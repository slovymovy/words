                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a50da2c-5eb1-4f0f-b53b-c56a1ad2f9f6",
                                                "sense_id": "d55ac7d8-7023-3cac-baa3-7f533bab534e",
                                                "text": "Meine Abstimmung war ungültig."
                                            },
                                            {
                                                "example_id": "e63450f5-2aa8-4d5f-9bd0-d992ec14e73b",
                                                "sense_id": "d55ac7d8-7023-3cac-baa3-7f533bab534e",
                                                "text": "Die Abstimmung hat die Prognose vom Vormittag bestätigt."
                                            },
                                            {
                                                "example_id": "5172d833-fa75-4f0d-be30-133dcdc75d02",
                                                "sense_id": "d55ac7d8-7023-3cac-baa3-7f533bab534e",
                                                "text": "„Am Ende ging die Abstimmung knapp verloren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bfc6aec3-7ff9-33db-8e27-ca66d5a3aa5a",
                                        "entry_id": "c825f38f-c258-32de-b694-836f12ef2d0a",
                                        "glosses": [
                                            "Einwirkung auf das Zusammenspiel mehrerer Komponenten, Beurteilung dieses Zusammenwirkens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40ef4fb3-45ab-414c-b3ca-16109b04d56c",
                                                "sense_id": "bfc6aec3-7ff9-33db-8e27-ca66d5a3aa5a",
                                                "text": "Die richtige Abstimmung von Matratze und Lattenrost ist ein entscheidender Faktor für erholsamen Schlaf."
                                            },
                                            {
                                                "example_id": "639a6784-d382-4e79-84ed-d3e50230416b",
                                                "sense_id": "bfc6aec3-7ff9-33db-8e27-ca66d5a3aa5a",
                                                "text": "„An den letzten Feinheiten von Design und Abstimmung wird gerade gearbeitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d55dd8d5-07d6-3458-be87-8a1fc126c65f",
                                        "entry_id": "c825f38f-c258-32de-b694-836f12ef2d0a",
                                        "glosses": [
                                            "Verständigung mehrerer Beteiligter über ein Vorgehen oder über die Lösung eines Problems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c242676-6b28-423b-b95e-a731a3468836",
                                                "sense_id": "d55dd8d5-07d6-3458-be87-8a1fc126c65f",
                                                "text": "Ziel der Abstimmung zwischen den beteiligten Referaten ist die einheitliche Anwendung des Subsidiaritätsprinzips durch die Bundesregierung."
