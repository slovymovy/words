                        "examples": [
                            {
                                "example_id": "0ab404a1-7d5b-4e51-ab01-429daa937813",
                                "sense_id": "aba6a5fb-c435-391a-b4ca-29fce61ac862",
                                "text": "Für die Kletterrebe (Gymnema sylvestre) ist eine blutzuckersenkende Wirkung durch Betazellstimulation beschrieben."
                            },
                            {
                                "example_id": "e5a36e1e-fd10-48f8-8115-fc8e1f111737",
                                "sense_id": "aba6a5fb-c435-391a-b4ca-29fce61ac862",
                                "text": "Die Kletterrebe ist über 2000 Jahre alt und kommt ursprünglich aus Indien. Sie gilt als der stärkste natürliche Zuckersenker und regt die Insulinproduktion an. Wenn man ihre Blätter kaut verliert man die Lust auf was Süßes!"
                            }
