                    {
                        "sense_id": "796485c5-a350-30f7-ba48-f4a456bc3243",
                        "entry_id": "fd3a3a7d-b354-3a9e-94ad-e2df2739f916",
                        "glosses": [
                            "het voortdurend schrapen (van bijvoorbeeld de keel of van het ene voorwerp over het andere)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68f2b243-d0e3-4bf1-b927-694ca5b47d1a",
                                "sense_id": "796485c5-a350-30f7-ba48-f4a456bc3243",
                                "text": "Door de koptelefoon klinkt het piepende geschraap langs de rand van de pan zo dichtbij dat de eerste toeschouwer die geen kippenvel krijgt nog gevonden moet worden."
                            },
                            {
                                "example_id": "7e9dd31c-3bde-4510-be8e-09e659581530",
                                "sense_id": "796485c5-a350-30f7-ba48-f4a456bc3243",
                                "text": "De buurtbewoners klagen over overlast veroorzaakt door rokers, die in de binnentuin en voor het café een sigaretje roken. Het geluid dat ze maken, galmt over het water. Maar ook het geschraap van stalen stoelen over de betonnen vloer 'dreunt door'."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbfe5902-71bc-3925-b764-c4126f9ad38e",
                        "entry_id": "fd3a3a7d-b354-3a9e-94ad-e2df2739f916",
                        "glosses": [
                            "het voordurend geld bij elkaar schrapen door een woekeraar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66d0b0ac-d098-48d7-b0d1-5c08bdb687d7",
                                "sense_id": "cbfe5902-71bc-3925-b764-c4126f9ad38e",
                                "text": "De woon-werkreiziger maakt al vaak meer kosten dan de werkgever vergoedt. Het is niet acceptabel dat de beperkte vergoeding die de werknemer krijgt ook nog een keer wordt belast. Dit geschraap ten laste van de werknemer voor het vullen van de schatkist moet worden beëindigd."
                            }
                        ]
                    }
