                                        "entry_id": "fe97bd17-bbe0-3ee4-a187-711e4ed12542",
                                        "glosses": [
                                            "A phobia, or fear, of mob-like crowds, as opposed to simply open spaces like agoraphobia or large crowds as with enochlophobia."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e89b61d9-3492-48e6-8d8a-b26f7bebb2d5",
                                                "sense_id": "41b69693-50a1-32f5-bcd6-67d0e957e014",
                                                "text": "Those who suffer enochlophobia, demophobia or ochlophobia–the fear of crowds–are not being entirely irrational."
                                            }
                                        ]
                                    }
