                                        "entry_id": "b1f47610-2229-3655-a4a7-cb2a25b3b3a4",
                                        "glosses": [
                                            "An action performed on a regular basis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ac76a54-79df-42fe-b1a7-98d6a058e94c",
                                                "sense_id": "c9dee879-412a-331e-b4bd-39c237a41bc7",
                                                "text": "It’s become a habit of mine to have a cup of coffee after dinner."
                                            },
                                            {
                                                "example_id": "37842998-0596-493c-9fe4-58cfaaf7d158",
                                                "sense_id": "c9dee879-412a-331e-b4bd-39c237a41bc7",
                                                "text": "a man of very shy, retired habits"
                                            },
                                            {
                                                "example_id": "f8e34c93-05c1-4849-907c-70704bd2353c",
                                                "sense_id": "c9dee879-412a-331e-b4bd-39c237a41bc7",
                                                "text": "Irregular bedtimes may disrupt healthy brain development in young children, according to a study of intelligence and sleeping habits. ¶ Going to bed at a different time each night affected girls more than boys, but both fared worse on mental tasks than children who had a set bedtime, researchers found."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b5c4ade-7396-36f2-88b0-83caa970ef8f",
                                        "entry_id": "b1f47610-2229-3655-a4a7-cb2a25b3b3a4",
                                        "glosses": [
                                            "An action performed repeatedly and automatically, usually without awareness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87fe8b56-de63-4bbb-860f-8ba88bef10e7",
                                                "sense_id": "7b5c4ade-7396-36f2-88b0-83caa970ef8f",
                                                "text": "By force of habit, he dressed for work even though it was holiday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d50de8-d449-3981-bbb9-5cf518117669",
                                        "entry_id": "b1f47610-2229-3655-a4a7-cb2a25b3b3a4",
                                        "glosses": [
                                            "An addiction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd9cea7-397e-464e-af23-6a8afa2e4d49",
                                                "sense_id": "41d50de8-d449-3981-bbb9-5cf518117669",
                                                "text": "kick the habit"
                                            },
                                            {
                                                "example_id": "91080085-26bc-4e86-8f6f-309977b4f6f2",
                                                "sense_id": "41d50de8-d449-3981-bbb9-5cf518117669",
                                                "text": "He has a 10-cigar habit."
                                            },
                                            {
                                                "example_id": "055b1453-4dbc-43d8-ae28-a2bc051c91b0",
                                                "sense_id": "41d50de8-d449-3981-bbb9-5cf518117669",
                                                "text": "Another white boy band / They're happy on demand / Everything is planned / Until the singer gets a habit"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
