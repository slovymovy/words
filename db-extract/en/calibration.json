                                        ]
                                    },
                                    {
                                        "sense_id": "712fb879-8ff2-3b23-aab1-d713227a8d4f",
                                        "entry_id": "1659582e-aeda-3fdf-86a2-17009c37a44f",
                                        "glosses": [
                                            "подстройка, проверка или измерение шкалы делений какого-нибудь измерительного прибора, сопоставление делений инструментальной шкалы со значениями измеряемой величины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6b95dd-384b-45c4-b4db-95d59f001666",
                                                "sense_id": "712fb879-8ff2-3b23-aab1-d713227a8d4f",
                                                "text": "Калибровка термометра."
                                            },
                                            {
                                                "example_id": "571eb228-17c7-483f-98c8-0e6013078f2c",
                                                "sense_id": "712fb879-8ff2-3b23-aab1-d713227a8d4f",
                                                "text": "С помощью набора эталонных источников гамма-квантов была выполнена повторная калибровка гамма-спектрометра."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb1bf3ff-408b-3c3b-8410-434e578b370c",
                                        "entry_id": "1659582e-aeda-3fdf-86a2-17009c37a44f",
                                        "glosses": [
                                            "функция, сопоставляющая деления шкалы со значениями измеряемой величины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ec34bf9-6e73-47f4-891f-f8a4af69ce9b",
                                                "sense_id": "bb1bf3ff-408b-3c3b-8410-434e578b370c",
                                                "text": "В этом диапазоне лучше подходит квадратичная калибровка, чем линейная."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1b3f3fb-7dab-3608-aec6-4780e3e0de66",
                                        "entry_id": "1659582e-aeda-3fdf-86a2-17009c37a44f",
                                        "glosses": [
                                            "физ. фиксация определённых степеней свободы поля для придания однозначности решениям уравнений движения этого поля"
                                        ],
                                        "tags": [
                                            "теории поля"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc677949-7a36-43b2-b1ae-69d8777ebe9f",
                                                "sense_id": "a1b3f3fb-7dab-3608-aec6-4780e3e0de66",
                                                "text": "Кулоновская калибровка более подходит для нерелятивистских задач электродинамики, но она, в отличие от лоренцевской калибровки, не является релятивистски инвариантной."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c662620-faf2-3b70-82db-2e25960ad797",
                                        "entry_id": "1659582e-aeda-3fdf-86a2-17009c37a44f",
                                        "glosses": [
                                            "разг. инструмент для проверки калибра"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de2d5dfa-3e23-3322-85c0-d8a5f2caaea4",
                                        "entry_id": "1659582e-aeda-3fdf-86a2-17009c37a44f",
