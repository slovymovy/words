        "ru-extract.jsonl": [
            {
                "entry_id": "9fd42c82-54ee-3e14-9d90-85e66aa0c15f",
                "word": "РБ",
                "pos": "abbrev",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "71203ec1-81cf-3db7-a125-1e0de04f5703",
                        "entry_id": "9fd42c82-54ee-3e14-9d90-85e66aa0c15f",
                        "glosses": [
                            "сокр. от Республика Башкортостан"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "688d7a2e-7a1e-41ef-a577-35cb918e69e8",
                                "sense_id": "71203ec1-81cf-3db7-a125-1e0de04f5703",
                                "text": "Старосубхангулово, или Бурзян, как называют его местные жители, старое село. Расположено в широкой межгорной правобережной долине реки Белой. Является центром Бурзянского района РБ."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a9404f8-3f80-39a1-a114-801c40b1ec5f",
                        "entry_id": "9fd42c82-54ee-3e14-9d90-85e66aa0c15f",
                        "glosses": [
                            "сокр. от Республика Беларусь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f95f27c-0ce2-4789-bc51-0ed07cd02faf",
                                "sense_id": "0a9404f8-3f80-39a1-a114-801c40b1ec5f",
                                "text": "Выравнивание белорусских таможенных пошлин на иномарки с российскими для поддержки российского же автопрома вовсе не вдохновляет граждан РБ."
                            }
                        ]
                    },
                    {
                        "sense_id": "aeaa8e9e-7d60-3092-b745-31eb4681e47a",
                        "entry_id": "9fd42c82-54ee-3e14-9d90-85e66aa0c15f",
                        "glosses": [
                            "сокр. от Республика Бурятия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "462e9250-9847-45f4-8568-b146b212bff0",
                                "sense_id": "aeaa8e9e-7d60-3092-b745-31eb4681e47a",
                                "text": "Подведя итоги совещания, Анатолий Кушнарев отметил, что в этой сфере накопилось множество проблем, и решать их совместными усилиями с Народным Хуралом РБ."
                            }
                        ]
                    },
                    {
                        "sense_id": "91f73e01-db43-3c98-80cf-9d5055d251fd",
                        "entry_id": "9fd42c82-54ee-3e14-9d90-85e66aa0c15f",
                        "glosses": [
                            "сокр. от Республика Болгария"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "643fde46-a695-4cf3-b2be-516cb37ec9ed",
                                "sense_id": "91f73e01-db43-3c98-80cf-9d5055d251fd",
                                "text": "Военная промышленность Республики Болгария (РБ) выделилась в отдельную отрасль экономики в конце XIX века."
                            }
                        ]
                    }
                ],
