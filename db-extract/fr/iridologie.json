                        "glosses": [
                            "Pseudo-science de l’iris de l’œil, qui prétend que son examen par le médecin ou par l’iridologue révèle l’état de santé de certains organes ou certaines affections."
                        ],
                        "tags": [
                            "Médecine non conventionnelle",
                            "Pseudo-sciences"
                        ],
                        "examples": [
                            {
                                "example_id": "63e6488f-7212-4f1c-83fe-87ee3a0780b3",
                                "sense_id": "0ef30c4f-185a-321a-99bf-abc198b7353d",
                                "text": "Certains thérapeutes rangent l’iridologie parmi les techniques de réflexologie, une autre pseudo-science."
                            },
                            {
                                "example_id": "161ce272-2a66-4762-a0dc-e6b9f7a3229f",
                                "sense_id": "0ef30c4f-185a-321a-99bf-abc198b7353d",
                                "text": "Le père de l’iridologie moderne est Ignaz von Peczely, Hongrois né en 1826 qui eut l’inspiration en soignant une chouette victime d’une fracture de patte."
                            }
                        ]
