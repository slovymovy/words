                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sepsis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc1d32d8-cd5d-3674-bd62-f562c09be177",
                                        "entry_id": "05840e15-0902-37ef-b897-93fc1b89977c",
                                        "glosses": [
                                            "État inflammatoire d’origine infectieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0c8f3e6-d259-4a36-afad-c8a0a47758d6",
                                                "sense_id": "dc1d32d8-cd5d-3674-bd62-f562c09be177",
                                                "text": "Le sepsis sévère et le choc septique sont des maladies fréquentes (plusieurs centaines de milliers de cas chaque année en Europe occidentale) et grevées d’une mortalité importante allant de 30 à plus de 70 %."
                                            },
                                            {
                                                "example_id": "6a9cac0c-929c-46b3-af84-9384f640b9dc",
                                                "sense_id": "dc1d32d8-cd5d-3674-bd62-f562c09be177",
                                                "text": "Le sepsis est défini par la présence concomitante d’une infection et d’une réponse systémique inflammatoire appelée SIRS."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0e328c1-0ca0-4567-a839-6458b0d1d266",
                        "source_entry_id": "164b0ff0-e333-371f-a2f0-734f9535bc21",
                        "source_sense_id": "f529ec68-28cb-3a2e-83f8-a3aa2ceb1079",
                        "source_sense_description": "serious medical condition in which the whole body is inflamed",
                        "target_lang_word": "Sepsis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sepsis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c81007cd-9aaa-3b39-9658-3f64659a4a01",
                                        "entry_id": "c6a53bff-a37c-3194-92f6-62aa1b4dac93",
                                        "glosses": [
                                            "komplexe systemische Entzündungsreaktion des Organismus wegen der Einschwemmung von Krankheitserregern aus einem Infektionsherd in die Blutbahn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04ee25f7-5fba-46f5-a469-4cdfdab8181e",
                                                "sense_id": "c81007cd-9aaa-3b39-9658-3f64659a4a01",
                                                "text": "Die rechtzeitige Behandlung mit den richtigen Antibiotika ist die Basis jeder erfolgreichen Sepsis-Therapie."
                                            },
                                            {
                                                "example_id": "343271ec-2977-447c-86ee-71eead91f782",
                                                "sense_id": "c81007cd-9aaa-3b39-9658-3f64659a4a01",
                                                "text": "„Rund 15 Prozent der im Krankenhaus verstorbenen Patienten verstarben 2015 in Deutschland an einer Sepsis.“"
                                            },
                                            {
                                                "example_id": "b70cd0ab-161f-4987-a955-99f7f022b052",
                                                "sense_id": "c81007cd-9aaa-3b39-9658-3f64659a4a01",
                                                "text": "Sepsis, schwere Sepsis und septischer Schock definieren ein Krankheitskontinuum, das über eine Kombination aus Vitalparametern, Laborwerten, hämodynamischen Daten und Organfunktionen definiert wird."
                                            },
                                            {
                                                "example_id": "ffc1a1e8-39aa-4098-856f-d5cfd2fabc0d",
                                                "sense_id": "c81007cd-9aaa-3b39-9658-3f64659a4a01",
                                                "text": "Sepsis, eine entzündliche Reaktion des gesamten Organismus auf einen über die Blutbahn verbreiteten Krankheitserreger, ist eine der häufigsten Ursachen für Todesfälle auf der Intensivstation, täglich sterben weltweit 1400 Menschen daran, die Todesrate einer schweren Sepsis liegt trotz der modernen Intensivmedizin noch immer zwischen 30 und 50 Prozent."
                                            },
                                            {
                                                "example_id": "5948df0d-066f-4c69-a95e-b6eb2ee47176",
                                                "sense_id": "c81007cd-9aaa-3b39-9658-3f64659a4a01",
                                                "text": "Entscheidend für die Senkung der Mortalität der Sepsis und auch der Kosten sind die schnelle und richtige Diagnose sowie die schnelle Einleitung einer zum Sepsiserreger passenden Therapie."
                                            },
                                            {
                                                "example_id": "7c37a4d1-8160-4b7e-a8a8-a50d7b6ae9db",
                                                "sense_id": "c81007cd-9aaa-3b39-9658-3f64659a4a01",
                                                "text": "Aktuell startet etwa ein Projekt, das sich mit einem neuen Ansatz zur Behandlung von Sepsis, der nach Herzinfarkt und Schlaganfall dritthäufigsten Todesursache in Österreich, befasst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4adcb29a-80d2-4a22-a81c-ff8cfeaf13c0",
                        "source_entry_id": "164b0ff0-e333-371f-a2f0-734f9535bc21",
                        "source_sense_id": "f529ec68-28cb-3a2e-83f8-a3aa2ceb1079",
                        "source_sense_description": "serious medical condition in which the whole body is inflamed",
                        "target_lang_word": "Blutvergiftung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutvergiftung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa93c554-8fe1-3338-b13c-abb25783d024",
                                        "entry_id": "3d27ed2e-a3fb-38fc-849d-790cfea6ee95",
                                        "glosses": [
                                            "eins von verschiedenen Krankheitsbildern, bei dem sich eine Infektion über Lymphe oder Blut im Körper ausbreitet und Entzündungen auslöst"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fe2370c-4ed0-419d-954b-28fa9fc1b3d3",
                                                "sense_id": "fa93c554-8fe1-3338-b13c-abb25783d024",
                                                "text": "Eine Blutvergiftung überlebt nur jeder zweite Patient."
                                            },
                                            {
                                                "example_id": "a3a9a03f-abcd-4056-bd34-c3be03e0f914",
                                                "sense_id": "fa93c554-8fe1-3338-b13c-abb25783d024",
                                                "text": "Bei einer Blutvergiftung verteilen sich Erreger über die Blutbahn in den ganzen Körper – findet man zugrundeliegende Infektion nicht, ist die Heilung unwahrscheinlich."
                                            },
                                            {
                                                "example_id": "16e0dd75-dbc6-4024-8416-d20158438d1a",
                                                "sense_id": "fa93c554-8fe1-3338-b13c-abb25783d024",
                                                "text": "„Ich lief zu Mittendorfs, Hilfe holen, und Stephans Mutter fuhr uns nach Vallendar ins Krankenhaus, wo Renate eine Tetanusspritze gegen Blutvergiftung kriegte.“"
                                            },
                                            {
                                                "example_id": "c038a023-863c-4561-9980-603c16cd118d",
                                                "sense_id": "fa93c554-8fe1-3338-b13c-abb25783d024",
                                                "text": "„Die Wunde an Walts Finger hatte so reichlich geblutet, daß keine Blutvergiftung entstand, aber den Verband mußte er eine Woche am Finger lassen, und die Wunde heilte erst nach drei Wochen zu.“"
                                            },
                                            {
                                                "example_id": "d802b00a-fb79-4ddf-bdfa-3debe92a6a99",
                                                "sense_id": "fa93c554-8fe1-3338-b13c-abb25783d024",
                                                "text": "„Als Carola Neher im Frühjahr 1925 an einer Blutvergiftung lebensgefährlich erkrankt, befürchtet er die Wiederholung des Schicksals seiner ersten Frau.“"
                                            },
                                            {
                                                "example_id": "291fb7dd-cc39-4a2a-99a1-2d0e759b75d2",
                                                "sense_id": "fa93c554-8fe1-3338-b13c-abb25783d024",
                                                "text": "„Ich hatte keinerlei Desinfektionsmittel, lebte im Schmutz, es konnte eine Blutvergiftung entstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
