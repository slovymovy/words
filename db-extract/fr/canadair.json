                ],
                "senses": [
                    {
                        "sense_id": "9c78566a-01a2-3b0e-83c2-92e520f86bdb",
                        "entry_id": "35c76263-94df-377b-83d9-08adca4ffe03",
                        "glosses": [
                            "Canadair CL-215 : avion bombardier d’eau."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "33746c9a-af7a-44a2-906a-6fd36b5ed8d7",
                                "sense_id": "9c78566a-01a2-3b0e-83c2-92e520f86bdb",
                                "text": "En cas d'incendie, les Canadairs sont basés à Marignane et sont loués à la région Sud-Est."
                            },
                            {
                                "example_id": "941933e8-5349-476c-bcf6-c1f5ed9dac89",
                                "sense_id": "9c78566a-01a2-3b0e-83c2-92e520f86bdb",
                                "text": "Ce mot était aussi chaque été la source d'une peur démesurée : celle d'être aspiré par un Canadair alors que je nageais en Méditerranée et d'être jeté, à quelques kilomètre de là, dans les flammes d'une pinède dévastée."
                            },
                            {
                                "example_id": "8d4aec42-ba12-43db-bc14-63a197f7a125",
                                "sense_id": "9c78566a-01a2-3b0e-83c2-92e520f86bdb",
                                "text": "Une solidarité que revendique aussi le commandant Sarioglu, ce pilote de Canadair de l’armée grecque, arrivé avant-hier à la BA 106 : « Ensemble, nous sommes plus forts, nous avons plus de solutions contre le feu. »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b9804232-b250-3231-9c17-e691b25c2a93",
                "word": "canadair",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ae7c4a0e-9bed-4de3-95b3-96dd8d741a90",
                        "entry_id": "b9804232-b250-3231-9c17-e691b25c2a93",
                        "tags": [
                            "plural"
                        ],
                        "form": "canadairs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37f7d73c-8d2c-390d-998d-3302c60963ba",
                        "entry_id": "b9804232-b250-3231-9c17-e691b25c2a93",
                        "glosses": [
                            "Avion bombardier d’eau, généralement un Canadair CL-215 de la marque Canadair."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "3f375a87-1709-4484-99e0-a3d872438cee",
                                "sense_id": "37f7d73c-8d2c-390d-998d-3302c60963ba",
                                "text": "Des canadairs et des trackers ont également été sollicités pour circonscrire l’incendie qui a ravagé 45 hectares de forêt."
                            },
                            {
                                "example_id": "f57471d0-6d8c-4279-9fd8-e5bf0836038a",
                                "sense_id": "37f7d73c-8d2c-390d-998d-3302c60963ba",
                                "text": "L’important est que le canadair vide ses réservoirs avant de les recharger pour un nouveau cycle de largage avec une nouvelle cible de choix !"
                            },
                            {
                                "example_id": "b7d74b5a-e967-4f8f-b81b-d1169e9cdc7e",
                                "sense_id": "37f7d73c-8d2c-390d-998d-3302c60963ba",
                                "text": "À ce moment-là, un autre incendie éclôt en zone urbaine dans les Alpes-Maritimes, ce qui conduit les autorités à y envoyer les canadairs, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2447fc30-3a1d-410b-a46f-6e06bd0e5eb4",
                        "source_entry_id": "b9804232-b250-3231-9c17-e691b25c2a93",
                        "source_sense_id": "37f7d73c-8d2c-390d-998d-3302c60963ba",
                        "target_lang_word": "waterbomber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waterbomber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10c3304e-e13c-346d-85d3-5da981976071",
                                        "entry_id": "92a86dc1-2da8-33a4-99e6-74ca117a6679",
                                        "glosses": [
                                            "An aircraft that engages in waterbombing, usually in the course of fighting a wildfire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8efa1a69-556a-444f-a153-f01383b45889",
                                                "sense_id": "10c3304e-e13c-346d-85d3-5da981976071",
                                                "text": "Near-synonyms: air tanker, airtanker, AT (broadly synonymous)"
                                            },
                                            {
                                                "example_id": "f7307051-fc8d-474f-926d-945ea5135c47",
                                                "sense_id": "10c3304e-e13c-346d-85d3-5da981976071",
                                                "text": "Some 50 firefighters, 10 tankers and waterbombers battled the grass and scrub blaze, which began about 12.30pm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
