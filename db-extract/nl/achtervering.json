                        "glosses": [
                            "mechanisme dat dient om schokken op te vangen van de wielen aan de achterkant van een voertuig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dd6fae1-0190-49cf-a9cb-8a4c368a32cc",
                                "sense_id": "ca0dd55f-159a-36ce-a306-3c3d625cac9c",
                                "text": "Doordat de achtervering dwars onderin de auto is geplaatst, zijn de wielkasten aan de binnenkant van de kofferbak mooi vlak, waardoor er ruimte is voor brede voorwerpen."
                            },
                            {
                                "example_id": "47f04903-01af-447a-aadb-cc540c4e4c66",
                                "sense_id": "ca0dd55f-159a-36ce-a306-3c3d625cac9c",
                                "text": "Het standaard onderstel van deze CLA 200 Shooting Brake is verrassend comfortabel, zeker in vergelijking met zijn wat stugge voorganger. Met name de achtervering gedraagt zich goedmoedig en deelt nauwelijks klappen uit aan je rug en billen."
                            },
                            {
                                "example_id": "fae94e41-efe2-4524-a4e2-3a57cc5b9671",
                                "sense_id": "ca0dd55f-159a-36ce-a306-3c3d625cac9c",
                                "text": "Met speciaal gelijmde banden en op een frame met voor- en achtervering gaat Michiel van der Heijden komend weekend in het Tsjechische Nove Mesto op jacht naar een olympisch ticket."
                            }
                        ]
                    }
