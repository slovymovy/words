                                    },
                                    {
                                        "sense_id": "33498854-d9a6-35b5-b28d-f7dd7ddc8c2d",
                                        "entry_id": "178614ea-c458-3233-98d5-4b802a0ad579",
                                        "glosses": [
                                            "In the same direction as the axis, parallel to the axis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0558a1a-aaea-49cf-ac27-c2c7e41e838d",
                                                "sense_id": "33498854-d9a6-35b5-b28d-f7dd7ddc8c2d",
                                                "text": "The secondary xylem usually consists of axial and radial elements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce5d72aa-2663-3ef3-a191-84c319a101f2",
