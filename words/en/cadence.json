                        {
                            "text": "The soldiers sang a loud <w>cadence</w> to keep their spirits high during the long march.",
                            "target_lang_translations": {
                                "ru": "Солдаты громко пели <w>строевую песню</w>, чтобы поддерживать боевой дух во время долгого марша."
                            }
