            "senses": [
                {
                    "sense_id": "9a2ff68b-025d-3a32-99d6-51e6cf2d1c1b",
                    "sense_definition": "op allerlei manieren verbonden met iets of iemand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbondenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De geschiedenis van de twee landen is nauw met elkaar <w>verweven</w>.",
                            "target_lang_translations": {
                                "en": "The history of the two countries is closely <w>intertwined</w>.",
                                "fr": "L'histoire des deux pays est étroitement <w>entremêlée</w>."
                            }
                        },
                        {
                            "text": "Zijn persoonlijke leven is volledig <w>verweven</w> met zijn professionele carrière.",
                            "target_lang_translations": {
                                "en": "His personal life is completely <w>interwoven</w> with his professional career.",
                                "fr": "Sa vie personnelle est totalement <w>imbriquée</w> dans sa carrière professionnelle."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbonden",
                        "verstrengeld",
                        "gekoppeld"
                    ],
                    "antonyms": [
                        "losstaand",
                        "gescheiden"
                    ],
                    "common_phrases": [
                        "nauw verweven",
                        "onlosmakelijk verweven"
                    ],
                    "target_lang_definitions": {
                        "en": "connected with something or someone in various ways",
                        "fr": "lié de diverses manières à quelque chose ou à quelqu'un"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intertwined",
                                "target_lang_sense_clarification": "closely connected or twisted together"
                            },
                            {
                                "target_lang_word": "interwoven",
                                "target_lang_sense_clarification": "blended or linked together intimately"
                            },
                            {
                                "target_lang_word": "linked",
                                "target_lang_sense_clarification": "connected in a general sense"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "entremêlé",
                                "target_lang_sense_clarification": "étroitement lié ou entrelacé"
                            },
                            {
                                "target_lang_word": "imbriqué",
                                "target_lang_sense_clarification": "fortement lié de façon complexe"
                            },
                            {
                                "target_lang_word": "lié",
                                "target_lang_sense_clarification": "connecté au sens général"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f6123ecf-8398-3fe4-9d92-a2680679c4f9",
                    "sense_definition": "verschillende draden of elementen door elkaar weven om een geheel te vormen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar probeert verschillende materialen in het tapijt te <w>verweven</w>.",
                            "target_lang_translations": {
                                "en": "The artist tries to <w>interweave</w> different materials into the carpet.",
                                "fr": "L'artiste tente d'<w>entrelacer</w> différents matériaux dans le tapis."
                            }
                        },
                        {
                            "text": "Zij wist de zijden draden prachtig te <w>verweven</w> tot een kleurrijk patroon.",
                            "target_lang_translations": {
                                "en": "She managed to <w>weave</w> the silk threads beautifully into a colorful pattern.",
                                "fr": "Elle a su <w>tisser</w> magnifiquement les fils de soie pour former un motif coloré."
                            }
                        }
                    ],
                    "synonyms": [
                        "dooreenweven",
                        "vlechten"
                    ],
                    "antonyms": [
                        "ontrafelen"
                    ],
                    "common_phrases": [
                        "draden verweven"
                    ],
                    "target_lang_definitions": {
                        "en": "to weave different threads or elements together to form a whole",
                        "fr": "tisser différents fils ou éléments ensemble pour former un tout"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to interweave",
                                "target_lang_sense_clarification": "to weave together"
                            },
                            {
                                "target_lang_word": "to weave in",
                                "target_lang_sense_clarification": "to incorporate by weaving"
                            },
                            {
                                "target_lang_word": "to entwine",
                                "target_lang_sense_clarification": "to twist or weave together"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "entrelacer",
