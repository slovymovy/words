                        "entry_id": "74863f88-e592-3e21-919e-b7ab0972a6be",
                        "glosses": [
                            "Of or relating to the epoch before written record."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16843e8c-5d73-455f-9512-99b53ccca8a6",
                                "sense_id": "930fc230-cac4-323d-88ad-044b64755a26",
                                "text": "Was it then in a pre-historic time that the Romans wandered into these lands?"
                            },
                            {
                                "example_id": "56c08f37-6266-41ff-a614-01d134c4ede7",
                                "sense_id": "930fc230-cac4-323d-88ad-044b64755a26",
                                "text": "The cartoon image of prehistoric woman being dragged by the hair by her caveman-husband probably conditions the perceptions of archaeologists far more than they realize."
                            }
                        ]
                    },
                    {
                        "sense_id": "9964f2be-b9eb-3848-ba64-950f52e52956",
                        "entry_id": "74863f88-e592-3e21-919e-b7ab0972a6be",
                        "glosses": [
                            "Ancient; very old, outdated, etc."
                        ],
                        "tags": [],
                        "examples": []
                    }
