                    {
                        "sense_id": "2355b3fa-a91d-3658-8abd-a68d52cebd60",
                        "entry_id": "36c0d29a-af35-3da8-baad-78e97ac9a632",
                        "glosses": [
                            "de wacht die met de bewaking van een vorst of aanzienlijk persoon belast is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "986326a6-c094-4e9d-8062-b79056118e40",
                                "sense_id": "2355b3fa-a91d-3658-8abd-a68d52cebd60",
                                "text": "Na de bedreiging eiste de politicus van de regering een lijfwacht."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4d0e14c-789c-36dc-834f-cd7482e81396",
                        "entry_id": "36c0d29a-af35-3da8-baad-78e97ac9a632",
                        "glosses": [
                            "een lid van een lijfwacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f1350e8-7ea3-4823-aaef-750d2e43c8f3",
                                "sense_id": "e4d0e14c-789c-36dc-834f-cd7482e81396",
                                "text": "Na een uitgebreide sollicitatieprocedure kon de man zich eindelijk lijfwacht van de koning noemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65e93842-27ef-45cc-8cf6-58332a785fc1",
                        "source_entry_id": "36c0d29a-af35-3da8-baad-78e97ac9a632",
                        "source_sense_id": "2355b3fa-a91d-3658-8abd-a68d52cebd60",
                        "source_sense_description": "de wacht die met de bewaking van een vorst of aanzienlijk persoon belast is",
                        "target_lang_word": "Leibwache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leibwache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70d73c5d-f787-3945-b5cd-2da0a970e942",
                                        "entry_id": "3318acb0-aebc-3889-b480-10492b30db6a",
                                        "glosses": [
                                            "Truppe oder Person, die mit dem Schutz einer bestimmten Person beauftragt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5834fd1-3b39-404a-9852-2821776ea3c2",
                                                "sense_id": "70d73c5d-f787-3945-b5cd-2da0a970e942",
                                                "text": "„Wir hörten dann auch, wie der Schaffner während der Nacht wie eine Leibwache vor unserer Tür kämpfte, um einen Kontrolleur oder was es sonst war, der zu uns hereinwollte, am Eintritt zu hindern.“"
                                            },
                                            {
                                                "example_id": "3e796ec9-eb1e-485f-b5bc-01eea37344ef",
                                                "sense_id": "70d73c5d-f787-3945-b5cd-2da0a970e942",
                                                "text": "„Des Weiteren würde der Schah ihn sicherlich damit beauftragen, in den Reihen seiner unfähigen Leibwache aufzuräumen.“"
                                            },
                                            {
                                                "example_id": "3af5837f-1c35-47f7-801a-5a6c6083068c",
                                                "sense_id": "70d73c5d-f787-3945-b5cd-2da0a970e942",
                                                "text": "„Ihre Leibwache hielt Speere mit Troddeln daran.“"
                                            },
                                            {
                                                "example_id": "afa700cb-a47c-4120-a566-00d929733639",
                                                "sense_id": "70d73c5d-f787-3945-b5cd-2da0a970e942",
                                                "text": "„Er versicherte mir, ich würde nicht enttäuscht sein, und er werde für mich eine Leibwache aufstellen, mit der ich zufrieden sein würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a83c914-167e-4d05-8cd1-36748bd29ae3",
                        "source_entry_id": "36c0d29a-af35-3da8-baad-78e97ac9a632",
