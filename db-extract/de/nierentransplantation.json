                        "entry_id": "f132d789-707c-3cb8-98d7-fb8d479affe1",
                        "glosses": [
                            "Einpflanzung einer Spenderniere in den Körper eines lebenden Menschen, bei gleichzeitiger Entfernung der erkrankten Niere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed46e012-caca-410a-9cf3-d54d05530539",
                                "sense_id": "83b835bc-ca7d-30bb-a3ca-4aabe2d40a06",
                                "text": "„Der Mann hatte sich von einer Nierentransplantation nicht mehr erholt.“"
                            },
                            {
                                "example_id": "ba893145-bdc7-46a5-8bce-370c77af848a",
                                "sense_id": "83b835bc-ca7d-30bb-a3ca-4aabe2d40a06",
                                "text": "„Mit einer Nierentransplantation kann die verbleibende Lebenserwartung auf knapp 45 Jahren fast verdoppelt werden.“"
                            }
                        ],
