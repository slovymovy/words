                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca442153-487e-42d2-a584-5fa0b6d50d02",
                                "sense_id": "2c81a1e9-94bd-3b81-bd75-eae08df3125f",
                                "text": "Der Steinpilz ist eine Pilzsorte. — Le cèpe est une sorte de champignons."
                            },
                            {
                                "example_id": "606f002f-a945-4660-a484-13593734e84e",
                                "sense_id": "2c81a1e9-94bd-3b81-bd75-eae08df3125f",
                                "text": "Der Steinpilz ist eine Pilzsorte.",
                                "translation": "Le cèpe est une sorte de champignons."
                            },
                            {
                                "example_id": "86f93714-0ac4-49be-ae69-e7f4177467ae",
                                "sense_id": "2c81a1e9-94bd-3b81-bd75-eae08df3125f",
                                "text": "Steinpilze zählen zu den schmackhaftesten Speisepilzen.",
                                "translation": "Les cèpes comptent parmi les champignons comestibles les plus savoureux."
                            }
                        ]
                    }
