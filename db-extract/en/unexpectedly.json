                                "example_id": "38b175cb-f4be-4ff2-8de1-b1e407b3dc97",
                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                "text": "Other evidence of former ownerships such as notice-boards, number plates, and makers' plates, are often discovered unexpectedly."
                            },
                            {
                                "example_id": "4ac4a871-d192-4892-ad79-18cc1f480fce",
                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                "text": "Texas House Democrats’ historic quorum break unexpectedly ended Thursday evening when at least three new Democrats returned to the floor, paving the way for state Republicans to pass restrictive voting legislation."
                            }
                        ]
