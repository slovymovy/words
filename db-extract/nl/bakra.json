                        "examples": [
                            {
                                "example_id": "9c6027eb-2c1d-4141-b947-89dde6a2db99",
                                "sense_id": "e90b1b77-afc5-3fe8-be27-580ff849de05",
                                "text": "Die bakra’s gaan er een heel nummertje van maken jongen, want eh, als iedereen naar Suriname kijkt, kijkt er niemand meer naar die Rutte en vergeten ze al die plannen om te bezuinigen."
                            },
                            {
                                "example_id": "f0dc0d71-d583-4e40-86e6-a84356b81b98",
                                "sense_id": "e90b1b77-afc5-3fe8-be27-580ff849de05",
                                "text": "In Suriname waren Nederlanders ver, ver verheven boven de Surinamers. In mijn gedachten waren alle Nederlanders rijk en woonden ze allemaal in grote huizen. Ik kon mijn ogen niet geloven toen die bakra mijn koffer oppakte om hem voor mij te dragen."
                            }
                        ]
                    }
