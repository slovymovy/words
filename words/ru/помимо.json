                {
                    "sense_id": "f0ec8da3-2695-300c-906e-63c0f283c852",
                    "sense_definition": "Без ведома или участия кого-либо; вопреки чему-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bypassing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это важное решение было принято <w>помимо</w> директора.",
                            "target_lang_translations": {
                                "en": "This important decision was made <w>without the knowledge of</w> the director.",
                                "zh": "这个重要的决定是在<w>背着</w>经理的情况下做出的。",
                                "nl": "Dit belangrijke besluit werd genomen <w>buiten medeweten van</w> de directeur.",
                                "pl": "Ta ważna decyzja została podjęta <w>bez wiedzy</w> dyrektora.",
                                "de": "Diese wichtige Entscheidung wurde <w>ohne</w> das Wissen des Direktors getroffen.",
                                "fr": "Cette décision importante a été prise <w>à l'insu du</w> directeur.",
                                "it": "Questa decisione importante è stata presa <w>all'insaputa</w> del direttore.",
                                "cs": "Toto důležité rozhodnutí bylo přijato <w>bez vědomí</w> ředitele.",
                                "tr": "Bu önemli karar, müdürün <w>bilgisi dışında</w> alındı.",
                                "es": "Esta importante decisión se tomó <w>sin el conocimiento del</w> director."
                            }
                        },
                        {
                            "text": "Слёзы потекли из её глаз <w>помимо</w> её воли.",
                            "target_lang_translations": {
                                "en": "Tears flowed from her eyes <w>against</w> her will.",
                                "zh": "泪水<w>违背</w>她的意愿从眼中流了出来。",
                                "nl": "Tranen stroomden uit haar ogen <w>tegen</w> haar wil <w>in</w>.",
                                "pl": "Łzy popłynęły z jej oczu <w>wbrew</w> jej woli.",
                                "de": "Tränen flossen aus ihren Augen <w>gegen</w> ihren Willen.",
                                "fr": "Des larmes ont coulé de ses yeux <w>contre</w> sa volonté.",
                                "it": "Le lacrime le sono scese dagli occhi <w>contro</w> la sua volontà.",
                                "cs": "Slzy jí tekly z očí <w>proti</w> její vůli.",
                                "tr": "Gözyaşları, kendi <w>iradesi dışında</w> gözlerinden aktı.",
                                "es": "Las lágrimas brotaron de sus ojos <w>en contra de</w> su voluntad."
                            }
                        }
