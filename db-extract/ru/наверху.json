                        "glosses": [
                            "выше, в верхней части"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "68e2bef7-9449-3ca8-b312-9a04a234a096",
                        "entry_id": "0af4dbcf-9d6e-312d-a3cc-2ff052f89f6f",
                        "glosses": [
                            "перен., разг. в высоком руководстве, среди начальства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe99a2c3-f5ff-4887-a04c-deba9770e8ea",
                                "sense_id": "68e2bef7-9449-3ca8-b312-9a04a234a096",
                                "text": "Вопрос решается наверху."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c0011c1-a916-31e0-a1a4-f0e4d36400e0",
                        "entry_id": "0af4dbcf-9d6e-312d-a3cc-2ff052f89f6f",
                        "glosses": [
                            "предлог, с род. п. в верхней части чего-либо, над чем-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67cb6120-e186-4e8d-b0e0-278d0d83b07a",
                        "source_entry_id": "0af4dbcf-9d6e-312d-a3cc-2ff052f89f6f",
                        "source_sense_description": "над",
                        "target_lang_word": "on top of",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on top of",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14cfba6b-292b-37a4-abda-c2a226cba2d6",
                                        "entry_id": "bfeca151-75b9-3744-a88e-0f2581d645ed",
                                        "glosses": [
                                            "Atop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9ae616f-ca02-47b4-b392-08cff6358e43",
                                                "sense_id": "14cfba6b-292b-37a4-abda-c2a226cba2d6",
                                                "text": "There's a house on top of the mountain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdaeb55d-e11c-3a6e-9358-5a58b8d010c4",
                                        "entry_id": "bfeca151-75b9-3744-a88e-0f2581d645ed",
                                        "glosses": [
                                            "Very close to, in any orientation or in time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57231ddd-cbd2-48f3-b6e2-a0c92d0ff548",
                                                "sense_id": "fdaeb55d-e11c-3a6e-9358-5a58b8d010c4",
                                                "text": "Living on top of one another in a refugee camp is stressful."
                                            },
                                            {
                                                "example_id": "62ac3ea9-410b-4ed1-a978-090316b76b0d",
                                                "sense_id": "fdaeb55d-e11c-3a6e-9358-5a58b8d010c4",
                                                "text": "At peak times, a telephone operator must handle a number of calls, one on top of the next."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d28fb771-c9f7-32b9-9974-5a9c2e6f529a",
                                        "entry_id": "bfeca151-75b9-3744-a88e-0f2581d645ed",
                                        "glosses": [
                                            "In addition to something else."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f242a060-66c3-4354-b66f-baa54e334f35",
                                                "sense_id": "d28fb771-c9f7-32b9-9974-5a9c2e6f529a",
                                                "text": "[…] and on top of all that, I got a puncture!"
                                            },
                                            {
                                                "example_id": "8eacb0a6-f715-4e3d-8822-6171f3799685",
                                                "sense_id": "d28fb771-c9f7-32b9-9974-5a9c2e6f529a",
                                                "text": "No Ammonite or Moabite is to enter the congregation of GOD, even to the tenth generation, nor any of his children, ever. Those nations didn’t treat you with hospitality on your travels out of Egypt, and on top of that they also hired Balaam son of Beor from Pethor in Mesopotamia to curse you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf86e0f4-dc73-3c59-8f6d-cc6b378226bd",
                                        "entry_id": "bfeca151-75b9-3744-a88e-0f2581d645ed",
                                        "glosses": [
                                            "Fully informed about, and in control of, something; up to speed with."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9faefe14-c18b-4843-b0eb-366bef8dbf97",
                                                "sense_id": "bf86e0f4-dc73-3c59-8f6d-cc6b378226bd",
                                                "text": "I have sorted out the problems and am now on top of the situation."
                                            },
                                            {
                                                "example_id": "79bdadb3-6bf1-4785-9638-86122f6f35e3",
                                                "sense_id": "bf86e0f4-dc73-3c59-8f6d-cc6b378226bd",
                                                "text": "You will need to get on top of your nutrition in addition to training for washboard abs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3ef1c81-74d8-4089-9bd5-0ac842e04682",
                        "source_entry_id": "0af4dbcf-9d6e-312d-a3cc-2ff052f89f6f",
                        "source_sense_description": "над",
                        "target_lang_word": "atop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3c7d7be-c04b-36a8-bd51-3c78d08c4968",
                                        "entry_id": "21095590-8051-3fcc-a001-eb97c1c8bb00",
                                        "glosses": [
                                            "On the top of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11756001-feef-4357-b937-c167a9ac38da",
                                                "sense_id": "d3c7d7be-c04b-36a8-bd51-3c78d08c4968",
                                                "text": "He sat atop the mountain, waiting for the end of the world."
                                            },
                                            {
                                                "example_id": "a3dd5317-60b4-4d63-8d6d-520700faef54",
                                                "sense_id": "d3c7d7be-c04b-36a8-bd51-3c78d08c4968",
                                                "text": "For example, when trailers containing new automobiles were first piggybacked two areas of potential damage became evident: (1) diesel locomotive exhaust left a film of oil on the new autos; and (2) auto windshields could be scarred or cracked by the metal-tipped \"tell-tales\" which warn men atop trains of oncoming bridges or tunnels."
                                            },
                                            {
                                                "example_id": "a6db047e-4ab5-430e-88a0-96ce82c60322",
                                                "sense_id": "d3c7d7be-c04b-36a8-bd51-3c78d08c4968",
                                                "text": "A virtue is made out of a necessity, with the child feeling far more atop and master of his oddness, his behavior now deliberate or even clever."
                                            },
                                            {
                                                "example_id": "97800277-70a0-4745-b39e-ccbdb4a65eaf",
                                                "sense_id": "d3c7d7be-c04b-36a8-bd51-3c78d08c4968",
                                                "text": "\"And other things,\" she echoed, nodding slowly and resting her body a little more atop him again."
                                            },
                                            {
                                                "example_id": "75d2af38-4e18-44bc-beb9-242d0deb3f34",
                                                "sense_id": "d3c7d7be-c04b-36a8-bd51-3c78d08c4968",
                                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\n“Monotheism was born here,” Goren tells me atop a cliff overlooking the sheet of iron-colored water."
                                            },
                                            {
                                                "example_id": "27f83aa8-0d21-4bf5-a593-9770513ff0fe",
                                                "sense_id": "d3c7d7be-c04b-36a8-bd51-3c78d08c4968",
                                                "text": "The leading voices of the womanosphere are using a similar strategy. As Brittany Hugoboom put it in an op–ed for the rightwing outlet Quillette: “Conservatives will never win if they imagine themselves as combatants atop defensive battlements, hurling abuse on the mass media. We need to involve ourselves in the creation of pop culture.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17197d17-9db4-3322-8122-9d02968fb623",
                                        "entry_id": "21095590-8051-3fcc-a001-eb97c1c8bb00",
                                        "glosses": [
                                            "On the top (with of)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53a83dd5-4b39-476f-8f6a-125ccc479271",
                                                "sense_id": "17197d17-9db4-3322-8122-9d02968fb623",
                                                "text": "He sat atop of the mountain, waiting for the end of the world."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "atop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1dd6ca1-1117-3b79-af5a-a163f2937ebd",
                                        "entry_id": "c2ab1ae5-7ea5-3c52-87bc-4ae32c1bf1aa",
                                        "glosses": [
                                            "On, to, or at the top."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ae9318b-fe6b-4453-9d8a-197390cc2ec1",
                                                "sense_id": "b1dd6ca1-1117-3b79-af5a-a163f2937ebd",
                                                "text": "He has a handsome face, still bearded in the midst of a mostly clean-shaving nation, and with the white hairs prevalent on the cheeks and temples; his head is bald atop, though hardly from the uneasiness of wearing a crown."
                                            },
                                            {
                                                "example_id": "0d6f5bdc-a17d-462c-8092-e10052f89d96",
                                                "sense_id": "b1dd6ca1-1117-3b79-af5a-a163f2937ebd",
                                                "text": "The envoy found the French king playing the part of horse while his young son rode atop."
                                            },
                                            {
                                                "example_id": "1f2a466b-a688-4b8b-ba76-4e5e8eeaf988",
                                                "sense_id": "b1dd6ca1-1117-3b79-af5a-a163f2937ebd",
                                                "text": "Everything large or small is carried atop out of habit as much as necessity, like a delightful but defiant challenge to the laws of gravity."
                                            },
                                            {
                                                "example_id": "7bac727d-775b-487c-94f1-a4615c44ae04",
                                                "sense_id": "b1dd6ca1-1117-3b79-af5a-a163f2937ebd",
                                                "text": "Probably cuddled up, spooning. Netflix auto-playing atop their shared covers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "3296ff02-6577-4a06-9f01-b9f7b9bc78e9",
