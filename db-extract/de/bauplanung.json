                ],
                "senses": [
                    {
                        "sense_id": "88840ab3-01d6-34c4-a6f8-86adab613c9e",
                        "entry_id": "f3cb72e6-8d0d-3259-bd33-4e3d81dead8f",
                        "glosses": [
                            "Planen eines Bauvorhabens; Prozess, die Errichtung eines neuen Hauses oder Gebäudes vorzubereiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "262d0b8a-a370-4a1a-b013-77ac95420c4a",
                                "sense_id": "88840ab3-01d6-34c4-a6f8-86adab613c9e",
                                "text": "„Vermutlich könnten lediglich die Bauplanung und die Bauaufsicht dorthin ziehen, während das Rechtsamt oder der Denkmalschutz anderswo untergebracht werden müßten.“"
                            },
                            {
                                "example_id": "807d4f25-5d19-4140-bb3e-778da452259f",
                                "sense_id": "88840ab3-01d6-34c4-a6f8-86adab613c9e",
                                "text": "„Wie Bremmer darlegte, ist die Bauplanung seit der Vorstellung des Entwurfs verändert worden: So soll an der Frankfurter Straße kein zweistöckiger Gebäuderiegel entstehen.“"
                            },
                            {
                                "example_id": "6574814d-6d03-4cfe-bab5-a3a1478f6ce8",
                                "sense_id": "88840ab3-01d6-34c4-a6f8-86adab613c9e",
                                "text": "„Erst wenn anschließend die Bauplanung vorliegt, soll ein Eröffnungstermin genannt werden.“"
                            },
                            {
                                "example_id": "380448d8-0cff-45a5-b222-56fc37a235a7",
                                "sense_id": "88840ab3-01d6-34c4-a6f8-86adab613c9e",
                                "text": "„‚Die Bauplanung ist unter aller Kanone‘, schimpft er und verweist auf die falsche Verlegung der neuen U-Bahn-Schienen im unteren Teil der Eckenheimer Landstraße.“"
                            },
                            {
                                "example_id": "1d1fd032-1fcf-49fe-bd23-895559be0adc",
                                "sense_id": "88840ab3-01d6-34c4-a6f8-86adab613c9e",
                                "text": "„Die konkrete Bauplanung und -ausführung hänge dann von den Zeitplänen der Bundesländer sowie den Unternehmen ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
