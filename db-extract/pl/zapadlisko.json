                                "target_senses": [
                                    {
                                        "sense_id": "b29ea9a7-00e8-31a1-b386-cfec1bed04b0",
                                        "entry_id": "24f334bc-a485-3bdd-bfdc-8a282e113c23",
                                        "glosses": [
                                            "A hole formed in soluble rock by the action of water, serving to conduct surface water to an underground passage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "826ad522-d7af-4224-b28c-15bff6c13e2b",
                                                "sense_id": "b29ea9a7-00e8-31a1-b386-cfec1bed04b0",
                                                "text": "A sinkhole suddenly opened up beneath the track of a heavy freight route in the eastern United States. Golfers playing the 13th hole at Hartford, Connecticut, had a new obstacle to tackle: a section of track suspended in mid-air after heavy rainfall in the aftermath of Storm Ida."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c275b88c-27f1-3bbc-a3c4-afe69199ce21",
                                        "entry_id": "24f334bc-a485-3bdd-bfdc-8a282e113c23",
                                        "glosses": [
                                            "A depressed area in which waste or drainage collects."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51164b7e-454c-319b-9025-d5d5ee30f28d",
                                        "entry_id": "24f334bc-a485-3bdd-bfdc-8a282e113c23",
                                        "glosses": [
                                            "A hole in the playfield that rewards the player when the ball is guided into it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf063a6c-28c3-4af4-b8b0-889032c55b64",
                                                "sense_id": "51164b7e-454c-319b-9025-d5d5ee30f28d",
                                                "text": "Pro Pinball is as authentic as pinball has ever been on the PC. It's all here, from the ramps, bumpers and sinkholes to the satisfying \"clack\" when you make the high-score list."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fcec66f-78ea-3399-bd4c-462faa48ad45",
                                        "entry_id": "24f334bc-a485-3bdd-bfdc-8a282e113c23",
                                        "glosses": [
                                            "A domain name server that has been configured to hand out non-routeable addresses for all domains, so that every computer that uses it will fail to get access to the real website."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcd4c84b-4390-3570-8a8b-209761acb6c1",
                                        "entry_id": "24f334bc-a485-3bdd-bfdc-8a282e113c23",
                                        "glosses": [
                                            "An attack which redirects requests, whether network or memory accesses, to a new location defined by the attacker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
