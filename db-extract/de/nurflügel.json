                "senses": [
                    {
                        "sense_id": "c46bfe29-a3d1-3835-bef4-f1cf4e46caeb",
                        "entry_id": "57345d43-9e59-381c-a234-dd84e182334c",
                        "glosses": [
                            "Flugzeug, bei dem Tragflächen und Rumpf eine Einheit bilden, das ohne Höhenruder auskommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "568c697e-bbfb-4faa-b052-0a9fe56a4d3f",
                                "sense_id": "c46bfe29-a3d1-3835-bef4-f1cf4e46caeb",
                                "text": "Der derzeit bekannteste Nurflügel ist der Northrop B-2 Tarnkappenbomber."
                            },
                            {
                                "example_id": "222ab9fa-dbb9-40ce-b796-c0ad4b34dc83",
                                "sense_id": "c46bfe29-a3d1-3835-bef4-f1cf4e46caeb",
                                "text": "„Ein weiteres ungewöhnliches Flugzeug ist zumindest schon für den optionalen Einbau eines Elektromotors vorbereitet. Es ist ein Nurflügel von Horten Aircraft aus Eisenach.“"
                            },
                            {
                                "example_id": "e60883d0-5bcf-45a8-8eed-eebb20dc71c3",
                                "sense_id": "c46bfe29-a3d1-3835-bef4-f1cf4e46caeb",
                                "text": "„Als besonders vielversprechend hat sich das Konzept des Nurflügels (Flying Wing, Blended Wing Body) erwiesen.“"
                            },
                            {
                                "example_id": "d6ab5e09-7cd9-4957-86c4-3a9b60007021",
                                "sense_id": "c46bfe29-a3d1-3835-bef4-f1cf4e46caeb",
                                "text": "„Für Hitlers Luftwaffenchef, Reichsmarschall Hermann Göring, entwickelten die Horten-Brüder das Konzept für einen sechsstrahligen Nurflügel-Fernbomber.“"
                            },
                            {
                                "example_id": "f1310ae8-8b19-4bfa-9bd8-8969e7b9e8bd",
                                "sense_id": "c46bfe29-a3d1-3835-bef4-f1cf4e46caeb",
                                "text": "„Das absolute Standardwerk über die Horten Nurflügel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
