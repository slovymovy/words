                        "form": "die Briefkastenfirmen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57055ea7-cf3d-356a-8650-fa2945ff548b",
                        "entry_id": "ea5e921d-e7bc-391f-91e5-12bd38cfcef3",
                        "glosses": [
                            "wirtschaftliches Unternehmen, das an seiner als Hauptsitz gemeldeten Adresse lediglich einen Briefkasten unterhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b14fb6-06fa-48da-9db8-c1f5594aba25",
                                "sense_id": "57055ea7-cf3d-356a-8650-fa2945ff548b",
                                "text": "Wenn ein Unternehmen ein Steuerparadies wie die Cayman-Inseln als Hauptsitz angibt, kann man fast davon ausgehen, dass es sich um eine Briefkastenfirma handelt."
                            },
                            {
                                "example_id": "2732cec2-47ce-4384-abae-ee8e91ec9e45",
                                "sense_id": "57055ea7-cf3d-356a-8650-fa2945ff548b",
                                "text": "Viele Großkonzerne haben ihre europäische Zentrale in den Niederlanden. Denn dort bekommen internationale Unternehmen große Steuervorteile. Deswegen sind diese Zentralen oft auch nur Briefkastenfirmen."
                            },
                            {
                                "example_id": "7dd856f9-21da-4564-9ca8-09e32e11036f",
                                "sense_id": "57055ea7-cf3d-356a-8650-fa2945ff548b",
                                "text": "„Viele internationale Geldinstitute und tausende von Briefkastenfirmen sorgten dafür, dass das Geld floss.“"
                            },
                            {
                                "example_id": "ac1b7270-f702-43c7-b5e6-95488abeb4b9",
                                "sense_id": "57055ea7-cf3d-356a-8650-fa2945ff548b",
                                "text": "„Er sprach von Luxemburg wie von einem verlorenen Paradies, während es doch bekanntlich ein winziges, mittelprächtiges Ländchen ist, ohne genauere Eigenschaften – nicht mal ein Land eigentlich, eher eine Ansammlung von Phantombüros, von Briefkastenfirmen auf Steuerflucht, in Parks verstreut.“"
                            },
                            {
                                "example_id": "5d6575f0-06e2-4388-8b00-8ef70b049fc0",
                                "sense_id": "57055ea7-cf3d-356a-8650-fa2945ff548b",
                                "text": "„Wäre es ein Geschäft gewesen mit Währung und Preisen, meine Großmutter hätte über eine milliardenschwere Holding mit Briefkastenfirmen auf den Cayman Islands verfügt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
