{
    "word_family": [
        "hobbyist",
        "hobbyism",
        "hobbyhorse"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5aa95e34-0f3c-3be3-889b-56df83179c48",
                    "sense_definition": "An activity that one enjoys doing in one's spare time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I like to collect stamps from different countries as a <w>hobby</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нравится собирать марки из разных стран в качестве <w>хобби</w>.",
                                "zh": "我喜欢收集各国邮票作为<w>爱好</w>。"
                            }
                        },
                        {
                            "text": "She decided to take up a new <w>hobby</w> like painting or gardening.",
                            "target_lang_translations": {
                                "ru": "Она решила найти себе новое <w>увлечение</w>, например, живопись или садоводство.",
                                "zh": "她决定培养一项新<w>爱好</w>，比如绘画或园艺。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pastime",
                        "avocation",
                        "pursuit",
                        "amusement",
                        "interest"
                    ],
                    "antonyms": [
                        "work"
                    ],
                    "common_phrases": [
                        "take up a hobby",
                        "favorite hobby"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность или занятие, которым человек занимается в свободное время ради удовольствия",
                        "zh": "在业余时间为了消遣而从事的活动"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хо́бби",
                                "target_lang_sense_clarification": "любимое занятие"
                            },
                            {
                                "target_lang_word": "увлече́ние",
                                "target_lang_sense_clarification": "занятие для души"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爱好",
                                "target_lang_sense_clarification": "个人喜爱的活动"
                            },
                            {
                                "target_lang_word": "嗜好",
                                "target_lang_sense_clarification": "特别喜爱的活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "790a830a-0282-3a34-a5fd-266d7ca52230",
                    "sense_definition": "A favorite topic or subject that one frequently talks about.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "topic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is talking about politics again, which is his pet <w>hobby</w>.",
                            "target_lang_translations": {
                                "ru": "Он снова говорит о политике, это его любимый <w>конёк</w>.",
                                "zh": "他又在谈论政治了，这可是他的<w>心头好</w>。"
                            }
                        },
                        {
                            "text": "Don't get him started on his favorite <w>hobby</w>, or he will talk for hours.",
                            "target_lang_translations": {
                                "ru": "Не заводи с ним речь о его любимом <w>коньке</w>, иначе он будет говорить часами.",
                                "zh": "别让他聊起他最喜欢的<w>话题</w>，否则他会说上几个小时。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hobby horse"
                    ],
                    "common_phrases": [
                        "pet hobby",
                        "ride a hobby"
                    ],
                    "target_lang_definitions": {
                        "ru": "Излюбленная тема или предмет, о котором человек часто говорит",
                        "zh": "一个人经常谈论的喜爱话题或主题"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конёк",
                                "target_lang_sense_clarification": "любимая тема разговора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口头禅",
                                "target_lang_sense_clarification": "常挂在嘴边的话题"
                            },
                            {
                                "target_lang_word": "心头好",
                                "target_lang_sense_clarification": "特别钟爱的话题"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "137067fa-4b5c-30d2-bef2-7bfa3e54027a",
                    "sense_definition": "A small falcon of the genus Falco, especially the Eurasian hobby.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birdwatcher spotted a <w>hobby</w> flying swiftly over the trees.",
                            "target_lang_translations": {
                                "ru": "Орнитолог заметил <w>чеглока</w>, стремительно летящего над деревьями.",
                                "zh": "观鸟者发现一只<w>燕隼</w>正迅速掠过树梢。"
                            }
                        },
                        {
                            "text": "A <w>hobby</w> is known for catching dragonflies in mid-air.",
                            "target_lang_translations": {
                                "ru": "<w>Чеглок</w> известен тем, что ловит стрекоз на лету.",
                                "zh": "<w>燕隼</w>以在空中捕食蜻蜓而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая хищная птица рода соколов, особенно обыкновенный чеглок",
                        "zh": "隼属的一种小型猛禽，尤指欧亚隼"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чегло́к",
                                "target_lang_sense_clarification": "вид сокола"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "燕隼",
                                "target_lang_sense_clarification": "一种小型猛禽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1864c90-390b-30bd-ab60-4a100ba05a43",
                    "sense_definition": "An extinct breed of horse native to the British Isles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Knights often rode a <w>hobby</w> because of its agility.",
                            "target_lang_translations": {
                                "ru": "Рыцари часто ездили на <w>хобби</w> из-за их маневренности.",
                                "zh": "骑士们常骑<w>霍比马</w>，因为这种马非常敏捷。"
                            }
                        },
                        {
                            "text": "The Irish <w>hobby</w> was famous for its speed and endurance.",
                            "target_lang_translations": {
                                "ru": "Ирландское <w>хобби</w> славилось своей скоростью и выносливостью.",
                                "zh": "爱尔兰<w>霍比马</w>以速度和耐力著称。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical breed"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вымершая порода небольших лошадей, обитавшая на Британских островах",
                        "zh": "不列颠群岛的一种已灭绝的小型马品种"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хобби",
                                "target_lang_sense_clarification": "порода лошадей"
                            },
                            {
                                "target_lang_word": "конёк",
                                "target_lang_sense_clarification": "маленькая лошадь (устар.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "霍比马",
                                "target_lang_sense_clarification": "历史上的小型马品种"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7f58a3ab-4bce-328f-ab51-9be8c2c03379",
                    "sense_definition": "An English surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Hobby</w> lives down the street from our house.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Хобби</w> живет вниз по улице от нашего дома.",
                                "zh": "<w>霍比</w>先生就住在我们那条街的下游。"
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Hobby</w> yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера я встретил женщину по имени Сара <w>Хобби</w>.",
                                "zh": "我昨天遇到了一位名叫莎拉·<w>霍比</w>的女士。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия",
                        "zh": "一个英语姓氏"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хобби",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "霍比",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}