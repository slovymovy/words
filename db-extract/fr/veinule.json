                    {
                        "sense_id": "16beb48e-97da-34c3-80c3-29a346529d41",
                        "entry_id": "3c0c8b72-4c3f-33f9-b201-5773bc87dbdd",
                        "glosses": [
                            "Petite veine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "844a356d-1bfe-46e1-9b2a-14e4e03ace9c",
                                "sense_id": "16beb48e-97da-34c3-80c3-29a346529d41",
                                "text": "Portion du foie du Porc, injectée, destinée à montrer les rapports des conduits biliaires et des veinules portales."
                            },
                            {
                                "example_id": "11e3b652-8d63-43e1-9882-759d11c3396a",
                                "sense_id": "16beb48e-97da-34c3-80c3-29a346529d41",
                                "text": "Deux personnes se trouvaient dans la voiture à roues basses : un jeune homme qui conduisait, et un vieillard à cheveux blancs, au visage pâle coupé de veinules rouges sur les joues."
                            }
                        ]
                    },
                    {
                        "sense_id": "db9ae2da-c618-3d29-94a4-3d32a5871531",
                        "entry_id": "3c0c8b72-4c3f-33f9-b201-5773bc87dbdd",
                        "glosses": [
                            "Forme ayant l'apparence d'une petite veine."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "61351784-733c-4403-a271-3f7103b479ee",
                                "sense_id": "db9ae2da-c618-3d29-94a4-3d32a5871531",
                                "text": "[…] des tiroirs ouverts se dégage une forte odeur de renfermé, de moisi, ils contiennent plusieurs énormes volumes reliés en carton recouvert d’un papier noir à veinules jaunâtres…"
                            }
                        ]
                    },
                    {
                        "sense_id": "a8f32e75-55d5-38d7-a664-3fcba2ee98db",
