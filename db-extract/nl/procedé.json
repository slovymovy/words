                                    {
                                        "sense_id": "6900e522-6d7d-3fee-ab10-5152b4f32ff2",
                                        "entry_id": "c4445770-c694-33f5-8dd7-ee1672346825",
                                        "glosses": [
                                            "A particular method for performing a task."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34cfdce4-ab06-4489-8759-2e06c893b92e",
                                                "sense_id": "6900e522-6d7d-3fee-ab10-5152b4f32ff2",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains. Isolating a city’s effluent and shipping it away in underground sewers has probably saved more lives than any medical procedure except vaccination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "166c1c71-4d2f-36c3-bd87-fb37337509b4",
                                        "entry_id": "c4445770-c694-33f5-8dd7-ee1672346825",
                                        "glosses": [
                                            "A series of small tasks or steps taken to accomplish an end."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4ff1b3c-4885-36d3-92ef-85962e12f2ad",
                                        "entry_id": "c4445770-c694-33f5-8dd7-ee1672346825",
                                        "glosses": [
                                            "The set of established forms or methods of an organized body for accomplishing a certain task or tasks."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "906fd5f7-4e08-4e89-9835-64bc5d38e380",
                                                "sense_id": "f4ff1b3c-4885-36d3-92ef-85962e12f2ad",
                                                "text": "Ensure that you follow procedure when accessing customers' personal information."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a33dfde8-ce91-3aa7-8089-3ebb6cf4d822",
                                        "entry_id": "c4445770-c694-33f5-8dd7-ee1672346825",
                                        "glosses": [
                                            "The steps taken in an action or other legal proceeding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "697848da-bd03-409e-a534-d4c113453be8",
                                                "sense_id": "a33dfde8-ce91-3aa7-8089-3ebb6cf4d822",
                                                "text": "Gracious procedures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d714e8a1-e4c5-38ac-96a6-847719a94e09",
                                        "entry_id": "c4445770-c694-33f5-8dd7-ee1672346825",
                                        "glosses": [
                                            "That which results; issue; product."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be730df8-df6d-460f-afeb-a94dee9e2667",
                                                "sense_id": "d714e8a1-e4c5-38ac-96a6-847719a94e09",
                                                "text": "There is not any known Substance, but Earth, and the Procedure of Earth (as Tile, Stone, &c.) that yeeldeth any Moss or Herby Substance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d741597-9360-3e5a-a844-a50735b3ba61",
                                        "entry_id": "c4445770-c694-33f5-8dd7-ee1672346825",
                                        "glosses": [
                                            "A subroutine or function coded to perform a specific task, but does not return a value."
                                        ],
