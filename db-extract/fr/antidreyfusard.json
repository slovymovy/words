                ],
                "senses": [
                    {
                        "sense_id": "4076bed7-5ea1-3c9e-b26d-a4555bbd5777",
                        "entry_id": "6511788c-4d0e-38b4-9cfb-9c0a7f2d7afd",
                        "glosses": [
                            "Qui s'opposa à la libération, à la réhabilitation du capitaine Alfred Dreyfus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f1a6ba-dd11-4113-8a32-c219b8b32ab3",
                                "sense_id": "4076bed7-5ea1-3c9e-b26d-a4555bbd5777",
                                "text": "Il ne manquait plus qu'un signe de l'universel renversement des choses. Nous l'avons. On nous annonce que Dreyfus est cocardier, militariste, partisan de l'infaillibilité de conseils de Guerre, antidreyfusard en un mot."
                            },
                            {
                                "example_id": "af8b1c35-1af1-4c92-8cfd-ff33cf183625",
                                "sense_id": "4076bed7-5ea1-3c9e-b26d-a4555bbd5777",
                                "text": "[…]; on n'a pas été peu surpris de voir Brunetière, qui avait été un des admirateurs des apaches antidreyfusards, conseiller la soumission ; c'est que l'expérience l'avait éclairé sur les conséquences de la violence."
                            },
                            {
                                "example_id": "072a0e76-df57-43ad-bf42-5bc0b9045c83",
                                "sense_id": "4076bed7-5ea1-3c9e-b26d-a4555bbd5777",
                                "text": "La déclaration de cette incompatibilité me fit croire que M. de Charlus était plus antidreyfusard qu'aucune des personnes que j'avais rencontrées."
                            }
                        ]
                    }
                ],
