                "senses": [
                    {
                        "sense_id": "d72f7e96-5ba9-37c0-a9bb-166672288a94",
                        "entry_id": "56f20079-0f1a-3ddf-a832-3549520f6c37",
                        "glosses": [
                            "To produce a low-pitched beeping sound."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "72ac37ba-985b-496e-8cc8-41cbbe27e253",
                                "sense_id": "d72f7e96-5ba9-37c0-a9bb-166672288a94",
                                "text": "The music on “LP” is almost entirely unnatural, booping and puffing, buzzing and ticking in tones no acoustic instrument would make."
                            }
                        ]
                    },
                    {
                        "sense_id": "48a1332b-1ab1-3daa-8d70-be417a72d40e",
                        "entry_id": "56f20079-0f1a-3ddf-a832-3549520f6c37",
                        "glosses": [
                            "To strike gently or playfully; to bop (especially on the nose)."
                        ],
                        "tags": [
                            "colloquial",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f5d001e6-1dff-4bea-88a8-8f3f7b5a224b",
                                "sense_id": "48a1332b-1ab1-3daa-8d70-be417a72d40e",
                                "text": "He spun around and booped me on the nose."
                            }
                        ]
                    }
