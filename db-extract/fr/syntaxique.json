    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2ef86277-5088-31d0-be7b-2ad5e2a21170",
                "word": "syntaxique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d0e57f2c-99b8-4fcd-afb5-17968096c831",
                        "entry_id": "2ef86277-5088-31d0-be7b-2ad5e2a21170",
