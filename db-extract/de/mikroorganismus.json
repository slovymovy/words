                    {
                        "form_id": "bbf713de-6846-415f-86b9-94e02f245a9c",
                        "entry_id": "466af1c2-02c5-31e1-bba4-6b6884ac111b",
                        "tags": [
                            "plural",
                            "dative"
                        ],
                        "form": "den Mikroorganismen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f96df1c6-9219-346b-a626-4e090fb14290",
                        "entry_id": "466af1c2-02c5-31e1-bba4-6b6884ac111b",
                        "glosses": [
                            "Micro-organisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d283585c-9c68-4308-9cc7-c175e754ad8d",
                                "sense_id": "f96df1c6-9219-346b-a626-4e090fb14290",
                                "text": "Die Mikrobiologie befasst sich mit Mikroorganismen.",
                                "translation": "La micro-biologie se penche sur les micro-organismes."
                            },
                            {
                                "example_id": "bc94e6a1-6f36-4961-99f0-9a163e7496f4",
                                "sense_id": "f96df1c6-9219-346b-a626-4e090fb14290",
                                "text": "Dass die Unterwäsche (beim Waschen) nicht steril wird, also frei von jeglichen Mikroorganismen, ist klar. Doch das ist sie ohnehin nicht mehr, sobald ich sie überstreife - und das soll sie auch gar nicht sein.",
                                "translation": "Il est évident que les sous-vêtements ne deviennent pas stériles (lors du lavage), c'est-à-dire exempts de tout micro-organisme. Mais ils ne le sont de toute façon plus dès que je les enfile - et ils ne doivent pas l'être."
                            },
                            {
                                "example_id": "f1c8151b-6289-4b49-bf4a-420fd96d2100",
                                "sense_id": "f96df1c6-9219-346b-a626-4e090fb14290",
                                "text": "Manchmal wird empfohlen, zusätzlich Lebensmittel oder Nahrungsergänzungsmittel mit probiotischen Mikroorganismen (Probiotika) zu verzehren. Studien zeigen jedoch, dass sie die Dauer des Durchfalls wahrscheinlich nicht verkürzen.",
                                "translation": "Il est parfois recommandé de consommer des aliments ou des compléments alimentaires contenant des micro-organismes probiotiques. Cependant, des études montrent qu'ils ne réduisent probablement pas la durée de la diarrhée."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
