                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea94f82f-78bc-3dde-b586-f693bdce4c0f",
                                        "entry_id": "9a422f93-8a75-3b4f-b7f8-76695c20c202",
                                        "glosses": [
                                            "That which is taken from another; something captured; a thing seized by force, stratagem, or superior power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d712df61-3449-4095-8259-8c9dd77b5977",
                                                "sense_id": "ea94f82f-78bc-3dde-b586-f693bdce4c0f",
                                                "text": "[…] wherefore he now begunne\nTo challenge her anew, as his owne prize,\nWhom formerly he had in battell wonne,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acf483b2-3c40-31eb-8cf1-395d558a7fc0",
                                        "entry_id": "9a422f93-8a75-3b4f-b7f8-76695c20c202",
                                        "glosses": [
                                            "Anything captured by a belligerent using the rights of war; especially, property captured at sea in virtue of the rights of war, as a vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1802472-c279-4533-ab1d-19adf6a6823e",
                                                "sense_id": "acf483b2-3c40-31eb-8cf1-395d558a7fc0",
                                                "text": "Having taken all the Treasure on Board their own Ships, and plundered their Prize of every Thing elſe they either wanted or liked, they let her go; ſhe not being able to continue her Voyage, returned back: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae9f62d-558f-3d03-af68-dcdf000d2f43",
                                        "entry_id": "9a422f93-8a75-3b4f-b7f8-76695c20c202",
                                        "glosses": [
                                            "An honour or reward striven for in a competitive contest; anything offered to be competed for, or as an inducement to, or reward of, effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1179e80-d35e-435a-bc2f-f17808904bb3",
                                                "sense_id": "2ae9f62d-558f-3d03-af68-dcdf000d2f43",
                                                "text": "I fought and conquer’d, yet have lost the prize."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ace1b65-a61e-3461-893f-816f279d09ab",
                                        "entry_id": "9a422f93-8a75-3b4f-b7f8-76695c20c202",
                                        "glosses": [
                                            "That which may be won by chance, as in a lottery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b1b2bd-335a-435f-94a4-4eb752368782",
                                                "sense_id": "3ace1b65-a61e-3461-893f-816f279d09ab",
                                                "text": "Cecil Rhodes […] was never tired of impressing upon one that the fact of being an Englishman was “the greatest prize in the lottery of life,” and that it was that thought which always sustained him when he was troubled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0d75d64-feec-370c-8a0a-0bca5a93fe6e",
                                        "entry_id": "9a422f93-8a75-3b4f-b7f8-76695c20c202",
                                        "glosses": [
                                            "Anything worth striving for; a valuable possession held or in prospect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "effbbf2d-d76b-4561-abd6-13eb396cf7b3",
                                                "sense_id": "e0d75d64-feec-370c-8a0a-0bca5a93fe6e",
                                                "text": "I press toward the mark for the prize of the high calling of God in Christ Jesus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aa30a0b-6ef5-3c12-a3b4-e49289ec8213",
                                        "entry_id": "9a422f93-8a75-3b4f-b7f8-76695c20c202",
                                        "glosses": [
                                            "A contest for a reward; competition."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8855fb8-ff61-4bc0-b536-b9ab8343e1f2",
                                                "sense_id": "9aa30a0b-6ef5-3c12-a3b4-e49289ec8213",
                                                "text": "Like one of two contending in a prize,\nThat thinks he hath done well in people's eyes […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "075cb82e-2b2c-3850-a7ba-800fd779c466",
                                        "entry_id": "9a422f93-8a75-3b4f-b7f8-76695c20c202",
                                        "glosses": [
                                            "A lever; a pry; also, the hold of a lever."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "prize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be95cd6d-b301-35cf-bf2b-d76d9224db3f",
                                        "entry_id": "9133659e-540a-36ed-a15e-dfd7c099edf0",
                                        "glosses": [
                                            "To consider highly valuable; to esteem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e552b64-fed2-4224-84f1-3f77bd6fcec7",
                                                "sense_id": "be95cd6d-b301-35cf-bf2b-d76d9224db3f",
                                                "text": "[…] I\nBeyond all limit of what else i’ the world\nDo love, prize, honour you."
                                            },
                                            {
                                                "example_id": "c67d4a20-1fd9-4ce4-8d3a-81cd61f6796b",
                                                "sense_id": "be95cd6d-b301-35cf-bf2b-d76d9224db3f",
                                                "text": "I pris’d your Person, but your Crown disdain."
                                            },
                                            {
                                                "example_id": "02ab28e8-4228-4eee-811e-d84125520c10",
                                                "sense_id": "be95cd6d-b301-35cf-bf2b-d76d9224db3f",
                                                "text": "‘[…] An old broken cup has no value. No one prizes it.’\n‘I prize it. It’s my museum, not yours.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f180ef-a2f1-3808-b183-7cf1e7caafc8",
                                        "entry_id": "9133659e-540a-36ed-a15e-dfd7c099edf0",
                                        "glosses": [
                                            "To set or estimate the value of; to appraise; to price; to rate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd1295ea-868b-463c-8a12-42678cc44846",
                                                "sense_id": "a4f180ef-a2f1-3808-b183-7cf1e7caafc8",
                                                "text": "[…] no life,\nI prize it not a straw, but for mine honour,"
                                            },
                                            {
                                                "example_id": "245c7fef-1834-4ef9-96c3-c3bce716b90b",
                                                "sense_id": "a4f180ef-a2f1-3808-b183-7cf1e7caafc8",
                                                "text": "[…] a goodly price that I was prized at."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9bb37e8-40c8-3819-b506-7260e041b699",
                                        "entry_id": "9133659e-540a-36ed-a15e-dfd7c099edf0",
                                        "glosses": [
                                            "To move with a lever; to force up or open; to prise or pry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb5b1210-a44e-41a1-9cd3-68733e5e904f",
                                                "sense_id": "b9bb37e8-40c8-3819-b506-7260e041b699",
                                                "text": "‘Find some other black boxes to prize open.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b94ecad2-0313-3e50-a799-afa5b6b1d0a5",
                                        "entry_id": "9133659e-540a-36ed-a15e-dfd7c099edf0",
                                        "glosses": [
                                            "To compete in a prizefight."
                                        ],
