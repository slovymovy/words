                                "target_senses": [
                                    {
                                        "sense_id": "1536b83a-512b-3bdb-8eba-14d156a5f1a3",
                                        "entry_id": "b99ea0c3-3602-3d18-a55a-1107e53734ed",
                                        "glosses": [
                                            "vrouw die kwellingen doorstaat of het eigen leven offert op religieuze grond"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8d3aa5c-a71d-4e8e-aeb3-157f21c7a7c7",
                                                "sense_id": "1536b83a-512b-3bdb-8eba-14d156a5f1a3",
                                                "text": "Eén ding wil ik nog zo graag: vergeef me, vergeef me alles. Ik ben ontzettend slecht, maar mijn kindermeid heeft me altijd verteld van die heilige martelares - hoe heette ze ook alweer? - die nog slechter was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "004b5143-c330-328c-b3dc-553f3fc09393",
