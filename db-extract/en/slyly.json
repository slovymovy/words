                                            {
                                                "example_id": "10b42820-e88e-4cc8-90b6-fc139d711f05",
                                                "sense_id": "df773488-ca11-3302-a048-e21c19d097aa",
                                                "text": "Dann lehnte der Stahlmagnat sich mit einem verschmitzten Lächeln im Sessel zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
