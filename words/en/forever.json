{
    "word_family": [
        "forevermore"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ae7159a4-56ca-3777-8118-43fdbd72e171",
                    "sense_definition": "For all future time; for eternity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I promise that I will love you <w>forever</w>.",
                            "target_lang_translations": {
                                "ru": "Я обещаю, что буду любить тебя <w>вечно</w>.",
                                "zh": "我保证我会<w>永远</w>爱你。"
                            }
                        },
                        {
                            "text": "Nothing in this world lasts <w>forever</w>.",
                            "target_lang_translations": {
                                "ru": "Ничто в этом мире не длится <w>вечно</w>.",
                                "zh": "这世上没有什么能持续到<w>永远</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "always",
                        "eternally",
                        "permanently",
                        "for good",
                        "evermore",
                        "for ever and ever",
                        "perpetually"
                    ],
                    "antonyms": [
                        "never"
                    ],
                    "common_phrases": [
                        "forever and ever",
                        "gone forever",
                        "last forever",
                        "live forever"
                    ],
                    "target_lang_definitions": {
                        "ru": "На все будущие времена; навечно.",
                        "zh": "在未来的所有时间里；直到永恒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "навсегда",
                                "target_lang_sense_clarification": "окончательно, безвозвратно"
                            },
                            {
                                "target_lang_word": "вечно",
                                "target_lang_sense_clarification": "бесконечно во времени"
                            },
                            {
                                "target_lang_word": "навеки",
                                "target_lang_sense_clarification": "поэтическое или усиленное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "永远",
                                "target_lang_sense_clarification": "表示在未来一直如此，常用于感情、状态等"
                            },
                            {
                                "target_lang_word": "永久",
                                "target_lang_sense_clarification": "较书面，表示直到永久"
                            },
                            {
                                "target_lang_word": "一辈子",
                                "target_lang_sense_clarification": "强调一辈子不变，常用于关系或承诺"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4febebd4-6573-3f92-8155-0c5e2993b0de",
                    "sense_definition": "For a very long time; a seeming eternity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took <w>forever</w> to find a parking space downtown.",
                            "target_lang_translations": {
                                "ru": "Поиск парковочного места в центре занял <w>целую вечность</w>.",
                                "zh": "在市中心找停车位花了<w>好久</w>。"
                            }
                        },
                        {
                            "text": "We had to wait <w>forever</w> for the bus to arrive.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось ждать автобуса <w>целую вечность</w>.",
                                "zh": "我们等公交车等了<w>半天</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "endlessly",
                        "ages",
                        "eternity"
                    ],
                    "common_phrases": [
                        "take forever",
                        "wait forever"
                    ],
                    "target_lang_definitions": {
                        "ru": "В течение очень долгого времени; целая вечность (преувеличение).",
                        "zh": "很长一段时间；像过了很久很久一样，常带夸张语气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целую вечность",
                                "target_lang_sense_clarification": "разговорное преувеличение"
                            },
                            {
                                "target_lang_word": "очень долго",
                                "target_lang_sense_clarification": "нейтральное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好久",
                                "target_lang_sense_clarification": "口语，表示时间拖得很长"
                            },
                            {
                                "target_lang_word": "半天",
                                "target_lang_sense_clarification": "夸张地说等了很久、花了很久"
                            },
                            {
                                "target_lang_word": "一辈子似的",
                                "target_lang_sense_clarification": "较直译，表示像过了一个世纪那么久"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "223093f2-fccc-3089-8461-f206885c5566",
                    "sense_definition": "Constantly or frequently, often describing an annoying habit.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>forever</w> losing his keys around the house.",
                            "target_lang_translations": {
                                "ru": "Он <w>вечно</w> теряет свои ключи где-то в доме.",
                                "zh": "他<w>老是</w>把钥匙丢在家里各处。"
                            }
                        },
                        {
                            "text": "They are <w>forever</w> arguing about money and bills.",
                            "target_lang_translations": {
                                "ru": "Они <w>постоянно</w> ссорятся из-за денег и счетов.",
                                "zh": "他们<w>老是</w>为了钱和账单吵架。"
                            }
                        }
                    ],
                    "synonyms": [
                        "always",
                        "all the time",
                        "continually",
                        "incessantly",
                        "endlessly"
                    ],
                    "antonyms": [
                        "never"
                    ],
                    "common_phrases": [
                        "forever changing",
                        "forever complaining"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно или очень часто (обычно о раздражающей привычке).",
                        "zh": "不断地或经常地，常用来形容令人烦恼的习惯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечно",
                                "target_lang_sense_clarification": "разговорное, с оттенком недовольства"
                            },
                            {
                                "target_lang_word": "постоянно",
                                "target_lang_sense_clarification": "регулярно, непрерывно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老是",
                                "target_lang_sense_clarification": "口语，常带不满或抱怨语气"
                            },
                            {
                                "target_lang_word": "总是",
                                "target_lang_sense_clarification": "表示频繁反复发生"
                            },
                            {
                                "target_lang_word": "不停",
                                "target_lang_sense_clarification": "较中性，表示持续不断地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e99d4a73-5843-3548-9f59-c6e2ea65102c",
                    "sense_definition": "Permanent, lasting, or constant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "permanence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animal shelter helped the dog find a <w>forever</w> home.",
                            "target_lang_translations": {
                                "ru": "Приют помог собаке найти <w>постоянный</w> дом.",
                                "zh": "动物收容所帮这只狗找到了一个<w>永久</w>的家。"
                            }
                        },
                        {
                            "text": "She is looking for a <w>forever</w> friend to share her life with.",
                            "target_lang_translations": {
                                "ru": "Она ищет друга <w>на всю жизнь</w>, чтобы разделить с ним судьбу.",
                                "zh": "她在寻找一个能陪伴自己<w>一生</w>的朋友。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "forever home",
                        "forever friend",
                        "forever war"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянный, длительный или неизменный.",
                        "zh": "永久的、持久的或持续不变的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постоянный",
                                "target_lang_sense_clarification": "не временный"
                            },
                            {
                                "target_lang_word": "на всю жизнь",
                                "target_lang_sense_clarification": "фраза, используемая как прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "永久",
                                "target_lang_sense_clarification": "不临时的，长期固定的"
                            },
                            {
                                "target_lang_word": "一生",
                                "target_lang_sense_clarification": "强调持续一生，常用于关系或陪伴"
                            },
                            {
                                "target_lang_word": "长期",
                                "target_lang_sense_clarification": "普通说法，表示长期不变"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "813b0a0c-0b3e-35e9-90b4-7b9aee1f1fc9",
                    "sense_definition": "An extremely long period of time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have not seen him in <w>forever</w>.",
                            "target_lang_translations": {
                                "ru": "Я не видел его <w>целую вечность</w>.",
                                "zh": "我已经<w>好久</w>没见到他了。"
                            }
                        },
                        {
                            "text": "It took me <w>forever</w> to finish reading that book.",
                            "target_lang_translations": {
                                "ru": "У меня ушла <w>вечность</w> на то, чтобы дочитать эту книгу.",
                                "zh": "我花了<w>好久</w>才把那本书读完。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in forever",
                        "took forever"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal contexts to exaggerate duration"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно долгий период времени.",
                        "zh": "极其漫长的一段时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вечность",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好久",
                                "target_lang_sense_clarification": "口语，表示非常长的一段时间"
                            },
                            {
                                "target_lang_word": "一辈子",
                                "target_lang_sense_clarification": "夸张说法，像永恒那么久"
                            },
                            {
                                "target_lang_word": "永恒",
                                "target_lang_sense_clarification": "较直译的名词说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1ed1d6d-6219-3c99-867c-76f093b09ce2",
                    "sense_definition": "A mythical time in the future that will never come.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythical_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will agree to that plan on the twelfth of <w>forever</w>.",
                            "target_lang_translations": {
                                "ru": "Я соглашусь на этот план в день святого <w>Никогда</w>.",
                                "zh": "要我同意那个计划，得等到<w>永远都不会来的那一天</w>。"
                            }
                        },
                        {
                            "text": "He said he would pay me back on the twelfth of <w>forever</w>.",
                            "target_lang_translations": {
                                "ru": "Он сказал, что вернет мне долг, когда рак на горе <w>свистнет</w>.",
                                "zh": "他说要到<w>永远都不会来的那一天</w>才还我钱。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "twelfth of forever"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мифическое время в будущем, которое никогда не наступит.",
                        "zh": "传说中未来的某个时间，但实际上永远不会到来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "никогда",
                                "target_lang_sense_clarification": "по смыслу идиомы"
                            },
                            {
                                "target_lang_word": "вечность",
                                "target_lang_sense_clarification": "дословный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "永远都不会来的那一天",
                                "target_lang_sense_clarification": "用于解释该习语，表示永远不会到来的时间"
                            },
                            {
                                "target_lang_word": "永远不会有的时候",
                                "target_lang_sense_clarification": "更简短，表示根本不会发生的时候"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}