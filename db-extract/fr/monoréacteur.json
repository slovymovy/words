                "senses": [
                    {
                        "sense_id": "c6012bdd-cb58-32a2-9542-5504825dee4a",
                        "entry_id": "a4e30ed9-0a69-3f0d-b1d0-7cd3653dfb82",
                        "glosses": [
                            "Aéronef propulsé par un seul réacteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dc068ff-0faf-470f-95fd-a957d820b75b",
                                "sense_id": "c6012bdd-cb58-32a2-9542-5504825dee4a",
                                "text": "Moins lourd que ses rivaux, le monoréacteur suédois a l’avantage d’être meilleur marché."
                            },
                            {
                                "example_id": "bf8d9e72-1883-4f69-ae9c-dcb3c9f4283d",
                                "sense_id": "c6012bdd-cb58-32a2-9542-5504825dee4a",
                                "text": "Un monoréacteur C-101 Aviojet de l’armée espagnole s’est abîmé, ce lundi matin près de Murcie, en Méditerranée et les recherches sont en cours pour récupérer le pilote, selon le site électronique d’El Pais."
                            },
                            {
                                "example_id": "3f2d5985-4a21-447b-9c31-54b4b4c9ffcf",
                                "sense_id": "c6012bdd-cb58-32a2-9542-5504825dee4a",
                                "text": "Maintenir en état de vol un F-104 Starfighter privé relève déjà du défi. En maintenir plusieurs en état de vol, mono et biplaces, encore plus mais Infinity Space va encore plus loin en proposant une formation au pilotage du monoréacteur bisonique."
                            }
                        ]
                    }
