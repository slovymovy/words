{
    "word_family": [],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "476681fc-3262-3506-839a-27530fbd5c95",
                    "sense_definition": "używany w pytaniach o liczbę lub ilość czegoś",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pytanie_o_ilość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ile</w> to kosztuje?",
                            "target_lang_translations": {
                                "ru": "<w>Сколько</w> это стоит?"
                            }
                        },
                        {
                            "text": "<w>Ile</w> masz lat?",
                            "target_lang_translations": {
                                "ru": "<w>Сколько</w> тебе лет?"
                            }
                        }
                    ],
                    "synonyms": [
                        "jak dużo",
                        "jak wiele"
                    ],
                    "common_phrases": [
                        "ile kosztuje",
                        "ile masz lat"
                    ],
                    "target_lang_definitions": {
                        "ru": "используется в вопросах о количестве или числе чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сколько",
                                "target_lang_sense_clarification": "вопросительное слово для выяснения количества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8e4088f-d468-3abf-ade0-07eabb40dafe",
                    "sense_definition": "określa ilość lub liczbę w zdaniach oznajmujących",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "określenie_ilości",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weź tyle, <w>ile</w> chcesz.",
                            "target_lang_translations": {
                                "ru": "Возьми столько, <w>сколько</w> хочешь."
                            }
                        },
                        {
                            "text": "Zrobiłem tyle, <w>ile</w> mogłem.",
                            "target_lang_translations": {
                                "ru": "Я сделал столько, <w>сколько</w> мог."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tyle ile"
                    ],
                    "target_lang_definitions": {
                        "ru": "определяет количество или число в утвердительных предложениях"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сколько",
                                "target_lang_sense_clarification": "указывает на неопределенное количество в придаточных предложениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "881cf3fc-7aef-3e22-b8f7-18764c1fada3",
                    "sense_definition": "pytanie o czas trwania",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pytanie_o_czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ile</w> jeszcze będę żył?",
                            "target_lang_translations": {
                                "ru": "<w>Сколько</w> мне еще жить?"
                            }
                        },
                        {
                            "text": "<w>Ile</w> czasu zajmie ta podróż?",
                            "target_lang_translations": {
                                "ru": "<w>Сколько</w> времени займет эта поездка?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ile czasu"
                    ],
                    "target_lang_definitions": {
                        "ru": "вопрос о продолжительности времени"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сколько",
                                "target_lang_sense_clarification": "используется в сочетании со словами, обозначающими время"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "00dbc91a-d420-38bc-9df7-d691c2efcb6c",
                    "sense_definition": "spójnik wprowadzający warunek",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "warunek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pójdę tam, <w>o</w> <w>ile</w> będę miał czas.",
                            "target_lang_translations": {
                                "ru": "Я пойду туда, <w>если</w> у меня будет время."
                            }
                        },
                        {
                            "text": "Zrobię to, <w>o</w> <w>ile</w> mi pomożesz.",
                            "target_lang_translations": {
                                "ru": "Я сделаю это, <w>если</w> ты мне поможешь."
                            }
                        }
                    ],
                    "synonyms": [
                        "o ile"
                    ],
                    "common_phrases": [
                        "o ile"
                    ],
                    "target_lang_definitions": {
                        "ru": "союз, вводящий условие"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "если",
                                "target_lang_sense_clarification": "вводит условие (в сочетании с 'o')"
                            },
                            {
                                "target_lang_word": "поскольку",
                                "target_lang_sense_clarification": "в значении 'в той мере, в какой'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}