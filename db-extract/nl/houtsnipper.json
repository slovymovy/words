                    {
                        "sense_id": "745917e8-4930-3a74-838d-6a2a49ad184f",
                        "entry_id": "816901d6-bff5-3d07-9cba-ac1c7012cc01",
                        "glosses": [
                            "een klein, plat hout dat ontstaat als snoeihout met een hakselaar is versnipperd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2a082ce-3c7b-498d-9910-aa2e1d358463",
                                "sense_id": "745917e8-4930-3a74-838d-6a2a49ad184f",
                                "text": "Langs het gazon slingert een pad van houtsnippers in de richting van het bos."
                            },
                            {
                                "example_id": "e4023691-469c-4fb3-95ed-e65518815afa",
                                "sense_id": "745917e8-4930-3a74-838d-6a2a49ad184f",
                                "text": "\"Dit is niet normaal. Dit is een steekwapen, ik heb bloed aan mijn vinger\", zegt Hans van Houwelingen. Hij houdt in de Almelose speeltuin een scherpe houtsnipper in de lucht. Het zand is er vervangen door houtsnippers. Veel te gevaarlijk, vindt de buurt."
                            }
                        ]
                    }
