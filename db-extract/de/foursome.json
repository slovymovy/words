                "senses": [
                    {
                        "sense_id": "8861a622-8761-3909-8b1f-79ca2b6c9887",
                        "entry_id": "91ed8496-6d66-3ec8-adb6-1cba8d83ee01",
                        "glosses": [
                            "Wettspielform im Golfspiel, bei der zwei Zweier-Teams jeweils nur einen Ball abwechselnd bis zum Loch schlagen"
                        ],
                        "tags": [
                            "Golf"
                        ],
                        "examples": [
                            {
                                "example_id": "3e87485c-42e7-45ec-9bc9-73d14b196311",
                                "sense_id": "8861a622-8761-3909-8b1f-79ca2b6c9887",
                                "text": "„Nach den vier Foursomes am Vormittag, bei denen ein Duo gemeinsam einen Ball spielt, und den zwei beendeten Fourballs, bei denen jede Golferin ihren eigenen Ball schlägt, liegt Titelverteidiger Europa mit 4:2 in Führung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0933448-92c6-4972-a414-eebb0bab6ec9",
                        "source_entry_id": "91ed8496-6d66-3ec8-adb6-1cba8d83ee01",
                        "source_sense_id": "8861a622-8761-3909-8b1f-79ca2b6c9887",
                        "target_lang_word": "foursome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foursome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "549574a4-4955-3f7c-8748-847871792a32",
                                        "entry_id": "6199a11c-990c-30d7-aec5-f025bfd49242",
                                        "glosses": [
                                            "A group of four, a quartet or a game (such as golf) played by four players, especially by two teams of two."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "923edf33-6051-4cdf-89a7-47ddaee14ee5",
                                                "sense_id": "549574a4-4955-3f7c-8748-847871792a32",
                                                "text": "The fired-up foursome takes itself very seriously, singing politically charged lyrics, which, in the tradition of Strife and Damnation AD, are strategically placed in the middle of slamming, moshable breakdowns."
                                            },
                                            {
                                                "example_id": "66779c00-26e9-4a8c-ae51-c1f6ea8ae089",
                                                "sense_id": "549574a4-4955-3f7c-8748-847871792a32",
                                                "text": "And Ms. Davies’s 7,000-square-foot guesthouse, the only building from the original estate to survive, is already a favorite among card-playing foursomes and others who want to lounge on the second-story deck and watch dolphins bob in the whitecapped waves."
                                            },
                                            {
                                                "example_id": "4b761abc-4705-491b-8c60-9bcb996318b0",
                                                "sense_id": "549574a4-4955-3f7c-8748-847871792a32",
                                                "text": "Also, since the players teed off simultaneously, the infamous \"shotgun start,\" with several foursomes at each tee box, the tournaments ran notoriously slow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a492033a-e052-309d-9621-c3c5176ab3e2",
                                        "entry_id": "6199a11c-990c-30d7-aec5-f025bfd49242",
                                        "glosses": [
                                            "A sex act between four people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
