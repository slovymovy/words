                    {
                        "translation_id": "b5f999c4-d3b5-4787-ad5a-11fc1617e333",
                        "source_entry_id": "22ae56cb-277a-3c6d-a2a3-6d89884f11f9",
                        "source_sense_id": "969cb8a4-f336-328d-85fd-9dd999197810",
                        "source_sense_description": "very toxic, colourless, crystalline alkaloid",
                        "target_lang_word": "strychnine",
