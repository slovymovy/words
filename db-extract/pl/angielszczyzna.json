                                                "sense_id": "777013f0-b77e-3ea5-87cf-f42830ba04c7",
                                                "text": "Die Sprache der Architektur ändert sich von Epoche zu Epoche."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "70032255-2712-3a97-b751-d34645bb3ea3",
                                        "entry_id": "f4c9629f-261d-30d0-adde-b62bcca311e2",
                                        "glosses": [
                                            "Ausdrucksform von Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
