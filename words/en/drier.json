    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d652b865-71cd-3713-bc3a-3065aa314098",
                    "sense_definition": "comparative form of <w>dry</w>: more dry",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The desert air is much <w>drier</w> than the air near the ocean.",
                            "target_lang_translations": {
                                "ru": "Воздух в пустыне намного <w>более сухой</w>, чем воздух у океана."
                            }
                        },
                        {
                            "text": "This towel is <w>drier</w> than the one you used earlier.",
                            "target_lang_translations": {
                                "ru": "Это полотенце <w>более сухое</w>, чем то, которое ты использовал раньше."
                            }
                        }
                    ],
                    "antonyms": [
                        "wetter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень прилагательного «сухой»: более сухой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "более сухой",
                                "target_lang_sense_clarification": "сравнительная степень прилагательного"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "40c61ec4-9748-3358-9932-60a917b56b48",
                    "sense_definition": "A machine or device used for removing moisture from something",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Put the wet clothes into the <w>drier</w> after washing them.",
                            "target_lang_translations": {
                                "ru": "Положи мокрую одежду в <w>сушилку</w> после стирки."
                            }
                        },
                        {
                            "text": "The hair <w>drier</w> stopped working while I was styling my hair.",
                            "target_lang_translations": {
                                "ru": "<w>Фен</w> перестал работать, пока я укладывала волосы."
                            }
                        }
                    ],
                    "synonyms": [
                        "dryer"
                    ],
                    "common_phrases": [
                        "hair drier",
                        "clothes drier"
                    ],
                    "target_lang_definitions": {
                        "ru": "Машина или устройство для удаления влаги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сушилка",
                                "target_lang_sense_clarification": "общее название устройства"
                            },
                            {
                                "target_lang_word": "фен",
                                "target_lang_sense_clarification": "устройство для сушки волос"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
