                                    },
                                    {
                                        "sense_id": "852b74b7-7de8-3b9b-b2f3-ee0c7ab8e9c9",
                                        "entry_id": "512fa959-d7b2-3f6d-bf3a-6198aba54b15",
                                        "glosses": [
                                            "A facilitator of a Quaker meeting for business affairs."
                                        ],
                                        "tags": [
                                            "Quakerism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13e0973d-fef3-313b-8b8a-c5e662d78252",
                                        "entry_id": "512fa959-d7b2-3f6d-bf3a-6198aba54b15",
                                        "glosses": [
                                            "In the Church of England, the layman that assists in the church service, especially in reading the responses (also called parish clerk and Bible clerk)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b54f3a61-3a51-4062-b56f-ffb0710ef651",
                                                "sense_id": "13e0973d-fef3-313b-8b8a-c5e662d78252",
                                                "text": "God save the King! Will no man say, amen? / Am I both priest and clerk? Well then, amen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e14d8d9a-b9a0-36fe-9cd3-2a4fcd2375f3",
                                        "entry_id": "512fa959-d7b2-3f6d-bf3a-6198aba54b15",
                                        "glosses": [
                                            "A cleric or clergyman (the legal title for clergy of the Church of England is \\\"Clerk in Holy Orders\\\", still used in legal documents and cherished by some of their number)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a491b0d8-2d37-3928-b00c-a673c85ae6d7",
                                        "entry_id": "512fa959-d7b2-3f6d-bf3a-6198aba54b15",
                                        "glosses": [
                                            "A scholar."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "913dc7b5-9b1d-461e-ab19-1da7dafc8296",
                                                "sense_id": "a491b0d8-2d37-3928-b00c-a673c85ae6d7",
                                                "text": "13th century, Traditional carol,\nAnd all was for an appel, an appel that he toke/As clerkès finden written in their boke."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clerk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68ca51fd-abd0-33d5-8ca6-d51e01e5b5a2",
                                        "entry_id": "6e1142ae-c8aa-375e-aae0-cc30a3fa499d",
                                        "glosses": [
                                            "To act as a clerk, to perform the duties or functions of a clerk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faa04960-719a-47c9-b259-3367bae4e276",
                                                "sense_id": "68ca51fd-abd0-33d5-8ca6-d51e01e5b5a2",
                                                "text": "The law school graduate clerked for the supreme court judge for the summer."
                                            },
                                            {
                                                "example_id": "e5371c77-d8aa-4045-9608-c7980bc69cb5",
                                                "sense_id": "68ca51fd-abd0-33d5-8ca6-d51e01e5b5a2",
                                                "text": "He turned to a more attentive audience, and found it in the young fellow they called The Iceman, because he clerked in the swell jewelry store around the corner, and was always there with the finger advertisement for his boss’s diamondware."
                                            },
                                            {
                                                "example_id": "b039d4bb-ad3f-4757-98e1-256b3b55da6c",
                                                "sense_id": "68ca51fd-abd0-33d5-8ca6-d51e01e5b5a2",
                                                "text": "[…] for three years he had worked in the stinking labyrinth of the Mandalay bazaars, clerking for the rice merchants and sometimes stealing."
                                            },
                                            {
                                                "example_id": "c38c268f-df83-482c-a9a7-cc606ea7a7b3",
                                                "sense_id": "68ca51fd-abd0-33d5-8ca6-d51e01e5b5a2",
                                                "text": "1956, Jean Stafford, \"A Reading Problem\" in The Collected Stories of Jean Stafford, New York: E.P. Dutton, 1984, p. 332,\nIn the winter, they lived in a town called Hoxie, Arkansas, where Evangelist Gerlash clerked in the Buttorf drugstore and preached and baptized on the side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb6bd12-44cb-3052-85f1-91c50ce25916",
                                        "entry_id": "6e1142ae-c8aa-375e-aae0-cc30a3fa499d",
                                        "glosses": [
                                            "To assemble information about a patient during their initial assessment by actions such as a taking a detailed medical history and performing a physical examination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a32e67-de0d-452f-8120-3938f6ec3677",
                                                "sense_id": "7bb6bd12-44cb-3052-85f1-91c50ce25916",
                                                "text": "The best preparation for the long case is to clerk patients on the wards and in outpatients within a strict 60 minutes. This would include deciding on a policy of management."
                                            },
                                            {
                                                "example_id": "714555d5-6643-43e4-9500-5fa6a2ef2fda",
                                                "sense_id": "7bb6bd12-44cb-3052-85f1-91c50ce25916",
                                                "text": "You should present a case you have clerked to a doctor (registrar or consultant) and discuss your choice of investigations and management."
                                            },
                                            {
                                                "example_id": "d90e0718-5cc3-4726-80e3-811bd62607b0",
                                                "sense_id": "7bb6bd12-44cb-3052-85f1-91c50ce25916",
                                                "text": "The best way to get involved is to clerk new patients on the ward prior to the rounds and then present your clerkings to the person leading the round."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
