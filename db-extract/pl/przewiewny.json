                                    {
                                        "sense_id": "c4500ab3-947f-32f5-b6fe-0bf1211692c6",
                                        "entry_id": "50ecbc16-c7a2-3a99-a5f8-a61213caac65",
                                        "glosses": [
                                            "Consisting of air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad6e972a-7ff7-428d-8bf0-167a8eb3d51a",
                                                "sense_id": "c4500ab3-947f-32f5-b6fe-0bf1211692c6",
                                                "text": "an airy substance; the airy parts of bodies"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9d2557c-8e5b-39cb-a81f-0f0bed37a126",
                                        "entry_id": "50ecbc16-c7a2-3a99-a5f8-a61213caac65",
                                        "glosses": [
                                            "Relating or belonging to air; high in air; aerial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13feaa5f-8ada-4738-9da2-c60310d2d2b9",
                                                "sense_id": "d9d2557c-8e5b-39cb-a81f-0f0bed37a126",
                                                "text": "an airy flight"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e5b142f-5914-3688-9344-0d4d554c1a78",
                                        "entry_id": "50ecbc16-c7a2-3a99-a5f8-a61213caac65",
                                        "glosses": [
                                            "Open to a free current of air; exposed to the air; breezy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b22167ba-e684-40bf-b509-5dec7f1b6ab4",
                                                "sense_id": "7e5b142f-5914-3688-9344-0d4d554c1a78",
                                                "text": "It was a good solid house, fanless but airy."
                                            },
                                            {
                                                "example_id": "b6bcf63f-3800-4c0d-806e-b31beff1de4c",
                                                "sense_id": "7e5b142f-5914-3688-9344-0d4d554c1a78",
                                                "text": "an airy situation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed1aa89c-60b4-35de-b011-0b1b93a54732",
                                        "entry_id": "50ecbc16-c7a2-3a99-a5f8-a61213caac65",
                                        "glosses": [
                                            "Resembling air; thin; unsubstantial; not material; airlike."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a0b4ab1-52dc-4882-b00d-6abc5e419658",
                                                "sense_id": "ed1aa89c-60b4-35de-b011-0b1b93a54732",
                                                "text": "Neither diamond-hardness nor airy intangibility can save you from this, the searing agony of death!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f17d64e1-b82e-3258-a937-c8d77cfd345d",
                                        "entry_id": "50ecbc16-c7a2-3a99-a5f8-a61213caac65",
                                        "glosses": [
                                            "Relating to the spirit or soul; delicate; graceful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508524a8-233f-4ee4-aaa6-fc748892107e",
                                                "sense_id": "f17d64e1-b82e-3258-a937-c8d77cfd345d",
                                                "text": "airy music"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec44c22c-4cb6-3e98-8550-f633d804d524",
                                        "entry_id": "50ecbc16-c7a2-3a99-a5f8-a61213caac65",
                                        "glosses": [
                                            "Not based on reality; having no solid foundation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "691600fa-8b59-4e73-a9ce-6b8ba018d9cc",
                                                "sense_id": "ec44c22c-4cb6-3e98-8550-f633d804d524",
                                                "text": "Ah me, ah me! No other ghost has haunted the boy’s room, my friends, since I have occupied it, than the ghost of my own childhood, the ghost of my own innocence, the ghost of my own airy belief."
                                            },
                                            {
                                                "example_id": "326958ee-68a0-4bc4-b16b-dc4eca950238",
                                                "sense_id": "ec44c22c-4cb6-3e98-8550-f633d804d524",
                                                "text": "One critic [Madeleine Schwartz] recently noted that the politics of Rooney’s novels were largely “gestural,” with airy mentions of Gaza or austerity protests but not much radical substance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c48d2d91-eb12-3312-9f40-3487a54791a2",
                                        "entry_id": "50ecbc16-c7a2-3a99-a5f8-a61213caac65",
                                        "glosses": [
                                            "light-hearted; vivacious"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9eebe919-299a-3db2-ae53-bbc5b7055101",
                                        "entry_id": "50ecbc16-c7a2-3a99-a5f8-a61213caac65",
                                        "glosses": [
                                            "Having an affected manner; being in the habit of putting on airs; affectedly grand."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e90fc959-223a-3c0f-b2c3-addc6aa563c9",
                                        "entry_id": "50ecbc16-c7a2-3a99-a5f8-a61213caac65",
                                        "glosses": [
                                            "Having the light and aerial tints true to nature."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bab5359-e4cb-38ba-8a23-5caa23258c0b",
                                        "entry_id": "50ecbc16-c7a2-3a99-a5f8-a61213caac65",
                                        "glosses": [
                                            "Spacious, well lit, well ventilated."
                                        ],
                                        "tags": [
                                            "of a room or building"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3840ca69-bc1e-46f6-b506-7f52d0039768",
                                                "sense_id": "5bab5359-e4cb-38ba-8a23-5caa23258c0b",
                                                "text": "The station has a bright and airy feel and the refurbishment works have provided a modern and inviting station environment for passengers."
                                            }
