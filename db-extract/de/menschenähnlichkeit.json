                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b90610-525e-4404-951c-722fa70233b8",
                                "sense_id": "3bcf7973-fa05-3b86-bf16-63ef5c037aeb",
                                "text": "„Er war mit Pelz bedeckt, und seine Gesichtszüge waren wegen ihrer grotesken Menschenähnlichkeit grässlicher als die eines Affen.“"
                            },
                            {
                                "example_id": "2ad87208-3fcb-4992-8e9a-5cee8dee3ff1",
                                "sense_id": "3bcf7973-fa05-3b86-bf16-63ef5c037aeb",
                                "text": "„Man gewann den Eindruck, dass seine äußere Menschenähnlichkeit nur ein Zugeständnis an anatomische Normalvorstellungen darstellte und dass seine äußere Gestalt mühelos und jederzeit - selbst in eben diesem Augenblick - die nie erschauten Formen und unbeschreiblichen Ausmaße anzunehmen vermochte, die in transgalaktischen Welten vorherrschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
