                                    {
                                        "sense_id": "9576a807-8aa1-34a2-8e48-b47bf710be87",
                                        "entry_id": "22299655-ed35-3ce4-a664-59a47495c293",
                                        "glosses": [
                                            "Mann, der Geschlechtsverkehr mit vielen Partnerinnen hat und/oder diese häufig wechselt; Mann, der ein ausschweifendes sexuelles Leben führt"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61b80d4e-2dc4-40da-8144-02321b164886",
                                                "sense_id": "9576a807-8aa1-34a2-8e48-b47bf710be87",
                                                "text": "„Da ich nun die Freiheit, in deren Besitz ich mich glaubte, voll und ganz genießen wollte, so machte ich bald unter den berühmtesten Studenten die allerschlechtesten Bekanntschaften. Denn die berühmtesten müssen natürlich gerade die schlechten Subjekte sein: Wüstlinge, Spieler, Hurer, Trunkenbolde, Prasser, Verführer ehrbarer Mädchen, Raufbolde, Lügner – mit einem Wort lauter Menschen, die nicht imstande sind, auch nur das geringste Gefühl von Tugend zu hegen. Als Kamerad solcher Leute lernte ich jetzt die Welt kennen, indem ich sie im großen Buche der Erfahrung studierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0da610b1-c932-4768-ad46-38785134229d",
                        "source_entry_id": "e8fd2a09-ba93-3c96-96f8-fbf2efcf3f54",
                        "source_sense_id": "f5558d29-694c-36c3-b58e-f44426ebd7a1",
