                            {
                                "target_word": "lasting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bff68a7-f065-3cad-a310-cd2297402c0d",
                                        "entry_id": "fe626e77-edc6-3bd6-90d6-da3e28a013e5",
                                        "glosses": [
                                            "In full lasting cloth: a durable, plain woven fabric formerly used for making clothes and for the uppers of women's shoes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
