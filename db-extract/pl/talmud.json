                                "target_senses": [
                                    {
                                        "sense_id": "6b6e9fd9-4d06-3699-961c-04d8783956c9",
                                        "entry_id": "e6979ecd-706b-35b1-86d2-9d06b7ca86b0",
                                        "glosses": [
                                            "uno dei testi sacri dell'ebraismo, che lo considera parte della Torah rivelata sul monte Sinai a Mosè e trasmessa a voce, quindi oralmente di generazione in generazione, fino alla conquista romana, occasione in cui venne stesa per inscritto: consiste in una raccolta di commenti che insistono sull'ermeneutica esegetica ebraica tradizionale \\\"antica\\\" circa i significati e le possibilità, accettate in seguito a discussioni dialettiche, anche per le applicazioni della Torah scritta appunto ammesse o meno, cioè i precetti religiosi ebraici detti Mitzvot; ciò grazie allo studio ed all'insegnamento religiosi. Assieme ad altre numerose raccolte, come per esempio quelle del Midrash e della cabala mistica ebraica, fa quindi parte della Torah orale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc534895-79f2-4cb3-9324-36129183c9f0",
                                                "sense_id": "6b6e9fd9-4d06-3699-961c-04d8783956c9",
                                                "text": "oltre ai metodi ermeneutici della Torah, ciascuno dei Rabbanim del Talmud presenta una specifica caratteristica con cui orientarsi nell'Halakhah e non soltanto"
                                            },
                                            {
                                                "example_id": "60abfec8-bd15-43b1-9e48-b77d5961bbd0",
                                                "sense_id": "6b6e9fd9-4d06-3699-961c-04d8783956c9",
                                                "text": "persino per i caratteri particolari della scrittura ebraica, Rashì è considerato tra i più celebri commentatori dopo l'epoca del Talmud"
                                            },
                                            {
                                                "example_id": "ef43f4a3-ad5b-4b4e-b096-f8d183f5c742",
                                                "sense_id": "6b6e9fd9-4d06-3699-961c-04d8783956c9",
                                                "text": "raccolta selezionata della dottrina etica, i Pirkei Avot del Talmud indagano intorno all'intelligenza più viva del \"pragmatismo teorico\" ebraico"
                                            }
                                        ]
                                    }
                                ]
                            }
