                "senses": [
                    {
                        "sense_id": "189a1454-572b-385b-afbb-c6bb78a1dd9a",
                        "entry_id": "2939a74d-00b9-34a8-b065-b661a8a12cf2",
                        "glosses": [
                            "weniger wichtige Auf- beziehungsweise Abstiegsmöglichkeit zwischen verschiedenen Geschoßen eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9439c3ac-2f75-4ecd-8040-7b014481648e",
                                "sense_id": "189a1454-572b-385b-afbb-c6bb78a1dd9a",
                                "text": "„Der B[eschwerde]F[ührer] musste unter erheblicher Anwendung von Körperkraft in einer Halsklammer über eine Seitenstiege des Gates auf das Vorfeld gebracht werden, wo er schließlich bis zum Eintreffen der Flughafensanitäter fixiert werden konnte, die dann die Versorgung der oberflächlichen Schnittverletzungen übernahm.“"
                            },
                            {
                                "example_id": "3c26503c-1042-4049-99d0-497792032f16",
                                "sense_id": "189a1454-572b-385b-afbb-c6bb78a1dd9a",
                                "text": "„Inzwischen lief ein Dienstmädchen des Hauses über eine Seitenstiege, welche dem Auge der Untersuchungs-Commission entgangen war, auf die Gasse und zum Magistratsgebäude, wo sie der dortigen Wache den Vorfall anzeigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
