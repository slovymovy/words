                "senses": [
                    {
                        "sense_id": "a23567d5-93c6-3878-a6d4-2742b2d7efe2",
                        "entry_id": "7652a859-d2f2-37c3-b8ae-5fdfea97ad39",
                        "glosses": [
                            "hasty, hurried (prone to quick actions and decisions)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c4a9be8-8a5a-49f9-a238-f09d138ac056",
                                "sense_id": "a23567d5-93c6-3878-a6d4-2742b2d7efe2",
                                "text": "Но предостережём чита́теля от скоропали́тельных вы́водов, поско́льку прямо́й перено́с закономе́рностей живо́тного ми́ра на мир люде́й едва́ ли возмо́жен.",
                                "translation": "But let us caution the reader against hasty conclusions, since a direct transfer of the laws of the animal world to the world of people is hardly possible.",
                                "english": "But let us caution the reader against hasty conclusions, since a direct transfer of the laws of the animal world to the world of people is hardly possible."
                            }
                        ]
                    }
