                            {
                                "example_id": "98a78d0b-42eb-4066-a27e-1b728834e8f8",
                                "sense_id": "ed9fcf8c-fa5c-340b-882f-032942583a57",
                                "text": "„Schriftproben konnten auch in Kriminalfällen wichtig sein, wenn Erpresser Briefe geschrieben hatten.“"
                            },
                            {
                                "example_id": "af7178e9-ca5e-4dc7-a3e2-6b598e150194",
                                "sense_id": "ed9fcf8c-fa5c-340b-882f-032942583a57",
                                "text": "„Schriftproben der Bewerber sollen ihnen verraten, welcher Kandidat für einen Job am besten geeignet ist.“"
                            }
                        ],
