                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db31d34c-cb45-4f8b-84f1-cbc153d19a28",
                                "sense_id": "b3cbadd7-d638-3c7a-834f-45ac92946d39",
                                "text": "Ik dook vol in de nieuwe wereld van ultra lichtgewicht kampeerspullen en verslond online zo veel mogelijk lijsten (gear lists) van anderen om de voor- en nadelen te begrijpen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dc61097-ba67-4d73-9fd2-c6f201424fd2",
                        "source_entry_id": "98c78d32-b01a-3763-a8b8-ccec2c4bfa64",
                        "source_sense_id": "b3cbadd7-d638-3c7a-834f-45ac92946d39",
                        "target_lang_word": "extreme",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extreme",
