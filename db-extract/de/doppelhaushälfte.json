                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1c973fb-2e1e-4952-8fc7-ed633ce90710",
                                                "sense_id": "f08f6c22-ff99-34ac-bffe-f1090086c8d9",
                                                "text": "The twink got a semi just from that look."
                                            }
                                        ]
                                    },
