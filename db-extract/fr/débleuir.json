                ],
                "senses": [
                    {
                        "sense_id": "1a292b31-821e-3487-9c2a-c3df9b4fe67e",
                        "entry_id": "f0711419-3aa4-3c91-b77a-f3a1e1b5f082",
                        "glosses": [
                            "Enlever la coloration bleue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e7a48bd-fee2-4550-b908-825d00bae076",
                                "sense_id": "1a292b31-821e-3487-9c2a-c3df9b4fe67e",
                                "text": "Au-delà, l’océan se lève dans un bleu si bleu qu’il débleuit tous les autres bleus dans cet univers de bleus."
                            }
                        ]
                    },
                    {
                        "sense_id": "02cbff4e-09fa-3e16-a29a-e82d39f56209",
                        "entry_id": "f0711419-3aa4-3c91-b77a-f3a1e1b5f082",
                        "glosses": [
                            "ou Perdre sa coloration bleue."
                        ],
                        "tags": [
                            "intransitive",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "a81c1a7d-d2fc-4d9e-aecc-2afb90364961",
                                "sense_id": "02cbff4e-09fa-3e16-a29a-e82d39f56209",
                                "text": "En levant les yeux, par exemple, je vis le ciel se débleuir, s’assombrir ; et puis, soudainement, au-dessus de moi, j’aperçus à ma droite — c’est-à-dire un peu au sud du point vers lequel je montais — une noirceur qui grossissait à vue d’œil."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1cd583b-8896-3cc6-8bed-cf3ddad4dad6",
                        "entry_id": "f0711419-3aa4-3c91-b77a-f3a1e1b5f082",
                        "glosses": [
                            "Traiter une pièce de métal pour lui enlever le bleu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00533ad1-154d-438e-ab6b-6a9b57d42104",
                                "sense_id": "f1cd583b-8896-3cc6-8bed-cf3ddad4dad6",
                                "text": "L’acier qui a été bleui à la chaleur se débleuit immédiatement par son passage à l’acide chlorhydrique très-dilué, au dixième, par exemple."
                            }
                        ]
                    },
                    {
                        "sense_id": "49ef90e5-ea47-3089-8449-603c8479a077",
                        "entry_id": "f0711419-3aa4-3c91-b77a-f3a1e1b5f082",
                        "glosses": [
                            "Faire perdre son innocence, sa naïveté à quelqu’un (un bleu)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fcacf614-b784-328c-968c-e94fd36b79ac",
                        "entry_id": "f0711419-3aa4-3c91-b77a-f3a1e1b5f082",
                        "glosses": [
                            "Désapprêter (un vêtement)."
                        ],
