                                        "entry_id": "9dc0610a-e0aa-3d59-a9f1-4cc3277db517",
                                        "glosses": [
                                            "bogini małżeństw, wierności małżeńskiej, kobiet zamężnych i wdów, małżonka Zeusa"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c46f51a-7cd0-424f-8ff6-03be10e4a02f",
                                                "sense_id": "0d172b4c-ec2c-3ce4-860f-bb098b987406",
                                                "text": "Hera uchodziła m.in. za zazdrosną i mściwą, zwłaszcza w stosunku do swych rywalek"
                                            },
                                            {
                                                "example_id": "dc466ad5-4d9f-48a3-bb93-700b2b6fbbbf",
                                                "sense_id": "0d172b4c-ec2c-3ce4-860f-bb098b987406",
                                                "text": "Atrybutami Hery były: diadem, berło, lilia, nieśmiertelnik (suchokwiat), granat, paw, kukułka i krowa."
                                            },
                                            {
                                                "example_id": "a547dc3d-1c12-4756-970e-de1181d0ea5c",
                                                "sense_id": "0d172b4c-ec2c-3ce4-860f-bb098b987406",
                                                "text": "Herze stale towarzyszyły jej córki, Ejlejtyja i Hebe"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "435c904a-71d8-380b-ae77-9eb6ece9000d",
                                        "entry_id": "9dc0610a-e0aa-3d59-a9f1-4cc3277db517",
                                        "glosses": [
                                            "planetoida o numerze katalogowym 103"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4abff2e8-d75b-458f-8db1-685b6dbae95a",
                                                "sense_id": "435c904a-71d8-380b-ae77-9eb6ece9000d",
                                                "text": "Hera porusza się w obszarze między orbitami Marsa i Jowisza, czyli w pasie głównym planetoid."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
