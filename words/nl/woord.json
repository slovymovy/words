                            "trait_type": "form",
                            "comment": "Vaak met een hoofdletter geschreven in religieuze context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Divine revelation, often referring to the Bible or Jesus Christ."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Word",
                                "target_lang_sense_clarification": "Scripture or Logos"
                            },
                            {
                                "target_lang_word": "Gospel",
                                "target_lang_sense_clarification": "the message of Christ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "002fc141-aa1b-3475-8145-f30eb749b1ed",
                    "sense_definition": "De standaardhoeveelheid gegevens die een processor in één keer kan verwerken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "informatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij deze oude computerarchitectuur bestaat een <w>woord</w> uit slechts zestien bits.",
                            "target_lang_translations": {
                                "en": "In this old computer architecture, a <w>word</w> consists of only sixteen bits."
                            }
                        },
                        {
                            "text": "De snelheid van de processor hangt mede af van de lengte van het <w>woord</w>.",
                            "target_lang_translations": {
                                "en": "The speed of the processor partly depends on the length of the <w>word</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The standard amount of data a processor can handle at once."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "word",
                                "target_lang_sense_clarification": "computing unit of data"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5f44e37-542c-37de-81d4-839f5b8dab58",
                    "sense_definition": "Een mannelijke eend.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De mannelijke wilde eend, de <w>woord</w>, kenmerkt zich door een glanzende groene kop.",
                            "target_lang_translations": {
                                "en": "The male mallard, the <w>drake</w>, is characterized by a shiny green head."
                            }
                        },
                        {
                            "text": "In de sloot zwom een <w>woord</w> samen met drie vrouwtjeseenden.",
                            "target_lang_translations": {
