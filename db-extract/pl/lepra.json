                "forms": [],
                "senses": [
                    {
                        "sense_id": "c0ebafb1-48e2-3d40-81c5-885e2c4a2521",
                        "entry_id": "057f49a6-20cb-36d5-9935-e5dd7f99783e",
                        "glosses": [
