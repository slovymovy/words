                "senses": [
                    {
                        "sense_id": "b64c9f3a-19a4-3305-864b-a57ecd56eb8f",
                        "entry_id": "94c18d62-23ac-3ba3-b781-fced9dca4b50",
                        "glosses": [
                            "Forcer deux éléments à se réajuster."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f3246fa-7c80-4102-9b7e-d0f714054150",
                                "sense_id": "b64c9f3a-19a4-3305-864b-a57ecd56eb8f",
                                "text": "Il a fallu recontraindre les deux morceaux cassés pour obtenir enfin la guérison totale de l’os."
                            }
                        ]
                    },
                    {
                        "sense_id": "c574b516-9d81-30bd-9283-01c68d82497f",
                        "entry_id": "94c18d62-23ac-3ba3-b781-fced9dca4b50",
                        "glosses": [
                            "Exercer de nouveau une contrainte sur quelqu’un ou quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6927b0-072e-432c-80d4-d68b3c1cca87",
                                "sense_id": "c574b516-9d81-30bd-9283-01c68d82497f",
                                "text": "Ainsi, quand la psychanalyse étaye sa théorie des mécanismes de l'inconscient sur la thermodynamique, elle recontraint la dynamique libidinale à fonctionner en circuit fermé, emprisonnant les flux « pulsionnels » dans des réservoirs solides."
                            }
                        ]
                    }
