                "senses": [
                    {
                        "sense_id": "429f3fb3-8fa0-304a-b5c7-d2285346773c",
                        "entry_id": "46f56d29-45be-3c07-83c6-76d129c771bc",
                        "glosses": [
                            "osoba o skrajnych, radykalnych poglądach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b255689e-b5cf-4a3d-ae27-5cba87bb3f16",
                                "sense_id": "429f3fb3-8fa0-304a-b5c7-d2285346773c",
                                "text": "W Turcji, która w latach 70. odczuła skutki terroru ze strony ekstremistycznych bojówek lewicy i prawicy, a później borykała się z kurdyjską PKK, po raz pierwszy na taką skalę doświadczyła terroru ze strony ekstremistów islamskich"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a48fe47f-6adf-4381-81ee-3f7df46bf5f4",
                        "source_entry_id": "46f56d29-45be-3c07-83c6-76d129c771bc",
                        "source_sense_id": "429f3fb3-8fa0-304a-b5c7-d2285346773c",
                        "target_lang_word": "extremist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extremist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f1c42bd-4011-3af1-9dd4-e3a44f412bfb",
                                        "entry_id": "e775ba16-7792-3df5-9d17-3e75b38fef2e",
                                        "glosses": [
                                            "A person who holds extreme views, especially one who advocates such views; a radical or fanatic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c05ac2d8-a5e8-410f-aa76-7a7124a32e06",
                                                "sense_id": "7f1c42bd-4011-3af1-9dd4-e3a44f412bfb",
                                                "text": "In Urif, extremists spray painted “Death to Arabs” on shipping containers belonging to a local resident and the local quarry was tagged with the words “Fight the enemy.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "extremist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8472215-8e67-392c-ae4f-ab231d021853",
                                        "entry_id": "0c00c690-2cc9-333d-aea3-813ece139220",
                                        "glosses": [
                                            "Holding extreme views, especially on a political or religious subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46cb58cf-d878-4f07-8d7a-e6b5d928c361",
                                                "sense_id": "c8472215-8e67-392c-ae4f-ab231d021853",
                                                "text": "There are some minor extremist movements that are antiforeigner."
                                            },
                                            {
                                                "example_id": "d6d3c2fd-1149-4db2-8007-04c6162b2423",
                                                "sense_id": "c8472215-8e67-392c-ae4f-ab231d021853",
                                                "text": "The hate crimes, once commonly referred to as “price tag attacks,” are committed by extremist Jewish youth from nearby settlements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc726906-fe1a-3dca-9e98-9aa0e4d4af98",
                                        "entry_id": "0c00c690-2cc9-333d-aea3-813ece139220",
                                        "glosses": [
                                            "Of or relating to extremism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f89246fa-1fda-48be-8b66-a8b7c4f28b30",
                        "source_entry_id": "46f56d29-45be-3c07-83c6-76d129c771bc",
                        "source_sense_id": "429f3fb3-8fa0-304a-b5c7-d2285346773c",
                        "target_lang_word": "extremista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extremista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "30d6165d-3777-371d-a5bd-e1802694c080",
                                        "entry_id": "9122d0b7-5181-378e-ae6c-c8c1dd323a4d",
                                        "glosses": [
                                            "Persona que es partidaria de ideas extremas o exageradas, especialmente en política."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "808a8c4e-1ee5-4e45-8d2c-7451f8ebaf33",
                                                "sense_id": "30d6165d-3777-371d-a5bd-e1802694c080",
                                                "text": "«La diplomacia norteamericana se ha movido también como pez en el agua en Irlanda del Norte, donde el proceso de paz sigue estancado pero la violencia terrorista ha dejado paso al diálogo patrocinado por Washington, y en Oriente Medio, la volátil región que, el pasado mes de noviembre, sufrió un duro revés con el asesinato del primer ministro israelí Yitzhak Rabin a manos de un extremista judío»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c4c0b98-ee6f-432f-a95b-f0d39a46c2d9",
                        "source_entry_id": "46f56d29-45be-3c07-83c6-76d129c771bc",
                        "source_sense_id": "429f3fb3-8fa0-304a-b5c7-d2285346773c",
                        "target_lang_word": "Extremist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Extremist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9e566dd-14f9-3fe3-b9e8-055c01da929d",
                                        "entry_id": "23866f26-5c97-3138-aabe-64a3cfe9ea30",
                                        "glosses": [
                                            "jemand, der etwas auf extreme Art und Weise tut; Anhänger des Extremismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce5deebc-c018-452a-ad9e-4c4ac3c64c3a",
                                                "sense_id": "b9e566dd-14f9-3fe3-b9e8-055c01da929d",
                                                "text": "SindExtremisten eine Bedrohung für die freie Welt?"
                                            },
                                            {
                                                "example_id": "98f0eb3a-3302-4663-918a-8f2531b98029",
                                                "sense_id": "b9e566dd-14f9-3fe3-b9e8-055c01da929d",
                                                "text": "„In Syrien sind seit dem Beginn der US-geführten Offensive gegen die Dschihadistengruppe vor einer Woche nach Angaben von Aktivisten bereits mehr als 200 Extremisten getötet worden.“"
                                            },
                                            {
                                                "example_id": "f89ad0ae-7758-47d6-8c16-e6ed19e0ac63",
                                                "sense_id": "b9e566dd-14f9-3fe3-b9e8-055c01da929d",
                                                "text": "„Die Bürger zudem als Extremisten zu denunzieren war der Beginn des Zusammenschlusses der Istanbuler, egal welcher politischen Überzeugung.“"
                                            },
                                            {
                                                "example_id": "61607d5f-5a0f-4183-abf2-0f6c1a4463c1",
                                                "sense_id": "b9e566dd-14f9-3fe3-b9e8-055c01da929d",
                                                "text": "„Doch nicht alle Kenianer folgen den Extremisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
