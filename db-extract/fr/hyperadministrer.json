                "senses": [
                    {
                        "sense_id": "3fce7628-9e8e-39d7-8ee2-a3f44fc315f5",
                        "entry_id": "0890e232-ef38-3675-8190-12a1fe4c57db",
                        "glosses": [
                            "Administrer d’une façon extrêmement importante ou exagérée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5efd9e1d-e1dd-4472-9069-9449e5db6dc9",
                                "sense_id": "3fce7628-9e8e-39d7-8ee2-a3f44fc315f5",
                                "text": "On a souvent fait observer qu’étant donné le potentiel humain extrêmement limité des deux pays, une des plus graves erreurs tant du FRELIMO que du MPLA a été de vouloir hypercentraliser et hyperadministrer."
                            },
                            {
                                "example_id": "4055f96c-08ef-4646-a430-d15679a8af79",
                                "sense_id": "3fce7628-9e8e-39d7-8ee2-a3f44fc315f5",
                                "text": "Bon je sais qu’en France c’est pas mieux, la peur de tout est le grand axe politique de droite comme de gauche et ce pays sensé ^([sic : censé]) être individualiste se rassure en étant hyperadministré."
                            }
                        ]
                    }
                ],
