                    {
                        "sense_id": "f202fe53-fa4c-3b6f-92c2-95fe8a5817c8",
                        "entry_id": "ffd7399b-5e79-3378-b4b9-1ec6d17068d6",
                        "glosses": [
                            "Qualifie des produits, des objets, etc. qui sont fabriqués artisanalement ou industriellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23cff112-8aa4-4ced-99a9-41a19fcb0e96",
                                "sense_id": "f202fe53-fa4c-3b6f-92c2-95fe8a5817c8",
                                "text": "Depuis quelques jours déjà, les Indiens arrivaient par bandes au fort, afin d'échanger les produits de leur chasse d'hiver contre des objets manufacturés."
                            },
                            {
                                "example_id": "fde2cb70-2ddb-4b67-88db-8a6bca2bd325",
                                "sense_id": "f202fe53-fa4c-3b6f-92c2-95fe8a5817c8",
                                "text": "Je voyais en lui, non pas un homme, mais un produit manufacturé, une machine à dire ce qu’il faut dire et à penser ce qu’il faut penser."
                            }
                        ]
                    }
                ],
