                        ]
                    },
                    {
                        "translation_id": "37657869-68b2-4170-80f4-e469efe74124",
                        "source_entry_id": "1f88e727-0627-316e-9377-bf2b44dd5d23",
                        "source_sense_id": "16d19fa1-d5cf-363b-a3e3-ffa5fd43eaae",
                        "target_lang_word": "béchamel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "béchamel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bac163a6-1278-36ee-98b6-20786ad40739",
                                        "entry_id": "1446cd23-01bb-3329-b9a6-8f98512fd39c",
                                        "glosses": [
                                            "Sauce blanche qui se fait avec de la farine, du lait et du beurre."
                                        ],
                                        "tags": [
                                            "Sauces"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "940a2ee7-ea92-437c-a68b-d65562e4c9be",
                                                "sense_id": "bac163a6-1278-36ee-98b6-20786ad40739",
                                                "text": "De la morue à la béchamel."
                                            },
                                            {
                                                "example_id": "c96c02a4-88fc-4c52-b0e5-28f57edbbe50",
                                                "sense_id": "bac163a6-1278-36ee-98b6-20786ad40739",
                                                "text": "Une béchamel de brochet. — L’onctuosité des béchamels."
                                            },
                                            {
                                                "example_id": "fd0eeaa3-64ec-4fae-b3fe-23d7a7d4ccb0",
                                                "sense_id": "bac163a6-1278-36ee-98b6-20786ad40739",
                                                "text": "Sauce à la Sainte-Menehould. — Mettez dans une casserole un morceau de beurre coupé, singez-le de farine ; délayez votre sauce avec du lait ou de la crème […] mettez-la sur le feu ; tournez-la comme la béchamel, et tordez-la à l’étamine."
                                            },
                                            {
                                                "example_id": "f1665814-3876-4ef9-8449-e3bdd96075a3",
                                                "sense_id": "bac163a6-1278-36ee-98b6-20786ad40739",
                                                "text": "Je prenais mes repas à la table d’hôte, où l’on servait d’étranges béchamels qui se soulevaient d’un seul disque, telle une crêpe oubliée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f3a09ab-faa2-3f6b-bfca-aa27df1fea7c",
                                        "entry_id": "1446cd23-01bb-3329-b9a6-8f98512fd39c",
                                        "glosses": [
                                            "Situation très problématique."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ee76034-8ecf-4179-81c1-404c6cfd7b8e",
                                                "sense_id": "0f3a09ab-faa2-3f6b-bfca-aa27df1fea7c",
                                                "text": "Pour qu’il abandonne ses cactus et qu’il revienne à Paname, faut qu’il lui en arrive une sévère au vieux Louis. Faut qu’il ait besoin de pognon ou qu’il soit tombé dans une béchamel infernale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28d6b325-b7b9-483e-90e2-aa788a3e9a50",
                        "source_entry_id": "1f88e727-0627-316e-9377-bf2b44dd5d23",
                        "source_sense_id": "16d19fa1-d5cf-363b-a3e3-ffa5fd43eaae",
                        "target_lang_word": "béchamelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "béchamelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c5c73ec-e230-3083-8094-2e9cbd7fc1d9",
                                        "entry_id": "46c1e0c0-13f0-3c7c-b9fc-366e30503add",
                                        "glosses": [
                                            "Variante de béchamel."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b8b67fb-8344-48c0-85ed-bf11ff2324e2",
                                                "sense_id": "7c5c73ec-e230-3083-8094-2e9cbd7fc1d9",
                                                "text": "Sur quatre amateurs que nous sommes, deux la préfèrent à l’huile et deux à la béchamelle. Et vous, cher ami ? — Le cher ami mordillait sa moustache et feignait de ne pas entendre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
