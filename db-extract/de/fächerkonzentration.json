                ],
                "senses": [
                    {
                        "sense_id": "0a168b6e-4ff8-3de2-98d8-4982ee0a5519",
                        "entry_id": "949a5272-ebc7-37ed-8473-a78ca735e8d0",
                        "glosses": [
                            "Verknüpfung von Sachkompetenzen, Methoden und technischen Ressourcen unterschiedlicher Arbeitsfelder, etwa um komplexe Aufgaben bewältigen zu können oder Synergieeffekte zu erzielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "126129c9-430c-4ad4-b341-f95e43c36234",
                                "sense_id": "0a168b6e-4ff8-3de2-98d8-4982ee0a5519",
                                "text": "„Durch Fächerkonzentration, Beschränkung des fremdsprachlichen Ausbildungsanteils, Kooperation mit Hochschulen, fachliche und zeitliche Begrenzung der Prüfungsprozedur sollte die Begrenzung der Ausbildungszeit erreicht werden.“"
                            },
                            {
                                "example_id": "215173cd-4f6d-432b-95ee-6305767e92af",
                                "sense_id": "0a168b6e-4ff8-3de2-98d8-4982ee0a5519",
                                "text": "„Im ‚Oberbau’ erfolgt eine Fächerkonzentration im Hinblick auf eine ganzheitliche Themenbehandlung.“"
                            },
                            {
                                "example_id": "902ccd05-5adf-47ab-95dc-37f04031b25d",
                                "sense_id": "0a168b6e-4ff8-3de2-98d8-4982ee0a5519",
                                "text": "„Sie haben den Vorteil, daß staatlich verordneten Rezepten zur Fächerkonzentration eine natürliche Schwerpunktbildung innerhalb einer Universität gegenübersteht, die in ihrem Ursprung auf unabhängige Gutachterurteile zurückzuführen ist.“"
                            },
                            {
                                "example_id": "ae6d9fd2-1a18-4da0-a288-ad609855a2c9",
                                "sense_id": "0a168b6e-4ff8-3de2-98d8-4982ee0a5519",
                                "text": "„Die Forderung der Politik nach Fächerkonzentration hat nur eine Form der Konzentration zur Folge: das Beschränken auf bestimmte Gebiete der historischen Forschung unter Vernachlässigung der ‚Peripherie’, etwa der Byzantinischen, Osteuropäischen, Süd- und Ostasiatischen Geschichte.“"
                            },
                            {
                                "example_id": "b023ce87-35ff-4363-81b2-96fe8664c32f",
                                "sense_id": "0a168b6e-4ff8-3de2-98d8-4982ee0a5519",
                                "text": "„Dies erfolgt in konsequenter Umsetzung der vom Berliner Senat und dem Vorstand beschlossenen Fächerkonzentration, die bei gleicher oder sogar verbesserter Leistung ökonomische Synergieeffekte hebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
