                "senses": [
                    {
                        "sense_id": "b624b200-f110-3236-9659-a8492b5d86da",
                        "entry_id": "0743eeb5-91d8-3520-b9bf-4d41306a9fed",
                        "glosses": [
                            "Nom usuel de Persea americana, arbre originaire du Mexique, du Guatémala et du Costa Rica, de la famille des lauracées et dont le fruit comestible est l’avocat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abe578b0-564a-4d30-8c06-99f0e6041e7a",
                                "sense_id": "b624b200-f110-3236-9659-a8492b5d86da",
                                "text": "Nous nous élevons rapidement et ne tardons pas à quitter la zone des cultures tropicales et subtropicales des terres basses. […] ; aux dattiers, aux dragonniers, aux manguiers, aux anoniers, aux avocatiers, aux goyaviers succèdent les arbres fruitiers des régions méditerranéennes, puis de l'Europe centrale. Nous montons toujours."
                            },
                            {
                                "example_id": "7a5ffd35-1e78-4cae-9f60-3a26632f75ab",
                                "sense_id": "b624b200-f110-3236-9659-a8492b5d86da",
                                "text": "L’avocatier appartient au genre Persea Miller, de la famille des Lauracées, dont on connaît une cinquantaine d’espèces dans le monde, pour la plupart originaires de l’Amérique tropicale."
                            },
                            {
                                "example_id": "b0024645-1fac-48d1-8205-64c96f57dfbb",
                                "sense_id": "b624b200-f110-3236-9659-a8492b5d86da",
                                "text": "L’avocatier est cultivé pour ses fruits qui servent à la consommation humaine ou qui donnent une huile utilisée principalement pour la fabrication des cosmétiques, mais aussi en pharmacologie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82829ed8-c56f-45bd-8b53-a41409ccb035",
