                "senses": [
                    {
                        "sense_id": "f52477d7-5fd4-38a7-97c4-1bc0dc83e1d0",
                        "entry_id": "d36ec192-2175-3ba3-b20d-581c4c8a1d77",
                        "glosses": [
                            "das Testen einer Software, um sie auf Erfüllung der erwünschten Anforderungen oder ihrer Qualität zu beurteilen"
                        ],
                        "tags": [
                            "Testen"
                        ],
                        "examples": [
                            {
                                "example_id": "927461dc-3c42-443b-96de-b064ee7fdb5a",
                                "sense_id": "f52477d7-5fd4-38a7-97c4-1bc0dc83e1d0",
                                "text": "„Den Nachweis, dass keine Fehler (mehr) vorhanden sind, kann das Softwaretesten nicht erbringen.“"
                            },
                            {
                                "example_id": "4fe98f35-c4cc-438d-8c11-dd877d4263b5",
                                "sense_id": "f52477d7-5fd4-38a7-97c4-1bc0dc83e1d0",
                                "text": "„SEQIS ist seit 2001 auf den in der IT unverzichtbaren Softwaretest spezialisiert und unterstützt ihre Kunden sehr erfolgreich mit Dienstleistungen und innovativen Lösungen.“"
                            },
                            {
                                "example_id": "34a1e29e-f484-4a84-a4d5-8cc5e5b2e2f5",
                                "sense_id": "f52477d7-5fd4-38a7-97c4-1bc0dc83e1d0",
                                "text": "„Thomas Dietl beschäftigt sich seit 5 Jahren mit Softwaretest, spezialisiert auf Testautomation und zuletzt als Teamleiter eines Testteams.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
