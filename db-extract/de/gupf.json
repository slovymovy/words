                        "entry_id": "583aad0b-f350-334f-8d16-47a1420b8bf6",
                        "glosses": [
                            "aus einem Gefäß oben herausragender Anteil einer Masse"
                        ],
                        "tags": [
                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "3aa08a39-bc74-455c-80a7-6d06e31ce7bc",
                                "sense_id": "b2f1af05-7dae-3b14-b09f-4a8ff1e04c04",
                                "text": "Meine Muffins sind gerade mal fünf Minuten im Ofen und schon haben sie einen schönen Gupf."
                            }
                        ],
