                                "target_senses": [
                                    {
                                        "sense_id": "2b90c941-b47b-3408-b48a-71f5111a9bf3",
                                        "entry_id": "25f5ec1f-c1f9-342f-86a8-43168c1df97f",
                                        "glosses": [
                                            "Of, or relating to the fusion of atomic nuclei at high temperatures."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daea2d84-b91a-4a77-822c-f9a67e8f875e",
                                                "sense_id": "2b90c941-b47b-3408-b48a-71f5111a9bf3",
                                                "text": "The first thermonuclear reaction was in a star; it was brought about by heat, as the description implies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bce6690-6a68-372d-bde6-be2510d314ec",
                                        "entry_id": "25f5ec1f-c1f9-342f-86a8-43168c1df97f",
                                        "glosses": [
                                            "Of, or relating to the use of atomic weapons based on such fusion, especially as distinguished from those based on fission."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21e1f3c1-1953-46fd-bfd0-1c6150aa3abd",
                                                "sense_id": "5bce6690-6a68-372d-bde6-be2510d314ec",
                                                "text": "I can't believe you gave me, a ten-year-old boy, a thermonuclear device [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thermonuclear",
