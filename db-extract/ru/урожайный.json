                        ],
                        "form": "урожа́йнее"
                    },
                    {
                        "form_id": "f3a78b82-c9f6-4ffa-8838-f9d28dc79651",
                        "entry_id": "b8c8715d-9e3d-3cc3-b8a0-51bd9270d3e3",
                        "tags": [
