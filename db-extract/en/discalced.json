    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7a9b1a65-8a31-3a5d-b1b6-2417f2f37ef8",
                "word": "discalced",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "23f4ed13-471c-37dc-b1d9-084a1a32ada8",
                        "entry_id": "7a9b1a65-8a31-3a5d-b1b6-2417f2f37ef8",
                        "glosses": [
                            "Pertaining to a religious order that historically forswore the wearing of shoes."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8609b85b-f7a8-4662-b5cc-ccfc7134749f",
                                "sense_id": "23f4ed13-471c-37dc-b1d9-084a1a32ada8",
                                "text": "Brother John is a member of the Discalced Carmelites."
                            }
                        ]
                    },
                    {
                        "sense_id": "eeeeea20-8b9b-3e06-8509-192516d3dc1b",
                        "entry_id": "7a9b1a65-8a31-3a5d-b1b6-2417f2f37ef8",
                        "glosses": [
                            "Shoeless; without shoes on; barefoot, or wearing sandals rather than shoes."
                        ],
                        "tags": [
                            "broadly",
                            "formal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "772179c6-0b76-4a67-a337-9d7228573a57",
                                "sense_id": "eeeeea20-8b9b-3e06-8509-192516d3dc1b",
                                "text": "They were discalced to a man like pilgrims of some common order for all their shoes were long since stolen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9c1ea66-a78e-4eea-bec1-cc099b7c5609",
                        "source_entry_id": "7a9b1a65-8a31-3a5d-b1b6-2417f2f37ef8",
                        "source_sense_description": "pertaining to a religious order that was historically barefoot",
                        "target_lang_word": "déchaux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déchaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abc235d8-1b55-3946-b0e6-c9567d6c0b13",
                                        "entry_id": "411ef31e-c67f-3687-adef-3f27a0978473",
                                        "glosses": [
                                            "Déchaussé."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2dcf474-790e-4eea-b1a6-d68a25e30d2c",
                                                "sense_id": "abc235d8-1b55-3946-b0e6-c9567d6c0b13",
                                                "text": "Pendant notre déjeuner survint une troupe d’étudiants en tournée ; ils étaient quatre et ressemblaient plus à des modèles de Ribera ou de Murillo qu’à des élèves en théologie, tant ils étaient déguenillés, déchaux et malpropres."
                                            },
                                            {
                                                "example_id": "331297d2-3455-4b34-9364-4fd98c63b132",
                                                "sense_id": "abc235d8-1b55-3946-b0e6-c9567d6c0b13",
                                                "text": "Sans se demander comment elle s'en irait, pieds déchaux dans les roches."
                                            },
                                            {
                                                "example_id": "154e190c-4708-4466-8326-98d6b7350e1c",
                                                "sense_id": "abc235d8-1b55-3946-b0e6-c9567d6c0b13",
                                                "text": "Ils étaient tous déchaux jusqu'au dernier comme des pèlerins d'un ordre inférieur car toutes leurs chaussures avaient été depuis longtemps volées. — (Cormac McCarthy, La Route, 2006, Éditions de l'Olivier, 2008, traduction de François Hirsch, page 28)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33568595-e76a-3b83-8f85-a617c3dd9295",
                                        "entry_id": "411ef31e-c67f-3687-adef-3f27a0978473",
                                        "glosses": [
                                            "Caractérise des moines et carmélites déchaussées qui marchent pieds nus dans des sandales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e4ffb76-4f3c-4b24-9cca-f4b7f0ad9026",
                                                "sense_id": "33568595-e76a-3b83-8f85-a617c3dd9295",
                                                "text": "Non loin du couvent des carmes déchaux de Santa Teresa, construit sur l’emplacement de la maison natale de Thérèse…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "deddefcb-f0e2-4611-95c0-318fc006e7f2",
                        "source_entry_id": "7a9b1a65-8a31-3a5d-b1b6-2417f2f37ef8",
                        "source_sense_description": "pertaining to a religious order that was historically barefoot",
                        "target_lang_word": "unbeschuht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbeschuht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17ff424c-05c0-31d7-8511-f34b9707aedf",
                                        "entry_id": "a752fc1a-3551-35ef-897f-0bb0665bf8b0",
                                        "glosses": [
                                            "kein Paar Schuhe tragend, ohne Schuhe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "621ea368-0b3d-4f97-bc31-134f6b515ebf",
                                                "sense_id": "17ff424c-05c0-31d7-8511-f34b9707aedf",
                                                "text": "„Dort hocken unbeschuhte Gäste unter orientalischen Bildern auf üppig gepolsterten Holzpodesten.“"
                                            },
                                            {
                                                "example_id": "11b6d9ef-fe61-446a-8212-f161fb970d24",
                                                "sense_id": "17ff424c-05c0-31d7-8511-f34b9707aedf",
                                                "text": "„So zog sie mit ihm auf schwerer Irrfahrt herum, schweifte unbeschuht und ohne Speise mit ihm durch die wilden Wälder; […].“"
                                            },
                                            {
                                                "example_id": "c4abb9d6-7e8e-4e25-979d-4b8a6a6b9476",
                                                "sense_id": "17ff424c-05c0-31d7-8511-f34b9707aedf",
                                                "text": "„Da hörte sie deutlich das »Trapp, trapp, trapp« unbeschuhter Füße aus dem anstoßenden Ankleidezimmer herauskommen und durch den Gang auf die Treppe zugehen.“"
                                            },
                                            {
                                                "example_id": "7314b58f-cd75-4222-8a7a-333c5c496020",
                                                "sense_id": "17ff424c-05c0-31d7-8511-f34b9707aedf",
                                                "text": "„Da näherte sich endlich ein langer Zug von Mönchen: beschuhte und unbeschuhte, weiße und schwarze, mit und ohne Bart, mit und ohne Kapuze – hinter ihnen der Scharfrichter, und endlich von Würdenträgern und Granden umgeben: vierzig Menschen, mit Tüchern ganz verdeckt, auf denen Flammen und Ungeheuer abgebildet waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
