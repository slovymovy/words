{
    "word_family": [
        "versify",
        "versification",
        "versifier"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23205b63-b834-3b9a-9b31-dd9eb1d95755",
                    "sense_definition": "One of the parts that a song or poem is divided into; a group of lines that form a unit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unit_of_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir sang the first <w>verse</w> of the hymn very softly.",
                            "target_lang_translations": {
                                "ru": "Хор очень тихо спел первый <w>куплет</w> гимна.",
                                "zh": "唱诗班非常轻柔地唱了赞美诗的第一<w>段</w>。"
                            }
                        },
                        {
                            "text": "Note the shift in tone between the first <w>verse</w> and the second.",
                            "target_lang_translations": {
                                "ru": "Обратите внимание на смену тона между первым <w>куплетом</w> и вторым.",
                                "zh": "注意第一<w>段</w>和第二段之间语气的转变。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stanza",
                        "section"
                    ],
                    "common_phrases": [
                        "first verse",
                        "sing a verse",
                        "verse and chorus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из частей, на которые делится песня или стихотворение; группа строк, образующих единое целое.",
                        "zh": "歌曲或诗歌中划分出的部分；构成一个单元的一组行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купле́т",
                                "target_lang_sense_clarification": "часть песни"
                            },
                            {
                                "target_lang_word": "строфа́",
                                "target_lang_sense_clarification": "часть стихотворения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "段落",
                                "target_lang_sense_clarification": "歌曲的段落"
                            },
                            {
                                "target_lang_word": "诗节",
                                "target_lang_sense_clarification": "诗歌的段落"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d498750c-377c-3a90-beb7-3ae789a0740a",
                    "sense_definition": "Writing that follows a specific rhythmic pattern and often rhymes, as opposed to prose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "literary_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Restoration literature is well known for its carefully constructed <w>verse</w>.",
                            "target_lang_translations": {
                                "ru": "Литература эпохи Реставрации известна своими тщательно выстроенными <w>стихами</w>.",
                                "zh": "复辟时期的文学以其精心构建的<w>韵文</w>而闻名。"
                            }
                        },
                        {
                            "text": "She decided to write the entire story in <w>verse</w> rather than prose.",
                            "target_lang_translations": {
                                "ru": "Она решила написать всю историю в <w>стихах</w>, а не в прозе.",
                                "zh": "她决定用<w>诗歌</w>而不是散文来写整个故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "poetry"
                    ],
                    "common_phrases": [
                        "blank verse",
                        "free verse",
                        "written in verse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Художественная речь, организованная по определённому ритмическому образцу и часто имеющая рифму, в отличие от прозы.",
                        "zh": "遵循特定节奏模式且通常押韵的文学写作形式，与散文相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стихи́",
                                "target_lang_sense_clarification": "поэтическое произведение"
                            },
                            {
                                "target_lang_word": "поэ́зия",
                                "target_lang_sense_clarification": "вид искусства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诗歌",
                                "target_lang_sense_clarification": "文学体裁"
                            },
                            {
                                "target_lang_word": "韵文",
                                "target_lang_sense_clarification": "有韵律的文字"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32a51f21-50d5-3a3a-a065-fe7cacb2b91b",
                    "sense_definition": "A short, numbered subdivision of a chapter in a holy book, such as the Bible or Quran.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unit_of_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest asked the congregation to read a specific <w>verse</w> together.",
                            "target_lang_translations": {
                                "ru": "Священник попросил прихожан прочитать конкретный <w>стих</w> вместе.",
                                "zh": "牧师请会众一起诵读一段特定的<w>经文</w>。"
                            }
                        },
                        {
                            "text": "He memorized a <w>verse</w> from the scripture for the ceremony.",
                            "target_lang_translations": {
                                "ru": "Он выучил <w>стих</w> из писания для церемонии.",
                                "zh": "他为仪式背诵了一段<w>经文</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chapter and verse",
                        "bible verse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое нумерованное подразделение главы в священной книге, такой как Библия или Коран.",
                        "zh": "圣经或古兰经等圣书中章节的短小编号细分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стих",
                                "target_lang_sense_clarification": "в священных текстах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经文",
                                "target_lang_sense_clarification": "宗教文本中的段落"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d72a2e7-60f2-37ec-bf85-83f9a6a59bf9",
                    "sense_definition": "To play against or compete with an opponent in a game or contest.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team is <w>versing</w> the champions in the final match next week.",
                            "target_lang_translations": {
                                "ru": "Наша команда <w>играет против</w> чемпионов в финальном матче на следующей неделе.",
                                "zh": "下周的决赛中，我们的队伍将<w>对阵</w>冠军队。"
                            }
                        },
                        {
                            "text": "I do not want to <w>verse</w> him because he is much better at this game than I am.",
                            "target_lang_translations": {
                                "ru": "Я не хочу <w>играть против</w> него, потому что он гораздо лучше меня в этой игре.",
                                "zh": "我不想和他<w>较量</w>，因为他在这场游戏里比我强得多。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "verse against"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Derived from 'versus'; common in spoken English among younger speakers."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть против соперника или соревноваться с ним в игре или состязании.",
                        "zh": "在游戏或比赛中与对手竞争。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игра́ть про́тив",
                                "target_lang_sense_clarification": "соревноваться"
                            },
                            {
                                "target_lang_word": "сража́ться с",
                                "target_lang_sense_clarification": "быть соперником"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对阵",
                                "target_lang_sense_clarification": "比赛中对抗"
                            },
                            {
                                "target_lang_word": "较量",
                                "target_lang_sense_clarification": "竞争"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9abc2d68-1cc2-3359-92c0-364bd8a639db",
                    "sense_definition": "To teach or educate someone about a specific subject so they become skilled or knowledgeable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>versed</w> us in the finer points of the complex theory.",
                            "target_lang_translations": {
                                "ru": "Он <w>просветил</w> нас в тонкостях этой сложной теории.",
                                "zh": "他向我们<w>传授</w>了这一复杂理论的精妙之处。"
                            }
                        },
                        {
                            "text": "She <w>versed</w> herself in the local laws before starting the business.",
                            "target_lang_translations": {
                                "ru": "Она <w>изучила</w> местные законы перед тем, как начать бизнес.",
                                "zh": "在创业之前，她让自己<w>精通</w>了当地的法律。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "verse in",
                        "well versed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Учить или просвещать кого-либо по определённому предмету, чтобы он стал опытным или знающим.",
                        "zh": "教授或教育某人特定学科，使其变得熟练或知识渊博。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просвеща́ть",
                                "target_lang_sense_clarification": "передавать знания"
                            },
                            {
                                "target_lang_word": "обуча́ть",
                                "target_lang_sense_clarification": "учить чему-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传授",
                                "target_lang_sense_clarification": "教授知识"
                            },
                            {
                                "target_lang_word": "精通",
                                "target_lang_sense_clarification": "指对某事非常了解"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}