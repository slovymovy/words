                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contralto",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bff9279-67a5-34c7-99dc-02645a8a91ec",
                                        "entry_id": "3a2d14c6-b7a3-355e-b93c-7e0b47e45893",
                                        "glosses": [
                                            "La plus grave des voix de femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61cf4f80-e4d1-4a17-8ae2-8bf61fa5a678",
                                                "sense_id": "4bff9279-67a5-34c7-99dc-02645a8a91ec",
                                                "text": "Vous connaissez quelqu’une de ces voix harmonieuses et mâles qui rappellent en un registre plus grave le contralto de la femme."
                                            },
                                            {
                                                "example_id": "277d2a42-ce32-4a22-87c2-88e7c51a6f8e",
                                                "sense_id": "4bff9279-67a5-34c7-99dc-02645a8a91ec",
                                                "text": "Il atteint des régions qu’il avait jusque-là réservées à ses grandes œuvres chorales, telles que le Requiem allemand et la Rhapsodie pour contralto, à laquelle il est impossible de ne pas associer ce diptyque."
                                            },
                                            {
                                                "example_id": "9af035af-459b-4faf-88d4-241caae3f52f",
                                                "sense_id": "4bff9279-67a5-34c7-99dc-02645a8a91ec",
                                                "text": "Elle récitait ce poème, toujours le même, avec une voix de contralto."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contralto",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94194cb3-a90e-30f0-a6dd-9d8c391a991b",
                                        "entry_id": "9d9e56f6-3250-3bb4-a00a-3ad81a7493d1",
                                        "glosses": [
                                            "(Par métonymie) Cantatrice ayant comme type de voix un contralto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8db950c2-5ac8-4e49-89b2-b43867cdbe03",
                                                "sense_id": "94194cb3-a90e-30f0-a6dd-9d8c391a991b",
                                                "text": "Les contraltos."
                                            },
                                            {
                                                "example_id": "b7f3f36e-83da-493b-a948-6f44c86bc6de",
                                                "sense_id": "94194cb3-a90e-30f0-a6dd-9d8c391a991b",
                                                "text": "Il y a dans le violon — si, ne voyant pas l’instrument, on ne peut pas rapporter ce qu’on entend à son image, laquelle modifie la sonorité — des accents qui lui sont si communs avec certaines voix de contralto, qu’on a l’illusion qu’une chanteuse s’est ajoutée au concert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
