                "senses": [
                    {
                        "sense_id": "cf5a2748-670e-3b38-a99a-5ef254040607",
                        "entry_id": "01143f98-9335-31c4-b08d-96884d3cf68b",
                        "glosses": [
                            "de manier waarop land in stukken is verdeeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "047ab504-abc5-41bf-af99-1b603472edcf",
                                "sense_id": "cf5a2748-670e-3b38-a99a-5ef254040607",
                                "text": "De ligging van Stakenbeek is volgens wethouder Alida Renkema nu juist een pluspunt. „Dicht bij het spoor en dicht bij het gezondheidscentrum. Ook WBO Wonen doet volop mee in Berghuizen.” Het nadenken over de verkaveling van fase 2 van de Stakenbeek kan beginnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c23d4309-ad82-3096-97f8-89ff8b39b10a",
                        "entry_id": "01143f98-9335-31c4-b08d-96884d3cf68b",
                        "glosses": [
                            "de manier waarop een groter geheel in scherp afgegrensde delen is verdeeld"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "212a28c8-04e7-4a64-9121-9f0ff123a07d",
                                "sense_id": "c23d4309-ad82-3096-97f8-89ff8b39b10a",
                                "text": "Laten we de stelling omdraaien: onderwijs schept inzicht - en niet alleen bij de student, maar ook bij de docent. In een tijd van vergaande wetenschappelijke verkaveling durf ik te stellen dat het de curricula van opleidingen zijn, meer nog dan wetenschappelijke publicaties, die eenheid bieden aan een versplinterd kennislandschap."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5523c258-4a6a-4583-a06c-97bd5c13aaef",
                        "source_entry_id": "01143f98-9335-31c4-b08d-96884d3cf68b",
