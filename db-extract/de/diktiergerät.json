                "senses": [
                    {
                        "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                        "entry_id": "8a1ef1fb-bc4e-3d88-a47e-07e102b3a918",
                        "glosses": [
                            "Gerät zum Aufsprechen und Abhören von Text"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ac57b66-287a-4a54-8a02-3fcd2ca7d99c",
                                "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                "text": "Der Bauleiter ging durch den Rohbau und hielt sämtliche Mängel auf seinem Diktiergerät fest."
                            },
                            {
                                "example_id": "b9793e11-6ab1-4c60-a87c-3793f843611c",
                                "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                "text": "Chef, Ihr Diktiergerät muss defekt sein, auf dem Band ist nur ein Rauschen zu hören!"
                            },
                            {
                                "example_id": "1bcbd725-e2c1-407b-8301-3ad9082eb1e1",
                                "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                "text": "„Jeder Befund wird außerdem vom Obduzenten auf ein Diktiergerät gesprochen.“"
                            },
                            {
                                "example_id": "a9d96c34-a852-4d04-90ee-ab1853854254",
                                "sense_id": "cbbd8bd6-4a83-382d-b56a-7f5844df038d",
                                "text": "„Er horchte nach, ob das Diktiergerät noch lief, musste sichergehen, dass das Geständnis aufgezeichnet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
