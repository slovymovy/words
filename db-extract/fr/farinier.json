                        "glosses": [
                            "Personne qui vend de la farine ou qui travaille dans un moulin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8998920f-487e-4843-8214-67bf6ebfba91",
                                "sense_id": "ecbacfad-42b2-3ca6-99b6-a8d9da292c53",
                                "text": "Ce meunier a la clientèle de presque tous les fariniers."
                            },
                            {
                                "example_id": "bf6d75ba-1d39-46db-8846-d3fe454c375d",
                                "sense_id": "ecbacfad-42b2-3ca6-99b6-a8d9da292c53",
                                "text": "Alors on entend les domestiques et le farinier qui frottent leurs pieds au paillasson, près de la porte, et ils chuchotent, se demandant ce qu’il faut dire."
                            }
                        ]
