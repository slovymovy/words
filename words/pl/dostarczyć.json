                        "dostarczyć towar",
                        "dostarczyć na czas"
                    ],
                    "target_lang_definitions": {
                        "ru": "привезти или принести что-либо в назначенное место или получателю"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доставить",
                                "target_lang_sense_clarification": "посылку, груз, документы"
                            },
                            {
                                "target_lang_word": "вручить",
                                "target_lang_sense_clarification": "лично получателю"
