                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alcool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir en soirée, ils ont acheté un petit <w>flash</w> de vodka dans une épicerie de quartier."
                        },
                        {
                            "text": "Il a sorti un <w>flash</w> de son manteau pour en boire une gorgée rapide."
                        }
                    ],
                    "common_phrases": [
                        "flash de vodka"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argotique"
                        }
                    ]
                },
                {
                    "sense_id": "5b7e04f2-4b2f-3d48-9b59-a53cb014fd93",
                    "sense_definition": "Effet intense et quasi instantané provoqué par la prise de certaines drogues.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drogue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'injection de ce produit illicite provoque un <w>flash</w> brutal qui submerge complètement l'organisme."
                        },
                        {
                            "text": "Les toxicomanes décrivent cette première sensation comme un <w>flash</w> puissant et destructeur."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "milieu de la drogue"
                        }
                    ]
                },
                {
                    "sense_id": "499f8ea5-732f-3a59-9bb4-e244ab0ae4a6",
                    "sense_definition": "Motif de tatouage préconçu proposé par un artiste sans modification majeure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tatouage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a choisi un joli <w>flash</w> dans le classeur de dessins présentés par la tatoueuse."
                        },
                        {
                            "text": "Durant cette convention, les artistes réalisaient uniquement des <w>flashs</w> sans rendez-vous."
                        }
