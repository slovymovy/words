                                "example_id": "149a8144-5fb7-4ae6-8608-462647dc3f45",
                                "sense_id": "ae03bb20-6077-36dc-89f7-8ecf9c859d41",
                                "text": "Het is het soort halfslachtigheid waarin men in Brugge - en grote delen van de voetbalwereld - uitblinkt. \"Het is geen foute club, maar ze hebben een heel groot deel foute fans en daar durven ze niet tegenin te gaan\", constateert columnist Vandeweghe."
                            }
                        ]
                    }
