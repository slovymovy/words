                        "source_entry_id": "ff064c67-e0cb-3750-9260-bb24e2cab232",
                        "source_sense_id": "c62d7a5d-b87d-3b16-961f-75ecc6250224",
                        "target_lang_word": "Kneifer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kneifer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a741d87b-9485-333c-934d-1aa97861fa68",
                                        "entry_id": "1dcd1de1-d78c-347d-af5e-ca48a1dffbce",
                                        "glosses": [
                                            "Brille, die keine Bügel hat und nur auf die Nase geklemmt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92051ac9-bbd6-4bf5-8fe3-afd55b2b5c79",
                                                "sense_id": "a741d87b-9485-333c-934d-1aa97861fa68",
                                                "text": "„»Was hat'denn?« fragte der Wirt neugierig, drückte den schwarzen Kneifer fester auf die Nase und kam näher.“"
                                            },
                                            {
                                                "example_id": "6cd1933f-be17-4e4a-b394-c59543ca8d44",
                                                "sense_id": "a741d87b-9485-333c-934d-1aa97861fa68",
                                                "text": "„Sehr zornig schielt der Alte, jetzt schon wieder durch den Kneifer, auf Pagel.“"
                                            },
                                            {
                                                "example_id": "ac0ebed7-5538-4905-86d7-ced882f2a135",
                                                "sense_id": "a741d87b-9485-333c-934d-1aa97861fa68",
                                                "text": "„Der Kneifer war aus Fensterscheibenglas, ein Kinderspielzeug, auch meine Schwester bekam einen.“"
                                            },
                                            {
                                                "example_id": "0eadbfec-96da-4c78-b5d4-e7e3a7a6a2ae",
                                                "sense_id": "a741d87b-9485-333c-934d-1aa97861fa68",
                                                "text": "„Bach sah mich über seinen Kneifer hinweg unter buschigen Augenbrauen kummervoll an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3bd1a8d-ad44-4771-8dec-6723ac75798a",
                        "source_entry_id": "ff064c67-e0cb-3750-9260-bb24e2cab232",
                        "source_sense_id": "c62d7a5d-b87d-3b16-961f-75ecc6250224",
