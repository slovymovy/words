                ],
                "senses": [
                    {
                        "sense_id": "55c4a631-caae-3798-847e-e6b7ee076536",
                        "entry_id": "b7752b01-1e05-326f-91de-8de25fa23619",
                        "glosses": [
                            "Menge des Pigments Melanin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5cccbb0-9143-4ae6-94aa-efe97922ee4b",
                                "sense_id": "55c4a631-caae-3798-847e-e6b7ee076536",
                                "text": "„Durch die Vermehrung der Melanozyten steigt schließlich auch die produzierte Melaninmenge, sodass es zur sichtbaren Hyperpigmentierung kommt.“"
                            },
                            {
                                "example_id": "f6c23e7a-d602-4284-9af0-f22e6181d7e1",
                                "sense_id": "55c4a631-caae-3798-847e-e6b7ee076536",
                                "text": "„Ist viel Melanin vorhanden, erscheint das Auge braun oder gar schwarz, bei sehr wenig Melanin ist es blau, verschiedene Melaninmengen dazwischen ergeben grüne, graue oder hellbraune Augen.“"
                            },
                            {
                                "example_id": "6cb2be11-620e-45be-a565-7ca7d48a6773",
                                "sense_id": "55c4a631-caae-3798-847e-e6b7ee076536",
                                "text": "„Die Hautfarbe hängt von der vorhandenen Melaninmenge in der Epidermis ab, die genetisch bestimmt ist.“"
                            },
                            {
                                "example_id": "b192bcd0-4c49-4595-89cf-64d675dc4549",
                                "sense_id": "55c4a631-caae-3798-847e-e6b7ee076536",
                                "text": "„Gelbe, blonde Haare mit ganz geringen Melaninmengen, oft nur in der Haut auftretend.“"
                            },
                            {
                                "example_id": "9f5fbfd6-df46-43b9-9604-df9ee644aa40",
                                "sense_id": "55c4a631-caae-3798-847e-e6b7ee076536",
                                "text": "„Die Verdunklung der Fische beruht nach seinen Beobachtungen nicht nur auf der Expansion der Melanophoren, sondern auch auf der Zunahme der Melaninmenge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
