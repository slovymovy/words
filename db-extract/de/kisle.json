                ],
                "senses": [
                    {
                        "sense_id": "9648e363-f4e0-3534-bd66-cbc7eb6765c1",
                        "entry_id": "44d39be2-bb4b-322a-9b11-7613057627bd",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c3ee63e-2e75-42df-a4be-290c0b97ae9d",
                                "sense_id": "9648e363-f4e0-3534-bd66-cbc7eb6765c1",
                                "text": "Frau Kisle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "09f75923-b035-4701-a986-9fe58bf96464",
                                "sense_id": "9648e363-f4e0-3534-bd66-cbc7eb6765c1",
                                "text": "Herr Kisle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2c852068-d307-4a81-889d-58e21810edfa",
                                "sense_id": "9648e363-f4e0-3534-bd66-cbc7eb6765c1",
                                "text": "Die Kisles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "8a29605e-7a26-4185-a959-9a8320e46313",
                                "sense_id": "9648e363-f4e0-3534-bd66-cbc7eb6765c1",
                                "text": "Der Kisle trägt nie die Pullover, die die Kisle ihm strickt."
                            },
                            {
                                "example_id": "01a8a8a7-3e39-413b-bb19-daa0233ebdb5",
                                "sense_id": "9648e363-f4e0-3534-bd66-cbc7eb6765c1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kisle kommt, geht der Herr Kisle.“"
                            },
                            {
                                "example_id": "d40c0ad1-0409-4b9c-8697-eabd90808a4e",
                                "sense_id": "9648e363-f4e0-3534-bd66-cbc7eb6765c1",
                                "text": "Kisle kommt und geht."
                            },
                            {
                                "example_id": "47367f55-a62f-4c16-8303-62c9222c040f",
                                "sense_id": "9648e363-f4e0-3534-bd66-cbc7eb6765c1",
                                "text": "Kisles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
