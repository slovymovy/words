                                "ru": "Это <w>твоя</w> машина припаркована снаружи?",
                                "nl": "Is dat <w>jouw</w> auto die daar buiten geparkeerd staat?",
                                "pl": "Czy ten zaparkowany na zewnątrz samochód jest <w>twój</w>?",
                                "de": "Ist das <w>dein</w> Auto, das draußen parkt?",
                                "fr": "Est-ce que c'est <w>ta</w> voiture garée dehors ?",
                                "it": "È la <w>tua</w> macchina quella parcheggiata fuori?",
                                "cs": "Je to <w>tvoje</w> auto zaparkované venku?",
                                "tr": "Dışarıda park edilmiş olan araba <w>senin</w> mi?",
                                "es": "¿Es este <w>tu</w> coche aparcado fuera?",
                                "zh": "外面停的那辆车是<w>你的</w>吗？"
                            }
                        }
