                    },
                    {
                        "form_id": "1c0e0b68-648a-4113-b6c6-c9fe82942244",
                        "entry_id": "f700d985-f391-3460-8b32-fb80d12f113f",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "rijtuigje"
                    },
                    {
                        "form_id": "103e4910-1f33-48bf-8688-73b28674c2ec",
                        "entry_id": "f700d985-f391-3460-8b32-fb80d12f113f",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "rijtuigjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c31fb47-103f-376e-9760-9881884fe28a",
                        "entry_id": "f700d985-f391-3460-8b32-fb80d12f113f",
                        "glosses": [
                            "wagen die door een of meer paarden getrokken wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27d3d747-7e1a-416f-83e1-0438163902b8",
                                "sense_id": "9c31fb47-103f-376e-9760-9881884fe28a",
                                "text": "Te Berwick, niet ver van Chicago, lieten Donderdagavond laat zes roovers zich in een rijtuig naar de Bank rijden. Terwijl twee hunner (thans: van hen) buiten bleven om op het rijtuig te passen, gingen de vier anderen, met behulp van valsche sleutels, het gebouw binnen, lieten met dynamiet de brandkast openspringen en stalen daaruit 30,000 dollars in goud."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a5ce45a-7c66-3ccd-b67d-acb864d78441",
                        "entry_id": "f700d985-f391-3460-8b32-fb80d12f113f",
                        "glosses": [
                            "een van de wagens van trein of tram, treinwagon, tramwagon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3aff81-ca61-4395-a4b7-a6c08bab035e",
                                "sense_id": "5a5ce45a-7c66-3ccd-b67d-acb864d78441",
                                "text": "Als aanvulling op de eenheids-doorgangswagen („Donnerbüchsen“) werd het rijtuigfabrikaat Bi 29 ontwikkeld. Deze rijtuigen hadden geen open platforms, maar een gesloten instapruimte om reizigers in de 2e klas beter tegen tocht te beschermen."
                            }
                        ]
                    },
                    {
                        "sense_id": "01c66be1-794b-369c-9028-480138221a8a",
                        "entry_id": "f700d985-f391-3460-8b32-fb80d12f113f",
                        "glosses": [
                            "in meer algemene zin elk tuig waarmee kan worden gereden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea00b194-6791-4044-99d9-a40449c6e7ae",
                                "sense_id": "01c66be1-794b-369c-9028-480138221a8a",
                                "text": "zonder laatstgenoemde definitie zou een motorrijtuig anders geen rijtuig zijn(!) terwijl we lezen in de wet aansprakelijkheidsverzekering motorrijtuigen:\nArtikel 31\nOp de eerste vordering van de personen, belast met de opsporing van de in deze wet strafbaar gestelde feiten is de bestuurder van een motorrijtuig verplicht het rijtuig te doen stilhouden en indien hij ingevolge artikel 14 eerste lid, artikel 17 tweede lid of artikel 19 eerste lid een document bij zich moet hebben, dit behoorlijk ter inzage af te geven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f081d7c-6926-49f9-8f63-ab8927ac2f1b",
                        "source_entry_id": "f700d985-f391-3460-8b32-fb80d12f113f",
                        "source_sense_id": "9c31fb47-103f-376e-9760-9881884fe28a",
                        "source_sense_description": "wagen die door een of meer paarden getrokken wordt",
                        "target_lang_word": "Kutsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kutsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33b8d578-1c31-3510-8951-b742a7b6841d",
                                        "entry_id": "451ca8c9-4749-3803-a13f-d2d8b4c6682c",
                                        "glosses": [
                                            "ein- oder zweiachsiges Fuhrwerk mit Karosserie oder beweglichem Verdeck; (ursprünglich) durch Nutztiere wie Pferde oder Ochsen gezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5e14925-9970-43f2-b8e6-68cf2d8e8acd",
                                                "sense_id": "33b8d578-1c31-3510-8951-b742a7b6841d",
                                                "text": "In Wien ist es für viele Besucher unerlässlich, mit einer Kutsche durch die Stadt zu fahren."
                                            },
                                            {
                                                "example_id": "82ecf1f8-72bf-4d34-b12e-c6c34a981dd2",
                                                "sense_id": "33b8d578-1c31-3510-8951-b742a7b6841d",
                                                "text": "„Schon der Anblick einer Kutsche macht mich ja ganz krank.“"
                                            },
                                            {
                                                "example_id": "81a7b6f7-c840-4f7a-91e5-74f19271eba0",
                                                "sense_id": "33b8d578-1c31-3510-8951-b742a7b6841d",
                                                "text": "„Droschken und leichte Kutschen waren die einzigen von den Ordnungsbehörden noch zugelassenen Fahrzeuge.“"
                                            },
                                            {
                                                "example_id": "6ce216a8-064d-4ae6-9be9-25fc75cad405",
                                                "sense_id": "33b8d578-1c31-3510-8951-b742a7b6841d",
                                                "text": "„Andere wandten ein, es werde die Gemeinde zehn Pfund und zwölf Schilling für die Kutsche und die Dienste eines Wärters kosten, das Mädchen zur Einschiffung nach London zu schaffen.“"
                                            },
                                            {
                                                "example_id": "9f3b3d9a-6447-47af-a091-ce6dc3c56552",
                                                "sense_id": "33b8d578-1c31-3510-8951-b742a7b6841d",
                                                "text": "„Isa und ich stiegen in die Kutsche, und auf rumpeligem Kopfsteinpflaster ging es nach Müggenburg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9741682f-8f13-31d2-bdda-8859b55227c2",
                                        "entry_id": "451ca8c9-4749-3803-a13f-d2d8b4c6682c",
                                        "glosses": [
                                            "ein Auto"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84613418-772a-4958-a45a-5d81e36a3929",
                                                "sense_id": "9741682f-8f13-31d2-bdda-8859b55227c2",
                                                "text": "Schafft denn deine Kutsche die Fahrt nach Italien noch?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d16e23a7-8fab-400d-911e-727046745a4e",
                        "source_entry_id": "f700d985-f391-3460-8b32-fb80d12f113f",
                        "source_sense_id": "5a5ce45a-7c66-3ccd-b67d-acb864d78441",
                        "source_sense_description": "een van de wagens van trein of tram",
                        "target_lang_word": "Wagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7892d72-cc06-3155-a184-ea34fd417a5d",
                                        "entry_id": "7595db21-a04c-3612-81f0-bb6f3b042521",
                                        "glosses": [
                                            "einachsiges oder mehrachsiges Fahrzeug zum Transport beliebiger Dinge, mit Muskelkraft bewegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d44ca3c-913b-478d-bdc4-c51e6a812cd4",
                                                "sense_id": "b7892d72-cc06-3155-a184-ea34fd417a5d",
                                                "text": "Die Ochsen hatten Mühe, den Wagen zu ziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "161fdf10-98bc-3232-8046-49d3d281af41",
                                        "entry_id": "7595db21-a04c-3612-81f0-bb6f3b042521",
                                        "glosses": [
                                            "ein Auto, Automobil"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03e82002-766d-45ea-a624-06c0fe5b41fe",
                                                "sense_id": "161fdf10-98bc-3232-8046-49d3d281af41",
                                                "text": "Harry, fahr' schon mal den Wagen vor."
                                            },
                                            {
                                                "example_id": "1c8817c3-59cc-4cca-a134-1bd99d9ecadb",
                                                "sense_id": "161fdf10-98bc-3232-8046-49d3d281af41",
                                                "text": "„Die Chauffeure fuhren die schweren, olivgrünen Wagen um den Teich herum und parkten sie ausgerichtet nebeneinander.“"
                                            },
                                            {
                                                "example_id": "ec69772e-cacc-4816-9969-92e28a84d366",
                                                "sense_id": "161fdf10-98bc-3232-8046-49d3d281af41",
                                                "text": "„Alle Essenszubereitungen mussten außerhalb des Wagens stattfinden und niemand durfte im Wagen ein Sandwich essen, für den Fall, dass Brotkrumen hinunterfielen.“"
                                            },
                                            {
                                                "example_id": "47e68fd8-4ca0-4224-b5a8-23de760142cc",
                                                "sense_id": "161fdf10-98bc-3232-8046-49d3d281af41",
                                                "text": "„Während der Junge die Dynamitkartons auf die Wägen lud, lauschte er den Kommentaren der Arbeiter zum Weltgeschehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "07c77440-89bc-365b-89aa-1dc17b37c3f8",
                                        "entry_id": "7595db21-a04c-3612-81f0-bb6f3b042521",
                                        "glosses": [
                                            "ein Sternbild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80663d3d-45f5-44ad-9014-33e086f57a3a",
                                                "sense_id": "07c77440-89bc-365b-89aa-1dc17b37c3f8",
                                                "text": "Den Großen Wagen kann man nur nachts sehen, weil er ein Sternbild ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "aa49fa5b-2c49-304a-a041-ffaa2f9500cf",
                                        "entry_id": "7595db21-a04c-3612-81f0-bb6f3b042521",
                                        "glosses": [
                                            "Schienenfahrzeug, das entweder von einer Lok gezogen wird oder einen eigenen Antrieb besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f2d2160-1fb3-4a7c-9bc6-d926e113ea8c",
                                                "sense_id": "aa49fa5b-2c49-304a-a041-ffaa2f9500cf",
                                                "text": "Die Wagen der ersten Klasse befinden sich im vorderen Zugteil."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caf5a688-631d-4005-81bb-53512af0c648",
                        "source_entry_id": "f700d985-f391-3460-8b32-fb80d12f113f",
