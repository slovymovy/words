                    {
                        "sense_id": "ac40a784-a4a7-3536-b597-07ded419a29e",
                        "entry_id": "30f2016a-279d-38e8-ab37-0815a50cc01d",
                        "glosses": [
                            "A concentrated fruit drink; a cordial."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9d810666-a93c-44ad-8c35-75e6f1e40ecb",
                                "sense_id": "ac40a784-a4a7-3536-b597-07ded419a29e",
                                "text": "So it came about that at three o'clock of that same afternoon, Rhoda Dawes and Anne Meredith sat primly on their chairs in Poirot's neat room and sipped blackberry sirop (which they disliked very much but were too polite to refuse) from old-fashioned glasses."
                            }
                        ]
                    },
                    {
                        "sense_id": "f897fab3-f587-3e8c-a0ab-ce127b5879cd",
                        "entry_id": "30f2016a-279d-38e8-ab37-0815a50cc01d",
                        "glosses": [
                            "A kettle used in making sugar by the open-kettle process."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4d91dc45-ea2a-4e5c-838e-98a5891d4987",
                                "sense_id": "f897fab3-f587-3e8c-a0ab-ce127b5879cd",
                                "text": "It is then dipped into the Flambeau, where it is brushed and cleaned, then passed to the Sirop, where it is further brushed, and finally into the Batterie, where it is concentrated to the granulating point—a density of about 45 degrees Baumé, and with a temperature of about 240 degrees Fahrenheit."
                            }
                        ]
                    }
