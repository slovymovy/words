                "translations": [
                    {
                        "translation_id": "ff452d81-94a9-4830-9f65-d2457e829d51",
                        "source_entry_id": "16bf71f0-d887-3111-8648-1c3b412d2879",
                        "source_sense_id": "6c08f356-8f94-3f41-8918-9f4499cbd50f",
                        "source_sense_description": "vor kurzer, nicht allzu langer Zeit",
                        "target_lang_word": "dernièrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dernièrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eebecc6b-8cb5-368a-9aab-d10a9479e44b",
                                        "entry_id": "88b21465-3c92-3bc4-9e8a-ce18abb584b9",
                                        "glosses": [
                                            "Il y a peu de temps, récemment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0ed5b91-78a5-45b0-8ae2-025bd0b94387",
                                                "sense_id": "eebecc6b-8cb5-368a-9aab-d10a9479e44b",
                                                "text": "Dernièrement, j'avais eu la maladresse de m'enrhumer en pleine chaleur."
                                            },
                                            {
                                                "example_id": "df356d05-7a62-4cee-be79-627388d03ae1",
                                                "sense_id": "eebecc6b-8cb5-368a-9aab-d10a9479e44b",
                                                "text": "Tout dernièrement encore, un trois-mâts français, […], avait rebroussé chemin vers le Costa Rica, où il avait dû être condamné car sa coque était entièrement mangée par les tarets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7741b5f9-c3e7-4864-b9e2-5be44baac3be",
                        "source_entry_id": "16bf71f0-d887-3111-8648-1c3b412d2879",
                        "source_sense_id": "6c08f356-8f94-3f41-8918-9f4499cbd50f",
                        "source_sense_description": "vor kurzer, nicht allzu langer Zeit",
                        "target_lang_word": "récemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "récemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6af15f22-103f-3716-bbea-96c55618379c",
                                        "entry_id": "d168b27d-2a64-355d-994a-91ae69bed098",
                                        "glosses": [
                                            "Il y a peu de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca9760cd-b76e-43ca-9ee3-4158e8391513",
                                                "sense_id": "6af15f22-103f-3716-bbea-96c55618379c",
                                                "text": "— Parfaitement... et il a dit à ces dames que c'était un étranger, arrivé récemment à Paris et colossalement riche."
                                            },
                                            {
                                                "example_id": "c3a6697d-7cd3-43fa-8f3b-f65a6363bfd1",
                                                "sense_id": "6af15f22-103f-3716-bbea-96c55618379c",
                                                "text": "Plusieurs constitutions adoptées récemment ont inclus des garanties spécifiques liées à la liberté d'information, reflétant une acceptation croissante de ce droit humain fondamental."
                                            },
                                            {
                                                "example_id": "2a63b65f-141f-47f3-b937-48631bb7f4a3",
                                                "sense_id": "6af15f22-103f-3716-bbea-96c55618379c",
                                                "text": "Les tribus, dites actuellement arabes, résultent du mélange des Beni-Hassan ou Hassan, plus récemment arrivés dans le pays, avec les Zenaga qui y étaient établis plus anciennement."
                                            },
                                            {
                                                "example_id": "bb43bd01-e814-4ee8-886a-974ec49d1a7e",
                                                "sense_id": "6af15f22-103f-3716-bbea-96c55618379c",
                                                "text": "Récemment relancé par Mehdi Chaoua et Ayoub Shaïb, deux amis et enfants du quartier de Crouin, le Club Football Crouin (CFC) a besoin d’un soutien financier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d8442a4-146c-4d3e-95bd-bbd59ebe4d39",
                        "source_entry_id": "16bf71f0-d887-3111-8648-1c3b412d2879",
                        "source_sense_id": "6c08f356-8f94-3f41-8918-9f4499cbd50f",
                        "source_sense_description": "vor kurzer, nicht allzu langer Zeit",
                        "target_lang_word": "el otro día",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ab8ac375-4acb-4286-a844-e2c32198f7d5",
                        "source_entry_id": "16bf71f0-d887-3111-8648-1c3b412d2879",
                        "source_sense_id": "e058f18f-f93b-3743-b1e9-2fa29efcf475",
                        "source_sense_description": "in letzter Konsequenz",
                        "target_lang_word": "à la fin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à la fin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31a6d3ed-4ba5-31ea-8e7f-63eccfa3d6f7",
                                        "entry_id": "dccd8014-ae9b-3653-8109-3777d47ae621",
                                        "glosses": [
                                            "Finalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14e18872-391d-4aac-9b00-bda50d937001",
                                                "sense_id": "31a6d3ed-4ba5-31ea-8e7f-63eccfa3d6f7",
                                                "text": "L’argent ! ce mot retentissait à mes oreilles, toutes les minutes. Je n’entendais jamais que le tintement de ce mot qui, à la fin, avait pris comme une sonorité d’écus remués."
                                            },
                                            {
                                                "example_id": "25bb5e5f-d40b-4496-8262-b8a33b9dd387",
                                                "sense_id": "31a6d3ed-4ba5-31ea-8e7f-63eccfa3d6f7",
                                                "text": "Bert parcourut l’île en tous sens […] pour tâcher de découvrir l’officier blessé. À la fin, il le fit débusquer de quelques buissons épais […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "927c9efa-69a3-3a77-b7b5-cae4db4d6569",
                                        "entry_id": "dccd8014-ae9b-3653-8109-3777d47ae621",
                                        "glosses": [
                                            "Pour marquer l’exaspération, l’impatience."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2c8380d-728a-4de8-ac71-a5dc4b4385e7",
                                                "sense_id": "927c9efa-69a3-3a77-b7b5-cae4db4d6569",
                                                "text": "— Tonnerre de Dieu ! veux-tu te taire à la fin, cochon !…"
                                            },
                                            {
                                                "example_id": "5730eaaa-137c-47d5-a61c-44a4fae5d1ed",
                                                "sense_id": "927c9efa-69a3-3a77-b7b5-cae4db4d6569",
                                                "text": "Tout ce boucan, ça vous porte sur les nerfs, à la fin !… On dirait une foule qui crie…, on dirait des gens qui trépignent…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23f2b42c-8b9e-4f6e-9183-a5d39c822e1b",
                        "source_entry_id": "16bf71f0-d887-3111-8648-1c3b412d2879",
                        "source_sense_id": "e058f18f-f93b-3743-b1e9-2fa29efcf475",
                        "source_sense_description": "in letzter Konsequenz",
                        "target_lang_word": "finalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                        "entry_id": "f4f6d6f2-dd9d-38d7-96bf-39b85adbd771",
                                        "glosses": [
                                            "Pour en finir ; en dernier résultat ; en dernier lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a9b6a3b-89ab-446c-8935-19d67cda8f54",
                                                "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                                "text": "C'était la première fois qu'il se risquait au Montparnasse. Ses regards inspectèrent la salle et, finalement, se fixèrent sur la grosse nuque puissante de Feempje."
                                            },
                                            {
                                                "example_id": "7bcae689-8cf8-487a-8cc0-a1d50e89a7e0",
                                                "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                                "text": "Les groupes ukrainiens, mexicains, lettons et lituaniens, qui devaient y participer, n’ont finalement pas pu être présents pour entonner la Marseillaise."
                                            },
                                            {
                                                "example_id": "6b44bc53-c853-4b70-8e08-70bdd811a123",
                                                "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                                "text": "Le mystère des perturbations de l’orbite de Mercure n'a finalement été élucidé qu'avec la théorie de la relativité générale proposée par Albert Einstein au début du XX^(ème) siècle."
                                            },
                                            {
                                                "example_id": "4f40607c-d72e-4705-abdb-70e234d2e374",
                                                "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                                "text": "A Clervaux, les Allemands relancèrent l'assaut contre le château. Finalement les obus à charge creuse eurent raison des épaisses murailles, et des incendies éclatèrent."
                                            },
                                            {
                                                "example_id": "cb7f0848-e257-4684-9810-c858949112bb",
                                                "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                                "text": "Une carence en carnitine aboutit à un dysfonctionnement mitochondrial, provoquant finalement la faiblesse musculaire."
                                            },
                                            {
                                                "example_id": "0416a0ff-ccde-4999-b05a-a327c85df4cc",
                                                "sense_id": "674db0d1-3335-385f-8b02-84d6a13dec38",
                                                "text": "La crise du Covid-19 pourrait finalement faire de Bruno Le Maire le ministre de la nationalisation d’Air France et d’un déficit et d’une dette records, dans l’espoir de contenir, «quoi qu’il en coûte», l’incendie économique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74cd090b-089d-4ab1-9570-077992768696",
                        "source_entry_id": "16bf71f0-d887-3111-8648-1c3b412d2879",
                        "source_sense_id": "e058f18f-f93b-3743-b1e9-2fa29efcf475",
