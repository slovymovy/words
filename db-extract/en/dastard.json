    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "161e6e45-4223-3c23-b9ba-100ea3c319dd",
                "word": "dastard",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "75eaa2e0-8df0-48e0-b904-7d13475a2984",
                        "entry_id": "161e6e45-4223-3c23-b9ba-100ea3c319dd",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more dastard"
                    },
                    {
                        "form_id": "7b441b11-dc5a-4c89-ad09-a3b9ed9609d2",
                        "entry_id": "161e6e45-4223-3c23-b9ba-100ea3c319dd",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most dastard"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05baff90-cf72-35ed-8ca7-74f99bc5c69d",
                        "entry_id": "161e6e45-4223-3c23-b9ba-100ea3c319dd",
                        "glosses": [
                            "Meanly shrinking from danger, cowardly, dastardly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36f2472d-6719-4716-b0f0-489ae18a16dd",
                                "sense_id": "05baff90-cf72-35ed-8ca7-74f99bc5c69d",
                                "text": "1590, Edmund Spenser, The Faerie Queene, Book III, Canto One, Stanza 22, in The Faerie Queene, Books Three and Four, edited by Dorothy Stephens, Hackett, 2006, p. 13,\nLike dastard Curres, that having at a bay\nThe salvage beast embost in wearie chace,\nDare not adventure on the stubborne pray,\nNe byte before, but rome from place to place,\nTo get a snatch, when turned is his face."
                            },
                            {
                                "example_id": "43566c75-c7e6-49c7-9a38-8d69c1f3d3a0",
                                "sense_id": "05baff90-cf72-35ed-8ca7-74f99bc5c69d",
                                "text": "Now dragg'd once more beyond the western main,\nTo groan beneath some dastard planter’s chain;\nWhere my poor countrymen in bondage wait\nThe long enfranchisement of ling’ring fate:"
                            },
                            {
                                "example_id": "c4337a7e-f9d1-44c1-b650-01f993015342",
                                "sense_id": "05baff90-cf72-35ed-8ca7-74f99bc5c69d",
                                "text": "Observe, too, that this is all a modern affair; belongs not to the old heroic times, but to these dastard new times. ‘Happiness our being’s end and aim’ is at bottom, if we will count well, not yet two centuries old in the world."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7aa94d19-094f-42bf-bca3-c9532ff7c327",
                        "source_entry_id": "161e6e45-4223-3c23-b9ba-100ea3c319dd",
                        "source_sense_id": "05baff90-cf72-35ed-8ca7-74f99bc5c69d",
                        "source_sense_description": "meanly shrinking from danger, cowardly",
                        "target_lang_word": "hinterhältig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hinterhältig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69c86c1a-fe38-33b5-b316-f9e3f6329503",
                                        "entry_id": "38345aa2-762e-3fc0-bb93-6c7ccd74c397",
                                        "glosses": [
                                            "die offene Auseinandersetzung scheuend, oftmals nach außen hin freundlich, aber mit bösen Absichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aab34fe9-3ab9-47b2-9299-d342307b8864",
                                                "sense_id": "69c86c1a-fe38-33b5-b316-f9e3f6329503",
                                                "text": "Der Kerl ist ein hinterhältiger Betrüger!"
                                            },
                                            {
                                                "example_id": "4a6ce279-b34b-4201-abee-318d69cf0e04",
                                                "sense_id": "69c86c1a-fe38-33b5-b316-f9e3f6329503",
                                                "text": "Bei dem hinterhältigen Angriff stach der Täter dem Opfer mit einem Messer in den Rücken."
                                            },
                                            {
                                                "example_id": "94ea658c-e4bc-45eb-9b7f-4a844eb92240",
                                                "sense_id": "69c86c1a-fe38-33b5-b316-f9e3f6329503",
                                                "text": "Ihm jetzt in den Rücken zu fallen ist hinterhältig und gemein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "041e3c09-9efa-46a7-b669-745ae6cec052",
                        "source_entry_id": "161e6e45-4223-3c23-b9ba-100ea3c319dd",
                        "source_sense_id": "05baff90-cf72-35ed-8ca7-74f99bc5c69d",
                        "source_sense_description": "meanly shrinking from danger, cowardly",
                        "target_lang_word": "heimtückisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heimtückisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14e58828-78e6-30fc-b81f-85aef00c8527",
                                        "entry_id": "e6c0602f-18ae-36b2-951b-f1ac62b08447",
                                        "glosses": [
                                            "voller Heimtücke; harmlos erscheinend, dabei aber sehr gefährlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "496509fc-54b3-44b1-ab3d-7c72bb16d692",
                                                "sense_id": "14e58828-78e6-30fc-b81f-85aef00c8527",
                                                "text": "Der Tierquäler ging auf besonders heimtückische Weise vor, indem er seine Opfer mit Leckereien anlockte."
                                            },
                                            {
                                                "example_id": "41a5c772-3dc2-4733-a4b3-2d69429041a1",
                                                "sense_id": "14e58828-78e6-30fc-b81f-85aef00c8527",
                                                "text": "Borreliose ist eine heimtückische Krankheit. Oft wird sie erst bemerkt, wenn es schon zu spät ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "7da21394-5c9c-302c-8874-547e910251c8",
                "word": "dastard",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "80ed2f38-cc39-498c-b8ae-10dd509259fe",
                        "entry_id": "7da21394-5c9c-302c-8874-547e910251c8",
                        "tags": [
                            "plural"
                        ],
                        "form": "dastards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "883a28fa-41c0-367d-87e0-478b22d0de17",
                        "entry_id": "7da21394-5c9c-302c-8874-547e910251c8",
                        "glosses": [
                            "A malicious coward; a dishonorable sneak."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e43166dc-0b4e-45e7-bbab-db93c7b685d7",
                                "sense_id": "883a28fa-41c0-367d-87e0-478b22d0de17",
                                "text": "I thought ye would never have given out these arms till you had recovered your ancient freedom: but you are all recreants and dastards, and delight to live in slavery to the nobility."
                            },
                            {
                                "example_id": "57276973-2911-48dd-9634-130e64f3b600",
                                "sense_id": "883a28fa-41c0-367d-87e0-478b22d0de17",
                                "text": "The dastard, that did heare him selfe defyde, / Seem'd not to weigh his threatfull words at all, / But laught them out, as if his greater pryde, / Did scorne the challenge of so base a thrall: Or had not courage, or else had no gall."
                            },
                            {
                                "example_id": "1358d04f-6d87-45d4-856e-3a57d6636010",
                                "sense_id": "883a28fa-41c0-367d-87e0-478b22d0de17",
                                "text": "My client, an innately bashful man, would be the last man in the world to do anything ungentlemanly which injured modesty could object to or cast a stone at a girl who took the wrong turning when some dastard, responsible for her condition, had worked his own sweet will on her."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dd4560b-c097-4bc4-b338-a822024ded91",
                        "source_entry_id": "7da21394-5c9c-302c-8874-547e910251c8",
                        "source_sense_id": "883a28fa-41c0-367d-87e0-478b22d0de17",
                        "source_sense_description": "malicious coward",
                        "target_lang_word": "Feigling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feigling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                        "entry_id": "68d08fb9-82ee-3a71-b31a-97dbe7378338",
                                        "glosses": [
                                            "furchtsame, ängstliche, risikoscheue Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef2bf05-5c64-4b48-9be2-42eab284e81d",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "Sei kein solcher Feigling und sag deinem Chef endlich mal richtig die Meinung!"
                                            },
                                            {
                                                "example_id": "80b97be5-baa2-4700-9ea8-f667b9670c3b",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Wer eine Familie mit fünf Töchtern gründet, kann kein Feigling sein.“"
                                            },
                                            {
                                                "example_id": "8dcd235e-67cb-432f-ad58-cf295d7da7d0",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Anstatt seinen Leuten zu Hilfe zu kommen, drehte sich dieser jämmerliche Feigling plötzlich um und gab Fersengeld.“"
                                            },
                                            {
                                                "example_id": "3b0e40a9-db73-4956-a505-614ed72cb053",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Nun schämten sich die Moskowiter wohl, dass sie als Feiglinge bezeichnet wurden, und schämten sich, dass sie wegfuhren, fuhren aber trotzdem weg, weil sie wussten, dass es sein musste.“"
                                            },
                                            {
                                                "example_id": "9e39e1ca-6039-4809-8fbb-6bfd8778ba3c",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "(„Soll ich da mal rüberbalancieren?“) – „Tu doch, mach doch, Feigling!“ – (Mögliche Antwort:) „Lieber ein Feigling sein, als einem Doofen ein’n Gefallen tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c0d4a18-d35a-4b08-a2da-2a4eab0cc0e5",
                        "source_entry_id": "7da21394-5c9c-302c-8874-547e910251c8",
