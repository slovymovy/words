                        "transmit",
                        "send",
                        "televise",
                        "relay"
                    ],
                    "antonyms": [
                        "narrowcast"
                    ],
                    "common_phrases": [
                        "broadcast live",
                        "broadcast news",
                        "broadcast a signal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать сообщение или сигнал посредством радиоволн или электронных средств.",
                        "zh": "通过无线电波或电子手段传输信息或信号。",
                        "de": "Eine Nachricht oder ein Signal über Funkwellen oder elektronische Medien übertragen.",
                        "tr": "Radyo dalgaları veya elektronik araçlar yoluyla bir mesaj veya sinyal iletmek."
                    },
