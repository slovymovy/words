                    {
                        "sense_id": "a4d14c91-fbbd-3edb-ac40-26f2f6269b41",
                        "entry_id": "8551afaa-4ea8-384d-8a86-aae859232d72",
                        "glosses": [
                            "Employé qui s'occupe de la réception des marchandises lors de leur arrivée au point de vente ou de distribution. Le réceptionnaire se charge de rentrer les nouvelles marchandises dans la base de données de l'entreprise. Il est responsable du stock et des marges de l'entreprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe2809f-31d0-4dc7-a408-df2f8a52de6c",
                                "sense_id": "a4d14c91-fbbd-3edb-ac40-26f2f6269b41",
                                "text": "Le réceptionnaire m’a demandé d’aller chercher des palettes dehors."
                            }
                        ]
                    },
                    {
                        "sense_id": "6864aa67-7e88-347d-8ffe-745a3b52be6e",
                        "entry_id": "8551afaa-4ea8-384d-8a86-aae859232d72",
                        "glosses": [
                            "Responsable de la réception des personnes dans un grand hôtel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ee5af2b-ab42-4b51-8791-1fcf15de18a2",
                                "sense_id": "6864aa67-7e88-347d-8ffe-745a3b52be6e",
                                "text": "Les serveurs servaient, les gouvernantes gouvernaient, les réceptionnaires réceptionnaient."
                            }
                        ]
                    }
                ],
