                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "der Abwesende",
                                "target_lang_sense_clarification": "männliche oder generische Person, die nicht anwesend ist"
                            },
                            {
                                "target_lang_word": "die Abwesende",
                                "target_lang_sense_clarification": "weibliche Person, die nicht anwesend ist"
                            }
                        ]
