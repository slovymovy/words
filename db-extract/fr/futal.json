                        "examples": [
                            {
                                "example_id": "7800c8b5-7fb8-46e9-a8a9-91b98006aa71",
                                "sense_id": "9bdd93d6-7fcd-32ef-9379-d0fd177fc39a",
                                "text": "Hé! T'as vu mon futal? T'as vu l'état? Ils vont me le rembourser au journal?"
                            },
                            {
                                "example_id": "15cc8db1-faf3-4a68-b897-d0e3fc19c6fb",
                                "sense_id": "9bdd93d6-7fcd-32ef-9379-d0fd177fc39a",
                                "text": "J’ai grossi, je ne rentre plus dans mon futal."
                            },
                            {
                                "example_id": "3424aa4d-4349-461c-ad63-9f63f6029ea6",
                                "sense_id": "9bdd93d6-7fcd-32ef-9379-d0fd177fc39a",
                                "text": "J'y ai filé mon futal."
                            },
                            {
                                "example_id": "89015e64-61c9-4492-a485-61dab1236cf5",
                                "sense_id": "9bdd93d6-7fcd-32ef-9379-d0fd177fc39a",
                                "text": "- Et au fait ! Vachement chic, le futal !\n- C’est un jean ! Import direct from United States !"
                            }
                        ]
                    }
                ],
