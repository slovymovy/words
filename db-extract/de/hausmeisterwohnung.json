                                "sense_id": "a8c809ec-7706-30fa-bacc-885f84a5886e",
                                "text": "„Die im Erdgeschoss liegende, drei Räume umfassende Hausmeisterwohnung wird dafür umgebaut.“"
                            },
                            {
                                "example_id": "b6f12985-d8f0-4b7b-b154-29575002da77",
                                "sense_id": "a8c809ec-7706-30fa-bacc-885f84a5886e",
                                "text": "„Die nötigen Räumlichkeiten wurden durch den Ausbau einer Hausmeisterwohnung geschaffen, der rechtzeitig abgeschlossen werden konnte. “"
                            }
                        ],
