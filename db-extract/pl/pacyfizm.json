                    {
                        "translation_id": "31a88b02-b4de-4a56-8cd0-b56532de7303",
                        "source_entry_id": "8b04c603-2208-3028-ad0e-8cc99d346289",
                        "source_sense_id": "f786e8ec-76df-319f-8956-29e9075e41b4",
                        "target_lang_word": "Pazifismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pazifismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85c9ab73-2d4e-3a49-963a-a99d45ca768a",
                                        "entry_id": "9c5f87e9-140c-33ad-a8a2-ad8082440fe7",
                                        "glosses": [
                                            "die Ideologie, die sich für den Frieden einsetzt und den Krieg und die Gewalt ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df0f34cf-b1e2-4a7e-bacd-e9f166bf15de",
                                                "sense_id": "85c9ab73-2d4e-3a49-963a-a99d45ca768a",
                                                "text": "„Wir müssen unsere Kinder gegen Militarismus impfen, indem wir sie im Geiste des Pazifismus erziehen.“"
                                            },
                                            {
                                                "example_id": "c50f5309-cfb5-4b21-ad6c-026bcadd184b",
                                                "sense_id": "85c9ab73-2d4e-3a49-963a-a99d45ca768a",
                                                "text": "„In Zürich hat Einstein bei einem Freund des Vaters, Gustav Maier, Unterstützung für seinen frühentwickelten Pazifismus gefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1918925-9d61-49d3-9853-b092100ed5d6",
                        "source_entry_id": "8b04c603-2208-3028-ad0e-8cc99d346289",
                        "source_sense_id": "f786e8ec-76df-319f-8956-29e9075e41b4",
                        "target_lang_word": "пацифизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пацифизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "763a32c5-6d87-3eaa-8aa3-0a507f52ed32",
                                        "entry_id": "df6908a3-f007-302c-85b9-e12b6f31e991",
                                        "glosses": [
                                            "полит. мировоззрение, основанное на осуждении всяческих войн, также основанное на этом мировоззрении антивоенное движение, участники которого отрицают всякие войны, в том числе национально-освободительные и революционные"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1406ab03-51af-4918-81e1-936533ac6dd9",
                                                "sense_id": "763a32c5-6d87-3eaa-8aa3-0a507f52ed32",
                                                "text": "И я за пацифизм, но только если появятся условия, исключающие войну."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb813844-9d5a-3f19-b3a5-d31b677990cd",
                                        "entry_id": "df6908a3-f007-302c-85b9-e12b6f31e991",
                                        "glosses": [
                                            "миролюбие, стремлении избегать конфликтов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "547a113b-0c4d-4195-9e12-d99d785eef2c",
                                                "sense_id": "cb813844-9d5a-3f19-b3a5-d31b677990cd",
                                                "text": "Каждый родитель должен научиться отдавать распоряжение, должен уметь не уклоняться от него, не прятаться от него ни за спиной родительской лени, ни из побуждений семейного пацифизма."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
