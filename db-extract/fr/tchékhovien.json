                                        "glosses": [
                                            "Of or pertaining to Anton Chekhov (1860–1904) or his writings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a691caf-473e-462f-8afa-f68678adc5e4",
                                                "sense_id": "7e00e3c7-5b81-3fde-b1e7-e2cdc22843bf",
                                                "text": "The structure of society in which the wealthy intelligentsia are sustained by armies of serfs and pontificate over the politics of Tsarist Russia only serves to reinforce the Chekhovian imagery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
