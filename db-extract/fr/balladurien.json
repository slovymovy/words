                        "entry_id": "5b86fb8a-a5e3-3c1a-9229-214371379ccc",
                        "glosses": [
                            "Relatif à Édouard Balladur, ou à sa politique."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "dec8b95f-757e-4fc7-899e-3b54c56cd3fa",
                                "sense_id": "e1ffa56e-4183-3e29-a5e1-e41727c30bb1",
                                "text": "Pour contrer l’offensive balladurienne, la thématique laïque et républicaine du candidat de la «fracture sociale» avait fait un tabac dans les obédiences."
                            },
                            {
                                "example_id": "5849e468-6be2-4773-bb80-8ef39b705d77",
                                "sense_id": "e1ffa56e-4183-3e29-a5e1-e41727c30bb1",
                                "text": "À travers des soupçons de financement illégal de la campagne présidentielle de 1995, via un système de rétrocommissions, le passé balladurien de l’actuel chef de l’État remonte à la surface."
                            }
                        ]
                    }
