                    {
                        "sense_id": "91321eb2-ae3d-3318-8837-5088dbf95d3a",
                        "entry_id": "75e2005e-3be4-3f70-926e-d762eb8e8be2",
                        "glosses": [
                            "apparaat waarmee men geluid- of lichtsignalen kan geven"
