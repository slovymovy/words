                        "glosses": [
                            "In a speechless manner; without speaking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f67bc465-f0ad-4059-b113-c8b3fb21567c",
                                "sense_id": "bb6e30f4-c09a-3b84-8fd9-5041f61e3b57",
                                "text": "He stood there speechlessly. The surprise had rendered him unable to make an intelligible reply."
                            },
                            {
                                "example_id": "4864f0b8-6b2a-420f-87b6-de39cc15b2ec",
                                "sense_id": "bb6e30f4-c09a-3b84-8fd9-5041f61e3b57",
                                "text": "That afternoon they stood at the foot of Mrs. Civil's bed. She was propped up by pillows, and through the little window looking westward the afternoon sun blazed unsparingly on the discoloured face of the sick woman, speechlessly rigid."
                            },
                            {
                                "example_id": "a6b0edbc-51e2-4c31-a565-31160b88b3b5",
                                "sense_id": "bb6e30f4-c09a-3b84-8fd9-5041f61e3b57",
                                "text": "His eyes grew round and he pointed speechlessly into space."
                            }
                        ]
                    }
