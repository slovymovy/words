                ],
                "translations": [
                    {
                        "translation_id": "9ef14de7-646c-48d2-baf9-14ab95f65672",
                        "source_entry_id": "9becb9a3-d622-3d57-a6a2-5cb53770598b",
                        "source_sense_id": "a5737b05-d050-3e91-a239-573ab28da8fb",
                        "target_lang_word": "be glad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ae22f45b-3243-49fc-a81b-cb3be5878590",
                        "source_entry_id": "9becb9a3-d622-3d57-a6a2-5cb53770598b",
                        "source_sense_id": "a5737b05-d050-3e91-a239-573ab28da8fb",
                        "target_lang_word": "be happy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8c9f3529-c75b-4fc8-be64-02e65634f2b8",
                        "source_entry_id": "9becb9a3-d622-3d57-a6a2-5cb53770598b",
                        "source_sense_id": "a5737b05-d050-3e91-a239-573ab28da8fb",
                        "target_lang_word": "rejoice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rejoice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc71d42-3ab3-30bd-94de-2419c5c64c7e",
                                        "entry_id": "c0e63af2-0bbe-3f17-a43b-4c25839e1aed",
                                        "glosses": [
                                            "To be very happy, be delighted, exult; to feel joy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6bf71e1-1001-4a82-a1f6-e4aed3e11d08",
                                                "sense_id": "6dc71d42-3ab3-30bd-94de-2419c5c64c7e",
                                                "text": "Obscurity, indeed, is painful to the mind as well as to the eye ; but to bring light from obscurity, by whatever labour, must needs to be delightful and rejoicing."
                                            },
                                            {
                                                "example_id": "5c65d176-338f-49c3-97ce-e838cf9f577c",
                                                "sense_id": "6dc71d42-3ab3-30bd-94de-2419c5c64c7e",
                                                "text": "At Waterhouses and Hulme End the usual booking office, waiting room and other station accommodation were to be found, but the remaining stations […] were mere stopping places, some of which rejoiced in a small shed for waiting passengers, others without any kind of shelter whatsoever."
                                            },
                                            {
                                                "example_id": "67b9fb3a-60fb-4fa6-8185-e225c712c6ec",
                                                "sense_id": "6dc71d42-3ab3-30bd-94de-2419c5c64c7e",
                                                "text": "Leicester closed out the win to spark emotional scenes as those inside Wembley rejoiced in a landmark victory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ff6a669-22b6-3786-ac64-2c6b1bebe290",
                                        "entry_id": "c0e63af2-0bbe-3f17-a43b-4c25839e1aed",
                                        "glosses": [
                                            "To have (someone) as a lover or spouse; to enjoy sexually."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a713ed50-d9a6-4bca-80a3-3eb4e0560470",
                                                "sense_id": "1ff6a669-22b6-3786-ac64-2c6b1bebe290",
                                                "text": "ye that are a knyghte wyueles that ye wyl not loue some mayden or gentylwoman /[…]/ but hit is noysed that ye loue quene Gueneuer / and that she hath ordeyned by enchauntement that ye shal neuer loue none other / but her / ne none other damoysel ne lady shall reioyse you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9fdae37-f314-3dcd-bdd1-cae31f0a3c4c",
                                        "entry_id": "c0e63af2-0bbe-3f17-a43b-4c25839e1aed",
                                        "glosses": [
                                            "To make happy, exhilarate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61e452eb-6360-4fda-9266-b3b63ddaa678",
                                                "sense_id": "d9fdae37-f314-3dcd-bdd1-cae31f0a3c4c",
                                                "text": "Were he [Cain] alive, it would rejoice his soul to see what mischief it had made."
                                            },
                                            {
                                                "example_id": "cf5d16d7-5581-453e-b8e1-69421c819fd4",
                                                "sense_id": "d9fdae37-f314-3dcd-bdd1-cae31f0a3c4c",
                                                "text": "But good news awaited them in the form of permission to travel about the area replenishing medical stocks in hospitals and clinics, and this task was delegated to Constance, as the newcomer, a fact which rejoiced her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f420f35-7ab3-3edc-8c17-b3164e837db4",
                                        "entry_id": "c0e63af2-0bbe-3f17-a43b-4c25839e1aed",
                                        "glosses": [
                                            "To enjoy."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83efce2c-2771-475d-a796-006018343f6e",
                                                "sense_id": "5f420f35-7ab3-3edc-8c17-b3164e837db4",
                                                "text": "c. 1449–1455, Reginald Peacock, Represser of over-much weeting [blaming] of the Clergie\nhis brother Constans next aftir him rejoiced the same west-parti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
