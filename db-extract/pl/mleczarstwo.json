                                    },
                                    {
                                        "sense_id": "d16162cd-3282-378a-9d07-f8e9cd82f9ba",
                                        "entry_id": "66ee2547-97cc-36c4-9170-3d7ee4e36346",
                                        "glosses": [
                                            "A woman's breast."
                                        ],
                                        "tags": [
                                            "countable",
