                    {
                        "translation_id": "024ef344-9528-43d3-851f-a365ad1fb4c5",
                        "source_entry_id": "a50fa4dd-f197-3f3a-be4a-b35e3b731c53",
                        "source_sense_id": "7a0335e2-dfea-3cbf-94e2-ba9438aa13d6",
                        "target_lang_word": "wienerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wienerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57c2ce5c-2e8e-3e24-9255-d120b5845481",
                                        "entry_id": "c414dfff-f383-317b-93eb-6708d61f1586",
                                        "glosses": [
                                            "Wien oder die Wiener betreffend; aus Wien oder von den Wienern stammend, zu ihnen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b36012-8d2d-4969-afab-d23092d65d1a",
                                                "sense_id": "57c2ce5c-2e8e-3e24-9255-d120b5845481",
                                                "text": "Sein Realitätssinn lässt den gebürtigen Niederösterreicher zweifeln, ob er den anderen Bundesländern nicht zu wienerisch wäre."
                                            },
                                            {
                                                "example_id": "00468e2c-c914-4b4f-a920-c4ad5d4258c2",
                                                "sense_id": "57c2ce5c-2e8e-3e24-9255-d120b5845481",
                                                "text": "Ich fühlte, dass ich jetzt keinen Fehler begehen durfte. Nur nicht die Frau auf ihre Unlogik hinweisen - unbedingt wienerisch-diplomatisch bleiben."
                                            },
                                            {
                                                "example_id": "0e319a96-510a-47ae-a506-ba74126a9bff",
                                                "sense_id": "57c2ce5c-2e8e-3e24-9255-d120b5845481",
                                                "text": "Der Ball der Republik also? Die wienerisch-pragmatische Antwort: „A bisserl schon, oba net wirklich!“"
                                            },
                                            {
                                                "example_id": "024eec99-6b89-4867-b348-d1f72dbdd20d",
                                                "sense_id": "57c2ce5c-2e8e-3e24-9255-d120b5845481",
                                                "text": "„Erstaunlich“, „sinnlich“, „wienerisch“, „exklusiv“, so soll das neu Luxus-Eck zwischen Tuchlauben und Am Hof in der Wiener Innenstadt sein."
                                            },
                                            {
                                                "example_id": "c65f848a-b3ee-451d-9741-334bc64add1f",
                                                "sense_id": "57c2ce5c-2e8e-3e24-9255-d120b5845481",
                                                "text": "Als dritte gemeinsame rattenbergerisch-wienerische Überleitung wurde aus dem mittelhochdeutschen Zwielaut \"iu\" wie zum Beispiel in \"liuchten\" (leuchten) ein \"ää\", nämlich \"läächdn\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
