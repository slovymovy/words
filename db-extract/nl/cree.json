                                        "entry_id": "f60ab378-cd02-3da6-abac-e7af683d24ee",
                                        "glosses": [
                                            "Sprache des gleichnamigen Indianerstamms, die zwischen den Rocky Mountains und dem Atlantik gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5103c1e5-ff54-4b4a-b5c7-f134f595fd5a",
                                                "sense_id": "9968cb34-ff08-32d0-89cc-3981d6e3e39b",
                                                "text": "„Das Cree ist die in Kanada am weitesten verbreitete Sprache der als First Nations bezeichneten Indianer.“"
                                            },
                                            {
                                                "example_id": "91283bca-7ed1-4a53-b7a9-be400265a452",
                                                "sense_id": "9968cb34-ff08-32d0-89cc-3981d6e3e39b",
                                                "text": "„Die Dialekte des Cree, Naskapi und Montagnais bilden zusammen eine Dialektkette, deren Verbreitungsgebiet Ost-Kanada ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Cree",
                                "target_lang_code": "de",
