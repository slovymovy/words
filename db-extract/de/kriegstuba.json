                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "8783e766-ca78-4f82-99b8-77a97fda7083",
                                "sense_id": "8ddb2980-eb4e-31b7-b129-1711713bd74b",
                                "text": "Was ist das Kampfspiel Augusts, der Flotten gegen einander\nfechten ließ, dessen Kriegstuba Neptunus vernahm,",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "81f3cb2b-a8b2-4aa9-9c36-5e4845b98a8b",
                                "sense_id": "8ddb2980-eb4e-31b7-b129-1711713bd74b",
                                "text": "Blast ihr die Kriegstuba, die in Portugal Bruder gegen Bruder, und den Bürger gegen den Bürger, zu einem aussichtslosen Metzeln treibt?"
                            },
                            {
                                "example_id": "8d009bf9-a4a9-40b2-92e1-364654ced696",
                                "sense_id": "8ddb2980-eb4e-31b7-b129-1711713bd74b",
                                "text": "1841, Bibliothek des Frohsinns, section 3, Instrumental- und Vokal-Concert: Großes Instrumental- und Vokal-Concert: eine musikalische Anthologie (published by Ernst Ortlepp, printed by Franz Heinrich Köhler, Stuttgart), volume 9, pages 11 and 12",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "05764e20-1fa7-4725-a8d8-586ae6cda850",
                                "sense_id": "8ddb2980-eb4e-31b7-b129-1711713bd74b",
                                "text": "[…] klarer und energischer Gesang, der immer kühner und feuriger anschwoll und sich bis zu einer herausfordernden Heftigkeit steigerte, daß man das sentimentale Instrument nicht wiedererkannte und irgend eine Kriegstuba zu hören glaubte."
                            },
                            {
                                "example_id": "96423775-b319-4b51-a422-c7a757cead2f",
                                "sense_id": "8ddb2980-eb4e-31b7-b129-1711713bd74b",
                                "text": "Martial rechnet es der Pax Romana zum Verdienst, daß sie die Kriegstuba im Norden zum Verstummen gebracht habe³⁹⁵.",
                                "translation": "³⁹⁵Mart. 7,80,1f. Quatenus Odrysios iam pax Romana triones / temperat et tetricae conticuere tubae.",
                                "english": "³⁹⁵Mart. 7,80,1f. Quatenus Odrysios iam pax Romana triones / temperat et tetricae conticuere tubae."
                            }
                        ]
