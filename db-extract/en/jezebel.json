            {
                "entry_id": "0974535e-7165-3095-9264-ec5f28284aed",
                "word": "Jezebel",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a372ae16-ba29-429a-8821-37521ea1d8db",
                        "entry_id": "0974535e-7165-3095-9264-ec5f28284aed",
                        "tags": [
                            "plural"
                        ],
                        "form": "Jezebels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b4eb8fc-231e-398e-a59f-0c6673a55834",
                        "entry_id": "0974535e-7165-3095-9264-ec5f28284aed",
                        "glosses": [
                            "A woman who is evil, scheming, shameless, or immoral."
                        ],
                        "tags": [
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "02e09f8d-27aa-4b1a-95b8-0230306d7e7b",
                                "sense_id": "7b4eb8fc-231e-398e-a59f-0c6673a55834",
                                "text": "She’s an absolute Jezebel!"
                            },
                            {
                                "example_id": "84a70fca-29ef-4e49-a530-48e925479f8f",
                                "sense_id": "7b4eb8fc-231e-398e-a59f-0c6673a55834",
                                "text": "I accused her in set terms of giving me the heave-ho in order that she could mercenarily marry a richer man. I called her a carrot-topped Jezebel whom I was thankful to have got out of my hair. […] “The core of the matter is,” I said, twiddling the wheel to avoid a passing hen, “that in Roberta Wickham we are dealing with a girl of high and haughty spirit. […] And girls of high and haughty spirit need kidding along. This cannot be done by calling them carrot-topped Jezebels.”"
                            },
                            {
                                "example_id": "4b4cac38-6aa2-402c-a5e7-89aa38b2c6a6",
                                "sense_id": "7b4eb8fc-231e-398e-a59f-0c6673a55834",
                                "text": "Red lips, hair, and fingernails\nI hear you're a mean old Jezebel"
                            }
                        ]
                    },
                    {
                        "sense_id": "e4092727-5564-3ec5-b779-7f1a5f1e9f82",
                        "entry_id": "0974535e-7165-3095-9264-ec5f28284aed",
                        "glosses": [
                            "Any of various pierid butterflies of the genus Delias."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac4e54d8-60bd-4767-b93f-2183c5d53921",
                        "source_entry_id": "0974535e-7165-3095-9264-ec5f28284aed",
                        "source_sense_description": "an immoral woman",
                        "target_lang_word": "Agrippine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agrippine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78fce00e-7881-3eab-ad52-6c9126ef5ee7",
                                        "entry_id": "ea024827-ece3-3901-9aa2-e10c3b03ec6e",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b59b8b-d852-4456-bd9f-3102dcd3799a",
                                                "sense_id": "78fce00e-7881-3eab-ad52-6c9126ef5ee7",
                                                "text": "Agrippine l’Aînée, fille d’Agrippa, petite-fille d’Auguste et mère de Caligula."
                                            },
                                            {
                                                "example_id": "cb4c83ec-99fe-4c2a-984a-03b87a5d326d",
                                                "sense_id": "78fce00e-7881-3eab-ad52-6c9126ef5ee7",
                                                "text": "Agrippine la Jeune, fille de la précédente et de Germanicus, femme de Claude et mère de Néron (15 - †59)."
                                            },
                                            {
                                                "example_id": "3dbc0810-80b5-4ba8-97c2-4fe9cf63ba58",
                                                "sense_id": "78fce00e-7881-3eab-ad52-6c9126ef5ee7",
                                                "text": "Et qui s’honorerait de l’appui d’Agrippine,\nLorsque Néron lui−même annonce ma ruine ?"
                                            },
                                            {
                                                "example_id": "615cebfc-0d4f-468d-b8d2-210075ea4c27",
                                                "sense_id": "78fce00e-7881-3eab-ad52-6c9126ef5ee7",
                                                "text": "Sainte Agrippine, martyre romaine sous Valérien († vers 256 ou 257)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
