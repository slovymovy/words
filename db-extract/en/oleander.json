                "senses": [
                    {
                        "sense_id": "84838af8-b49e-343d-b36e-39c7e3e05008",
                        "entry_id": "d66f13d3-77ab-3e34-879e-fadf06869b85",
                        "glosses": [
                            "Nerium oleander, a notoriously poisonous shrub in the dogbane family, Apocynaceae, but nonetheless widely grown as an ornamental, having leathery lance-shaped leaves and deep rose-colored or white flowers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58a690f2-83e5-4501-8f73-487a39631257",
                        "source_entry_id": "d66f13d3-77ab-3e34-879e-fadf06869b85",
                        "source_sense_id": "84838af8-b49e-343d-b36e-39c7e3e05008",
                        "source_sense_description": "A poisonous shrub",
                        "target_lang_word": "oleandr",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7bd0b3a6-244b-4de6-aaad-7e9bf9a8cf27",
                        "source_entry_id": "d66f13d3-77ab-3e34-879e-fadf06869b85",
                        "source_sense_id": "84838af8-b49e-343d-b36e-39c7e3e05008",
                        "source_sense_description": "A poisonous shrub",
                        "target_lang_word": "laurier-rose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laurier-rose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f05345-32e2-3b6e-8916-a8f20427bc29",
                                        "entry_id": "f73052d9-48ba-3967-ba61-a79c495f69a7",
                                        "glosses": [
                                            "Nom vulgaire de Nerium oleander, arbuste ornemental de la famille des Apocynacées. Ce laurier, très toxique, porte des fleurs de couleur rose, il existe de nombreux cultivars aux fleurs blanches, jaunes ou rouges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12cc3c69-0dfa-4441-a2b3-fc5f497ba3ce",
                                                "sense_id": "e8f05345-32e2-3b6e-8916-a8f20427bc29",
                                                "text": "A chaque redan du rocher croissaient des touffes de chênes nains, des buis et des lauriers-roses."
                                            },
                                            {
                                                "example_id": "f874eb25-f7af-47d6-b388-d4dc57a40069",
                                                "sense_id": "e8f05345-32e2-3b6e-8916-a8f20427bc29",
                                                "text": "Le palmier et le laurier-rose sont mes arbres favoris ; la vue du palmier et du laurier-rose me cause une joie, une gaieté étonnantes. Il me semble que l’on ne peut pas être malheureux à leur ombre."
                                            },
                                            {
                                                "example_id": "75dc8c77-62e2-4f28-b0e7-9cf772c22f64",
                                                "sense_id": "e8f05345-32e2-3b6e-8916-a8f20427bc29",
                                                "text": "Elle était née sur les bords du lac de Génézareth, dans un pays d'ombre et de soleil, envahi par les lauriers roses."
                                            },
                                            {
                                                "example_id": "04495664-cda4-4953-b15c-7bd5db8305bf",
                                                "sense_id": "e8f05345-32e2-3b6e-8916-a8f20427bc29",
                                                "text": "Signalons que les rhéophytes émergées se rencontrent également en milieux ouverts en zone tempérée ; de nombreuses espèces de saules et de lauriers-roses en constituent de bons exemples."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a128e7c-5db8-3132-84c9-41ec3c0b44bd",
                                        "entry_id": "f73052d9-48ba-3967-ba61-a79c495f69a7",
                                        "glosses": [
                                            "Nom vernaculaire de Podocarpus coriaceus, arbre sempervirent des Caraïbes."
                                        ],
                                        "tags": [
                                            "Guadeloupe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18a21ab3-c600-450a-9cc4-be451d9bf9e3",
                                                "sense_id": "0a128e7c-5db8-3132-84c9-41ec3c0b44bd",
                                                "text": "Le laurier rose est la seule Gymnosperme indigène de la Guadeloupe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb7ad8a3-866e-41bf-960e-ad454a36ba8e",
                        "source_entry_id": "d66f13d3-77ab-3e34-879e-fadf06869b85",
                        "source_sense_id": "84838af8-b49e-343d-b36e-39c7e3e05008",
                        "source_sense_description": "A poisonous shrub",
                        "target_lang_word": "oléandre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oléandre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e561fc7d-2b5c-3107-addd-2a15d3ddac58",
                                        "entry_id": "33934eab-7ff2-3319-b662-7cbbb6380e6a",
                                        "glosses": [
                                            "Synonyme de laurier-rose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24139b3b-671e-46c8-999f-e3c96b8d72c9",
                                                "sense_id": "e561fc7d-2b5c-3107-addd-2a15d3ddac58",
                                                "text": "Ô ! Viareggio plus beau que l’Orient\nqui dans le bleu immaculé de tes soirs\nexhales le parfum pénétrant de l’oléandre,\nen toi je suis né,\nen toi j’espère mourir."
                                            },
                                            {
                                                "example_id": "427944c7-bb5c-4575-9a89-cb4ad37dee57",
                                                "sense_id": "e561fc7d-2b5c-3107-addd-2a15d3ddac58",
                                                "text": "Elle m’emmena dans un coin du jardin, elle me fit asseoir à une certaine distance d’un immense oléandre rose."
                                            },
                                            {
                                                "example_id": "04eeb3aa-6448-4c8e-b6e5-07066551d62a",
                                                "sense_id": "e561fc7d-2b5c-3107-addd-2a15d3ddac58",
                                                "text": "Après avoir déjeuné de quelques noix au miel, elle épinglait dans ses cheveux des fleurs d’oranger blanches comme neige ou des pétales rouges d’oléandre, et s’en allait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed121292-1230-475f-bc11-e72b28d52c5d",
                        "source_entry_id": "d66f13d3-77ab-3e34-879e-fadf06869b85",
                        "source_sense_id": "84838af8-b49e-343d-b36e-39c7e3e05008",
                        "source_sense_description": "A poisonous shrub",
