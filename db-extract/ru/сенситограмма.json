                    {
                        "translation_id": "f1d1eb7e-1399-4c6c-81b9-fe73702b089f",
                        "source_entry_id": "ac9b8371-67cd-378f-9547-83e4dd8eb57a",
                        "source_sense_id": "1191c3c1-2a57-38ff-ada2-f603a3844109",
                        "target_lang_word": "Sensitometerstreifen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3ef0c5c9-0f9c-4e8c-aa32-0309cc074a2d",
                        "source_entry_id": "ac9b8371-67cd-378f-9547-83e4dd8eb57a",
                        "source_sense_id": "1191c3c1-2a57-38ff-ada2-f603a3844109",
