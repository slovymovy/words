                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57170fe0-e3a6-4b4c-9aab-5126b9fb459a",
                        "source_entry_id": "4c9f8141-9b18-3aee-bf8f-c957febee8c1",
                        "source_sense_id": "b4936e6c-7d49-36da-b285-0a7469b2c401",
                        "source_sense_description": "Religion: wundersame Wiederkehr einer heiligen Person",
                        "target_lang_word": "second coming",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "second coming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e46f27d-a66a-39dd-ac71-8188b37fe386",
                                        "entry_id": "78a7d1cf-296f-3440-aa77-aa557f358229",
                                        "glosses": [
                                            "The prophesied return of Jesus Christ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc233af-97b1-4cd2-a2c6-6d1d1c9fb254",
                                                "sense_id": "0e46f27d-a66a-39dd-ac71-8188b37fe386",
                                                "text": "When the time of Christ's second coming is at hand, there will be but a very little faith in the world. And the Lord knows that there be many, who are now as high as Lucifer, that at that day, for want of faith, will be thrown down to the sides of the pit; even in the very belly of hell."
                                            },
                                            {
                                                "example_id": "35efde78-2b4d-4da6-a977-3c28da4fa4d7",
                                                "sense_id": "0e46f27d-a66a-39dd-ac71-8188b37fe386",
                                                "text": "When Malone next looked round he was gone. \"He is one of these Second-coming fanatics,\" he whispered to Enid. There are a lot of them—Christadelphians, Russellites, Bible Students and what-not."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
