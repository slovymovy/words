                                        "examples": [
                                            {
                                                "example_id": "21d29640-cca0-4577-b67d-373490cab69e",
                                                "sense_id": "031d548c-99c8-36de-8687-447a52310383",
                                                "text": "„Eine der beiden 16-Jährigen, die bei dem Flugzeugunglück in San Francisco ums Leben kamen, wurde von einem Rettungsfahrzeug überrollt.“"
                                            },
                                            {
                                                "example_id": "88a05b1b-c714-4b62-8644-ddd3209b1a48",
                                                "sense_id": "031d548c-99c8-36de-8687-447a52310383",
                                                "text": "„Auf der Höhe seiner Macht kam Zia-ul-Haq am 17. August 1988 gemeinsam mit dem US-amerikanischen Botschafter Arnold Lewis Raphel bei einem Flugzeugunglück ums Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a37f719-75bb-484d-b450-16eb5e432257",
                        "source_entry_id": "349f8e3f-6d89-37f5-8f11-c21dd91b9986",
                        "source_sense_id": "d69a4c3e-f4cb-33fe-a83a-f14d3f7806c7",
                        "source_sense_description": "Luftfahrt: Flugzeugunglück, Flugzeugabsturz, Flugzeugkatastrophe",
                        "target_lang_word": "Flugzeugabsturz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flugzeugabsturz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac715b3c-1b5f-3d86-96d6-289cb271dcca",
                                        "entry_id": "36188197-92e7-3057-b3e7-338f7c02194a",
                                        "glosses": [
                                            "Unfall, bei dem ein Flugzeug zu Boden (oder ins Wasser) stürzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54672cd0-8e3d-4ba5-bcab-d2bb31f41c1f",
                                                "sense_id": "ac715b3c-1b5f-3d86-96d6-289cb271dcca",
                                                "text": "Beim Flugzeugabsturz stürzte die Maschine in eine unbewohnte Gegend."
                                            },
                                            {
                                                "example_id": "098959dd-a394-48a4-80bd-fd9284ab4645",
                                                "sense_id": "ac715b3c-1b5f-3d86-96d6-289cb271dcca",
                                                "text": "„UN-Generalsekretär Dag Hammarskjöld kommt noch im selben Jahr bei einem Flugzeugabsturz über dem Kongo ums Leben, als er einen Waffenstillstand aushandeln will.“"
                                            },
                                            {
                                                "example_id": "52f99a30-2726-4ed7-9db8-ff19c1e23f04",
                                                "sense_id": "ac715b3c-1b5f-3d86-96d6-289cb271dcca",
                                                "text": "„Doch ein halbes Jahr später verunglückte der Militärpilot bei einem Flugzeugabsturz an der Ostfront tödlich. Ursache war ein Pilotenfehler.“"
                                            },
                                            {
                                                "example_id": "3ca35ee2-c161-4d98-b945-c291e2393ceb",
                                                "sense_id": "ac715b3c-1b5f-3d86-96d6-289cb271dcca",
                                                "text": "„Eine kurvenreiche Blondine, die als Einzige einen Flugzeugabsturz unversehrt überlebt hat, wird zum Häuptling eines Kannibalenstammes gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
