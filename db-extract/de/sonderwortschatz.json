                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0746de08-4546-480d-8b7f-4ff86c0454ef",
                                "sense_id": "cafd1476-c71a-3266-8df4-2052134d7698",
                                "text": "„In der Deutschen Komponente bildete sich zu dieser Zeit ein religiöser Sonderwortschatz heraus, der durch die vielfältigen Verbindungen nicht regional beschränkt blieb.“"
                            },
                            {
                                "example_id": "b3b163ec-dcaa-4c21-b96c-4ac48e524251",
                                "sense_id": "cafd1476-c71a-3266-8df4-2052134d7698",
                                "text": "„Jenisch als Sondersprache ist eine Mischspache, die sich vor allem durch eine Sonderlexik auszeichnet, wobei ein einzelner Sprecher heutzutage im Durchschnitt über einen Sonderwortschatz von rund 500 Wörtern oder Basismorphemen verfügt.“"
                            }
                        ],
