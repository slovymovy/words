                                            {
                                                "example_id": "108f5a85-65ae-4d42-a0b7-52f69e378add",
                                                "sense_id": "7d484a97-3f34-3731-a42f-0253b9bed784",
                                                "text": "„Die Vereinigten Staaten steckten Ende der dreißiger Jahre immer noch in einer schweren Wirtschaftskrise.“"
                                            },
                                            {
                                                "example_id": "6495b143-dd5c-4d4b-a555-a795a56e1068",
                                                "sense_id": "7d484a97-3f34-3731-a42f-0253b9bed784",
                                                "text": "„Der Türhüter der Kanzlei des Konsulats der Vereinigten Staaten stand, stark wie ein Boxer, hinter dem aktenbeladenen Tisch, der den Aufgang der Treppe versperrte.“"
                                            },
                                            {
                                                "example_id": "1d703a37-f62d-4252-b1fd-5aff27fa2391",
                                                "sense_id": "7d484a97-3f34-3731-a42f-0253b9bed784",
                                                "text": "„Die Verfassung der Vereinigten Staaten war in vier inspirierenden Monaten ausgearbeitet worden, musste allerdings noch in mindestens neun der dreizehn Gründerstaaten ratifiziert werden, ehe sie in Kraft treten konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
