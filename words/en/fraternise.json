            "senses": [
                {
                    "sense_id": "75024dbf-5536-3119-a9a6-1418e636100e",
                    "sense_definition": "To associate or socialize with others in a friendly or brotherly way, often with people one is expected to be hostile towards.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "socialize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were strictly forbidden to <w>fraternise</w> with the local population during the occupation.",
                            "target_lang_translations": {
                                "zh": "占领期间，士兵被严令禁止与当地民众<w>亲近</w>。"
                            }
                        },
                        {
                            "text": "It is unprofessional for managers to <w>fraternise</w> too closely with their subordinates.",
                            "target_lang_translations": {
                                "zh": "经理与下属走得太近、过度<w>结交</w>是不专业的表现。"
                            }
                        }
                    ],
                    "synonyms": [
                        "socialize",
                        "mingle",
                        "associate"
                    ],
                    "antonyms": [
                        "shun",
                        "ostracize"
                    ],
                    "common_phrases": [
                        "fraternise with"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指与他人友好或像兄弟般地交往，通常指与本应敌对的人建立亲密关系。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "亲近",
                                "target_lang_sense_clarification": "指打破隔阂，与人建立友好关系。"
                            },
                            {
                                "target_lang_word": "结交",
                                "target_lang_sense_clarification": "指与人建立社交联系，常用于不被鼓励的场合。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
