                "senses": [
                    {
                        "sense_id": "4dbe80d5-8024-3635-935a-ecc90dd3dfb8",
                        "entry_id": "ff7cdbda-861d-3b1b-81fa-f44c2d503498",
                        "glosses": [
                            "autobus szkolny"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0ac979a8-3d6c-4ee8-8625-b29d7d56ddc3",
                                "sense_id": "4dbe80d5-8024-3635-935a-ecc90dd3dfb8",
                                "text": "Ten gimbus znowu się spóźnia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7ab0fe35-7300-3036-9eb1-44ddaee50ac1",
                        "entry_id": "ff7cdbda-861d-3b1b-81fa-f44c2d503498",
                        "glosses": [
                            "gimnazjalista"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "fe5d19b1-5172-4c22-b517-aa48e6b4dc55",
                                "sense_id": "7ab0fe35-7300-3036-9eb1-44ddaee50ac1",
                                "text": "Wszystkie gimbusy z tej szkoły to wandale i chuligani!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "bffc1911-b435-3133-9c79-29b334a76357",
                        "entry_id": "ff7cdbda-861d-3b1b-81fa-f44c2d503498",
                        "glosses": [
                            "o głośno, głupio zachowującym się nastolatku"
                        ],
                        "tags": [
                            "colloquial",
                            "offensive"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c979b62-4881-4684-bbb5-e55b614c13b9",
                        "source_entry_id": "ff7cdbda-861d-3b1b-81fa-f44c2d503498",
                        "source_sense_id": "4dbe80d5-8024-3635-935a-ecc90dd3dfb8",
                        "target_lang_word": "Schulbus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schulbus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6af1c958-99bc-33ac-b87b-1fb30ee679de",
                                        "entry_id": "051884d8-ef08-3f56-a09a-d9b91118621e",
                                        "glosses": [
                                            "Bus für den Transport von Schülern zur Schule und zurück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb7b3c7-6014-47dd-be63-46ae9b69d449",
                                                "sense_id": "6af1c958-99bc-33ac-b87b-1fb30ee679de",
                                                "text": "„Also was Schulbusse anbelangt, ist unser Junge ausreichend vorbereitet.“"
                                            },
                                            {
                                                "example_id": "ff2ad31b-6e4e-4f5e-9812-98c0f6304ab5",
                                                "sense_id": "6af1c958-99bc-33ac-b87b-1fb30ee679de",
                                                "text": "„Der Schulbus hatte Verspätung.“"
                                            },
                                            {
                                                "example_id": "f26e7c20-5d43-48ed-8624-bd16b4f17847",
                                                "sense_id": "6af1c958-99bc-33ac-b87b-1fb30ee679de",
                                                "text": "„Sie ging fort zur Schule, ging in ihrem gelben Ostermantel über die knirschende Auffahrt und wartete, all ihre Tränen vergessend, auf den gelben Schulbus, unter einem wolkigen Himmel, der keinen Regen verhieß.“"
                                            },
                                            {
                                                "example_id": "bc85de24-52fa-4b8d-b05a-0d725c41967d",
                                                "sense_id": "6af1c958-99bc-33ac-b87b-1fb30ee679de",
                                                "text": "„Sie werden mit dem Schulbus hin- und zurücktransportiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
