                    {
                        "sense_id": "66a725d9-02dc-30fb-bdfe-d220c8c4cc29",
                        "entry_id": "297c3f10-85d6-3972-b0fa-595d8a0df098",
                        "glosses": [
                            "That generates electricity by converting the energy of moving water, or of steam escaping under high pressure."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0bb16c3f-04dd-4baa-98e0-1210af6b9bda",
                                "sense_id": "66a725d9-02dc-30fb-bdfe-d220c8c4cc29",
                                "text": "Baishan hydroelectric station is located 39 km from the downstream Hongshi hydroelectric station and 250 km from the downstream Fengman hydroelectric station, Jilin Province, China, on the upper reaches of the Second Songhua River, […] In Baishan district the weather is very cold in winter (lowest temperature, -44.5°C; highest temperature, 38.8°C; long-term average, 4.3°C)."
                            }
                        ]
                    },
                    {
                        "sense_id": "bff421f3-036f-3d71-a741-f09386728f66",
                        "entry_id": "297c3f10-85d6-3972-b0fa-595d8a0df098",
                        "glosses": [
                            "Of or relating to the electricity so produced."
