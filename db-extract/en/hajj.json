                                                "example_id": "6a5f87cd-2439-4b3e-89a6-ce81622eb2c1",
                                                "sense_id": "df2b3094-8539-3063-a2c7-b98451c944ec",
                                                "text": "Bönler, Budistler, Hindular ve Jainistler, Dünya'nın merkezinde olduğuna inandıkları ve Meru Dağı da dedikleri Kaylaş'a hac ederler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dca94bb5-dc27-3a1c-9eb2-5929cc69d763",
                                        "entry_id": "9addddec-06e7-3b4e-99b3-3539604f90e7",
                                        "glosses": [
                                            "İslâm'ın beş şartından biri olan ve Müslümanlarca zilhicce ayında Mekke'de yapılan Kâbe'yi ziyaret ve tavaf ibadeti."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b901c813-e945-4b45-ad6c-93a02b3800f7",
                                                "sense_id": "dca94bb5-dc27-3a1c-9eb2-5929cc69d763",
                                                "text": "Sağlıklı ve zengin her Müslümana hayatında bir kere hac etmek farzdır."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
