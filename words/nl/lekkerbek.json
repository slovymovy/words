                        ]
                    }
                },
                {
                    "sense_id": "6169409b-20a3-370b-9ce3-8bac3e372f42",
                    "sense_definition": "Inversievorm van de tweede persoon enkelvoud tegenwoordige tijd van <w>lekkerbekken</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>lekkerbek</w> je zo als je naar die menukaart kijkt?",
                            "target_lang_translations": {
                                "en": "Why are you <w>drooling</w> like that when looking at that menu?"
