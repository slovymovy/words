            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a1b58bac-913d-335f-9aad-1418db56a96d",
                    "sense_definition": "Человек, который играет на музыкальном инструменте или занимается музыкой профессионально.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой брат — талантливый <музыкант>, он отлично играет на гитаре.",
                            "target_lang_translations": {
                                "en": "My brother is a talented <w>musician</w>; he plays the guitar excellently.",
                                "fr": "Mon frère est un <w>musicien</w> talentueux, il joue très bien de la guitare."
                            }
                        },
                        {
                            "text": "На городской площади выступали уличные <музыканты> и собирали толпу зрителей.",
                            "target_lang_translations": {
                                "en": "Street <w>musicians</w> were performing in the town square and gathering a crowd of spectators.",
                                "fr": "Des <w>musiciens</w> de rue se produisaient sur la place de la ville et rassemblaient une foule de spectateurs."
                            }
                        }
                    ],
                    "common_phrases": [
                        "уличный музыкант",
                        "талантливый музыкант",
                        "рок-музыкант",
                        "профессиональный музыкант"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who plays a musical instrument or engages in music professionally.",
                        "fr": "Personne qui joue d'un instrument de musique ou qui pratique la musique professionnellement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "musician",
                                "target_lang_sense_clarification": "general meaning"
                            },
                            {
                                "target_lang_word": "performer",
                                "target_lang_sense_clarification": "one who performs music"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "musicien",
                                "target_lang_sense_clarification": "sens général"
                            },
                            {
                                "target_lang_word": "instrumentiste",
                                "target_lang_sense_clarification": "personne qui joue d'un instrument"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "009166b8-eeb9-3ec3-8c07-b04bea06d90b",
                    "sense_definition": "Боец российской частной военной компании «Вагнер».",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В новостях сообщили, что <музыканты> заняли новые позиции на окраине города.",
                            "target_lang_translations": {
                                "en": "The news reported that the <w>Wagner fighters</w> had taken new positions on the outskirts of the city.",
                                "fr": "Les informations ont rapporté que les <w>combattants de Wagner</w> avaient pris de nouvelles positions à la périphérie de la ville."
                            }
                        },
                        {
                            "text": "Этот опытный <музыкант> прошёл через множество сложных операций.",
                            "target_lang_translations": {
                                "en": "This experienced <w>Wagner fighter</w> has gone through many complex operations.",
                                "fr": "Ce <w>wagnérien</w> expérimenté est passé par de nombreuses opérations difficiles."
                            }
                        }
                    ],
                    "synonyms": [
                        "ва́гнеровец"
