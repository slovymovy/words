                "entry_id": "f6cc2828-b414-3d09-a582-52a29b7e868d",
                "word": "eskadron",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "7c183ace-5dd6-46bc-9a72-73318a5431eb",
                        "entry_id": "f6cc2828-b414-3d09-a582-52a29b7e868d",
                        "tags": [
                            "plural"
                        ],
                        "form": "eskadrons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5abc7528-b74a-3e10-bf09-af599e322c7f",
                        "entry_id": "f6cc2828-b414-3d09-a582-52a29b7e868d",
                        "glosses": [
                            "een kleine tactische eenheid bij de cavalerie (tegenwoordig gemechaniseerd of gemotoriseerd) of Koninklijke Marechaussee bestaande uit 3 of 4 peletons (totaal ongeveer 150 ruiters) met een ritmeester aan het hoofd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad0ba29a-327b-4127-be10-81d09c8c00b5",
                                "sense_id": "5abc7528-b74a-3e10-bf09-af599e322c7f",
                                "text": "Toevallig heb ik in Nederland mijn dienstplicht vervuld als NBC-specialist (van ‘nucleair, biologisch en chemisch’). In die functie berekende ik de inzetbaarheid van de manschappen in mijn eskadron na de ontploffing van een kernwapen. In tegenstelling tot wat de leek soms denkt, is het namelijk niet de bedoeling dat het leger dan hard weg loopt. Met stralingsdosis x, zal ik maar zeggen, kan een peloton nog vijf uur een brug bewaken, voordat de mannen fysiek onbruikbaar worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e6cca06-2c10-32f0-9063-0c8303d0df97",
                        "entry_id": "f6cc2828-b414-3d09-a582-52a29b7e868d",
                        "glosses": [
                            "groep gevechtsvliegtuigen (meestal squadron genoemd) bestaande uit 18 vliegtuigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66416f6d-cfee-4b89-b47f-34966c2d93b3",
                                "sense_id": "2e6cca06-2c10-32f0-9063-0c8303d0df97",
                                "text": "'Soms moet je een wespennest uitroken als je niet wilt dat de wespen je tuin en je leefbaarheid vernielen. Ik zeg niet: stop je hand in dat wespennest, maar ik stel voor de Koerden te bewapenen om op die manier de macht van IS in te perken. Het is niet zo dat ik pleit om zo snel mogelijk een eskadron F-16's naar Irak te sturen, maar ik vind dat je het niet als optie moet uitsluiten, zoals minister Timmermans nu doet.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1718c49-a66c-47fd-8bb4-ca8be1ff9549",
                        "source_entry_id": "f6cc2828-b414-3d09-a582-52a29b7e868d",
                        "source_sense_id": "5abc7528-b74a-3e10-bf09-af599e322c7f",
                        "source_sense_description": "een kleine tactische eenheid bij de cavalerie (tegenwoordig gemechaniseerd of gemotoriseerd) of ...",
                        "target_lang_word": "Schwadron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwadron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                                        "entry_id": "74a20aef-3042-3f6f-8aba-b7026919b91c",
                                        "glosses": [
                                            "kleinste Einheit der Kavallerie"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d67bdf6-d5e5-4206-9f42-49f885550f91",
                                                "sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                                                "text": "Die Schwadron ritt mit gezücktem Säbel ins Treffen, der Rittmeister vorneweg."
                                            },
                                            {
                                                "example_id": "d0c2f7f9-b7cd-4280-9247-da4b0d60eb24",
                                                "sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                                                "text": "„Sie mußten zur Seite springen, sich an eine Häuserwand drängen, denn die ganze Straße wurde von einer Schwadron roter Husaren eingenommen, die in so schnellem Trab in Kriegsausrüstung vorbeizogen, daß die Karabiner auf ihren Rücken hin und her hüpften.“"
                                            },
                                            {
                                                "example_id": "2294f473-dbee-4067-b357-a979b92120d1",
                                                "sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                                                "text": "„Die Schwadronen seiner Ausbildungsabteilung sind ebenfalls alarmiert worden; gleich in der nächsten Nacht sollen sie ausrücken.“"
                                            },
                                            {
                                                "example_id": "ec9bcd02-871e-4ddb-b9a3-a9e2722f0d04",
                                                "sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                                                "text": "„Zögernd ritt die Schwadron den steilen Berg der Vorstadt hinauf.“"
                                            },
                                            {
                                                "example_id": "cf71532b-0ece-4318-9f37-2e654f16ffbc",
                                                "sense_id": "ae05d5c7-2085-3f34-ace4-8a372d7f2db9",
                                                "text": "„Die Schwadron, der Nikolai Rostow als Junker angehörte, lag in dem deutschen Dorf Salzeneck im Quartier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b4c730c-382a-41b4-9492-4218e8fa9ee7",
                        "source_entry_id": "f6cc2828-b414-3d09-a582-52a29b7e868d",
