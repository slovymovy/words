                                        "entry_id": "fdad3f54-a552-37e9-b095-a872c38f62f3",
                                        "glosses": [
                                            "geschlechtsreifes weibliches Hausrind, das noch kein Kalb geboren hat"
                                        ],
                                        "tags": [
