                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Happily</w>, the rain stopped just before the picnic started.",
                            "target_lang_translations": {
                                "ru": "<w>К счастью</w>, дождь прекратился как раз перед началом пикника.",
                                "tr": "<w>Neyse ki</w> yağmur piknik başlamadan hemen önce durdu.",
                                "zh": "<w>幸运的是</w>，雨在野餐开始前刚好停了。",
                                "pl": "<w>Na szczęście</w> deszcz przestał padać tuż przed rozpoczęciem pikniku.",
                                "nl": "<w>Gelukkig</w> stopte de regen net voordat de picknick begon.",
                                "de": "<w>Glücklicherweise</w> hörte der Regen kurz vor Beginn des Picknicks auf.",
                                "fr": "<w>Heureusement</w>, la pluie s'est arrêtée juste avant le début du pique-nique.",
                                "it": "<w>Fortunatamente</w>, la pioggia è smessa poco prima che iniziasse il picnic.",
                                "cs": "<w>Naštěstí</w> déšť ustal těsně před začátkem pikniku.",
                                "es": "<w>Afortunadamente</w>, la lluvia paró justo antes de que empezara el picnic."
                            }
                        },
                        {
                            "text": "The missing documents were <w>happily</w> found in a drawer.",
