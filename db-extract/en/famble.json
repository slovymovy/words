                                "example_id": "12c96b02-6767-4261-88ce-0fcdcc4ee2fa",
                                "sense_id": "96d0020a-7bb5-381f-b273-063335b4ec10",
                                "text": "We clap our fambles."
                            },
                            {
                                "example_id": "c5e97dd5-2223-4ab9-8b3d-eb9a85340423",
                                "sense_id": "96d0020a-7bb5-381f-b273-063335b4ec10",
                                "text": "A Bow Street Runner says \"I knew a cove as talked the way you do – leastways, in the way of business I knew him! In fact, you remind me of him very strong […] He was on the dub-lay, and very clever with his fambles. He ended up in the Whit, o’ course.\""
                            },
                            {
                                "example_id": "6f92bcd2-f32e-476a-806f-cd678b6abb87",
                                "sense_id": "96d0020a-7bb5-381f-b273-063335b4ec10",
                                "text": "I'm keeping my fambles clean on this trip."
                            }
                        ]
                    }
