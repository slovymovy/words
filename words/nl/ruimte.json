                {
                    "sense_id": "349052ea-3585-3a3f-919c-add992adbdf6",
                    "sense_definition": "de beschikbare fysieke plek of afstand die een object kan innemen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fysieke_omvang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is in deze kleine kamer niet genoeg <w>ruimte</w> voor een grote kast.",
                            "target_lang_translations": {
                                "en": "There is not enough <w>room</w> in this small room for a large cupboard.",
                                "ru": "В этой маленькой комнате недостаточно <w>места</w> для большого шкафа."
                            }
                        },
                        {
                            "text": "Je moet voldoende <w>ruimte</w> laten tussen de auto's voor de veiligheid.",
                            "target_lang_translations": {
                                "en": "You must leave sufficient <w>space</w> between the cars for safety.",
                                "ru": "Для безопасности нужно оставлять достаточное <w>расстояние</w> между машинами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voldoende ruimte",
                        "ruimte gebrek"
                    ],
                    "target_lang_definitions": {
                        "en": "the available physical area or distance that an object can occupy",
                        "ru": "доступное физическое место или расстояние, которое может занимать объект"
                    },
