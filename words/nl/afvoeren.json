{
    "word_family": [
        "afvoer",
        "toevoeren",
        "doorvoeren",
        "uitvoeren",
        "invoeren"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b3d1efa-9ed9-3996-9d6a-3dc472780701",
                    "sense_definition": "Het wegleiden, transporteren of verwijderen van personen, goederen of vloeistoffen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gewonde soldaten werden snel met een ambulance <w>afgevoerd</w> naar het ziekenhuis.",
                            "target_lang_translations": {
                                "en": "The wounded soldiers were quickly <w>evacuated</w> to the hospital by ambulance."
                            }
                        },
                        {
                            "text": "Na de storm moesten we al het overtollige water en de omgewaaide bomen snel <w>afvoeren</w>.",
                            "target_lang_translations": {
                                "en": "After the storm, we had to quickly <w>drain</w> all the excess water and remove the fallen trees."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegvoeren",
                        "verwijderen",
                        "wegleiden",
                        "transporteren"
                    ],
                    "antonyms": [
                        "aanvoeren",
                        "toevoeren"
                    ],
                    "common_phrases": [
                        "water afvoeren",
                        "afval afvoeren",
                        "gevangenen afvoeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To drain, lead away, transport, or remove people, goods, or liquids."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drain",
                                "target_lang_sense_clarification": "of liquids"
                            },
                            {
                                "target_lang_word": "evacuate",
                                "target_lang_sense_clarification": "of people, such as wounded or prisoners"
                            },
                            {
                                "target_lang_word": "remove",
                                "target_lang_sense_clarification": "of waste or debris"
                            },
                            {
                                "target_lang_word": "dispose of",
                                "target_lang_sense_clarification": "of waste materials"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a33fce8-815a-3213-a274-4ee5832a69e1",
                    "sense_definition": "Iets niet langer handhaven, schrappen of buiten gebruik stellen (zoals een idee, toneelstuk of product).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schrappen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directie besloot om dat verouderde product definitief uit het assortiment te <w>afvoeren</w>.",
                            "target_lang_translations": {
                                "en": "The management decided to permanently <w>discontinue</w> that outdated product from the range."
                            }
                        },
                        {
                            "text": "Wegens tegenvallende bezoekersaantallen moesten ze de theatervoorstelling vroegtijdig <w>afvoeren</w>.",
                            "target_lang_translations": {
                                "en": "Due to disappointing visitor numbers, they had to <w>withdraw</w> the theater production early."
                            }
                        }
                    ],
                    "synonyms": [
                        "schrappen",
                        "afschaffen",
                        "elimineren",
                        "intrekken"
                    ],
                    "antonyms": [
                        "invoeren",
                        "introduceren"
                    ],
                    "common_phrases": [
                        "een toneelstuk afvoeren",
                        "uit het assortiment afvoeren"
                    ],
                    "target_lang_definitions": {
                        "en": "To no longer maintain, to scrap, phase out, or withdraw from use (such as an idea, play, or product)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "phase out",
                                "target_lang_sense_clarification": "of products or services"
                            },
                            {
                                "target_lang_word": "discontinue",
                                "target_lang_sense_clarification": "of products or assortments"
                            },
                            {
                                "target_lang_word": "withdraw",
                                "target_lang_sense_clarification": "of plays, shows, or products"
                            },
                            {
                                "target_lang_word": "eliminate",
                                "target_lang_sense_clarification": "to completely remove or scrap"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c983f466-8b48-3730-b8c7-e472cea41534",
                    "sense_definition": "De meervoudige verleden tijd van <w>afvaren</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verleden_tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een prachtig gezicht toen wij met de boot geruisloos van de kust <w>afvoeren</w>.",
                            "target_lang_translations": {
                                "en": "It was a beautiful sight when we silently <w>sailed away</w> from the coast in the boat."
                            }
                        },
                        {
                            "text": "Zodra het signaal klonk, merkten we dat zij langzaam de rivier <w>afvoeren</w>.",
                            "target_lang_translations": {
                                "en": "As soon as the signal sounded, we noticed that they were slowly <w>sailing down</w> the river."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past plural of afvaren"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The past plural form of 'afvaren' (to sail away, depart by boat)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sailed away",
                                "target_lang_sense_clarification": "past plural of departing by boat"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1bc489ef-2498-30a8-92aa-7720b9c01244",
                    "sense_definition": "Het meervoud van het zelfstandig naamwoord <w>afvoer</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meervoud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De loodgieter moest alle verstopte <w>afvoeren</w> in het oude gebouw grondig reinigen.",
                            "target_lang_translations": {
                                "en": "The plumber had to thoroughly clean all the clogged <w>drains</w> in the old building."
                            }
                        },
                        {
                            "text": "Tijdens de hevige regenval konden de <w>afvoeren</w> op de straat het water niet meer verwerken.",
                            "target_lang_translations": {
                                "en": "During the heavy rainfall, the street <w>drains</w> could no longer handle the water."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of afvoer"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The plural form of the noun 'afvoer' (drain, waste pipe)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drains",
                                "target_lang_sense_clarification": "plural of drain"
                            },
                            {
                                "target_lang_word": "outlets",
                                "target_lang_sense_clarification": "plural of outlet or discharge pipe"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}