                "senses": [
                    {
                        "sense_id": "322ad89c-d971-3ff6-a7b0-28482814666c",
                        "entry_id": "f66d9b81-bb1a-3534-a757-814f203ebc1b",
                        "glosses": [
                            "die Entstehung des Universums nach dem Standardmodell der Kosmologie"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "f2ed301c-3e79-4819-aab1-f294cc2381b9",
                                "sense_id": "322ad89c-d971-3ff6-a7b0-28482814666c",
                                "text": "Man nimmt an, dass das Weltall mit einem Urknall entstand."
                            },
                            {
                                "example_id": "28daa338-f52d-4cc2-8064-03053b7ae857",
                                "sense_id": "322ad89c-d971-3ff6-a7b0-28482814666c",
                                "text": "Nach dem Standardmodell der Kosmologie nahm das Universum vor rund 13,8 Milliarden Jahren im Urknall seinen Anfang."
                            },
                            {
                                "example_id": "b1e27d3a-1582-4416-a50c-2afb15fe6493",
                                "sense_id": "322ad89c-d971-3ff6-a7b0-28482814666c",
                                "text": "Seine Mission hat der kleine Satellit LISA mehr als erfüllt. Er hat den Grundstein gelegt für die weitere Erforschung von Gravitationswellen im All - entstanden beim Urknall."
                            },
                            {
                                "example_id": "6672a883-b984-41c4-994a-436e3f873f75",
                                "sense_id": "322ad89c-d971-3ff6-a7b0-28482814666c",
                                "text": "„Das Standardmodell der Kosmologie beschreibt ein Universum, das aus dem Nichts mit dem Urknall entstand und seitdem expandiert.“"
                            },
                            {
                                "example_id": "720cd9be-8b97-450e-8f81-f60367ba0582",
                                "sense_id": "322ad89c-d971-3ff6-a7b0-28482814666c",
                                "text": "„Im Physikstudium erfuhr ich dann, dass bereits 10⁻⁴⁴ Sekunden nach dem Urknall, der sogenannten Planck-Zeit, Raum und Zeit definiert wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1eab342f-0b3a-4299-9cab-14fae880d264",
