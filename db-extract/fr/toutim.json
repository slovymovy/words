                    {
                        "sense_id": "e699f667-a3ab-383d-bf1d-77721a0f6321",
                        "entry_id": "d977b536-c4f5-3078-b109-29f87fa95103",
                        "glosses": [
                            "Ensemble d’objets, totalité d’un lot."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4326ee89-80fd-4c38-865b-cd66efc77a31",
                                "sense_id": "e699f667-a3ab-383d-bf1d-77721a0f6321",
                                "text": "Dans la penderie de ma chambre, ma bonne valise était prête, comme toujours, avec les trois costards, les six limaces, et le toutim; le petit nécessaire de l’homme en cavale, et puis, en dessous, deux bonnes briques en talbins de dix mille, tout neufs, que j’avais été le jour même retirer de mon coffre."
                            },
                            {
                                "example_id": "d18f0ac0-72cf-4420-9ded-2ac05b84dcb2",
                                "sense_id": "e699f667-a3ab-383d-bf1d-77721a0f6321",
                                "text": "Depuis une semaine, ayant strictement rien à maquiller, elle venait de filer le tarin dans une série de volumes, hérités, avec le toutim, du baronnet, et qu’elle avait jusqu’alors conservés, bicause les reliures qui cadraient parfaitement avec les boiseries de la bibliothèque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a23f844-168f-4e0a-9fec-cbd791f8ebc0",
                        "source_entry_id": "d977b536-c4f5-3078-b109-29f87fa95103",
                        "source_sense_id": "e699f667-a3ab-383d-bf1d-77721a0f6321",
                        "target_lang_word": "whole ball of wax",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whole ball of wax",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c06ac7de-73a7-3a7a-81b0-d93fa5331294",
                                        "entry_id": "85758028-6617-3071-8772-8238c633bda3",
                                        "glosses": [
                                            "The entire or overall plan, concept or action."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82a76868-ff89-44bf-990d-b6edc365e502",
                                                "sense_id": "c06ac7de-73a7-3a7a-81b0-d93fa5331294",
                                                "text": "The whole ball of wax will be viewed in 5 minutes."
                                            },
                                            {
                                                "example_id": "b00302d9-50cb-4cae-aa6d-ed62f31c3613",
                                                "sense_id": "c06ac7de-73a7-3a7a-81b0-d93fa5331294",
                                                "text": "In my opinion the whole ball of wax depends on what she'll say."
                                            },
                                            {
                                                "example_id": "68fa064e-b10e-46e1-a3f6-ac9a125b2fd0",
                                                "sense_id": "c06ac7de-73a7-3a7a-81b0-d93fa5331294",
                                                "text": "Of course I have to take a little advantage. After all, I'm the guy who puts the thing together—the whole ball of wax."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a1dfde6-6534-3cf4-9b9f-3fc97a9469ff",
                                        "entry_id": "85758028-6617-3071-8772-8238c633bda3",
                                        "glosses": [
                                            "Everything of a similar or related nature; everything necessary for a particular purpose."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71099a52-2886-4598-aaab-40dbf9d766cd",
                                                "sense_id": "3a1dfde6-6534-3cf4-9b9f-3fc97a9469ff",
                                                "text": "We've got pots, pans, the food and cooking utensils—the whole ball of wax."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
