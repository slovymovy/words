                "senses": [
                    {
                        "sense_id": "7e8e88f9-4488-3fb7-8b49-e7f22446dd58",
                        "entry_id": "b40c744c-bb36-3eb7-8bee-3503de5e5b65",
                        "glosses": [
                            "Suspicious; having suspicions or questions."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "79f53e9e-4742-4d59-b548-e33dd3408faf",
                                "sense_id": "7e8e88f9-4488-3fb7-8b49-e7f22446dd58",
                                "text": "Even my lame psychic ability told me he'd be pretty sus if he found me pissing on in the lounge room on a week night."
                            },
                            {
                                "example_id": "2f8c7df3-7663-42a4-8233-ef4c705afff0",
                                "sense_id": "7e8e88f9-4488-3fb7-8b49-e7f22446dd58",
                                "text": "Everyone had been a bit sus about Mrs Jones and Lana Vilenskaya, so it wasn't surprising that Mrs Jones stood to speak."
                            },
                            {
                                "example_id": "8d651d1b-c485-4345-b86c-509ab2532b68",
                                "sense_id": "7e8e88f9-4488-3fb7-8b49-e7f22446dd58",
                                "text": "I'm still really sus about those crocs we found in the drains."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa9ce08a-6c80-3434-ab0c-d18efbfd26fd",
                        "entry_id": "b40c744c-bb36-3eb7-8bee-3503de5e5b65",
                        "glosses": [
                            "Suspicious; raising or causing people to have suspicions."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "93ad5719-a1bc-4ba6-affb-f48c4ac816bb",
                                "sense_id": "fa9ce08a-6c80-3434-ab0c-d18efbfd26fd",
                                "text": "Why this should be I will never know except I might be a pretty sus looking geezer or something. They took about six of us who were in the cafe down the nick and dubbed us up in separate peters. After a long while these two bogies came into ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e744970-798b-31f9-9695-7cc621cc4c12",
                        "entry_id": "b40c744c-bb36-3eb7-8bee-3503de5e5b65",
                        "glosses": [
                            "Acting in a borderline sexually inappropriate way, causing others to \\\"suspect\\\" them of being sexually attracted to someone and trying to hide it."
                        ],
                        "tags": [
                            "humorous",
                            "often",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c3ff9971-7ccd-4ac3-8308-52201d6471a4",
                                "sense_id": "6e744970-798b-31f9-9695-7cc621cc4c12",
                                "text": "That guy is always acting sus with the boys—are you sure he's not gay?"
                            },
                            {
                                "example_id": "861e3201-b95e-4425-ad57-e92196bd76a3",
                                "sense_id": "6e744970-798b-31f9-9695-7cc621cc4c12",
                                "text": "I was acting sus with my friend turns out he's gay I don't think he was joking"
                            },
                            {
                                "example_id": "a6009f38-7510-4d1c-b6f4-086970e513d2",
                                "sense_id": "6e744970-798b-31f9-9695-7cc621cc4c12",
                                "text": "Maybe I’m a sus hetero bro who's been subtly abusive and deserves to be blocked out entirely."
                            },
                            {
                                "example_id": "3f5df00d-bd08-4c48-9f8d-56ac72dfbdd5",
                                "sense_id": "6e744970-798b-31f9-9695-7cc621cc4c12",
                                "text": "Gf [30] was acting sus around another guy and not sure If im [M20] just overthinking it."
                            },
                            {
                                "example_id": "401b8c6d-d5c6-4772-bfd9-a82920250bbc",
                                "sense_id": "6e744970-798b-31f9-9695-7cc621cc4c12",
                                "text": "I've also heard many instances of him acting sus with girls."
                            },
                            {
                                "example_id": "e4f0caf4-7f34-4057-b763-667f8d84aff3",
                                "sense_id": "6e744970-798b-31f9-9695-7cc621cc4c12",
                                "text": "Totally not being sus with my controller"
                            }
                        ]
                    }
