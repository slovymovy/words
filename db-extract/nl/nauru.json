                                            {
                                                "example_id": "5e6f94ea-bd0e-4d02-99ab-92ce004cc18c",
                                                "sense_id": "3df20dbc-98aa-3173-be01-3b81cc2c51de",
                                                "text": "Nauru ist ein Atoll auf der Spitze eines unterirdischen erloschenen Vulkans."
                                            },
                                            {
                                                "example_id": "bdc0cae4-c61d-47cb-9131-1b154ba62a1d",
                                                "sense_id": "3df20dbc-98aa-3173-be01-3b81cc2c51de",
                                                "text": "Mit etwa 13.000 Einwohnern ist Nauru einer der kleinsten Staaten der Welt."
                                            },
                                            {
                                                "example_id": "ea4c822b-107d-4c37-ac0d-8bddf6446be3",
                                                "sense_id": "3df20dbc-98aa-3173-be01-3b81cc2c51de",
                                                "text": "„Nauru blieb bei Australien und wurde am 31. Januar 1986 unabhängig.“"
                                            }
                                        ],
