                "senses": [
                    {
                        "sense_id": "00978657-ec09-3c32-9438-59a21500f369",
                        "entry_id": "5edba23f-ae01-303f-bff4-7cbf3cbd3d5c",
                        "glosses": [
                            "oorspronkelijke bewoner van Australië voordat Europeanen zich daar gingen vestigen, of een nazaat daarvan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c665475d-b7f3-4f63-8433-c34e184f0ff6",
                                "sense_id": "00978657-ec09-3c32-9438-59a21500f369",
                                "text": "De vaagheden rond de dood van de man en het feit dat zijn familie niet meteen op de hoogte is gesteld, hebben tot veel onbegrip geleid. Daar komt bij dat Walker de tweede Aboriginal in twee maanden tijd is die om het leven komt door een politiekogel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7da05c1-38dd-43aa-8111-40f5b6901a4b",
                        "source_entry_id": "5edba23f-ae01-303f-bff4-7cbf3cbd3d5c",
                        "source_sense_id": "00978657-ec09-3c32-9438-59a21500f369",
                        "source_sense_description": "oorspronkelijke bewoner van Australië",
                        "target_lang_word": "Aboriginal",
                        "target_lang_code": "en",
