                ],
                "senses": [
                    {
                        "sense_id": "f804eb24-de66-3656-b4c3-76826909d1f4",
                        "entry_id": "63d2f171-3da6-39e4-97a5-99515e0d4f09",
                        "glosses": [
                            "Sorte d’étoffe de soie douce et croisée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c9bd701-b1bf-457b-9036-040e95b532c2",
                                "sense_id": "f804eb24-de66-3656-b4c3-76826909d1f4",
                                "text": "Le corsage est montant, […]. Col et sous-manche en toile. Cravate en surah cardinal, ornée de dentelle."
                            },
                            {
                                "example_id": "adc1e241-91d3-4ab0-868a-db2065fd5489",
                                "sense_id": "f804eb24-de66-3656-b4c3-76826909d1f4",
                                "text": "Anthime ne se souciait plus des modes ; mais, pour simple qu'il désirât sa cravate (modeste nœud de surah noir), encore la voulait-il choisir."
                            },
                            {
                                "example_id": "2d77663f-6906-4137-8524-19abf69e863a",
                                "sense_id": "f804eb24-de66-3656-b4c3-76826909d1f4",
                                "text": "Mme de Marsantes avait une robe de surah blanc à grandes palmes, sur lesquelles se détachaient des fleurs en étoffe, lesquelles étaient noires."
                            },
                            {
                                "example_id": "75dd3829-9ed6-42a6-aac7-1d2741f8ed88",
                                "sense_id": "f804eb24-de66-3656-b4c3-76826909d1f4",
                                "text": "Rigott était une petite vieille accorte, un peu grasse, aux splendides bandeaux d'argent ; éternellement vêtue d'une robe de surah noir, copieusement blindée de passementeries anciennes."
                            },
                            {
                                "example_id": "3197e3e2-a554-409c-be32-ef77592ae679",
                                "sense_id": "f804eb24-de66-3656-b4c3-76826909d1f4",
                                "text": "Chez Mme Gandolin on s’empresse, on étale les moires, les surahs. Tout le monde aime Agnès et veut qu’elle soit belle, le jour de la noce."
                            }
                        ]
                    }
                ],
