                                    },
                                    {
                                        "sense_id": "3a0ac1bf-f6b2-3363-86c6-ecafd615e1af",
                                        "entry_id": "9198dda9-6ae1-31e0-a0d7-aaa8c4fc5165",
                                        "glosses": [
                                            "Inhaber des Grads des Magisters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46404a90-d8d2-445a-9a4e-fd84c924723f",
                                                "sense_id": "3a0ac1bf-f6b2-3363-86c6-ecafd615e1af",
                                                "text": "Küss die Hand, Frau Magister!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c8158bdb-e39f-3857-86ff-93767a71900e",
                                        "entry_id": "9198dda9-6ae1-31e0-a0d7-aaa8c4fc5165",
                                        "glosses": [
                                            "Apotheker"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "5753379d-3aa4-3352-be6a-887318cead0b",
                                        "entry_id": "9198dda9-6ae1-31e0-a0d7-aaa8c4fc5165",
                                        "glosses": [
                                            "Lehrer"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c60b897-c665-4317-bea6-7e0ec75f87be",
                                                "sense_id": "5753379d-3aa4-3352-be6a-887318cead0b",
                                                "text": "Mein Magister sagte immer: »Das Leben ist eines der härtesten«."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "0e0968c8-a556-3cdb-8a95-82681793bde2",
                                        "entry_id": "9198dda9-6ae1-31e0-a0d7-aaa8c4fc5165",
                                        "glosses": [
                                            "akademischer Grad mit Lehrberechtigung an Hochschulen"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ffe3646-8a2c-4418-8e36-6f04f0388c99",
                                                "sense_id": "0e0968c8-a556-3cdb-8a95-82681793bde2",
                                                "text": "„Der Magister konnte zur Hölle fahren, und genau dorthin dürfte er auch gekommen sein, als er starb.“"
                                            },
                                            {
                                                "example_id": "7afd7752-f044-4cbd-ba68-b0f0748d08fd",
                                                "sense_id": "0e0968c8-a556-3cdb-8a95-82681793bde2",
                                                "text": "„Er sei der Assistent des Magistersund berühmten Professors Kant, Königsberg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51686fd7-0997-47a8-a60e-6bbe48ad9d07",
                        "source_entry_id": "7d5c0c6b-d9f4-3846-93ee-1392f5b3edae",
                        "target_lang_word": "Lehrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lehrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c421ab8c-9c34-3f4a-96bd-7124f0088fdd",
                                        "entry_id": "022d9bbe-933a-33b9-ac2a-af078453f38b",
                                        "glosses": [
                                            "Person, die Wissen (beziehungsweise Fertigkeiten, Verhaltensweisen, Werte und so weiter) an Lernende (Schüler, Studenten) vermittelt, häufig im Rahmen des Unterrichts an einer Bildungseinrichtung"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a636e73-d05e-44ab-a28b-3f209232a485",
                                                "sense_id": "c421ab8c-9c34-3f4a-96bd-7124f0088fdd",
                                                "text": "Der Lehrer erklärt mir die Grundrechenarten."
                                            },
                                            {
                                                "example_id": "62d18a1a-3ac5-44ed-a5a2-ccbce31a22bd",
                                                "sense_id": "c421ab8c-9c34-3f4a-96bd-7124f0088fdd",
                                                "text": "Der Lehrer hat vormittags recht und nachmittags frei."
                                            },
                                            {
                                                "example_id": "e65eaf84-fd09-43b0-b687-78e9f0808cb1",
                                                "sense_id": "c421ab8c-9c34-3f4a-96bd-7124f0088fdd",
                                                "text": "[Wolfgang Clement, Ex-Ministerpräsident des Landes Nordrhein-Westfalen:] „Wir haben nach Schätzungen, die ich für realistisch halte, mindestens 20.000 Lehrerinnen und Lehrer zu wenig.“"
                                            },
                                            {
                                                "example_id": "85ac5d72-ee22-48ce-a285-477cf249d57d",
                                                "sense_id": "c421ab8c-9c34-3f4a-96bd-7124f0088fdd",
                                                "text": "„Und nicht nur die Schüler, auch die schlecht bezahlten Lehrer fehlen oft.“"
                                            },
                                            {
                                                "example_id": "f504051b-3fd3-48c0-938c-5a122676f56f",
                                                "sense_id": "c421ab8c-9c34-3f4a-96bd-7124f0088fdd",
                                                "text": "„Der Lehrer oder noch häufiger die Lehrerin als Respektsperson stellt eine Frage, und der Schüler gibt eine verblüffende Antwort, die eine nonkonforme Antwort verrät.“"
                                            },
                                            {
                                                "example_id": "eb88e480-e3f5-447c-95c6-5b2f20ea61e0",
                                                "sense_id": "c421ab8c-9c34-3f4a-96bd-7124f0088fdd",
                                                "text": "„Ihr Mann war Lehrer wie sie selbst und unterrichtete außer Mathematik noch Wehrschutz, deshalb kannte er sich ein wenig mit radioaktiven Strahlen aus und besorgte ihnen Jodtabletten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lehrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "763b0d6c-afbd-3c7b-ace3-4de9952aa3a7",
                                        "entry_id": "1434cba5-1086-320e-934d-7bd5b1093eb0",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd40be9d-d68f-4156-9331-6d400b707b13",
                                                "sense_id": "763b0d6c-afbd-3c7b-ace3-4de9952aa3a7",
                                                "text": "Frau Lehrer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "f75addf1-4b77-458b-aad9-af8058f88e91",
                                                "sense_id": "763b0d6c-afbd-3c7b-ace3-4de9952aa3a7",
                                                "text": "Herr Lehrer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "45c728ee-2507-4d83-a3ee-de765fabc3ef",
                                                "sense_id": "763b0d6c-afbd-3c7b-ace3-4de9952aa3a7",
                                                "text": "Die Lehrers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "add42548-52c4-44e0-9524-2b25c160272a",
                                                "sense_id": "763b0d6c-afbd-3c7b-ace3-4de9952aa3a7",
                                                "text": "Der Lehrer trägt nie die Schals, die die Lehrer ihm strickt."
                                            },
                                            {
                                                "example_id": "2debcd55-fb2a-4968-beb1-0fe44bfc1c79",
                                                "sense_id": "763b0d6c-afbd-3c7b-ace3-4de9952aa3a7",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lehrer kommt, geht der Herr Lehrer.“"
                                            },
                                            {
                                                "example_id": "ff9eff58-169f-4c3a-91d7-6ad01cf50025",
                                                "sense_id": "763b0d6c-afbd-3c7b-ace3-4de9952aa3a7",
                                                "text": "Lehrer kommt und geht."
                                            },
                                            {
                                                "example_id": "9181a687-b0dc-41fe-b130-f02954796155",
                                                "sense_id": "763b0d6c-afbd-3c7b-ace3-4de9952aa3a7",
                                                "text": "Lehrers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
