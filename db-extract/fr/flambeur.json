                ],
                "senses": [
                    {
                        "sense_id": "b6da4a13-5fdb-3e2d-83e1-7f49a77f8772",
                        "entry_id": "09c8a8e4-8907-3089-aeee-cac718968ca9",
                        "glosses": [
                            "Personne qui flambe son argent, particulièrement au jeu ; qui dépense de façon ostentatoire, cherche à en mettre plein la vue ; m’as-tu-vu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da29f657-5cbc-4456-a1ff-f524d566fc76",
                                "sense_id": "b6da4a13-5fdb-3e2d-83e1-7f49a77f8772",
                                "text": "Qu’ils vous aperçoivent sur un champ de courses, ils vous font passer pour un flambeur incorrigible qui dépense tous ses appointements et qui vendrait sa culotte pour encourager la race chevaline."
                            },
                            {
                                "example_id": "4fa8cb66-b4b6-4c87-a816-195b9662cb1c",
                                "sense_id": "b6da4a13-5fdb-3e2d-83e1-7f49a77f8772",
                                "text": "Gaspillage éhonté! Au prix où est le fuel… flambeurs!!"
                            },
                            {
                                "example_id": "37d636e3-fced-447d-a33d-b8ec806d115d",
                                "sense_id": "b6da4a13-5fdb-3e2d-83e1-7f49a77f8772",
                                "text": "Si je tombe sur un flambeur, je suis jeté dans les lits des filles, joué aux dés, et en un tournemain je me retrouve à poil, dans la rue."
                            },
                            {
                                "example_id": "246fe60e-5eb1-4528-9a66-95db0ec5e0ab",
                                "sense_id": "b6da4a13-5fdb-3e2d-83e1-7f49a77f8772",
                                "text": "C’est un flambeur de première !"
                            }
                        ]
                    }
                ],
