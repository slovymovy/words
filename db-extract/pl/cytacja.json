                "translations": [
                    {
                        "translation_id": "2b24f3c8-23fb-40d6-83dc-5cc123596bad",
                        "source_entry_id": "6d6b849d-79ee-3947-a265-0f821ba00d72",
                        "source_sense_id": "be35586c-df14-388b-9353-79b00fdcfa43",
                        "target_lang_word": "citation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9a35752-72ce-30b1-895a-28462a731193",
                                        "entry_id": "ba5a80b8-3aa0-3e03-8d91-740769718b31",
                                        "glosses": [
                                            "An official summons or notice given to a person to appear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29bfd233-0afe-4c81-a983-b714468425b2",
                                                "sense_id": "d9a35752-72ce-30b1-895a-28462a731193",
                                                "text": "No citation was issued upon this appeal returnable to the next term of this court, nor was the record filed and the cause docketed during that term. On the 29th of May, 1865, however, a citation was issued, returnable at this term, and service of this citation was acknowledged by the present district attorney; and the writ was returned and the record filed at this term, under an agreement between the district attorney and the attorney for the claimants, to submit the cause upon printed briefs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e37e8ae-7df0-3adf-9bb3-1b0e2d0e125e",
                                        "entry_id": "ba5a80b8-3aa0-3e03-8d91-740769718b31",
                                        "glosses": [
                                            "The paper containing such summons or notice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05efb88b-3d8b-38bd-93e4-bc2e80e8e044",
                                        "entry_id": "ba5a80b8-3aa0-3e03-8d91-740769718b31",
                                        "glosses": [
                                            "The act of citing a passage from a text, or from another person, using the exact words of the original text or speech and giving credit to the original by referencing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5cc9c8a-d08e-301b-a8fe-d61f0e14e301",
                                        "entry_id": "ba5a80b8-3aa0-3e03-8d91-740769718b31",
                                        "glosses": [
                                            "An entry in a list of sources from which information was taken, typically following a prescribed bibliographical style; a reference."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79bb9e86-a34a-3754-9576-72819628cd4d",
                                        "entry_id": "ba5a80b8-3aa0-3e03-8d91-740769718b31",
                                        "glosses": [
                                            "The passage or words quoted; a quotation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae689ed1-654c-3f56-98ba-ce1755b18a8c",
                                        "entry_id": "ba5a80b8-3aa0-3e03-8d91-740769718b31",
                                        "glosses": [
                                            "A quotation with attached bibliographical details demonstrating the use of a particular lexical item in a dictionary, especially a dictionary on historical principles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d9e5152-39c4-4e39-9a5d-4e13d03ec6c3",
                                                "sense_id": "ae689ed1-654c-3f56-98ba-ce1755b18a8c",
                                                "text": "Historically, target words were garnered through focused reading programs and citations were handwritten on slips of paper which were collated alphabetically and stored in drawers for ready access (much like old-fashioned library catalogues)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a8d40d9-030c-3661-8137-07d201919394",
                                        "entry_id": "ba5a80b8-3aa0-3e03-8d91-740769718b31",
                                        "glosses": [
                                            "Enumeration; mention."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a983d9f6-8138-4f17-a858-6ac643f0395b",
                                                "sense_id": "4a8d40d9-030c-3661-8137-07d201919394",
                                                "text": "It's a simple citation of facts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3b57c3b-9652-3479-8610-91d58440f81c",
                                        "entry_id": "ba5a80b8-3aa0-3e03-8d91-740769718b31",
                                        "glosses": [
                                            "A reference to decided cases, or books of authority, to prove a point in law."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d31d0547-565c-3ba4-93bd-4f2f56535986",
                                        "entry_id": "ba5a80b8-3aa0-3e03-8d91-740769718b31",
                                        "glosses": [
                                            "A commendation in recognition of some achievement, or a formal statement of an achievement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "036afead-4430-4e0f-bf8b-bd821f735e55",
                        "source_entry_id": "6d6b849d-79ee-3947-a265-0f821ba00d72",
                        "source_sense_id": "be35586c-df14-388b-9353-79b00fdcfa43",
                        "target_lang_word": "quotation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quotation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "babee3a8-80c1-31b9-8083-5d7862657b8b",
                                        "entry_id": "e1cbe761-fb42-31c5-9502-c1f87cafbb81",
                                        "glosses": [
                                            "A fragment of a human expression that is repeated by somebody else, for example from literature or a famous speech."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1772d4f5-44ec-40dc-ad6d-004d28f17621",
                                                "sense_id": "babee3a8-80c1-31b9-8083-5d7862657b8b",
                                                "text": "\"Where they burn books, they will also burn people\" is a famous quotation from Heinrich Heine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbc8ecfc-0200-3b24-a5e2-c0ca17a6c5e7",
                                        "entry_id": "e1cbe761-fb42-31c5-9502-c1f87cafbb81",
                                        "glosses": [
                                            "The act of quoting someone or something."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97d6e3b1-6973-490d-addb-8c5a17ea61a0",
                                                "sense_id": "bbc8ecfc-0200-3b24-a5e2-c0ca17a6c5e7",
                                                "text": "One of these preachers was a blacksmith, whose iron constitution had entirely given way, and the little strength that remained he exhausted in endless quotation of texts from the Bible."
                                            },
                                            {
                                                "example_id": "9dd221e8-3cd2-4fb0-8207-4a0ba887240c",
                                                "sense_id": "bbc8ecfc-0200-3b24-a5e2-c0ca17a6c5e7",
                                                "text": "Mr. [Augustine] Birrell has, as usual, quoted very liberally, and to excellent effect. Quotation is an art the difficulty of which may easily be underrated by paragraph-writers or by persons who do not write at all. You may say no end of wise things about a writer, and yet fail to convey a sense of the peculiar flavor for which you really value him. To insinuate a phrase or verse of our author into the midst of our own readable (because ephemeral) discourse, is all most of us may do, without giving our readers an unpalatable suspicion that they are being seduced into the perusal of a real author. Mr. Birrell quotes by the page, and we gratefully read every line because we are sure Mr. Birrell, at least, is incapable of asking us to read anything inconsequent or dull."
                                            },
                                            {
                                                "example_id": "e4108a02-2999-40c0-b0b7-c048407a4d7b",
                                                "sense_id": "bbc8ecfc-0200-3b24-a5e2-c0ca17a6c5e7",
                                                "text": "In his mature works, [Chinary] Ung pays regular homage to Cambodian music by evoking its ambience without resorting to quotation of specific Cambodian melodies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e352dcf-4467-3656-a58c-da4dd50d16f0",
                                        "entry_id": "e1cbe761-fb42-31c5-9502-c1f87cafbb81",
                                        "glosses": [
                                            "A price that has been quoted for buying or selling."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62b58eb2-7ae3-40f9-a655-76e83990cc70",
                                                "sense_id": "1e352dcf-4467-3656-a58c-da4dd50d16f0",
                                                "text": "Let's get a quotation for repairing the roof before we decide whether it's worth doing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a140412c-f9d8-3c96-a22f-92e1c0ee8c6b",
                                        "entry_id": "e1cbe761-fb42-31c5-9502-c1f87cafbb81",
                                        "glosses": [
                                            "The act of setting a price."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3809f61c-4d0e-3fb2-b222-389a21dda033",
                                        "entry_id": "e1cbe761-fb42-31c5-9502-c1f87cafbb81",
                                        "glosses": [
                                            "A quota, a share."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14005921-7ab1-49be-b35c-6192e7a4d087",
                        "source_entry_id": "6d6b849d-79ee-3947-a265-0f821ba00d72",
                        "source_sense_id": "be35586c-df14-388b-9353-79b00fdcfa43",
                        "target_lang_word": "Zitat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zitat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd9a794a-02ea-3df3-861f-cb39aaf2e693",
                                        "entry_id": "f5be2fb3-2465-3074-b40d-f470b1b8e5c8",
                                        "glosses": [
                                            "wörtliche Anführung (Wiedergabe) eines Textes, die immer in Anführungszeichen steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97349af0-6f8c-49ee-9bdd-79b33595c83f",
                                                "sense_id": "bd9a794a-02ea-3df3-861f-cb39aaf2e693",
                                                "text": "Ein Zitat aus Goethes Werken macht sich immer gut."
                                            },
                                            {
                                                "example_id": "1e0285fc-f19c-4ed4-a761-852b02e092fd",
                                                "sense_id": "bd9a794a-02ea-3df3-861f-cb39aaf2e693",
                                                "text": "„Ganz gleich, ob es sich um die Integration echter Zitate oder um die von Sprichwörtern, sprichwörtlichen Redewendungen und sonstigen phraseologischen Einheiten handelt - immer sind damit auch Übersetzer(innen) in eine fremde oder aus einer fremden Sprache vor Probleme gestellt.“"
                                            },
                                            {
                                                "example_id": "318a0bbe-7aa1-4a66-859d-3becb92b16cd",
                                                "sense_id": "bd9a794a-02ea-3df3-861f-cb39aaf2e693",
                                                "text": "„Mit diesem Zitat gelang es mir, ihn nicht grundsätzlich umzustimmen, aber doch sein vorläufiges Einverständnis zur Fortsetzung meiner Arbeit zu bekommen.“"
                                            },
                                            {
                                                "example_id": "f74d0788-f634-4ba0-ac85-24d06c67c09a",
                                                "sense_id": "bd9a794a-02ea-3df3-861f-cb39aaf2e693",
                                                "text": "„Auf weitere Zitate, die nicht weiterführen, sei verzichtet.“"
                                            },
                                            {
                                                "example_id": "a700a7f4-2b18-4cdf-b9f9-30ae534772b5",
                                                "sense_id": "bd9a794a-02ea-3df3-861f-cb39aaf2e693",
                                                "text": "„Wörter und Wortgruppen, die als Zitate aus einer fremden Sprache angesehen werden, bleiben in der Schreibung meist völlig unverändert .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
