    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bb6aa125-a1a5-34cc-880a-c444559d67c3",
                    "sense_definition": "Detached or positioned apart; not connected or joined.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two islands are <w>separated</w> by a narrow channel of water.",
                            "target_lang_translations": {
                                "ru": "Два острова <w>разделены</w> узким проливом.",
                                "zh": "两座岛屿被一条狭窄的水道<w>分开</w>了。"
                            }
                        },
                        {
                            "text": "Keep the raw meat <w>separated</w> from the fresh vegetables.",
                            "target_lang_translations": {
                                "ru": "Держите сырое мясо <w>отдельно</w> от свежих овощей.",
                                "zh": "要把生肉和新鲜蔬菜<w>分开</w>存放。"
                            }
                        }
                    ],
                    "synonyms": [
                        "detached",
                        "disconnected",
                        "apart",
                        "isolated",
                        "divided"
                    ],
                    "antonyms": [
                        "united",
                        "combined",
                        "unified"
                    ],
                    "common_phrases": [
                        "separated by",
                        "widely separated",
                        "separated from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отделённый или расположенный отдельно; не соединённый.",
                        "zh": "处于分离状态或位置上分开的；未连接或未结合的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделённый",
                                "target_lang_sense_clarification": "разъединённый на части или находящийся порознь"
                            },
                            {
                                "target_lang_word": "отделённый",
                                "target_lang_sense_clarification": "обособленный от чего-либо"
                            },
                            {
                                "target_lang_word": "отдельный",
                                "target_lang_sense_clarification": "самостоятельный, изолированный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分开的",
                                "target_lang_sense_clarification": "指物体或事物处于不连接的状态"
                            },
                            {
                                "target_lang_word": "分离的",
                                "target_lang_sense_clarification": "指从整体中被隔离开来"
                            },
                            {
                                "target_lang_word": "独立的",
                                "target_lang_sense_clarification": "指互不相关或单独存在"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bba7cac5-fce8-35dc-acab-94b97916eab9",
                    "sense_definition": "No longer living with a spouse or partner, though not necessarily legally divorced.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "marital_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My parents are <w>separated</w>, but they still celebrate holidays together.",
                            "target_lang_translations": {
                                "ru": "Мои родители <w>живут порознь</w>, но всё ещё отмечают праздники вместе.",
                                "zh": "我的父母虽然<w>分居</w>了，但节日时还是会聚在一起庆祝。"
                            }
                        },
                        {
                            "text": "She is currently <w>separated</w> from her husband.",
                            "target_lang_translations": {
                                "ru": "Она сейчас <w>живёт отдельно</w> от своего мужа.",
                                "zh": "她目前正与丈夫<w>分居</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "estranged",
                        "split up",
                        "apart"
                    ],
                    "antonyms": [
                        "united"
                    ],
                    "common_phrases": [
                        "legally separated",
                        "separated parents",
                        "recently separated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекратившие совместное проживание супруги или партнёры (но не обязательно официально разведённые).",
                        "zh": "指夫妻或伴侣不再共同生活，但不一定在法律上已离婚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живущий порознь",
                                "target_lang_sense_clarification": "о супругах, не живущих вместе"
                            },
                            {
                                "target_lang_word": "разошедшийся",
                                "target_lang_sense_clarification": "прекративший отношения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分居的",
                                "target_lang_sense_clarification": "指夫妻双方不再共同居住"
                            }
                        ]
                    }
                }
            ]
        },
        {
