                ],
                "senses": [
                    {
                        "sense_id": "44d46f5f-37be-3369-ba0e-9c48ad70ca23",
                        "entry_id": "b3761383-eaf7-3b45-bd9f-eba9effa190c",
                        "glosses": [
                            "Faire perdre son caractère naturel (lié à la Nature) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f17bd61a-7daa-4aa5-bd86-1afab0c4e139",
                                "sense_id": "44d46f5f-37be-3369-ba0e-9c48ad70ca23",
                                "text": "Il importe donc de «dénaturiser» l’idée de nature."
                            },
                            {
                                "example_id": "edbdeaf5-dfc5-4307-9733-60b6ebc9124b",
                                "sense_id": "44d46f5f-37be-3369-ba0e-9c48ad70ca23",
                                "text": "S’humaniser, pour lui, c’est se « dénaturiser », tout le combat de sa vie consistera désormais en cette sorte d’humanisation."
                            },
                            {
                                "example_id": "36e2086e-6f78-483e-aa13-e6ec93118dc5",
                                "sense_id": "44d46f5f-37be-3369-ba0e-9c48ad70ca23",
                                "text": "Ceci aboutit à un catholicisme dénaturisé, où l’acteur unique est l’homme, face à Dieu."
                            }
                        ]
                    }
                ],
