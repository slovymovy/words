        "fr-extract.jsonl": [
            {
                "entry_id": "e30bd292-3805-376f-ad9f-76f70e74e6ba",
                "word": "ontologique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d293de43-39ad-4dab-8ef6-3afcb6e978e1",
                        "entry_id": "e30bd292-3805-376f-ad9f-76f70e74e6ba",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "ontologiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43cfe075-3587-308d-815a-12b2bee668e1",
                        "entry_id": "e30bd292-3805-376f-ad9f-76f70e74e6ba",
                        "glosses": [
                            "Qui a rapport à l’ontologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f7aa9b9-410a-4bc8-b117-b9adc7546886",
                                "sense_id": "43cfe075-3587-308d-815a-12b2bee668e1",
                                "text": "La preuve ontologique de l’existence de Dieu, c’est la preuve tirée de l’idée de l’être infini, l’existence étant contenue dans l’idée que l’on a de la perfection."
                            },
                            {
                                "example_id": "4c261843-440f-4920-b778-27d86e8aba57",
                                "sense_id": "43cfe075-3587-308d-815a-12b2bee668e1",
                                "text": "Pour s’évader de la mentalité scolastique, il fallait répudier le réalisme des universaux […] ; qui conduisait à des théories erronées, telles que la fixité des espèces et la distinction ontologique des caractères essentiels et accidentels ; […]."
                            },
                            {
                                "example_id": "5144eea2-2b8e-4488-8335-4dad26466bf5",
                                "sense_id": "43cfe075-3587-308d-815a-12b2bee668e1",
                                "text": "Je fis sur « la preuve ontologique chez Descartes » une dissertation que Mademoiselle Lambert jugea médiocre."
                            },
                            {
                                "example_id": "d25e764a-8492-440c-b247-4457b5fece11",
                                "sense_id": "43cfe075-3587-308d-815a-12b2bee668e1",
                                "text": "Mais l’histoire n’est jamais la simple réalisation ontologique d’une telle potentialité, c’est une transformation permanente des réalités antérieures en fonction des conditions du moment […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "4e47f854-57e8-3db8-beeb-14754056a7bb",
                        "entry_id": "e30bd292-3805-376f-ad9f-76f70e74e6ba",
                        "glosses": [
                            "Qui concerne ce qui est constitutif de l’être, le fait même d’exister."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1d5c7249-fda2-4212-91d2-1bb74a0c70ab",
                                "sense_id": "4e47f854-57e8-3db8-beeb-14754056a7bb",
                                "text": "Le moignon ontologique insulte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08267364-99bd-40c8-97e4-95e485fe8bbe",
                        "source_entry_id": "e30bd292-3805-376f-ad9f-76f70e74e6ba",
                        "target_lang_word": "ontological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ontological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "937de27e-2f9a-381c-a233-195af0400557",
                                        "entry_id": "ba9d5961-d9dc-304f-b211-e0c68c4a1381",
                                        "glosses": [
                                            "Of or relating to ontology."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "878502ee-375e-4080-ac9f-5806561531ff",
                                                "sense_id": "937de27e-2f9a-381c-a233-195af0400557",
                                                "text": "A curious thing about the ontological problem is its simplicity. It can be put in three Anglo-Saxon monosyllables: ‘What is there?’ It can be answered, moreover, in a word—‘Everything’—and everyone will accept this answer as true."
                                            },
                                            {
                                                "example_id": "bf9834ad-f090-4692-bf28-55d3f631575c",
                                                "sense_id": "937de27e-2f9a-381c-a233-195af0400557",
                                                "text": "Applying a critical discourse analysis to MM, this thesis argues that far-right media portrays any challenge to the status quo, be it demographic, political, cultural, or social, as threatening to ontological security by utilizing a Positive Self and Negative Other dichotomy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "159197b7-2af0-3cd2-baf6-0ded685f1cd3",
                                        "entry_id": "ba9d5961-d9dc-304f-b211-e0c68c4a1381",
                                        "glosses": [
                                            "Of or pertaining to the nature of being or existence."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cf92e79-d7bb-4aae-9124-1e931226a8d7",
                                                "sense_id": "159197b7-2af0-3cd2-baf6-0ded685f1cd3",
                                                "text": "Such is the human ontological imagination, and such is the convincingness of what it brings to birth. Unpicturable beings are realized, and realized with an intensity almost like that of an hallucination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad948f0f-c714-40a4-8a31-a14a6fe9cb1f",
                        "source_entry_id": "e30bd292-3805-376f-ad9f-76f70e74e6ba",
                        "target_lang_word": "존재론적",
                        "target_lang_code": "ko",
