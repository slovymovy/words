                                            {
                                                "example_id": "1a0ebc96-8239-47d4-b90f-6a7fa66dde81",
                                                "sense_id": "1fd6a628-1ba2-3d6d-aac2-7a9b4ae94547",
                                                "text": "„Im Einzugsbereich der altägyptischen Reichshauptstadt Memphis erstreckt sich über Dutzende von Kilometern und parallel zum Verlauf des Nils eine gewaltige Nekropole. Die Totenstadt war nahezu während der gesamten 3000-jährigen pharaonischen Geschichte in Benutzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
