{
    "word_family": [],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "10f5c14f-cf76-378c-8765-371f8fe46250",
                    "sense_definition": "Extremely great in number; innumerable or multitudinous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "countless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government has imposed <w>myriad</w> new restrictions to address the ongoing crisis.",
                            "target_lang_translations": {
                                "de": "Die Regierung hat <w>unzählige</w> neue Beschränkungen erlassen, um die anhaltende Krise zu bewältigen."
                            }
                        },
                        {
                            "text": "There are <w>myriad</w> reasons to pursue a healthy and active lifestyle.",
                            "target_lang_translations": {
                                "de": "Es gibt <w>unzählige</w> Gründe, einen gesunden und aktiven Lebensstil zu verfolgen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "myriad reasons",
                        "myriad possibilities",
                        "myriad ways"
                    ],
                    "target_lang_definitions": {
                        "de": "Extrem zahlreich; unzählbar oder in einer riesigen Menge vorhanden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "unzählig",
                                "target_lang_sense_clarification": "sehr zahlreich, nicht zählbar"
                            },
                            {
                                "target_lang_word": "zahlreich",
                                "target_lang_sense_clarification": "in großer Anzahl vorhanden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da99532f-9dfe-350b-b1e7-2fee7b651398",
                    "sense_definition": "Multifaceted or having countless diverse aspects.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "countless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The causes of the condition are <w>myriad</w> and difficult to diagnose properly.",
                            "target_lang_translations": {
                                "de": "Die Ursachen für diesen Zustand sind <w>vielfältig</w> und schwer korrekt zu diagnostizieren."
                            }
                        },
                        {
                            "text": "They walked out into the soft <w>myriad</w> darkness of the late spring night.",
                            "target_lang_translations": {
                                "de": "Sie traten hinaus in die sanfte, <w>vielfältige</w> Dunkelheit der späten Frühlingsnacht."
                            }
                        }
                    ],
                    "common_phrases": [
                        "myriad aspects",
                        "myriad causes"
                    ],
                    "target_lang_definitions": {
                        "de": "Vielschichtig oder mit unzähligen verschiedenen Aspekten versehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "vielfältig",
                                "target_lang_sense_clarification": "in vielen verschiedenen Formen oder Aspekten"
                            },
                            {
                                "target_lang_word": "facettenreich",
                                "target_lang_sense_clarification": "viele verschiedene Seiten oder Aspekte habend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25f760fc-aca4-3482-959a-bd9e2228e6af",
                    "sense_definition": "A vast, indefinitely large number or multitude of things or people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "countless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest is home to a <w>myriad</w> of species that thrive in the rich soil.",
                            "target_lang_translations": {
                                "de": "Der Wald ist die Heimat einer <w>Vielzahl</w> von Arten, die im nährstoffreichen Boden gedeihen."
                            }
                        },
                        {
                            "text": "She faced a <w>myriad</w> of choices when deciding her future career path.",
                            "target_lang_translations": {
                                "de": "Sie stand vor einer <w>Vielzahl</w> von Möglichkeiten, als sie über ihren zukünftigen Karriereweg entschied."
                            }
                        }
                    ],
                    "synonyms": [
                        "plethora",
                        "wealth"
                    ],
                    "common_phrases": [
                        "a myriad of"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine riesige, unbestimmte Menge von Dingen oder Personen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Vielzahl",
                                "target_lang_sense_clarification": "große Menge von Dingen oder Lebewesen"
                            },
                            {
                                "target_lang_word": "Unmenge",
                                "target_lang_sense_clarification": "sehr große, oft als übermäßig empfundene Menge"
                            },
                            {
                                "target_lang_word": "Unzahl",
                                "target_lang_sense_clarification": "eine besonders große, nicht genau bestimmbare Menge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edf1a101-7a9d-35c9-8fe6-24946f24c1eb",
                    "sense_definition": "The exact number of ten thousand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ten_thousand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In historical texts, a single <w>myriad</w> referred precisely to ten thousand soldiers.",
                            "target_lang_translations": {
                                "de": "In historischen Texten bezog sich eine einzelne <w>Myriade</w> genau auf zehntausend Soldaten."
                            }
                        },
                        {
                            "text": "The army was counted by <w>myriads</w> rather than thousands.",
                            "target_lang_translations": {
                                "de": "Die Armee wurde in <w>Myriaden</w> statt in Tausenden gezählt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historically used to mean 10,000"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die exakte Zahl zehntausend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Myriade",
                                "target_lang_sense_clarification": "historisch für den Wert zehntausend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}