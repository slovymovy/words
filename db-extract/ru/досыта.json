        "ru-extract.jsonl": [
            {
                "entry_id": "4f9bba15-1897-31d5-bbd1-0532ef2c70f4",
                "word": "досыта",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ffc6bee6-15b1-3495-a533-192b2064c4be",
                        "entry_id": "4f9bba15-1897-31d5-bbd1-0532ef2c70f4",
                        "glosses": [
                            "разг. до насыщения, до сытости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0be80d0-d4b9-4f94-a75d-83790b0dccf1",
                                "sense_id": "ffc6bee6-15b1-3495-a533-192b2064c4be",
                                "text": "Социальная служба старается отвлечь их от повседневных проблем, вкусно и досыта накормить, дать тепло и надежду."
                            },
                            {
                                "example_id": "375dcd30-5e4b-4b29-aa50-8e5aca8a18a7",
                                "sense_id": "ffc6bee6-15b1-3495-a533-192b2064c4be",
                                "text": "Папа, мама и я наедались пайком Катиного брата почти досыта, только кое-что приходилось прикупать в гастрономе, находившемся в том же доме, где мы жили."
                            }
                        ]
                    },
                    {
                        "sense_id": "25738823-449d-320d-b0c8-54c73b0ec2ec",
                        "entry_id": "4f9bba15-1897-31d5-bbd1-0532ef2c70f4",
                        "glosses": [
                            "перен., разг. вдоволь, до отвала"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd8d181e-1601-4619-8ea4-784e449084cb",
                                "sense_id": "25738823-449d-320d-b0c8-54c73b0ec2ec",
                                "text": "Сейчас досыта набегаться с ребятами — вот сладость жизни, и она от него никуда не уйдёт."
                            },
                            {
                                "example_id": "f3a46018-a70e-4d5e-b009-e89f0c8cb8bb",
                                "sense_id": "25738823-449d-320d-b0c8-54c73b0ec2ec",
                                "text": "Евдокия обычно не снисходила до разговора с истопником, а потому два мужика вполне могли наговориться досыта."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "756a16cb-9ec3-4436-85fc-ed688dce6db1",
                        "source_entry_id": "4f9bba15-1897-31d5-bbd1-0532ef2c70f4",
                        "target_lang_word": "to one's heart's content",
                        "target_lang_code": "en",
