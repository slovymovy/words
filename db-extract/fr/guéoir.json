                "senses": [
                    {
                        "sense_id": "8848cd66-c272-3b35-a799-5f8f7470493c",
                        "entry_id": "ee76d71d-9859-3d23-967e-92c5a4ec8ea7",
                        "glosses": [
                            "Sorte de point d’eau, dans lequel on accède par une pente légère, et qui était destinée à l'abreuvement et au délassement des chevaux."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b2f6f882-5883-46d9-a52c-92e428b73d93",
                                "sense_id": "8848cd66-c272-3b35-a799-5f8f7470493c",
                                "text": "Les oies et les canards se dandinent jusqu'aux ruisseaux d'en bas qui débordent au guéoir. Cette sorte de piscine où l'entrée et la sortie sont en pente douce sert à baigner les chevaux."
                            },
                            {
                                "example_id": "67b3ad11-6fb1-42d0-8d74-2d8b3f6905db",
                                "sense_id": "8848cd66-c272-3b35-a799-5f8f7470493c",
                                "text": "Le pédiluve est appelé dans la région « guéoir » ou « égayoir » : il s'agit d'un emplacement pavé descendant en pente douce de la rive jusque dans le lit de la rivière […]."
                            },
                            {
                                "example_id": "1dabdbc4-49bc-4bf9-af5e-c7360d058ca8",
                                "sense_id": "8848cd66-c272-3b35-a799-5f8f7470493c",
                                "text": "Art. VIII. La Société exécutera l'engagement qu'elle a pris avec le conseil municipal de Bouxwiller, le 4 février 1827, relativement à la construction d'un nouveau guéoir ou abreuvoir."
                            }
                        ]
                    }
