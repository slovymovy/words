                        "s'affronter en finale"
                    ]
                },
                {
                    "sense_id": "829fb021-10f7-30af-9c1d-f15a812d01bd",
                    "sense_definition": "Mettre en contact face à face ou bout à bout deux éléments pour les assembler.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien doit <w>affronter</w> les bords de la plaie avant de poser les points de suture."
                        },
                        {
                            "text": "L'artisan prend soin d'<w>affronter</w> les deux pièces de bois pour assurer un joint parfait."
