                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5cb2ba7-1325-4fe2-86ce-5281950d33b2",
                                                "sense_id": "6a0e4b75-4531-36b7-bc92-51c0b13d562a",
                                                "text": "Due to inflation, the monthly gym fee is rising by 10% from January."
                                            }
                                        ]
                                    },
