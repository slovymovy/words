                "translations": [
                    {
                        "translation_id": "c7870745-8a2f-41a3-bc62-54def9567a5c",
                        "source_entry_id": "25a25308-f041-330f-a4e4-2cc940654c0f",
                        "source_sense_id": "bc0333c3-0d18-3095-b28c-a2423594d911",
                        "source_sense_description": "kunstmatige behuizing waarbinnen een bijenvolk zijn raten kan bouwen, oorspronkelijk in de vorm van een gevlochten korf",
                        "target_lang_word": "Bienenkorb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bienenkorb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb3d4273-2092-3069-a2a2-b77fce0c5d4b",
                                        "entry_id": "f2a1bed8-95fa-3862-b581-206cbdbd8e11",
                                        "glosses": [
                                            "künstliche Behausung für ein Volk von Honigbienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f98233f-971d-4529-9787-55e2ae36364e",
                                                "sense_id": "fb3d4273-2092-3069-a2a2-b77fce0c5d4b",
                                                "text": "Der Bienenkorb dient der westlichen Honigbiene als künstliche Behausung."
                                            },
                                            {
                                                "example_id": "00432fba-b998-4057-8d44-80d963bdbbc8",
                                                "sense_id": "fb3d4273-2092-3069-a2a2-b77fce0c5d4b",
                                                "text": "„Sie fanden neben den Bienenkörben ein Beet mit Karotten, die zwar klein waren, aber doch erfrischten.“"
                                            },
                                            {
                                                "example_id": "a6200cdf-5ce2-46af-9a24-0b354db0cce8",
                                                "sense_id": "fb3d4273-2092-3069-a2a2-b77fce0c5d4b",
                                                "text": "„Nach kurzer Zeit standen die Türme da wie riesige Bienenkörbe voll Licht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c51a464-f0c6-4761-b380-0a3a2c48bb4d",
                        "source_entry_id": "25a25308-f041-330f-a4e4-2cc940654c0f",
                        "source_sense_id": "bc0333c3-0d18-3095-b28c-a2423594d911",
                        "source_sense_description": "kunstmatige behuizing waarbinnen een bijenvolk zijn raten kan bouwen, oorspronkelijk in de vorm van een gevlochten korf",
                        "target_lang_word": "beehive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beehive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "213a7f4d-5475-3e98-833d-474e7be4b26a",
                                        "entry_id": "b218ac43-1cc3-3d89-b150-dc3b9782bc09",
                                        "glosses": [
                                            "A sheltered place where bees, usually honey bees (genus Apis), live.",
                                            "Such a home prepared by the bees themselves, in which some species of honey bees live and raise their young."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa7e91e0-2541-305f-a204-aed1176d81a4",
                                        "entry_id": "b218ac43-1cc3-3d89-b150-dc3b9782bc09",
                                        "glosses": [
                                            "A sheltered place where bees, usually honey bees (genus Apis), live.",
                                            "A man-made structure in which honey bees are kept so that humans can harvest their honey."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf167f7b-bb8a-34a3-ae6c-c23194ffcc5f",
                                        "entry_id": "b218ac43-1cc3-3d89-b150-dc3b9782bc09",
                                        "glosses": [
                                            "Any place full of activity, or in which people are very busy."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7c92e60-1064-369d-a16e-113b28eabc6b",
                                        "entry_id": "b218ac43-1cc3-3d89-b150-dc3b9782bc09",
                                        "glosses": [
                                            "A women's hairstyle, popular in the 1960s, in which long hair is styled into a hive-shaped form on top of the head and usually held in place with lacquer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63ab3893-293c-3126-a6a5-df76a18423e5",
                                        "entry_id": "b218ac43-1cc3-3d89-b150-dc3b9782bc09",
                                        "glosses": [
                                            "A particular style of hat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0ced2fa-de8c-438b-b1be-93292c66978e",
                                                "sense_id": "63ab3893-293c-3126-a6a5-df76a18423e5",
                                                "text": "A very neat old woman, still in her good outdoor coat and best beehive hat, was sitting at a polished mahogany table on whose surface there were several scored scratches so deep that a triangular piece of the veneer had come cleanly away,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d5e9c41-16ee-3f8f-a0b6-0639c09830a4",
                                        "entry_id": "b218ac43-1cc3-3d89-b150-dc3b9782bc09",
                                        "glosses": [
                                            "A type of anti-personnel ammunition round containing flechettes, and characterised by the buzzing sound made as they fly through the air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25fee3b4-4619-47ab-858f-ecc2c51a58bd",
                                                "sense_id": "5d5e9c41-16ee-3f8f-a0b6-0639c09830a4",
                                                "text": "By the time it was over, Stone had been blown thirty feet through the air by a beehive round as he was running across a field, knocked out by the concussion of the blast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "737302b3-72fa-35e8-90a2-f7709554aa31",
                                        "entry_id": "b218ac43-1cc3-3d89-b150-dc3b9782bc09",
                                        "glosses": [
                                            "Alternative form of Beehive."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "alt-of",
                                            "alternative",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0b5950e-28c0-47fe-8fbf-986e5a6e18df",
                                                "sense_id": "737302b3-72fa-35e8-90a2-f7709554aa31",
                                                "text": "Brian Small said that the Minister could not 'hide in the beehive any longer'"
                                            },
                                            {
                                                "example_id": "e0e62ed0-133e-4e29-8f2f-edd2d059ca56",
                                                "sense_id": "737302b3-72fa-35e8-90a2-f7709554aa31",
                                                "text": "In New Zealand, this approach is taken one step forward in that Ministers physically sit together up in the beehive, as their building is known, rather than being based in the Departments."
                                            },
                                            {
                                                "example_id": "0dffe7c0-e3f8-4e9e-a6fb-bd466513fe20",
                                                "sense_id": "737302b3-72fa-35e8-90a2-f7709554aa31",
                                                "text": "As with other major buildings the beehive demonstrated the need for a standardized building drawing practice which could be applied — and understood"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12fa206f-2a2c-3cb8-accb-39d703fc4a31",
                                        "entry_id": "b218ac43-1cc3-3d89-b150-dc3b9782bc09",
                                        "glosses": [
                                            "In Conway's Game of Life, a particular still life pattern with a rounded appearance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6714a1b8-823e-447b-b5d6-cd6955e722fc",
                                                "sense_id": "12fa206f-2a2c-3cb8-accb-39d703fc4a31",
                                                "text": "By the way, what happens to a beehive which is under attack by one or two gliders such as pictured:"
                                            },
                                            {
                                                "example_id": "dfad2233-b4b8-4e8e-a96d-a96f6fb86daf",
                                                "sense_id": "12fa206f-2a2c-3cb8-accb-39d703fc4a31",
                                                "text": "Alternatively, in many cases the debris can be suppressed by perturbing the debris with a passing spaceship before it stabilizes into the beehive or loaf."
                                            },
                                            {
                                                "example_id": "0cfc4506-190e-40a4-a5f1-3bc9ec2ceb69",
                                                "sense_id": "12fa206f-2a2c-3cb8-accb-39d703fc4a31",
                                                "text": "Unfortunately, a beehive (a common six cell still life) was also created close to the block, and its position made it impossible to eliminate with conventional methods using still lifes (anything placed to destroy it would be damaged by earlier activity)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0a91b08-13a7-32e3-a2e4-9cbf510f210e",
                                        "entry_id": "b218ac43-1cc3-3d89-b150-dc3b9782bc09",
                                        "glosses": [
                                            "A diagram showing where balls have passed the batter, used in analysis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "beehive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89dd87cc-00e7-3261-a8cc-9e307e943c17",
                                        "entry_id": "5ca5cf30-f4a5-3689-b88c-6c84cd9e4c49",
                                        "glosses": [
                                            "To fill (a place) with busy activity."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21d8d35e-2690-4ba3-8705-a5608fcf8554",
                                                "sense_id": "89dd87cc-00e7-3261-a8cc-9e307e943c17",
                                                "text": "Quite naturally, if there are more ministers swarming the cabinet rooms and conference halls, then there will be a spate of civil servants beehiving the secretariat."
                                            },
                                            {
                                                "example_id": "90cbbfdf-eb4a-4c7c-bc1a-2241ae8e2f2d",
                                                "sense_id": "89dd87cc-00e7-3261-a8cc-9e307e943c17",
                                                "text": "The patrons beehiving the place whooped and shouted."
                                            },
                                            {
                                                "example_id": "7bc350ef-e909-427f-baaf-3984dbf9c391",
                                                "sense_id": "89dd87cc-00e7-3261-a8cc-9e307e943c17",
                                                "text": "This is not the first time that I learnt of a neighbor's death after a lapse of a few weeks. You just don't see people beehiving a home, like in India […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73141ae1-fab7-3991-b605-4c2ee0d78a34",
                                        "entry_id": "5ca5cf30-f4a5-3689-b88c-6c84cd9e4c49",
                                        "glosses": [
                                            "To style the hair in a hive-shaped or bouffant form."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6ccafce-3e45-40c3-ba11-88cc04019b36",
                        "source_entry_id": "25a25308-f041-330f-a4e4-2cc940654c0f",
