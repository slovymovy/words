                                        "sense_id": "bfc3d63d-676a-3069-8b84-b375945c7023",
                                        "entry_id": "4101fddc-e94d-30f5-9dfa-d0ba2ad4a633",
                                        "glosses": [
                                            "Personne ayant une très bonne vision."
                                        ],
                                        "tags": [
                                            "Par analogie avec l’animal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8201bd85-8137-4c74-bc45-5e73cea7ed3c",
                                                "sense_id": "bfc3d63d-676a-3069-8b84-b375945c7023",
                                                "text": "Un fantassin s’enlisa dans la boue. Ce n’est que bien plus tard que l’on s’aperçut de sa disparition. Le meilleur tireur de la compagnie ! Un œil de chat !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53d7dbaf-d47f-3288-8284-2ea3cca0168d",
                                        "entry_id": "4101fddc-e94d-30f5-9dfa-d0ba2ad4a633",
                                        "glosses": [
                                            "Appellation vernaculaire ancienne d’une herbe qui correspondrait à l’antirrhinon grec, et l’antirrhinum latin. → Voir genre botanique moderne Antirrhinum"
