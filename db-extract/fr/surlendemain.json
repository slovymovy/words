        "fr-extract.jsonl": [
            {
                "entry_id": "06e9b137-2f01-3eb2-a4ac-91843777c0d4",
                "word": "surlendemain",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2b63726f-9f5a-44bb-8848-59cd37db3461",
                        "entry_id": "06e9b137-2f01-3eb2-a4ac-91843777c0d4",
                        "tags": [
                            "plural"
                        ],
                        "form": "surlendemains"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5007be10-eced-3578-af11-c2dd5e0c0e69",
                        "entry_id": "06e9b137-2f01-3eb2-a4ac-91843777c0d4",
                        "glosses": [
                            "Jour qui suit le lendemain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9277096b-672f-4f2b-b853-23751af64cb2",
                                "sense_id": "5007be10-eced-3578-af11-c2dd5e0c0e69",
                                "text": "Ce dimanche était le treizième de l'année 1813. Le surlendemain, Napoléon partait pour cette fatale campagne pendant laquelle il allait perdre successivement Bessières et Duroc, […]."
                            },
                            {
                                "example_id": "cf411e3b-dfc1-4edd-a506-eed40207bb7b",
                                "sense_id": "5007be10-eced-3578-af11-c2dd5e0c0e69",
                                "text": "Je déjeunais à l’Élysée le surlendemain de la chute du ministère."
                            },
                            {
                                "example_id": "61723f63-aad1-4ad2-b6b0-4981b813154a",
                                "sense_id": "5007be10-eced-3578-af11-c2dd5e0c0e69",
                                "text": "Jim et Jimmy, qui devaient débuter le surlendemain à Genève, avaient craint qu’on ne les empêchât de partir."
                            },
                            {
                                "example_id": "5cd43cb8-216e-4214-9cdb-e95cab934791",
                                "sense_id": "5007be10-eced-3578-af11-c2dd5e0c0e69",
                                "text": "Le surlendemain au petit jour, je passai en vue du cap de Mala […]."
                            },
                            {
                                "example_id": "e7e1fb0a-42f1-4e19-820e-940c01210f53",
                                "sense_id": "5007be10-eced-3578-af11-c2dd5e0c0e69",
                                "text": "Je vérifiai mon révolver et bouclai mes cantines avec la quasi-certitude que le surlendemain nous servirions de pâture aux corbeaux du Saïs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ca9a35b-b840-40b8-8bbc-2c0c4aad15b2",
                        "source_entry_id": "06e9b137-2f01-3eb2-a4ac-91843777c0d4",
                        "source_sense_id": "5007be10-eced-3578-af11-c2dd5e0c0e69",
                        "target_lang_word": "Übermorgen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f31d51b2-b9ca-410a-b7ba-61b87e5c5497",
                        "source_entry_id": "06e9b137-2f01-3eb2-a4ac-91843777c0d4",
                        "source_sense_id": "5007be10-eced-3578-af11-c2dd5e0c0e69",
                        "target_lang_word": "overmorrow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overmorrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "999c1833-aa48-3bbd-9873-c7932180a90e",
                                        "entry_id": "fa6ee2f1-94d0-398d-a828-8d17b051c087",
                                        "glosses": [
                                            "On the day after tomorrow."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fac397f1-4895-4f1a-b19d-3e8793524d27",
                                                "sense_id": "999c1833-aa48-3bbd-9873-c7932180a90e",
                                                "text": "Thẽ [then] ſpake Tobias vnto the virgin, and ſayde: Vp Sara, let vs make oure prayer vnto God to daye, tomorow, and ouermorow: for theſe thre nightes wil we reconcyle oure ſelues with God: and whan the thirde holy night is paſt, we ſhall ioyne together in yͤ deutye of mariage.",
                                                "translation": "Then spake Tobias unto the virgin, and said: Up Sara, let us make our prayer unto God today, tomorrow, and overmorrow: for these three nights will we reconcile ourselves with God, and when the third holy night is past, we shall join together in the duty of marriage.",
                                                "english": "Then spake Tobias unto the virgin, and said: Up Sara, let us make our prayer unto God today, tomorrow, and overmorrow: for these three nights will we reconcile ourselves with God, and when the third holy night is past, we shall join together in the duty of marriage."
                                            },
                                            {
                                                "example_id": "7f4d45ec-af28-44c5-8587-184f5ddd3223",
                                                "sense_id": "999c1833-aa48-3bbd-9873-c7932180a90e",
                                                "text": "\"Yes, I will come, but it will take a few more days to clear up Delegation business. Can I follow you on Wednesday? Yours, [Arthur] McManus.\" / \"We can go not overmorrow, but on Thursday.\""
                                            },
                                            {
                                                "example_id": "f27620ca-9f9b-430f-81b4-e9eeb83ada23",
                                                "sense_id": "999c1833-aa48-3bbd-9873-c7932180a90e",
                                                "text": "Sinowjeff and myself go to Caucasus overmorrow. Will you with us? Wi kan not understand as necessary differences in the english party without the language. […] Excuse my for this analphabetical letter, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overmorrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e906f8f6-5bd7-3c97-acb6-503207fadd2c",
                                        "entry_id": "63c1057d-dbe2-3bd8-ac18-a4cda8c9c799",
                                        "glosses": [
                                            "The day after tomorrow."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12c63ea3-4ad0-4288-bc09-cdd0536c5a2a",
                                                "sense_id": "e906f8f6-5bd7-3c97-acb6-503207fadd2c",
                                                "text": "My members borrow / A thrill from wild Walpurgis-night: / It comes round on the overmorrow— / Then why we wake we know aright."
                                            },
                                            {
                                                "example_id": "b068eb57-bc97-4d6b-bc6b-f348fc7d6a98",
                                                "sense_id": "e906f8f6-5bd7-3c97-acb6-503207fadd2c",
                                                "text": "She's been missing for days and now Ēostre is on the overmorrow."
                                            },
                                            {
                                                "example_id": "b0bc7966-ab25-4a4e-bfbc-656a1d03b246",
                                                "sense_id": "e906f8f6-5bd7-3c97-acb6-503207fadd2c",
                                                "text": "The gesith demands an audience with the new thegn-heir, by over-morrow. If this does not happen, the gesith of Katla has decreed his place and its inhabitants be seen as invaders and dealt with as such."
                                            },
                                            {
                                                "example_id": "5e81e018-b9b5-4d34-8c3d-ba799ee1b3b5",
                                                "sense_id": "e906f8f6-5bd7-3c97-acb6-503207fadd2c",
                                                "text": "The lifeguards were mainly Aussies, rough drinkers who delighted in foul-mouthed utterings sprinkled with Aussie slang. They played up to this idea of the bronzed, grizzled, Aussie boozers who treated girls badly and were hungover until midday; that's midday on the overmorrow!"
                                            },
                                            {
                                                "example_id": "f45fb027-942c-4615-b687-bc0e27d43337",
                                                "sense_id": "e906f8f6-5bd7-3c97-acb6-503207fadd2c",
                                                "text": "\"There's always a tomorrow … will you be there in it with me?\" His hopeful eyes searched for a yes in them. \"Not just tomorrow-tomorrow but the coming overmorrows and beyond that.\" I smiled hugging him abruptly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overmorrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "075078f6-e0dc-36d8-91c4-2d1dab0edf4c",
                                        "entry_id": "af6db44e-bc54-31ae-b5dd-da20ff46bb56",
                                        "glosses": [
                                            "Of or relating to the day after tomorrow."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0706dbad-d8e3-4ef5-9023-fcfed03ee664",
                                                "sense_id": "075078f6-e0dc-36d8-91c4-2d1dab0edf4c",
                                                "text": "For thou néedeſt not by thy morrowe and ouermorrowe delayes to augment his diſcommoditie ⁊ [and] hinderance any longer, from whom thou haſt by thy ſubtile meanes and wicked violence, wreſted the goodes that he hath, conſidering yͭ [that] he to his loſſe hath lacked them long enough, ⁊ béen without them too too long God wott."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
