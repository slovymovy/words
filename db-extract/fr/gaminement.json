                        "glosses": [
                            "D'une manière gamine ; comme par gaminerie."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4e0536be-644a-4f61-851c-71d37a218988",
                                "sense_id": "b1e6550a-0a3d-377d-9d6a-641c4dad04fc",
                                "text": "Son « tu » me froissa un peu. Mais je lui répondis gaminement : « Tu trouves que j'ai engraissé ! » Il partit d'un fou rire. Et, à partir de ce jour, nous nous tutoyâmes et nous devînmes les meilleurs amis du monde."
                            },
                            {
                                "example_id": "8ec944fb-eb08-45aa-bef0-1dd0045b2fb6",
                                "sense_id": "b1e6550a-0a3d-377d-9d6a-641c4dad04fc",
                                "text": "[…], Lestrange, procédant au rite habituel, fit mine d'enlever le béret, piqué d'une rose, dont Aïssa avait, ce jour-là, gaminement coiffé ses lourds cheveux..."
                            }
                        ]
                    }
