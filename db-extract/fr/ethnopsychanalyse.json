                        "glosses": [
                            "Application des outils de la psychanalyse à des matériaux anthropologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47f2b0a3-afa0-49fb-a7b7-7c18c0570074",
                                "sense_id": "04a67be5-495d-3a79-94b7-3d5515409f09",
                                "text": "L’ethnopsychanalyse se situe dans une nébuleuse où gravitent dans des orbites croisées l’ethnopsychiatrie, la psychanalyse, l’anthropologie culturelle, le culturalisme, la psychologie des peuples, la psychiatrie transculturelle, l’anthropologie psychanalytique, voire l’ethnomédecine."
                            },
                            {
                                "example_id": "ec3a14f0-fab5-45e1-9a75-ebbd27c2c44c",
                                "sense_id": "04a67be5-495d-3a79-94b7-3d5515409f09",
                                "text": "L’'ethnopsychanalyse, dans le champ de laquelle s’inscrit cet ouvrage, combine, comme son nom l’indique, l’ethnologie et la psychanalyse, deux disciplines dont la complémentarité a été longtemps controversée et reste encore loin d’être reconnue par les chercheurs."
                            }
                        ]
                    }
