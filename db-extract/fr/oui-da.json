        "fr-extract.jsonl": [
            {
                "entry_id": "6c447f9b-07fc-3ff7-8b40-01756c83a8a7",
                "word": "oui-da",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cb4b8d58-33e6-46b0-88cf-eaaa0ba3a9bf",
                        "entry_id": "6c447f9b-07fc-3ff7-8b40-01756c83a8a7",
                        "tags": [],
                        "form": "oui da"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12557a16-f1a1-35de-aa22-454c5d04e70c",
                        "entry_id": "6c447f9b-07fc-3ff7-8b40-01756c83a8a7",
                        "glosses": [
                            "Oui, bien sûr, c’est ça."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8db9ef46-c707-48fb-bc3d-8062691228d3",
                                "sense_id": "12557a16-f1a1-35de-aa22-454c5d04e70c",
                                "text": "Un jour qu’elle était à cette fontaine, il vint à elle une pauvre femme qui la pria de lui donner à boire. — Oui-da, ma bonne mère, dit cette belle fille."
                            },
                            {
                                "example_id": "c10dd3dd-acb6-4090-b6d1-376eb8c7b0f7",
                                "sense_id": "12557a16-f1a1-35de-aa22-454c5d04e70c",
                                "text": "— Oui-da ! s’écria-t-il en voyant sir Arthur, un tête-à-tête nocturne avec ma sœur !"
                            },
                            {
                                "example_id": "8c8c077f-7fcd-43f9-8367-596fe398599b",
                                "sense_id": "12557a16-f1a1-35de-aa22-454c5d04e70c",
                                "text": "Angèle, descendant. — Oui-da ! Ah ! çà ! dis-moi donc ? Est-ce que ça va durer longtemps cette comédie que tu me joues depuis une heure ?"
                            },
                            {
                                "example_id": "df90899d-1525-4d56-8e54-9fdf68f8afae",
                                "sense_id": "12557a16-f1a1-35de-aa22-454c5d04e70c",
                                "text": "— Oui-da, acquiesça le plus âgé des manants. Il faut qu’on finisse notre affaire, le temps file."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70f9c7aa-65ea-4242-b6c7-08c5e33894bb",
                        "source_entry_id": "6c447f9b-07fc-3ff7-8b40-01756c83a8a7",
                        "source_sense_id": "12557a16-f1a1-35de-aa22-454c5d04e70c",
                        "target_lang_word": "jawohl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jawohl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                        "entry_id": "c0ca7df8-de46-3bca-8be4-e3bc5725239e",
                                        "glosses": [
                                            "gibt eine positive Antwort auf eine Entscheidungsfrage; drückt Bekräftigung, Zustimmung aus"
                                        ],
                                        "tags": [
                                            "verstärkend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5468581f-8a42-46c4-a579-4359122ff07d",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "Jawohl, Herr Major!"
                                            },
                                            {
                                                "example_id": "23e520e0-e9d0-4038-91b6-2c1bd28a6dfd",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Krämer, von Reineboth im Rücken angesprochen, drehte sich zu diesem um, antwortete: «Jawohl.»“"
                                            },
                                            {
                                                "example_id": "35cd9598-2f84-4535-a817-717364ccce1d",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Ich hielt sie am Arm, die junge Person, die meine Tochter hätte sein können, beziehungsweise am Handgelenk; ich sagte ihr (natürlich zum Spaß!) mit erhobenem Finger, sie habe mich zu diesem Flug gezwungen, jawohl, niemand anders als sie - sie sagte: ‚there is no danger, Sir, no danger at all. We’re going to land in Mexico-City in about one hour and twenty minutes‘.“"
                                            },
                                            {
                                                "example_id": "43e4710a-9bb7-4e63-8245-cae66801ca30",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Jawohl war die Trennung bis zum November abgemacht; sie selbst hatte darauf bestanden, damit auch sie Opfer vorzuweisen hatte.“"
                                            },
                                            {
                                                "example_id": "affae6e1-68ba-4f40-82ea-6737909470ac",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Jawohl, ihr habt recht gehört, die Großtante raucht; sie raucht eine für eine Heilige ziemlich unheilige Baumelpfeife mit geschnitztem Holzkopf.“"
                                            },
                                            {
                                                "example_id": "c9e2e381-c907-4b37-b5f8-715a2becb7cc",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Stieß man ihn so hinaus, hatte auch er keinerlei Verpflichtung, er konnte sich fallenlassen, wohin er wollte, jawohl, und die sollten seinen Stürzen noch einmal schaudernd zuschauen, dann würden sie es vielleicht bereuen, ihn nicht aufgenommen zu haben.“"
                                            },
                                            {
                                                "example_id": "0af68453-1b46-493e-9780-246b06f0cafb",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Hatte sie recht? Jawohl, es kommt vor, daß Blinddarmentzündungen durch Fremdkörper hervorgerufen werden, die sich im Appendix festgesetzt haben.“"
                                            },
                                            {
                                                "example_id": "d4a8b553-e11a-4568-8398-8139b0e13977",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Jawohl bin ich ungerecht.“"
                                            },
                                            {
                                                "example_id": "5ce5d60d-9f62-4e51-ab9f-c3566dea7c55",
                                                "sense_id": "7e2c9934-5b03-3877-8bff-efdb09faec7d",
                                                "text": "„Kann ein US-Magazin in Australien für Verleumdung verurteilt werden, wenn es auf seiner Webseite Unwahrheiten über einen Australier verbreitet? Jawohl, entschied jetzt der oberste australische Gerichtshof.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b90cf237-aca5-426c-8793-c924b4747a85",
                        "source_entry_id": "6c447f9b-07fc-3ff7-8b40-01756c83a8a7",
                        "source_sense_id": "12557a16-f1a1-35de-aa22-454c5d04e70c",
                        "target_lang_word": "of course",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "of course",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cac0daff-dedd-3b6c-81c0-4c7c7b5a6a52",
                                        "entry_id": "c42ffe39-4d2b-315f-8cdd-3cbffe0f6570",
                                        "glosses": [
                                            "In due course; as a matter of course, as a natural result."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a78ee3e-3873-4fbf-bc4d-0ca90ed6fe0e",
                                                "sense_id": "cac0daff-dedd-3b6c-81c0-4c7c7b5a6a52",
                                                "text": "He inspired love and emulation wherever he appeared; envy and jealous rage followed of course; so that he became a very desirable, though a very dangerous acquaintance."
                                            },
                                            {
                                                "example_id": "d672d6eb-a44d-4beb-8dbd-c2330c6786b5",
                                                "sense_id": "cac0daff-dedd-3b6c-81c0-4c7c7b5a6a52",
                                                "text": "Not tarrying long enough in the brain to be subject to reflection, the next sensations, of course, obliterate them."
                                            },
                                            {
                                                "example_id": "27cb1587-3f16-4c45-97a6-740d1e8f6c6c",
                                                "sense_id": "cac0daff-dedd-3b6c-81c0-4c7c7b5a6a52",
                                                "text": "It was at one time made a question whether giving the royal assent to a single bill did not of course put an end to the session."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce6e8dcc-872e-3c76-8d7f-8fedee7dddbe",
                                        "entry_id": "c42ffe39-4d2b-315f-8cdd-3cbffe0f6570",
                                        "glosses": [
                                            "Naturally, as would be expected; for obvious reasons, obviously."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9e956e3-4caa-4b49-8cdc-b872d6063f85",
                                                "sense_id": "ce6e8dcc-872e-3c76-8d7f-8fedee7dddbe",
                                                "text": "Of course I know that!"
                                            },
                                            {
                                                "example_id": "607f6e1b-1e78-447a-8d09-af3f64fcf9fc",
                                                "sense_id": "ce6e8dcc-872e-3c76-8d7f-8fedee7dddbe",
                                                "text": "You will of course surrender all your future rights to the property."
                                            },
                                            {
                                                "example_id": "a278154c-23ef-487a-9003-f4b8be2b8dd3",
                                                "sense_id": "ce6e8dcc-872e-3c76-8d7f-8fedee7dddbe",
                                                "text": "“Heavens!” exclaimed Nina, “the blue-stocking and the fogy!—and yours are pale blue, Eileen!—you’re about as self-conscious as Drina—slumping there with your hair tumbling à la Mérode! Oh, it's very picturesque, of course, but a straight spine and good grooming is better.[…]”"
                                            },
                                            {
                                                "example_id": "e194b264-8fec-4150-b7ea-910be20c54ec",
                                                "sense_id": "ce6e8dcc-872e-3c76-8d7f-8fedee7dddbe",
                                                "text": "We tiptoed into the house, up the stairs and along the hall into the room where the Professor had been spending so much of his time. 'Twas locked, of course, but the Deacon man got a big bunch of keys out of his pocket and commenced to putter with the lock."
                                            },
                                            {
                                                "example_id": "4b6e7f4b-668b-40f3-9acf-d6b5b33d5039",
                                                "sense_id": "ce6e8dcc-872e-3c76-8d7f-8fedee7dddbe",
                                                "text": "There were other flapper-era starlets, of course—Louise Brooks, Greta Garbo—but they were poseurs by comparison."
                                            },
                                            {
                                                "example_id": "86c7f231-3981-4c8b-9542-3941db21f092",
                                                "sense_id": "ce6e8dcc-872e-3c76-8d7f-8fedee7dddbe",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins. For each one there is a frighteningly precise measurement of just how likely it is to jump from the shadows and get you."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "of course",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10de03ea-4830-3936-9ceb-e54cda5713da",
                                        "entry_id": "5ed0b4ec-5153-30e1-9605-f765525b994c",
                                        "glosses": [
                                            "That is part of ordinary behaviour or custom; customary, natural."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08cdb8be-d9d0-4696-ab2e-77426ec86ffa",
                                                "sense_id": "10de03ea-4830-3936-9ceb-e54cda5713da",
                                                "text": "Had Francesca grown up by his side, she would have loved him; and a thousand indulgences, the result of careless good-nature, would have linked the child to the parent, till the mutual affection would have become a thing of course."
                                            },
                                            {
                                                "example_id": "63dfc190-bb8d-43bd-83f3-c351eb67794d",
                                                "sense_id": "10de03ea-4830-3936-9ceb-e54cda5713da",
                                                "text": "I am not using a mere phrase of course, when I say that the feelings with which I bear a part in the ceremony of this day, are such as I find it difficult to utter in words."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "of course",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c0cabfd-8175-3931-811c-36b7db26c929",
                                        "entry_id": "1228b4fa-82f3-3f78-8041-9ba82a848a48",
                                        "glosses": [
                                            "Indicates enthusiastic agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb4106eb-9f8d-4e74-b6dd-05e3cbc63672",
                                                "sense_id": "7c0cabfd-8175-3931-811c-36b7db26c929",
                                                "text": "Will you come with me? — Of course!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f57d90a9-fed9-3934-a9d9-66f55bf6221a",
                                        "entry_id": "1228b4fa-82f3-3f78-8041-9ba82a848a48",
                                        "glosses": [
                                            "Used to acknowledge thanks; ritual reply to “thank you”."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528a1df4-10e1-43aa-95ce-708cf209e80c",
                                                "sense_id": "f57d90a9-fed9-3934-a9d9-66f55bf6221a",
                                                "text": "Thank you! — Of course!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e13b93e1-5986-41d2-966b-4a0983a6a164",
                        "source_entry_id": "6c447f9b-07fc-3ff7-8b40-01756c83a8a7",
                        "source_sense_id": "12557a16-f1a1-35de-aa22-454c5d04e70c",
                        "target_lang_word": "jawel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jawel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f549776d-b06e-3b3c-9bf1-476f15d61b22",
                                        "entry_id": "0b863bbe-8c4e-3c1b-9627-7df2d2215550",
                                        "glosses": [
                                            "ja, antwoordend op een ontkennende vraag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c5b5396-2af4-405b-bbe2-7d368adf385b",
                                                "sense_id": "f549776d-b06e-3b3c-9bf1-476f15d61b22",
                                                "text": "Kom je niet mee vanavond? Jawel, ik kom."
                                            },
                                            {
                                                "example_id": "5f0c4bf9-5d84-41a9-ae99-54e7b917be14",
                                                "sense_id": "f549776d-b06e-3b3c-9bf1-476f15d61b22",
                                                "text": "Maar wat was hij van plan? Ik bracht mijn vinger naar de trekker en bewoog mijn geweer 'O, jawel."
                                            },
                                            {
                                                "example_id": "7b2da859-bddc-4b9e-aa21-eb16ee88a636",
                                                "sense_id": "f549776d-b06e-3b3c-9bf1-476f15d61b22",
                                                "text": "'Pardon?' 'Moeten wij niet met respect behandeld worden?' 'O jawel, natuurlijk jullie ook,' haast hij zich te zeggen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
