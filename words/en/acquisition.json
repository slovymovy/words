                },
                {
                    "sense_id": "ba161b9b-b819-396b-abd3-ed598be9aa5a",
                    "sense_definition": "Something that has been bought, obtained, or gained.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum proudly displayed its latest <w>acquisition</w> in the main gallery.",
