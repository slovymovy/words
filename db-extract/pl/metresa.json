        "pl-extract.jsonl": [
            {
                "entry_id": "c064ee39-6ffd-3446-be26-ed8146e4b540",
                "word": "metresa",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "58ffece3-b6f4-31e4-a0a7-b9eb4e244ea1",
                        "entry_id": "c064ee39-6ffd-3446-be26-ed8146e4b540",
                        "glosses": [
                            "kochanka i utrzymanka, zazwyczaj króla lub magnata"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39a529b1-781d-4a42-9f67-3a12d553103c",
                        "source_entry_id": "c064ee39-6ffd-3446-be26-ed8146e4b540",
                        "source_sense_id": "58ffece3-b6f4-31e4-a0a7-b9eb4e244ea1",
                        "target_lang_word": "Mätresse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mätresse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81f4028d-5ce0-3907-bfd7-4e03673e9ac4",
                                        "entry_id": "574a7a1f-35fe-3ee3-bb8d-ebe42505d525",
                                        "glosses": [
                                            "die meist einflussreiche Geliebte eines Fürsten oder Monarchen"
                                        ],
                                        "tags": [
                                            "16. bis 19. Jahrhundert"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b3524e2-5d35-4bde-8bbb-df3a51080e44",
                                                "sense_id": "81f4028d-5ce0-3907-bfd7-4e03673e9ac4",
                                                "text": "„Die Mätresse des Königs war die wohl einflussreichste Person am französischen Hof des Ancien Régimes.“"
                                            },
                                            {
                                                "example_id": "88dfb1cf-b3b8-4c17-9463-4840ea53ea21",
                                                "sense_id": "81f4028d-5ce0-3907-bfd7-4e03673e9ac4",
                                                "text": "„Nach 1804 hatte Caroline als des Herzogs Mätresse erheblichen Einfluß auf das Weimarer Theatergeschehen.“"
                                            },
                                            {
                                                "example_id": "172827a8-caf6-464b-9fc4-7b584217b6b3",
                                                "sense_id": "81f4028d-5ce0-3907-bfd7-4e03673e9ac4",
                                                "text": "„Bei den ersten Zusammentreffen machte ich einen Kratzfuß und empfahl mich; später aber bat man mich dazubleiben, denn die Fürsten wissen meistens nicht, was sie allein mit ihren Mätressen anfangen sollen.“"
                                            },
                                            {
                                                "example_id": "6fa28312-76d3-4119-8a39-d7758509d413",
                                                "sense_id": "81f4028d-5ce0-3907-bfd7-4e03673e9ac4",
                                                "text": "„Seine Mätresse war damals die Präsidentin de Fleurieu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2aaf35d6-b342-3f3c-8563-98857284a563",
                                        "entry_id": "574a7a1f-35fe-3ee3-bb8d-ebe42505d525",
                                        "glosses": [
                                            "die Geliebte eines verheirateten Mannes"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a78ae892-866b-474d-aaec-95710fe6585b",
                                                "sense_id": "2aaf35d6-b342-3f3c-8563-98857284a563",
                                                "text": "„Sadie ist vor Trauer außer sich und macht einen Skandal, als sie die offizielle Ehefrau und eine weitere Geliebte, von der Clarence zwei Kinder hat, auftauchen sieht, ganz abgesehen von mehreren Mätressen, die alle behaupten, die einzigen zu sein, die ihn je geliebt haben.“"
                                            },
                                            {
                                                "example_id": "f4204b7e-70ff-490d-83e0-517561d67d1e",
                                                "sense_id": "2aaf35d6-b342-3f3c-8563-98857284a563",
                                                "text": "„Die reichen Weißen in den Villen an der Esplanade ließen auf der gegenüberliegenden Seite großzügige Häuser für ihre schwarzen und halbblütigen Mätressen errichten.“"
                                            },
                                            {
                                                "example_id": "e3cf9522-21e1-491f-9504-8fba9d999183",
                                                "sense_id": "2aaf35d6-b342-3f3c-8563-98857284a563",
                                                "text": "„Max wußte, daß er eigentlich nur nach Polen gekommen war, um sich eine Mätresse zuzulegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8641052e-04f3-4eec-9e0d-363679b276e6",
                        "source_entry_id": "c064ee39-6ffd-3446-be26-ed8146e4b540",
                        "source_sense_id": "58ffece3-b6f4-31e4-a0a7-b9eb4e244ea1",
                        "target_lang_word": "метресса",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "метресса",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f47e427d-eb65-3e30-bf3a-b5fd8ccd2606",
                                        "entry_id": "4a56cba8-574e-338e-84cf-66c58ca52e69",
                                        "glosses": [
                                            "устар. любовница"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478614ea-4061-495e-9aa8-8cea7933f605",
                                                "sense_id": "f47e427d-eb65-3e30-bf3a-b5fd8ccd2606",
                                                "text": "Живет он тепло и сытно, а иногда даже имеет на стороне метрессу (по большей части вдову-попадью), которую посещает в сумерки на короткое время."
                                            },
                                            {
                                                "example_id": "5fb47e3d-8b7f-454b-aa44-f49cc23e9f4a",
                                                "sense_id": "f47e427d-eb65-3e30-bf3a-b5fd8ccd2606",
                                                "text": "Наталья была главной героиней, субреткой, плясуньей, певицей и метрессой хозяина."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
