                "senses": [
                    {
                        "sense_id": "b279a94a-b338-3c03-a210-58fa2dc6a6b8",
                        "entry_id": "9a264923-e015-3706-8d5a-856e2d1a7e85",
                        "glosses": [
                            "durch Läuse, Milben, Zecken oder Flöhe übertragene, in Deutschland meldepflichtige Infektionskrankheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4fe6cc3-fa08-4bb7-be0b-207a2664ae03",
                                "sense_id": "b279a94a-b338-3c03-a210-58fa2dc6a6b8",
                                "text": "„Für Napoleons Armee wurde das Fleckfieber während des Russlandfeldzugs zu einem ernsthaften Problem.“"
                            },
                            {
                                "example_id": "733e104e-6ad8-4e43-93fd-c41da038a3db",
                                "sense_id": "b279a94a-b338-3c03-a210-58fa2dc6a6b8",
                                "text": "„Weil Unterkünfte, Kleidung und Verpflegung erbärmlich waren, erkrankten viele Herero an Skorbut, Typhus, Fleckfieber und anderen Krankheiten.“"
                            },
                            {
                                "example_id": "53f9529a-bee4-40d0-b762-8719db582fc2",
                                "sense_id": "b279a94a-b338-3c03-a210-58fa2dc6a6b8",
                                "text": "„In der Türkei an Fleckfieber erkankt und von den Ärzten schon aufgegeben, wurde Wegner nach Deutschland zurückgeschickt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
