{
    "word_family": [
        "moeten",
        "moet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c5ceb86a-55aa-3b20-81df-8c0ac09b4a84",
                    "sense_definition": "iets wat verplicht is of gedaan moet worden, vaak zonder dat men er echt zin in heeft",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verplichting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga vanavond naar die receptie, maar het is eigenlijk een <w>moetje</w> voor mijn werk.",
                            "target_lang_translations": {
                                "en": "I'm going to that reception tonight, but it's actually a <w>must-do</w> for my work."
                            }
                        },
                        {
                            "text": "Vindt u het wel leuk om hier te zijn, of is het een <w>moetje</w>?",
                            "target_lang_translations": {
                                "en": "Are you actually enjoying being here, or is it just an <w>obligation</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "must"
                    ],
                    "common_phrases": [
                        "een sociaal moetje"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik voor een verplichting"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "something that is mandatory or must be done, often without one really wanting to"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "must-do",
                                "target_lang_sense_clarification": "an obligatory task or event"
                            },
                            {
                                "target_lang_word": "chore",
                                "target_lang_sense_clarification": "a tedious but necessary task"
                            },
                            {
                                "target_lang_word": "obligation",
                                "target_lang_sense_clarification": "something one is bound to do"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4555c848-3440-35e2-ad3e-df112b89dbc7",
                    "sense_definition": "een huwelijk dat gesloten wordt omdat de bruid onverwacht zwanger is",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "huwelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger kwam een <w>moetje</w> vaker voor in kleine dorpen dan tegenwoordig.",
                            "target_lang_translations": {
                                "en": "In the past, a <w>shotgun wedding</w> occurred more often in small villages than nowadays."
                            }
                        },
                        {
                            "text": "De geboorte van hun dochter na zeven maanden liet zien dat het een <w>moetje</w> geweest was.",
                            "target_lang_translations": {
                                "en": "The birth of their daughter after seven months showed that it had been a <w>shotgun wedding</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informele term voor een gedwongen huwelijk"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a marriage entered into because the bride is unexpectedly pregnant"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shotgun wedding",
                                "target_lang_sense_clarification": "a marriage forced by pregnancy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4c76169-3927-35d4-a89c-a2a833cae24e",
                    "sense_definition": "verkleinwoord van <w>moe</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "familie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij noemde zijn moeder altijd liefkozend zijn <w>moetje</w>.",
                            "target_lang_translations": {
                                "en": "He always affectionately called his mother his <w>mommy</w>."
                            }
                        },
                        {
                            "text": "Het kleine kind riep om zijn <w>moetje</w> toen hij wakker werd.",
                            "target_lang_translations": {
                                "en": "The little child called for his <w>mommy</w> when he woke up."
                            }
                        }
                    ],
                    "synonyms": [
                        "moesje"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vrij ouderwetse liefkoosnaam"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "diminutive of 'moe' (mother), used as an affectionate term"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mommy",
                                "target_lang_sense_clarification": "affectionate term for mother"
                            },
                            {
                                "target_lang_word": "mummy",
                                "target_lang_sense_clarification": "affectionate term for mother (British)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a99d1976-c3e5-30fe-b426-95bbbe60030c",
                    "sense_definition": "verkleinwoord van <w>moet</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "afdruk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er stond een klein <w>moetje</w> in het papier waar de pen had gedrukt.",
                            "target_lang_translations": {
                                "en": "There was a small <w>mark</w> in the paper where the pen had pressed."
                            }
                        },
                        {
                            "text": "Door de strakke sokken stond er een <w>moetje</w> in zijn huid.",
                            "target_lang_translations": {
                                "en": "Because of the tight socks, there was an <w>imprint</w> in his skin."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "diminutive of 'moet' (dent/mark), referring to a small impression or mark left by pressure"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mark",
                                "target_lang_sense_clarification": "a visible impression on a surface"
                            },
                            {
                                "target_lang_word": "dent",
                                "target_lang_sense_clarification": "a small hollow or mark caused by pressure"
                            },
                            {
                                "target_lang_word": "imprint",
                                "target_lang_sense_clarification": "a mark made by pressing something onto a surface"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}