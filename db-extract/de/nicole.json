                                "target_senses": [
                                    {
                                        "sense_id": "5f1965e2-21b3-3f54-8915-85b7a69efcd9",
                                        "entry_id": "aed6b5cf-e1ed-3323-bdb9-31a8e63d54a0",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43ee6406-effe-49a6-9049-9a8301bb0717",
                                                "sense_id": "5f1965e2-21b3-3f54-8915-85b7a69efcd9",
                                                "text": "Nicola Sturgeon",
                                                "translation": "(name of a Scottish politician)",
                                                "english": "(name of a Scottish politician)"
                                            },
                                            {
                                                "example_id": "b8d46b99-d7fa-4812-9102-41d6831b6c09",
                                                "sense_id": "5f1965e2-21b3-3f54-8915-85b7a69efcd9",
                                                "text": "\"Come in with me, if you like. You can help me to find the child.\" She fumbled in her bag and found a slip of paper. \"Her name is Nicola Anna Magdalene Elisabeth Stephanie Lenke.\" Peter laughed. \"She ought to be easy to find with that lot. What do they call her for short?\""
                                            },
                                            {
                                                "example_id": "101f4928-0fd9-452f-a2c5-052ae05350ad",
                                                "sense_id": "5f1965e2-21b3-3f54-8915-85b7a69efcd9",
                                                "text": "He had never called her by her full name so many times in a row. Usually it was Nicky, or sometimes Nick. But never Nicola. Her full name sounded very ominous coming now from Nathaniel Sheridan's lips."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa95368c-fa85-4858-a53b-ce75a0125165",
                        "source_entry_id": "829b15d5-90d2-3a96-96d5-239b87fecd57",
                        "source_sense_id": "1dddd8a6-253a-3063-b697-4bcdbc1fb5c6",
