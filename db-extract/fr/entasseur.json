                        "glosses": [
                            "Celui qui entasse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b98c205e-95ca-4386-aa29-d2f2e1cdf030",
                                "sense_id": "7c07e799-13c4-3c6e-a356-de58cc465ef5",
                                "text": "C’est un grand entasseur d’autographes."
                            },
                            {
                                "example_id": "f21dcb7b-5e36-4afc-8d31-b2608b8693d4",
                                "sense_id": "7c07e799-13c4-3c6e-a356-de58cc465ef5",
                                "text": "Quel entasseur de figures, de métaphores !"
                            },
                            {
                                "example_id": "cce9f2f2-9a4a-4aef-b6cb-af744e04b19e",
                                "sense_id": "7c07e799-13c4-3c6e-a356-de58cc465ef5",
                                "text": "Ce travail demande au moins quatre ouvriers, un « entasseur », un « déchargeur », deux « hommes à tas »."
                            },
                            {
                                "example_id": "1351842d-d1b2-4048-9ba4-1b3bf2f47ff1",
                                "sense_id": "7c07e799-13c4-3c6e-a356-de58cc465ef5",
                                "text": "Toute sa croyance fanatique aux légendes, aux prodiges venait à son secours. Quoi de plus simple ! Géants, démons, dragons, génies, entasseurs, éventreurs de montagnes avaient fendu, découpé celle-là."
                            }
