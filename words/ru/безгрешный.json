{
    "word_family": [
        "грех",
        "грешник",
        "грешить",
        "безгрешность",
        "безгрешно"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "98afa4b9-76c0-3383-9926-e81f1a63bf58",
                    "sense_definition": "Не совершивший греха, не имеющий за собой религиозных или моральных прегрешений.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sinless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В священных книгах говорится, что среди смертных людей нет абсолютно <w>безгрешных</w>.",
                            "target_lang_translations": {
                                "en": "The sacred texts say that among mortal people, no one is completely <w>sinless</w>."
                            }
                        },
                        {
                            "text": "Монах искренне надеялся сохранить свою душу чистой и <w>безгрешной</w>.",
                            "target_lang_translations": {
                                "en": "The monk sincerely hoped to keep his soul pure and <w>sinless</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "безгрехо́вный"
                    ],
                    "antonyms": [
                        "грешный",
                        "небезгрешный"
                    ],
                    "common_phrases": [
                        "безгрешный человек",
                        "безгрешная душа"
                    ],
                    "target_lang_definitions": {
                        "en": "Having committed no sin; free from religious or moral wrongdoing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sinless",
                                "target_lang_sense_clarification": "free from sin or guilt"
                            },
                            {
                                "target_lang_word": "spotless",
                                "target_lang_sense_clarification": "morally pure and blameless"
                            },
                            {
                                "target_lang_word": "immaculate",
                                "target_lang_sense_clarification": "free from moral blemish"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fe21be5-3ef2-3700-9b9d-785928e6f4ca",
                    "sense_definition": "Не содержащий в себе ничего предосудительного, не вызывающий упрёка или осуждения; безобидный.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "innocent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это была вполне <w>безгрешная</w> шутка, которая никому не причинила вреда.",
                            "target_lang_translations": {
                                "en": "It was quite a <w>harmless</w> joke that hurt no one."
                            }
                        },
                        {
                            "text": "Они вели долгие разговоры на самые обычные и <w>безгрешные</w> темы.",
                            "target_lang_translations": {
                                "en": "They had long conversations on the most ordinary and <w>innocent</w> topics."
                            }
                        }
                    ],
                    "common_phrases": [
                        "безгрешная шутка",
                        "безгрешное занятие"
                    ],
                    "target_lang_definitions": {
                        "en": "Containing nothing objectionable; harmless, inoffensive, or blameless."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "harmless",
                                "target_lang_sense_clarification": "not causing harm or offense"
                            },
                            {
                                "target_lang_word": "innocent",
                                "target_lang_sense_clarification": "inoffensive and benign"
                            },
                            {
                                "target_lang_word": "blameless",
                                "target_lang_sense_clarification": "free from fault or reproach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44ff84b6-0dc8-39e4-8fcb-9e3ddeb6db02",
                    "sense_definition": "Выражающий чистоту, простодушие, детскую наивность и непорочность.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "innocent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ребёнок смотрел на незнакомца с удивительно <w>безгрешным</w> взглядом.",
                            "target_lang_translations": {
                                "en": "The child looked at the stranger with a remarkably <w>innocent</w> gaze."
                            }
                        },
                        {
                            "text": "Её <w>безгрешная</w> улыбка сразу рассеяла все тревоги и сомнения.",
                            "target_lang_translations": {
                                "en": "Her <w>pure</w> smile immediately dispelled all anxieties and doubts."
                            }
                        }
                    ],
                    "common_phrases": [
                        "безгрешный взгляд",
                        "безгрешная улыбка"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing purity, simple-heartedness, childlike naivety, and innocence."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "innocent",
                                "target_lang_sense_clarification": "showing pure naivety and simplicity"
                            },
                            {
                                "target_lang_word": "pure",
                                "target_lang_sense_clarification": "untainted, sincere, and childlike"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}