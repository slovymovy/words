                        "examples": [
                            {
                                "example_id": "4a19e246-6512-429a-9ab0-409e04d5f346",
                                "sense_id": "faaa788c-dc84-309a-bdec-051995cb5b2a",
                                "text": "Jeśli solipsysta nie wierzy w istnienie innych ludzi, po co głosi solipsyzm?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3dbcd7d-386c-4b1f-99a5-6d8f33cbfcb3",
                        "source_entry_id": "ff4dbbaf-38de-3e42-9a9c-eb541cb65f00",
