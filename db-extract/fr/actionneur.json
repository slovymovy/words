            {
                "entry_id": "f73e84df-ddb7-3392-875b-dd31de765caf",
                "word": "actionneur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b094e5e-f6c6-42f8-9f9e-f5fa77b4453c",
                        "entry_id": "f73e84df-ddb7-3392-875b-dd31de765caf",
                        "tags": [
                            "plural"
                        ],
                        "form": "actionneurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2767692a-c729-3b2d-8305-6fb6ebdfa35c",
                        "entry_id": "f73e84df-ddb7-3392-875b-dd31de765caf",
                        "glosses": [
                            "Partie d'une machine qui, recevant un ordre de la partie commande via un éventuel préactionneur, convertit l’énergie qui lui est fournie en une action mécanique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93d11d75-077a-4515-a7d7-6ab24b223d3f",
                                "sense_id": "2767692a-c729-3b2d-8305-6fb6ebdfa35c",
                                "text": "Dans le domaine des microtechnologies, on peut citer les céramiques piézoélectriques, les actionneurs électrostatiques ou magnétostrictifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "af22cd87-18f2-3ec4-84a6-456baee62b48",
                        "entry_id": "f73e84df-ddb7-3392-875b-dd31de765caf",
                        "glosses": [
                            "Dispositif (vérin par exemple) qui permet de réguler le débit et la pression d'un fluide (air, gazole, huile) afin de piloter un autre système dans des conditions particulières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fac7ca47-dc11-45c4-b5d6-c063aa33f1f7",
                                "sense_id": "af22cd87-18f2-3ec4-84a6-456baee62b48",
                                "text": "L’actionneur amortisseur de lacet réalise la fonction d’asservissement de position, en associant comme l’actionneur d’aileron, une servovalve, un vérin linéaire symétrique double tige et un capteur de position intégré à la tige de vérin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3df41c70-bd88-45fb-a6f7-3a96dc6837e3",
                        "source_entry_id": "f73e84df-ddb7-3392-875b-dd31de765caf",
                        "target_lang_word": "Aktor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d07b39d5-3ae2-30d5-88fc-81e8e41be77d",
                                        "entry_id": "fa17beac-f012-39f6-8671-72d6109e1d70",
                                        "glosses": [
                                            "ein Element, das eine Eingangsgröße in eine andersartige Ausgangsgröße umwandelt, um einen gewünschten Effekt hervorzurufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2215764-0fec-47b6-95de-a4ffbdf6fa6d",
                                                "sense_id": "d07b39d5-3ae2-30d5-88fc-81e8e41be77d",
                                                "text": "„Während Sensoren eine physikalische Größe in elektrischen Strom umwandeln, machen Aktoren oder Aktuatoren genau das Gegenteil und wandeln Strom in eine andere Energieform um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e53c9ef-df60-34e5-8bff-e82ae02d4ca1",
                                        "entry_id": "fa17beac-f012-39f6-8671-72d6109e1d70",
                                        "glosses": [
                                            "Urheber einer (sozialen) Handlung"
                                        ],
                                        "tags": [
                                            "Sozialwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a311f4be-e3f3-42cc-b9b3-6a314a32b74b",
                                                "sense_id": "9e53c9ef-df60-34e5-8bff-e82ae02d4ca1",
                                                "text": "„Ein Aktor handelt strategisch, wenn er auf etwas in der objektiven Welt Bezug nimmt, dabei aber die Erwartungen und Entscheidungen von anderen Aktoren in seinem egozentrischen Handlungskalkül berücksichtigen muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86b22eaf-e39b-44c0-920b-9cf6f61c2288",
                        "source_entry_id": "f73e84df-ddb7-3392-875b-dd31de765caf",
                        "target_lang_word": "actuator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actuator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9eda2883-958f-347b-aaf4-6db8600adf5b",
                                        "entry_id": "645951d4-84b2-3f0d-962a-c5c958b7afc3",
                                        "glosses": [
                                            "Something that actuates something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67ee86c6-f7ec-4192-b06e-4d7de62a6d13",
                                                "sense_id": "9eda2883-958f-347b-aaf4-6db8600adf5b",
                                                "text": "The mind is the actuator of the body."
                                            },
                                            {
                                                "example_id": "c149e60f-fa42-4858-a0f0-dbd2ea89c8cb",
                                                "sense_id": "9eda2883-958f-347b-aaf4-6db8600adf5b",
                                                "text": "[…] and God is the Author and Actuator of nature, as well as of grace; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bf04df8-50f1-338d-a006-335bd2917f50",
                                        "entry_id": "645951d4-84b2-3f0d-962a-c5c958b7afc3",
                                        "glosses": [
                                            "A usually electric device that causes a mechanical device (i.e., a mechanism) to be switched on or off. For example; an electric motor that opens and closes a valve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c1266d1-d01e-3b1f-b279-26852045255e",
                                        "entry_id": "645951d4-84b2-3f0d-962a-c5c958b7afc3",
                                        "glosses": [
                                            "The mechanism that moves the head assembly on a disk drive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47625277-d91f-34f6-adf3-b7fe1aeca9cf",
                                        "entry_id": "645951d4-84b2-3f0d-962a-c5c958b7afc3",
                                        "glosses": [
                                            "A relay that controls the flow of electricity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
