                "senses": [
                    {
                        "sense_id": "149e40e1-beaa-3600-ad43-7c7f03113845",
                        "entry_id": "6deae50b-8574-3f9b-9a90-e864f11be48d",
                        "glosses": [
                            "lijdend aan autisme"
