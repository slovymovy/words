                                "example_id": "cbfd1231-8542-4046-bd12-a6e10784ffc0",
                                "sense_id": "994aec67-5012-30ee-8232-8e08d12a8777",
                                "text": "Он поймал щурёнка длиной со столовый нож и трёх ершей."
                            }
                        ]
                    },
                    {
                        "sense_id": "773eadcf-e238-3285-8d70-3c21d1dec327",
