                                "target_senses": [
                                    {
                                        "sense_id": "81c9319e-c5ec-3640-95f1-de9269c44010",
                                        "entry_id": "6d446886-2075-3c47-9308-94cd4234c257",
                                        "glosses": [
                                            "In a cyclic manner; in cycles; periodically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e80302f-3f03-4cfc-98f4-411dc3c717ee",
                                                "sense_id": "81c9319e-c5ec-3640-95f1-de9269c44010",
                                                "text": "The exhibits, moreover, reject the supposedly Eurocentric notion of historical development. “Things are looked at very cyclically, not in a linear way,” one curator told The Washington Post."
                                            },
                                            {
                                                "example_id": "c7fc2222-5d3e-4897-809c-8fcbb0e4dd8a",
                                                "sense_id": "81c9319e-c5ec-3640-95f1-de9269c44010",
                                                "text": "El Niño, a temperature change in the Pacific ocean that happens cyclically, may have begun interacting with the long-term process of global warming, with catastrophic results."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
