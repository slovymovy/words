{
    "word_family": [
        "précédent",
        "prédécesseur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7d47f03-484f-3bc8-a36f-d75bcae7b73f",
                    "sense_definition": "Avoir lieu ou arriver avant quelque chose dans le temps.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temporalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un violent orage a <w>précédé</w> la baisse soudaine des températures dans toute la région."
                        },
                        {
                            "text": "Pendant les semaines qui ont <w>précédé</w> l'examen, elle a révisé consciencieusement tous les soirs."
                        }
                    ],
                    "antonyms": [
                        "succéder",
                        "suivre"
                    ],
                    "common_phrases": [
                        "les jours qui précèdent",
                        "précéder de peu"
                    ]
                },
                {
                    "sense_id": "34cf6360-efdc-3eee-836a-e3d3e2f2927f",
                    "sense_definition": "Occuper une place antérieure dans une suite, un texte ou une hiérarchie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toutes les explications nécessaires figurent dans le chapitre qui <w>précède</w> cette conclusion."
                        },
                        {
                            "text": "La lettre B <w>précède</w> immédiatement la lettre C dans l'alphabet latin."
                        }
                    ],
                    "antonyms": [
                        "suivre"
                    ],
                    "common_phrases": [
                        "le chapitre qui précède"
                    ]
                },
                {
                    "sense_id": "78d58112-cf76-3bef-9e45-fb940de6cbbf",
                    "sense_definition": "Marcher ou se déplacer devant quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deux motards de la police roulaient en avant pour <w>précéder</w> le cortège officiel."
                        },
                        {
                            "text": "Le guide expérimenté <w>précédait</w> les randonneurs sur ce sentier escarpé pour assurer leur sécurité."
                        }
                    ],
                    "synonyms": [
                        "devancer"
                    ],
                    "antonyms": [
                        "suivre"
                    ],
                    "common_phrases": [
                        "précéder le cortège"
                    ]
                }
            ]
        }
    ]
