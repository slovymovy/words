        "fr-extract.jsonl": [
            {
                "entry_id": "34c6dc13-fdcf-3a01-863a-d0f3a8c56635",
                "word": "gazoduc",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b7221ca1-3d6e-4dcd-be47-0b47bd8d2d0d",
                        "entry_id": "34c6dc13-fdcf-3a01-863a-d0f3a8c56635",
                        "tags": [
                            "plural"
                        ],
                        "form": "gazoducs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f602f190-8fc9-31fc-9d26-3b9fb8f69b94",
                        "entry_id": "34c6dc13-fdcf-3a01-863a-d0f3a8c56635",
                        "glosses": [
                            "Pipeline qui permet de transporter du gaz d’un point à un autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a14a479-c929-4a2a-8d60-b660b51d9e48",
                                "sense_id": "f602f190-8fc9-31fc-9d26-3b9fb8f69b94",
                                "text": "Les ressources connues en gaz, compte tenu des besoins de la Géorgie et de la Turquie, déjà branchées sur le tube, ne permettraient toutefois pas de rentabiliser la construction de ce gazoduc, qui est toujours en panne d’investisseurs."
                            },
                            {
                                "example_id": "7166bb5f-440f-4a00-b236-3b7722e63b93",
                                "sense_id": "f602f190-8fc9-31fc-9d26-3b9fb8f69b94",
                                "text": "Hors service à cause de la guerre en Ukraine, les gazoducs Nord Stream reliant la Russie à l’Allemagne sous la mer Baltique ont été tous deux touchés, lundi, par des fuites spectaculaires, au large de l’île danoise de Bornholm."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a30d23f3-3e3d-40ae-a373-1a0460ec277c",
                        "source_entry_id": "34c6dc13-fdcf-3a01-863a-d0f3a8c56635",
                        "source_sense_id": "f602f190-8fc9-31fc-9d26-3b9fb8f69b94",
                        "target_lang_word": "Gaspipeline",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaspipeline",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13f0ed0a-4efb-31d5-aece-f391c0e24d18",
                                        "entry_id": "0dfc2a53-bde8-372f-be24-53ac22ee3b5d",
                                        "glosses": [
                                            "Pipeline für den Transport von Gas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e61c001-7101-4151-bb11-e99ad63d2123",
                                                "sense_id": "13f0ed0a-4efb-31d5-aece-f391c0e24d18",
                                                "text": "„Eine staatliche Gaspipeline ist im Süden Indiens explodiert und hat einen Feuersturm ausgelöst, in dem 15 Menschen ums Leben kamen.“"
                                            },
                                            {
                                                "example_id": "90a339ed-a3e5-4f91-875a-2122e63b34d3",
                                                "sense_id": "13f0ed0a-4efb-31d5-aece-f391c0e24d18",
                                                "text": "„In Islamabad gab es lange Zeit Gerüchte, wonach die CIA die Aktionen der belutschischen Freiheitskämpfer gegen die Regierung unterstützt, um den Bau einer iranisch-indischen Gaspipeline über pakistanisches Territorium zu verhindern oder auch die Bedeutung des zu der Zeit im Bau befindlichen Tiefseehafens Gwadar zu unterminieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d0fdbf7-5cb0-48be-b5e4-94b75a57f68c",
                        "source_entry_id": "34c6dc13-fdcf-3a01-863a-d0f3a8c56635",
                        "source_sense_id": "f602f190-8fc9-31fc-9d26-3b9fb8f69b94",
