                                            },
                                            {
                                                "example_id": "e1ec14dd-bcb8-49d3-84ee-68e752e98364",
                                                "sense_id": "cf1b780f-78db-3a6c-9fcb-1f327ea80ab6",
                                                "text": "„Sein kaufmännischer Angestellter in der neu eröffneten Garnhandlung war kein Mann, der seine Pflicht streng nahm.“"
                                            },
                                            {
                                                "example_id": "28d19a90-aed3-4840-af30-ae9b4178f98c",
                                                "sense_id": "cf1b780f-78db-3a6c-9fcb-1f327ea80ab6",
                                                "text": "„Der Angestellte kommt mit verbundenem Kopf eine Stunde zu spät ins Büro.“"
                                            },
                                            {
                                                "example_id": "31e3d731-671e-48d2-b7f8-653dad648fae",
                                                "sense_id": "cf1b780f-78db-3a6c-9fcb-1f327ea80ab6",
                                                "text": "[1920er Jahre:] „Noch stärker als die Zahl der Fabrikarbeiterinnen nahm die Gruppe der weiblichen Angestellten zu, besonders in großen Städten.“"
                                            },
                                            {
                                                "example_id": "f79d6845-6639-49ee-9acc-354d1775dab5",
                                                "sense_id": "cf1b780f-78db-3a6c-9fcb-1f327ea80ab6",
                                                "text": "„1925 war ein Drittel aller Angestellten weiblich: Sekretärinnen, Stenotypistinnen – Angestellte, die Stenografie (Kurzschrift) und Maschineschreiben beherrschten –, Verkauferinnen.“"
                                            },
                                            {
                                                "example_id": "5de9e563-612b-4582-8273-ab1562bdc542",
                                                "sense_id": "cf1b780f-78db-3a6c-9fcb-1f327ea80ab6",
                                                "text": "„Vielen staatlichen Angestellten in den USA dürfte mulmig geworden sein, als sie von einer der ersten Personalentscheidungen des designierten US-Präsidenten erfahren haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
