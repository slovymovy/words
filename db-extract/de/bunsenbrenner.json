                "senses": [
                    {
                        "sense_id": "29de27ba-742e-3cc6-a04d-5695d8da59c9",
                        "entry_id": "b276424f-81bb-3243-b9fc-367cfd6c300c",
                        "glosses": [
                            "Gasbrenner, bei dem das zugeführte Gas die zur Verbrennung benötigte Luft durch eine verstellbare Öffnung ansaugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10ae2769-bb14-485f-8d1d-382838208cca",
                                "sense_id": "29de27ba-742e-3cc6-a04d-5695d8da59c9",
                                "text": "„Der Vorläufer der heute eingesetzten Brenner wurde 1855 von Robert Wilhelm Bunsen entwickelt und ihm zu Ehren als Bunsenbrenner bezeichnet.“"
                            },
                            {
                                "example_id": "3306f04a-33ff-4b47-bb2a-228cd446bdc3",
                                "sense_id": "29de27ba-742e-3cc6-a04d-5695d8da59c9",
                                "text": "„Der Bunsenbrenner wird neben dem Teclubrenner im chemischen Labor häufig zum Erhitzen von Stoffproben oder Flüssigkeiten benutzt.“"
                            },
                            {
                                "example_id": "775d1087-8581-4934-8e62-fc8e917e03e3",
                                "sense_id": "29de27ba-742e-3cc6-a04d-5695d8da59c9",
                                "text": "„Eine doppelte Reihe von mit Glasstöpseln verschlossenen Flaschen stand in einem Regal an der Wand gegenüber der Tür, und der Tisch war vollständig bedeckt mit einem Durcheinander von Bunsenbrennern, Reagenzgläsern und Retorten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a12ad0a0-ca16-4139-9d54-ed99b3ab308f",
                        "source_entry_id": "b276424f-81bb-3243-b9fc-367cfd6c300c",
                        "source_sense_id": "29de27ba-742e-3cc6-a04d-5695d8da59c9",
                        "source_sense_description": "Gasbrenner, der die zur Verbrennung benötigte Luft durch eine verstellbare Öffnung ansaugt",
                        "target_lang_word": "Bunsen burner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bunsen burner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa4b7055-6762-3970-8cb1-924f6a6b6549",
                                        "entry_id": "ff5c2304-4720-3a08-b6d3-71e271ba2c8f",
                                        "glosses": [
                                            "A small laboratory gas burner whose air supply may be controlled with an adjustable hole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37fe4aef-db5c-4664-ba9c-d2f29b029113",
                                                "sense_id": "fa4b7055-6762-3970-8cb1-924f6a6b6549",
                                                "text": "The due performance of Bunsen's burner depends upon the proper admixture of gas and air."
                                            },
                                            {
                                                "example_id": "03a741ff-48a2-4f6e-a723-d2ad14bf97f7",
                                                "sense_id": "fa4b7055-6762-3970-8cb1-924f6a6b6549",
                                                "text": "Although the Bunsen burner has been in extensive use for several years, there would seem to be a very well-grounded suspicion that its capabilities have not yet been fully discovered, for applications for patents for inventions, which are based on the Bunsen burner, or on modifications of it, are occasionally found in the official journal of the Patent Office."
                                            },
                                            {
                                                "example_id": "ed543cfa-da76-4213-92cc-e91ad7438b5c",
                                                "sense_id": "fa4b7055-6762-3970-8cb1-924f6a6b6549",
                                                "text": "Flame sterilisation is a frequently used technique in the microbiology laboratory and Bunsen burners are commonly used to provide the flame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
