                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "depredation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae11c62-758a-3b01-98a0-3568cac9a283",
                                        "entry_id": "c3886ca4-d5fe-3c17-833c-b03cc0d8021b",
                                        "glosses": [
                                            "An act of consuming agricultural resources (crops, livestock), especially as plunder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "385fb329-643f-452b-9881-faf6fad23f1f",
                                                "sense_id": "8ae11c62-758a-3b01-98a0-3568cac9a283",
                                                "text": "An animal that produces only two to four young per year cannot suffer vast depredations on the adult population without drastic effects."
                                            },
                                            {
                                                "example_id": "e9ae81e4-f886-4571-9f41-138039380f22",
                                                "sense_id": "8ae11c62-758a-3b01-98a0-3568cac9a283",
                                                "text": "Depredation of cultivated crops by elephants is widespread in both Africa and Asia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c876047a-6468-331b-b32f-988e3846744d",
                                        "entry_id": "c3886ca4-d5fe-3c17-833c-b03cc0d8021b",
                                        "glosses": [
                                            "A raid or predatory attack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45f85453-5aa9-486e-b0f9-84b2cbd15bb9",
                                                "sense_id": "c876047a-6468-331b-b32f-988e3846744d",
                                                "text": "Union Gen. William Tecumseh Sherman had long known that his fragile supply and communication lines through Tennessee were in serious jeopardy because of depredations by Forrest's cavalry raids. (Battle of Brice's Crossroads)"
                                            },
                                            {
                                                "example_id": "7c745f7b-6085-44da-ac12-3fc5bfbf5dbc",
                                                "sense_id": "c876047a-6468-331b-b32f-988e3846744d",
                                                "text": "Despite losing its overall roof to the depredations of the Luftwaffe in the Second World War, the main building survives in all its Gothic glory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
