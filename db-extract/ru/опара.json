                "senses": [
                    {
                        "sense_id": "64dae1d8-8315-3506-aaab-ff017ea4343b",
                        "entry_id": "a136859a-2f90-396c-993b-a0ef9d8e422d",
                        "glosses": [
                            "заготовка для кислого дрожжевого теста"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3267a1ee-880c-4bd6-b553-5d0f58859638",
                                "sense_id": "64dae1d8-8315-3506-aaab-ff017ea4343b",
                                "text": "Та выпирает, словно опара из корыта."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "555d9d52-9501-41b1-af35-5acb51a566d1",
                        "source_entry_id": "a136859a-2f90-396c-993b-a0ef9d8e422d",
                        "source_sense_id": "64dae1d8-8315-3506-aaab-ff017ea4343b",
                        "target_lang_word": "Sauerteig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sauerteig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80d723ff-2836-373a-8ece-290eefa58ee3",
                                        "entry_id": "9d9ffa3b-77af-338c-876d-07e4334ec0a5",
                                        "glosses": [
                                            "durch Beigabe von Mehl und Wasser ein in fortwährender Gärung gehaltener Teig, der als Triebmittel zumeist einem Backwerk (vor allem Brot) zugefügt wird, was zu dessen Lockerung führt und ihm einen leicht säuerlichen Geschmack verleiht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dabda55c-5a89-49d4-8149-3ccd494c26ec",
                                                "sense_id": "80d723ff-2836-373a-8ece-290eefa58ee3",
                                                "text": "„Die für die Gasbildung wichtigen Hefen des Sauerteiges haben ihr Optimum zwischen pH 4,0 und 5,6. […] Die vereinfachten Führungen des Sauerteiges werden dadurch erreicht, daß nur die Milchsäuregärung mit Sauerteig durchgeführt wird.“"
                                            },
                                            {
                                                "example_id": "d6c46ebc-7469-4083-9ffb-e1dd15011d93",
                                                "sense_id": "80d723ff-2836-373a-8ece-290eefa58ee3",
                                                "text": "„Für den Sauerteig-Ansatz 250 g Weizen mehlfein mahlen, mit 1/4 1 lauwarmem Wasser vermischen, 48 Std. an einem warmen Ort […] gären lassen, bis ein breiiger, angenehm säuerlich riechender Teig entsteht.\n- Für den Vorteig 250 g Weizen mehlfein mahlen. Mit dem Sauerteig-Ansatz und 200 ml lauwarmem Wasser vermischen.“"
                                            },
                                            {
                                                "example_id": "f21bfa72-bb07-46be-b534-f2e8c1b1ee5a",
                                                "sense_id": "80d723ff-2836-373a-8ece-290eefa58ee3",
                                                "text": "„Weitere Teigführungsarten, die per Definition den Sauerteigen zugerechnet werden müssen, sind Backferment und das Honig-Salz-Verfahren.“"
                                            },
                                            {
                                                "example_id": "c43a816a-eb6f-449e-bc74-18c224960ca7",
                                                "sense_id": "80d723ff-2836-373a-8ece-290eefa58ee3",
                                                "text": "„Sie wollten nicht auf die Angaben widerspenstiger Müller und sich über die Kontrollen gekränkt zeigender Bäcker vertrauen, sondern selbst beobachten, aus wie viel Korn zu Beginn des Herstellungsvorgangs wie viele Brote an dessen Ende wurden, vom Mahlen über das Ansetzen des Sauerteigs bis zum ordnungsgemäßen Ausbacken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Sauerteig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c61ab73-ffbe-36b5-9ca1-7a5e761509e8",
                                        "entry_id": "3e5d5e75-0ca4-3c0b-941f-854f5e515610",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf803c59-ce6a-4e76-a2e5-664e40bb5801",
                                                "sense_id": "5c61ab73-ffbe-36b5-9ca1-7a5e761509e8",
                                                "text": "„Karin E. Blumberger-Sauerteig (* 3. April 1945) ist eine deutsche Diplomatin und war von 2008 bis 2010 Botschafterin in Kamerun, Äquatorialguinea sowie der Zentralafrikanischen Republik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2877a3c3-4220-45ef-8025-a661e5dc227b",
                        "source_entry_id": "a136859a-2f90-396c-993b-a0ef9d8e422d",
                        "source_sense_id": "64dae1d8-8315-3506-aaab-ff017ea4343b",
                        "target_lang_word": "levain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "levain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df69582a-6685-37a6-819b-5be2934843d3",
                                        "entry_id": "90e1eb41-42b5-3857-b4ef-5f33bd8dd228",
                                        "glosses": [
                                            "Morceau de pâte aigrie qui, mêlée à la pâte dont on veut faire du pain, sert à la faire lever, à la faire fermenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "696bfa76-4006-4cd4-95d1-4e8146c72659",
                                                "sense_id": "df69582a-6685-37a6-819b-5be2934843d3",
                                                "text": "Dans un coffre en bois de chêne, appelé pétrin, on introduit la quantité de farine que l’on veut convertir en pain, en l’écartant sur les bords, puis on délaye au milieu le levain avec de l’eau chaude et une partie de la farine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18e9d34b-11e6-3078-acd4-16479317ec6b",
                                        "entry_id": "90e1eb41-42b5-3857-b4ef-5f33bd8dd228",
                                        "glosses": [
                                            "Substance capable de produire une fermentation interne dans le corps avec lequel on l’a mêlé et d’y exciter un gonflement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac9c9dbd-ed67-41ab-b0b5-2e3998b2caa6",
                                                "sense_id": "18e9d34b-11e6-3078-acd4-16479317ec6b",
                                                "text": "Levain de bière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                        "entry_id": "90e1eb41-42b5-3857-b4ef-5f33bd8dd228",
                                        "glosses": [
                                            "Germes de certaines passions violentes."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90597481-a794-4b0f-869b-51853704258d",
                                                "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                                "text": "Il avait dans le cœur un vieux levain de haine."
                                            },
                                            {
                                                "example_id": "c4c8047a-a083-4b0a-ae35-7fbc8d9d9806",
                                                "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                                "text": "Leur haine n’est pas si bien apaisée qu’il n’en reste quelque levain."
                                            },
                                            {
                                                "example_id": "90c65559-cb25-4513-bc16-9e0c28a0025b",
                                                "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                                "text": "Il y a chez ce peuple un levain de sédition."
                                            },
                                            {
                                                "example_id": "945e42aa-5191-4661-83d7-71c8317f4219",
                                                "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                                "text": "Un levain de discorde, de révolte, d’inimitié, de division."
                                            },
                                            {
                                                "example_id": "b4eca63f-670a-4138-8dc2-323f9a7d9a5a",
                                                "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                                "text": "Se défaire du vieux levain du péché."
                                            },
                                            {
                                                "example_id": "9196063a-a933-461f-b1ba-aa6ccb580de7",
                                                "sense_id": "7d4e71f4-078c-32f6-82eb-0052a80a1e6e",
                                                "text": "Nourrir le levain de la vengance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
