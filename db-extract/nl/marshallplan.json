                        "examples": [
                            {
                                "example_id": "c9b1b31f-cd3f-4ca0-bb3c-df5ad9ecefa5",
                                "sense_id": "ab461cab-0e49-3961-8f61-34c2476efd6d",
                                "text": "De oud-president pleit voor een marshallplan voor de aidsbestrijding in Afrika."
                            },
                            {
                                "example_id": "a4d3a333-6a42-4007-8b7c-a494b482b293",
                                "sense_id": "ab461cab-0e49-3961-8f61-34c2476efd6d",
                                "text": "Ontwikkelingseconoom Carlos Lopes: 'Hou op met die marshallplannen voor Afrika'"
                            },
                            {
                                "example_id": "4e0415b7-84b0-4183-9b14-50ccaec594f2",
                                "sense_id": "ab461cab-0e49-3961-8f61-34c2476efd6d",
                                "text": "De Europese Commissie komt met een ‘Groeiplan’. Hierin worden enkele honderden miljarden euro’s uit diverse structuurprogramma’s en van de Europese Investeringsbank in elkaar geknutseld als een Ikeameubel en verheven tot een marshallplan voor infrastructuurprojecten."
                            }
                        ]
