                                        "entry_id": "b276424f-81bb-3243-b9fc-367cfd6c300c",
                                        "glosses": [
                                            "Gasbrenner, bei dem das zugeführte Gas die zur Verbrennung benötigte Luft durch eine verstellbare Öffnung ansaugt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10ae2769-bb14-485f-8d1d-382838208cca",
                                                "sense_id": "29de27ba-742e-3cc6-a04d-5695d8da59c9",
                                                "text": "„Der Vorläufer der heute eingesetzten Brenner wurde 1855 von Robert Wilhelm Bunsen entwickelt und ihm zu Ehren als Bunsenbrenner bezeichnet.“"
                                            },
                                            {
                                                "example_id": "3306f04a-33ff-4b47-bb2a-228cd446bdc3",
                                                "sense_id": "29de27ba-742e-3cc6-a04d-5695d8da59c9",
                                                "text": "„Der Bunsenbrenner wird neben dem Teclubrenner im chemischen Labor häufig zum Erhitzen von Stoffproben oder Flüssigkeiten benutzt.“"
                                            },
                                            {
                                                "example_id": "775d1087-8581-4934-8e62-fc8e917e03e3",
                                                "sense_id": "29de27ba-742e-3cc6-a04d-5695d8da59c9",
                                                "text": "„Eine doppelte Reihe von mit Glasstöpseln verschlossenen Flaschen stand in einem Regal an der Wand gegenüber der Tür, und der Tisch war vollständig bedeckt mit einem Durcheinander von Bunsenbrennern, Reagenzgläsern und Retorten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
