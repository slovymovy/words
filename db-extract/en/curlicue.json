                ],
                "senses": [
                    {
                        "sense_id": "db77c9a0-9573-3a38-8b51-d7f19b37b6a2",
                        "entry_id": "94eb7e84-a9a9-3286-9606-3a4b5b24d654",
                        "glosses": [
                            "A fancy twisting or curling shape usually made from a series of spirals and loops."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e29345fa-2ca6-49ad-a614-d29ad1516f4c",
                                "sense_id": "db77c9a0-9573-3a38-8b51-d7f19b37b6a2",
                                "text": "I put in plenty of curlicues after the figures so that no one could raise the check into $400,000; then I got out my old rattan suit case and put in some clothes."
                            },
                            {
                                "example_id": "3ac34547-42d9-457b-99bb-1dde80a70f75",
                                "sense_id": "db77c9a0-9573-3a38-8b51-d7f19b37b6a2",
                                "text": "There was not the slightest use in trying to make its twisty curlicue streets conform to any engineering plan on earth; so those sensible old-time folk didn't try."
                            },
                            {
                                "example_id": "e208de2f-2561-46ca-ad82-b0de2ab3542d",
                                "sense_id": "db77c9a0-9573-3a38-8b51-d7f19b37b6a2",
                                "text": "(Curlicue hand-drawn cartoons blossom frequently throughout, touching base with the source material’s distinctive visual style while adding an aptly hallucinogenic vibe when required.)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55ad607f-8993-4ced-8e98-cb575bfc5c3d",
                        "source_entry_id": "94eb7e84-a9a9-3286-9606-3a4b5b24d654",
                        "source_sense_id": "db77c9a0-9573-3a38-8b51-d7f19b37b6a2",
                        "source_sense_description": "fancy curling shape",
                        "target_lang_word": "Schnörkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnörkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf7cdcb-73d3-34bb-909b-19d72a9090c0",
                                        "entry_id": "051e0467-8c88-3b60-9bff-a35a507c74e0",
                                        "glosses": [
                                            "geschwungene Verzierung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "411538af-de27-412e-ae0a-01147dcfffab",
                                                "sense_id": "2bf7cdcb-73d3-34bb-909b-19d72a9090c0",
                                                "text": "Der Bilderrahmen war voller Schnörkel."
                                            },
                                            {
                                                "example_id": "f1f6db24-f746-4916-8515-072d84bea973",
                                                "sense_id": "2bf7cdcb-73d3-34bb-909b-19d72a9090c0",
                                                "text": "„Mit dem Finger malte er Schnörkel auf die Theke.“"
                                            },
                                            {
                                                "example_id": "371fb97b-62d9-411a-ba3c-eccb156584fd",
                                                "sense_id": "2bf7cdcb-73d3-34bb-909b-19d72a9090c0",
                                                "text": "„Ein Rest von Bemalung, ein kläglicher ausgewachsener Schnörkel belehrten mich, daß dieses Haus in fernen Friedens- und Sommerzeiten afrikanische Kunden bedient hatte.“"
                                            },
                                            {
                                                "example_id": "3a46ed47-4dd3-430e-9cff-0698161b29c8",
                                                "sense_id": "2bf7cdcb-73d3-34bb-909b-19d72a9090c0",
                                                "text": "„Wir erachten es als selbstverständlich, dass wir unsere Gedanken in einen Haufen willkürlicher Schnörkel zwängen, die die Zeilen eines Blattes Papier oder eines Bildschirms bevölkern, und dass dieselben Schnörkel wiederum in den Köpfen oder Kehlen anderer Menschen am anderen Ende der Welt oder in einer fernen unbekannten Zukunft zum Leben erwachen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "808656ea-deaa-35db-b8fa-6b52f7458784",
                                        "entry_id": "051e0467-8c88-3b60-9bff-a35a507c74e0",
                                        "glosses": [
                                            "schneckenförmige Verzierung der Geigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "021324b3-a813-4922-a187-29a49bbc3276",
                                                "sense_id": "808656ea-deaa-35db-b8fa-6b52f7458784",
                                                "text": "Bei dieser Geige war statt eines Schnörkels ein Engelskopf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
