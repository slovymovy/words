                    }
                ],
                "senses": [
                    {
                        "sense_id": "dfcf7b6a-8592-3f54-809c-d82728182bdc",
                        "entry_id": "92787287-4522-3fa7-9f0a-7e9e49606428",
                        "glosses": [
                            "Qu’on peut danser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac01ed36-7951-4858-bea8-29385d61fedf",
                                "sense_id": "dfcf7b6a-8592-3f54-809c-d82728182bdc",
                                "text": "… et c’était les plus belles bourrées du monde, toutes inconnues chez nous, mais si enlevantes et d’un mouvement si dansable, qu’il nous semblait voler en l’air plutôt que gigotter sur le gazon."
                            },
                            {
                                "example_id": "b670b571-0b76-43c3-a7a1-cf3b3cfc6e72",
                                "sense_id": "dfcf7b6a-8592-3f54-809c-d82728182bdc",
                                "text": "Le Panacea de Woody Herman (B. F 116) n'est qu’un Woody Herman de plus, bien en place et dansable, mais froid et peu sincère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7276891-8939-4934-8a62-33d937804655",
                        "source_entry_id": "92787287-4522-3fa7-9f0a-7e9e49606428",
                        "source_sense_id": "dfcf7b6a-8592-3f54-809c-d82728182bdc",
                        "target_lang_word": "tanzbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tanzbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bab33866-39d8-3271-864d-2834b4bef709",
                                        "entry_id": "719ad31a-28c3-3f3a-be70-b6b45e61225f",
                                        "glosses": [
                                            "zum Tanzen geeignet"
                                        ],
                                        "tags": [
                                            "auf Musik bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "578c1ba7-d240-4da4-af70-3eac80bf184a",
                                                "sense_id": "bab33866-39d8-3271-864d-2834b4bef709",
                                                "text": "„Der Salon wurde geschmückt und ich legte meine tanzbarste Musik auf.“"
                                            },
                                            {
                                                "example_id": "b023f9d2-1c18-434f-a855-ebdd026adbdc",
                                                "sense_id": "bab33866-39d8-3271-864d-2834b4bef709",
                                                "text": "Claudia komponiert äußerst tanzbare Musik."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97524148-0f88-47a3-aff3-d7c56583e744",
                        "source_entry_id": "92787287-4522-3fa7-9f0a-7e9e49606428",
                        "source_sense_id": "dfcf7b6a-8592-3f54-809c-d82728182bdc",
                        "target_lang_word": "danceable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "danceable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c143c9a5-5c9d-310b-81e3-9e482e5372f0",
                                        "entry_id": "bb929823-a3a7-3cc6-91fd-e54ec635b684",
                                        "glosses": [
                                            "Suitable for dancing."
                                        ],
                                        "tags": [
                                            "of music"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c069522-2241-3b69-a910-021797b75a4b",
                                        "entry_id": "bb929823-a3a7-3cc6-91fd-e54ec635b684",
                                        "glosses": [
                                            "Danceworthy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48a74560-f339-400d-be5e-bbe1b8055177",
                                                "sense_id": "4c069522-2241-3b69-a910-021797b75a4b",
                                                "text": "“Assignment time! Hatchi machi! (gasps) I got conference room cleanup duty. In your face!” “Last time I checked, that was very lame.” (humming) “Why would you dance? That's not a danceable job.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "danceable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9749d03-06c1-3387-b78d-2009b67341ee",
                                        "entry_id": "4906c85d-f727-34cc-96c8-4986d878992a",
                                        "glosses": [
                                            "A social event with dancing; a ball."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e482d2c3-8a00-4424-add9-9f30002e916e",
                                                "sense_id": "e9749d03-06c1-3387-b78d-2009b67341ee",
                                                "text": "During the months that followed the bazaar, Rhett called whenever he was in town, taking Scarlett riding in his carriage, escorting her to danceables and bazaars and waiting outside the hospital to drive her home."
                                            },
                                            {
                                                "example_id": "efe80ca9-70b5-4724-bbc2-84098655bd0f",
                                                "sense_id": "e9749d03-06c1-3387-b78d-2009b67341ee",
                                                "text": "The Netherwood was billed as \"a city hotel in the country.\" For two decades after its 1878 opening, people arrived from New York by parlor car to spend their vacation on the Netherwood Heights. Croquet, danceables, masquerades, tennis, bowling, midnight suppers, and fancy dress balls were the order of the day for the vacationer."
                                            },
                                            {
                                                "example_id": "049cea36-50e0-45a9-9927-751bcd824f5b",
                                                "sense_id": "e9749d03-06c1-3387-b78d-2009b67341ee",
                                                "text": "In the street the rattle of carriages could still be heard, women's voices calling farewells and invitations to future dinners and danceables."
                                            },
                                            {
                                                "example_id": "ac2aac83-2e89-4e6f-ad48-8322523d0dab",
                                                "sense_id": "e9749d03-06c1-3387-b78d-2009b67341ee",
                                                "text": "We children were introduced to these musical ensembles very early, and as we grew up, we merely tolerated them in part because their performances were usually sit-down events rather than danceables, and they weren't as hip as the American music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9a49a3c-92cc-3924-8376-663412fca20f",
                                        "entry_id": "4906c85d-f727-34cc-96c8-4986d878992a",
                                        "glosses": [
                                            "A song suitable for dancing to."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2945fea-bfd9-4980-8811-92ef22c36346",
                                                "sense_id": "f9a49a3c-92cc-3924-8376-663412fca20f",
                                                "text": "The Dynatones' approach is a three-way mix: familiar danceables from the likes of Junior Walker, Sam & Dave and the Rascals; scrupulously selected obscurities from such artists as Z.Z. Hill and Rodger Collins, which underscore the depth of their commitment to the genre; and smart, well crafted originals written by vocalist Chip \"C.C\" Miller and guitarist Larry Dunn."
                                            },
                                            {
                                                "example_id": "ac848046-ad16-4cbd-99e0-47847582eac9",
                                                "sense_id": "f9a49a3c-92cc-3924-8376-663412fca20f",
                                                "text": "A five-piece band playing modern Top 40 danceables, Hot Pursuit is after Tucsonans not content with toe tapping."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
