                        "examples": [
                            {
                                "example_id": "bd4da273-56c6-434f-83a9-783c3efa9c99",
                                "sense_id": "adbdb9fe-0490-3783-b4af-dc71fbd47228",
                                "text": "Russian Synodal Bible, Mark 4.11:"
                            },
                            {
                                "example_id": "b4b46708-3dd1-43d9-b146-b72421157e10",
                                "sense_id": "adbdb9fe-0490-3783-b4af-dc71fbd47228",
                                "text": "И сказал им: вам дано знать тайны Царствия Божия, а тем внешним все бывает в притчах;",
                                "translation": "He told them, “The secret of the kingdom of God has been given to you. But to those on the outside everything is said in parables;",
                                "english": "He told them, “The secret of the kingdom of God has been given to you. But to those on the outside everything is said in parables;"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
