                                                "example_id": "3e49d915-a146-4f8e-a5c8-1e1c7f32d55a",
                                                "sense_id": "9ab03321-9787-33c1-acb4-70c46c675ba0",
                                                "text": "With manly mien he stalked along the ground."
                                            },
                                            {
                                                "example_id": "e39d3c66-d180-4494-9241-ebb4aa6b8542",
                                                "sense_id": "9ab03321-9787-33c1-acb4-70c46c675ba0",
                                                "text": "Then stalking through the deep, / He fords the ocean."
                                            },
                                            {
                                                "example_id": "5ebc6831-df7c-4ec7-8737-c0a85ef2bf79",
                                                "sense_id": "9ab03321-9787-33c1-acb4-70c46c675ba0",
                                                "text": "I forbear myself from entering the lists in which he has long stalked alone and unchallenged."
                                            }
                                        ]
                                    }
