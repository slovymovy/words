                "senses": [
                    {
                        "sense_id": "23602139-beb7-3e81-9ca8-73e445f41b14",
                        "entry_id": "5467bd93-fe16-3415-a8c4-a66e6d27823b",
                        "glosses": [
                            "Zange, mit der man Nägel oder Dübel aus der Wand oder einem Brett ziehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b787096-e5ed-4929-8e0d-06b6a96b8bf2",
                                "sense_id": "23602139-beb7-3e81-9ca8-73e445f41b14",
                                "text": "Eine Kneifzange gehört in jeden Werkzeugkasten, da sie vielseitig eingesetzt werden kann."
                            },
                            {
                                "example_id": "4edfa6ee-f842-4436-8b55-63b4c5c19f4a",
                                "sense_id": "23602139-beb7-3e81-9ca8-73e445f41b14",
                                "text": "„Mit einer Kneifzange ließen sich die Schlösser leicht entfernen.“."
                            },
                            {
                                "example_id": "c01a41de-6d58-438a-b696-ae7e7eccf29c",
                                "sense_id": "23602139-beb7-3e81-9ca8-73e445f41b14",
                                "text": "„Die größte Neuigkeit war, dass kein amerikanischer Verleger Joyce' Buch auch nur mit der Kneifzange anfassen wollte, und damit kam eine private Ausgabe nicht mehr infrage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
