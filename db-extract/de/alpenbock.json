                        "source_sense_id": "67a4bc2c-909a-3de7-9618-68415d628d3d",
                        "source_sense_description": "Zoologie: ein Käfer aus der Familie der Bockkäfer",
                        "target_lang_word": "rosalie des Alpes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rosalie des Alpes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd103fe1-6478-3272-b426-c095f6dc4cee",
                                        "entry_id": "7f60e4ce-e58a-386d-b586-df399936c417",
                                        "glosses": [
                                            "Insecte longicorne, coléoptère au corps relativement long (18–38 mm), étroit, aplati, gris-bleu avec des taches noires sur les élytres et de très longues antennes bleues."
                                        ],
                                        "tags": [
                                            "Coléoptérologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea92993b-d9b3-498f-a0f9-1d7e03d35cb3",
                                                "sense_id": "bd103fe1-6478-3272-b426-c095f6dc4cee",
                                                "text": "Rare et menacée à cause du déboisement, la rosalie des Alpes peut être observée en dehors des massifs montagneux, notamment dans les frênes charentais."
                                            },
                                            {
                                                "example_id": "a979dd7e-1a9b-4f0e-b6c6-475e9cbc7617",
                                                "sense_id": "bd103fe1-6478-3272-b426-c095f6dc4cee",
                                                "text": "À partir des oeufs pondus dans les fissures des arbres morts ou fraîchement abattus, naissent des larves qui forent leurs galeries dans le bois dont elles se nourrissent trois ans durant … Les belles rosalies des Alpes n’auront qu’une dizaine de jours après leur métamorphose pour assurer leur reproduction. Le mâle, plus précoce, défend âprement un espace favorable à une future ponte puis s’accouple avec une femelle pendant plusieurs heures."
                                            }
                                        ]
                                    }
                                ]
                            }
