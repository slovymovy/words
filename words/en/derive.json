{
    "word_family": [
        "derivation",
        "derivative",
        "derivable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b2274cf-c98e-31f0-b830-15afe40895fd",
                    "sense_definition": "To obtain or receive something, such as a benefit or quality, from a specific source.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "obtaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people <w>derive</w> great pleasure from gardening during the spring months.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>получают</w> огромное удовольствие от садоводства в весенние месяцы.",
                                "de": "Viele Menschen <w>gewinnen</w> in den Frühlingsmonaten große Freude an der Gartenarbeit.",
                                "zh": "许多人在春天做园艺时能从中<w>获得</w>很大的乐趣。"
                            }
                        },
                        {
                            "text": "It is possible to <w>derive</w> satisfaction from a job well done even if it was difficult.",
                            "target_lang_translations": {
                                "ru": "Можно <w>извлечь</w> удовлетворение от хорошо выполненной работы, даже если она была трудной.",
                                "de": "Man kann aus einer gut erledigten Arbeit Zufriedenheit <w>schöpfen</w>, selbst wenn sie schwierig war.",
                                "zh": "即使工作很困难，人们也可能从一项完成得很好的工作中<w>得到</w>满足感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "get",
                        "obtain",
                        "acquire",
                        "gain"
                    ],
                    "common_phrases": [
                        "derive pleasure from",
                        "derive satisfaction from",
                        "derive benefit from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать или извлекать что-либо (например, выгоду или качество) из определенного источника.",
                        "de": "Etwas (wie einen Nutzen oder eine Eigenschaft) aus einer bestimmten Quelle erhalten oder gewinnen.",
                        "zh": "从某个特定来源获得或得到某种东西，如好处、快乐或某种品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получать",
                                "target_lang_sense_clarification": "удовольствие, выгоду"
                            },
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "пользу, удовлетворение"
                            },
                            {
                                "target_lang_word": "черпать",
                                "target_lang_sense_clarification": "вдохновение, силы"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gewinnen",
                                "target_lang_sense_clarification": "Nutzen oder Freude aus etwas ziehen"
                            },
                            {
                                "target_lang_word": "erlangen",
                                "target_lang_sense_clarification": "etwas durch Anstrengung oder Umstände erhalten"
                            },
                            {
                                "target_lang_word": "schöpfen",
                                "target_lang_sense_clarification": "Kraft oder Inspiration aus einer Quelle ziehen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获得",
                                "target_lang_sense_clarification": "从某个来源得到好处、快乐、满足等"
                            },
                            {
                                "target_lang_word": "得到",
                                "target_lang_sense_clarification": "得到某种积极结果或感受"
                            },
                            {
                                "target_lang_word": "汲取",
                                "target_lang_sense_clarification": "多用于抽象事物，如力量、灵感、益处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4cbc501-5ddb-3263-954c-ec2433f89ddf",
                    "sense_definition": "To have a specified thing as a starting point or source; to originate from.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The English word 'clue' <w>derives</w> from the word 'clew', meaning a ball of thread.",
                            "target_lang_translations": {
                                "ru": "Английское слово «clue» <w>происходит</w> от слова «clew», означающего клубок ниток.",
                                "de": "Das englische Wort 'clue' <w>leitet sich</w> von dem Wort 'clew' ab, was ein Knäuel Garn bedeutet.",
                                "zh": "英语单词“clue”<w>源于</w>“clew”一词，原意是“一团线”。"
                            }
                        },
                        {
                            "text": "Her excellent organizational skills <w>derive</w> from her time working as a secretary in the army.",
                            "target_lang_translations": {
                                "ru": "Ее отличные организаторские способности <w>берут начало</w> со времен ее работы секретарем в армии.",
                                "de": "Ihre exzellenten organisatorischen Fähigkeiten <w>stammen</w> aus ihrer Zeit als Sekretärin bei der Armee.",
                                "zh": "她出色的组织能力<w>来自</w>她在军队担任秘书的那段经历。"
                            }
                        }
                    ],
                    "synonyms": [
                        "originate",
                        "stem",
                        "spring",
                        "arise"
                    ],
                    "common_phrases": [
                        "derive from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь что-либо в качестве отправной точки или источника; происходить от чего-либо.",
                        "de": "Einen bestimmten Ursprung haben; von etwas abstammen.",
                        "zh": "以某个事物为起点或来源；源于，出自。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "происходить",
                                "target_lang_sense_clarification": "от какого-либо слова или источника"
                            },
                            {
                                "target_lang_word": "берет начало",
                                "target_lang_sense_clarification": "о происхождении"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "abstammen",
                                "target_lang_sense_clarification": "einen Ursprung haben"
                            },
                            {
                                "target_lang_word": "herrühren",
                                "target_lang_sense_clarification": "einen Ursprung in etwas haben"
                            },
                            {
                                "target_lang_word": "stammen",
                                "target_lang_sense_clarification": "von einem Ort oder einer Quelle kommen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "源于",
                                "target_lang_sense_clarification": "表示起源、来源"
                            },
                            {
                                "target_lang_word": "来自",
                                "target_lang_sense_clarification": "强调来自某个来源或经历"
                            },
                            {
                                "target_lang_word": "起源于",
                                "target_lang_sense_clarification": "较正式，强调起始来源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f9d1313-e580-3f6d-a1e2-24875d872293",
                    "sense_definition": "To reach a conclusion or find a result by using logic or reasoning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists were able to <w>derive</w> a new theory based on the data they collected.",
                            "target_lang_translations": {
                                "ru": "Ученые смогли <w>вывести</w> новую теорию на основе собранных ими данных.",
                                "de": "Die Wissenschaftler konnten auf Basis der gesammelten Daten eine neue Theorie <w>herleiten</w>.",
                                "zh": "科学家们能够根据收集到的数据<w>推导出</w>一个新理论。"
                            }
                        },
                        {
                            "text": "From these basic principles, we can <w>derive</w> a conclusion about the behavior of the system.",
                            "target_lang_translations": {
                                "ru": "Из этих основных принципов мы можем <w>сделать</w> вывод о поведении системы.",
                                "de": "Aus diesen Grundprinzipien können wir eine Schlussfolgerung über das Verhalten des Systems <w>ableiten</w>.",
                                "zh": "根据这些基本原理，我们可以<w>得出</w>关于该系统行为的结论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deduce",
                        "infer",
                        "reason"
                    ],
                    "common_phrases": [
                        "derive a conclusion",
                        "derive a formula"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прийти к выводу или получить результат с помощью логики или рассуждений.",
                        "de": "Durch logisches Denken oder Schlussfolgern zu einem Ergebnis gelangen.",
                        "zh": "通过逻辑或推理得出结论，或求得某个结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выводить",
                                "target_lang_sense_clarification": "формулу, заключение"
                            },
                            {
                                "target_lang_word": "получать",
                                "target_lang_sense_clarification": "логический результат"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "herleiten",
                                "target_lang_sense_clarification": "logisch aus Prinzipien entwickeln"
                            },
                            {
                                "target_lang_word": "ableiten",
                                "target_lang_sense_clarification": "ein Ergebnis aus Voraussetzungen folgern"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推导出",
                                "target_lang_sense_clarification": "通过逻辑、公式或原理推出结果"
                            },
                            {
                                "target_lang_word": "得出",
                                "target_lang_sense_clarification": "得出结论、结果"
                            },
                            {
                                "target_lang_word": "推出",
                                "target_lang_sense_clarification": "较书面，强调推理所得"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f600a578-94c3-300e-86f9-a1b6789069d1",
                    "sense_definition": "To trace the linguistic history and development of a word or phrase.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Etymologists try to <w>derive</w> the history of obscure slang terms used in the city.",
                            "target_lang_translations": {
                                "ru": "Этимологи пытаются <w>проследить</w> историю малоизвестных сленговых терминов, используемых в городе.",
                                "de": "Etymologen versuchen, die Geschichte obskurer Slangbegriffe der Stadt <w>herzuleiten</w>.",
                                "zh": "词源学家试图<w>追溯</w>这座城市里一些冷僻俚语的历史。"
                            }
                        },
                        {
                            "text": "It is often difficult to <w>derive</w> words that have been borrowed across multiple languages.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>установить происхождение</w> слов, которые были заимствованы несколькими языками.",
                                "de": "Es ist oft schwierig, Wörter <w>herzuleiten</w>, die aus mehreren Sprachen entlehnt wurden.",
                                "zh": "对于经过多种语言借入的词，往往很难<w>考证</w>其来源。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trace"
                    ],
                    "common_phrases": [
                        "derive the etymology"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical linguistic context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прослеживать лингвистическую историю и развитие слова или фразы.",
                        "de": "Die sprachgeschichtliche Herkunft eines Wortes oder Ausdrucks nachvollziehen.",
                        "zh": "追查一个词或短语在语言上的历史来源和发展过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прослеживать этимологию",
                                "target_lang_sense_clarification": "историю слова"
                            },
                            {
                                "target_lang_word": "выводить",
                                "target_lang_sense_clarification": "происхождение слова"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "herleiten",
                                "target_lang_sense_clarification": "die Etymologie eines Wortes bestimmen"
                            },
                            {
                                "target_lang_word": "etymologisch zurückführen",
                                "target_lang_sense_clarification": "die Herkunft eines Wortes klären"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "追溯词源",
                                "target_lang_sense_clarification": "追查词语的历史来源"
                            },
                            {
                                "target_lang_word": "考证词源",
                                "target_lang_sense_clarification": "考察并确定词语来源"
                            },
