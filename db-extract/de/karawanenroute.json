                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d13bdeb8-e2ac-49c4-ba0d-ef86239c7eaa",
                                "sense_id": "b0f6b630-9062-3116-94c5-905dec6bf195",
                                "text": "„Auf der viel genutzten Karawanenroute durch die Sahara kommen sie gut voran.“"
                            },
                            {
                                "example_id": "39a87c1e-e08e-443a-bfd0-a969698c7008",
                                "sense_id": "b0f6b630-9062-3116-94c5-905dec6bf195",
                                "text": "„Um die gesamte Karawanenroute von etwa eintausendvierhundert Kilometern bewältigen zu können, waren die Händler auf Stützpunkte, auf Karawansereien, angewiesen, um dort rasten und Verpflegung aufnehmen zu können.“"
                            }
                        ],
