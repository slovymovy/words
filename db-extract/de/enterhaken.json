                ],
                "senses": [
                    {
                        "sense_id": "46171d41-52b7-3c54-8537-eea2ebe5e7ce",
                        "entry_id": "5f6d9326-f70d-3dc1-b421-62692d9b4150",
                        "glosses": [
                            "mit einem Haken versehene Stange, um ein anderes Schiff heranzuziehen (und es zu entern, zu überfallen)"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "e0841dfe-417e-4cf1-8fbb-6281eb404ab5",
                                "sense_id": "46171d41-52b7-3c54-8537-eea2ebe5e7ce",
                                "text": "„In wenigen Augenblicken würden die Enterhaken geworfen werden und kurz darauf die Bordwände der Schiffe aneinanderreihen.“"
                            },
                            {
                                "example_id": "35c7eb02-1119-44cd-8fc0-18fef7a105cf",
                                "sense_id": "46171d41-52b7-3c54-8537-eea2ebe5e7ce",
                                "text": "„Käpten Sturm nahm den Enterhaken, befestigte ein stabiles Seil daran und legte ihn in den Wurf-Korb.“"
                            },
                            {
                                "example_id": "8dfefbcd-d395-47a5-a0bb-5a1ec8c73e1f",
                                "sense_id": "46171d41-52b7-3c54-8537-eea2ebe5e7ce",
                                "text": "„Die Piraten reagieren auf euer Manöver, indem sie eine Reihe Enterhaken bereitmachen.“"
                            },
                            {
                                "example_id": "bd2e6f50-5553-43b9-9b7a-362406f07ee3",
                                "sense_id": "46171d41-52b7-3c54-8537-eea2ebe5e7ce",
                                "text": "„Neben ihm lagen weitere der großen Bolzen, doch auch ein Enterhaken und eine Rolle Seil.“"
                            },
                            {
                                "example_id": "3bcc34b1-4209-488a-9938-ca89ab9afd1e",
                                "sense_id": "46171d41-52b7-3c54-8537-eea2ebe5e7ce",
                                "text": "„Ich ließ die Riemenstange fallen, ergriff das Seil mit dem kleinen Enterhaken und sprang über die Köpfe der Matrosen hinweg nach vorn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
