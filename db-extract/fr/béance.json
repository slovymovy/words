        "fr-extract.jsonl": [
            {
                "entry_id": "12977a89-dd14-3342-a9e6-a3fcc6a5f59e",
                "word": "béance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ad1c8b32-1b3b-4eb0-bb07-c8f5e0ce53da",
                        "entry_id": "12977a89-dd14-3342-a9e6-a3fcc6a5f59e",
                        "tags": [
                            "plural"
                        ],
                        "form": "béances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "87ea9beb-f5f0-3c3a-884e-03e4176ecbc7",
                        "entry_id": "12977a89-dd14-3342-a9e6-a3fcc6a5f59e",
                        "glosses": [
                            "État de ce qui est béant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06fa7097-b4f2-4fc5-8e51-5d43e9872c92",
                                "sense_id": "87ea9beb-f5f0-3c3a-884e-03e4176ecbc7",
                                "text": "Parmi les clientes dont mon m’avait plus spécialement confié la garde, les plus baveuses me donnaient un foutu tintouin. […]. Leurs petits vices, sévices; et leurs grandes béances à tenir toujours propres…"
                            },
                            {
                                "example_id": "c49d837d-0bad-40fd-a534-f2a951ddf8f0",
                                "sense_id": "87ea9beb-f5f0-3c3a-884e-03e4176ecbc7",
                                "text": "C’est ce que fait la psychanalyse quand elle rattache un symptôme à une béance dans la structure."
                            },
                            {
                                "example_id": "6e7ae3ef-4b80-42ee-9802-6836442629b3",
                                "sense_id": "87ea9beb-f5f0-3c3a-884e-03e4176ecbc7",
                                "text": "Devant l’horreur de ces béances, mon esprit s’engourdissait et devenait silence et informe magma…"
                            },
                            {
                                "example_id": "caecf2ae-a3a4-4f76-9fb8-f4897c34bc32",
                                "sense_id": "87ea9beb-f5f0-3c3a-884e-03e4176ecbc7",
                                "text": "Dans un octobre, un novembre, un février mental, c’est comme si l’on retrouvait un espace inespéré, une béance."
                            },
                            {
                                "example_id": "67973ae9-6533-44f9-8317-823483aa0302",
                                "sense_id": "87ea9beb-f5f0-3c3a-884e-03e4176ecbc7",
                                "text": "Les impressionnistes cherchaient la matière de la neige et non sa béance."
                            },
                            {
                                "example_id": "4d064469-8364-4d97-b109-71d2c54bc9d1",
                                "sense_id": "87ea9beb-f5f0-3c3a-884e-03e4176ecbc7",
                                "text": "La pornographie mainstream comporte quantité de ces scènes post-coïtales de béance, et s'y complaît – c'est un mot clé à succès."
                            }
                        ]
                    }
                ],
