                "senses": [
                    {
                        "sense_id": "4ea43656-df0b-37bc-9596-e36166780389",
                        "entry_id": "405ece34-747d-36cf-89ab-2b8472447f75",
                        "glosses": [
                            "Befragung einer Personengruppe, die der Repräsentation der Meinung dieser Personengruppe dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b625a17d-0530-4f3a-bf74-f9e96d665e65",
                                "sense_id": "4ea43656-df0b-37bc-9596-e36166780389",
                                "text": "„Aus einer Repräsentativbefragung unter rund 3000 Bundesbürgern ab 14 Jahre geht hervor, dass die ARD demnach die besten Krimis bietet, gefolgt vom ZDF.“"
                            },
                            {
                                "example_id": "baab106c-e10d-412b-9b17-d12211f6a81c",
                                "sense_id": "4ea43656-df0b-37bc-9596-e36166780389",
                                "text": "„bei vielen Fragen, die das Allensbacher Institut in einer Repräsentativbefragung mit rund 2000 Interviews im März 1985 zum Thema der Kapitulation stellte, muß man die Antworten für Männer und Frauen trennen.“"
                            },
                            {
                                "example_id": "78aa5128-d677-46ac-b1c4-83008bb36edb",
                                "sense_id": "4ea43656-df0b-37bc-9596-e36166780389",
                                "text": "„Eine Repräsentativbefragung von 120 Deutschschweizer Jugendlichen hat schon 1993 ergeben, dass in der Regel bis zu fünf Sendungen parallel geschaut werden.“"
                            },
                            {
                                "example_id": "1a8018b8-955f-49ee-b2c9-ccd64c9118e4",
                                "sense_id": "4ea43656-df0b-37bc-9596-e36166780389",
                                "text": "„Als Grundlage ist zwar eine aufwendige Repräsentativbefragung durchgeführt worden.“"
                            },
                            {
                                "example_id": "f49308c8-da74-400b-919b-975afed3438b",
                                "sense_id": "4ea43656-df0b-37bc-9596-e36166780389",
                                "text": "„Nach einer Repräsentativbefragung deutscher Unternehmen aller Größenklassen, über die das Magazin \"Focus\" in seiner aktuellen Ausgabe berichtet, kennen überhaupt nur 18 Prozent den Begriff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
