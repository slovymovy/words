                "senses": [
                    {
                        "sense_id": "85bfcf4b-f46f-3f11-b970-1e1a5ffa9a1d",
                        "entry_id": "cb5cd691-46f5-3392-8541-07e1db87b396",
                        "glosses": [
                            "ein Wort mit allen seinen Bestandteilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6abbb58-a059-4de3-b65f-ed1ef28cd1af",
                                "sense_id": "85bfcf4b-f46f-3f11-b970-1e1a5ffa9a1d",
                                "text": "„Was haben erkennbare Bestandteile mit der Bedeutung des Gesamtwortes zu tun?“"
                            },
                            {
                                "example_id": "57a6ae8d-d75a-4be5-b868-455dab5e60c5",
                                "sense_id": "85bfcf4b-f46f-3f11-b970-1e1a5ffa9a1d",
                                "text": "„Hierzu muß der Benutzer als Sprachäußerung in zeitlich aufeinanderfolgenden Spracheingaben sowohl das Gesamtwort des gewünschten Listenelements als auch mindestens ein Anfangszeichen des gewünschten Listenelements benennen.“"
                            },
                            {
                                "example_id": "ca49045b-ee85-494b-8b65-9f626e16418f",
                                "sense_id": "85bfcf4b-f46f-3f11-b970-1e1a5ffa9a1d",
                                "text": "„Das geht sogar so weit, dass man gerne das kleine Wörtchen \"unter\" aus dem Gesamtwort streicht.“"
                            },
                            {
                                "example_id": "ee465415-6cf1-4f0e-a3ef-f1d76448368c",
                                "sense_id": "85bfcf4b-f46f-3f11-b970-1e1a5ffa9a1d",
                                "text": "„Orthographisch sind sie mit dem Stamm fest zusammengewachsen; d. h. das Gesamtwort stellt sich als ununterbrochene Buchstabenfolge dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
