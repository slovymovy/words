{
    "word_family": [
        "complication",
        "décompliquer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72c4cd3d-c830-3fbd-ad01-22671b68f072",
                    "sense_definition": "Rendre confus, embrouillé ou difficile à comprendre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comprendre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pourquoi veux-tu toujours <w>compliquer</w> les choses avec des explications inutiles ?"
                        },
                        {
                            "text": "Son explication confuse ne fait que <w>compliquer</w> la compréhension du problème."
                        }
                    ],
                    "synonyms": [
                        "embrouiller",
                        "obscurcir"
                    ],
                    "antonyms": [
                        "éclairer",
                        "simplifier"
                    ],
                    "common_phrases": [
                        "compliquer les choses",
                        "compliquer la tâche"
                    ]
                },
                {
                    "sense_id": "efa1c132-d6e0-3cbc-8372-14b4727c4d43",
                    "sense_definition": "Aggraver ou rendre une situation plus pénible et délicate.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aggraver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision imprévue risque de <w>compliquer</w> la vie de nombreux usagers."
                        },
                        {
                            "text": "Une dispute inutile ne ferait que <w>compliquer</w> la situation actuelle entre eux."
                        }
                    ],
                    "antonyms": [
                        "simplifier"
                    ],
                    "common_phrases": [
                        "compliquer la vie",
                        "compliquer la situation"
                    ]
                },
                {
                    "sense_id": "b3526cc4-30ef-3935-8395-de8b4074b188",
                    "sense_definition": "Rendre un ensemble ou une structure plus complexe en multipliant les éléments ou les rapports.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ingénieur a préféré ne pas <w>compliquer</w> le mécanisme de cette machine."
                        },
                        {
                            "text": "Ajouter trop de fonctions risque de <w>compliquer</w> la structure du logiciel."
                        }
                    ],
                    "synonyms": [
                        "complexifier"
                    ],
                    "antonyms": [
                        "décompliquer",
                        "simplifier"
                    ]
                }
            ]
        }
    ]
