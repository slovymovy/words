                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0e642c4-0ae4-3e59-a402-bbe5aa5fa456",
                                        "entry_id": "b8da4f7a-0c21-32dd-8476-e857af4a79e6",
                                        "glosses": [
                                            "A network of computers that can only be accessed using special software, configuration, or authorization, usually characterized by the anonymization of users, participating hosts, or both."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ef67b85-f840-493c-bf02-e959885dbf96",
                                                "sense_id": "c0e642c4-0ae4-3e59-a402-bbe5aa5fa456",
                                                "text": "Despite all the openness of the Internet, there are still places you cannot saunter into on the Web. You must be invited. These are “darknets”: exclusive peer-to-peer networks in which membership is based on circles of trust, whose activities are veiled from the general public."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87b39c90-42eb-44e8-b0f5-23b34ed63be2",
                        "source_entry_id": "7feaf071-a447-3696-aeb4-3531ad60b75c",
                        "source_sense_id": "05252249-fe72-36ec-8d50-66f45b8845d2",
                        "source_sense_description": "Bereich des Internet, der nur erschwert zugänglich ist",
                        "target_lang_word": "darknet",
                        "target_lang_code": "fr",
