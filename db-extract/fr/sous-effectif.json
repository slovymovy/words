                                "example_id": "03397217-947e-4b07-8b24-582311acf29a",
                                "sense_id": "38ca4260-fe52-399e-ae52-1730c3ef6c15",
                                "text": "Avec les carnets de commandes ultraremplis, l’entreprise est en sous-effectifs."
