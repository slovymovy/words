    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aef5bf92-2e3d-3f92-8800-563f929fa2d9",
                    "sense_definition": "A close-fitting hat, either brimless or peaked.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "headwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were all wearing <w>caps</w> to protect them from the sun.",
                            "target_lang_translations": {
                                "ru": "Все дети были в <w>кепках</w>, чтобы защититься от солнца."
                            }
                        },
                        {
                            "text": "He put on a baseball <w>cap</w> before heading out to the park.",
                            "target_lang_translations": {
                                "ru": "Он надел <w>бейсболку</w> перед тем, как отправиться в парк."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baseball cap",
                        "wear a cap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно прилегающий головной убор, без полей или с козырьком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кепка",
                                "target_lang_sense_clarification": "с козырьком"
                            },
                            {
                                "target_lang_word": "шапка",
                                "target_lang_sense_clarification": "общий термин для мягких головных уборов"
                            },
                            {
                                "target_lang_word": "бейсболка",
                                "target_lang_sense_clarification": "спортивная кепка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b45b2f6-410d-3f00-be00-cb953da55762",
                    "sense_definition": "A protective cover or seal for a container or object.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took the <w>cap</w> off the bottle and splashed himself with some cologne.",
                            "target_lang_translations": {
                                "ru": "Он снял <w>крышку</w> с флакона и брызнул на себя одеколоном."
                            }
                        },
                        {
                            "text": "Make sure to replace the bottle <w>cap</w> so the liquid doesn't spill.",
                            "target_lang_translations": {
                                "ru": "Обязательно закрой <w>крышку</w> бутылки, чтобы жидкость не пролилась."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bottle cap",
                        "lens cap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защитная крышка или уплотнение для контейнера или объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крышка",
                                "target_lang_sense_clarification": "для бутылок или банок"
                            },
                            {
                                "target_lang_word": "колпачок",
                                "target_lang_sense_clarification": "для ручек, объективов или мелких предметов"
                            },
                            {
                                "target_lang_word": "пробка",
                                "target_lang_sense_clarification": "затычка для сосуда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80e24435-d556-35c3-8398-30771002e1e3",
                    "sense_definition": "An artificial upper limit or ceiling, often regarding money or prices.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We should put a <w>cap</w> on the salaries, to keep them under control.",
                            "target_lang_translations": {
                                "ru": "Нам следует установить <w>потолок</w> зарплат, чтобы держать их под контролем."
                            }
                        },
                        {
                            "text": "The government decided to impose a price <w>cap</w> on essential goods.",
                            "target_lang_translations": {
                                "ru": "Правительство решило ввести <w>ограничение</w> цен на товары первой необходимости."
                            }
                        }
                    ],
                    "antonyms": [
                        "floor"
                    ],
                    "common_phrases": [
                        "price cap",
                        "salary cap",
                        "put a cap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусственный верхний предел или потолок, часто в отношении денег или цен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничение",
                                "target_lang_sense_clarification": "верхний предел"
                            },
                            {
                                "target_lang_word": "потолок",
                                "target_lang_sense_clarification": "максимально допустимый уровень"
                            },
                            {
                                "target_lang_word": "кэп",
                                "target_lang_sense_clarification": "финансовый термин для процентных ставок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e96b00e8-707e-375b-aba2-b01021a2c4b8",
                    "sense_definition": "The summit or top part of something, like a mountain or a mushroom.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was snow on the <w>cap</w> of the mountain even in summer.",
                            "target_lang_translations": {
                                "ru": "Даже летом на <w>вершине</w> горы лежал снег."
                            }
                        },
                        {
                            "text": "The biologist carefully examined the mushroom <w>cap</w> for identification.",
                            "target_lang_translations": {
                                "ru": "Биолог внимательно изучил <w>шляпку</w> гриба для идентификации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ice cap",
                        "mushroom cap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхушка или верхняя часть чего-либо, например, горы или гриба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вершина",
                                "target_lang_sense_clarification": "горы или холма"
                            },
                            {
                                "target_lang_word": "шляпка",
                                "target_lang_sense_clarification": "гриба"
                            },
                            {
                                "target_lang_word": "шапка",
                                "target_lang_sense_clarification": "снежная или ледяная на вершине"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa3734b6-7372-3648-9fca-6b9cf15e5741",
                    "sense_definition": "An appearance in an international game for a national sports team.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rio Ferdinand won his 50th <w>cap</w> for England in a game against Sweden.",
                            "target_lang_translations": {
                                "ru": "Рио Фердинанд провел свой 50-й <w>матч</w> за сборную Англии в игре против Швеции."
                            }
                        },
                        {
                            "text": "The young player was thrilled to earn his first international <w>cap</w>.",
                            "target_lang_translations": {
                                "ru": "Молодой игрок был в восторге от своего первого <w>вызова</w> в сборную."
                            }
                        }
                    ],
                    "common_phrases": [
                        "win a cap",
                        "international cap"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English sports context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступление в международном матче за национальную спортивную сборную."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "матч",
                                "target_lang_sense_clarification": "за сборную"
                            },
                            {
                                "target_lang_word": "выход",
                                "target_lang_sense_clarification": "на поле в составе сборной"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fb2b7e2-6533-3da2-b304-9d9c7f1e9550",
                    "sense_definition": "A lie, exaggeration, or false statement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'm telling the truth, no <w>cap</w>, I actually saw him there.",
                            "target_lang_translations": {
                                "ru": "Я говорю правду, <w>без вранья</w>, я действительно видел его там."
                            }
                        },
                        {
                            "text": "Everything he just said is total <w>cap</w> and nobody believes him.",
                            "target_lang_translations": {
                                "ru": "Все, что он только что сказал — полная <w>чушь</w>, и никто ему не верит."
                            }
                        }
                    ],
                    "common_phrases": [
                        "no cap",
                        "that is cap"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Modern youth slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ложь, преувеличение или ложное утверждение (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ложь",
                                "target_lang_sense_clarification": "вранье"
                            },
                            {
                                "target_lang_word": "гонево",
                                "target_lang_sense_clarification": "сленг, неправда"
                            },
                            {
                                "target_lang_word": "брехня",
                                "target_lang_sense_clarification": "разговорное, ложь"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "880bc9d6-3b93-3d2f-9309-dd2052a60912",
                    "sense_definition": "To cover or seal something with a cap.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cover_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>cap</w> the pen when you are finished so it doesn't dry out.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>закрой</w> ручку колпачком, когда закончишь, чтобы она не высохла."
                            }
                        },
                        {
                            "text": "The workers had to <w>cap</w> the well to prevent any further leaks.",
                            "target_lang_translations": {
                                "ru": "Рабочим пришлось <w>загерметизировать</w> скважину, чтобы предотвратить дальнейшие утечки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cap the pen",
                        "cap the bottle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Накрыть или запечатать что-либо крышкой или колпачком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрывать",
                                "target_lang_sense_clarification": "крышкой или колпачком"
                            },
                            {
                                "target_lang_word": "накрывать",
                                "target_lang_sense_clarification": "сверху"
                            },
                            {
                                "target_lang_word": "закупоривать",
                                "target_lang_sense_clarification": "плотно закрывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "695d9e91-8141-3f5b-b0da-505996c9725e",
                    "sense_definition": "To set or reach an upper limit on something, such as spending or capacity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limit_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>cap</w> wages for the next fiscal year.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>ограничить</w> рост зарплат на следующий финансовый год."
                            }
                        },
                        {
                            "text": "They had to <w>cap</w> spending to avoid going over the budget.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>лимитировать</w> расходы, чтобы не выйти за рамки бюджета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cap spending",
                        "cap prices"
                    ],
                    "target_lang_definitions": {
                        "ru": "Установить или достичь верхнего предела чего-либо, например, расходов или мощности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничивать",
                                "target_lang_sense_clarification": "устанавливать предел"
                            },
                            {
                                "target_lang_word": "лимитировать",
                                "target_lang_sense_clarification": "вводить лимит"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e0d4ed8-8e40-3b4c-9a64-c2650e91f316",
                    "sense_definition": "To conclude or finish something, often in a way that makes it even better or worse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A beautiful sunset <w>capped</w> a perfect day at the beach.",
                            "target_lang_translations": {
                                "ru": "Прекрасный закат <w>увенчал</w> идеальный день на пляже."
                            }
                        },
                        {
                            "text": "To <w>cap</w> it all off, my car wouldn't start when I tried to leave.",
                            "target_lang_translations": {
                                "ru": "В <w>завершение</w> ко всему, моя машина не завелась, когда я собрался уезжать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cap it off",
                        "cap the day"
                    ],
                    "target_lang_definitions": {
                        "ru": "Завершить или закончить что-либо, часто таким образом, что делает это еще лучше или хуже."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увенчать",
                                "target_lang_sense_clarification": "стать достойным завершением"
                            },
                            {
                                "target_lang_word": "завершить",
                                "target_lang_sense_clarification": "поставить точку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4775a14-692a-3030-99ee-868a670ed306",
                    "sense_definition": "To shoot someone with a firearm.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gangster threatened to <w>cap</w> anyone who talked to the police.",
                            "target_lang_translations": {
                                "ru": "Гангстер угрожал <w>пристрелить</w> любого, кто заговорит с полицией."
                            }
                        },
                        {
                            "text": "He was afraid someone might <w>cap</w> him if he entered that neighborhood.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что его могут <w>завалить</w>, если он зайдет в тот район."
                            }
                        }
                    ],
                    "synonyms": [
                        "pop a cap in someone's ass"
                    ],
                    "common_phrases": [
                        "cap someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in urban or criminal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Застрелить кого-либо из огнестрельного оружия (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пристрелить",
                                "target_lang_sense_clarification": "убить из оружия"
                            },
                            {
                                "target_lang_word": "шлепнуть",
                                "target_lang_sense_clarification": "сленг, убить"
                            },
                            {
                                "target_lang_word": "завалить",
                                "target_lang_sense_clarification": "криминальный жаргон"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "de09ddfb-bd0f-378a-877c-f3c39c0a0a62",
                    "sense_definition": "A nickname for the captain of a team, ship, or group.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nickname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "\"But listen, <w>Cap</w>!\" he protested, falling out of his role as midshipman.",
                            "target_lang_translations": {
                                "ru": "«Но послушайте, <w>Кэп</w>!» — запротестовал он, выходя из роли мичмана."
                            }
                        },
                        {
                            "text": "The players always looked to <w>Cap</w> for leadership during the game.",
                            "target_lang_translations": {
                                "ru": "Игроки всегда ждали от <w>Кэпа</w> лидерства во время игры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hey Cap",
                        "listen Cap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a friendly or respectful address"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозвище капитана команды, корабля или группы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кэп",
                                "target_lang_sense_clarification": "сокращение от капитан"
                            },
                            {
                                "target_lang_word": "командир",
                                "target_lang_sense_clarification": "обращение к лидеру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7654f58-e48c-3659-b62c-478a6b128247",
                    "sense_definition": "Initialism of the Common Agricultural Policy of the European Union.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "policy",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>CAP</w> budget will have to be increased if more countries join the EU.",
                            "target_lang_translations": {
                                "ru": "Бюджет <w>ЕСХП</w> придется увеличить, если к ЕС присоединится больше стран."
                            }
                        },
                        {
                            "text": "Farmers across Europe are affected by changes to the <w>CAP</w> regulations.",
                            "target_lang_translations": {
                                "ru": "Фермеры по всей Европе затронуты изменениями в правилах <w>ЕСХП</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the CAP budget"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Acronym/Initialism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единая сельскохозяйственная политика Европейского союза."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ЕСХП",
                                "target_lang_sense_clarification": "аббревиатура политики ЕС"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}