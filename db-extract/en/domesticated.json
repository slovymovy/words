                        "sense_id": "a55049a3-ffcd-3fd0-a3ca-6d486d698dd8",
                        "entry_id": "df4145ec-bab9-3e81-bb58-a59193c1c143",
                        "glosses": [
                            "Selectively bred to live with or around humans. (of an animal or a plant, especially a pet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baf450a4-0e29-47d8-90a7-33e7157d2c19",
                                "sense_id": "a55049a3-ffcd-3fd0-a3ca-6d486d698dd8",
                                "text": "But I can take the calves and learn them to work and give milk, and learn them to become domesticated and useful."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a30b9d6a-32a6-400e-850b-ed2db28aa242",
                        "source_entry_id": "df4145ec-bab9-3e81-bb58-a59193c1c143",
                        "source_sense_id": "a55049a3-ffcd-3fd0-a3ca-6d486d698dd8",
                        "source_sense_description": "selectively bred to live with or around humans",
                        "target_lang_word": "domestiqué",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "domestiqué",
