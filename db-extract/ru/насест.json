                            {
                                "target_word": "perch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23963bef-0057-3159-ae39-7c72fe606310",
                                        "entry_id": "fcfb7376-38cb-3707-b253-1e804ace5def",
                                        "glosses": [
                                            "To rest on a perch (especially, of a bird); to roost."
                                        ],
                                        "tags": [
