                                    {
                                        "sense_id": "6ea48d41-17ca-3c4a-919d-3ad708ab7bd2",
                                        "entry_id": "2ae0682b-cb38-395e-956b-e3c7914ccae7",
                                        "glosses": [
                                            "A variety of short-grain rice popular in Southeast and East Asia, known for its stickiness when cooked."
                                        ],
