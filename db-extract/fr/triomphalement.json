        "fr-extract.jsonl": [
            {
                "entry_id": "92de92da-02ae-39b6-9fb4-fbd166d2cbdc",
                "word": "triomphalement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8e8d03d1-46bd-320b-9b48-de3dd6831fa3",
                        "entry_id": "92de92da-02ae-39b6-9fb4-fbd166d2cbdc",
                        "glosses": [
                            "En triomphe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a60c846f-e2f9-40cf-bed1-9a9057c0c8e6",
                                "sense_id": "8e8d03d1-46bd-320b-9b48-de3dd6831fa3",
                                "text": "Ces misérables, enivrés de vin et du succès de leurs crimes, ne daignaient plus se cacher ; ils parcouraient triomphalement ces rues embrasées [de Moscou],"
                            },
                            {
                                "example_id": "a7174d57-2e77-40ee-933e-019ba9716f22",
                                "sense_id": "8e8d03d1-46bd-320b-9b48-de3dd6831fa3",
                                "text": "Puis, une troupe s'empare du fauteuil royal, l'emporte triomphalement et va le brûler sur la place de la Bastille ; […]."
                            },
                            {
                                "example_id": "7d135b60-96d9-4664-9d79-75d5e1715111",
                                "sense_id": "8e8d03d1-46bd-320b-9b48-de3dd6831fa3",
                                "text": "On a évoqué triomphalement des héros militaires ; des hommes ont pensé : « Et moi ! », et se sont enfiévrés, montrant ce qu’ils pensaient, […]."
                            },
                            {
                                "example_id": "0efd2727-def2-4dcc-8678-79d5388587cd",
                                "sense_id": "8e8d03d1-46bd-320b-9b48-de3dd6831fa3",
                                "text": "Les autres, les Laugier, cet homme à tête de rat, avec qui il avait bu les premiers apéritifs et qui était parti triomphalement avec la jeune Américaine, tous ces gens-là, tous ceux du Ritz, tous ceux du Fouquet’s, c'étaient des peigne-cul."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
