                "word": "affilée",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c5ae7e4f-b68d-35b5-986b-6756cf587f65",
                        "entry_id": "5e24988e-e5eb-30ca-9758-15add78b5989",
                        "glosses": [
                            "Participe passé féminin singulier du verbe affiler."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "79343e74-669c-466d-9de2-85388fc554fd",
                                "sense_id": "c5ae7e4f-b68d-35b5-986b-6756cf587f65",
                                "text": "Avoir la langue bien affilée : Quelqu’un qui parle facilement et beaucoup, qui a du babil."
                            },
                            {
                                "example_id": "7f48afe5-a798-40b1-9339-fa7e80a16263",
                                "sense_id": "c5ae7e4f-b68d-35b5-986b-6756cf587f65",
                                "text": "Cette femme a la langue bien affilée : Se dit surtout d’une personne médisante."
                            },
                            {
                                "example_id": "6d132570-58b0-4460-a58b-19c8c3d308f6",
                                "sense_id": "c5ae7e4f-b68d-35b5-986b-6756cf587f65",
                                "text": "S’emploie comme nom dans la locution adverbiale « d’affilée », signifiant « à la suite, sans interruption »."
                            },
                            {
                                "example_id": "10c5d874-c7b6-474c-8daa-ac5f06c9980f",
                                "sense_id": "c5ae7e4f-b68d-35b5-986b-6756cf587f65",
                                "text": "\"Ensemble nous avons réussi à obtenir un troisième mandat majoritaire d'affilée\", a déclaré M. Ford lors de son discours de la victoire."
                            },
                            {
                                "example_id": "a70a7a32-8280-4aae-9d20-18ec41384ec0",
                                "sense_id": "c5ae7e4f-b68d-35b5-986b-6756cf587f65",
                                "text": "Il a fait sa besogne d’affilée"
                            },
                            {
                                "example_id": "dc1e137b-ab1f-41ba-afe3-1c0929e0b2d7",
                                "sense_id": "c5ae7e4f-b68d-35b5-986b-6756cf587f65",
                                "text": "D’une affilée."
                            }
                        ]
                    }
