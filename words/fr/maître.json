    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cac0ef76-674c-3e45-8f90-c6e8412531ca",
                    "sense_definition": "Enseignant qui fait la classe aux enfants dans une école primaire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "enseignement et expertise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>maître</w> de ma fille explique chaque leçon avec beaucoup de patience."
                        },
                        {
                            "text": "Les enfants écoutent leur <w>maître</w> en silence dans la classe."
                        }
                    ],
                    "synonyms": [
                        "instituteur",
                        "enseignant"
                    ],
                    "antonyms": [
                        "élève"
                    ],
                    "common_phrases": [
                        "maître d'école"
                    ]
                },
                {
                    "sense_id": "28cad73f-a3eb-32da-8808-07ed4c3fcefe",
                    "sense_definition": "Personne à qui appartient un animal domestique et qui s'en occupe.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "autorité et possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien attend son <w>maître</w> devant la porte de la maison."
                        },
                        {
                            "text": "Mon voisin est le <w>maître</w> de ce petit chat noir."
                        }
                    ],
                    "synonyms": [
                        "propriétaire"
                    ],
                    "common_phrases": [
                        "maître du chien"
                    ]
                },
                {
                    "sense_id": "fd5d64f0-6ce7-322e-86c8-e35e610ebee2",
                    "sense_definition": "Personne qui exerce son autorité sur d'autres personnes ou sur une situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "autorité et possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>maître</w> de maison accueille les invités avec le sourire."
                        },
                        {
                            "text": "Dans cette équipe, personne n'est vraiment le <w>maître</w> du jeu."
                        },
                        {
                            "text": "Malgré la tempête, le capitaine est resté le <w>maître</w> de la situation."
                        }
