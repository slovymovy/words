                "senses": [
                    {
                        "sense_id": "49f029b3-1176-34e2-bdd7-3bec7ab28087",
                        "entry_id": "4d3da9b0-c201-3d68-a867-5f8b57dd287f",
                        "glosses": [
                            "Thron mit zwei Pfauenabbildungen auf der Spitze, der ursprünglich für die Herrscher des Mogulreichs gebaut wurde und heute als verschollen gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e8660b9-6814-436b-8e22-3535543fdb8d",
                                "sense_id": "49f029b3-1176-34e2-bdd7-3bec7ab28087",
                                "text": "Shah Jahan (1592–1666) war der erste Mogul, der auf dem Pfauenthron saß."
                            },
                            {
                                "example_id": "fdba9932-9f8b-400f-8a7c-8d71d06531b5",
                                "sense_id": "49f029b3-1176-34e2-bdd7-3bec7ab28087",
                                "text": "„Er raubte den berühmten Pfauenthron der Großmoguln und viele ihrer Schätze und zog sich mit seiner Beute wieder nach Persien zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "269fe2f6-0600-3a89-9eae-a44def3b22ca",
                        "entry_id": "4d3da9b0-c201-3d68-a867-5f8b57dd287f",
                        "glosses": [
                            "von Fath Ali Schah in Auftrag gegebener und von nachfolgenden persischen Herrschern verwendeter Thron"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6d22459-3112-463d-8b97-62f5ae04474b",
                                "sense_id": "269fe2f6-0600-3a89-9eae-a44def3b22ca",
                                "text": "Trotz seines Namens enthält der Pfauenthron keine Darstellung von Pfauen."
                            },
                            {
                                "example_id": "669593a0-b5e3-4ce3-b47e-87f143f63f2a",
                                "sense_id": "269fe2f6-0600-3a89-9eae-a44def3b22ca",
                                "text": "Seit 1980 ist der Pfauenthron in Teheran im Kronjuwelenmuseum der Nationalbank ausgestellt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
