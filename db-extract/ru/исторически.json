                        "cross_references": [
                            {
                                "target_word": "históricamente",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9cfac451-32e9-3da7-8b72-54a3cb06af76",
                                        "entry_id": "57bdf654-96c9-327e-9f71-c1b7ce8692fc",
                                        "glosses": [
                                            "De modo histórico; según o con base en la historia, la trayectoria o el historial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccfb2d63-a1ef-462e-a70e-0d668d4c800e",
                                                "sense_id": "9cfac451-32e9-3da7-8b72-54a3cb06af76",
                                                "text": "Los individuos operan dentro de los límites de lo que les es históricamente posible. Y lo que es históricamente posible para un individuo está en función de los sistemas de lenguaje a que pertenece"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51e9d802-a710-4880-91da-fcefd5dd0b1e",
                        "source_entry_id": "cd06f783-d5b4-32c7-a16c-9507211922f6",
                        "source_sense_id": "22eb1598-4b04-3d2d-8b17-a4c24825293e",
                        "target_lang_word": "historisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "historisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ffc50c6-75ff-3de0-a499-07507713c179",
                                        "entry_id": "c47bbc9a-843e-35f9-b9b3-2510b021c500",
                                        "glosses": [
                                            "die Geschichte betreffend, sich auf Geschichte beziehend, in der Art und Weise, wichtig für die Geschichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cddf72a-6253-45bc-91da-e466fb5375fe",
                                                "sense_id": "6ffc50c6-75ff-3de0-a499-07507713c179",
                                                "text": "Dies ist ein historischer Moment."
                                            },
                                            {
                                                "example_id": "d6a3c44a-15b0-4235-8e97-7e3df71b520f",
                                                "sense_id": "6ffc50c6-75ff-3de0-a499-07507713c179",
                                                "text": "Für den im Mittelalter spielenden Film werden historische Kostüme benötigt."
                                            },
                                            {
                                                "example_id": "33dcf89e-0392-469d-9b3b-d8ecbe292a20",
                                                "sense_id": "6ffc50c6-75ff-3de0-a499-07507713c179",
                                                "text": "Das wohl historischste Ereignis 1989, wenn man so sagen will, war der Mauerfall."
                                            },
                                            {
                                                "example_id": "bbb8e2d8-f504-4afd-b051-aefd43d16d34",
                                                "sense_id": "6ffc50c6-75ff-3de0-a499-07507713c179",
                                                "text": "„Geduldig setzte der Führer seinen Militärs auseinander, wie der große König ein enormes Risiko eingegangen sei, und wie sich plötzlich, gleichsam als Belohnung für so viel Wagemut, ein unvorhersehbares historisches Ereignis eingestellt habe.“"
                                            },
                                            {
                                                "example_id": "791f8bbe-b1f2-4c4f-92a6-5523e3e07c83",
                                                "sense_id": "6ffc50c6-75ff-3de0-a499-07507713c179",
                                                "text": "„Es gibt ganz konkrete historische Gründe dafür, dass Ostdeutschland bis heute erst gute zwei Drittel der westdeutschen Wirtschaftskraft erreicht.“"
                                            },
                                            {
                                                "example_id": "ba7c6959-f747-4c99-8bae-d33d3c2e69b8",
                                                "sense_id": "6ffc50c6-75ff-3de0-a499-07507713c179",
                                                "text": "„Die Basketballerinnen aus Frankreich haben bei der EM die Schweiz mit einer historischen Niederlage nach Hause geschickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dfae2b5c-cfb6-3202-a649-f0b97f3be064",
                                        "entry_id": "c47bbc9a-843e-35f9-b9b3-2510b021c500",
                                        "glosses": [
                                            "einer früheren Geschichtsepoche angehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9951330e-207a-495b-accf-e46f078db9a2",
                                                "sense_id": "dfae2b5c-cfb6-3202-a649-f0b97f3be064",
                                                "text": "Der historische Name von Eisenhüttenstadt war Stalinstadt."
                                            },
                                            {
                                                "example_id": "b1b9e42f-d06f-4081-811f-9a1017227b8a",
                                                "sense_id": "dfae2b5c-cfb6-3202-a649-f0b97f3be064",
                                                "text": "„Die häufigsten Brandursachen in historischen Gebäuden sind Brandstiftungen, die in den letzten Jahrzehnten deutlich zugenommen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "69e08af6-9458-35bd-afa0-6928a3e10434",
                                        "entry_id": "c47bbc9a-843e-35f9-b9b3-2510b021c500",
                                        "glosses": [
                                            "für die (zukünftige) Geschichte bedeutsam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aaad089-1f51-4f5b-a48e-584d05609fcd",
                                                "sense_id": "69e08af6-9458-35bd-afa0-6928a3e10434",
                                                "text": "„Wir leben in historischen Zeiten!“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
