                "senses": [
                    {
                        "sense_id": "dcf6497d-045b-321b-9d66-c55c498c38c3",
                        "entry_id": "1ea0d829-aee5-3660-832c-997b62958e43",
                        "glosses": [
                            "geheel geluidloos, uiterst kalm en rustig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc85231b-e49c-436a-a009-1ffdf2eda33b",
                                "sense_id": "dcf6497d-045b-321b-9d66-c55c498c38c3",
                                "text": "Op zondag was het doodstil in het dorp; je ging naar de kerk, op familiebezoek of een eindje wandelen, want op de dag des Heren mocht niet worden gefietst."
                            },
                            {
                                "example_id": "6f8d21fc-5100-4e5e-abdf-c0728b3d30d2",
                                "sense_id": "dcf6497d-045b-321b-9d66-c55c498c38c3",
                                "text": "Het werd doodstil in de zaal."
                            },
                            {
                                "example_id": "61d57acf-e747-4654-b8d1-1ceefbc08b3f",
                                "sense_id": "dcf6497d-045b-321b-9d66-c55c498c38c3",
                                "text": "Het is doodstil aan de andere kant van de lijn."
                            },
                            {
                                "example_id": "0c717aaf-a397-482d-af16-cb91cd635382",
                                "sense_id": "dcf6497d-045b-321b-9d66-c55c498c38c3",
                                "text": "In de doodstille kamer kon je een speld horen vallen."
                            },
                            {
                                "example_id": "24fc84d1-791f-4bf9-8852-58d0b7f727eb",
                                "sense_id": "dcf6497d-045b-321b-9d66-c55c498c38c3",
                                "text": "Er schoot een stoot adrenaline door mijn lijf en ik bleef doodstil staan. Mijn gedachten flitsten naar de Youtube-filmpjes die ik had bekeken over wat je moet doen bij een bear encounter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1958af53-4c30-432e-b80a-6f452d6999bd",
                        "source_entry_id": "1ea0d829-aee5-3660-832c-997b62958e43",
                        "source_sense_id": "dcf6497d-045b-321b-9d66-c55c498c38c3",
