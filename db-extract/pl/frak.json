                                "target_senses": [
                                    {
                                        "sense_id": "e17dc312-3d56-3f86-97b4-58523df8ee03",
                                        "entry_id": "405225c4-039a-32d6-bc18-3d2d842f6922",
                                        "glosses": [
                                            "The most formal kind of eveningwear for men, consisting of an evening tailcoat, trousers with strips of braid down the side seams, white stiff-fronted shirt, white bow tie and waistcoat with or without sash."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c419321f-8f9f-3927-b8c2-07d8d17fae4e",
                                        "entry_id": "405225c4-039a-32d6-bc18-3d2d842f6922",
                                        "glosses": [
                                            "A dress code specifying white tie for men and ball gown or evening dress for women, or, alternatively, full military dress or national costume."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c7f4850-0655-4998-802f-7bd8fb35320f",
                                                "sense_id": "c419321f-8f9f-3927-b8c2-07d8d17fae4e",
                                                "text": "You are cordially invited to dinner with His Excellency the President. Dress: White Tie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af40b6f0-1606-4c50-9257-ba852f8bbd28",
                        "source_entry_id": "5d63fa96-9d88-3e0c-985f-83599247231f",
