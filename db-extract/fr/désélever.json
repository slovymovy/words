                "senses": [
                    {
                        "sense_id": "27cc5094-6f5d-364f-9a93-fd66370e2271",
                        "entry_id": "3fb9a537-749b-389c-80bf-0e6eefbb5532",
                        "glosses": [
                            "Refaire baisser (quelque chose qui avait été élevé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0dc523-b6b4-4d9c-8690-8ccd30597513",
                                "sense_id": "27cc5094-6f5d-364f-9a93-fd66370e2271",
                                "text": "J'ai vu beaucoup d'images qui utilisent un ENTRYPOINT avec gosu pour désélever le processus à exécuter."
                            },
                            {
                                "example_id": "89e008e7-be61-4ee5-94f9-e67f7a5dc99e",
                                "sense_id": "27cc5094-6f5d-364f-9a93-fd66370e2271",
                                "text": "Comment désélever les privilèges d'un processus enfant"
                            },
                            {
                                "example_id": "4994190e-8e41-4a0f-8c8b-5eb3dd102e21",
                                "sense_id": "27cc5094-6f5d-364f-9a93-fd66370e2271",
                                "text": "Une autre alternative consiste à éplucher et à désélever manuellement les fruits, mais cela peut être un processus compliqué et coûteux. Hefestus a donc mis au point un système permettant de séparer les composants du fruit de la grenade."
                            },
                            {
                                "example_id": "2a9b633d-1f25-433c-b713-411fab65073a",
                                "sense_id": "27cc5094-6f5d-364f-9a93-fd66370e2271",
                                "text": "Microsoft Edge se désélève désormais automatiquement;"
                            }
                        ]
                    },
                    {
                        "sense_id": "645f1923-9144-3e3b-8120-2031bff6a06e",
                        "entry_id": "3fb9a537-749b-389c-80bf-0e6eefbb5532",
                        "glosses": [
                            "Se défaire de ce qu'on a appris quand on a été élevé."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "0e2b08f5-f406-4d6e-8791-a1eaf482b722",
                                "sense_id": "645f1923-9144-3e3b-8120-2031bff6a06e",
                                "text": "L’autre possibilité était que mon subconscient (peut-être des souvenirs réprimés quand je me suis « désélevé ») tentait de me révéler la localisation de la Cité des Anciens."
                            },
                            {
                                "example_id": "3d5b9569-8119-4f8e-9feb-4d070e198d3b",
                                "sense_id": "645f1923-9144-3e3b-8120-2031bff6a06e",
                                "text": "Alors qu'ils exploraient Vis Uban, il trouvèrent un Daniel désélevé et le convainquirent de revenir sur la Terre."
                            }
                        ]
                    }
