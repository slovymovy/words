    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69267b12-b9b3-3f69-8183-a496c921f478",
                    "sense_definition": "Action de déposer quelque chose, comme une candidature, une plainte ou de l'argent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commissariat a enregistré le <w>dépôt</w> de plainte de la victime ce matin."
                        },
                        {
                            "text": "La date limite pour le <w>dépôt</w> des candidatures est fixée à vendredi soir."
                        }
                    ],
                    "antonyms": [
                        "retrait"
                    ],
                    "common_phrases": [
                        "dépôt de plainte",
                        "dépôt de bilan",
                        "dépôt des candidatures"
                    ]
                },
                {
                    "sense_id": "371681c7-2365-3060-8961-f77302bf6e62",
                    "sense_definition": "Lieu ou bâtiment aménagé pour entreposer du matériel, des marchandises ou des véhicules.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chauffeurs ramènent tous les bus au <w>dépôt</w> à la fin de leur service."
                        },
                        {
                            "text": "Les ouvriers stockent les palettes de marchandises dans ce grand <w>dépôt</w>."
                        }
                    ],
                    "synonyms": [
                        "entrepôt",
                        "hangar",
                        "remise"
                    ],
                    "common_phrases": [
                        "dépôt de bus",
                        "dépôt de munitions",
                        "dépôt pétrolier"
                    ]
                },
                {
                    "sense_id": "fdf534c5-01eb-360d-8083-3ddfe3fa490a",
                    "sense_definition": "Somme d'argent ou objet de valeur confié à un tiers ou placé dans un établissement financier.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le propriétaire exige un <w>dépôt</w> de garantie avant de nous remettre les clés."
                        },
                        {
                            "text": "Ce client effectue chaque semaine un <w>dépôt</w> sur son compte d'épargne."
