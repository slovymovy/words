        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8720a717-35bf-3bfd-b7d7-b153b88a39b5",
                    "sense_definition": "Slightly wet; damp or containing moisture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wetness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soil should be kept <w>moist</w> but not soaking wet.",
                            "target_lang_translations": {
                                "ru": "Почва должна оставаться <w>влажной</w>, но не залитой водой."
                            }
                        },
                        {
                            "text": "Bake the cake until it is soft and <w>moist</w> inside.",
                            "target_lang_translations": {
                                "ru": "Выпекайте пирог, пока он не станет мягким и <w>сочным</w> внутри."
                            }
                        }
                    ],
                    "synonyms": [
                        "damp",
                        "humid"
                    ],
                    "antonyms": [
                        "dry",
                        "unmoist"
                    ],
                    "common_phrases": [
