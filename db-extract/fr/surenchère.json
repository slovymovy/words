                "forms": [
                    {
                        "form_id": "0665e460-6258-4d19-837a-fd41d54363f7",
                        "entry_id": "283a578a-0103-3ddf-b2be-fff554211167",
                        "tags": [
                            "plural"
                        ],
                        "form": "surenchères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d57d7e2-eb46-3ccb-b1a9-de7c090929f4",
                        "entry_id": "283a578a-0103-3ddf-b2be-fff554211167",
                        "glosses": [
                            "Enchère qu’on fait au-dessus d’une autre enchère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a231b90-5db8-4629-a4a5-86c226e46725",
                                "sense_id": "5d57d7e2-eb46-3ccb-b1a9-de7c090929f4",
                                "text": "Il a fait une surenchère sur moi."
                            }
                        ]
                    },
                    {
                        "sense_id": "d925ad79-9e38-3f2e-adb7-e3ab50235a68",
                        "entry_id": "283a578a-0103-3ddf-b2be-fff554211167",
                        "glosses": [
                            "Promesse plus grande, action de rivaliser de promesses ou d’être en compétition forcenée."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "da88372d-c495-4aa2-8876-2114890c59f0",
                                "sense_id": "d925ad79-9e38-3f2e-adb7-e3ab50235a68",
                                "text": "Le chœur des conversations augmente peu à peu de volume et, dans une surenchère d’efforts et d’inventivités progressive, émerge une société quelconque."
                            },
                            {
                                "example_id": "286bae4d-92b6-42b7-9b64-9d5aea8db1a7",
                                "sense_id": "d925ad79-9e38-3f2e-adb7-e3ab50235a68",
                                "text": "On a fait valoir que l’augmentation de la consommation urbaine de viande au XIXᵉ siècle pouvait provenir de la surenchère gastronomique (ou gastrolâtrique) de la bourgeoisie."
                            },
                            {
                                "example_id": "c0ad92fd-5dc0-4266-b38d-9bdbcbe8fd5d",
                                "sense_id": "d925ad79-9e38-3f2e-adb7-e3ab50235a68",
                                "text": "Mais, dans cette surenchère guerrière, le leader israélien, malgré le numéro de son nouvel ami américain, reste très isolé sur la scène internationale."
                            },
                            {
                                "example_id": "c5a8f52b-3e92-4171-ba90-b885872a95c9",
                                "sense_id": "d925ad79-9e38-3f2e-adb7-e3ab50235a68",
                                "text": "Il avait parfois honte de certains de ses confrères, de leur sensationnalisme impudique et de la surenchère dramatique de leurs mots.\n— Nous RAPPELONS (comme si les beubeus d’auditeurs l’avaient déjà oublié) que DEUX femmes ont été ASSASSINÉES dans des conditions ABOMINABLES."
                            },
                            {
                                "example_id": "754c8ad5-559d-4130-83fd-c5325dfa8976",
                                "sense_id": "d925ad79-9e38-3f2e-adb7-e3ab50235a68",
                                "text": "Zapad 2021 réunit tous les ingrédients d’une surenchère assumée en matière de communication stratégique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec000eb4-c0f4-4036-964f-6c550b961db9",
                        "source_entry_id": "283a578a-0103-3ddf-b2be-fff554211167",
                        "source_sense_id": "5d57d7e2-eb46-3ccb-b1a9-de7c090929f4",
                        "source_sense_description": "Enchère qu’on fait au-dessus d’une autre enchère.",
                        "target_lang_word": "outbid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outbid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dac5e16-132d-3fe2-824e-a687d713f132",
                                        "entry_id": "b876aa91-3c14-3e0b-b169-5c794da9b271",
                                        "glosses": [
                                            "To bid more than (somebody else) in an auction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2bdb83a-e307-4a8b-a367-7109186ea7d6",
                                                "sense_id": "6dac5e16-132d-3fe2-824e-a687d713f132",
                                                "text": "Bengal outbidded those of Delhi; instead of searching for khalifahs for obtaining recognition, Sultan Sikandar Shah himself took the title .of Imam ul-Azam and Khalifat-ul-Muazzam."
                                            },
                                            {
                                                "example_id": "d133c7f3-dfde-44d1-bb50-8c67d8cff9f7",
                                                "sense_id": "6dac5e16-132d-3fe2-824e-a687d713f132",
                                                "text": "You must understand that there are people who strive and save their whole lives to acquire something, and when they are simply outbidded or outfoxed by me, it is not taken with a delicate smile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
