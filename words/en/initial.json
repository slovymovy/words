                        "beginning",
                        "original",
                        "starting",
                        "earliest",
                        "primary"
                    ],
                    "antonyms": [
                        "final"
                    ],
                    "common_phrases": [
                        "initial stage",
                        "initial reaction",
                        "initial phase",
                        "initial cost"
                    ],
                    "target_lang_definitions": {
