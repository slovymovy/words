                        "entry_id": "cac3d0a7-7b2b-36ed-b852-45dae197a169",
                        "glosses": [
                            "Traiter au mercure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a483cb2-9698-4eeb-8bcb-833f0bb36baf",
                                "sense_id": "92d1a35b-8f24-3cb8-a253-50b069a7a0de",
                                "text": "Mais on ne peut pas hydrargyriser ou iodurer un syphilitique pendant toute son existence pour empêcher l’explosion d’accidents hypothétiques qu’aucun signe saisissable ne fait pressentir."
                            }
                        ]
