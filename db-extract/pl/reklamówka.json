                "senses": [
                    {
                        "sense_id": "6dff8b79-b8b4-3813-bc3f-a13fef6688c1",
                        "entry_id": "1f2144e4-cc9f-3c9e-bafa-b47c058465b0",
                        "glosses": [
                            "plastikowa torba z nadrukiem reklamowym"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "940bc2cd-1866-4f52-ac86-84f19ecde199",
                                "sense_id": "6dff8b79-b8b4-3813-bc3f-a13fef6688c1",
                                "text": "Reklamówki są nieekologiczne, powinno się używać papierowych toreb."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c47e298c-d1ea-351c-a0be-25ceb1b19720",
                        "entry_id": "1f2144e4-cc9f-3c9e-bafa-b47c058465b0",
