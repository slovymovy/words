                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joie de vivre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9e12444-72f2-341b-b0b8-221dcb3664e3",
                                        "entry_id": "7750e7b5-3551-32d8-b5ff-d3adcbdb50e3",
                                        "glosses": [
                                            "Gaieté ou félicité profonde provenant du sentiment d’exister."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c516dce-ec6d-4361-a088-9eecede1c9de",
                                                "sense_id": "c9e12444-72f2-341b-b0b8-221dcb3664e3",
                                                "text": "— Tu as raison, petite Tien... Je suis né dans un vallon verdoyant, comme jamais ne verdoiera la jungle la plus somptueuse, et chez moi, dès que le soleil glisse ses premiers rayons par delà les collines, chacun ouvre les yeux et chante la joie de vivre, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26819a0d-9d0a-4ee1-a88b-6a371526b67b",
                        "source_entry_id": "dae86779-cdaa-32f8-b40f-ea170ae9465a",
                        "source_sense_id": "d829e3b1-781b-359e-8533-7a0f4f4f3983",
                        "source_sense_description": "Freude am Leben, positive Einstellung zum Leben",
                        "target_lang_word": "levensvreugde",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "levensvreugde",
