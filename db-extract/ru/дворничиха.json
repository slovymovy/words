                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9426c1b9-00b6-49d6-ad3a-09459b5875a5",
                                "sense_id": "cfc022a5-45c2-3b4a-aa12-6df316bf3dcf",
                                "text": "Однажды дворничиха Дуся подарила Татьяне Васильевне полведра воды, а та от благодарности и смущения заплакала."
                            },
                            {
                                "example_id": "3cad2e8e-f496-44e4-9106-79f1dcd37f96",
                                "sense_id": "cfc022a5-45c2-3b4a-aa12-6df316bf3dcf",
                                "text": "Увы, бывают времена, // когда, криклива и дурна, // во двор выходит злая дворничиха Клава."
                            }
                        ]
                    }
