                ],
                "senses": [
                    {
                        "sense_id": "5270beb9-6b04-3a49-992b-96f02f1d88f1",
                        "entry_id": "9de144b0-fc5b-354a-ac87-40218d573167",
                        "glosses": [
                            "Abteilung der Polizei zur Kontrolle/Wahrung der Sitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b001461a-3ab3-4cf3-a84d-01a13088a3a5",
                                "sense_id": "5270beb9-6b04-3a49-992b-96f02f1d88f1",
                                "text": "„Aber da ist dann doch mehr, nämlich die Rolle der Sittenpolizei, die etwas drastisch verschlimmbessert, was doch nur vage droht.“"
                            },
                            {
                                "example_id": "7ef0eab2-fadb-4bff-aea9-3363992ace70",
                                "sense_id": "5270beb9-6b04-3a49-992b-96f02f1d88f1",
                                "text": "„Nachmittags, als die Sittenpolizei kam, war ich froh, daß Marie weg war, obwohl die Tatsache, daß sie weg war, für mich äußerst peinlich wurde.“"
                            },
                            {
                                "example_id": "79619710-12b6-402f-b0e0-9cacf9f6f844",
                                "sense_id": "5270beb9-6b04-3a49-992b-96f02f1d88f1",
                                "text": "„Das Spektrum ihrer Aktivitäten reicht von einer studentisch organisierten Sittenpolizei über die Durchsetzung von Geschlechtertrennung in Lehre und Verwaltung, die Indoktrinierung von Studienanfängern bis hin zu Folter auf dem Campus und zu gewalttätigen Aktionen im öffentlichen Raum.“"
                            },
                            {
                                "example_id": "0c5a4e02-d1ff-414d-b2a3-4fe99353dc06",
                                "sense_id": "5270beb9-6b04-3a49-992b-96f02f1d88f1",
                                "text": "„Mittlerweile war die Sittenpolizei ihm auf die Spur gekommen, und binnen kurzem wurden mindestens zwanzig seiner Etablissements geschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
