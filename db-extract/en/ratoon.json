                ],
                "senses": [
                    {
                        "sense_id": "f3af57ef-04aa-30e5-bfc5-2fc7566c71ab",
                        "entry_id": "d4653da6-793d-3549-b4c2-c932a465f439",
                        "glosses": [
                            "To sprout ratoons."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ce25635d-1eec-46b3-aa14-33fde7a49604",
                                "sense_id": "f3af57ef-04aa-30e5-bfc5-2fc7566c71ab",
                                "text": "In the sugar areas to the north and south of the Colony cane has been known to \"ratoon\" for 20 to 30 years."
                            }
                        ]
                    },
                    {
                        "sense_id": "daaabd48-6c5e-3043-8007-431dba1a1538",
                        "entry_id": "d4653da6-793d-3549-b4c2-c932a465f439",
                        "glosses": [
                            "To cut a plant, especially sugar cane, so that it will produce ratoons."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c8ab1355-7875-4726-b60a-d80b9cef4b47",
                                "sense_id": "daaabd48-6c5e-3043-8007-431dba1a1538",
                                "text": "1969, M. Menzel; F. Wilson, \"Genetic Relationships in Hibiscus Sect. Furcaria,\" Brittonia, vol. 21, no. 2, p. 100,\nAttempts to propagate them by cuttings (of flowering shoots) and to ratoon the old plants in the greenhouse in November were unsuccessful."
                            }
                        ]
                    }
