                ],
                "senses": [
                    {
                        "sense_id": "4b3b5938-bf72-3f35-9930-53c23eceb7ba",
                        "entry_id": "f0ca5983-5166-3b63-8030-ab16537a1249",
                        "glosses": [
                            "Covered by dew."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "452385ab-92c8-40aa-b15c-6ff6e83d5359",
                                "sense_id": "4b3b5938-bf72-3f35-9930-53c23eceb7ba",
                                "text": "His mildly vivid dewy beam\nOf beryl to diffuse: the gleam\nWith elf-light tiniest figures lit\nOf shapely moon-fair elves who sit\nEach on a gemmy blade's curled tip\nIn circle."
                            },
                            {
                                "example_id": "0f577a2c-b9a5-41b3-87d4-2d8c771ca400",
                                "sense_id": "4b3b5938-bf72-3f35-9930-53c23eceb7ba",
                                "text": "The dewy grass was too slick for football."
                            }
                        ]
                    },
                    {
                        "sense_id": "d537477e-a039-3ac6-90bb-4f59b74a15d6",
                        "entry_id": "f0ca5983-5166-3b63-8030-ab16537a1249",
                        "glosses": [
                            "Having the quality of bearing droplets of water."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e732e8a-1478-4b4c-a0b4-4f4ad5d2156b",
                                "sense_id": "d537477e-a039-3ac6-90bb-4f59b74a15d6",
                                "text": "In the dewy fog, it was cold and damp."
                            },
                            {
                                "example_id": "22de8124-04c9-46ff-8a37-d36a83d0d18c",
                                "sense_id": "d537477e-a039-3ac6-90bb-4f59b74a15d6",
                                "text": "At midnight, in the month of June, / I stand beneath the mystic moon. / An opiate vapor, dewy, dim, / Exhales from out her golden rim"
                            }
                        ]
                    },
                    {
                        "sense_id": "b83d8bb5-9d6e-3079-8348-1505649235fd",
                        "entry_id": "f0ca5983-5166-3b63-8030-ab16537a1249",
                        "glosses": [
                            "Resembling or characteristic of dew."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1657c76a-17d7-3fc1-a9a7-742f75bceaf1",
                        "entry_id": "f0ca5983-5166-3b63-8030-ab16537a1249",
                        "glosses": [
                            "Fresh and innocent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef73dd7e-02cb-4ad8-85fa-2445ab510d7a",
                                "sense_id": "1657c76a-17d7-3fc1-a9a7-742f75bceaf1",
                                "text": "1814, 16 March, Percy Bysshe Shelley letter to Hogg, Thy Gentle Face\nThy dewy looks sink in my breast\nThy gentle words stir poison there;"
                            },
                            {
                                "example_id": "380f70ec-863c-47f3-b15e-7dec50cd4e49",
                                "sense_id": "1657c76a-17d7-3fc1-a9a7-742f75bceaf1",
                                "text": "It was unusually early for him; his whole person exhaled the charm of almost dewy freshness; […]"
                            },
                            {
                                "example_id": "e733f21e-f778-45fb-8448-c4ebfcffb684",
                                "sense_id": "1657c76a-17d7-3fc1-a9a7-742f75bceaf1",
                                "text": "Simplicity in life, simplicity in art, and a dewy freshness over all."
                            }
                        ]
                    }
                ],
