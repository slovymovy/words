                                        "examples": [
                                            {
                                                "example_id": "14e9f6cd-3afc-4d76-af68-f698ccfcc4fd",
                                                "sense_id": "cf45da32-6e21-32ea-a18b-7e68b108ba3a",
                                                "text": "The amounts involved on the investment side are significant across many proptech startups. Property tech venture capital platform PiLabs launched in 2014 and has already spent £113m backing 47 founders in the sector; […]"
                                            },
                                            {
                                                "example_id": "5f3d0da1-0369-4efa-8343-81808aa2ce88",
                                                "sense_id": "cf45da32-6e21-32ea-a18b-7e68b108ba3a",
                                                "text": "“Lisbon has several ingredients making it a unique and efficient tech ecosystem,” says Suharev, CEO of proptech company CASAFARI, listing factors such as quality of life, governmental programs designed to attract foreign entrepreneurs, and its Silicon Valley-like business mindset."
                                            }
                                        ]
                                    }
                                ]
