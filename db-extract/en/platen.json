                        "entry_id": "17f3f044-777d-38ed-80d7-94e87377d8db",
                        "glosses": [
                            "The part of a printing press which presses the paper against the type and by which the impression is made."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a331c69-ae6b-4b2a-92fe-8e7fda346f85",
                                "sense_id": "e5c91e4e-391e-37b9-b199-b8963a30dd95",
                                "text": "And the form is inked, the paper is applied, the bed is slid, and the platen is levered down and the proof is printed."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c61a2d2-05ba-3427-8bbf-b29419f286ad",
                        "entry_id": "17f3f044-777d-38ed-80d7-94e87377d8db",
                        "glosses": [
                            "The part of a typewriter or printer on which the paper rests to receive an impression."
