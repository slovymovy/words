                "senses": [
                    {
                        "sense_id": "f9a1920e-bb09-3418-9128-3eed80a506dd",
                        "entry_id": "d8b59b3a-e721-305a-8fc7-bc1e84eceeb1",
                        "glosses": [
                            "Niederlage (eines Teams oder Spielers) im Viertelfinale eines Turniers/Wettbewerbs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81a12d6a-3f14-47d7-916a-c362c5f03d6d",
                                "sense_id": "f9a1920e-bb09-3418-9128-3eed80a506dd",
                                "text": "„Dann kam die Viertelfinalniederlage gegen Griechenland.“"
                            },
                            {
                                "example_id": "07c916cd-72a5-40e6-857c-a6b4506c5f60",
                                "sense_id": "f9a1920e-bb09-3418-9128-3eed80a506dd",
                                "text": "„Cufré hatte den deutschen Verteidiger Per Mertesacker nach Argentiniens Viertelfinalniederlage bei der WM 2006 einen Tritt in die Weichteile verpasst. Cufré war in dem Spiel nicht zum Einsatz gekommen.“"
                            },
                            {
                                "example_id": "d7a208c4-78a9-41d9-9a49-b548bbf9fdba",
                                "sense_id": "f9a1920e-bb09-3418-9128-3eed80a506dd",
                                "text": "„Er holte außerdem Trainer Hervé Renard zurück, dessen vorige Amtszeit als Nationaltrainer mit einer Viertelfinalniederlage gegen Nigeria bei der Afrikameisterschaft 2010 geendet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
