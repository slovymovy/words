                        "examples": [
                            {
                                "example_id": "c3e8bb48-a9ca-4010-b48b-5951afb1955d",
                                "sense_id": "9ed7460e-c41c-35bc-a795-4929ec19b284",
                                "text": "My seatmate on the airplane snored incessantly."
                            },
                            {
                                "example_id": "0cce2898-416b-4aa6-b69b-b996fe935ed0",
                                "sense_id": "9ed7460e-c41c-35bc-a795-4929ec19b284",
                                "text": "The Buzzis' older son, Rocco, and I had been high school buddies, then roommates at BU, seatmates at Sox games."
                            },
                            {
                                "example_id": "86d388b5-29b2-40d8-a96a-e82e3fdf5e1d",
                                "sense_id": "9ed7460e-c41c-35bc-a795-4929ec19b284",
                                "text": "Last month, the cryptographer and coder known as Moxie Marlinspike was getting settled on an airplane when his seatmate, a Midwestern-looking man in his sixties, asked for help."
                            },
                            {
                                "example_id": "c831ec2a-cabb-4462-ae1e-998804731d11",
                                "sense_id": "9ed7460e-c41c-35bc-a795-4929ec19b284",
                                "text": "Several years ago, I was sitting on a flight to San Francisco, when my seatmate, a man a little older than me, struck up a conversation. Perhaps you hate it when that happens; I love it."
                            }
                        ]
