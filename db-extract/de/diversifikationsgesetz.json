                ],
                "senses": [
                    {
                        "sense_id": "9a84d4e6-1cc4-35cb-b29f-6090294033a6",
                        "entry_id": "937b3cf9-a859-3871-80bf-510deb957bc8",
                        "glosses": [
                            "Gesetz(es-Hypothese), dass die Diversifikationen sprachlicher Ausdrücke, d.h. ihre unterschiedlichen Bedeutungen oder Erscheinungsformen, einem allgemein gültigen Sprachgesetz unterliegen, das sich mathematisch ableiten (deduzieren) lässt."
                        ],
                        "tags": [
                            "Quantitative Linguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "7e7c3e7c-ea45-44fb-b75f-3fabe1adc018",
                                "sense_id": "9a84d4e6-1cc4-35cb-b29f-6090294033a6",
                                "text": "Das Diversifikationsgesetz kann auf eine Vielzahl sprachlicher Phänomene angewendet werden, z.B. auf die Häufigkeit, mit der Wörter verschiedener Länge oder unterschiedlicher Wortarten in Texten gesetzmäßig verteilt sind."
                            },
                            {
                                "example_id": "8a49dede-ce4a-4633-b75b-8655a21bb9b3",
                                "sense_id": "9a84d4e6-1cc4-35cb-b29f-6090294033a6",
                                "text": "„Das sogenannte Diversifikationsgesetz hat die formale beziehungsweise funktional-semantische Differenzierung einer Einheit zum Gegenstand (…)“"
                            },
                            {
                                "example_id": "213774f9-6422-4b8b-a682-d585341c5697",
                                "sense_id": "9a84d4e6-1cc4-35cb-b29f-6090294033a6",
                                "text": "„Bisher gibt es eine Vielzahl von Untersuchungen, die das Diversifikationsgesetz stützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
