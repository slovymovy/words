                "senses": [
                    {
                        "sense_id": "adf635c1-e908-395f-84b0-406f15b76227",
                        "entry_id": "76a2b4cd-afd5-3912-bb3f-575cdcbd8c48",
                        "glosses": [
                            "längliche, vom Aussehen an eine Zunge erinnernde Flamme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7df69d5-d51b-43ec-8776-d151c83f1916",
                                "sense_id": "adf635c1-e908-395f-84b0-406f15b76227",
                                "text": "„Das Glas der Lampe zersprang, und eine kleine Flammenzunge leckte hervor, und in diesem Moment entschied sich John Grant für die Lebenden und gegen die Toten und trug seine Frau hinaus in Sicherheit.“"
                            },
                            {
                                "example_id": "04f1d1a0-1492-48aa-b4ee-4416336d0d25",
                                "sense_id": "adf635c1-e908-395f-84b0-406f15b76227",
                                "text": "„Lodernde Flammenzungen in Rot und Orange winden sich um einstürzende Mauern, Säulen und Friese, und aus all dem schreitet eine Gestalt; sie trägt ein kleines schwarzes Kleid und wird im Herankommen immer größer.“"
                            },
                            {
                                "example_id": "21c33e7f-ea5d-4c3b-b464-f8247c1a9687",
                                "sense_id": "adf635c1-e908-395f-84b0-406f15b76227",
                                "text": "„Das Feuer war heruntergebrannt bis auf eine einzelne Flammenzunge, die fast reglos auf der Asche stand.“"
                            },
                            {
                                "example_id": "8174cd89-f517-41c6-b7d5-8f7cefdc5264",
                                "sense_id": "adf635c1-e908-395f-84b0-406f15b76227",
                                "text": "„In dem Moment, als CJ das Ende des Ganges erreichte, erscholl ein ohrenbetäubender Chor von Drachengebrüll aus dem Nistzentrum, und dann schoss zu ihrem Entsetzen eine riesige, einige Dutzend Meter lange Flammenzunge in den Himmel und erleuchtete den Korridor, in dem sie sich befanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
