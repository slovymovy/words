    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1ed7d7d4-72ef-3447-b684-4fd7eb1d7694",
                    "sense_definition": "D'une pâleur excessive, en parlant du visage ou du teint, sous l'effet de la peur, de la maladie ou d'une vive émotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visage_pale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En apprenant la mauvaise nouvelle, il est soudainement devenu <w>blême</w>."
                        },
                        {
                            "text": "Son visage <w>blême</w> trahissait une grande fatigue après cette longue nuit d'angoisse."
                        }
                    ],
                    "synonyms": [
                        "blafard",
                        "livide",
                        "pâle"
                    ],
                    "antonyms": [
                        "coloré",
                        "rubicond"
                    ],
                    "common_phrases": [
                        "devenir blême",
                        "visage blême"
                    ]
                },
                {
                    "sense_id": "de174091-100e-3de5-9cc9-9905df2b6fc8",
                    "sense_definition": "Qui est d'une couleur terne, blanchâtre, ou qui diffuse une clarté faible et sans éclat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lumiere_pale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La lueur <w>blême</w> de la lune éclairait à peine les ruines du vieux château."
                        },
                        {
                            "text": "Nous marchions dans le brouillard sous la lumière <w>blême</w> du petit matin."
                        }
                    ],
                    "synonyms": [
                        "blafard",
                        "terne"
                    ],
                    "antonyms": [
                        "éclatant",
                        "lumineux",
                        "vif"
                    ],
                    "common_phrases": [
                        "lueur blême",
                        "lumière blême"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "143dbb3a-b535-3a47-89fd-073ff895d65c",
                    "sense_definition": "Lueur blafarde ou lumière pâle et terne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lumiere_pale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les voyageurs marchaient en silence dans le <w>blême</w> de l'aube naissante."
                        },
                        {
                            "text": "Le <w>blême</w> sinistre de la nuit hivernale enveloppait complètement le village abandonné."
