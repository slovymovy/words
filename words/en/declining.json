                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай уменьшения, ухудшения или снижения; упадок",
                        "pl": "Przypadek zmniejszenia się, pogorszenia lub obniżenia wartości; spadek, upadek"
                    },
                    "translations": {
