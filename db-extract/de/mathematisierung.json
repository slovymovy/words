                "senses": [
                    {
                        "sense_id": "087a720d-121f-3a10-9ecc-f40f04fcac7a",
                        "entry_id": "9d38c1c1-ca62-31b9-bf75-ebf72b286b1e",
                        "glosses": [
                            "Beschreibung/Erfassung eines Beobachtungsbereichs mit den Mitteln der Mathematik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa138025-a166-40d1-b0d5-a98d1a42fa53",
                                "sense_id": "087a720d-121f-3a10-9ecc-f40f04fcac7a",
                                "text": "„Diese zweifache Konsequenz - neue Einsicht in vertraute Bereiche und Übertragung der Denkweise auf neue Bereiche - ist typisch für die Mathematisierung in allen Gebieten.“"
                            },
                            {
                                "example_id": "e794a18f-0549-4b65-85cb-19a645f00ddf",
                                "sense_id": "087a720d-121f-3a10-9ecc-f40f04fcac7a",
                                "text": "„Die durchgreifende Mathematisierung besonders der Naturwissenschaften, die weitgehend mathematische Behandlung ökonomischer Probleme und der ständig an Bedeutung zunehmende Einsatz von Rechenautomaten weisen der Mathematik eine wichtige Rolle zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
