                "senses": [
                    {
                        "sense_id": "dff7c7d9-0e4d-3268-800b-9db2244d321e",
                        "entry_id": "3ad65957-cf77-3b04-9ec1-3598e331fd60",
                        "glosses": [
                            "äußere, fester gebackene Hülle eines Brotes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa71e28a-5140-4649-bf8c-5706bf35c9ea",
                                "sense_id": "dff7c7d9-0e4d-3268-800b-9db2244d321e",
                                "text": "Manchmal ist mir die Brotrinde zu hart."
                            },
                            {
                                "example_id": "16536ffe-6fc6-4cac-888e-0d995624f481",
                                "sense_id": "dff7c7d9-0e4d-3268-800b-9db2244d321e",
                                "text": "„Im Schein des kleinen blauen Feuers saßen wir einander gemütlich gegenüber, während Bock die Pfanne ausleckte und die Brotrinden fraß.“"
                            },
                            {
                                "example_id": "8bd69825-b4e7-41f0-ba1b-49410127d751",
                                "sense_id": "dff7c7d9-0e4d-3268-800b-9db2244d321e",
                                "text": "„Er holte eine Brotrinde aus der Tasche.“"
                            },
                            {
                                "example_id": "bbc70dd2-8d21-4751-ade3-e0a82e69d081",
                                "sense_id": "dff7c7d9-0e4d-3268-800b-9db2244d321e",
                                "text": "„In der Tischlerwerkstatt fand ich Brotrinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
