                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14b9700b-900d-328c-a051-c94effac9e47",
                                        "entry_id": "0a8388b1-4677-3db8-9d9c-93dc07f24639",
                                        "glosses": [
                                            "Someone who roasts coffee beans; a company or place of business that does so."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab23fc04-7d7b-43c2-81fe-4182143826bd",
                                                "sense_id": "14b9700b-900d-328c-a051-c94effac9e47",
                                                "text": "Several artisanal roasters are operating in the region now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ca040d7-06b0-3bc6-b041-95cf1c8660d8",
                                        "entry_id": "0a8388b1-4677-3db8-9d9c-93dc07f24639",
                                        "glosses": [
                                            "A machine for roasting things; especially, one that roasts coffee beans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a329cd03-e1a9-4419-8a18-308dad193fa0",
                                                "sense_id": "6ca040d7-06b0-3bc6-b041-95cf1c8660d8",
                                                "text": "They've invested in large roasters with impressive stainless steel parts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d8362dd-53dc-3a8c-8063-a09de548a159",
                                        "entry_id": "0a8388b1-4677-3db8-9d9c-93dc07f24639",
                                        "glosses": [
                                            "A kitchen utensil used for roasting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c595ebc-6979-4ca2-8dfc-73eb808f5bc0",
                                                "sense_id": "0d8362dd-53dc-3a8c-8063-a09de548a159",
                                                "text": "I found a really nice roaster in the kitchenware aisle, plus a bamboo cutting board."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee0f9e5e-add4-3cad-ada3-e09e48f777ad",
                                        "entry_id": "0a8388b1-4677-3db8-9d9c-93dc07f24639",
                                        "glosses": [
                                            "A chicken, pig, etc. suitable for roasting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4da03273-693b-496a-b36d-9bd34d614537",
                                                "sense_id": "ee0f9e5e-add4-3cad-ada3-e09e48f777ad",
                                                "text": "I found a really nice roaster in the meat department, and I'm going to make some stuffing for it, too."
                                            },
                                            {
                                                "example_id": "23d8f7e9-0a2b-41b4-a6fd-f8fbc8d9d244",
                                                "sense_id": "ee0f9e5e-add4-3cad-ada3-e09e48f777ad",
                                                "text": "There is nothing I would like more than for a young wise guy or wise gal to study my teachings and learn from my experiences in order to become America's next great roaster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20e50bc2-1ba1-36ea-bb17-3510545c714d",
                                        "entry_id": "0a8388b1-4677-3db8-9d9c-93dc07f24639",
                                        "glosses": [
                                            "Someone who roasts food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12d5bbde-49b5-44c7-bf8f-962d8af4f9f0",
                                                "sense_id": "20e50bc2-1ba1-36ea-bb17-3510545c714d",
                                                "text": "Hank is just about everyone's favorite pig roaster around here. He stays pretty busy with block parties, weddings, and reunions."
                                            },
                                            {
                                                "example_id": "6703c758-74ac-4adf-89f5-68d2d87b6a87",
                                                "sense_id": "20e50bc2-1ba1-36ea-bb17-3510545c714d",
                                                "text": "[…] they [professional cooks] had as many as 25 helpers, such as saucerers, larders, roasters, pottagers, bakers, spicers, and fruiterers, not to mention spit turners and scullions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b85ff5ac-aa93-3f91-80c3-cc0bcfb58cb5",
                                        "entry_id": "0a8388b1-4677-3db8-9d9c-93dc07f24639",
                                        "glosses": [
                                            "A type of industrial furnace; especially, one that roasts ore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed39f909-366a-4296-9ff2-e27701e27c91",
                                                "sense_id": "b85ff5ac-aa93-3f91-80c3-cc0bcfb58cb5",
                                                "text": "Having been dumped out of the mine cars, the ore then moves along a conveyor to the roaster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7c30112-4c95-3a4f-9dab-b1379b71079d",
                                        "entry_id": "0a8388b1-4677-3db8-9d9c-93dc07f24639",
                                        "glosses": [
                                            "One who roasts or banters, especially as a comedy routine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e176ed5-60a8-4938-8c56-1417ea9b5ed3",
                                                "sense_id": "b7c30112-4c95-3a4f-9dab-b1379b71079d",
                                                "text": "He does standup, and he's a pretty good roaster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6615c93e-daf3-3df3-ae0a-7014b10c3d6f",
                                        "entry_id": "0a8388b1-4677-3db8-9d9c-93dc07f24639",
                                        "glosses": [
                                            "An epistellar gas giant exoplanet."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2692261-9434-4cca-800f-097d4d12dfed",
                                                "sense_id": "6615c93e-daf3-3df3-ae0a-7014b10c3d6f",
                                                "text": "Some of the earliest discoveries of exoplanets were roasters because they are the least difficult to detect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7494841-ef7d-31dd-b520-0c24aec76bbd",
                                        "entry_id": "0a8388b1-4677-3db8-9d9c-93dc07f24639",
                                        "glosses": [
                                            "An objectionable person; somebody making a fool of themselves."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2f2acee-26cd-4078-a12d-549128e55bad",
                                                "sense_id": "b7494841-ef7d-31dd-b520-0c24aec76bbd",
                                                "text": "Person A: Oh look, he's at it again. Person B: What a roaster."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
