                ],
                "translations": [
                    {
                        "translation_id": "ffb9a21b-a4ec-4d8d-82be-e55e4f8b6393",
                        "source_entry_id": "51dc06cc-6f03-311a-8d8c-43d3ef5daced",
                        "source_sense_id": "6d852753-f4b1-3ca3-9693-67811d57508f",
                        "source_sense_description": "Wirtschaft: Mehrwertsteuer, Umsatzsteuer",
                        "target_lang_word": "Mehrwertsteuer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mehrwertsteuer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "572050eb-ca06-3096-af28-9beb98167eeb",
                                        "entry_id": "6c8af57a-f178-37ff-98e7-2adea162cf1f",
                                        "glosses": [
                                            "Umsatzsteuer mit Vorsteuerabzug, die ein leistendes Unternehmen auf seinen Kunden abwälzen darf"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f76713dd-2214-4d28-b24f-18534b7db3c5",
                                                "sense_id": "572050eb-ca06-3096-af28-9beb98167eeb",
                                                "text": "Die Mehrwertsteuer stellt keinen Mehrwert des gekauften Produktes dar, sondern ist die dem Unternehmen auferlegt und weiter berechnete Umsatzsteuer."
                                            },
                                            {
                                                "example_id": "45f19cfb-c354-4abe-9c56-7f732220d57c",
                                                "sense_id": "572050eb-ca06-3096-af28-9beb98167eeb",
                                                "text": "Alle Unternehmen die Mehrwertsteuer vereinnahmen, müssen diese dem Finanzamt melden und natürlich auch umgehend abführen."
                                            },
                                            {
                                                "example_id": "d08eaa60-8f90-4170-9049-81b9b45ba6e8",
                                                "sense_id": "572050eb-ca06-3096-af28-9beb98167eeb",
                                                "text": "Es gibt unterschiedliche Umsatzsteuersätze, so das sich die Mehrwertsteuer von Lebensmitteln oder Tabakwahren unterscheidet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
