{
    "word_family": [
        "comprisal"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fb27befa-d582-35bd-989f-b6c0d207641b",
                    "sense_definition": "To be made up of or to consist of a particular set of parts or members.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local council <w>comprises</w> ten elected members from different districts.",
                            "target_lang_translations": {
                                "ru": "Местный совет <w>состоит из</w> десяти избранных членов от разных округов."
                            }
                        },
                        {
                            "text": "Our research team <w>comprises</w> a lead scientist and four junior assistants.",
                            "target_lang_translations": {
                                "ru": "Наша исследовательская группа <w>включает в себя</w> ведущего ученого и четырех младших ассистентов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "comprises a total of",
                        "comprises several different parts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоять из определенного набора частей или участников."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состоять из",
                                "target_lang_sense_clarification": "быть сформированным из"
                            },
                            {
                                "target_lang_word": "включать в себя",
                                "target_lang_sense_clarification": "иметь в своем составе"
                            },
                            {
                                "target_lang_word": "насчитывать",
                                "target_lang_sense_clarification": "иметь в количестве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f2f9eed-220a-3ef0-9a15-6204c6d92f15",
                    "sense_definition": "To constitute or make up the whole of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Older people <w>comprise</w> a large proportion of the local population.",
                            "target_lang_translations": {
                                "ru": "Пожилые люди <w>составляют</w> большую часть местного населения."
                            }
                        },
                        {
                            "text": "These three main components <w>comprise</w> the entire engine system.",
                            "target_lang_translations": {
                                "ru": "Эти три основных компонента <w>образуют</w> всю систему двигателя."
                            }
                        }
                    ],
                    "synonyms": [
                        "form",
                        "make up",
                        "compose"
                    ],
                    "common_phrases": [
                        "comprise the majority",
                        "comprise the bulk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Составлять или формировать целое из частей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составлять",
                                "target_lang_sense_clarification": "являться частью целого"
                            },
                            {
                                "target_lang_word": "образовывать",
                                "target_lang_sense_clarification": "формировать структуру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0beb693c-abe5-3939-b510-1ae030cc4b71",
                    "sense_definition": "To include or contain specific elements that define the scope of a patent or invention.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patented device <w>comprises</w> a sensor and a wireless transmitter.",
                            "target_lang_translations": {
                                "ru": "Запатентованное устройство <w>содержит</w> датчик и беспроводной передатчик."
                            }
                        },
                        {
                            "text": "The claim <w>comprises</w> at least one processor and a memory unit.",
                            "target_lang_translations": {
                                "ru": "Формула изобретения <w>включает</w> как минимум один процессор и блок памяти."
                            }
                        }
                    ],
                    "common_phrases": [
                        "comprises the following elements"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used in legal and patent documentation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Включать или содержать определенные элементы, определяющие объем патента или изобретения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включать",
                                "target_lang_sense_clarification": "содержать элементы в патенте"
                            },
                            {
                                "target_lang_word": "содержать",
                                "target_lang_sense_clarification": "иметь в составе устройства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}