                                "target_senses": [
                                    {
                                        "sense_id": "26486ad8-97aa-30a9-8f0e-64fd3d0b37b6",
                                        "entry_id": "0abab871-8135-39a1-afc7-f9e5fbf07653",
                                        "glosses": [
                                            "Action par laquelle une chose est détériorée ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "722c914a-352f-4f78-b18c-4df97b13a9bd",
                                                "sense_id": "26486ad8-97aa-30a9-8f0e-64fd3d0b37b6",
                                                "text": "Tout locataire est responsable des détériorations survenues durant son bail."
                                            },
                                            {
                                                "example_id": "dbcbf466-c901-47a6-9ad7-b9b8cc742287",
                                                "sense_id": "26486ad8-97aa-30a9-8f0e-64fd3d0b37b6",
                                                "text": "Il y a de grandes détériorations dans cette terre, tout y est dans une étrange détérioration."
                                            },
                                            {
                                                "example_id": "24c81ddb-c475-4cc4-806e-c388a36e9763",
                                                "sense_id": "26486ad8-97aa-30a9-8f0e-64fd3d0b37b6",
                                                "text": "Il faut en conclure que la cause de cette détérioration intéressait par conséquent la jante toute entière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
