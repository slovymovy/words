                "senses": [
                    {
                        "sense_id": "d8628fd0-fb7c-3234-ae3b-26f550431f6f",
                        "entry_id": "a2ccbf21-d4ad-331e-8a25-b7df39c4a7b3",
                        "glosses": [
                            "die von einem mesodermalen Epithel ausgekleidete, zwischen Darm und Körperwand befindliche Leibeshöhle"
                        ],
                        "tags": [
                            "Entwicklungsbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "eecb4a28-6fbd-4be7-9e7b-7bf757af0efa",
                                "sense_id": "d8628fd0-fb7c-3234-ae3b-26f550431f6f",
                                "text": "„Sobald die Segmentation des Somitenmesoderms einsetzt, gliedern sich die Seitenplatten in je zwei Schichten: eine äußere Schicht, die sich an das Ektoderm anlagert […], und eine innere Schicht, die sich an das Entoderm anschließt […]. Diese beiden Schichten umschließen das flüssigkeitsgefüllte Cölom (sekundäre Leibeshöhle).“"
                            },
                            {
                                "example_id": "ad368ded-8609-4121-b028-88066d5a88eb",
                                "sense_id": "d8628fd0-fb7c-3234-ae3b-26f550431f6f",
                                "text": "Das flüssigkeitsgefüllte Cölom übernimmt bei vielen Protostomiern die Funktion eines Hydroskeletts."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
