                            },
                            {
                                "target_lang_word": "неразбериха",
                                "target_lang_sense_clarification": "беспорядок, путаница в делах"
                            },
                            {
                                "target_lang_word": "сумбур",
                                "target_lang_sense_clarification": "беспорядок в мыслях или чувствах"
                            },
                            {
