                        "examples": [
                            {
                                "example_id": "151b7995-17bd-41c9-8f53-1f0ef1c09bf6",
                                "sense_id": "d7ead5f9-f965-3ec4-9bc8-54c189d878a9",
                                "text": "Die Biogeochemie beschäftigt sich mit Prozessen und Reaktionen, welche die Zusammensetzung der natürlichen Umwelt bestimmen.",
                                "translation": "Biogeochemistry deals with processes and reactions that govern the composition of the natural environment.",
                                "english": "Biogeochemistry deals with processes and reactions that govern the composition of the natural environment."
                            },
                            {
                                "example_id": "1415ca47-1231-4314-a221-537536d947c8",
                                "sense_id": "d7ead5f9-f965-3ec4-9bc8-54c189d878a9",
                                "text": "Insbesondere behandelt die Biogeochemie die Lehre von Kreisläufen von chemischen Elementen, wie zum Beispiel Kohlenstoff, Stickstoff, Schwefel und Phosphor.",
                                "translation": "In particular, biogeochemistry is the study of the cycles of chemical elements, such as carbon, nitrogen, sulfur and phosphorus.",
                                "english": "In particular, biogeochemistry is the study of the cycles of chemical elements, such as carbon, nitrogen, sulfur and phosphorus."
                            }
                        ]
                    }
