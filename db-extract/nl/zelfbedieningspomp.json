                            {
                                "example_id": "23938dca-3bd8-4a8f-ad65-aff6fccfcf0e",
                                "sense_id": "b785e389-e07e-393b-a14a-07e1f0b12870",
                                "text": "Tanken langs de snelweg is gemiddeld 13 tot 16 cent per liter duurder dan kleinere pompen en zelfbedieningspompen.”"
                            },
                            {
                                "example_id": "1c2abf2a-64bd-462d-91c5-d07c2f086cd4",
                                "sense_id": "b785e389-e07e-393b-a14a-07e1f0b12870",
                                "text": "Een onbekend aantal automobilisten is met autopech gestrand nadat ze in Leeuwarden bij een zelfbedieningspomp van Shell hadden getankt. Hun wagen viel stil omdat ze - zonder het te weten - diesel hadden getankt, terwijl hun auto op benzine rijdt."
                            },
                            {
                                "example_id": "5c7e471b-acf7-43d1-a28b-72773bda4607",
                                "sense_id": "b785e389-e07e-393b-a14a-07e1f0b12870",
                                "text": "VAB wijst er ook op dat tanken aan een zelfbedieningspomp in Italië goedkoper is dan aan een pomp met bediening (servito), waar de brandstof tot 10 eurocent per liter duurder is."
                            }
