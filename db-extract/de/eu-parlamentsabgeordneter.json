                "senses": [
                    {
                        "sense_id": "aeb8c131-6611-388e-8f45-86c496691cb6",
                        "entry_id": "e84db065-b485-3c53-880b-bd53fe2877ea",
                        "glosses": [
                            "(männliches) Mitglied des Europäischen Parlaments"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e47ae0a-7295-43c6-8175-c5fd36b0b05c",
                                "sense_id": "aeb8c131-6611-388e-8f45-86c496691cb6",
                                "text": "„Auch der EU-Parlamentsabgeordnete Joost Lagendijk, der zur Beobachtung des Prozesses nach Istanbul gekommen war, begrüßte die Gerichtsentscheidung.“"
                            },
                            {
                                "example_id": "22718aeb-9a10-4192-b742-db03b9d8936e",
                                "sense_id": "aeb8c131-6611-388e-8f45-86c496691cb6",
                                "text": "„Der grüne EU-Parlamentsabgeordnete Bütikofer fordert Kanzlerin Merkel auf, sich öffentlich hinter die EU-Kommission zu stellen – und damit gegen den französischen Präsidenten Sarkozy.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
