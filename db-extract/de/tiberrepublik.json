                "senses": [
                    {
                        "sense_id": "a9f6efa9-4386-3844-a7d1-b907cbf178b6",
                        "entry_id": "d5f7e7b0-87b4-3cf1-b2d6-affe2d1fa89a",
                        "glosses": [
                            "römische Republik; Rom"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a0f360ef-95ac-4f62-bd1e-009f3c119f0d",
                                "sense_id": "a9f6efa9-4386-3844-a7d1-b907cbf178b6",
                                "text": "„Wichtiger waren für den Geschichtsschreiber die Hintergründe: Was sagte das Jubelfest über den Zustand der Tiberrepublik?“"
                            },
                            {
                                "example_id": "42b8ebc2-6d63-401b-b7ac-7276ad8d1a6a",
                                "sense_id": "a9f6efa9-4386-3844-a7d1-b907cbf178b6",
                                "text": "„Sie wandte sich nach Wien um einen erfahrenen General, der das neapolitanische Heer feldtüchtig machen und gegen die neue Tiberrepublik führen möchte.“"
                            },
                            {
                                "example_id": "149c2bbb-ad60-4464-abd8-7a83e9738c06",
                                "sense_id": "a9f6efa9-4386-3844-a7d1-b907cbf178b6",
                                "text": "„Erst Rom verdrängte Rhodos, das künftig aber zum ersten Bundesgenossen der Tiberrepublik wurde.“"
                            },
                            {
                                "example_id": "cccc5a89-631a-419b-a32a-66c307dc9c14",
                                "sense_id": "a9f6efa9-4386-3844-a7d1-b907cbf178b6",
                                "text": "„Der Staat griff in den folgenden Jahren immer stärker in das wirtschaftliche Geschehen der Tiberrepublik ein.“"
                            },
                            {
                                "example_id": "7d52c347-7459-49f3-baa2-79810003d4f9",
                                "sense_id": "a9f6efa9-4386-3844-a7d1-b907cbf178b6",
                                "text": "„Immerhin hielt der belesene Hellene die politische Ordnung der Tiberrepublik im Vergleich für die »beste Verfassung, die es heute gibt« – gerade weil Elemente der Königs-, Adels- und Volksherrschaft in ihr kombiniert seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
