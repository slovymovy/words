        "de-extract.jsonl": [
            {
                "entry_id": "6e89ced2-c184-33da-b031-2ecdd7ca5b8f",
                "word": "harpsichord",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ad2f81e6-024b-3ef6-92e5-44989b97e12f",
                        "entry_id": "6e89ced2-c184-33da-b031-2ecdd7ca5b8f",
                        "glosses": [
                            "Cembalo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "064d6c52-24d8-4bc7-bbaa-f91628f4ec10",
                                "sense_id": "ad2f81e6-024b-3ef6-92e5-44989b97e12f",
                                "text": "\"Their outward garments were adorned with the figures of suns, moons, and stars; interwoven with those of fiddles, flutes, harps, trumpets, guitars, harpsichords, and many other instruments of music, unknown to us in Europe.\"",
                                "translation": "Die Kleidungsstücke wurden außen mit den Darstellungen von Sonnen, Monden und Sternen geschmückt, verwoben mit denen von Geigen, Flöten, Harfen, Trompeten, Gitarren, Cembali und vielen anderen Instrumenten der Musik, die uns in Europa unbekannt sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
