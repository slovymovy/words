                ],
                "senses": [
                    {
                        "sense_id": "c068154c-a99b-32d4-be7a-72f3e3a99d66",
                        "entry_id": "019a8116-00b3-3e2e-8af7-c06ab66e4d1c",
                        "glosses": [
                            "innerhalb der Chromosphäre der Sonne plötzlich auftretender Strahlungsausbruch, wenn die bogenförmig geschlossenen magnetischen Feldlinien aufbrechen"
                        ],
                        "tags": [
                            "Astrophysik"
                        ],
                        "examples": [
                            {
                                "example_id": "092ed8df-49be-469a-8c57-d13361e0d2b0",
                                "sense_id": "c068154c-a99b-32d4-be7a-72f3e3a99d66",
                                "text": "Thomas Berger … weist auf die Hauptgefahren hin: „Bei starken Sonneneruptionen werden viele hochenergetische Protonen ins All geschleudert. Und die Dosis kann auf einen Schlag so hoch sein, dass es bei Astronauten zur Strahlenkrankheit kommt.“"
                            },
                            {
                                "example_id": "d2f11f0c-436d-462c-a9bf-c58b2e0d5145",
                                "sense_id": "c068154c-a99b-32d4-be7a-72f3e3a99d66",
                                "text": "Einen Vorgeschmack auf die Gefahren einer Sonneneruption bekam die Erde erst vor ein paar Jahren: 1989 war Kanada von massiven Stromausfällen und Störungen der Gasversorgung betroffen, nachdem ein Sonnensturm das Land getroffen hatte."
                            },
                            {
                                "example_id": "d60846d8-5af3-4fc7-b626-d89f017fa3a4",
                                "sense_id": "c068154c-a99b-32d4-be7a-72f3e3a99d66",
                                "text": "Eine typische Sonneneruption setzt nach Angaben der Forscher die Energie von rund 100 Millionen Megatonnen TNT frei."
                            },
                            {
                                "example_id": "44ec50f9-5c4c-4236-8993-4d3740bb3638",
                                "sense_id": "c068154c-a99b-32d4-be7a-72f3e3a99d66",
                                "text": "Er [Richard Carrington] entdeckte Anfang September 1859 eine Sonneneruption, von der man heute schätzt, dass dabei eine Energie von zehn Milliarden Hiroshima-Atombomben freigesetzt wurde."
                            },
                            {
                                "example_id": "50821866-0b2e-40a5-9283-c32ac6185a00",
                                "sense_id": "c068154c-a99b-32d4-be7a-72f3e3a99d66",
                                "text": "Auch in Stromnetzen können Sonnenstürme Störungen verursachen. So führte 1973 eine Sonneneruption zu einem Stromausfall in der kanadischen Provinz Québec - sechs Millionen Menschen saßen damals im Dunkeln."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
