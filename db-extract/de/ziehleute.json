                "senses": [
                    {
                        "sense_id": "1cecc5ce-4595-3dae-93c0-7c0bc9e6a053",
                        "entry_id": "d4ac27d6-788c-3bc7-b575-ea8d0dae5d35",
                        "glosses": [
                            "landschaftlich: Möbelpacker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "613bc9ba-f409-46bf-ba89-d9953a4e93dc",
                                "sense_id": "1cecc5ce-4595-3dae-93c0-7c0bc9e6a053",
                                "text": "„Der Mitte März 1907 begonnene Streik der Ziehleute drohte den allgemeinen Umzugstermin am 1. April in Mitleidenschaft zu ziehen, konnte aber noch rechtzeitig mit Vertragsabschlüssen in einzelnen Unternehmen beendet werden.“"
                            },
                            {
                                "example_id": "2c8d508e-1104-4285-847a-5af819ea535a",
                                "sense_id": "1cecc5ce-4595-3dae-93c0-7c0bc9e6a053",
                                "text": "„Das gesetzliche Trinkgeld, das der Spediteur abrechnet, entspricht dem Bedienungszuschlag im Restaurant und wird vom Empfänger nicht anerkannt. Daher der Brauch, den Ziehleuten neben Speis und Trank Bares in die Hand zu drücken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
