                        "glosses": [
                            "Something hazarded or ventured; a guess or speculation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29e146d1-4f70-4d36-b7a1-4ef6984e51ad",
                                "sense_id": "06f5307e-0645-3d1a-9715-e19560cc474a",
                                "text": "The possessors of some of the homes on the Drive were more than mere names to him; for he had been a guest at an occasional semi-public entertainment in certain of the mansions he passed. But it never occurred to Gregg to dream of owning one of them; indeed, his hazardings of his future were altogether too vague to picture himself founding a family."
                            },
                            {
                                "example_id": "9d28de0c-aa58-4d77-82fb-cab9ac9e88a7",
                                "sense_id": "06f5307e-0645-3d1a-9715-e19560cc474a",
                                "text": "You see the vague speculations of Democritus becoming precise in Dalton, the cloudy hazardings of Pythagoras set solid in figures by Kepler; here is the balance, there is the yard-stick; number one is the principle of all things; […]"
                            }
                        ]
                    }
