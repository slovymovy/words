{
    "word_family": [
        "riddling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22ced745-01cb-3c61-964f-af728ccf209a",
                    "sense_definition": "A verbal puzzle or mystery that requires thought to solve.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "puzzle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children enjoyed trying to solve the <w>riddle</w> during the party.",
                            "target_lang_translations": {
                                "ru": "Детям понравилось пытаться отгадать <w>загадку</w> во время вечеринки."
                            }
                        },
                        {
                            "text": "He told a <w>riddle</w> that left everyone in the room confused.",
                            "target_lang_translations": {
                                "ru": "Он загадал <w>загадку</w>, которая привела всех в комнате в замешательство."
                            }
                        }
                    ],
                    "synonyms": [
                        "enigma",
                        "conundrum",
                        "brain-teaser"
                    ],
                    "common_phrases": [
                        "solve a riddle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Словесная головоломка или тайна, требующая размышления для решения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загадка",
                                "target_lang_sense_clarification": "краткое иносказательное описание чего-либо, что надо отгадать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41e77d3f-4bc3-319e-982d-db5cc070153d",
                    "sense_definition": "An ancient literary form using parallel expressions to hide a meaning.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "puzzle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor analyzed the structure of the ancient <w>riddle</w> found in the manuscript.",
                            "target_lang_translations": {
                                "ru": "Профессор проанализировал структуру древней <w>загадки</w>, найденной в рукописи."
                            }
                        },
                        {
                            "text": "Many cultures have a tradition of using the <w>riddle</w> as a form of poetic expression.",
                            "target_lang_translations": {
                                "ru": "Во многих культурах существует традиция использования <w>загадки</w> как формы поэтического выражения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Древняя литературная форма, использующая параллельные выражения для сокрытия смысла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загадка",
                                "target_lang_sense_clarification": "в контексте фольклора или поэтической формы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89dadcf9-2f50-3e01-85c4-8006d1d7c2a1",
                    "sense_definition": "A coarse sieve used to separate materials of different sizes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer used a <w>riddle</w> to remove stones from the soil.",
                            "target_lang_translations": {
                                "ru": "Фермер использовал <w>решето</w>, чтобы убрать камни из почвы."
                            }
                        },
                        {
                            "text": "He shook the <w>riddle</w> to sift the fine sand from the gravel.",
                            "target_lang_translations": {
                                "ru": "Он потряс <w>решето</w>, чтобы отсеять мелкий песок от гравия."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубое сито, используемое для разделения материалов разного размера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решето",
                                "target_lang_sense_clarification": "инструмент для просеивания крупных частиц"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "59805da0-e93d-3b4c-992b-3f0a3b99451d",
                    "sense_definition": "To make many holes in something, often with bullets or projectiles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden fence was <w>riddled</w> with bullet holes after the practice.",
                            "target_lang_translations": {
                                "ru": "Старый деревянный забор был <w>изрешечен</w> пулевыми отверстиями после тренировки."
                            }
                        },
                        {
                            "text": "The target was <w>riddled</w> with holes by the end of the shooting session.",
                            "target_lang_translations": {
                                "ru": "К концу стрельб мишень была <w>изрешечена</w> отверстиями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "riddled with holes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать много отверстий в чем-либо, часто пулями или снарядами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изрешетить",
                                "target_lang_sense_clarification": "пробить во многих местах, сделать сплошь покрытым дырами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f826346-6b5e-3347-90da-2617c5abc09e",
                    "sense_definition": "To be full of or spread throughout with something negative or destructive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report was <w>riddled</w> with errors and had to be rewritten.",
                            "target_lang_translations": {
                                "ru": "Отчет <w>изобиловал</w> ошибками, и его пришлось переписать."
                            }
                        },
                        {
                            "text": "His career was <w>riddled</w> with bad decisions and missed opportunities.",
                            "target_lang_translations": {
                                "ru": "Его карьера <w>изобиловала</w> неверными решениями и упущенными возможностями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "riddled with errors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть наполненным чем-то негативным или разрушительным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изобиловать",
                                "target_lang_sense_clarification": "иметь в большом количестве (обычно о недостатках)"
                            },
                            {
                                "target_lang_word": "кишеть",
                                "target_lang_sense_clarification": "быть переполненным чем-то неприятным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0301f95b-91f5-34c9-9383-2116979c8856",
                    "sense_definition": "To pass material through a sieve.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>riddle</w> the compost to ensure it is fine enough for seeds.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>просеять</w> компост, чтобы убедиться, что он достаточно мелкий для семян."
                            }
                        },
                        {
                            "text": "It is easier to <w>riddle</w> the soil when it is dry.",
                            "target_lang_translations": {
                                "ru": "Почву легче <w>просеивать</w>, когда она сухая."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пропускать материал через сито."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просеивать",
                                "target_lang_sense_clarification": "пропускать через сито для очистки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a1697b48-f1dd-36af-935d-66c90cd1f364",
                    "sense_definition": "A family name.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Riddle</w> is our new history teacher.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Риддл</w> — наш новый учитель истории."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Riddle</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "На конференции я встретил женщину по имени Сара <w>Риддл</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Риддл",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}