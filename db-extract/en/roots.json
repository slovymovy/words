            {
                "entry_id": "892460cb-75d7-34a1-8e1f-a0e57de4add8",
                "word": "roots",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f61b4fc3-925f-3413-bdc4-b9bb29ead401",
                        "entry_id": "892460cb-75d7-34a1-8e1f-a0e57de4add8",
                        "glosses": [
                            "Ancestry."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b22fe12-3e97-4be8-9950-d3ae64cd2c9f",
                                "sense_id": "f61b4fc3-925f-3413-bdc4-b9bb29ead401",
                                "text": "I have both Irish and German roots."
                            }
                        ]
                    },
                    {
                        "sense_id": "68a6bb46-bd91-39d5-ae6b-6bb1ebaec4b2",
                        "entry_id": "892460cb-75d7-34a1-8e1f-a0e57de4add8",
                        "glosses": [
                            "Beginnings; origin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3cfaaf8-1934-4272-98f7-17ff2ffafcd4",
                                "sense_id": "68a6bb46-bd91-39d5-ae6b-6bb1ebaec4b2",
                                "text": "Jazz has its roots in blues."
                            }
                        ]
                    },
                    {
                        "sense_id": "13d9ed6a-e9be-302f-a284-53a7390e5256",
                        "entry_id": "892460cb-75d7-34a1-8e1f-a0e57de4add8",
                        "glosses": [
                            "Grown-out hair, often of a grey or natural colour."
                        ],
                        "tags": [
                            "of hair"
                        ],
                        "examples": [
                            {
                                "example_id": "f05820d5-7f1a-444a-b539-cc5e623452e9",
                                "sense_id": "13d9ed6a-e9be-302f-a284-53a7390e5256",
                                "text": "I just coloured my hair and already my roots are showing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d038c40-e690-4d66-9b57-7536c68538c1",
                        "source_entry_id": "892460cb-75d7-34a1-8e1f-a0e57de4add8",
                        "source_sense_description": "ancestors",
                        "target_lang_word": "aïeux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aïeux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9dbfce42-2a03-3ea4-bd31-2a4ae61a68f4",
                                        "entry_id": "ed756f78-115c-3676-b577-ab56e966974c",
                                        "glosses": [
                                            "Pluriel de aïeul : tous ceux de qui l’on descend."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a0d21e9-c5b7-4105-bc42-41761172e1f1",
                                                "sense_id": "9dbfce42-2a03-3ea4-bd31-2a4ae61a68f4",
                                                "text": "Certaines familles présentent des aïeux prestigieux dans le champ militaire : deux ont un arrière-grand-père maréchal de France ou général de la guerre de 1914-1918."
                                            },
                                            {
                                                "example_id": "c032a73e-e6de-4f79-85ed-5a6297c59db3",
                                                "sense_id": "9dbfce42-2a03-3ea4-bd31-2a4ae61a68f4",
                                                "text": "Le ciel, tout l’univers est plein de mes aïeux."
                                            },
                                            {
                                                "example_id": "c48cfb8c-2f18-4f7f-84f7-09b5be7d7a1b",
                                                "sense_id": "9dbfce42-2a03-3ea4-bd31-2a4ae61a68f4",
                                                "text": "Il est de ces esprits favorisés des cieux, Qui sont tout par eux-mêmes et rien par leurs aïeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a175c9d-3cb2-3d0b-84b9-45ddb03dc8f9",
                                        "entry_id": "ed756f78-115c-3676-b577-ab56e966974c",
                                        "glosses": [
                                            "Tous ceux qui ont vécu dans les siècles passés."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22a7fa5b-e642-4768-ba0f-07620a3a4d17",
                                                "sense_id": "5a175c9d-3cb2-3d0b-84b9-45ddb03dc8f9",
                                                "text": "Ce long amas d’aïeux, que vous diffamez tous, Sont autant de témoins qui parlent contre vous."
                                            },
                                            {
                                                "example_id": "ae1d000c-86b2-4bcd-a75d-ae6f5d7aa1e1",
                                                "sense_id": "5a175c9d-3cb2-3d0b-84b9-45ddb03dc8f9",
                                                "text": "Plus d’honneur, plus de lois ; Rome est anéantie ; De l’univers et d’elle il [César] triomphe aujourd’hui ; Nos imprudents aïeux n’ont vaincu que pour lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
