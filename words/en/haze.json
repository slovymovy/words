{
    "word_family": [
        "hazy",
        "haziness",
        "hazer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e17aeb6b-dfbe-37a7-9c58-0e27eb209bb9",
                    "sense_definition": "Very fine solid particles or liquid droplets suspended in the air, slightly limiting visibility.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "atmospheric conditions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning sun was barely visible through the thick <w>haze</w> of smoke from the nearby forest fire.",
                            "target_lang_translations": {
                                "ru": "Утреннее солнце было едва видно сквозь густую <w>дымку</w> дыма от лесного пожара неподалеку."
                            }
                        },
                        {
                            "text": "A blue <w>haze</w> touched the long valley with mystery as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Голубая <w>дымка</w> придала длинной долине таинственности, когда солнце начало садиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "mist",
                        "smog",
                        "vapor"
                    ],
                    "antonyms": [
                        "clarity",
                        "clearness"
                    ],
                    "common_phrases": [
                        "blue haze",
                        "thick haze",
                        "morning haze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мельчайшие твердые частицы или капли жидкости, взвешенные в воздухе и слегка ограничивающие видимость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дымка",
                                "target_lang_sense_clarification": "легкая пелена"
                            },
                            {
                                "target_lang_word": "мгла",
                                "target_lang_sense_clarification": "помутнение воздуха частицами пыли или дыма"
                            },
                            {
                                "target_lang_word": "туман",
                                "target_lang_sense_clarification": "атмосферное явление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba91ba49-6a9a-353a-8dde-c3c573633bea",
                    "sense_definition": "A state of mental confusion, vagueness of memory, or lack of focus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked around in a <w>haze</w> of alcohol, unable to remember where he had parked his car.",
                            "target_lang_translations": {
                                "ru": "Он бродил в алкогольном <w>угаре</w>, не в силах вспомнить, где припарковал машину."
                            }
                        },
                        {
                            "text": "After the accident, she spent several days in a <w>haze</w> of confusion and grief.",
                            "target_lang_translations": {
                                "ru": "После аварии она провела несколько дней в <w>тумане</w> смятения и горя."
                            }
                        }
                    ],
                    "synonyms": [
                        "daze",
                        "fog",
                        "muddle"
                    ],
                    "common_phrases": [
                        "haze of memory",
                        "haze of confusion",
                        "drunken haze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние спутанности сознания, неясность памяти или отсутствие концентрации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туман",
                                "target_lang_sense_clarification": "в голове, в мыслях"
                            },
                            {
                                "target_lang_word": "помутнение",
                                "target_lang_sense_clarification": "сознания или рассудка"
                            },
                            {
                                "target_lang_word": "пелена",
                                "target_lang_sense_clarification": "перед глазами или в памяти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1416960-ffb4-3669-a122-dc2e0ec4de8d",
                    "sense_definition": "A dullness or lack of transparency on a surface that should be reflective or clear.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surface appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old soap left a persistent <w>haze</w> on the drinking glasses even after they were rinsed.",
                            "target_lang_translations": {
                                "ru": "Старое мыло оставило стойкий <w>налет</w> на стаканах даже после того, как их сполоснули."
                            }
                        },
                        {
                            "text": "You need to buff the car wax thoroughly to remove the white <w>haze</w> from the paint.",
                            "target_lang_translations": {
                                "ru": "Нужно тщательно отполировать воск, чтобы удалить белую <w>мутность</w> с краски автомобиля."
                            }
                        }
                    ],
                    "synonyms": [
                        "cloudiness",
                        "film",
                        "opacity"
                    ],
                    "antonyms": [
                        "sheen",
                        "gloss"
                    ],
                    "common_phrases": [
                        "persistent haze",
                        "white haze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тусклость или отсутствие прозрачности на поверхности, которая должна быть отражающей или чистой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "налет",
                                "target_lang_sense_clarification": "тонкий слой на поверхности"
                            },
                            {
                                "target_lang_word": "тусклость",
                                "target_lang_sense_clarification": "отсутствие блеска"
                            },
                            {
                                "target_lang_word": "мутность",
                                "target_lang_sense_clarification": "непрозрачность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6ea85df-1abd-3038-aa7b-e7eabfbe1095",
                    "sense_definition": "Any substance causing cloudiness or turbidity in liquids like beer or wine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "liquid properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brewer used fining agents to remove the protein <w>haze</w> from the chilled beer.",
                            "target_lang_translations": {
                                "ru": "Пивовар использовал осветлители, чтобы удалить белковое <w>помутнение</w> из охлажденного пива."
                            }
                        },
                        {
                            "text": "A slight <w>haze</w> in the wine is often a sign that it has not been heavily filtered.",
                            "target_lang_translations": {
                                "ru": "Легкая <w>муть</w> в вине часто является признаком того, что оно не подвергалось сильной фильтрации."
                            }
                        }
                    ],
                    "synonyms": [
                        "turbidity",
                        "cloudiness"
                    ],
                    "common_phrases": [
                        "chill haze",
                        "protein haze"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in brewing and winemaking"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое вещество, вызывающее помутнение в жидкостях, таких как пиво или вино."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "муть",
                                "target_lang_sense_clarification": "осадок или взвесь в жидкости"
                            },
                            {
                                "target_lang_word": "помутнение",
                                "target_lang_sense_clarification": "потеря прозрачности напитка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b0953bc-9ea1-3cd5-a911-8f4f093d65ee",
                    "sense_definition": "To subject someone to an unpleasant or humiliating initiation ritual, often in a college or military context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university has strict rules against students who try to <w>haze</w> new members of the fraternity.",
                            "target_lang_translations": {
                                "ru": "В университете действуют строгие правила против студентов, которые пытаются <w>издеваться</w> над новыми членами братства."
                            }
                        },
                        {
                            "text": "It is illegal for senior officers to <w>haze</w> recruits during their first week of basic training.",
                            "target_lang_translations": {
                                "ru": "Для старших офицеров незаконно <w>гонять</w> новобранцев во время их первой недели базовой подготовки."
                            }
                        }
                    ],
                    "synonyms": [
                        "bully",
                        "harass",
                        "mistreat"
                    ],
                    "common_phrases": [
                        "haze recruits",
                        "haze freshmen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергать кого-либо неприятному или унизительному ритуалу посвящения, часто в колледже или военной среде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "издеваться",
                                "target_lang_sense_clarification": "в рамках ритуалов посвящения"
                            },
                            {
                                "target_lang_word": "гонять",
                                "target_lang_sense_clarification": "подвергать испытаниям новичков"
                            },
                            {
                                "target_lang_word": "дедовщина",
                                "target_lang_sense_clarification": "как явление (сущ.), связанное с процессом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47268a52-08cf-3dc3-9b82-f31f54d453c8",
                    "sense_definition": "To become blurry, dim, or thick with atmospheric particles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "atmospheric conditions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the temperature dropped, the distant mountains began to <w>haze</w> over in the evening air.",
                            "target_lang_translations": {
                                "ru": "Когда температура упала, далекие горы начали <w>заволакиваться</w> дымкой в вечернем воздухе."
                            }
                        },
                        {
                            "text": "The horizon <w>hazed</w> into a sandy mist as the wind picked up across the desert.",
                            "target_lang_translations": {
                                "ru": "Горизонт <w>затянулся</w> песчаным туманом, когда в пустыне поднялся ветер."
                            }
                        }
                    ],
                    "synonyms": [
                        "cloud",
                        "obscure"
                    ],
                    "antonyms": [
                        "clear"
                    ],
                    "common_phrases": [
                        "haze over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться расплывчатым, тусклым или застилаться атмосферными частицами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заволакиваться",
                                "target_lang_sense_clarification": "о небе или горизонте"
                            },
                            {
                                "target_lang_word": "затуманиваться",
                                "target_lang_sense_clarification": "становиться неясным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23b8aa9b-fa3a-3aac-95e6-2b5c6ca7d9d5",
                    "sense_definition": "To use unpleasant stimuli to discourage a wild animal from approaching humans.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Park rangers will <w>haze</w> a bear using noise-makers to ensure it stays away from the campsites.",
                            "target_lang_translations": {
                                "ru": "Рейнджеры парка будут <w>отпугивать</w> медведя с помощью шумовых устройств, чтобы он держался подальше от лагерей."
                            }
                        },
                        {
                            "text": "The wildlife team had to <w>haze</w> the coyote to prevent it from becoming too comfortable around people.",
                            "target_lang_translations": {
                                "ru": "Команде по охране дикой природы пришлось <w>отпугнуть</w> койота, чтобы он не слишком привыкал к людям."
                            }
                        }
                    ],
                    "synonyms": [
                        "deter",
                        "scare off"
                    ],
                    "common_phrases": [
                        "haze a bear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать неприятные стимулы, чтобы отпугнуть дикое животное от приближения к людям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпугивать",
                                "target_lang_sense_clarification": "диких животных"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "32f80e80-d0db-3a15-9dc3-d9232bb2a176",
                    "sense_definition": "A diminutive or short form of the female given name <w>Hazel</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Everyone in the family calls her <w>Haze</w> instead of using her full name.",
                            "target_lang_translations": {
                                "ru": "Все в семье зовут ее <w>Хейз</w> вместо полного имени."
                            }
                        },
                        {
                            "text": "Her friends often use <w>Haze</w> as a nickname when they are hanging out together.",
                            "target_lang_translations": {
                                "ru": "Ее друзья часто используют имя <w>Хейз</w> как прозвище, когда они проводят время вместе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a nickname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная или краткая форма женского имени Хейзел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хейз",
                                "target_lang_sense_clarification": "уменьшительное имя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}