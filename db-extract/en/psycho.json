                    {
                        "sense_id": "6754e0b0-10e1-3fd0-8b23-4941df4275af",
                        "entry_id": "efde1891-a65f-326e-8eba-af18706550ba",
                        "glosses": [
                            "Psychotic, psychopathic, or (broadly) otherwise insane."
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "e9d026f1-b365-46e8-a11a-116d3ab38f84",
                                "sense_id": "6754e0b0-10e1-3fd0-8b23-4941df4275af",
                                "text": "That psycho jawn had snuck a pistol into the gym while we was practicing and started shooting shit up like she was some kinda hot female action hero."
                            },
                            {
                                "example_id": "8fad6462-ec0e-41fd-9b2c-cff1027fe1f6",
                                "sense_id": "6754e0b0-10e1-3fd0-8b23-4941df4275af",
                                "text": "Oh, she's sweet but a psycho / A little bit psycho / At night she's screamin' / \"I'm-ma-ma-ma out my mind\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "13257af3-fa81-3ce6-816b-2dbd4970b947",
                "word": "psycho",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
