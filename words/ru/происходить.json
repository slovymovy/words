    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9cbccc5-ccba-3c73-a6a3-2971f84bec85",
                    "sense_definition": "Случаться, иметь место, бывать, совершаться в действительности.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Никто не знал, что <w>происходит</w> за закрытыми дверями.",
                            "target_lang_translations": {
                                "en": "No one knew what was <w>happening</w> behind closed doors.",
                                "zh": "没人知道关起门来在<w>发生</w>什么。"
                            }
                        },
                        {
                            "text": "Это странное событие <w>происходит</w> каждый год.",
                            "target_lang_translations": {
                                "en": "This strange event <w>takes place</w> every year.",
                                "zh": "这个奇怪的事件每年都会<w>发生</w>。"
                            }
                        },
                        {
                            "text": "В фильме всё <w>происходит</w> очень быстро и динамично.",
                            "target_lang_translations": {
                                "en": "In the movie, everything <w>happens</w> very quickly and dynamically.",
                                "zh": "电影里的一切<w>进行</w>得非常快且充满活力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "случаться",
                        "бывать",
                        "встречаться",
                        "делаться",
                        "твориться"
                    ],
                    "common_phrases": [
                        "что происходит",
                        "происходить на глазах",
                        "происходить в мире",
                        "происходить с кем-то"
                    ],
                    "target_lang_definitions": {
                        "en": "To happen, take place, or occur in reality.",
                        "zh": "指事情发生、出现或存在。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "happen",
                                "target_lang_sense_clarification": "general"
                            },
                            {
                                "target_lang_word": "occur",
                                "target_lang_sense_clarification": "formal"
                            },
                            {
                                "target_lang_word": "take place",
                                "target_lang_sense_clarification": "for events or scheduled actions"
                            },
                            {
                                "target_lang_word": "go on",
                                "target_lang_sense_clarification": "informal, continuous action"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发生",
                                "target_lang_sense_clarification": "指事情出现或产生"
                            },
                            {
                                "target_lang_word": "进行",
                                "target_lang_sense_clarification": "指活动或事件正在开展"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62430ec0-ef76-3867-b5c5-870f24aa87a0",
                    "sense_definition": "Возникать, являться следствием или результатом чего-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "origin_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его неуверенность <w>происходила</w> от недостатка опыта.",
                            "target_lang_translations": {
                                "en": "His insecurity <w>stemmed</w> from a lack of experience.",
                                "zh": "他的不自信<w>源于</w>缺乏经验。"
                            }
                        },
                        {
                            "text": "Многие болезни <w>происходят</w> от неправильного образа жизни.",
                            "target_lang_translations": {
                                "en": "Many diseases <w>stem</w> from an unhealthy lifestyle.",
                                "zh": "许多疾病都<w>源于</w>不健康的生活方式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "проистекать"
                    ],
                    "common_phrases": [
                        "происходить от слова",
                        "происходить по причине"
                    ],
                    "target_lang_definitions": {
                        "en": "To arise, result, or stem from something.",
                        "zh": "指由某种原因引起或产生。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stem",
                                "target_lang_sense_clarification": "to result from a cause"
                            },
                            {
                                "target_lang_word": "derive",
                                "target_lang_sense_clarification": "to originate from a source"
                            },
                            {
                                "target_lang_word": "originate",
                                "target_lang_sense_clarification": "to come into existence"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "源于",
                                "target_lang_sense_clarification": "指事物产生的根源"
                            },
                            {
                                "target_lang_word": "出自",
                                "target_lang_sense_clarification": "指从某处产生或引申出来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "894e2731-9384-3022-b058-9b29ec09fdfb",
                    "sense_definition": "Вести своё происхождение, родословную от кого-либо или иметь истоком что-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "origin_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот древний обычай <w>происходит</w> из языческих времён.",
                            "target_lang_translations": {
                                "en": "This ancient custom <w>originates</w> from pagan times.",
                                "zh": "这个古老的习俗<w>起源于</w>异教时代。"
                            }
                        },
                        {
                            "text": "Считается, что человек <w>происходит</w> от общего предка с обезьяной.",
                            "target_lang_translations": {
                                "en": "It is believed that humans <w>descend</w> from a common ancestor with apes.",
                                "zh": "人们认为人类与猿类<w>起源于</w>共同的祖先。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вести происхождение"
                    ],
                    "common_phrases": [
                        "происходить из семьи",
                        "происходить из рода",
                        "происходить от обезьяны"
                    ],
                    "target_lang_definitions": {
                        "en": "To descend from ancestors or have a specific origin.",
                        "zh": "指血统、家族或事物的起源。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "descend",
                                "target_lang_sense_clarification": "from lineage or ancestors"
                            },
                            {
                                "target_lang_word": "originate",
                                "target_lang_sense_clarification": "from a source or origin"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "起源于",
                                "target_lang_sense_clarification": "指事物的发端"
                            },
                            {
                                "target_lang_word": "出身于",
                                "target_lang_sense_clarification": "指人的家庭背景或社会地位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
