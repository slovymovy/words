                "senses": [
                    {
                        "sense_id": "4821e734-d22b-35b4-843d-561381bd53d4",
                        "entry_id": "c17362fa-69e6-3003-8562-b1b2fdc01c1b",
                        "glosses": [
                            "Person, die beruflich Beerdigungen (Bestattungen) organisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a33578f6-9198-4d9d-9664-c61925e8b32d",
                                "sense_id": "4821e734-d22b-35b4-843d-561381bd53d4",
                                "text": "„Der Bestattungsunternehmer hatte den Leichnam des Vaters zu diesem Zeitpunkt bereits in Obhut genommen, jedoch ohne vertragliche Grundlage […].“"
                            },
                            {
                                "example_id": "93df1edb-ff86-4d73-8bcb-929001856b42",
                                "sense_id": "4821e734-d22b-35b4-843d-561381bd53d4",
                                "text": "„Wo wollen Sie mit der Leiche hin? Einer Leiche, die förmlich durchsiebt wurde? Wollen sie sie vielleicht zum nächsten Bestattungsunternehmer bringen?“"
                            },
                            {
                                "example_id": "aa3cf12a-51dc-43a0-b548-84b05153756a",
                                "sense_id": "4821e734-d22b-35b4-843d-561381bd53d4",
                                "text": "„Oskar wurde zwar von dem Bestattungsunternehmer mit entsprechenden, geruchsbindenden Mitteln behandelt, aber ich gebe zu, dass es kein Dauerzustand ist, ihn hier im Kaminzimmer zu lassen.“"
                            },
                            {
                                "example_id": "109935dd-fdb4-46dc-8469-a9b33c4263da",
                                "sense_id": "4821e734-d22b-35b4-843d-561381bd53d4",
                                "text": "„Man blättert bis dato ungelesene Heilige Schriften durch, versucht die schönsten Bibelsprüche herauszusuchen; man telefoniert mit verschiedenen Pfarrern, sucht sich Lieder für den Beerdigungsgottesdienst heraus und bespricht alles mit dern Organisten; man erstellt eine Kondolenzliste, fragt sich grübelnd, ob man eine Tante einladen soll, die der Verstorbene bekanntermaßen gehasst hat, die aber tödlich beleidigt wäre, wenn man sie nicht einlüde; man bespricht sich mit Bestattungsunternehmern über Sarggrößen — alles interessante, therapeutische, ja mitunter sogar amüsante Tätigkeiten (siehe Bestatter).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
