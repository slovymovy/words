                    },
                    {
                        "form_id": "d7630772-2d20-4374-afa7-b98f92ccb6fd",
                        "entry_id": "38d1d477-8611-306d-9130-c75a80051027",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most open-handed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "49c36aa4-f9d5-3fc3-8e7d-33c8a3baa3d3",
                        "entry_id": "38d1d477-8611-306d-9130-c75a80051027",
                        "glosses": [
                            "Done with the hand open rather than clenched"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f324ab54-31bf-4b32-9cff-91563fb75162",
                                "sense_id": "49c36aa4-f9d5-3fc3-8e7d-33c8a3baa3d3",
                                "text": "Hitters use the open-handed tip to try to softly place the ball over the blockers or into other open areas of the opponent's court."
                            },
                            {
                                "example_id": "112fc14a-20d1-474d-b8c7-5c51ae468f74",
                                "sense_id": "49c36aa4-f9d5-3fc3-8e7d-33c8a3baa3d3",
                                "text": "Visual gaze toward the mother was present with the children's earliest gestures, but only in those cases where the gesture was itself directed toward the mother, such as extending objects toward the mother or open-handed reaching or pointing toward objects held by the mother."
                            },
                            {
                                "example_id": "61d71301-3ac3-4b0f-8ea7-964d81038e67",
                                "sense_id": "49c36aa4-f9d5-3fc3-8e7d-33c8a3baa3d3",
                                "text": "And there were other words that stung his ears like hail: 'Slut! Bitch! Whore!' each accompanied by a noise: the open-handed slap that sounded like the tearing ofcalico, the dull thud followed by a gasp as a bunched fist slammed into yielding flesh, the reedy shriek and the gurgling sob -- and eventually the whistling breaths as Jessie climbed the stairs and shouted until she made herself heard that if they didn't stop their racket right this minute then she'd be calling the bobbies."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c1eba34-decc-335b-895a-6fde9c902cf4",
                        "entry_id": "38d1d477-8611-306d-9130-c75a80051027",
                        "glosses": [
                            "Liberal and generous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afcccd00-4af0-4fd4-87ff-2f61c4c6819b",
                                "sense_id": "4c1eba34-decc-335b-895a-6fde9c902cf4",
                                "text": "'No, no,' said the undertaker; 'not an open-handed gentleman in general, by any means. There you mistake him; but an afflicted gentleman, an affectionate gentleman, who knows what it is in the power of money to do, in giving him relief, and in testifying his love and veneration for the departed.'"
                            },
                            {
                                "example_id": "d5f329f9-d1c2-4166-874e-0215d347ebfb",
                                "sense_id": "4c1eba34-decc-335b-895a-6fde9c902cf4",
                                "text": "\"I'll do the old gorilla the justice to say that he is open-handed with money.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "bbe45c9d-cc76-33d9-839b-a23171e0a880",
                        "entry_id": "38d1d477-8611-306d-9130-c75a80051027",
                        "glosses": [
                            "Frank, honest, and tolerant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3f2352e-a295-4a10-92ab-61bfb7c3a64c",
                                "sense_id": "bbe45c9d-cc76-33d9-839b-a23171e0a880",
                                "text": "Despite Gustavus' open-handed dealing, many princes of Europe did not trust him."
                            }
                        ]
                    },
                    {
                        "sense_id": "da641165-d457-304f-a786-13dc8e92c567",
                        "entry_id": "38d1d477-8611-306d-9130-c75a80051027",
                        "glosses": [
                            "Characterized by looseness and fullness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21b71d06-560d-4f34-ae17-2e8609bafa04",
                                "sense_id": "da641165-d457-304f-a786-13dc8e92c567",
                                "text": "She sat there for more than three hours, as sheet after sheet became covered with her open-handed writing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
