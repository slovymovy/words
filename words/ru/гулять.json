                {
                    "sense_id": "79635a60-cc3a-3a1d-91b5-d961a77128de",
                    "sense_definition": "Быть свободным от работы или учёбы, иметь выходной день.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leisure_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Праздник пришёлся на четверг, так что мы <w>гуляем</w> четыре дня подряд.",
                            "target_lang_translations": {
                                "en": "The holiday fell on a Thursday, so we <w>are off</w> for four days in a row.",
                                "nl": "De feestdag viel op een donderdag, dus we <w>zijn</w> vier dagen achter elkaar <w>vrij</w>.",
                                "pl": "Święto wypadło w czwartek, więc <w>mamy wolne</w> przez cztery dni z rzędu."
                            }
                        },
                        {
                            "text": "Начальник подписал отпуск, и теперь я <w>гуляю</w> целый месяц.",
                            "target_lang_translations": {
                                "en": "The boss signed the vacation request, and now I <w>am off</w> for a whole month.",
                                "nl": "De baas heeft mijn vakantieaanvraag getekend en nu <w>ben</w> ik een hele maand <w>vrij</w>.",
                                "pl": "Szef podpisał wniosek urlopowy i teraz <w>mam wolne</w> przez cały miesiąc."
                            }
                        }
