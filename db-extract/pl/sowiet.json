                                    {
                                        "sense_id": "2b0d3ff3-8245-39c3-9d6a-71ec40e79a28",
                                        "entry_id": "de796a08-0a9f-321f-b0b4-257096e4a8e2",
                                        "glosses": [
                                            "Persona nacida en, o ciudadano de, la antigua URSS."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "04d4c9b0-1055-37ea-a042-2df489c8dac9",
                                        "entry_id": "de796a08-0a9f-321f-b0b4-257096e4a8e2",
                                        "glosses": [
                                            "Dicho de una persona, arisco, intratable."
                                        ],
                                        "tags": [
                                            "Spain",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ed37bf8-70a8-4f3f-a022-80a1030e825b",
                                                "sense_id": "04d4c9b0-1055-37ea-a042-2df489c8dac9",
                                                "text": "Déjalo, hoy se ha levantado soviético."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9d69a21-e4e9-4d30-827c-767bc2885962",
                        "source_entry_id": "1346ecdf-5aed-3494-88d1-38f04e4cd31c",
                        "source_sense_id": "931d9c8a-f33b-37dd-91cb-46f07b1d6e4f",
                        "target_lang_word": "Sowjet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sowjet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5a434f6-748f-3675-83aa-c4902407a999",
                                        "entry_id": "de26c996-7f95-3346-ae1b-ecb173ff735b",
                                        "glosses": [
                                            "Arbeiter-, Bauern- und Soldatenräte, die während der russischen Revolutionen von 1905 und 1917 entstanden waren"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eff4712-55e7-4b9a-85d6-01e4bbc0dfc7",
                                                "sense_id": "b5a434f6-748f-3675-83aa-c4902407a999",
                                                "text": "Der Petersburger Sowjet glich in den ersten Wochen seines Bestehens einer riesigen permanenten Arbeiter- und Soldatenversammlung."
                                            },
                                            {
                                                "example_id": "9bc5ac5c-18dc-4037-a317-f82ea6ff6897",
                                                "sense_id": "b5a434f6-748f-3675-83aa-c4902407a999",
                                                "text": "Die Bezeichnung Doppelherrschaft ist an die Ereignisse von Frühjahr bis Herbst 1917 angelehnt, als in Form der Sowjets und der provisorischen Regierung zwei alternative Machtzentren parallel existierten (…)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64e32fb0-5c4d-3d61-b2af-602e608ff540",
                                        "entry_id": "de26c996-7f95-3346-ae1b-ecb173ff735b",
                                        "glosses": [
                                            "Macht- und Verwaltungsorgane in Sowjetrussland (1917–1922) und in der Sowjetunion (1922–1991)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af3eb6ef-e847-4b4b-aeec-14db47e667c7",
                                                "sense_id": "64e32fb0-5c4d-3d61-b2af-602e608ff540",
                                                "text": "Aber eine Macht, die nur von unten nach oben arbeite, könne nicht funktionieren, wenn nicht auch von oben nach unten, etwa von den Stadtsowjets in die Gebietssowjets delegiert werde."
                                            },
                                            {
                                                "example_id": "cd0e1a72-cba1-44b2-aa4e-6c2df542bdc6",
                                                "sense_id": "64e32fb0-5c4d-3d61-b2af-602e608ff540",
                                                "text": "Der Oberste Sowjet der UdSSR besteht aus zwei Kammern: dem Unionssowjet und dem Nationalitätensowjet."
                                            },
                                            {
                                                "example_id": "14465cc1-07a1-4397-a314-ce39414e08dd",
                                                "sense_id": "64e32fb0-5c4d-3d61-b2af-602e608ff540",
                                                "text": "„Die Sowjets beschossen die Stadt, die kurz darauf fallen sollte, aus Stalinorgeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "702689e0-cec9-3a93-9266-e12265ffc19c",
                                        "entry_id": "de26c996-7f95-3346-ae1b-ecb173ff735b",
                                        "glosses": [
                                            "Sowjetbürger = Bürger der Sowjetunion/UdSSR. Ursprünglich Bezeichnung für die Anhänger der Sowjetmacht während des russischen Bürgerkrieges (1917–1922)."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f0d5b14-040f-4d96-8405-2553275b2fa9",
                                                "sense_id": "702689e0-cec9-3a93-9266-e12265ffc19c",
                                                "text": "Und die Sowjets lachen mit. War das ein Spaßmacher, der das zuwege brachte?"
                                            },
                                            {
                                                "example_id": "9a07be63-efaf-477b-96da-18c7cc6b2ab7",
                                                "sense_id": "702689e0-cec9-3a93-9266-e12265ffc19c",
                                                "text": "Für das zaristische Rußland – gegen die Sowjets!"
                                            },
                                            {
                                                "example_id": "17c95c69-fcf8-429d-a732-d0d8c63d2667",
                                                "sense_id": "702689e0-cec9-3a93-9266-e12265ffc19c",
                                                "text": "„Als die Sowjetunion [1939 Finnland] angriff, gab es über Nacht eine nationale Einigung. Jeder in Finnland, inklusive der Kommunisten, sah ein, dass das eine existenzielle Bedrohung sei und sich Finnland gegen die Sowjets verteidigen müsse“."
                                            },
                                            {
                                                "example_id": "5852beab-6efe-4bc4-9962-229bc3e664d9",
                                                "sense_id": "702689e0-cec9-3a93-9266-e12265ffc19c",
                                                "text": "„Hitler hatte nicht die Niederlage der Sowjets und den totalen Sieg verkündet, um Propaganda zu machen und die Moral der Heimatfront zu stärken, sondern weil er glaubte, es verhalte sich wirklich so.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
