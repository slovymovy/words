                        "source_entry_id": "28ccbb86-3252-3dcc-89c7-36165fb28558",
                        "source_sense_id": "39c4258d-2d0c-3258-bacd-8e410d6eef43",
                        "source_sense_description": "sechswertiger, süß schmeckender Alkohol; ein pflanzlicher Wirkstoff",
                        "target_lang_word": "sorbitol",
