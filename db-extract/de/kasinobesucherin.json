                            {
                                "example_id": "c9b45ed3-22c8-456f-aa1a-ac6593c08e90",
                                "sense_id": "b3afcd47-edd7-3b40-bfd2-d569dbbfda93",
                                "text": "Emma war regelmäßige Kasinobesucherin und bildete sich wie so viele ein, ein funktionierendes Spielsystem entwickelt zu haben."
                            },
                            {
                                "example_id": "67e82fb6-2d2a-4974-a9cb-4010a3ea9b82",
                                "sense_id": "b3afcd47-edd7-3b40-bfd2-d569dbbfda93",
                                "text": "„‚Ich wusste gar nicht, wie vielseitig die Produkte der Region Spreewald sind‘, sagt die tägliche Kasinobesucherin Heike Chevremont und ergänzt ‚die Spezialitäten haben einfach Klasse geschmeckt.‘“"
                            }
