                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f1a9641-6e7e-4af1-a485-5062bf568f22",
                                                "sense_id": "10f01191-51b4-32bb-9709-9a0a70876899",
                                                "text": "„Mit ein wenig Glück gibt es den azurblauen Himmel und Sonne satt dazu.“"
                                            },
                                            {
                                                "example_id": "120b14bc-0000-499e-9fa5-fd82811ef9ce",
                                                "sense_id": "10f01191-51b4-32bb-9709-9a0a70876899",
                                                "text": "Hast du ein azurblaues Näpfchen in deinem Farbkasten?"
                                            },
                                            {
                                                "example_id": "7920d0a6-e23d-477d-bd5e-e0f5fd1ea387",
                                                "sense_id": "10f01191-51b4-32bb-9709-9a0a70876899",
                                                "text": "„Wer ohne azurblaue Vignette auf der Windschutzscheibe seines Autos auf einer Autobahn oder einer Schnellstraße erwischt wird, muss 120 Euro Strafe bezahlen, sozusagen als Ersatzmaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
