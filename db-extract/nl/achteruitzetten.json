        "nl-extract.jsonl": [
            {
                "entry_id": "c8413c9f-3582-3537-be36-9054d324224a",
                "word": "achteruitzetten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "062727ec-61e0-3246-8db2-98294b608daa",
                        "entry_id": "c8413c9f-3582-3537-be36-9054d324224a",
                        "glosses": [
                            "het terugdraaien van een klok naar een vroeger tijdstip"
                        ],
                        "tags": [
                            "tijdrekening"
                        ],
                        "examples": [
                            {
                                "example_id": "f0230823-fb50-4c65-838a-6bf9e5f5c32f",
                                "sense_id": "062727ec-61e0-3246-8db2-98294b608daa",
                                "text": "Afgelopen weekend werd de klok in Europa weer een uur achteruitgezet. Niet alleen het gezinsleven maar ook kippen, koeien en andere dieren hebben volgens de politica te lijden onder het „volledig zoek raken van het bioritme”."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0187bfc-20ad-3492-b678-42364ad4772d",
                        "entry_id": "c8413c9f-3582-3537-be36-9054d324224a",
                        "glosses": [
                            "teruggaan naar een oudere, mindere toestand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11c495f0-6fe6-43d9-9133-3a16f37ab8e0",
                                "sense_id": "a0187bfc-20ad-3492-b678-42364ad4772d",
                                "text": "Ankara bedong ook versnelling van de onderhandelingen over toetreding tot de EU. Daarbij zijn de Turkse omgang met grondrechten en persvrijheid van belang, maar het land heeft op die terreinen de laatste jaren stappen achteruitgezet, aldus Timmermans."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf26d3f8-71b8-3d73-941e-d413739dad04",
                        "entry_id": "c8413c9f-3582-3537-be36-9054d324224a",
                        "glosses": [
                            "verslechteren, verminderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74823f85-e08e-4dda-b62e-de5d1f73e033",
                                "sense_id": "bf26d3f8-71b8-3d73-941e-d413739dad04",
                                "text": "Ondanks de stevige winsten van de graadmeters waren er ook duidelijke verliezers. Zo werd farmaceut Bristol-Myers Squibb 16 procent achteruitgezet, na de melding van een mislukte test voor een van zijn medicijnen op het gebied van longkanker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "890aa938-7989-42a5-bed7-c3cd12950069",
                        "source_entry_id": "c8413c9f-3582-3537-be36-9054d324224a",
                        "source_sense_id": "a0187bfc-20ad-3492-b678-42364ad4772d",
                        "source_sense_description": "verslechteren, verminderen",
                        "target_lang_word": "degrade",
