                            {
                                "example_id": "ebb3cde3-d405-43fb-acd1-5fd25a9e59f9",
                                "sense_id": "e92b59c1-9bcd-3cff-a0a6-abaed1e11686",
                                "text": "„Teurer wird hingegen die Kapellennutzung.“"
                            },
                            {
                                "example_id": "e8be4ab6-4520-49be-a18c-222337abf599",
                                "sense_id": "e92b59c1-9bcd-3cff-a0a6-abaed1e11686",
                                "text": "„In den nachfolgend aufgeführten Gebühren für Grabstellen der evangelischen Friedhöfe ist die Kapellennutzung für eine Trauerfeier nicht enthalten.“"
                            },
                            {
                                "example_id": "0d697325-04ff-4a8d-a198-212f20a2d2ba",
                                "sense_id": "e92b59c1-9bcd-3cff-a0a6-abaed1e11686",
                                "text": "„Die Kapellennutzung in dieser Form wird auf die halbe Zeit mit halben Personenzahlen im Vergleich zur Trauerfeier eingeschätzt.“"
                            },
                            {
                                "example_id": "98c3ca05-d0db-4e79-b047-38bd72fd23e1",
                                "sense_id": "e92b59c1-9bcd-3cff-a0a6-abaed1e11686",
                                "text": "„Die Kapellennutzung ist unabhängig von der Kirchenzugehörigkeit möglich.“"
                            },
                            {
                                "example_id": "a39df4f1-0387-4527-8947-61afe6d31687",
                                "sense_id": "e92b59c1-9bcd-3cff-a0a6-abaed1e11686",
                                "text": "„Dort müssen die Angehörigen nur 400 Euro für Grabnutzung und Bestattung einschließlich Kapellennutzung zahlen.“"
                            }
                        ],
