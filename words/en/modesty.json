{
    "word_family": [
        "modest",
        "modestly",
        "immodesty",
        "immodest"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0aa111ba-e157-3804-8328-483b46f1c26b",
                    "sense_definition": "The quality of being modest; having a limited and not overly high opinion of oneself and one's abilities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his incredible success in the tech industry, he spoke about his achievements with great <w>modesty</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свой невероятный успех в технологической индустрии, он говорил о своих достижениях с большой <w>скромностью</w>."
                            }
                        },
                        {
                            "text": "She accepted the prestigious award with characteristic <w>modesty</w>, thanking her entire team for their hard work.",
                            "target_lang_translations": {
                                "ru": "Она приняла престижную награду с характерной <w>скромностью</w>, поблагодарив всю свою команду за усердную работу."
                            }
                        }
                    ],
                    "synonyms": [
                        "humility",
                        "meekness",
                        "unpretentiousness"
                    ],
                    "antonyms": [
                        "arrogance",
                        "immodesty"
                    ],
                    "common_phrases": [
                        "characteristic modesty",
                        "false modesty",
                        "genuine modesty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество человека, который не склонен преувеличивать свои достоинства и способности; отсутствие высокомерия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скромность",
                                "target_lang_sense_clarification": "отсутствие хвастовства"
                            },
                            {
                                "target_lang_word": "непритязательность",
                                "target_lang_sense_clarification": "простота и отсутствие претензий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "174e3b69-ffe2-34e2-a038-a80f346051fa",
                    "sense_definition": "Moderate behavior or reserve in one's actions and speech.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat was known for his <w>modesty</w> and restraint during heated international negotiations.",
                            "target_lang_translations": {
                                "ru": "Дипломат был известен своей <w>сдержанностью</w> и самообладанием во время острых международных переговоров."
                            }
                        },
                        {
                            "text": "The <w>modesty</w> of his lifestyle surprised many, as he lived in a small apartment despite his wealth.",
                            "target_lang_translations": {
                                "ru": "<w>Скромность</w> его образа жизни многих удивляла, так как он жил в маленькой квартире, несмотря на свое богатство."
                            }
                        }
                    ],
                    "synonyms": [
                        "reserve",
                        "moderation",
                        "discretion"
                    ],
                    "antonyms": [
                        "impudence",
                        "extravagance"
                    ],
                    "common_phrases": [
                        "natural modesty",
                        "behave with modesty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умеренность в поведении, образе жизни или речи; сдержанность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдержанность",
                                "target_lang_sense_clarification": "умеренность в проявлениях"
                            },
                            {
                                "target_lang_word": "скромность",
                                "target_lang_sense_clarification": "простой образ жизни"
                            },
                            {
                                "target_lang_word": "благопристойность",
                                "target_lang_sense_clarification": "соответствие правилам приличия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c402cf68-4e85-3f8c-be2a-22eaa5b69ffa",
                    "sense_definition": "The avoidance of sexual explicitness or indecency in dress or behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "decency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional dress code was designed to ensure <w>modesty</w> among all members of the community.",
                            "target_lang_translations": {
                                "ru": "Традиционный дресс-код был разработан для обеспечения <w>скромности</w> среди всех членов сообщества."
                            }
                        },
                        {
                            "text": "Out of <w>modesty</w>, she chose a dress that covered her shoulders and knees for the ceremony.",
                            "target_lang_translations": {
                                "ru": "Из <w>скромности</w> она выбрала для церемонии платье, закрывающее плечи и колени."
                            }
                        }
                    ],
                    "synonyms": [
                        "pudency",
                        "decency",
                        "chastity"
                    ],
                    "antonyms": [
                        "immodesty"
                    ],
                    "common_phrases": [
                        "sense of modesty",
                        "out of modesty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соблюдение приличий в одежде или поведении, избегание непристойности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скромность",
                                "target_lang_sense_clarification": "пристойность в одежде"
                            },
                            {
                                "target_lang_word": "стыдливость",
                                "target_lang_sense_clarification": "чувство смущения или стыда"
                            },
                            {
                                "target_lang_word": "целомудрие",
                                "target_lang_sense_clarification": "строгая нравственность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}