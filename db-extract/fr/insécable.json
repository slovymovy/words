                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f73699a-2fd9-3250-ae81-fcdf18e45c55",
                        "entry_id": "b580b68b-fe3d-3591-9097-18570fcccf35",
                        "glosses": [
                            "Que l’on ne saurait couper ou partager."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "aae9a3cd-5f49-4bd8-8d3a-7983bde261d3",
                                "sense_id": "6f73699a-2fd9-3250-ae81-fcdf18e45c55",
                                "text": "Il ne faut pas non plus faire violence à l’impossible, ni tout observer de la même façon que dans les raisonnements […] qui nous donnent une solution aux autres problèmes physiques, comme le fait que le tout est corps et nature intangible, ou que les éléments sont insécables, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "741f8bea-6f37-3b74-8aef-1832c17dac77",
                        "entry_id": "b580b68b-fe3d-3591-9097-18570fcccf35",
                        "glosses": [
                            "En parlant d’une espace, qui rend solidaires les deux entités qu’elle sépare (qui demeurent alors sur la même ligne de texte)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c6cfc1f-82ec-4aeb-ae19-5c470573fe0d",
                        "source_entry_id": "b580b68b-fe3d-3591-9097-18570fcccf35",
                        "target_lang_word": "indivisible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indivisible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28b87fcd-89a9-3f64-a633-7583e0e89a25",
                                        "entry_id": "52074591-746c-3d0b-97b3-3d899397387a",
                                        "glosses": [
                                            "Incapable of being divided; atomic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1929298f-950a-474f-9793-9d11da3fe233",
                                                "sense_id": "28b87fcd-89a9-3f64-a633-7583e0e89a25",
                                                "text": "one indivisible point of time"
                                            },
                                            {
                                                "example_id": "a1322096-a406-423c-9e4a-8c76d4b15d3c",
                                                "sense_id": "28b87fcd-89a9-3f64-a633-7583e0e89a25",
                                                "text": "Although the mainland and Taiwan are yet to be reunited, they belong to one and same China, which is an indivisible whole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d28f0b51-74ab-3eec-9dc8-cee74d8e4c7f",
                                        "entry_id": "52074591-746c-3d0b-97b3-3d899397387a",
                                        "glosses": [
                                            "Incapable of being divided by a specific integer without leaving a remainder."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "indivisible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd7ce9f5-624d-39ad-8045-e0079de471bc",
                                        "entry_id": "517256a4-3e35-3cf0-b563-e7d1c525cee4",
                                        "glosses": [
                                            "That which cannot be divided or split."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19a146ae-99ea-471b-844b-cb47a8b14598",
                                                "sense_id": "fd7ce9f5-624d-39ad-8045-e0079de471bc",
                                                "text": "By atom, nobody will imagine we intend to express a perfect indivisible, but only the least sort of natural bodies."
                                            },
                                            {
                                                "example_id": "e417aa02-600c-468d-aa71-a10485816980",
                                                "sense_id": "fd7ce9f5-624d-39ad-8045-e0079de471bc",
                                                "text": "The compoſition of Bodies, whether it be of Diviſibles or Indiviſibles, is a queſtion which must be rank'd with the Indiſſolvibles: For though it hath been attempted by the moſt illuſtrious Wits of all Philoſophick Ages; yet they have done little elſe, but ſhewn their own diviſions to be almoſt as infinite, as ſome ſuppoſe thoſe of their Subject."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22483c9d-915c-35d8-b8de-feaa0a468587",
                                        "entry_id": "517256a4-3e35-3cf0-b563-e7d1c525cee4",
                                        "glosses": [
                                            "An infinitely small quantity which is assumed to admit of no further division."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
