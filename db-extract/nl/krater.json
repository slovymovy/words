        "nl-extract.jsonl": [
            {
                "entry_id": "0af34aea-df3f-348b-b751-e1e27ad11374",
                "word": "krater",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "7c32fb49-4c56-48a2-a21d-f257d66fd52c",
                        "entry_id": "0af34aea-df3f-348b-b751-e1e27ad11374",
                        "tags": [
                            "plural"
                        ],
                        "form": "kraters"
                    },
                    {
                        "form_id": "8f4d1073-a5e8-4339-b22c-6741ae260c57",
                        "entry_id": "0af34aea-df3f-348b-b751-e1e27ad11374",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "kratertje"
                    },
                    {
                        "form_id": "c551a91b-3efc-4bfa-b41d-7672a9e393cd",
                        "entry_id": "0af34aea-df3f-348b-b751-e1e27ad11374",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "kratertjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a04842fc-328c-3061-8a96-f7634007a944",
                        "entry_id": "0af34aea-df3f-348b-b751-e1e27ad11374",
                        "glosses": [
                            "een trechtervormige uitholling in de grond veroorzaakt door een inslag of een (vulkanische) explosie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b7dc08-0cee-487f-b615-74d84be8763c",
                                "sense_id": "a04842fc-328c-3061-8a96-f7634007a944",
                                "text": "Het oppervlak van de maan is gepokt en gemazeld met kraters veroorzaakt door de inslagen in haar lange geschiedenis."
                            },
                            {
                                "example_id": "6a1d62fe-cb6e-4928-aa21-4dee645fa6c4",
                                "sense_id": "a04842fc-328c-3061-8a96-f7634007a944",
                                "text": "Daarna liet ik de toeristen al snel achter me en volgde ik de trail die helemaal langs de rand van de vulkaankrater liep. Op een bordje stond vermeld dat deze krater 650 meter diep was en ongeveer 7.700 jaar geleden was ontstaan."
                            },
                            {
                                "example_id": "ad53ea74-3937-481c-974a-a9617fd391e4",
                                "sense_id": "a04842fc-328c-3061-8a96-f7634007a944",
                                "text": "Het is stil in Roombeek. Touwen tingen tegen de vlaggenmast waar de driekleur halfstok hangt. In de verte het gejoel van spelende kinderen. Zo’n 70 mensen herdenken vrijdagmiddag 13 mei de ramp die zich 22 jaar eerder voltrok in de Enschedese wijk. Zij staan bij de plek waar de gewraakte vuurwerkcontainers een krater achterlieten. Een gat in de stad."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a374bfc-631f-3dd7-ab50-175c20e6d572",
                        "entry_id": "0af34aea-df3f-348b-b751-e1e27ad11374",
                        "glosses": [
                            "een mengvat voor wijn en water uit het Oude Griekenland"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a96944f9-f346-45ba-b048-81da20091859",
                        "source_entry_id": "0af34aea-df3f-348b-b751-e1e27ad11374",
                        "target_lang_word": "cratère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cratère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74dfe36b-4561-3f60-bab2-63a334744bd5",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Vase à deux anses, plus large que profond, d’une grande capacité, contenant du vin et de l’eau mêlés, dont on remplissait les coupes qu’on passait ensuite à chaque convive."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b52d2362-fe3a-44cb-8e4b-e2f58910bb27",
                                                "sense_id": "74dfe36b-4561-3f60-bab2-63a334744bd5",
                                                "text": "Les vins de palme et de tamaris, ceux de Safet et de Byblos, coulaient des amphores dans les cratères, des cratères dans les coupes, des coupes dans les gosiers ; on bavardait, les cœurs s’épanchaient."
                                            },
                                            {
                                                "example_id": "9bdc0181-500f-4df7-b43e-573cf568a06b",
                                                "sense_id": "74dfe36b-4561-3f60-bab2-63a334744bd5",
                                                "text": "Quand M. Bloch nous eut laissé tremper nos lèvres dans des coupes plates que son fils décorait du nom de « cratères aux flancs profondément creusés », il nous fit admirer un tableau qu'il aimait tant qu'il l'apportait avec lui à Balbec."
                                            },
                                            {
                                                "example_id": "1d78e44d-32dc-477c-8138-e8f909ae8810",
                                                "sense_id": "74dfe36b-4561-3f60-bab2-63a334744bd5",
                                                "text": "La suite a fini dans les livres d’histoire. Maurice Moisson vient de découvrir le sommet de ce qui est toujours le plus imposant cratère grec connu, un cratère étant un grand vase destiné à mélanger l’eau et le vin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49b3fb7d-a5c7-38fc-bc8f-c5b79795702d",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Vase à deux anses, plus large que profond, d’une grande capacité, contenant du vin et de l’eau mêlés, dont on remplissait les coupes qu’on passait ensuite à chaque convive.",
                                            "Coupe à boire large et peu profonde, hanap."
                                        ],
                                        "tags": [
                                            "Ancient",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47bef252-cbe2-46dc-b539-76137e78b9c6",
                                                "sense_id": "49b3fb7d-a5c7-38fc-bc8f-c5b79795702d",
                                                "text": "La Sorbonne & le cardinal Lemoine ont encore aujourd’hui des cratères ; ce sont de grandes coupes en écuelle à bords rabattus & sans oreilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5957619-eb9e-3562-9f22-d11d67fbb3de",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Dépression limitée par un bord abrupt, qui peut être circulaire ou elliptique."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "569f072d-caf0-3029-b649-181f126619a0",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Dépression limitée par un bord abrupt, qui peut être circulaire ou elliptique.",
                                            "Dépression formée par les éruptions d’un volcan."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a0d3d6-c438-4019-a253-9c5a09f3705e",
                                                "sense_id": "569f072d-caf0-3029-b649-181f126619a0",
                                                "text": "Après un tel paroxysme, l’éboulement des côtés du cratère obstrue encore plus l’orifice du volcan, et l’oblitère entièrement. On peut alors procéder à des observations […]."
                                            },
                                            {
                                                "example_id": "e2f0fa16-e2dd-4f6b-88ea-3d977a7dd317",
                                                "sense_id": "569f072d-caf0-3029-b649-181f126619a0",
                                                "text": "L’anse où nous mouillons est évidemment un ancien cratère dans l’intérieur duquel la mer a fait irruption ; de tous côtés surgissent des cônes de cendres qui dénotent une récente activité volcanique."
                                            },
                                            {
                                                "example_id": "c459e502-0f57-422a-96e9-ac4c0fd6531d",
                                                "sense_id": "569f072d-caf0-3029-b649-181f126619a0",
                                                "text": "Le face aride de l’île et les nombreux cratères éteints en dénonçaient la formation géologique récente […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97944096-999d-31bf-9ac9-ca9388e0e2b2",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Dépression limitée par un bord abrupt, qui peut être circulaire ou elliptique.",
                                            "Dépression du sol laissée par un impact météoritique."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f62efb1-b31d-47cc-bcee-00d0a1f3c259",
                                                "sense_id": "97944096-999d-31bf-9ac9-ca9388e0e2b2",
                                                "text": "Les cratères d’impacts lunaires suggèrent que les planètes du système solaire furent soumises à un bombardement intense il y a quatre milliards d’années."
                                            },
                                            {
                                                "example_id": "30da117e-999b-47d9-890a-a4c3a87823e3",
                                                "sense_id": "97944096-999d-31bf-9ac9-ca9388e0e2b2",
                                                "text": "Phobos, la plus grosse des deux lunes de Mars, a la forme d’un patatoïde et mesure environ 28 km × 23 km × 20 km. Elle est dominée par le cratère Stickney […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20008a3c-65f5-344f-a385-5d152084a616",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Dépression limitée par un bord abrupt, qui peut être circulaire ou elliptique.",
                                            "Dépression formée suite à un effondrement d’origine souterraine."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7c2bcd7-be05-466b-8dcf-4546b8f074cc",
                                                "sense_id": "20008a3c-65f5-344f-a385-5d152084a616",
                                                "text": "Le 1ᵉʳ juillet 1916, la bataille de la Somme commence par une série de méga-explosions, occasionnées par des mines placées au plus près des lignes allemandes. L’immense cratère creusé dans le sol devant la crête de l’Aubépine (Hawthorn Ridge) est le premier à être fouillé par des chercheurs britanniques, révélant comment l’armée allemande a stratégiquement pris le dessus et réduit à néant le plan initial de l’état-major anglais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cc63a4a-6045-3a4a-a841-063371b95512",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Dépression limitée par un bord abrupt, qui peut être circulaire ou elliptique.",
                                            "Dépression formée suite à une explosion au-dessus, sur ou en dessous de la surface du sol."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a61c316-5609-47a1-b3ee-ef0dc27e516a",
                                                "sense_id": "9cc63a4a-6045-3a4a-a841-063371b95512",
                                                "text": ".Ténèbres opaques. Chaos lunaire de cratères d’obus. Au fond des cratères ou chevauchant sur leurs crêtes, mêlée confuse et cruelle de souches et de troncs rompus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16ad3579-f179-3564-bef7-b43097fa4917",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Ouverture pratiquée à la partie supérieure d’un fourneau de verrier."
                                        ],
                                        "tags": [
                                            "Verrerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e621bcef-dcb7-4da6-94f2-33904d4c6f65",
                                                "sense_id": "16ad3579-f179-3564-bef7-b43097fa4917",
                                                "text": "On les adosse à un coteau ou à une butte, afin de faciliter l'accès au cratère du four lors du remplissage. On les construit de pierres des champs et de pierres calcaires, liées par du mortier."
                                            },
                                            {
                                                "example_id": "dc8be366-6e4c-436c-8d58-cee37e87e421",
                                                "sense_id": "16ad3579-f179-3564-bef7-b43097fa4917",
                                                "text": "Cette base est surmontée d'un dôme où s'ouvre le cratère permettant de cueillir le verre avec la canne de verrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af71aed6-edab-3aa4-8edb-b7435f6e3085",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Orifice, trou dans la peau, dû à un furoncle, un bubon, un anthrax…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7028d387-480d-492d-b16a-b376b2a35064",
                                                "sense_id": "af71aed6-edab-3aa4-8edb-b7435f6e3085",
                                                "text": "Le furoncle est une infection due à une bactérie, le doré. Les toxines sécrétées par la bactérie provoquent la destruction du follicule pileux ou pilosébacé et la formation d'un bourbillon (tissu blanchâtre provenant de cette destruction). L'élimination du bourbillon laisse place à un cratère rouge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "942ce264-65ce-37f6-8e84-5268438a858b",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Creux formé par l’arc électrique à l’extrémité du charbon positif."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b224b623-bd2c-3265-a738-b76a8d11f635",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Anus."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8e6b154-68a9-483f-8b6b-c33a5f450a12",
                                                "sense_id": "b224b623-bd2c-3265-a738-b76a8d11f635",
                                                "text": "[…] la vanille poivrée de son cul aux multiples replis de cratère brun !"
                                            },
                                            {
                                                "example_id": "2bbfffdd-8d33-443f-9f64-c161bf330a9f",
                                                "sense_id": "b224b623-bd2c-3265-a738-b76a8d11f635",
                                                "text": "J'ai dû lui démonter le cratère !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1fa654b-2751-3a2c-ae4e-49b41911ff0d",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Sexe féminin insatiable."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eea96e92-4e39-4028-8efe-f776505fda75",
                                                "sense_id": "c1fa654b-2751-3a2c-ae4e-49b41911ff0d",
                                                "text": "O femmes, femmes, comme le démon de la garçomanie et du putanisme vous possèdent ! votre con est un gouffre insatiable, un cratère qui voudrait user tous les vits !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb264794-d7f4-3053-8441-f782ad562c7d",
                                        "entry_id": "d1fb684e-b0fe-31bd-9dab-bfdd9e7a16f0",
                                        "glosses": [
                                            "Personne laide."
                                        ],
                                        "tags": [
                                            "pejorative",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "132689da-c33b-4a1d-b1a4-53a524194e55",
                                                "sense_id": "eb264794-d7f4-3053-8441-f782ad562c7d",
                                                "text": "Maintenant si c'est une inconnue que tu trouves canon et après l'avoir acoster tu la trouve c**** la tu te dis c'est un cratère !^([sic])"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
