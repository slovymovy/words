                "senses": [
                    {
                        "sense_id": "3028fc97-54f6-3dda-85e8-4a359b069aac",
                        "entry_id": "e30eb547-b0ac-39c8-af10-3ed8b3ee9fe0",
                        "glosses": [
                            "Imitation einer blühenden Blume oder einer Grünpflanze aus farbigen Polymeren"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "3e8e906b-5842-48a6-918a-49da5b45b425",
                                "sense_id": "3028fc97-54f6-3dda-85e8-4a359b069aac",
                                "text": "„Die „Spruchherzen“ aus Pappe, Papier- und Kunststoffblumen mit DDR-Getränkeflaschen-Aufklebern oder Ostblock-Sammelmarken bereichern nun die Museumssammlung zur Schaustellergeschichte.“"
                            },
                            {
                                "example_id": "e9085f56-74ef-4423-92b8-0c8e8bbcfda4",
                                "sense_id": "3028fc97-54f6-3dda-85e8-4a359b069aac",
                                "text": "„Damit die Blumen lieber weiterhin in der Natur blühen und nicht an eurem Haaransatz verwelken, sind Kunststoffblumen eine langlebige Variante für den blumigen Haarreifen.“"
                            },
                            {
                                "example_id": "e350746c-557a-45f4-b39e-a9dd5b492983",
                                "sense_id": "3028fc97-54f6-3dda-85e8-4a359b069aac",
                                "text": "„In verschiedenen Farben erhältlich ist die Kunststoffblume im passenden Übertopf aus Keramik erhältlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
