                ],
                "senses": [
                    {
                        "sense_id": "cca4cc0a-2ce4-377d-b19b-e087264184d2",
                        "entry_id": "17742f91-f5c1-35b8-88e1-844b4d0f0198",
                        "glosses": [
                            "полит. политика господства группы промышленно развитых стран над остальным миром в XVI—XX вв., основанная на захвате заморских территорий с целью их экономической эксплуатации"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54a0c53d-0dbb-45a3-b71f-7a31e09b5b33",
                                "sense_id": "cca4cc0a-2ce4-377d-b19b-e087264184d2",
                                "text": "В настоящее время система колониализма ликвидирована; почти все бывшие колонии получили независимость."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0af767d7-7a91-4a06-a6ce-47a9aa48cc3f",
                        "source_entry_id": "17742f91-f5c1-35b8-88e1-844b4d0f0198",
                        "source_sense_id": "cca4cc0a-2ce4-377d-b19b-e087264184d2",
                        "target_lang_word": "colonialism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colonialism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a87b5308-de14-381b-8fa5-dba36fccd1c6",
                                        "entry_id": "5d17f9f1-06a0-35cc-80b7-fae1210e659b",
                                        "glosses": [
                                            "The policy of a country seeking to extend or retain its authority over other people or territories, generally with the aim of economic dominance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d090db2-c770-46e8-9d2d-196f8d441353",
                                                "sense_id": "a87b5308-de14-381b-8fa5-dba36fccd1c6",
                                                "text": "Though most of the cases here cover European encounters with non-Europeans, it is not the intention of the book to give the impression that genocide is a function of European colonialism and imperialism alone."
                                            },
                                            {
                                                "example_id": "ca4136d3-c86a-421f-a6ae-373a9722e1b1",
                                                "sense_id": "a87b5308-de14-381b-8fa5-dba36fccd1c6",
                                                "text": "It was the racist, settler colonialism that created whiteness, that created blackness, half-caste, quarter-caste, octoroon, that saw mixed-race people as a third race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f1ab9fe-499f-3446-8d24-5948b72f5575",
                                        "entry_id": "5d17f9f1-06a0-35cc-80b7-fae1210e659b",
                                        "glosses": [
                                            "Any form of foreign influence seen as undesirable."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f94d0ab-29c3-3c67-b0e2-ec06a1454c6d",
                                        "entry_id": "5d17f9f1-06a0-35cc-80b7-fae1210e659b",
                                        "glosses": [
                                            "A colonial word, phrase, concept, or habit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb21eb4-d063-45f0-905f-8d5759363c51",
                                                "sense_id": "1f94d0ab-29c3-3c67-b0e2-ec06a1454c6d",
                                                "text": "Although the settlement seems so far to have made but slow progress, there are many things which show that, to use a colonialism, \"the place was going ahead.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c687fd2-6b38-33b5-ba6a-757ec3483203",
                                        "entry_id": "5d17f9f1-06a0-35cc-80b7-fae1210e659b",
                                        "glosses": [
                                            "Colonial life."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b557edf-452a-403b-ad9c-98b910f6a4a4",
                        "source_entry_id": "17742f91-f5c1-35b8-88e1-844b4d0f0198",
