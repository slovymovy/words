                "senses": [
                    {
                        "sense_id": "ac1385c2-a88b-356f-b36a-7c951b9d585c",
                        "entry_id": "c9651e13-a7ce-3d60-8dd2-a85569389243",
                        "glosses": [
                            "истор. связанный с выполнением тягла, обложенный тяглом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b44b73c8-8744-45d4-acc1-8576985f83e5",
                                "sense_id": "ac1385c2-a88b-356f-b36a-7c951b9d585c",
                                "text": "Тяглые люди. Тяглая земля."
                            },
                            {
                                "example_id": "68c5db0b-935d-49ee-b133-c9f6b2130b39",
                                "sense_id": "ac1385c2-a88b-356f-b36a-7c951b9d585c",
                                "text": "Как воспрещалось беломестцам обеливать приобретаемые ими посадские тяглые дворы и места, так не дозволялось и тяглым людям, селясь на белой земле, по ней обеливать самих себя."
                            }
                        ]
                    },
                    {
                        "sense_id": "55f9ab59-a842-378d-b0d3-1ecaba7fdd55",
                        "entry_id": "c9651e13-a7ce-3d60-8dd2-a85569389243",
                        "glosses": [
                            "служащий для тяги"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "765d55ee-4bf8-4dac-aeca-7f3fe4b8b22c",
                                "sense_id": "55f9ab59-a842-378d-b0d3-1ecaba7fdd55",
                                "text": "Тяглый скот."
                            }
                        ]
                    }
