                                        "sense_id": "085ed307-6758-354f-9ab4-a30f92bf337f",
                                        "entry_id": "830b8586-d7be-3f3a-901a-a9fd782ff3de",
                                        "glosses": [
                                            "An orchid; now specifically, a plant of the genus Orchis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a20b2b-75d5-4f62-b31a-6b7c2157081a",
                                                "sense_id": "085ed307-6758-354f-9ab4-a30f92bf337f",
                                                "text": "[T]heir maid has dreſſed their hats with cowſlips, orchiſſes, cuckoo-flowers, and golden-cups—[…]"
                                            },
                                            {
                                                "example_id": "2ecd092a-7f1a-40ca-a52c-8fb447aafee2",
                                                "sense_id": "085ed307-6758-354f-9ab4-a30f92bf337f",
                                                "text": "In spring, what a place it was for wild flowers!―as Lucy Raymond and her brothers well knew, having often brought home thence great bunches of dielytras and convallarias and orchises; and at any time some bright blossoms were generally to be found gleaming through the shade."
                                            },
                                            {
                                                "example_id": "0568014a-b65c-4d8e-9cd9-052cdf695835",
                                                "sense_id": "085ed307-6758-354f-9ab4-a30f92bf337f",
                                                "text": "He had a suit of summer mufti, and a broad-brimmed blue beaver hat looped with leaves broken from the hedgerows in the lanes, and a Leander scarf tucked full of flowers: loosestrife, meadowrue, orchis, ragged-robin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f3f1668-36f1-3e0d-93bd-a65258d5164f",
                                        "entry_id": "830b8586-d7be-3f3a-901a-a9fd782ff3de",
                                        "glosses": [
                                            "A testis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
