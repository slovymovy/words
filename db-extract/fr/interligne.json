                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ef1bf279-c75b-4215-8ffc-6bc2ed9be2c5",
                        "entry_id": "1006acc6-a65a-3f26-b951-2ac5710905ce",
                        "tags": [
                            "plural"
                        ],
