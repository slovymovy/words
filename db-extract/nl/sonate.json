                ],
                "translations": [
                    {
                        "translation_id": "37717b9f-29d6-4e4d-9846-28e4039fdb05",
                        "source_entry_id": "5029b164-c465-30fc-8a4d-160a2c752d79",
                        "source_sense_id": "2c335fbf-ada7-3a5d-b119-910ffdee496f",
