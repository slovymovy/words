                    {
                        "translation_id": "688f256e-0157-42e6-a42f-bd14de185295",
                        "source_entry_id": "c7af6d14-aeb1-301d-b9b1-3233cbc4f5df",
                        "source_sense_description": "city and port in the province of Syracuse, Sicily",
                        "target_lang_word": "Syrakuzy",
