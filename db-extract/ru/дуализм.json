                                                "sense_id": "b9b712e3-9457-3141-b9e8-15875d8a553d",
                                                "text": "Weininger uznaje daleko posunięty dualizm kobiety i mężczyzny, którzy reprezentują tak samo jak u Kokoschki dwie krańcowo różne formy bytu"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "1f813f75-6eb1-3287-add5-6c10057f113e",
                                        "entry_id": "3af227a7-435e-30e7-841a-35937eebdd00",
                                        "glosses": [
                                            "nurt w filozofii uznający za postawę bytu dwie odrębne substancje"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ad52b0-ba66-4c68-9fb2-275600a4fa44",
                                                "sense_id": "1f813f75-6eb1-3287-add5-6c10057f113e",
                                                "text": "[…] w uporządkowaniu materiału wyraźnie zaznacza się wpływ tak popularnego podówczas neoplatonizmu, akcentującego dualizm tego, co cielesne i duchowe, ziemskie i niebiańskie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
