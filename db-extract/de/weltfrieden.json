                        "source_sense_id": "432d3cf6-b8d0-3f49-8a8e-995f6ea0d3e2",
                        "source_sense_description": "Wunschzustand, in dem alle Nationen der Erde in Frieden miteinander leben",
                        "target_lang_word": "мир во всём мире",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мир во всём мире",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3faac493-dc19-3f6d-b148-35c388f871cb",
                                        "entry_id": "89eb9f14-849c-3d82-ae52-07075a00551d",
                                        "glosses": [
                                            "идеал свободы, мира и счастья между странами, внутри всех стран, между всеми людьми"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4457349a-f964-4626-bf22-5d5813413b9b",
                                                "sense_id": "3faac493-dc19-3f6d-b148-35c388f871cb",
                                                "text": "Победив, он убедился, что война кончилась, и стал бороться за мир во всём мире."
                                            },
                                            {
                                                "example_id": "d31320fb-17c4-4210-b2ba-bfcd830332bd",
                                                "sense_id": "3faac493-dc19-3f6d-b148-35c388f871cb",
                                                "text": "Люди, то есть народы, должны обманываться, они не достойны вдохновляющих примеров служения, поскольку все погрязли в мелочной суете, ― так проповедовал этот дядюшка, по недоразумению оказавшийся в одном стане с истинными борцами за мир во всём мире…"
                                            },
                                            {
                                                "example_id": "92d57c05-1d5c-457b-880c-8565ecc3db82",
                                                "sense_id": "3faac493-dc19-3f6d-b148-35c388f871cb",
                                                "text": "Вот почему достаточно в мире одной любви, чтобы наступил тот самый мир во всём мире."
                                            },
                                            {
                                                "example_id": "9685f3a0-5b23-45a4-803a-c1eded5015fe",
                                                "sense_id": "3faac493-dc19-3f6d-b148-35c388f871cb",
                                                "text": "Он мыслил о политике только в глобальных терминах, имея в качестве конечной цели мир во всём мире, и считая мир в семье и нации промежуточными стадиями в совершенствовании мирового порядка"
                                            },
                                            {
                                                "example_id": "1b8d2812-86a0-4671-9e43-522d4bbba47c",
                                                "sense_id": "3faac493-dc19-3f6d-b148-35c388f871cb",
                                                "text": "Казалось, будто все умеют читать мысли и знают, как она предала мир во всём мире."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
