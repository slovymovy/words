                        "glosses": [
                            "Characterized by or prone to writhing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0b24112-5e13-48fe-baa6-402a80c50977",
                                "sense_id": "6979dc85-03a3-31a2-a3ee-3af1d5f5b4fe",
                                "text": "Maud's dances were termed “wiggly, writhy, squirmy”—rendering them more reptilian than artistic in tone."
                            },
                            {
                                "example_id": "962c2c17-b914-437b-882e-61a2644c2e14",
                                "sense_id": "6979dc85-03a3-31a2-a3ee-3af1d5f5b4fe",
                                "text": "Nor fly, nor insect, nor writhy snake, escape their deep research."
                            },
                            {
                                "example_id": "2b202d7b-227e-4f84-9ea7-3c204d7ab697",
                                "sense_id": "6979dc85-03a3-31a2-a3ee-3af1d5f5b4fe",
                                "text": "When we caught a writhy, stunted fish, wide-eyed, mouthing silence, which slipped out of our hands, we picked it up, threw it back to its mud-blind home."
                            }
                        ]
                    }
