                                "target_senses": [
                                    {
                                        "sense_id": "7f8b6e39-d86a-3927-a466-fbd96fc9359d",
                                        "entry_id": "cc693a6b-5d5f-3bba-8467-8669f118b009",
                                        "glosses": [
                                            "Alternative spelling of penny pincher."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a23d18-8837-4833-99bc-b47881cb4ff1",
                                                "sense_id": "7f8b6e39-d86a-3927-a466-fbd96fc9359d",
                                                "text": "Hopefully, the penny-pinchers at the DfT/Treasury will finally agree to this. otherwise many of the proposed benefits will be lost."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa5afc17-01d5-4ea3-9694-b0b48a8172ac",
                        "source_entry_id": "ae8d8bf6-bd1c-38e2-9899-d5ce613c3c60",
                        "source_sense_id": "a3892a65-b674-302b-b398-ffc1cab40f0b",
                        "source_sense_description": "schwäbisch, vornehmlich in Baden-Württemberg: Geizhals",
                        "target_lang_word": "skinflint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skinflint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "275dfc06-26ae-33b0-b70a-5dfd7d4a31c6",
                                        "entry_id": "434af2b8-3cb5-3177-910b-87ff1676e5b7",
                                        "glosses": [
                                            "One who is excessively stingy or cautious with money; a tightwad; a miser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6639ad56-a163-4679-8d21-88dda687621a",
                                                "sense_id": "275dfc06-26ae-33b0-b70a-5dfd7d4a31c6",
                                                "text": "You know, he is quite a different sort from the Public Prosecutor and our other provincial skinflints--fellows who shiver in their shoes before they will spend a single kopeck."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7df59f6-c4a4-4048-abec-9a2f3a64f93c",
                        "source_entry_id": "ae8d8bf6-bd1c-38e2-9899-d5ce613c3c60",
                        "source_sense_id": "a3892a65-b674-302b-b398-ffc1cab40f0b",
                        "source_sense_description": "schwäbisch, vornehmlich in Baden-Württemberg: Geizhals",
                        "target_lang_word": "pingre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pingre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1b211c5-b5af-3553-8ab7-9a7a98befc3f",
                                        "entry_id": "d19dc18b-649d-3345-960b-96b55b2ad3bd",
                                        "glosses": [
                                            "Avare."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da495a56-957d-4d18-834b-ba3e847009c6",
                                                "sense_id": "b1b211c5-b5af-3553-8ab7-9a7a98befc3f",
                                                "text": "La pingrerie, c'est une économie de la dépense qui dépasse les bornes, et le pingre est du genre à réclamer endéans le mois, à domicile, le remboursement d'une demi-obole."
                                            },
                                            {
                                                "example_id": "3bccf96a-ac73-4899-88ea-2c111265d788",
                                                "sense_id": "b1b211c5-b5af-3553-8ab7-9a7a98befc3f",
                                                "text": "Il devait me les payer. Mais, comme par hasard, cet abominable pingre, doublé d'un combineur sans vergogne, n'avait jamais le sou sur lui, […]."
                                            },
                                            {
                                                "example_id": "fb911d8c-0ec1-475c-8825-ec13f29c5548",
                                                "sense_id": "b1b211c5-b5af-3553-8ab7-9a7a98befc3f",
                                                "text": "Un collègue pourrait être un abominable pingre, doublé d'un radin, s’il venait travailler en étant conscient qu’il risquerait d’infecter tout le monde juste par peur de ne pas être payé , […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1785e74a-2cce-3c87-92ad-9a3ac7043005",
                                        "entry_id": "d19dc18b-649d-3345-960b-96b55b2ad3bd",
                                        "glosses": [
                                            "Personne méchante, effrontée et vêtue chichement."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1368263f-a442-32bd-b5bc-5bbd5843d089",
                                        "entry_id": "d19dc18b-649d-3345-960b-96b55b2ad3bd",
                                        "glosses": [
                                            "Navire de commerce à fond plat du XVIIIᵉ siècle."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e7f4d93-3a1d-4e4f-a5dd-93b07a2b724a",
                                                "sense_id": "1368263f-a442-32bd-b5bc-5bbd5843d089",
                                                "text": "… se trouvant attaquée par un pingre anglais, alors qu'elle revenait de Bourbon avec un plein chargement de café le 27 mars 1747, …"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pingre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cc080fa-d2bd-3906-a2f2-d9e89fad9ee3",
                                        "entry_id": "6ac5a018-bbd9-32a5-890c-53ab05d45cfc",
                                        "glosses": [
                                            "Avare."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a0ea0be-1fe9-4079-968b-1d5aeb7f1625",
                                                "sense_id": "4cc080fa-d2bd-3906-a2f2-d9e89fad9ee3",
                                                "text": "Je crois surtout que l'Europe montre une fois de plus son insuffisance et que lorsqu'il faut mettre la main à la poche, elle est pingre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
