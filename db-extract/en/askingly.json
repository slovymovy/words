                        "glosses": [
                            "In an asking manner; so as to ask."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa25a86-f82a-4758-b465-282725035e45",
                                "sense_id": "baaac559-184d-34f6-bb61-8611c5acd16a",
                                "text": "How askingly It’s footsteps t’ward me bend?\nIt seems to say, “And have I then one Friend?”"
                            },
                            {
                                "example_id": "82d10c3d-73b9-491c-98b3-45aa8e98d1bb",
                                "sense_id": "baaac559-184d-34f6-bb61-8611c5acd16a",
                                "text": "“I don’t know whether this is something your wife ever knew about or not?” he began askingly."
                            },
                            {
                                "example_id": "387b68b5-0096-4b66-b29e-a00b9cb180d7",
                                "sense_id": "baaac559-184d-34f6-bb61-8611c5acd16a",
                                "text": "Aspiration is looking askingly; to reach a desirable result one must look askingly toward that which can fulfill."
                            },
                            {
                                "example_id": "d372194f-07ca-4c45-84f6-c31ef9ca890b",
                                "sense_id": "baaac559-184d-34f6-bb61-8611c5acd16a",
                                "text": "“That can’t possibly be true,” I say. But he looks at me so sadly, askingly, across his desk—"
                            }
                        ]
                    }
