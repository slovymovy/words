                "senses": [
                    {
                        "sense_id": "3cf43c7a-2ec7-3416-91cf-2d0b1382c9d6",
                        "entry_id": "7c4e6cff-9827-32b0-a719-ed6de8a52965",
                        "glosses": [
                            "Faire perdre son caractère arqué à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "820b470c-8f47-4987-9972-836df50323fc",
                                "sense_id": "3cf43c7a-2ec7-3416-91cf-2d0b1382c9d6",
                                "text": "Malgré les fatigues que subissent l’avant et l’arrière, l’excès, dans le centre du navire, du poids sur le déplacement, les efforts même et les vibrations du moteur, tendent à désarquer le navire."
                            },
                            {
                                "example_id": "70e0bbba-d0d8-4ef7-83d0-9424c33ec81a",
                                "sense_id": "3cf43c7a-2ec7-3416-91cf-2d0b1382c9d6",
                                "text": "ils virent Kabaï se redresser dans l’herbe demi-haute désarquer son long dos étirer ses longs bras puis demander à Méridéala si la cueillette n’avait pas assez duré"
                            }
                        ]
                    }
