            {
                "entry_id": "3f2cd314-e524-3e1a-9393-346167dbd94b",
                "word": "trapan",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a020754a-38c8-4aad-94e9-e0583005d600",
                        "entry_id": "3f2cd314-e524-3e1a-9393-346167dbd94b",
                        "tags": [
                            "present",
                            "singular",
                            "third-person"
                        ],
                        "form": "trapans"
                    },
                    {
                        "form_id": "99e7272b-bf3c-465d-b201-e6730f376ce3",
                        "entry_id": "3f2cd314-e524-3e1a-9393-346167dbd94b",
                        "tags": [
