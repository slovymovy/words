{
    "word_family": [
        "dread"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44c5b033-c3b1-3364-b6b7-08180eb08724",
                    "sense_definition": "A matted coil of hair formed by locking strands together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hair_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a single <w>dreadlock</w> tied back with a colorful ribbon.",
                            "target_lang_translations": {
                                "zh": "他留着一根<w>脏辫</w>，并用彩色丝带扎在脑后。"
                            }
                        },
                        {
                            "text": "The stylist carefully separated each <w>dreadlock</w> to keep the hair healthy.",
                            "target_lang_translations": {
                                "zh": "造型师小心地分开每一根<w>脏辫</w>，以保持头发健康。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "long dreadlock",
                        "thick dreadlock"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种将头发缠绕、打结而形成的辫子发型。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脏辫",
                                "target_lang_sense_clarification": "指将头发编织成紧密缠绕的辫子，是该发型的通用称呼。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2ef02cfa-0527-3c64-a31d-5e94d715e206",
                    "sense_definition": "To style hair into matted coils.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hair_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>dreadlock</w> her hair for the summer festival.",
                            "target_lang_translations": {
                                "zh": "她决定为了夏季音乐节去<w>编脏辫</w>。"
                            }
                        },
                        {
                            "text": "It takes many hours to <w>dreadlock</w> long hair properly.",
                            "target_lang_translations": {
                                "zh": "把长发妥善地<w>编脏辫</w>需要花费很多个小时。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将头发编成脏辫。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "编脏辫",
                                "target_lang_sense_clarification": "指进行编织脏辫这一动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}