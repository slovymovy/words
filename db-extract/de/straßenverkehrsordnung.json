                "senses": [
                    {
                        "sense_id": "814c4274-673d-3540-a98c-a5dd04c2944c",
                        "entry_id": "ce313ef8-5dc5-3ca2-9c76-b6ad3943eff2",
                        "glosses": [
                            "eine Rechtsverordnung, in der alle Regeln für alle Straßenverkehrsteilnehmer festgelegt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48f31908-a5af-4b77-a91c-5b157d07329b",
                                "sense_id": "814c4274-673d-3540-a98c-a5dd04c2944c",
                                "text": "Die Straßenverkehrsordnungen von Deutschland und England divergieren doch erheblich."
                            },
                            {
                                "example_id": "4fefc0ea-8eeb-4c99-aa43-887cbef668df",
                                "sense_id": "814c4274-673d-3540-a98c-a5dd04c2944c",
                                "text": "„Nun wurde die Novelle der Straßenverkehrsordnung (StVO) konkretisiert: Laut einer begleitenden Verordnung sollen 49 Autobahnabschnitte mittels Asfinag-Kameras überwacht werden.“"
                            },
                            {
                                "example_id": "e6a696be-7453-4f98-989b-839aa7dbef60",
                                "sense_id": "814c4274-673d-3540-a98c-a5dd04c2944c",
                                "text": "„Falls ich bis Ende der Woche keine präzise Antwort auf diese und alle anderen schwebenden Fragen der Straßenverkehrsordnung erhalte, fahre ich künftig ohne vorherige Warnung nach dem gesunden Menschenverstand.“"
                            },
                            {
                                "example_id": "4a3d1fae-57a9-4ae8-8fe3-41be749a5868",
                                "sense_id": "814c4274-673d-3540-a98c-a5dd04c2944c",
                                "text": "„So auch im Bundesverkehrsministerium, das im April 2013 die Straßenverkehrsordnung in Gendersprech novellierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
