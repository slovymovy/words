                "senses": [
                    {
                        "sense_id": "6190e421-176a-3cfc-8ab3-e8bdf3e7f1fe",
                        "entry_id": "8eef804e-e9e8-3280-b5b5-a109b391ac80",
                        "glosses": [
                            "To lodge; to stay temporarily."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "84f35874-fcb5-4bf1-a9d5-78a02043166e",
                                "sense_id": "6190e421-176a-3cfc-8ab3-e8bdf3e7f1fe",
                                "text": "Let mee freely- enterchange a word with thee ( oh! body ) what rusticall & rude Clowne, very block head, and course conditioned fellow should hee be valiewed, to whose house might happen a Prince or Earle to come to allodge, who would not willingly and most readily giue way,..."
                            },
                            {
                                "example_id": "be25daec-1193-4859-9052-10314ebe5503",
                                "sense_id": "6190e421-176a-3cfc-8ab3-e8bdf3e7f1fe",
                                "text": "An encampment of 30000 footemen, and 6000 horsemen, allodged and fortified in an open Campania: hauing a riuer running on the one side."
                            },
                            {
                                "example_id": "6a008bda-a64c-4ad3-be15-a920a66cb213",
                                "sense_id": "6190e421-176a-3cfc-8ab3-e8bdf3e7f1fe",
                                "text": "Upon sight hereof pay unto Edward Chamberlaine, esq., the summe of ten pounds, being for an iron chest fo the use of the deputy leiutenants to allodge the publick money in according to the directions of his Majestie's letters, given under our hands the 12th of July 1665."
                            }
                        ]
                    }
