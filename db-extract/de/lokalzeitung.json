                ],
                "senses": [
                    {
                        "sense_id": "67265230-93da-3bae-9d0f-d1ea8dfc2fac",
                        "entry_id": "bb1cb182-b0e0-3f34-9c1e-5542c312dc04",
                        "glosses": [
                            "örtlich begrenzte Zeitung, lokale Zeitung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99af8df8-1734-440a-b77a-bcdfda93c04a",
                                "sense_id": "67265230-93da-3bae-9d0f-d1ea8dfc2fac",
                                "text": "„In den Schulen wurde weiter unterrichtet, sogar die Lokalzeitungen konnten weiter erscheinen.“"
                            },
                            {
                                "example_id": "21fed7ad-1d82-416f-85bc-0c3b6aadfdac",
                                "sense_id": "67265230-93da-3bae-9d0f-d1ea8dfc2fac",
                                "text": "„Der ebenfalls anwesende Schriftsteller Maurice G. Dantec berichtete in einer Lokalzeitung begeistert von dem Ereignis; dies war die erste gewichtige intellektuelle Unterstützung für dieses Projekt.“"
                            },
                            {
                                "example_id": "3ebd5b49-db1e-4958-900f-f75a581a9196",
                                "sense_id": "67265230-93da-3bae-9d0f-d1ea8dfc2fac",
                                "text": "„Das Stück war gut, und ich schrieb für die Lokalzeitung eine Besprechung, die vom Hotelbesitzer übersetzt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
