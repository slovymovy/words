                ],
                "senses": [
                    {
                        "sense_id": "aa5dd230-1cb8-325f-a38c-2d31d4a79a61",
                        "entry_id": "dd65ef7e-8a37-3d6e-8aca-ab4034c155d9",
                        "glosses": [
                            "устар., разг. то же, что завтрак"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61137282-a158-4980-839d-1dc9552e1a41",
                                "sense_id": "aa5dd230-1cb8-325f-a38c-2d31d4a79a61",
                                "text": "Забавник этот Пётр Сергеич! Ну ладно, скажи: хорошо! Пусть только фриштик получше приготовит… Скажи: буду! Наталье Егоровне и деточкам кланяйся!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cd42dee-f777-41fa-8294-abf286e893a7",
                        "source_entry_id": "dd65ef7e-8a37-3d6e-8aca-ab4034c155d9",
                        "source_sense_id": "aa5dd230-1cb8-325f-a38c-2d31d4a79a61",
                        "target_lang_word": "Frühstück",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frühstück",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1a8385d-bb98-3c64-85ad-c5b46f99ec76",
                                        "entry_id": "4e2e2017-43e3-3f85-969a-a8fd018001a3",
                                        "glosses": [
                                            "Mahlzeit, die man am Morgen oder Vormittag zu sich nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b705cf66-6c0e-4889-b9d3-6bc52ad2fcf8",
                                                "sense_id": "a1a8385d-bb98-3c64-85ad-c5b46f99ec76",
                                                "text": "Zum Frühstück isst Jutta täglich eine Schüssel Müsli."
                                            },
                                            {
                                                "example_id": "1ffb64d1-911e-4069-ac61-39570615250c",
                                                "sense_id": "a1a8385d-bb98-3c64-85ad-c5b46f99ec76",
                                                "text": "Viele Urlauber waren mit dem spärlichen Frühstück im Zwei-Sterne-Hotel nicht zufrieden."
                                            },
                                            {
                                                "example_id": "f2f92538-0138-41b8-a353-939f0ab23557",
                                                "sense_id": "a1a8385d-bb98-3c64-85ad-c5b46f99ec76",
                                                "text": "In Japan isst man Reis, Natto, gebratenen Fisch und Misosuppe zum Frühstück."
                                            },
                                            {
                                                "example_id": "e138df8d-933d-4e23-9c52-f7ac82e1e7c9",
                                                "sense_id": "a1a8385d-bb98-3c64-85ad-c5b46f99ec76",
                                                "text": "„Nachdem John sein Frühstück wortlos verzehrt hatte, ging er, den Frost und das bläulich flimmernde Mondlicht verfluchend, fort.“"
                                            },
                                            {
                                                "example_id": "e3d1b60e-5e10-4367-97f3-083434e532b8",
                                                "sense_id": "a1a8385d-bb98-3c64-85ad-c5b46f99ec76",
                                                "text": "„Es macht ihm anscheinend nichts aus, daß er zum Frühstück Kaffee-Ersatz trinken und sich beim Abendessen mit Schwarzbrot in Wasser begnügen muß.“"
                                            },
                                            {
                                                "example_id": "9f429bf9-2da7-4829-9d86-3792c71375c1",
                                                "sense_id": "a1a8385d-bb98-3c64-85ad-c5b46f99ec76",
                                                "text": "„Am nächsten Tag um elf empfing mich ein opulentes Frühstück im Esszimmer der Pension.“"
                                            },
                                            {
                                                "example_id": "d4bb9c0d-3a60-49f3-805b-7a0246e91d40",
                                                "sense_id": "a1a8385d-bb98-3c64-85ad-c5b46f99ec76",
                                                "text": "„Wir haben uns dann aber nicht lange mit dem Frühstück aufgehalten, sondern sind rasch losgezogen.“"
                                            },
                                            {
                                                "example_id": "cfd420cb-da09-46c3-8158-840eab8656b8",
                                                "sense_id": "a1a8385d-bb98-3c64-85ad-c5b46f99ec76",
                                                "text": "„Gegen halb neun holte sie ihn zum Frühstück ab.“"
                                            },
                                            {
                                                "example_id": "838b5fc1-508f-47e6-9b59-2ddb08cbbcf0",
                                                "sense_id": "a1a8385d-bb98-3c64-85ad-c5b46f99ec76",
                                                "text": "„Bei festlichen Anlässen, Dinners und Frühstücken wurden aufmerksam alle Vorschriften der englischen Etikette beachtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
