                "senses": [
                    {
                        "sense_id": "164f3092-3237-3118-b639-c2eea4821e49",
                        "entry_id": "0e67b1ec-9b49-3169-8e82-640971f3c94e",
                        "glosses": [
                            "Geschwister eines Elternteils einer Person"
                        ],
                        "tags": [
                            "jargon",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6f9d30ae-0b9a-4edb-ab60-2d6ea5db95c4",
                                "sense_id": "164f3092-3237-3118-b639-c2eea4821e49",
                                "text": "„Für Fälle mit einem kranken Eltergeschwister gilt die Gleichung W_U = p - 1,25p² + 0,25p².“"
                            },
                            {
                                "example_id": "703026d8-4e40-4c32-8f20-e821813b420e",
                                "sense_id": "164f3092-3237-3118-b639-c2eea4821e49",
                                "text": "„Falls Verwandte oder Verschwägerte in der Seitenlinie von Verfolgungsmaßnahmen betroffen sind, gilt das Auskunftsverweigerungsrecht nur bis zum dritten Grad, also beispielsweise Geschwister, Eltergeschwister (Onkel/Tante) und deren Kinder.“"
                            },
                            {
                                "example_id": "2e148d69-0d81-4351-b460-b60f620b8c51",
                                "sense_id": "164f3092-3237-3118-b639-c2eea4821e49",
                                "text": "„Von den vom Verf . erzielten Untersuchungsergebnissen ist ferner die niedrige, nur etwa 60% erreichende Penetranz des Gliomgens in jenen Geschwisterschaften bemerkenswert, in denen das Leiden erstmals in Erscheinung tritt, während in Geschwisterreihen mit gliombehafteten Eltern oder Eltergeschwistern eine etwa 90% erreichende Penetranz beobachtet wird.“"
                            },
                            {
                                "example_id": "a3aaf63e-2533-4d2a-92b7-88a6a66cfa9c",
                                "sense_id": "164f3092-3237-3118-b639-c2eea4821e49",
                                "text": "„Rückkreuzung behafteter Tiere mit unbehafteten Eltern oder Eltergeschwistern (die aber selbst Eltern behafteter Tiere sind), ergibt ebenfalls behaftete neben unbehafteten Tieren.“"
                            },
                            {
                                "example_id": "a741ea26-3ee3-4b9f-bf67-b9ef8a70ab0f",
                                "sense_id": "164f3092-3237-3118-b639-c2eea4821e49",
                                "text": "„Zahlreicher sind die Abweichungen von der Norm bei den Eltergeschwistern: ...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
