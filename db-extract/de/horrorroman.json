                "senses": [
                    {
                        "sense_id": "1d164a02-e1d7-3616-b51c-778dc6964cda",
                        "entry_id": "5b93cfb1-613a-3111-bf46-71dea1722f3c",
                        "glosses": [
                            "Roman aus dem Horrorgenre, mit unheimlichem, düsteren Inhalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "298d490a-e66f-4469-a7a8-983239d58496",
                                "sense_id": "1d164a02-e1d7-3616-b51c-778dc6964cda",
                                "text": "„Ich hatte einmal versucht, einen Horrorroman über Ratten zu lesen, der nichts weiter bewirkte, als mich friedlich einschlummern zu lassen.“"
                            },
                            {
                                "example_id": "a9754441-c6a9-4785-8fe6-8ea0b8ba7694",
                                "sense_id": "1d164a02-e1d7-3616-b51c-778dc6964cda",
                                "text": "„Die professionellen Studenten - ältere Typen mit Bärten und unzeitgemäß langen Haaren sowie Powerfrauen in Geschäftskleidung - belegten die Plätze an den Rändern, und ganz hinten hockten die Sonderlinge, die aussahen, als würden sie Horrorromane nicht nur lesen, sondern darin leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
