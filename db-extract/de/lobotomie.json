                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e5c3116-6fcc-439b-b846-35cbd4bc00ae",
                                                "sense_id": "497ddf4a-a46e-3027-b545-bfa9ee68f932",
                                                "text": "It was the invention of the frontal lobotomy (though it was then often called a leucotomy, particularly in Britain)."
                                            }
