                "senses": [
                    {
                        "sense_id": "695f486b-9810-32bc-be09-ab6f748f8e0f",
                        "entry_id": "f2acd781-e639-3694-ab7a-f84b44f7681b",
                        "glosses": [
                            "Bürste für die Haarpflege"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2b5493d-8285-4773-bdde-9f09efaac08f",
                                "sense_id": "695f486b-9810-32bc-be09-ab6f748f8e0f",
                                "text": "„Hinter dem Fahrersitz hängt ein geflochtener Strohkorb mit Haarbürste, Bodylotion, einer Zahnbürste und drei Tiegeln Kosmetika.“"
                            },
                            {
                                "example_id": "91eecde2-86d4-43b3-8c78-2fd30ef263dd",
                                "sense_id": "695f486b-9810-32bc-be09-ab6f748f8e0f",
                                "text": "„Sie sollen Haarknoten entwirren, für schönen Glanz sorgen und die Durchblutung der Kopfhaut anregen. Doch welche Haarbürste ist wirklich gut?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be5cf343-7c3e-402d-a7b5-52dff098572d",
                        "source_entry_id": "f2acd781-e639-3694-ab7a-f84b44f7681b",
