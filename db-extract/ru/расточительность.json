                    {
                        "form_id": "91724528-2fa9-427e-bd8d-efb5a93cf654",
                        "entry_id": "f3de4af4-dc3f-3c27-96b2-d4d3b3ec0e06",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "расточи́тельностях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "09363fca-0e17-35ae-bf3f-ff46345d6559",
                        "entry_id": "f3de4af4-dc3f-3c27-96b2-d4d3b3ec0e06",
                        "glosses": [
                            "свойство по значению прилагательного расточительный; излишняя (часто неразумная) щедрость в тратах, расходовании чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7725fd8d-ff55-4918-9bda-555407568355",
                                "sense_id": "09363fca-0e17-35ae-bf3f-ff46345d6559",
                                "text": "Кроме того, мне хорошо была известна расточительность моей дочери; уже только поэтому нельзя было не опасаться за дурные последствия ее нового шага."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cbfa9db-c331-4d4a-9eb4-c1494b8ab077",
                        "source_entry_id": "f3de4af4-dc3f-3c27-96b2-d4d3b3ec0e06",
                        "source_sense_id": "09363fca-0e17-35ae-bf3f-ff46345d6559",
                        "target_lang_word": "extravagance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extravagance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66b6180c-7438-357d-8ef0-e14b003c1c4b",
                                        "entry_id": "73ba55aa-e5c6-3a44-ab73-44778ec9de68",
                                        "glosses": [
                                            "Excessive or superfluous expenditure of money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eeb9725c-5485-3434-bbbb-7805ee22970d",
                                        "entry_id": "73ba55aa-e5c6-3a44-ab73-44778ec9de68",
                                        "glosses": [
                                            "Prodigality, as of anger, love, expression, imagination, or demands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5056dfc9-91b6-4998-83e7-6592ac44d674",
                                                "sense_id": "eeb9725c-5485-3434-bbbb-7805ee22970d",
                                                "text": "The visions of romance were over. Catherine was completely awakened. Henry’s address, short as it had been, had more thoroughly opened her eyes to the extravagance of her late fancies than all their several disappointments had done."
                                            },
                                            {
                                                "example_id": "e099f61e-fcbd-453c-b3ef-d95820a56bba",
                                                "sense_id": "eeb9725c-5485-3434-bbbb-7805ee22970d",
                                                "text": "A great bargain also had been the excellent Axminster carpet which covered the floor; as, again, the arm-chair in which Bunting now sat forward, staring into the dull, small fire. In fact, that arm-chair had been an extravagance of Mrs. Bunting. She had wanted her husband to be comfortable after the day's work was done, and she had paid thirty-seven shillings for the chair."
                                            },
                                            {
                                                "example_id": "afbb4dbe-44e0-425b-b091-8194940c17ac",
                                                "sense_id": "eeb9725c-5485-3434-bbbb-7805ee22970d",
                                                "text": "At the same time he will need most carefully to avoid anything resembling extravagance or overstatement. While no socialist heorist has ever been known to discredit himself with his fellows even by the silliest of proposals, the old-fashioned liberal will damn himself by an impracticable suggestion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43f119d7-ef0f-3144-b895-bf31bbbaedae",
                                        "entry_id": "73ba55aa-e5c6-3a44-ab73-44778ec9de68",
                                        "glosses": [
                                            "Something extravagant; something done out of extravagance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b272a4-3b47-4e9d-bed5-09ba69eb0765",
                                                "sense_id": "43f119d7-ef0f-3144-b895-bf31bbbaedae",
                                                "text": "That luxury car is an extravagance you can't afford."
                                            },
                                            {
                                                "example_id": "24120f39-2eab-4e66-8d1b-38a6bc366309",
                                                "sense_id": "43f119d7-ef0f-3144-b895-bf31bbbaedae",
                                                "text": "There were no limos or extravagances at this point, because we all wanted to make as much money as possible. We played it cheap. No huge catering bills, no wild parties, not even upgraded hotel rooms. Whenever we arrived at an airport Robin would be there to meet us in a rented SUV or big sedan, and we'd head to the gig on our own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d97f630-3e2f-4397-be2d-ce02533cb54c",
                        "source_entry_id": "f3de4af4-dc3f-3c27-96b2-d4d3b3ec0e06",
                        "source_sense_id": "09363fca-0e17-35ae-bf3f-ff46345d6559",
                        "target_lang_word": "wastefulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wastefulness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "668d3270-4512-3f2e-aeb0-7a6bf4fef781",
                                        "entry_id": "18053b83-4fee-348f-99fd-09c82e6160f8",
                                        "glosses": [
                                            "imprudent or excessive expenditure or the waste of resources"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ccd54d7-237b-468e-a00e-0e482454cbae",
                                                "sense_id": "668d3270-4512-3f2e-aeb0-7a6bf4fef781",
                                                "text": "Arsenal paid the price for that wastefulness when Chelsea took the lead after 14 minutes. Mata was afforded to much space by Santos and when the ponderous Per Mertesacker missed his cross Lampard timed his arrival perfectly to head past Wojciech Szczesny."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5708ea9-5e45-45be-bb29-cae2a4c11e37",
                        "source_entry_id": "f3de4af4-dc3f-3c27-96b2-d4d3b3ec0e06",
                        "source_sense_id": "09363fca-0e17-35ae-bf3f-ff46345d6559",
                        "target_lang_word": "dissipation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissipation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52968849-0640-3ff9-980d-53b30a946613",
                                        "entry_id": "b3a905aa-df56-3e90-9abc-706d765e5d70",
                                        "glosses": [
                                            "The act of dissipating or dispersing; a state of dispersion or separation; dispersion; waste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dbc114e-9ed6-49bc-8853-79d8505a95a5",
                                                "sense_id": "52968849-0640-3ff9-980d-53b30a946613",
                                                "text": "without loss or dissipation of the matter"
                                            },
                                            {
                                                "example_id": "de48f708-9e2d-41ea-a3a4-dc14d6d7d87f",
                                                "sense_id": "52968849-0640-3ff9-980d-53b30a946613",
                                                "text": "the famous dissipation of mankind"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce815612-8b28-31aa-aafc-78ecc1b96fee",
                                        "entry_id": "b3a905aa-df56-3e90-9abc-706d765e5d70",
                                        "glosses": [
                                            "A dissolute course of life, in which health, money, etc., are squandered in pursuit of pleasure; profuseness in immoral indulgence, as late hours, riotous living, etc.; dissoluteness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a876d9-443d-4825-bdfa-ca38c989b904",
                                                "sense_id": "ce815612-8b28-31aa-aafc-78ecc1b96fee",
                                                "text": "I rose by candle-light, and consumed, in the intensest application, the hours which every other individual of our party wasted in enervating slumbers, from the hesternal dissipation or debauch."
                                            },
                                            {
                                                "example_id": "d7969a78-bbce-4ba4-bc0a-9a4918c5b4e2",
                                                "sense_id": "ce815612-8b28-31aa-aafc-78ecc1b96fee",
                                                "text": "18th century, Patrick Henry in a parliamentary debate\nto reclaim the spendthrift from his dissipation and extravagance"
                                            },
                                            {
                                                "example_id": "afd9e845-b855-456b-b938-5a11377a3b7b",
                                                "sense_id": "ce815612-8b28-31aa-aafc-78ecc1b96fee",
                                                "text": "He neither wept nor prayed; he cursed and defied: execrated God and man, and gave himself up to reckless dissipation."
                                            },
                                            {
                                                "example_id": "afbfd431-0a95-4e8d-a57e-d4d99e06a874",
                                                "sense_id": "ce815612-8b28-31aa-aafc-78ecc1b96fee",
                                                "text": "[...] This is a surprise attack, and I’d no wish that the garrison, forewarned, should escape. I am sure, Lord Stranleigh, that he has been descanting on the distraction of the woods and the camp, or perhaps the metropolitan dissipation of Philadelphia, [...]"
                                            },
                                            {
                                                "example_id": "35d83343-a0d5-46df-b681-a021a0880eb4",
                                                "sense_id": "ce815612-8b28-31aa-aafc-78ecc1b96fee",
                                                "text": "An oil lamp burned upon a high, old-fashioned mantel, casting its dim rays over a dozen repulsive figures. All but one were men. The other was a woman of about thirty. Her face, marked by low passions and dissipation, might once have been lovely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cb8b25f-c5d6-3fcc-81f7-9b7f1c9c3f71",
                                        "entry_id": "b3a905aa-df56-3e90-9abc-706d765e5d70",
                                        "glosses": [
                                            "A trifle which wastes time or distracts attention."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "558ed572-5a17-4015-8fc6-3dd32f64ed9f",
                                                "sense_id": "8cb8b25f-c5d6-3fcc-81f7-9b7f1c9c3f71",
                                                "text": "Prevented from finishing them [the letters] a thousand avocations and dissipations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d768e36f-f3be-3289-b0e5-9a20fabe2c15",
                                        "entry_id": "b3a905aa-df56-3e90-9abc-706d765e5d70",
                                        "glosses": [
                                            "A loss of energy, usually as heat, from a dynamic system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a063118-fdca-4f7d-bf2d-dcfbb7167ad3",
                                                "sense_id": "d768e36f-f3be-3289-b0e5-9a20fabe2c15",
                                                "text": "They conclude[…] the planet will have a final period of rotation between 56 and 88 days, depending on the assumed form of the dissipation function."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7f70dff-a5e7-4d1c-b295-d5b84948b674",
                        "source_entry_id": "f3de4af4-dc3f-3c27-96b2-d4d3b3ec0e06",
                        "source_sense_id": "09363fca-0e17-35ae-bf3f-ff46345d6559",
                        "target_lang_word": "rozrzutność",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rozrzutność",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "d7794a3d-56a6-384d-8ca0-f889c94c165d",
                                        "entry_id": "e42ea28d-530e-3912-bea5-ab75c59a939e",
                                        "glosses": [
                                            "cecha tego, co rozrzutne; cecha tych, którzy są rozrzutni"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfa47214-2a1e-4d17-bc6d-9657ee56b84a",
                                                "sense_id": "d7794a3d-56a6-384d-8ca0-f889c94c165d",
                                                "text": "Jednym z najbardziej potrzebnych wydatków Tysona było dziewięć tysięcy miesięcznie na psychoanalityka, u którego leczył się z chorobliwej rozrzutności"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3c53b30-f0ce-4b17-bb62-772dffbff604",
                        "source_entry_id": "f3de4af4-dc3f-3c27-96b2-d4d3b3ec0e06",
                        "source_sense_id": "09363fca-0e17-35ae-bf3f-ff46345d6559",
                        "target_lang_word": "prodigalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prodigalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71a03f20-52c8-3970-aebc-acce3f9051c8",
                                        "entry_id": "9b836d86-ae3e-311d-b3d2-8b38babcac82",
                                        "glosses": [
                                            "Caractère, habitude de celui ou de celle qui est prodigue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44c15877-82cc-4e6f-a3d4-a7ec585a5678",
                                                "sense_id": "71a03f20-52c8-3970-aebc-acce3f9051c8",
                                                "text": "Le sophisme que je combats dans cet écrit est d’autant plus dangereux, appliqué aux travaux publics, qu’il sert à justifier les entreprises et les prodigalités les plus folles. Quand un chemin de fer ou un pont ont une utilité réelle, il suffit d’invoquer cette utilité. Mais si on ne le peut, que fait-on ? On a recours à cette mystification : « Il faut procurer de l’ouvrage aux ouvriers. »"
                                            },
                                            {
                                                "example_id": "854c229d-e473-4ee9-bb39-8f60540a6ca1",
                                                "sense_id": "71a03f20-52c8-3970-aebc-acce3f9051c8",
                                                "text": "La parole n’était-elle pas une des plus effrayantes prodigalités de fluide vital que l’homme pouvait se permettre […]."
                                            },
                                            {
                                                "example_id": "3266bbba-522f-47c1-99f3-ee2bc7f8923b",
                                                "sense_id": "71a03f20-52c8-3970-aebc-acce3f9051c8",
                                                "text": "Soyez radin. La prodigalité attire de nombreux amis sur le court terme mais, plus tard, personne ne vous en remerciera jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f1f0409-ea8d-319e-8973-20f62a14d78e",
                                        "entry_id": "9b836d86-ae3e-311d-b3d2-8b38babcac82",
                                        "glosses": [
                                            "Action de prodiguer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf238888-2fe1-4578-a9f9-11e129f4f71b",
                                                "sense_id": "3f1f0409-ea8d-319e-8973-20f62a14d78e",
                                                "text": "« La ferme parfaitement autarcique de nos amis restait sur le modèle des fermes de l’an mil, racontait-il au soir de sa vie. Le monde, lui, a plus changé pendant le déroulement de ma propre existence qu’il n’avait changé depuis le néolithique à la ferme de Marcillat. » Cette expérience de vie simple, où la subsistance est suspendue à la prodigalité de la nature, le marque profondément."
                                            },
                                            {
                                                "example_id": "a70caa62-0423-45e8-8396-9a367f4cc3e2",
                                                "sense_id": "3f1f0409-ea8d-319e-8973-20f62a14d78e",
                                                "text": "Ses prodigalités l’ont ruiné en peu de temps. - Il s’est ruiné en folles prodigalités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc005cde-a909-3095-8526-e1671c7dcc11",
                                        "entry_id": "9b836d86-ae3e-311d-b3d2-8b38babcac82",
                                        "glosses": [
                                            "Richesse, exubérance, profusion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a6a22ec-4fbf-4c1e-8f19-be5fd3318bd1",
                                                "sense_id": "dc005cde-a909-3095-8526-e1671c7dcc11",
                                                "text": "Quels hommes étaient-ce donc que ceux qui exécutaient ces merveilleuses constructions que les prodigalités des palais féeriques ne pourraient dépasser ? La race en est-elle donc perdue ? Et nous, qui nous vantons d’être civilisés, ne serions-nous, en effet, que des barbares décrépits ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "dc762439-607f-4aa7-b0ed-255a337ca21a",
