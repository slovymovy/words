                                            {
                                                "example_id": "43e08f47-2758-40de-a1e1-cf37b0ab4238",
                                                "sense_id": "ebd00afd-a449-3379-932c-3af6e6e0efa4",
                                                "text": "„Die Verbindung von Lingam und Yoni, dem Zeichen des weiblichen Geschlechts, symbolisiert die Vereinigung des Götterpaares Shiva und Kali, die Synthese von männlicher Kraft und kreativer, weiblicher Energie, die mystische ‚Einheit in der Zweiheit‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
