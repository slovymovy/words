                "forms": [
                    {
                        "form_id": "273e79c5-a2b7-4794-b181-aa4bbf88db22",
                        "entry_id": "04ce1e2c-a7d6-33e6-babf-8078d340d3bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "niqabs"
                    },
                    {
                        "form_id": "a841e531-dd25-47a6-98c6-e33d53d7783b",
                        "entry_id": "04ce1e2c-a7d6-33e6-babf-8078d340d3bc",
                        "tags": [],
                        "form": "nikab"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f0aae66-58ad-3642-b538-f725c7233d25",
                        "entry_id": "04ce1e2c-a7d6-33e6-babf-8078d340d3bc",
                        "glosses": [
                            "Voile fixé sur la tête, en tant que constituant une forme de hijab, et qui couvre la tête avec une fente permettant de voir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "949ec2d3-7b48-45b0-9cfc-5681256a4f21",
                                "sense_id": "5f0aae66-58ad-3642-b538-f725c7233d25",
                                "text": "Nous n’avons certes pas monté d’association, ni manifesté notre réticence à cette loi en défilant dans les rues, mais plutôt fait le choix de détourner la représentation classique que l’on a du niqab."
                            },
                            {
                                "example_id": "2891678e-63c8-4464-a445-b160059b809b",
                                "sense_id": "5f0aae66-58ad-3642-b538-f725c7233d25",
                                "text": "Il faisait valoir que «le respect ne doit pas altérer le fait que le hijab, le niqab et la burka sont aussi des instruments d’oppression pour des millions de filles et de femmes dans le monde qui n’ont pas la possibilité de faire un choix»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e999b7b6-92be-45c9-8467-84ad99608e79",
                        "source_entry_id": "04ce1e2c-a7d6-33e6-babf-8078d340d3bc",
                        "source_sense_id": "5f0aae66-58ad-3642-b538-f725c7233d25",
                        "target_lang_word": "Niqab",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niqab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e06f324-3021-36dd-b116-5ca2ab306cbd",
                                        "entry_id": "a440fefe-6bbd-3677-b413-4d15b4138a4c",
                                        "glosses": [
                                            "Gesichtsschleier, bei dem die Augen frei bleiben"
                                        ],
                                        "tags": [
                                            "Islam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8832b469-6f0b-4b9b-b960-f103d70ef1c7",
                                                "sense_id": "1e06f324-3021-36dd-b116-5ca2ab306cbd",
                                                "text": "Der Niqab ist auf der arabischen Halbinsel entstanden und dort auch heute noch am stärksten verbreitet."
                                            },
                                            {
                                                "example_id": "d639ff06-6734-4f8a-a979-d2853f1e888a",
                                                "sense_id": "1e06f324-3021-36dd-b116-5ca2ab306cbd",
                                                "text": "„Im Nachtdienst hielt ich einen PKW an, in dem vier komplett vermummte Frauen in ihren schwarzen Niqabs saßen.“"
                                            },
                                            {
                                                "example_id": "dbd0c905-a7a2-4c7f-82c4-f6f2115c1219",
                                                "sense_id": "1e06f324-3021-36dd-b116-5ca2ab306cbd",
                                                "text": "„In vielen Ländern sehen Frauen die Welt nur durch ein engmaschiges Netz - sie tragen einen Niqab, den Gesichtsschleier der Muslima.“"
                                            },
                                            {
                                                "example_id": "f5f70995-ecac-4a0b-93c2-e39245310097",
                                                "sense_id": "1e06f324-3021-36dd-b116-5ca2ab306cbd",
                                                "text": "„Weil sie für ein Verbot der Vollverschleierung demonstrieren wollte, trat die Thüringer AfD-Abgeordnete Wiebke Muhsal mit einem Niqab im Landtag auf.“"
                                            },
                                            {
                                                "example_id": "445b4e51-9317-469b-b134-0dc18fced97a",
                                                "sense_id": "1e06f324-3021-36dd-b116-5ca2ab306cbd",
                                                "text": "„Die Debatte über den Schleier, die ein Minister der Regierung Blair vor drei Monaten lostrat, zielte auf die unbestreitbare Tatsache, dass Niqab und Burka ein ‚Zeichen der Trennung‘ darstellten, die Gräben in der Gesellschaft vertieften und Integration verhinderten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f119165-555b-4aaa-b3b5-741488fd8773",
                        "source_entry_id": "04ce1e2c-a7d6-33e6-babf-8078d340d3bc",
                        "source_sense_id": "5f0aae66-58ad-3642-b538-f725c7233d25",
