                "forms": [],
                "senses": [
                    {
                        "sense_id": "77cca9d6-6237-3af7-b9cb-73551b976c9c",
                        "entry_id": "8a280424-5d94-3fbf-bad8-7f3336f57241",
                        "glosses": [
                            "Changement de vitesse sur une bicyclette (par dérailleur ou tout autre système plus ancien), par opposition à la vitesse unique des bicyclettes qui ne disposent que d’un seul pignon."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "70ad94d4-e29a-4204-a4ce-859b28011ea9",
                                "sense_id": "77cca9d6-6237-3af7-b9cb-73551b976c9c",
                                "text": "Polymultiplication, roue libre, freins puissants, alimentation végétarienne, y a-t-il là, oui ou non, de quoi permettre à un cycliste quelconque de doubler, sans fatigue anormale, ses étapes habituelles, de passer deux fois les Alpes entre le lever et le coucher du soleil, d’aller de Lyon à la mer le premier jour, et d’en revenir le lendemain. That is the question."
                            },
                            {
                                "example_id": "ad00d10e-a5be-4e94-ab45-f2115a17aa62",
                                "sense_id": "77cca9d6-6237-3af7-b9cb-73551b976c9c",
                                "text": "Les machines sont équipées avec les systèmes de polymultiplication les plus variés, opposant les moyeux â engrenages, avec une quinzaine de systèmes de fabrication française : déraillement de chaîne, rétrodirectes, pédaliers à engrenages, etc."
                            }
                        ]
                    }
