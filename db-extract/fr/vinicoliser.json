                "senses": [
                    {
                        "sense_id": "79dd3ea0-1d13-345e-93ad-5e9c61b39a5b",
                        "entry_id": "0633c747-ba4d-3ba1-a1a0-ab1fe48c2d47",
                        "glosses": [
                            "Donner un caractère vinicole à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44021182-6dfb-493b-a0a7-c2f5e24fe3cf",
                                "sense_id": "79dd3ea0-1d13-345e-93ad-5e9c61b39a5b",
                                "text": "Vinicolisée sur sa pente inférieure, la chaîne du lac fait la liaison avec la voûte de Macolin."
                            },
                            {
                                "example_id": "1d733c95-68c8-434c-ae20-eb9efb2d70a3",
                                "sense_id": "79dd3ea0-1d13-345e-93ad-5e9c61b39a5b",
                                "text": "Je ne m'inscrit pas dans la démarche de vouloir \"vinicoliser\" mon mobilier."
                            },
                            {
                                "example_id": "66bede3c-4f04-4e9f-929d-c28e1d2f19e1",
                                "sense_id": "79dd3ea0-1d13-345e-93ad-5e9c61b39a5b",
                                "text": "Il est grand temps d’évoquer ce second set qui tourne à l’avantage d’une équipe d’Herrlisheim revancharde et teigneuse en défense, 6 joueuses alors omniprésentes sur toutes les balles, balayant leur terrain et la bande du filet avec de grandes brassées qui neutralisent les Savernoises et laissent penser que le match risque de se prolonger au grand dam des 19 inscrits au \"Saverner Stuewel\" pour l’après match munsterisé, cabrisé, vinicolisé et finalement jovial et ventripotent, ponctué de révélations sur la préparation physique de certaines joueuses qui entretiennent leur forme en faisant des footings en forêt."
                            }
                        ]
                    }
