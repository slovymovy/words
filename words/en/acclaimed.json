{
    "word_family": [
        "acclaim",
        "acclamation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "da575f95-f765-3537-9c5b-c8955ef55437",
                    "sense_definition": "Greatly praised, highly respected, or enthusiastically approved by the public or critics.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "reputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many critically <w>acclaimed</w> novels are not commercially successful.",
                            "target_lang_translations": {
                                "ru": "Многие <w>признанные</w> критиками романы не имеют коммерческого успеха.",
                                "nl": "Veel door critici <w>geprezen</w> romans zijn commercieel niet succesvol."
                            }
                        },
                        {
                            "text": "She is an <w>acclaimed</w> writer whose books become bestsellers before they are even published.",
                            "target_lang_translations": {
                                "ru": "Она — <w>признанная</w> писательница, чьи книги становятся бестселлерами еще до публикации.",
                                "nl": "Zij is een <w>gevierd</w> schrijfster wiens boeken bestsellers worden nog voordat ze zijn gepubliceerd."
                            }
                        },
                        {
                            "text": "The restaurant is internationally <w>acclaimed</w> for its innovative approach to traditional cuisine.",
                            "target_lang_translations": {
                                "ru": "Этот ресторан всемирно <w>признан</w> благодаря своему новаторскому подходу к традиционной кухне.",
                                "nl": "Het restaurant is internationaal <w>gerenommeerd</w> vanwege zijn innovatieve benadering van de traditionele keuken."
                            }
                        }
                    ],
                    "synonyms": [
                        "celebrated",
                        "renowned",
                        "praised",
                        "distinguished"
                    ],
                    "antonyms": [
                        "criticized",
                        "unknown",
                        "obscure"
                    ],
                    "common_phrases": [
                        "critically acclaimed",
                        "highly acclaimed",
                        "internationally acclaimed",
                        "widely acclaimed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получивший высокую оценку, пользующийся большим уважением или восторженно принятый публикой или критиками.",
                        "nl": "Geprezen door critici of het publiek; genietend van veel respect en waardering."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признанный",
                                "target_lang_sense_clarification": "пользующийся уважением и авторитетом"
                            },
                            {
                                "target_lang_word": "прославленный",
                                "target_lang_sense_clarification": "широко известный и почитаемый"
                            },
                            {
                                "target_lang_word": "высоко оцененный",
                                "target_lang_sense_clarification": "получивший положительные отзывы"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "geprezen",
                                "target_lang_sense_clarification": "algemene term voor iemand of iets dat veel lof ontvangt"
                            },
                            {
                                "target_lang_word": "gerenommeerd",
                                "target_lang_sense_clarification": "bekend en gerespecteerd om uitmuntende kwaliteit"
                            },
                            {
                                "target_lang_word": "gevierd",
                                "target_lang_sense_clarification": "populair en alom gewaardeerd"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1a9b53cc-4e3c-33d1-9301-d89433cba9b0",
                    "sense_definition": "Simple past and past participle of <w>acclaim</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "praise_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics <w>acclaimed</w> the new movie as a masterpiece of modern cinema.",
                            "target_lang_translations": {
                                "ru": "Критики <w>провозгласили</w> новый фильм шедевром современного кинематографа.",
                                "nl": "De critici <w>prezen</w> de nieuwe film als een meesterwerk van de moderne cinema."
                            }
                        },
                        {
                            "text": "The crowd <w>acclaimed</w> the returning heroes with loud cheers and applause.",
                            "target_lang_translations": {
                                "ru": "Толпа <w>приветствовала</w> возвращающихся героев громкими криками и аплодисментами.",
                                "nl": "De menigte <w>juichte</w> de terugkerende helden toe met luid gejuich en applaus."
                            }
                        }
                    ],
                    "synonyms": [
                        "praised",
                        "applauded",
                        "hailed"
                    ],
                    "antonyms": [
