{
    "word_family": [
        "romance",
        "romantically",
        "romanticize",
        "romanticism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ae92a5ac-d045-3ea8-adb4-8ccc33ec4801",
                    "sense_definition": "Relating to love or a close, affectionate relationship.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "love_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went for a <w>romantic</w> walk along the beach at sunset.",
                            "target_lang_translations": {
                                "ru": "Они отправились на <w>романтическую</w> прогулку по пляжу на закате.",
                                "zh": "他们在日落时分沿着海滩进行了一次<w>浪漫的</w>散步。"
                            }
                        },
                        {
                            "text": "He wrote a <w>romantic</w> letter to express his feelings.",
                            "target_lang_translations": {
                                "ru": "Он написал <w>романтическое</w> письмо, чтобы выразить свои чувства.",
                                "zh": "他写了一封<w>浪漫的</w>信来表达他的感情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loving",
                        "affectionate"
                    ],
                    "antonyms": [
                        "unromantic",
                        "platonic"
                    ],
                    "common_phrases": [
                        "romantic relationship",
                        "romantic dinner",
                        "romantic comedy",
                        "romantic love"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к любви или близким, нежным отношениям.",
                        "zh": "与爱情或亲密、深情的恋爱关系有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "романтический",
                                "target_lang_sense_clarification": "связанный с любовными отношениями"
                            },
                            {
                                "target_lang_word": "романтичный",
                                "target_lang_sense_clarification": "проникнутый романтикой, нежный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浪漫的",
                                "target_lang_sense_clarification": "形容与爱情相关的行为或氛围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23952586-96de-3c21-bdfe-9ff58c528c95",
                    "sense_definition": "Creating a feeling of excitement, mystery, and love; appealing to the imagination.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "atmosphere_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Venice is often considered one of the most <w>romantic</w> cities in the world.",
                            "target_lang_translations": {
                                "ru": "Венецию часто считают одним из самых <w>романтичных</w> городов в мире.",
                                "zh": "威尼斯常被认为是世界上最<w>浪漫的</w>城市之一。"
                            }
                        },
                        {
                            "text": "The old castle ruins created a <w>romantic</w> atmosphere in the moonlight.",
                            "target_lang_translations": {
                                "ru": "Руины старого замка создавали <w>романтическую</w> атмосферу в лунном свете.",
                                "zh": "月光下，古老的城堡废墟营造出一种<w>浪漫的</w>氛围。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "romantic atmosphere",
                        "romantic setting",
                        "romantic getaway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создающий атмосферу таинственности и любви; пробуждающий воображение.",
                        "zh": "营造出一种令人兴奋、神秘和充满爱意的感觉；富有想象力或诗意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "романтичный",
                                "target_lang_sense_clarification": "содержащий элементы романтики, живописный"
                            },
                            {
                                "target_lang_word": "романтический",
                                "target_lang_sense_clarification": "настраивающий на любовный лад"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浪漫的",
                                "target_lang_sense_clarification": "形容环境或氛围富有诗意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12fb997e-a3e4-3a2f-b3e0-738d99b2250c",
                    "sense_definition": "Characterized by an idealized or unrealistic view of reality; fanciful or sentimental.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "idealism_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a <w>romantic</w> notion of life in the countryside, ignoring the hard work involved.",
                            "target_lang_translations": {
                                "ru": "У неё <w>романтическое</w> представление о жизни в деревне, игнорирующее тяжёлый труд.",
                                "zh": "她对乡村生活有着<w>不切实际的</w>幻想，忽略了其中涉及的艰辛劳动。"
                            }
                        },
                        {
                            "text": "His <w>romantic</w> ideas about war were quickly shattered by the reality of combat.",
                            "target_lang_translations": {
                                "ru": "Его <w>романтические</w> представления о войне были быстро разрушены реальностью боя.",
                                "zh": "他对战争的<w>空想</w>很快就被战斗的现实击碎了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unromantic"
                    ],
                    "common_phrases": [
                        "romantic notion",
                        "romantic idea",
                        "romantic view"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся идеализированным или нереалистичным взглядом на действительность; мечтательный.",
                        "zh": "以理想化或不切实际的眼光看待现实；幻想的或多愁善感的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "романтический",
                                "target_lang_sense_clarification": "идеализированный, оторванный от реальности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不切实际的",
                                "target_lang_sense_clarification": "形容想法脱离现实"
                            },
                            {
                                "target_lang_word": "空想的",
                                "target_lang_sense_clarification": "形容带有幻想色彩的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de4ac066-4bd1-33ea-bb33-43fd98e4460e",
                    "sense_definition": "Relating to the Romanticism movement in arts and literature, which emphasized emotion and nature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Keats and Shelley are famous <w>Romantic</w> poets.",
                            "target_lang_translations": {
                                "ru": "Китс и Шелли — известные <w>романтические</w> поэты.",
                                "zh": "济慈和雪莱是著名的<w>浪漫主义</w>诗人。"
                            }
                        },
                        {
                            "text": "The <w>Romantic</w> era produced some of the world's greatest music.",
                            "target_lang_translations": {
                                "ru": "<w>Романтическая</w> эпоха подарила миру величайшую музыку.",
                                "zh": "<w>浪漫主义</w>时期创作出了一些世界上最伟大的音乐作品。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Romantic movement",
                        "Romantic poet",
                        "Romantic era"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к романтизму — направлению в искусстве и литературе.",
                        "zh": "与艺术和文学中的浪漫主义运动有关，强调情感和自然。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "романтический",
                                "target_lang_sense_clarification": "относящийся к эпохе романтизма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浪漫主义的",
                                "target_lang_sense_clarification": "指代浪漫主义文学或艺术流派"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6db04981-b1d1-3082-928a-952126db8a94",
                    "sense_definition": "Experiencing romantic attraction; interested in romantic relationships.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "orientation_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She identifies as <w>romantic</w> asexual, meaning she desires a relationship but not sex.",
                            "target_lang_translations": {
                                "ru": "Она определяет себя как <w>романтический</w> асексуал, что означает, что она хочет отношений, но не секса.",
                                "zh": "她认为自己是<w>有浪漫倾向的</w>无性恋者，这意味着她渴望恋爱关系但不需要性行为。"
                            }
                        },
                        {
                            "text": "Understanding your <w>romantic</w> orientation can help you navigate relationships better.",
                            "target_lang_translations": {
                                "ru": "Понимание своей <w>романтической</w> ориентации может помочь вам лучше ориентироваться в отношениях.",
                                "zh": "了解自己的<w>浪漫倾向</w>可以帮助你更好地处理人际关系。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alloromantic"
                    ],
                    "antonyms": [
                        "aromantic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий романтическое влечение; заинтересованный в романтических отношениях.",
                        "zh": "体验到浪漫吸引力；对浪漫关系感兴趣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "романтический",
                                "target_lang_sense_clarification": "связанный с типом влечения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有浪漫倾向的",
                                "target_lang_sense_clarification": "指代个人的情感取向"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d9143ff-0027-3b81-8130-1d826f506aec",
                    "sense_definition": "A person who is sentimental, idealistic, or prone to romance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "idealism_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a hopeless <w>romantic</w> who still believes in fairy tales.",
                            "target_lang_translations": {
                                "ru": "Он безнадежный <w>романтик</w>, который всё ещё верит в сказки.",
                                "zh": "他是一个无可救药的<w>浪漫主义者</w>，至今仍相信童话故事。"
                            }
                        },
                        {
                            "text": "As a <w>romantic</w>, she loves watching movies about finding true love.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>романтиком</w>, она обожает смотреть фильмы о поиске настоящей любви.",
                                "zh": "作为一个<w>浪漫主义者</w>，她喜欢看关于寻找真爱的电影。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hopeless romantic",
                        "true romantic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, склонный к сентиментальности, идеализации или мечтательности.",
                        "zh": "多愁善感、理想主义或容易产生浪漫情怀的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "романтик",
                                "target_lang_sense_clarification": "мечтательный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浪漫主义者",
                                "target_lang_sense_clarification": "指代性格浪漫的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fb5bf3b-b1bc-3eb2-b090-a2f4f8700898",
                    "sense_definition": "An artist or writer belonging to the Romantic movement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Romantics</w> rejected the rationalism of the Enlightenment.",
                            "target_lang_translations": {
                                "ru": "<w>Романтики</w> отвергали рационализм Просвещения.",
                                "zh": "<w>浪漫主义者</w>们拒绝了启蒙运动的理性主义。"
                            }
                        },
                        {
                            "text": "Wordsworth was one of the leading <w>Romantics</w> of his time.",
                            "target_lang_translations": {
                                "ru": "Вордсворт был одним из ведущих <w>романтиков</w> своего времени.",
                                "zh": "华兹华斯是他那个时代主要的<w>浪漫主义者</w>之一。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Художник или писатель, принадлежащий к эпохе романтизма.",
                        "zh": "属于浪漫主义运动的艺术家或作家。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "романтик",
                                "target_lang_sense_clarification": "последователь романтизма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浪漫主义者",
                                "target_lang_sense_clarification": "指代浪漫主义流派的创作者"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}