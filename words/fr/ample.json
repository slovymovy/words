                {
                    "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                    "sense_definition": "Qui est abondant, étendu ou développé de manière détaillée et approfondie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous attendons de plus <w>amples</w> informations avant de prendre une décision définitive.",
                            "target_lang_translations": {
                                "en": "We are waiting for <w>further</w> information before making a final decision.",
                                "ru": "Мы ждём <w>дополнительной</w> информации, прежде чем принять окончательное решение.",
                                "nl": "Wij wachten op <w>nadere</w> informatie voordat we een definitief besluit nemen.",
                                "de": "Wir warten auf <w>weitere</w> Informationen, bevor wir eine endgültige Entscheidung treffen.",
                                "pl": "Czekamy na <w>dodatkowe</w> informacje przed podjęciem ostatecznej decyzji.",
                                "it": "Attendiamo <w>ulteriori</w> informazioni prima di prendere una decisione definitiva.",
                                "cs": "Před konečným rozhodnutím čekáme na <w>podrobnější</w> informace.",
                                "tr": "Kesin bir karar vermeden önce daha <w>ayrıntılı</w> bilgi bekliyoruz.",
                                "es": "Esperamos <w>más amplia</w> información antes de tomar una decisión definitiva.",
                                "zh": "在做出最终决定之前，我们还在等待更多<w>详细</w>的信息。"
                            }
                        },
                        {
                            "text": "Le directeur a fait un très <w>ample</w> exposé sur la situation financière de notre entreprise.",
                            "target_lang_translations": {
                                "en": "The director gave a very <w>thorough</w> presentation on the financial situation of our company.",
                                "ru": "Директор сделал очень <w>подробный</w> доклад о финансовом положении нашей компании.",
                                "nl": "De directeur gaf een zeer <w>uitvoerige</w> uiteenzetting over de financiële situatie van ons bedrijf.",
                                "de": "Der Direktor hielt einen sehr <w>ausführlichen</w> Vortrag über die finanzielle Lage unseres Unternehmens.",
                                "pl": "Dyrektor wygłosił bardzo <w>szczegółowe</w> omówienie sytuacji finansowej naszej firmy.",
                                "it": "Il direttore ha fatto un'esposizione molto <w>dettagliata</w> sulla situazione finanziaria della nostra azienda.",
                                "cs": "Ředitel přednesl velmi <w>podrobný</w> výklad o finanční situaci naší firmy.",
                                "tr": "Müdür, şirketimizin mali durumu hakkında çok <w>ayrıntılı</w> bir sunum yaptı.",
                                "es": "El director hizo una exposición muy <w>detallada</w> sobre la situación financiera de nuestra empresa.",
                                "zh": "经理对我们公司的财务状况作了非常<w>详尽</w>的介绍。"
                            }
                        }
