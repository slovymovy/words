                        "entry_id": "e2a35f33-c56c-36bf-a298-3ffa2ee6c361",
                        "glosses": [
                            "een smalle, ondiepe uitgraving in de grond voor de afvoer van te veel water die echter meestal droog staat"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "582b4c7d-ddf4-4052-944c-b8d169f2c06b",
                                "sense_id": "44e66622-5c12-37a4-bda7-76329e9e75e3",
                                "text": "Meerdere automobilisten schatten de situatie verkeerd in en eindigden in een greppel langs de weg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3e33f47-9af4-402a-b0dd-9c912587cac0",
                        "source_entry_id": "e2a35f33-c56c-36bf-a298-3ffa2ee6c361",
                        "source_sense_id": "44e66622-5c12-37a4-bda7-76329e9e75e3",
                        "source_sense_description": "een smalle, ondiepe uitgraving in de grond voor de afvoer van teveel water",
                        "target_lang_word": "Graben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Graben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60758f2d-f879-3000-ad40-be932e928e54",
                                        "entry_id": "900809bd-658e-35cd-be78-e5a6fdaa4687",
                                        "glosses": [
                                            "länglicher Erdaushub"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac53033-5e54-460e-819a-77d45443eaaf",
                                                "sense_id": "60758f2d-f879-3000-ad40-be932e928e54",
                                                "text": "Die Gräben werden ausgehoben, um unterirdische Leitungen zu verlegen."
                                            },
                                            {
                                                "example_id": "db7cf2d6-1238-42b5-a46f-3db134eb7f1f",
                                                "sense_id": "60758f2d-f879-3000-ad40-be932e928e54",
                                                "text": "„Der Graben war hier flach.“"
                                            },
                                            {
                                                "example_id": "b672dc91-cfa2-4141-8b6a-6b9ff4a7b69d",
                                                "sense_id": "60758f2d-f879-3000-ad40-be932e928e54",
                                                "text": "„Der Graben selbst wurde 1580 zugeschüttet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c1e7248-85e5-3270-a485-3fa559acc8b6",
                                        "entry_id": "900809bd-658e-35cd-be78-e5a6fdaa4687",
                                        "glosses": [
                                            "Wassergraben, Hindernis beim Pferderennen"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec7cb465-e544-4630-bd2f-6436e0683163",
                                                "sense_id": "8c1e7248-85e5-3270-a485-3fa559acc8b6",
                                                "text": "Die Stute nahm den Graben ohne sichtliche Probleme."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "709fb0a7-d4a8-3e06-8d7e-645771b3cff3",
                                        "entry_id": "900809bd-658e-35cd-be78-e5a6fdaa4687",
                                        "glosses": [
                                            "Schützengraben, befestigte Stellung an der Front"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d698da1-f595-4415-9a87-2befcfdbafc7",
                                                "sense_id": "709fb0a7-d4a8-3e06-8d7e-645771b3cff3",
                                                "text": "Vor der Stadt kann man noch die alten Gräben besichtigen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5816d4bc-84de-37dc-8e06-e6b0308e7fe5",
                                        "entry_id": "900809bd-658e-35cd-be78-e5a6fdaa4687",
                                        "glosses": [
                                            "das, was zwei Positionen voneinander trennt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1e3be5d-34e7-422d-9382-dfabb53a6ca9",
                                                "sense_id": "5816d4bc-84de-37dc-8e06-e6b0308e7fe5",
                                                "text": "Gibt es ihn noch, den oft besprochenen Graben zwischen Ost und West?"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Graben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d7c65b6-185b-3cdd-91e0-da109836fcd4",
                                        "entry_id": "8c70f058-7f30-3593-89cc-e7660c8236eb",
                                        "glosses": [
                                            "Handlung, etwas zu graben, das Ausheben einer Vertiefung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d1ea1b7-94a1-4a0b-82f7-8755b9a1edbd",
                                                "sense_id": "3d7c65b6-185b-3cdd-91e0-da109836fcd4",
                                                "text": "„Ich wanderte zwischen den Hütten umher und hörte das Graben, nervöses Geflüster und Gebete.“"
                                            },
                                            {
                                                "example_id": "54d71400-86d1-48cc-bfe6-c61c9db37908",
                                                "sense_id": "3d7c65b6-185b-3cdd-91e0-da109836fcd4",
                                                "text": "„Alles ist besser, als dem Bagger beim Graben zuzusehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7e78e89-eff3-433f-8940-ed92c97cdd09",
                        "source_entry_id": "e2a35f33-c56c-36bf-a298-3ffa2ee6c361",
                        "source_sense_id": "44e66622-5c12-37a4-bda7-76329e9e75e3",
                        "source_sense_description": "een smalle, ondiepe uitgraving in de grond voor de afvoer van teveel water",
                        "target_lang_word": "Straßengraben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Straßengraben",
