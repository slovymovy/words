                        "examples": [
                            {
                                "example_id": "e733e899-763b-4e61-b324-7325d9293d0c",
                                "sense_id": "184a7d09-a804-3217-92a8-3776cc6c4fa8",
                                "text": "Op de bureautafel ligt het assortiment vuurwerk dat in de Italiaanse fabriek van Di Blasio wordt gemaakt. Van zijn cobra’s bestaan veertien types, de een zwaarder dan de ander. De in zilverpapier verpakte Cobra 8 heeft honderd gram springstof (gemeten in NEC, Net Explosive Content). Dat is meer dan genoeg om containers, brugleuningen en zelfs auto's op te blazen, zoals te zien is in filmpjes die gebruikers op internet zetten."
                            },
                            {
                                "example_id": "919c8fea-17b1-40ce-a860-4e1719d71a5e",
                                "sense_id": "184a7d09-a804-3217-92a8-3776cc6c4fa8",
                                "text": "Truss voerde campagne op het verlagen van belastingen en daarmee het creëren van economische groei. Nu die plannen grotendeels in de prullenbak liggen, is de grote vraag in Westminster waar ze eigenlijk nog voor staat. \"Of is ze zich misschien onder haar bureautafel aan het verstoppen\", sneerde een parlementariër gisteren in het Lagerhuis waar Truss niet aanwezig was."
                            }
                        ]
                    }
