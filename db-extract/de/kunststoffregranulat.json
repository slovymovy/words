                "senses": [
                    {
                        "sense_id": "b75c1052-4ea5-3b68-85c2-d93b0bc3d735",
                        "entry_id": "e807021a-50b6-3687-8aeb-19ddf800d785",
                        "glosses": [
                            "zu Kunststoffgranulat recycelte Kunststoffabfälle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b312adf-c06c-49ca-829c-4ec2709b9f01",
                                "sense_id": "b75c1052-4ea5-3b68-85c2-d93b0bc3d735",
                                "text": "„Mit mehr als 16.000 Tonnen Jahreskapazität ist Rissland Kunststoffe einer der führenden Hersteller von Kunststoffregranulaten und Kunststoff-Compounds in Deutschland.“"
                            },
                            {
                                "example_id": "954a2b9d-8632-4e88-828a-7061249701ae",
                                "sense_id": "b75c1052-4ea5-3b68-85c2-d93b0bc3d735",
                                "text": "„Die so erfassten Hartkunststoffe werden bei der […] im Werk Rheinfelden stofflich verwertet und zu Kunststoffregranulat verarbeitet.“"
                            },
                            {
                                "example_id": "32e448f7-a4ad-4b6c-a83c-43808739e031",
                                "sense_id": "b75c1052-4ea5-3b68-85c2-d93b0bc3d735",
                                "text": "„Die schwierige Suche nach einem kostengünstigen, schnell und einfach zu montierenden Biofiltersystem mit hoher Lebensdauer zwang uns zur eigenen Entwicklung eines Biofiltermodulsystems aus Kunststoffregranulat als Alternative zu konventionellen Werkstoffen, um u.a. der Zielsetzung des Dualen Systems Deutschland (DSD) gerecht zu werden.“"
                            },
                            {
                                "example_id": "ed1cd143-3261-41bc-8fd1-3ab0d3f04c51",
                                "sense_id": "b75c1052-4ea5-3b68-85c2-d93b0bc3d735",
                                "text": "„Dieses Mischsilo wird für gut rieselfähige Schüttgüter, wie zum Beispiel PVC-Dryblend, Kunststoffmahlgut, Kunststoffgranulat oder Kunststoffregranulat eingesetzt.“"
                            },
                            {
                                "example_id": "64bbe515-9f60-4225-b5a7-cba3f86f041b",
                                "sense_id": "b75c1052-4ea5-3b68-85c2-d93b0bc3d735",
                                "text": "„Gitter-Magnet im Gehäuse dient zur Abscheidung von ferromagnetischen Partikeln aus Kunststoffregranulat, Granulat und Mahlgut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
