                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f688da88-b943-4ca8-8aa1-a8ed148569db",
                                "sense_id": "5d4e06b4-ffce-342f-b467-62c7c5b7d238",
                                "text": "„Tatsächlich brachten internationale Zeitungen im Sommer 1916 zunehmend Berichte über die Versorgungsschwierigkeiten in Deutschland, wozu nicht unbedingt deutsche Presseberichte vonnöten waren.“"
                            },
                            {
                                "example_id": "d1dd6316-1c7f-4ccf-af2f-df714da8b6ca",
                                "sense_id": "5d4e06b4-ffce-342f-b467-62c7c5b7d238",
                                "text": "„Obama konnte laut Presseberichten den Iran mit dem Virus Stuxnet nur deswegen angreifen, weil die Software, die die iranischen Atomanlagen betrieb, auch im Westen bekannt war: Sie stammte von Siemens.“"
                            }
                        ],
