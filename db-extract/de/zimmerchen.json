                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chambrette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99c58121-758d-3037-9a01-03cd5881d3b8",
                                        "entry_id": "43259822-8979-3b2a-a1d9-8534523ce862",
                                        "glosses": [
                                            "Petite chambre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d023eb2a-a0b2-4d92-9868-f647fb486dc8",
                                                "sense_id": "99c58121-758d-3037-9a01-03cd5881d3b8",
                                                "text": "Laissant toutes les chambres à la disposition des étrangers pour qu'ils s’y emménageassent comme ils l’entendaient, il se retira, seul et sombre, dans une chambrette dans laquelle il se verrouilla tout de suite."
                                            },
                                            {
                                                "example_id": "f0d495ef-dc91-44ed-be3f-967294de64bd",
                                                "sense_id": "99c58121-758d-3037-9a01-03cd5881d3b8",
                                                "text": "Ma chambrette de bois était mignonne, étroite, basse, garnie de quelques meubles fabriqués à Copenhague et d’un grand poêle cylindrique, éclairée par deux toutes petites fenêtres […]."
                                            },
                                            {
                                                "example_id": "b32f4c2c-06bc-430f-9e03-3ed80eb26b24",
                                                "sense_id": "99c58121-758d-3037-9a01-03cd5881d3b8",
                                                "text": "C’était, t’en souviens-tu, Lison,\nDans ta chambrette :\nTu enlevais ton petit jupon,\nMoi ma jaquette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47324812-4ad8-3063-af7b-18a603161105",
                                        "entry_id": "43259822-8979-3b2a-a1d9-8534523ce862",
                                        "glosses": [
                                            "Calque québécois de roomette, compartiment de voiture-lits à bord de trains du continent américain."
                                        ],
