                        "translation_id": "c3ced01b-df29-4fbf-ba84-3a0ccd098bd1",
                        "source_entry_id": "9d02afde-f98c-374b-bf6e-3d101f0509b0",
                        "source_sense_id": "9d795e24-3bdd-3fa9-9f1d-4692ce8f9fe6",
                        "target_lang_word": "Kritikerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kritikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e8748f1-bf26-3865-924e-8100755afb61",
                                        "entry_id": "9f658d1c-7a6c-3ad3-8acf-1dc12572cf10",
                                        "glosses": [
                                            "weibliche Person, die kritisiert, etwas tadelt oder bemängelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd68b416-c2a1-4d0c-a6b7-2134851a7676",
                                                "sense_id": "9e8748f1-bf26-3865-924e-8100755afb61",
                                                "text": "Immer wenn ich eine Idee hab, sagt mir Lena, die Kritikerin, das sie nichts bringe."
                                            },
                                            {
                                                "example_id": "cf2e3528-ae8e-42e9-9478-692d9d883f9a",
                                                "sense_id": "9e8748f1-bf26-3865-924e-8100755afb61",
                                                "text": "„Sexton wurde gefeuert, aber sie blieb eine Fürsprecherin der Elektromobilität – und eine Kritikerin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eee80694-4adf-30d4-a0d6-d0794f945207",
                                        "entry_id": "9f658d1c-7a6c-3ad3-8acf-1dc12572cf10",
                                        "glosses": [
                                            "weibliche Person, die beruflich (Kunst-)Werke kritisiert oder streng beurteilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "684ed4a4-ec92-4716-b4db-7c3f6a5848cd",
                                                "sense_id": "eee80694-4adf-30d4-a0d6-d0794f945207",
                                                "text": "Die Kritik ist dabei einer M[e]inung: \"Begnadete Unterhalter\" schrieb die \"Welt am Sonntag\", und auch die Kritikerin dieser Zeitung schwärmte von der \"charmanten Leichtigkeit des musikalischen Seins\" dieser besonderen Spielart von Salonmusik."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
