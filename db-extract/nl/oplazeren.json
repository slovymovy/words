                                                "example_id": "18c806fc-d96b-442b-9f66-ef8b0000dbfa",
                                                "sense_id": "9edf2616-826e-346c-b1fa-89761e9241ed",
                                                "text": "And to tear apart the ties that bind\nPerhaps fuck off might be too kind\nPerhaps fuck off might be too kind"
                                            },
                                            {
                                                "example_id": "6fb1a766-d98d-4c8d-92bf-6663b9f051c0",
                                                "sense_id": "9edf2616-826e-346c-b1fa-89761e9241ed",
                                                "text": "Fuck you\n And your friends\n That I'll never see again\n Everybody but your dog\n You can all fuck off"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61f3c3b0-eedf-364a-b448-77c5cdad445d",
                                        "entry_id": "fa34aca8-361d-3da0-aef4-60d49dabed15",
                                        "glosses": [
                                            "To leave unexpectedly."
                                        ],
                                        "tags": [
                                            "idiomatic",
