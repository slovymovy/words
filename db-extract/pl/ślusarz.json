                                        "glosses": [
                                            "osoba opravující a instalující zámky a jiné kovové předměty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54817cf5-4d39-4a69-9aa9-819a13050ed4",
                                                "sense_id": "f672f5fe-7a67-3d4b-9e12-e991f73acb02",
                                                "text": "Byl zase nedělní den, pozdní odpůldne, když náš zámečník se ubíral z Dlouhé třídy do šedivé, zastrčené ulice ve čtvrti Petrská."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zámečník",
