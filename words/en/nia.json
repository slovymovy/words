        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "c4b309fc-12aa-3361-adf8-6768e3644218",
                    "sense_definition": "Used at the end of a sentence to emphasize that something is trivial, small, or undemanding.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It costs five dollars <w>nia</w>.",
                            "target_lang_translations": {
                                "zh": "只要五块钱<w>而已</w>。"
                            }
                        },
                        {
                            "text": "I just wanted to say hello <w>nia</w>.",
                            "target_lang_translations": {
                                "zh": "我只是想打个招呼<w>罢了</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "only"
                    ],
                    "common_phrases": [
                        "just that nia"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in Singaporean and Malaysian English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "句末语气词，用于强调某事微不足道、简单或仅此而已。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "而已",
                                "target_lang_sense_clarification": "表示仅此而已，强调数量少或程度轻"
                            },
                            {
                                "target_lang_word": "罢了",
                                "target_lang_sense_clarification": "表示事情简单或不重要"
                            }
                        ]
                    }
                }
            ]
        }
