                                            {
                                                "example_id": "31cba1aa-bf27-42c0-a61d-22e99cb6cbe2",
                                                "sense_id": "871d5399-6079-3207-84b6-7c3fa459f9a5",
                                                "text": "Opeens zat er een worm in haar maag. Het beest kronkelde als een bezetene. Misselijkheid kwam sterk opzetten."
