                    {
                        "translation_id": "b5013cb5-c41f-447b-b732-94a51d9c4af7",
                        "source_entry_id": "b9f8d7a2-85bb-3fe0-a2a1-ce096b918357",
                        "source_sense_id": "3cd3883c-384e-32f7-b81f-cc826e6c7886",
