                    {
                        "translation_id": "2ca50a6d-9119-4bed-95ad-fa8d9e2e0f11",
                        "source_entry_id": "2a97178d-c658-348f-98af-8fd620a6c917",
                        "source_sense_id": "2947649c-54ea-3d64-8d3f-bf5d042d10bc",
                        "source_sense_description": "long-lasting",
                        "target_lang_word": "ausdauernd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausdauernd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b8cea58-ec27-33b4-b302-cdf5b81c3fb7",
                                        "entry_id": "1d805a18-30b1-3ee6-991e-18b3c9fb6fc9",
                                        "glosses": [
                                            "eine Belastung lange durchhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07b96154-4113-4609-a415-ee17949838e0",
                                                "sense_id": "7b8cea58-ec27-33b4-b302-cdf5b81c3fb7",
                                                "text": "Anstrengende Gartenarbeit macht mir nichts aus, ich bin ausdauerndes Arbeiten gewohnt."
                                            },
                                            {
                                                "example_id": "97bb411d-d461-4121-b1b4-17935bab43f9",
                                                "sense_id": "7b8cea58-ec27-33b4-b302-cdf5b81c3fb7",
                                                "text": "[…] sie lächelt mich an und schüttelt mir die Hand, lange und ausdauernd.."
                                            },
                                            {
                                                "example_id": "3bfab101-f2a6-4110-942c-44e458332942",
                                                "sense_id": "7b8cea58-ec27-33b4-b302-cdf5b81c3fb7",
                                                "text": "[…] in einem der alten Pavillons knutscht ausdauernd ein Pärchen."
                                            },
                                            {
                                                "example_id": "32ca377b-edf2-4938-a229-9ee2e90c5d42",
                                                "sense_id": "7b8cea58-ec27-33b4-b302-cdf5b81c3fb7",
                                                "text": "[…] Es [wird] erst einmal laut und schrill, denn die Koboldmakis beginnen ausdauernd zu singen. Je ein Weibchen und ein Männchen, beide nicht größer als zwölf Zentimeter, rufen im Duett ihre Familie zusammen, um gemeinsam ihre Schlafbäume aufzusuchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c14ccc2-7851-3167-9d4f-0c3d7ba525ed",
                                        "entry_id": "1d805a18-30b1-3ee6-991e-18b3c9fb6fc9",
                                        "glosses": [
                                            "in Bezug auf Pflanzen, insbesondere Beikräuter/Unkräuter: immer wieder austreibend, immer wieder nachwachsend"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "824311f2-2f08-4108-8a27-2b162cd6d80d",
                                                "sense_id": "9c14ccc2-7851-3167-9d4f-0c3d7ba525ed",
                                                "text": "Giersch ist ein wirklich ausdauerndes Unkraut, dem man auch mit der Giftspritze kaum beikommt."
                                            },
                                            {
                                                "example_id": "9cd3a5c8-5c2e-403a-a2ae-74d417c4038f",
                                                "sense_id": "9c14ccc2-7851-3167-9d4f-0c3d7ba525ed",
                                                "text": "„Beschreibung: Ausdauernde Kräuter aus der Familie der Doldengewächse (Apiaceae) mit spindelförmigen, unangenehm riechendem Wurzelstock.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44ddaceb-8970-419a-b07d-07b49c61b420",
                        "source_entry_id": "2a97178d-c658-348f-98af-8fd620a6c917",
