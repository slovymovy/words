                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e71678a-addf-4af0-91ec-b5b55728f184",
                                                "sense_id": "cca282bf-960e-30d5-beaf-b2663e2fc0d6",
                                                "text": "Eine beliebte Musikgruppe wird für Unterhaltung sorgen."
                                            },
                                            {
                                                "example_id": "1fac42f7-d2bd-48ef-8ec1-2e8d7c27e649",
                                                "sense_id": "cca282bf-960e-30d5-beaf-b2663e2fc0d6",
                                                "text": "„Für Unterhaltung bei den Gastmählern sorgten vor allem die Barden (…): Dichter und Sänger, die ihre Heldengesänge meist in Begleitung einer Harfe vortrugen.“"
