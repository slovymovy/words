                    "sense_id": "0c1a7894-572b-3de6-8ad2-47aaac923f33",
                    "sense_definition": "Acte stupide, maladresse ou erreur lourde de conséquences.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fait une énorme <w>connerie</w> en démissionnant sans avoir trouvé un autre travail.",
                            "target_lang_translations": {
                                "en": "He made a huge <w>blunder</w> by quitting without having found another job.",
                                "ru": "Он сделал огромную <w>глупость</w>, уволившись, не найдя другой работы.",
                                "nl": "Hij heeft een enorme <w>stommiteit</w> begaan door ontslag te nemen zonder een andere baan gevonden te hebben.",
                                "de": "Er hat eine riesige <w>Dummheit</w> begangen, indem er gekündigt hat, ohne eine andere Stelle gefunden zu haben.",
                                "pl": "Zrobił ogromne <w>głupstwo</w>, rezygnując z pracy, zanim znalazł inną.",
                                "it": "Ha fatto un'enorme <w>cazzata</w> dimettendosi senza aver trovato un altro lavoro.",
                                "cs": "Udělal obrovskou <w>hloupost</w>, když dal výpověď, aniž si předtím našel jinou práci.",
                                "tr": "Başka bir iş bulmadan istifa ederek büyük bir <w>hata</w> yaptı.",
                                "es": "Hizo una enorme <w>metedura de pata</w> al renunciar sin haber encontrado otro trabajo.",
                                "zh": "他还没找到别的工作就辞职了，真是干了件大<w>蠢事</w>。"
                            }
                        },
                        {
                            "text": "Les enfants passent leur journée à faire des <w>conneries</w> dès qu'on a le dos tourné.",
                            "target_lang_translations": {
                                "en": "The kids spend all day doing <w>stupid things</w> as soon as our backs are turned.",
                                "ru": "Дети весь день делают <w>глупости</w>, стоит нам отвернуться.",
                                "nl": "De kinderen brengen de hele dag door met <w>dwaasheden uithalen</w> zodra we even niet kijken.",
                                "de": "Die Kinder verbringen den ganzen Tag damit, <w>Dummheiten</w> anzustellen, sobald wir ihnen den Rücken kehren.",
                                "pl": "Dzieci cały dzień robią <w>głupstwa</w>, gdy tylko się odwrócimy.",
                                "it": "I bambini passano la giornata a fare <w>stupidaggini</w> appena giriamo le spalle.",
                                "cs": "Děti celý den dělají <w>hlouposti</w>, jakmile se odvrátíme.",
                                "tr": "Biz arkamızı döner dönmez çocuklar bütün gün <w>aptallıklar</w> yapıyor.",
                                "es": "Los niños se pasan el día haciendo <w>tonterías</w> en cuanto les damos la espalda.",
                                "zh": "我们一转身，孩子们就整天闹腾，净干些<w>蠢事</w>。"
                            }
                        }
                    ],
