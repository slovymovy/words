                        "entry_id": "3b05c9cb-5ecc-3e50-bca3-3dea4722431b",
                        "glosses": [
                            "Partisan de la doctrine économique du mondialisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1264fa5a-fd6e-419e-b801-94ffd874a217",
                                "sense_id": "921b0835-a84f-34e8-822c-b2eda7771ddd",
                                "text": "Par son travail et ses brillants discours à la société des Nations, il était un mondialiste avant l’heure."
                            },
                            {
                                "example_id": "7521a0c5-3b5f-465b-bc5c-c07fb9c8ccb6",
                                "sense_id": "921b0835-a84f-34e8-822c-b2eda7771ddd",
                                "text": "Bien que les mondialistes « puristes » continuent d’être majoritaires, ces dernières années ils ont été marginalisés."
                            }
                        ]
                    }
                ],
