                "senses": [
                    {
                        "sense_id": "ed2e5f83-8a94-3dc0-bb9e-edd432e5d461",
                        "entry_id": "5f35acdc-94d8-363d-a6a1-a5d75e11c4ca",
                        "glosses": [
                            "sowjetischer Raketenwerfer aus den 1940er Jahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "507bda1e-69f0-4947-adcc-69404c5ec504",
                                "sense_id": "ed2e5f83-8a94-3dc0-bb9e-edd432e5d461",
                                "text": "Wegen des charakteristischen pfeifenden Geräusches das die Raketen beim Start verursachten, wurde die Waffe Stalinorgel genannt."
                            },
                            {
                                "example_id": "f967d441-96d8-434e-bc5f-dafd35fa7324",
                                "sense_id": "ed2e5f83-8a94-3dc0-bb9e-edd432e5d461",
                                "text": "„Unter dem Heulen der Stalinorgel, im mörderischen Granathagel, eingeklemmt zwischen zerfetzten Menschenleibern war für erhebene Gedanken kein Platz.“"
                            },
                            {
                                "example_id": "296acd65-9091-4992-8600-3f9f1920e7d6",
                                "sense_id": "ed2e5f83-8a94-3dc0-bb9e-edd432e5d461",
                                "text": "„Die Sowjets beschossen die Stadt, die kurz darauf fallen sollte, aus Stalinorgeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
