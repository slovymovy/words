                                "target_senses": [
                                    {
                                        "sense_id": "a3107cd3-e47d-3177-b2cf-9673d34efd43",
                                        "entry_id": "36cc0935-9363-3840-97ef-a80bf8692078",
                                        "glosses": [
                                            "Courant de l'anarchisme dit communiste, qui place le syndicat comme forme naturelle d'organisation des classes ouvrière et paysanne, et refuse le principe de parti unique comme vecteur politique de la transformation sociétale."
                                        ],
                                        "tags": [
                                            "Syndicalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31fbef8d-1d95-46c2-b8a2-d52d0963b0c1",
                                                "sense_id": "a3107cd3-e47d-3177-b2cf-9673d34efd43",
                                                "text": "Du syndicalisme révolutionnaire à l’anarchosyndicalisme."
                                            },
                                            {
                                                "example_id": "0e37d483-dc3a-4ab3-9e9d-87821b3d1780",
                                                "sense_id": "a3107cd3-e47d-3177-b2cf-9673d34efd43",
                                                "text": "Georges Sorel (1847-1916), théoricien de l’anarchosyndicalisme, tente de rapporter la violence née de l’affaire Dreyfus à celle de la Révolution française, pour établir un système politique fondé sur cette passerelle à haut risque."
                                            }
                                        ]
                                    }
                                ]
                            }
