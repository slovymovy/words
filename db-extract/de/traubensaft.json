                ],
                "senses": [
                    {
                        "sense_id": "ff3dc1a3-2ef2-3d12-b63e-bae073128539",
                        "entry_id": "80aaf306-668c-3c7e-97cc-54335d81bf26",
                        "glosses": [
                            "Saft, der aus gepressten Weintrauben hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29742b66-69f4-4be3-9250-41755a505d09",
                                "sense_id": "ff3dc1a3-2ef2-3d12-b63e-bae073128539",
                                "text": "„Obwohl es wahrscheinlich die Perser waren, die vor über 8000 Jahren erstmals Traubensaft zu Wein vergoren haben, steht außer Frage, dass die Franzosen ihn zu höchster Blüte gebracht haben.“"
                            },
                            {
                                "example_id": "f5737162-72ec-470d-ae58-63a94a08c727",
                                "sense_id": "ff3dc1a3-2ef2-3d12-b63e-bae073128539",
                                "text": "„Aus einer Öffnung am unteren Teil des Zubers lief der frisch gepresste Traubensaft in ein bereitgestelltes Holzfass.“"
                            },
                            {
                                "example_id": "3ac41316-fc2a-47c9-ad5e-99381dcb116a",
                                "sense_id": "ff3dc1a3-2ef2-3d12-b63e-bae073128539",
                                "text": "„Wir nehmen Traubensaft und ein Glas Scheurebe, Flammkuchen und Handkäs mit Musik.“"
                            },
                            {
                                "example_id": "1210c698-bcd4-43c0-85cc-fa3621e9eff2",
                                "sense_id": "ff3dc1a3-2ef2-3d12-b63e-bae073128539",
                                "text": "„Ich liebte Traubensaft! Traubensaft und Cracker – was gab es Schöneres für ein Kind?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
