                    },
                    {
                        "translation_id": "ae71b2d4-45a9-496e-9ed7-93529f6bfe0c",
                        "source_entry_id": "dcd94ce2-db3c-34c6-9865-53d17945ac58",
                        "source_sense_id": "6b026aef-1085-3e40-93eb-7d8ebd4f0103",
                        "source_sense_description": "het denkbeeldige punt loodrecht omhoog aan de hemelkoepel",
                        "target_lang_word": "Zenit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zenit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0de782ee-ae5e-3a2b-bc2a-d1bb8510d95a",
                                        "entry_id": "4ec0b9f9-aa2f-305e-a6a7-4a7ed2191ad9",
                                        "glosses": [
                                            "der höchste Punkt des Himmelsgewölbes senkrecht über dem Betrachter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9040670f-4d10-48f0-b316-4adacc835426",
                                                "sense_id": "0de782ee-ae5e-3a2b-bc2a-d1bb8510d95a",
                                                "text": "Im Mai steht der Große Wagen schon am frühen Abend hoch im Zenit."
                                            },
                                            {
                                                "example_id": "16f37292-0654-44f2-9520-2af0918f9123",
                                                "sense_id": "0de782ee-ae5e-3a2b-bc2a-d1bb8510d95a",
                                                "text": "„Vom Zenit bis zum Nadir erstreckte sich ein unübersehbarer Ring von Sternenstaub, jene Milchstraße, in deren Mitte unsere Sonne nur als Stern vierter Größe gilt.“"
                                            },
                                            {
                                                "example_id": "67bbd8e4-f502-4af4-a91f-a772ce122084",
                                                "sense_id": "0de782ee-ae5e-3a2b-bc2a-d1bb8510d95a",
                                                "text": "„Als er wieder zu sich kam, näherte sich die Sonne ihrem Zenit und es war Ebbe.“"
                                            },
                                            {
                                                "example_id": "8b8fb238-e0bc-4a60-848e-335aa5bf96c8",
                                                "sense_id": "0de782ee-ae5e-3a2b-bc2a-d1bb8510d95a",
                                                "text": "„Die Sonne hatte den Zenit schon überschritten, als sie Helena erreichten und dort landeten.“"
                                            },
                                            {
                                                "example_id": "ec0188cf-d0e3-45bc-be59-b0b79bc72fbf",
                                                "sense_id": "0de782ee-ae5e-3a2b-bc2a-d1bb8510d95a",
                                                "text": "„Zuerst wurd es am Zenit, wo die Nebelschichten dünner waren, hell, nach und nach hob sich auch die Horizontlinie mit helleren Streifen ab.“"
                                            },
                                            {
                                                "example_id": "a02db877-5954-441a-8fef-7cbd1bbbb66a",
                                                "sense_id": "0de782ee-ae5e-3a2b-bc2a-d1bb8510d95a",
                                                "text": "„Wenn eine Gerade vom Erdmittelpunkt durch deinen Standort und hinaus in den Weltraum gezogen würde, so würde sie zu deinem Zenit führen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "692e04f4-6b3f-33c1-aa2d-c5d39bcd1262",
                                        "entry_id": "4ec0b9f9-aa2f-305e-a6a7-4a7ed2191ad9",
                                        "glosses": [
                                            "Zeitpunkt des größten Erfolges"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05aff1a3-8de2-4e04-87d1-c6141d925a33",
                                                "sense_id": "692e04f4-6b3f-33c1-aa2d-c5d39bcd1262",
                                                "text": "Bereits im Alter von 20 Jahren hatte er den Zenit seines Ruhms erreicht."
                                            },
                                            {
                                                "example_id": "e608a384-af37-4691-9f1f-4c9405e30afc",
                                                "sense_id": "692e04f4-6b3f-33c1-aa2d-c5d39bcd1262",
                                                "text": "„Denn auch an der Börse war der Zenit bereits überschritten.“"
                                            },
                                            {
                                                "example_id": "0b272263-c1eb-468a-87f5-4e6e13008b4e",
                                                "sense_id": "692e04f4-6b3f-33c1-aa2d-c5d39bcd1262",
                                                "text": "„Liszt stand als Pianist auf dem Zenit seines Ruhms, doch war er den Ansprüchen, die er an sich als Komponist stellte, in den letzten Jahren vieles schuldig geblieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbe720b9-ebf8-4f05-9719-b03acc525680",
                        "source_entry_id": "dcd94ce2-db3c-34c6-9865-53d17945ac58",
                        "source_sense_id": "6b026aef-1085-3e40-93eb-7d8ebd4f0103",
                        "source_sense_description": "het denkbeeldige punt loodrecht omhoog aan de hemelkoepel",
                        "target_lang_word": "zenith",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zenith",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9f2d7e4-f6ed-34fc-9a2b-0483a0f982b9",
                                        "entry_id": "1602b46b-85f2-3067-8ac1-4869bfc9bd99",
                                        "glosses": [
                                            "The point in the sky vertically above a given position or observer; the point in the celestial sphere opposite the nadir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85672675-e564-4b95-acc6-7da0bc527cb2",
                                                "sense_id": "b9f2d7e4-f6ed-34fc-9a2b-0483a0f982b9",
                                                "text": "The 12 day wee had the wind high and large ſo that in two dayes ſaile we made the Sunne our Zenith or verticall point[…]"
                                            },
                                            {
                                                "example_id": "b9f19032-b931-4c74-b957-ea920fcf556b",
                                                "sense_id": "b9f2d7e4-f6ed-34fc-9a2b-0483a0f982b9",
                                                "text": "In this 10th m. appeared that prodigious Comett the tayl whereof was like the blade of a double edged sword, and reached almost from the horizon to the zenith."
                                            },
                                            {
                                                "example_id": "5b4a4001-b25d-4b47-9eb0-a9d084b5466c",
                                                "sense_id": "b9f2d7e4-f6ed-34fc-9a2b-0483a0f982b9",
                                                "text": "In the east a pillar of cloud reared from horizon to zenith, with a kind of arm outstretched like a threatening colossus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61b90208-2be9-3264-9d95-5459f1ec33fa",
                                        "entry_id": "1602b46b-85f2-3067-8ac1-4869bfc9bd99",
                                        "glosses": [
                                            "The highest point in the sky reached by a celestial body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4df70a9-a822-4738-bfc1-9d83be86e103",
                                                "sense_id": "61b90208-2be9-3264-9d95-5459f1ec33fa",
                                                "text": "[…] in the middle of the day, when the sun was in the zenith, the violence of the heat was too great to stir out […]"
                                            },
                                            {
                                                "example_id": "f709d4b2-fc10-4f93-8145-beaae4cc7e9c",
                                                "sense_id": "61b90208-2be9-3264-9d95-5459f1ec33fa",
                                                "text": "As far to the west as Monica could see, her world was a sea of fog, […]. Above it arched a cerulean sky; as the sun climbed to the zenith, […], the fog gradually took on a bluish tinge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88a30709-300c-372b-a894-b2855bdc5eb0",
                                        "entry_id": "1602b46b-85f2-3067-8ac1-4869bfc9bd99",
                                        "glosses": [
                                            "Highest point or state; peak."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a551d58-5047-435a-a3db-724674cb80c0",
                                                "sense_id": "88a30709-300c-372b-a894-b2855bdc5eb0",
                                                "text": "Winning the continental championship was the zenith of my career."
                                            },
                                            {
                                                "example_id": "820efe20-8dc4-4ab2-a553-ed938b12ea26",
                                                "sense_id": "88a30709-300c-372b-a894-b2855bdc5eb0",
                                                "text": "I find my zenith doth depend upon / A most auspicious star."
                                            },
                                            {
                                                "example_id": "1b10f200-6e02-4da0-8081-2e4934e117ef",
                                                "sense_id": "88a30709-300c-372b-a894-b2855bdc5eb0",
                                                "text": "It was during those civil troubles […] this aspiring family reached the zenith."
                                            },
                                            {
                                                "example_id": "6c2f23fe-1ebc-4f7c-8849-1d2178705341",
                                                "sense_id": "88a30709-300c-372b-a894-b2855bdc5eb0",
                                                "text": "\"There for a while I enjoyed myself in the zenith of glory and pleasure.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "451fb9b1-b58a-4a46-a497-1cbc4ec7a449",
                        "source_entry_id": "dcd94ce2-db3c-34c6-9865-53d17945ac58",
                        "source_sense_id": "6b026aef-1085-3e40-93eb-7d8ebd4f0103",
                        "source_sense_description": "het denkbeeldige punt loodrecht omhoog aan de hemelkoepel",
                        "target_lang_word": "zénith",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zénith",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca966b4a-b6ce-3878-a4e9-9067ae1c2211",
                                        "entry_id": "fb137883-b00b-3e43-97bb-1d9fc72480ee",
                                        "glosses": [
                                            "Point du ciel qui est situé directement au-dessus de notre tête et auquel aboutirait une ligne verticale élevée du point où nous sommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c192995-c3f8-4274-abb1-bab4d738b080",
                                                "sense_id": "ca966b4a-b6ce-3878-a4e9-9067ae1c2211",
                                                "text": "Le temps était alors très beau et la chaleur assez forte. Aucun nuage, ni à l'horizon, ni au zénith."
                                            },
                                            {
                                                "example_id": "d9ea7f9a-5a78-4e68-860b-5d9af0334944",
                                                "sense_id": "ca966b4a-b6ce-3878-a4e9-9067ae1c2211",
                                                "text": "La petite troupe, sous la direction du trappeur, se dirigea vers le rancho, dans lequel il leur avait offert un abri contre les rayons ardents du soleil arrivé à son zénith."
                                            },
                                            {
                                                "example_id": "f7953878-ce21-4e62-a6d5-935d2151ae24",
                                                "sense_id": "ca966b4a-b6ce-3878-a4e9-9067ae1c2211",
                                                "text": "Une assourdissante détonation partit du zénith, et l’aéronat décrivit une terrible embardée."
                                            },
                                            {
                                                "example_id": "e6d2b276-3b4a-4cd5-a550-94c0283c9c57",
                                                "sense_id": "ca966b4a-b6ce-3878-a4e9-9067ae1c2211",
                                                "text": "Quelques blancheurs commencent à nuancer l’horizon vers l’est. Les nuages du zénith en reçoivent une première coloration."
                                            },
                                            {
                                                "example_id": "4a8c51c9-f9fc-4ce1-b87e-6486815bdcbf",
                                                "sense_id": "ca966b4a-b6ce-3878-a4e9-9067ae1c2211",
                                                "text": "Lorsque le ciel sera enténébré, que le peuple ne verra plus goutte dans la vie, alors montera de l'horizon au zénith l’Étoile du Matin irradiant sa splendeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea397b81-b0b4-301f-8ea6-06dbedb5dbd4",
                                        "entry_id": "fb137883-b00b-3e43-97bb-1d9fc72480ee",
                                        "glosses": [
                                            "Point culminant."
                                        ],
                                        "tags": [
                                            "common",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "078f644b-762f-428a-8f16-d25a77b47bc4",
                                                "sense_id": "ea397b81-b0b4-301f-8ea6-06dbedb5dbd4",
                                                "text": "Dans les existences les plus illustres comme dans les plus obscures, n’y a-t-il pas pour l’animal comme pour les secrétaires généraux un zénith et un nadir, une période où le pelage est magnifique, où la fortune rayonne de tout son éclat."
                                            },
                                            {
                                                "example_id": "246af259-5271-4fe7-8269-d1e283d4c29a",
                                                "sense_id": "ea397b81-b0b4-301f-8ea6-06dbedb5dbd4",
                                                "text": "Savait-on au préalable qu'il faudrait utiliser la force pour avoir ne fût-ce qu'une quote-part dans le commerce épicier ? Mais alors, pourquoi ces tâtonnements, cette escalade de violence, rapide mais graduelle, qui s'étale sur toute une décennie pour n'atteindre son zénith que sous le gouvernement d’Albuquerque ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
