                        "sense_id": "70460ad5-546d-3dfc-b4ce-270eff0fa474",
                        "entry_id": "194e2720-7e29-33ad-aef3-4a6ffbbd8751",
                        "glosses": [
                            "brothers, brethren"
                        ],
                        "tags": [
