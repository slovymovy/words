                    }
                ],
                "senses": [
                    {
                        "sense_id": "0fefc05f-fab1-3b55-a2b0-e220d0eead54",
                        "entry_id": "af770ed8-d418-3026-88a9-223fc437f4e3",
                        "glosses": [
                            "Intervalle de six notes consécutives, y compris les deux extrêmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "783132e5-1a54-4be5-ad8a-f4e47f1244bc",
                                "sense_id": "0fefc05f-fab1-3b55-a2b0-e220d0eead54",
                                "text": "Intervalle de sixte."
                            },
                            {
                                "example_id": "b956a1a7-b10b-4b15-9105-f3525384d305",
                                "sense_id": "0fefc05f-fab1-3b55-a2b0-e220d0eead54",
                                "text": "Sixte majeure, celle dont la valeur est de quatre tons et demi."
                            },
                            {
                                "example_id": "4f334249-f8b0-41e4-a6fe-9981a2bc0d9d",
                                "sense_id": "0fefc05f-fab1-3b55-a2b0-e220d0eead54",
                                "text": "Sixte mineure, celle dont la valeur est de trois tons et deux demi-tons."
                            },
                            {
                                "example_id": "f51e305e-73e2-46f2-9a78-91ee012f0fb6",
                                "sense_id": "0fefc05f-fab1-3b55-a2b0-e220d0eead54",
                                "text": "Sixte augmentée, celle dont la valeur est de quatre tons et deux demi-tons."
                            },
                            {
                                "example_id": "2a4ad364-f25c-4f41-9bbb-937f22390ddc",
                                "sense_id": "0fefc05f-fab1-3b55-a2b0-e220d0eead54",
                                "text": "Sixte diminuée, celle dont la valeur est de deux tons et trois demi-tons."
                            }
                        ]
                    },
                    {
                        "sense_id": "86e812b8-8a37-33d4-95d4-8ec22766e9c9",
                        "entry_id": "af770ed8-d418-3026-88a9-223fc437f4e3",
                        "glosses": [
                            "Position de garde au fleuret et à l'épée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3545a248-c8eb-4131-b445-a97792bd87f3",
                                "sense_id": "86e812b8-8a37-33d4-95d4-8ec22766e9c9",
                                "text": "Georges Claretie, dans un maillot de couleur sombre, mince, agile, plein d’entrain, prenait des contres de sixte, puis chargeait avec une élégante rapidité."
                            }
                        ]
                    }
                ],
