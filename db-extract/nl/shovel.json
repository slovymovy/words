                        "glosses": [
                            "graafmachine op banden met een beweegbare laadschop die zowel kan graven als grond verplaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "125955b0-b1fe-4ae4-84e7-3d29f480872e",
                                "sense_id": "cf343528-2176-35f8-93a8-be290c3e3b43",
                                "text": "In de loodsen lopen nu honderden vreemden rond te snuffelen of er iets van hun gading bij is. Veilinghuis Troostwijk, de grootste in zijn soort in Europa, houdt een open kijkdag. Er worden 493 kavels aangeboden. Van een vijf jaar oude shovel die minimaal 25.000 euro moet opbrengen tot cementmolens van 10 euro."
                            }
                        ]
