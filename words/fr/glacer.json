                    "frequency": "Middle",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le grand froid d'hiver <w>glace</w> l'eau des bassins en une seule nuit."
                        },
                        {
                            "text": "Il faut laisser <w>glacer</w> la préparation liquide avant de pouvoir la déguster."
                        }
                    ],
                    "synonyms": [
