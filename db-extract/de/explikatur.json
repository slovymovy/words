                        "sense_id": "f7d1b9c6-5554-369b-87cb-15bb8c84623e",
                        "entry_id": "4466e0f5-76e6-3728-9093-0be4e74d87f4",
                        "glosses": [
                            "die Anreicherung beziehungsweise Vollendung eines vorgegebenen Sprachfragmentes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3cfb3ee-4fea-4814-8e22-6aa8a59d9fca",
                                "sense_id": "f7d1b9c6-5554-369b-87cb-15bb8c84623e",
                                "text": "\"Die Kritik an der Grice'schen Konzeption hat zu weiteren Termini geführt. So führt Carston (Language and Cogniton, 1988) noch die \"Explikatur\" ein, was von Bach (Semantic slack, in: Tsohatzidis: Foundations of speech act theory, 1994) kritisiert wird, der dafür \"Implizitur\" vorschlägt.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7752cce1-c635-4a53-958d-78a7d998d7e3",
                        "source_entry_id": "4466e0f5-76e6-3728-9093-0be4e74d87f4",
                        "source_sense_id": "f7d1b9c6-5554-369b-87cb-15bb8c84623e",
                        "source_sense_description": "Linguistik: die Anreicherung beziehungsweise Vollendung eines vorgegebenen Sprachfragmentes",
                        "target_lang_word": "explicature",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explicature",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32e7f8ba-3415-3090-86e3-7470caab035c",
                                        "entry_id": "386d0ba3-a347-3032-b0ef-2cec42ce3f64",
                                        "glosses": [
                                            "Something explicitly expressed in an utterance, as opposed to what is implicit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6f746ed-e128-4122-8998-e86f27419ab5",
                                                "sense_id": "32e7f8ba-3415-3090-86e3-7470caab035c",
                                                "text": "In relevance theory terms, he must construct a hypothesis about the explicit content of Ally's utterance;that is, he mustrely upon both the words she uses in this utterance and an inferencing process to construct an explicature."
                                            },
                                            {
                                                "example_id": "b1d36f30-d265-450f-b030-89af0e2e0575",
                                                "sense_id": "32e7f8ba-3415-3090-86e3-7470caab035c",
                                                "text": "If the speaker was your flat-mate and you had a habit of borrowing her property without permission, she might be asking you if you'd 'borrowed' the book she owned (explicature) and the utterance might be taken as a demand for its return."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
