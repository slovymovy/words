                ],
                "senses": [
                    {
                        "sense_id": "adad5d1a-d43f-35ef-9216-32694eca26c2",
                        "entry_id": "cb4c4f0b-9b4c-3c35-b2b6-c77fed211dff",
                        "glosses": [
                            "een zak gemaakt van jute, gemaakt voor het vervoer van grove goederen zoals bijvoorbeeld kolen, de zak van Sinterklaas is meestal ook een jutezak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde588f1-a1d4-4ded-a216-6915d651b411",
                                "sense_id": "adad5d1a-d43f-35ef-9216-32694eca26c2",
                                "text": "Maar het blijft rustig vandaag. De spanning die de afgelopen weken steeds hoger opliep, wordt wel zichtbaar als er een ongenodigde gast het schoolplein opkomt. Het is een vrouw uit de buurt met een zwart geschminkt gezicht en een bij elkaar geraapt Pietenpak aan. Ze heeft ook een jutezak en een roe bij zich. Ze wil haar steun betuigen, vertelt ze."
                            },
                            {
                                "example_id": "070c0ce6-de5c-429a-b290-0926625b209c",
                                "sense_id": "adad5d1a-d43f-35ef-9216-32694eca26c2",
                                "text": "De Mexicaanse justitie leken extra op hun hoede voor Palma, nu Guzman al enige tijd vastzit en het kartel een nieuwe leider nodig lijkt te hebben. Guzman ontsnapte in juli vorig jaar via een tunnel uit Altiplano. In januari van dit jaar werd hij weer opgepakt. Het was zijn tweede ontsnapping: in 2001 verborg hij zich in een jutezak en reed hij zo de vrijheid tegemoet, om in 2014 weer te worden gearresteerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0d4440c-5ca9-354b-99da-966fe95d4675",
                        "entry_id": "cb4c4f0b-9b4c-3c35-b2b6-c77fed211dff",
                        "glosses": [
                            "weinig elegante kleding"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d056896b-d76a-4004-90d7-0aa626f604c2",
                                "sense_id": "f0d4440c-5ca9-354b-99da-966fe95d4675",
                                "text": "Ontroerend was hoe hij op het EK met een ballenjongen op selfie ging. Zijn troostend praatje met Gareth Bale na de wedstrijd was al even hartelijk en warm. De voetballer uitgevouwen als mens. Cristiano Ronaldo is minder hautain dan zijn Gesamtkunstwerk toelaat. Hij verandert weleens van kapsel, loopt niet in een jutezak door de stad, heeft ook nog een paar limousines en meisjes op overschot. Maar de ultieme dressman is ook een antwoord op een pokdalige jeugd. Het arme joch uit Madeira had wat in te halen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62cda872-49ef-4548-a37d-c1c25a336d2d",
                        "source_entry_id": "cb4c4f0b-9b4c-3c35-b2b6-c77fed211dff",
                        "source_sense_id": "adad5d1a-d43f-35ef-9216-32694eca26c2",
                        "source_sense_description": "een zak gemaakt van jute, gemaakt voor het vervoer van grove goederen...",
                        "target_lang_word": "gunny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gunny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bef148b5-4857-3d5c-852a-25d3c7bc3bd6",
                                        "entry_id": "2704b867-3776-3823-941c-c25bacf89337",
                                        "glosses": [
                                            "A coarse heavy fabric made of jute or hemp."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70e3ebbb-d309-432b-aab0-eac5e2bc002d",
                                                "sense_id": "bef148b5-4857-3d5c-852a-25d3c7bc3bd6",
                                                "text": "Traffic is brisk, and goods consists of rice, gunny (hessian), maize and native implements."
                                            },
                                            {
                                                "example_id": "eef53f34-250a-4a3e-b876-d3f4a7aea752",
                                                "sense_id": "bef148b5-4857-3d5c-852a-25d3c7bc3bd6",
                                                "text": "Provisions were ferried by camel in stout sacks of gunny with blocks of ice packed round them; a herculean task."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c6e9b6-35cd-32e0-802d-70ca07c595bd",
                                        "entry_id": "2704b867-3776-3823-941c-c25bacf89337",
                                        "glosses": [
                                            "Clipping of gunny sack"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gunny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9eff161-3b66-3237-b787-6470659c8288",
                                        "entry_id": "6923a567-a11d-34e2-97da-3b03182c4f08",
                                        "glosses": [
                                            "A gunnery sergeant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7511dce-d46b-4c29-8a90-2ac62d322235",
                                                "sense_id": "c9eff161-3b66-3237-b787-6470659c8288",
                                                "text": "The gunny's voice reverberated between the barracks as we marched, “Ya left right . . . left right . . . left right left. […] Then the gunny unexpectedly stopped our forward movement. “Company, halt!”"
                                            },
                                            {
                                                "example_id": "394c74bb-7a8e-4d1f-b976-e9569051cdae",
                                                "sense_id": "c9eff161-3b66-3237-b787-6470659c8288",
                                                "text": "“As a rule of thumb, Marine corporals, when a gunny asks a question, answer it,”"
                                            },
                                            {
                                                "example_id": "928980e7-65e8-4f93-85a8-7b38bde133cf",
                                                "sense_id": "c9eff161-3b66-3237-b787-6470659c8288",
                                                "text": "Alongside even' officer chain of command is an enlisted one, and the company gunnery sergeant (\"gunny\" for short) is the enlisted counterpart […] Without a gunny, the day-to-day operations of the infantry would likely grind to a halt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
