                    {
                        "sense_id": "fe10947e-3c81-3765-b574-5a4208581293",
                        "entry_id": "89fb27fb-bf9b-3523-b69f-6c44543e82a1",
                        "glosses": [
                            "persoon die in dezelfde gevangenis(cel) gevangen wordt gehouden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86d38d7b-a12d-4309-a2a5-98c9fd9f7aed",
                                "sense_id": "fe10947e-3c81-3765-b574-5a4208581293",
                                "text": "Een medegevangene wist hun later te vertellen dat deze Duitser een baron zou zijn met landgoederen in Nederland, Duitsland en Nederlands-Indië."
                            },
                            {
                                "example_id": "677f2c40-f35e-4a76-813d-bc188cceaad7",
                                "sense_id": "fe10947e-3c81-3765-b574-5a4208581293",
                                "text": "Zijn medegevangene had een zesjarig dochtertje genaamd Christina."
                            },
                            {
                                "example_id": "9978d818-006e-44e3-a9a6-b3c53d56cc5f",
                                "sense_id": "fe10947e-3c81-3765-b574-5a4208581293",
                                "text": "Vervolgens werd nog een 35-jarige Irakees opgepakt, die tegen een medegevangene zou hebben gezegd dat hij het gezin bij een huurmoord zou hebben gedood. Ook dat bleek uiteindelijk niet te bewijzen. Ook speculaties dat de vermoorde man, werkzaam in de satelliet-industrie, misschien bij spionage betrokken was, leidden nergens toe."
                            }
                        ]
                    }
