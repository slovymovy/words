                    {
                        "translation_id": "6dc871ca-0e1c-4d1e-a2db-2966cae0cd27",
                        "source_entry_id": "2b9796c3-c4b3-3bfa-8ac4-361bd2c7260b",
                        "source_sense_id": "2b52236c-f78b-3968-822d-cd10220b03ea",
                        "target_lang_word": "Priem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Priem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4ddeeed-c265-3e89-ae7d-ba39152f24d1",
                                        "entry_id": "f54c60c7-e286-3e07-bc29-b97f87622411",
                                        "glosses": [
                                            "ein Stück Kautabak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8a4098-6fe0-422e-bc1c-6b574a5f98f3",
                                                "sense_id": "f4ddeeed-c265-3e89-ae7d-ba39152f24d1",
                                                "text": "„Er raucht, was er finden kann und kaut obendrein auf seinem Priem herum.“"
                                            },
                                            {
                                                "example_id": "8b5bf134-72da-4c33-9184-93f5055d59d2",
                                                "sense_id": "f4ddeeed-c265-3e89-ae7d-ba39152f24d1",
                                                "text": "„Er ist eben aus dem Bett gekrochen, hat eine Kanne schwarzen Kaffee getrunken und versucht jetzt, mit viel Priem den Geschmack von der gestrigen Sauferei aus dem Mund zu kriegen.“"
                                            },
                                            {
                                                "example_id": "32aec6b9-a8e1-4632-92c0-d97446e89717",
                                                "sense_id": "f4ddeeed-c265-3e89-ae7d-ba39152f24d1",
                                                "text": "„Der alte Seebär wiegte den Kopf hin und her und schob seinen Priem in die andere Backe.“"
                                            },
                                            {
                                                "example_id": "21201a07-3c11-49ce-8e2f-91c83583fddc",
                                                "sense_id": "f4ddeeed-c265-3e89-ae7d-ba39152f24d1",
                                                "text": "„Von Zeit zu Zeit spucken sie den Priem aus, gleichgültig, wohin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44225e83-9dfb-4d8f-8bf5-1f19dec12f2d",
                        "source_entry_id": "2b9796c3-c4b3-3bfa-8ac4-361bd2c7260b",
                        "source_sense_id": "2b52236c-f78b-3968-822d-cd10220b03ea",
                        "target_lang_word": "Kautabak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kautabak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c541ad5d-76e0-391f-bcec-ae7a0fa72c3a",
                                        "entry_id": "aa69b450-a32a-38a2-bb76-624c3ac5be02",
                                        "glosses": [
                                            "„saucierter Tabak zum Kauen“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f3c9386-07dc-4017-a20d-7b3d5b72bf48",
                                                "sense_id": "c541ad5d-76e0-391f-bcec-ae7a0fa72c3a",
                                                "text": "„Für jeden zehn Zigarren, zwanzig Zigaretten und zwei Stück Kautabak, das ist sehr anständig.“"
                                            },
                                            {
                                                "example_id": "9d9f6879-b060-4401-9ad4-b4e9770064ce",
                                                "sense_id": "c541ad5d-76e0-391f-bcec-ae7a0fa72c3a",
                                                "text": "„Dort waren sie sicher, sie hielten als Kautabak auch viel länger vor, und so habe ich denn, trotz meines anfänglichen Ekels, auf diese Weise endgültig das Priemen gelernt.“"
                                            },
                                            {
                                                "example_id": "d414c181-3a4d-4d9b-b2c9-e4f1164d0433",
                                                "sense_id": "c541ad5d-76e0-391f-bcec-ae7a0fa72c3a",
                                                "text": "„Die Freundlichkeit überraschte sie, und noch bevor Habba sich versah, hielt er das Stück Kautabak in der Hand.“"
                                            },
                                            {
                                                "example_id": "af1ce326-03e7-4228-974b-e764520d3ead",
                                                "sense_id": "c541ad5d-76e0-391f-bcec-ae7a0fa72c3a",
                                                "text": "„Der Alte spuckte in den Schnee und schob sich ein Stück Kautabak in den Mund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
