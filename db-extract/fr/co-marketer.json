                        "glosses": [
                            "Marketer en parallèle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71ec9590-fb7e-46cf-a8b9-d14dea87a585",
                                "sense_id": "142c04f0-877c-3a94-9319-7b60e4042b9e",
                                "text": "Les leaders dans le domaine des équipements pour cybersportifs et des solutions optiques associent leurs forces pour co-brander et co-marketer une nouvelle génération d’optique pour les joueurs."
                            },
                            {
                                "example_id": "af416083-10cd-4b5f-aba1-47f48b6fe25b",
                                "sense_id": "142c04f0-877c-3a94-9319-7b60e4042b9e",
                                "text": "Cette solution sera distribuée et par un grossiste avec lequel Keyvelop va co-marketer cette application complète."
                            },
                            {
                                "example_id": "4ebee9ae-e80b-4ed8-9697-29b513060ec3",
                                "sense_id": "142c04f0-877c-3a94-9319-7b60e4042b9e",
                                "text": "Ces deux typologies d'acteurs se regroupent généralement pour co-marketer une offre la plus complète possible."
                            }
                        ]
