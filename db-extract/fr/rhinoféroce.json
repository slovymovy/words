                "senses": [
                    {
                        "sense_id": "4deb1b2b-c4b8-34fc-88cb-6bdd05a951f7",
                        "entry_id": "27e30037-a1ab-3d97-95ce-c0ea7ab5da8a",
                        "glosses": [
                            "Rhinocéros."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "d03b6828-951c-4cb4-ae33-ed13e5317cc7",
                                "sense_id": "4deb1b2b-c4b8-34fc-88cb-6bdd05a951f7",
                                "text": "Je tournai au tigre, au rhinoféroce [me transformai en tigre, en rhinoféroce] ! la garde accourut et nous transvasa au violon, où l'on nous sépara."
                            },
                            {
                                "example_id": "851338fe-0976-4d4d-9af1-a1de4a81e14f",
                                "sense_id": "4deb1b2b-c4b8-34fc-88cb-6bdd05a951f7",
                                "text": "Tous ces jolis gas (garçons) avaient la lèvre supérieure fendue en bec de lièvre, d'où sortait une dent de rhinoféroce d'un bon pied de long."
                            },
                            {
                                "example_id": "dfcfd11a-c114-4816-9a8d-0679d9223465",
                                "sense_id": "4deb1b2b-c4b8-34fc-88cb-6bdd05a951f7",
                                "text": "Et puis après, les sorciers continuèrent leur chanson infernale, en regardant mon défunt père et en le couchant en joue avec leurs grandes dents de rhinoféroce."
                            },
                            {
                                "example_id": "18f48e53-55ad-49ae-b58a-23c40fb05851",
                                "sense_id": "4deb1b2b-c4b8-34fc-88cb-6bdd05a951f7",
                                "text": "Perrier parlant du rhinocéros, le rhinoféroce, comme disent les garçons du Jardin des Plantes, l'animal le plus brutal…"
                            },
                            {
                                "example_id": "2f20e344-69f4-4b07-ae10-1884447cfff2",
                                "sense_id": "4deb1b2b-c4b8-34fc-88cb-6bdd05a951f7",
                                "text": "André il a mangé le rhinoféroce."
                            },
                            {
                                "example_id": "057c9978-af48-425d-bb62-19d0bb688d3a",
                                "sense_id": "4deb1b2b-c4b8-34fc-88cb-6bdd05a951f7",
                                "text": "Rhinoféroce gros mammifère cornu, extrêmement dangereux et cruel."
                            },
                            {
                                "example_id": "f68a4650-5259-44ad-9e69-2932c485d88f",
                                "sense_id": "4deb1b2b-c4b8-34fc-88cb-6bdd05a951f7",
                                "text": "Je suis Olivier, biologiste, moniteur et chauffeur, fait un jeune homme en descendant du véhicule. Passez-moi vos bagages, je vais nourrir le rhinoféroce !"
                            },
                            {
                                "example_id": "bbb8024d-2420-4aaa-8784-c3bfb4f4deb4",
                                "sense_id": "4deb1b2b-c4b8-34fc-88cb-6bdd05a951f7",
                                "text": "La première caractéristique du rhinoféroce est d'être féroce."
                            }
                        ]
                    }
                ],
