                "senses": [
                    {
                        "sense_id": "da64e444-19f7-36a4-9aac-94e3a40f80b8",
                        "entry_id": "ac94fc55-f3f1-3c59-86aa-9729dcb6d156",
                        "glosses": [
                            "прост. тот, кто кусается"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe1614f4-2315-4878-9f23-ddc6660ed9b5",
                                "sense_id": "da64e444-19f7-36a4-9aac-94e3a40f80b8",
                                "text": "Заводилися в августе мухи кусаки; брюшко их ― короче; разъехались крылышки: перелетают беззвучно; и ― хитрые: нет, не садятся на кожу, а… сядет, бывало, кусака такая на платье, переползая с него очень медленно: ай!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a7354c2-586e-4a8c-ab6c-2463fa8a8a9d",
                        "source_entry_id": "ac94fc55-f3f1-3c59-86aa-9729dcb6d156",
                        "source_sense_id": "da64e444-19f7-36a4-9aac-94e3a40f80b8",
                        "target_lang_word": "Beißer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beißer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1b67c4e-2ce7-368c-9ba2-fee09ed317e1",
                                        "entry_id": "de6ebc79-5899-36d7-a134-67b8d45df581",
                                        "glosses": [
                                            "Tier, das schnell zubeißt, zum Beispiel ein Hund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5984bcaa-ff74-4b22-9bb7-b0c8f319a156",
                                                "sense_id": "a1b67c4e-2ce7-368c-9ba2-fee09ed317e1",
                                                "text": "Der Schäferhund von nebenan wird schnell zum Beißer."
                                            },
                                            {
                                                "example_id": "87195e58-53b3-4b94-9f6b-6d2274c17eb9",
                                                "sense_id": "a1b67c4e-2ce7-368c-9ba2-fee09ed317e1",
                                                "text": "„Bösartige Tiere (z. B. Schläger und Beißer) sind abgesondert unterzubringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "813444c2-c43b-3fcc-a881-a52579981596",
                                        "entry_id": "de6ebc79-5899-36d7-a134-67b8d45df581",
                                        "glosses": [
                                            "Zahn"
                                        ],
                                        "tags": [
                                            "humorous",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a21947b6-6d72-444b-9d2c-ac0124fb9a8c",
                                                "sense_id": "813444c2-c43b-3fcc-a881-a52579981596",
                                                "text": "Der Zahnarzt gab seinem Patienten einen Rat zum Pflegen der Beißer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2c662948-a087-3547-bab3-9f204bef2cda",
                                        "entry_id": "de6ebc79-5899-36d7-a134-67b8d45df581",
                                        "glosses": [
                                            "Eisenstange, mit der große oder schwere Gegenstände gehoben und gelockert werden"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a191b7f3-5420-4a78-a091-11baa8258d32",
                                                "sense_id": "2c662948-a087-3547-bab3-9f204bef2cda",
                                                "text": "„Es war aber üblich, daß man die zumeist nur verklemmten Dachklappen mit einer Beißzange (Beißer) unter erheblichem Kraftaufwand zuzwängte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
