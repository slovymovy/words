                "senses": [
                    {
                        "sense_id": "35802aa7-a15d-3836-84ba-2cf72b25733f",
                        "entry_id": "f3f9cece-9928-383e-a330-2175ae87591c",
                        "glosses": [
                            "Interprétation officielle d’un texte donnée par l’Administration sur la demande d’un administré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c3458b-6597-4005-843c-5b3226bad21a",
                                "sense_id": "35802aa7-a15d-3836-84ba-2cf72b25733f",
                                "text": "Les industriels dont nous avons parlé étaient, bien entendu, des libérés admis aux droits civiques de la Nouvelle-Galles du Sud, après expiration de leur peine, ou même avant, par rescrit du gouverneur."
                            },
                            {
                                "example_id": "bdd14faa-abe9-4d0f-951c-a53929ebf03e",
                                "sense_id": "35802aa7-a15d-3836-84ba-2cf72b25733f",
                                "text": "Un contribuable peut solliciter de l’administration fiscale un rescrit, c’est à dire une réponse formelle de l’administration à une question sur l’interprétation d’un texte fiscal (question de législation) ou sur l’interprétation de la situation de fait au regard du droit fiscal (rescrit général)."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc89c2df-b88f-34f2-960d-ccb59845e6e3",
                        "entry_id": "f3f9cece-9928-383e-a330-2175ae87591c",
                        "glosses": [
                            "Réponse de l’empereur aux questions adressées par les gouverneurs, les magistrats."
                        ],
                        "tags": [
                            "Droit romain"
                        ],
                        "examples": [
                            {
                                "example_id": "01c6479b-e640-467e-bb70-86ef4c38a966",
                                "sense_id": "dc89c2df-b88f-34f2-960d-ccb59845e6e3",
                                "text": "Après de longs et tristes débats, Idace obtint de l’empereur Gratien un rescrit qui bannit de toute terre les hérétiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "13a9f88d-30b3-3446-b44a-cc0bbadd7029",
                        "entry_id": "f3f9cece-9928-383e-a330-2175ae87591c",
                        "glosses": [
                            "Réponse du pape sur toute question de théologie, pour servir de décision ou de loi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "887047be-5ccc-4bbd-a50f-74793071540a",
                                "sense_id": "13a9f88d-30b3-3446-b44a-cc0bbadd7029",
                                "text": "[…] lettres, sur parchemin, munies du sceau de cire de l'évêque de Paris, Ranulphe d’Hombloniere, datées de 1281, le jeudi précédant la fête des Palmes (19 mars 1282, nouveau style), et portant vidimus du rescrit précité adressé à Philippe [III], roi des Francs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "232e9fe9-867d-463d-a0ab-16d2af594035",
                        "source_entry_id": "f3f9cece-9928-383e-a330-2175ae87591c",
