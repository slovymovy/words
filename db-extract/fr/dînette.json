        "fr-extract.jsonl": [
            {
                "entry_id": "f9686b5d-981c-3d3c-ba31-54ac5e4ef27d",
                "word": "dînette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bab81344-c069-472e-a602-a0921beb1198",
                        "entry_id": "f9686b5d-981c-3d3c-ba31-54ac5e4ef27d",
                        "tags": [
                            "plural"
                        ],
                        "form": "dînettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ed935ff7-d3fd-3336-bd45-4d9e09ea72c7",
                        "entry_id": "f9686b5d-981c-3d3c-ba31-54ac5e4ef27d",
                        "glosses": [
                            "Variante, dans l'orthographe traditionnelle, de dinette."
                        ],
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "examples": [
                            {
                                "example_id": "9c6a209d-5289-4c93-8099-e5baeb17be2d",
                                "sense_id": "ed935ff7-d3fd-3336-bd45-4d9e09ea72c7",
                                "text": "Ah ! gueux ! brigand ! c’est comme ça que tu fais la dînette avec des blondes ... sans en rien dire aux camarades !"
                            },
                            {
                                "example_id": "b79d0962-25cd-4f76-8c4b-45b4c4a5eb10",
                                "sense_id": "ed935ff7-d3fd-3336-bd45-4d9e09ea72c7",
                                "text": "— Oui, oui, oui, il faut faire la dînette.\nAlors furent apportées des petites tables rondes, et des serviettes grandes comme des feuilles de lilas, et des verres profonds comme des dés à coudre, et des assiettes creuses comme des coquilles de noix. Le repas fut de chocolat et de sucre en miettes ; et le vin ne pouvait pas couler dans les verres, car les petites fioles blanches, longues comme le petit doigt, avaient le cou trop mince."
                            },
                            {
                                "example_id": "158c9106-fed4-4e3b-8e84-74465c9ac52e",
                                "sense_id": "ed935ff7-d3fd-3336-bd45-4d9e09ea72c7",
                                "text": "Sur les bancs de pierre des Tuileries, les dînettes s’organisent. Quatre sous de frites ! deux sous de gâteaux de la veille !"
                            },
                            {
                                "example_id": "a8c33db3-e61c-4dfc-865b-643f8a3d8fe8",
                                "sense_id": "ed935ff7-d3fd-3336-bd45-4d9e09ea72c7",
                                "text": "Les don Quichotte qui pourfendent la « théorie du genre » s’effraient en effet que des filles jouent avec des voiturettes ou que des garçons changent les couches d'un poupon ou jouent à la dînette."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e0bf573-c309-4f20-9dc8-f6a4659e3eb2",
                        "source_entry_id": "f9686b5d-981c-3d3c-ba31-54ac5e4ef27d",
                        "source_sense_id": "ed935ff7-d3fd-3336-bd45-4d9e09ea72c7",
                        "target_lang_word": "Imbiss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Imbiss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "992414fc-9303-3763-baea-12e96d921ab7",
                                        "entry_id": "eecbfc57-9765-3108-b7c4-9b470dba855e",
                                        "glosses": [
                                            "eine kurze Mahlzeit außerhalb der Hauptmahlzeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d250b401-dbb9-49fc-91dc-f7583e5a4155",
                                                "sense_id": "992414fc-9303-3763-baea-12e96d921ab7",
                                                "text": "Auf der Veranda nahmen sie einen kleinen Imbiss ein."
                                            },
                                            {
                                                "example_id": "b3bf4bb2-2534-4e02-9b9b-280a6384e1f4",
                                                "sense_id": "992414fc-9303-3763-baea-12e96d921ab7",
                                                "text": "„Tischchen mit Imbissen wurden aufgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                        "entry_id": "eecbfc57-9765-3108-b7c4-9b470dba855e",
                                        "glosses": [
                                            "Stand, Kantine, Kiosk oder Stube, wo man eine kleine Zwischenmahlzeit^([1]) kaufen und einnehmen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "647b0840-2df2-449c-9043-b2e9907143f7",
                                                "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                                "text": "Lass uns mal eben zum Imbiss gehen!"
                                            },
                                            {
                                                "example_id": "dea258a5-452c-4135-b849-763b970cf03d",
                                                "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                                "text": "„Die Tür von Henrys Imbiss ging auf, und zwei Männer kamen herein.“"
                                            },
                                            {
                                                "example_id": "34e98f89-7ce7-460c-96d6-39e268d1bc50",
                                                "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                                "text": "„Gegenüber ihrer Stammkneipe gab es einen kleinen vietnamesischen Imbiss.“"
                                            },
                                            {
                                                "example_id": "7ebe4cd9-eb3d-4b1b-99b8-52775373e2f6",
                                                "sense_id": "2f19d36e-00b8-31de-9923-c76c7ebf862a",
                                                "text": "„Aldís zog die Nase hoch, schnäuzte sich, suchte Zuflucht im Imbiss des Ladens, wo sie einen Hotdog bestellte, aber gar keinen Hunger verspürte und das Würstchen nach dem ersten Bissen in die Tonne warf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
