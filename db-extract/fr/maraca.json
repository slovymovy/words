                        "entry_id": "d8737575-62ff-384f-9375-699b344fe918",
                        "glosses": [
                            "Instrument de musique à percussion constitué d’’une calebasse remplie de graines et emmanché sur un bâton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c279b6de-37c2-4e24-ab5b-47e023b73c5a",
                                "sense_id": "b9dc19b7-6b5f-3eab-9c43-56d5484c71aa",
                                "text": "Certains d’entre eux tenaient une maraca, ce curieux instrument de musique fait d’un fruit dont le bruit a pour effet de réveiller les esprits."
                            },
                            {
                                "example_id": "80d61934-47a2-49bc-83d5-4335b6ca6e93",
                                "sense_id": "b9dc19b7-6b5f-3eab-9c43-56d5484c71aa",
                                "text": "A quelle rêverie vient m’arracher alors une étrange psalmodie, scandée par une maraca ?"
                            },
                            {
                                "example_id": "7498e8bd-c5bf-4c60-a776-c2fba77fb01a",
                                "sense_id": "b9dc19b7-6b5f-3eab-9c43-56d5484c71aa",
                                "text": "Ils partageaient deux maracas : chacun le sien."
                            }
                        ]
                    }
