{
    "word_family": [
        "revolting",
        "revolted",
        "revolter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2d486e4-230e-3817-b6ae-4fc9ea5a8396",
                    "sense_definition": "An act of violent uprising against an authority or government.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uprising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens started a <w>revolt</w> against the unfair taxes imposed by the king.",
                            "target_lang_translations": {
                                "tr": "Vatandaşlar, kral tarafından dayatılan haksız vergilere karşı bir <w>isyan</w> başlattı."
                            }
                        },
                        {
                            "text": "The military <w>revolt</w> was quickly suppressed by the government forces.",
                            "target_lang_translations": {
                                "tr": "Askeri <w>ayaklanma</w> hükümet güçleri tarafından hızla bastırıldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "armed revolt",
                        "insurrection",
                        "rebellion"
                    ],
                    "common_phrases": [
                        "lead a revolt",
                        "crush a revolt"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir otoriteye veya hükümete karşı şiddetli ayaklanma eylemi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "isyan",
                                "target_lang_sense_clarification": "Genel olarak otoriteye karşı ayaklanma."
                            },
                            {
                                "target_lang_word": "başkaldırı",
                                "target_lang_sense_clarification": "Düzenin bozulmasına yönelik direniş."
                            },
                            {
                                "target_lang_word": "ayaklanma",
                                "target_lang_sense_clarification": "Toplu bir şekilde yönetime karşı gelme."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8aad53b0-f663-358a-a625-56c5a7b12ccc",
                    "sense_definition": "To rise up in open opposition against an authority or government.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uprising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The people decided to <w>revolt</w> against the corrupt regime.",
                            "target_lang_translations": {
                                "tr": "Halk, yozlaşmış rejime karşı <w>isyan etmeye</w> karar verdi."
                            }
                        },
                        {
                            "text": "The soldiers refused to <w>revolt</w> despite the harsh conditions.",
                            "target_lang_translations": {
                                "tr": "Askerler, zorlu koşullara rağmen <w>başkaldırmayı</w> reddetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "rebellion"
                    ],
                    "common_phrases": [
                        "revolt against"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir otoriteye veya hükümete karşı açıkça karşı gelmek veya ayaklanmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "isyan etmek",
                                "target_lang_sense_clarification": "Otoriteye karşı fiilen ayaklanmak."
                            },
                            {
                                "target_lang_word": "başkaldırmak",
                                "target_lang_sense_clarification": "Boyun eğmeyi reddedip karşı durmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97ae2376-249d-39d1-ae91-8e70b07be7c9",
                    "sense_definition": "To cause someone to feel intense disgust or repulsion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disgust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smell of the rotting garbage <w>revolts</w> me.",
                            "target_lang_translations": {
                                "tr": "Çürüyen çöplerin kokusu beni <w>iğrendiriyor</w>."
                            }
                        },
                        {
                            "text": "His cruel behavior <w>revolts</w> everyone who hears about it.",
                            "target_lang_translations": {
                                "tr": "Onun zalimce davranışları, bunu duyan herkesi <w>tiksindiriyor</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinde yoğun bir tiksinti veya iğrenme duygusu uyandırmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "iğrendirmek",
                                "target_lang_sense_clarification": "Bir şeyin kişide tiksinti yaratması."
                            },
                            {
                                "target_lang_word": "tiksindirmek",
                                "target_lang_sense_clarification": "Bir durumun veya davranışın kişide nefret uyandırması."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "333e7cfe-6e21-377e-804f-20de95c09831",
                    "sense_definition": "To feel strong physical or moral disgust or nausea towards something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disgust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My stomach <w>revolts</w> at the sight of such greasy food.",
                            "target_lang_translations": {
                                "tr": "Böylesine yağlı yemekleri görünce midem <w>bulanıyor</w>."
                            }
                        },
                        {
                            "text": "Most people <w>revolt</w> at the thought of animal cruelty.",
                            "target_lang_translations": {
                                "tr": "Çoğu insan hayvan zulmü düşüncesinden <w>tiksinti duyuyor</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "revolt at"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeye karşı güçlü bir fiziksel veya ahlaki tiksinti ya da mide bulantısı hissetmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "iğrenmek",
                                "target_lang_sense_clarification": "Bir şeyden tiksinme duygusu duymak."
                            },
                            {
                                "target_lang_word": "tiksinti duymak",
                                "target_lang_sense_clarification": "Bir duruma karşı ahlaki veya fiziksel tepki göstermek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}