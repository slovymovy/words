                ],
                "senses": [
                    {
                        "sense_id": "1d489812-9bd3-36a9-8908-3ec0a6d2a538",
                        "entry_id": "43e8b079-bf70-37e9-9603-e43cf2499e94",
                        "glosses": [
                            "Betriebsart beim Backofen, bei der ein kleiner Lüfter die warme Luft umwälzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6745df2a-9b18-46d4-b649-19cfb5d6e1a4",
                                "sense_id": "1d489812-9bd3-36a9-8908-3ec0a6d2a538",
                                "text": "Die Brötchen sollen bei 200 °C Ober-Unterhitze oder 175 °C Umluft 30 Minuten backen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f38c8332-26e5-3909-ae1d-4f5bf275d3ed",
                        "entry_id": "43e8b079-bf70-37e9-9603-e43cf2499e94",
                        "glosses": [
                            "Abluft, die teilweise oder zur Gänze nicht aus dem Gebäude abgeführt wird, sondern dem Raum erneut als Zuluft / Mischluft zugeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "558aa8c1-c9b6-4bda-a42c-0f8ee11c74f1",
                                "sense_id": "f38c8332-26e5-3909-ae1d-4f5bf275d3ed",
                                "text": "Heutzutage vermeidet man es, gebrauchte Umluft im Gebäude zu belassen und weiter zu verteilen."
                            },
                            {
                                "example_id": "e7e37e8b-d1ce-4046-b79b-2c1861d751e9",
                                "sense_id": "f38c8332-26e5-3909-ae1d-4f5bf275d3ed",
                                "text": "„In der Richtlinie TM26, der englischen Ingenieursvereinigung CIBSE gilt die Staubflächendichte von 1 g/m² für den Bereich Zuluft und Umluft, während für reine Fortluftkanäle eine max. Staubflächendichte von 6 g/m² zulässig ist.“"
                            },
                            {
                                "example_id": "1b88ae35-1ec5-4ec8-95f3-156f8a17f6f3",
                                "sense_id": "f38c8332-26e5-3909-ae1d-4f5bf275d3ed",
                                "text": "„Ob sie mit Umluft oder mit Abluft arbeiten – Abzugshauben in der Küche müssen mit der Wohnungslüftung harmonieren.“"
                            },
                            {
                                "example_id": "35a06425-af3d-4be5-8936-0fd9191fe343",
                                "sense_id": "f38c8332-26e5-3909-ae1d-4f5bf275d3ed",
                                "text": "„Zudem greift die technische Regel des Vereins Deutscher Ingenieure – daher die Abkürzung VDI –für alle Zuluftanlagen sowie für Abluftanlagen, wenn diese die Zuluftqualität durch Umluft beeinflussen.“"
                            },
                            {
                                "example_id": "14a96b45-1695-4d88-8a8b-2dc28b116bd1",
                                "sense_id": "f38c8332-26e5-3909-ae1d-4f5bf275d3ed",
                                "text": "Ein kleiner Heizlüfter in der Übergangszeit ist das beste Beispiel dafür, wie die Umluft durch eine Umluftheizung gewärmt und bewegt wird."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
