                "senses": [
                    {
                        "sense_id": "1c959776-1c3e-3c85-8ab4-2809051f4fb8",
                        "entry_id": "db60b764-c875-38a2-85f0-7cbb02e186b8",
                        "glosses": [
                            "eheliche Partnerschaft, die als besonders glücklich oder vorbildlich dargestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bee78f4-4788-490c-b61a-69c7628425bd",
                                "sense_id": "1c959776-1c3e-3c85-8ab4-2809051f4fb8",
                                "text": "Hannah und Paul führen nach außen hin eine Bilderbuchehe. Doch Paul hat sich in eine 24-Jährige verliebt, mit der er ein Verhältnis hat."
                            },
                            {
                                "example_id": "c84b94ab-0331-4686-b17a-0d86ac0a6a30",
                                "sense_id": "1c959776-1c3e-3c85-8ab4-2809051f4fb8",
                                "text": "Die Beziehung zwischen Schauspielerin Uschi Glas (58) und ihrem Mann Bernd Tewaag (58) galt stets als Bilderbuchehe. Doch dann hatte Uschis „Bernie“ plötzlich eine andere - noch dazu 28 Jahre jünger als sie selbst. Tewaag reichte die Scheidung ein."
                            },
                            {
                                "example_id": "2c300a2e-3b41-4167-8f69-0a058c54404c",
                                "sense_id": "1c959776-1c3e-3c85-8ab4-2809051f4fb8",
                                "text": "Aus Sicht der Angeklagten war ihre Ehe mit […] wie eine Bilderbuchehe verlaufen. […] Die Angeklagte ahnte nicht, daß ihr Ehemann […] seit Mitte 1987 eine intime Beziehung zu der Steuerfachgehilfin […] aufgenommen hatte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
