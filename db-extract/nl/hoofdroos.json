                "senses": [
                    {
                        "sense_id": "d7d36c9f-2287-363a-afe4-ae3f7dd5bd2c",
                        "entry_id": "c52e3c40-4486-3854-a560-5e18001603f3",
                        "glosses": [
                            "afwijking aan de hoofdhuid gekenmerkt door witte vettige schilfers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95570076-9f24-4d8a-b2e3-346568285cbe",
                                "sense_id": "d7d36c9f-2287-363a-afe4-ae3f7dd5bd2c",
                                "text": "In het tl-licht zag ik hoe de schilfers van zijn hardnekkige hoofdroos in zijn fameuze coupe friture bleven plakken, ik zag zijn rode, opgezette gezichtshuid, ik bekeek het allemaal heel nauwkeurig, alsof het het laatste was wat ik van de wereld te zien ging krijgen."
                            },
                            {
                                "example_id": "4d3b84c5-2baf-4de4-abe2-ad5c6dbc9f03",
                                "sense_id": "d7d36c9f-2287-363a-afe4-ae3f7dd5bd2c",
                                "text": "De karakters zijn een beetje plat, maar lachen kun je zeker met deze Britse schrijver. Hij heeft de extreme humor van Roald Dahl en is ook een kei in grappige opsommingen. Zo eten ze op school risotto van hoofdroos, mottenkorma en gefrituurde lijmbrokken. Yuk!"
                            }
                        ]
                    }
