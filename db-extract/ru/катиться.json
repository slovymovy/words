                        "examples": [
                            {
                                "example_id": "42e2d1d1-fdc0-43da-886c-a2e85b63f88f",
                                "sense_id": "09daa044-df32-3b81-aa15-1d6d3a678cf3",
                                "text": "слёзы кати́лись по её щека́м",
                                "translation": "tears were rolling down her cheeks",
                                "english": "tears were rolling down her cheeks"
                            },
                            {
                                "example_id": "b414f72b-0434-40a4-9cf4-36c544611bf5",
                                "sense_id": "09daa044-df32-3b81-aa15-1d6d3a678cf3",
                                "text": "день ка́тится за днём",
                                "translation": "day after day rolls by",
                                "english": "day after day rolls by"
                            },
                            {
                                "example_id": "0fa7ecc9-f633-4652-aadc-e33baa1138f8",
                                "sense_id": "09daa044-df32-3b81-aa15-1d6d3a678cf3",
                                "text": "кати́сь отсю́да!",
                                "translation": "get out!, clear off!, beat it!",
                                "english": "get out!, clear off!, beat it!"
