                "senses": [
                    {
                        "sense_id": "d823b906-e51d-3c81-b92b-160d389e4938",
                        "entry_id": "90432b1f-324c-3b0d-af4b-47c735d5539f",
                        "glosses": [
                            "анат. конусообразный выступ мягкого нёба у некоторых человекообразных обезьян и человека"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e19f98-a6bf-4723-ac73-fb5ee8812bf4",
                                "sense_id": "d823b906-e51d-3c81-b92b-160d389e4938",
                                "text": "— Вы опасный человек! — сказала она мне, — я бы лучше желала попасться в лесу под нож убийцы, чем вам на язычок…"
                            }
                        ]
                    },
                    {
                        "sense_id": "163c4110-4d8b-302a-ab5c-04c939ca1240",
                        "entry_id": "90432b1f-324c-3b0d-af4b-47c735d5539f",
                        "glosses": [
                            "деталь язычковых музыкальных инструментов"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3a8f6259-8488-3e57-97f1-4e94dc50d715",
                        "entry_id": "90432b1f-324c-3b0d-af4b-47c735d5539f",
                        "glosses": [
                            "ботан. небольшой листовидный отросток (у однодольных)"
                        ],
                        "tags": [],
