                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>fleeing</w> from one hiding spot to another exhausted the refugees.",
                            "target_lang_translations": {
                                "nl": "Het constante <w>vluchten</w> van de ene schuilplaats naar de andere putte de vluchtelingen uit."
                            }
                        },
                        {
                            "text": "Their <w>fleeing</w> was a desperate attempt to escape the encroaching army.",
                            "target_lang_translations": {
