                "senses": [
                    {
                        "sense_id": "c6686829-5753-3369-8174-ea151c41254b",
                        "entry_id": "37b46922-1aad-3c0d-826c-b3733287a364",
                        "glosses": [
                            "Mediziner in der praktischen Ausbildungsphase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a45a3fe-9cae-4cc0-87c5-bd25fafa0bc8",
                                "sense_id": "c6686829-5753-3369-8174-ea151c41254b",
                                "text": "„Eine Turnusärztin bzw. ein Turnusarzt ist eine Ärztin bzw. ein Arzt, die bzw. der sich in einer praktischen Ausbildung zur praktischen Ärztin bzw. zum praktischen Arzt oder zur Fachärztin bzw. zum Facharzt befindet.“"
                            },
                            {
                                "example_id": "550b0db9-dcb7-4741-ad7f-7f056f55ac70",
                                "sense_id": "c6686829-5753-3369-8174-ea151c41254b",
                                "text": "„Österreichs Turnusärzte sind mit ihrer Ausbildung zum Facharzt mäßig zufrieden.“"
                            },
                            {
                                "example_id": "1bbada9a-3e3b-4dd6-969a-f4ca9fe8d57b",
                                "sense_id": "c6686829-5753-3369-8174-ea151c41254b",
                                "text": "„Sofern krankenanstaltenrechtliche Organisationsvorschriften keine dauernde Anwesenheit eines Facharztes erfordern, können Turnusärzte, die bereits über die entsprechenden Kenntnisse und Fertigkeiten verfügen, vorübergehend auch ohne Aufsicht eines für die Ausbildung verantwortlichen Facharztes tätig werden.“"
                            },
                            {
                                "example_id": "fc57eef2-e8bd-48a1-8abf-aad8213f0b1f",
                                "sense_id": "c6686829-5753-3369-8174-ea151c41254b",
                                "text": "„Ein typischer Turnusarzt hatte bisher mit Zulagen 3.000 Euro brutto im Monat, künftig werden es 3.700 Euro sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
