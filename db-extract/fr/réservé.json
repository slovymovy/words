                "senses": [
                    {
                        "sense_id": "d95a5913-8e0f-3640-b7d9-861bd105568d",
                        "entry_id": "bfc95c59-7682-3dc5-8549-9185ddd41085",
                        "glosses": [
                            "Discret, timide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0876197-481c-47d0-a7cf-9ab08443d717",
                                "sense_id": "d95a5913-8e0f-3640-b7d9-861bd105568d",
                                "text": "Cette femme est très réservée."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f11ff8e-57a1-31d9-9fd3-c231f3a4ae6d",
                        "entry_id": "bfc95c59-7682-3dc5-8549-9185ddd41085",
                        "glosses": [
                            "Qui ne se prononce pas encore, encore réticent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28c7f75b-8d52-4573-a4f0-6053f21b614e",
                                "sense_id": "4f11ff8e-57a1-31d9-9fd3-c231f3a4ae6d",
                                "text": "Il est réservé sur le sujet."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf96111f-97e6-33c7-a2d6-376820a4995c",
                        "entry_id": "bfc95c59-7682-3dc5-8549-9185ddd41085",
                        "glosses": [
                            "Gardé, conservé pour un usage particulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca5c4cf5-1926-4318-b8d5-9c98d8438f5d",
                                "sense_id": "cf96111f-97e6-33c7-a2d6-376820a4995c",
                                "text": "Places réservées."
                            },
                            {
                                "example_id": "c88b4a78-4226-406f-9206-7515cc402485",
                                "sense_id": "cf96111f-97e6-33c7-a2d6-376820a4995c",
                                "text": "Un wagon réservé."
                            },
                            {
                                "example_id": "16d4c16b-c337-4d45-b8bb-d451829ff43c",
                                "sense_id": "cf96111f-97e6-33c7-a2d6-376820a4995c",
                                "text": "Ces armes sont réservées à l'armée."
                            },
                            {
                                "example_id": "9d43c017-99df-40e5-ba7f-716d0436d74a",
                                "sense_id": "cf96111f-97e6-33c7-a2d6-376820a4995c",
                                "text": "Chasse réservée, terrain où le droit de chasse n’appartient qu’au propriétaire et aux personnes dûment autorisées par le propriétaire."
                            },
                            {
                                "example_id": "245d317d-a587-4798-add4-99cfc8219e02",
                                "sense_id": "cf96111f-97e6-33c7-a2d6-376820a4995c",
                                "text": "Biens réservés, ceux dont un testateur ne peut frustrer ses héritiers légitimes."
                            },
                            {
                                "example_id": "850cac97-3ff3-4412-9b0b-871047fd6bee",
                                "sense_id": "cf96111f-97e6-33c7-a2d6-376820a4995c",
                                "text": "Cas réservés, péché dont on ne peut être absous que par le pape ou l’évêque, ou par les prêtres qui ont reçu d’eux un pouvoir spécial."
                            },
                            {
                                "example_id": "0285e003-0c3c-4716-8a1b-c4e03a84e955",
                                "sense_id": "cf96111f-97e6-33c7-a2d6-376820a4995c",
                                "text": "Les piliers réservés, piliers naturels qui lors du creusement n'ont pas été excavés, ils soutiennent le plafond de la mine."
                            }
                        ]
                    },
                    {
                        "sense_id": "15e3600a-0736-3df8-9512-58146c0579b2",
                        "entry_id": "bfc95c59-7682-3dc5-8549-9185ddd41085",
                        "glosses": [
                            "En termes de procédure,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77be7f0c-5bc3-4a9c-850c-6fcd8d9ce52f",
                                "sense_id": "15e3600a-0736-3df8-9512-58146c0579b2",
                                "text": "Tous droits réservés."
                            },
                            {
                                "example_id": "48e989c3-6d12-44d9-95e6-fc9f9e2fbd3a",
                                "sense_id": "15e3600a-0736-3df8-9512-58146c0579b2",
                                "text": "Toute prétention réservée."
                            },
                            {
                                "example_id": "48748664-3eb5-4b8e-ad2b-1a8964adc849",
                                "sense_id": "15e3600a-0736-3df8-9512-58146c0579b2",
                                "text": "Tous dépens réservés."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4a76e87-9a39-3965-9f2c-02907fbd90a0",
                        "entry_id": "bfc95c59-7682-3dc5-8549-9185ddd41085",
                        "glosses": [
                            "Qui ne doit pas être abattu lors d’une coupe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37bab512-a903-45fe-a0d9-60d52efd38fb",
                                "sense_id": "b4a76e87-9a39-3965-9f2c-02907fbd90a0",
                                "text": "L'acheteur est tenu de respecter toutes les tiges réservées ou non marquées conformément au paragraphe 1.2.1 du règlement national d’exploitation forestière et doit leur éviter tout dommage."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
