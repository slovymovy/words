                ],
                "senses": [
                    {
                        "sense_id": "f476a8fa-9eb5-3deb-b84a-a6d1bc0db6cb",
                        "entry_id": "9de60e35-d6f4-3534-9b0f-7a585514b0fb",
                        "glosses": [
                            "Empêcheur, personne qui fait de l'obstructionnisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c9908c-2428-47e9-8b79-44a78cc77187",
                                "sense_id": "f476a8fa-9eb5-3deb-b84a-a6d1bc0db6cb",
                                "text": "Il faut avoir l’attitude d’une personne qui résout des problèmes plutôt que d’être perçue comme un obstructionniste ou un mandataire de la machine bureaucratique."
                            },
                            {
                                "example_id": "c1495679-52c4-48ed-88d7-16dfcf5aaeb5",
                                "sense_id": "f476a8fa-9eb5-3deb-b84a-a6d1bc0db6cb",
                                "text": "Que faisait-on ici ? Pourquoi ne pas lever la séance en laissant les obstructionnistes seuls face à leurs scrutins ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1464e76-2244-42ad-a97c-ab639de07a22",
                        "source_entry_id": "9de60e35-d6f4-3534-9b0f-7a585514b0fb",
                        "source_sense_id": "f476a8fa-9eb5-3deb-b84a-a6d1bc0db6cb",
                        "target_lang_word": "obstructionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstructionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca835ee2-a35f-37db-809c-89403d454413",
                                        "entry_id": "4ef471d2-4a48-3822-b3d4-6da977257647",
                                        "glosses": [
                                            "Someone who systematically obstructs the actions of others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e040e10-2cb7-4e0f-be0a-dbfedae7f348",
                                                "sense_id": "ca835ee2-a35f-37db-809c-89403d454413",
                                                "text": "\"And you, sir, have lived an unimaginative obstructionist and never can hope now to emerge from it.\""
                                            },
                                            {
                                                "example_id": "5ea11aff-6029-4a5c-a428-05a5ac01b491",
                                                "sense_id": "ca835ee2-a35f-37db-809c-89403d454413",
                                                "text": "The obstructionists didn't have their own plan, but they counted, successfully, on delay to frustrate any alternative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "239a1cff-dd54-34ea-92bf-7577803a6882",
                                        "entry_id": "4ef471d2-4a48-3822-b3d4-6da977257647",
                                        "glosses": [
                                            "Someone who systematically obstructs the actions of others.",
                                            "Someone who attempts to impede the progress of legislation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
