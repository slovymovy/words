                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de38efab-4d79-3907-bf42-4acf8c3445b8",
                                        "entry_id": "8bbfc95b-152f-3ad8-b2dc-12f58a72ad64",
                                        "glosses": [
                                            "To seal or stop up, especially with a cork stopper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70587fd3-3321-4645-9b2a-878db46aa90e",
                                                "sense_id": "de38efab-4d79-3907-bf42-4acf8c3445b8",
                                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nArms draped on shoulders, kick-stepping in circles, they swing bottles of wine. Purpled thumbs cork the bottles. The wine leaps and jumps behind green glass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b5eb1c9-d251-3629-8ed7-495c8f1986c1",
                                        "entry_id": "8bbfc95b-152f-3ad8-b2dc-12f58a72ad64",
                                        "glosses": [
                                            "To blacken (as) with a burnt cork."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8afd66b9-bb11-3a16-8967-1d4a423605cc",
                                        "entry_id": "8bbfc95b-152f-3ad8-b2dc-12f58a72ad64",
                                        "glosses": [
                                            "To leave the cork in a bottle after attempting to uncork it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c3ba142-d864-320c-a590-4ff064a3eb2a",
                                        "entry_id": "8bbfc95b-152f-3ad8-b2dc-12f58a72ad64",
                                        "glosses": [
                                            "To fill with cork."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "751bfb31-c27d-311a-9af8-c8c66830d0ba",
                                        "entry_id": "8bbfc95b-152f-3ad8-b2dc-12f58a72ad64",
                                        "glosses": [
                                            "To fill with cork.",
                                            "To tamper with (a bat) by drilling out part of the head and filling the cavity with cork or similar light, compressible material."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c92cf468-215f-469f-8653-710623041146",
                                                "sense_id": "751bfb31-c27d-311a-9af8-c8c66830d0ba",
                                                "text": "He corked his bat, which was discovered when it broke, causing a controversy."
                                            },
                                            {
                                                "example_id": "4397c62e-8d8b-4e53-b491-a8df34bd5a6d",
                                                "sense_id": "751bfb31-c27d-311a-9af8-c8c66830d0ba",
                                                "text": "Apparently I used to have some good power even though I was little, but the team we were playing against thought I had corked the bat. I kid you not! They paid $200 to have the bat popped off to prove they were right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd5eadf6-80d6-3de1-af32-88d9cf2ddebc",
                                        "entry_id": "8bbfc95b-152f-3ad8-b2dc-12f58a72ad64",
                                        "glosses": [
                                            "To injure through a blow; to induce a haematoma."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51ccaccb-7fbd-4bc1-9117-535c0450fe8d",
                                                "sense_id": "fd5eadf6-80d6-3de1-af32-88d9cf2ddebc",
                                                "text": "The vicious tackle corked his leg."
                                            },
                                            {
                                                "example_id": "ce2d1c24-849d-4b51-94eb-31f10f75fafa",
                                                "sense_id": "fd5eadf6-80d6-3de1-af32-88d9cf2ddebc",
                                                "text": "Injuries, which seemed to be of an inconsequential nature, were often sustained, such as a sprained ankle, a dislocated phalanx, a twisted foot, a corked leg and so on."
                                            },
                                            {
                                                "example_id": "8bdebaa6-8bee-4d7c-a37b-b6163ff0d96a",
                                                "sense_id": "fd5eadf6-80d6-3de1-af32-88d9cf2ddebc",
                                                "text": "As he moved away again, William winced at an ache in his thigh.\n‘Must have corked my leg when I got up,’ he thought."
                                            },
                                            {
                                                "example_id": "236de205-e60a-4b69-b84a-abc3196e7a88",
                                                "sense_id": "fd5eadf6-80d6-3de1-af32-88d9cf2ddebc",
                                                "text": "“I′m okay. I must have corked my thigh when Bruce fell onto me. I′ll be fine.”"
                                            },
                                            {
                                                "example_id": "eec44568-1413-4027-a2ee-5727725e32c4",
                                                "sense_id": "fd5eadf6-80d6-3de1-af32-88d9cf2ddebc",
                                                "text": "2010, Andrew Stojanovski, Dog Ear Cafe, large print 16pt, page 191,\nMuch to my relief he had only corked his leg when he had jumped."
                                            },
                                            {
                                                "example_id": "a2e2429d-2b61-407c-a7df-986c5d773176",
                                                "sense_id": "fd5eadf6-80d6-3de1-af32-88d9cf2ddebc",
                                                "text": "I corked my thigh late in the game, which we won, and came off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e560cf1-f165-3306-9b93-e89c9c8d1cba",
                                        "entry_id": "8bbfc95b-152f-3ad8-b2dc-12f58a72ad64",
                                        "glosses": [
                                            "To position one's drift net just outside of another person's net, thereby intercepting and catching all the fish that would have gone into that person's net."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5866c88-9dd4-4148-bc27-59e8bb072277",
                                                "sense_id": "1e560cf1-f165-3306-9b93-e89c9c8d1cba",
                                                "text": "Kate remembered then, the family fish camp a mile or so up Amartuq Creek, the very creek across the mouth of which Yuri Andreev had tried to cork Joe Anahonak not half an hour before."
                                            },
                                            {
                                                "example_id": "a5ab1491-1ff7-4134-856f-ef624cc0e3b7",
                                                "sense_id": "1e560cf1-f165-3306-9b93-e89c9c8d1cba",
                                                "text": "But its soon apparent that there are more boats than fish—at least for the moment. We all drift quietly, keeping an eye out for other boats and other nets. Corking another guy's net is a screaming—bastard offense."
                                            },
                                            {
                                                "example_id": "7ee3b74b-0440-483b-b380-e52603b91076",
                                                "sense_id": "1e560cf1-f165-3306-9b93-e89c9c8d1cba",
                                                "text": "You're pissed if someone sets too close to you and especially if he sets his net right along yours, \"corking\" you and intercepting the fish that seem headed to your own net. I was close to this guy's outside net, but definitely not corking him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64cf01f6-7bad-3da5-9caa-537e3040173d",
                                        "entry_id": "8bbfc95b-152f-3ad8-b2dc-12f58a72ad64",
                                        "glosses": [
                                            "To block (a street) illegally, to allow a protest or other activity to take place without traffic."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7692d412-6fe5-41c3-a162-ae485b1f613a",
                                                "sense_id": "64cf01f6-7bad-3da5-9caa-537e3040173d",
                                                "text": "[…] corking the streets is a challenge to capitalist ideologies, like skateboarding in parking lots and walkways […]"
                                            }
                                        ]
                                    }
                                ]
                            },
