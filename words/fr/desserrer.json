{
    "word_family": [
        "serrer",
        "serrage",
        "desserrage",
        "resserrer",
        "resserrement",
        "serrement",
        "serre"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30468951-56ae-32f4-ab48-fa3ff836874d",
                    "sense_definition": "Rendre moins serré un objet, un lien, un vêtement ou une fixation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relâcher_tension_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ce repas copieux, il a dû <w>desserrer</w> un peu sa ceinture pour respirer.",
                            "target_lang_translations": {
                                "en": "After that hearty meal, he had to <w>loosen</w> his belt a little to breathe.",
                                "ru": "После такого обильного обеда ему пришлось немного <w>ослабить</w> ремень, чтобы дышать.",
                                "de": "Nach diesem üppigen Essen musste er seinen Gürtel ein wenig <w>lockern</w>, um atmen zu können.",
                                "es": "Después de esa comida copiosa, tuvo que <w>aflojar</w> un poco el cinturón para poder respirar.",
                                "zh": "吃完这顿丰盛的大餐，他不得不把腰带<w>松开</w>一点，才能喘过气来。"
                            }
                        },
                        {
                            "text": "Le mécanicien utilise une clé pour <w>desserrer</w> les boulons de la roue avant.",
                            "target_lang_translations": {
                                "en": "The mechanic uses a wrench to <w>loosen</w> the bolts on the front wheel.",
                                "ru": "Механик использует гаечный ключ, чтобы <w>ослабить</w> болты переднего колеса.",
                                "de": "Der Mechaniker benutzt einen Schlüssel, um die Radbolzen am Vorderrad zu <w>lockern</w>.",
                                "es": "El mecánico utiliza una llave para <w>aflojar</w> las tuercas de la rueda delantera.",
                                "zh": "技师用扳手<w>松开</w>前轮的螺栓。"
                            }
                        }
                    ],
                    "synonyms": [
                        "détendre",
                        "relâcher",
                        "dénouer"
                    ],
                    "antonyms": [
                        "serrer"
                    ],
                    "common_phrases": [
                        "desserrer la ceinture",
                        "desserrer un nœud",
                        "desserrer une vis"
                    ],
                    "target_lang_definitions": {
                        "en": "To make an object, knot, garment or fastening less tight.",
                        "ru": "Сделать менее тугими предмет, узел, одежду или крепление.",
                        "de": "Einen Gegenstand, einen Knoten, ein Kleidungsstück oder eine Befestigung weniger fest machen.",
                        "es": "Hacer menos apretado un objeto, un nudo, una prenda o una sujeción.",
                        "zh": "使物体、绳结、衣物或紧固件变得不那么紧。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "loosen",
                                "target_lang_sense_clarification": "belts, knots, screws, fastenings"
                            },
                            {
                                "target_lang_word": "slacken",
                                "target_lang_sense_clarification": "ropes, cables, reins, tension"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ослабить",
                                "target_lang_sense_clarification": "ремень, болты, винты, крепления"
                            },
                            {
                                "target_lang_word": "распустить",
                                "target_lang_sense_clarification": "узел, шнуровку, шнурки"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lockern",
                                "target_lang_sense_clarification": "Gürtel, Schrauben, Befestigungen"
                            },
                            {
                                "target_lang_word": "lösen",
                                "target_lang_sense_clarification": "Knoten, Schnürsenkel, Verschlüsse"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aflojar",
                                "target_lang_sense_clarification": "cinturón, nudos, prendas"
                            },
                            {
                                "target_lang_word": "desapretar",
                                "target_lang_sense_clarification": "tuercas, tornillos, tapas"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "松开",
                                "target_lang_sense_clarification": "腰带、螺丝、绳结"
                            },
                            {
                                "target_lang_word": "放松",
                                "target_lang_sense_clarification": "衣物、束缚、紧固件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c10fae17-203a-3f6d-aa4d-dc95083c68b9",
                    "sense_definition": "Ouvrir ou cesser de maintenir contractée une partie du corps, ou débloquer un mécanisme.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relâcher_tension_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'effet de la colère, elle refusait de <w>desserrer</w> les dents devant le juge.",
                            "target_lang_translations": {
                                "en": "In her anger, she refused to <w>unclench</w> her teeth in front of the judge.",
                                "ru": "Охваченная гневом, она отказывалась <w>разжимать</w> зубы перед судьёй.",
                                "de": "Vor Wut weigerte sie sich, vor dem Richter die Kiefer zu <w>entspannen</w>.",
                                "es": "Presa de la rabia, se negaba a <w>relajar</w> la mandíbula ante el juez.",
                                "zh": "她正在气头上，在法官面前就是不肯<w>松开</w>牙关。"
                            }
                        },
                        {
                            "text": "N'oublie pas de <w>desserrer</w> le frein à main avant de démarrer la voiture.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>release</w> the handbrake before starting the car.",
                                "ru": "Не забудь <w>отпустить</w> ручной тормоз, прежде чем завести машину.",
                                "de": "Vergiss nicht, vor dem Losfahren die Handbremse zu <w>lösen</w>.",
                                "es": "No olvides <w>soltar</w> el freno de mano antes de arrancar el coche.",
                                "zh": "发动汽车前别忘了<w>松开</w>手刹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ouvrir",
                        "décontracter",
                        "relâcher"
                    ],
                    "antonyms": [
                        "serrer",
                        "crisper"
                    ],
                    "common_phrases": [
                        "desserrer les dents",
                        "desserrer le frein"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop holding a part of the body tense, or to release a mechanism.",
                        "ru": "Перестать напрягать часть тела или разблокировать механизм.",
                        "de": "Eine angespannte Körperstelle nicht mehr anspannen oder einen Mechanismus entriegeln.",
                        "es": "Dejar de mantener tensa una parte del cuerpo o desbloquear un mecanismo.",
                        "zh": "不再绷紧身体的某个部位，或解除机械装置的锁定。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unclench",
                                "target_lang_sense_clarification": "teeth, fists, jaw muscles"
                            },
                            {
                                "target_lang_word": "release",
                                "target_lang_sense_clarification": "handbrakes, locks, mechanisms"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "разжать",
                                "target_lang_sense_clarification": "зубы, кулаки, челюсть"
                            },
                            {
                                "target_lang_word": "отпустить",
                                "target_lang_sense_clarification": "ручной тормоз, стопор, фиксатор"
                            },
                            {
                                "target_lang_word": "расслабить",
                                "target_lang_sense_clarification": "мышцы, челюсть, плечи"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lösen",
                                "target_lang_sense_clarification": "Handbremse, Feststellbremse"
                            },
                            {
                                "target_lang_word": "entspannen",
                                "target_lang_sense_clarification": "Kiefer, Muskeln, Körperpartien"
                            },
                            {
                                "target_lang_word": "entriegeln",
                                "target_lang_sense_clarification": "Schloss, Riegel, Mechanismus"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "soltar",
                                "target_lang_sense_clarification": "freno de mano, cerrojo"
                            },
                            {
                                "target_lang_word": "relajar",
                                "target_lang_sense_clarification": "mandíbula, músculos, hombros"
                            },
                            {
                                "target_lang_word": "liberar",
                                "target_lang_sense_clarification": "mecanismo, bloqueo, pestillo"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "松开",
                                "target_lang_sense_clarification": "牙齿、拳头、紧绷的肌肉"
                            },
                            {
                                "target_lang_word": "释放",
                                "target_lang_sense_clarification": "手刹、锁定机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e94e37e5-6291-3d52-833f-6820ad76791b",
                    "sense_definition": "Devenir moins tendu ou perdre de sa fermeté, en parlant d'un lien ou d'un assemblage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relâcher_tension_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À force de marcher sur ce chemin caillouteux, mes lacets se sont <w>desserrés</w>.",
                            "target_lang_translations": {
                                "en": "After walking so long on this stony path, my laces have <w>loosened</w>.",
                                "ru": "От долгой ходьбы по этой каменистой тропе мои шнурки <w>ослабли</w>.",
                                "de": "Vom langen Gehen auf diesem steinigen Weg haben sich meine Schnürsenkel <w>gelockert</w>.",
                                "es": "De tanto caminar por este sendero pedregoso, mis cordones <w>se aflojaron</w>.",
                                "zh": "在这条碎石小路上走了这么久，我的鞋带都<w>松动</w>了。"
                            }
                        },
                        {
                            "text": "Avec les vibrations constantes du moteur, plusieurs vis risquent de se <w>desserrer</w>.",
                            "target_lang_translations": {
                                "en": "With the engine constantly vibrating, several screws may <w>loosen</w>.",
                                "ru": "Из-за постоянной вибрации мотора несколько винтов могут <w>разболтаться</w>.",
                                "de": "Durch die ständigen Vibrationen des Motors könnten sich mehrere Schrauben <w>lockern</w>.",
                                "es": "Con las vibraciones constantes del motor, varios tornillos podrían <w>soltarse</w>.",
                                "zh": "发动机持续震动，好几个螺丝可能会<w>松动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "se détendre",
                        "se relâcher"
                    ],
                    "antonyms": [
                        "se serrer",
                        "se resserrer"
                    ],
                    "target_lang_definitions": {
                        "en": "To become less taut or firm, said of a tie or joint.",
                        "ru": "Становиться менее натянутым или крепким — о связи или соединении.",
                        "de": "Weniger straff oder fest werden, besonders bei einer Verbindung oder Befestigung.",
                        "es": "Perder firmeza o tensión, dicho de una atadura o de una unión.",
                        "zh": "指绳子或连接件等变得不那么紧，或失去牢固性。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "loosen",
                                "target_lang_sense_clarification": "laces, screws, fittings becoming loose"
                            },
                            {
                                "target_lang_word": "slacken",
                                "target_lang_sense_clarification": "ropes, cables becoming less taut"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ослабнуть",
                                "target_lang_sense_clarification": "шнурки, узлы, ремни"
                            },
                            {
                                "target_lang_word": "разболтаться",
                                "target_lang_sense_clarification": "винты, болты, гайки, соединения"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich lockern",
                                "target_lang_sense_clarification": "Schrauben, Muttern, Befestigungen"
                            },
                            {
                                "target_lang_word": "sich lösen",
                                "target_lang_sense_clarification": "Knoten, Schnürsenkel, Verbindungen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aflojarse",
                                "target_lang_sense_clarification": "cordones, nudos, ataduras"
                            },
                            {
                                "target_lang_word": "soltarse",
                                "target_lang_sense_clarification": "tornillos, tuercas, piezas"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "松动",
                                "target_lang_sense_clarification": "螺丝、螺母、零件"
                            },
                            {
                                "target_lang_word": "松弛",
                                "target_lang_sense_clarification": "绳索、缆绳、绷带"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dd33d0c-a89b-33a7-a649-4d815ce71a45",
                    "sense_definition": "Rendre une situation, une règle ou une contrainte moins rigoureuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relâcher_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque centrale a décidé de <w>desserrer</w> sa politique monétaire pour relancer l'activité.",
                            "target_lang_translations": {
                                "en": "The central bank has decided to <w>ease</w> its monetary policy to boost economic activity.",
                                "ru": "Центральный банк решил <w>смягчить</w> денежно-кредитную политику, чтобы оживить деловую активность.",
                                "de": "Die Zentralbank hat beschlossen, ihre Geldpolitik zu <w>lockern</w>, um die Wirtschaft anzukurbeln.",
                                "es": "El banco central ha decidido <w>flexibilizar</w> su política monetaria para reactivar la actividad económica.",
                                "zh": "央行决定<w>放宽</w>货币政策，以提振经济活动。"
                            }
                        },
                        {
                            "text": "Les forces de police ont fini par <w>desserrer</w> l'étau autour du quartier bloqué.",
                            "target_lang_translations": {
                                "en": "The police finally <w>eased</w> their grip on the cordoned-off neighbourhood.",
                                "ru": "Полиция наконец <w>ослабила</w> кольцо оцепления вокруг заблокированного квартала.",
                                "de": "Die Polizei hat schließlich den Ring um das abgeriegelte Viertel <w>gelockert</w>.",
                                "es": "La policía ha acabado por <w>aflojar</w> el cerco alrededor del barrio bloqueado.",
                                "zh": "警方终于<w>放松</w>了对被封锁街区的管控。"
                            }
                        }
                    ],
                    "synonyms": [
                        "assouplir",
                        "alléger",
                        "atténuer"
                    ],
                    "antonyms": [
                        "durcir",
                        "resserrer"
                    ],
                    "common_phrases": [
                        "desserrer l'étau"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a situation, rule or constraint less strict.",
                        "ru": "Сделать ситуацию, правило или ограничение менее строгими.",
                        "de": "Eine Situation, eine Regel oder eine Einschränkung weniger streng gestalten.",
                        "es": "Hacer menos estricta una situación, una norma o una restricción.",
                        "zh": "使情况、规则或限制变得不那么严格。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ease",
                                "target_lang_sense_clarification": "restrictions, pressure, tensions"
                            },
                            {
                                "target_lang_word": "loosen",
                                "target_lang_sense_clarification": "monetary policy, controls, regulations"
                            },
                            {
                                "target_lang_word": "relax",
                                "target_lang_sense_clarification": "rules, regulations, requirements"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "смягчить",
                                "target_lang_sense_clarification": "правила, требования, денежную политику"
                            },
                            {
                                "target_lang_word": "ослабить",
                                "target_lang_sense_clarification": "контроль, давление, ограничения"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "lockern",
                                "target_lang_sense_clarification": "Regeln, Vorschriften, Geldpolitik"
                            },
                            {
                                "target_lang_word": "entschärfen",
                                "target_lang_sense_clarification": "Lage, Spannungen, Konflikte"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "aflojar",
                                "target_lang_sense_clarification": "normas, controles, restricciones"
                            },
                            {
                                "target_lang_word": "flexibilizar",
                                "target_lang_sense_clarification": "política monetaria, normas, requisitos"
                            },
                            {
                                "target_lang_word": "suavizar",
                                "target_lang_sense_clarification": "medidas, tensiones, sanciones"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放宽",
                                "target_lang_sense_clarification": "政策、限制、规定"
                            },
                            {
                                "target_lang_word": "放松",
                                "target_lang_sense_clarification": "规则、管制、要求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f5dc5dc-fae7-332f-840a-2e32462ea6a3",
                    "sense_definition": "Augmenter l'intervalle entre des personnes ou des objets trop rapprochés.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "espacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a demandé aux élèves de <w>desserrer</w> les rangs dans la cour.",
                            "target_lang_translations": {
                                "en": "The teacher asked the pupils to <w>space out</w> their rows in the playground.",
                                "ru": "Учитель попросил учеников <w>раздвинуть</w> ряды на школьном дворе.",
                                "de": "Der Lehrer bat die Schüler, auf dem Schulhof die Reihen <w>aufzulockern</w>.",
                                "es": "El profesor pidió a los alumnos que <w>separaran</w> las filas en el patio.",
                                "zh": "老师让学生们在操场上把队伍<w>拉开</w>些距离。"
                            }
                        },
                        {
                            "text": "Le graphiste a légèrement <w>desserré</w> les lettres du titre pour mieux l'aérer.",
                            "target_lang_translations": {
                                "en": "The graphic designer slightly <w>spaced out</w> the letters of the title to give it more room to breathe.",
                                "ru": "Графический дизайнер слегка <w>раздвинул</w> буквы заголовка, чтобы сделать его воздушнее.",
                                "de": "Der Grafiker hat die Buchstaben des Titels leicht <w>spationiert</w>, damit der Titel luftiger wirkt.",
                                "es": "El diseñador gráfico ha <w>espaciado</w> ligeramente las letras del título para que respire mejor.",
                                "zh": "设计师略微<w>拉大</w>了标题字母之间的间距，让标题看起来更加疏朗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "espacer",
                        "écarter"
                    ],
                    "antonyms": [
                        "rapprocher",
                        "resserrer"
                    ],
                    "common_phrases": [
                        "desserrer les rangs"
                    ],
                    "target_lang_definitions": {
                        "en": "To increase the gap between people or objects that are too close together.",
                        "ru": "Увеличить промежуток между людьми или предметами, которые стоят слишком близко.",
                        "de": "Den Abstand zwischen zu dicht beieinanderstehenden Personen oder Gegenständen vergrößern.",
                        "es": "Aumentar la distancia entre personas u objetos que están demasiado juntos.",
                        "zh": "扩大彼此靠得过近的人或物之间的间隔。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "space",
                                "target_lang_sense_clarification": "letters, rows, objects spaced apart"
                            },
                            {
                                "target_lang_word": "spread",
                                "target_lang_sense_clarification": "people, groups, objects dispersing"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "раздвинуть",
                                "target_lang_sense_clarification": "ряды, строки, буквы"
                            },
                            {
                                "target_lang_word": "разредить",
                                "target_lang_sense_clarification": "толпу, ряды, строй"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auflockern",
                                "target_lang_sense_clarification": "Reihen, Aufstellung, Formation"
                            },
                            {
                                "target_lang_word": "auseinanderrücken",
                                "target_lang_sense_clarification": "Stühle, Personen, Gegenstände"
                            },
                            {
                                "target_lang_word": "spationieren",
                                "target_lang_sense_clarification": "Buchstaben, Schrift, Typografie"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "espaciar",
                                "target_lang_sense_clarification": "letras, filas, tipografía"
                            },
                            {
                                "target_lang_word": "separar",
                                "target_lang_sense_clarification": "personas, filas, sillas"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉开",
                                "target_lang_sense_clarification": "队列、间距、距离"
                            },
