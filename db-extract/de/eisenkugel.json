                        "examples": [
                            {
                                "example_id": "2d4b6876-4639-4c9e-8854-a04bce8fc789",
                                "sense_id": "009d278a-efb9-378a-887b-84653a211d15",
                                "text": "„Der Mann ging mit einer Kugel, die für das Boule-ähnliche Spiel Petanque benutzt wird, in einen Apple-Store in Dijon, wo er begann, mit der schweren Eisenkugel auf Geräte einzuschlagen.“"
                            },
                            {
                                "example_id": "ea852d9d-b896-4b7c-abb2-d5e22317ce1c",
                                "sense_id": "009d278a-efb9-378a-887b-84653a211d15",
                                "text": "„Als Kevorkian einmal vor das Gericht zitiert wurde, schleifte er eine Eisenkugel hinter sich her.“"
                            },
                            {
                                "example_id": "0c528770-5749-4098-9587-a93845183b00",
                                "sense_id": "009d278a-efb9-378a-887b-84653a211d15",
                                "text": "„Ihre Stein- oder Eisenkugeln wogen bis zu einem halben Zentner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
