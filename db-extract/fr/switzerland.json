                "entry_id": "8ce16428-87a8-33c4-a916-0cf847897a7d",
                "word": "Switzerland",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d8118aea-1784-3edd-9648-8d7f0fab4d8a",
                        "entry_id": "8ce16428-87a8-33c4-a916-0cf847897a7d",
                        "glosses": [
                            "Suisse, pays d’Europe bordé par l’Allemagne au nord, par l’Autriche et le Liechtenstein à l’est, par l’Italie au sud et par la France à l’ouest, et dont la capitale est Berne."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c83c7dff-8446-4e21-9850-a21b2136a871",
                                "sense_id": "d8118aea-1784-3edd-9648-8d7f0fab4d8a",
                                "text": "Je suis en Switzerland c’est bien mieux rejoins moi"
                            },
                            {
                                "example_id": "537e8537-8355-49f6-b33e-aa97825d86f8",
                                "sense_id": "d8118aea-1784-3edd-9648-8d7f0fab4d8a",
                                "text": "depuis 2010 empêche vendre beaucoup des ses actifs p/investir dans matériaux stratégiques et critiques. Sont-ils contrôleur de GLENCORE, BHP, TRAFIGURA, SHELL et marché l’or physique et MARCHÉ AGRICOLES en Switzerland. Et ça alertée d’autres investisseurs."
                            },
                            {
                                "example_id": "2275988c-56cb-47d6-9390-fa5ed3ced194",
                                "sense_id": "d8118aea-1784-3edd-9648-8d7f0fab4d8a",
                                "text": "Mais je crois que Mister Nicolas n’est pas millionaire, comme le croit ma famille au Songea, et voilà pourquoi je ne lui demanderai jamais si je peux aller le voir en Switzerland, il paraît que c’est un très beau pays, je l’ai constaté en voyant le calendrier de Swisscontact."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a1e729c-3eff-435a-b2b7-f91c8a43dada",
                        "source_entry_id": "8ce16428-87a8-33c4-a916-0cf847897a7d",
                        "source_sense_id": "d8118aea-1784-3edd-9648-8d7f0fab4d8a",
                        "target_lang_word": "Schweiz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweiz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de734bb4-4189-38be-97ad-c1f6a9395adc",
                                        "entry_id": "43195ba8-9ebe-31d9-b8a2-8ad9d3b6899b",
                                        "glosses": [
                                            "Staat in Mitteleuropa"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fedfa53-29f0-4190-b55e-c892535e30f7",
                                                "sense_id": "de734bb4-4189-38be-97ad-c1f6a9395adc",
                                                "text": "Die Hauptstadt der Schweiz ist de facto die Bundesstadt Bern."
                                            },
                                            {
                                                "example_id": "1dd057ce-a686-4124-a4b9-abb2b368fea1",
                                                "sense_id": "de734bb4-4189-38be-97ad-c1f6a9395adc",
                                                "text": "„Mit Voralpen werden in der Schweiz jene Gebiete bezeichnet, die den Übergang vom leicht hügeligen Schweizer Mittelland zum Gebirgsraum der Alpen markieren.“"
                                            },
                                            {
                                                "example_id": "29f58ac9-2a69-4e1c-a91f-cdf3bd9f19a2",
                                                "sense_id": "de734bb4-4189-38be-97ad-c1f6a9395adc",
                                                "text": "„Als traditionelle Orte der Namenforschung im deutschsprachigen Raum sind Lüneburg, Heidelberg, Mainz und Wiesbaden sowie mit Statistiken auch Zentren in Österreich und der Schweiz zu nennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1319879f-a45a-3eb5-995d-1be787402ee3",
                                        "entry_id": "43195ba8-9ebe-31d9-b8a2-8ad9d3b6899b",
                                        "glosses": [
                                            "Teil von Gebietsbezeichnungen bergiger und schöner Landschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00af9f41-872a-4a19-9464-8e3de1369d6e",
                                                "sense_id": "1319879f-a45a-3eb5-995d-1be787402ee3",
                                                "text": "Wir wollen im Sommer durch die Fränkische Schweiz Rad fahren."
                                            },
                                            {
                                                "example_id": "afa8a7be-7f69-4111-adb1-fa51b94d55f3",
                                                "sense_id": "1319879f-a45a-3eb5-995d-1be787402ee3",
                                                "text": "„Noch häufiger wird der Begriff Schweiz für schöne, topographisch bewegte Landschaften angewandt. Weltweit gibt es fast 200 Schweizen, darunter mehr als ein Drittel in Deutschland […].“"
                                            },
                                            {
                                                "example_id": "142bd731-dfa3-4286-9dea-a02d6b025a61",
                                                "sense_id": "1319879f-a45a-3eb5-995d-1be787402ee3",
                                                "text": "„Theodor Fontane, der unermüdliche Wanderer durch Brandenburg, spottete 1862, die ‹Schweizen werden immer kleiner, und so gibt es nicht bloss mehr eine märkische, sondern bereits auch eine Ruppiner Schweiz›.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e06a969-91bf-4948-afdb-1e7dc0cbc585",
