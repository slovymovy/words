    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d72158d8-0281-39ab-b89b-11dbc1524977",
                    "sense_definition": "Périphérique d'entrée composé de touches qui permet d'écrire des textes et d'envoyer des commandes à un ordinateur.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon <w>clavier</w> d'ordinateur ne fonctionne plus depuis ce matin."
                        },
                        {
                            "text": "Il tape très vite sur son <w>clavier</w> sans jamais regarder ses mains."
                        }
                    ],
                    "common_phrases": [
                        "clavier d'ordinateur",
                        "raccourci clavier"
                    ]
                },
                {
                    "sense_id": "e524031f-1d6d-352a-a13a-634f44e5d6a8",
                    "sense_definition": "Ensemble des touches d'un instrument de musique comme le piano ou l'orgue.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pianiste pose doucement ses mains sur le <w>clavier</w> avant de commencer à jouer."
                        },
                        {
                            "text": "Certains orgues possèdent plusieurs <w>claviers</w> superposés."
