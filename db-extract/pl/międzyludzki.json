                "translations": [
                    {
                        "translation_id": "1955d07f-4609-424e-81fc-cb3d26169f0a",
                        "source_entry_id": "a9a0dcef-c34a-38c6-8a57-c939dce130e5",
                        "source_sense_id": "aa9ff2ca-d1b6-3a67-9c55-ebc09b1c9d27",
                        "target_lang_word": "interpersonal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interpersonal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d69637b9-2367-3fc0-b435-1a009315df0f",
                                        "entry_id": "c936334e-a3da-38f4-9808-f1345341f5b6",
                                        "glosses": [
                                            "Between two or more people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33568623-827f-492a-8b27-4431ac0d56e1",
                                                "sense_id": "d69637b9-2367-3fc0-b435-1a009315df0f",
                                                "text": "By slightly modifying Piaget's scheme of the development of the capacity to follow and be aware of rules, I propose to distinguish three stages, or types, of mastery of interpersonal processes: coercion, self-help, and cooperation."
                                            },
                                            {
                                                "example_id": "dfa526ff-59ad-4e63-b8b8-c10b9c0a45e8",
                                                "sense_id": "d69637b9-2367-3fc0-b435-1a009315df0f",
                                                "text": "The complexity of having so many organisations involved, and the deep integration required, has undoubtedly tested the interpersonal skills of project leaders who have had little face-to-face contact."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4b7d6d2-1ed9-4b86-9815-7034d35e00be",
                        "source_entry_id": "a9a0dcef-c34a-38c6-8a57-c939dce130e5",
                        "source_sense_id": "aa9ff2ca-d1b6-3a67-9c55-ebc09b1c9d27",
                        "target_lang_word": "interpersonnel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interpersonnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d6d33a6-c53e-319a-82fb-61862fe4fb7f",
                                        "entry_id": "aa6a98c3-65da-34f2-8011-327bf5afe302",
                                        "glosses": [
                                            "Qui a lieu entre plusieurs personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42be0e70-6696-4998-ba13-e8528d8c2a18",
                                                "sense_id": "3d6d33a6-c53e-319a-82fb-61862fe4fb7f",
                                                "text": "La situation des relations interpersonnelles au sein des écoles est souvent déplorable et questionnante."
                                            },
                                            {
                                                "example_id": "e7f7159c-e181-4aed-ad14-8f8ead07b7c7",
                                                "sense_id": "3d6d33a6-c53e-319a-82fb-61862fe4fb7f",
                                                "text": "…d’une logique d'affrontement brutal à une pratique plus feutrée de ses conflits interpersonnels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e385f1-9dad-367f-921f-81a366e392f5",
                                        "entry_id": "aa6a98c3-65da-34f2-8011-327bf5afe302",
                                        "glosses": [
                                            "Qui a lieu sans intermédiaire entre deux personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6dd69c2-7da6-4e91-bc72-2bb3f289dd9e",
                                                "sense_id": "e3e385f1-9dad-367f-921f-81a366e392f5",
                                                "text": "Ayant grandi immergée dans la technologie des téléphones intélligents et les réseaux sociaux, la génération Z a eu moins d’occasions de développer ses compétences interpersonnelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
