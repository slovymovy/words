                        "form": "шатну́в"
                    },
                    {
                        "form_id": "2172608a-00da-4dab-aa5e-f9c4054128f4",
                        "entry_id": "1dbbe3cf-8c17-3bae-ba85-4e221a5f023b",
                        "tags": [
                            "adverbial",
