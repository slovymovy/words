                                                "example_id": "3ad0a32b-93f3-4385-a701-3bd708aaed48",
                                                "sense_id": "1fb0882b-270b-313f-a304-5d8c624b57b7",
                                                "text": "5 is an automorphic number because 5² = 25, which ends in 5; similarly 625² = 390625, ends in 625."
