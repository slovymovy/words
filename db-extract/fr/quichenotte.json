                        "sense_id": "b7379fb3-2b6e-3e1f-885d-7391e96ce428",
                        "entry_id": "a9c41f73-6746-3d96-9926-7e5e71e95e0b",
                        "glosses": [
                            "Coiffe paysanne traditionnelle de forme cylindrique très enveloppante, accrochée sous le menton et destinée à protéger contre l'ardeur du soleil."
                        ],
                        "tags": [
                            "Vendée",
                            "Charente-Maritime",
                            "Saintonge",
                            "et région nantaise"
                        ],
                        "examples": [
                            {
                                "example_id": "d25b47b8-33e8-4533-8df9-3a627becd585",
                                "sense_id": "b7379fb3-2b6e-3e1f-885d-7391e96ce428",
                                "text": "On voit de vieilles dames porter encore la quichenotte dans les rues de Saint-Barthélemy, ce qui rappelle l’origine normande, bretonne, poitevine, saintongeaise et angevine, de la population blanche de cette île."
                            },
                            {
                                "example_id": "5a3d0673-c00d-48a7-8f45-4a262a9f8ab3",
                                "sense_id": "b7379fb3-2b6e-3e1f-885d-7391e96ce428",
                                "text": "Elle était coiffée d’une quichenotte dont les bavolets protégeaient les côtés de la figure et le cou."
                            }
                        ]
                    }
