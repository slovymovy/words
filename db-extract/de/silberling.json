                "senses": [
                    {
                        "sense_id": "2947d512-5595-3e70-b682-0df054451cc8",
                        "entry_id": "19af581b-9faf-3ded-b9a3-b3bda4a476fc",
                        "glosses": [
                            "eine (antike) Münze aus Silber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46a94be-5550-4770-b4dc-d1cc0f37e4fd",
                                "sense_id": "2947d512-5595-3e70-b682-0df054451cc8",
                                "text": "Neben einigen Silberlingen und Schmuckstücken fanden die Archäologen bei der Ausgrabung auch Spielzeug und andere Alltagsgegenstände."
                            },
                            {
                                "example_id": "01e5106a-8e59-461d-b3d0-501ef5f9d9a4",
                                "sense_id": "2947d512-5595-3e70-b682-0df054451cc8",
                                "text": "„Da ging einer von den Zwölfen, mit Namen Judas Iskariot, zu den Hohenpriestern und sprach: Was wollt ihr mir geben? Ich will ihn euch verraten. Und sie boten ihm dreißig Silberlinge.“"
                            },
                            {
                                "example_id": "9eb7447f-f825-4185-bdae-a94b6db67195",
                                "sense_id": "2947d512-5595-3e70-b682-0df054451cc8",
                                "text": "„Als Judas, der ihn verraten hatte, sah, dass er zum Tode verurteilt war, reute es ihn, und er brachte die dreißig Silberlinge den Hohenpriestern und Ältesten zurück“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f490e19-302d-4b17-877e-da97b7b079e3",
                        "source_entry_id": "19af581b-9faf-3ded-b9a3-b3bda4a476fc",
                        "source_sense_id": "2947d512-5595-3e70-b682-0df054451cc8",
                        "source_sense_description": "eine (antike) Münze aus Silber",
                        "target_lang_word": "silverling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silverling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "749cf27b-bbf1-38ea-932a-83f40b90650f",
                                        "entry_id": "ff9d2900-c0b0-31b3-aee0-a0e8252cb51d",
                                        "glosses": [
                                            "Shekel or small silvern coin of little value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15536dc0-114a-4416-9055-1e29a6e4a073",
                                                "sense_id": "749cf27b-bbf1-38ea-932a-83f40b90650f",
                                                "text": "As for those Samnites, and the men of Uz,\nThat bought my Spanish oils and wines of Greece,\nHere have I purs'd their paltry silverlings.\nFie, what a trouble 'tis to count this trash!"
                                            },
                                            {
                                                "example_id": "a0f5db7d-346f-456a-a418-f36410d348f9",
                                                "sense_id": "749cf27b-bbf1-38ea-932a-83f40b90650f",
                                                "text": "And it shall come to pass in that day, that every place shall be, where there were a thousand vines at a thousand silverlings, it shall even be for briers and thorns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d4ed6ba-d935-3612-9886-dc2421df4d49",
                                        "entry_id": "ff9d2900-c0b0-31b3-aee0-a0e8252cb51d",
                                        "glosses": [
                                            "Baccharis halimifolia, a shrub of the aster family."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
