                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65638ec5-c7c6-4bb0-986c-7cde1872c825",
                                "sense_id": "9a99eaf1-32ba-3b57-94b5-70008e2e417f",
                                "text": "Vlak voor de verkiezingen in september 1989 organiseerde de VVD een campagneavond die qua omvang de bijeenkomst van Klaver oversteeg. De organisatie in Bleiswijk had gerekend op 2000 man; er kwamen er drie keer zo veel. De massale belangstelling leidde tot een file in de richting van de afgehuurde veilinghal."
                            },
                            {
                                "example_id": "288e85b2-2def-4f4e-af8b-65c97d158aaa",
                                "sense_id": "9a99eaf1-32ba-3b57-94b5-70008e2e417f",
                                "text": "Tv-programma EenVandaag liet vanavond al een paar van de foto's zien. De 32 foto's zijn van het middagconcert in de veilinghal in het Noord-Hollandse plaatsje. Daarbij waren tussen de 2500 en 3000 mensen aanwezig. Er was plaats voor 7000 man in de veilinghal, maar die waren er alleen 's avonds."
                            },
                            {
                                "example_id": "8365c90b-66ed-45b2-b834-366b3f9ea0ff",
                                "sense_id": "9a99eaf1-32ba-3b57-94b5-70008e2e417f",
                                "text": "De veilinghal in Broek op Langedijk is de oudste doorvaargroenteveiling te wereld"
                            }
                        ]
                    }
