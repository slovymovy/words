                    {
                        "sense_id": "6e66ddba-349b-34da-85d9-f53af7de8548",
                        "entry_id": "87e95f29-7df9-33b7-ad1d-9bfc1481e309",
                        "glosses": [
                            "A male given name from Welsh."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "386f79cf-2174-428b-862f-2639215c01cd",
                                "sense_id": "6e66ddba-349b-34da-85d9-f53af7de8548",
                                "text": "What was his name now? Literary sort of name - I've got it. Meredith. Meredith Blake. Don't know whether he's alive or not."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fc1055a-30a3-3918-b7f3-eaa823989675",
                        "entry_id": "87e95f29-7df9-33b7-ad1d-9bfc1481e309",
                        "glosses": [
                            "A female given name from Welsh; sometimes mistaken for a combination of Mary and Edith."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d583e4a4-7c5b-41b5-8f75-ba9fab3f72a4",
                                "sense_id": "9fc1055a-30a3-3918-b7f3-eaa823989675",
                                "text": "Chili’s has also enlisted several actors from “The Office” to star in the ads, including Melora Hardin (Jan Levinson), Andy Buckley (David Wallace), Brian Baumgartner (Kevin Malone) and Kate Flannery (Meredith Palmer)."
                            },
                            {
                                "example_id": "81feb4a5-caf0-4c12-b2fa-f955c2fa9ece",
                                "sense_id": "9fc1055a-30a3-3918-b7f3-eaa823989675",
                                "text": "\"What did I hear you say her name was?\"\n\"Meredith. Mary and Edith. Names from both sides of the family.\"\n\"Meredith,\" he repeated softly. \"I like it.\""
                            }
                        ]
                    },
                    {
