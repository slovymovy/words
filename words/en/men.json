                {
                    "sense_id": "41bd7163-f61c-30c9-823a-1200573b3d35",
                    "sense_definition": "Plural of <w>man</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "group_plural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two <w>men</w> shook hands after the meeting.",
                            "target_lang_translations": {
                                "ru": "Двое <w>мужчин</w> пожали друг другу руки после встречи.",
                                "pl": "Dwaj <w>mężczyźni</w> uścisnęli sobie dłonie po spotkaniu."
                            }
                        },
                        {
                            "text": "Most <w>men</w> enjoy watching sports on the weekend.",
                            "target_lang_translations": {
                                "ru": "Большинство <w>мужчин</w> любят смотреть спорт по выходным.",
                                "pl": "Większość <w>mężczyzn</w> lubi oglądać sport w weekendy."
                            }
