        "fr-extract.jsonl": [
            {
                "entry_id": "4bca2941-7976-3b54-9f84-ebd83f17ea87",
                "word": "aventureux",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "314f554f-4e1f-455f-a23d-fc6423170aca",
                        "entry_id": "4bca2941-7976-3b54-9f84-ebd83f17ea87",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "aventureuse"
                    },
                    {
                        "form_id": "271a4a2b-f9f8-496c-a40f-d1d3d6f032b5",
                        "entry_id": "4bca2941-7976-3b54-9f84-ebd83f17ea87",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "aventureuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04af87b7-e61c-3a85-bead-c5282a50b736",
                        "entry_id": "4bca2941-7976-3b54-9f84-ebd83f17ea87",
                        "glosses": [
                            "Qui s’aventure ; qui hasarde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e663664-02f4-4d40-886c-471792ac973f",
                                "sense_id": "04af87b7-e61c-3a85-bead-c5282a50b736",
                                "text": "Je vous laisse à penser si ces tendances se développèrent pendant sa jeunesse aventureuse jetée aux quatre coins du monde."
                            },
                            {
                                "example_id": "e35956e6-bcfb-4121-8da0-23df1110ad13",
                                "sense_id": "04af87b7-e61c-3a85-bead-c5282a50b736",
                                "text": "Personne n’ignore ce que fut cette aventureuse campagne du général Skobeleff contre les peuplades turkomènes, – campagne dont la création du chemin de fer transcaspien assura le succès définitif."
                            },
                            {
                                "example_id": "a4b70b1b-ce35-4c84-ad7e-330ccf822839",
                                "sense_id": "04af87b7-e61c-3a85-bead-c5282a50b736",
                                "text": "Pour rien au monde nous ne nous serions lancés dans une expédition aventureuse."
                            },
                            {
                                "example_id": "5d0e2180-0919-4ebd-99a3-402a4588e188",
                                "sense_id": "04af87b7-e61c-3a85-bead-c5282a50b736",
                                "text": "Quelques jeunes clubmen, dont l’imagination aventureuse s’était enflammée de patriotisme, s’entassèrent dans cinq ou six automobiles et partirent clandestinement pour Beacon Hill."
                            },
                            {
                                "example_id": "813d1efa-c5f3-43be-8a5c-91b3975fee44",
                                "sense_id": "04af87b7-e61c-3a85-bead-c5282a50b736",
                                "text": "– Mon oncle Prosper disait que l’argent ne peut pas rapporter au-dessus de dix et même qu’il ne faut pas chercher au-dessus de dix, que c’est aventureux."
                            },
                            {
                                "example_id": "7328ab50-05d8-4b0e-a860-7aa15549503c",
                                "sense_id": "04af87b7-e61c-3a85-bead-c5282a50b736",
                                "text": "Le temps approche où le grand commerce va, plus que les guerres de chevalerie, tenter les jeunes Anglais aventureux."
                            },
                            {
                                "example_id": "aaa809f0-741e-408c-866c-e59353323be0",
                                "sense_id": "04af87b7-e61c-3a85-bead-c5282a50b736",
                                "text": "Les Belges tenaient un rang très-distingué parmi les Gaulois, […]. Ceux-ci remplissaient tout le monde connu du fracas de leurs armes ; leurs bandes aventureuses étaient partout."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d214c76-7de1-4337-96de-e3125216df25",
                        "source_entry_id": "4bca2941-7976-3b54-9f84-ebd83f17ea87",
                        "source_sense_id": "04af87b7-e61c-3a85-bead-c5282a50b736",
                        "target_lang_word": "abenteuerlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abenteuerlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb413bd3-c010-35e8-9d29-3fc7d72afa8f",
                                        "entry_id": "c4c567ce-cf7f-3336-a67d-7f42880be803",
                                        "glosses": [
                                            "wie ein Abenteuer sein, sich auf ein Abenteuer beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "199d5d76-0459-43ba-b4c1-f2c58337f6d4",
                                                "sense_id": "fb413bd3-c010-35e8-9d29-3fc7d72afa8f",
                                                "text": "Wir haben eine abenteuerliche Reise hinter uns."
                                            },
                                            {
                                                "example_id": "39d00d99-3c95-4816-9f22-51fef9020c00",
                                                "sense_id": "fb413bd3-c010-35e8-9d29-3fc7d72afa8f",
                                                "text": "„Das von A.J. Hucket verbreitete moderne Bungee-Jumping wird, wie auch das Kine-Swinging, bei dem der Fall in ein Bergsteigerseil in seitwärtigen Pendelbewegungen ausgeschwungen wird, als abenteuerliches Vergnügen, als artistische Herausforderung, als kühne Präzisionskunst, als Mutprobe, als extremes Training der Seele […], als Psychotest verstanden und praktiziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b5ace8e8-f2d0-366d-a601-11b20dece8d9",
                                        "entry_id": "c4c567ce-cf7f-3336-a67d-7f42880be803",
                                        "glosses": [
                                            "etwas ohne Vorkenntnisse tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea7ada99-a1b4-408d-a380-621a301ca0b8",
                                                "sense_id": "b5ace8e8-f2d0-366d-a601-11b20dece8d9",
                                                "text": "Es ist abenteuerlich, ohne Insiderkenntnisse an der Börse zu spekulieren."
                                            },
                                            {
                                                "example_id": "472cfb5c-f015-439b-9795-ced4c514ca55",
                                                "sense_id": "b5ace8e8-f2d0-366d-a601-11b20dece8d9",
                                                "text": "„Die Weltbank stellte angesichts dieses abenteuerlichen Umgangs mit Staatsfinanzen ihre Kreditzahlungen an Simbabwe ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
