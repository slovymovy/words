                                "target_senses": [
                                    {
                                        "sense_id": "c5edf38f-e5b6-35fb-af4f-9105e2e0c617",
                                        "entry_id": "bac33da3-4f65-3ef9-9f35-b7e8033a69c0",
                                        "glosses": [
                                            "Initialism of gross domestic product."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70142cda-2065-4ff7-b4b7-642319ca04d1",
                                                "sense_id": "c5edf38f-e5b6-35fb-af4f-9105e2e0c617",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            },
                                            {
                                                "example_id": "ae11a605-f498-496b-bef1-c714d43829cf",
                                                "sense_id": "c5edf38f-e5b6-35fb-af4f-9105e2e0c617",
                                                "text": "Or take Wikipedia. Supported by investments of time rather than money, it has left the old Encyclopedia Britannica in the dust – and taken the GDP down a few notches in the process."
                                            },
                                            {
                                                "example_id": "91068369-6b14-488f-a50d-ca0860644947",
                                                "sense_id": "c5edf38f-e5b6-35fb-af4f-9105e2e0c617",
                                                "text": "Global GDP is projected to grow by 3.1% this year, and by just 2.2% in 2023, according to the latest forecast from the Organization for Economic Cooperation and Development (OECD)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4d99f68-abe4-3a6e-b749-68474ee5d71b",
                                        "entry_id": "bac33da3-4f65-3ef9-9f35-b7e8033a69c0",
                                        "glosses": [
                                            "Initialism of guanosine diphosphate, a nucleotide."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb9d6e8b-5d90-4dcc-aa23-f5364570c427",
                        "source_entry_id": "81361f37-0dd5-38d5-a791-109c1f3c0608",
