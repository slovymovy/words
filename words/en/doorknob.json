    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9766c06-727c-3a43-8aa8-4e4ae653743a",
                    "sense_definition": "A round handle on a door that is turned to open or unlatch it.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She grabbed the <w>doorknob</w> and slowly turned it to open the door.",
                            "target_lang_translations": {
                                "pl": "Chwyciła za <w>gałkę</w> i powoli ją przekręciła, aby otworzyć drzwi."
                            }
                        },
                        {
                            "text": "The brass <w>doorknob</w> was cold to the touch on that winter morning.",
                            "target_lang_translations": {
                                "pl": "Mosiężna <w>klamka</w> była zimna w dotyku tamtego zimowego poranka."
                            }
                        }
                    ],
                    "synonyms": [
                        "door handle"
                    ],
                    "common_phrases": [
                        "brass doorknob",
                        "turn the doorknob"
                    ],
                    "target_lang_definitions": {
                        "pl": "Okrągły uchwyt przy drzwiach służący do ich otwierania poprzez przekręcenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "gałka",
                                "target_lang_sense_clarification": "okrągły uchwyt drzwiowy"
                            },
                            {
                                "target_lang_word": "gałka u drzwi",
                                "target_lang_sense_clarification": "drzwiowa"
                            },
                            {
                                "target_lang_word": "klamka",
                                "target_lang_sense_clarification": "ogólnie o uchwycie do otwierania drzwi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4f82cfc-cfa8-3b9b-99db-c25ddd156c92",
                    "sense_definition": "A stupid, foolish, or clumsy person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop acting like a complete <w>doorknob</w> and pay attention to what you are doing.",
                            "target_lang_translations": {
                                "pl": "Przestań zachowywać się jak skończony <w>idiota</w> i uważaj na to, co robisz."
                            }
                        },
                        {
                            "text": "He felt like an absolute <w>doorknob</w> after forgetting his keys inside the locked car.",
                            "target_lang_translations": {
                                "pl": "Poczuł się jak kompletny <w>głupek</w>, kiedy zapomniał kluczyków z zatrzaśniętego samochodu."
                            }
                        }
                    ],
                    "synonyms": [
                        "idiot",
                        "fool",
                        "blockhead"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "insulting"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba głupia, niemądra lub niezdarna."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "idiota",
                                "target_lang_sense_clarification": "o osobie głupiej"
                            },
                            {
                                "target_lang_word": "głupek",
                                "target_lang_sense_clarification": "potocznie"
                            },
                            {
                                "target_lang_word": "tępak",
                                "target_lang_sense_clarification": "obelżywie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
