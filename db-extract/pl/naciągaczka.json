                                "target_word": "tapeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02f8ebd1-d95d-3bea-9924-eefafb85f980",
                                        "entry_id": "98d01fc1-a33b-394d-9dda-149ff0b5e7f8",
                                        "glosses": [
                                            "Femme qui emprunte de l’argent, souvent sans l’intention de la rendre."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dca12eff-e2b9-4ff4-8807-e7dd9cd775b2",
                                                "sense_id": "02f8ebd1-d95d-3bea-9924-eefafb85f980",
                                                "text": "Entre une copine et une tapeuse, la différence est petite quand on est riche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7acbb152-abc2-34e2-958d-f3fa27979869",
                                        "entry_id": "98d01fc1-a33b-394d-9dda-149ff0b5e7f8",
                                        "glosses": [
                                            "Femme qui tape à la machine, qui écrit à la machine à écrire ou à l’ordinateur."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e09b4d17-1f67-33cf-a33a-911c69ceac5b",
                                        "entry_id": "98d01fc1-a33b-394d-9dda-149ff0b5e7f8",
                                        "glosses": [
                                            "Pianiste qui accompagne des danseurs ou des chanteurs. Répétitrice."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013e8730-dec2-4000-acd7-817ca24cf1c8",
                                                "sense_id": "e09b4d17-1f67-33cf-a33a-911c69ceac5b",
                                                "text": "Elle força même Edmond à prendre des leçons de tango. Chez un professeur argentin, pas loin de la Madeleine. … La tapeuse jouait éternellement le Tango du Pendu …."
                                            }
                                        ]
                                    }
                                ]
                            }
