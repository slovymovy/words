                "senses": [
                    {
                        "sense_id": "32dac19b-5e8a-3e32-93d6-0e37532aa0ef",
                        "entry_id": "6388fdd4-78cd-37a2-b031-c9fa06e58394",
                        "glosses": [
                            "Publikationen (der Presse), klassischerweise Zeitungen und Zeitschriften, die sich auf ein bestimmtes Fachgebiet spezialisiert haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e9c021b-3d60-445d-917f-f7e37f576ce0",
                                "sense_id": "32dac19b-5e8a-3e32-93d6-0e37532aa0ef",
                                "text": "Die Fachpresse hatte 1994 einen Anteil von knapp 40% am gesamten Zeitschriftenbestand und war damit die größte Zeitschriftengruppe in der Pressestatistik."
                            },
                            {
                                "example_id": "838c32cc-5675-4d88-a5b3-d8147abf83ef",
                                "sense_id": "32dac19b-5e8a-3e32-93d6-0e37532aa0ef",
                                "text": "Niedergelassene Allgemeinärzte, Praktiker und Internisten greifen nach wie vor gerne zur medizinischen Fachpresse, wenn sie sich informieren wollen."
                            },
                            {
                                "example_id": "bef4e1fb-c60e-482e-a556-431f5a4d681d",
                                "sense_id": "32dac19b-5e8a-3e32-93d6-0e37532aa0ef",
                                "text": "„Wenngleich die Empfehlung des BfArM auf den ersten Blick nachvollziehbar erscheint, wird sie in der Fachpresse kontrovers diskutiert.“"
                            },
                            {
                                "example_id": "3753547e-2abd-4b88-a7ee-894ef4e46ca9",
                                "sense_id": "32dac19b-5e8a-3e32-93d6-0e37532aa0ef",
                                "text": "„Beſchämend mußten wir zugeſtehen, daß die Millionenſtadt Berlin die ſchlechteſte Fachpreſſe beſitzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
