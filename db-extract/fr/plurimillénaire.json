                "senses": [
                    {
                        "sense_id": "74e5ba70-4de9-340a-b1d7-3add27b2a0cc",
                        "entry_id": "fb48448a-3876-30ae-8757-e57adb3a60dc",
                        "glosses": [
                            "De plusieurs milliers d’années."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8df5ac2-dac5-4afc-bd89-3df6a5f61930",
                                "sense_id": "74e5ba70-4de9-340a-b1d7-3add27b2a0cc",
                                "text": "Dans ce cas aussi l’action anthropique plurimillénaire ne permet pas une distinction sûre des syntypes ; on remarque surtout le mélange d’éléments némoraux avec d’autres qui sont caractéristiques de prés et de pâturages."
                            },
                            {
                                "example_id": "e883cf57-0175-492f-90ac-23ac1bb38585",
                                "sense_id": "74e5ba70-4de9-340a-b1d7-3add27b2a0cc",
                                "text": "Les Chinois n’admettent pas […] que l’on traite sans égards leur pays fort d’une civilisation plurimillénaire et, depuis peu, d’une croissance hors norme."
                            },
                            {
                                "example_id": "d9cf67a8-8f52-467e-a148-3868ab977500",
                                "sense_id": "74e5ba70-4de9-340a-b1d7-3add27b2a0cc",
                                "text": "Les peuples premiers de l’Arctique, héritiers d’une histoire plurimillénaire de chasseurs qui ont survécu dans un désert de glace et de pierre, ont développé une sagesse qui unit la culture et la nature au sein d’une dialectique complexe."
                            }
                        ]
                    }
