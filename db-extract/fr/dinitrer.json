                "senses": [
                    {
                        "sense_id": "67e6e4d9-8495-3196-a0f3-ab223b1d3ace",
                        "entry_id": "b9284934-9165-373c-bed5-061a7aaa3d1e",
                        "glosses": [
                            "Transformer un composé chimique pour y faire apparaître un double groupement (NO₂) : (NO₂)₂"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "672070cb-351f-4f18-af1f-3944c437eaea",
                                "sense_id": "67e6e4d9-8495-3196-a0f3-ab223b1d3ace",
                                "text": "Pour dinitrer la trichlorobenzine ou nitrer une fois de plus la nitrotrichlorobenzine, il faut employer, chaud, le mélange mélange SO₄H₂ + AO₃H fumant : la dinitrotrichlorobenzine, dont l'auteur donne la description, est en cristaux d'un jaune clair, et fournit par réduction la nitrotrichloraniline, base salifiable."
                            },
                            {
                                "example_id": "a91df1f6-dac0-4fa9-8973-5bba55f85880",
                                "sense_id": "67e6e4d9-8495-3196-a0f3-ab223b1d3ace",
                                "text": "J'avais produit un bon litre à 80% pour dinitrer le benzène et faire du méta diaminobenzène, j'avais un solide jaune au final qui après purification ne me posait pas de problèmes lors du test du Pt de fusion et en IR."
                            }
                        ]
                    }
