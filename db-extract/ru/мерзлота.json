                    {
                        "translation_id": "49dcbe85-13bd-40be-a80e-a7af9cbab01e",
                        "source_entry_id": "42196c11-a170-3975-82e6-4603be492bcb",
                        "source_sense_id": "50016159-c9d4-3934-88e0-f3fda6bb8ed3",
                        "target_lang_word": "frost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b8124f1-9c0d-3bd9-8322-884b86d5086d",
                                        "entry_id": "aeebd6e4-9dd8-3e83-9d7b-eb837b403f83",
                                        "glosses": [
                                            "A cover of minute ice crystals on objects that are exposed to the air. Frost is formed by the same process as dew, except that the temperature of the frosted object is below freezing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd772162-2fd6-37c9-8017-99964e5e1902",
                                        "entry_id": "aeebd6e4-9dd8-3e83-9d7b-eb837b403f83",
                                        "glosses": [
                                            "The cold weather that causes these ice crystals to form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b02254fe-9338-49c7-8595-f182da72cd28",
                                                "sense_id": "fd772162-2fd6-37c9-8017-99964e5e1902",
                                                "text": "Thus I was; in the day the drought consumed me, and the frost by night; and my sleep departed from mine eyes."
                                            },
                                            {
                                                "example_id": "292ad325-881f-4496-9c2d-5b7744f654f9",
                                                "sense_id": "fd772162-2fd6-37c9-8017-99964e5e1902",
                                                "text": "It is more probable, in almost every country of Europe, that there will be frost sometime in January, than that the weather will continue open throughout that whole month;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e4b810d-39d7-3b41-a1a5-c10d5acb2e5d",
                                        "entry_id": "aeebd6e4-9dd8-3e83-9d7b-eb837b403f83",
                                        "glosses": [
                                            "Coldness or insensibility; severity or rigidity of character."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59effcc1-1098-45a7-838f-6f41947f7d5b",
                                                "sense_id": "7e4b810d-39d7-3b41-a1a5-c10d5acb2e5d",
                                                "text": "It was one of those moments of intense feeling when the frost of the Scottish people melts like a snow-wreath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3e2f9cf-0efe-3479-9bfd-de16f5ca819f",
                                        "entry_id": "aeebd6e4-9dd8-3e83-9d7b-eb837b403f83",
                                        "glosses": [
                                            "The act of freezing; the congelation of water or other liquid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b350e54e-b642-32a0-b07f-6cd17f3182c2",
                                        "entry_id": "aeebd6e4-9dd8-3e83-9d7b-eb837b403f83",
                                        "glosses": [
                                            "A shade of white, like that of frost."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aad7834d-57c6-34d1-8314-cb2efc4112a1",
                                        "entry_id": "aeebd6e4-9dd8-3e83-9d7b-eb837b403f83",
                                        "glosses": [
                                            "A disappointment; a cheat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "383619ce-0ee0-3bc9-8366-baa1180cd63d",
                                        "entry_id": "aeebd6e4-9dd8-3e83-9d7b-eb837b403f83",
                                        "glosses": [
                                            "A kind of light diffuser."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06ee20f4-372c-4150-9905-675ee7ccb168",
                                                "sense_id": "383619ce-0ee0-3bc9-8366-baa1180cd63d",
                                                "text": "Frosts and diffusion are flame retardant and produce similar results except that some of the frosts are very subtle in their effects. For example: Hamburg Frost will soften the beam edge with little additional spread of the beam."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
