                "senses": [
                    {
                        "sense_id": "44c68fee-aa1c-338f-a27b-dfeb17dff792",
                        "entry_id": "cac7ca48-b319-3506-a460-eff86808258e",
                        "glosses": [
                            "Unterricht über einen bestimmten Zeitraum, der dem Aufbau oder der Verbesserung der Tanzkenntnisse der Kursteilnehmer dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24664b7c-4060-405e-8922-f79057ae7bf0",
                                "sense_id": "44c68fee-aa1c-338f-a27b-dfeb17dff792",
                                "text": "„Michael Hauser, 47, brachte das größte Opfer, das ein Mann seiner Frau nur bringen kann: Er belegte einen Tanzkurs.“"
                            },
                            {
                                "example_id": "aef97e5e-7c59-4539-a295-7f6193dc40cc",
                                "sense_id": "44c68fee-aa1c-338f-a27b-dfeb17dff792",
                                "text": "„Mit fünfzehn, sagt die Hilde, habe ich einen kostenlosen Tanzkurs in der evangelischen Kirche mitgemacht, wo ich auch zum Konfirmandenunterricht und zur Jugendstunde gegangen bin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
