                {
                    "sense_id": "608bb17d-b40e-3abc-81ec-c67fc6e8080e",
                    "sense_definition": "Zeer heet en drukkend van temperatuur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temperatuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is vandaag <w>snikheet</w> buiten in de volle zon.",
                            "target_lang_translations": {
                                "ru": "Сегодня на улице под палящим солнцем <w>невыносимо жарко</w>.",
                                "fr": "Il fait une chaleur <w>étouffante</w> aujourd'hui dehors en plein soleil."
                            }
                        },
                        {
                            "text": "We bleven binnen omdat het <w>snikheet</w> was op het strand.",
                            "target_lang_translations": {
                                "ru": "Мы остались дома, потому что на пляже было <w>знойно</w>.",
                                "fr": "Nous sommes restés à l'intérieur parce qu'il faisait une chaleur <w>torride</w> sur la plage."
                            }
                        }
                    ],
                    "synonyms": [
                        "stikheet",
                        "loeiheet",
                        "gloeiheet",
                        "smoorheet"
                    ],
                    "common_phrases": [
                        "snikhete dag",
                        "snikhete zomer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень жаркая и душная погода.",
                        "fr": "Extrêmement chaud et étouffant ou lourd en parlant de la température."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знойный",
                                "target_lang_sense_clarification": "очень жаркий, часто с тяжелым, душным воздухом"
                            },
                            {
                                "target_lang_word": "невыносимо жаркий",
                                "target_lang_sense_clarification": "о погоде, которую трудно переносить из-за высокой температуры"
                            },
                            {
                                "target_lang_word": "палящий",
                                "target_lang_sense_clarification": "очень жаркий, обжигающий"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "caniculaire",
                                "target_lang_sense_clarification": "d'une chaleur extrême et persistante"
                            },
                            {
                                "target_lang_word": "étouffant",
                                "target_lang_sense_clarification": "très chaud et difficile à respirer"
                            },
                            {
                                "target_lang_word": "torride",
                                "target_lang_sense_clarification": "d'une chaleur brûlante"
                            },
                            {
