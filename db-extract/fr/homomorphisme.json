                                        "entry_id": "d21b0e89-f7c7-3e31-b69d-886acd393b78",
                                        "glosses": [
                                            "eine spezielle Abbildung einer algebraischen Ordnung in oder auf eine andere algebraische Ordnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3696ec9-d6de-400a-b40f-0b22f4bdf042",
                                                "sense_id": "236fd0e0-aa4b-3d3f-8d4e-76686010e63e",
                                                "text": "„Es ist leicht nachzurechnen, daß die Nacheinanderanwendung von Homomorphismen (Isomorphismen) wieder ein Homomorphismus (Isomorphismus) ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
