                        "sense_id": "9c4ca7cd-8142-3600-b5a5-8b77b3d8d2d2",
                        "entry_id": "543fbd50-4dcb-3f3f-84af-515c24700bb0",
                        "glosses": [
                            "winkel die vlees in grote porties goedkoop aanbiedt #product dat zo goedkoop wordt aangeboden dat men wel mag aannemen dat het het niet milieu- of mensvriendelijk is geproduceerd"
                        ],
                        "tags": [],
