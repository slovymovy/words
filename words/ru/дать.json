{
    "word_family": [
        "давать",
        "дача",
        "дарение",
        "даритель",
        "даровой",
        "дательный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0aecb356-58a8-3e89-a2d4-b862a6ba6076",
                    "sense_definition": "переместить что-либо в руки или распоряжение кого-либо",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, <w>дай</w> мне эту книгу.",
                            "target_lang_translations": {
                                "pl": "Proszę, <w>daj</w> mi tę książkę.",
                                "fr": "S'il te plaît, <w>donne</w>-moi ce livre."
                            }
                        },
                        {
                            "text": "Он <w>дал</w> ей ключи от квартиры.",
                            "target_lang_translations": {
                                "pl": "On <w>dał</w> jej klucze do mieszkania.",
                                "fr": "Il lui a <w>donné</w> les clés de l'appartement."
                            }
                        }
                    ],
                    "synonyms": [
                        "предоставить"
                    ],
                    "antonyms": [
                        "взять",
                        "получить"
                    ],
                    "common_phrases": [
                        "дать руку",
                        "дать денег"
                    ],
                    "target_lang_definitions": {
                        "pl": "wręczyć, przekazać coś do rąk lub do dyspozycji kogoś",
                        "fr": "Remettre ou transmettre quelque chose entre les mains ou à la disposition de quelqu'un."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dać",
                                "target_lang_sense_clarification": "przekazać, wręczyć coś komuś"
                            },
                            {
                                "target_lang_word": "podać",
                                "target_lang_sense_clarification": "podać coś do ręki"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "donner",
                                "target_lang_sense_clarification": "mettre en main ou à disposition de quelqu'un"
                            },
                            {
                                "target_lang_word": "passer",
                                "target_lang_sense_clarification": "tendre un objet de la main à la main"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e7773c6-ecf8-3317-9736-936bdaf17639",
                    "sense_definition": "разрешать, не препятствовать совершению действия",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама не <w>дала</w> мне пойти гулять вечером.",
                            "target_lang_translations": {
                                "pl": "Mama nie <w>pozwoliła</w> mi pójść na spacer wieczorem.",
                                "fr": "Maman ne m'a pas <w>laissé</w> aller me promener ce soir."
                            }
                        },
                        {
                            "text": "Шум не <w>дал</w> ему спокойно уснуть.",
                            "target_lang_translations": {
                                "pl": "Hałas nie <w>dał</w> mu spokojnie zasnąć.",
                                "fr": "Le bruit ne lui a pas <w>permis</w> de s'endormir tranquillement."
                            }
                        }
                    ],
                    "synonyms": [
                        "позволить",
                        "разрешить"
                    ],
                    "common_phrases": [
                        "дать возможность",
                        "дать закончить"
                    ],
                    "target_lang_definitions": {
                        "pl": "pozwolić, umożliwić zrobienie czegoś, nie stawiać przeszkód",
                        "fr": "Autoriser ou rendre possible une action, ne pas y faire obstacle."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dać",
                                "target_lang_sense_clarification": "pozwolić, umożliwić (np. dać pospać)"
                            },
                            {
                                "target_lang_word": "pozwolić",
                                "target_lang_sense_clarification": "zezwolić na coś"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "laisser",
                                "target_lang_sense_clarification": "ne pas empêcher de faire quelque chose"
                            },
                            {
                                "target_lang_word": "permettre",
                                "target_lang_sense_clarification": "accorder l'autorisation ou la possibilité"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca5dc069-fb67-319f-a892-4214546570c6",
                    "sense_definition": "оценить чей-либо возраст по внешнему виду",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "estimation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На вид ему можно <w>дать</w> не больше тридцати лет.",
                            "target_lang_translations": {
                                "pl": "Z wyglądu można mu <w>dać</w> nie więcej niż trzydzieści lat.",
                                "fr": "À vue de nez, on ne lui <w>donnerait</w> pas plus de trente ans."
                            }
                        },
                        {
                            "text": "Сколько лет ты <w>дашь</w> этой женщине?",
                            "target_lang_translations": {
                                "pl": "Ile lat <w>dałbyś</w> tej kobiecie?",
                                "fr": "Quel âge <w>donnes</w>-tu à cette femme ?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "ocenić czyjś wiek na podstawie wyglądu",
                        "fr": "Attribuer un âge à quelqu'un d'après son apparence physique."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dać",
                                "target_lang_sense_clarification": "ocenić wiek na tyle lat"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "donner",
                                "target_lang_sense_clarification": "estimer l'âge de quelqu'un"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b47fe24b-8169-38c4-ac6b-6346922141cd",
                    "sense_definition": "ударить, нанести физический удар",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хулиган хотел <w>дать</w> ему по лицу.",
                            "target_lang_translations": {
                                "pl": "Chuligan chciał mu <w>dać</w> w twarz.",
                                "fr": "Le voyou voulait lui <w>en mettre</w> une en plein visage."
                            }
                        },
                        {
                            "text": "Если ещё раз толкнёшь меня, я тебе так <w>дам</w>, что мало не покажется.",
                            "target_lang_translations": {
                                "pl": "Jeśli jeszcze raz mnie popchniesz, tak ci <w>dam</w>, że popamiętasz.",
                                "fr": "Si tu me pousses encore une fois, je vais t'en <w>coller</w> une dont tu te souviendras."
                            }
                        }
                    ],
                    "synonyms": [
                        "ударить"
                    ],
                    "common_phrases": [
                        "дать по морде",
                        "дать подзатыльник"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "uderzyć kogoś, wymierzyć cios",
                        "fr": "Frapper quelqu'un, asséner un coup physique."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dać",
                                "target_lang_sense_clarification": "uderzyć, wymierzyć cios (potocznie)"
                            },
                            {
                                "target_lang_word": "przywalić",
                                "target_lang_sense_clarification": "mocno uderzyć (potocznie)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "donner",
                                "target_lang_sense_clarification": "asséner un coup (fam.)"
                            },
                            {
                                "target_lang_word": "mettre",
                                "target_lang_sense_clarification": "frapper, assener (ex. mettre une claque)"
                            },
                            {
                                "target_lang_word": "foutre",
                                "target_lang_sense_clarification": "assener un coup (très familier)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35961254-0763-3ef1-939d-c2752a8dc305",
                    "sense_definition": "согласиться на половой акт",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sex",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она не <w>дала</w> ему на первом свидании.",
                            "target_lang_translations": {
                                "pl": "Nie <w>dała</w> mu na pierwszej randce.",
                                "fr": "Elle n'a pas voulu <w>coucher</w> avec lui au premier rendez-vous."
                            }
                        },
                        {
                            "text": "Он хвастался, что она ему <w>дала</w>.",
                            "target_lang_translations": {
                                "pl": "Chwalił się, że mu <w>dała</w>.",
                                "fr": "Il se vantait qu'elle lui ait <w>cédé</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "вульгарный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "zgodzić się na odbycie stosunku seksualnego (wulgarnie/potocznie)",
                        "fr": "Accepter d'avoir des rapports sexuels avec quelqu'un."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dać",
                                "target_lang_sense_clarification": "zgodzić się na seks (potocznie/wulgarnie)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "se donner",
                                "target_lang_sense_clarification": "consentir à des rapports intimes"
                            },
                            {
                                "target_lang_word": "coucher",
                                "target_lang_sense_clarification": "avoir des relations sexuelles"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}