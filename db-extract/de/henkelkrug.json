                                        "sense_id": "fad16d85-883c-385b-8ac7-ae1e7a5565bc",
                                        "entry_id": "30e2cfad-ea10-3d9d-aa0d-49a7adaa68ce",
                                        "glosses": [
                                            "To utter a sound like \\\"jug\\\", as certain birds do, especially the nightingale."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41f9b16e-69e2-4f44-b884-f9e2087052cd",
                                                "sense_id": "fad16d85-883c-385b-8ac7-ae1e7a5565bc",
                                                "text": "Down in the orchard a nightingale jug-jugged, as if he, too, had dropped into a soft billet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95a8fc5-7c75-3c7d-a3ff-addf08884c6b",
                                        "entry_id": "30e2cfad-ea10-3d9d-aa0d-49a7adaa68ce",
