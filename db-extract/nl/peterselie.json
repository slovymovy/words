                    {
                        "translation_id": "a32d75b9-9f1f-461e-bd59-adeb2826cf4c",
                        "source_entry_id": "8d70e6e5-3e4c-37e5-97e9-d54d5a9eba2f",
                        "source_sense_id": "e47ec67f-c085-3c7b-9905-43d6e9f396e4",
                        "source_sense_description": "kruid",
                        "target_lang_word": "persil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
