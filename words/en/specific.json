                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>specific</w> name of the domestic cat is Felis catus.",
                            "target_lang_translations": {
                                "ru": "<w>Видовое</w> название домашней кошки — Felis catus."
                            }
                        },
                        {
                            "text": "Scientists are looking for <w>specific</w> traits that distinguish these two birds.",
                            "target_lang_translations": {
                                "ru": "Ученые ищут <w>видовые</w> признаки, которые отличают этих двух птиц."
                            }
                        }
                    ],
                    "synonyms": [
                        "proper"
                    ],
                    "antonyms": [
                        "generic"
                    ],
                    "common_phrases": [
                        "specific name"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
