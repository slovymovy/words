                "senses": [
                    {
                        "sense_id": "ba701663-b53e-3fd3-8111-1d7f2fb6ba78",
                        "entry_id": "4d30a6f4-f963-3627-8d53-dc5bca13cf76",
                        "glosses": [
                            "im Gebirge befindliche Hütte; landwirtschaftliches Gebäude auf einer Alm"
                        ],
                        "tags": [
                            "Architektur, schweizerisch"
                        ],
                        "examples": [
                            {
                                "example_id": "a4eb66a5-4c25-497a-a1f1-cc8913089d38",
                                "sense_id": "ba701663-b53e-3fd3-8111-1d7f2fb6ba78",
                                "text": "Über dem Chalet hing dichter Nebel."
                            },
                            {
                                "example_id": "945d7177-9c9a-4561-bc8c-66bbc1e1b8f6",
                                "sense_id": "ba701663-b53e-3fd3-8111-1d7f2fb6ba78",
                                "text": "Das Chalet lag verborgen in einem dichten Nebel."
                            },
                            {
                                "example_id": "fdc14f8e-cdec-4901-b869-f90a52877489",
                                "sense_id": "ba701663-b53e-3fd3-8111-1d7f2fb6ba78",
                                "text": "Das Chalet war von dichtem Nebel umhüllt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f9f671f7-2713-3f3c-bfe4-652ba84617fb",
                        "entry_id": "4d30a6f4-f963-3627-8d53-dc5bca13cf76",
                        "glosses": [
                            "meist aus Holz gebautes (einfaches) Ferienhaus, Landhaus, Ferienwohnung"
                        ],
                        "tags": [
                            "Architektur, schweizerisch"
                        ],
                        "examples": [
                            {
                                "example_id": "c3de083c-be6c-4d07-9799-6aa6d3fdb2ce",
                                "sense_id": "f9f671f7-2713-3f3c-bfe4-652ba84617fb",
                                "text": "Der Arbeitskollege hat ein Chalet im Kanton Waadt, wo er oft Urlaub macht."
                            },
                            {
                                "example_id": "063c28c3-6347-41b4-bb8e-136405aefca1",
                                "sense_id": "f9f671f7-2713-3f3c-bfe4-652ba84617fb",
                                "text": "„Der idyllische Winterurlaub in einer Hütte ist im Lockdown nicht erlaubt. Trotzdem werden Ferienwohnungen, Apartments und Chalets in Österreich angeboten.“"
                            },
                            {
                                "example_id": "b16a6352-ab2f-4a1f-bff1-d46dbd0719d3",
                                "sense_id": "f9f671f7-2713-3f3c-bfe4-652ba84617fb",
                                "text": "„Sie prägen das Ortsbild in Rohr, zum Teil seit genau 100 Jahren. Das Chalet Baglivo oder das Chalet Senn daneben, an der Hauptrasse im Aargauer Stadtteil Rohr.“"
                            },
                            {
                                "example_id": "67431eda-5454-44f6-931c-00836eb4cd29",
                                "sense_id": "f9f671f7-2713-3f3c-bfe4-652ba84617fb",
                                "text": "[…] „alles [hatte] so gut angefangen: Auf der Webseite von Airbnb hat sie ein Chalet entdeckt, in dem sie mit ihren Söhnen den Winterurlaub verbringen wollte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e27ae5f-fb57-43d0-aecf-97a28fd5f2bf",
                        "source_entry_id": "4d30a6f4-f963-3627-8d53-dc5bca13cf76",
                        "source_sense_id": "ba701663-b53e-3fd3-8111-1d7f2fb6ba78",
                        "source_sense_description": "im Gebirge befindliche Hütte; landwirtschaftliches Gebäude auf einer Alm",
                        "target_lang_word": "chalet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chalet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a99d38de-f892-3fe2-a6a3-4c878bd46be0",
                                        "entry_id": "67d1740e-77bd-385d-a495-9331c6a6a0aa",
                                        "glosses": [
                                            "An alpine style of wooden building with a sloping roof and overhanging eaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9299ccdf-587b-4768-94a5-c55ca32746e7",
                                                "sense_id": "a99d38de-f892-3fe2-a6a3-4c878bd46be0",
                                                "text": "Toward the end of the war, Benoit was sent off on his own with forged papers; he wound up working as a horse groom at a chalet in the Loire valley. Mandelbrot describes this harrowing youth with great sangfroid."
                                            },
                                            {
                                                "example_id": "14a73a3c-15bd-4fa9-a1b7-3af6ab3b74d5",
                                                "sense_id": "a99d38de-f892-3fe2-a6a3-4c878bd46be0",
                                                "text": "“I know that Perdita spends the offseason at her chalet in Gstaad, and that her mansion would be empty. And the perfect place to teach you all a valuable lesson about the importance of being nice to people who maybe aren't part of your core group but who have done a lot of nice things for you and yet you still treat them like shit.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b2ead2a-38c3-3226-bd0b-e09a6e3149f9",
                                        "entry_id": "67d1740e-77bd-385d-a495-9331c6a6a0aa",
                                        "glosses": [
                                            "A recreational lodge or small house within the grounds of a resort or country club dedicated to the uniformed services, used for events, staycations and other social gatherings."
                                        ],
                                        "tags": [
                                            "Singapore"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "182583fb-ac09-49d6-b809-bd7d83906f40",
                        "source_entry_id": "4d30a6f4-f963-3627-8d53-dc5bca13cf76",
                        "source_sense_id": "ba701663-b53e-3fd3-8111-1d7f2fb6ba78",
                        "source_sense_description": "im Gebirge befindliche Hütte; landwirtschaftliches Gebäude auf einer Alm",
                        "target_lang_word": "chalet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chalet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d56c114-aca2-37b2-a308-82f4d965b73f",
                                        "entry_id": "30d045cb-4728-3f38-a843-eccc90af9874",
                                        "glosses": [
                                            "Cabane sur l’alpage, où s’abritent les bergers pendant l’été et où ils font les fromages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e320fdd-ebb3-4b20-9701-eef4e4a7e899",
                                                "sense_id": "4d56c114-aca2-37b2-a308-82f4d965b73f",
                                                "text": "Autour de l’habitation principale dont M. d’Orbe dispose, sont épars assez loin quelques chalets, qui de leurs toits de chaume peuvent couvrir l’amour et le plaisir, amis de la simplicité rustique. Les fraîches et discrètes laitières savent garder pour autrui le secret dont elles ont besoin pour elles-mêmes."
                                            },
                                            {
                                                "example_id": "e54433c8-2085-4474-b2ae-ea35aeaa63f8",
                                                "sense_id": "4d56c114-aca2-37b2-a308-82f4d965b73f",
                                                "text": "J’étais seul [lors d’un voyage dans les Alpes] ; je voyageais à pied dans ces montagnes. Je m’arrêtai dans un chalet, et j’y passai trois jours dans une famille de bergers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c69dea8-2d6c-3beb-afb7-cb13091c2dfd",
                                        "entry_id": "30d045cb-4728-3f38-a843-eccc90af9874",
                                        "glosses": [
                                            "Cabane sur l’alpage, où s’abritent les bergers pendant l’été et où ils font les fromages.",
                                            "Cabane, cabinet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "723257fb-7788-380a-9d41-788a54415309",
                                        "entry_id": "30d045cb-4728-3f38-a843-eccc90af9874",
                                        "glosses": [
                                            "Maison de campagne, maison de plaisance de style rustique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4719162e-8635-4910-8936-9b5cffc03f85",
                                                "sense_id": "723257fb-7788-380a-9d41-788a54415309",
                                                "text": "Un chalet normand."
                                            },
                                            {
                                                "example_id": "db2347ea-b993-44d4-90fd-98c563be3460",
                                                "sense_id": "723257fb-7788-380a-9d41-788a54415309",
                                                "text": "Dans ce castel humble et drôlet,\nElle brode, lit et fricasse.\nQu’elle aime ce petit chalet !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27e959b0-1e83-3ca6-b746-38dcabc37220",
                                        "entry_id": "30d045cb-4728-3f38-a843-eccc90af9874",
                                        "glosses": [
                                            "Lampe suspendue au plafond."
                                        ],
                                        "tags": [
                                            "Auvergne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feadd1f7-24a5-4573-8939-282cce99fbbe",
                                                "sense_id": "27e959b0-1e83-3ca6-b746-38dcabc37220",
                                                "text": "On soupe à la lueur du chalet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
