                                "target_senses": [
                                    {
                                        "sense_id": "cdc6d036-5591-38fc-9665-51a8ab541dc4",
                                        "entry_id": "66e4c2bd-8632-3209-a6eb-5f3e25632109",
                                        "glosses": [
                                            "alle zwei Jahre stattfindende Ausstellung oder Schau (besonders bildende Kunst und Film)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e7b3461-7d7c-40b0-a9ce-eff94b5d2471",
                                                "sense_id": "cdc6d036-5591-38fc-9665-51a8ab541dc4",
                                                "text": "Zur diesjährigen Biennale werden wieder einige Prominente aus aller Welt erwartet."
                                            },
                                            {
                                                "example_id": "74dc79dd-300a-40a3-bf1e-41dbe64684c5",
                                                "sense_id": "cdc6d036-5591-38fc-9665-51a8ab541dc4",
                                                "text": "„Die Geschichte von der Maus mit den roten Strümpfen stand auf der Auswahlliste zum Deutschen Jugendliteraturpreis und wurde mit der Goldenen Plakette der Biennale der Illustratoren 1979 in Bratislava ausgezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
