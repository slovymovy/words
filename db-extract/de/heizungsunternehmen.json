                "senses": [
                    {
                        "sense_id": "bb2fb2a7-e7cf-302c-8e30-2b6f187c4b81",
                        "entry_id": "7d015d8f-c524-3fac-99f4-5a7893ac1f3a",
                        "glosses": [
                            "Firma, die im Bereich der Heiztechnik tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32675322-a741-4d18-89e5-74c089319d3c",
                                "sense_id": "bb2fb2a7-e7cf-302c-8e30-2b6f187c4b81",
                                "text": "„Er absolvierte eine Klempnerausbildung und stieg dann ins elterliche Heizungsunternehmen ein.“"
                            },
                            {
                                "example_id": "27e0b617-aeba-4367-a7b2-617e51d46a77",
                                "sense_id": "bb2fb2a7-e7cf-302c-8e30-2b6f187c4b81",
                                "text": "„Das Heizungsunternehmen setzte eine Arbeitszeitverlängerung von wöchentlich drei Stunden durch, ohne einen entsprechenden Lohnausgleich zu zahlen.“"
                            },
                            {
                                "example_id": "8db01c88-30ea-4b30-9968-d9ac04154e9f",
                                "sense_id": "bb2fb2a7-e7cf-302c-8e30-2b6f187c4b81",
                                "text": "„Er konnte gerade noch sagen, das es ein Heizungsunternehmen war, das gerne am Bau beteiligt werden würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
