                    },
                    {
                        "translation_id": "748c4582-a5d5-418a-b372-31f874d8584e",
                        "source_entry_id": "f5832900-69dc-3c27-a3ca-b94dc02f8d09",
                        "source_sense_id": "263a7d13-be88-317d-9e64-43d2d4d26512",
                        "target_lang_word": "spretato",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "37b34051-e113-4112-a8ea-e081207c1e55",
                        "source_entry_id": "f5832900-69dc-3c27-a3ca-b94dc02f8d09",
                        "source_sense_id": "263a7d13-be88-317d-9e64-43d2d4d26512",
                        "target_lang_word": "défroqué",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défroqué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97680edd-c26b-3635-8685-cd81d73e707a",
                                        "entry_id": "a6e23e89-28e6-3a4d-9a25-41febd5b8b9b",
                                        "glosses": [
                                            "Qui a quitté ou qui veut quitter l’état monastique ou l’état ecclésiastique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "899f0096-3dcc-4dde-b5fd-d99d9bcc56eb",
                                                "sense_id": "97680edd-c26b-3635-8685-cd81d73e707a",
                                                "text": "Et c’est ainsi qu’il se retrouva, prêtre défroqué, à marcher avec les autres, dans cet interminable défilé qui s’étirait sur plus de deux milles, au milieu des grappes de moutons bêlant, des poneys traînant des travois chargés de peaux, de sacs de graines, ou des vieillards trop faibles pour refaire le chemin du retour."
                                            },
                                            {
                                                "example_id": "0aa0fd27-fbe0-46fa-b912-2b52d0e3eed7",
                                                "sense_id": "97680edd-c26b-3635-8685-cd81d73e707a",
                                                "text": "Malgré de sensibles défauts, malgré l’humilité de son origine, ce fils de paysans et de pauvres marins, couvert du triple ridicule d’échappé de séminaire, de clerc défroqué, de cuistre endurci, on l’a tout d’abord accueilli, écouté, choyé même, uniquement parce qu’on trouvait dans sa voix des accents sincères."
                                            },
                                            {
                                                "example_id": "2adb2522-eb42-4add-aea1-434c47b85cf0",
                                                "sense_id": "97680edd-c26b-3635-8685-cd81d73e707a",
                                                "text": "Son maître l'envoyait de temps à autre faire une commission dans la petite boutique, obscure et sale, d'un prêteur à gages, qui était un ecclésiastique défroqué."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "défroqué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b839dc96-d1e7-3935-9848-f20595b6039a",
                                        "entry_id": "196c4218-3dcc-36b1-85f5-23c1f49f34cb",
                                        "glosses": [
                                            "Personne qui a quitté l’état religieux."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c24d91e-08bd-4724-b2d7-59a29354e8f4",
                                                "sense_id": "b839dc96-d1e7-3935-9848-f20595b6039a",
                                                "text": "« C’est le châtiment des défroqués, pensa-t-il. Le prêtre, qui subsiste en eux, se laisse voir. Tu es sacerdos in æternum, Guitrel. »"
                                            },
                                            {
                                                "example_id": "b6430ac1-3902-4bb5-bba6-8d39b9ca6152",
                                                "sense_id": "b839dc96-d1e7-3935-9848-f20595b6039a",
                                                "text": "Puisque théoriquement un moine pouvait quitter les ordres, d’autres considérations l’incitaient à demeurer moine. Les défroqués obtenaient peu de sympathie de la population et même de leur famille ; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "défroqué",
                                "target_lang_code": "fr",
                                "target_senses": [
