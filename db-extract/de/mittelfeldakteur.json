                                "target_senses": [
                                    {
                                        "sense_id": "0a332452-230a-3d64-9fd2-d252b7ebfed5",
                                        "entry_id": "ce44a6d9-f98e-338a-908b-7aa9144f4ab4",
                                        "glosses": [
                                            "Joueur ou joueuse dont le rôle est de réaliser la liaison entre la défense et l'attaque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "590bfaaf-159b-4533-9696-1f7c0ab6e023",
                                                "sense_id": "0a332452-230a-3d64-9fd2-d252b7ebfed5",
                                                "text": "Griedge Mbock, à côté d’elle, est très jeune, les milieux de terrain sont toujours très jeunes."
                                            },
                                            {
                                                "example_id": "d70aee1c-35c0-463b-bac4-d212a0c9f45a",
                                                "sense_id": "0a332452-230a-3d64-9fd2-d252b7ebfed5",
                                                "text": "Ainsi, Oriane Jean-François, la prometteuse milieu de terrain du PSG, la gardienne Mylène Chavas et la défenseure Aïssatou Tounkara ont été écartées des 26 qui préparaient l’événement."
                                            },
                                            {
                                                "example_id": "b593419e-fb50-45ac-9c51-cdca822c7584",
                                                "sense_id": "0a332452-230a-3d64-9fd2-d252b7ebfed5",
                                                "text": "Curiosité d’un recrutement estival surtout tourné vers des éléments connus en Ligue 2 (Weissbeck, Livolant, Marcelin), le milieu de terrain espagnol Pedro Diaz, qui devrait à nouveau débuter ce samedi (15 heures) face à Amiens, n’a pas tremblé au moment d’enfiler le maillot des Girondins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
