{
    "word_family": [
        "patriot",
        "patriotism",
        "patriotic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f06d0701-6d1d-34ee-8c21-d2e2aa1f6b47",
                    "sense_definition": "A person who comes from the same country as another person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete was cheered on by all of his <w>compatriots</w> in the stadium.",
                            "target_lang_translations": {
                                "de": "Der Athlet wurde von all seinen <w>Landsleuten</w> im Stadion angefeuert."
                            }
                        },
                        {
                            "text": "She felt a strong connection to her <w>compatriots</w> while living abroad.",
                            "target_lang_translations": {
                                "de": "Während sie im Ausland lebte, fühlte sie eine starke Verbundenheit zu ihren <w>Landsleuten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fellow citizen",
                        "countryperson"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die aus demselben Land stammt wie eine andere Person."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Landsmann",
                                "target_lang_sense_clarification": "männliche Person aus dem gleichen Land"
                            },
                            {
                                "target_lang_word": "Landsmännin",
                                "target_lang_sense_clarification": "weibliche Person aus dem gleichen Land"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "61d634e6-f315-3325-94e6-39200bbea382",
                    "sense_definition": "Relating to or sharing the same country and national sentiment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They shared a <w>compatriot</w> spirit during the national celebration.",
                            "target_lang_translations": {
                                "de": "Sie teilten während der nationalen Feier einen <w>patriotischen</w> Geist."
                            }
                        },
                        {
                            "text": "The soldiers displayed a <w>compatriot</w> loyalty to their homeland.",
                            "target_lang_translations": {
                                "de": "Die Soldaten zeigten eine <w>patriotische</w> Loyalität gegenüber ihrer Heimat."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sich auf das gleiche Land und das nationale Zugehörigkeitsgefühl beziehend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "patriotisch",
                                "target_lang_sense_clarification": "das Vaterland betreffend oder liebend"
                            },
                            {
                                "target_lang_word": "national",
                                "target_lang_sense_clarification": "die eigene Nation betreffend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}