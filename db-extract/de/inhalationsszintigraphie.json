                ],
                "senses": [
                    {
                        "sense_id": "070b19df-e571-3b7e-bee7-b46c88194354",
                        "entry_id": "bbe3f61c-d5f4-3981-8b9c-a9e07a23955a",
                        "glosses": [
                            "bildgebendes Verfahren, bei dem der Patient radioaktiv markierte Stoffe einatmet, die sich in der Lunge ansammeln, und dann zur späteren Auswertung auf einer Aufnahme festgehalten werden"
                        ],
                        "tags": [
                            "Diagnostik"
                        ],
                        "examples": [
                            {
                                "example_id": "78371d07-c0d4-4ff5-a552-257507e33959",
                                "sense_id": "070b19df-e571-3b7e-bee7-b46c88194354",
                                "text": "„Bei sicherem Nachweise einer therapiebedürftigen Venenthrombose wurde auf eine weitere Spezifizierung des perfusionsszintigraphischen Befundes durch eine Spiral-CT Untersuchung oder eine Inhalationsszintigraphie verzichtet.“"
                            },
                            {
                                "example_id": "e278d98d-6f54-4207-a222-d9611b5b1829",
                                "sense_id": "070b19df-e571-3b7e-bee7-b46c88194354",
                                "text": "„Bei der Ventilations- beziehungsweise Inhalationsszintigraphie wird das Radiopharmakon (Aerosole, verdampfte Kohlepartikel) über die Atemluft zugeführt und seine Verteilung in der Lunge nach Einatmen szintigraphisch dokumentiert.“"
                            },
                            {
                                "example_id": "4a26aabe-fdbc-4540-8978-45eb2ab7fab0",
                                "sense_id": "070b19df-e571-3b7e-bee7-b46c88194354",
                                "text": "„Während die Perfusionsszintigraphie heute in der Regel mit ⁹⁹ᵐTechnetium-markierten Albumin-Partikeln durchgeführt wird, werden für die Ventilationsuntersuchungen entweder radioaktive Edelgase oder radioaktiv markierte Aerosole (Inhalationsszintigraphie) verwendet.“"
                            },
                            {
                                "example_id": "a8ea7b5f-e394-47e5-9c07-004a426d161d",
                                "sense_id": "070b19df-e571-3b7e-bee7-b46c88194354",
                                "text": "„Bei über 150 Pat. wurden Inhalationsszintigraphien der Lunge mit ¹³¹J- und ⁹⁹ᵐ-markierten Albuminpartikeln durchgeführt.“"
                            },
                            {
                                "example_id": "f3155833-570e-4750-82f0-00259f607b13",
                                "sense_id": "070b19df-e571-3b7e-bee7-b46c88194354",
                                "text": "„Durch neuere und strahlenhygienisch einfacher durchzuführende Verfahren, wie z. B. Inhalationsszintigraphien mit ⁹⁹Tc-markierten DTPA-Aerosolpartikeln, die in der Lunge deponiert bleiben, ist es aber inzwischen auch weniger kooperative Patienten entsprechend zu untersuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
