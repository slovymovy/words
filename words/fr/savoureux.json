                {
                    "sense_id": "ae0f4407-e4c3-3a25-ab13-0b326be19bb6",
                    "sense_definition": "Qui suscite l'intérêt, qui séduit l'esprit par son caractère piquant, drôle ou original.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conférencier a raconté une anecdote <w>savoureuse</w> qui a fait rire toute la salle.",
                            "target_lang_translations": {
                                "en": "The lecturer told a <w>witty</w> anecdote that had the whole room laughing.",
                                "ru": "Лектор рассказал <w>остроумную</w> историю, которая рассмешила весь зал.",
                                "nl": "De spreker vertelde een <w>geestige</w> anekdote die de hele zaal aan het lachen maakte.",
                                "de": "Der Redner erzählte eine <w>witzige</w> Anekdote, die den ganzen Saal zum Lachen brachte.",
                                "pl": "Prelegent opowiedział <w>dowcipną</w> anegdotę, która rozbawiła całą salę.",
                                "it": "Il conferenziere ha raccontato un aneddoto <w>spiritoso</w> che ha fatto ridere tutta la sala.",
                                "cs": "Přednášející vyprávěl <w>vtipnou</w> anekdotu, která rozesmála celý sál.",
                                "tr": "Konuşmacı, bütün salonu güldüren <w>esprili</w> bir anekdot anlattı.",
                                "es": "El conferenciante contó una anécdota <w>ocurrente</w> que hizo reír a toda la sala.",
                                "zh": "演讲者讲了一则<w>风趣</w>的轶事，逗得整个会场都笑了起来。"
                            }
                        },
                        {
                            "text": "L'écrivain dépeint ses personnages avec beaucoup d'ironie et un style très <w>savoureux</w>.",
