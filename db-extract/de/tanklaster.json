                "senses": [
                    {
                        "sense_id": "99cdba7f-013a-3ce0-b335-8e8950366b1e",
                        "entry_id": "a8acf77f-5cae-31c5-a0f7-924f846d2f4a",
                        "glosses": [
                            "Fahrzeug, das flüssige oder gasförmige Güter in einem großen (entweder auf dem Fahrgestell montierten oder auf einem Anhänger beziehungsweise Auflieger befindlichen) Behältnis transportiert"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d744556f-4fd6-4b10-bf8f-063608edfb5c",
                                "sense_id": "99cdba7f-013a-3ce0-b335-8e8950366b1e",
                                "text": "Auf dem Firmenhof stehen zwei Tanklaster, der eine hat Milch geladen und der andere hatte kürzlich Säure geladen."
                            },
                            {
                                "example_id": "5e444135-63a7-4cc6-b4da-53cdbbd068a7",
                                "sense_id": "99cdba7f-013a-3ce0-b335-8e8950366b1e",
                                "text": "Tanklaster sollten nicht mit Silolastern verwechselt werden."
                            },
                            {
                                "example_id": "38630336-836b-4b22-92aa-3d82152133df",
                                "sense_id": "99cdba7f-013a-3ce0-b335-8e8950366b1e",
                                "text": "„Der 39-jährige Fahrer eines Tanklasters hatte offenbar aufgrund eines gesundheitlichen Problems am Samstag das Bewusstsein verloren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8607225-7608-426c-bed9-f142ec87e64c",
                        "source_entry_id": "a8acf77f-5cae-31c5-a0f7-924f846d2f4a",
                        "source_sense_id": "99cdba7f-013a-3ce0-b335-8e8950366b1e",
                        "source_sense_description": "Fahrzeug, das flüssige oder gasförmige Güter in einem großen Behältnis transportiert",
                        "target_lang_word": "camion-citerne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camion-citerne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e98962bd-3c4d-3e0f-bdc6-50aac30f1f4e",
                                        "entry_id": "9dbbf9a1-9c9a-3985-9751-3ed99c0c420c",
                                        "glosses": [
                                            "Camion dont la charge est constituée d’une citerne, utilisé pour le transport de liquides, de gaz ou de pulvérulents stockés en vrac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29e8b8f8-ef4b-40e4-82fb-7ca07985061c",
                                                "sense_id": "e98962bd-3c4d-3e0f-bdc6-50aac30f1f4e",
                                                "text": "Un grondement de tonnerre derrière eux. Le camion-citerne venait de passer au ras du pare-chocs de la Suzuki qui se mit à redescendre la pente trop forte pour elle."
                                            },
                                            {
                                                "example_id": "68ca47af-1135-4bc2-8940-69189e103186",
                                                "sense_id": "e98962bd-3c4d-3e0f-bdc6-50aac30f1f4e",
                                                "text": "Rynner voudrait bien voir revenir le second camion-citerne qui est parti, voilà déjà déjà un bon moment, pour faire le plein au riachuelo voisin."
                                            },
                                            {
                                                "example_id": "1cbe9422-8c93-4a06-94f7-7eca8760304e",
                                                "sense_id": "e98962bd-3c4d-3e0f-bdc6-50aac30f1f4e",
                                                "text": "Et c'est au Maroc qu'ils entendaient se rendre, dès qu'ils pourraient faire le plein de leurs avions, ce à quoi ils étaient résolus à parvenir, dussent-ils s'emparer pour cela du camion-citerne les armes à la main."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
