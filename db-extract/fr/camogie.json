                                        "entry_id": "d1b3120c-d38d-33c8-a073-9d566e38a890",
                                        "glosses": [
                                            "A women's stick-and-ball sport from Ireland, almost identical to hurling."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7414ba0c-9cd1-4511-b1f1-699f1510c462",
                                                "sense_id": "9dcf557f-5619-3d22-a0a6-cb045fe9aec1",
                                                "text": "Camogie resembles hurling, although the field is smaller (110 meters by 68 meters), the stick, or caman, is smaller than a hurley, and the ball is also lighter than the sliothar."
                                            }
                                        ]
                                    }
                                ]
                            }
