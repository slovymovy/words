                                            "Personne polyamoureuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "166ee8f3-b824-4e45-915f-2b2ebe7f2f2b",
                                                "sense_id": "fda91ea5-c3f4-30f2-82ca-2f6e42bc71de",
                                                "text": "À partir de ces bases saines et partagées, les polyamoureux tissent des relations ouvertes, basées sur la confiance, la communication et le respect de l’autre et de son désir."
                                            }
                                        ]
                                    }
