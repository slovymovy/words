                                        "sense_id": "b7cffd04-cd36-3895-af11-11d1684f6c37",
                                        "entry_id": "381468c7-811b-3fba-96dc-8aaf51c89279",
                                        "glosses": [
                                            "разг. о молодой девушке (обычно достигшей брачного возраста)"
                                        ],
                                        "tags": [],
