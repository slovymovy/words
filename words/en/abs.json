                {
                    "sense_id": "2b023043-cb18-3be4-9cad-90e01e0bad63",
                    "sense_definition": "Antilock braking system; a safety mechanism in vehicles that prevents wheels from locking during braking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "automotive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ABS</w> light on the dashboard indicates a problem with the brakes.",
                            "target_lang_translations": {
                                "ru": "Индикатор <w>АБС</w> на приборной панели указывает на проблему с тормозами.",
                                "zh": "仪表盘上的<w>防抱死制动系统</w>指示灯亮起，说明刹车有问题。",
                                "es": "La luz del <w>ABS</w> en el tablero indica un problema con los frenos."
                            }
                        },
                        {
                            "text": "My car is equipped with <w>ABS</w> to prevent skidding on wet roads.",
                            "target_lang_translations": {
                                "ru": "Моя машина оснащена <w>АБС</w> для предотвращения заноса на мокрой дороге.",
                                "zh": "我的车配备了<w>防抱死制动系统</w>，以防止在湿滑路面上打滑。",
                                "es": "Mi coche está equipado con <w>ABS</w> para evitar derrapes en carreteras mojadas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ABS brakes",
                        "ABS system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Антиблокировочная система; механизм безопасности в транспортных средствах, предотвращающий блокировку колес при торможении.",
                        "zh": "防抱死制动系统；车辆中防止车轮在制动时抱死的安全机制。",
                        "es": "Sistema antibloqueo de frenos; mecanismo de seguridad en vehículos que evita que las ruedas se bloqueen al frenar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "АБС",
                                "target_lang_sense_clarification": "автомобильная система"
                            },
                            {
                                "target_lang_word": "антиблокировочная система",
                                "target_lang_sense_clarification": "полное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "防抱死制动系统",
                                "target_lang_sense_clarification": "汽车安全系统"
                            },
                            {
                                "target_lang_word": "ABS",
                                "target_lang_sense_clarification": "常用缩写"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ABS",
                                "target_lang_sense_clarification": "sistema de frenado"
                            },
                            {
                                "target_lang_word": "sistema antibloqueo",
                                "target_lang_sense_clarification": "término técnico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a13ff4c-b622-39b2-b544-7aaea45d9fad",
                    "sense_definition": "Acrylonitrile butadiene styrene; a type of strong, durable plastic used in plumbing and manufacturing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plumber replaced the old metal pipes with new <w>ABS</w> ones.",
                            "target_lang_translations": {
                                "ru": "Сантехник заменил старые металлические трубы на новые из <w>АБС-пластика</w>.",
                                "zh": "水管工把旧金属管换成了新的<w>ABS塑料</w>管。",
                                "es": "El fontanero reemplazó las tuberías de metal viejas por unas nuevas de <w>ABS</w>."
                            }
                        },
                        {
                            "text": "This 3D printer filament is made of <w>ABS</w> plastic.",
                            "target_lang_translations": {
                                "ru": "Эта нить для 3D-принтера сделана из <w>АБС-пластика</w>.",
                                "zh": "这种3D打印耗材是由<w>ABS塑料</w>制成的。",
                                "es": "Este filamento para impresora 3D está hecho de plástico <w>ABS</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ABS plastic",
                        "ABS pipe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акрилонитрилбутадиенстирол; тип прочного, долговечного пластика, используемого в сантехнике и производстве.",
                        "zh": "丙烯腈-丁二烯-苯乙烯共聚物；一种用于管道和制造业的坚固耐用塑料。",
                        "es": "Acrilonitrilo butadieno estireno; un tipo de plástico fuerte y duradero utilizado en fontanería y fabricación."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "АБС-пластик",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "АБС",
                                "target_lang_sense_clarification": "аббревиатура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "ABS塑料",
                                "target_lang_sense_clarification": "材料"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "plástico ABS",
                                "target_lang_sense_clarification": "material"
                            },
                            {
                                "target_lang_word": "ABS",
                                "target_lang_sense_clarification": "abreviatura del material"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01c59abd-34f5-3e1c-96d7-4d30952df393",
                    "sense_definition": "Asset-backed security; a financial investment backed by a pool of assets like loans or leases.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank issued an <w>ABS</w> to raise capital from investors.",
                            "target_lang_translations": {
                                "ru": "Банк выпустил <w>ценные бумаги, обеспеченные активами</w>, для привлечения капитала от инвесторов.",
                                "zh": "银行发行了<w>资产支持证券</w>以从投资者那里筹集资金。",
                                "es": "El banco emitió un <w>activo respaldado por valores</w> para recaudar capital de los inversores."
                            }
                        },
                        {
                            "text": "Investors should understand the risks associated with the <w>ABS</w> market.",
                            "target_lang_translations": {
                                "ru": "Инвесторы должны понимать риски, связанные с рынком <w>ценных бумаг, обеспеченных активами</w>.",
                                "zh": "投资者应该了解与<w>资产支持证券</w>市场相关的风险。",
                                "es": "Los inversores deben entender los riesgos asociados con el mercado de <w>activos respaldados por valores</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ценная бумага, обеспеченная активами; финансовая инвестиция, обеспеченная пулом активов, таких как кредиты или лизинг.",
                        "zh": "资产支持证券；由贷款或租赁等资产池支持的金融投资。",
                        "es": "Valor respaldado por activos; una inversión financiera respaldada por un conjunto de activos como préstamos o arrendamientos."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ценная бумага, обеспеченная активами",
                                "target_lang_sense_clarification": "финансы"
                            },
                            {
                                "target_lang_word": "облигация, обеспеченная активами",
                                "target_lang_sense_clarification": "финансы"
                            }
                        ],
                        "zh": [
