                ],
                "senses": [
                    {
                        "sense_id": "e57f54e2-819b-3d6c-a719-efcb4ce65cfc",
                        "entry_id": "687490b4-bbdb-35c4-acb6-16d35aa442fd",
                        "glosses": [
                            "Agreement; accordance; consonance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bcbcace3-82aa-4f5a-a5ab-90c6e643cb16",
                                "sense_id": "e57f54e2-819b-3d6c-a719-efcb4ce65cfc",
                                "text": "John Sterling at Herstmonceux that afternoon, and his Father here in London, would have offered strange contrasts to an eye that had seen them both. Contrasts, and yet concordances."
                            }
                        ]
                    },
                    {
                        "sense_id": "e95ef2d4-d08c-3a34-842b-9d219c8efd1a",
                        "entry_id": "687490b4-bbdb-35c4-acb6-16d35aa442fd",
                        "glosses": [
                            "Agreement of words with one another; concord."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7bd6f08d-1427-3e4d-a206-19f39a2d0fc0",
                        "entry_id": "687490b4-bbdb-35c4-acb6-16d35aa442fd",
                        "glosses": [
                            "An alphabetical verbal index showing the places in the text of a book where each principal word may be found, with its immediate context in each place."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "750e35fd-2548-4490-b2cf-cd9386bb7f77",
                                "sense_id": "7bd6f08d-1427-3e4d-a206-19f39a2d0fc0",
                                "text": "c. 1857, Thomas Macaulay, \"Paul Bunyan\", contribution to the Encyclopaedia Britannica,\nHis knowledge of the Bible was such, that he might have been called a living concordance."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c363956-3871-34c5-94e5-2ef34a824135",
                        "entry_id": "687490b4-bbdb-35c4-acb6-16d35aa442fd",
                        "glosses": [
                            "A list of occurrences of a word or phrase from a corpus, with the immediate context."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "45a7ab93-ebaf-38cd-bcec-b80eea873a32",
                        "entry_id": "687490b4-bbdb-35c4-acb6-16d35aa442fd",
                        "glosses": [
                            "The probability that a pair of individuals will both have a certain characteristic (phenotypic trait) given that one of the pair has the characteristic."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35040ccb-2b1f-471f-a4af-734e5513db8e",
                        "source_entry_id": "687490b4-bbdb-35c4-acb6-16d35aa442fd",
                        "source_sense_description": "agreement — see also agreement",
                        "target_lang_word": "согла́сие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "согла́сие",
