                        "entry_id": "272ebca9-aa1e-33a6-b26d-3e9613b2e7f4",
                        "glosses": [
                            "мастер по изготовлению бочек, кадок и т. п.; бондарь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fafc2ee-cd7e-470a-a9d1-7d2a607903d4",
                                "sense_id": "b68c27fb-919f-3f8f-a687-8024bf205a3f",
                                "text": "Бочарная Слобода, в которой живут бочары, которые на Компанейских Пивоварнях бочки набивают."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9be2f8bf-591d-46ca-9250-cb7db0df6ec0",
                        "source_entry_id": "272ebca9-aa1e-33a6-b26d-3e9613b2e7f4",
                        "source_sense_id": "b68c27fb-919f-3f8f-a687-8024bf205a3f",
                        "target_lang_word": "cooper",
