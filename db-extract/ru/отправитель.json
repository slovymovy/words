                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ea91108-97bd-4eee-8bbe-c3a37312c234",
                        "source_entry_id": "fbf0b03c-c300-30f7-8fc4-e4988dbef8bd",
                        "source_sense_id": "7c01dbe7-d571-3da4-b440-023aee5190f4",
                        "target_lang_word": "Absender",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absender",
