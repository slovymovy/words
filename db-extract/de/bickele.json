                "senses": [
                    {
                        "sense_id": "1c53f9f4-7c67-3c11-8486-ddce59117571",
                        "entry_id": "85bf6fdc-cac8-3a4b-8881-b22d901fcfa9",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fe79410-c000-4660-9542-524b91425602",
                                "sense_id": "1c53f9f4-7c67-3c11-8486-ddce59117571",
                                "text": "Frau Bickele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "52b0f045-0807-4e38-b5b6-63728ea401bd",
                                "sense_id": "1c53f9f4-7c67-3c11-8486-ddce59117571",
                                "text": "Herr Bickele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "231ccfca-4d8f-4e20-8a66-562b58d89bd3",
                                "sense_id": "1c53f9f4-7c67-3c11-8486-ddce59117571",
                                "text": "Die Bickeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e1b6769f-b8c2-410b-b604-f09a3505c5f3",
                                "sense_id": "1c53f9f4-7c67-3c11-8486-ddce59117571",
                                "text": "Der Bickele trägt nie die Schals, die die Bickele ihm strickt."
                            },
                            {
                                "example_id": "fdf8d5c8-50c0-48a0-913f-a71760b432ad",
                                "sense_id": "1c53f9f4-7c67-3c11-8486-ddce59117571",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bickele kommt, geht der Herr Bickele.“"
                            },
                            {
                                "example_id": "599787cc-7318-4da9-acf2-e7ff82df5f23",
                                "sense_id": "1c53f9f4-7c67-3c11-8486-ddce59117571",
                                "text": "Bickele kommt und geht."
                            },
                            {
                                "example_id": "d8535e0c-b731-4dbc-8165-49af33ce3af4",
                                "sense_id": "1c53f9f4-7c67-3c11-8486-ddce59117571",
                                "text": "Bickeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
