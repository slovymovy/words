                ],
                "senses": [
                    {
                        "sense_id": "cf7664ad-d925-3506-be56-51c777f64ca0",
                        "entry_id": "8ee4f89f-c467-379f-99d6-ad66c37c576f",
                        "glosses": [
                            "fachliches Gebiet, auf dem jemand arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00150130-752d-4793-a9ae-ec01101b2a3a",
                                "sense_id": "cf7664ad-d925-3506-be56-51c777f64ca0",
                                "text": "„Die Mitglieder des Gremiums werden in geheime Sachverhalte aus dem Tätigkeitsbereich der Geheimdienste eingeweiht.“"
                            },
                            {
                                "example_id": "4f9fe5a1-b7ed-4b49-a113-2550964e5398",
                                "sense_id": "cf7664ad-d925-3506-be56-51c777f64ca0",
                                "text": "„‚Elad‘, die ihren Tätigkeitsbereich 2005 und auch in den Jahren danach auf weitere benachbarte Stadtgebiete ausdehnen durfte, nutzte ihren Einfluss in Regierungskreisen, um sich bei ihren Grabungen und Bautätigkeiten immer wieder über Bauvorschriften hinwegzusetzen.“"
                            },
                            {
                                "example_id": "e48d9b1a-2d6b-49c0-8f2f-660e140cab37",
                                "sense_id": "cf7664ad-d925-3506-be56-51c777f64ca0",
                                "text": "„Das liegt wohl auch am zweiten Trend, über den sich die befragten Fondsanbieter ihr Herz ausschütten, nämlich dem Vertrieb: Mit keinem ihrer Tätigkeitsbereiche sind die Fondsgesellschaften so unzufrieden wie mit dem Vertrieb; und in keinem ihrer Tätigkeitsbereiche sehen sie für die kommenden Jahre so große Aufgaben auf sich zukommen.“"
                            },
                            {
                                "example_id": "2a997bd9-8479-45b0-b0ba-55fb89e47338",
                                "sense_id": "cf7664ad-d925-3506-be56-51c777f64ca0",
                                "text": "„Vom Abteilungsleiter zum Bereichsleiter - mit diesem Karrieresprung steigt das Gehalt erheblich, in manchen Tätigkeitsbereichen verdoppelt es sich beinahe.“"
                            },
                            {
                                "example_id": "b149500e-9d79-437c-8dbc-b62121ef4152",
                                "sense_id": "cf7664ad-d925-3506-be56-51c777f64ca0",
                                "text": "„Im Tätigkeitsbereiche der böhmischen Zentralgesellschaft befinden sich nur 3 Molkereigenossenschaften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
