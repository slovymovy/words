                    },
                    {
                        "sense_id": "ddcadb63-78e0-30e9-8a0f-136b909f112f",
                        "entry_id": "a057fd02-8c95-32ce-8fb0-72645ab67310",
                        "glosses": [
                            "iets bekand en openbaar maken wat eerst nog geheimgehouden werd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80708807-5d91-4693-9dd2-909bd690108f",
                                "sense_id": "ddcadb63-78e0-30e9-8a0f-136b909f112f",
                                "text": "Bernstein was begin jaren zeventig in dienst van The Washington Post een van de onthullers van het Watergate-schandaal, dat president Richard Nixon uiteindelijk deed aftreden."
                            },
                            {
                                "example_id": "a709d483-39c6-418d-bb72-454a12be3595",
                                "sense_id": "ddcadb63-78e0-30e9-8a0f-136b909f112f",
                                "text": "Daniel Ellsberg, onthuller van de Pentagon Papers in 1971 en een van de bekendste klokkenluiders van de Verenigde Staten, heeft Bradley Manning 'het volgende slachtoffer van een afgrijselijke, verkeerde oorlog'genoemd."
                            },
                            {
                                "example_id": "a08fd508-a0bb-44bb-8ac5-87a558eacd7b",
                                "sense_id": "ddcadb63-78e0-30e9-8a0f-136b909f112f",
                                "text": "Wie aantoont dat de regering loog, wordt gecriminaliseerd. De regering zelf werpt intussen stenen naar de onthullers."
                            }
                        ]
                    }
