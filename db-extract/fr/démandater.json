                ],
                "senses": [
                    {
                        "sense_id": "9c8c0409-2de0-3611-8d53-05641854e060",
                        "entry_id": "ed361a47-4a20-3c28-a3b3-1b6330d6dbd9",
                        "glosses": [
                            "Retirer à quelqu’un son mandat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "803741bf-7979-4fb1-b225-d4894d820dd2",
                                "sense_id": "9c8c0409-2de0-3611-8d53-05641854e060",
                                "text": "Les banques « démandatent » leur mandataire comme elles le veulent."
                            },
                            {
                                "example_id": "189c3d93-0f7a-4257-bab9-dd0e5edba4b1",
                                "sense_id": "9c8c0409-2de0-3611-8d53-05641854e060",
                                "text": "Sur le point “politique”, en effet un délégué syndical peut être démandaté à tout moment, mais cela doit être fait soit avec son accord explicite, soit suite à un non-respect des règles de vie et chartes syndicales lui imposant des obligations et des devoirs."
                            },
                            {
                                "example_id": "fa965efe-cba8-495f-ae2c-a4f1c0856bb4",
                                "sense_id": "9c8c0409-2de0-3611-8d53-05641854e060",
                                "text": "Mon syndicat me démandate alors sans motif."
                            }
                        ]
                    }
