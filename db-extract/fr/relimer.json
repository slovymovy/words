                    {
                        "sense_id": "8653f98c-57f3-3852-970b-47cfd539b78b",
                        "entry_id": "3f6eb49f-37c5-3cc0-8e16-33fa6da3078f",
                        "glosses": [
                            "Polir, retoucher."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a0cde152-5b01-480f-8fb9-5858162668ae",
                                "sense_id": "8653f98c-57f3-3852-970b-47cfd539b78b",
                                "text": "Loin de moy soit la faveur et la pompe Qui d’apparence et de fard nous retrompe, Qui nous relime et nous ronge au dedans."
                            },
                            {
                                "example_id": "3d5f30c1-1609-4910-8416-4bf8ab898250",
                                "sense_id": "8653f98c-57f3-3852-970b-47cfd539b78b",
                                "text": "De la prose\nQue l’art lime et relime."
                            },
                            {
                                "example_id": "459cd41e-1e51-4e15-b8f1-7d8d23a533f9",
                                "sense_id": "8653f98c-57f3-3852-970b-47cfd539b78b",
                                "text": "Je suis entouré de mes tragédies, que je relime."
                            }
                        ]
                    }
