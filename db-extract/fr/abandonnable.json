                "senses": [
                    {
                        "sense_id": "a26c5070-542c-3eb9-84eb-30d4a3c8dce7",
                        "entry_id": "41b3b5bc-7a63-3a68-aba1-0fb84d470ec1",
                        "glosses": [
                            "Qui peut, qui doit être abandonné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97bfa330-3381-4f1f-b44b-2d803cdd0ccd",
                                "sense_id": "a26c5070-542c-3eb9-84eb-30d4a3c8dce7",
                                "text": "En-dessous de quel niveau de bénéfice une entreprise est-elle « abandonnable » ?"
                            },
                            {
                                "example_id": "ae1cb389-c258-4118-9fd6-06c634a4afbe",
                                "sense_id": "a26c5070-542c-3eb9-84eb-30d4a3c8dce7",
                                "text": "« Que deviendrai-je si vous m’abandonnez » – discours somme toute inattendu, dans la bouche d’un homme ordinairement en position de force, bien davantage que de faiblesse vis-à-vis de la femme dépendante, plus fréquemment placée en posture « d’abandonnable » potentielle."
                            },
                            {
                                "example_id": "c95253b1-7710-4d01-a044-b071eef7c290",
                                "sense_id": "a26c5070-542c-3eb9-84eb-30d4a3c8dce7",
                                "text": "Par cette loi, le mariage devient un vulgaire contrat aisément abandonnable au seul gré des desiderata de ses parties."
                            }
                        ]
                    }
                ],
