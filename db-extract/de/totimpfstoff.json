                "senses": [
                    {
                        "sense_id": "b9615106-a6f3-3272-a1f0-aef4f12b04ff",
                        "entry_id": "627c4c8e-8371-34a9-b808-8f8743fae6c2",
                        "glosses": [
                            "Vakzin (Impfstoff), das nicht vermehrungsfähiges (totes) Virusmaterial enthält, welches den Körper zur Bildung von Antikörpern anregt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8918611-4405-4a36-954d-c5b18e47b712",
                                "sense_id": "b9615106-a6f3-3272-a1f0-aef4f12b04ff",
                                "text": "„Totimpfstoff – das klingt erstmal gruselig. Dabei handelt es sich aber um einen inaktiven Impfstoff mit abgetöteten Krankheitserregern oder auch nur Bestandteilen davon. Schaffen sie den Sprung in den menschlichen Körper, werden sie als fremd erkannt und die Immunabwehr geht ans Werk.“"
                            },
                            {
                                "example_id": "68bf5987-67bc-47ce-9a6c-5aff2fb11641",
                                "sense_id": "b9615106-a6f3-3272-a1f0-aef4f12b04ff",
                                "text": "„Totimpfstoffe kennt man vor allem von der Tetanusimpfung, aber auch bei der Impfung gegen Diphtherie, Hepatitis B, Kinderlähmung oder Keuchhusten wird mit inaktiven Erregern gearbeitet.“"
                            },
                            {
                                "example_id": "18569b34-13e3-47b2-bed0-a898aa753d83",
                                "sense_id": "b9615106-a6f3-3272-a1f0-aef4f12b04ff",
                                "text": "Totimpfstoffe bestehen nicht nur aus ganzen, inaktivierten Viren, sondern können auch Untereinheitenimpfstoffe sein, die nur gewisse Proteine des Virus enthalten."
                            },
                            {
                                "example_id": "d2cff6a8-8a65-4d45-9157-24abf0f1aa91",
                                "sense_id": "b9615106-a6f3-3272-a1f0-aef4f12b04ff",
                                "text": "Bei diesem Totimpfstoff wird eine Untereinheit des Spike-Proteins des Coronavirus in Baculovirus-Zellen rekombinant hergestellt und dann, um eine ausreichende Impfreaktion zu erhalten, mit einem Adjuvanz kombiniert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
