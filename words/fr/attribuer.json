{
    "word_family": [
        "attribut",
        "attribution",
        "attribuable",
        "attributif",
        "réattribuer",
        "réattribution"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3bfe334-8d61-312e-93a9-aa44c2e40e3c",
                    "sense_definition": "Donner ou conférer officiellement un avantage, une récompense, une tâche ou un droit à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jury a décidé d'<w>attribuer</w> une bourse d'études à cette étudiante très prometteuse."
                        },
                        {
                            "text": "Le directeur va <w>attribuer</w> un rôle spécifique à chaque membre du nouveau projet."
                        }
                    ],
                    "synonyms": [
                        "accorder",
                        "conférer",
                        "allouer",
                        "octroyer"
                    ],
                    "antonyms": [
                        "retirer",
                        "priver"
                    ],
                    "common_phrases": [
                        "attribuer une bourse",
                        "attribuer un rôle",
                        "attribuer un prix"
                    ]
                },
                {
                    "sense_id": "6113943e-049d-325e-850c-cc2e4f9089de",
                    "sense_definition": "Considérer une personne ou une chose comme la cause, l'origine ou l'auteur de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "imputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les spécialistes continuent d'<w>attribuer</w> ce tableau célèbre au grand maître italien."
                        },
                        {
                            "text": "Les médecins <w>attribuent</w> cette baisse de fatigue à son changement d'alimentation récent."
                        }
                    ],
                    "synonyms": [
                        "imputer",
                        "prêter",
                        "assigner"
                    ],
                    "common_phrases": [
                        "attribuer la cause",
                        "attribuer une citation"
                    ]
                },
                {
                    "sense_id": "9e6bb052-4ec7-3316-ad80-053c4a1a3988",
                    "sense_definition": "Prendre pour soi un droit, un titre ou un mérite qui revient éventuellement à autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appropriation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune chercheur s'est <w>attribué</w> tout le mérite de cette découverte collective."
                        },
                        {
                            "text": "Ce dirigeant refuse de s'<w>attribuer</w> des privilèges excessifs face aux employés."
                        }
                    ],
                    "synonyms": [
                        "s'arroger",
                        "s'accorder",
                        "s'approprier"
                    ],
                    "antonyms": [
                        "partager"
                    ],
                    "common_phrases": [
                        "s'attribuer le mérite",
                        "s'attribuer des privilèges"
                    ]
                }
            ]
        }
    ]
}