{
    "word_family": [
        "gauge",
        "gauger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a882937a-c75c-3ea2-ac07-dd73b24f2004",
                    "sense_definition": "present participle and gerund of <w>gauge</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>gauging</w> the distance between the two cars before making his move.",
                            "target_lang_translations": {
                                "de": "Er <w>schätzte</w> den Abstand zwischen den beiden Autos ab, bevor er handelte."
                            }
                        },
                        {
                            "text": "By <w>gauging</w> public reaction, the company decided to modify the product.",
                            "target_lang_translations": {
                                "de": "Durch das <w>Einschätzen</w> der öffentlichen Reaktion beschloss das Unternehmen, das Produkt zu modifizieren."
                            }
                        }
                    ],
                    "synonyms": [
                        "measuring",
                        "estimating",
                        "evaluating"
                    ],
                    "common_phrases": [
                        "gauging public reaction",
                        "gauging the distance"
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von \"gauge\" (messen, abschätzen, beurteilen)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "messen",
                                "target_lang_sense_clarification": "eine physikalische Größe bestimmen"
                            },
                            {
                                "target_lang_word": "abschätzen",
                                "target_lang_sense_clarification": "eine ungefähre Größe oder Wirkung beurteilen"
                            },
                            {
                                "target_lang_word": "beurteilen",
                                "target_lang_sense_clarification": "eine Situation oder Reaktion einschätzen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e006df6-692e-3983-bf9e-ce86e01ee3dc",
                    "sense_definition": "The act of measuring or estimating, with or as if with a gauge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team performed periodic <w>gaugings</w> of the water level to prevent flooding.",
                            "target_lang_translations": {
                                "de": "Das Team führte regelmäßige <w>Messungen</w> des Wasserstands durch, um Überschwemmungen zu verhindern."
                            }
                        },
                        {
                            "text": "Accurate <w>gaugings</w> of the wind speed are essential for safe sailing.",
                            "target_lang_translations": {
                                "de": "Genaue <w>Messungen</w> der Windgeschwindigkeit sind für sicheres Segeln unerlässlich."
                            }
                        }
                    ],
                    "synonyms": [
                        "measurement",
                        "estimation",
                        "assessment"
                    ],
                    "common_phrases": [
                        "periodic gaugings"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Akt des Messens oder Schätzens, wie mit einem Messgerät."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Messung",
                                "target_lang_sense_clarification": "Bestimmung einer physikalischen Größe"
                            },
                            {
                                "target_lang_word": "Einschätzung",
                                "target_lang_sense_clarification": "Beurteilung oder Bewertung einer Situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "878edc2b-233a-3403-9a13-db6acae3cd22",
                    "sense_definition": "The addition of various materials, such as plaster of Paris, to lime mortar to facilitate quick setting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plasterer explained that proper <w>gauging</w> of the mortar prevents cracking.",
                            "target_lang_translations": {
                                "de": "Der Gipser erklärte, dass das richtige <w>Anmischen</w> des Mörtels Rissbildung verhindert."
                            }
                        },
                        {
                            "text": "Traditional masonry relies on precise <w>gauging</w> to ensure structural integrity.",
                            "target_lang_translations": {
                                "de": "Traditionelles Mauerwerk verlässt sich auf präzises <w>Mischen</w> des Mörtels, um die strukturelle Integrität zu gewährleisten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in masonry and plastering"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Das Hinzufügen von Materialien wie Gips zu Kalkmörtel, um ein schnelles Abbinden zu ermöglichen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Mischen",
                                "target_lang_sense_clarification": "Zusatz von Gips zu Mörtel zur schnelleren Härtung"
                            },
                            {
                                "target_lang_word": "Anmachen",
                                "target_lang_sense_clarification": "Zubereiten von Mörtel mit Bindemitteln"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad669df6-ac92-3db0-ba7c-5630e0ad7a53",
                    "sense_definition": "A decorative technique in sewing consisting of parallel rows of gathers; shirring.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vintage dress featured beautiful <w>gauging</w> across the bodice.",
                            "target_lang_translations": {
                                "de": "Das Vintage-Kleid wies ein wunderschönes <w>Smoken</w> über dem Mieder auf."
                            }
                        },
                        {
                            "text": "She practiced her <w>gauging</w> technique on a scrap piece of linen.",
                            "target_lang_translations": {
                                "de": "Sie übte ihre Technik des <w>Kräuselns</w> an einem Reststück Leinen."
                            }
                        }
                    ],
                    "synonyms": [
                        "shirring",
                        "gathering"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in sewing and textiles"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine dekorative Nähtechnik, die aus parallelen Reihen von Falten besteht; Smokarbeit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Smoken",
                                "target_lang_sense_clarification": "Zierstiche über gerafftem Stoff"
                            },
                            {
                                "target_lang_word": "Kräuseln",
                                "target_lang_sense_clarification": "Zusammenziehen von Stoff in parallelen Falten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}