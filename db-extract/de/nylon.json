                "senses": [
                    {
                        "sense_id": "3b3b2f57-e001-395b-9ee4-6c32ff41c044",
                        "entry_id": "bcff4bcb-864a-3bec-afef-c585416c3452",
                        "glosses": [
                            "glänzende, reißfeste Chemiefaser, die meist zur Herstellung von Textilien verwendet wird"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "204cf329-ddcb-4152-a545-165e2a263487",
                                "sense_id": "3b3b2f57-e001-395b-9ee4-6c32ff41c044",
                                "text": "Er trägt ein Hemd aus Nylon."
                            },
                            {
                                "example_id": "d61ed546-e342-47ad-b12b-e6fee50dbfd5",
                                "sense_id": "3b3b2f57-e001-395b-9ee4-6c32ff41c044",
                                "text": "„Man hört das Geräusch des aneinanderreibenden Nylons ihrer Leggings.“"
                            },
                            {
                                "example_id": "72445792-3f2b-4d69-88a7-69cb31de2e40",
                                "sense_id": "3b3b2f57-e001-395b-9ee4-6c32ff41c044",
                                "text": "„Sie trugen identische Jacken. Dünn, weiß, aus einer Art Nylon, mit Kapuzen“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5faebef2-47c1-3065-89ac-7c491707256b",
                        "entry_id": "bcff4bcb-864a-3bec-afef-c585416c3452",
                        "glosses": [
                            "Damenstrumpf aus [1]"
                        ],
                        "tags": [
                            "colloquial",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "7721503a-dfdd-4b59-8347-45fd55203cb9",
                                "sense_id": "5faebef2-47c1-3065-89ac-7c491707256b",
                                "text": "Sie trug Nylons."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7c7e923-0e20-4a59-9f9e-6150fe493b61",
                        "source_entry_id": "bcff4bcb-864a-3bec-afef-c585416c3452",
                        "source_sense_id": "3b3b2f57-e001-395b-9ee4-6c32ff41c044",
                        "target_lang_word": "nylon",
