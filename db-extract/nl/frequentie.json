                        "entry_id": "4799d24a-9cf4-3f2e-95f8-e1ac875c1e7a",
                        "glosses": [
                            "aantal keren of herhalingen per tijdseenheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d94f19bc-8ff4-434f-b873-6448a327ed73",
                                "sense_id": "55eb1348-c4ab-356f-9a44-fd9592424f84",
                                "text": "Die tram rijdt met een frequentie van twee keer per uur."
                            }
                        ]
                    },
                    {
                        "sense_id": "412dca72-58a0-3951-a007-1ad3fbaab8a5",
                        "entry_id": "4799d24a-9cf4-3f2e-95f8-e1ac875c1e7a",
                        "glosses": [
                            "het aantal perioden per seconde, trillingsgetal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29145fd3-61fb-4b55-a92a-2e2fd0bbff5b",
                                "sense_id": "412dca72-58a0-3951-a007-1ad3fbaab8a5",
                                "text": "In de elektrotechniek wordt de frequentie uitgedrukt in de SI-eenheid hertz (symbool Hz)."
                            }
                        ]
                    },
                    {
                        "sense_id": "e488d8d1-944b-31de-9ea4-7993744b696a",
                        "entry_id": "4799d24a-9cf4-3f2e-95f8-e1ac875c1e7a",
                        "glosses": [
                            "het aantal malen dat een bepaalde observatie gedaan is"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10e852c8-c4da-4185-97ea-e23a5b78b55a",
                        "source_entry_id": "4799d24a-9cf4-3f2e-95f8-e1ac875c1e7a",
                        "source_sense_description": "1,2. aantal keren of herhalingen per tijdseenheid",
                        "target_lang_word": "Frequenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frequenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45cecbb2-bc0f-3af9-af42-4bd81f6a478b",
                                        "entry_id": "f5c6f28c-0660-3287-aad6-c4468975bc63",
                                        "glosses": [
                                            "Anzahl der Ereignisse pro Zeitintervall, Häufigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1e45ec-8c2c-498d-bc5c-9407b9d7a44d",
                                                "sense_id": "45cecbb2-bc0f-3af9-af42-4bd81f6a478b",
                                                "text": "„Die Frequenz der Fahrten wurde bei den Wiener Linien unterdessen bereits leicht reduziert, wenn auch nicht in ungewöhnlichem Ausmaß.“"
                                            },
                                            {
                                                "example_id": "887e4fba-192f-4953-9017-7df0e4ad9967",
                                                "sense_id": "45cecbb2-bc0f-3af9-af42-4bd81f6a478b",
                                                "text": "„Die ÖBB versicherte uns zu Beginn der Bauarbeiten, dass die Frequenz der Regionalzüge nach Fertigstellung des Ausbaus wieder wie vorher sein wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95f14e8b-e7ae-320f-bf6e-e20a876295ae",
                                        "entry_id": "f5c6f28c-0660-3287-aad6-c4468975bc63",
                                        "glosses": [
                                            "Maß dafür, wie schnell bei einem periodischen Vorgang die Wiederholungen aufeinander folgen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06836887-9112-4ee0-807b-9c5af0d59089",
                                                "sense_id": "95f14e8b-e7ae-320f-bf6e-e20a876295ae",
                                                "text": "Die SI-Basiseinheit der Frequenz ist „Hertz“, abgekürzt „Hz“ = 1/s."
                                            },
                                            {
                                                "example_id": "042a6874-ef0a-4813-aeae-231e0d65828b",
                                                "sense_id": "95f14e8b-e7ae-320f-bf6e-e20a876295ae",
                                                "text": "Die Frequenz des Senders liegt bei 108 MHz, also im UKW-Bereich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60c38c70-ef6d-4598-a2d0-748c17704103",
                        "source_entry_id": "4799d24a-9cf4-3f2e-95f8-e1ac875c1e7a",
                        "source_sense_description": "1,2. aantal keren of herhalingen per tijdseenheid",
                        "target_lang_word": "frequency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frequency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eea318c0-037c-309b-81db-44c698a19f02",
                                        "entry_id": "1aaf4528-ea8a-3956-9dca-02e80294ada5",
                                        "glosses": [
                                            "The rate of occurrence of anything; the relationship between incidence and time period."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26072256-7eb1-42d1-b65c-1799abe79a90",
                                                "sense_id": "eea318c0-037c-309b-81db-44c698a19f02",
                                                "text": "With growing confidence, the Viking’s raids increased in frequency."
                                            },
                                            {
                                                "example_id": "b95a0f94-9eff-4ad9-8b0c-2c3be50df356",
                                                "sense_id": "eea318c0-037c-309b-81db-44c698a19f02",
                                                "text": "The frequency of bus service has been improved from one every 15 to one every 12 minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f20183d3-c00c-3962-a5f8-6e7356bc072f",
                                        "entry_id": "1aaf4528-ea8a-3956-9dca-02e80294ada5",
                                        "glosses": [
                                            "The property of occurring often rather than infrequently."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f3f48bf-3429-4489-89f9-4315fc0c7ce2",
                                                "sense_id": "f20183d3-c00c-3962-a5f8-6e7356bc072f",
                                                "text": "The FAQ addresses questions that come up with some frequency."
                                            },
                                            {
                                                "example_id": "489e45e9-e9a0-4b66-b3af-0f9532d65d55",
                                                "sense_id": "f20183d3-c00c-3962-a5f8-6e7356bc072f",
                                                "text": "The frequency of the visits was what annoyed him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                        "entry_id": "1aaf4528-ea8a-3956-9dca-02e80294ada5",
                                        "glosses": [
                                            "The quotient of the number of times n a periodic phenomenon occurs over the time t in which it occurs: f=n/t."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b4ec6a1-99b2-42d3-a658-a264f9f40cd7",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "The frequency of the musical note A above middle C is 440 oscillations per second."
                                            },
                                            {
                                                "example_id": "2befa359-ee5e-4cc5-9362-d0fd9c54dbb4",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "The frequency of a wave is its velocity v divided by its wavelength #92;lambda: f#61;v#47;#92;lambda."
                                            },
                                            {
                                                "example_id": "1aece17b-b808-47f3-adae-1a9db1d74d7c",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "Broadcasting live at a frequency of 98.3 megahertz, we’re your rock alternative!"
                                            },
                                            {
                                                "example_id": "a7d9f2d3-ed4a-4850-b945-262cad1258b3",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "The frequency for electric power in the Americas is generally 60 Hz rather than 50."
                                            },
                                            {
                                                "example_id": "a15ac354-72e1-4af2-9ea2-ec087ff7fcdc",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "[…] the Plan incorporates in proper combination every available modern technique, including extensive electrification on the new standard high-voltage a.c. system at a frequency of 50 cycles; main-line diesel traction as a half-way house to electrification; lightweight diesel trains for secondary and branch services; and a smaller wagon fleet doing more work by the use of continuous brakes in conjunction with modernised terminals and marshalling yards."
                                            },
                                            {
                                                "example_id": "ea14b92e-ccdb-43a0-90a3-fe3ca6a55421",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "36 MHz transponder providing a pool of 794 reallocatable frequencies."
                                            },
                                            {
                                                "example_id": "fbfe9304-3eab-48a7-bf52-4636466b0f97",
                                                "sense_id": "9fef33e1-8d6d-3655-96af-89199442029e",
                                                "text": "In this case, a band-pass filter using a range or window of frequencies is appropriate to isolate the frequency or the group of frequencies that characterize a specific cycle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de244603-2425-32a8-97ce-5936bd654553",
                                        "entry_id": "1aaf4528-ea8a-3956-9dca-02e80294ada5",
                                        "glosses": [
                                            "A tone, character, mood, or vibe"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3bf786a-6d04-478a-86b3-e04e61bfcdf2",
                                                "sense_id": "de244603-2425-32a8-97ce-5936bd654553",
                                                "text": "And if you haven’t picked up on the gay frequencies in her lyrics, her wig choices, and her possible lesbian salutes? Maybe that’s because they weren’t meant for you. IYKYK."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cba6ed6-ed36-3558-b2f5-79109c3a2728",
                                        "entry_id": "1aaf4528-ea8a-3956-9dca-02e80294ada5",
                                        "glosses": [
                                            "number of times an event occurred in an experiment (absolute frequency)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "894aae29-3270-414b-8b91-0bf4428c6e32",
                        "source_entry_id": "4799d24a-9cf4-3f2e-95f8-e1ac875c1e7a",
                        "source_sense_description": "1,2. aantal keren of herhalingen per tijdseenheid",
                        "target_lang_word": "fréquence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fréquence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ee584f6-2429-33ef-be9e-77e378fbcd9b",
                                        "entry_id": "c19e8606-26df-361f-ad04-5abd540602d0",
                                        "glosses": [
                                            "Répétition incessante et régulière d’une action ou d’un fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "206e2c56-461a-475d-867e-10585b36b3c0",
                                                "sense_id": "3ee584f6-2429-33ef-be9e-77e378fbcd9b",
                                                "text": "Alors que les risques auxquels les militaires sont exposés imposent une fréquence d’examen annuelle, certaines cellules avaient institué une fréquence bisannuelle pour les examens, ce qui correspondait plutôt à ce qu'elles étaient capables d'assurer, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e00b2e5-d2f0-3501-ac8b-3b248ac65eee",
                                        "entry_id": "c19e8606-26df-361f-ad04-5abd540602d0",
                                        "glosses": [
                                            "Probabilité de la survenance d'un phénomène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d26c18-b793-43c4-bdf8-53b690784a88",
                                                "sense_id": "9e00b2e5-d2f0-3501-ac8b-3b248ac65eee",
                                                "text": "Une population est optimalement adaptée si, dans un contexte environnemental donné et constant, la fréquence la plus avantageuse du génotype le plus avantageux est stable et que la population se perpétue."
                                            },
                                            {
                                                "example_id": "fd7c552e-fcfc-4a26-ace7-e130ca9f130c",
                                                "sense_id": "9e00b2e5-d2f0-3501-ac8b-3b248ac65eee",
                                                "text": "Des erreurs lors de la réplication de l’ADN (mutations) ou des transferts de gènes s'accumulent à fréquence faible mais constante au cours du temps, ce qui augmente progressivement le polymorphisme au sein de chaque écotype."
                                            },
                                            {
                                                "example_id": "74c542d7-4a50-431e-808f-a20ef5a902f5",
                                                "sense_id": "9e00b2e5-d2f0-3501-ac8b-3b248ac65eee",
                                                "text": "Les infections fungiques sont démontrées chez environ 5 % des patients présentant une neutropénie fébrile ; cette fréquence a tendance à augmenter dans de nombreux centres, au cours des dernières années."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d19c6ac8-2e83-3778-8861-4f97b4d52959",
                                        "entry_id": "c19e8606-26df-361f-ad04-5abd540602d0",
                                        "glosses": [
                                            "Succession rapide des battements, en parlant du pouls, du cœur ou des mouvements nécessaires à la respiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "920afd82-2d95-47b6-bdfa-69431c590560",
                                                "sense_id": "d19c6ac8-2e83-3778-8861-4f97b4d52959",
                                                "text": "Plus rarement, il existe des troubles cardiaques très marqués : petitesse et fréquence extrême du pouls, lipothymies et syncopes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0c1bbfd-f7ad-321c-8145-da5a94f79e8c",
                                        "entry_id": "c19e8606-26df-361f-ad04-5abd540602d0",
                                        "glosses": [
                                            "Nombre de fois que la période est contenue dans une unité de temps, lors d'un mouvement périodique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "note": "La fréquence est généralement mesurée en hertz",
                                        "examples": [
                                            {
                                                "example_id": "f6a43f37-5201-4796-876a-0c0915cc1e20",
                                                "sense_id": "a0c1bbfd-f7ad-321c-8145-da5a94f79e8c",
                                                "text": "Cette salle des machines est découpée en deux. Deux tiers de l'énergie sont distribués à une fréquence de 50 Hz pour alimenter des sites industriels en Bavière. Le tiers restant, qui affiche 16,7 Hz, est fourni à la Deutsche Bahn, pour faire rouler ses trains dans le land."
                                            },
                                            {
                                                "example_id": "42e10fbe-e945-4809-99b4-dc099b8e4065",
                                                "sense_id": "a0c1bbfd-f7ad-321c-8145-da5a94f79e8c",
                                                "text": "C'est le cas du son de la voix, on l'a noté, enregistrable par le sonagraphe, retraçable par un sonagramme où les fréquences sont portées en ordonnée et le temps en abscisse."
                                            },
                                            {
                                                "example_id": "6ee9e010-b212-42fa-b435-0aa0e6b1a3fd",
                                                "sense_id": "a0c1bbfd-f7ad-321c-8145-da5a94f79e8c",
                                                "text": "Cet animal s'oriente dans l’espace par écholocation : il émet des sons de très haute fréquence et utilise l’écho renvoyé par les obstacles ou les proies pour les localiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a526c97-daf3-3f3a-8531-cffe11c5344d",
                                        "entry_id": "c19e8606-26df-361f-ad04-5abd540602d0",
                                        "glosses": [
                                            "Gamme d'ondes sur laquelle se font les télécommunications."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e4371c1-37fe-46d8-8f27-8d06c36b8396",
                                                "sense_id": "9a526c97-daf3-3f3a-8531-cffe11c5344d",
                                                "text": "Ils sortirent le matériel, branchèrent la gégène que René enfourcha pour pédaler. Le courant passait. L'opérateur radio pouvait émettre le message que lui avait donné Gaëtan. La communication était mauvaise et le radio dut changer de fréquence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "189ba4a8-6efb-4007-9dad-844425ee7aef",
                        "source_entry_id": "4799d24a-9cf4-3f2e-95f8-e1ac875c1e7a",
