                                "example_id": "8183d6a5-b2d7-4f2a-b931-eb8a05a13e21",
                                "sense_id": "8d29b9bd-af1c-3dba-bec3-dd51fff7b0f5",
                                "text": "„Die Muskelschicht innerhalb der Magenwand besteht aus drei übereinanderliegenden Schichten glatter Muskulatur.“"
                            },
                            {
                                "example_id": "39d521ee-e4b4-4a2d-8cba-66f842c5b300",
                                "sense_id": "8d29b9bd-af1c-3dba-bec3-dd51fff7b0f5",
                                "text": "„Die Ausschüttung von Gastrin wird durch Reizung des Vagusnervs und durch Druckrezeptoren in der Magenwand ausgelöst, die eine Füllung des Magens anzeigen.“"
                            }
                        ],
