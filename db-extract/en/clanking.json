                            {
                                "example_id": "6561af20-5558-4883-846a-1b932f602b36",
                                "sense_id": "44f2bab7-ae20-3611-9712-9bac46ca7c31",
                                "text": "My course happened to lead me to the river, and I saw a steamer lying there, and from the bustle on her decks and the clankings from her engine room, I concluded that she was making preparations for a start somewhere."
                            },
                            {
                                "example_id": "82a0a880-2d37-4c4a-bbad-87ff2e4aa2c1",
                                "sense_id": "44f2bab7-ae20-3611-9712-9bac46ca7c31",
                                "text": "Smalling’s challenge was weak and, when Lucas buried his shot, the night air was filled with the clanking of thousands of red plastic seats being emptied."
                            }
                        ]
                    }
