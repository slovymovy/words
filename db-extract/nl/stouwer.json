                "senses": [
                    {
                        "sense_id": "d59ecec7-f38d-3e7e-9057-545ee8b34aac",
                        "entry_id": "33e8ad31-0a6d-3042-b85b-846060db0a02",
                        "glosses": [
                            "lader en losser van schepen (zowel als persoon of als onderneming)"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "d6fa8256-ec55-440d-883a-e00a88457a45",
                                "sense_id": "d59ecec7-f38d-3e7e-9057-545ee8b34aac",
                                "text": "De Ghent Container Terminal komt er door de samenwerking tussen de Vlaamse stouwer en logistieke groep Manuport, die actief is in de havens van Antwerpen en Gent, en de Finse containerrederij- en terminalholding Container Finance Ltd. Elk bedrijf financiert de helft van het project. De concessie loopt over een termijn van dertig jaar."
                            },
                            {
                                "example_id": "f64b7189-af39-4e93-bfb5-42da8813275d",
                                "sense_id": "d59ecec7-f38d-3e7e-9057-545ee8b34aac",
                                "text": "Tussen 1991 en 2006 hebben stouwers in de Belgische zeehavens afspraken gemaakt over kostprijsverhogingen. Dat blijkt uit onderzoek van het Auditoraat van de Raad voor de Mededinging. De bedrijven zelf kunnen nog reageren op het onderzoek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ca89f60-641c-44da-8577-fbf360a23367",
                        "source_entry_id": "33e8ad31-0a6d-3042-b85b-846060db0a02",
                        "source_sense_id": "d59ecec7-f38d-3e7e-9057-545ee8b34aac",
                        "source_sense_description": "lader en losser van schepen (zowel als persoon of als onderneming)",
                        "target_lang_word": "loader",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loader",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "116abfce-4eae-3f08-80f3-ea2f0f67d6e2",
                                        "entry_id": "385afcc7-ffd1-3d1c-81c4-c51b0df1de5f",
                                        "glosses": [
                                            "Agent noun of load; a person or device that loads."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "498dc3c1-024c-4c77-a8c4-38d275d3a25d",
                                                "sense_id": "116abfce-4eae-3f08-80f3-ea2f0f67d6e2",
                                                "text": "There was only one loader for the truck today so it took him a long time to get everything moved."
                                            },
                                            {
                                                "example_id": "7c2c6b04-49d3-4310-bd45-be6b840ccf9d",
                                                "sense_id": "116abfce-4eae-3f08-80f3-ea2f0f67d6e2",
                                                "text": "The auto-loader on the gun kept jamming so they did it manually."
                                            },
                                            {
                                                "example_id": "0e9ce5cb-d4d6-4bcf-9c35-4e53a92997a3",
                                                "sense_id": "116abfce-4eae-3f08-80f3-ea2f0f67d6e2",
                                                "text": "A loader performs the important work of storing goods in the wagons and of unloading the wagons. In each case considerable skill is required to avoid breakage, and, in the case of loading, skill goes far to conserve wagon space."
                                            },
                                            {
                                                "example_id": "3303294c-3203-43ca-85c7-cdca514435ac",
                                                "sense_id": "116abfce-4eae-3f08-80f3-ea2f0f67d6e2",
                                                "text": "The loader […] placed the cartridge in the muzzle and shoved it in as far as he could. The rammer rammed it home, the gun captain inserting his priming wire to make sure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc33992d-b579-3d17-aeae-95d2e7cf810b",
                                        "entry_id": "385afcc7-ffd1-3d1c-81c4-c51b0df1de5f",
                                        "glosses": [
                                            "A program that prepares other programs for execution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0cc6f8d-7dc5-30b1-84a8-72af1345baf5",
                                        "entry_id": "385afcc7-ffd1-3d1c-81c4-c51b0df1de5f",
                                        "glosses": [
                                            "A tractor with a scoop, for example: front-end loader, front loader, endloader, payloader, bucket loader, tracked loader, wheel loader, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3282595d-4489-3c75-a3dd-c424c78e1d5b",
                                        "entry_id": "385afcc7-ffd1-3d1c-81c4-c51b0df1de5f",
                                        "glosses": [
                                            "A tractor with a scoop, for example: front-end loader, front loader, endloader, payloader, bucket loader, tracked loader, wheel loader, etc.",
                                            "Ellipsis of backhoe loader"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a794d654-4104-3ff9-9d11-02966641070a",
                                        "entry_id": "385afcc7-ffd1-3d1c-81c4-c51b0df1de5f",
                                        "glosses": [
                                            "An incentive given to a dealer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bbdc6d7-61ee-4264-9298-07a22f7205a7",
                                                "sense_id": "a794d654-4104-3ff9-9d11-02966641070a",
                                                "text": "Unique point-of-purchase materials and display loaders dramatically contribute to the display's attention-getting ability."
                                            },
                                            {
                                                "example_id": "38b7d5ac-dea1-4061-bd43-830ffd23b91f",
                                                "sense_id": "a794d654-4104-3ff9-9d11-02966641070a",
                                                "text": "Marketers use dealer loaders to obtain new distributors and push larger quantities of goods."
                                            },
                                            {
                                                "example_id": "4871a302-82d9-4775-b235-d23cda781cc5",
                                                "sense_id": "a794d654-4104-3ff9-9d11-02966641070a",
                                                "text": "Dealer (or buying) loaders are gifts offered to resellers for stocking products. Many companies specialize in providing premium and gift items, and publish catalogues from which you can select appropriate items."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
