                        "examples": [
                            {
                                "example_id": "6f0a0fd4-3290-4488-bb93-eaa30081cf52",
                                "sense_id": "f4211f3f-a0a4-34fc-9528-f4d0d8c1e7d3",
                                "text": "„Nach meinem Bruder kam eine kanadische Freundin von Sophie und es wurde etwas besser, da ihre Coolness meine Töchter animierte.“"
                            },
                            {
                                "example_id": "8fed1b31-9fdf-49b4-b379-7e74cf0f9f57",
                                "sense_id": "f4211f3f-a0a4-34fc-9528-f4d0d8c1e7d3",
                                "text": "„So wird Rauchen zum Beispiel mit Eigenschaften wie Coolness und Überlegenheit assoziiert.“"
                            },
                            {
                                "example_id": "9ea035d5-0c84-4734-927a-1aa28965a754",
                                "sense_id": "f4211f3f-a0a4-34fc-9528-f4d0d8c1e7d3",
                                "text": "„Allerdings ist Coolness weiß Gott keine Tugend, die Europa im Moment braucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
