                        "bold statement",
                        "political statement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представление определенного мнения, позиции или стиля.",
                        "tr": "Belli bir görüşün, duruşun veya tarzın sunulması veya dışa vurumu."
