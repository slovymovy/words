                "senses": [
                    {
                        "sense_id": "a63898fd-f63f-3148-a55f-b48e08c8f78a",
                        "entry_id": "af354dff-b160-33ec-b03b-4604cbff9fcf",
                        "glosses": [
                            "Glas eines Fensters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f4bd4be-f392-4525-8bac-65585bcec384",
                                "sense_id": "a63898fd-f63f-3148-a55f-b48e08c8f78a",
                                "text": "„Durch das klare Fensterglas blicken Menschen heraus, leer und still wie Invaliden.“"
                            },
                            {
                                "example_id": "0ee5df3a-1b2d-407b-819d-bc86c4b9d9ff",
                                "sense_id": "a63898fd-f63f-3148-a55f-b48e08c8f78a",
                                "text": "„Hinter Fensterglas steht ein kapitaler Achtender von Hirsch, dessen Geweih vor einer Abendrottapete goldgelb leuchtet (Bühne: Florian Parbs).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
