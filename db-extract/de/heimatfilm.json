                "senses": [
                    {
                        "sense_id": "e06fa408-441f-32fd-8c3a-1635764e7593",
                        "entry_id": "5def0a25-0acd-304f-98c7-d6b1e36ea180",
                        "glosses": [
                            "Film, meist gespielt in den Bergen von Österreich, Bayern oder der Schweiz"
                        ],
                        "tags": [
                            "Film",
                            "Filmgenre"
                        ],
                        "examples": [
                            {
                                "example_id": "54840213-edfa-4da0-9a5b-df8a38123958",
                                "sense_id": "e06fa408-441f-32fd-8c3a-1635764e7593",
                                "text": "„Solange noch die Rosen blüh'n“ ist ein Heimatfilm."
                            },
                            {
                                "example_id": "f7171734-ceac-4c38-9149-101b21fa1853",
                                "sense_id": "e06fa408-441f-32fd-8c3a-1635764e7593",
                                "text": "„Die durchschnittliche staatlich finanzierte TV-Serie, ob Soap, Heimatfilm, Arztserie oder Krimi, strahlt ein hohes Maß an Vertrauen in den Staat aus, stellt die Gesellschaft als grundsätzlich heil dar und fordert uns nicht zum Nachdenken auf: Alles ist gut, wie es ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
