                "senses": [
                    {
                        "sense_id": "f530068f-ed44-3a95-a0a8-a9db8bd4112f",
                        "entry_id": "5b4c2465-4bb2-3360-b74f-6de854def4b2",
                        "glosses": [
                            "goed uitziend, van een zekere schoonheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74463e4e-1d9c-457b-b3b3-a106e7d8dd06",
                                "sense_id": "f530068f-ed44-3a95-a0a8-a9db8bd4112f",
                                "text": "Ze had een aanminnige houding."
                            },
                            {
                                "example_id": "b6900d7c-9b4b-4cad-a23e-16f1687d7045",
                                "sense_id": "f530068f-ed44-3a95-a0a8-a9db8bd4112f",
                                "text": "Aono richt zich op specialisten binnen een specialisme, op ‘genreschilders’ en in het bijzonder daarin de fijnschilders. Dat waren schilders van alledaagse taferelen, van binnenkamerscènes van een vrouw met een papegaai of een luit, van keukenmeiden aan de afwas, van een aanminnig paar bij kaarslicht, en dat alles geschilderd op minutieuze wijze. (Roelof van Gelder NRC 7 augustus 2015)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4732e1e3-3857-4372-8cf1-65006189e687",
                        "source_entry_id": "5b4c2465-4bb2-3360-b74f-6de854def4b2",
                        "source_sense_id": "f530068f-ed44-3a95-a0a8-a9db8bd4112f",
                        "source_sense_description": "goed uitziend, van een zekere schoonheid",
                        "target_lang_word": "anmutig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anmutig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94cc74ee-af8a-31fb-b28d-78793f2255fe",
                                        "entry_id": "31261f91-b7f1-3bf1-895a-e72e078c989f",
                                        "glosses": [
                                            "reizend, mit Anmut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53259c71-96cc-42be-ae46-90c9ae67696c",
                                                "sense_id": "94cc74ee-af8a-31fb-b28d-78793f2255fe",
                                                "text": "Anmutig glitt die junge Schlittschuhläuferin über das Eis."
                                            },
                                            {
                                                "example_id": "07ff3cc0-2450-460c-9bf5-78f5597f5796",
                                                "sense_id": "94cc74ee-af8a-31fb-b28d-78793f2255fe",
                                                "text": "„In süßen Träumen geht meines holden Clärchens freundliche Gestalt vorüber und lächelt mich mit ihren hellen Augen so anmutig an.“"
                                            },
                                            {
                                                "example_id": "d08e7703-67ee-406a-a16f-46f18766ea2c",
                                                "sense_id": "94cc74ee-af8a-31fb-b28d-78793f2255fe",
                                                "text": "„Anmutig zum Klang von Panflöten tanzend, brachte er vor dem Altar Opfer dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
