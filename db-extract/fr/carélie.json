        "fr-extract.jsonl": [
            {
                "entry_id": "9ac1289f-bf9f-3771-89b8-39ceee085d00",
                "word": "Carélie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fd730e56-4534-3b86-b727-c4c64d36c0b1",
                        "entry_id": "9ac1289f-bf9f-3771-89b8-39ceee085d00",
                        "glosses": [
                            "Région frontalière entre la Finlande et la Russie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4faf83a5-8a6c-4034-bb2b-4dff76379419",
                                "sense_id": "fd730e56-4534-3b86-b727-c4c64d36c0b1",
                                "text": "[Le lac d’Onéga est un] grand lac de l’empire russien, entre la Carélie moscovite au nord, le pays de Cargapol à l’orient, & la Carélie suédoise au couchant septentrional."
                            },
                            {
                                "example_id": "83dff924-fe9f-4487-8a70-a5f67dc384e5",
                                "sense_id": "fd730e56-4534-3b86-b727-c4c64d36c0b1",
                                "text": "Moscou offre en compensation une rectification frontalière en Carélie orientale et la conclusion d’un pacte d’assistance."
                            }
                        ]
                    },
                    {
                        "sense_id": "0da078a8-b68d-3211-8886-ee490c370496",
                        "entry_id": "9ac1289f-bf9f-3771-89b8-39ceee085d00",
                        "glosses": [
                            "Région frontalière entre la Finlande et la Russie.",
                            "République du nord-ouest de la Fédération de Russie, dont la capitale est Petrozavodsk."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d1ee24ba-0c54-3966-8b76-0d5c15d38d25",
                        "entry_id": "9ac1289f-bf9f-3771-89b8-39ceee085d00",
                        "glosses": [
                            "Région frontalière entre la Finlande et la Russie.",
                            "Province de la partie orientale de la Finlande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06faaa0c-ed42-47f2-9a13-fdc1ca37edfb",
                                "sense_id": "d1ee24ba-0c54-3966-8b76-0d5c15d38d25",
                                "text": "Les terribles événements qui font le sujet de ce roman se sont produits à cette date, en Finlande, à Kollaa. Mais aussi sur son isthme, en Carélie. Dans ses glaces, à Petsamo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f7b19d2-1e9f-43de-ad2a-7e15c2a7b9ac",
                        "source_entry_id": "9ac1289f-bf9f-3771-89b8-39ceee085d00",
                        "target_lang_word": "Karelien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karelien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06783d8d-043a-3df5-9ef0-e19eba235974",
                                        "entry_id": "34dda74d-d26b-372e-a965-accd6547f642",
                                        "glosses": [
                                            "historische Region in Nordosteuropa (heute teils in Russland, teils in Finnland)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b30ea50e-ca3f-41ac-88dc-6f5ff824f8d9",
                                                "sense_id": "06783d8d-043a-3df5-9ef0-e19eba235974",
                                                "text": "In Karelien wird heute kaum noch Karelisch gesprochen."
                                            },
                                            {
                                                "example_id": "aaf2b1af-e1c5-46cb-a3cf-be179459ce7b",
                                                "sense_id": "06783d8d-043a-3df5-9ef0-e19eba235974",
                                                "text": "Das weckt Erinnerungen an Bilder aus dem Geschichtsunterricht und historischen Wochenschauen: Stalins Angriff auf Finnland, Winterkrieg 1939/40, das tief verschneite Karelien, Soldaten auf Skiern, Gewehre über den Rücken."
                                            },
                                            {
                                                "example_id": "2f4dec9a-e485-4ab4-9f1d-48ad94008dcb",
                                                "sense_id": "06783d8d-043a-3df5-9ef0-e19eba235974",
                                                "text": "Die nordosteuropäische Region Karelien, die heute zwischen Finnland und Russland aufgeteilt ist, gilt als die Wiege der Rauchsauna."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ce383bc-8c87-35ea-88c6-2935c1b6026a",
                                        "entry_id": "34dda74d-d26b-372e-a965-accd6547f642",
                                        "glosses": [
                                            "Republik innerhalb der Russischen Föderation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb74e865-ea0a-42f7-8e20-f6aa31d3d2fa",
                                                "sense_id": "7ce383bc-8c87-35ea-88c6-2935c1b6026a",
                                                "text": "Die Republik Karelien wurde am 21. Mai 1992 innerhalb der Russischen Föderation gegründet."
                                            },
                                            {
                                                "example_id": "165f6f79-4a18-426d-a381-75cdb9be2e3e",
                                                "sense_id": "7ce383bc-8c87-35ea-88c6-2935c1b6026a",
                                                "text": "In der Republik Karelien sind die Sprachen Finnisch, Karelisch, Russisch und Wepsisch offiziell zugelassen."
                                            },
                                            {
                                                "example_id": "52fae5e5-b6d3-4308-8f5d-232f40591ebb",
                                                "sense_id": "7ce383bc-8c87-35ea-88c6-2935c1b6026a",
                                                "text": "Nun droht die Plünderung durch finnische Papier- und Holzkonzerne. Besonders betroffen ist der rund 800 Kilometer lange Grenzabschnitt zwischen Finnland und der Republik Karelien."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
