                "senses": [
                    {
                        "sense_id": "364463bb-96e5-3a48-8b14-c41edacd3856",
                        "entry_id": "936b8af6-dc7f-3026-ae09-b8254115c132",
                        "glosses": [
                            "Relatif à la contreculture des hippies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79f65587-5136-462c-98dc-d36453a3dc8e",
                                "sense_id": "364463bb-96e5-3a48-8b14-c41edacd3856",
                                "text": "Elle continua néanmoins à sortir avec le musicien, s'autorisant de simples flirts avec les garçons du cours de théâtre, moins nombreux que les filles qui les partageaient de bonne grâce, une polyandrie de circonstance encouragée par la philosophie hippie."
                            },
                            {
                                "example_id": "583af6da-11d8-4c54-bfd0-4957767f3537",
                                "sense_id": "364463bb-96e5-3a48-8b14-c41edacd3856",
                                "text": "Culture hippie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cc02818-bba8-4a3a-847c-ed2cffd69b6c",
                        "source_entry_id": "936b8af6-dc7f-3026-ae09-b8254115c132",
                        "source_sense_id": "364463bb-96e5-3a48-8b14-c41edacd3856",
                        "target_lang_word": "hippiehaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hippiehaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f88e4cc9-53a8-381f-aec5-f2438d7be59b",
                                        "entry_id": "388216c0-6240-36b2-a906-f881f0287532",
                                        "glosses": [
                                            "nach der Art von oder vergleichbar mit einem Hippie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14be2ff7-f515-4df9-871e-341040750003",
                                                "sense_id": "f88e4cc9-53a8-381f-aec5-f2438d7be59b",
                                                "text": "„Julie sah hippiehaft aus und machte ganz schön was her.“"
                                            },
                                            {
                                                "example_id": "385cbe67-f731-45fd-9220-922767a98533",
                                                "sense_id": "f88e4cc9-53a8-381f-aec5-f2438d7be59b",
                                                "text": "„In dem ausladenden Aufzug sah sie noch hippiehafter aus als die Angeklagten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3d6ba6f-0e6d-4f42-81f5-ae591d9ac150",
                        "source_entry_id": "936b8af6-dc7f-3026-ae09-b8254115c132",
