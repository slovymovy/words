{
    "word_family": [
        "silliness",
        "sillily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "714b50ad-24db-37ec-9b48-d7b2a81a4256",
                    "sense_definition": "Laughable or amusing through foolishness or a playful appearance.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "foolishness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were laughing at a <w>silly</w> joke during the party.",
                            "target_lang_translations": {
                                "ru": "Дети смеялись над <w>глупой</w> шуткой во время праздника."
                            }
                        },
                        {
                            "text": "He had a <w>silly</w> grin on his face after winning the game.",
                            "target_lang_translations": {
                                "ru": "После победы в игре на его лице была <w>дурашливая</w> ухмылка."
                            }
                        }
                    ],
                    "synonyms": [
                        "charming"
                    ],
                    "common_phrases": [
                        "silly joke",
                        "silly grin",
                        "silly walk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смешной или забавный из-за глупости или игривого вида."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глупый",
                                "target_lang_sense_clarification": "в значении забавный или несерьезный"
                            },
                            {
                                "target_lang_word": "дурашливый",
                                "target_lang_sense_clarification": "склонный к шуткам и забавам"
                            },
                            {
                                "target_lang_word": "нелепый",
                                "target_lang_sense_clarification": "вызывающий смех своим видом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "894dfbb1-46d5-3515-9139-aa2526e134a7",
                    "sense_definition": "Showing a lack of good judgment or common sense; thoughtless.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "foolishness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>silly</w> mistake to leave your keys inside the car.",
                            "target_lang_translations": {
                                "ru": "Это была <w>глупая</w> ошибка — оставить ключи внутри машины."
                            }
                        },
                        {
                            "text": "Don't be <w>silly</w>, there is no such thing as ghosts in the attic.",
                            "target_lang_translations": {
                                "ru": "Не <w>глупи</w>, на чердаке не бывает никаких привидений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silly mistake",
                        "don't be silly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрирующий отсутствие здравого смысла или рассудительности; безрассудный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глупый",
                                "target_lang_sense_clarification": "неразумный"
                            },
                            {
                                "target_lang_word": "нелепый",
                                "target_lang_sense_clarification": "бессмысленный"
                            },
                            {
                                "target_lang_word": "дурацкий",
                                "target_lang_sense_clarification": "разговорное, о поступках или вещах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "162d5648-49ab-3bec-b73a-9a91cfb79d9e",
                    "sense_definition": "Stupefied, senseless, or dazed, often as a result of a shock or repetitive action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud noise scared me <w>silly</w> when I was walking home alone.",
                            "target_lang_translations": {
                                "ru": "Громкий шум напугал меня до <w>безумия</w>, когда я шел домой один."
                            }
                        },
                        {
                            "text": "He was knocked <w>silly</w> after bumping his head on the low doorway.",
                            "target_lang_translations": {
                                "ru": "Он был <w>оглушен</w>, ударившись головой о низкий дверной проем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scared silly",
                        "knocked silly"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in phrases like 'scared silly' or 'knocked silly'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошеломленный, потерявший сознание или одурманенный, часто в результате шока или повторяющегося действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одуревший",
                                "target_lang_sense_clarification": "потерявший сообразительность"
                            },
                            {
                                "target_lang_word": "обалдевший",
                                "target_lang_sense_clarification": "сильно удивленный или потрясенный"
                            },
                            {
                                "target_lang_word": "полуживой",
                                "target_lang_sense_clarification": "в контексте физического удара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8193d93-b770-38aa-b8f0-1f0328deb87a",
                    "sense_definition": "In cricket, referring to a fielding position very close to the batsman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cricket",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain decided to place a fielder at <w>silly</w> point to pressure the batsman.",
                            "target_lang_translations": {
                                "ru": "Капитан решил поставить полевого игрока в позицию <w>силли</w>-пойнт, чтобы оказать давление на бьющего."
                            }
                        },
                        {
                            "text": "Standing at <w>silly</w> mid-on requires great reflexes and courage.",
                            "target_lang_translations": {
                                "ru": "Нахождение в позиции <w>силли</w>-мид-он требует отличных рефлексов и мужества."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silly point",
                        "silly mid-on"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in cricket-playing regions"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В крикете: позиция полевого игрока, находящаяся очень близко к бьющему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ближний",
                                "target_lang_sense_clarification": "о позиции в крикете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9238ccb-5c3e-3132-aec7-103dde117658",
                    "sense_definition": "Absurdly or ridiculously large, especially regarding price.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He paid a <w>silly</w> price for that vintage car at the auction.",
                            "target_lang_translations": {
                                "ru": "Он заплатил <w>бешеную</w> цену за тот винтажный автомобиль на аукционе."
                            }
                        },
                        {
                            "text": "The company spent a <w>silly</w> amount of money on unnecessary office decorations.",
                            "target_lang_translations": {
                                "ru": "Компания потратила <w>несусветную</w> сумму денег на ненужные украшения для офиса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silly price",
                        "silly money"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to emphasize excess"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Абсурдно или нелепо большой, особенно в отношении цены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бешеный",
                                "target_lang_sense_clarification": "о чрезмерно высокой цене"
                            },
                            {
                                "target_lang_word": "несусветный",
                                "target_lang_sense_clarification": "огромный и нелепый"
                            },
                            {
                                "target_lang_word": "глупый",
                                "target_lang_sense_clarification": "неоправданно большой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2245db0-02ca-3de2-9cb7-e44c8119347b",
                    "sense_definition": "Pious, holy, or good.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_meanings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>silly</w> man spent his days in prayer and contemplation.",
                            "target_lang_translations": {
                                "ru": "<w>Блаженный</w> человек проводил свои дни в молитве и созерцании."
                            }
                        },
                        {
                            "text": "In ancient texts, the term was used to describe <w>silly</w> saints.",
                            "target_lang_translations": {
                                "ru": "В древних текстах этот термин использовался для описания <w>благочестивых</w> святых."
                            }
                        }
                    ],
                    "antonyms": [
                        "pious"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "original meaning of the word"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Благочестивый, святой или добрый (архаичное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блаженный",
                                "target_lang_sense_clarification": "святой, простодушный"
                            },
                            {
                                "target_lang_word": "благочестивый",
                                "target_lang_sense_clarification": "праведный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7302108d-ceb3-38ed-a41f-a7b741b6e8b6",
                    "sense_definition": "A person who acts in a foolish or playful way.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>silly</w>, put your shoes on the right feet.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>глупышкой</w>, надень ботинки на нужные ноги."
                            }
                        },
                        {
                            "text": "The little <w>sillies</w> were running around the garden in their pajamas.",
                            "target_lang_translations": {
                                "ru": "Маленькие <w>глупышки</w> бегали по саду в пижамах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "little silly"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used affectionately"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведет себя глупо или игриво."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глупышка",
                                "target_lang_sense_clarification": "ласковое обращение"
                            },
                            {
                                "target_lang_word": "глупец",
                                "target_lang_sense_clarification": "человек, совершающий глупости"
                            },
                            {
                                "target_lang_word": "дурачок",
                                "target_lang_sense_clarification": "разговорное, часто ласковое"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3871cdcc-cadb-3b16-9938-5adbc99418d7",
                    "sense_definition": "In a <w>silly</w> or foolish manner.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was acting <w>silly</w> just to make the baby laugh.",
                            "target_lang_translations": {
                                "ru": "Он вел себя <w>дурашливо</w>, просто чтобы рассмешить ребенка."
                            }
                        },
                        {
                            "text": "Stop behaving so <w>silly</w> and start focusing on your homework.",
                            "target_lang_translations": {
                                "ru": "Перестань вести себя так <w>глупо</w> и сосредоточься на домашнем задании."
                            }
                        }
                    ],
                    "common_phrases": [
                        "acting silly",
                        "behaving silly"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used instead of 'sillily'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупым или несерьезным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глупо",
                                "target_lang_sense_clarification": "неразумно"
                            },
                            {
                                "target_lang_word": "дурашливо",
                                "target_lang_sense_clarification": "игриво"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}