                        ],
                        "form": "russiennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5bffd0e7-dc8c-3a5d-a762-e0a5454a14fc",
                        "entry_id": "4db4e8d6-b621-3ddd-bd0e-4dc89990251a",
                        "glosses": [
                            "Relatif à la Russie, aux habitants de la Russie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce05466a-1506-46eb-a1a1-bd3bdd4cc756",
                                "sense_id": "5bffd0e7-dc8c-3a5d-a762-e0a5454a14fc",
                                "text": "Toute cette étendue de pays est gouvernée par un Prince nommé communément le Grand Duc, ou Knez de Moscovie, vu que Knez en Russien signifie Duc."
                            },
                            {
                                "example_id": "ec3f3389-7ce6-4696-ae5d-5ae996450f8d",
                                "sense_id": "5bffd0e7-dc8c-3a5d-a762-e0a5454a14fc",
                                "text": "Porohi est un terme Russien qui signifie pierre de roche."
                            },
                            {
                                "example_id": "bb0e47dd-b2ac-4229-94ed-ebaf80890afe",
                                "sense_id": "5bffd0e7-dc8c-3a5d-a762-e0a5454a14fc",
                                "text": "Et pour prévenir aussi par mer toute occasion qui pourrait faire naître quelque mésintelligence entre les deux parties pacifiantes, autant qu’il est possible, on a conclu et résolu que si les vaisseaux de guerre suédois, un ou plusieurs, soit qu’ils soient petits ou grands, passent dorénavant une des forteresses de Sa Majesté Czarienne, ils feront la salve de leur canon, et, ils seront d’abord ressalués de celui de la forteresse russienne ; et vice versa, si les vaisseaux de guerre russiens, un ou plusieurs, soit qu’ils soient petits ou grands, passent dorénavant une des forteresses de Sa Majesté le roi de Suède, ils feront la salve de leur canon, et ils seront d’abord ressalués de celui de la forteresse suédoise."
                            },
                            {
                                "example_id": "f97683b6-c13c-44d1-9ca2-92458c46bdfc",
                                "sense_id": "5bffd0e7-dc8c-3a5d-a762-e0a5454a14fc",
                                "text": "Les Tchétchènes de la République Tchétchène sont Russiens, n’étant pas Russes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a61479b9-4bfa-4a1c-acd8-60c93bd58ab6",
                        "source_entry_id": "4db4e8d6-b621-3ddd-bd0e-4dc89990251a",
                        "source_sense_id": "5bffd0e7-dc8c-3a5d-a762-e0a5454a14fc",
                        "target_lang_word": "российский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "российский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c1ab5bdd-4a3a-3be1-9750-5ee82122677d",
                                        "entry_id": "07f1f5c0-4e44-32a5-962a-b3e6a0f28050",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным Россия [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eff5011-1476-4f3b-b7a6-e58e681f7d72",
                                                "sense_id": "c1ab5bdd-4a3a-3be1-9750-5ee82122677d",
                                                "text": "Российская история."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9da1d330-31b2-3703-bd09-822d646f5f87",
                                        "entry_id": "07f1f5c0-4e44-32a5-962a-b3e6a0f28050",
                                        "glosses": [
                                            "перен. связанный, соотносящийся по значению с существительным Россия [3]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46bc9b7d-d5f1-4680-8499-ef4d115af5d0",
                                                "sense_id": "9da1d330-31b2-3703-bd09-822d646f5f87",
                                                "text": "Российская культура."
                                            },
                                            {
                                                "example_id": "544c478d-f59e-4e21-abed-71966799c85d",
                                                "sense_id": "9da1d330-31b2-3703-bd09-822d646f5f87",
                                                "text": "Небо Российску ты Солнце ясно!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a13f634-e86e-368b-b1a3-f4f5036ae7eb",
                                        "entry_id": "07f1f5c0-4e44-32a5-962a-b3e6a0f28050",
                                        "glosses": [
                                            "имеющий происхождение из России [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11f9c245-e0c6-48fc-a679-352c908c1385",
                                                "sense_id": "5a13f634-e86e-368b-b1a3-f4f5036ae7eb",
                                                "text": "Госпожа N*** происходит из достаточной и довольно знатной российской фамилии N***."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a1c1c6a-29f7-3ece-b7d4-895128ca89b1",
                                        "entry_id": "07f1f5c0-4e44-32a5-962a-b3e6a0f28050",
                                        "glosses": [
                                            "зарегистрированный органами власти России [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9877987f-eab8-4512-aef5-32ab1e48fd74",
                                                "sense_id": "3a1c1c6a-29f7-3ece-b7d4-895128ca89b1",
                                                "text": "Российское гражданство."
                                            },
                                            {
                                                "example_id": "71f046fe-edba-41d0-9786-c60c9dc3fbfd",
                                                "sense_id": "3a1c1c6a-29f7-3ece-b7d4-895128ca89b1",
                                                "text": "Российский паспорт."
                                            },
                                            {
                                                "example_id": "c66ebd45-325f-4c72-bc53-39f4d102ac6f",
                                                "sense_id": "3a1c1c6a-29f7-3ece-b7d4-895128ca89b1",
                                                "text": "Как отмечает Потоцкий, взаимодействие с российскими компаниями учит консультантов гибко применять свои возможности, варьируя их от детального проектирования необходимых процессов до так называемого \"направляющего\" консалтинга, когда основная творческая инициатива по развитию проекта исходит от заказчика."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "757f6945-a968-3d82-9342-61a01351c58f",
                                        "entry_id": "07f1f5c0-4e44-32a5-962a-b3e6a0f28050",
                                        "glosses": [
                                            "изготовленный на территории России"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bf680ca-372a-45f4-bac4-0e4010994d84",
                                                "sense_id": "757f6945-a968-3d82-9342-61a01351c58f",
                                                "text": "Но повысить уровень переработки леса гораздо проще, чем создать российский автомобиль, который сами россияне захотели бы покупать за 10 тыс. долларов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
