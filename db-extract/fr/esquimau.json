                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1f9e451-42ad-3f3b-bb2c-e4026a3b2a00",
                        "entry_id": "ca65a123-204a-3b77-b105-4cb2ed33ec6d",
                        "glosses": [
                            "Relatif au peuple habitant les terres arctiques du Groënland, du Canada, de l’Alaska et de la Sibérie ; à sa langue et sa culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52a8abaf-3df8-4efc-93f0-76b9b16e8fc9",
                                "sense_id": "d1f9e451-42ad-3f3b-bb2c-e4026a3b2a00",
                                "text": "C’est l’histoire d’un bébé esquimau qui deviendra grand et chasseur comme ses ancêtres […]"
                            },
                            {
                                "example_id": "8f288ebb-1539-48f4-9f94-d8d82b265a31",
                                "sense_id": "d1f9e451-42ad-3f3b-bb2c-e4026a3b2a00",
                                "text": "Le petit village esquimau de Shishmaref posé sur un îlot aux confins de l’Alaska s’enfonce dans la mer un peu plus chaque année, victime du réchauffement climatique, et doit déménager sur le continent, au risque de perdre son identité."
                            },
                            {
                                "example_id": "986b6d66-9497-40ce-9ee1-8b5624da666e",
                                "sense_id": "d1f9e451-42ad-3f3b-bb2c-e4026a3b2a00",
                                "text": "Mrs. Paulina Barnett et Madge les suivaient, Madge maniant avec adresse le long fouet esquimau terminé par une lanière de nerf durci."
                            },
                            {
                                "example_id": "359bffd8-aa02-43f4-b241-62c725a3b8c6",
                                "sense_id": "d1f9e451-42ad-3f3b-bb2c-e4026a3b2a00",
                                "text": "Aussi le facteur de saisonnalité qui semble être le moteur de ces déplacements supposés est, en particulier depuis les travaux de M. Mauss sur les sociétés esquimaudes au début du siècle (Mauss, 1906), un axe de recherche important de l’archéologie paléolithicienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd433fb9-fe85-4ad9-bfaa-8a6f76df0360",
                        "source_entry_id": "ca65a123-204a-3b77-b105-4cb2ed33ec6d",
                        "source_sense_id": "d1f9e451-42ad-3f3b-bb2c-e4026a3b2a00",
