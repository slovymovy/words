                        "glosses": [
                            "Armee, die aus freiwillig dienenden Berufs- und Zeitsoldaten besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab3b4941-9733-40d4-bb34-d469b0945b32",
                                "sense_id": "300abd9c-7c1a-3d35-b4de-8ac1efd842db",
                                "text": "„Daraufhin wurde das römische Heer durch Marius zu einer Berufsarmee umgestaltet.“"
                            },
                            {
                                "example_id": "080d53d2-2d4f-49c0-8de3-c4a153acf758",
                                "sense_id": "300abd9c-7c1a-3d35-b4de-8ac1efd842db",
                                "text": "„Äthiopien bekommt eine moderne Berufsarmee, eine Zentralregierung, ein Berufsbeamtentum, einheitliche Gesetze nach dem Vorbild des Code Napoléon, ein neues Steuersystem sowie Straßen, die die Hauptstadt mit allen wichtigen Provinzen verbinden.“"
                            }
                        ],
