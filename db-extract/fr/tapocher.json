                ],
                "senses": [
                    {
                        "sense_id": "11cec5b7-a7fb-3699-b854-b6ae5018e136",
                        "entry_id": "0e9d1555-5d36-36db-953f-1dd7610a643a",
                        "glosses": [
                            "Taper, battre."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "1b69ab7d-de2f-47ec-8f06-fb4afe6d5939",
                                "sense_id": "11cec5b7-a7fb-3699-b854-b6ae5018e136",
                                "text": "Vivement le temps d’aller tapocher sur du métal pour faire oublier les trop nombreuses heures passées loin de la maison durant les périodes des fêtes."
                            },
                            {
                                "example_id": "11bf512a-f893-4359-a2ef-72df0f0adc1b",
                                "sense_id": "11cec5b7-a7fb-3699-b854-b6ae5018e136",
                                "text": "— Vieux chien sale, murmura-t-il quand il eut terminé. J’aurais dû le tapocher un peu plus."
                            },
                            {
                                "example_id": "f03ff3b7-f362-4750-8df4-d259d7110af4",
                                "sense_id": "11cec5b7-a7fb-3699-b854-b6ae5018e136",
                                "text": "Pourquoi après qu'il se soit relevé on continue à tapocher dessus ?"
                            },
                            {
                                "example_id": "a866d59a-eab4-420d-b9cd-ff90cfd9087f",
                                "sense_id": "11cec5b7-a7fb-3699-b854-b6ae5018e136",
                                "text": "Les policiers en beau fusil // Ont sorti menottes et matraques // Et ont tapoché les hippies // À grands coups de jarnac"
                            }
                        ]
                    },
                    {
                        "sense_id": "9a14b26a-fc88-36c0-be12-5e937aa2f31b",
                        "entry_id": "0e9d1555-5d36-36db-953f-1dd7610a643a",
                        "glosses": [
