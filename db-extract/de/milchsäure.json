                        "examples": [
                            {
                                "example_id": "acf97891-7d05-4479-82e7-510e724ac0dd",
                                "sense_id": "e3f24856-b979-33aa-977b-f7e70e9926d3",
                                "text": "Milchsäure kommt im Schweiß, Blut, im Muskelserum, der Niere, Galle und im Speichel vor."
                            },
                            {
                                "example_id": "9550e94c-8467-4ae0-972a-2ef4c6c88ef2",
                                "sense_id": "e3f24856-b979-33aa-977b-f7e70e9926d3",
                                "text": "Die Milchsäure wird im Stoffwechsel durch Vergärung verschiedener Zucker gebildet."
                            },
                            {
                                "example_id": "f17266c6-1602-4508-bd19-4953d522b751",
                                "sense_id": "e3f24856-b979-33aa-977b-f7e70e9926d3",
                                "text": "Die Salze der Milchsäuren heißen Lactate."
                            }
