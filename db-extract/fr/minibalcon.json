                            {
                                "example_id": "9b03fb06-2def-45d3-89fd-4bc43c8518bf",
                                "sense_id": "a76d2ef3-3dd0-3fad-ba8d-de32e42d708e",
                                "text": "Pour les plus aventuriers, 4 cabanes perchées (pour 2 personnes), avec moustiquaires et minibalcons."
                            },
                            {
                                "example_id": "04f4d65e-51af-44f3-8de7-daebb2fd4ccc",
                                "sense_id": "a76d2ef3-3dd0-3fad-ba8d-de32e42d708e",
                                "text": "Nous dormions peu. Et nous nous réveillions au moment où de petits singes couraient sur notre minibalcon, réchauffés par le soleil rouge de l’aube."
                            },
                            {
                                "example_id": "f294bba4-922b-4f8e-b6a8-2f834c6cbc67",
                                "sense_id": "a76d2ef3-3dd0-3fad-ba8d-de32e42d708e",
                                "text": "Maman nous ramenait de chez Ikea où nous avions acheté une minitable et deux minichaises pour les mettre sur le minibalcon-jungle."
                            }
                        ]
                    }
