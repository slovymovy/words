{
    "word_family": [
        "leaning",
        "leanness",
        "leanly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86958981-edab-34ca-8268-c89501309c7b",
                    "sense_definition": "To bend or move the top part of the body or an object in a particular direction away from a vertical position.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_incline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>lean</w> forward to hear what he was whispering in the noisy room.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>наклониться</w> вперед, чтобы расслышать, что он шептал в шумной комнате.",
                                "zh": "在嘈杂的房间里，她不得不向前<w>倾身</w>才能听清他在耳语什么。"
                            }
                        },
                        {
                            "text": "The old wooden fence began to <w>lean</w> dangerously after the heavy storm passed.",
                            "target_lang_translations": {
                                "ru": "Старый деревянный забор начал опасно <w>наклоняться</w> после сильного шторма.",
                                "zh": "暴风雨过后，那道老木栅栏开始危险地<w>倾斜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tilt",
                        "slant",
                        "incline",
                        "bend"
                    ],
                    "common_phrases": [
                        "lean forward",
                        "lean back",
                        "lean out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сгибать верхнюю часть тела или наклонять объект в определенном направлении от вертикального положения.",
                        "zh": "指身体或物体偏离垂直位置，向某个方向倾斜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклоняться",
                                "target_lang_sense_clarification": "двигаться вниз или в сторону"
                            },
                            {
                                "target_lang_word": "наклониться",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾斜",
                                "target_lang_sense_clarification": "物体偏离垂直状态"
                            },
                            {
                                "target_lang_word": "俯身",
                                "target_lang_sense_clarification": "身体向前倾"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9434e6c-7f80-33df-aba9-aac36c28c9cc",
                    "sense_definition": "To rest against or on something for physical support.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt tired and decided to <w>lean</w> against the brick wall while waiting.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал усталость и решил <w>прислониться</w> к кирпичной стене во время ожидания.",
                                "zh": "他觉得累了，等待时决定<w>靠</w>在砖墙上。"
                            }
                        },
                        {
                            "text": "Please do not <w>lean</w> on the glass door because it might break under pressure.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>опирайтесь</w> на стеклянную дверь, так как она может разбиться под давлением.",
                                "zh": "请不要<w>靠</w>在玻璃门上，它可能会因受压而破裂。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rest",
                        "prop",
                        "recline",
                        "tilt"
                    ],
                    "common_phrases": [
                        "lean against",
                        "lean on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полагаться на кого-либо или что-либо в поисках помощи, поддержки или утешения.",
                        "zh": "身体倚靠在某物上以获得支撑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полагаться",
                                "target_lang_sense_clarification": "рассчитывать на кого-то"
                            },
                            {
                                "target_lang_word": "опираться",
                                "target_lang_sense_clarification": "искать поддержку (переносное значение)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "靠",
                                "target_lang_sense_clarification": "身体倚靠"
                            },
                            {
                                "target_lang_word": "倚",
                                "target_lang_sense_clarification": "倚靠在某物上"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9434e6c-7f80-33df-aba9-aac36c28c9cc",
                    "sense_definition": "To rely on someone or something for help, support, or comfort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can always <w>lean</w> on your family and friends during difficult times.",
                            "target_lang_translations": {
                                "ru": "Ты всегда можешь <w>положиться</w> на семью и друзей в трудные времена.",
                                "zh": "在困难时期，你总可以<w>依靠</w>你的家人和朋友。"
                            }
                        },
                        {
                            "text": "The team had to <w>lean</w> heavily on their manager to get the project finished.",
                            "target_lang_translations": {
                                "ru": "Команде пришлось сильно <w>полагаться</w> на своего менеджера, чтобы завершить проект.",
                                "zh": "团队不得不严重<w>依赖</w>他们的经理来完成这个项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rely",
                        "depend",
                        "count on"
                    ],
                    "common_phrases": [
                        "lean on someone",
                        "lean heavily on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полагаться на кого-либо или что-либо в поисках помощи, поддержки или утешения.",
                        "zh": "依靠某物以获得物理支撑，或在精神上依赖某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полагаться",
                                "target_lang_sense_clarification": "рассчитывать на кого-то"
                            },
                            {
                                "target_lang_word": "опираться",
                                "target_lang_sense_clarification": "искать поддержку (переносное значение)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "靠",
                                "target_lang_sense_clarification": "身体接触支撑物"
                            },
                            {
                                "target_lang_word": "依靠",
                                "target_lang_sense_clarification": "依赖某人或某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ed47937-9930-3394-92c6-fc7534a7ba35",
                    "sense_definition": "To tend toward a particular opinion, preference, or course of action.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "opinion_tendency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am starting to <w>lean</w> towards the second option we discussed yesterday.",
                            "target_lang_translations": {
                                "ru": "Я начинаю <w>склоняться</w> к второму варианту, который мы обсуждали вчера.",
                                "zh": "我开始<w>倾向</w>于我们昨天讨论的第二个方案。"
                            }
                        },
                        {
                            "text": "Most voters in this district <w>lean</w> towards the democratic candidate in local elections.",
                            "target_lang_translations": {
                                "ru": "Большинство избирателей в этом округе <w>склоняются</w> к кандидату от демократов на местных выборах.",
                                "zh": "在这个选区，大多数选民在地方选举中<w>偏向</w>民主党候选人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tend",
                        "incline",
                        "favor"
                    ],
                    "common_phrases": [
                        "lean towards",
                        "lean toward"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склоняться к определенному мнению, предпочтению или курсу действий.",
                        "zh": "在观点、偏好或行动上倾向于某一方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склоняться",
                                "target_lang_sense_clarification": "иметь тенденцию или предпочтение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾向",
                                "target_lang_sense_clarification": "思想或态度上的偏向"
                            },
                            {
                                "target_lang_word": "偏向",
                                "target_lang_sense_clarification": "支持某一方"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4179843e-7346-3d2a-a6a8-52a0802aff5a",
                    "sense_definition": "Thin and healthy in appearance; without much body fat.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "thin_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runner had a <w>lean</w> body built for speed and long-distance endurance.",
                            "target_lang_translations": {
                                "ru": "У бегуна было <w>поджарое</w> тело, созданное для скорости и выносливости на длинных дистанциях.",
                                "zh": "这位跑步者有着一副为速度和长距离耐力而生的<w>精瘦</w>体格。"
                            }
                        },
                        {
                            "text": "He stayed <w>lean</w> and fit by exercising every morning before going to work.",
                            "target_lang_translations": {
                                "ru": "Он оставался <w>стройным</w> и подтянутым, тренируясь каждое утро перед работой.",
                                "zh": "他每天上班前锻炼，保持着<w>精瘦</w>健康的体态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slim",
                        "slender",
                        "thin",
                        "fit"
                    ],
                    "common_phrases": [
                        "lean and fit",
                        "long and lean"
                    ],
                    "target_lang_definitions": {
                        "ru": "Худой и здоровый на вид; без лишнего жира.",
                        "zh": "指人身体瘦削且健康，没有多余的脂肪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поджарый",
                                "target_lang_sense_clarification": "стройный и мускулистый"
                            },
                            {
                                "target_lang_word": "стройный",
                                "target_lang_sense_clarification": "хорошего телосложения"
                            },
                            {
                                "target_lang_word": "сухощавый",
                                "target_lang_sense_clarification": "худощавый, без жира"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精瘦",
                                "target_lang_sense_clarification": "瘦而结实"
                            },
                            {
                                "target_lang_word": "苗条",
                                "target_lang_sense_clarification": "身材匀称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1c36684-0ad7-3f10-b89f-47ff9d844f90",
                    "sense_definition": "Containing little or no fat (used primarily for meat).",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "no_fat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor recommended eating <w>lean</w> meat to help lower his cholesterol levels.",
                            "target_lang_translations": {
                                "ru": "Врач порекомендовал есть <w>постное</w> мясо, чтобы помочь снизить уровень холестерина.",
                                "zh": "医生建议吃<w>瘦</w>肉以帮助降低他的胆固醇水平。"
                            }
                        },
                        {
                            "text": "We bought some <w>lean</w> ground beef to make healthy burgers for dinner.",
                            "target_lang_translations": {
                                "ru": "Мы купили <w>нежирный</w> говяжий фарш, чтобы приготовить полезные бургеры на ужин.",
                                "zh": "我们买了一些<w>精</w>牛肉馅来做健康的晚餐汉堡。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lean meat",
                        "lean beef",
                        "lean cut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий мало жира или совсем без него (обычно о мясе).",
                        "zh": "指肉类脂肪含量很少或没有脂肪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постный",
                                "target_lang_sense_clarification": "о мясе или пище"
                            },
                            {
                                "target_lang_word": "нежирный",
                                "target_lang_sense_clarification": "с низким содержанием жира"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瘦",
                                "target_lang_sense_clarification": "指肉类不肥"
                            },
                            {
                                "target_lang_word": "精",
                                "target_lang_sense_clarification": "指肉类去除了肥肉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0adda192-deca-3d94-9f59-fb414a0725be",
                    "sense_definition": "Efficient and economic; using few resources to achieve a goal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "efficient_business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory adopted <w>lean</w> manufacturing methods to reduce waste and increase profits.",
                            "target_lang_translations": {
                                "ru": "Завод внедрил методы <w>бережливого</w> производства, чтобы сократить отходы и увеличить прибыль.",
                                "zh": "工厂采用了<w>精益</w>生产方法来减少浪费并增加利润。"
                            }
                        },
                        {
                            "text": "A <w>lean</w> organization can adapt quickly to sudden changes in the global market.",
                            "target_lang_translations": {
                                "ru": "<w>Бережливая</w> организация может быстро адаптироваться к внезапным изменениям на мировом рынке.",
                                "zh": "一个<w>精简</w>的组织能够迅速适应全球市场的突变。"
                            }
                        }
                    ],
                    "synonyms": [
                        "efficient",
                        "streamlined"
                    ],
                    "common_phrases": [
                        "lean manufacturing",
                        "lean management",
                        "lean startup"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эффективный и экономичный; использующий минимум ресурсов для достижения цели.",
                        "zh": "指通过精简资源配置来提高效率和经济效益。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бережливый",
                                "target_lang_sense_clarification": "термин в бизнесе (бережливое производство)"
                            },
                            {
                                "target_lang_word": "эффективный",
                                "target_lang_sense_clarification": "оптимизированный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精简",
                                "target_lang_sense_clarification": "减少冗余以提高效率"
                            },
                            {
                                "target_lang_word": "高效",
                                "target_lang_sense_clarification": "资源利用率高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03e97d31-5dd3-30b5-bd77-43a41b6ddb77",
                    "sense_definition": "Lacking money, food, or abundance; difficult or scarce.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scarcity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company faced some <w>lean</w> years before finally becoming profitable again.",
                            "target_lang_translations": {
                                "ru": "Компания пережила несколько <w>тяжелых</w> лет, прежде чем снова стать прибыльной.",
                                "zh": "公司在最终重新盈利之前，经历了几年的<w>艰难</w>岁月。"
                            }
                        },
                        {
                            "text": "Farmers are worried about a <w>lean</w> harvest this autumn due to the summer drought.",
                            "target_lang_translations": {
                                "ru": "Фермеры обеспокоены <w>скудным</w> урожаем этой осенью из-за летней засухи.",
                                "zh": "由于夏季干旱，农民们担心今年秋天的收成会很<w>贫乏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "meager",
                        "scarce",
                        "scanty"
                    ],
                    "antonyms": [
                        "rich"
                    ],
                    "common_phrases": [
                        "lean years",
                        "lean times",
                        "lean harvest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий недостаток денег, еды или изобилия; трудный или скудный.",
                        "zh": "指资源匮乏、生活艰难或收成不佳的时期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скудный",
                                "target_lang_sense_clarification": "недостаточный"
                            },
                            {
                                "target_lang_word": "бедный",
                                "target_lang_sense_clarification": "небогатый ресурсами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贫乏",
                                "target_lang_sense_clarification": "资源不足"
                            },
                            {
                                "target_lang_word": "艰难",
                                "target_lang_sense_clarification": "指时期困苦"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc41054d-5358-3b29-9d62-a08ee86b4ca1",
                    "sense_definition": "The part of meat that consists of muscle and has little or no fat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no_fat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully cut the white fat off the steak and ate only the <w>lean</w>.",
                            "target_lang_translations": {
                                "ru": "Он аккуратно срезал белый жир со стейка и съел только <w>мякоть</w>.",
                                "zh": "他小心地切掉牛排上的白油，只吃了<w>瘦肉</w>。"
                            }
                        },
                        {
                            "text": "Some people prefer the flavor of fat, while others only want the <w>lean</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторым нравится вкус жира, в то время как другие хотят только <w>постное мясо</w>.",
                                "zh": "有些人喜欢肥肉的味道，而另一些人只想要<w>瘦肉</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть мяса, состоящая из мышц и содержащая мало или совсем не содержащая жира.",
                        "zh": "肉中肌肉的部分，几乎不含脂肪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постное мясо",
                                "target_lang_sense_clarification": "мясо без жира"
                            },
                            {
                                "target_lang_word": "мякоть",
                                "target_lang_sense_clarification": "чистое мясо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瘦肉",
                                "target_lang_sense_clarification": "肉的瘦的部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53f9522f-215e-384e-bfda-db42d30f6816",
                    "sense_definition": "A deviation or inclination away from a vertical position.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_incline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old barn has a noticeable <w>lean</w> to the left because the foundation is sinking.",
                            "target_lang_translations": {
                                "ru": "У старого сарая заметный <w>крен</w> влево, потому что фундамент проседает.",
                                "zh": "由于地基下沉，那个旧谷仓明显向左<w>倾斜</w>。"
                            }
                        },
                        {
                            "text": "You can see the <w>lean</w> of the trees caused by the constant prevailing wind.",
                            "target_lang_translations": {
                                "ru": "Можно увидеть <w>наклон</w> деревьев, вызванный постоянным преобладающим ветром.",
                                "zh": "你可以看到由于常年盛行风导致的树木<w>斜度</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tilt",
                        "slant",
                        "inclination"
