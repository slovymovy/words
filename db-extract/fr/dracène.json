                    },
                    {
                        "form_id": "5de98fdd-c5ea-474e-8f80-f46b2a29a8a0",
                        "entry_id": "9d0d822e-2d29-3fc9-ae79-2bcb8d3e9c7e",
                        "tags": [
                            "masculine"
                        ],
                        "form": "dragon"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "97bb5e10-ead8-3772-bd31-eba3ecd36202",
                        "entry_id": "9d0d822e-2d29-3fc9-ae79-2bcb8d3e9c7e",
                        "glosses": [
                            "Dragonne ; dragon femelle."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "f3019fe4-4637-48ea-b5b0-bfd49c109eec",
                                "sense_id": "97bb5e10-ead8-3772-bd31-eba3ecd36202",
                                "text": "Un poème du VIIᵉ siècle conte la venue du dieu à Pythô, l’Hymne homérique à Apollon : après sa naissance, le dieu cherche un sanctuaire digne de lui et se fixe à Delphes où il tue de ses flèches un dragon, ennemi de la lumière, ou plutôt une dracène, que la Terre a suscitée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3860e13-2685-4f3b-903e-a976eabe0580",
                        "source_entry_id": "9d0d822e-2d29-3fc9-ae79-2bcb8d3e9c7e",
                        "source_sense_id": "97bb5e10-ead8-3772-bd31-eba3ecd36202",
                        "target_lang_word": "Drachin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drachin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b5702b4-6efd-3898-9ea6-c53606fcd6d6",
                                        "entry_id": "0cb23385-8474-3ad0-a56d-ea9220ee344e",
                                        "glosses": [
                                            "weiblicher Drache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d7c86e-7557-45c6-bb80-65d507dfc0c6",
                                                "sense_id": "6b5702b4-6efd-3898-9ea6-c53606fcd6d6",
                                                "text": "Die Drachin lag vor ihrer Höhle und kaute auf einem Hirsch herum, den sie sich zuvor gefangen hatte."
                                            },
                                            {
                                                "example_id": "fe6eb6b7-b233-45f1-97a4-f11edb507ee7",
                                                "sense_id": "6b5702b4-6efd-3898-9ea6-c53606fcd6d6",
                                                "text": "„Das Mädchen sah zu der Drachin auf, die entrüstet die Schwingen zusammenfaltete.“"
                                            },
                                            {
                                                "example_id": "d52229c6-10a4-4133-94c6-d8fde010fb59",
                                                "sense_id": "6b5702b4-6efd-3898-9ea6-c53606fcd6d6",
                                                "text": "„Die Tötung der Drachin hat somit, zumindest auf den zweiten Blick, durchaus auch eine kosmische Dimension.“"
                                            },
                                            {
                                                "example_id": "fa5bab11-456b-465b-90fd-786eb5487617",
                                                "sense_id": "6b5702b4-6efd-3898-9ea6-c53606fcd6d6",
                                                "text": "„Der alte Yen erschauerte, dachte zurück an die Mönche, ihre Leichen, ihr großes Versagen; und beobachtete das Meer mit verzweifelter Besorgnis, weil er damit rechnete, die Drachin noch einmal hervorbrechen zu sehen.“"
                                            },
                                            {
                                                "example_id": "789d3ff1-6a46-4f90-9c9b-3c0bdddfddcf",
                                                "sense_id": "6b5702b4-6efd-3898-9ea6-c53606fcd6d6",
                                                "text": "„Nun kann der chinesische Drache als Befruchter, als Vermittler von Gestalt, auch Familie haben, die europäische Drachin dagegen ist eine notorische Einzelgängerin, nimmt weder selbst definitive Gestalt an, noch gibt sie sie weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dc6026e-f44f-428f-9ec3-cccb3472dd51",
                        "source_entry_id": "9d0d822e-2d29-3fc9-ae79-2bcb8d3e9c7e",
                        "source_sense_id": "97bb5e10-ead8-3772-bd31-eba3ecd36202",
                        "target_lang_word": "dragoness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dragoness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "782e9f28-df34-3ba9-9a45-5b351d4ce4fa",
                                        "entry_id": "313de550-bda9-3a62-a122-00a2a0b7797d",
                                        "glosses": [
                                            "A female dragon."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46c94943-4471-433c-8afd-1a1a144e0a35",
                                                "sense_id": "782e9f28-df34-3ba9-9a45-5b351d4ce4fa",
                                                "text": "The King Apollo, with an arrow, freed / From his strong string, destroy’d the Dragoness"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4058129-e6d4-38dc-aaef-8a5c12ac77eb",
                                        "entry_id": "313de550-bda9-3a62-a122-00a2a0b7797d",
                                        "glosses": [
                                            "A female dragon."
                                        ],
                                        "tags": [
                                            "especially",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ea0ffa1-ddec-4c1f-a6f0-787d54170939",
                                                "sense_id": "f4058129-e6d4-38dc-aaef-8a5c12ac77eb",
                                                "text": "But what really catches my attention about this dragoness is her thick tail, which looks to be twice as thick as a normal dragon tail. And I really don't know how to say this, except to say that this dragoness is seriously luscious. Maybe that's a terrible thing to say because I'm dying and all, but there it is. This is one seriously juicy-looking dragonette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
