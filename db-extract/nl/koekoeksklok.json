                    {
                        "sense_id": "b04a081a-3aa6-3ed3-820e-95ee9bfa6d1a",
                        "entry_id": "2b0c6e19-2285-3200-ab58-44cfc889af3e",
                        "glosses": [
                            "een type klok die het geluid van de koekoek als uursignaal heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "752523d5-4bc8-481a-83cf-ec43bfc9131f",
                                "sense_id": "b04a081a-3aa6-3ed3-820e-95ee9bfa6d1a",
                                "text": "De koekoeksklok is een erfstuk van mijn opa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b15b7669-baae-429c-9fef-0650b32c8b1e",
                        "source_entry_id": "2b0c6e19-2285-3200-ab58-44cfc889af3e",
                        "source_sense_id": "b04a081a-3aa6-3ed3-820e-95ee9bfa6d1a",
                        "source_sense_description": "klok",
                        "target_lang_word": "Kuckucksuhr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kuckucksuhr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c111d64-af15-3ae4-bd2e-100afeb9819f",
                                        "entry_id": "c0c8a975-2bf6-3867-a84f-639beff678f6",
                                        "glosses": [
                                            "zumeist kunstvoll gestaltete Wanduhr, bei der zu jeder halben und vollen Stunde eine Kuckucksfigur von einem Kuckucksruf begleitet aus einer sich öffnenden Tür hervorspringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ae5534-d36c-463f-b043-188f884fcacc",
                                                "sense_id": "1c111d64-af15-3ae4-bd2e-100afeb9819f",
                                                "text": "Als Kinder waren wir stets gern bei Großvater zu Gast, da in seinem Wohnzimmer eine liebliche Kuckucksuhr hing, die uns immer wieder zu erfreuen vermochte."
                                            },
                                            {
                                                "example_id": "5171b4f0-bbc4-4c92-ad99-450d78f40361",
                                                "sense_id": "1c111d64-af15-3ae4-bd2e-100afeb9819f",
                                                "text": "„Die kaputte Kuckucksuhr meiner Großmutter habe ich auch geerbt.“"
                                            },
                                            {
                                                "example_id": "8688b822-0bcd-429a-8ba2-d8af0608e3b0",
                                                "sense_id": "1c111d64-af15-3ae4-bd2e-100afeb9819f",
                                                "text": "„Ihnen folgte ein Mann mit einem Holzbein, der eine große Kuckucksuhr trug, deren Gewichte nachschleiften.“"
                                            },
                                            {
                                                "example_id": "1e21f584-ae8b-4fad-87ab-9c43a16a8000",
                                                "sense_id": "1c111d64-af15-3ae4-bd2e-100afeb9819f",
                                                "text": "„Mein Blick wanderte zu seinen dunklen Augen hinter der Brille, und ich stockte einen Moment, als im gleichen Augenblick Amalias alte Kuckucksuhr, die schon lange nicht mehr richtig funktionierte, zu rufen begann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8ff805c-805d-426d-8caa-0224ceb357d3",
                        "source_entry_id": "2b0c6e19-2285-3200-ab58-44cfc889af3e",
                        "source_sense_id": "b04a081a-3aa6-3ed3-820e-95ee9bfa6d1a",
                        "source_sense_description": "klok",
                        "target_lang_word": "cuckoo clock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuckoo clock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67ff3024-2cb0-3733-8cdf-912de2788d48",
                                        "entry_id": "6344c5a6-e4b8-3f9b-a2c8-d6c4269a1040",
                                        "glosses": [
                                            "A clock that announces the time (hours and quarter hours) by a cuckoo sound, often equipped with a small cuckoo automaton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81d8a758-f942-49ed-bcc2-3f032eb362b3",
                                                "sense_id": "67ff3024-2cb0-3733-8cdf-912de2788d48",
                                                "text": "In Italy, for thirty years under the Borgias, they had warfare, terror, murder, bloodshed, but they produced Michelangelo, Leonardo da Vinci, and the Renaissance… In Switzerland, they had brotherly love. They had five hundred years of democracy and peace, and what did that produce?… The cuckoo clock. So long, Holly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
