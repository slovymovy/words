                "senses": [
                    {
                        "sense_id": "063fed45-9517-3480-b31d-cd6c88d56b09",
                        "entry_id": "d5fc1b83-6042-360f-9d13-05520b9af742",
                        "glosses": [
                            "geschlossener, mit Fenstern versehener Vorbau an einem Gebäude, zum Beispiel einer Kirche oder einer Burg, der als eigener kleinerer geistlicher Raum (Kapelle) oder dessen Chorraum dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eda7680-5d92-4f59-b4cc-68bd38473053",
                                "sense_id": "063fed45-9517-3480-b31d-cd6c88d56b09",
                                "text": "„Der Kapellenerker im zweiten Obergeschoss ist aus Sandsteinquadern erbaut und sitzt auf drei Granitkonsolen, die durch Wappen verziert sind.“"
                            },
                            {
                                "example_id": "eb8bc9a4-97bf-4546-bcff-f4dcbda73a4d",
                                "sense_id": "063fed45-9517-3480-b31d-cd6c88d56b09",
                                "text": "„Ein Kapellenerker ist die nach außen sichtbare Erweiterung eines eigenständigen Hauskapellenraumes.“"
                            },
                            {
                                "example_id": "475865dc-b94e-4bc4-8835-f91255e3dde1",
                                "sense_id": "063fed45-9517-3480-b31d-cd6c88d56b09",
                                "text": "„Im 1. Obergeschoss ragt ein Kapellenerker aus Sandsteinquadern vor, zum Turm hin sind Aborterker im 1. und 2. Obergeschoss versetzt auf Konsolen angebracht.“"
                            },
                            {
                                "example_id": "59ae6cca-6af9-4945-8d37-a25b9b72a1a7",
                                "sense_id": "063fed45-9517-3480-b31d-cd6c88d56b09",
                                "text": "„Die Reichskleinodien werden nämlich seit 1967 nahezu unverändert im Kapellenerker des Krönungssaals gezeigt.“"
                            },
                            {
                                "example_id": "dffd5599-c0e5-4155-920c-8d7402794313",
                                "sense_id": "063fed45-9517-3480-b31d-cd6c88d56b09",
                                "text": "„Das Schmuckstück der Burg ist der gotische Kapellenerker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
