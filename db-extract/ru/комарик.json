                                        "sense_id": "82b04d4e-5ca3-31f9-aca0-0108d8e0415c",
                                        "entry_id": "7d812fef-7a3f-342a-9db7-4e8da7b25255",
                                        "glosses": [
                                            "Any bait or lure designed to resemble a midge."
                                        ],
                                        "tags": [],
