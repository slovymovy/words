                        "glosses": [
                            "Chanteuse ou chanteur dont la tessiture s'établit entre les voix de soprano et alto."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7fe10d7-c344-480f-9321-b53105cb7767",
                                "sense_id": "f07956af-277e-3d8c-9d53-eef4823f8a82",
                                "text": "C'est une mezzo internationalement reconnue."
                            },
                            {
                                "example_id": "8141dba9-fd7d-49e8-b6e1-ef5d3851b8bc",
                                "sense_id": "f07956af-277e-3d8c-9d53-eef4823f8a82",
                                "text": "[M. Dédé] ne se gêne pas pour leur envoyer que le mezzo a meuglé comme une vache et que le fameux Robichon, qui se croit ténor, ce n’est qu’un trial qui gueule."
                            }
                        ]
