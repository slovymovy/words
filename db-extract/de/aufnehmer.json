                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "20ac157f-127e-3528-b9d0-79f2db6beaef",
                        "entry_id": "1458eb1e-a022-3555-b2cf-6c65e10e0b74",
                        "glosses": [
                            "Befestigung von Werkstücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32b7e572-a778-4cb3-b7c6-8c7eed913977",
                                "sense_id": "20ac157f-127e-3528-b9d0-79f2db6beaef",
                                "text": "„Das Einbringen des Schlauches in den Aufnehmer muss mit einer Hand möglich sein.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
