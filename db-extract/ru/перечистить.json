                "senses": [
                    {
                        "sense_id": "8e0d3ad0-e4ac-31a8-92c8-9e0228ca9c45",
                        "entry_id": "07548013-057b-3509-bb66-bb5ac47e23fc",
                        "glosses": [
                            "вычистить, освободив от грязи, пыли, всё или многое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b1a5c0b-c848-4df9-801f-224a6475247f",
                                "sense_id": "8e0d3ad0-e4ac-31a8-92c8-9e0228ca9c45",
                                "text": "Первым делом она всё перемыла да перечистила ― самовары, рукомойник медный, таз (любила, чтобы все в избе горело), ― затем принялась за просушку нарядов."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc645bd9-9079-326b-b6cf-25813e561ac4",
                        "entry_id": "07548013-057b-3509-bb66-bb5ac47e23fc",
                        "glosses": [
                            "вычистить, освободив от грязи, пыли, заново, ещё раз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cff8e3c3-3079-4bd7-822d-666eed8e0c84",
                                "sense_id": "dc645bd9-9079-326b-b6cf-25813e561ac4",
                                "text": "Не один раз, без всякой надобности, были вымыты стволы, перечищены и перемазаны замки."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2df20ee-45f1-3d32-880e-9a8de174044a",
                        "entry_id": "07548013-057b-3509-bb66-bb5ac47e23fc",
                        "glosses": [
                            "очистить от кожи, скорлупы всё или многое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51307caa-2e53-47fe-b025-4ae9aa6816f2",
                                "sense_id": "d2df20ee-45f1-3d32-880e-9a8de174044a",
                                "text": "Когда рыба была уже перечищена и Михайло наливал в большущий чугун воду, пришли и рыболовы."
                            },
                            {
                                "example_id": "5b6c2da3-57b6-4fc0-b19c-e02e09d33597",
                                "sense_id": "d2df20ee-45f1-3d32-880e-9a8de174044a",
                                "text": "Сколько я перечистила рыбы за свою жизнь, трудно вспомнить!"
                            }
                        ]
                    }
                ],
