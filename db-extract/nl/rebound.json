                                "target_senses": [
                                    {
                                        "sense_id": "380310a7-e993-3a1b-9809-5594e9101878",
                                        "entry_id": "afe9f19a-612c-3b81-9963-bfbee8f88f99",
                                        "glosses": [
                                            "The recoil of an object bouncing off another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10e0d74d-c94e-3d56-832f-c0345f442240",
                                        "entry_id": "afe9f19a-612c-3b81-9963-bfbee8f88f99",
                                        "glosses": [
                                            "A return to health or well-being; a recovery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbc31797-b5c1-4b0e-a6a0-4b28dbb274a3",
                                                "sense_id": "10e0d74d-c94e-3d56-832f-c0345f442240",
                                                "text": "I am on the rebound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d9e731d-769c-333e-9148-19e73f13bf2b",
                                        "entry_id": "afe9f19a-612c-3b81-9963-bfbee8f88f99",
                                        "glosses": [
                                            "An effort to recover from a setback."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5854fb42-6c02-3ebe-859f-20d005fbb2b2",
                                        "entry_id": "afe9f19a-612c-3b81-9963-bfbee8f88f99",
                                        "glosses": [
                                            "The period of getting over a recently ended romantic relationship."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16f8f530-f2cb-4209-a912-bc865b93aa18",
                                                "sense_id": "5854fb42-6c02-3ebe-859f-20d005fbb2b2",
                                                "text": "\"I get it. Girl caught him on the rebound when he was vulnerable.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1599dc9-e826-3644-b588-c3ccb2790881",
                                        "entry_id": "afe9f19a-612c-3b81-9963-bfbee8f88f99",
                                        "glosses": [
                                            "A romantic partner with whom one begins a relationship (or the relationship one begins) for the sake of getting over a previous, recently ended romantic relationship."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eec30d07-5d7b-4b01-b58e-34db1689a509",
                                                "sense_id": "b1599dc9-e826-3644-b588-c3ccb2790881",
                                                "text": "What if she was a rebound after all and he didn't feel the same way for her anymore?"
                                            },
                                            {
                                                "example_id": "739487cc-d52d-4290-8cf4-0d737cb338ff",
                                                "sense_id": "b1599dc9-e826-3644-b588-c3ccb2790881",
                                                "text": "Nika was dealt a terrible blow in finding she was a rebound and that Steve was still madly in love with his ex and that their love affair was sparked out of retaliation[.]"
                                            },
                                            {
                                                "example_id": "0f5356ff-77de-4cc7-bc29-354f0606f5b6",
                                                "sense_id": "b1599dc9-e826-3644-b588-c3ccb2790881",
                                                "text": "Sure, he was a rebound, but he was a respectable rebound. Then, the rebound broke up with me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26ff9d65-99d8-3803-a7c0-4716005870e5",
                                        "entry_id": "afe9f19a-612c-3b81-9963-bfbee8f88f99",
                                        "glosses": [
                                            "The strike of the ball after it has bounced off a defending player or the crossbar or goalpost."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93cdd4b4-ecfa-4fc5-accb-d82dcbdbef9b",
                                                "sense_id": "26ff9d65-99d8-3803-a7c0-4716005870e5",
                                                "text": "The inevitable Baggies onslaught followed as substitute Simon Cox saw his strike excellently parried by keeper Bunn, with Cox heading the rebound down into the ground and agonisingly over the bar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "611977b9-a855-33a6-b249-59996de864d7",
                                        "entry_id": "afe9f19a-612c-3b81-9963-bfbee8f88f99",
                                        "glosses": [
                                            "An instance of catching the ball after it has hit the rim or backboard without a basket being scored, generally credited to a particular player."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rebound",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28f2738c-9fe1-38b4-ae0d-65bc55179b9d",
                                        "entry_id": "42188422-2806-3998-99e9-c4f4cc146233",
                                        "glosses": [
                                            "To bound or spring back from a force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "497317e0-892e-4afc-a880-7ef88d679acb",
                                                "sense_id": "28f2738c-9fe1-38b4-ae0d-65bc55179b9d",
                                                "text": "Bodies which are absolutely hard, or so soft as to be void of elasticity, will not rebound from one another."
                                            },
                                            {
                                                "example_id": "699d8fca-7e2c-443b-b603-5173c526d6aa",
                                                "sense_id": "28f2738c-9fe1-38b4-ae0d-65bc55179b9d",
                                                "text": "Martin Kelly fired in a dangerous cross and the Hearts defender looked on in horror as the ball rebounded off him and into the net."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0abd5358-6796-375f-af9f-f6e9e7f1f7c8",
                                        "entry_id": "42188422-2806-3998-99e9-c4f4cc146233",
                                        "glosses": [
                                            "To give back an echo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "519ccf01-0b1d-4e4b-a1bb-baa5dc7996f8",
                                                "sense_id": "0abd5358-6796-375f-af9f-f6e9e7f1f7c8",
                                                "text": "each cave and echoing rock rebounds"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af62aae6-7ffa-3ccf-a0cd-179234b40ed6",
                                        "entry_id": "42188422-2806-3998-99e9-c4f4cc146233",
                                        "glosses": [
                                            "To jump up or get back up again."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d2e0d39-c5a7-4cbf-9551-743d6e4f4b69",
                                                "sense_id": "af62aae6-7ffa-3ccf-a0cd-179234b40ed6",
                                                "text": "“Even after this utter devastation, most people in the Greenwood community, most African Americans in Tulsa said to themselves and to their larger community, ‘we shall not be moved.’ And they rebounded and rebuilt and created an incarnation of Black Wall Street that would surpass its initial version.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bd9550f-f3b9-3034-be79-4aee8699abef",
                                        "entry_id": "42188422-2806-3998-99e9-c4f4cc146233",
                                        "glosses": [
                                            "To send back; to reverberate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97edd22d-0d44-4847-a39f-c0380760858e",
                                                "sense_id": "1bd9550f-f3b9-3034-be79-4aee8699abef",
                                                "text": "Silenus sung; the vales his voice rebound, / And carry to the skies the sacred sound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81dfcfae-e07e-3b64-aaf1-a7f96af78818",
                                        "entry_id": "42188422-2806-3998-99e9-c4f4cc146233",
                                        "glosses": [
                                            "To catch the ball after it has hit the rim or backboard without scoring a basket for the other team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7afc0467-8ab3-4966-92b0-0abd7ecf237e",
                                                "sense_id": "81dfcfae-e07e-3b64-aaf1-a7f96af78818",
                                                "text": "By the mid-19605, the top small forwards in the game were Rick Barry and Iohn Havlicek, both of whom excelled as defenders and passers, rebounded well, and provided their respective teams with exceptional scoring."
                                            },
                                            {
                                                "example_id": "29e4c5ea-e106-4d76-996d-48a3a7e3eebf",
                                                "sense_id": "81dfcfae-e07e-3b64-aaf1-a7f96af78818",
                                                "text": "I knew for sure if Griffin blocked shots and rebounded the basketball my Ravens would become champions."
                                            }
                                        ]
                                    }
                                ]
                            },
