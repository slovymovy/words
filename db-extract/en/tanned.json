                        "examples": [
                            {
                                "example_id": "0ee1ea44-c3af-4b9d-ba66-fea5a930b00e",
                                "sense_id": "5b92a244-3f8c-379e-87bd-3f675f0931f0",
                                "text": "You're looking very tanned."
                            },
                            {
                                "example_id": "28f50740-2f27-43e8-99c7-21084e1dc213",
                                "sense_id": "5b92a244-3f8c-379e-87bd-3f675f0931f0",
                                "text": "tanned bodies lying on the beach"
                            },
                            {
                                "example_id": "d4f82f58-d9fc-4f10-987f-e071538ef1c7",
                                "sense_id": "5b92a244-3f8c-379e-87bd-3f675f0931f0",
                                "text": "Dressed always in jeans, a loose long sleeved top and large brimmed straw beach hat [...] she stood out from the tanned seasoned locals."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a9d1df4-bf5b-3224-a102-d90b77867803",
                        "entry_id": "c6c589c9-294a-346f-a1f5-db9f5cba10f3",
