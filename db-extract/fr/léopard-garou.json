                        "sense_id": "90ba2ed0-4d29-3d9f-81c7-9849c69a7dc5",
                        "entry_id": "ebb7c5e3-845e-31c6-8760-a3f9a642f32d",
                        "glosses": [
                            "Celui qui se transforme d’un être humain en un léopard et vice versa, de façon complète ou partielle."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "92b34a61-691b-48ad-a7d3-d0c2fcf42106",
                                "sense_id": "90ba2ed0-4d29-3d9f-81c7-9849c69a7dc5",
                                "text": "Après les sorciers malfaisants viennent les animaux-garous, représentés ici par des léopards-garous et des panthères-garous."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28826b3f-7de1-4953-a7a7-c7671e7cdb40",
                        "source_entry_id": "ebb7c5e3-845e-31c6-8760-a3f9a642f32d",
