                        "examples": [
                            {
                                "example_id": "9b242742-22f3-4237-80fe-5c383291ae75",
                                "sense_id": "a285a9c9-f5fc-37ea-af04-e167511ea8da",
                                "text": "Что вы тут хай подняли?"
                            }
                        ]
                    },
                    {
                        "sense_id": "09e0e70d-c0e6-316e-80ae-c496ccd47048",
                        "entry_id": "8495aeba-4269-3ebe-9527-402f8fceb3aa",
