                    ],
                    "common_phrases": [
                        "fall short"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не достигая цели или установленного требования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не дотягивать",
                                "target_lang_sense_clarification": "до стандарта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
