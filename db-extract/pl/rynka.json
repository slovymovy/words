                "translations": [
                    {
                        "translation_id": "8ebd7617-eeeb-4f2b-8299-f7a743d14d4f",
                        "source_entry_id": "fc587ef3-67f3-3b18-8f9d-ad669aa44283",
                        "source_sense_id": "697e2782-5d7f-3e4d-9fe9-f54abf38271d",
                        "target_lang_word": "skillet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skillet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b33223bc-b3b6-3f50-abd8-e2e0ee13ae2f",
                                        "entry_id": "212a98a2-3fe8-3ea2-91ab-612256696f16",
                                        "glosses": [
                                            "A large and heavy saucepan or frying pan with legs and, usually, a long handle designed for heating food in a fireplace."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2069e0c5-d982-340b-94cf-a5eeb312b99f",
                                        "entry_id": "212a98a2-3fe8-3ea2-91ab-612256696f16",
                                        "glosses": [
                                            "A pan for frying, generally large and heavy."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce4831e0-9d43-4c6b-9b9f-7a7d8ac559cd",
                                                "sense_id": "2069e0c5-d982-340b-94cf-a5eeb312b99f",
                                                "text": "Heat some oil in a cast-iron skillet and add the onions."
                                            },
                                            {
                                                "example_id": "da21a63d-c366-4a93-b72c-c422611735f6",
                                                "sense_id": "2069e0c5-d982-340b-94cf-a5eeb312b99f",
                                                "text": "Inside this paper plane\nNote my words are Navy sealed\nSo here and I quote\nTaboo and I are in the same boat\nWhat's said from Pennywise\nI guess we all float\nSky is the limit, I could die in a minute\nGot my mind in a skillet\nSuicide not a mission\nSee the vibe very timid\nI'm timid and very sad\nTranslated my thoughts and feelings\nI pivot into the pad"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b144fb6-770d-311c-b8ad-47b587ea3a4d",
                                        "entry_id": "212a98a2-3fe8-3ea2-91ab-612256696f16",
                                        "glosses": [
                                            "A dish or meal cooked in such a pan."
                                        ],
                                        "tags": [
                                            "US",
                                            "attributive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b9de4f-fc17-4c2c-91a8-bd4fd54d237a",
                                                "sense_id": "6b144fb6-770d-311c-b8ad-47b587ea3a4d",
                                                "text": "This is an easy skillet with potatoes and bacon."
                                            },
                                            {
                                                "example_id": "20339542-671d-470b-9183-874d79d0ebdc",
                                                "sense_id": "6b144fb6-770d-311c-b8ad-47b587ea3a4d",
                                                "text": "Can you make up a quick skillet hash?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "skillet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45996dcd-b985-3c2a-9a16-619b6da04586",
                                        "entry_id": "1dc510a1-7b59-3bd3-bdb8-cad87cb9f466",
                                        "glosses": [
                                            "To cook in a skillet."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "496d3e87-06e6-4476-b76f-6178dd87ed42",
                                                "sense_id": "45996dcd-b985-3c2a-9a16-619b6da04586",
                                                "text": "Now that the season has arrived in many parts of the country for the nimrods to load their trusty Thirty-Thirties and go forth in quest of the elusive deer, it seems an appropriate time to say a word about the skilleting of venison — which can be a pretty tough and dry proposition if not properly handled."
                                            },
                                            {
                                                "example_id": "09ffe6d8-7fe3-4ccc-ba54-8f16798ec50f",
                                                "sense_id": "45996dcd-b985-3c2a-9a16-619b6da04586",
                                                "text": "That said, Danton in manhood is probed and skilleted, admired and reviled in a multitude of memoirs written by contemporaries who love him, loathe him or simply stand and watch as the Danton tempest roars past."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5e583c2-1433-497a-9681-39cde68c733f",
                        "source_entry_id": "fc587ef3-67f3-3b18-8f9d-ad669aa44283",
