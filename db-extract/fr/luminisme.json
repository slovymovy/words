                "senses": [
                    {
                        "sense_id": "261ea87b-e247-31b0-9eb9-12ecc272df61",
                        "entry_id": "269584a4-4c81-35b1-bdb1-b06c65f68d24",
                        "glosses": [
                            "Mouvement artistique, en peinture, qui accorde une attention toute particulière à la lumière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f784d3b8-6c65-4623-9c17-bec96400bed7",
                                "sense_id": "261ea87b-e247-31b0-9eb9-12ecc272df61",
                                "text": "Le luminisme hollandais, caractérisé par l’utilisation d’une grande gamme de couleur, est proche de fauvisme."
                            },
                            {
                                "example_id": "c6d00178-a43e-41f9-b15d-61055adf3c94",
                                "sense_id": "261ea87b-e247-31b0-9eb9-12ecc272df61",
                                "text": "Vouet connaît une riche carrière en Italie où il subit d’abord l’influence du luminisme du Caravage puis s’impose à Rome sous Urbain VIII."
                            },
                            {
                                "example_id": "7497a374-e81e-4645-83d3-e84fcb079c23",
                                "sense_id": "261ea87b-e247-31b0-9eb9-12ecc272df61",
                                "text": "Ainsi, on retrouve la majesté de Vénus dominant formellement l’espace, le sfumato retranscrivant les chairs incarnées et le luminisme révélant le décor unifié par la démarche du créateur."
                            }
                        ]
                    }
                ],
