                        "sense_id": "b650c635-807f-37c4-917d-bfbf523645ef",
                        "entry_id": "535d7fe1-402c-3794-893a-328436014c6c",
                        "glosses": [
                            "Rapport d’un travail ou projet de recherche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e13d31b-7ee5-4614-b497-040de75978c0",
                                "sense_id": "b650c635-807f-37c4-917d-bfbf523645ef",
                                "text": "Hier finden Sie eine Liste mit Forschungsberichten zum Thema «Sucht», die vom Bundesamt für Gesundheit finanziert worden sind.",
                                "translation": "Veuillez trouver ci-dessous la liste des rapports de recherche sur le thème de la dépendance, financés par l’Office fédéral de la santé publique."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4b71400-9342-39fb-ace1-a378ca0ae015",
                        "entry_id": "535d7fe1-402c-3794-893a-328436014c6c",
                        "glosses": [
                            "Rapport global sur les activités, les travaux de recherche dans une institution, par exemple une université."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81e87921-8076-4bf6-9268-75f209ed7694",
                                "sense_id": "d4b71400-9342-39fb-ace1-a378ca0ae015",
                                "text": "Das Institut für vergleichende Städtegeschichte erstellt jährlich einen Forschungsbericht über seine Arbeit. Die Berichte werden auf dieser Seite als PDF-Dateien zur Verfügung gestellt.",
                                "translation": "L’Institut d’histoire urbaine comparée établit chaque année un rapport de recherche sur son travail. Les rapports sont mis à disposition sur cette page sous forme de fichiers PDF."
                            }
                        ]
                    }
