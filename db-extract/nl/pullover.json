                                        "glosses": [
                                            "An instance of a vehicle being pulled over."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d727c1ec-708e-4002-a879-28da549a2e0d",
                                                "sense_id": "52c2debe-acf3-332e-80cc-94d823f4066d",
                                                "text": "I followed my training in the academy regarding vehicle pullovers."
                                            }
                                        ]
