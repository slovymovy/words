                "senses": [
                    {
                        "sense_id": "00cb66c6-8cb9-35f0-b4fc-3666cf808603",
                        "entry_id": "22492eae-48e5-3d8f-9b4e-2dde1ed9a4e3",
                        "glosses": [
                            "Qualifier par une épithète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eba23cb6-dcc0-4a45-ab64-2bde52e60306",
                                "sense_id": "00cb66c6-8cb9-35f0-b4fc-3666cf808603",
                                "text": "Vous m’excusez de ne pas vous dire Cher Maître — Je vous aime et vous estime trop pour vous épithétiser de cette banale formule et je ne sais pas!"
                            }
                        ]
                    },
                    {
                        "sense_id": "42c2ca87-be9b-36a6-98a8-f3862281cf18",
                        "entry_id": "22492eae-48e5-3d8f-9b4e-2dde1ed9a4e3",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afc1c530-1ae8-4340-85ec-313c8e7ad988",
                                "sense_id": "42c2ca87-be9b-36a6-98a8-f3862281cf18",
                                "text": "Le malade n'y parvient même plus à nommer la seule différence appellative importante (p.ex.°le garçon marche la boîte), car il reste bloqué sur une totale incapacité d’épithétiser (= de partialiser au sein du terme) les informations qu'il a élaborées à propos de la première image."
                            }
                        ]
                    }
                ],
