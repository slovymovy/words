    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1e96c2ad-36ee-394f-af6d-cdb05d871554",
                    "sense_definition": "Petit instrument à vent qui produit un son aigu lorsqu'on souffle dedans.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arbitre porte un <w>sifflet</w> autour du cou pour arrêter le jeu."
                        },
                        {
                            "text": "Le policier utilise son <w>sifflet</w> pour régler la circulation au carrefour."
                        }
                    ],
                    "common_phrases": [
                        "coup de sifflet"
                    ]
                },
                {
                    "sense_id": "570e043e-e893-396b-8a3e-9eff268af136",
                    "sense_definition": "Son aigu produit par le vent, par un instrument ou en soufflant entre les lèvres.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un <w>sifflet</w> strident a retenti au moment du départ du train."
                        },
                        {
                            "text": "On entendait le <w>sifflet</w> perçant du vent à travers la fenêtre mal fermée."
                        }
                    ],
                    "synonyms": [
                        "sifflement"
                    ]
                },
                {
                    "sense_id": "52d42807-dea9-3784-b8ea-6e4a926b8cc4",
                    "sense_definition": "Manifestation bruyante de mécontentement ou de protestation émise par une foule.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur a quitté le terrain sous les <w>sifflets</w> nourris du public mécontent."
                        },
                        {
                            "text": "Le discours du ministre a été interrompu par une vague de <w>sifflets</w> hostiles."
                        }
                    ],
                    "common_phrases": [
                        "sous les sifflets"
                    ]
                },
                {
                    "sense_id": "c693670b-812d-3ea6-a63f-94bfbb08a65b",
                    "sense_definition": "Gorge ou gosier, principalement employé dans des locutions figurées.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa réponse cinglante lui a coupé net le <w>sifflet</w> devant toute l'assemblée."
                        },
                        {
                            "text": "Cette eau glacée fait un bien fou quand on a le <w>sifflet</w> complètement sec."
                        }
                    ],
                    "common_phrases": [
                        "couper le sifflet",
                        "se rincer le sifflet"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "ed6da63c-ea69-3398-a5b3-6b868fd7e3f3",
                    "sense_definition": "Cri aigu caractéristique émis par certaines espèces d'oiseaux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde forestier sait distinguer le <w>sifflet</w> du merle de celui de la grive."
                        },
                        {
                            "text": "Au crépuscule, le <w>sifflet</w> discret de certains passereaux résonne dans les bois."
                        }
                    ],
                    "synonyms": [
                        "chant"
                    ]
                }
            ]
        }
    ]
