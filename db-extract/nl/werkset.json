                "senses": [
                    {
                        "sense_id": "bfffdb49-3473-3b0c-b316-584458f70073",
                        "entry_id": "ff4503ed-9900-370f-8925-2515345a850a",
                        "glosses": [
                            "verzameling materialen en gereedschappen die je nodig hebt voor een bepaalde taak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abb1a338-c23b-4d60-a996-710a50fa4290",
                                "sense_id": "bfffdb49-3473-3b0c-b316-584458f70073",
                                "text": "Ze bekijken en manipuleren filmpjes, maken tekeningen, animaties, manipuleren stempels en laten de poppen over het scherm dansen. Ze krijgen voldoende beeldmateriaal om mee te starten en een uitgebreide werkset met diverse soorten gereedschap. Daartoe behoren onder andere toverpenselen, allerlei stempels en een elektrische mixer. Een combinatie van deze mogelijkheden levert grappige effecten op, maar het is allemaal eerst even uitproberen vooraleer kunstenaars in spe de finesse in de vingers hebben om er goede resultaten mee te bereiken. De Standaard 23 OKTOBER 2001 OM 00:00 UUR"
                            },
                            {
                                "example_id": "08653526-1cf4-49dd-9fda-bb5f59dfabd0",
                                "sense_id": "bfffdb49-3473-3b0c-b316-584458f70073",
                                "text": "Behalve de overzetkit worden er ook werksets voor de aanwezigheid van amfibieën in poelen ter beschikking gesteld van vergunde personen."
                            }
                        ]
                    }
                ],
