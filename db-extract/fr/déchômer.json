                ],
                "senses": [
                    {
                        "sense_id": "81f56c2f-0065-321c-a9b7-9515d5fb1fdd",
                        "entry_id": "9736f0c0-64bc-3f5b-94f3-5d56a0c3fdf2",
                        "glosses": [
                            "Enlever le chaume de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d7859d3-e020-4423-bd22-042165d68872",
                                "sense_id": "81f56c2f-0065-321c-a9b7-9515d5fb1fdd",
                                "text": "En fonction de type d’engrais, après l’épandage, ils ont un à trois jours pour déchômer la terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "19ed11f0-c3e5-39d3-9745-d2db0879c58d",
                        "entry_id": "9736f0c0-64bc-3f5b-94f3-5d56a0c3fdf2",
                        "glosses": [
                            "Cesser de chômer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "940ccd9b-f48e-42d0-90a0-888955714d54",
                                "sense_id": "19ed11f0-c3e5-39d3-9745-d2db0879c58d",
                                "text": "On chôme et on déchôme comme on veut."
                            }
                        ]
                    },
                    {
                        "sense_id": "4adf2c19-0cfb-3ef0-a5cc-bb9df48cdbf1",
                        "entry_id": "9736f0c0-64bc-3f5b-94f3-5d56a0c3fdf2",
                        "glosses": [
                            "Quitter le chôme, recommencer à pâturer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5d41920-23f1-4d10-a6f6-33db3f941686",
                                "sense_id": "4adf2c19-0cfb-3ef0-a5cc-bb9df48cdbf1",
                                "text": "Ben oui, je le fais aussi un peu en début d’après-midi, quand elles déchôment."
                            }
                        ]
                    }
