            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2b288a91-f0db-3270-96fd-fc73cedd093d",
                    "sense_definition": "een persoon die in grote armoede leeft en bijna geen geld heeft",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "armoede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Haar vader vond het vreselijk dat ze wilde trouwen met die <w>armoedzaaier</w> die geen cent bezat.",
                            "target_lang_translations": {
                                "en": "Her father thought it was terrible that she wanted to marry that <w>pauper</w> who didn't have a cent to his name."
                            }
                        },
                        {
                            "text": "Zelfs als een <w>armoedzaaier</w> probeert te sparen, blijft het leven in de stad ontzettend duur.",
                            "target_lang_translations": {
                                "en": "Even if a <w>destitute person</w> tries to save, life in the city remains incredibly expensive."
                            }
                        }
                    ],
                    "synonyms": [
                        "arme",
                        "behoeftige",
                        "bedelaar",
                        "minimumlijder",
                        "schooier"
                    ],
                    "antonyms": [
                        "rijkaard",
                        "rijke"
                    ],
                    "common_phrases": [
                        "een arme armoedzaaier"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak pejoratief gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a person living in extreme poverty with almost no money"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pauper",
                                "target_lang_sense_clarification": "a very poor person"
                            },
                            {
                                "target_lang_word": "beggar",
                                "target_lang_sense_clarification": "someone who lives by asking for money"
                            },
                            {
                                "target_lang_word": "destitute person",
                                "target_lang_sense_clarification": "someone without money, food, or a home"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d768a65-5e12-3bd2-91e5-5e221fd35233",
                    "sense_definition": "iemand die voortdurend ruzie zoekt of agressief gedrag vertoont",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>armoedzaaier</w> probeerde weer een gevecht te beginnen midden op het dorpsplein.",
                            "target_lang_translations": {
                                "en": "That <w>troublemaker</w> tried to start a fight again in the middle of the village square."
                            }
                        },
                        {
                            "text": "Niemand wil samenwerken met zo'n <w>armoedzaaier</w> die alleen maar voor onrust zorgt.",
                            "target_lang_translations": {
                                "en": "No one wants to work with such a <w>quarreller</w> who only causes unrest."
                            }
                        }
                    ],
                    "synonyms": [
                        "onruststoker",
                        "ruziemaker",
                        "ruziestoker",
                        "ruziezoeker"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "in deze betekenis minder gebruikelijk in modern Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "someone who constantly seeks conflict or exhibits aggressive behavior"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "troublemaker",
                                "target_lang_sense_clarification": "someone who causes problems or arguments"
                            },
                            {
                                "target_lang_word": "quarreller",
                                "target_lang_sense_clarification": "someone who frequently argues"
                            },
                            {
                                "target_lang_word": "brawler",
                                "target_lang_sense_clarification": "someone who gets into physical fights"
                            }
                        ]
                    }
                }
            ]
        }
    ]
