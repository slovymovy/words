            {
                "entry_id": "94b97f28-1e75-31c0-ba21-46419bf7ca4c",
                "word": "Barré",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bbf20b79-67a3-319e-a520-4d011a0249be",
                        "entry_id": "94b97f28-1e75-31c0-ba21-46419bf7ca4c",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b288986-c548-4eec-ada3-489971db2a7e",
                                "sense_id": "bbf20b79-67a3-319e-a520-4d011a0249be",
                                "text": "Laure Calamy m’a vite paru une évidence, confie Jonathan Barré."
                            },
                            {
                                "example_id": "bece3eca-ae58-49f2-aa8d-0dcd52857aa5",
                                "sense_id": "bbf20b79-67a3-319e-a520-4d011a0249be",
                                "text": "J’avais lu son œuvre avant de me plonger dans les travaux biographiques de Jean Lacouture et de Jean-Luc Barré, dans lesquels j’ai découvert des aspects de sa vie que je ne connaissais pas."
                            },
                            {
                                "example_id": "147f4d94-cce9-4e65-8602-3f489f82062f",
                                "sense_id": "bbf20b79-67a3-319e-a520-4d011a0249be",
                                "text": "Huit nouveaux donc, dont trois bizuts : le Toulousain Emmanuel Meafou (25 ans) en 2ᵉ ligne, le Parisien Léo Barré (21 ans) à l’arrière et le Bordelais Nicolas Depoortère (21 ans) au centre."
                            }
                        ]
                    }
                ],
                "translations": [],
