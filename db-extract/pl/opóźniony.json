                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retarded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26c7485a-673f-3d88-8787-e9b740be0f88",
                                        "entry_id": "cc0dd7a1-1b27-3d5e-bf40-fc49d18de0de",
                                        "glosses": [
                                            "Delayed; delayed in development, hindered; impeded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "278b89c9-fc6c-4f60-9c3e-9bf269d2b5a8",
                                                "sense_id": "26c7485a-673f-3d88-8787-e9b740be0f88",
                                                "text": "This kind of plant is usually of a retarded growth."
                                            },
                                            {
                                                "example_id": "e76d518f-fde6-4f37-9c27-7ae1d8868494",
                                                "sense_id": "26c7485a-673f-3d88-8787-e9b740be0f88",
                                                "text": "The last zone, lying beyond the Ch‘ang-pai mountains, was in special isolation and culturally as retarded as regions much farther north."
                                            },
                                            {
                                                "example_id": "38e6c6fa-e513-41ed-92ba-1867120f5e0b",
                                                "sense_id": "26c7485a-673f-3d88-8787-e9b740be0f88",
                                                "text": "HGH, which was originally developed to assist children with retarded growth, is believed to be especially popular with sprinters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62c35f29-be26-35de-87a4-8a7d61f9825b",
                                        "entry_id": "cc0dd7a1-1b27-3d5e-bf40-fc49d18de0de",
                                        "glosses": [
                                            "Having mental retardation; mentally deficient or underdeveloped."
                                        ],
                                        "tags": [
                                            "dated",
                                            "offensive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "065e4be8-becb-4e73-8f04-e657035fe7d0",
                                                "sense_id": "62c35f29-be26-35de-87a4-8a7d61f9825b",
                                                "text": "Experts in the field say there are now at least 200,000 retarded people over 60 in the United States."
                                            },
                                            {
                                                "example_id": "e7df3b50-5b55-4308-8cab-09b9c0b20008",
                                                "sense_id": "62c35f29-be26-35de-87a4-8a7d61f9825b",
                                                "text": "One day the order of things begins to unravel. First, the doctor, on horseback, is tripped up by an invisible wire and his injuries put him in the hospital for months. Then several children, including the son of the Baron and the retarded child of the doctor’s mistress, are severely beaten. Later, the Baron’s barn is set on fire."
                                            },
                                            {
                                                "example_id": "397ebb5f-532c-4131-ad74-24d560c56505",
                                                "sense_id": "62c35f29-be26-35de-87a4-8a7d61f9825b",
                                                "text": "Shriver started the Special Olympics Games in 1968 to foster fitness and self-esteem for those with mental retardation and advocated in Washington for her cause well into her eighties. The event has grown to include 190 nations.\nHer concern for the mentally handicapped was attributed to her relationship with older sister Rosemary, who was said to have been mildly retarded and spent the majority of her life in a long-term care facility after a lobotomy."
                                            },
                                            {
                                                "example_id": "eb9bf84d-ac3f-4c7f-a3e5-3a5db4080521",
                                                "sense_id": "62c35f29-be26-35de-87a4-8a7d61f9825b",
                                                "text": "As one of hundreds of examples, here is how Emily and Charles work to stimulate their profoundly retarded newborn, and the kind of detail Solomon is consistently able to draw from his subjects:[…]"
                                            },
                                            {
                                                "example_id": "0cc4100a-0333-44ff-994d-ebb2da310d7f",
                                                "sense_id": "62c35f29-be26-35de-87a4-8a7d61f9825b",
                                                "text": "Me and my friends used to feed LSD to this little retarded girl in our neighborhood and we'd lock arms around her and go \"nightmare! Nightmare! Nightmare! Nightmare! Nightmare! Nightmare! Nightmare! Nightmare!\" It actually cured her retardation."
                                            },
                                            {
                                                "example_id": "9a858e03-832e-41bc-8244-0e2a006c04c8",
                                                "sense_id": "62c35f29-be26-35de-87a4-8a7d61f9825b",
                                                "text": "Gavali added that he is going to meet the state home minister by next week to brief him about the situation. “Giving drugs to children can cause long term harm and they can also become retarded. Such begging gangs are also seen at Kharghar, Belapur highway junction, and at Nerul LP, \" he said."
                                            },
                                            {
                                                "example_id": "ebd3f248-e050-4814-b71a-06285d2f1735",
                                                "sense_id": "62c35f29-be26-35de-87a4-8a7d61f9825b",
                                                "text": "The convict sexually exploited the girl, a Class 8 student who is moderately retarded, on multiple occasions."
                                            },
                                            {
                                                "example_id": "43b068ce-ffe8-4b71-aac2-33a5c9ca2b33",
                                                "sense_id": "62c35f29-be26-35de-87a4-8a7d61f9825b",
                                                "text": "The defense, which sought a life sentence, had argued that Yamada was mildly retarded and had committed the crime impulsively after being angered by the victims' actions and words."
                                            },
                                            {
                                                "example_id": "f87f758a-48e4-4716-80df-6d06c195843f",
                                                "sense_id": "62c35f29-be26-35de-87a4-8a7d61f9825b",
                                                "text": "A 49-year-old mother yesterday pleaded guilty to manslaughter when appearing in High Court after strangling her 21-year-old retarded son to death with a plastic tablecloth nearly three years ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d85dbf0c-e21c-3e24-bc40-599ca3747a26",
                                        "entry_id": "cc0dd7a1-1b27-3d5e-bf40-fc49d18de0de",
                                        "glosses": [
                                            "Specifically, having an IQ below 70."
                                        ],
                                        "tags": [
                                            "dated",
                                            "offensive",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c9ad72b-e73f-35b7-8d12-9b9e94e43012",
                                        "entry_id": "cc0dd7a1-1b27-3d5e-bf40-fc49d18de0de",
                                        "glosses": [
                                            "Extremely stupid; obtuse"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fcf20ec-34d6-46f3-aff3-af6fb9404438",
                                                "sense_id": "2c9ad72b-e73f-35b7-8d12-9b9e94e43012",
                                                "text": "Looking at Jack, Gabbie said, \"What?\" \"That's the Troll Bridge.\" She groaned at the pun. \"That's retarded.\""
                                            },
                                            {
                                                "example_id": "2a687763-95ff-49c1-b83d-8cc9579b2a0c",
                                                "sense_id": "2c9ad72b-e73f-35b7-8d12-9b9e94e43012",
                                                "text": "I've got a terrific sign in front of my house that keeps intruders out: Retarded Pit Bull High on Angel Dust. No one's come over the wall yet. Except a couple of retarded guys who were high on angel dust."
                                            },
                                            {
                                                "example_id": "b5dc2a0e-707c-4448-8f54-90758509ae43",
                                                "sense_id": "2c9ad72b-e73f-35b7-8d12-9b9e94e43012",
                                                "text": "If it sounds like a bad script that a retarded child would write, it’s because it is. Yet, anti-Zionists will aggressively explain to you why this insanity makes perfect sense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b698ef9-8e51-3f3c-8a3d-e5ae479bdf88",
                                        "entry_id": "cc0dd7a1-1b27-3d5e-bf40-fc49d18de0de",
                                        "glosses": [
                                            "Designating a parameter of an electromagnetic field which is adjusted to account for the finite speed of radiation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "retarded",
