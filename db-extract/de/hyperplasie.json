                "translations": [
                    {
                        "translation_id": "0ebcfba1-5039-47d8-aa9b-2bdff9fc364f",
                        "source_entry_id": "cf81bbcf-1213-3514-967e-b8ff2bb92914",
                        "source_sense_id": "f2328d90-87dc-334f-8bba-e577e956a1de",
                        "source_sense_description": "Medizin: die Vergrößerung eines Gewebes oder eines Organs durch vermehrte Zellteilung",
                        "target_lang_word": "hyperplasia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperplasia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19d970ab-6440-3995-a5d1-75a682622c70",
                                        "entry_id": "490619d1-81fc-3530-978b-5388f5734b03",
                                        "glosses": [
                                            "An increase in the size of a tissue or organ due to increased number of cells."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eec492b6-dde8-40af-9e72-901c31803905",
                                                "sense_id": "19d970ab-6440-3995-a5d1-75a682622c70",
                                                "text": "But we can no longer regard the mere fact of these diffuse condensations of the lung becoming yellow and caseous as an evidence of their tuberculous nature, especially since the pathological anatomists, and among them Virchow, have shown that formations of the most different kind, having not the slightest connection with tubercule— as, for example, old cancerous masses, lymphatic glands swollen by a hyperplasia of cells, hæmorrhagical infarctions, abscesses, &c.— undergo exactly the same caseous transformation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e14d5d1-8d6a-43a7-a8df-846af2ab1d9d",
                        "source_entry_id": "cf81bbcf-1213-3514-967e-b8ff2bb92914",
                        "source_sense_id": "f2328d90-87dc-334f-8bba-e577e956a1de",
                        "source_sense_description": "Medizin: die Vergrößerung eines Gewebes oder eines Organs durch vermehrte Zellteilung",
                        "target_lang_word": "hyperplasie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperplasie",
