                        "examples": [
                            {
                                "example_id": "964d3d78-7f20-48f9-b7c4-383704ddeb60",
                                "sense_id": "dd7d5380-37d7-3f26-843f-843b995af20e",
                                "text": "So I went up and down, and through the street, and down to the harbour-side, like a dog that has lost its master, with a strange gnawing in my inwards, and every now and then a movement of despair."
                            },
                            {
                                "example_id": "2423c80a-bc5b-4e6b-8e4b-b318a4dc40c3",
                                "sense_id": "dd7d5380-37d7-3f26-843f-843b995af20e",
                                "text": "[A]nd the post mortem performed handily and swiftly right at the edge of the grave, so that the inwards which had caused the pig's death preceded him into the ground and he lay at last resting squarely on the cause of his own undoing."
                            }
                        ]
                    }
