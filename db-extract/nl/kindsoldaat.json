                    {
                        "sense_id": "d1ca6515-9a85-390d-90cd-b234d445c227",
                        "entry_id": "ecc64ced-554c-33a6-b2c4-fd22acf8c89a",
                        "glosses": [
                            "kind dat dienstdoet in een regeringsleger of in een georganiseerde gewapende politieke groep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "056d67ca-d534-410f-9059-94d2d53f35da",
                                "sense_id": "d1ca6515-9a85-390d-90cd-b234d445c227",
                                "text": "Kindsoldaten worden vooral gebruikt door rebellenlegers, maar ook regeringslegers rekruteren en gebruiken minderjarigen als soldaten. Ruim zestig landen op de wereld rekruteren jongeren onder de achttien jaar voor hun strijdkrachten. Ook in Nederland kunnen jongeren vanaf zeventien jaar BBT'er worden: beroepsmilitair voor bepaalde tijd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fd9f830-d8ce-4a0f-a19d-d68c1f5b4c00",
                        "source_entry_id": "ecc64ced-554c-33a6-b2c4-fd22acf8c89a",
                        "source_sense_id": "d1ca6515-9a85-390d-90cd-b234d445c227",
                        "source_sense_description": "kind dat deelneemt aan een gewapend conflict",
                        "target_lang_word": "Kindersoldat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kindersoldat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10544f45-2c2c-304b-b3a5-83f0b8bfb19c",
                                        "entry_id": "3651c49d-05d5-3f63-a76c-90ff83822094",
                                        "glosses": [
                                            "minderjährige Person, die als Soldat eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2954b2a4-38d0-48fd-8635-6baf3be00f86",
                                                "sense_id": "10544f45-2c2c-304b-b3a5-83f0b8bfb19c",
                                                "text": "„Weil Kindersoldaten im Krieg gelernt haben, sich mit Gewalt zu nehmen, was sie wollen, rutschen sie, wenn sie sich wieder in die Zivilgesellschaft eingliedern sollen, besonders oft in die Kriminalität ab.“"
                                            },
                                            {
                                                "example_id": "59dff8bd-0c32-4dcf-818d-2a64adc80d99",
                                                "sense_id": "10544f45-2c2c-304b-b3a5-83f0b8bfb19c",
                                                "text": "„Man nimmt an, dass sich die Zahl von Kindersoldaten weltweit auf etwa 250000 beläuft und dass es Kindersoldaten in rund 86 Staaten und Regionen der Welt gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
