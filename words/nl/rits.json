{
    "word_family": [
        "ritsen",
        "ritssluiting",
        "ritselen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43d9fa7e-68e9-360c-afbc-ad8ee6bb4281",
                    "sense_definition": "Een sluiting bestaande uit twee rijen tanden die met een schuifje in elkaar grijpen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sluiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>rits</w> van mijn nieuwe jas zit helaas vast.",
                            "target_lang_translations": {
                                "en": "The <w>zipper</w> of my new jacket is unfortunately stuck."
                            }
                        },
                        {
                            "text": "Je moet de <w>rits</w> voorzichtig omhoog trekken om hem niet te breken.",
                            "target_lang_translations": {
                                "en": "You have to pull the <w>zip</w> up carefully so as not to break it."
                            }
                        }
                    ],
                    "synonyms": [
                        "ritssluiting",
                        "treksluiting"
                    ],
                    "common_phrases": [
                        "kapotte rits",
                        "rits dichtdoen"
                    ],
                    "target_lang_definitions": {
                        "en": "A fastener consisting of two rows of teeth that interlock with a slider."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "zipper",
                                "target_lang_sense_clarification": "common term for a zip fastener"
                            },
                            {
                                "target_lang_word": "zip",
                                "target_lang_sense_clarification": "British English term for a zipper"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2df5c86b-235a-35dd-8e95-09a31b6ef83f",
                    "sense_definition": "Een lange reeks of serie van gelijksoortige zaken of gebeurtenissen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reeks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kwam tijdens de vergadering met een hele <w>rits</w> voorstellen.",
                            "target_lang_translations": {
                                "en": "He came up with a whole <w>string</w> of proposals during the meeting."
                            }
                        },
                        {
                            "text": "Er staat een hele <w>rits</w> auto's te wachten voor het stoplicht.",
                            "target_lang_translations": {
                                "en": "There is a whole <w>line</w> of cars waiting at the traffic light."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een hele rits"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in informele context voor een lange lijst"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A long series or sequence of similar things or events."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "string",
                                "target_lang_sense_clarification": "a series of similar things"
                            },
                            {
                                "target_lang_word": "whole list",
                                "target_lang_sense_clarification": "informal way to describe a long sequence"
                            },
                            {
                                "target_lang_word": "slew",
                                "target_lang_sense_clarification": "a large number or series"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2e5fca5-397f-307a-9449-a7821e673b4c",
                    "sense_definition": "Een hoger gelegen zandrug of schelpenrug in een moerassig gebied.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nederzetting werd gebouwd op een natuurlijke <w>rits</w> om droge voeten te houden.",
                            "target_lang_translations": {
                                "en": "The settlement was built on a natural <w>sand ridge</w> to keep feet dry."
                            }
                        },
                        {
                            "text": "In dit drasland vormen de <w>ritsen</w> de enige begaanbare paden.",
                            "target_lang_translations": {
                                "en": "In this wetland, the <w>ridges</w> form the only passable paths."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk gebruikt in Suriname"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A higher-lying sand or shell ridge in a swampy area."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chenier",
                                "target_lang_sense_clarification": "a sandy ridge in a marshy area"
                            },
                            {
                                "target_lang_word": "sand ridge",
                                "target_lang_sense_clarification": "elevated ground in a wetland"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2882fc1c-cb46-3e2e-b47f-bdf9ee055d27",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>ritsen</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>rits</w> mijn tas even dicht voordat we vertrekken.",
                            "target_lang_translations": {
                                "en": "I'll <w>zip</w> my bag shut before we leave."
                            }
                        },
                        {
                            "text": "Wacht even, ik <w>rits</w> mijn jas vast.",
                            "target_lang_translations": {
                                "en": "Wait a second, I'm <w>zipping</w> up my jacket."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm van het werkwoord ritsen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'to zip'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "zip",
                                "target_lang_sense_clarification": "to close with a zipper"
                            },
                            {
                                "target_lang_word": "zipper",
                                "target_lang_sense_clarification": "to fasten using a zipper"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e141e686-30ca-3a9d-a88b-f78b6ff0f386",
                    "sense_definition": "Seksueel opgewonden of wulps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "staat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De honden gedroegen zich nogal <w>rits</w> tijdens hun wandeling in het park.",
                            "target_lang_translations": {
                                "en": "The dogs were behaving rather <w>lustfully</w> during their walk in the park."
                            }
                        },
                        {
                            "text": "In het voorjaar zijn veel dieren in het bos erg <w>rits</w>.",
                            "target_lang_translations": {
                                "en": "In the spring, many animals in the forest are <w>in heat</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "vaak gebruikt in specifieke regio's of voor dieren"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Sexually aroused or lustful."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in heat",
                                "target_lang_sense_clarification": "specifically for animals in a mating state"
                            },
                            {
                                "target_lang_word": "horny",
                                "target_lang_sense_clarification": "informal/slang for sexually aroused"
                            },
                            {
                                "target_lang_word": "lustful",
                                "target_lang_sense_clarification": "feeling strong sexual desire"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "47e44a20-9748-329a-94b3-0449876b903a",
                    "sense_definition": "Nabootsing van het geluid van een rits die sluit of van iets dat scheurt.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>rits</w>, daar ging de rits van zijn rugzak eindelijk dicht.",
                            "target_lang_translations": {
                                "en": "And <w>zip</w>, the zipper of his backpack finally closed."
                            }
                        },
                        {
                            "text": "Met een kort <w>rits</w> trok zij het klittenband van haar schoen los.",
                            "target_lang_translations": {
                                "en": "With a short <w>rip</w>, she pulled the Velcro off her shoe."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imitation of the sound of a zipper closing or something tearing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "zip",
                                "target_lang_sense_clarification": "the sound of a fast movement or fastener"
                            },
                            {
                                "target_lang_word": "rip",
                                "target_lang_sense_clarification": "the sound of something tearing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}