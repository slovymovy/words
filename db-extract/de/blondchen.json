                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a97f54dc-bc19-3745-b34f-c914347ca72c",
                                        "entry_id": "34b6c615-33f3-3663-955a-9ea2add0cb35",
                                        "glosses": [
                                            "(film, television, theater) A kind of 2,000-watt lamp."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edcf0b43-223f-49a6-8af5-05ea528c4fdb",
                                                "sense_id": "a97f54dc-bc19-3745-b34f-c914347ca72c",
                                                "text": "Most [camera crews] carry two blondes and three redheads or their equivalents. Blondes are 2000 watt lamps traditionally with yellow heads (or shells) used to light fairly large areas — also referred to as 2Ks — and redheads smaller 800 watt lamps traditionally with red shells to light faces."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blonde",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "883bb596-e3da-3fae-98e0-dcc82d13e79c",
                                        "entry_id": "2ffc585f-0677-3451-aab2-f445cfcfd3e7",
                                        "glosses": [
                                            "Alternative form of blond."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07b17754-63e5-498a-a2da-42e43f5974a2",
                                                "sense_id": "883bb596-e3da-3fae-98e0-dcc82d13e79c",
                                                "text": "So the great wasteful summer days went by, the glory of the passionate nights of July, the crisper blonde luxuriance of August."
                                            },
                                            {
                                                "example_id": "2f78ad56-5397-44fc-9f93-9d1b129b5838",
                                                "sense_id": "883bb596-e3da-3fae-98e0-dcc82d13e79c",
                                                "text": "Como en aquel bar de Copenhague lleno de hombres rubios y de mujeres rubias que al final resultaron ser también hombres rubios, donde el Torpedero Tucumán se había enfadado porque al meter mano se encontró quinientos buenos gramos de lo que no esperaba; […]"
                                            },
                                            {
                                                "example_id": "8e00140b-6818-4ce7-8830-359769f6e7da",
                                                "sense_id": "883bb596-e3da-3fae-98e0-dcc82d13e79c",
                                                "text": "The tables are full of blond men and blonde women, the room full of the smells of food and the sound of harsh, clipped Northlander voices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92e94fea-ff71-33ea-a0e7-886139184112",
                                        "entry_id": "2ffc585f-0677-3451-aab2-f445cfcfd3e7",
                                        "glosses": [
                                            "Stupid, ignorant, naive."
                                        ],
                                        "tags": [
                                            "especially",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ca6a4a3-351a-4810-8aa4-9742561539f0",
                                                "sense_id": "92e94fea-ff71-33ea-a0e7-886139184112",
                                                "text": "Emma's already huge green eyes widen and she gives me this look like, “Oh my God, sometimes you are just so blonde!”"
                                            },
                                            {
                                                "example_id": "91fbd783-f16c-45d1-83d9-a738ae96d59f",
                                                "sense_id": "92e94fea-ff71-33ea-a0e7-886139184112",
                                                "text": "I was so blonde I honestly had no idea why he got so angry. He cooled on me for a week or so."
                                            },
                                            {
                                                "example_id": "b2dd8b24-a963-4b35-9ccb-d0d902db5c06",
                                                "sense_id": "92e94fea-ff71-33ea-a0e7-886139184112",
                                                "text": "“She was so blonde, she studied for a blood test, when she went to the airport and saw a sign that said, 'Airport Left,' she turned around and went home, when she heard that 90% of all crimes occur around the home, she moved."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blonde",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc097f32-a210-3420-87d6-c7a584af3c18",
