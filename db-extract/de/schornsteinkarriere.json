                "senses": [
                    {
                        "sense_id": "8b28820d-dd32-382d-afbd-c5dc8553b4cb",
                        "entry_id": "c2e8c42b-136c-345f-b9ad-9793bb4e957b",
                        "glosses": [
                            "Karriere, bei dem der Aufstieg innerhalb eines einzigen Funktionsbereichs erfolgt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a515d4ef-8f5b-474e-9c21-48f6f1c5f4a3",
                                "sense_id": "8b28820d-dd32-382d-afbd-c5dc8553b4cb",
                                "text": "„Derlei Todesanzeigen zeugen von der alten Welt der Schornsteinkarrieren, in der es weder üblich noch nötig war, alle paar Jahre den Arbeitgeber zu wechseln, um »den nächsten Schritt zu machen«, wie es heute so gerne heißt.“"
                            },
                            {
                                "example_id": "e39de58f-c9a7-4ea0-b8dc-45ec61fc7d8f",
                                "sense_id": "8b28820d-dd32-382d-afbd-c5dc8553b4cb",
                                "text": "„‚Weiterführend‘ wird hier aber nicht als die klassische Schornsteinkarriere verstanden, also eine Stufe nach der anderen auf der Karriereleiter in der Hierarchie, sondern als persönliche Weiterentwicklung.“"
                            },
                            {
                                "example_id": "cd9cafa0-4584-403f-8f60-73d7d9f11aed",
                                "sense_id": "8b28820d-dd32-382d-afbd-c5dc8553b4cb",
                                "text": "„In Behörden und Verwaltungen wird die konventionelle Karriere noch klassischer ausgelegt – im Sinne einer unflexiblen Schornsteinkarriere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
