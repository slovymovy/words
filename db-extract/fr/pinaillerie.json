                        "entry_id": "709b8835-795f-3abd-97f5-834205aaea56",
                        "glosses": [
                            "Action de pinailler, souci excessif du détail, recherche exagérée et inutile de la précision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ad9249-0be8-42fa-be6f-5bf11a7bfd17",
                                "sense_id": "3e784f72-66a0-3694-ac53-74990a9a46b1",
                                "text": "Évitons la pinaillerie, allons à l’essentiel."
                            },
                            {
                                "example_id": "5a152710-6492-44a8-a00c-ade3e46027a0",
                                "sense_id": "3e784f72-66a0-3694-ac53-74990a9a46b1",
                                "text": "Ces pinailleries ne font pas avancer la rédaction de l’article."
                            },
                            {
                                "example_id": "ff2844d4-52a3-4eda-94f1-93d0683f63b7",
                                "sense_id": "3e784f72-66a0-3694-ac53-74990a9a46b1",
                                "text": "D’autant que ces artistes de la pinaillerie font montre d’une imagination débordante dans l’exercice de leur fonction, et d’un sens de l’humour qui rappelle un peu les Marx Brothers et les grandes heures de Magritte."
                            }
                        ]
                    }
