                        "source_entry_id": "0075fa3b-58be-3678-8d06-06d46cc8b03b",
                        "source_sense_id": "0faf5b8a-f657-3cc0-a70b-0ec778551f6c",
                        "source_sense_description": "(familie) een vrouwelijk persoon die óf dezelfde moeder óf dezelfde vader heeft als jou",
                        "target_lang_word": "Halbschwester",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbschwester",
