    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee25a65e-ac93-3076-b180-542eb21a82d0",
                    "sense_definition": "Présenter au regard du public, mettre en vue des objets ou des œuvres d'art.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "montrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musée a décidé d'<w>exposer</w> les peintures de cet artiste contemporain pendant tout l'été."
                        },
                        {
                            "text": "Cette galerie va <w>exposer</w> des œuvres de sculpteurs locaux dès le mois prochain."
                        }
                    ],
                    "synonyms": [
                        "présenter",
                        "montrer"
                    ],
                    "antonyms": [
                        "cacher",
                        "masquer"
                    ],
                    "common_phrases": [
                        "exposer des œuvres",
                        "exposer un tableau"
                    ]
                },
                {
                    "sense_id": "8dd805e7-15d5-3a0c-b8d6-1975b9c090b4",
                    "sense_definition": "Présenter, faire connaître ou expliquer avec ordre des idées, des faits ou une situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "expliquer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur va <w>exposer</w> ses idées lors de la prochaine réunion d'équipe."
                        },
                        {
                            "text": "Le ministre a pris la parole pour <w>exposer</w> la situation économique du pays."
                        }
                    ],
                    "synonyms": [
                        "expliquer",
                        "présenter",
                        "développer"
                    ],
                    "antonyms": [
                        "taire",
                        "dissimuler"
                    ],
                    "common_phrases": [
                        "exposer ses idées",
                        "exposer la situation"
                    ]
                },
                {
                    "sense_id": "51dfc767-3599-3304-b456-bb5514bed11a",
                    "sense_definition": "Placer ou orienter quelque chose de façon à le soumettre à l'action d'un élément extérieur comme le soleil ou la lumière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas trop <w>exposer</w> au soleil les plantes sensibles pendant les heures chaudes."
                        },
                        {
                            "text": "Elle préfère <w>exposer</w> le linge au vent pour qu'il sèche plus rapidement."
                        }
                    ],
                    "synonyms": [
                        "soumettre",
                        "orienter"
                    ],
                    "antonyms": [
                        "abriter",
                        "protéger"
                    ],
                    "common_phrases": [
                        "exposer au soleil",
                        "exposer à la lumière"
                    ]
                },
                {
                    "sense_id": "4d51e460-7786-3890-8fe2-0d9c4e8224a5",
                    "sense_definition": "Mettre en péril ou soumettre quelqu'un ou quelque chose à un risque ou à un danger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "risque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prendre cette route de montagne en hiver peut vous <w>exposer</w> à un danger mortel."
                        },
                        {
                            "text": "Le soldat a refusé d'<w>exposer</w> sa vie sans avoir reçu d'ordres précis."
                        }
                    ],
                    "synonyms": [
                        "compromettre",
                        "risquer"
                    ],
                    "antonyms": [
                        "épargner",
                        "préserver"
                    ],
                    "common_phrases": [
                        "exposer à un danger",
                        "exposer sa vie"
                    ]
                }
            ]
        }
    ]
}