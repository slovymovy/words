                                                "example_id": "f13f414d-0bed-4028-ac1c-283c18b705c1",
                                                "sense_id": "5e7b9f48-fef5-32a3-8d25-367986b47818",
                                                "text": "Si se hubiese inventado este ensayo antes, muchos hombres que hoy caminan libres por el mundo habrían pagado hace tiempo sus crímenes."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
