                        "entry_id": "31018d0b-51f8-3d3c-a605-da96d6b7fdef",
                        "glosses": [
                            "Donner un caractère figuratif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "170c005e-769b-4c7d-a9b2-b1cfc1063ca2",
                                "sense_id": "035b3460-5131-365d-99e0-7615edfdd920",
                                "text": "Cette dernière ne sert plus à figurativiser et discursiviser un affrontement de type politique."
                            },
                            {
                                "example_id": "947b3c8c-b4ab-4dee-a848-66672eff54f0",
                                "sense_id": "035b3460-5131-365d-99e0-7615edfdd920",
                                "text": "La scène figurative est donc bien un moment fort de tensions perceptives perçues mais déployées selon un certain espace textuel, nécessitant une mise en discours, pour figurativiser une passion qui ne peut être objectivée autrement."
                            }
                        ]
                    }
