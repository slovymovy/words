                        "examples": [
                            {
                                "example_id": "ad3ad64a-6f4d-4d5b-9e18-1539caaa4cad",
                                "sense_id": "127d9944-ac6c-356f-858f-aeffa949368d",
                                "text": "Dominique van der Heyde (48) volgt Ferry Mingelen (66) per 1 januari 2014 op als politiek duider van Nieuwsuur. Ze zal daarom vertrekken bij het Achtuurjournaal. Dat hebben de NOS en NTR vandaag laten weten."
                            },
                            {
                                "example_id": "1d9afb53-38a3-4c98-aed0-8a16d9bbb43d",
                                "sense_id": "127d9944-ac6c-356f-858f-aeffa949368d",
                                "text": "Ron Fresen is vanaf begin 2014 de politiek duider voor het NOS Journaal. Hij volgt daarmee Dominique van der Heyde op. Zij gaat vanaf dan namelijk aan de slag bij Nieuwsuur. Dat heeft de NOS woensdag bekendgemaakt."
                            },
                            {
                                "example_id": "04c93704-d568-4223-96c9-f17bb5b648d6",
                                "sense_id": "127d9944-ac6c-356f-858f-aeffa949368d",
                                "text": "Maar waar je als fan van Klaver aan het eind van zo'n debat kunt concluderen dat hij het prima heeft gedaan, moet ik als politiek duider concluderen dat hij met dit optreden niemand meer heeft bereikt dat zijn eigen achterban."
                            }
                        ]
                    }
