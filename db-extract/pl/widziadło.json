                "senses": [
                    {
                        "sense_id": "7775e5d8-4947-305e-8430-760117568582",
                        "entry_id": "00800122-9c10-3f63-9ec3-3bc1a9ddee10",
                        "glosses": [
                            "obraz, który nam się przyśnił; złudzenie wzroku lub wyobraźni; to, co ktoś widzi w świecie realnym lub w umyśle, a co nie jest częścią rzeczywistości"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "a6194be4-8b52-46d2-8e33-5de8f9f50293",
                                "sense_id": "7775e5d8-4947-305e-8430-760117568582",
                                "text": "Lucjan często widział pod oknem jej kiwającą się sylwetkę, zwłaszcza przed wieczorem, w mroku, sprawiała koszmarne widziadło."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "76c211c1-7995-3c9a-b0d3-e45185f0f433",
                        "entry_id": "00800122-9c10-3f63-9ec3-3bc1a9ddee10",
                        "glosses": [
                            "wizja"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "17181f59-ada8-4055-b948-b05c4ca450d0",
                                "sense_id": "76c211c1-7995-3c9a-b0d3-e45185f0f433",
                                "text": "Teatr musi wrócić do formy pół[ ]religijnej, wzniosłej, stać się widziadłem zbiorowem (sic!) [zbiorowym], [jak w »Bachantkach« Eurypidesa.]"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
