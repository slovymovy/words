                },
                {
                    "sense_id": "498126f4-2ca6-3f06-b784-dc422361252f",
                    "sense_definition": "Unerwarteter zusätzlicher Vorteil oder Anreiz, der jemandem als besondere Überraschung geboten wird.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als besonderes <w>Bonbon</w> erhielten alle Mitarbeiter am Jahresende einen zusätzlichen freien Tag."
                        },
                        {
                            "text": "Die Fluggesellschaft bot treuen Kunden als kleines <w>Bonbon</w> ein kostenloses Upgrade in die erste Klasse."
