                                    {
                                        "sense_id": "188f63dd-79f2-342d-b8ca-1e0eb5b68573",
                                        "entry_id": "191a31dc-f4cb-3595-812a-3c94427f22a8",
                                        "glosses": [
                                            "Qui se divise en fourche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ff99450-e3cd-4940-b6fd-7f0064fd76fe",
                                                "sense_id": "188f63dd-79f2-342d-b8ca-1e0eb5b68573",
                                                "text": "Le grand genre est de porter à la main une canne (vara) ou bâton blanc, bifurqué à l’extrémité, haut de quatre pieds, sur lequel on s’appuie nonchalamment lorsque l’on s’arrête pour causer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bifurqué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90f10ca8-129b-347d-8927-448f8e165d02",
                                        "entry_id": "aeabda1c-4d4d-35b3-a637-ee0e92073915",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe bifurquer."
                                        ],
