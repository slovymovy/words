                                        "glosses": [
                                            "To shut or fasten with a hasp, or as with a hasp."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2b7389a-8af5-495b-a9f9-2639a62ebe35",
                                                "sense_id": "be53c831-9fbb-3182-b8ec-dae5decbd168",
                                                "text": "He is hasped and hooped and hirpling with pain,\nlimping and looped in it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56d51ee3-2e95-4fa8-bd44-ded18b1e8f35",
                        "source_entry_id": "1c869e4e-3895-3dfd-b8a3-e87b23809125",
                        "source_sense_id": "93168938-0b91-38a5-8f12-5f47fb3a0cf3",
                        "target_lang_word": "Haspe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haspe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31aca24d-8761-327c-bada-3240d99b6d83",
                                        "entry_id": "b3d461af-9b50-35f1-87c3-a658882aa644",
                                        "glosses": [
                                            "Verbindung zwischen einem feststehenden und einem beweglich gebrauchten Teil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6556eada-14d4-49aa-a779-243a226774ba",
                                                "sense_id": "31aca24d-8761-327c-bada-3240d99b6d83",
                                                "text": "Das Fenster hing schief in der Haspe."
                                            },
                                            {
                                                "example_id": "8b7d527b-b319-4180-b8d1-21218a428d02",
                                                "sense_id": "31aca24d-8761-327c-bada-3240d99b6d83",
                                                "text": "Um das Quietschen und Knarren des Tores zu unterbinden, müssen die Haspen unbedingt eingefettet werden."
                                            },
                                            {
                                                "example_id": "41cb8c19-d5a3-4580-9bab-c6f0366574af",
                                                "sense_id": "31aca24d-8761-327c-bada-3240d99b6d83",
                                                "text": "„Früher hatten sie die Haspen, die die Fenster innen sicherten, nicht eingehängt.“"
                                            },
                                            {
                                                "example_id": "3b8cc387-4c13-446b-bc29-490b06e0a7cf",
                                                "sense_id": "31aca24d-8761-327c-bada-3240d99b6d83",
                                                "text": "„Bei den letzten Worten sprang sie mit wildem Satz auf den erschreckt Zurücktaumelnden zu, und der nächste Augenblick hätte sein Schicksal besiegelt, aber die aus den Haspen gestürzte Tür hielt ihren Fuß, sie wankte, stürzte und sah sich im nächsten Augenblick in der Gewalt ihres Feindes.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "866fc013-c6cc-334d-9abd-265be667c937",
                                        "entry_id": "b3d461af-9b50-35f1-87c3-a658882aa644",
                                        "glosses": [
                                            "Haken"
                                        ],
                                        "tags": [
                                            "Bergbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff49f6be-5503-4a0c-a5dd-02edb18a2838",
                                                "sense_id": "866fc013-c6cc-334d-9abd-265be667c937",
                                                "text": "Haspen waren Klammern, die die »Fahrten« befestigten, also die Leitern zum Ein- und Ausfahren in ein Bergwerk."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
