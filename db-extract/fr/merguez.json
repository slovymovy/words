        "fr-extract.jsonl": [
            {
                "entry_id": "4906ceaa-594b-3ccb-b85d-d80cabd13806",
                "word": "merguez",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "37b959a1-275b-37d5-85d3-5bbfeb658595",
                        "entry_id": "4906ceaa-594b-3ccb-b85d-d80cabd13806",
                        "glosses": [
                            "Fine saucisse épicée, faite de bœuf ou de mouton, originaire du Maghreb et destinée à la grillade."
                        ],
                        "tags": [
                            "Charcuterie"
                        ],
                        "examples": [
                            {
                                "example_id": "77e66d16-ec1e-485a-9213-54c1758d92b1",
                                "sense_id": "37b959a1-275b-37d5-85d3-5bbfeb658595",
                                "text": "Martin admire l’accortise du marchand de berlingots, du juif qui débite de la galette rekaka et des ronds à l'anis, du rôtisseur qui fait fumer sur brasier, dans une caisse de tôle, des brochettes de foie ou des merguez, saucisses à la viande de mouton."
                            },
                            {
                                "example_id": "2e6e3154-27f0-47eb-944f-9939521faa09",
                                "sense_id": "37b959a1-275b-37d5-85d3-5bbfeb658595",
                                "text": "Nous nous y procurons une monture de bretelles sans couture et consommons des merguez (saucisses grillées) à la tunisienne, sauf que les merguez israélites ne renferment pas de porc."
                            },
                            {
                                "example_id": "b2a404c5-11af-4822-9d45-a32a7192a231",
                                "sense_id": "37b959a1-275b-37d5-85d3-5bbfeb658595",
                                "text": "Le mot merguez désigne les saucisses de mouton et de bœuf. Il en est qui se préparent extemporanément pour être grillées et consommées le jour même. D’autres sont de conserve."
                            },
                            {
                                "example_id": "b9139874-dcc6-436b-84fb-8387f6848e16",
                                "sense_id": "37b959a1-275b-37d5-85d3-5bbfeb658595",
                                "text": "Cette recette est vraiment délicieuse avec des merguez, mais on peut aussi la réaliser avec des chipolatas ou de la saucisse de Toulouse."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b090271-53c1-332b-b755-ee814e736911",
                        "entry_id": "4906ceaa-594b-3ccb-b85d-d80cabd13806",
                        "glosses": [
                            "Pénis."
                        ],
                        "tags": [
                            "analogy",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "192e8f1d-c59b-4e9a-b8b7-1d90d876687f",
                                "sense_id": "0b090271-53c1-332b-b755-ee814e736911",
                                "text": "Comprenant enfin de quoi il retournait en voyant toutes ces queues au garde-à-vous ! Me pinçant alors la cuisse jusqu’au sang en m’indiquant la porte du menton, à travers les vapeurs d’eucalyptus.\n— Vous partez déjà ? s’est désolé notre voisin, sa merguez à la main."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd60eea2-491a-31b9-a28c-6a86f2a25a8e",
                        "entry_id": "4906ceaa-594b-3ccb-b85d-d80cabd13806",
                        "glosses": [
                            "Nul."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "cb8f183e-7049-43a5-aea8-0dd86457f3a0",
                                "sense_id": "cd60eea2-491a-31b9-a28c-6a86f2a25a8e",
                                "text": "Quelle merguez celui-là !"
                            }
                        ]
                    },
                    {
                        "sense_id": "d23e1899-865a-3831-a9f2-4c9dd7b8d4fe",
                        "entry_id": "4906ceaa-594b-3ccb-b85d-d80cabd13806",
                        "glosses": [
                            "Véhicule en mauvais état (souvent volé) maquillé et trafiqué pour tromper la vigilance d’un acheteur ou des autorités."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "713fe691-bb81-40fd-b34e-28e614e885a5",
                                "sense_id": "d23e1899-865a-3831-a9f2-4c9dd7b8d4fe",
                                "text": "Le tour est joué, de deux véhicules, on en fait un seul, d'où le surnom de merguez attribué à cette technique qui mélange des composants."
                            }
                        ]
                    },
                    {
                        "sense_id": "50ccc2a0-f917-3d15-906c-33c6925b82e9",
                        "entry_id": "4906ceaa-594b-3ccb-b85d-d80cabd13806",
                        "glosses": [
                            "Tout véhicule en mauvais état, mal entretenu, vieux, moche ou démodé."
                        ],
                        "tags": [
                            "broadly",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "cd9cfded-bfe4-4fec-af5e-e7a469f9e56d",
                                "sense_id": "50ccc2a0-f917-3d15-906c-33c6925b82e9",
                                "text": "C’est donc un coup dur pour les malheureux détenteurs de BX qui caressaient l’espoir de se voir un jour dédommagés pour les innombrables préjudices subis durant près de quatre décennies au volant de leur « merguez »."
                            }
                        ]
                    }
                ],
