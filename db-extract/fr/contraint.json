                                            {
                                                "example_id": "eec02c2b-3adc-4f4f-ad04-21a7041dce4a",
                                                "sense_id": "c2760042-ab71-3a59-ae04-7d4d9be9c735",
                                                "text": "De geforceerde deur kon niet meer goed gesloten worden."
                                            },
                                            {
                                                "example_id": "cc025c54-5fd8-4c76-b821-a1654a9f1df7",
                                                "sense_id": "c2760042-ab71-3a59-ae04-7d4d9be9c735",
                                                "text": "Het geforceerde compromis maakte van de conferentie op het einde toch nog een succes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe46ae99-c71a-342a-8f8a-ab1c78d28e84",
