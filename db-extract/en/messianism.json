                                        "glosses": [
                                            "w Polsce w I poł. XIX w. pogląd przypisujący narodowi polskiemu rolę mesjasza, głoszący wiarę w to, iż naród ten zbawi ludzkość poprzez swoje cierpienia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0243335d-eaf9-41e8-97a1-652fd0db53b9",
                                                "sense_id": "c39d510d-26d0-3eb9-8a13-49ee6b14774e",
                                                "text": "Winkelriedyzm romantyczny kwestionował cierpienie oraz bierną mękę mesjanizmu, podkreślając zarazem sens walki czynnej, aktywności."
                                            }
