                "senses": [
                    {
                        "sense_id": "8e4a888b-6c4b-38a7-8479-49d0a269a1df",
                        "entry_id": "49292f25-b29c-38cc-a6c2-50145666b055",
                        "glosses": [
                            "Variante de zézayer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d492d7b8-3e59-4487-98c6-6ea09d63e0c2",
                                "sense_id": "8e4a888b-6c4b-38a7-8479-49d0a269a1df",
                                "text": "En l’entendant zézéyer, je me suis mis à prononcer comme lui."
                            },
                            {
                                "example_id": "96d93030-0ce0-4bbb-96c8-419028ce3029",
                                "sense_id": "8e4a888b-6c4b-38a7-8479-49d0a269a1df",
                                "text": "- Zhut ! Ze me conzentre, tu vois pas ? dit Amélia\nOui, elle devait se concentrer, non pas pour réussir le sort, mais pour ne pas zézéyer. Si elle prononçait « Wingardium Levioza », elle allait tout rater."
                            },
                            {
                                "example_id": "c7eb8ee9-5bcf-4860-98cf-abbda08afc68",
                                "sense_id": "8e4a888b-6c4b-38a7-8479-49d0a269a1df",
                                "text": "Conséquence, je ne serai jamais un excellent astrologue... [fin de la lecture zézéyée]"
                            }
                        ]
                    }
