                "senses": [
                    {
                        "sense_id": "5038968b-8223-368b-9558-ce98304b08d3",
                        "entry_id": "de6cf50f-7d1c-3e65-b7b0-913645b4b6a2",
                        "glosses": [
                            "Bauern, ohne Unterscheidung des Geschlechts; Bäuerin und Bauer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16f6da1a-728f-497a-995e-7b05f75512d6",
                                "sense_id": "5038968b-8223-368b-9558-ce98304b08d3",
                                "text": "„Die Bauersleute mit ihren Kindern sitzen beim Mittagstisch. Eine Magd serviert die Suppe.“"
                            },
                            {
                                "example_id": "3f8fd4cf-811b-435f-b307-30477e949740",
                                "sense_id": "5038968b-8223-368b-9558-ce98304b08d3",
                                "text": "„Sie war das Kind armer Bauersleute.“"
                            },
                            {
                                "example_id": "23228833-3ba7-47fd-ae96-f42f39d5693e",
                                "sense_id": "5038968b-8223-368b-9558-ce98304b08d3",
                                "text": "„Die Bauersleute würden durch ihren Aufstand nur gewinnen und es wäre zu befürchten, daß sie oder ihre Nachkommen abermals eine Rebellion und neue Empörung anzetteln würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
