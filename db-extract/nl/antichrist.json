                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5748ab9-9c5f-376d-a3ba-3810b398a3ad",
                        "entry_id": "b937a9f2-a5e8-3675-b04c-0de23ee2ddca",
                        "glosses": [
                            "personificatie van alles wat vijandig aan het christendom is"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bbf3c6f5-455f-3c7b-8a19-d3fe83c60829",
                        "entry_id": "b937a9f2-a5e8-3675-b04c-0de23ee2ddca",
                        "glosses": [
                            "naam voor het apocalyptische wezen (eigenlijk den duivel zelf) dat vóór het einde der tijden op aarde zal verschijnen vanwege de naderende terugkeer van Jezus Christus om zijn Duizendjarig vredesrijk op aarde te vestigen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "887b8d52-ed7d-4018-8de2-4aa179e4b8c9",
                        "source_entry_id": "b937a9f2-a5e8-3675-b04c-0de23ee2ddca",
                        "target_lang_word": "Antichrist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antichrist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c69a49d4-8dd5-3df6-ab2d-4b81fc13e08a",
                                        "entry_id": "bb5f3495-07d0-3c97-93b4-813af606273f",
                                        "glosses": [
                                            "der Widersacher von Christus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fe21f2f-676d-48a3-979c-5c4e2ed3b829",
                                                "sense_id": "c69a49d4-8dd5-3df6-ab2d-4b81fc13e08a",
                                                "text": "Der Antichrist wird alle mit falscher Zunge verführen und die Menschheit ins Verderben führen."
                                            },
                                            {
                                                "example_id": "8f52f183-fa93-448c-9de9-229daba3f12d",
                                                "sense_id": "c69a49d4-8dd5-3df6-ab2d-4b81fc13e08a",
                                                "text": "„In Bruchstücken ausphantasiert wird die Vorstellung eines unreinen, dem Antichristen ergebenen Volkes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Antichrist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "864b7144-41a5-3de5-9d06-ad113b82d501",
                                        "entry_id": "ed1cce42-68fc-3434-8145-71bc3f1a3937",
                                        "glosses": [
                                            "Person, die nicht Christ ist und Einwände gegen die christliche Glaubensgemeinschaft hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d94729b9-0e5e-407c-8279-21f1e3e7569a",
                                                "sense_id": "864b7144-41a5-3de5-9d06-ad113b82d501",
                                                "text": "Die Antichristen lehnen nicht immer den Gottesglauben ab, aber verneinen die christliche Lehre."
                                            },
                                            {
                                                "example_id": "0bb1a08e-803b-4d43-8c2d-8a26c222eb2a",
                                                "sense_id": "864b7144-41a5-3de5-9d06-ad113b82d501",
                                                "text": "„Hier wuchs der radikale Atheist und selbst ernannte ‚Antichrist‘, der wesentlich mit zu der fundamentalen Krise des Christentums am Übergang vom 19. zum 20. Jahrhundert beigetragen hatte, selbst zur Quelle religiöser Impulse heran.“"
                                            },
                                            {
                                                "example_id": "57517147-8532-43ca-a7aa-bd25c2b22b48",
                                                "sense_id": "864b7144-41a5-3de5-9d06-ad113b82d501",
                                                "text": "„Und mit seinem Charisma und dem internationalen Hintergrund entspricht natürlich niemand dem Bild vom Antichrist so genau wie Präsident Barack Obama.“"
                                            },
                                            {
                                                "example_id": "a0544e45-2d41-4cb1-bd41-e7af554f65d7",
                                                "sense_id": "864b7144-41a5-3de5-9d06-ad113b82d501",
                                                "text": "„Letzteres wussten alle, nur Anton Millbacher konnte es nicht glauben, dass sein König mit dem Antichristen im Bunde stand.“"
                                            },
                                            {
                                                "example_id": "0dc9c789-3d14-489b-8be9-b71a4aa5b898",
                                                "sense_id": "864b7144-41a5-3de5-9d06-ad113b82d501",
                                                "text": "„Was sie vom Kriege, von Bonaparte und seinem Anmarsch hörten, das verknüpfte sich in ihren Hirnen mit ebenso verschwommenen Vorstellungen vom Antichrist, vom Ende der Welt und von einer unumschränkten Freiheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "849adb7e-769e-4d6e-ae26-8af1e94cb205",
                        "source_entry_id": "b937a9f2-a5e8-3675-b04c-0de23ee2ddca",
                        "target_lang_word": "Antichrist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antichrist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d21a9f3-a5da-3a6c-a726-0666120f345e",
                                        "entry_id": "02b6249b-3d6e-3ee8-a231-7c5c7e66c981",
                                        "glosses": [
                                            "A false messiah who, under direct control of the Devil, will usher in the abomination in the end times; a false prophet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c4014e-4e15-4611-b3a6-b1cee2d32f72",
                                                "sense_id": "9d21a9f3-a5da-3a6c-a726-0666120f345e",
                                                "text": "Little childꝛen, it is the laſt time: and as yee haue heard that Antichꝛiſt ſhall come, euen now are there many Antichꝛiſts, whereby wee know that it is the laſt time."
                                            },
                                            {
                                                "example_id": "388c17dd-f3ba-4f68-a536-2b65b04134f7",
                                                "sense_id": "9d21a9f3-a5da-3a6c-a726-0666120f345e",
                                                "text": "[Ross Douthat:] Is Silicon Valley recklessly ambitious? What should we fear more: Armageddon or stagnation? Why is one of the world’s most successful investors worrying about the Antichrist? […] [Peter Thiel:] […] And the Christian framing, which in some ways is the same question, is: Antichrist or Armageddon? You have the one-world state of the Antichrist, or we’re sleepwalking toward Armageddon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f8b38cc-cb84-419f-abb2-27baab1d1a46",
                        "source_entry_id": "b937a9f2-a5e8-3675-b04c-0de23ee2ddca",
                        "target_lang_word": "antéchrist",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antéchrist",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd5f9e5d-6cb4-3423-ba9a-58aa7f4a94ed",
                                        "entry_id": "760746b1-36fe-3f69-83a0-233b5a86d0ec",
                                        "glosses": [
                                            "Imposteur qui cherchera à établir une religion opposée à celle de Jésus-Christ, et qui viendra à la fin des temps."
                                        ],
                                        "tags": [
                                            "Biblical",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a39324a-3472-4a2c-bc3b-08912f8fb6f7",
                                                "sense_id": "cd5f9e5d-6cb4-3423-ba9a-58aa7f4a94ed",
                                                "text": "Tout incident de persécution empruntait à la mythologie de l’Antéchrist quelque chose de son carac­tère effroyablement dramatique ; au lieu d'être apprécié en raison de son importance matérielle, […], il était un élément de la guerre engagée par Satan, prince de ce monde, qui allait bientôt révéler son Antéchrist."
                                            },
                                            {
                                                "example_id": "be30f8d2-edf8-4715-b732-3923179aebf1",
                                                "sense_id": "cd5f9e5d-6cb4-3423-ba9a-58aa7f4a94ed",
                                                "text": "On parlait beaucoup de l’Antéchrist ; on en a sans doute parlé de tout temps dans les communautés chrétiennes, mais cette obsession de la Fin semble avoir été plus forte dans ce petit milieu qu’à d’autres époques, comme la nôtre, où tant de raisons incitent à y songer."
                                            },
                                            {
                                                "example_id": "c7400104-2659-4d4a-a091-b9e7bcc0d46e",
                                                "sense_id": "cd5f9e5d-6cb4-3423-ba9a-58aa7f4a94ed",
                                                "text": "Et les plus connus étaient les Témoins de Jéhovah et les Pentecôtistes et les Amishes qui n'aimaient pas l’électricité et s’éclairaient à la lampe à pétrole et portaient des habits noirs et disaient que les conquêtes techniques conduisaient l'homme à s'éloigner de Dieu ce qui était l'intention première de l’Antéchrist qui voulait tuer l’âme en l'homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0934a10-ed29-3122-862d-49c54957d56f",
                                        "entry_id": "760746b1-36fe-3f69-83a0-233b5a86d0ec",
                                        "glosses": [
                                            "Celui qui est opposé à Jésus-Christ, qui est l’ennemi de Jésus-Christ."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7b44bd3-e077-4e77-9d78-a1fe40a548c2",
                                                "sense_id": "d0934a10-ed29-3122-862d-49c54957d56f",
                                                "text": "Pour les cléricaux, M. Combes, le « petit père » comme on l’appela, figura pendant longtemps l’antéchrist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4ed13e9-c177-3b49-bc40-92e4738c535e",
                                        "entry_id": "760746b1-36fe-3f69-83a0-233b5a86d0ec",
                                        "glosses": [
                                            "Ennemi juré."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "924a1ebe-27bb-4b0a-ba49-79d99edef783",
                                                "sense_id": "b4ed13e9-c177-3b49-bc40-92e4738c535e",
                                                "text": "Tel que je connaissais Mac Allermy, je le vois fort bien s’élançant dans la lutte pour abattre l’antéchrist que représentait à ses yeux Arsène Lupin."
                                            },
                                            {
                                                "example_id": "0724f2af-6014-4abf-bf97-f120af2e628d",
                                                "sense_id": "b4ed13e9-c177-3b49-bc40-92e4738c535e",
                                                "text": "Les pompidoliens soutiennent d’abord l’éphémère candidature du Premier ministre, Pierre Messmer, qui expédie les affaires courantes. Mais ce contre-feu fait long feu. Messmer renonce. Les pompidoliens vont alors favoriser l’homme qui a fait tomber le général en 1969, l’antéchrist du gaullisme : Valéry Giscard d’Estaing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
