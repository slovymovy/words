                {
                    "sense_id": "349d64c7-7cfd-3015-b5d6-57ab4b7445e0",
                    "sense_definition": "Qui frappe l'esprit par son évidence, sa grandeur ou son caractère remarquable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remarquable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe a remporté une victoire <w>éclatante</w> lors de la finale du tournoi régional.",
                            "target_lang_translations": {
                                "en": "The team won a <w>resounding</w> victory in the final of the regional tournament.",
                                "de": "Die Mannschaft errang im Finale des regionalen Turniers einen <w>glänzenden</w> Sieg.",
                                "es": "El equipo logró una victoria <w>rotunda</w> en la final del torneo regional.",
                                "zh": "球队在地区锦标赛的决赛中取得了<w>辉煌</w>的胜利。",
                                "ru": "Команда одержала <w>блестящую</w> победу в финале регионального турнира."
                            }
                        },
                        {
                            "text": "Cette nouvelle découverte scientifique apporte la preuve <w>éclatante</w> de la validité de sa théorie.",
                            "target_lang_translations": {
                                "en": "This new scientific discovery provides <w>conclusive</w> proof of the validity of their theory.",
                                "de": "Diese neue wissenschaftliche Entdeckung liefert den <w>eindeutigen</w> Beweis für die Gültigkeit ihrer Theorie.",
                                "es": "Este nuevo descubrimiento científico aporta una prueba <w>contundente</w> de la validez de su teoría.",
                                "zh": "这一新的科学发现为证明他的理论有效提供了<w>确凿</w>的证据。",
                                "ru": "Это новое научное открытие даёт <w>убедительное</w> доказательство справедливости его теории."
                            }
                        }
