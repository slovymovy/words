                {
                    "sense_id": "717a7f6e-7678-3c84-b189-f624d073d62c",
                    "sense_definition": "Initialism of Organisation de l’Armée Secrète, a historical French dissident paramilitary organization.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_organizations",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "The first real meeting of the <w>OAS</w> was held in mid-May 1961.",
                            "target_lang_translations": {
                                "ru": "Первое настоящее собрание <w>ОАС</w> состоялось в середине мая 1961 года."
                            }
                        },
                        {
                            "text": "Its purpose was to sabotage de Gaulle’s efforts to remove French rule from Algeria, leading to violent clashes involving the <w>OAS</w>.",
                            "target_lang_translations": {
                                "ru": "Его целью был саботаж усилий де Голля по выводу французских войск из Алжира, что привело к жестоким столкновениям с участием <w>ОАС</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "OAS terrorist campaign",
                        "members of the OAS"
                    ],
                    "target_lang_definitions": {
                        "ru": "Секретная вооруженная организация (ОАС) — ультраправая подпольная националистическая организация во Франции во время Алжирской войны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ОАС",
                                "target_lang_sense_clarification": "Секретная вооруженная организация"
                            }
                        ]
                    }
                },
