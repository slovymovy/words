                                "sense_id": "27750acf-e46e-3c3b-abc0-98ec333930c6",
                                "text": "— Я одессит, я из Одессы, здрасьте!"
                            }
                        ]
                    },
                    {
                        "sense_id": "e343235d-60a4-330f-acea-57aefbee3e48",
                        "entry_id": "23d5c77a-f46e-3ac7-b903-ec271bf54820",
                        "glosses": [
                            "разг."
                        ],
