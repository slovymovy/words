                    },
                    {
                        "translation_id": "5131b56e-14ad-4e7a-b235-fa9b57361bfb",
                        "source_entry_id": "ae9aad42-8358-3ba7-94fe-4a4f31065d87",
                        "source_sense_id": "448cf3c1-d6a2-37f2-8414-b9718584e978",
                        "source_sense_description": "Défaut du bois",
                        "target_lang_word": "ring failure",
