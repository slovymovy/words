                ],
                "senses": [
                    {
                        "sense_id": "ff850e0b-fed4-3882-9bdd-e244d3fcc7c2",
                        "entry_id": "3fdb222b-d92b-3fc3-9972-59e9506d4082",
                        "glosses": [
                            "Celui qui se plaît à faire des cachotteries."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b2e868d8-e469-424c-bc57-250f2fcc4985",
                                "sense_id": "ff850e0b-fed4-3882-9bdd-e244d3fcc7c2",
                                "text": "C’est un cachottier, c’est un ladre, c’est un homme, voyez-vous, mademoiselle, qui me laisserait crever plutôt que de me prêter cent sous."
                            },
                            {
                                "example_id": "b78f2056-8460-4659-8f64-75e917382ab0",
                                "sense_id": "ff850e0b-fed4-3882-9bdd-e244d3fcc7c2",
                                "text": "— Alors, reprit-il, vous avez du nouveau sur le chantier ?\nComme la pièce demeurait sans lumière, il distinguait mal l’expression d’Yves, toujours muet.\n— Quel cachottier ! Allons ! poil ou plume ? Vers ou prose ?"
                            },
                            {
                                "example_id": "834fa864-7038-4282-8b07-1ab0c5eb7bc1",
                                "sense_id": "ff850e0b-fed4-3882-9bdd-e244d3fcc7c2",
                                "text": "Hélas pour ces cachottiers, « Le Canard » a pu fourrer son bec duns le document et constater l’ampleur des largesses concédées aux sociétés d’autoroutes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4d20fd7-6471-4739-a385-9ed8cb8e4a92",
                        "source_entry_id": "3fdb222b-d92b-3fc3-9972-59e9506d4082",
                        "source_sense_id": "ff850e0b-fed4-3882-9bdd-e244d3fcc7c2",
                        "target_lang_word": "secretive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secretive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4aeaa780-7c44-3c91-a01f-de6d1756ef47",
                                        "entry_id": "ba1b50f3-1c45-3216-b038-2d042367ff9f",
                                        "glosses": [
                                            "Having an inclination to secrecy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4adb9439-1cc6-49c0-8b6f-041a45968959",
                                                "sense_id": "4aeaa780-7c44-3c91-a01f-de6d1756ef47",
                                                "text": "She's a secretive girl, not giving away much about her life."
                                            },
                                            {
                                                "example_id": "a374e6cd-f7a5-452d-b1c9-b700590975a5",
                                                "sense_id": "4aeaa780-7c44-3c91-a01f-de6d1756ef47",
                                                "text": "Why are you acting all secretive? What are you hiding?"
                                            },
                                            {
                                                "example_id": "e7d9844f-5a4a-4d2a-b4b5-1dea36a73de9",
                                                "sense_id": "4aeaa780-7c44-3c91-a01f-de6d1756ef47",
                                                "text": "Sitting back on a bench in the sunshine, Tom and I began to catch up with each other while the girls arranged their surprises at the remotest picnic table in the lay-by. Genial lorry drivers, munching wurst high in their cabs, looking down on their secretive toing and froing with interest."
                                            }
                                        ]
                                    }
                                ]
                            },
