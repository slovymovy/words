                    },
                    {
                        "sense_id": "9cc042c9-2422-313c-bac4-bcc2b53e7919",
                        "entry_id": "33789c39-2fd6-30be-b153-e3597372a67c",
                        "glosses": [
                            "A conventional act or constraint."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c004a33d-937d-4206-8c36-ca1b4d35740e",
                                "sense_id": "9cc042c9-2422-313c-bac4-bcc2b53e7919",
                                "text": "Having said this, you will not, I trust, suspect me of disliking you for throwing off conventionalisms and speaking to me as a man to a man."
                            }
                        ]
                    },
                    {
                        "sense_id": "e454c2ee-d5cf-3b83-8dec-3e5440c85ddf",
                        "entry_id": "33789c39-2fd6-30be-b153-e3597372a67c",
                        "glosses": [
                            "The doctrine that logical or mathematical principles are simply the expression of conventions."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5597ee64-f8d3-45aa-b9d7-e86ed793f112",
                                "sense_id": "e454c2ee-d5cf-3b83-8dec-3e5440c85ddf",
                                "text": "Skepticism arrives at conventionalism by way of the claims that the conditions on evidential support cannot be satisfied […] but that we must have beliefs in order to carry on."
                            }
                        ]
                    }
