                    {
                        "sense_id": "54a4bbd6-50ab-391f-bfa7-0418cea657fb",
                        "entry_id": "03c7319a-af42-3cb9-b6b6-eedea801d060",
                        "glosses": [
                            "Relatif à l'énurésie ou affecté par cette incontinence diurne ou nocturne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d06e468c-49d6-4321-a3a8-6943289051ab",
                                "sense_id": "54a4bbd6-50ab-391f-bfa7-0418cea657fb",
                                "text": "Je ne porte pas des couches parce que je fais partie des bébés adultes. Je porte des couches par sécurité, car je suis énurétique. Depuis que j'en porte, je me sens plus tranquille."
                            },
                            {
                                "example_id": "ca98e7f9-1dc3-46e1-86b9-a8676ea3853f",
                                "sense_id": "54a4bbd6-50ab-391f-bfa7-0418cea657fb",
                                "text": "Une sorte de serre chaude abritant une plante grasse imprégnée d’une odeur lourde, énurétique."
                            }
                        ]
                    }
                ],
