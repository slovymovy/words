                "senses": [
                    {
                        "sense_id": "40d41bdb-5bf5-358f-bacc-b012693092d2",
                        "entry_id": "6ddd862d-b6b5-3d6d-85f4-240dca28cceb",
                        "glosses": [
                            "Performance nettement moins bonne que ses performances habituelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15abd0d-1355-4f83-9c85-8143ead6c8c0",
                                "sense_id": "40d41bdb-5bf5-358f-bacc-b012693092d2",
                                "text": "Il s'ensuit diverses sensations physiques (p. ex., rougissements, tremblements, transpiration) et une contre-performance des fonctions cognitives (p. ex., problèmes de concentration, trous de mémoire)."
                            },
                            {
                                "example_id": "86565831-bca4-4f76-97cd-9475340dac21",
                                "sense_id": "40d41bdb-5bf5-358f-bacc-b012693092d2",
                                "text": "Pour expliquer les contre-performances françaises, qui incitent à s’interroger avec le Haut Conseil des finances publiques (HCFP) sur le caractère optimiste des hypothèses de croissance du gouvernement pour les années 2015 à 2017, les économistes, de quelque école de pensée qu’ils soient, avancent plusieurs causes."
                            },
                            {
                                "example_id": "6e442aab-9d7b-4228-81eb-aeb75f11b977",
                                "sense_id": "40d41bdb-5bf5-358f-bacc-b012693092d2",
                                "text": "Après un début de saison prometteur, ponctué par deux victoires en trois courses, Ferrari n’a fait qu’enchaîner les boulettes et les contre-performances."
                            }
                        ]
                    }
                ],
