                "senses": [
                    {
                        "sense_id": "faef40e5-7e98-353d-aea1-5454c5377b4d",
                        "entry_id": "9b562072-5852-3304-afa2-766b37106f60",
                        "glosses": [
                            "Qui peut être gradué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b55402a-f400-4243-a0be-6af9acc921d0",
                                "sense_id": "faef40e5-7e98-353d-aea1-5454c5377b4d",
                                "text": "Plus l’amplitude de cette réponse graduable est grande, plus la fréquence des pointes cheminant dans l'axone est élevée."
                            },
                            {
                                "example_id": "ae0919ef-b437-4487-a161-662040284bfe",
                                "sense_id": "faef40e5-7e98-353d-aea1-5454c5377b4d",
                                "text": "L’éthique est, en principes, en intention et en action, une et indivisible. Le respect dû à l’être humain n’est pas graduable, ni négociable ou à géométrie variable."
                            },
                            {
                                "example_id": "193444a6-a947-4ed9-9876-04ed6fe16c9b",
                                "sense_id": "faef40e5-7e98-353d-aea1-5454c5377b4d",
                                "text": "Les répercussions sociétales s’expriment sur un large spectre de gravité si tant est qu’on puisse en juger. Graduable sur une échelle de violence plus ou moins dangereuse pour l’intégrité mentale et/ou physique."
                            }
                        ]
                    },
                    {
                        "sense_id": "baa5e71b-573f-3bd7-852f-406fe546b4e4",
                        "entry_id": "9b562072-5852-3304-afa2-766b37106f60",
                        "glosses": [
                            "Qui peut avoir un niveau d’intensité."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5d5a8ddb-6b20-48b6-aa6d-c13dcccac53b",
                                "sense_id": "baa5e71b-573f-3bd7-852f-406fe546b4e4",
                                "text": "Comme il a été question de noms et de verbes, disons deux mots d’une catégorie d’adjectifs, divisés sur le critère graduable / non graduable. On sait que ce critère est celui qui autorise ou empêche la présence des marqueurs de degré."
                            },
                            {
                                "example_id": "066f54b6-b39d-4d58-b540-1cf853097265",
                                "sense_id": "baa5e71b-573f-3bd7-852f-406fe546b4e4",
                                "text": "Sans être stricto sensu graduable, l’adjectif, par son contexte d’emploi se situe dans un contexte de graduation."
                            }
                        ]
                    },
                    {
                        "sense_id": "78eaf547-53b0-3848-b23d-18140e93b50a",
                        "entry_id": "9b562072-5852-3304-afa2-766b37106f60",
                        "glosses": [
                            "Qualifie une source d’éclairage dont on peut faire varier l’intensité."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5fe8410f-97f2-4a18-acc6-e630454046d4",
                                "sense_id": "78eaf547-53b0-3848-b23d-18140e93b50a",
                                "text": "Grâce à son plafond technique, son éclairage graduable et son mobilier modulable, cet espace peut accueillir diverses manifestations."
                            },
                            {
                                "example_id": "38433c93-7234-4e4c-8270-4411671a1bab",
                                "sense_id": "78eaf547-53b0-3848-b23d-18140e93b50a",
                                "text": "L’éclairage a été soigneusement planifié par zone, et est graduable pour refléter l’heure du jour."
                            }
                        ]
                    }
                ],
