                {
                    "sense_id": "1e1f7745-ceb4-34b7-bbf9-2681ad476df0",
                    "sense_definition": "A store of valuable items or money found hidden or abandoned.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The divers discovered a sunken <w>trove</w> of gold coins off the coast.",
                            "target_lang_translations": {
                                "nl": "De duikers ontdekten een gezonken <w>schat</w> aan gouden munten voor de kust.",
                                "ru": "Водолазы обнаружили у побережья затонувший <w>клад</w> золотых монет."
                            }
                        },
                        {
                            "text": "Archaeologists unearthed a hidden <w>trove</w> of ancient jewelry in the cave.",
                            "target_lang_translations": {
                                "nl": "Archeologen hebben in de grot een verborgen <w>schat</w> aan antieke sieraden opgegraven.",
                                "ru": "Археологи раскопали в пещере спрятанный <w>клад</w> древних украшений."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoard",
                        "cache"
                    ],
                    "common_phrases": [
                        "treasure trove"
                    ],
                    "target_lang_definitions": {
