{
    "word_family": [
        "miscreance",
        "miscreancy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4966d2e0-3274-3d3f-8c89-df1ec12996ee",
                    "sense_definition": "A person who behaves badly, disruptively, or breaks the law.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wrongdoer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The principal decided to suspend the young <w>miscreants</w> who had vandalized the school gym.",
                            "target_lang_translations": {
                                "ru": "Директор решил временно отстранить от занятий юных <w>хулиганов</w>, устроивших погром в школьном спортзале."
                            }
                        },
                        {
                            "text": "Local police are searching for the <w>miscreants</w> responsible for the recent neighborhood thefts.",
                            "target_lang_translations": {
                                "ru": "Местная полиция разыскивает <w>злоумышленников</w>, причастных к недавним кражам в районе."
                            }
                        }
                    ],
                    "synonyms": [
                        "troublemaker",
                        "wrongdoer",
                        "malefactor",
                        "scoundrel"
                    ],
                    "antonyms": [
                        "benefactor",
                        "saint"
                    ],
                    "common_phrases": [
                        "young miscreants",
                        "punish the miscreants"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведет себя плохо, нарушает порядок или закон; нарушитель, хулиган."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарушитель",
                                "target_lang_sense_clarification": "закона или порядка"
                            },
                            {
                                "target_lang_word": "пакостник",
                                "target_lang_sense_clarification": "тот, кто делает мелкие пакости"
                            },
                            {
                                "target_lang_word": "хулиган",
                                "target_lang_sense_clarification": "нарушитель общественного порядка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f69bb790-6e75-3a6d-896f-00e52b317664",
                    "sense_definition": "An unscrupulous villain who is completely unrestrained by moral principles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wrongdoer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel's antagonist is a heartless <w>miscreant</w> who exploits everyone around him without remorse.",
                            "target_lang_translations": {
                                "ru": "Антагонист романа — бездушный <w>негодяй</w>, который без зазрения совести использует всех вокруг."
                            }
                        },
                        {
                            "text": "He was denounced as a moral <w>miscreant</w> after his financial schemes ruined hundreds of families.",
                            "target_lang_translations": {
                                "ru": "Его заклеймили как морального <w>выродка</w> после того, как его финансовые махинации разорили сотни семей."
                            }
                        }
                    ],
                    "synonyms": [
                        "villain",
                        "scoundrel",
                        "reprobate",
                        "blackguard"
                    ],
                    "antonyms": [
                        "hero"
                    ],
                    "common_phrases": [
                        "moral miscreant"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in a dramatic or literary context to emphasize villainy."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бессовестный злодей, полностью лишенный моральных принципов; подлец, негодяй."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "негодяй",
                                "target_lang_sense_clarification": "подлый человек"
                            },
                            {
                                "target_lang_word": "мерзавец",
                                "target_lang_sense_clarification": "человек без моральных принципов"
                            },
                            {
                                "target_lang_word": "злодей",
                                "target_lang_sense_clarification": "совершающий злые дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdc5b55f-170e-3a68-85a1-84a1a71d72c9",
                    "sense_definition": "One who holds a false religious belief; a misbeliever or heretic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heretic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval texts, the knight vowed to vanquish any <w>miscreant</w> who refused to accept the faith.",
                            "target_lang_translations": {
                                "ru": "В средневековых текстах рыцарь клялся победить любого <w>неверного</w>, отказавшегося принять веру."
                            }
                        },
                        {
                            "text": "The zealot regarded all outsiders as mere <w>miscreants</w> doomed to spiritual ruin.",
                            "target_lang_translations": {
                                "ru": "Фанатик считал всех чужаков просто <w>еретиками</w>, обреченными на духовную гибель."
                            }
                        }
                    ],
                    "synonyms": [
                        "heretic",
                        "misbeliever",
                        "infidel",
                        "unbeliever"
                    ],
                    "antonyms": [
                        "believer",
                        "orthodox"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This religious sense is historical and rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, придерживающийся ложного религиозного учения; еретик или иноверец."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "еретик",
                                "target_lang_sense_clarification": "вероотступник"
                            },
                            {
                                "target_lang_word": "иноверец",
                                "target_lang_sense_clarification": "человек другой веры"
                            },
                            {
                                "target_lang_word": "неверный",
                                "target_lang_sense_clarification": "в религиозном контексте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ecd165b4-e777-380d-8f6a-dbee5f2731b6",
                    "sense_definition": "Lacking in conscience or moral principles; unscrupulous and villainous.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unprincipled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was criticized for its <w>miscreant</w> behavior in dumping toxic waste into the river.",
                            "target_lang_translations": {
                                "ru": "Компанию раскритиковали за ее <w>преступное</w> поведение, выразившееся в сбросе токсичных отходов в реку."
                            }
                        },
                        {
                            "text": "How do we get fair treatment when confronting <w>miscreant</w> workers sometimes means no care at all?",
                            "target_lang_translations": {
                                "ru": "Как нам добиться справедливого отношения, если противостояние <w>недобросовестным</w> работникам иногда означает полное отсутствие ухода?"
                            }
                        }
                    ],
                    "synonyms": [
                        "unscrupulous",
                        "unprincipled",
                        "dishonorable",
                        "reprobate"
                    ],
                    "antonyms": [
                        "honorable",
                        "principled",
                        "virtuous"
                    ],
                    "common_phrases": [
                        "miscreant behavior",
                        "miscreant activities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный совести или моральных принципов; недобросовестный, подлый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развращённый",
                                "target_lang_sense_clarification": "испорченный, аморальный"
                            },
                            {
                                "target_lang_word": "недобросовестный",
                                "target_lang_sense_clarification": "нарушающий правила или обязательства"
                            },
                            {
                                "target_lang_word": "подлый",
                                "target_lang_sense_clarification": "бесчестный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec46c951-44cd-3cb9-b76f-845defcdfc3d",
                    "sense_definition": "Holding an incorrect or heretical religious belief.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heretic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sect was condemned for spreading <w>miscreant</w> doctrines throughout the province.",
                            "target_lang_translations": {
                                "ru": "Секту осудили за распространение <w>еретических</w> учений по всей провинции."
                            }
                        },
                        {
                            "text": "He was branded a <w>miscreant</w> teacher for questioning the established dogmas of the church.",
                            "target_lang_translations": {
                                "ru": "Его заклеймили как <w>лжеучителя</w> за то, что он подверг сомнению установленные догматы церкви."
                            }
                        }
                    ],
                    "synonyms": [
                        "heretical",
                        "heterodox",
                        "misbelieving"
                    ],
                    "antonyms": [
                        "orthodox"
                    ],
                    "common_phrases": [
                        "miscreant doctrines"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This religious sense is historical and rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Придерживающийся неверного или еретического религиозного учения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "еретический",
                                "target_lang_sense_clarification": "противоречащий догматам церкви"
                            },
                            {
                                "target_lang_word": "лжеучительский",
                                "target_lang_sense_clarification": "относящийся к ложному учению"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}