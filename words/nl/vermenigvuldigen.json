                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bacteriën in de schaal <w>vermenigvuldigen</w> zich razendsnel bij deze temperatuur.",
                            "target_lang_translations": {
                                "en": "The bacteria in the dish <w>multiply</w> very rapidly at this temperature."
