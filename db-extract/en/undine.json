                        "glosses": [
                            "A female water-sprite or nymph."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "06762bda-a4d4-3157-9caf-b5a2cf25602c",
                        "entry_id": "3fb88760-9552-3389-9670-a51033864e0b",
