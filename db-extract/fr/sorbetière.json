                                    },
                                    {
                                        "sense_id": "c0a39621-1fd2-3920-9d24-522199708933",
                                        "entry_id": "b102075c-a50a-3e28-8d3d-b649d55b238e",
                                        "glosses": [
                                            "A company or person that makes ice cream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b891a88f-7bd4-4525-991f-acd5e99981ec",
                                                "sense_id": "c0a39621-1fd2-3920-9d24-522199708933",
                                                "text": "The ice cream maker gave particular attention to the Progress ammonia or direct expansion freezer in 50 and 100 quart capacities shown in this booth and a new 60 quart H. Atkinson brine freezer."
                                            },
                                            {
                                                "example_id": "729b1f9b-15ef-4cf8-8a0e-75fadc375ad5",
                                                "sense_id": "c0a39621-1fd2-3920-9d24-522199708933",
                                                "text": "An ice cream maker gives local school children a firsthand look at the ice cream process."
                                            },
                                            {
                                                "example_id": "5e0e7a02-f6c6-4ed1-a224-eef51003f5f1",
                                                "sense_id": "c0a39621-1fd2-3920-9d24-522199708933",
                                                "text": "Ben & Jerry’s, the ice cream maker, gives away 7 1/2 percent of its pretax profits in support of environmental preservation."
                                            },
                                            {
                                                "example_id": "df716fcb-581a-4ec7-9b23-f39e9fa17f00",
                                                "sense_id": "c0a39621-1fd2-3920-9d24-522199708933",
                                                "text": "If your ice cream maker gives your laboratory analyst a sample of the complete mix at 8 o’clock, in just forty minutes the operator can tell him the exact butter fat and total solids content in the mix."
                                            }
                                        ]
