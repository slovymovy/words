                        "glosses": [
                            "niet meer verder kunnen gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b25e152-8464-401d-bf10-7525b0e0a235",
                                "sense_id": "21dda635-3ba6-3218-b650-0847bafe8d12",
                                "text": "Maar Dekker vindt het nog slechter om leerlingen op een school te laten die \"zwak, zeer zwak is en over een paar maanden financieel gaat vastdraaien\". Hij wees erop dat leraren al om zich heen kijken of ze ergens anders aan de slag kunnen."
                            }
                        ]
                    }
