    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9ecfa95-2dbf-32fd-8688-d0be3cb0913a",
                    "sense_definition": "Représenter ou faire connaître une personne, un lieu ou une chose avec précision par la parole ou par l'écrit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pouvez-vous me <w>décrire</w> l'aspect physique de cet homme avec exactitude ?"
                        },
                        {
                            "text": "L'écrivain prend plaisir à <w>décrire</w> la scène avec de très nombreux détails."
                        }
                    ],
                    "synonyms": [
                        "dépeindre",
                        "relater"
                    ],
                    "common_phrases": [
                        "décrire la scène",
                        "décrire en détail"
                    ]
                },
                {
                    "sense_id": "3e14314f-4c8f-326f-813f-dc0bbf188485",
                    "sense_definition": "Tracer ou suivre une trajectoire, une courbe ou une figure géométrique dans l'espace.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avion a commencé à <w>décrire</w> un cercle parfait au-dessus de la piste avant d'atterrir."
                        },
                        {
                            "text": "La sonde spatiale s'apprête à <w>décrire</w> une orbite elliptique autour de la planète rouge."
                        }
                    ],
                    "synonyms": [
                        "tracer"
                    ],
                    "common_phrases": [
                        "décrire un cercle",
                        "décrire une trajectoire",
                        "décrire une courbe"
                    ]
                },
                {
                    "sense_id": "061469e0-7764-305a-bedf-2f154dcabeb8",
                    "sense_definition": "Parcourir un chemin, un itinéraire ou une boucle spatiale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le convoi a dû <w>décrire</w> un vaste détour pour contourner la zone inondée."
                        },
                        {
                            "text": "Les marcheurs fatigués <w>décrivaient</w> une longue boucle à travers les sentiers escarpés."
                        }
                    ],
                    "synonyms": [
                        "parcourir"
                    ],
                    "common_phrases": [
                        "décrire un circuit",
                        "décrire une boucle"
                    ]
                }
            ]
        }
    ]
