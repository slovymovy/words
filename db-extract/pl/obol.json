                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da0cd865-33bd-3e6f-8fb4-bbbfd0876c81",
                        "entry_id": "1a324c40-c683-3489-b2ca-b09edb7481bd",
                        "glosses": [
                            "Obolus"
                        ],
                        "tags": [
                            "mittelalterliches Polen",
