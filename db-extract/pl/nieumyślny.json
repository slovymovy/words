                                                "example_id": "3b17cb98-ff34-48cd-a4b0-66403d0ccb7b",
                                                "sense_id": "80df7196-1626-3e9f-848f-c4b33a339213",
                                                "text": "The way to trueth is but one and simple, that of particular profit and benefit of affaires a man hath in charge, double, uneven and accidentall [translating fortuite]."
                                            }
                                        ]
                                    },
