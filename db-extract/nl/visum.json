                "senses": [
                    {
                        "sense_id": "c33de05f-fcd5-36bb-9a12-f5ca6b223829",
                        "entry_id": "c5c1a2cc-230b-368b-9f99-494b266ad2d6",
                        "glosses": [
                            "een officiële toestemming een land binnen te reizen en in dat land te verblijven, afgegeven door het betreffende land."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a32ffff-7449-4669-ba0c-104bad9a946b",
                                "sense_id": "c33de05f-fcd5-36bb-9a12-f5ca6b223829",
                                "text": "Om sommige landen binnen te reizen is er een visum nodig."
                            },
                            {
                                "example_id": "a7babc2e-c2ce-4da9-982d-b14dd8850e59",
                                "sense_id": "c33de05f-fcd5-36bb-9a12-f5ca6b223829",
                                "text": "Stap voor stap kon ik nalezen hoe zij haar Amerikaanse visum had geregeld, welke telefoonprovider het meest geschikt was en welke uitrusting ze had aangeschaft."
                            },
                            {
                                "example_id": "98c3cd7c-c367-4a09-8a63-9ef4f635b14c",
                                "sense_id": "c33de05f-fcd5-36bb-9a12-f5ca6b223829",
                                "text": "Vervolgens duurt het drie maanden voor je alles rondom visums en vergunningen hebt uitgezocht."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bf21b31-64f8-3b9d-a378-9f7270534bed",
                        "entry_id": "c5c1a2cc-230b-368b-9f99-494b266ad2d6",
                        "glosses": [
                            "het bewijs dat een architect is ingeschreven bij de Orde van Architecten."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5af79a8a-6546-4d9b-ab54-f7ea12e861d0",
                        "source_entry_id": "c5c1a2cc-230b-368b-9f99-494b266ad2d6",
                        "target_lang_word": "visa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67d9a22e-b024-3ce6-97e1-31b3f46fe69d",
                                        "entry_id": "a689da8d-7080-365e-8ded-0c38cf4c742b",
                                        "glosses": [
                                            "A permit to enter and leave a country, normally issued by the authorities of the country to be visited."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7092d55e-a6b5-42c7-a804-c8c8d9e1b2b6",
                                                "sense_id": "67d9a22e-b024-3ce6-97e1-31b3f46fe69d",
                                                "text": "I came on a six-month tourist visa."
                                            },
                                            {
                                                "example_id": "7bebfab1-7b2c-4e6a-b7b1-711a1e50e025",
                                                "sense_id": "67d9a22e-b024-3ce6-97e1-31b3f46fe69d",
                                                "text": "Several Sun MySQLers have been denied short stay business visas to Australia - yes, Australia - as they attempted to attend a Linux conference in Hobart, Tasmania. According to a blog post from Kaj Arno, vice president in charge of \"database community\" at Sun Microsystems, several employees - many of whom worked with MySQL - have been barred from entering Oz."
                                            },
                                            {
                                                "example_id": "314f4bdc-1944-448d-8f0f-c1d534f54691",
                                                "sense_id": "67d9a22e-b024-3ce6-97e1-31b3f46fe69d",
                                                "text": "However, I couldn't continue by land to Georgia, as I would have liked: Russia still maintains its crazy, Sovietesque visa regulations, which makes getting a transit visa extremely difficult and extremely expensive."
                                            },
                                            {
                                                "example_id": "6894fda0-8c7d-4352-afda-e10a990ec220",
                                                "sense_id": "67d9a22e-b024-3ce6-97e1-31b3f46fe69d",
                                                "text": "The impact would be smaller in the immediate term given that the Trump proclamation allows existing visa holders to remain in the US, but still, at MSK around 100 new scientific and medical trainees this year would not be allowed to commence their research."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "visa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "873815ee-12c9-30d2-a811-04c1ed6b068c",
                                        "entry_id": "4a412175-f51e-3aff-a1ae-7f639d5b6db5",
                                        "glosses": [
                                            "To endorse (a passport, etc.)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28a1ef8d-46cb-4d61-8165-044f98b314a7",
                                                "sense_id": "873815ee-12c9-30d2-a811-04c1ed6b068c",
                                                "text": "\"Let me tell you that I am going to spit into that coffee! Yes, and if you do not get me my passport visaed this very minute, I shall take it to Monsignor myself.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58d8a743-a9a2-4859-9780-5b383103eec9",
                        "source_entry_id": "c5c1a2cc-230b-368b-9f99-494b266ad2d6",
                        "target_lang_word": "visé",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visé",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93d756fa-9b4b-37cf-bd80-49aa1ab5c913",
                                        "entry_id": "970d00c8-6049-3eb8-b499-cec996c347b1",
                                        "glosses": [
                                            "visa."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9b96a21-e4e7-4835-b728-3d195aad4487",
                                                "sense_id": "93d756fa-9b4b-37cf-bd80-49aa1ab5c913",
                                                "text": "A minister cannot make any direct charge for giving or viséing a passport (though his porter always takes care to ask for something), whereas the Russian consul always charges a dollar banco for every visé."
                                            },
                                            {
                                                "example_id": "38ec3284-7df9-4cf3-80fb-c49c7c29a24f",
                                                "sense_id": "93d756fa-9b4b-37cf-bd80-49aa1ab5c913",
                                                "text": "[…] promising her that he would not print a word to which her approval should not be expressly given. She should countersign every page before it went to press, and none should leave the house without her visé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "visé",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3382bb9-bd9b-3b10-9331-78ea4a495ff8",
                                        "entry_id": "2a366705-4e98-3537-8f92-12dc968e9d9f",
                                        "glosses": [
                                            "To examine and endorse (a passport, etc.); to visa."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95e6d522-0d70-4066-9fa4-557059033e19",
                                                "sense_id": "c3382bb9-bd9b-3b10-9331-78ea4a495ff8",
                                                "text": "[…] unable to be abroad after ten at night, or to carry a gun, or to remove into another district without a written pass which must be visé on reaching a police-station."
                                            },
                                            {
                                                "example_id": "bb79c250-ea0f-4279-8ce5-46fb1bc044fa",
                                                "sense_id": "c3382bb9-bd9b-3b10-9331-78ea4a495ff8",
                                                "text": "Russian consuls everywhere have been instructed to visé passports of geologists presenting membership cards, which will also facilitate matters at the frontier."
                                            },
                                            {
                                                "example_id": "f691663e-4306-4028-ac72-ea0dc58c8600",
                                                "sense_id": "c3382bb9-bd9b-3b10-9331-78ea4a495ff8",
                                                "text": "Therefore, with my passport properly viséd and my papers all in order, I one night left Hull for Stockholm by the weekly Wilson service."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c36c3ad5-8c40-445e-95ce-6116fa9f9e1a",
