                "senses": [
                    {
                        "sense_id": "21dfb3f7-5ca0-3ccb-aa44-780a6594048b",
                        "entry_id": "71cb965d-e839-3f7f-bb10-de5e821d18b5",
                        "glosses": [
                            "iets waarop men kan terugvallen als er iets mis gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a558b40a-e043-4284-a33c-c155fc6edbeb",
                                "sense_id": "21dfb3f7-5ca0-3ccb-aa44-780a6594048b",
                                "text": "Bovendien doen de vaste praatpalen dienst als achtervang, voor het geval het mobiele belverkeer uitvalt."
                            },
                            {
                                "example_id": "dc740072-4a56-4f55-9a95-d0e13c14696d",
                                "sense_id": "21dfb3f7-5ca0-3ccb-aa44-780a6594048b",
                                "text": "De instelling, die is opgericht als achtervang van corporaties, creëerde de mogelijkheid om over meerdere jaren geld te lenen zonder dat werd gekeken wat corporaties met de financiering deden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e850485-202a-4508-90be-6869255671b3",
                        "source_entry_id": "71cb965d-e839-3f7f-bb10-de5e821d18b5",
                        "source_sense_id": "21dfb3f7-5ca0-3ccb-aa44-780a6594048b",
                        "source_sense_description": "iets waarop men kan terugvallen als er iets mis gaat",
                        "target_lang_word": "back up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "back up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f288751-a3a7-3ed7-a0b0-f3d1b2749ae1",
                                        "entry_id": "939397bf-3620-39df-9884-fa96e766c38c",
                                        "glosses": [
                                            "To move backwards, especially for a vehicle to do so."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7030d84b-4c1b-4201-8e70-d657e5dec42b",
                                                "sense_id": "8f288751-a3a7-3ed7-a0b0-f3d1b2749ae1",
                                                "text": "That beeping sound indicates that the truck is backing up."
                                            },
                                            {
                                                "example_id": "f5e553dd-1176-472c-8149-cc7a2a049527",
                                                "sense_id": "8f288751-a3a7-3ed7-a0b0-f3d1b2749ae1",
                                                "text": "We expressed our readiness, and in ten minutes were in the station wagon, rolling rapidly down the long drive, for it was then after nine.[…]As we reached the lodge we heard the whistle, and we backed up against one side of the platform as the train pulled up at the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "140b0140-f856-3a58-bd97-29bde27f0e8d",
                                        "entry_id": "939397bf-3620-39df-9884-fa96e766c38c",
                                        "glosses": [
                                            "To move a vehicle backwards."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4a48153-1ed0-44fa-9df8-67579d9246af",
                                                "sense_id": "140b0140-f856-3a58-bd97-29bde27f0e8d",
                                                "text": "Back up the car a little, you're blocking the driveway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73648bf9-fbdf-355b-bab3-76149080d213",
                                        "entry_id": "939397bf-3620-39df-9884-fa96e766c38c",
                                        "glosses": [
                                            "To undo one's actions."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22cd3087-bd96-4930-891d-ac8318b110dc",
                                                "sense_id": "73648bf9-fbdf-355b-bab3-76149080d213",
                                                "text": "I couldn't see how to finish the project, so I backed up and tried it another way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8ecb1a-0ca3-387c-9e36-128508add25e",
                                        "entry_id": "939397bf-3620-39df-9884-fa96e766c38c",
                                        "glosses": [
                                            "To reconsider one's thoughts."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13027475-2b07-4752-8575-14fe26804aab",
                                                "sense_id": "5f8ecb1a-0ca3-387c-9e36-128508add25e",
                                                "text": "This isn't working. Let's back up and think about it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69fbdd99-4705-3fda-ba65-29c9aa1e9e7b",
                                        "entry_id": "939397bf-3620-39df-9884-fa96e766c38c",
                                        "glosses": [
                                            "To copy (data) so that it can be restored if the main copy is lost."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dd55626-06a3-4fcb-806c-a5ec0f9848d0",
                                                "sense_id": "69fbdd99-4705-3fda-ba65-29c9aa1e9e7b",
                                                "text": "Back up your documents folder before applying the update."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10fa3cc3-2af0-3cbf-825d-805ce1737e53",
                                        "entry_id": "939397bf-3620-39df-9884-fa96e766c38c",
                                        "glosses": [
                                            "To provide support or the promise of support to."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76c476bb-fcd9-450c-98f3-173bc4010286",
                                                "sense_id": "10fa3cc3-2af0-3cbf-825d-805ce1737e53",
                                                "text": "You should be careful. This guy is backed up by the local gang."
                                            },
                                            {
                                                "example_id": "ef9ef200-7ec7-4fd7-a7fe-6560b874dc25",
                                                "sense_id": "10fa3cc3-2af0-3cbf-825d-805ce1737e53",
                                                "text": "When he said I wasn't there, I told him I was, and my buddy backed me up."
                                            },
                                            {
                                                "example_id": "1f6abdaa-9e1b-4193-b075-4568ecdaf666",
                                                "sense_id": "10fa3cc3-2af0-3cbf-825d-805ce1737e53",
                                                "text": "Thank you for backing me up. I know it's not easy delivering bad news-especially to a friend-but sometimes it's the only way we can move forward and begin to heal."
                                            },
                                            {
                                                "example_id": "44a7fbc7-20f5-4a21-8cb9-b1e2e8add169",
                                                "sense_id": "10fa3cc3-2af0-3cbf-825d-805ce1737e53",
                                                "text": "Researching and corroborating facts to put in my script is one thing, but getting sources to back up the assertions of interviewed contributors can be quite another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3653aa6e-133e-3241-a928-a71a93a7bae5",
                                        "entry_id": "939397bf-3620-39df-9884-fa96e766c38c",
                                        "glosses": [
                                            "For the non-striker to take a few steps down the pitch, in preparation to taking a run, just as the bowler bowls the ball."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7899c0a-27c2-3310-893e-d540d35c6605",
                                        "entry_id": "939397bf-3620-39df-9884-fa96e766c38c",
                                        "glosses": [
                                            "For a fielder to position himself behind the wicket (relative to a team-mate who is throwing the ball at the wicket) so as to stop the ball, and prevent overthrows."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "594b105d-9e78-3a35-8336-57b08da895d0",
                                        "entry_id": "939397bf-3620-39df-9884-fa96e766c38c",
                                        "glosses": [
                                            "To halt the flow or movement of something."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d045109a-872b-427c-9936-5876266dff3f",
                                                "sense_id": "594b105d-9e78-3a35-8336-57b08da895d0",
                                                "text": "When I flushed the toilet, the plumbing backed up and burst."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fb065f2-80a3-3631-b368-b721a7000f10",
                                        "entry_id": "939397bf-3620-39df-9884-fa96e766c38c",
                                        "glosses": [
                                            "To fill up because of a backlog."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14a4b313-0c22-4d4f-b829-92215976c387",
                                                "sense_id": "8fb065f2-80a3-3631-b368-b721a7000f10",
                                                "text": "WAITRESS: Hurry up with those drinks, Lucy. We're backing up. (Grabs the drinks LUCY has poured.) What are you doing? These are regular. They all ordered large."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d482e56a-9ea7-378a-bdd2-a7d187437d6d",
                                        "entry_id": "939397bf-3620-39df-9884-fa96e766c38c",
                                        "glosses": [
                                            "To run a printing press in reverse."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
