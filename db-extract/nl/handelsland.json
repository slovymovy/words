                        "glosses": [
                            "een land dat veel geld verdient met de inkoop, verkoop en transport van goederen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "761d6db7-7d74-474d-9f2d-19b3600ad886",
                                "sense_id": "f8be8b9e-c3de-3866-bf1e-3bd24b0a21a1",
                                "text": "Er moest wel verkocht blijven worden in dit handelsland. Alle specialisten op het gebied van business development, vooral degenen met ervaring, zijn gewild."
                            },
                            {
                                "example_id": "784425c2-c39f-4878-88e8-37287154a9a7",
                                "sense_id": "f8be8b9e-c3de-3866-bf1e-3bd24b0a21a1",
                                "text": "De luchtvaartsector verdedigt het hub-and-spoke-model van Schiphol met meer dan 300 bestemmingen. Vincent van Hooff, het Hoofd Vliegdienst van KLM, meent dat Nederland als internationaal handelsland deze verbindingen nodig heeft om een welvarende economie te hebben."
                            }
                        ]
