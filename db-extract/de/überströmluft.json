                ],
                "senses": [
                    {
                        "sense_id": "4d50fb29-4bbd-3782-891a-4ff90a921477",
                        "entry_id": "8c8ce817-cb3f-354a-bbc5-4f0c42dd7590",
                        "glosses": [
                            "abzuführende Raumluft, die gezielt von dem einen zum nächsten Raum oder Bereich, weiter strömt"
                        ],
                        "tags": [
                            "Lüftungstechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "2b3963e1-9024-497f-8421-2892d23c3008",
                                "sense_id": "4d50fb29-4bbd-3782-891a-4ff90a921477",
                                "text": "„Diese kommerziell erhältliche Lüftungzarge (Keller AG, Schweiz), besitzt einen schallgedämmten Durchgang für die Überströmluft und einen Bodennahen Auslass für die Zuluft.“"
                            },
                            {
                                "example_id": "3e5cc420-ed4e-4659-8a91-556bf54087b6",
                                "sense_id": "4d50fb29-4bbd-3782-891a-4ff90a921477",
                                "text": "„Die Schallkulissen für Überströmluft besitzen für eine zusätzliche Verbesserung der akustischen Eigenschaften außerdem eine Winkeländerung.“"
                            },
                            {
                                "example_id": "b39f3159-1d26-4844-b1c3-3bcc1adf5c23",
                                "sense_id": "4d50fb29-4bbd-3782-891a-4ff90a921477",
                                "text": "„Tabelle 11 der DIN EN 13779 – Volumenströme der Außenluft oder Überströmluft je Bodenfläche (Nettofläche) für Räume, die nicht für den Aufenthalt von Personen bestimmt sind.“"
                            },
                            {
                                "example_id": "94255b82-3a02-4563-b719-d07c93bcd6e2",
                                "sense_id": "4d50fb29-4bbd-3782-891a-4ff90a921477",
                                "text": "„Für die ungehinderte Luftströmung von den Zulufträumen zu den Ablufträumen sind Überströmluft-Durchlässe (ÜLD) einzusetzen.“"
                            },
                            {
                                "example_id": "969e5b50-88cf-441a-b10a-83ba143de663",
                                "sense_id": "4d50fb29-4bbd-3782-891a-4ff90a921477",
                                "text": "„Die Überströmluft (aufwändig aufbereitete und sterilfiltrierte Luft) aus OP-Räumen sollte aus energetischen Gründen soweit als möglich zur Belüftung vorgelagerter Räume der OP-Abteilung verwendet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
