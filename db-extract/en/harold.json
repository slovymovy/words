    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a78120ba-e3a8-3752-a4b1-7d1c92911629",
                "word": "Harold",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0f3745c5-36eb-4f06-ab51-41dfcb6de079",
                        "entry_id": "a78120ba-e3a8-3752-a4b1-7d1c92911629",
                        "tags": [
                            "plural"
                        ],
                        "form": "Harolds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "be62c864-ddfa-3fb2-9d03-1874426da60d",
                        "entry_id": "a78120ba-e3a8-3752-a4b1-7d1c92911629",
                        "glosses": [
                            "A male given name from Old English or Old Norse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dc83388-1657-47c7-bd6d-8322b654d84b",
                                "sense_id": "be62c864-ddfa-3fb2-9d03-1874426da60d",
                                "text": "For I have heard the Steers / Had land in Saxon times; and your own name / Of Harold sounds so English and so old / I am sure you must be proud of it."
                            },
                            {
                                "example_id": "4589381b-1228-40f7-b67d-fa2b841d910c",
                                "sense_id": "be62c864-ddfa-3fb2-9d03-1874426da60d",
                                "text": "She called her husband Hal because no one else had ever done so and it had a dashing ring, rather out of keeping with Harold's appearance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86db21cd-c6a2-49cf-851a-93bfe1f1680c",
                        "source_entry_id": "a78120ba-e3a8-3752-a4b1-7d1c92911629",
                        "source_sense_id": "be62c864-ddfa-3fb2-9d03-1874426da60d",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Hérault",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hérault",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e44b51f2-cafb-3f41-8b65-5e7bfead665a",
                                        "entry_id": "f0467e96-c2ee-3d27-aa40-0fae434f6581",
                                        "glosses": [
                                            "Fleuve côtier du sud de la France."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d1706f5-0fd9-3cd9-b56a-bb766379ebca",
                                        "entry_id": "f0467e96-c2ee-3d27-aa40-0fae434f6581",
                                        "glosses": [
                                            "Département français d'Occitanie, qui porte le numéro 34."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60517842-4733-4922-9be6-6aab94af8502",
                                                "sense_id": "0d1706f5-0fd9-3cd9-b56a-bb766379ebca",
                                                "text": "Mais le département de l’Hérault n’écarte pas la possibilité d’utiliser ce « béton coquillé » ailleurs, s’il s’avère, toutefois, aussi performant que le traditionnel."
                                            },
                                            {
                                                "example_id": "4f67dca6-e29e-4f82-af68-2c305ce29d4e",
                                                "sense_id": "0d1706f5-0fd9-3cd9-b56a-bb766379ebca",
                                                "text": "Salut à toi, puisque tu as le succès, puisque tu fais de tes vignerons des multimillionnaires, ô Hérault rouge, ô Hérault vainqueur, source intarissable du vin populaire, métropole de ce pinard démocratique, devenu indispensable aux citoyens conscients."
                                            },
                                            {
                                                "example_id": "20be181b-5260-4b88-8f84-bf90498c86be",
                                                "sense_id": "0d1706f5-0fd9-3cd9-b56a-bb766379ebca",
                                                "text": "Il y a quelques jours, un pompier l’a aidé, au téléphone, à mettre son bébé au monde, tandis que sa femme était en train d’accoucher, chez eux, à Sérignan (Hérault)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
