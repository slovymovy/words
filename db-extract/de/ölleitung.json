                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oléoduc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49204f5b-0cab-37f8-986a-7e1df379d36d",
                                        "entry_id": "81edf71c-ba41-38be-92a6-1ecd677f9d42",
                                        "glosses": [
                                            "Tube de transport de pétrole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e13c0ce-baa0-4315-8507-281cd8909be1",
                                                "sense_id": "49204f5b-0cab-37f8-986a-7e1df379d36d",
                                                "text": "Les pétroliers géants ne pouvant emprunter le canal, le projet d'un oléoduc transisthmique vit le jour à la fin des années 1970. Commencé en 1981 et mis en service début 1983, cet oléoduc sert au transport du pétrole en provenance des gisements de l'Alaska et à destination des raffineries de la côte est des États-Unis."
                                            },
                                            {
                                                "example_id": "621ae78a-1409-436e-9832-6d4f5c194019",
                                                "sense_id": "49204f5b-0cab-37f8-986a-7e1df379d36d",
                                                "text": "Les oléoducs de petit diamètre servent au transport des hydrocarbures sur de courtes distances, les longs trajets étant assurés par les chemins de fer ou les bateaux."
                                            },
                                            {
                                                "example_id": "b66c5423-129a-48a2-935c-f79c36620c7d",
                                                "sense_id": "49204f5b-0cab-37f8-986a-7e1df379d36d",
                                                "text": "Prenez les oléoducs, où le fédéral réaffirme continuellement son pouvoir de l’imposer au Québec."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a57807b-e8e9-4361-809a-94d7e455b1f9",
                        "source_entry_id": "08bd4d9b-2d9b-341d-801e-37849285316e",
                        "source_sense_id": "15256272-06f6-3ca7-b0d2-080743417044",
                        "source_sense_description": "Rohr oder Rohrsystem zum Transport von Öl",
                        "target_lang_word": "pipeline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pipeline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e51b2ffb-e388-366a-98bb-38ec84655b98",
                                        "entry_id": "e55d0b32-ecc9-3033-a9e3-43ebb3882022",
                                        "glosses": [
                                            "Oiseau de mer, voisin des mauves, huitrier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ac06805-62c5-481f-8f2b-a035a055b8ee",
                                                "sense_id": "e51b2ffb-e388-366a-98bb-38ec84655b98",
                                                "text": "L’ostralègue européenne est dite vulgairement huîtrier, pie de mer, et pipeline."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pipeline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca3a9ccd-5252-323b-a45a-e010377c68c7",
                                        "entry_id": "5a957ff4-4747-398d-97db-bab1a5ec1485",
                                        "glosses": [
                                            "Canalisation composée de tubes utilisée pour transporter des fluides et en particulier du pétrole ou du gaz ; oléoduc, gazoduc."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cb1c7d3-66bc-4f16-9509-17179ffc8a9e",
                                                "sense_id": "ca3a9ccd-5252-323b-a45a-e010377c68c7",
                                                "text": "La planète brûle et on l’arrose avec du gaz et du pétrole ! Ces énergies fossiles passeront bientôt dans de beaux pipelines tout neufs, financés avec notre argent."
                                            },
                                            {
                                                "example_id": "4d234df6-09ee-42d8-a8d3-18333c0de310",
                                                "sense_id": "ca3a9ccd-5252-323b-a45a-e010377c68c7",
                                                "text": "Objets de bras de fer géopolitiques ces derniers mois, les deux pipelines exploités par un consortium dépendant du géant russe Gazprom étaient encore remplis de gaz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdd57553-ffdb-3df8-819e-cf5c7fea9c2a",
                                        "entry_id": "5a957ff4-4747-398d-97db-bab1a5ec1485",
                                        "glosses": [
                                            "Système à travers lequel quelque chose est conduit."
                                        ],
                                        "tags": [
                                            "generically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac82abb0-a21c-3e48-be20-fa711cbc02e4",
                                        "entry_id": "5a957ff4-4747-398d-97db-bab1a5ec1485",
                                        "glosses": [
                                            "Canal de transmission de l’information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bb1d867-b113-4166-9bf8-94ee2d1abfdc",
                                                "sense_id": "ac82abb0-a21c-3e48-be20-fa711cbc02e4",
                                                "text": "Le rendu d’images 3D est réalisé en utilisant un pipeline graphique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c72f73f-956f-3302-8f33-1d96e11371a6",
                                        "entry_id": "5a957ff4-4747-398d-97db-bab1a5ec1485",
                                        "glosses": [
                                            "Technique de conception des processeurs, leur permettant de traiter l’information en parallèle, sur plusieurs étages dont le nombre détermine la profondeur du pipeline."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "380cb34a-9a63-37d1-bada-1ea9c1902ac0",
                                        "entry_id": "5a957ff4-4747-398d-97db-bab1a5ec1485",
                                        "glosses": [
                                            "Méthode de communication inter-processus via un tube."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e167533-5f3b-3f07-a269-5044e3bc06d2",
                                        "entry_id": "5a957ff4-4747-398d-97db-bab1a5ec1485",
                                        "glosses": [
                                            "Succession d'étapes d'intégration continue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8de2405-40fc-4e2c-911e-e4d8cc0908ac",
                                                "sense_id": "3e167533-5f3b-3f07-a269-5044e3bc06d2",
                                                "text": "Un pipeline Jenkins se compose de plusieurs états ou étapes, et ils sont exécutés dans une séquence l'un après l'autre."
                                            },
                                            {
                                                "example_id": "722455aa-867a-4e8c-85e0-2890d4fe7dd2",
                                                "sense_id": "3e167533-5f3b-3f07-a269-5044e3bc06d2",
                                                "text": "Le terme consacré pour cette chaîne de fabrication est alors le « pipeline de déploiement », qui étend son contrôle sur les activités de qualification et d'automatisation du déploiement, objet des chapitres suivants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b96bdcd7-2187-348e-a8b7-773a18d44fca",
                                        "entry_id": "5a957ff4-4747-398d-97db-bab1a5ec1485",
                                        "glosses": [
                                            "Schéma largement observé de développement des intérêts personnels, des circonstances ou des opinions."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbbc7f59-643b-4892-8f12-5eb0b9ac9381",
                                                "sense_id": "b96bdcd7-2187-348e-a8b7-773a18d44fca",
                                                "text": "À l'époque je tolérais Joe Rogan, maintenant il est dans la pipeline extrême-droite et c'est triste. Ses émissions sont devenues catastrophiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
