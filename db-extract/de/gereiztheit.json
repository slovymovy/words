                        "form": "der Gereiztheit"
                    },
                    {
                        "form_id": "262d6e34-884b-4c2c-81c4-ee50701178d0",
                        "entry_id": "ded93f93-8d97-37af-ae6b-9e3466fcdef5",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Gereiztheit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                        "entry_id": "ded93f93-8d97-37af-ae6b-9e3466fcdef5",
                        "glosses": [
                            "Zustand nervlich angespannter Stimmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d728877-dd6c-4bb1-8868-5826beef17ba",
                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                "text": "Am Ende des Arbeitstages schleppte er den Stress und die Gereiztheit oft mit nach Hause."
                            },
                            {
                                "example_id": "59841b73-b480-470a-8598-4fbca3cec0fc",
                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                "text": "„Als Bruni bemerkt, dass Isoldes depressive Gereiztheit zunimmt, äußert sie ihre Vermutung, dass es für Percys Reserviertheit neben der Nibelungentreue noch handfestere Gründe geben könnte, wogegen halt schärfere Aphrodisiaka eingesetzt werden müssten.“"
                            },
                            {
                                "example_id": "0fbd59f4-5239-4f89-9b90-b8ea44a946ac",
                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                "text": "„Alle ihre Gereiztheit war plötzlich verschwunden, und ihre unruhigen, fragenden Augen hafteten in gieriger Erwartung an seinem Gesicht.“"
                            },
                            {
                                "example_id": "81f7df7e-bb1f-43b2-8275-fc2405916b40",
                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                "text": "„Sie lachte herzlich, denn der Ton, in dem St. Armaud dies sagte, klang durchaus liebenswürdig und jedenfalls ebenso frei von Gereiztheit wie Tadel.“"
                            },
                            {
                                "example_id": "9fe2e779-d03a-4b43-b29f-874837c33d3f",
                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                "text": "„Wenn Karl Emonds eine Siebenzimmerwohnung hätte, wäre die Gereiztheit, das Gehetztsein nicht mehr unumgänglich.“"
                            },
                            {
                                "example_id": "a6a04519-9fe0-48f3-9724-46b95a17fc01",
                                "sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                                "text": "„Als Ferris sein Büro betrat, musterte Hoffman ihn über den Rand seiner Lesebrille hinweg mit einer Mischung aus Gereiztheit und Erstaunen, als habe er total vergessen, dass er Ferris herbestellt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a41d6104-d962-4e1e-a09b-82046ea458d6",
                        "source_entry_id": "ded93f93-8d97-37af-ae6b-9e3466fcdef5",
                        "source_sense_id": "dc51487c-701d-3dee-a7d7-1210ce34ea02",
                        "source_sense_description": "Zustand nervlich angespannter Stimmung",
                        "target_lang_word": "irritation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irritation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "819e886c-5d5f-3c95-a816-a27ff78e8259",
                                        "entry_id": "ea77443e-c9ef-3706-840e-7e087801a556",
                                        "glosses": [
                                            "Réaction inflammatoire locale, souvent douloureuse, affectant un tissu ou un organe exposé à un agent irritant (chimique, physique ou infectieux)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a71c8cc-9b16-44b6-9c0a-13e36b9980fe",
                                                "sense_id": "819e886c-5d5f-3c95-a816-a27ff78e8259",
                                                "text": "L’application de ce médicament sur la peau y détermine une irritation très vive. Ses nerfs sont dans une grande irritation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fe19f9c-25e1-3958-8e52-3a748c1a2058",
                                        "entry_id": "ea77443e-c9ef-3706-840e-7e087801a556",
                                        "glosses": [
                                            "Action exercée par un stimulus irritant sur un tissu vivant, notamment les nerfs ou les muqueuses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66b9c0b6-69a6-31e8-b5db-a331d4392065",
                                        "entry_id": "ea77443e-c9ef-3706-840e-7e087801a556",
                                        "glosses": [
                                            "Effet local, non corrosif, provoqué par un agent chimique sur un tissu vivant, se traduisant par une inflammation réversible."
                                        ],
                                        "tags": [
                                            "Toxicologie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6351b78-94ba-3341-8126-99aec6f5e25f",
                                        "entry_id": "ea77443e-c9ef-3706-840e-7e087801a556",
                                        "glosses": [
                                            "État émotionnel de tension ou d’agacement, mêlé d’impatience, pouvant évoluer vers la colère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7983acf3-9aa8-45c6-b3ce-ac3f122b44c7",
                                                "sense_id": "a6351b78-94ba-3341-8126-99aec6f5e25f",
                                                "text": "Son irritation fut très vive. J’ai tâché d’adoucir son irritation. Calmer l’irritation des esprits."
                                            },
                                            {
                                                "example_id": "eaaf087a-1f17-4fe1-9fd7-92886d5527f1",
                                                "sense_id": "a6351b78-94ba-3341-8126-99aec6f5e25f",
                                                "text": "Et, peu à peu, de la douceur primordiale, un peu timide et avide de tendresse de son caractère, montaient une sourde irritation, une rancœur et une révolte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fc00266-abf2-3e47-a327-0b97203fe549",
                                        "entry_id": "ea77443e-c9ef-3706-840e-7e087801a556",
                                        "glosses": [
                                            "Agitation ou exaspération collective dans un contexte social ou politique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b890859-b0de-4dbc-aff6-97cba24665ed",
                                                "sense_id": "5fc00266-abf2-3e47-a327-0b97203fe549",
                                                "text": "[…]; l'assassinat de la duchesse de Praslin, par son mari, pair de France, accrurent l'irritation publique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
