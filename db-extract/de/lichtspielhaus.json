                ],
                "senses": [
                    {
                        "sense_id": "3c255c40-d0bf-31ca-8bcd-8985baec7ed2",
                        "entry_id": "5dd60682-6ffa-3ccb-aec4-4a49127fbb59",
                        "glosses": [
                            "Örtlichkeit zur Vorführung von Filmen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "f4c1b309-6e3f-479e-a230-d46a8d6abffb",
                                "sense_id": "3c255c40-d0bf-31ca-8bcd-8985baec7ed2",
                                "text": "Die Lichtspielhäuser der Nation sind dank des neuen James Bond-Films bis auf den letzten Platz ausgebucht!"
                            },
                            {
                                "example_id": "53e296dc-6aa9-497e-b646-fddab68e63c5",
                                "sense_id": "3c255c40-d0bf-31ca-8bcd-8985baec7ed2",
                                "text": "„Das Gesundheitsamt hat auf die gesundheitsgemäße Beschaffenheit von Herbergen, Schlafstellen, Massenquartieren und dergleichen sowie von Räumen, in denen zeitweise größere Menschenansammlungen stattfinden (Versammlungs- und Ausstellungsräume, Theater und Lichtspielhäuser), zu achten und die Ortspolizeibehörden hierbei zu beraten.“"
                            },
                            {
                                "example_id": "ba40752c-6908-47f6-9e48-f0625e2098b8",
                                "sense_id": "3c255c40-d0bf-31ca-8bcd-8985baec7ed2",
                                "text": "„Ihr damaliges Mietshaus in der Schlageterstraße, gegenüber vom Lichtspielhaus, war abgebrannt.“"
                            },
                            {
                                "example_id": "e0c4a245-712f-4e31-b70a-041a0669110a",
                                "sense_id": "3c255c40-d0bf-31ca-8bcd-8985baec7ed2",
                                "text": "„Als ich gestern Abend an der Kasse eines unserer führenden Lichtspielhäuser die Eintrittskarte löste, trat ein adrett gekleidetes Fräulein auf mich zu und überreichte mir aus größerem Vorrat eine appetitlich verpackte Kleinigkeit, wobei sie mir viel Vergnügen wünschte.“"
                            },
                            {
                                "example_id": "4a8a22c8-e531-4fc1-977f-6741d4704152",
                                "sense_id": "3c255c40-d0bf-31ca-8bcd-8985baec7ed2",
                                "text": "„Drei Jahre lang hatte Tyler für eine Kette von Lichtspielhäusern Filme auf- und abgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
