                                ]
                            },
                            {
                                "target_word": "Tenor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6953d0a5-25a3-39aa-8793-2257a1fe5176",
                                        "entry_id": "83953dff-c2e8-3ee5-a8a7-1cb1038789aa",
                                        "glosses": [
                                            "Ausrichtung, hauptsächliche Aussage (einer Argumentation, Darstellung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86a7a047-b867-4b1c-b16a-be339390f8a8",
                                                "sense_id": "6953d0a5-25a3-39aa-8793-2257a1fe5176",
                                                "text": "Der Tenor seiner Ausführungen lief darauf hinaus, dass man das Vorhaben absagen solle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca676119-5d6e-3c12-a56e-8a19d0368203",
                                        "entry_id": "83953dff-c2e8-3ee5-a8a7-1cb1038789aa",
                                        "glosses": [
                                            "auf eine kurze Formel gebrachter Teil eines Urteils, der die eigentliche Entscheidung und weitere Rechtsfolgen der Hauptsache benennt"
                                        ],
                                        "tags": [
                                            "Deutsches Recht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f32c431-1d34-4101-a188-d77b21e1eeb2",
                                                "sense_id": "ca676119-5d6e-3c12-a56e-8a19d0368203",
                                                "text": "„Ein Tenor muss so bestimmt sein, dass sich aus ihm ohne Erklärung die Zahlungsverpflichtung des Unterhaltsschuldners eindeutig ergibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
