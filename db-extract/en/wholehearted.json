                                        "entry_id": "e8b35470-263d-3313-a30f-563225571995",
                                        "glosses": [
                                            "(zumindest sprachlich sich) aufs Äußerste zugetan (gebend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "403f891d-1d50-44e0-8e6d-bf7df9f7f396",
                                                "sense_id": "32a0e66f-b200-3b0f-977f-362c54c1ae03",
                                                "text": "„Der Dienststellenleiterin […] sei herzlichst für die reibungslose und unkomplizierte Zusammenarbeit gedankt.“"
                                            },
                                            {
                                                "example_id": "77f2d81a-63d5-4f06-aa0a-4e65f5552827",
                                                "sense_id": "32a0e66f-b200-3b0f-977f-362c54c1ae03",
                                                "text": "„Ich darf daran die Versicherung knüpfen, daß Sie in Königsberg herzlichst willkommen sein werden und bitte um zahlreiches Erscheinen.“"
                                            },
                                            {
                                                "example_id": "a0eeed1c-8e24-445b-89cc-e6c2399c7fde",
                                                "sense_id": "32a0e66f-b200-3b0f-977f-362c54c1ae03",
                                                "text": "„Das geschah nun glücklicherweise unserer Prinzessin, der Bodo Prinz ja herzlichst zugetan war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
