                        "entry_id": "f600a232-b8e7-3609-81b6-b4633beb2719",
                        "glosses": [
                            "Courge originaire du Japon, voisine du potiron. Sa forme et son goût lui ont valu le surnom de courge châtaigne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a722300-a1df-449c-8d9a-590065891518",
                                "sense_id": "8f8ef7ee-20fb-3ae8-b0a8-f988965ae867",
                                "text": "De la famille des courges, le potimarron, plus petit que le potiron, révèle un goût fin de châtaigne."
                            },
                            {
                                "example_id": "abdafeb0-6355-4733-ab3b-172a66288aa0",
                                "sense_id": "8f8ef7ee-20fb-3ae8-b0a8-f988965ae867",
                                "text": "Laver la courge kabocha (ou le potimarron)."
                            }
                        ]
                    }
                ],
