    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7c021902-fbbd-3869-844b-8546827d6b61",
                "word": "Margaret",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "766cfd57-f380-40f4-bd2b-6536d4b53fbe",
                        "entry_id": "7c021902-fbbd-3869-844b-8546827d6b61",
                        "tags": [
                            "plural"
                        ],
                        "form": "Margarets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2109a007-9d1b-31ca-bdf8-4d5ac120c8c2",
                        "entry_id": "7c021902-fbbd-3869-844b-8546827d6b61",
                        "glosses": [
                            "A female given name from Ancient Greek."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "eb914324-51dc-4bc0-a6c0-d20823e250bd",
                                "sense_id": "2109a007-9d1b-31ca-bdf8-4d5ac120c8c2",
                                "text": "Margaret shall now be queen, and rule the king;\nBut I will rule both her, the king, and realm."
                            },
                            {
                                "example_id": "9c60034f-4bb3-45f9-85b1-db754b637920",
                                "sense_id": "2109a007-9d1b-31ca-bdf8-4d5ac120c8c2",
                                "text": "Margaret, Marguerite - the pearl! the daisy! Oh name of romance and of minstrelsy, which brings the days of chivalry to mind, and the worship of flowers and ladies fair!"
                            },
                            {
                                "example_id": "ab42dd6f-e2fa-4f1a-9a78-090c103a6943",
                                "sense_id": "2109a007-9d1b-31ca-bdf8-4d5ac120c8c2",
                                "text": "Fair as a summer dream was Margaret,— / Such dream as in a poet's soul might start, / Musing of old loves while the moon doth set: […]"
                            },
                            {
                                "example_id": "b1f91147-192b-422b-9eb7-94eb491ed816",
                                "sense_id": "2109a007-9d1b-31ca-bdf8-4d5ac120c8c2",
                                "text": "Amongst us English, the name is a greater favourite than with any other nation: but we have played upon it, and abused it oftener too. In no language does Margaret sound sweeter or homelier than in ours: not so Mag, Maggie, Meg, Madge, Moggie, Peg, Peggy, and abominable Piggy, of which abridgements only the two first are defensible."
                            },
                            {
                                "example_id": "8f8ed320-bfe6-4382-be95-815078c9acb7",
                                "sense_id": "2109a007-9d1b-31ca-bdf8-4d5ac120c8c2",
                                "text": "The girls from our year were mainly named some version of Shawn. There was Shawna, Dawna, Shawnee, Dawnali, Shalana, and just plain Dawn and Shawn. There was also a girl named Margaret, named after her grandmother, who worked at the post office. I ended up talking with Margaret."
                            }
                        ]
                    },
                    {
                        "sense_id": "40ee6aa9-df90-3122-b0a3-aa4788441d0a",
                        "entry_id": "7c021902-fbbd-3869-844b-8546827d6b61",
                        "glosses": [
                            "A river in southwestern Western Australia, presumed named for a cousin of John Garrett Bussell, founder of Busselton. See Margaret River."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "152d0fc5-670d-3632-9272-374d1b1c8454",
                        "entry_id": "7c021902-fbbd-3869-844b-8546827d6b61",
                        "glosses": [
                            "A river in Kimberley region, Western Australia, named for its European discoverer's sister-in-law. See Margaret River."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "21add6b3-2bec-325b-ba62-fb9733b05de1",
                        "entry_id": "7c021902-fbbd-3869-844b-8546827d6b61",
                        "glosses": [
                            "A moon of Uranus, named for a character in Much Ado About Nothing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a130086a-fc98-41a0-baaf-5981dcce3fe4",
                                "sense_id": "21add6b3-2bec-325b-ba62-fb9733b05de1",
                                "text": "Astronomers discovered nine small moons lying outside the orbit of Oberon (Francisco, Caliban, Stephano, Trinculo, Sycorax, Margaret, Prospero, Setebos, and Ferdinand) between 1997 and 2003."
                            },
                            {
                                "example_id": "6c10b690-b8d4-4f64-b303-9d8923e70b99",
                                "sense_id": "21add6b3-2bec-325b-ba62-fb9733b05de1",
                                "text": "The odd one out is Margaret, which travels in a \"normal\" prograde direction, though it has the most eccentric orbit of all the Uranian satellites."
                            },
                            {
                                "example_id": "b002ff66-4fc9-46db-8fed-c5dd9c851167",
                                "sense_id": "21add6b3-2bec-325b-ba62-fb9733b05de1",
                                "text": "[…]moons known to be moving in a prograde or direct orbit is Margaret, orbiting Uranus at an average distance of nearly nine million miles (14,845,000 km) in an orbit that currently exceeds all other Solar System moons in terms of eccentricity (0.7979).[…]Margaret takes about 4.6 Earth years to complete a single orbit of the planet."
                            }
                        ]
                    }
                ],
