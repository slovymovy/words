                    }
                ],
                "translations": [
                    {
                        "translation_id": "18ac1eea-78f1-4680-acd0-f40ed13972eb",
                        "source_entry_id": "b9bd63d6-7fd8-34ce-a5d9-a09d2dba54fb",
                        "source_sense_id": "dd0b6c29-90a2-3652-a838-12f19164a6b5",
                        "source_sense_description": "een kleine lepel om thee mee te roeren",
                        "target_lang_word": "Teelöffel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teelöffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "408aed46-b2ec-3b37-9e09-8cb548c35911",
                                        "entry_id": "0731eb14-aa55-3ea2-b19d-a5ce3ef7a678",
                                        "glosses": [
                                            "ein kleiner Löffel, der zum Teegeschirr passt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4982ed11-a33d-46c7-a1f3-36ff72a6a0bc",
                                                "sense_id": "408aed46-b2ec-3b37-9e09-8cb548c35911",
                                                "text": "Ich verwende zum Tee trinken einen silbernen Teelöffel."
                                            },
                                            {
                                                "example_id": "d65db888-48dc-4cab-8637-4e8ce1b079f5",
                                                "sense_id": "408aed46-b2ec-3b37-9e09-8cb548c35911",
                                                "text": "„Alles, was ich noch finde, sind zwei im Sand verlorene Teelöffel und die Spitzhacke, die die Schatzgräber hier vergaßen.“"
                                            },
                                            {
                                                "example_id": "f11f21cb-e49f-4f2d-a4a0-1b414792078b",
                                                "sense_id": "408aed46-b2ec-3b37-9e09-8cb548c35911",
                                                "text": "„Dabei verstrich sehr viel Zeit, bis schließlich Jadeflöte Tee, dazu Früchte und Teelöffel brachte.“"
                                            },
                                            {
                                                "example_id": "190be2e5-7c22-4165-85a1-4b189ea38697",
                                                "sense_id": "408aed46-b2ec-3b37-9e09-8cb548c35911",
                                                "text": "„Ihre Schwiegertochter kündigt ihr einen Gast an, als sie gerade den Teelöffel auf der Untertasse ablegen will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c2c0607-675e-3439-a240-564fb7cf4a02",
                                        "entry_id": "0731eb14-aa55-3ea2-b19d-a5ce3ef7a678",
                                        "glosses": [
                                            "vage Mengenangabe, von etwa 5 Millilitern"
                                        ],
                                        "tags": [
                                            "zum Abmessen von Pulvern und Flüssigkeiten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f8b0a87-1bfa-4dc5-9a9d-54b3c79c0a8c",
                                                "sense_id": "0c2c0607-675e-3439-a240-564fb7cf4a02",
                                                "text": "Mit einem Teelöffel kann man ungefähr 5 Milliliter abmessen."
                                            },
                                            {
                                                "example_id": "307b0d6c-5d70-4060-9b39-22f56116f8ec",
                                                "sense_id": "0c2c0607-675e-3439-a240-564fb7cf4a02",
                                                "text": "Man sollte Medikamente nicht mit dem Teelöffel dosieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
