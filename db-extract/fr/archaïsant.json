                ],
                "senses": [
                    {
                        "sense_id": "7ba9afa6-9740-3580-b124-ad3591d555ea",
                        "entry_id": "7cd4c4c9-3e85-3f1e-ab83-02e4cc0ee006",
                        "glosses": [
                            "Qui se dirige vers l’archaïsme, qui n’est pas loin d’être archaïque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a1e3d4b-8aad-4d71-9eff-65b2eb152757",
                                "sense_id": "7ba9afa6-9740-3580-b124-ad3591d555ea",
                                "text": "Le réflexe jacobin, aggravé par le réflexe conservateur, condamnerait le français au ghetto, à un pittoresque archaïsant. Tout bouge, tout évolue. Le pédantisme, qui veut figer la langue, est la lettre morte d'une science vétilleuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "2270a44a-9eeb-38af-9d20-7ae9def00d76",
                        "entry_id": "7cd4c4c9-3e85-3f1e-ab83-02e4cc0ee006",
                        "glosses": [
                            "Qualifie un texte, un discours etc., dont le style est remarquable par l'emploi récurrent de formes anciennes, d'archaïsmes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9dc97fea-da38-3f44-aa8a-337efbabeaf6",
                        "entry_id": "7cd4c4c9-3e85-3f1e-ab83-02e4cc0ee006",
                        "glosses": [
                            "Qui a tendance à rabaisser, en reprochant d’être trop ancien."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "4a19ba49-3e51-4eed-8049-cc1d78f38e49",
                                "sense_id": "9dc97fea-da38-3f44-aa8a-337efbabeaf6",
                                "text": "Dans l’art hellénistique et romain, le phénomène « archaïsant » n’est pas uniquement lié à une recherche stylistique. La référence au passé - un passé grec -, sur des objets destinés à meubler essentiellement l’espace des demeures romaines (reliefs, bases, plaques Campana) tout en créant une atmosphère sacrée, renvoie au temps des dieux et à des rites énoncés comme plus anciens, tels que la libation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "184ba5ba-875e-47ec-b05e-4f9eb87f04ef",
                        "source_entry_id": "7cd4c4c9-3e85-3f1e-ab83-02e4cc0ee006",
                        "target_lang_word": "archaistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archaistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "643417d6-c3e0-3cc6-ba05-be011193fc48",
                                        "entry_id": "7a026207-296b-3955-bbfd-46f9a142df19",
                                        "glosses": [
                                            "Pertaining to an archaist; deliberately archaic, old-fashioned in an affected way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98f00d23-7d44-4740-b0cb-9128bab75b6e",
                                                "sense_id": "643417d6-c3e0-3cc6-ba05-be011193fc48",
                                                "text": "The emperor Augustus introduced an archaistic revival of ancient virtue and ancient religion, which caused the poem of Lucretius On the Nature of Things to become unpopular, and it remained so until the Renaissance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "archaistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff43059c-8e9c-30c0-a90f-681b570aa46e",
                                        "entry_id": "248d5432-62ec-3998-8b47-cfbbf6bdaf91",
                                        "glosses": [
                                            "Archaistic themes, motifs, items, etc."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0a95485-624a-450f-9fba-09def970a411",
                                                "sense_id": "ff43059c-8e9c-30c0-a90f-681b570aa46e",
                                                "text": "As in the case of Renaissance Italy, it is precisely the presence of the archaistic in the modern that is so fascinating to the cultural historian."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfb8766f-2f56-4071-8a7f-f93cf59147e6",
                        "source_entry_id": "7cd4c4c9-3e85-3f1e-ab83-02e4cc0ee006",
