                        "glosses": [
                            "Of or relating to the family Suidae of pigs and related creatures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0cc33b-0b6b-460a-9f6b-5e9c3824266c",
                                "sense_id": "d24c5072-e3e2-3b06-8df1-7735d7f928b6",
                                "text": "Owing to the kindness of Mr. M. A. Hinton, I have been able to examine at leisure the large collection of recent Suid skulls in the British Museum."
                            },
                            {
                                "example_id": "0fa04120-168c-4b6f-8f97-42f3d4824ce4",
                                "sense_id": "d24c5072-e3e2-3b06-8df1-7735d7f928b6",
                                "text": "Table 18.1 shows the results obtained by the Haemagglutination-Inhibition Test on ten suid feeds with the anti-warthog system and the converse anti-bushpig system."
                            },
                            {
                                "example_id": "bfeb8335-55a1-4ea8-b472-e9b0305d0980",
                                "sense_id": "d24c5072-e3e2-3b06-8df1-7735d7f928b6",
                                "text": "In a study by Harris and Cerling (2002), isotopic analysis of the enamel of extant and Neogene suids shows that major components of C₄ vegetation (i.e., warm-growing season grasses) were present in extinct suid species from the Turkana Basin deposits of northern Kenya as early as about 7Ma."
                            }
                        ]
                    }
