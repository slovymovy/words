                    },
                    {
                        "sense_id": "9e845746-d759-3d33-a5c7-84e2c4b453d0",
                        "entry_id": "e4684479-6f27-31a8-ba8c-b72b570adf83",
                        "glosses": [
                            "het geheel van als kunstzinnig beschouwde geschreven werken, m.n. proza of poëzie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b5353db-f9fa-40dc-ba5a-3a444fb56fc9",
                                "sense_id": "9e845746-d759-3d33-a5c7-84e2c4b453d0",
                                "text": "Het bizarre verhaal van de ‘Zelfmoordbrug van honden’ in Dumbarton, ten noordwesten van Glasgow, houdt bewoners al decennia bezig en is een klassieker in esoterische litteratuur. Maar nu heeft het mysterie de bloedserieuze New York Times gehaald."
                            },
                            {
                                "example_id": "75a67f3d-0ed7-4979-af58-26afade0d0bb",
                                "sense_id": "9e845746-d759-3d33-a5c7-84e2c4b453d0",
                                "text": "Op de jaarlijkse hoogmis voor de litteratuur boden zo’n honderd standhouders dit jaar zo’n 65.000 titels te koop aan. Honderden auteurs, waaronder Pascale Naessens, Ish Ait Hamou en Toni Coppers, zetten hun handtekening tijdens in totaal 2.000 signeersessies, bovenop 300 optredens en lezingen die werden georganiseerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "7dd86eda-23e6-3dfc-aad0-aa314c7def9c",
                        "entry_id": "e4684479-6f27-31a8-ba8c-b72b570adf83",
                        "glosses": [
                            "alle teksten die op een bepaald vakgebied betrekking hebben"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f90d772-c318-4e75-b886-234d9538279b",
