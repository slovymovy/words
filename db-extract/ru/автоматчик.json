                        "glosses": [
                            "воен. военнослужащий, вооружённый автоматом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "533b26e8-b3de-4d71-a89d-2a04e713806f",
                                "sense_id": "6133fb4c-28da-3c50-a82e-9a42f4d9b984",
                                "text": "Когда он начал подниматься, первый автоматчик был уже у ступеней и тряс в руках короткий, почти игрушечный автоматик."
                            }
                        ]
                    },
                    {
                        "sense_id": "c378006a-cbfa-3379-8e9c-50ac80a88344",
                        "entry_id": "4be27786-d9e1-3d7f-867b-e52b8a99945a",
                        "glosses": [
                            "техн. оператор станков-автоматов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90a49cbc-4d02-41aa-89f1-a53efa569253",
                                "sense_id": "c378006a-cbfa-3379-8e9c-50ac80a88344",
                                "text": "Каждый автоматчик заменил 12–14 высококвалифицированных электросварщиков."
                            }
                        ]
                    }
