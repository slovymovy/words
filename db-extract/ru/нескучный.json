                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d2d41ff-6158-4bcb-ab26-f826d1dfcb03",
                        "source_entry_id": "696cd109-5006-37b9-a97b-bd5c454e9633",
                        "source_sense_description": "весёлый, бодрый",
                        "target_lang_word": "merry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5fbc767-c753-3d79-9361-e81bc2702374",
                                        "entry_id": "5b784948-cecb-36df-bc16-3f4cff59f370",
                                        "glosses": [
                                            "Jolly and full of high spirits; happy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "074f5e83-85dd-4650-a1ac-2c870350350e",
                                                "sense_id": "e5fbc767-c753-3d79-9361-e81bc2702374",
                                                "text": "We had a very merry Christmas."
                                            },
                                            {
                                                "example_id": "1399b50a-9bb5-4a08-968f-a847f1958e71",
                                                "sense_id": "e5fbc767-c753-3d79-9361-e81bc2702374",
                                                "text": "I am neuer merry when I heare ſweet muſique."
                                            },
                                            {
                                                "example_id": "ebeb26b4-7084-4608-9fc3-cdb41e3ed128",
                                                "sense_id": "e5fbc767-c753-3d79-9361-e81bc2702374",
                                                "text": "I felt comforted by the song of the redbreast, and I thought I felt less lonely and deserted as long as I heard the merry notes of the thrush."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddb35f58-d9dc-33fc-86f1-a79211c8d0f7",
                                        "entry_id": "5b784948-cecb-36df-bc16-3f4cff59f370",
                                        "glosses": [
                                            "Festive and full of fun and laughter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c652b67-87b2-488c-b0cf-8e4b5c7f2976",
                                                "sense_id": "ddb35f58-d9dc-33fc-86f1-a79211c8d0f7",
                                                "text": "Everyone was merry at the party."
                                            },
                                            {
                                                "example_id": "ec2ded56-06f6-4dbc-a351-8df1fdcf0bc9",
                                                "sense_id": "ddb35f58-d9dc-33fc-86f1-a79211c8d0f7",
                                                "text": "If I have the chance, I will make our worshipful Sheriff pay right well for that which he hath done to me. Maybe I may bring him some time into Sherwood Forest and have him to a right merry feast with us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088a75ae-caa2-37ea-a035-fa7b19b0f607",
                                        "entry_id": "5b784948-cecb-36df-bc16-3f4cff59f370",
                                        "glosses": [
                                            "Brisk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e32e5f8-8ae2-4451-b481-fc1b45287506",
                                                "sense_id": "088a75ae-caa2-37ea-a035-fa7b19b0f607",
                                                "text": "The play moved along at a merry pace."
                                            },
                                            {
                                                "example_id": "19564bcc-32f4-4b1e-be77-c0218f44cd99",
                                                "sense_id": "088a75ae-caa2-37ea-a035-fa7b19b0f607",
                                                "text": "The car moved at a merry clip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "454d3f28-560e-3a96-a34e-390452285798",
                                        "entry_id": "5b784948-cecb-36df-bc16-3f4cff59f370",
                                        "glosses": [
                                            "Causing laughter, mirth, gladness, or delight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73b075b1-eaa9-4047-84cd-50a424b4b6a6",
                                                "sense_id": "454d3f28-560e-3a96-a34e-390452285798",
                                                "text": "a merry jest"
                                            },
                                            {
                                                "example_id": "a2eddc52-6fce-431d-95fa-32d258418fcb",
                                                "sense_id": "454d3f28-560e-3a96-a34e-390452285798",
                                                "text": "There eke my feeble barke a while may ſtay, / Till mery wynd and weather call her thence away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "664374c5-c523-39e7-9914-9732f0c63f03",
                                        "entry_id": "5b784948-cecb-36df-bc16-3f4cff59f370",
                                        "glosses": [
                                            "drunk; tipsy"
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35c6a52a-71a5-47c3-bc5d-ab36f932ef7c",
                                                "sense_id": "664374c5-c523-39e7-9914-9732f0c63f03",
                                                "text": "Some of us got a little merry at the office Christmas party."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "merry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a9e5329-5525-3cb7-8c54-f630a3b8d641",
                                        "entry_id": "723a3e79-e647-3228-8cb3-2b41cda148a4",
                                        "glosses": [
                                            "An English wild cherry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d69a34a-3ab9-4abd-9a38-806703343261",
                        "source_entry_id": "696cd109-5006-37b9-a97b-bd5c454e9633",
                        "source_sense_description": "весёлый, бодрый",
                        "target_lang_word": "cheerful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheerful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6eeeeb76-1001-347e-9fef-d42c9b1ee170",
                                        "entry_id": "258f8a75-8e57-3ae5-80b9-c92bdf972bb2",
                                        "glosses": [
                                            "Noticeably happy and optimistic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e27d3084-012e-4ead-849c-ec598847accd",
                                                "sense_id": "6eeeeb76-1001-347e-9fef-d42c9b1ee170",
                                                "text": "Ever in cheerfullest mood art thou, when others are filled with\nGloomy forebodings of illl, and see only ruin before them."
                                            },
                                            {
                                                "example_id": "edba85a1-e713-4f9a-bf6a-479d5484e97b",
                                                "sense_id": "6eeeeb76-1001-347e-9fef-d42c9b1ee170",
                                                "text": "He moped, she felt, as the time went by, and he was cheerfuler only when some letter, full of hope without expectation, came from Dick."
                                            },
                                            {
                                                "example_id": "d3c8c042-edf2-434d-8c03-55257d4ed8f8",
                                                "sense_id": "6eeeeb76-1001-347e-9fef-d42c9b1ee170",
                                                "text": "The Eskimo is a nobler, cheerfuller and easy-goinger person than we smug civilized citizens have always imagined. Rockwell Kent, the noted Eskimophile, claims they are a polite and happy race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7a9621b-981b-324c-9f23-0fc39553505f",
                                        "entry_id": "258f8a75-8e57-3ae5-80b9-c92bdf972bb2",
                                        "glosses": [
                                            "Bright and pleasant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25a8b5e5-c145-4393-ad46-4cd91892a341",
                                                "sense_id": "a7a9621b-981b-324c-9f23-0fc39553505f",
                                                "text": "They enjoyed a cheerful room."
                                            },
                                            {
                                                "example_id": "8b92395a-39a8-4167-b81f-15ba8f6b35b5",
                                                "sense_id": "a7a9621b-981b-324c-9f23-0fc39553505f",
                                                "text": "At half-past nine on this Saturday evening, the parlour of the Salutation Inn, High Holborn, contained most of its customary visitors.[…]In former days every tavern of repute kept such a room for its own select circle, a club, or society, of habitués, who met every evening, for a pipe and a cheerful glass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4ea9c92-ddcf-4247-86a3-79f21efaeedf",
                        "source_entry_id": "696cd109-5006-37b9-a97b-bd5c454e9633",
                        "source_sense_description": "весёлый, бодрый",
                        "target_lang_word": "fun-filled",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d08d8d0f-683e-4d6e-8c6b-458c09e911f0",
                        "source_entry_id": "696cd109-5006-37b9-a97b-bd5c454e9633",
                        "source_sense_description": "весёлый, бодрый",
                        "target_lang_word": "enjoyable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enjoyable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90bda27a-7b0d-3a37-a648-926f21153213",
                                        "entry_id": "e8ccc1f6-fb8c-3c55-993f-e010c74dc8f8",
                                        "glosses": [
                                            "Pleasant, capable of giving pleasure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76b4ee02-b3bd-4dea-aa65-271dd929da21",
                                                "sense_id": "90bda27a-7b0d-3a37-a648-926f21153213",
                                                "text": "That was an enjoyable day; I had a lot of fun."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
