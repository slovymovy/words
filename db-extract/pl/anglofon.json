                                        "sense_id": "948d49cf-5064-3cd5-b847-1073f7f47906",
                                        "entry_id": "34d561d1-da0d-361e-9e85-9aa95132bb2a",
                                        "glosses": [
                                            "English-speaking."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d078ceb-a444-4c38-a2e6-193bd18a9fb0",
                                                "sense_id": "948d49cf-5064-3cd5-b847-1073f7f47906",
                                                "text": "the Anglophone media"
                                            },
                                            {
                                                "example_id": "4fc31942-3735-4547-85e4-aedee4fac337",
                                                "sense_id": "948d49cf-5064-3cd5-b847-1073f7f47906",
                                                "text": "Ireland is an unusual anglophone location in that it is an island of some size with a population large enough for internal dialectal variation. It can be compared in this respect with Newfoundland and possibly with Jamaica and New Zealand (two islands, of course). Other anglophone locations are either much larger (United States, Canada, South Africa, Australia) or so small that an internal differentiation of varieties is not recognisable, cf. the many anglophone islands of the Caribbean as well as such islands as Malta or Tristan da Cunha."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Anglophone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b08cf2cb-3220-3fdb-aba3-fdcadcbacee6",
                                        "entry_id": "a7e36df0-a454-3fa5-a203-2ddd82053948",
                                        "glosses": [
                                            "One who speaks English, generally natively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "800e9f20-ff09-4466-a2d2-58c0470b4f9a",
                                                "sense_id": "b08cf2cb-3220-3fdb-aba3-fdcadcbacee6",
                                                "text": "When we consider the situation of Anglophones in Quebec, we quickly realize that the vitality of this group depends upon its geographical location. In and around Montreal, Anglophones have good access to English-language resources and services. They also have their own institutions, although French is now part of these institutions. Anglophones living in and around Montreal are better served in their language than anywhere else in the province."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcf95a72-0887-4a3c-a392-f03ee0c77896",
                        "source_entry_id": "1a81c113-5ea3-305f-b5ea-de86185e3da8",
                        "source_sense_id": "5dba64bb-b27a-34f4-84c1-ff0cab5b900d",
                        "target_lang_word": "anglophone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anglophone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8495aab1-4fcd-3c3e-aafe-ef6ec2c21342",
                                        "entry_id": "24986e67-929d-316f-b865-c8591e40e179",
                                        "glosses": [
                                            "Personne parlant la langue anglaise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9efb38f8-947a-473d-89da-6d9b635da87e",
                                                "sense_id": "8495aab1-4fcd-3c3e-aafe-ef6ec2c21342",
                                                "text": "La minorité anglaise avait également reçu, de façon encore plus discrète, une autre « protection »: le trésorier du Québec serait un anglophone, un anglophone choisi par les financiers."
                                            },
                                            {
                                                "example_id": "5cb59791-23ad-4300-a26f-31a9c24213f5",
                                                "sense_id": "8495aab1-4fcd-3c3e-aafe-ef6ec2c21342",
                                                "text": "Dans le quartier où j'ai grandi, nous appelions alors les anglophones sous des vocables discriminatoires « anglo-fous ou anglo-foufou », « bamenda » etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anglophone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ce9f07e-2d8c-3ff0-9cc2-19b3722c2706",
                                        "entry_id": "a34138d8-7c53-314d-b2e8-44cd7018d7e4",
                                        "glosses": [
                                            "De langue anglaise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0160f64c-6d6b-4078-918b-fe030697c7a1",
                                                "sense_id": "5ce9f07e-2d8c-3ff0-9cc2-19b3722c2706",
                                                "text": "Selon plusieurs penseurs de l'époque, l'État québécois est le seul qui puisse rivaliser avec les grandes entreprises anglophones d'Amérique du Nord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
