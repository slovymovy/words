                ],
                "senses": [
                    {
                        "sense_id": "1bd7cac6-bfd8-326d-8389-71482b3151a1",
                        "entry_id": "67eaac59-9582-3582-81c1-149eee27efb0",
                        "glosses": [
                            "Qui relève de la routine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08c0aa8c-2cde-417b-9526-cafb3827e188",
                                "sense_id": "1bd7cac6-bfd8-326d-8389-71482b3151a1",
                                "text": "À Sméraldine, les vies les plus routinières et les plus calmes se passent sans répétitions."
                            },
                            {
                                "example_id": "0479f885-814e-42e8-9e6c-a1a6db66c976",
                                "sense_id": "1bd7cac6-bfd8-326d-8389-71482b3151a1",
                                "text": "« Sur ces routes, le trajet est routinier. La vigilance des conducteurs s’émousse », ajoute Céline Soubranne, secrétaire générale d’Axa Prévention."
                            },
                            {
                                "example_id": "e65e7daf-0384-4cc3-8da3-3d1dde12c1e1",
                                "sense_id": "1bd7cac6-bfd8-326d-8389-71482b3151a1",
                                "text": "Ça nous distrait des réalités mièvres et routinières de la Syrie, de la Libye ou de la Corée du Nord ?"
                            },
                            {
                                "example_id": "95102558-45f3-4ec8-84f1-37e61f5bc4e9",
                                "sense_id": "1bd7cac6-bfd8-326d-8389-71482b3151a1",
                                "text": "L’homme est un animal routinier, pour qui tout changement est angoissant et douloureux. Surtout lorsque l’appareil économico-politique dominant entretient le système."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e2169f7-6f8c-41ac-a9f0-493168a22784",
                        "source_entry_id": "67eaac59-9582-3582-81c1-149eee27efb0",
                        "source_sense_id": "1bd7cac6-bfd8-326d-8389-71482b3151a1",
