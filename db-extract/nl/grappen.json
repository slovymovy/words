                "senses": [
                    {
                        "sense_id": "e49b2e7d-c9c2-3d13-8584-b7b7c547ccf1",
                        "entry_id": "1cb951ec-86b0-3e79-bfa5-01f3487e2945",
                        "glosses": [
                            "iets grappigs zeggen"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "f18ee0f6-c2f8-4e8d-bd0d-c088a8787582",
                                "sense_id": "e49b2e7d-c9c2-3d13-8584-b7b7c547ccf1",
                                "text": "Af en toe grapte de pastoor zelfs en moesten de mensen hard lachen."
                            },
                            {
                                "example_id": "d5a8d823-13ee-489d-a8fb-f5161e6ea9c5",
                                "sense_id": "e49b2e7d-c9c2-3d13-8584-b7b7c547ccf1",
                                "text": "Wout Poels, meesterknecht voor Team Ineos, grapt dat hij maar beter zijn gravelbike kan meenemen."
                            },
                            {
                                "example_id": "999ce14b-14aa-4e89-b204-499110e1d80c",
                                "sense_id": "e49b2e7d-c9c2-3d13-8584-b7b7c547ccf1",
                                "text": "Ze grapte dat ze een zwarte weduwe was die haar mannetje na het paren opat. Zij vroeg zich af waarom zij toch altijd drama’s aantrok: zo complex was ze toch niet? Ze vond kerels vaak veel te bezitterig. ‘In dat opzicht zijn vrouwen eigenlijk veel fijner en vaak ook een stuk mooier.’"
                            }
                        ]
                    }
                ],
