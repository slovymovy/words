                        "examples": [
                            {
                                "example_id": "53a7c069-df0e-4594-831c-15aa08056453",
                                "sense_id": "e2efdecb-41d0-3588-ba0d-b4461e569bd7",
                                "text": "Dat inhaalprogramma is eind 2013 van start gegaan in Syrië zelf en de grote vluchtelingenkampen in buurlanden. In oktober 2013 moment was er een uitbraak van polio met uiteindelijk enkele tientallen gevallen. De WHO is intussen al weer gestopt met de inentingscampagne, omdat geen kinderen meer worden aangetroffen die de virussen bij zich dragen."
                            },
                            {
                                "example_id": "6c4d5be8-4f6f-44e2-82e8-24772df38fe8",
                                "sense_id": "e2efdecb-41d0-3588-ba0d-b4461e569bd7",
                                "text": "Na het inhaalprogramma van vorige week, is de hockeycompetitie nu echt weer begonnen. Op de helft van het seizoen gaan twee teams samen aan kop; Amsterdam en Oranje Zwart. De Eindhovenaren verloren vandaag; Rotterdam was in Brabant met 2-1 te sterk. Amsterdam kon dus profiteren, op bezoek bij de nummer 6 Laren."
                            }
                        ]
                    }
