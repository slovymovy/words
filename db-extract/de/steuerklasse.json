                "senses": [
                    {
                        "sense_id": "3f9acd93-22cd-3739-884a-dfeeed673040",
                        "entry_id": "382d1666-fe0a-3fac-b618-c0543cf64760",
                        "glosses": [
                            "Lohnsteuerklasse in Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5458d0f-7616-4210-aebf-321f3f81b548",
                                "sense_id": "3f9acd93-22cd-3739-884a-dfeeed673040",
                                "text": "„Ihr Arbeitgeber benötigt von Ihnen bestimmte Informationen (zum Beispiel Steuerklasse und Anzahl der Kinder), um Ihre Lohnsteuer berechnen und abführen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cae3a722-4147-33c0-9bc6-59953edc6229",
                        "entry_id": "382d1666-fe0a-3fac-b618-c0543cf64760",
                        "glosses": [
                            "Grad der Verwandtschaft bei der Ermittlung der Erbschaftssteuer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a396a5b-d392-432f-86cd-5f431897bf7a",
                                "sense_id": "cae3a722-4147-33c0-9bc6-59953edc6229",
                                "text": "„Keine Bedenken gegen die unterschiedliche Behandlung von Ehegatten und Lebensgefährten bei der Einordnung in Steuerklassen bei der Erbschafts- und Schenkungssteuer; sachliche Rechtfertigung des Anknüpfens an formale familienrechtliche Kategorien und des Verzichts auf eine Gleichbehandlung von Vermögenstransfers zwischen den Partnern nicht formalisierter Gemeinschaften und solchen zwischen Ehegatten im Erbschaftssteuerrecht“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
