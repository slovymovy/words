                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f228e61d-472e-4a57-a8f1-a8ac84eeac2f",
                                "sense_id": "3bb8b036-bf0c-3088-aba1-39e6cb32d10e",
                                "text": "Nog hoor ik de plotselinge arpeggio's van geschater dansen boven het jonge gras-vrolijk aanzwellend, ver klinkend, vloeiend, spontaan, een klokjesachtig vrouwelijk getinkel, opeens weer onderdrukt, snel en onherroepelijk gesmoord in de stille plechtigheid van de doorvesperde lucht, nu trillend van somber klokgelui. Dong! Dong! Dong! (Uit De onzichtbare man van Ralph Ellison)"
                            }
                        ]
                    }
