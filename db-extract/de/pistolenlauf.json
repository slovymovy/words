                ],
                "senses": [
                    {
                        "sense_id": "75e0d158-7a90-3357-b665-632c1ae7bc95",
                        "entry_id": "9446c804-8b0f-34e3-bffc-54d8edfe43c0",
                        "glosses": [
                            "Lauf einer Pistole"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c912bc5-57b2-4ddc-b677-82b4d82b10dc",
                                "sense_id": "75e0d158-7a90-3357-b665-632c1ae7bc95",
                                "text": "„Als die Staatsanwältin nach dem Hersteller fragt, fährt der Beamte mit dem Zeigefinger über den Pistolenlauf und wischt das Blut weg.“"
                            },
                            {
                                "example_id": "9553e5b9-4ac3-451a-b3ce-6eb675f4a394",
                                "sense_id": "75e0d158-7a90-3357-b665-632c1ae7bc95",
                                "text": "„Dem Waffeningenieur präsentiert sich das Projektil im Idealzustand: Der Pistolenlauf hat seine ganz individuellen Spuren darauf hinterlassen, quasi wie ein Fingerabdruck.“"
                            },
                            {
                                "example_id": "395b1b24-3e6e-4097-b0c8-c534ed9217af",
                                "sense_id": "75e0d158-7a90-3357-b665-632c1ae7bc95",
                                "text": "„Der Mann spuckt auf den Boden, zieht seine Pistole. Noch einmal sieht man das Gesicht des Kleinen, dann blickt auch der Zuschauer in den Pistolenlauf.“"
                            },
                            {
                                "example_id": "b88b99ac-6ea6-4b32-b6b5-a251832414c5",
                                "sense_id": "75e0d158-7a90-3357-b665-632c1ae7bc95",
                                "text": "„Er kroch durch das plattgedrückte Gras zurück, bis er sie fand, hob sie auf, drehte sich um und suchte den oberen Rand des Flusstals ab, während er sich mit dem Pistolenlauf den Staub aus dem Ärmel klopfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
