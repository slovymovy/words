                    "sense_definition": "Op enig moment in de tijd; wordt vaak gebruikt in vragen of voorwaardelijke zinnen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heb jij <w>ooit</w> zo'n vreemd dier gezien?",
                            "target_lang_translations": {
                                "en": "Have you <w>ever</w> seen such a strange animal?",
                                "ru": "Ты <w>когда-нибудь</w> видел такое странное животное?",
                                "pl": "Czy widziałeś <w>kiedykolwiek</w> tak dziwne zwierzę?",
                                "de": "Hast du <w>jemals</w> so ein seltsames Tier gesehen?",
                                "fr": "As-tu <w>jamais</w> vu un animal aussi étrange ?",
                                "it": "Hai <w>mai</w> visto un animale così strano?",
                                "cs": "Viděl jsi <w>někdy</w> tak zvláštní zvíře?",
                                "tr": "Sen <w>hiç</w> böyle garip bir hayvan gördün mü?",
                                "es": "¿Has visto <w>alguna vez</w> un animal tan extraño?"
                            }
                        },
                        {
                            "text": "Als je <w>ooit</w> hulp nodig hebt, mag je me bellen.",
                            "target_lang_translations": {
                                "en": "If you <w>ever</w> need help, you can call me.",
                                "ru": "Если тебе <w>когда-нибудь</w> понадобится помощь, можешь мне позвонить.",
                                "pl": "Jeśli <w>kiedykolwiek</w> będziesz potrzebować pomocy, możesz do mnie zadzwonić.",
                                "de": "Wenn du <w>jemals</w> Hilfe brauchst, kannst du mich anrufen.",
                                "fr": "Si <w>jamais</w> tu as besoin d'aide, tu peux m'appeler.",
                                "it": "Se <w>mai</w> avrai bisogno di aiuto, puoi chiamarmi.",
                                "cs": "Pokud bys <w>někdy</w> potřeboval pomoc, můžeš mi zavolat.",
                                "tr": "Eğer <w>herhangi bir zamanda</w> yardıma ihtiyacın olursa beni arayabilirsin.",
                                "es": "Si <w>alguna vez</w> necesitas ayuda, puedes llamarme."
                            }
