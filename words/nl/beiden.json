{
    "word_family": [
        "beide"
    ],
    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "9e9c63d0-dc32-34bf-a8ed-3f418ea83ccf",
                    "sense_definition": "elk van twee personen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beide_personen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had <w>beiden</w> een kopie van zijn nieuwe roman gegeven.",
                            "target_lang_translations": {
                                "en": "He had given <w>both of them</w> a copy of his new novel."
                            }
                        },
                        {
                            "text": "Dit is een uitstekend idee voor jullie <w>beiden</w>.",
                            "target_lang_translations": {
                                "en": "This is an excellent idea for <w>both of you</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "allebei"
                    ],
                    "common_phrases": [
                        "voor jullie beiden",
                        "hen beiden"
                    ],
                    "target_lang_definitions": {
                        "en": "each of two people"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "both",
                                "target_lang_sense_clarification": "referring to two people"
                            },
                            {
                                "target_lang_word": "both of them",
                                "target_lang_sense_clarification": "referring to two people as objects"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "6660175a-358c-37e6-8784-d7975a843f38",
                    "sense_definition": "persoonlijk meervoud van <w>beide</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beide_personen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben <w>beiden</w> besloten om niet naar het feest te gaan.",
                            "target_lang_translations": {
                                "en": "We <w>both</w> decided not to go to the party."
                            }
                        },
                        {
                            "text": "Zij wilden <w>beiden</w> de hoofdprijs winnen.",
                            "target_lang_translations": {
                                "en": "They <w>both</w> wanted to win the grand prize."
                            }
                        }
                    ],
                    "synonyms": [
                        "allebei"
                    ],
                    "common_phrases": [
                        "wij beiden",
                        "beiden aanwezig"
                    ],
                    "target_lang_definitions": {
                        "en": "personal plural of 'both', referring to two people as subjects"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "both",
                                "target_lang_sense_clarification": "referring to two people doing something"
                            },
                            {
                                "target_lang_word": "both of us",
                                "target_lang_sense_clarification": "referring to 'we both'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf79b618-389e-3b9f-a058-6db47c3abe25",
                    "sense_definition": "wachten of afwachten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wachten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij moeten de tijd rustig <w>beiden</w> tot er meer nieuws is.",
                            "target_lang_translations": {
                                "en": "We must quietly <w>bide</w> our time until there is more news."
                            }
                        },
                        {
                            "text": "Zij <w>beidde</w> haar kans om haar plannen te presenteren.",
                            "target_lang_translations": {
                                "en": "She <w>awaited</w> her opportunity to present her plans."
                            }
                        }
                    ],
                    "synonyms": [
                        "afwachten",
                        "wachten",
                        "verbeiden"
                    ],
                    "common_phrases": [
                        "de tijd beiden"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "voornamelijk in literaire of plechtige context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to wait or bide one's time (archaic/literary)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bide",
                                "target_lang_sense_clarification": "to wait for a favorable time"
                            },
                            {
                                "target_lang_word": "await",
                                "target_lang_sense_clarification": "to wait for something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30817d7f-792f-3570-9367-dcaf8b97ff56",
                    "sense_definition": "treuzelen of dralen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "treuzelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet niet zo lang <w>beiden</w> als er snel een beslissing genomen moet worden.",
                            "target_lang_translations": {
                                "en": "You should not <w>delay</w> so long when a decision needs to be made quickly."
                            }
                        },
                        {
                            "text": "Zonder te <w>beiden</w> ging hij direct aan het werk.",
                            "target_lang_translations": {
                                "en": "Without <w>tarrying</w>, he went straight to work."
                            }
                        }
                    ],
                    "synonyms": [
                        "treuzelen",
                        "dralen",
                        "aarzelen"
                    ],
                    "antonyms": [
                        "opschieten",
                        "haasten"
                    ],
                    "common_phrases": [
                        "zonder te beiden"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "zeer zelden gebruikt in modern Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to dawdle, hesitate, or delay (archaic)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "delay",
                                "target_lang_sense_clarification": "to hesitate or linger"
                            },
                            {
                                "target_lang_word": "tarry",
                                "target_lang_sense_clarification": "to delay or linger in acting"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}