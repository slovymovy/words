                "senses": [
                    {
                        "sense_id": "63ffc58a-06e5-3619-8657-5a9c64a0cf95",
                        "entry_id": "c6d6c7a2-16b8-3445-a726-4591af1f778c",
                        "glosses": [
                            "technische Anlage, in der die Sonneneinstrahlung in elektrischen Strom umgewandelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ea4533a-1d3c-4a94-9f91-dc39d81790cd",
                                "sense_id": "63ffc58a-06e5-3619-8657-5a9c64a0cf95",
                                "text": "„Am Freitag wird in Villalgordo del Júcar, einer 1200-Seelen-Gemeinde im Südosten der Iberischen Halbinsel, das weltweit erste Sonnenkraftwerk, das für eine industrielle Anwendung gedacht ist, offiziell eröffnet.“"
                            },
                            {
                                "example_id": "67b92e58-aa15-45b0-a5d9-bb3ec05d361e",
                                "sense_id": "63ffc58a-06e5-3619-8657-5a9c64a0cf95",
                                "text": "„In den Vereinigten Staaten sollte das größte Sonnenkraftwerk der Welt entstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
