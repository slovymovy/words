                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stupidité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est une <w>bête</w> erreur, mais elle nous a coûté beaucoup de temps."
                        },
                        {
                            "text": "Il a eu un accident <w>bête</w> en descendant les escaliers."
