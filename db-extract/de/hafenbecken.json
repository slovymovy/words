                ],
                "senses": [
                    {
                        "sense_id": "14b41995-2321-3643-be14-01c0705349cb",
                        "entry_id": "2701a6be-2a65-3eda-b55c-df4e7013a64e",
                        "glosses": [
                            "mit Wasser gefüllter Bereich eines Hafens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa586ed6-d273-4f26-9b89-d4649164f4de",
                                "sense_id": "14b41995-2321-3643-be14-01c0705349cb",
                                "text": "„Auf dem Grund des Hafenbeckens unweit der Landebrücken haben Archäologen den Kieferknochen eines Mannes und den Schädel einer jungen Frau gefunden - beide starben möglicherweise durch die Hand eines unbekannten Mörders.“"
                            },
                            {
                                "example_id": "2b506d07-2117-41f9-a338-df3a4ca780b1",
                                "sense_id": "14b41995-2321-3643-be14-01c0705349cb",
                                "text": "„Der Bärtige lief nicht zum Bahnhof, sondern umrundete das Hafenbecken, vorbei am Kohlelagerplatz und den Getreidesilos.“"
                            },
                            {
                                "example_id": "bcf9d3e5-df4e-4ad2-9a37-013a971ae5c1",
                                "sense_id": "14b41995-2321-3643-be14-01c0705349cb",
                                "text": "„Sie kamen auf den Platz, der das kleine Hafenbecken umschließt.“"
                            },
                            {
                                "example_id": "4a7e5d53-34dc-4b0e-a300-30bfb57f1f23",
                                "sense_id": "14b41995-2321-3643-be14-01c0705349cb",
                                "text": "„Im Hafenbecken trieben schon etliche Leichen, denen teilweise die Ohren fehlten, weil Räuber es auf die Ohrringe abgesehen und sie kurzerhand abgeschnitten hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
