                "senses": [
                    {
                        "sense_id": "f545b18c-cadb-3bf0-9603-a12762192708",
                        "entry_id": "804e3a7c-a1a6-323d-bb31-6b7619e3491b",
                        "glosses": [
                            "Behältnis, das in christlichen Kirchen der Taufe dient und mit geweihtem Wasser gefüllt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba7ef4a8-5830-4731-9bfe-45dd6bacceef",
                                "sense_id": "f545b18c-cadb-3bf0-9603-a12762192708",
                                "text": "In vielen Kirchen stehen schöne, alte Taufsteine."
                            },
                            {
                                "example_id": "12a8cf02-6e2e-4969-a339-0b727d74a5dc",
                                "sense_id": "f545b18c-cadb-3bf0-9603-a12762192708",
                                "text": "„Auch der Taufstein ist noch erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fff2be3-1327-4577-81c2-6317e9e7396f",
                        "source_entry_id": "804e3a7c-a1a6-323d-bb31-6b7619e3491b",
                        "source_sense_id": "f545b18c-cadb-3bf0-9603-a12762192708",
                        "source_sense_description": "Religion: Behältnis, das in christlichen Kirchen der Taufe dient und mit geweihtem Wasser gefüllt ist",
                        "target_lang_word": "font",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "font",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5b8a0b7-a5c7-3e87-92fe-7ad3e39eb284",
                                        "entry_id": "26462df5-c3f2-33ab-bdd8-50e1f50d3833",
                                        "glosses": [
                                            "A source, wellspring, fount."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d6763dd-8c92-4fa1-80da-d47b9cfaf3b7",
                                                "sense_id": "f5b8a0b7-a5c7-3e87-92fe-7ad3e39eb284",
                                                "text": "1824 — George Gordon, Lord Byron, Don Juan, canto V\nA gaudy taste; for they are little skill'd in\nThe arts of which these lands were once the font"
                                            },
                                            {
                                                "example_id": "8ae82f89-fbff-4c72-812f-f3391afc99d0",
                                                "sense_id": "f5b8a0b7-a5c7-3e87-92fe-7ad3e39eb284",
                                                "text": "As I am not drawing here on the font of imagination to refresh that of fact and experience, I do not suggest that the Tarot set the example of expressing Secret Doctrine in pictures and that it was followed by Hermetic writers; but it is noticeable that it is perhaps the earliest example of this art."
                                            },
                                            {
                                                "example_id": "5fdee74e-3559-4f54-807a-d1cd5294f419",
                                                "sense_id": "f5b8a0b7-a5c7-3e87-92fe-7ad3e39eb284",
                                                "text": "I am interested to fix your attention on this prospect now because unless you take it within your view and permit the full significance of it to command your thought I cannot find the right light in which to set forth the particular matter that lies at the very font of my whole thought as I address you to-day."
                                            },
                                            {
                                                "example_id": "bce79880-f89d-48c8-acd2-5f781b8788b7",
                                                "sense_id": "f5b8a0b7-a5c7-3e87-92fe-7ad3e39eb284",
                                                "text": "The Bible lays special stress on the fear of God as the font of wisdom."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "font",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d6638bd-e3d9-3660-a151-44776ef34db3",
                                        "entry_id": "e2138362-8fd0-3360-b15c-1d80c5cd0706",
                                        "glosses": [
                                            "A receptacle in a church for holy water, especially one used in baptism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd151eac-baf0-4fb3-b90e-b6b5b9677b47",
                                                "sense_id": "5d6638bd-e3d9-3660-a151-44776ef34db3",
                                                "text": "She dipped her fingers in the font and crossed herself."
                                            },
                                            {
                                                "example_id": "56aa8d37-6ee6-437f-b020-703660e51efb",
                                                "sense_id": "5d6638bd-e3d9-3660-a151-44776ef34db3",
                                                "text": "Blessed be God, that, at the font, /⁠ My sponsors bound me to the call / Of Christ in England to confront / The world, the flesh, the fiend and all."
                                            },
                                            {
                                                "example_id": "b3f958d3-5079-4286-854a-e8f223ba2f25",
                                                "sense_id": "5d6638bd-e3d9-3660-a151-44776ef34db3",
                                                "text": "In the Apostolic Age, as in Jewish times (John, iii, 23), baptism was administered without special fonts, at the seaside or in streams or pools of water (Acts, viii, 38); […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2b9278b-0edb-3497-8eb8-03c7463162a9",
                                        "entry_id": "e2138362-8fd0-3360-b15c-1d80c5cd0706",
                                        "glosses": [
                                            "A receptacle for lamp oil in a lamp."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "font",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7f10a3f-7148-3213-aa66-ac49153ed437",
                                        "entry_id": "2e570959-ddc8-354d-83da-7f5ed87d1805",
                                        "glosses": [
                                            "A set of glyphs of unified design, belonging to one typeface (e.g., Helvetica), style (e.g., italic), and weight (e.g., bold). Usually representing the letters of an alphabet and its supplementary characters.",
                                            "In metal typesetting, a set of type sorts in one size."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c2c7d35-1615-3674-ae8b-7055c8ba8a90",
                                        "entry_id": "2e570959-ddc8-354d-83da-7f5ed87d1805",
                                        "glosses": [
                                            "A set of glyphs of unified design, belonging to one typeface (e.g., Helvetica), style (e.g., italic), and weight (e.g., bold). Usually representing the letters of an alphabet and its supplementary characters.",
                                            "In phototypesetting, a set of patterns forming glyphs of any size, or the film they are stored on."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5c75a02-4933-3bdb-a543-4bd15c288069",
                                        "entry_id": "2e570959-ddc8-354d-83da-7f5ed87d1805",
                                        "glosses": [
                                            "A set of glyphs of unified design, belonging to one typeface (e.g., Helvetica), style (e.g., italic), and weight (e.g., bold). Usually representing the letters of an alphabet and its supplementary characters.",
                                            "In digital typesetting, a set of glyphs in a single style, representing one or more alphabets or writing systems, or the computer code representing it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "619fca8e-c60f-3c0e-a2fe-73fa56e06a36",
                                        "entry_id": "2e570959-ddc8-354d-83da-7f5ed87d1805",
                                        "glosses": [
                                            "A typeface."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04c18972-6d4a-3717-be3b-a7d79112a076",
                                        "entry_id": "2e570959-ddc8-354d-83da-7f5ed87d1805",
                                        "glosses": [
                                            "A computer file containing the code used to draw and compose the glyphs of one or more typographic fonts on a computer display or printer."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4be76a23-3be0-48f4-be04-bda4704afe3a",
                                                "sense_id": "04c18972-6d4a-3717-be3b-a7d79112a076",
                                                "text": "They bought a license for the Gulliver font and installed that font on several machines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ade4c8c5-c7a8-3b65-a803-19378c2da828",
                                        "entry_id": "2e570959-ddc8-354d-83da-7f5ed87d1805",
                                        "glosses": [
                                            "The design of any text."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dacf32d1-f9ec-4d94-a8c3-c5da7f4679da",
                                                "sense_id": "ade4c8c5-c7a8-3b65-a803-19378c2da828",
                                                "text": "I like the font of this logo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "font",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7376c11-08ac-379b-bf7c-770e7a355ab4",
                                        "entry_id": "676ca778-699b-36ad-bde6-e9c8868b675f",
                                        "glosses": [
                                            "To overlay (text) on the picture."
