                "senses": [
                    {
                        "sense_id": "7eeff806-eeef-3e0e-8194-8b1625af328a",
                        "entry_id": "72138490-ac5b-37c0-8db0-dea1dada9f96",
                        "glosses": [
                            "Landeplatz an einem Gewässer"
                        ],
                        "tags": [
                            "South German"
                        ],
                        "examples": [
                            {
                                "example_id": "e7d33484-b13e-464b-a1a5-a13b8b55ca5a",
                                "sense_id": "7eeff806-eeef-3e0e-8194-8b1625af328a",
                                "text": "Eine Lände ist ein einfacher Landeplatz an einem Gewässer, also die einfachste Form eines Binnenhafens."
                            },
                            {
                                "example_id": "6b92b5ad-7623-49e2-b2be-7f5a631f4358",
                                "sense_id": "7eeff806-eeef-3e0e-8194-8b1625af328a",
                                "text": "„Aus Lärmgründen zeigen die Fenster an der Lände meist vom Fluss weg.“"
                            },
                            {
                                "example_id": "20462987-ff33-490c-9e1b-1f2f55911395",
                                "sense_id": "7eeff806-eeef-3e0e-8194-8b1625af328a",
                                "text": "„An der Lände von Helena aber suchten weinende Frauen und Mädchen unter den Toten ihre Lieben; ernste Männer trugen die verwundeten Kameraden in die nächsten Häuser hinauf.“"
                            },
                            {
                                "example_id": "cda2b546-c0cc-4ae3-9d4e-09f8e850bafa",
                                "sense_id": "7eeff806-eeef-3e0e-8194-8b1625af328a",
                                "text": "„Ich kann zu Fuß zur Lände gehn – das heißt zum Supermarkt und zur Bar – auf der einzigen Piste oder querweg durch die Insel, durch bemooste flache Felsen und waldige Moore, an Holzplätzen, Lichtungen, Scheunen vorbei nach Kallalä, wo die Anlegestelle der südlichen Fähren ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
