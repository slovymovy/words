                ],
                "translations": [
                    {
                        "translation_id": "0488b0f6-142e-4367-8d3a-ac16bbaa0de6",
                        "source_entry_id": "c7455282-6342-3361-b20c-3234b6724c9e",
                        "source_sense_id": "411f100b-8395-3603-aec5-2d0edbc0cd4a",
                        "source_sense_description": "een vrouw die thuisblijft om het huishouden te doen",
                        "target_lang_word": "Hausfrau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausfrau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02f1124e-40cb-3268-b89a-8420c8dde07c",
                                        "entry_id": "14afac96-fb04-316b-998f-c2152e64badd",
                                        "glosses": [
                                            "ihren eigenen Haushalt führende und besorgende Frau"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d33f3f2-c0a5-47ac-b844-d35c5d2ccd00",
                                                "sense_id": "02f1124e-40cb-3268-b89a-8420c8dde07c",
                                                "text": "„Es muss einen Extrembergsteiger schon frustrieren, wenn die Regionen, in die er vorgedrungen ist, heutzutage sogar von kletternden Hausfrauen erreicht werden - wenn sie denn genügend Kleingeld haben.“"
                                            },
                                            {
                                                "example_id": "f13e1e81-7514-4bea-a225-53681a315387",
                                                "sense_id": "02f1124e-40cb-3268-b89a-8420c8dde07c",
                                                "text": "Hausfrau ist ein sehr anstrengender Beruf."
                                            },
                                            {
                                                "example_id": "677f2c09-dc64-4004-8824-0b5bfa36a441",
                                                "sense_id": "02f1124e-40cb-3268-b89a-8420c8dde07c",
                                                "text": "\"Und er fing an, von Madame Homais zu sprechen, deren arg vernachlässigte Kleidung sie beide sonst immer zum Lachen gereizt hatte. ‚Was schadet denn das?’ unterbrach ihn Emma. ‚Eine gute Hausfrau zerbricht sich nicht den Kopf über das, was sie annzieht.’ \""
                                            },
                                            {
                                                "example_id": "26e01758-7b72-40b7-8253-6bef3dbb5fd1",
                                                "sense_id": "02f1124e-40cb-3268-b89a-8420c8dde07c",
                                                "text": "„Die ersten Absprachen wurden übrigens in den Knuttstuben (Strickstuben) zwischen den beteiligten Hausfrauen getroffen, aus deren Reihen sich später das Festkomitee rekrutierte, das jedem - vom Koch über die Backfrau bis zum Musikus - seine Aufgaben zuwies.“"
                                            },
                                            {
                                                "example_id": "71fab43e-06b9-404f-ae80-c31c03d8ffb8",
                                                "sense_id": "02f1124e-40cb-3268-b89a-8420c8dde07c",
                                                "text": "„Aber da dies nur ein paar Seiten aus dem Leben einer dicken Hausfrau aus Neuengland sind, muss ich aufrichtig sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e2d46907-9cf8-3c52-9f95-005cdb2d0a3f",
                                        "entry_id": "14afac96-fb04-316b-998f-c2152e64badd",
                                        "glosses": [
                                            "ein möbliertes Zimmer oder Ähnliches vermietende Frau"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6492a34-856a-493d-908d-ad0e759c82c6",
                        "source_entry_id": "c7455282-6342-3361-b20c-3234b6724c9e",
                        "source_sense_id": "411f100b-8395-3603-aec5-2d0edbc0cd4a",
