                        "source_sense_id": "a180f9a6-e80c-3119-8281-6e28835f24bc",
                        "source_sense_description": "zonder tanden",
                        "target_lang_word": "toothless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toothless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31d73606-26fd-30fc-99bf-83f8f0730d21",
                                        "entry_id": "88e177b7-992e-37cf-a925-10a32897dd46",
                                        "glosses": [
                                            "Having no teeth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e5bb097-34fd-4a2f-a8b4-b42a0e1ff50e",
                                                "sense_id": "31d73606-26fd-30fc-99bf-83f8f0730d21",
                                                "text": "a toothless old man"
                                            },
                                            {
                                                "example_id": "ce01e6a1-6b58-4ae6-8217-649675fd1192",
                                                "sense_id": "31d73606-26fd-30fc-99bf-83f8f0730d21",
                                                "text": "She goes on to explain the difficulty she's having getting visas for Lawrence and for Robert, the 14-year-old who is her older brother and is, amazingly, the last child of the toothless tiny woman who buzzes around us. (I find out later that she is only in her mid-fifties.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1360ab4c-2687-3131-8083-a803e29c4737",
                                        "entry_id": "88e177b7-992e-37cf-a925-10a32897dd46",
                                        "glosses": [
                                            "Weak; having no ability to enforce something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d3db733-c6f3-4899-87fd-7cb6acd15db6",
                                                "sense_id": "1360ab4c-2687-3131-8083-a803e29c4737",
                                                "text": "The treaty was toothless because of the lack of participation from the undersigned."
                                            },
                                            {
                                                "example_id": "0bf33222-7eff-47db-b7c6-a8ecf61e4632",
                                                "sense_id": "1360ab4c-2687-3131-8083-a803e29c4737",
                                                "text": "Not tell? Ha! ha! I could ſmile, / At this old, and toothleſſe vvile."
                                            },
                                            {
                                                "example_id": "a16f59fe-863a-4501-b37a-210322fe28b2",
                                                "sense_id": "1360ab4c-2687-3131-8083-a803e29c4737",
                                                "text": "Bans of the sale of human remains across platforms like Facebook, Etsy, Instagram and eBay are toothless and poorly enforced, Huffer said. And when a page does get shut down, he said, it just pops up on a different website."
                                            },
                                            {
                                                "example_id": "069a830b-c835-4cad-b939-db005a5a84dd",
                                                "sense_id": "1360ab4c-2687-3131-8083-a803e29c4737",
                                                "text": "The glut of moronic, Roganesque dude-bro podcasts are long overdue for mocking, but this one is toothless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
