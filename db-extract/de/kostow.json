                "senses": [
                    {
                        "sense_id": "5f3b6b3a-50dc-3c1c-8255-3eb408cae61a",
                        "entry_id": "d2875339-7c69-3493-9cba-efcd1b30894b",
                        "glosses": [
                            "Familienname; Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7420e4d1-a843-46f2-9d80-17fac84d0f9a",
                                "sense_id": "5f3b6b3a-50dc-3c1c-8255-3eb408cae61a",
                                "text": "Frau Kostow ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a19c7524-d784-4f99-91a7-c837b180f868",
                                "sense_id": "5f3b6b3a-50dc-3c1c-8255-3eb408cae61a",
                                "text": "Herr Kostow wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "00338c93-cc17-4272-b387-eb3e02bc4981",
                                "sense_id": "5f3b6b3a-50dc-3c1c-8255-3eb408cae61a",
                                "text": "Die Kostows fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "12e187e3-0408-4d71-97ad-ebcc266fa0b7",
                                "sense_id": "5f3b6b3a-50dc-3c1c-8255-3eb408cae61a",
                                "text": "Der Kostow trägt nie die Pullover, die die Kostow ihm strickt."
                            },
                            {
                                "example_id": "4ff61a52-8a8c-4c09-a440-2c1e623328ff",
                                "sense_id": "5f3b6b3a-50dc-3c1c-8255-3eb408cae61a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kostow kommt, geht der Herr Kostow.“"
                            },
                            {
                                "example_id": "a5e80fe4-0d4e-4e54-bc02-8f6fb545a9e3",
                                "sense_id": "5f3b6b3a-50dc-3c1c-8255-3eb408cae61a",
                                "text": "Kostow kommt und geht."
                            },
                            {
                                "example_id": "8ebe9448-1ab5-4e32-86ce-5ee7c4357e0b",
                                "sense_id": "5f3b6b3a-50dc-3c1c-8255-3eb408cae61a",
                                "text": "Kostows kamen, sahen und siegten."
                            }
                        ],
