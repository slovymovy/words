        "nl-extract.jsonl": [
            {
                "entry_id": "38028d03-05e6-3797-a965-c6597920ac00",
                "word": "flonkeren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2e5f4538-04df-3a51-87b4-fc0445af6c75",
                        "entry_id": "38028d03-05e6-3797-a965-c6597920ac00",
                        "glosses": [
                            "op een levendige, onrustige, beweeglijke manier licht uitzenden of weerkaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f267da8-57a3-4dc0-b237-c9d85c27a468",
                                "sense_id": "2e5f4538-04df-3a51-87b4-fc0445af6c75",
                                "text": "De sterren flonkeren in de hemel."
                            },
                            {
                                "example_id": "ae2d7374-a2b6-4202-8b34-ca7a46016513",
                                "sense_id": "2e5f4538-04df-3a51-87b4-fc0445af6c75",
                                "text": "De gastvrouw, met wie ik bevriend ben geraakt, heeft prachtig gedekt. De kaarsen flonkeren, het zilver schittert. Vlak voor we gaan aanzitten, neemt ze me even apart. „Wat een jaar, he”, zegt ze. „Ik word tachtig, maar dit was het ergste jaar uit mijn leven. Sinds de verkiezingen slaap ik slecht. Waar gaat het heen met de wereld?”"
                            },
                            {
                                "example_id": "90852d09-bfcc-45df-8e48-98dd14f38386",
                                "sense_id": "2e5f4538-04df-3a51-87b4-fc0445af6c75",
                                "text": "De zon doet het hoofdkwartier van de Navo glanzen en flonkeren als een kroonjuweel. De ontelbare glazen panelen spelen een vrolijk spel met het felle licht wanneer Donald Trump donderdag even naar vieren arriveert. Onbeschaamd pronkt het gloednieuwe gebouw met zichzelf alsof het de Amerikaanse president wil laten zien klaar te zijn voor een lang en vitaal leven. Dat heeft iets ironisch, om niet zeggen provocerends, tegenover de man die het bondgenootschap nog niet zo lang geleden verouderd noemde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8aa624d6-5d79-4b92-af21-8f3c4efb72ac",
                        "source_entry_id": "38028d03-05e6-3797-a965-c6597920ac00",
                        "source_sense_id": "2e5f4538-04df-3a51-87b4-fc0445af6c75",
                        "source_sense_description": "op een levendige, onrustige, beweeglijke manier licht uitzenden of weerkaatsen",
                        "target_lang_word": "funkeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "funkeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11c72b6b-cda3-3e10-a52f-2a458c67d886",
                                        "entry_id": "bfbfbe22-5417-3437-8e1b-872298121370",
                                        "glosses": [
                                            "kurz und schnell aufleuchten, blitzen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d45d670d-11f4-466a-9841-162ad500a2aa",
                                                "sense_id": "11c72b6b-cda3-3e10-a52f-2a458c67d886",
                                                "text": "Die Tautropfen funkeln auf dem Gras in der frühen Morgensonne wie tausend Diamanten."
                                            },
                                            {
                                                "example_id": "2d87c074-41e3-4cda-9435-ee052bfa04cf",
                                                "sense_id": "11c72b6b-cda3-3e10-a52f-2a458c67d886",
                                                "text": "„Dieses Jahr haben wir den Weihnachtsbaum toll geschmückt! Die Kerzen, Kugeln und das Lametta funkeln miteinander um die Wette.“"
                                            },
                                            {
                                                "example_id": "1fed7fff-4f75-4ed3-8706-622ccbbecac3",
                                                "sense_id": "11c72b6b-cda3-3e10-a52f-2a458c67d886",
                                                "text": "[…] die damals 26-Jährige [Diana Ross startete] 1970 ihre Solokarriere. Der brave Bob-Haarschnitt wich einer Lockenmähne, die Kleider wurden enger, und der Schmuck funkelte prachtvoller."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "36e0b054-5c3e-3248-b34c-0d40e960f8cd",
                                        "entry_id": "bfbfbe22-5417-3437-8e1b-872298121370",
                                        "glosses": [
                                            "als Ausdruck einer Emotion, die (meist) in den Augen sichtbar wird: Erregung oder Freude ausstrahlen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d41a861-46ca-4359-a8e6-8b340710c27f",
                                                "sense_id": "36e0b054-5c3e-3248-b34c-0d40e960f8cd",
                                                "text": "Seine Augen funkelten wütend vor Zorn über ihre Untreue."
                                            },
                                            {
                                                "example_id": "cc868a17-31c8-4685-8a54-bd9cd216f713",
                                                "sense_id": "36e0b054-5c3e-3248-b34c-0d40e960f8cd",
                                                "text": "Kunde: „[Wir hätten gerne] unsere Meldebestätigungen. Man braucht die Dinger doch fürs Standesamt.“ Berliner Schalterbeamtin (bekannt für ihre Unfreundlichkeit): „Ja, schon. Ihre Zukünftige kann auch gerne eine kriegen. Die hat nämlich einen Termin.“ Sie deutete auf den Zettel, „aber Sie nicht, junger Mann.“ Sie funkelte mich an."
                                            },
                                            {
                                                "example_id": "7b797e92-5a54-48a9-9d2c-1e053f7ebc40",
                                                "sense_id": "36e0b054-5c3e-3248-b34c-0d40e960f8cd",
                                                "text": "„Wie die hellen Locken ihr Gesicht umrahmt hatten, und ihre Augen, die hatten gefunkelt!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0d0b4883-bee6-32ba-a377-d019815c923f",
                                        "entry_id": "bfbfbe22-5417-3437-8e1b-872298121370",
                                        "glosses": [
                                            "durch besonderen Witz herausragen, besonders geistreich sein"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "356edef5-6459-42f6-aa1b-6ecf8539da72",
                                                "sense_id": "0d0b4883-bee6-32ba-a377-d019815c923f",
                                                "text": "Erst in der neuen Übersetzung von Renate Bleibtreu funkelt das Buch [August Strindbergs: \"Das rote Zimmer\"] in seinem maliziösen Witz.“"
                                            },
                                            {
                                                "example_id": "e2247a30-ada4-4884-92f4-f1fc010217b6",
                                                "sense_id": "0d0b4883-bee6-32ba-a377-d019815c923f",
                                                "text": "[Die] größten Stärken [des biographischen Romans \"Eden\" von Sibylle Knauss] liegen nämlich im Lebensbild der Abenteurerin Mary Leakey. Darin funkeln Stil, Witz und Farbe\"."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c91c1a28-e165-45a1-8db8-c6f048ad9986",
                        "source_entry_id": "38028d03-05e6-3797-a965-c6597920ac00",
                        "source_sense_id": "2e5f4538-04df-3a51-87b4-fc0445af6c75",
                        "source_sense_description": "op een levendige, onrustige, beweeglijke manier licht uitzenden of weerkaatsen",
                        "target_lang_word": "glitzern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glitzern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f02028b-b705-341f-8505-11961e71c010",
                                        "entry_id": "6a7fe9be-e2b7-336b-a59d-8a90549e9123",
                                        "glosses": [
                                            "einfallendes Licht immer wieder zu allen Seiten hin kräftig reflektieren (oder diesen Effekt nachahmen); farbig (im Licht) schimmern"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6eda561-d46d-4c2a-8785-8b8fdf88e9f5",
                                                "sense_id": "8f02028b-b705-341f-8505-11961e71c010",
                                                "text": "„Sie glitzerte in ihrem paillettenbestickten zartrosa Kleid im Blitzlicht der Fotografen."
                                            },
                                            {
                                                "example_id": "b3b712d2-abc5-4187-969d-e38eb61fbf3c",
                                                "sense_id": "8f02028b-b705-341f-8505-11961e71c010",
                                                "text": "„Ihr Kleid war auch silberfarben und glitzerte förmlich in der Dunkelheit, sie hatte sich herausgeputzt für diesen Abend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c71ec065-d731-342c-95d7-3190c970b46a",
                                        "entry_id": "6a7fe9be-e2b7-336b-a59d-8a90549e9123",
                                        "glosses": [
                                            "Erregung oder Freude ausstrahlen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6aba09a-fc09-44a1-97f6-fb102a2b3322",
                                                "sense_id": "c71ec065-d731-342c-95d7-3190c970b46a",
                                                "text": "„Der Mann war Klinkenfabrikant und glitzerte geradezu in seinem Stolz darauf, dass er dank seiner Loge jetzt ja jederzeit ‚in sein Stadion‘ könne […]“"
                                            },
                                            {
                                                "example_id": "41a83ecb-fe4b-4ff2-ab95-8b632e8b2a3a",
                                                "sense_id": "c71ec065-d731-342c-95d7-3190c970b46a",
                                                "text": "Es glitzerte wahrlich in den Augen der Besucher, als sie endlich einen Blick auf sein neuestes Werk werfen durften."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33929eb7-1ba1-401a-bfb6-b27882e9631c",
                        "source_entry_id": "38028d03-05e6-3797-a965-c6597920ac00",
                        "source_sense_id": "2e5f4538-04df-3a51-87b4-fc0445af6c75",
                        "source_sense_description": "op een levendige, onrustige, beweeglijke manier licht uitzenden of weerkaatsen",
                        "target_lang_word": "twinkle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17f4d68c-679b-3f69-95ec-94219f441c51",
                                        "entry_id": "3b241be2-27a7-34bd-b1c7-26d349d5611b",
                                        "glosses": [
                                            "To shine with a flickering light; to glimmer."
                                        ],
                                        "tags": [
                                            "of a source of light"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90862081-beba-4ce3-aa20-6fe6a6d6df96",
                                                "sense_id": "17f4d68c-679b-3f69-95ec-94219f441c51",
                                                "text": "We could see the lights of the village twinkling in the distance."
                                            },
                                            {
                                                "example_id": "69e7bada-40a5-4de0-b540-9435bf7e050a",
                                                "sense_id": "17f4d68c-679b-3f69-95ec-94219f441c51",
                                                "text": "These stars do not twinkle when viewed through telescopes that have large apertures."
                                            },
                                            {
                                                "example_id": "68293b5b-6f5b-411d-aaa9-23f9e2678e61",
                                                "sense_id": "17f4d68c-679b-3f69-95ec-94219f441c51",
                                                "text": "The western sky twinkled with stars."
                                            },
                                            {
                                                "example_id": "27552d8d-9a4c-4e7a-b887-d0290a84e98e",
                                                "sense_id": "17f4d68c-679b-3f69-95ec-94219f441c51",
                                                "text": "As the train rumbled slowly over the Forth Bridge, the western sky was aflame with a particularly gorgeous sunset, and lights were twinkling from the small craft riding at anchor on the calm waters of the firth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4a7af48-8aad-3ce3-a1b3-fabd71872bb3",
                                        "entry_id": "3b241be2-27a7-34bd-b1c7-26d349d5611b",
                                        "glosses": [
                                            "To be bright with delight."
                                        ],
                                        "tags": [
                                            "of eyes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4672d0d3-d83b-48c6-9d61-b6a2daad7291",
                                                "sense_id": "a4a7af48-8aad-3ce3-a1b3-fabd71872bb3",
                                                "text": "His shrewd little eyes twinkled roguishly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2d720e3-0388-3ce7-bd90-9e0cb9cbfba4",
                                        "entry_id": "3b241be2-27a7-34bd-b1c7-26d349d5611b",
                                        "glosses": [
                                            "To bat, blink or wink the eyes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55db21a7-6768-4fc3-aa8c-2379ba3fd748",
                                                "sense_id": "b2d720e3-0388-3ce7-bd90-9e0cb9cbfba4",
                                                "text": "She smiled and gave a little nod and twinkled her eyes[…]"
                                            },
                                            {
                                                "example_id": "118332f6-fd8a-44ab-bb21-8863ed3db009",
                                                "sense_id": "b2d720e3-0388-3ce7-bd90-9e0cb9cbfba4",
                                                "text": "The Owl Fell a Moping and Twinkling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1322fdf3-29ef-3aaf-a989-9614f766cb7d",
                                        "entry_id": "3b241be2-27a7-34bd-b1c7-26d349d5611b",
                                        "glosses": [
                                            "To flit to and fro."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8ab7f04-494c-482a-bf60-0b6995f76cd5",
                                                "sense_id": "1322fdf3-29ef-3aaf-a989-9614f766cb7d",
                                                "text": "A butterfly twinkled among the vines[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "twinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c864694-d154-312f-9b77-e638d6b96a2e",
                                        "entry_id": "397f0221-ce6c-38f9-9f9f-327d144dce40",
                                        "glosses": [
                                            "A sparkle or glimmer of light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7635d741-a911-465f-9694-8ee2330d0e03",
                                                "sense_id": "5c864694-d154-312f-9b77-e638d6b96a2e",
                                                "text": "Soon the rocket was out of sight, and the flame was only seen as a tiny twinkle of light."
                                            }
                                        ]
                                    },
