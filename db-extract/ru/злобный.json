                "translations": [
                    {
                        "translation_id": "256c5dff-0e02-4de2-8a52-51881d316112",
                        "source_entry_id": "b48480c3-9203-3758-8aa4-1e75924788bf",
                        "target_lang_word": "malicious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malicious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c2ae4d5-f2c3-3165-ad58-fca992773338",
                                        "entry_id": "a4d051de-1ded-3395-94c2-59a2bb12c9a2",
                                        "glosses": [
                                            "Intending to do harm; characterized by spite and malice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e22e9b93-d0cb-42ed-8594-1ff555adbfa6",
                                                "sense_id": "9c2ae4d5-f2c3-3165-ad58-fca992773338",
                                                "text": "He was sent off for a malicious tackle on Jones."
                                            },
                                            {
                                                "example_id": "2e2b22ea-7033-4629-8bfd-90ff3ae69ce2",
                                                "sense_id": "9c2ae4d5-f2c3-3165-ad58-fca992773338",
                                                "text": "They gathered soberly in the farthest recess of the ward and gossiped about him in malicious, offended undertones, rebelling against his presence as a ghastly imposition and resenting him malevolently for the nauseating truth of which he was bright reminder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d91b247a-8935-4d59-a89c-631bf547a1a5",
                        "source_entry_id": "b48480c3-9203-3758-8aa4-1e75924788bf",
                        "target_lang_word": "vicious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vicious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46ee4534-f901-39ec-bbb9-97673cdde4dd",
                                        "entry_id": "899b8237-1158-343f-8eeb-90d7b697da4f",
                                        "glosses": [
                                            "Violent, destructive and cruel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a89f9a3-7701-32b2-91cd-dc0c865733a7",
                                        "entry_id": "899b8237-1158-343f-8eeb-90d7b697da4f",
                                        "glosses": [
                                            "Savage and aggressive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8f267f5-9b6d-4a63-b2e8-51b94d3987df",
                                                "sense_id": "1a89f9a3-7701-32b2-91cd-dc0c865733a7",
                                                "text": "He had always been remarkably immune from such little ailments, and had only once in his life been ill, of a vicious pneumonia long ago at school. He hadn't the faintest idea what to with a cold in the head, he just took quinine and continued to blow his nose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17124271-6dc1-308e-956c-59af209cf828",
                                        "entry_id": "899b8237-1158-343f-8eeb-90d7b697da4f",
                                        "glosses": [
                                            "Pertaining to vice; characterised by immorality or depravity."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18912341-e8f7-41ed-820c-d3535e3c18e3",
                                                "sense_id": "17124271-6dc1-308e-956c-59af209cf828",
                                                "text": "We may so seize on vertue, that if we embrace it with an over-greedy and violent desire, it may become vicious."
                                            },
                                            {
                                                "example_id": "f24ee58b-72dd-4082-a030-80f298262e5c",
                                                "sense_id": "17124271-6dc1-308e-956c-59af209cf828",
                                                "text": "A murrain on you, Reverend Apse/I hope you get caught in a vicious moral lapse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
