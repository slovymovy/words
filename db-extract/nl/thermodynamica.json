                "forms": [],
                "senses": [
                    {
                        "sense_id": "504a66b8-73da-38dc-858a-23a9a301950b",
                        "entry_id": "bc097326-508b-34ae-8c7e-e3fb6a45b68f",
                        "glosses": [
                            "de leer van warmte en arbeid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdbafa40-1a3f-4a77-bc19-97716f7539ad",
                                "sense_id": "504a66b8-73da-38dc-858a-23a9a301950b",
                                "text": "De ontwikkeling van de thermodynamica kwam voort uit de ontwikkeling van de stoommachine enerzijds en van de differentiaalrekening anderzijds."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5591d49d-2fa1-4c43-99a0-9b2089b702fe",
                        "source_entry_id": "bc097326-508b-34ae-8c7e-e3fb6a45b68f",
                        "source_sense_id": "504a66b8-73da-38dc-858a-23a9a301950b",
                        "source_sense_description": "de leer van warmte en arbeid",
                        "target_lang_word": "Thermodynamik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thermodynamik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                        "entry_id": "d232f483-ab21-3ff0-9bce-f9c0b988b8af",
                                        "glosses": [
                                            "Wissenschaft, die sich mit der Wirkung von Wärme beschäftigt; die Lehre der thermischen Energie, ihre Erscheinungsformen und nutzbaren Fähigkeiten"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a28e0b1-298e-4d08-b981-7e73328b1787",
                                                "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                                "text": "„Wir wollen damit beginnen, die Thermodynamik in den Rest der Physik einzuordnen.“"
                                            },
                                            {
                                                "example_id": "a30472a5-84af-441b-8880-8ffc3de9d4ef",
                                                "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                                "text": "„Thermodynamik ist die allgemeine Theorie energie- und stoffumwandelnder Prozesse.“"
                                            },
                                            {
                                                "example_id": "53845eba-a05d-4e4e-8607-6a8217b5e071",
                                                "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                                "text": "„Die Thermodynamik sagt aus, dass eine Reaktion dann „freiwillig“ ablaufen kann, wenn die Differenz der freien Enthalpie zwischen Ausgangs- und Endzustand negativ ist (0<∆G).“"
                                            },
                                            {
                                                "example_id": "373d7945-9bd0-47b0-9068-9548adc1c0b9",
                                                "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                                "text": "„Die folgende Phase war gekennzeichnet durch das Bestreben, die wissenschaftlichen Erkenntnisse der Thermodynamik praktisch zu nutzen und so spielen vor allem Ingenieure eine herausragende Rolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69569641-b8c4-481e-835b-e342ddc66971",
                        "source_entry_id": "bc097326-508b-34ae-8c7e-e3fb6a45b68f",
                        "source_sense_id": "504a66b8-73da-38dc-858a-23a9a301950b",
                        "source_sense_description": "de leer van warmte en arbeid",
                        "target_lang_word": "thermodynamics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thermodynamics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84cfbf47-fd3a-38f7-b3c3-7626a68ba1e3",
                                        "entry_id": "c20fa274-d3ad-319a-9d85-f43f7cb9b707",
                                        "glosses": [
                                            "The science of the conversions between heat and other forms of energy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b38a267a-6dbb-4a5f-b1d9-f853dbd6be3b",
                                                "sense_id": "84cfbf47-fd3a-38f7-b3c3-7626a68ba1e3",
                                                "text": "“3D photochemistry plays a huge role because it provides heating or cooling, which can affect the thermodynamics and perhaps the atmospheric composition of a planetary system,” Chen said."
                                            },
                                            {
                                                "example_id": "d42fdf9e-cbdf-4c40-9e82-fc32fcdb24d3",
                                                "sense_id": "84cfbf47-fd3a-38f7-b3c3-7626a68ba1e3",
                                                "text": "The top-hatted “drinking bird,” once a fixture in science classrooms for demonstrating the basics of thermodynamics, is making a surprising comeback — as the inspiration for a new clean-energy generator that could one day power your watch and phone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee7fc0aa-e855-416e-bf26-d2ecfc45b1cf",
                        "source_entry_id": "bc097326-508b-34ae-8c7e-e3fb6a45b68f",
                        "source_sense_id": "504a66b8-73da-38dc-858a-23a9a301950b",
