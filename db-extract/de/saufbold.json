                "senses": [
                    {
                        "sense_id": "00c857a8-2234-36ee-ab93-410b6e2e9f46",
                        "entry_id": "27254685-6f70-3461-9f10-f91e4ee77a80",
                        "glosses": [
                            "eine Person, die viel Alkohol trinkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cdcbe3f-4ab7-42f1-89ee-06310d91bf8e",
                                "sense_id": "00c857a8-2234-36ee-ab93-410b6e2e9f46",
                                "text": "Mit diesem Saufbold gehe ich nicht mehr in die Stadt!"
                            },
                            {
                                "example_id": "51b9cccc-0e72-4b11-8c50-72b405a93955",
                                "sense_id": "00c857a8-2234-36ee-ab93-410b6e2e9f46",
                                "text": "„Da ich jedoch den Mann als rüpelhaften und groben Saufbold kannte, der für ein Ja oder Nein rasch mit dem Degen zur Hand war, hielt ich es für besser, zu schweigen und nicht mehr an seine Tochter zu denken; denn ich wollte mich mit einem Mann seines Schlages nicht einlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
