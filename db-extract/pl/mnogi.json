                "translations": [
                    {
                        "translation_id": "a0ceead0-df2d-4f98-b736-c02570fa0ebd",
                        "source_entry_id": "4b4d1680-1fe2-30a2-84f4-b5723915406e",
                        "source_sense_id": "2a6de48f-408f-3596-b175-e2f9ff3d1611",
                        "target_lang_word": "numerous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "numerous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e768dc0-79b6-37c0-b050-9d89fe1fbe1c",
                                        "entry_id": "5119ebc9-128c-3c98-847b-3d40372abb7a",
                                        "glosses": [
                                            "An indefinite large number of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7dbd958-b37a-4bc8-a5f2-f99f1209d30a",
                                                "sense_id": "6e768dc0-79b6-37c0-b050-9d89fe1fbe1c",
                                                "text": "There are numerous definitions of the word 'man'."
                                            },
                                            {
                                                "example_id": "7fe9cec6-f806-4db8-abab-490658aa8fc1",
                                                "sense_id": "6e768dc0-79b6-37c0-b050-9d89fe1fbe1c",
                                                "text": "There are numerous reasons to refrain."
                                            },
                                            {
                                                "example_id": "194da907-59ea-43a0-b802-0b41848b3d1b",
                                                "sense_id": "6e768dc0-79b6-37c0-b050-9d89fe1fbe1c",
                                                "text": "Numerous experimental tests and other observations have been offered in favor of animal mind reading, and although many scientists are skeptical, others assert that humans are not the only species capable of representing what others do and don’t perceive and know."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "numerous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a00bf81c-c8fb-3ce9-b3f6-f53dd7b49c7a",
                                        "entry_id": "388d6a80-2f14-3130-bf49-6b9c0257578c",
                                        "glosses": [
                                            "Indefinitely large numerically; many."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c2e518f-c485-47b6-bb7b-0456c5d1d966",
                                                "sense_id": "a00bf81c-c8fb-3ce9-b3f6-f53dd7b49c7a",
                                                "text": "The reasons to refrain are numerous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d72a70d-f868-3130-86ca-e615073810db",
                                        "entry_id": "388d6a80-2f14-3130-bf49-6b9c0257578c",
                                        "glosses": [
                                            "Consisting of a large number of individuals or parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94d48ea0-0679-4c54-ae1b-eb0b60051b11",
                                                "sense_id": "6d72a70d-f868-3130-86ca-e615073810db",
                                                "text": "A numerous band of men and maidens escorts him by torchlight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5750b086-412d-4f6c-a64f-1729f8b080ee",
                        "source_entry_id": "4b4d1680-1fe2-30a2-84f4-b5723915406e",
                        "source_sense_id": "2a6de48f-408f-3596-b175-e2f9ff3d1611",
                        "target_lang_word": "zahlreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zahlreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fca107f-6105-3ba1-954f-eadf17fd5655",
                                        "entry_id": "76bd31f1-6be7-3285-9a5a-6ff0d62410d6",
                                        "glosses": [
                                            "in großer Anzahl vorhanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d1977f6-f125-40c7-9fb2-ce803b0c329d",
                                                "sense_id": "5fca107f-6105-3ba1-954f-eadf17fd5655",
                                                "text": "Ich will die Richtigkeit dieser Zauberformel am Leben zahlreicher erfolgreicher Menschen aufzeigen."
                                            },
                                            {
                                                "example_id": "16a6210b-c748-4fae-8ebc-fe5f9d043d10",
                                                "sense_id": "5fca107f-6105-3ba1-954f-eadf17fd5655",
                                                "text": "„Bewährt hatte sich durch zahlreiche persönliche Beziehungen zwischen der vermischten und den munizipalen Aristokratien Italiens eng geknüpfte Band der Wehrgenossenschaft, die Hannibal trotz vielerlei Bemühungen und einiger Teilerfolge nicht zu sprengen vermochte.“"
                                            },
                                            {
                                                "example_id": "5745a697-ca85-4cb7-8189-893d14f1d9aa",
                                                "sense_id": "5fca107f-6105-3ba1-954f-eadf17fd5655",
                                                "text": "„Die Archäologen arbeiteten bei der Erforschung und Interpretation der Funde mit zahlreichen Kollegen aus Nachbardisziplinen zusammen.“"
                                            },
                                            {
                                                "example_id": "017b3c41-6cd5-4a5c-8deb-5dd0a8977ac6",
                                                "sense_id": "5fca107f-6105-3ba1-954f-eadf17fd5655",
                                                "text": "„Aber zahlreicher sind die Schimpf- und Drohbriefe, die täglich an meine Adresse kommen.“"
                                            },
                                            {
                                                "example_id": "087c2815-358c-49e7-9195-7b961c059ce8",
                                                "sense_id": "5fca107f-6105-3ba1-954f-eadf17fd5655",
                                                "text": "„Es handelt sich hierbei um Einzeller (Protozoen) wie die Foraminiferen (mit Kalkschale) und die Radiolarien (Skelett aus Kieselsäure), um Coelenteraten wie Medusen und Quallen, um Rädertierchen, Würmer aus der Gruppe der Anneliden und der Chaetognathen sowie zahlreiche Krustentiere, unter den die Copepoden überwiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d2c05e1-c0bc-4cba-b3b4-c4ffc508c652",
                        "source_entry_id": "4b4d1680-1fe2-30a2-84f4-b5723915406e",
                        "source_sense_id": "9d16d5e1-cc8e-323a-baba-89ba9b3ff6a0",
                        "target_lang_word": "plural",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f2c8a34-cd2e-36a5-b610-5b76adee4c5f",
                                        "entry_id": "a07204f6-d40e-3a36-87a2-1260180a9340",
                                        "glosses": [
                                            "Consisting of or containing more than one of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c38781d2-05a7-4291-930c-92a5a89c4983",
                                                "sense_id": "9f2c8a34-cd2e-36a5-b610-5b76adee4c5f",
                                                "text": "The notion of culture is one whose meanings are plural and shifting."
                                            },
                                            {
                                                "example_id": "f411a0ad-bbec-4ce0-a930-71f37ae4feea",
                                                "sense_id": "9f2c8a34-cd2e-36a5-b610-5b76adee4c5f",
                                                "text": "Than plural faith which is too much by one: Thou counterfeit to thy true friend!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "732692e6-3fde-3f9a-ad23-f6a829a38111",
                                        "entry_id": "a07204f6-d40e-3a36-87a2-1260180a9340",
                                        "glosses": [
                                            "In systems of number, not singular or not singular or dual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8306d46-0fd6-4b0b-bda5-e766095ef28f",
                                                "sense_id": "732692e6-3fde-3f9a-ad23-f6a829a38111",
                                                "text": "English nouns usually have singular and plural forms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb0a8c56-e560-3030-b069-7adc15bd003d",
                                        "entry_id": "a07204f6-d40e-3a36-87a2-1260180a9340",
                                        "glosses": [
                                            "Pluralistic."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29dd1c02-1c24-47b2-84ca-a5893e9e5c4c",
                                                "sense_id": "eb0a8c56-e560-3030-b069-7adc15bd003d",
                                                "text": "Although the nation was far more plural than Canada in the number of its Christian groups"
                                            },
                                            {
                                                "example_id": "10e02c5f-cabe-4a1a-844a-f81672f59b3e",
                                                "sense_id": "eb0a8c56-e560-3030-b069-7adc15bd003d",
                                                "text": "The Hong Kong and Singapore markets are way more \"plural\" than most Western economies, but they have not led to pluralistic politics."
                                            },
                                            {
                                                "example_id": "c505b6f4-2ba3-41c1-b908-77f52d00c404",
                                                "sense_id": "eb0a8c56-e560-3030-b069-7adc15bd003d",
                                                "text": "History is perhaps more plural than traditionally imagined, leaving room for more groups to express their story."
                                            },
                                            {
                                                "example_id": "04b1d940-8459-4a4d-bfe3-48c5d873a3fa",
                                                "sense_id": "eb0a8c56-e560-3030-b069-7adc15bd003d",
                                                "text": "Generally the girls tend to perceive their social world as somewhat more plural than boys do. Several of these questions reveal that there are more boys (61%) than girls (39%) who 'do not know' about the religion of others"
                                            },
                                            {
                                                "example_id": "16385ff2-3225-41af-b1ca-852a04c16d3f",
                                                "sense_id": "eb0a8c56-e560-3030-b069-7adc15bd003d",
                                                "text": "Yet More's conscience was responding to a world just a little more plural than the world he was born in"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd69ec1-3d0b-3121-9df2-4ef24af889d2",
                                        "entry_id": "a07204f6-d40e-3a36-87a2-1260180a9340",
                                        "glosses": [
                                            "Having some form of multiplicity, especially dissociative identity disorder."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "plural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca0603e3-ff08-3efd-a25c-4f29add313a9",
                                        "entry_id": "38fa99a1-9a3e-3f63-8ac0-b83d2e829142",
                                        "glosses": [
                                            "The plural number. In English, referring to more or less than one of something."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "803b9ac1-78fe-4940-ae53-c37348b33bf2",
                                                "sense_id": "ca0603e3-ff08-3efd-a25c-4f29add313a9",
                                                "text": "\"There are three numbers; the singular, the dual, and the plural. [...] The dual is sometimes used to denote two objects, but even here the plural is more common.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "778ac58f-afef-3acb-a116-82fe5059c050",
                                        "entry_id": "38fa99a1-9a3e-3f63-8ac0-b83d2e829142",
                                        "glosses": [
                                            "A word in the form in which it potentially refers to something other than one person or thing; and other than two things if the language has a dual form."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1139a43c-0081-4632-bbd0-5f8d9966d709",
                                                "sense_id": "778ac58f-afef-3acb-a116-82fe5059c050",
                                                "text": "The plural of 'cat' is 'cats', but the plural of 'child' is 'children'."
                                            },
                                            {
                                                "example_id": "23e119fa-58c2-4539-9738-5ede8e9bb5f9",
                                                "sense_id": "778ac58f-afef-3acb-a116-82fe5059c050",
                                                "text": "Malay is the lingua franca of several Southeast Asia countries and has been simplified by its use as a second language by non-native speakers.\nFor example, the Malay plural is formed by repeating a word twice – buku means book and buku-buku means books."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb7a32d5-6f3a-3351-ac2d-c854c3468a66",
                                        "entry_id": "38fa99a1-9a3e-3f63-8ac0-b83d2e829142",
                                        "glosses": [
                                            "A person with some form of multiplicity, particularly dissociative identity disorder."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47fe6467-f97e-461c-941c-bf078a29d2cb",
                                                "sense_id": "cb7a32d5-6f3a-3351-ac2d-c854c3468a66",
                                                "text": "Singlet and monocultural identity is so normalized that many voice hearers and plurals don’t share their experiences with anyone, living in isolation (and sometimes in poverty) and spending considerable inner resources to manage postures and performances of ‘mental health’."
                                            },
                                            {
                                                "example_id": "c7a08613-7391-45da-988c-dac43beb810f",
                                                "sense_id": "cb7a32d5-6f3a-3351-ac2d-c854c3468a66",
                                                "text": "More strongly, respect might require that singlets themselves accept, in the context of interacting with plurals, that people are truly distinct people."
                                            },
                                            {
                                                "example_id": "0cae138c-ca4e-4cd3-b248-ae65190ae8a1",
                                                "sense_id": "cb7a32d5-6f3a-3351-ac2d-c854c3468a66",
                                                "text": "Autistics, plurals, and gender nonconforming individuals are all stigmatized as not being capable of understanding their own experiences and are repeatedly attacked with narratives intended to make them doubt their own emotions, memories, and sense of self."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
