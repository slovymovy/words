                    },
                    {
                        "translation_id": "df593121-4084-45bd-b6e5-533139c5112d",
                        "source_entry_id": "905e52cd-abe2-304b-ae45-1e913c818818",
                        "source_sense_id": "3007c72b-48b5-327d-8f3e-c2570fbfd67f",
                        "source_sense_description": "een titel die aan bepaalde geestelijken wordt verleend binnen enkele christelijke kerkgemeenschappen.",
                        "target_lang_word": "chanoine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chanoine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "203d2c08-1af3-38c3-8b61-b0d67b632c91",
                                        "entry_id": "2ef3379c-d750-3700-840c-50515fb8f5c1",
                                        "glosses": [
                                            "Prêtre catholique membre du conseil de l’évêque et chargé de célébrer l’office."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2f70a9f-5e58-4a52-ba7d-fd2386261a0d",
                                                "sense_id": "203d2c08-1af3-38c3-8b61-b0d67b632c91",
                                                "text": "M. Pierre-Nicolas Anot, prêtre, docteur en théologie, chanoine, théologal et grand-pénitencier de Reims, est mort le 21 octobre dernier, âgé de près de 61 ans."
                                            },
                                            {
                                                "example_id": "8ca06b77-0314-453d-b3b5-7ca383a27ae9",
                                                "sense_id": "203d2c08-1af3-38c3-8b61-b0d67b632c91",
                                                "text": "Ce volume, petit in-32, semblable à un Annuaire du Bureau des Longitudes, est recouvert de drap pelucheux comme un bréviaire de chanoine, […]."
                                            },
                                            {
                                                "example_id": "f429597f-6740-4275-8621-f1ebe8910927",
                                                "sense_id": "203d2c08-1af3-38c3-8b61-b0d67b632c91",
                                                "text": "Vous pensez bien, dit-il, que la nomination d’un chanoine étranger au diocèse n’a pas été considérée d’un œil indifférent par le clergé de Chartres."
                                            },
                                            {
                                                "example_id": "21eac1f1-0e11-4551-94cf-84577ee77e65",
                                                "sense_id": "203d2c08-1af3-38c3-8b61-b0d67b632c91",
                                                "text": "Tadeus Stanek ressemblait à un chanoine tel que la tradition nous en impose l’image. Il en avait la rondeur, l’air benoît et une onctuosité de geste qui donnait confiance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a762df4d-9587-30f3-966f-053679ea709e",
                                        "entry_id": "2ef3379c-d750-3700-840c-50515fb8f5c1",
                                        "glosses": [
                                            "Celui qui possède un canonicat dans une église cathédrale, collégiale ou certaines basiliques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "090cce97-ef45-44f7-b8c1-da3ed0880a9d",
                                                "sense_id": "a762df4d-9587-30f3-966f-053679ea709e",
                                                "text": "Il alla trouver un vieux chanoine de la collégiale de Condé, nommé Josquin, qui avait un génie merveilleux pour la musique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f434f1e2-2392-3ca7-8b28-cfc7980541a3",
                                        "entry_id": "2ef3379c-d750-3700-840c-50515fb8f5c1",
                                        "glosses": [
                                            "Prêtre ou diacre vivant dans une communauté religieuse et se distinguant des moines par le fait qu’il assume une charge pastorale d’âmes, souvent au sein d’une église paroissiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb69963c-9131-4773-aeda-84cac840d2bd",
                                                "sense_id": "f434f1e2-2392-3ca7-8b28-cfc7980541a3",
                                                "text": "Bientôt millénaire, la congrégation des chanoines du Grand-Saint-Bernard amplifie sa mission d’accueil sur ce col en haute altitude, en combinant pastorale du tourisme et écoute des besoins spirituels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
