                "senses": [
                    {
                        "sense_id": "031f1ecb-71e5-3ce6-85bc-c4de4bfcf152",
                        "entry_id": "e5b6f065-e2d6-3ed3-a4ed-25d828fbe256",
                        "glosses": [
                            "Donner un caractère iconologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d55ff3d-9f3c-4f31-b0d3-77586f59c64d",
                                "sense_id": "031f1ecb-71e5-3ce6-85bc-c4de4bfcf152",
                                "text": "Il a si bien ciblé l’essence même de l'ouvrage qu'il me propose d’« iconologiser » Panofsky lui-même, c’est-à-dire de définir l’« habitus» par lequel Panofsky participe du XXᵉ siècle."
                            },
                            {
                                "example_id": "50a68c61-c86b-469f-b16f-495fe1443e4c",
                                "sense_id": "031f1ecb-71e5-3ce6-85bc-c4de4bfcf152",
                                "text": "C'était comme si la puissance insupportable de l'illusion réaliste de la photographie nous obligeait d'iconologiser la photographie."
                            }
                        ]
                    }
                ],
