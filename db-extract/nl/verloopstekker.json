                    {
                        "sense_id": "33ff83c5-bea4-38e8-b5e5-8ef167ef8ab5",
                        "entry_id": "e57f3043-e17b-3994-b243-d8b1ebab636a",
                        "glosses": [
                            "een hulpmiddel dat twee elektrische apparaten met ongelijke aansluitingen met elkaar kan verbinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8e2468b-8638-4003-99b8-2612a50420c7",
                                "sense_id": "33ff83c5-bea4-38e8-b5e5-8ef167ef8ab5",
                                "text": "De Soldius 1, versie 3, heeft twee zonnepanelen. In combinatie met een mini-usb-aansluiting en diverse verloopstekkers kan het apparaat mobieltjes van bijna alle merken opladen, plus alle apparaten met een 5 volts usb-aansluiting, zoals een TomTom."
                            },
                            {
                                "example_id": "b6ffdb25-9e08-47cf-b06b-e903abf8cfe8",
                                "sense_id": "33ff83c5-bea4-38e8-b5e5-8ef167ef8ab5",
                                "text": "Gelukkig is ieder gewoon stopcontact goed genoeg, als je maar de juiste verloopstekker bij je hebt."
                            }
                        ]
                    }
                ],
