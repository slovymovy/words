{
    "word_family": [
        "utility",
        "utilize",
        "utilization",
        "utilitarianism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f588af66-fadf-3556-abca-70f824424c70",
                    "sense_definition": "Designed to be practical, functional, and useful rather than attractive or decorative.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "functionality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The furniture in the office was strictly <w>utilitarian</w>, chosen for durability rather than style.",
                            "target_lang_translations": {
                                "ru": "Мебель в офисе была сугубо <w>утилитарной</w>, выбранной ради долговечности, а не стиля."
                            }
                        },
                        {
                            "text": "He preferred a simple, <w>utilitarian</w> design for his workshop tools.",
                            "target_lang_translations": {
                                "ru": "Для инструментов в своей мастерской он предпочитал простой, <w>практичный</w> дизайн."
                            }
                        }
                    ],
                    "synonyms": [
                        "functional",
                        "practical",
                        "pragmatic"
                    ],
                    "antonyms": [
                        "decorative",
                        "ornamental"
                    ],
                    "common_phrases": [
                        "purely utilitarian",
                        "utilitarian design"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный быть практичным, функциональным и полезным, а не привлекательным или декоративным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утилитарный",
                                "target_lang_sense_clarification": "практичный, сугубо функциональный"
                            },
                            {
                                "target_lang_word": "практичный",
                                "target_lang_sense_clarification": "удобный и функциональный"
                            },
                            {
                                "target_lang_word": "функциональный",
                                "target_lang_sense_clarification": "рассчитанный на выполнение функций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ac20798-1b84-3527-b9ac-302be06937ea",
                    "sense_definition": "Of, relating to, or based on the ethical doctrine of utilitarianism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "From a <w>utilitarian</w> perspective, any action that maximizes overall happiness is morally right.",
                            "target_lang_translations": {
                                "ru": "С <w>утилитаристской</w> точки зрения любое действие, максимизирующее всеобщее счастье, является морально правильным."
                            }
                        },
                        {
                            "text": "The philosopher proposed a <w>utilitarian</w> framework to resolve modern ethical dilemmas.",
                            "target_lang_translations": {
                                "ru": "Философ предложил <w>утилитаристскую</w> концепцию для разрешения современных этических дилемм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "utilitarian ethics",
                        "utilitarian perspective"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к этическому учению утилитаризма или основанный на нем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утилитаристский",
                                "target_lang_sense_clarification": "связанный с утилитаризмом"
                            },
                            {
                                "target_lang_word": "утилитарный",
                                "target_lang_sense_clarification": "в контексте этики утилитаризма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b20b7461-6470-380d-9e70-0656a2baef3d",
                    "sense_definition": "Of or relating to usefulness or utility.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "functionality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee evaluated the project purely on its <w>utilitarian</w> value to the local community.",
                            "target_lang_translations": {
                                "ru": "Комитет оценивал проект исключительно по его <w>практической</w> ценности для местного сообщества."
                            }
                        },
                        {
                            "text": "Beyond its historical significance, the building serves a modern <w>utilitarian</w> purpose.",
                            "target_lang_translations": {
                                "ru": "Помимо исторического значения, здание служит современным <w>утилитарным</w> целям."
                            }
                        }
                    ],
                    "common_phrases": [
                        "utilitarian value",
                        "utilitarian purpose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к пользе, практической выгоде или применимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утилитарный",
                                "target_lang_sense_clarification": "имеющий чисто практическое значение или пользу"
                            },
                            {
                                "target_lang_word": "практический",
                                "target_lang_sense_clarification": "относящийся к реальной пользе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b10ad2d-eb6d-36c0-aa39-7bd705a6d54d",
                    "sense_definition": "An adherent, practitioner, or supporter of utilitarianism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a committed <w>utilitarian</w>, she consistently voted for policies that benefited the majority.",
                            "target_lang_translations": {
                                "ru": "Будучи убеждённым <w>утилитаристом</w>, она последовательно голосовала за политику, приносящую пользу большинству."
                            }
                        },
                        {
                            "text": "Early <w>utilitarians</w> argued that laws should aim to produce the greatest happiness for the greatest number.",
                            "target_lang_translations": {
                                "ru": "Первые <w>утилитаристы</w> утверждали, что законы должны быть направлены на достижение наибольшего счастья для наибольшего числа людей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последователь или сторонник утилитаризма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утилитарист",
                                "target_lang_sense_clarification": "приверженец этики утилитаризма"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}