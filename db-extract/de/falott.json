                "senses": [
                    {
                        "sense_id": "53753f9a-cb9e-3cf8-ac5a-72dc496fd180",
                        "entry_id": "0b45d1dd-f02e-3750-886f-128204d7dc38",
                        "glosses": [
                            "Betrüger, Halunke, Lump"
                        ],
                        "tags": [
                            "Bavarian",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3c19edea-64ef-42f7-8e05-5cf22ac15ee8",
                                "sense_id": "53753f9a-cb9e-3cf8-ac5a-72dc496fd180",
                                "text": "„Trotz stockenden Blutes wirkt er beweglich – ein gealterter Loge, ein unglücklicher Mensch, selbst von Alberich gegängelt, gängelt er die anderen, ein bisschen Showstar und doch ein hinterhältiger Falott.“"
                            },
                            {
                                "example_id": "8fc3dc6f-e080-41bd-af27-c17e252ed5c9",
                                "sense_id": "53753f9a-cb9e-3cf8-ac5a-72dc496fd180",
                                "text": "„Wenn sich so ein Fallot wenigstens schlagen möcht’ – aber nein, da wär’ er ja vorsichtiger, da möcht’ er sowas nicht riskieren…“"
                            },
                            {
                                "example_id": "3a8f7f00-202d-4ed2-a6cb-cdceced4110e",
                                "sense_id": "53753f9a-cb9e-3cf8-ac5a-72dc496fd180",
                                "text": "„‚Vorn im G’schäft verkaufst du das bisserl Fleisch, das dir zugeteilt wird. Und hinten im Hof verkaufst du die Schwarzmarktware, du Falott, du!‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b09ede5e-3d9d-48b0-98ab-c44a4d362cf1",
                        "source_entry_id": "0b45d1dd-f02e-3750-886f-128204d7dc38",
                        "source_sense_id": "53753f9a-cb9e-3cf8-ac5a-72dc496fd180",
                        "source_sense_description": "bairisch, besonders österreichisch, umgangssprachlich: Betrüger, Halunke, Lump",
                        "target_lang_word": "мерзавец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мерзавец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8019bab8-f9c2-38cb-990d-0c03c497e22b",
                                        "entry_id": "5e899f65-88a3-32e0-bd03-27f979f49269",
                                        "glosses": [
                                            "разг., бран. отвратительный человек, негодяй || употребляется как бранное слово"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7d1675-c401-4736-ae63-5ea07491479a",
                                                "sense_id": "8019bab8-f9c2-38cb-990d-0c03c497e22b",
                                                "text": "Ни одного чиновника нет у меня хорошего, все мерзавцы!"
                                            },
                                            {
                                                "example_id": "f59ef5b4-4d6c-4016-bc5c-a506fb3d1797",
                                                "sense_id": "8019bab8-f9c2-38cb-990d-0c03c497e22b",
                                                "text": "Ты лжёшь, мерзавец! вскричал я в бешенстве, ты лжёшь самым бесстыдным образом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26078e31-e713-4c32-9c1f-16db84386935",
                        "source_entry_id": "0b45d1dd-f02e-3750-886f-128204d7dc38",
                        "source_sense_id": "53753f9a-cb9e-3cf8-ac5a-72dc496fd180",
                        "source_sense_description": "bairisch, besonders österreichisch, umgangssprachlich: Betrüger, Halunke, Lump",
                        "target_lang_word": "негодяй",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "негодяй",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "88c82231-4383-3761-9d78-bfc9034de9c8",
                                        "entry_id": "5d9ecab8-9011-3ce0-bb03-2bd4c4abac56",
                                        "glosses": [
                                            "бран. негодный, подлый, низкий человек, внушающий негодование"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a9dd10-5e37-4f89-a046-a6eccd26afef",
                                                "sense_id": "88c82231-4383-3761-9d78-bfc9034de9c8",
                                                "text": "Впрочем, ей нечего говорить, скажу её мужу, что я негодяй, обманывал его."
                                            },
                                            {
                                                "example_id": "0295f382-1448-4a78-a998-f32eb3c4cfab",
                                                "sense_id": "88c82231-4383-3761-9d78-bfc9034de9c8",
                                                "text": "— Телегин негодяй и преступник, военным судом он будет расстрелян."
                                            },
                                            {
                                                "example_id": "275753a8-7b50-469e-8431-02853d1d716f",
                                                "sense_id": "88c82231-4383-3761-9d78-bfc9034de9c8",
                                                "text": "Так у этого негодяя ещё и жена — коммунистка?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a4dc2f0-b28c-4628-981e-b74178265ee3",
                        "source_entry_id": "0b45d1dd-f02e-3750-886f-128204d7dc38",
                        "source_sense_id": "53753f9a-cb9e-3cf8-ac5a-72dc496fd180",
                        "source_sense_description": "bairisch, besonders österreichisch, umgangssprachlich: Betrüger, Halunke, Lump",
                        "target_lang_word": "обманщик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обманщик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "358043e1-8a40-3eb4-abcd-2e3e5687dcdd",
                                        "entry_id": "b36dbe7c-2990-34f9-ba55-aaeea9137f38",
                                        "glosses": [
                                            "тот, кто обманул или обманывает кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c69eadd-1f80-4fb6-8b43-1695afbae559",
                                                "sense_id": "358043e1-8a40-3eb4-abcd-2e3e5687dcdd",
                                                "text": "Назвать его в глаза обманщиком ― было подвергнуть себя погибели; и то, на что был я готов под виселицею в глазах всего народа и в первом пылу негодования, теперь казалось мне бесполезной хвастливостию."
                                            },
                                            {
                                                "example_id": "5ea49911-7a71-4581-8033-6d1fff730534",
                                                "sense_id": "358043e1-8a40-3eb4-abcd-2e3e5687dcdd",
                                                "text": "— Что любовь! — заметила она, — это пагубное чувство; мужчины все такие обманщики…"
                                            },
                                            {
                                                "example_id": "db9d568e-4419-4f1d-a9f7-50abf952e799",
                                                "sense_id": "358043e1-8a40-3eb4-abcd-2e3e5687dcdd",
                                                "text": "Злые же люди и обманщики будут преуспевать во зле, вводя в заблуждение и заблуждаясь."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
