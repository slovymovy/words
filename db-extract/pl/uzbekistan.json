                                        "sense_id": "68988d1a-3fcb-3212-8324-ac6dcde912cb",
                                        "entry_id": "2ce168c9-e3ce-3b66-90f4-d1e95ff02d54",
                                        "glosses": [
                                            "A country in Central Asia. Official name: Republic of Uzbekistan. Capital: Tashkent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd0c51a2-0a6d-4d8e-9c5d-352cc7333957",
                                                "sense_id": "68988d1a-3fcb-3212-8324-ac6dcde912cb",
                                                "text": "Several officers are going to train border police in Tajikistan and Uzbekistan, which border Afghanistan, and in several other countries."
                                            },
                                            {
                                                "example_id": "b5856aa5-56f6-420b-b149-e4061ae2f4db",
                                                "sense_id": "68988d1a-3fcb-3212-8324-ac6dcde912cb",
                                                "text": "She wore a coat made of old cloth from Uzbekistan called a suzani, which was faded black with embroidered red circles and yellow and white zigzags."
                                            },
                                            {
                                                "example_id": "61c562e5-2073-4486-bae0-31a7539fd4b3",
                                                "sense_id": "68988d1a-3fcb-3212-8324-ac6dcde912cb",
                                                "text": "In Uzbekistan, forced sterilizations apparently began in 2004 and became official state policy in 2009."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
