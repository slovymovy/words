                "senses": [
                    {
                        "sense_id": "9f42d631-bb1e-38bc-af7b-4f79c7ffe454",
                        "entry_id": "f7d6a468-9176-36ff-8b40-d43b9cac4678",
                        "glosses": [
                            "Eigenschaft/Handlungsweise, in übersteigertem Maße aktiv, tätig zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab8b192a-b0c6-4efa-bce6-a4c2a74f15ec",
                                "sense_id": "9f42d631-bb1e-38bc-af7b-4f79c7ffe454",
                                "text": "„Überaktivität bedeutet exzessive Ruhelosigkeit, besonders in Situationen, die relative Ruhe verlangen.“"
                            },
                            {
                                "example_id": "0083fcd6-dcbe-40bf-9ecb-b3272e39f0d1",
                                "sense_id": "9f42d631-bb1e-38bc-af7b-4f79c7ffe454",
                                "text": "„Um nicht der Gefahr der Überaktivität zu erliegen, gilt es, unsere eigenen Grenzen und fehlenden Kapazitäten zu akzeptieren und gelassen zu glauben: Gott wirkt und ich darf mich daran beteiligen!“"
                            },
                            {
                                "example_id": "6fb8feee-4bc6-4f3e-9a28-53bbd6e1281a",
                                "sense_id": "9f42d631-bb1e-38bc-af7b-4f79c7ffe454",
                                "text": "„Schädigungen oberhalb des mittleren Hirnstamms (Pons) führen zu einer Überaktivität des Blasenmuskels ohne wesentliche Abflussbehinderung.“"
                            },
                            {
                                "example_id": "e3b63ee5-64af-4b1d-85dd-8c789896fae2",
                                "sense_id": "9f42d631-bb1e-38bc-af7b-4f79c7ffe454",
                                "text": "„Befunde aus pharmakologischen Provokationstests könnten eventuell als Überaktivität im noradrenergen System interpretiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
