                        "cross_references": [
                            {
                                "target_word": "schlecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ed0a761-0011-36f4-82c1-e8e7f8230c04",
                                        "entry_id": "e7dced2c-cfdd-3014-895b-b0a6a610e723",
                                        "glosses": [
                                            "nicht den Anforderungen oder Erwartungen entsprechend, weil mit Mängeln behaftet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58a68188-a573-4f11-8bec-477d93e1850d",
                                                "sense_id": "3ed0a761-0011-36f4-82c1-e8e7f8230c04",
                                                "text": "Die Messer sind von schlechter Qualität, sie schneiden nicht."
                                            },
                                            {
                                                "example_id": "d69c81d8-2e92-4eea-9150-28a2311bff01",
                                                "sense_id": "3ed0a761-0011-36f4-82c1-e8e7f8230c04",
                                                "text": "„Die CDU-Vorsitzende Angela Merkel, der in der Partei schlechtes Krisenmanagement vorgeworfen wurde, ließ Meyer beschädigt zurück.“"
                                            },
                                            {
                                                "example_id": "efc8115b-4125-4097-aa07-c379a9d0f4ba",
                                                "sense_id": "3ed0a761-0011-36f4-82c1-e8e7f8230c04",
                                                "text": "Das ist eine schlechte Lösung, weil sie mehr Nachteile als Vorteile mit sich bringt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0896210d-50fd-34b0-af65-4cd139757aab",
                                        "entry_id": "e7dced2c-cfdd-3014-895b-b0a6a610e723",
                                        "glosses": [
                                            "nicht hinreichend gut, wenn man es mit dem Zustand vergleicht, der ausreichend oder sogar gut ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b303ebd-91fb-4325-8bcf-8058ef74694b",
                                                "sense_id": "0896210d-50fd-34b0-af65-4cd139757aab",
                                                "text": "„Die CDU-Vorsitzende Angela Merkel, der in der Partei schlechtes Krisenmanagement vorgeworfen wurde, ließ Meyer beschädigt zurück.“"
                                            },
                                            {
                                                "example_id": "f35042ed-401d-46cf-bbd2-4b512403c30a",
                                                "sense_id": "0896210d-50fd-34b0-af65-4cd139757aab",
                                                "text": "Das Kind ist ein schlechter Esser."
                                            },
                                            {
                                                "example_id": "456d9871-871f-4945-962a-297e61c6d032",
                                                "sense_id": "0896210d-50fd-34b0-af65-4cd139757aab",
                                                "text": "Die Großmutter hat schlechte Augen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6d9a1588-d014-331d-806e-3d36ef1dd9d2",
                                        "entry_id": "e7dced2c-cfdd-3014-895b-b0a6a610e723",
                                        "glosses": [
                                            "nicht mehr genießbar/anwendbar, etwa bei Lebensmitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e3dd98f-b0cd-4285-9100-e469a4244892",
                                                "sense_id": "6d9a1588-d014-331d-806e-3d36ef1dd9d2",
                                                "text": "Die Erdbeeren waren nicht im Kühlschrank, sie sind schlecht geworden."
                                            },
                                            {
                                                "example_id": "156c78a8-e49f-4304-ba63-01a2a5851c6c",
                                                "sense_id": "6d9a1588-d014-331d-806e-3d36ef1dd9d2",
                                                "text": "Die schlechten Kirschen musst du aussortieren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0311857e-cdac-340e-ae66-2ce0f66360ec",
                                        "entry_id": "e7dced2c-cfdd-3014-895b-b0a6a610e723",
                                        "glosses": [
                                            "moralisch nicht akzeptabel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e15ae2cb-be31-4fc2-b22f-813192848045",
                                                "sense_id": "0311857e-cdac-340e-ae66-2ce0f66360ec",
                                                "text": "Der Räuber war ein schlechter Mensch."
                                            },
                                            {
                                                "example_id": "b7e36fb7-59f1-4b57-a4bc-1e21160ced38",
                                                "sense_id": "0311857e-cdac-340e-ae66-2ce0f66360ec",
                                                "text": "Irgendwie war sie dort in schlechte Gesellschaft reingerutscht."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "ff9e5773-9f93-389d-8257-56214c454ad8",
                                        "entry_id": "e7dced2c-cfdd-3014-895b-b0a6a610e723",
                                        "glosses": [
                                            "sich unwohl oder krank fühlend"
                                        ],
                                        "tags": [
                                            "jemandem ist schlecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81d95646-c2f3-4e1c-af64-a8300189c9ec",
                                                "sense_id": "ff9e5773-9f93-389d-8257-56214c454ad8",
                                                "text": "Nach dem vielen Wein war mir gestern ganz schlecht."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "63c79b6c-e9e9-3c94-befc-8659daf4892c",
                                        "entry_id": "e7dced2c-cfdd-3014-895b-b0a6a610e723",
                                        "glosses": [
                                            "nicht so, dass es fördert und nützt, sondern so, dass es schadet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d2a7d71-0c1e-4711-9713-793c05ef216c",
                                                "sense_id": "63c79b6c-e9e9-3c94-befc-8659daf4892c",
                                                "text": "Diese Version des Videospiels hat in der Fachpresse schlechte Rezensionen bekommen."
                                            },
                                            {
                                                "example_id": "482276a8-2631-46ca-bf19-05de7621f888",
                                                "sense_id": "63c79b6c-e9e9-3c94-befc-8659daf4892c",
                                                "text": "Heute ist ein ganz schlechter Zeitpunkt, um ihn zu fragen. Er hat eine fürchterliche Laune."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "c5f362c1-c8a5-3d5e-931f-1dd7b4318f18",
