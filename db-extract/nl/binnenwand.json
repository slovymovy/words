                "senses": [
                    {
                        "sense_id": "c22e672f-ee20-34d8-ac70-443847620d4a",
                        "entry_id": "d1100c00-0928-367c-8d99-4421eba74aed",
                        "glosses": [
                            "verticaal oprijzend vlak aan de binnenkant van een ruimte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce91503c-667a-4cba-bca3-b33156780260",
                                "sense_id": "c22e672f-ee20-34d8-ac70-443847620d4a",
                                "text": "De lichte toets van de wand rechts beviel hem zeer, de hoge vensters met roze dagkanten, maar de overstaande binnenwand was meer naar de oude smaak, zwaarder."
                            },
                            {
                                "example_id": "3fca845d-2efe-4ba0-9781-bae360a7ed40",
                                "sense_id": "c22e672f-ee20-34d8-ac70-443847620d4a",
                                "text": "Boston-verdachte Dzjochar Tsarnajev heeft een boodschap achtergelaten op de binnenwand van de boot waarin hij zich verschuilde voor de politie, meldt de Amerikaanse nieuwszender CBS."
                            },
                            {
                                "example_id": "464c872f-fa12-428d-b4dc-828b3109d290",
                                "sense_id": "c22e672f-ee20-34d8-ac70-443847620d4a",
                                "text": "Van die zes patiënten leden er vier aan endocarditis, een ontsteking van de binnenwand van het hart of de hartkleppen, die maar zelden voorkomt. In Nederland krijgen jaarlijks ongeveer 250 mensen endocarditis. Maar een heel klein aantal van hen hebben Q-koorts."
                            }
                        ]
                    }
