                "senses": [
                    {
                        "sense_id": "a9a6eb25-b62b-3059-bcaf-be367e19c817",
                        "entry_id": "8d5a64e7-e102-32c8-9887-714259285cff",
                        "glosses": [
                            "Redonner un aspect pulpeux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40677d4d-c2ea-4fcd-bf8b-edf67f5ea6a8",
                                "sense_id": "a9a6eb25-b62b-3059-bcaf-be367e19c817",
                                "text": "Comment réduire les rides et repulper la peau ?"
                            },
                            {
                                "example_id": "76b5cbb3-add8-4548-b257-9fcebed24e15",
                                "sense_id": "a9a6eb25-b62b-3059-bcaf-be367e19c817",
                                "text": "Pour la garder dans son lit, à l'instar des producteurs d’Alerte à Malibu et Cie, son mari avait exigé qu'elle redressât son nez, ravalât sa façade, repulpât ses lèvres, retendît son ventre, remontât ses fesses et siliconât ses seins."
                            },
                            {
                                "example_id": "308acfd4-f2f2-44f3-91f3-0161cff0e640",
                                "sense_id": "a9a6eb25-b62b-3059-bcaf-be367e19c817",
                                "text": "« Faites confiance » à la technique de remaillage du visage aux fils d’or pour « retendre les traits affaissés », ou aux injections de graisse du fessier pour « repulper » le menton, autant d’opérations coûtant des milliers d’euros (10/12/2016)…"
                            }
                        ]
                    }
                ],
