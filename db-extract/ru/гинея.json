                "senses": [
                    {
                        "sense_id": "e13a3cd6-c856-3ca6-b5b5-598f10cd5089",
                        "entry_id": "17345c79-649e-3def-97c8-807614c9fa7b",
                        "glosses": [
                            "истор. старинная золотая монета в Англии (имела хождение в 1663—1817)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7bc7b31-9863-412f-938b-bae1f3777e33",
                                "sense_id": "e13a3cd6-c856-3ca6-b5b5-598f10cd5089",
                                "text": "Я не видал ещё никого в Лондоне, не успел взять денег у банкира, но успел слышать в Вестминстерском аббатстве Генделеву ораторию «Мессию», отдав за вход последнюю гинею свою."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a06595f-902d-49e6-b0ed-680238741575",
                        "source_entry_id": "17345c79-649e-3def-97c8-807614c9fa7b",
                        "source_sense_id": "e13a3cd6-c856-3ca6-b5b5-598f10cd5089",
                        "target_lang_word": "guinea",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guinea",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55120e4c-bd62-3028-8f1b-00011bb7194d",
                                        "entry_id": "637a7c56-ad72-3fb1-87b0-568a0ad637a0",
                                        "glosses": [
                                            "A gold coin originally worth twenty shillings; later (from 1717 until the adoption of decimal currency) standardised at a value of twenty-one shillings."
                                        ],
                                        "tags": [
                                            "British",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f47f61de-ca36-4323-98bf-cd45bbd1ab6e",
                                                "sense_id": "55120e4c-bd62-3028-8f1b-00011bb7194d",
                                                "text": "English, French, Spanish, Portuguese, Georges, and Louises, doubloons and double guineas and moidores and sequins, the pictures of all the kings of Europe for the last hundred years, strange Oriental pieces stamped with what looked like wisps of string or bits of spider's web, round pieces and square pieces, and pieces bored through the middle, as if to wear them round your neck—nearly every variety of money in the world must, I think, have found a place in that collection..."
                                            },
                                            {
                                                "example_id": "b1b4f51f-47c0-4fe9-b6ce-37849c0e3d35",
                                                "sense_id": "55120e4c-bd62-3028-8f1b-00011bb7194d",
                                                "text": "However, since there are 488 pages in all for a bargain price of a guinea one must not be too carping."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f19b5785-4930-3d4a-8fe7-017a9d2735ab",
                                        "entry_id": "637a7c56-ad72-3fb1-87b0-568a0ad637a0",
                                        "glosses": [
                                            "Synonym of guinea fowl."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eba2eee-30b0-4fce-9273-56cd318c201b",
                                                "sense_id": "f19b5785-4930-3d4a-8fe7-017a9d2735ab",
                                                "text": "The guineas peeped complainingly, the goslings waddled into all the puddles and came back to chill my skin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b0a86a4-ac8b-3d48-a503-9e1c2a2d5f7a",
                                        "entry_id": "637a7c56-ad72-3fb1-87b0-568a0ad637a0",
                                        "glosses": [
                                            "A person of Italian descent."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "ethnic",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80b9d0f0-dcae-4abf-af07-2e16b3d9c4a8",
                                                "sense_id": "3b0a86a4-ac8b-3d48-a503-9e1c2a2d5f7a",
                                                "text": "If I’m to tell the whole truth—and why not? I sure have the time!—I’ll have to start by saying I was born Richard Pinzetti, in New York’s Little Italy. My father was an Old World guinea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
