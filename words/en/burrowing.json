            "senses": [
                {
                    "sense_id": "d46a4bae-8564-389b-99ba-d5fa0c139858",
                    "sense_definition": "The act or result of digging a hole or tunnel in the ground for shelter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "digging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rabbit's <w>burrowing</w> created a complex network of tunnels beneath the garden.",
                            "target_lang_translations": {
                                "ru": "<w>Рытье</w> кролика создало сложную сеть туннелей под садом."
                            }
                        },
                        {
                            "text": "Scientists studied the <w>burrowing</w> of the small rodents to understand their habitat preferences.",
                            "target_lang_translations": {
                                "ru": "Ученые изучали <w>рытье</w> мелких грызунов, чтобы понять их предпочтения в среде обитания."
                            }
                        }
                    ],
                    "synonyms": [
                        "digging",
                        "tunneling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или результат выкапывания норы или туннеля в земле для укрытия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рытье",
                                "target_lang_sense_clarification": "процесс создания углублений или туннелей"
                            },
                            {
                                "target_lang_word": "норение",
                                "target_lang_sense_clarification": "специальный термин для процесса создания нор животными"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2daec0b7-70f3-3202-855d-735ad1df65e0",
                    "sense_definition": "Present participle and gerund of <w>burrow</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mole was <w>burrowing</w> deep into the soft earth to escape the heat.",
                            "target_lang_translations": {
                                "ru": "Крот <w>зарывался</w> глубоко в мягкую землю, чтобы спастись от жары."
                            }
                        },
                        {
                            "text": "We watched the crab <w>burrowing</w> into the wet sand on the beach.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как краб <w>зарывается</w> в мокрый песок на пляже."
                            }
                        }
                    ],
                    "synonyms": [
                        "digging",
                        "tunneling"
                    ],
                    "common_phrases": [
