    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae995f45-d9eb-391f-9f01-0d34619f120c",
                    "sense_definition": "Мелкие пятнышки или прыщики на коже или слизистых оболочках, возникающие при болезни.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "медицина",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После приема лекарства у ребенка появилась сильная <w>сыпь</w> на руках.",
                            "target_lang_translations": {
                                "en": "After taking the medicine, the child developed a severe <w>rash</w> on their hands."
                            }
                        },
                        {
                            "text": "Врач внимательно осмотрел <w>сыпь</w> на теле пациента и поставил диагноз.",
                            "target_lang_translations": {
                                "en": "The doctor carefully examined the <w>rash</w> on the patient's body and made a diagnosis."
                            }
                        }
                    ],
                    "common_phrases": [
                        "аллергическая сыпь",
                        "угревая сыпь"
                    ],
                    "target_lang_definitions": {
                        "en": "Small spots or pimples on the skin or mucous membranes that appear during an illness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rash",
                                "target_lang_sense_clarification": "An area of inflamed and irritated skin."
                            },
                            {
                                "target_lang_word": "eruption",
                                "target_lang_sense_clarification": "A skin condition or outbreak resulting in a rash."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72b72efd-e6ec-3261-8042-6f07bcba1747",
                    "sense_definition": "То, что было засыпано или высыпано куда-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "действие",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Всю <w>сыпь</w> из мешка переложили в большой ящик.",
                            "target_lang_translations": {
                                "en": "All the <w>spilled material</w> from the bag was moved into a large box."
                            }
                        },
                        {
                            "text": "Рабочие убрали <w>сыпь</w> песка с дороги после завершения ремонта.",
                            "target_lang_translations": {
                                "en": "The workers cleared the <w>pile</w> of sand from the road after the repairs were finished."
                            }
                        }
                    ],
                    "synonyms": [
                        "высыпь"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Material that has been poured or spilled somewhere."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spillage",
                                "target_lang_sense_clarification": "Material that has been accidentally spilled."
                            },
                            {
                                "target_lang_word": "pile",
                                "target_lang_sense_clarification": "A quantity of loose material gathered in one place."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c6c0f9f-2d22-30e2-b841-e009b19a08e9",
                    "sense_definition": "Рассыпанный типографский шрифт.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "типография",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На столе наборщика лежала <w>сыпь</w> из мелких металлических букв.",
                            "target_lang_translations": {
                                "en": "On the typesetter's table lay a <w>jumble of loose type</w> made of small metal letters."
                            }
                        },
                        {
                            "text": "Пришлось долго разбирать <w>сыпь</w> после падения ящика со шрифтом.",
                            "target_lang_translations": {
                                "en": "It took a long time to sort the <w>mixed-up type</w> after the box of font fell."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "профессиональный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Scattered or mixed-up printing type."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pi",
                                "target_lang_sense_clarification": "Printing term for mixed-up or jumbled type."
                            },
                            {
                                "target_lang_word": "loose type",
                                "target_lang_sense_clarification": "Printing characters that are not organized in a frame."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc2f0a09-c136-3846-8690-9f3ff5b078ef",
                    "sense_definition": "Форма второго лица единственного числа повелительного наклонения глагола <w>сыпать</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "действие",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Сыпь</w> сахар в чай, если он недостаточно сладкий.",
                            "target_lang_translations": {
                                "en": "<w>Pour</w> sugar into the tea if it is not sweet enough."
                            }
                        },
                        {
                            "text": "<w>Сыпь</w> корм птицам только в специальную кормушку.",
                            "target_lang_translations": {
                                "en": "<w>Sprinkle</w> the bird feed only into the special feeder."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "повелительное наклонение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb 'to pour' or 'to sprinkle'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pour",
                                "target_lang_sense_clarification": "To cause a substance to flow in a stream."
                            },
                            {
                                "target_lang_word": "sprinkle",
                                "target_lang_sense_clarification": "To scatter small particles over a surface."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}