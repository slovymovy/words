                "translations": [
                    {
                        "translation_id": "ad29241d-0675-4e57-aca6-20dece1ff7ee",
                        "source_entry_id": "1cdbd519-1475-3f7b-a1c9-97acd076f24a",
                        "source_sense_id": "1cc3c289-18c8-39cd-8beb-292e6677e25b",
                        "target_lang_word": "liver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14f7626f-49d0-3582-bee7-28141d5ee683",
                                        "entry_id": "dea8aa31-b394-3723-a6c6-b0c449e84b3d",
                                        "glosses": [
                                            "A large organ in the body that stores and metabolizes nutrients, destroys toxins and produces bile. It is responsible for thousands of biochemical reactions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c37b00d-d7c6-45e4-bff6-6fd9d5cef106",
                                                "sense_id": "14f7626f-49d0-3582-bee7-28141d5ee683",
                                                "text": "Steve Jobs is a famous liver transplant recipient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfeca577-eb43-3bf6-885a-b01cbb0b5622",
                                        "entry_id": "dea8aa31-b394-3723-a6c6-b0c449e84b3d",
                                        "glosses": [
                                            "This organ, as taken from animals used as food."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97ddd6a2-262e-4ffa-a194-650c240a1614",
                                                "sense_id": "bfeca577-eb43-3bf6-885a-b01cbb0b5622",
                                                "text": "I'd like some goose liver pate."
                                            },
                                            {
                                                "example_id": "f211f549-5e91-4a80-9b8d-2412f98efe54",
                                                "sense_id": "bfeca577-eb43-3bf6-885a-b01cbb0b5622",
                                                "text": "You could fry up some chicken livers for a tasty treat. — Nah, I don't like chicken liver."
                                            },
                                            {
                                                "example_id": "0554a65d-00bb-4f9b-82ea-5b1e1265707b",
                                                "sense_id": "bfeca577-eb43-3bf6-885a-b01cbb0b5622",
                                                "text": "\"I should think you've rocked the boat enough already by refusing to eat liver.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "535f5256-462b-3047-b4f8-b4c5ed6ed6b3",
                                        "entry_id": "dea8aa31-b394-3723-a6c6-b0c449e84b3d",
                                        "glosses": [
                                            "A dark brown colour, tinted with red and gray, like the colour of liver."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d61076da-29a1-3688-8b36-c17925f7650b",
                                        "entry_id": "dea8aa31-b394-3723-a6c6-b0c449e84b3d",
                                        "glosses": [
                                            "Any of various chemical compounds—particularly sulfides—thought to resemble livers in color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd4732b8-5e5f-4acd-afd6-eb78f3fb8828",
                                                "sense_id": "d61076da-29a1-3688-8b36-c17925f7650b",
                                                "text": "He gave his horse some liver of antimony."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "liver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "795d966d-a6df-3117-8a37-142720db65c8",
                                        "entry_id": "cdf15a3b-951a-3889-85c9-da3916741bd9",
                                        "glosses": [
                                            "Of the colour of liver (dark brown, tinted with red and gray)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca59ee70-06ee-40f2-ad05-64472f36f218",
                                                "sense_id": "795d966d-a6df-3117-8a37-142720db65c8",
                                                "text": "His friend Rothwell, who had the use of the best Laveracks for breeding purposes, wrote him that one of his puppies was liver and white."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "liver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e95512a-80ae-3354-b3cd-14d4d54cdd03",
                                        "entry_id": "8e979316-3c22-3178-b7bc-d764bfd7fc14",
                                        "glosses": [
                                            "Someone who lives (usually in a specified way)."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d999e1d-68fa-47a2-92aa-929b7a23d568",
                                                "sense_id": "5e95512a-80ae-3354-b3cd-14d4d54cdd03",
                                                "text": "Ephori of Sparta, hearing a dissolute liver propose a very beneficial advise unto the people, commaunded him to hold his peace, and desired an honest man to assume the invention of it unto himselfe and to propound it."
                                            },
                                            {
                                                "example_id": "f55a7bc5-2a34-4aed-a56b-a7cacba17bfb",
                                                "sense_id": "5e95512a-80ae-3354-b3cd-14d4d54cdd03",
                                                "text": "a wicked liver may be reclaimed, and prove an honest man[…]."
                                            },
                                            {
                                                "example_id": "65324381-028d-4f78-b0c5-3aeb0c791e43",
                                                "sense_id": "5e95512a-80ae-3354-b3cd-14d4d54cdd03",
                                                "text": "Try if life be worth the liver's care."
                                            },
                                            {
                                                "example_id": "63023135-6c43-42b2-bc40-f620e5ab0f2a",
                                                "sense_id": "5e95512a-80ae-3354-b3cd-14d4d54cdd03",
                                                "text": "[…] a stately speech; / Such as grave Livers do in Scotland use, / Religious men, who give to God and Man their dues."
                                            },
                                            {
                                                "example_id": "19033c0e-f7df-463c-aab9-7deef18676a9",
                                                "sense_id": "5e95512a-80ae-3354-b3cd-14d4d54cdd03",
                                                "text": "A great lover of the faith, a great defender of the faith, a great lover of life, great liver of life, great defender of life. And yet he plotted and planned over fifty murders, and carried each of one them out—if only on paper, and if only for our pleasure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c04c67db-4023-3335-a442-10e10fa1d2b7",
                                        "entry_id": "8e979316-3c22-3178-b7bc-d764bfd7fc14",
                                        "glosses": [
                                            "Someone who lives (usually in a specified way).",
                                            "Someone who is alive: one of the living."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65707a43-88c1-49e6-837c-23f731f3888e",
                                                "sense_id": "c04c67db-4023-3335-a442-10e10fa1d2b7",
                                                "text": "When as the wandring Scots and Picthts King Marius had subdude, He gave the Liuers dwellings."
                                            },
                                            {
                                                "example_id": "312f6835-118c-4dee-8b1c-9d0de01a5c30",
                                                "sense_id": "c04c67db-4023-3335-a442-10e10fa1d2b7",
                                                "text": "Thou king of heaven, which […] Dost see the secret of each livers heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52cd497f-38d5-3eb6-b86b-8d93f6181be8",
                                        "entry_id": "8e979316-3c22-3178-b7bc-d764bfd7fc14",
                                        "glosses": [
                                            "Someone who lives (usually in a specified way).",
                                            "Someone who lives in a particular place; an inhabitant, a dweller."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3731aa5-cfe4-4dd6-b6c2-10518f931b8c",
                                                "sense_id": "52cd497f-38d5-3eb6-b86b-8d93f6181be8",
                                                "text": "They must instantly have been detected by the present Livers that were upon the place."
                                            },
                                            {
                                                "example_id": "b5c227cc-7ef6-4782-9ee3-159cce7f3fa6",
                                                "sense_id": "52cd497f-38d5-3eb6-b86b-8d93f6181be8",
                                                "text": "One, John Powle, a Liver on Sasquehanna River."
                                            },
                                            {
                                                "example_id": "4e3a18a1-4721-45c5-9f68-9d007b834214",
                                                "sense_id": "52cd497f-38d5-3eb6-b86b-8d93f6181be8",
                                                "text": "There is no liver in the country so practical."
                                            }
                                        ]
                                    }
                                ]
                            },
