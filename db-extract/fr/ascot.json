                    {
                        "sense_id": "b2a92e56-5514-3629-9e13-83f576d09378",
                        "entry_id": "15164a3c-4aa8-3a91-a5b1-b3b50466fcbd",
                        "glosses": [
                            "Sorte de double cravate courte et large."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c4fb235-af09-42e3-a9a6-a4ab1db9e139",
                                "sense_id": "b2a92e56-5514-3629-9e13-83f576d09378",
                                "text": "Il porte un costume avec un pantalon rayé, un ascot gris, et un veston sport, ce qui ne passe pas inaperçu."
                            },
                            {
                                "example_id": "a477171c-0310-4b4d-8c47-64cedc8152f6",
                                "sense_id": "b2a92e56-5514-3629-9e13-83f576d09378",
                                "text": "Vêtus de leurs pantalons bouffants, maintenus par de fines bretelles, et de leurs chemises blanches, parsemées de pois d’or et surmontées d’un ascot rouge vif, ils portaient le chapeau pointu et les escarpins d’apparat."
                            }
                        ]
                    }
