                        "glosses": [
                            "Se trier tout seul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76e4104c-cdfa-425c-926e-f9f5890acb73",
                                "sense_id": "547a2280-04d3-3706-908f-bb4b90084b08",
                                "text": "Heureusement que ceux qui viennent sur Eugénol s'auto-trient..."
                            },
                            {
                                "example_id": "df372d24-56f2-4a6d-93d4-fe43878740d9",
                                "sense_id": "547a2280-04d3-3706-908f-bb4b90084b08",
                                "text": "Je me limite aux urgences : les bibs qui ne se lavent pas tous seuls (dommage), la lessive qui ne se met pas toute seule dans la machine (comment ça, vos linges savent s’auto-trier ?) et la vaisselle qui ni rentre ni sort du lave-vaisselle toute seule (espèce d’êtres primitifs, va ! Ils sont où ceux de La Belle et la Bête ?)."
                            },
                            {
                                "example_id": "dbf2e67d-a875-4c43-ac0c-9243a0c493c9",
                                "sense_id": "547a2280-04d3-3706-908f-bb4b90084b08",
                                "text": "Il faudra qu'on s'auto-trie!!"
                            }
                        ]
                    }
