                "senses": [
                    {
                        "sense_id": "f44a396a-580d-3b3f-a62a-cde0f00f7174",
                        "entry_id": "5a2d10be-7b6c-30ea-984e-a86c1ec009db",
                        "glosses": [
                            "einzelne Kapelle oder Separee in einem Gebäude, das einem Kaiser geweiht wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ce72ede-cafd-4f85-8a2a-a121707bc504",
                                "sense_id": "f44a396a-580d-3b3f-a62a-cde0f00f7174",
                                "text": "„Der obere Teil der Doppelkapelle, die sogenannte Kaiserkapelle, hat für die Romanik sehr ungewöhnliche Proportionen.“"
                            },
                            {
                                "example_id": "79261ffe-ff82-4174-bbab-01aac63f6b4c",
                                "sense_id": "f44a396a-580d-3b3f-a62a-cde0f00f7174",
                                "text": "„Hierbei wurde deutlich, dass sich der Marienaltar in der Südlichen Kaiserkapelle und der Johannesaltar in der Schnewlin-kapelle in keinem guten Zustand befanden und deshalb dringend zur Restaurierung anstanden.“"
                            },
                            {
                                "example_id": "db0253bf-4425-4baa-a654-e809117e1199",
                                "sense_id": "f44a396a-580d-3b3f-a62a-cde0f00f7174",
                                "text": "„DER MARIENALTAR in der südlichen Kaiserkapelle des Freiburger Münsters soll restauriert werden.“"
                            },
                            {
                                "example_id": "7d5a4eb2-15fc-4e99-a091-fbfa4f29d7b9",
                                "sense_id": "f44a396a-580d-3b3f-a62a-cde0f00f7174",
                                "text": "„Im 18. Jahrhundert wurde der kleine Portalvorbau ausgeführt und die Kaiserkapelle neu ausgestattet.“"
                            },
                            {
                                "example_id": "e5c5501a-f1f4-4cc5-a85a-e3a7d4aa4b10",
                                "sense_id": "f44a396a-580d-3b3f-a62a-cde0f00f7174",
                                "text": "„Zusammenfassend lässt sich daher ohne genaue Grabungsauswertung schon jetzt festhalten, dass es in den ersten zehn Jahren nach der Bistumsgründung auf dem Domhügel mindestens fünf Steinbauten und einen ersten Friedhof vor der Kaiserkapelle und einen Friedhof südlich neben dem Gunthardom gegeben hat: die Kaiserkapelle selbst, die karolingische Befestigungsmauer um die Domburg, zwei profane Wohngebäude und der erste Dom für das Chorgebet und die Gottesdienste des sich gründenden Domkapitels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
