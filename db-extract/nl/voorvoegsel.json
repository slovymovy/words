                    {
                        "sense_id": "6ddde94a-52fe-3593-a140-40e96368b542",
                        "entry_id": "69677ffc-9bd1-338e-9599-076f00f524f6",
                        "glosses": [
                            "een gebonden morfeem dat voor een ander woord geplaatst wordt om iets aan de betekenis toe te voegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c9073c-8163-4437-bdb9-fd58cf374fc3",
                                "sense_id": "6ddde94a-52fe-3593-a140-40e96368b542",
                                "text": "Tot die laatste categorie behoorde luitenant D'Aulnay-Pradelle. Iedereen die het over hem had, liet de voornaam, het adellijk voorvoegsel, het Aulnay' en het verbindingsstreepje achterwege en zei gewoon `Pradelle, omdat bekend was dat hij daar pisnijdig om werd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98739fcd-3f3e-42c6-bfd6-1b6ce94d4843",
                        "source_entry_id": "69677ffc-9bd1-338e-9599-076f00f524f6",
                        "source_sense_id": "6ddde94a-52fe-3593-a140-40e96368b542",
                        "source_sense_description": "een gebonden morfeem dat voor een ander woord geplaatst wordt om iets aan de betekenis toe te voegen",
                        "target_lang_word": "Vorsilbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorsilbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f8727df-82b5-3d44-bdee-f0f34f35f2a9",
                                        "entry_id": "8c5b5ac1-d918-3e24-86ec-71dc19089158",
                                        "glosses": [
                                            "Silbe, die vor dem Wortstamm steht; Synonym zu Präfix"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b0e82f2-b206-401e-b3db-c7e77c6ee57e",
                                                "sense_id": "3f8727df-82b5-3d44-bdee-f0f34f35f2a9",
                                                "text": "In dem Wort Vorsilbe ist „vor-“ die Vorsilbe."
                                            },
                                            {
                                                "example_id": "f6c10ffd-c70f-4741-bd11-052e781e686d",
                                                "sense_id": "3f8727df-82b5-3d44-bdee-f0f34f35f2a9",
                                                "text": "Vorsilben dienen der Ableitung von Wörtern."
                                            },
                                            {
                                                "example_id": "10d87eda-6483-447e-89b1-c971ce1b8dc3",
                                                "sense_id": "3f8727df-82b5-3d44-bdee-f0f34f35f2a9",
                                                "text": "„Ableitungen nennen wir Wörter, die aus einem vorhandenen Wort und einer Vor- und Nachsilbe bestehen (…).“"
                                            },
                                            {
                                                "example_id": "883afd25-38dc-462b-9050-c5d3caaa4c83",
                                                "sense_id": "3f8727df-82b5-3d44-bdee-f0f34f35f2a9",
                                                "text": "„Soweit die Vokale der Vorsilben vor dem Wortakzent stehen, unterliegen sie bereits in althochdeutscher Zeit der Reduzierung.“"
                                            },
                                            {
                                                "example_id": "c5b40549-d099-4217-823e-d356aa394cdc",
                                                "sense_id": "3f8727df-82b5-3d44-bdee-f0f34f35f2a9",
                                                "text": "„Zunächst erfährt die Vielfalt der Vorsilben eine Vereinfachung…“"
                                            },
                                            {
                                                "example_id": "ecb8de3a-66dc-4cc9-9e44-44ac52d1ca92",
                                                "sense_id": "3f8727df-82b5-3d44-bdee-f0f34f35f2a9",
                                                "text": "„Sie nehmen deutsche Wörter, setzen polnische Vorsilben an den Anfang und polnische Endungen an das Ende.“"
                                            },
                                            {
                                                "example_id": "9172b134-ba48-4563-99ef-5c453fafef4f",
                                                "sense_id": "3f8727df-82b5-3d44-bdee-f0f34f35f2a9",
                                                "text": "„Das Andauern einer Handlung, ihre Intensität, ihre Abgeschlossenheit oder ihr Anfang ( so genannte Aktionsarten) können durch besondere Präfixe (Vorsilben) bezeichnet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee0a1111-171c-4aa4-95d6-3e3b9c35ac64",
                        "source_entry_id": "69677ffc-9bd1-338e-9599-076f00f524f6",
                        "source_sense_id": "6ddde94a-52fe-3593-a140-40e96368b542",
                        "source_sense_description": "een gebonden morfeem dat voor een ander woord geplaatst wordt om iets aan de betekenis toe te voegen",
                        "target_lang_word": "prefix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prefix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c88a56d-0e5d-3034-a005-b797676790b0",
                                        "entry_id": "f43e276d-2a78-3cbd-91dc-a8d4453e29ac",
                                        "glosses": [
                                            "Something placed before another",
                                            "A morpheme added to the beginning of a word to modify its meaning, for example as, pre- in prefix, con- in conjure, re- in reheat, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de3cb495-9e22-440c-86e0-017fad65eae0",
                                                "sense_id": "3c88a56d-0e5d-3034-a005-b797676790b0",
                                                "text": "The chosen prefixes won the vote in part because they start with the only two letters left in the alphabet that are not already used in measurement. The b for “bronto” is already used for bytes and h for “hella” is used for hecto, the prefix for 100."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79f8410f-7a4b-350f-860a-efc615136d7d",
                                        "entry_id": "f43e276d-2a78-3cbd-91dc-a8d4453e29ac",
                                        "glosses": [
                                            "Something placed before another",
                                            "A set of digits placed before a telephone number, to indicate where the number is based, what type of phone number it is (landline, mobile, toll-free, premium rate etc.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12ad648d-67cc-4de2-86ce-78e5a527b9a4",
                                                "sense_id": "79f8410f-7a4b-350f-860a-efc615136d7d",
                                                "text": "in the UK, a number with an 0800 prefix is a toll-free number."
                                            },
                                            {
                                                "example_id": "ae0dfab5-e4d7-4b9d-b2a3-b9d0231ba85e",
                                                "sense_id": "79f8410f-7a4b-350f-860a-efc615136d7d",
                                                "text": "Add the prefix +34 to dial a Spanish number from abroad"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "221b3bca-09f7-387c-a6b8-ba3c238b1d20",
                                        "entry_id": "f43e276d-2a78-3cbd-91dc-a8d4453e29ac",
                                        "glosses": [
                                            "Something placed before another",
                                            "A title added to a person's name, such as Mr. or Dr."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5babd5e8-d62d-373e-911c-d8ac02425c32",
                                        "entry_id": "f43e276d-2a78-3cbd-91dc-a8d4453e29ac",
                                        "glosses": [
                                            "Something placed before another",
                                            "An initial segment of a string of characters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ebfec3-4ffb-451c-b44a-9a6864ff22e9",
                                                "sense_id": "5babd5e8-d62d-373e-911c-d8ac02425c32",
                                                "text": "The string \"abra\" is both a prefix and a suffix of the string \"abracadabra\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prefix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3dd8fef-9d24-3e00-9f3b-c9a00488a33a",
                                        "entry_id": "b2c68435-7cd3-3a2e-ae34-c49267278437",
                                        "glosses": [
                                            "To determine beforehand; to set in advance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4bbf093-a702-417d-ad3e-8aac945065ae",
                                                "sense_id": "a3dd8fef-9d24-3e00-9f3b-c9a00488a33a",
                                                "text": "But the danger was, that a man can hardly prefix any certaine limits unto his desire[…]."
                                            },
                                            {
                                                "example_id": "a05f53b2-83b9-46bf-add4-f2710ce4f97e",
                                                "sense_id": "a3dd8fef-9d24-3e00-9f3b-c9a00488a33a",
                                                "text": "It is important to realize that pregivenness or prefixing is a kind of anteriority that does its work in the present; subjects and meanings in part emerge in enuciative co-constitutive moments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0ec6c1e-72a1-343d-aa3c-f9d57a72f72f",
                                        "entry_id": "b2c68435-7cd3-3a2e-ae34-c49267278437",
                                        "glosses": [
                                            "To put or fix before, or at the beginning of something; to place at the start."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
