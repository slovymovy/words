                            }
                        },
                        {
                            "text": "Hij <w>remde</w> de wagen voorzichtig <w>af</w> toen hij de bocht naderde.",
                            "target_lang_translations": {
                                "en": "He carefully <w>slowed</w> the car <w>down</w> as he approached the bend."
                            }
