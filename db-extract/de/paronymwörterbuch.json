                "senses": [
                    {
                        "sense_id": "040ff41a-56c6-37db-a566-0519d5918f34",
                        "entry_id": "cbf0ccc0-0edb-3239-9082-d1a0960e6a0a",
                        "glosses": [
                            "Linguistik: Wörterbuch, in dem Paronyme zusammengestellt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79e21b46-883a-4f35-97b6-4cae4a45c2ac",
                                "sense_id": "040ff41a-56c6-37db-a566-0519d5918f34",
                                "text": "„Erstens soll mit einem auf Korpusbasis erarbeiteten Paronymwörterbuch eine lexikografische Lücke gefüllt werden.“"
                            },
                            {
                                "example_id": "c75a4e8a-e00a-4599-8a64-22c48010773f",
                                "sense_id": "040ff41a-56c6-37db-a566-0519d5918f34",
                                "text": "„Gleichzeitig wird damit in gewisser Weise auch die Traditionslinie angedeutet, in der das Paronymwörterbuch zu verorten ist.“"
                            },
                            {
                                "example_id": "e894b7bc-04f4-4cfc-a0f1-dba5dabb9e3b",
                                "sense_id": "040ff41a-56c6-37db-a566-0519d5918f34",
                                "text": "„Das Paronymwörterbuch ist ein Onlinewörterbuch, das die korpusbasierte Verwendung lexikalischer Ausdrücke dokumentiert, die aufgrund ausdrucksbedingter und semantischer Ähnlichkeiten im Sprachgebrauch verwechselt werden.“"
                            },
                            {
                                "example_id": "11cb90ee-e828-4d89-9abb-126d3141ff3f",
                                "sense_id": "040ff41a-56c6-37db-a566-0519d5918f34",
                                "text": "„Ein kleines Paronymwörterbuch hat Constantinescu 1976 vorgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
