                                        "glosses": [
                                            "Scherbe eines Tongefäßes, auf der kurze Notizen gemacht wurden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8d29810-63fe-4172-8321-6caa36887a8d",
                                                "sense_id": "caf264ef-fbbd-336c-8095-26bd8db4a7b1",
                                                "text": "„Bis auf das demotische Ostrakon aus Leiden und das Berliner Ostrakon, die beide der römischen Zeit zuzuordnen sind, entstammen sämtliche Stücke dem Neuen Reich (18.–20. Dynastie, 1550-1070 v.Chr.).“"
                                            }
