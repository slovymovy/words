                                        "sense_id": "d5b49381-0f8f-3a95-8422-b416f26b968c",
                                        "entry_id": "70430b20-7c0d-3cb4-9d2f-b6ba6e52db77",
                                        "glosses": [
                                            "One who lends, especially money; specifically, a bank or other entity that specializes in granting loans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddfa1ae9-cc9b-437a-b09c-43a986ade09f",
                                                "sense_id": "d5b49381-0f8f-3a95-8422-b416f26b968c",
                                                "text": "[Polonius]: Neither a borrower nor a lender be:\nFor loan oft loses both itself and friend;\nAnd borrowing dulls the edge of husbandry."
                                            },
                                            {
                                                "example_id": "c34b2921-734b-4fa8-94ce-d4dc7bf85555",
                                                "sense_id": "d5b49381-0f8f-3a95-8422-b416f26b968c",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms. Those that want to borrow are matched with those that want to lend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
