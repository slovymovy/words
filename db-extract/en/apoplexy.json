                                                "example_id": "3f9204b7-6596-43e5-969e-2f0ed9f9c0b8",
                                                "sense_id": "cb364e36-9869-3149-b79d-758ba587f945",
                                                "text": "Man versuchte, die Hauptursache für die Apoplexie der Aprikosenbäume zu ergründen."
                                            }
