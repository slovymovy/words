                ],
                "senses": [
                    {
                        "sense_id": "5d1a96f6-b81b-3a5a-911f-b96704ce22b9",
                        "entry_id": "28bd60a6-99ff-3cb2-9b1d-407a8fa1b736",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7efb1cc7-a281-469c-a099-f404be395014",
                                "sense_id": "5d1a96f6-b81b-3a5a-911f-b96704ce22b9",
                                "text": "Frau Schmittle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6b26640a-efe3-440e-9a61-60ab3fe27d85",
                                "sense_id": "5d1a96f6-b81b-3a5a-911f-b96704ce22b9",
                                "text": "Herr Schmittle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2c69d7f5-8144-4ca0-a8df-3a4de022b238",
                                "sense_id": "5d1a96f6-b81b-3a5a-911f-b96704ce22b9",
                                "text": "Die Schmittles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "c9c7d427-ec6a-4704-a213-ea19109b8046",
                                "sense_id": "5d1a96f6-b81b-3a5a-911f-b96704ce22b9",
                                "text": "Der Schmittle trägt nie die Pullover, die die Schmittle ihm strickt."
                            },
                            {
                                "example_id": "ac40f571-ba18-498a-a170-b1e4768fc502",
                                "sense_id": "5d1a96f6-b81b-3a5a-911f-b96704ce22b9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schmittle kommt, geht der Herr Schmittle.“"
                            },
                            {
                                "example_id": "be2dbfa9-77e9-4619-aabd-18b58eb8cd2c",
                                "sense_id": "5d1a96f6-b81b-3a5a-911f-b96704ce22b9",
                                "text": "Schmittle kommt und geht."
                            },
                            {
                                "example_id": "49984c8c-0b16-41be-a50a-815d093067b9",
                                "sense_id": "5d1a96f6-b81b-3a5a-911f-b96704ce22b9",
                                "text": "Schmittles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
