                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er schaltete den <w>Fernseher</w> ein, um die Nachrichten zu sehen.",
                            "target_lang_translations": {
                                "en": "He turned on the <w>television</w> to watch the news.",
                                "ru": "Он включил <w>телевизор</w>, чтобы посмотреть новости.",
                                "nl": "Hij zette de <w>televisie</w> aan om naar het nieuws te kijken.",
                                "pl": "Włączył <w>telewizor</w>, aby obejrzeć wiadomości.",
                                "fr": "Il alluma la <w>télévision</w> pour regarder les informations.",
                                "it": "Ha acceso il <w>televisore</w> per guardare il telegiornale.",
                                "cs": "Zapnul <w>televizi</w>, aby se podíval na zprávy.",
                                "tr": "Haberleri izlemek için <w>televizyonu</w> açtı.",
                                "es": "Encendió el <w>televisor</w> para ver las noticias.",
                                "zh": "他打开<w>电视</w>看新闻。"
                            }
                        },
                        {
                            "text": "Mach bitte den <w>Fernseher</w> aus, wenn du ins Bett gehst.",
                            "target_lang_translations": {
                                "en": "Please turn off the <w>TV</w> when you go to bed.",
                                "ru": "Пожалуйста, выключи <w>телевизор</w>, когда пойдёшь спать.",
                                "nl": "Doe alsjeblieft de <w>televisie</w> uit als je naar bed gaat.",
                                "pl": "Wyłącz proszę <w>telewizor</w>, kiedy pójdziesz spać.",
                                "fr": "Éteins la <w>télévision</w>, s'il te plaît, quand tu vas te coucher.",
                                "it": "Spegni la <w>televisione</w>, per favore, quando vai a letto.",
                                "cs": "Vypni prosím <w>televizi</w>, až půjdeš spát.",
                                "tr": "Yatağa gittiğinde lütfen <w>televizyonu</w> kapat.",
                                "es": "Apaga el <w>televisor</w>, por favor, cuando te vayas a la cama.",
                                "zh": "你去睡觉时，请把<w>电视机</w>关掉。"
                            }
                        }
