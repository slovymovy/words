                        "sense_id": "dd85e457-6999-3283-8ae5-5ca97d61a011",
                        "entry_id": "59b35799-67ee-3133-a57c-7cdcb7c1078c",
                        "glosses": [
                            "(Domaine ferroviaire) Action de placer un engin ferroviaire dans le sens le plus propice à la bonne marche."
                        ],
                        "tags": [],
                        "examples": []
                    }
