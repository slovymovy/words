                    {
                        "translation_id": "e70b142e-59ee-464a-9079-e95caa0e27ae",
                        "source_entry_id": "6ff4b442-6bab-3184-9658-0fdb08bb7472",
                        "source_sense_description": "spontaneous behaviour",
                        "target_lang_word": "Laune",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laune",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f7ba55f-2677-308b-a542-be3b3b95140a",
                                        "entry_id": "1dda765a-4f4a-3b18-9b58-9efaaf2449b7",
                                        "glosses": [
                                            "Gemütszustand; wie sich jemand fühlt oder worauf jemand gerade Lust hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40241dfe-e079-4e67-8d24-cee1bb24452a",
                                                "sense_id": "5f7ba55f-2677-308b-a542-be3b3b95140a",
                                                "text": "Ich habe schlechte Laune."
                                            },
                                            {
                                                "example_id": "5c68fef6-7328-4b9a-a351-382dd66fea48",
                                                "sense_id": "5f7ba55f-2677-308b-a542-be3b3b95140a",
                                                "text": "„Mit russischer Laune und den Überresten sibirischer Wurst in meinem Körper ziehe ich also mit Sara los, um Menschen kennenzulernen, die uns nicht kennenlernen wollen.“"
                                            },
                                            {
                                                "example_id": "fc1ea38f-7813-4a17-921f-58d301fd9037",
                                                "sense_id": "5f7ba55f-2677-308b-a542-be3b3b95140a",
                                                "text": "„Jetzt, nach seinem Vormittagsschlaf, war der Alte besonders guter Laune.“"
                                            },
                                            {
                                                "example_id": "5371311b-7900-4680-b79f-17b84db23af3",
                                                "sense_id": "5f7ba55f-2677-308b-a542-be3b3b95140a",
                                                "text": "„Als er von mir gehört hatte, ich ginge nur um einer verliebten Laune willen nach Neapel, beschwor er mich, einen Monat bei ihm zu verbringen und ihm zuliebe meine Laune zu opfern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0ea3a4c1-186b-30e1-8726-450d42039c63",
                                        "entry_id": "1dda765a-4f4a-3b18-9b58-9efaaf2449b7",
                                        "glosses": [
                                            "spontaner Gefühlsausbruch"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6e3dae7-48c3-4172-9ca5-2fb84f0ed576",
                                                "sense_id": "0ea3a4c1-186b-30e1-8726-450d42039c63",
                                                "text": "Sie hat wieder eine ihrer Launen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a29440fc-6d1a-3633-994b-90b64d40fa6d",
                                        "entry_id": "1dda765a-4f4a-3b18-9b58-9efaaf2449b7",
                                        "glosses": [
                                            "unerwartete oder unkonventionelle Eigenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abdb8efb-bc41-449a-b548-7f2a72ad58fb",
                                                "sense_id": "a29440fc-6d1a-3633-994b-90b64d40fa6d",
                                                "text": "Mit seinen Launen befremdete er stets seine Gäste."
                                            },
                                            {
                                                "example_id": "2f97426d-3ac2-4b1d-8d6d-b2007512534e",
                                                "sense_id": "a29440fc-6d1a-3633-994b-90b64d40fa6d",
                                                "text": "„Sophies mürrische Laune verflüchtigte sich hin und wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
