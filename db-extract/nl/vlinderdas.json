                "translations": [
                    {
                        "translation_id": "c0a79a66-70e5-4f35-bd2d-a6b640293fe3",
                        "source_entry_id": "52fa2c45-b6c4-3565-ad75-f9afe35d3fd2",
                        "source_sense_id": "a6d136ee-c005-3a0d-877c-09c8ba3e3c6f",
                        "target_lang_word": "Fliege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fliege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "644ad1e7-592e-362b-bf8b-39a3b00dc737",
                                        "entry_id": "bd215552-c7c2-356f-a918-65993ea1165d",
                                        "glosses": [
                                            "fliegendes Insekt der Unterordnung Fliegen (Brachycera)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "000ae2a8-cf6c-475a-90f0-833eddb69462",
                                                "sense_id": "644ad1e7-592e-362b-bf8b-39a3b00dc737",
                                                "text": "Wenn hinter Fliegen Fliegen fliegen, fliegen Fliegen Fliegen nach."
                                            },
                                            {
                                                "example_id": "7fa7c602-e3d6-4a93-8e6d-2f460f051756",
                                                "sense_id": "644ad1e7-592e-362b-bf8b-39a3b00dc737",
                                                "text": "„Die Beisitzer sitzen bei, der eine schreibt an einem Bericht in einer anderen Sache, der zweite beobachtet das Treiben einer Fliege auf dem Tintenfaß.“"
                                            },
                                            {
                                                "example_id": "af25b30a-60b6-4bcb-9ecd-0072b26585d2",
                                                "sense_id": "644ad1e7-592e-362b-bf8b-39a3b00dc737",
                                                "text": "„Eine Fliege krabbelte über die Schreibtischplatte.“"
                                            },
                                            {
                                                "example_id": "cf600286-529f-4a20-bc73-330fb69d5c7d",
                                                "sense_id": "644ad1e7-592e-362b-bf8b-39a3b00dc737",
                                                "text": "„Und der Geruch aus seinen Wunden lockte zahllose Fliegen herbei.“"
                                            },
                                            {
                                                "example_id": "efd91eb8-e32a-4072-85af-887df95439e7",
                                                "sense_id": "644ad1e7-592e-362b-bf8b-39a3b00dc737",
                                                "text": "„In der Zwischenzeit lungerte er im Schatten herum, schnappte Fliegen und Käfer auf dem Dach der Hütte, die Walt ihm gebaut hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa1b773c-cd9e-38d9-bfdb-68b0e1f579a8",
                                        "entry_id": "bd215552-c7c2-356f-a918-65993ea1165d",
                                        "glosses": [
                                            "Kleidungsstück, das überwiegend von Männern um den Hals getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77a78dad-db22-4cf5-bf3d-d46a46936d77",
                                                "sense_id": "fa1b773c-cd9e-38d9-bfdb-68b0e1f579a8",
                                                "text": "Heinz Riesenhuber, MdB, ist bekannt als der Mann mit der Fliege."
                                            },
                                            {
                                                "example_id": "059c8a00-0293-490a-a4ea-720696473bdc",
                                                "sense_id": "fa1b773c-cd9e-38d9-bfdb-68b0e1f579a8",
                                                "text": "„Papa kauft sich weder Fliegen noch Krawatten, alle Fliegen und Krawatten hat Mama für Papa gekauft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "61c1cac3-7491-36cd-a616-274a7b5bb967",
                                        "entry_id": "bd215552-c7c2-356f-a918-65993ea1165d",
                                        "glosses": [
                                            "kleiner Bart auf der Oberlippe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de7da65-0727-44a2-8a72-120a56b73d84",
                                                "sense_id": "61c1cac3-7491-36cd-a616-274a7b5bb967",
                                                "text": "Die Fliege erlangte als „Hitlerbärtchen“ traurige Berühmtheit."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "393dfa81-b96d-3e5a-b64e-ff7b739007af",
                                        "entry_id": "bd215552-c7c2-356f-a918-65993ea1165d",
                                        "glosses": [
                                            "künstlicher Angelköder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "646b748e-69f7-4089-a142-b6729d9b0fe3",
                                                "sense_id": "393dfa81-b96d-3e5a-b64e-ff7b739007af",
                                                "text": "Das Binden von Fliegen stellt in Fliegenfischerkreisen ein eigenständiges und zeitintensives zusätzliches Hobby dar."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "091b46aa-ce89-3396-bb32-75a7a5ebd5c2",
                                        "entry_id": "bd215552-c7c2-356f-a918-65993ea1165d",
                                        "glosses": [
                                            "verschiedene fliegende Insekten"
                                        ],
                                        "tags": [
                                            "in Zusammensetzungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efac1a44-5dab-4fcf-9534-bb92f0ebe7ab",
                                                "sense_id": "091b46aa-ce89-3396-bb32-75a7a5ebd5c2",
                                                "text": "Die Spanische Fliege ist eigentlich ein Käfer."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
