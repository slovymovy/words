                        "sense_id": "ee7a85da-def1-33c5-8dc3-06d213d40f29",
                        "entry_id": "23711b22-d576-37b7-9b22-47155e809788",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord temperatuur"
                        ],
                        "tags": [
                            "form-of",
