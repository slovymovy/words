                ],
                "senses": [
                    {
                        "sense_id": "0da2a8c4-c56e-3221-8f29-ae8e493a5650",
                        "entry_id": "2b214d6b-9dd8-327b-b98f-d8bd009d944d",
                        "glosses": [
                            "свойство по значению прилагательного божественный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c1606d9-9b0c-4381-bf76-018eed751cdb",
                                "sense_id": "0da2a8c4-c56e-3221-8f29-ae8e493a5650",
                                "text": "В самом деле, пока ефесеяне были уверены в божественности Артемиды, они без нарушения закона совести не могли спокойно слушать хулы на неё."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5439e18d-4a80-4d0b-ac1c-97e33a4b3f86",
                        "source_entry_id": "2b214d6b-9dd8-327b-b98f-d8bd009d944d",
                        "source_sense_id": "0da2a8c4-c56e-3221-8f29-ae8e493a5650",
                        "target_lang_word": "deity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2d532ec-02d0-3b06-9091-453ea7454590",
                                        "entry_id": "c1ff945e-a69b-3e8c-9a28-add5831fb359",
                                        "glosses": [
                                            "Synonym of divinity: the state, position, or fact of being a god."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7a7167a-92bf-4386-99e8-462938656557",
                                                "sense_id": "e2d532ec-02d0-3b06-9091-453ea7454590",
                                                "text": "Thou seest all, yet none at all sees thee: / All that is by the working of thy Deitee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c567694-dbdf-360a-861c-5a94f8f208d3",
                                        "entry_id": "c1ff945e-a69b-3e8c-9a28-add5831fb359",
                                        "glosses": [
                                            "A supernatural divine being; a god or goddess."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44dafd62-c29e-4f06-aa09-e72e947c3cef",
                                                "sense_id": "6c567694-dbdf-360a-861c-5a94f8f208d3",
                                                "text": "The fact that in most lands the moon was originally a female deity has led many historians to dispute the superiority of the moon over the sun in ancient mythology."
                                            },
                                            {
                                                "example_id": "76181e68-1833-40b1-876f-79812cac767d",
                                                "sense_id": "6c567694-dbdf-360a-861c-5a94f8f208d3",
                                                "text": "Every act of a Roman, from birth to death, from dawn to night, was controlled and supervised by some presiding deity."
                                            },
                                            {
                                                "example_id": "77d1e89a-d7c5-47b5-9b34-705d8958d319",
                                                "sense_id": "6c567694-dbdf-360a-861c-5a94f8f208d3",
                                                "text": "The crux of monotheism is not only belief in a single deity but belief in a deity who is different from everything else."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7db118d1-0e0b-459d-b1af-54b5e14b48dc",
                        "source_entry_id": "2b214d6b-9dd8-327b-b98f-d8bd009d944d",
                        "source_sense_id": "0da2a8c4-c56e-3221-8f29-ae8e493a5650",
                        "target_lang_word": "divinity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "divinity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bc0f58e-df09-3fe0-8d61-0186b4467271",
                                        "entry_id": "768dc9e1-e2cd-39fd-b48b-1f01802d6b35",
                                        "glosses": [
                                            "The state, position, or fact of being a god or God."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85831736-9504-471c-b0cc-1f9e030ffbad",
                                                "sense_id": "6bc0f58e-df09-3fe0-8d61-0186b4467271",
                                                "text": "They say there is divinity in odd numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44efbe56-791d-3d42-8827-8df25e25380d",
                                        "entry_id": "768dc9e1-e2cd-39fd-b48b-1f01802d6b35",
                                        "glosses": [
                                            "Synonym of deity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f6ff615-da44-47a1-a16a-643b9e382a2a",
                                                "sense_id": "44efbe56-791d-3d42-8827-8df25e25380d",
                                                "text": "You may leave out where you live and use either initials or an alias, since gods, buddhas and other divinities look only at our hearts."
                                            },
                                            {
                                                "example_id": "ed9faed9-2002-4122-8425-c70ddcea717b",
                                                "sense_id": "44efbe56-791d-3d42-8827-8df25e25380d",
                                                "text": "At the base of the whole process by which divinities and demons were created, and rites for their propitiation and placation established, lay Fear - fear stimulating the imagination to fantastic activity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e9dbcce-92ae-37c1-9069-80d7bcacb59a",
                                        "entry_id": "768dc9e1-e2cd-39fd-b48b-1f01802d6b35",
                                        "glosses": [
                                            "A celestial being inferior to a supreme God but superior to man."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf235d25-1b06-4f88-90e3-562518017330",
                                                "sense_id": "6e9dbcce-92ae-37c1-9069-80d7bcacb59a",
                                                "text": "These beings are derogatory from the wisdom and power of the author of nature, who doubtless can govern this machin he cou’d create, by more direct and easie methods, than employing these subservient divinities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "433468e6-9959-3ca5-9a41-8dd729e78d6a",
                                        "entry_id": "768dc9e1-e2cd-39fd-b48b-1f01802d6b35",
                                        "glosses": [
                                            "The study of religion or religions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "379ad9c1-0214-409c-817d-5fe8cc548540",
                                                "sense_id": "433468e6-9959-3ca5-9a41-8dd729e78d6a",
                                                "text": "Harvard Divinity School has been teaching theology since 1636."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec416b33-4856-34d4-b16e-3e2e2f60e5a8",
                                        "entry_id": "768dc9e1-e2cd-39fd-b48b-1f01802d6b35",
                                        "glosses": [
                                            "A type of confectionery made with egg whites, corn syrup, and white sugar."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad1b7046-51f1-4c76-adde-6fdc651b4dab",
                                                "sense_id": "ec416b33-4856-34d4-b16e-3e2e2f60e5a8",
                                                "text": "A lot of it is food: Grits, fried green tomatoes, sweet potato pie, divinity, corn nuggets, hot tamales and crawfish are just some of the delicacies he has discussed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
