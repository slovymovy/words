                                "target_senses": [
                                    {
                                        "sense_id": "72704cdf-56f4-3155-bbfc-b725ed7b5f4b",
                                        "entry_id": "7ca416bd-0dc7-33fd-b7ba-d2cba2da407e",
                                        "glosses": [
                                            "mietbares Zimmer für zwei Personen in Beherbergungsbetrieben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6b71120-8a18-471a-8d8a-7212e93aecb9",
                                                "sense_id": "72704cdf-56f4-3155-bbfc-b725ed7b5f4b",
                                                "text": "Ein Bett in einem Doppelzimmer ist billiger als ein Einzelzimmer."
                                            },
                                            {
                                                "example_id": "1637aeb1-a310-4bfb-992d-b075ca7a8aca",
                                                "sense_id": "72704cdf-56f4-3155-bbfc-b725ed7b5f4b",
                                                "text": "„Alle Quartiere sind ausgebucht, wir bekommen ein großes Zimmer im Haus des Bürgermeisters, genau genommen ein Doppelzimmer einschließlich Schreibraum und einem riesigen Bad.“"
                                            },
                                            {
                                                "example_id": "098c1399-2b54-4223-b962-cfd684a71a25",
                                                "sense_id": "72704cdf-56f4-3155-bbfc-b725ed7b5f4b",
                                                "text": "„Mein Bruder hatte mich vor Wochen gefragt, ob ich ein Einzelzimmer oder ein Doppelzimmer haben wolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
