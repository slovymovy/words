                                                "example_id": "17a7225d-1847-4dde-a3ae-79de5c5d246c",
                                                "sense_id": "9c6e8e72-40c1-3601-8fe3-f25d83045c8f",
                                                "text": "Dimorphisme sexuel, ensemble des caractères qui distinguent le mâle de la femelle dans une même espèce animale."
                                            }
                                        ]
                                    },
