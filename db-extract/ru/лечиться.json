                ],
                "senses": [
                    {
                        "sense_id": "79c04544-f95a-32e9-8720-ce16b0decf0b",
                        "entry_id": "738a2a7f-9846-3074-a567-e77353c1614e",
                        "glosses": [
                            "to take treatment, to receive treatment undergo a cure (of a patient)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31ea9bf1-f3eb-4c36-9b11-3cf9cd8e0d9d",
                                "sense_id": "79c04544-f95a-32e9-8720-ce16b0decf0b",
                                "text": "у кого́ вы ле́читесь?",
                                "translation": "who is your doctor?",
                                "english": "who is your doctor?"
                            },
                            {
                                "example_id": "533eee6d-cb05-457e-85bf-910447c033b0",
                                "sense_id": "79c04544-f95a-32e9-8720-ce16b0decf0b",
                                "text": "лечи́ться от чего́-л",
                                "translation": "to receive treatment for something",
                                "english": "to receive treatment for something"
                            },
                            {
                                "example_id": "df44cc44-0ec6-4231-9cab-1470780b3173",
                                "sense_id": "79c04544-f95a-32e9-8720-ce16b0decf0b",
                                "text": "лечи́ться гря́зями",
                                "translation": "to take/undergo a mud cure",
                                "english": "to take/undergo a mud cure"
                            },
                            {
                                "example_id": "83b05eaa-1ea8-44e6-9f95-018f4f494f4d",
                                "sense_id": "79c04544-f95a-32e9-8720-ce16b0decf0b",
                                "text": "лечи́ться самому",
                                "translation": "to doctor oneself",
                                "english": "to doctor oneself"
                            }
                        ]
                    },
                    {
                        "sense_id": "3b9b45b4-d388-3d4e-bd6c-f5c120ed9a91",
                        "entry_id": "738a2a7f-9846-3074-a567-e77353c1614e",
                        "glosses": [
                            "to cure (of a disease)"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "44831ec3-6035-4c8c-b2fa-6f997f38ed63",
                                "sense_id": "3b9b45b4-d388-3d4e-bd6c-f5c120ed9a91",
                                "text": "э́та боле́знь до́лго ле́чится",
                                "translation": "this disease takes long to cure",
                                "english": "this disease takes long to cure"
                            },
                            {
                                "example_id": "3833deb5-121b-44c4-89bf-bdfd174ccfe3",
                                "sense_id": "3b9b45b4-d388-3d4e-bd6c-f5c120ed9a91",
                                "text": "э́та боле́знь не ле́чится",
                                "translation": "there is no cure for this disease",
                                "english": "there is no cure for this disease"
                            }
                        ]
                    },
                    {
                        "sense_id": "e1ba3941-1f6f-326a-b780-5ce1c9114430",
                        "entry_id": "738a2a7f-9846-3074-a567-e77353c1614e",
                        "glosses": [
                            "to heal (of wounds, burns)"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dcf70d99-a45d-4ddb-bebc-a9827601e856",
                                "sense_id": "e1ba3941-1f6f-326a-b780-5ce1c9114430",
                                "text": "ожо́ги ле́чатся до́лго",
                                "translation": "burns heal slowly",
                                "english": "burns heal slowly"
                            }
                        ]
                    },
