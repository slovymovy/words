                "senses": [
                    {
                        "sense_id": "5d4dfc4f-baf1-39a5-93b4-aa4b9d593acf",
                        "entry_id": "d929aaad-d034-3c75-99de-70e327451ed0",
                        "glosses": [
                            "Employé attaché à une tâche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "068b8171-2144-47f7-a074-0447487fb280",
                                "sense_id": "5d4dfc4f-baf1-39a5-93b4-aa4b9d593acf",
                                "text": "On ne pratique nulle part avec l'insolente familiarité de nos préposés, ces recherches sur la personne, qui révoltent la pudeur et le bon sens."
                            },
                            {
                                "example_id": "78e07c58-9f71-43ca-bb82-2915f14caf94",
                                "sense_id": "5d4dfc4f-baf1-39a5-93b4-aa4b9d593acf",
                                "text": "Le non-paiement des cotisations sociales est constitutif d'infraction pénale dans le chef de l’employeur, ou de ses préposés et mandataires qui ont la responsabilité du paiement des cotisations."
                            },
                            {
                                "example_id": "2535155c-40bf-49c9-b341-d012f9662d2a",
                                "sense_id": "5d4dfc4f-baf1-39a5-93b4-aa4b9d593acf",
                                "text": "« Monsieur, il n’y a plus d’autres trains. Il ne faut pas rester », dit avec ménagement le préposé de la SNCF."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
