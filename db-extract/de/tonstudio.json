                                "target_senses": [
                                    {
                                        "sense_id": "21c4e3d8-9193-3ac0-a5b3-b1a9fce45c01",
                                        "entry_id": "7dfb1334-6abe-3ede-b5f9-424fb52808d6",
                                        "glosses": [
                                            "een ruimte die speciaal geschikt is gemaakt om muziek op te nemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "241a6f64-2453-444b-8b28-e569410bb060",
                                                "sense_id": "21c4e3d8-9193-3ac0-a5b3-b1a9fce45c01",
                                                "text": "Het incident gebeurde op 5 september, buiten een opnamestudio in Beverly Hills."
                                            },
                                            {
                                                "example_id": "ac2ca2c9-9a71-4f22-9375-8b7adf22951a",
                                                "sense_id": "21c4e3d8-9193-3ac0-a5b3-b1a9fce45c01",
                                                "text": "Jasper werd in 1998 ter dood veroordeeld omdat hij een studiobaas had beroofd en vermoord, in een opnamestudio in de Texaanse stad San Antonio."
                                            },
                                            {
                                                "example_id": "55fb42ca-6a3c-4363-85a0-1c000d2e584b",
                                                "sense_id": "21c4e3d8-9193-3ac0-a5b3-b1a9fce45c01",
                                                "text": "De Nederlandse componist vertelt hoe het verder verliep in de opnamestudio. \"Toots moest even bijkomen, en daarna heeft hij het prachtig en subtiel ingespeeld. Ik wilde dat hij wat meer improviseerde, maar dat vond hij ongepast. 'Zoiets teders moet je heel eenvoudig laten', zei hij.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
