                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03e44151-1686-420f-a0a4-e0e256fe080e",
                                                "sense_id": "b06f2935-a55a-39fd-9e69-293d601208ba",
                                                "text": "À sa droite, à ses pieds, on distingue quatre outils dont trois sont difficiles à identifier : une hache, un épluchoir ou un couperet (?), une tarière (?) et un poinçon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "accc7b0a-0c40-3436-b6de-a4bc1a5231eb",
