                "senses": [
                    {
                        "sense_id": "9003ac21-a912-34c7-8fce-acefc4f3e6f2",
                        "entry_id": "09be2fd2-1a69-3c42-a321-582a85940d44",
                        "glosses": [
                            "Relatif à Horace, poète latin du premier siècle avant J.-C., ou à son œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db5f3536-00f2-4657-91b1-8ebb2af362c6",
                                "sense_id": "9003ac21-a912-34c7-8fce-acefc4f3e6f2",
                                "text": "Ronsard imite dans cette élégie la palinodie ironique ou recantatio d’Horace, et l’imitateur emprunte copieusement le vocabulaire horacien traitant des charmes d’une sourcière."
                            },
                            {
                                "example_id": "ea401bc8-ea12-4218-935a-1fde59930460",
                                "sense_id": "9003ac21-a912-34c7-8fce-acefc4f3e6f2",
                                "text": "[…] ; si ce lecteur pouvait avoir oublié tout ce qu'on lui a dit des odes pindariques ou horaciennes, des leçons de Coqueret et du fameux manifeste que l'ami Du Bellay avait publié en 1549; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27d1e876-3b79-4cf1-b0ce-3a8e62fc8110",
                        "source_entry_id": "09be2fd2-1a69-3c42-a321-582a85940d44",
                        "source_sense_id": "9003ac21-a912-34c7-8fce-acefc4f3e6f2",
                        "target_lang_word": "Horatian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Horatian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bf557df-4d5e-3883-bed7-c6f3f1926b14",
                                        "entry_id": "976ab530-6e6e-3e17-98a5-ef0cbaf22629",
                                        "glosses": [
                                            "Of or pertaining to the Roman poet Horace (Quintus Horatius Flaccus; 65–8 BCE) or to his works or style."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e4a3a16-d162-4312-9ae8-075088324b8e",
                                                "sense_id": "5bf557df-4d5e-3883-bed7-c6f3f1926b14",
                                                "text": "There are three typical forms of ode: Horatian, Pindaric and irregular. Horatian odes follow the conventions of Horace, who deliberately imitated the Greek lyricists such as Alcaeus and Anacreon."
                                            },
                                            {
                                                "example_id": "4071e96c-c8f1-4ed1-9bdc-e4bc37d4c44b",
                                                "sense_id": "5bf557df-4d5e-3883-bed7-c6f3f1926b14",
                                                "text": "Satirical literature can commonly be categorised as Horatian, Juvenalian or Menippean. Horatian satire playfully criticizes some social vice through gentle, mild, and light-hearted humour."
                                            },
                                            {
                                                "example_id": "33adfc84-d6ae-4a28-b551-bd84f710f254",
                                                "sense_id": "5bf557df-4d5e-3883-bed7-c6f3f1926b14",
                                                "text": "Jonson was the most Horatian of the Elizabethans, both by nature and by study."
                                            },
                                            {
                                                "example_id": "aa52ccd6-d4a7-464d-a692-9b3ed80ce083",
                                                "sense_id": "5bf557df-4d5e-3883-bed7-c6f3f1926b14",
                                                "text": "Again nothing could be more Horatian than the high spirits of the introduction of the poem."
                                            },
                                            {
                                                "example_id": "0e161977-e10c-47f3-afb6-4a2d886683e0",
                                                "sense_id": "5bf557df-4d5e-3883-bed7-c6f3f1926b14",
                                                "text": "While these writers would have been familiar with both,^([the Horatian and Juvenalian styles of satire]) some were naturally \"attracted to the abrasiveness of Juvenal rather than the suavity of Horace\" while others found they were able to express whatever they wanted to express in more Horatian tones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
