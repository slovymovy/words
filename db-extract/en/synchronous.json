                                        "entry_id": "c012df69-00a7-30b6-afce-1f460f3d0511",
                                        "glosses": [
                                            "Qualifie les mouvements qui se font en même temps."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c44c8a77-ce20-4aa4-8540-e841539cb89d",
                                                "sense_id": "8185ec57-ae1d-3862-aca6-0dfb9269697e",
                                                "text": "Sourire. Respiration synchrone des dormeurs."
                                            },
                                            {
                                                "example_id": "587865ae-626b-488a-ae50-94535fd50456",
                                                "sense_id": "8185ec57-ae1d-3862-aca6-0dfb9269697e",
                                                "text": "Les oscillations de ces deux pendules sont synchrones."
                                            },
                                            {
                                                "example_id": "822d1447-bf5f-4d8b-bf83-2fa0a337ddcf",
                                                "sense_id": "8185ec57-ae1d-3862-aca6-0dfb9269697e",
                                                "text": "Les récepteurs récents utilisent le discriminateur à coïncidence aussi appelé détecteur à quadrature ou détecteur synchrone."
                                            },
                                            {
                                                "example_id": "06d8f290-7b97-4b2a-acc6-21bc4b88a1da",
                                                "sense_id": "8185ec57-ae1d-3862-aca6-0dfb9269697e",
                                                "text": "Vous vous demandiez comment la CAQ pouvait être aussi synchrone avec le peuple québécois ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9aa6717d-1fc2-499b-a728-5eaf201d9c68",
                        "source_entry_id": "74428420-9161-3cd5-9973-0a1bb4388998",
