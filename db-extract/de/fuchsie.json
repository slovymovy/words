                    {
                        "sense_id": "347f4317-bc96-3244-8596-da7135622678",
                        "entry_id": "5121c08b-823e-35d2-8239-3674a3843fdf",
                        "glosses": [
                            "häufig als Strauch wachsende Pflanze aus Familie der Nachtkerzengewächse, die aufgrund ihres Erscheinungsbildes häufig als Zierpflanze genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23d63162-55e5-473f-bfce-14b1a5ee569b",
                                "sense_id": "347f4317-bc96-3244-8596-da7135622678",
                                "text": "Die Fuchsie ist eine ideale Balkon- und Kübelpflanze für halbschattige bis schattige Standorte."
                            },
                            {
                                "example_id": "87f55a4e-414f-42f5-a561-eb85f5a5826a",
                                "sense_id": "347f4317-bc96-3244-8596-da7135622678",
                                "text": "Die Fuchsie ist ebenso der Mode unterworfen gewesen, wie so manche andere Pflanze."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23a18af5-1d9d-4d84-a1c4-b27271df8fc0",
                        "source_entry_id": "5121c08b-823e-35d2-8239-3674a3843fdf",
                        "source_sense_id": "347f4317-bc96-3244-8596-da7135622678",
