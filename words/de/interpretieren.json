{
    "word_family": [
        "Interpretation",
        "Interpret",
        "Interpretin",
        "interpretierbar",
        "Fehlinterpretation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c72ef5fa-86b8-356a-8421-77a28d3e3181",
                    "sense_definition": "den Sinn oder die tiefere Bedeutung von etwas (wie einem Text, Kunstwerk oder Verhalten) erklären und deuten",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "bedeutung_erklaeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Deutschunterricht müssen die Schüler heute ein bekanntes Gedicht <w>interpretieren</w>."
                        },
                        {
                            "text": "Man kann sein langes Schweigen auf ganz unterschiedliche Weise <w>interpretieren</w>."
                        }
                    ],
                    "synonyms": [
                        "auslegen",
                        "deuten"
                    ],
                    "common_phrases": [
                        "ein Gedicht interpretieren",
                        "falsch interpretieren"
                    ]
                },
                {
                    "sense_id": "d7ba7b96-28af-33a7-9dbf-2a8bb5a6f720",
                    "sense_definition": "ein musikalisches oder dramatisches Werk auf eigene, künstlerische Art und Weise aufführen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kuenstlerisch_darbieten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die junge Pianistin <w>interpretierte</w> das anspruchsvolle Konzert von Beethoven mit großer Leidenschaft."
                        },
                        {
                            "text": "Jeder Schauspieler <w>interpretiert</w> die klassische Rolle des Hamlet etwas anders."
                        }
                    ],
                    "synonyms": [
                        "darbieten"
                    ],
                    "common_phrases": [
                        "ein Musikstück interpretieren",
                        "eine Rolle interpretieren"
                    ]
                },
                {
                    "sense_id": "ab6553c8-2010-3746-8890-32c3959c8c13",
                    "sense_definition": "einen Quellcode Befehl für Befehl direkt ausführen, ohne ihn zuvor in Maschinensprache zu übersetzen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "programmierung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Software <w>interpretiert</w> das Skript Zeile für Zeile während des laufenden Betriebs."
                        },
                        {
                            "text": "Anstatt das Programm vorab zu kompilieren, <w>interpretiert</w> das System die Befehle direkt."
                        }
                    ],
                    "common_phrases": [
                        "Befehle interpretieren",
                        "Skripte interpretieren"
                    ]
                }
            ]
        }
    ]
}