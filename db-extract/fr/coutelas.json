                        "examples": [
                            {
                                "example_id": "12c4d328-fa1b-4213-9e77-737a7c868417",
                                "sense_id": "a6baf344-778e-3fb9-a05a-5b6d083426dd",
                                "text": "La première scène qui s'offre à nos yeux est une scène de carnage : des hommes roux, aux cheveux incultes, armés de coutelas, les bras nus et rouges de sang, éventrent des morues fraîches et les décapitent […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a8c1bf46-c48b-3832-8626-c998c09a2638",
                        "entry_id": "b2ddc98c-4b7e-3ded-bf2e-5efdcc15ca31",
                        "glosses": [
                            "Meuble représentant l’arme du même nom dans les armoiries. À rapprocher de badelaire, couteau, cimeterre, épée, kriss, rapière et sabre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7df03a9-416d-4222-bf89-f80b4c7df39a",
                                "sense_id": "a8c1bf46-c48b-3832-8626-c998c09a2638",
                                "text": "D’azur, à une palme d’or et un coutelas d’argent emmanché d’or passés en sautoir, accompagné en chef d’un \"E\" couronné d’or et de trois fleurs de lis du même aux autres cantons, qui est de Saint-Savin de la Vienne → voir illustration « armoiries avec un coutelas »"
                            }
                        ]
                    }
