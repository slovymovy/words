                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "890554ba-beb8-369a-a4a5-4e9423cb857a",
                                        "entry_id": "99e3dd2e-2808-392e-9c99-aa891644db6e",
                                        "glosses": [
                                            "An amusingly eccentric or grumpy and usually elderly man."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ec49041-46cb-427a-b69a-71ec198c85a3",
                                                "sense_id": "890554ba-beb8-369a-a4a5-4e9423cb857a",
                                                "text": "Jed, darling. The old codgers need to talk. Andrew's going to buy you a drink in that beautiful bar up on the terrace."
                                            },
                                            {
                                                "example_id": "1c91b0e3-642f-4737-a2a5-e05e591de6ed",
                                                "sense_id": "890554ba-beb8-369a-a4a5-4e9423cb857a",
                                                "text": "Now I was a forsaken codger snuffling disgracefully from a beautiful floozy's abuse."
                                            },
                                            {
                                                "example_id": "0e6639b0-c998-4952-92f5-76ba76d1704d",
                                                "sense_id": "890554ba-beb8-369a-a4a5-4e9423cb857a",
                                                "text": "‘I haven’t been drinking your health, my codger,’ replied Mr. Squeers; ‘so you have nothing to do with that.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
