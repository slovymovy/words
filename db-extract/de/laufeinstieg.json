                "senses": [
                    {
                        "sense_id": "2adf2157-5b69-35ab-ae87-630bbc83ed6a",
                        "entry_id": "ff7539e0-5999-3586-a1ab-e38c35219456",
                        "glosses": [
                            "Beginn einer (regelmäßigen) Laufaktivität; Phase, in der man mit dem (regelmäßigen) Laufen/Joggen startet"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "96fa2ee4-1184-46ed-ac09-dccfd95e1294",
                                "sense_id": "2adf2157-5b69-35ab-ae87-630bbc83ed6a",
                                "text": "„Der beste Tipp für den Laufeinstieg ist definitiv: Keep it simple!“"
                            },
                            {
                                "example_id": "e1df4444-8a8d-4c45-9ca7-158de66d7620",
                                "sense_id": "2adf2157-5b69-35ab-ae87-630bbc83ed6a",
                                "text": "„Wir haben Ihnen hier sieben Tipps für einen entspannten Laufeinstieg mit Ihrem Hund zusammengestellt:“"
                            },
                            {
                                "example_id": "aa13df15-e83c-4c3d-83a1-702251a69704",
                                "sense_id": "2adf2157-5b69-35ab-ae87-630bbc83ed6a",
                                "text": "„So überwindest du die häufigsten Probleme und Rückschläge, die dir beim Laufeinstieg begegnen können“"
                            },
                            {
                                "example_id": "25d9e181-f2df-4dbb-bf7e-81088cbd6ab9",
                                "sense_id": "2adf2157-5b69-35ab-ae87-630bbc83ed6a",
                                "text": "„Wie bereits erwähnt, wird die Methode vor allem für den Laufeinstieg empfohlen, aber Galloway setzt sie als Coach auch bei erfahrenen Läufer:innen [sic] ein und ist überzeugt davon, dass sie sich sogar für Bestzeiten eignet.“"
                            },
                            {
                                "example_id": "b3b30bfc-7651-474d-bca8-9a3de3c460b9",
                                "sense_id": "2adf2157-5b69-35ab-ae87-630bbc83ed6a",
                                "text": "„Wie bei einem Laufeinstieg musst du als Wiedereinsteiger oder Wiedereinsteigerin das Lauftraining im Frühling behutsam starten und die Umfänge ebenfalls langsam steigern.“"
                            },
                            {
                                "example_id": "2046e7fe-011d-44ce-9128-c2a0ba75e9f1",
                                "sense_id": "2adf2157-5b69-35ab-ae87-630bbc83ed6a",
                                "text": "„Du suchst einen Schuh für deinen Laufeinstieg, der ein gutes Preis-Leistungs-Verhältnis hat?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
