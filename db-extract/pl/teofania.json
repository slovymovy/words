                                        "sense_id": "39013252-5c12-3778-b2e4-569353c47202",
                                        "entry_id": "32085ff5-d154-3182-81ff-ca8db22f0139",
                                        "glosses": [
                                            "A manifestation of a deity to a person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "208a7478-2c65-4704-8e69-1756c095d3f7",
                                                "sense_id": "39013252-5c12-3778-b2e4-569353c47202",
                                                "text": "It was a bewildering theophany, since it was impossible to make out anything clearly in the stormy obscurity of thunder, lightning, smoke and wind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e540a1d-44cf-4993-a46f-320702687417",
                        "source_entry_id": "03d97d80-7cbd-3659-ad50-2860634116da",
                        "source_sense_id": "04600b48-cbef-385c-8d9e-59eff6dfb3ab",
                        "target_lang_word": "théophanie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théophanie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a90f596-50ea-3d66-9841-39e3f4035f22",
                                        "entry_id": "7491e2bc-c950-33bf-b6a6-e81960dab4de",
                                        "glosses": [
                                            "Révélation d’une divinité par le truchement de son apparition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "077771c9-6e73-4e0d-bfc1-8133b1c114b6",
                                                "sense_id": "8a90f596-50ea-3d66-9841-39e3f4035f22",
                                                "text": "Il n’y a qu’une théophanie, qui est la Croix."
                                            },
                                            {
                                                "example_id": "620fa40f-39cf-446b-b641-ad500672382e",
                                                "sense_id": "8a90f596-50ea-3d66-9841-39e3f4035f22",
                                                "text": "Bien sûr, je ne peux pas écrire ce qu’il me demande. La théophanie n’appartient qu’à ceux qui l’ont vécue ; elle reste éternellement accessible à tous les autres, qui ne se représenteront jamais les sentiments qu’elle procure. Davis est persuadé qu’il peut parler à Dieu grâce à des nombres aléatoires, et que cela est désormais démontré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
