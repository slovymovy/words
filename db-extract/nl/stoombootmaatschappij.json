                        "glosses": [
                            "onderneming die stoomboten bezit en exploiteert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde8d456-5709-4539-af4e-d76b67b19956",
                                "sense_id": "31f16855-21c3-3894-b27c-bb2d85bbe126",
                                "text": "Hij werd in 1909 geboren in Suriname en woonde in Paramaribo. Een ondernemende man die gaat varen voor de Koninklijke Nederlandse Stoombootmaatschappij (KNSM)."
                            },
                            {
                                "example_id": "62160c81-f238-4e41-bb5e-b0c5d86eeddf",
                                "sense_id": "31f16855-21c3-3894-b27c-bb2d85bbe126",
                                "text": "Zijn vele zoons vlogen uit in diverse richtingen. Enkelen werden bankier. Mijn grootvader, Balthazar, werd actief in de handel. Mijn vader ging in Amsterdam in de rederij, als directeur van een stoombootmaatschappij.”"
                            }
                        ]
                    }
