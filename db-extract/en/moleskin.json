                        "cross_references": [
                            {
                                "target_word": "Moleskin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de68fb36-7779-3214-8e84-6df21bc304c7",
                                        "entry_id": "e56f0732-2639-3dd0-9d51-f717db1100a0",
                                        "glosses": [
                                            "„kräftiger (Futter)stoff aus Baumwolle“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31a870b7-6912-4f00-b740-b15f16f18913",
                                                "sense_id": "de68fb36-7779-3214-8e84-6df21bc304c7",
                                                "text": "„Moleskin, sehr selten gewordener, schwerer Baumwollstoff der Manchester-Tradition, der mit ungewöhnlich starken Kettengarnen und hoher Dichtigkeit von Schußgarnen – bis zu 400 Fäden pro Zoll – gewebt wird, was nur auf besonderen Webstühlen möglich ist, die ihrerseits selten geworden sind.“"
                                            },
                                            {
                                                "example_id": "93374c14-223f-49ef-b14d-b56fbba07e46",
                                                "sense_id": "de68fb36-7779-3214-8e84-6df21bc304c7",
                                                "text": "„Insbesondere in England ist Moleskin auch noch als wärmerer und robuster Arbeitsanzugstoff für das Landleben beliebt. Der heute selten gewordene Moleskin wird überwiegend zu strapazierfähiger warmer Berufskleidung verarbeitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
