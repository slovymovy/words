                    {
                        "translation_id": "8182b7a7-cdf9-4c9f-bbe9-795e0a368b62",
                        "source_entry_id": "d69509a0-2145-3164-a915-311908b8e2c9",
                        "source_sense_id": "884c1aa1-0936-3400-947c-04eba3d84556",
                        "target_lang_word": "cognac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cognac",
