    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f91b29a-e012-3963-af22-4e14cc137715",
                    "sense_definition": "Action de réunir ou d'ajuster différentes pièces pour former un tout, ou ensemble résultant de cette action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>assemblage</w> des différents éléments du meuble prend environ une heure."
                        },
                        {
                            "text": "L'ouvrier vérifie chaque <w>assemblage</w> pour garantir la solidité de la structure en bois."
                        }
                    ],
                    "synonyms": [
                        "montage",
                        "réunion"
                    ],
                    "common_phrases": [
                        "ligne d'assemblage",
                        "technique d'assemblage",
                        "point d'assemblage"
                    ]
                },
                {
                    "sense_id": "1cc6ac1e-592d-3490-9dcd-c425a5b7ce79",
                    "sense_definition": "Mélange de plusieurs vins ou cépages complémentaires pour élaborer une cuvée harmonieuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vin rouge est un <w>assemblage</w> de merlot et de cabernet sauvignon."
                        },
                        {
                            "text": "Le domaine maîtrise parfaitement l'art de l'<w>assemblage</w> pour créer des cuvées exceptionnelles."
                        }
                    ],
                    "common_phrases": [
                        "vin d'assemblage"
                    ]
                },
                {
                    "sense_id": "7bc6b42b-b75a-304e-a8ef-35e65410416b",
                    "sense_definition": "Rapprochement ou combinaison de choses abstraites, d'éléments variés ou d'idées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son discours n'était qu'un <w>assemblage</w> d'idées contradictoires et confuses."
                        },
                        {
                            "text": "Le roman présente un curieux <w>assemblage</w> de réalité historique et de fiction."
                        }
                    ],
                    "synonyms": [
                        "union",
                        "réunion"
                    ]
                },
                {
                    "sense_id": "bd139f48-fbfa-3ca8-9228-915de212270c",
                    "sense_definition": "Traduction d'un programme rédigé en langage assembleur en instructions directement exécutables par la machine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>assemblage</w> du code source a généré un fichier binaire compact."
                        },
                        {
                            "text": "Une erreur de syntaxe a interrompu le processus d'<w>assemblage</w> du module."
                        }
                    ],
                    "common_phrases": [
                        "langage d'assemblage"
                    ]
                }
            ]
        }
    ]
