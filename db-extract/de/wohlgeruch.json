                                "target_senses": [
                                    {
                                        "sense_id": "5b7f32b4-6480-348d-9ba1-d446f4700d1c",
                                        "entry_id": "99c3eaad-5c8c-3684-bd4e-ddd1a5085e3d",
                                        "glosses": [
                                            "A pleasant smell or odour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41137110-55c4-485a-aa8a-bda3bd5a8c3b",
                                                "sense_id": "5b7f32b4-6480-348d-9ba1-d446f4700d1c",
                                                "text": "You could just use ordinary shop-bought kecap manis to marinade the meat, but making your own is easy, has a far more elegant fragrance and is, above all, such a great brag! Flavouring kecap manis is an intensely personal thing, so try this version now and next time cook the sauce down with crushed, split lemongrass and a shredded lime leaf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60272d91-6646-3062-a418-d14553d3c8de",
                                        "entry_id": "99c3eaad-5c8c-3684-bd4e-ddd1a5085e3d",
                                        "glosses": [
                                            "A perfume."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f659ee72-2465-4541-972b-cbeae345eb9e",
                                                "sense_id": "60272d91-6646-3062-a418-d14553d3c8de",
                                                "text": "Today, sales of women's fragrances are double those of men's, and 80 percent of all men's after-shaves and colognes are in fact bought by women, as gifts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fragrance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60423c36-510c-3c1d-b3f6-efae91a7aa4f",
                                        "entry_id": "be4959d7-1b3c-368e-b4ac-4e57da36d71a",
                                        "glosses": [
                                            "To apply a fragrance to; to perfume."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b92b3469-6676-4c23-bd25-cf856edcce81",
                        "source_entry_id": "f21c5376-7e02-3491-9cae-991ebcfb7062",
                        "source_sense_id": "9c79ec6c-6ff5-3beb-a34f-3c4163b2f9e9",
                        "target_lang_word": "parfum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parfum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65a75e30-ce47-3a23-a0de-336af8b63e8e",
                                        "entry_id": "56aada6e-1c8c-35a3-97e7-11a24dfe8368",
                                        "glosses": [
                                            "Odeur aromatique, agréable, plus ou moins forte, plus ou moins subtile et suave, qui s’exhale d’une substance quelconque et particulièrement des fleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "882af086-1017-420f-97a9-277befc5d20e",
                                                "sense_id": "65a75e30-ce47-3a23-a0de-336af8b63e8e",
                                                "text": "Qu’ai-je besoin de demander aux choses d’autres jouissances que celle de leur présence, c’est-à-dire leur beauté et leur parfum ?"
                                            },
                                            {
                                                "example_id": "58fb4300-8bde-4175-84c3-605edfb8228f",
                                                "sense_id": "65a75e30-ce47-3a23-a0de-336af8b63e8e",
                                                "text": "On fait preuve d’imagination, même si les plats sont archi-simples, on s’efforce de présenter un plat comme une œuvre d’art, on exalte ses parfums, bref on rend hommage à l’aliment."
                                            },
                                            {
                                                "example_id": "01ad0cdd-f579-4e00-a73b-dea231f6c2b4",
                                                "sense_id": "65a75e30-ce47-3a23-a0de-336af8b63e8e",
                                                "text": "Des racines coupées et des feuilles de betteraves, bouillant dans une marmite sur le feu, mêlaient leur parfum âcre à l’odeur de renfermé qui semblait stagner dans les encoignures."
                                            },
                                            {
                                                "example_id": "88ef1b38-8673-4508-944d-e67b7bba6458",
                                                "sense_id": "65a75e30-ce47-3a23-a0de-336af8b63e8e",
                                                "text": "Et chacun de me plaisanter ; ma jeunesse à son lever, mon parfum de fille fraîche, ma chair toute neuve en son premier éclat éveillaient chez les hommes de sournoises concupiscences, aiguisaient leur regard."
                                            },
                                            {
                                                "example_id": "2eea8b03-5816-4b78-af6c-d1ead5ada842",
                                                "sense_id": "65a75e30-ce47-3a23-a0de-336af8b63e8e",
                                                "text": "Les observateurs comprendront alors que la Péchina, chez qui la passion sortait par tous les pores, réveillât en des natures perverses la fantaisie endormie par l’abus ; de même qu’à table l’eau vient à la bouche à l’aspect de ces fruits contournés, troués, tachés de noir que les gourmands connaissent pas expérience, et sous la peau desquels la nature se plaît à mettre des saveurs et des parfums de choix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b338bd61-3f55-37a3-9f9d-6b44a48f9729",
                                        "entry_id": "56aada6e-1c8c-35a3-97e7-11a24dfe8368",
                                        "glosses": [
                                            "Produit industriel ou artisanal, extrait de certaines fleurs ou obtenus par des procédés chimiques, et dont il s’exhale une odeur agréable."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f34840bf-632a-4972-88a7-c3dca9d11514",
                                                "sense_id": "b338bd61-3f55-37a3-9f9d-6b44a48f9729",
                                                "text": "Ce furent les Croisades qui firent pénétrer en France l’usage des parfums : on introduisait ceux-ci sous forme de peaux odoriférantes destinées à faire des pourpoints, des ceintures, des gants. Aussi s’explique-t-on que le commerce de la parfumerie ait d’abord été aux mains des gantiers."
                                            },
                                            {
                                                "example_id": "3e2cab0f-33ea-4121-ba42-7617fdb2b800",
                                                "sense_id": "b338bd61-3f55-37a3-9f9d-6b44a48f9729",
                                                "text": "La haine de cette femme. De sa petite vie nourrie de crèmes de beauté et de fonds de teint. De parfums, de houppettes, d’épilations « maillot », de laits autobronzants."
                                            },
                                            {
                                                "example_id": "65f7a4cb-ba16-4106-8819-3122077053de",
                                                "sense_id": "b338bd61-3f55-37a3-9f9d-6b44a48f9729",
                                                "text": "Le parfum, pour moi, ça représente ce à quoi tout homme veut accéder. … Le parfum pour moi, c’était une résistance. Je ne suis ni le Christ, ni Bouddha, ni sainte Thérèse d’Avila, mais je sentirai bon, je vais me moquer de l’incarnation terrestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8de2867d-7fab-3570-93de-c763a433244e",
                                        "entry_id": "56aada6e-1c8c-35a3-97e7-11a24dfe8368",
                                        "glosses": [
                                            "Lors des épisodes de peste à la fin du XVIIᵉ siècle, fumigation utilisée pour préserver ou désinfecter les maisons de la maladie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b129e092-cc30-4576-8af7-23e8fee870b5",
                                                "sense_id": "8de2867d-7fab-3570-93de-c763a433244e",
                                                "text": "Il y a deux sortes de parfums ; le premier, préservatif pour ceux qui ne sont pas soupçonnés, l'autre, pour les maisons & personnes infectées. […] Le parfumeur ou Aérieur met le feu au parfum du grenier, ferme la porte, & ainsi descendant de chambre en chambre met le feu au parfum de chacune. […] Pour user et brûler le parfum il faut prendre quatre livres de foin sec pour deux livres de parfum & ainsi à proportion […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fdb1943-ccb9-3140-ba6d-6532b66cbf73",
                                        "entry_id": "56aada6e-1c8c-35a3-97e7-11a24dfe8368",
                                        "glosses": [
                                            "Effet subtil et durable d’une réalité agréable."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d19b2f5d-c49e-4f5f-8d5d-71301abc257f",
                                                "sense_id": "2fdb1943-ccb9-3140-ba6d-6532b66cbf73",
                                                "text": "Le parfum de la louange, des louanges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54edb48d-7dcb-3573-9804-5565741240b1",
                                        "entry_id": "56aada6e-1c8c-35a3-97e7-11a24dfe8368",
                                        "glosses": [
                                            "Rappel ; ressemblance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352cfef6-087c-4517-a557-670625c9c977",
                                                "sense_id": "54edb48d-7dcb-3573-9804-5565741240b1",
                                                "text": "Lancé, par surcroît, dans la vie parisienne, autant par son parentage que par sa profession, il traînait avec lui les parfums du Tout-Paris frais de la veille."
                                            },
                                            {
                                                "example_id": "93bb315c-bb52-469b-8b48-120dcb4d87ac",
                                                "sense_id": "54edb48d-7dcb-3573-9804-5565741240b1",
                                                "text": "Il y a un sujet sur lequel Pékin et les manifestants de Hongkong sont d’accord : c’est bien un parfum de révolution qui flotte sur cette ville riche mais rebelle de 7,4 millions d’habitants."
                                            },
                                            {
                                                "example_id": "f3ab73c6-2022-47a9-9045-4f807b7a88b4",
                                                "sense_id": "54edb48d-7dcb-3573-9804-5565741240b1",
                                                "text": "Et un rapide coup d’œil sur des campagnes antérieures du fabricant indique d’ailleurs que, moins brutales sans doute, elles dégagent quand même un fort parfum de machisme."
                                            },
                                            {
                                                "example_id": "6b309a39-765d-4b37-a814-40a80b1d9269",
                                                "sense_id": "54edb48d-7dcb-3573-9804-5565741240b1",
                                                "text": "La deuxième condition est aujourd'hui de créer un léger « parfum de démocratie ». Pas de la démocratie, c’est évidemment risqué, mais un simple avant-goût, le minimum pour éviter la critique des gouvernements étrangers et de l’Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf9fc5f0-8731-454c-8f39-cd8f3a65c760",
                        "source_entry_id": "f21c5376-7e02-3491-9cae-991ebcfb7062",
                        "source_sense_id": "9c79ec6c-6ff5-3beb-a34f-3c4163b2f9e9",
                        "target_lang_word": "fragrance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fragrance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "088c8730-84e9-367b-9ec9-02ef3b17f8dd",
                                        "entry_id": "d7a056fd-f48a-3768-9662-9d6f5d91a6e2",
                                        "glosses": [
                                            "Parfum."
                                        ],
                                        "tags": [
                                            "Parfumerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "041e8470-1f41-4fb1-be10-88f0cbd923cf",
                                                "sense_id": "088c8730-84e9-367b-9ec9-02ef3b17f8dd",
                                                "text": "De la création d’une fragrance, en passant par la conception de son flacon, jusqu’à son installation sur les étagères chromées d’un grand magasin, il faut réunir une foule d’intervenants d’horizons très variés."
                                            },
                                            {
                                                "example_id": "bf44ce24-93f3-4910-ab00-8c2d0a32404f",
                                                "sense_id": "088c8730-84e9-367b-9ec9-02ef3b17f8dd",
                                                "text": "Il saurait incidemment – en baisant Djamila pour la première fois – que ce parfum était Opium, d’Yves Saint Laurent, et que cette fragrance serait sa madeleine de Proust à tout jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f84bd853-52ab-3385-b7c6-e27bcbc70022",
                                        "entry_id": "d7a056fd-f48a-3768-9662-9d6f5d91a6e2",
                                        "glosses": [
                                            "Odeur plaisante d’un produit parfumé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5520aeb2-3bb0-4866-ab6f-79d41ccf5b1b",
                                                "sense_id": "f84bd853-52ab-3385-b7c6-e27bcbc70022",
                                                "text": "Il exultait de faire un labeur d’homme d’éprouver ses muscles, de pleinement profiter du soleil, de l’air tiède qui charriait de fameuses fragrances de bois, de chaume frais, d’herbes desséchées…"
                                            },
                                            {
                                                "example_id": "9de846c7-4ddd-44bd-82cf-d00ad35c6bfa",
                                                "sense_id": "f84bd853-52ab-3385-b7c6-e27bcbc70022",
                                                "text": "Terrible, les nains qui ne savent pas boire sans puer. Moi, bourré, je ravale. Rien ne s’échappe. Je ne répands que des fragrances d’eau de toilette."
                                            },
                                            {
                                                "example_id": "e5318f8b-4b06-404e-a2f2-8c9b93e87230",
                                                "sense_id": "f84bd853-52ab-3385-b7c6-e27bcbc70022",
                                                "text": "Elle n’était plus que la discrète fragrance de violette et l’écho automnal de la nymphette sur laquelle je m’étais roulé autrefois en poussant de grands cris."
                                            },
                                            {
                                                "example_id": "49837830-a182-44a4-8eb2-ff55a439d690",
                                                "sense_id": "f84bd853-52ab-3385-b7c6-e27bcbc70022",
                                                "text": "Dans le parfum qui errait, je reconnus celui de Marco, mais marié, si je puis écrire, à une autre fragrance corsée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
