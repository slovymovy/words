                                "target_senses": [
                                    {
                                        "sense_id": "4c721c43-ac01-3715-9072-5ad78ca520f7",
                                        "entry_id": "cc4aedb2-c75f-325d-b077-bfeb930f28ca",
                                        "glosses": [
                                            "The line along one's forehead where hair starts growing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af7d8407-83cd-4ea9-9d37-8b65e02fc6bc",
                                                "sense_id": "4c721c43-ac01-3715-9072-5ad78ca520f7",
                                                "text": "It's just a receding hairline — it's not like you're going bald."
                                            },
                                            {
                                                "example_id": "442280f7-c95a-4ea7-94b8-5befb2414d38",
                                                "sense_id": "4c721c43-ac01-3715-9072-5ad78ca520f7",
                                                "text": "Using a Danish technique, doctors can now insert plugs of just one or two hairs in front of an implanted area to simulate a natural hairline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efe804a9-abf6-35a8-90ae-eb0de522dfe7",
                                        "entry_id": "cc4aedb2-c75f-325d-b077-bfeb930f28ca",
                                        "glosses": [
                                            "A very thin line in writing, drawing, or typography."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41e5d9cc-b9af-36c8-8570-a5871e7000b9",
                                        "entry_id": "cc4aedb2-c75f-325d-b077-bfeb930f28ca",
                                        "glosses": [
                                            "A very thin line in writing, drawing, or typography.",
                                            "A very thin fissure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e10fae10-8aa5-48c6-bc3c-f8664a939a57",
                                                "sense_id": "41e5d9cc-b9af-36c8-8570-a5871e7000b9",
                                                "text": "While inspecting the new house, we found a few hairlines in one of the walls."
                                            },
                                            {
                                                "example_id": "a9cec991-b6c9-42f8-b913-f4fed4cf0f0f",
                                                "sense_id": "41e5d9cc-b9af-36c8-8570-a5871e7000b9",
                                                "text": "Yup, you got a crack in it [the cylinder head] all right. Just a hairline, but that damn thing is gonna cause a big headache later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25c02d58-ed6e-34e9-b59f-669aadabd08d",
                                        "entry_id": "cc4aedb2-c75f-325d-b077-bfeb930f28ca",
                                        "glosses": [
                                            "A fishing line made from hair."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hairline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "588f7a18-11a9-39dc-a66f-fbb3cabd10b0",
                                        "entry_id": "1ef4ca85-16df-38e5-ac4d-c7fbad48669f",
                                        "glosses": [
