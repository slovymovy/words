                ],
                "senses": [
                    {
                        "sense_id": "f776101b-f7dd-36c6-8ec5-fb735c5206ff",
                        "entry_id": "e6686152-00d4-3a86-86b8-0190277cef7f",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb509563-4729-4ff1-9426-cb4def1ff82f",
                                "sense_id": "f776101b-f7dd-36c6-8ec5-fb735c5206ff",
                                "text": "Frau Ramin ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "36bab395-f1c4-4415-9e30-31a7686ce4be",
                                "sense_id": "f776101b-f7dd-36c6-8ec5-fb735c5206ff",
                                "text": "Herr Ramin wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "915d028a-65fb-421c-8a89-7f9e59b31f90",
                                "sense_id": "f776101b-f7dd-36c6-8ec5-fb735c5206ff",
                                "text": "Die Ramins fahren heute nach Bremen."
                            },
                            {
                                "example_id": "2dfdd486-0ccf-49e1-b224-37cba412b0af",
                                "sense_id": "f776101b-f7dd-36c6-8ec5-fb735c5206ff",
                                "text": "Der Ramin trägt nie die Pullover, die die Ramin ihm strickt."
                            },
                            {
                                "example_id": "6e3e473a-2753-425c-ad8a-77decc92f961",
                                "sense_id": "f776101b-f7dd-36c6-8ec5-fb735c5206ff",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ramin kommt, geht der Herr Ramin.“"
                            },
                            {
                                "example_id": "6e350ac1-6222-4952-b174-9eeb6ef5bcc3",
                                "sense_id": "f776101b-f7dd-36c6-8ec5-fb735c5206ff",
                                "text": "Ramin kommt und geht."
                            },
                            {
                                "example_id": "e9476b8d-f421-41ef-99f7-23275587f715",
                                "sense_id": "f776101b-f7dd-36c6-8ec5-fb735c5206ff",
                                "text": "Ramins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
