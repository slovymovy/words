                    },
                    {
                        "translation_id": "94e1f525-dc2d-4108-bbb9-e4f03ab28a8f",
                        "source_entry_id": "b6382d33-5b7e-3982-89a8-ecd58df8a92e",
                        "source_sense_id": "091fb26c-24c9-3cd0-8b42-b5150061a33f",
                        "source_sense_description": "Kind, das der Ehegatte aus einer früheren Beziehung in eine Ehe oder Partnerschaft mitbringt",
                        "target_lang_word": "bel-enfant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bel-enfant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be1c1901-a874-35f9-a534-4249df505ba7",
                                        "entry_id": "dfa799cc-9598-31d8-be60-1c44b50b1f20",
                                        "glosses": [
                                            "Enfant d’un autre lit (i.e. fils ou fille de l’époux ou épouse précédente)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf2e565b-a369-4376-93fa-7994c86925cc",
                                                "sense_id": "be1c1901-a874-35f9-a534-4249df505ba7",
                                                "text": "Le couple et leurs deux enfants forment une «famille moderne», a dit Kamala Harris, en racontant que Cole et Ella, ses beaux-enfants, l'appelaient «Momala»."
                                            },
                                            {
                                                "example_id": "f3f15eb3-ba46-4ff6-8256-841ada238370",
                                                "sense_id": "be1c1901-a874-35f9-a534-4249df505ba7",
                                                "text": "Le rôle du beau-parent est particulièrement délicat : on attend de lui qu’il considère son « bel-enfant » comme s’il était le sien, et pourtant, il ne doit pas marcher sur les plates-bandes du parent absent."
                                            },
                                            {
                                                "example_id": "cf8d7936-13af-42c9-94e2-8afe1fbbd9b8",
                                                "sense_id": "be1c1901-a874-35f9-a534-4249df505ba7",
                                                "text": "Ils estiment être une famille unie et veulent partager leur patrimoine immobilier en parts égales, sans faire de distinction entre leurs beaux-enfants et leurs enfants biologiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ecc10f5-3fad-3c7e-8c5a-74e77a633ee6",
                                        "entry_id": "dfa799cc-9598-31d8-be60-1c44b50b1f20",
                                        "glosses": [
                                            "Époux de son enfant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a7bd030-d80f-4941-b910-0463db2384f5",
                                                "sense_id": "7ecc10f5-3fad-3c7e-8c5a-74e77a633ee6",
                                                "text": "Le veuf et la veuve s’étant mariés, ils ont chacun acquis plusieurs beaux-enfants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
