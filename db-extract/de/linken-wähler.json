                "senses": [
                    {
                        "sense_id": "f4c57293-ce71-326b-8010-154082f4dcb4",
                        "entry_id": "fb447cdc-49e1-3d7e-81a3-37a3f71d58b6",
                        "glosses": [
                            "Person, die bei einer Wahl in Deutschland für die Partei „Die Linke“ gestimmt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f1a3ce1-268e-41a6-b608-fa4e7548c392",
                                "sense_id": "f4c57293-ce71-326b-8010-154082f4dcb4",
                                "text": "„Über die Einstellungen der Linken-Wähler liegen nur wenige Daten vor.“"
                            },
                            {
                                "example_id": "3e8580a7-bfe0-429e-8ef1-c9f15a7d7ccc",
                                "sense_id": "f4c57293-ce71-326b-8010-154082f4dcb4",
                                "text": "Für Westdeutschland stellen wir fest, dass Linken-Wähler tatsächlich überdurchschnittlich oft Abitur haben. Auch im Osten haben die Linken-Wähler eher einen mittleren Bildungsabschluss als beispielsweise einen Hauptschulabschluss."
                            },
                            {
                                "example_id": "3fdc8913-630a-4c19-b202-ddce6e291629",
                                "sense_id": "f4c57293-ce71-326b-8010-154082f4dcb4",
                                "text": "„Männlich, gebildet, ärmer – das ist der Durchschnitt der Menschen, die bei Wahlen für die Linkspartei stimmen. Daten von YouGov zeigen, wie der Linken-Wähler tickt.“"
                            },
                            {
                                "example_id": "047aec4c-d6e6-43d8-9f67-5633396ae239",
                                "sense_id": "f4c57293-ce71-326b-8010-154082f4dcb4",
                                "text": "„Merkel ablösen und selber mitregieren - davon sind die Sozialisten weiter denn je entfernt. Stattdessen wandern Linken-Wähler zur AfD ab […].“"
                            },
                            {
                                "example_id": "499d2a19-469c-4f68-8dba-fa6a8923d440",
                                "sense_id": "f4c57293-ce71-326b-8010-154082f4dcb4",
                                "text": "„Im Gegenzug wandern rund 400.000 Wähler von der Linken zu den Rechten – jeder zehnte ehemalige Linken-Wähler wählte am Sonntag die AfD.“"
                            },
                            {
                                "example_id": "7f043fee-9c85-4b3a-8314-e1a6ed863ed1",
                                "sense_id": "f4c57293-ce71-326b-8010-154082f4dcb4",
                                "text": "„Die Mehrheit der Linken-Wähler in Sachsen-Anhalt, aber auch jeder zweite AfD-Sympathisant, fand es jedoch richtig, dass die Linke die Benachteiligung Ostdeutschlands thematisierte. Sie traf damit wenig überraschend einen Nerv: das Ungleichgewicht.“"
                            },
                            {
                                "example_id": "b5b60f47-febf-45d7-820c-b482ccd1dde2",
                                "sense_id": "f4c57293-ce71-326b-8010-154082f4dcb4",
                                "text": "„Bei den Linken-Wähler nennen immerhin 22 Prozent die AfD als ihre zweitliebste Partei. Das sind erheblich mehr als bei allen anderen Parteien: Bei der CDU kommt die AfD nur bei fünf Prozent der Anhänger auf Platz zwei der Sympathien, bei den Grünen sind es drei, bei der SPD zwei Prozent.“"
                            },
                            {
                                "example_id": "c1589ad9-21ae-4bf2-b0f1-c85284706251",
                                "sense_id": "f4c57293-ce71-326b-8010-154082f4dcb4",
                                "text": "„Doch wie die Gesellschaft ist auch die Linkspartei in der Flüchtlingsfrage gespalten. 45 Prozent der Linken-Wähler […] fänden es gut, wenn es wegen der Flüchtlingskrise wieder Grenzkontrollen gäbe, auch wenn dadurch das Reisen und der Güterverkehr in Europa erschwert würden.“"
                            },
                            {
                                "example_id": "0e18d596-93ec-4ea5-9201-c048e3e3d0c8",
                                "sense_id": "f4c57293-ce71-326b-8010-154082f4dcb4",
                                "text": "[Bodo Ramelow:] „38 Prozent der Linken-Wähler geben an, ihre [Wahl-]Entscheidung wegen ihm getroffen zu haben. Das ist absolut vergleichbar mit Kretschmann und den Grünen in Baden-Württemberg.“"
                            },
                            {
                                "example_id": "2922dfe0-8154-48e4-908f-3d0e39819a01",
                                "sense_id": "f4c57293-ce71-326b-8010-154082f4dcb4",
                                "text": "„Nur jeder vierte potenzielle Linken-Wähler würde dieser Partei heute tatsächlich seine Stimme geben. Das geht aus einer Analyse des Forschungsinstituts Emnid hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
