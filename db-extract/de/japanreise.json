                    {
                        "sense_id": "2db94b14-cb29-3743-9608-b1b06139e2a2",
                        "entry_id": "e5b8d971-8e1e-3a23-b719-567aeb24e644",
                        "glosses": [
                            "Reise, die nach Japan oder durch das Gebiet von Japan führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "018cb2c8-bddb-471c-8c20-855b3abbb187",
                                "sense_id": "2db94b14-cb29-3743-9608-b1b06139e2a2",
                                "text": "„Wenn es mit der Bahn auch preisgünstig sein sollte, ist das Lösen eines JR-Passes schon vor Antritt der Japanreise nötig.“"
                            },
                            {
                                "example_id": "0deb81aa-3c2e-42f7-878e-ac63e4138933",
                                "sense_id": "2db94b14-cb29-3743-9608-b1b06139e2a2",
                                "text": "„Besucher können auf der Wiese picknicken, die von den Beales 1907 von einer Japanreise mitgebrachten Ahornbäume bewundern und in die Landschaft hinauswandern.“"
                            },
                            {
                                "example_id": "9845e03d-9f92-4dbb-8625-53099ff387fa",
                                "sense_id": "2db94b14-cb29-3743-9608-b1b06139e2a2",
                                "text": "„Während seiner ersten Japanreise konnte sich Ulbricht oft nur mithilfe von Übersetzungsapps verständigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
