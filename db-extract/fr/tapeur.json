                        "entry_id": "a1fc99ef-488d-3418-864a-1c67b1196024",
                        "glosses": [
                            "Personne qui emprunte de l’argent, souvent sans l’intention de la rendre."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "8f037ca8-5f1d-4894-aa58-896f1ae4a415",
                                "sense_id": "f1f44163-1475-3b19-81e7-9f0cb03877ef",
                                "text": "Thommereux. — Ça doit être un tapeur, ça !… Il vient pour lui emprunter de l’argent, ce quelconque !…"
                            },
                            {
                                "example_id": "3802d8b8-e8be-4b01-a0de-c11010394176",
                                "sense_id": "f1f44163-1475-3b19-81e7-9f0cb03877ef",
                                "text": "Le contremaître arabe se raidit un peu plus encore, son compagnon à moustache sortit une cigarette (il ne sortit pas le paquet, juste la cigarette, comme un homme qui n’a pas envie de partager, qui en a marre des tapeurs)."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bca4a11-c373-3a3d-830c-2d5ed9e45755",
                        "entry_id": "a1fc99ef-488d-3418-864a-1c67b1196024",
                        "glosses": [
                            "Personne qui tape à la machine, qui écrit à la machine à écrire ou à l’ordinateur."
                        ],
