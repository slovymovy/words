                                                "example_id": "7ff44337-bd4d-4505-9609-e42ce5a99b19",
                                                "sense_id": "52dd7318-0e86-3e25-8537-3f22f76cbf1b",
                                                "text": "Cette folle de Renée, qui était apparue une nuit dans le ciel parisien comme la fée excentrique des voluptés mondaines, était la moins analysable des femmes."
                                            },
                                            {
                                                "example_id": "fe82776f-3da8-4135-9e88-47481243abdd",
                                                "sense_id": "52dd7318-0e86-3e25-8537-3f22f76cbf1b",
                                                "text": "La décision est-elle un produit analysable ?"
                                            }
