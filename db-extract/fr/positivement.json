                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b1f8b1b-0276-41a8-8cc4-79d7781622ab",
                        "source_entry_id": "c59306bd-3b7d-3a1b-b5bf-1e369670d553",
                        "target_lang_word": "positively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "positively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "861bcff0-06f3-3dcf-b5fe-32e0c373b696",
                                        "entry_id": "9f66840d-a81d-3439-94a1-ec059e48191d",
                                        "glosses": [
                                            "In a positive manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b75212d-e4fb-43b5-9a25-2a873f320316",
                                                "sense_id": "861bcff0-06f3-3dcf-b5fe-32e0c373b696",
                                                "text": "He approached the interview positively."
                                            },
                                            {
                                                "example_id": "acf4d1e0-4af2-4179-8340-eef77ee98493",
                                                "sense_id": "861bcff0-06f3-3dcf-b5fe-32e0c373b696",
                                                "text": "There’s nothing – not. one. thing. – that Trump could do or say that would be received positively by TDSers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d23723db-941f-3b4b-a641-bbd66539435c",
                                        "entry_id": "9f66840d-a81d-3439-94a1-ec059e48191d",
                                        "glosses": [
                                            "With certainty."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8491cbed-8a17-4084-9d06-c02b7e874d1e",
                                                "sense_id": "d23723db-941f-3b4b-a641-bbd66539435c",
                                                "text": "I will positively be there at 8 a.m."
                                            },
                                            {
                                                "example_id": "4b8c26d4-5dae-40c7-ad3c-4bdd06c77d6a",
                                                "sense_id": "d23723db-941f-3b4b-a641-bbd66539435c",
                                                "text": "The carriage nearly overturned, and he saw her eyes blaze at him, and she positively hissed, “I suppose you are enjoying this?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a558e3fe-bc3f-37e5-9d35-e67e7ea09498",
                                        "entry_id": "9f66840d-a81d-3439-94a1-ec059e48191d",
                                        "glosses": [
                                            "Absolutely; utterly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa581e0-bab3-4141-99b3-e84dabbc2317",
                                                "sense_id": "a558e3fe-bc3f-37e5-9d35-e67e7ea09498",
                                                "text": "[…] Easter Sunday, for all its traditions, is a gladless day in London. There is positively nothing to do."
                                            },
                                            {
                                                "example_id": "e02b389b-1cd2-4517-9005-9406ac075feb",
                                                "sense_id": "a558e3fe-bc3f-37e5-9d35-e67e7ea09498",
                                                "text": "She talked and laughed and positively forgot until he had come in (just as she had imagined) that Pearl Fulton had not turned up."
                                            },
                                            {
                                                "example_id": "c90f1b58-24be-4234-bc20-f90d31b53ee8",
                                                "sense_id": "a558e3fe-bc3f-37e5-9d35-e67e7ea09498",
                                                "text": "\"Positively do not open,\" reads the message under the cabinet in which Ed and Lorraine put the possessed Annabelle doll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e96f4916-edd5-382c-a932-838d9902b5a0",
                                        "entry_id": "9f66840d-a81d-3439-94a1-ec059e48191d",
                                        "glosses": [
                                            "Very."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b29cfe6a-4276-4e0d-bcc2-c2fad2f25eb0",
                                                "sense_id": "e96f4916-edd5-382c-a932-838d9902b5a0",
                                                "text": "I had a positively wonderful time."
                                            },
                                            {
                                                "example_id": "e440e8bd-24c1-4ac7-aee7-696707b53a0a",
                                                "sense_id": "e96f4916-edd5-382c-a932-838d9902b5a0",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. […] The bed was the most extravagant piece. Its graceful cane halftester rose high towards the cornice and was so festooned in carved white wood that the effect was positively insecure, as if the great couch were trimmed with icing sugar."
                                            },
                                            {
                                                "example_id": "bb9a8515-0578-489d-9bfa-12b458434a52",
                                                "sense_id": "e96f4916-edd5-382c-a932-838d9902b5a0",
                                                "text": "In the 90s it was Craigslist and AOL chat rooms, then Match.com and Kiss.com. But the lengthy, heartfelt e-mails exchanged by the main characters in You’ve Got Mail (1998) seem positively Victorian in comparison to the messages sent on the average dating app today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39ec6c12-fc31-4909-b034-7fd27efd7a6c",
                        "source_entry_id": "c59306bd-3b7d-3a1b-b5bf-1e369670d553",
