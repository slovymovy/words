                "word": "pique-prune",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "474343ac-f777-495d-8c55-10c86d919e40",
                        "entry_id": "57f54465-3ac7-3bcc-9586-7f1bff849eba",
