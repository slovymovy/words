{
    "word_family": [
        "sulky",
        "sullen",
        "sulking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c42d380d-ab78-3b14-aa3b-02a5d7459380",
                    "sense_definition": "To express ill humor or offence by remaining sullenly silent or withdrawn.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sulk-behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of talking about his problems, he chose to <w>sulk</w> in his room all afternoon.",
                            "target_lang_translations": {
                                "pl": "Zamiast porozmawiać o swoich problemach, wolał <w>dąsać się</w> w swoim pokoju przez całe popołudnie."
                            }
                        },
                        {
                            "text": "Please do not <w>sulk</w> in silence when you can just tell me what is bothering you.",
                            "target_lang_translations": {
                                "pl": "Proszę, nie <w>bocz się</w> w milczeniu, skoro możesz mi po prostu powiedzieć, co cię trapi."
                            }
                        }
                    ],
                    "synonyms": [
                        "mope"
                    ],
                    "common_phrases": [
                        "sulk in silence",
                        "sulk in his room"
                    ],
                    "target_lang_definitions": {
                        "pl": "Okazywać niezadowolenie, urazę lub zły humor poprzez milczenie, dąsanie się lub unikanie kontaktu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dąsać się",
                                "target_lang_sense_clarification": "okazywać niezadowolenie lub urazę"
                            },
                            {
                                "target_lang_word": "boczyć się",
                                "target_lang_sense_clarification": "lekko gniewać się, unikać kogoś z urazy"
                            },
                            {
                                "target_lang_word": "obrażać się",
                                "target_lang_sense_clarification": "strzelać fochy, dąsać się"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ba94929-7580-3e44-b118-15f3c023f9e2",
                    "sense_definition": "A state or fit of sulking; a sullen mood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sulk-behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Leo has been in a <w>sulk</w> all morning because he did not get his way.",
                            "target_lang_translations": {
                                "pl": "Leo ma <w>fochy</w> przez cały ranek, ponieważ nie postawił na swoim."
                            }
                        },
                        {
                            "text": "She went into a deep <w>sulk</w> after her ideas were rejected at the meeting.",
                            "target_lang_translations": {
                                "pl": "Wpadła w głębokie <w>dąsy</w> po tym, jak jej pomysły zostały odrzucone na spotkaniu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in a sulk",
                        "into a sulk"
                    ],
                    "target_lang_definitions": {
                        "pl": "Stan dąsania się, zły humor lub fochy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dąsy",
                                "target_lang_sense_clarification": "stan niezadowolenia i obrażenia się"
                            },
                            {
                                "target_lang_word": "fochy",
                                "target_lang_sense_clarification": "potocznie: stan obrażenia się, dąsy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c604fb49-21b8-331a-953f-63c4cb2791b6",
                    "sense_definition": "A person who sulks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sulk-person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>sulk</w>, Leo, and come join the party.",
                            "target_lang_translations": {
                                "pl": "Nie bądź takim <w>dąsalem</w>, Leo, i dołącz do zabawy."
                            }
                        },
                        {
                            "text": "He was known as a bit of a <w>sulk</w> when things did not go according to his plan.",
                            "target_lang_translations": {
                                "pl": "Był znany jako niezły <w>mruk</w>, gdy sprawy nie szły po jego myśli."
                            }
                        }
                    ],
                    "common_phrases": [
                        "such a sulk"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe a person"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba, która często się dąsa lub obraża."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dąsal",
                                "target_lang_sense_clarification": "osoba łatwo obrażająca się"
                            },
                            {
                                "target_lang_word": "mruk",
                                "target_lang_sense_clarification": "osoba milcząca i ponura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "153e602e-2e79-344a-af51-62dfc6773330",
                    "sense_definition": "A furrow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plow left a deep <w>sulk</w> in the damp soil of the field.",
                            "target_lang_translations": {
                                "pl": "Pług zostawił głęboką <w>bruzdę</w> w wilgotnej glebie na polu."
                            }
                        },
                        {
                            "text": "He carefully guided the tractor to ensure each <w>sulk</w> was perfectly straight.",
                            "target_lang_translations": {
                                "pl": "Ostrożnie prowadził traktor, aby upewnić się, że każda <w>bruzda</w> była idealnie prosta."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Mainly regional or agricultural usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Bruzda w ziemi powstała po przejściu pługa."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bruzda",
                                "target_lang_sense_clarification": "wyżłobienie w ziemi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}