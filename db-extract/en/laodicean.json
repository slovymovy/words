                    {
                        "sense_id": "48fbd77f-70f4-38cf-9f5a-9f7c47f5c8ae",
                        "entry_id": "481ea0a5-61b3-326b-8f23-c77ec34734aa",
                        "glosses": [
                            "lukewarm, neither hot nor cold (with reference to Revelation 3:16)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a89cfb62-dee4-42a5-8cc4-dca9d53a6857",
                                "sense_id": "48fbd77f-70f4-38cf-9f5a-9f7c47f5c8ae",
                                "text": "The baths were mostly tiled showers, with an endless variety of spouting mechanisms, but with one definitely non-Laodicean characteristic in common, a propensity, while in use, to turn instantly beastly hot or blindingly cold upon you, depending on whether your neighbor turned on his cold or his hot to deprive you of a necessary complement in the shower you had so carefully blended."
                            }
                        ]
                    },
                    {
                        "sense_id": "115db749-2bd9-3530-8230-a16912fa4076",
                        "entry_id": "481ea0a5-61b3-326b-8f23-c77ec34734aa",
                        "glosses": [
                            "half-hearted or apathetic, especially with regards to religion or politics"
                        ],
                        "tags": [],
                        "examples": []
                    }
