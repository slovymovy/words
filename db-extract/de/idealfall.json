                        "form": "die Idealfälle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2138db68-5f4d-35e0-9b39-4f817a2faeea",
                        "entry_id": "7f4d2ef4-d82d-39f8-b4f7-a65cba3f9a18",
                        "glosses": [
                            "Eintreten eines Zustandes, wie er besser nicht sein könnte; idealer Fall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81dacad4-606a-434a-966a-27a02975e6d9",
                                "sense_id": "2138db68-5f4d-35e0-9b39-4f817a2faeea",
                                "text": "„Es wäre natürlich der Idealfall, dass Doping gar nicht stattfindet, so wie es im Idealfall nur gute Menschen geben sollte.“"
                            },
                            {
                                "example_id": "0d1f33a5-f05d-41e8-9689-878fa2d32453",
                                "sense_id": "2138db68-5f4d-35e0-9b39-4f817a2faeea",
                                "text": "„Dass sie auch spülmaschinenfest sind, hat einen Grund: Der Kunde, der laut Pensold ‚immer umweltbewusster wird‘, soll im Idealfall damit wieder und wieder vorbeischauen.“"
                            },
                            {
                                "example_id": "ef2ea353-390e-4406-9115-b03daff018cf",
                                "sense_id": "2138db68-5f4d-35e0-9b39-4f817a2faeea",
                                "text": "„Ich wollte die verlorene Heimat unserer Familie besser verstehen und im Idealfall noch einmal lebendig werden lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
