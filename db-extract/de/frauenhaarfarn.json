                    {
                        "sense_id": "ed1d60f5-4adb-3649-ab31-94c7c9c31b98",
                        "entry_id": "87181523-fe6b-3992-a151-be04c903d188",
                        "glosses": [
                            "Vertreter der Pflanzengattung der „Frauenhaarfarne“ (fachsprachlich: Adiantum)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb28076-2b28-4713-8e45-aed3c63836d1",
                                "sense_id": "ed1d60f5-4adb-3649-ab31-94c7c9c31b98",
                                "text": "„Kennzeichnendes Merkmal der Gattung Frauenhaarfarne ist der umgeschlagene Blattrand, der die Sori bedeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3c6fb34f-dad5-30da-bb5e-49ad65b2bf71",
                        "entry_id": "87181523-fe6b-3992-a151-be04c903d188",
                        "glosses": [
                            "Vertreter der Farnart „Frauenhaarfarn“ (fachsprachlich: Adiantum capillus-veneris) aus der Gattung der Frauenhaarfarne (Adiantum)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38768637-6c0d-4abb-8c27-b68808f48a1e",
                                "sense_id": "3c6fb34f-dad5-30da-bb5e-49ad65b2bf71",
                                "text": "„Da gibt es den Jochblattbalsambaum (Commiphora multijuga), mit dem zierlich hängenden Laub, das an Frauenhaarfarn erinnert und der auch im blattlosen Zutand an dem schönen glatten weinroten Stamm leicht zu erkennen ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
