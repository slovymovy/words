                    {
                        "translation_id": "290bb4bf-f4ad-4231-b4d2-a4100f6afdea",
                        "source_entry_id": "0216bcaf-ad49-3eac-a914-1ac7af267976",
                        "source_sense_description": "hospitalizing of a patient",
