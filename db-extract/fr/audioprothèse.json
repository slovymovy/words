                    {
                        "sense_id": "ce4eaf7f-d602-35ac-8d4f-c367371b3445",
                        "entry_id": "847d94fb-3481-33b2-948e-b199a5c6570a",
                        "glosses": [
                            "Appareillage permettant de compenser les pertes d’audition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58707538-5904-4c3b-a295-1db5daa58109",
                                "sense_id": "ce4eaf7f-d602-35ac-8d4f-c367371b3445",
                                "text": "Depuis l’apparition des nouvelles prothèses numériques, réalisant un véritable traitement du signal acoustique, les performances des audioprothèses se sont considérablement accrues : l’appareil est capable d’amplifier sélectivement la parole au milieu du bruit ambiant, ce qui améliore la compréhension du malentendant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3430cc96-9243-4f1f-84d8-d181a381a205",
                        "source_entry_id": "847d94fb-3481-33b2-948e-b199a5c6570a",
                        "source_sense_id": "ce4eaf7f-d602-35ac-8d4f-c367371b3445",
                        "target_lang_word": "Hörgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hörgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a50bdf69-0527-318f-9843-9084656e8529",
                                        "entry_id": "107d972a-37bc-3ce2-a630-336fb0ccd1a5",
                                        "glosses": [
                                            "Gerät für Hörgeschädigte, um die Hörfähigkeit zu verbessern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad50a7b-97d8-45d6-9362-063b22ff4912",
                                                "sense_id": "a50bdf69-0527-318f-9843-9084656e8529",
                                                "text": "Als ihr Vater sechzig Jahre alt war, brauchte er wegen Hörverlustes ein Hörgerät."
                                            },
                                            {
                                                "example_id": "4465e7a5-53b1-41f4-b256-32a178430641",
                                                "sense_id": "a50bdf69-0527-318f-9843-9084656e8529",
                                                "text": "„Wir sehen Gehhilfen, Hörgeräte, Tablettendosen, zitternde und gleichwohl konzentrierte Hände, die die Medikamente neben dem Besteck ordnen.“"
                                            },
                                            {
                                                "example_id": "2a20f7a3-5a35-40ed-a3ce-6f89592fbf0b",
                                                "sense_id": "a50bdf69-0527-318f-9843-9084656e8529",
                                                "text": "„Erst kürzlich hatte ich mir bei einem Besuch bei meiner Mutter ihre Hörgeräte ausgeborgt und in die Ohren geschoben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
