                                    {
                                        "sense_id": "9fada8fe-c2e4-31ad-a1b3-842e1649562c",
                                        "entry_id": "710fd344-2244-3f82-876d-609aec6f8ebb",
                                        "glosses": [
                                            "Qualifie un être vivant ayant la capacité de changer de forme (ex : loup-garou, changeling, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00ef341a-9530-3ce6-8f2b-3f2d1b8f6306",
                                        "entry_id": "710fd344-2244-3f82-876d-609aec6f8ebb",
                                        "glosses": [
                                            "Se dit d’un virus qui change son algorithme, sans changer sa sémantique, à chaque cycle de reproduction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9d8cad0-102b-4d4c-b1d1-3d79a23a0cac",
                                                "sense_id": "00ef341a-9530-3ce6-8f2b-3f2d1b8f6306",
                                                "text": "Les virus métamorphes sont similaires aux virus polymorphes […] Alors que les différentes formes mutées d’un virus polymorphe partagent le même noyau (en particulier la fonction de mutation), celles d’un virus métamorphe ont chacune un noyau différent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "métamorphe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a8a8676-5b12-3a63-b8db-32b7a7ab5641",
                                        "entry_id": "7faf3a70-3dcb-3b1a-8145-a22fb1fba341",
                                        "glosses": [
                                            "Être métamorphe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34458005-c5d0-4a5c-bf52-7ecaabd7cc33",
                                                "sense_id": "7a8a8676-5b12-3a63-b8db-32b7a7ab5641",
                                                "text": "Si un métamorphe est mis en contact avec ces substances étranges, tirés de plantes provenant de chine, il reprend exactement le visage de son adolescence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b82411b-4aac-3840-b952-f6cced9c7094",
                                        "entry_id": "7faf3a70-3dcb-3b1a-8145-a22fb1fba341",
                                        "glosses": [
                                            "Mot changeant de forme sans changer de sens. Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "818594e4-9dd1-41a1-95df-9241197f6077",
                        "source_entry_id": "97ad2d15-d255-33aa-b2f4-14bcaa0c77a6",
                        "source_sense_description": "creature capable of changing its appearance",
                        "target_lang_word": "Gestaltwandler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gestaltwandler",
