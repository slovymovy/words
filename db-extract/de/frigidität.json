                        ],
                        "examples": [
                            {
                                "example_id": "0a086bb3-4d2a-4a0a-8bff-753cb9e2ae05",
                                "sense_id": "ee6a039c-0099-36dd-99e3-86cef6f888e5",
                                "text": "„Die Einteilung der Frigidität reicht von Frauen, die den Geschlechtsverkehr im Prinzip genießen, aber dabei keinen Orgasmus erreichen können, bis zu Frauen, denen jede sexuelle Aktivität ein Greuel ist.“"
                            },
                            {
                                "example_id": "fe1e11ad-d4bf-4d18-a70d-6ea7b2ace101",
                                "sense_id": "ee6a039c-0099-36dd-99e3-86cef6f888e5",
                                "text": "„Hier geht es um Arm und Reich, und er spielt der Monroe einen Millionär mit Jacht vor, den Millionär schlechthin, nämlich den Shell-Erben, der sich von der Monroe seine durch ein tragisches Erlebnis bedingte Frigidität von der Seele küssen lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
