                "senses": [
                    {
                        "sense_id": "9a4bd802-84ed-3da3-b633-003cd6fdc16a",
                        "entry_id": "f1a9aa45-da7b-3359-bb27-75e290b839e0",
                        "glosses": [
                            "Dans les années 1920-1930, des opposants à l'URSS furent enlevés à l'étranger par la police secrète soviétique et ramenés à Moscou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "976fc6fa-b95c-4091-8fc6-b2ac3e6fb6f5",
                                "sense_id": "9a4bd802-84ed-3da3-b633-003cd6fdc16a",
                                "text": "Tandis qu’ils argumentaient à propos de cette position, Blanc plaidant pour reprendre son coup, je fis du regard le tour de la pièce. Je remarquai le portrait de ce qui avait été dans la passé une famille impériale. Et la moustache d’un célèbre général, moscoué quelques années auparavant."
                            }
                        ]
                    }
