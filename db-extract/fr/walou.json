                    {
                        "sense_id": "fafbd5cc-a5d4-367d-88e3-65aeef66c3cf",
                        "entry_id": "13241fa5-f6ce-378d-89eb-3c93cda63f33",
                        "glosses": [
                            "Rien ; rien du tout."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c5641262-5a42-425e-9f0c-1820802fc47b",
                                "sense_id": "fafbd5cc-a5d4-367d-88e3-65aeef66c3cf",
                                "text": "Au Maroc, walou ! rien, makache ! Je ne vais jamais au cinéma, il n'y a rien. Théâtre ou musique, zéro. Gens à voir, zéro !"
                            },
                            {
                                "example_id": "c9a78227-4297-4142-8d76-0d1f73e8c100",
                                "sense_id": "fafbd5cc-a5d4-367d-88e3-65aeef66c3cf",
                                "text": "Ce miroir ne lui renvoyait pas son visage. Elle voyait bien pourtant les arbres derrière elle, se refléter dans la glace, mais elle, rien, walou !\nLe Korrigan lui expliqua que c'était normal, et Chloé, pensive, acquiesça en se massant le menton, dubitative !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c51cf10f-e840-4217-bfb2-22e19537711e",
                        "source_entry_id": "13241fa5-f6ce-378d-89eb-3c93cda63f33",
