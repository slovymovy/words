                ],
                "senses": [
                    {
                        "sense_id": "833cd86b-f0c2-3d40-999b-58722294e73a",
                        "entry_id": "03b836a6-ae61-3ba8-8e03-1c6bd81e3413",
                        "glosses": [
                            "Stelle, an der ein Fluss in ein anderes Gewässer übergeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33684d83-dc4d-4696-84ba-9aa1bc152d10",
                                "sense_id": "833cd86b-f0c2-3d40-999b-58722294e73a",
                                "text": "An der Flussmündung wendest du dich nach Osten."
                            },
                            {
                                "example_id": "2d667788-dfc1-485a-91e5-eb40d91e1fbc",
                                "sense_id": "833cd86b-f0c2-3d40-999b-58722294e73a",
                                "text": "„Über der Flussmündung hing eine schwarze Wolkenwand, und der stille Wasserweg, der bis zu den äußersten Enden der Erde reicht, strömte düster unter dem bedeckten Himmel dahin – schien hineinzuführen in das Herz einer gewaltigen Finsternis.“"
                            },
                            {
                                "example_id": "6a8e7ca0-ff59-4dab-9b82-dd934ae96f2a",
                                "sense_id": "833cd86b-f0c2-3d40-999b-58722294e73a",
                                "text": "„Und Portugal hat dem Spiel der mächtigen Staaten ohnehin kaum noch etwas entgegenzusetzen – es wird mit einem winzigen Gebiet an der Flussmündung abgespeist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
