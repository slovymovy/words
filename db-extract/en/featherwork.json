                        "glosses": [
                            "A cultural artifact made with feathers."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "de51e6cb-088a-4a04-86bc-0c4c7ad7ebcd",
                                "sense_id": "54ae6ad4-9bd8-3da8-9a94-8dfce60c67c3",
                                "text": "With filigreed Kongo ivories, gilded Qing astrolabes, Brazilian featherwork, Sri Lankan rock-crystal, mother-of-pearl Mughal inlay and life-size Portuguese carvings of angels and saints, it has something even for someone who has seen everything before."
                            },
                            {
                                "example_id": "7af3aead-ee6d-454c-814b-df508839978c",
                                "sense_id": "54ae6ad4-9bd8-3da8-9a94-8dfce60c67c3",
                                "text": "The importation of New World featherworks into Europe was a journey of dilution, degradation and eventual loss of meaning - a banal Disneyfication of indigenous dignity."
                            }
                        ]
                    }
