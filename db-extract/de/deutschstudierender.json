                "senses": [
                    {
                        "sense_id": "69305061-e1b2-3391-a8eb-ac075b68e310",
                        "entry_id": "e4a57435-3c87-3b7b-8557-1f321bd0bf87",
                        "glosses": [
                            "Person, die an einer Hochschule für das Fach Deutsch eingeschrieben ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93ca584a-4a50-41e2-8c45-4557a6d1e7d2",
                                "sense_id": "69305061-e1b2-3391-a8eb-ac075b68e310",
                                "text": "„Beachtung verdient, dass der Anteil der Deutschstudierenden auf Anfängerniveau in den letzten Jahren gestiegen ist.“"
                            },
                            {
                                "example_id": "bc0aa962-0293-4051-958f-cf58d3170601",
                                "sense_id": "69305061-e1b2-3391-a8eb-ac075b68e310",
                                "text": "„40 Deutschabteilungen in China hatten ihre je zweiköpfigen Mannschaften nach Beijing geschickt, um an dem fünften Nationalen Debattierwettbewerb für Deutschstudierende teilzunehmen“"
                            },
                            {
                                "example_id": "cc5edff2-b01c-486b-ac3d-ff7c07f6ad69",
                                "sense_id": "69305061-e1b2-3391-a8eb-ac075b68e310",
                                "text": "„Die fachspezifischen Übungen für Deutschstudierende (Haupt- und Leitfach Deutsch, alte Studienordnung) greifen jene Anforderungen auf, die zusätzlich an Lehrende des Faches Deutsch gestellt werden;…“"
                            },
                            {
                                "example_id": "e0a0ba42-da55-4dc5-9185-6863fc5a4a74",
                                "sense_id": "69305061-e1b2-3391-a8eb-ac075b68e310",
                                "text": "„Diese jungen Deutschstudierenden verfügen aber über gute Sprachkenntnisse und können große Leistungsstärke beweisen, wenn man sie früh entdeckt, betreut und unterstützt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
