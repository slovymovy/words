                "senses": [
                    {
                        "sense_id": "6f6ad63e-16b2-3089-bef1-73e128036a1b",
                        "entry_id": "a257714b-4043-3393-b0af-2f7a4495b243",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "295ea72d-ab06-40a2-9ddb-6f21657b554b",
                                "sense_id": "6f6ad63e-16b2-3089-bef1-73e128036a1b",
                                "text": "Frau Zumkehr ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "017d52e8-efe8-4d09-af6d-00df6b72431c",
                                "sense_id": "6f6ad63e-16b2-3089-bef1-73e128036a1b",
                                "text": "Herr Zumkehr wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1c8e1570-f22c-4900-b2c2-03c14850b60b",
                                "sense_id": "6f6ad63e-16b2-3089-bef1-73e128036a1b",
                                "text": "Die Zumkehrs fahren heute nach Hamburg."
                            },
                            {
                                "example_id": "2ce7c41d-52c1-4653-8a7c-f9f78f56bb0c",
                                "sense_id": "6f6ad63e-16b2-3089-bef1-73e128036a1b",
                                "text": "Der Zumkehr trägt nie die Pullover, die die Zumkehr ihm strickt."
                            },
                            {
                                "example_id": "9d8c43fd-f6fe-451a-a92a-dd44f3f170e2",
                                "sense_id": "6f6ad63e-16b2-3089-bef1-73e128036a1b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zumkehr kommt, geht der Herr Zumkehr.“"
                            },
                            {
                                "example_id": "cb8d27c5-429a-4061-8814-966c286d2f67",
                                "sense_id": "6f6ad63e-16b2-3089-bef1-73e128036a1b",
                                "text": "Zumkehr kommt und geht."
                            },
                            {
                                "example_id": "a97b28f9-5bed-4cb4-855d-ea069fe900ed",
                                "sense_id": "6f6ad63e-16b2-3089-bef1-73e128036a1b",
                                "text": "Zumkehrs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
