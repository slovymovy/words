{
    "word_family": [
        "look",
        "looker",
        "looking",
        "outlook"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c89b0f8-cf51-3d7f-9517-a4ee62a4ee13",
                    "sense_definition": "The act or process of searching for information in a dictionary, encyclopedia, or other reference source.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "information search",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A quick dictionary <w>lookup</w> will help you understand the meaning of this difficult word.",
                            "target_lang_translations": {
                                "ru": "Быстрый <w>поиск</w> в словаре поможет вам понять значение этого трудного слова."
                            }
                        },
                        {
                            "text": "The index is organized alphabetically to make a manual <w>lookup</w> much faster for the reader.",
                            "target_lang_translations": {
                                "ru": "Указатель составлен в алфавитном порядке, чтобы ручной <w>поиск</w> был гораздо быстрее для читателя."
                            }
                        }
                    ],
                    "synonyms": [
                        "search",
                        "reference"
                    ],
                    "common_phrases": [
                        "dictionary lookup",
                        "manual lookup",
                        "quick lookup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс поиска информации в словаре, энциклопедии или другом справочном источнике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поиск",
                                "target_lang_sense_clarification": "информации в справочнике"
                            },
                            {
                                "target_lang_word": "проверка",
                                "target_lang_sense_clarification": "значения или факта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd285710-e3e8-330b-98b0-6d4ebbbd5709",
                    "sense_definition": "An automated attempt to retrieve specific data from a computer database or table.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "information search",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application performs a database <w>lookup</w> every time a user enters their identification number.",
                            "target_lang_translations": {
                                "ru": "Приложение выполняет <w>запрос</w> к базе данных каждый раз, когда пользователь вводит свой идентификационный номер."
                            }
                        },
                        {
                            "text": "My database <w>lookup</w> failed because I misspelled the word in the search query.",
                            "target_lang_translations": {
                                "ru": "Мой <w>поиск</w> в базе данных не удался, потому что я допустил ошибку в слове в поисковом запросе."
                            }
                        }
                    ],
                    "synonyms": [
                        "query",
                        "retrieval"
                    ],
                    "common_phrases": [
                        "database lookup",
                        "table lookup",
                        "failed lookup"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Автоматизированная попытка извлечь определенные данные из компьютерной базы данных или таблицы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрос",
                                "target_lang_sense_clarification": "к базе данных"
                            },
                            {
                                "target_lang_word": "поиск",
                                "target_lang_sense_clarification": "в таблице или базе данных"
                            },
                            {
                                "target_lang_word": "лукап",
                                "target_lang_sense_clarification": "профессиональный жаргон программистов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f55dc171-4f00-3dd9-ab16-de9d88a33e22",
                    "sense_definition": "A common misspelling of the phrasal verb <w>look up</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not <w>lookup</w> words as a single verb; it should be written as two separate words.",
                            "target_lang_translations": {
                                "ru": "Не следует <w>писать lookup</w> как один глагол; это должно писаться как два отдельных слова."
                            }
                        },
                        {
                            "text": "Many students accidentally <w>lookup</w> the answer instead of writing 'look up' correctly.",
                            "target_lang_translations": {
                                "ru": "Многие студенты случайно <w>пишут lookup</w> слитно вместо правильного написания 'look up'."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "misspelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенное ошибочное написание фразового глагола 'look up'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посмотреть",
                                "target_lang_sense_clarification": "ошибочное слитное написание фразового глагола «look up» — найти, посмотреть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}