                    },
                    {
                        "translation_id": "d1680468-11f2-4851-bdee-797118610481",
                        "source_entry_id": "b1c1fb3f-df5a-3d82-be62-83cca254fc80",
                        "source_sense_id": "fb9f72ca-a906-3c9b-b0ed-2e38bf28d6fd",
