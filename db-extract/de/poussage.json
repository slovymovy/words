                "translations": [
                    {
                        "translation_id": "09e3c0b5-40d0-4ce8-b50b-025f4921e5dc",
                        "source_entry_id": "17ce8b7c-9f53-3be7-9048-790c40cb4cdd",
                        "source_sense_id": "161aa503-0918-364c-8aaa-60ba642fb0bb",
                        "source_sense_description": "umgangssprachlich veraltet: meist kurzes, oberflächliches Liebesverhältnis",
                        "target_lang_word": "amour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22012f21-9bff-3039-9a16-d2b36e67dc3f",
                                        "entry_id": "a831770b-a9e4-34cd-bc9e-7c48fb3b0c78",
                                        "glosses": [
                                            "Courtship; flirtation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9f8368f-f6b6-4461-90af-df82326239ad",
                                                "sense_id": "22012f21-9bff-3039-9a16-d2b36e67dc3f",
                                                "text": "Perhaps Daisy never went in for amour at all—and yet there's something in that voice of hers…."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bba3244-edee-3fe9-bec1-2af7180d082e",
                                        "entry_id": "a831770b-a9e4-34cd-bc9e-7c48fb3b0c78",
                                        "glosses": [
                                            "A love affair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00a86cfa-e2b3-4234-aab6-7e6829054e69",
                                                "sense_id": "6bba3244-edee-3fe9-bec1-2af7180d082e",
                                                "text": "Jones had mentioned the Fact of his Amour, and of his being the Rival of Blifil, but had cautiously concealed the Name of the young Lady."
                                            },
                                            {
                                                "example_id": "c7517751-4118-4871-90ff-efb46b52c937",
                                                "sense_id": "6bba3244-edee-3fe9-bec1-2af7180d082e",
                                                "text": "The amours of the greater scaup are, if anything, even more varied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02037f04-51a6-3b2d-afd6-fc44d10da772",
                                        "entry_id": "a831770b-a9e4-34cd-bc9e-7c48fb3b0c78",
                                        "glosses": [
                                            "A lover."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "369b1446-be9f-4b6d-ba42-8c1f0d90fe0d",
                                                "sense_id": "02037f04-51a6-3b2d-afd6-fc44d10da772",
                                                "text": "‘Dulce, will you go to the masquerade-ball to night?’ said I to my lesser-half, on a bright evening during the gayest part of the ‘carnival season.’ / ‘No, my amor,’ answered she; ‘I am ill this evening; do n’t go out to-night, but stay by my side, and let your cheering presence save a doctor’s fee.’"
                                            },
                                            {
                                                "example_id": "3897c995-0226-462b-8e96-6b49e8d8fe9c",
                                                "sense_id": "02037f04-51a6-3b2d-afd6-fc44d10da772",
                                                "text": "Makes you wonder how they were able to see their amours, or their hands..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be05ae56-ca1a-3cb1-b966-c5b2abbeb4a2",
                                        "entry_id": "a831770b-a9e4-34cd-bc9e-7c48fb3b0c78",
                                        "glosses": [
                                            "Love, affection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bdfa413-13ac-4681-8843-ec2645b98bcc",
                        "source_entry_id": "17ce8b7c-9f53-3be7-9048-790c40cb4cdd",
                        "source_sense_id": "a2394492-ccae-34f9-a631-c82e855a999b",
                        "source_sense_description": "umgangssprachlich veraltet, abwertend: Partner in einem kurzen, oberflächlichen Liebesverhältnis",
                        "target_lang_word": "paramour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paramour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c012704b-43ba-3d7d-ab4d-8acef007833a",
                                        "entry_id": "945fd2d7-93fc-308a-96d3-dd6211cd0cf3",
                                        "glosses": [
                                            "An illicit lover, either male or female."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8167de70-5a34-41c2-9e02-86dce554471c",
                                                "sense_id": "c012704b-43ba-3d7d-ab4d-8acef007833a",
                                                "text": "to run away with a paramour"
                                            },
                                            {
                                                "example_id": "08c6737a-4050-438d-ba77-cb80fb2f1a60",
                                                "sense_id": "c012704b-43ba-3d7d-ab4d-8acef007833a",
                                                "text": "The seducer appeared with dauntless front, accompanied by his paramour."
                                            },
                                            {
                                                "example_id": "ae54a1dd-9981-4ba9-a7a0-f79bae508f17",
                                                "sense_id": "c012704b-43ba-3d7d-ab4d-8acef007833a",
                                                "text": "They should be chaste, not lustful, nor taking paramours:"
                                            },
                                            {
                                                "example_id": "cb9a14a4-76ad-4f7d-826f-3a64ba70c19c",
                                                "sense_id": "c012704b-43ba-3d7d-ab4d-8acef007833a",
                                                "text": "The action scenes are deafening and punchily staged by director Louis Letterier (The Transporter), though I wish he’d set more time aside to spend with Nobby, his paramour Dawn (Rebel Wilson), their shaven-headed brood, and friends"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aea4f6f-1462-3df6-9ca7-6c9542d64a7d",
                                        "entry_id": "945fd2d7-93fc-308a-96d3-dd6211cd0cf3",
                                        "glosses": [
                                            "The Virgin Mary or Jesus Christ (when addressed by a person of the opposite sex)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "paramour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd00b15d-62a9-3e3c-8fe6-a920543e3639",
                                        "entry_id": "db06ab2f-f4a9-3efd-95ab-a787206424a5",
                                        "glosses": [
                                            "To go with a paramour; to have an affair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a4aeadd-5efc-495e-a590-e1d39439725b",
                                                "sense_id": "bd00b15d-62a9-3e3c-8fe6-a920543e3639",
                                                "text": "The paramouring matron left / A babe and husband both bereft;"
                                            },
                                            {
                                                "example_id": "53fbaed2-62ef-4be3-b3b6-3c83595c91f4",
                                                "sense_id": "bd00b15d-62a9-3e3c-8fe6-a920543e3639",
                                                "text": "This meant it could even call in \"third party 'paramours'\" and tell them to quit their paramouring."
                                            }
                                        ]
                                    }
                                ]
