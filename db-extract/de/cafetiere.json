                "senses": [
                    {
                        "sense_id": "6f64c622-b604-32aa-89c3-83b0037c26db",
                        "entry_id": "36ef9a57-d6e2-349d-8192-5f282bcbeba7",
                        "glosses": [
                            "Besitzerin eines Kaffeehauses"
                        ],
                        "tags": [
