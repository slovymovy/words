                                        "examples": [
                                            {
                                                "example_id": "75026dfb-4479-4710-b948-2fc009fa8dc9",
                                                "sense_id": "7da6b112-bbb5-3ef1-8cb6-58ff76e60651",
                                                "text": "After several years of study, the Government of Singapore in 1982 decided to implement a comprehensive mass rapid transit (MRT) system."
                                            },
                                            {
                                                "example_id": "bedf4864-52c5-42af-b8c9-4aab45a21598",
                                                "sense_id": "7da6b112-bbb5-3ef1-8cb6-58ff76e60651",
                                                "text": "The origins of the MRT are derived from a forecast by city planners in 1967 which stated the need for a rail based urban transportation system."
                                            },
                                            {
                                                "example_id": "e44b2866-4d22-4218-bb57-a718e2e9dcbd",
                                                "sense_id": "7da6b112-bbb5-3ef1-8cb6-58ff76e60651",
                                                "text": "Bukit Panjang residents will soon enjoy a shorter commuting time to town when Singapore’s latest MRT line, the Downtown Line 2 (DTL2), commences operations on Dec 27."
                                            }
                                        ]
                                    },
