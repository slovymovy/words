                        "source_entry_id": "23f455ee-ddec-3ecb-b349-d541fe722718",
                        "source_sense_id": "08dc51c1-5fdc-3b2e-96e6-a5af91d857af",
                        "source_sense_description": "von Natur aus, natürlicherweise, grundsätzlich, (schon) an sich",
                        "target_lang_word": "grundsätzlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grundsätzlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1400adda-ded6-3483-b1a0-b125a0a9ec8f",
                                        "entry_id": "2d541032-6b8f-33b6-9343-1a8e61bdd66f",
                                        "glosses": [
                                            "die Grundsätze beziehungsweise die feste Meinung einer Person oder Organisation betreffend und daher wichtig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c17b7ec-7256-4297-9af7-398107d279bc",
                                                "sense_id": "1400adda-ded6-3483-b1a0-b125a0a9ec8f",
                                                "text": "Wir müssen die grundsätzlichen Ideen unserer Firma vertreten."
                                            },
                                            {
                                                "example_id": "5a4e4d35-c9da-45ee-8481-9ed3866ebbbc",
                                                "sense_id": "1400adda-ded6-3483-b1a0-b125a0a9ec8f",
                                                "text": "Bevor wir uns mit den unwichtigen Details herumschlagen, sollten wir zuerst mal die grundsätzlichen Fragen klären."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1528d06-f13a-389a-a8ef-0fd3b7580da6",
                                        "entry_id": "2d541032-6b8f-33b6-9343-1a8e61bdd66f",
                                        "glosses": [
                                            "einem Grundsatz folgend, aber in Nebensätzen ad exceptio Ausnahmen zulassend"
                                        ],
                                        "tags": [
                                            "meist adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdb6cf15-5858-4a61-81f7-8d340020de38",
                                                "sense_id": "e1528d06-f13a-389a-a8ef-0fd3b7580da6",
                                                "text": "Ich bin grundsätzlich gegen diesen Vorschlag."
                                            },
                                            {
                                                "example_id": "002e712c-2ae1-4783-9884-da06047ccf84",
                                                "sense_id": "e1528d06-f13a-389a-a8ef-0fd3b7580da6",
                                                "text": "„Die Gäste kennen die Kellnerinnen, die Kellnerinnen ihre Gäste, man nennt sich grundsätzlich beim Vornamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "608306fc-0f79-3ad1-8470-190abad1eccd",
                                        "entry_id": "2d541032-6b8f-33b6-9343-1a8e61bdd66f",
                                        "glosses": [
                                            "einem Grundsatz folgend, aber bestimmte Ausnahmen zulassend"
                                        ],
                                        "tags": [
                                            "meist adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a7ac04c-332e-4360-b2c2-3462df17a71d",
                                                "sense_id": "608306fc-0f79-3ad1-8470-190abad1eccd",
                                                "text": "Dieses Produkt ist grundsätzlich für die Jugendlichen gedacht, kann aber auch für Erwachsene interessant sein."
                                            },
                                            {
                                                "example_id": "4daafd8a-2b18-41b3-be3a-24490131887f",
                                                "sense_id": "608306fc-0f79-3ad1-8470-190abad1eccd",
                                                "text": "„Grundsätzlich gilt, dass Nadelbäume mehr Sauerstoff produzieren als Laubbäume und junge Bäume mehr als alte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
