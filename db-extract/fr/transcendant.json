                    {
                        "form_id": "19ca11be-f3fa-4036-996a-79e2acfe4a23",
                        "entry_id": "5684f5e3-5fd1-30d4-8296-dd01ca4f1dd6",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "transcendante"
                    },
                    {
                        "form_id": "597d5751-10e7-4966-bb8d-2d443484004a",
                        "entry_id": "5684f5e3-5fd1-30d4-8296-dd01ca4f1dd6",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "transcendantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "071dbfe8-025a-3a1b-b279-66fa68feac0c",
                        "entry_id": "5684f5e3-5fd1-30d4-8296-dd01ca4f1dd6",
                        "glosses": [
                            "Qui est élevé, supérieur, qui excelle en son genre, en parlant particulièrement de l’esprit et de certaines choses qui y ont rapport."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb22a4fd-10c6-4e3e-b85a-ed72cef01415",
                                "sense_id": "071dbfe8-025a-3a1b-b279-66fa68feac0c",
                                "text": "Esprit, génie, mérite transcendant. — Cet homme a une vertu transcendante, des qualités transcendantes."
                            }
                        ]
                    },
                    {
                        "sense_id": "61133ba7-8e69-3f16-bd76-70066537b1eb",
                        "entry_id": "5684f5e3-5fd1-30d4-8296-dd01ca4f1dd6",
                        "glosses": [
                            "Qui est remarquable en son genre. — Note d’usage : Il s'emploie surtout dans les phrases négatives."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9e1f8a96-1e2c-4460-acae-7c4ca96736ea",
                                "sense_id": "61133ba7-8e69-3f16-bd76-70066537b1eb",
                                "text": "J’ai vu son dernier film. Ce n’est pas mal, mais ce n’est pas transcendant."
                            },
                            {
                                "example_id": "923e53d0-290a-46da-9c95-49088e54db6c",
                                "sense_id": "61133ba7-8e69-3f16-bd76-70066537b1eb",
                                "text": "Cet expérimentateur de la dernière heure a donc eu 5 morts sur 59 malades, ce qui constitue une « léthalité » — mot plus transcendant que mortalité — de 8, 5 p. 100, tandis que ladite léthalité est de 15 à 18 p. 100 dans les épidémies ordinaires de fièvre typhoïde ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a0fe02c-b7ab-3da5-b9a9-03e72f2d700f",
                        "entry_id": "5684f5e3-5fd1-30d4-8296-dd01ca4f1dd6",
                        "glosses": [
                            "Qui n'est pas de nature algébrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d0bbc6-ec8a-48e0-9f30-0de0f5a8f1df",
                                "sense_id": "1a0fe02c-b7ab-3da5-b9a9-03e72f2d700f",
                                "text": "Mathématiques transcendantes. — Équation, fonction, courbe transcendante."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d8e0faf-b407-3fc9-b21b-b872ea7aea84",
                        "entry_id": "5684f5e3-5fd1-30d4-8296-dd01ca4f1dd6",
                        "glosses": [
                            "Qualifie un nombre complexe, et en particulier un nombre réel, qui n’est pas algébrique."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "2722f4fd-c727-465e-a999-0a0ca4614962",
                                "sense_id": "0d8e0faf-b407-3fc9-b21b-b872ea7aea84",
                                "text": "Les nombres π et e sont transcendants."
                            }
                        ]
                    },
                    {
                        "sense_id": "55da13e6-3038-37d5-8c4c-c03feab5f0bb",
                        "entry_id": "5684f5e3-5fd1-30d4-8296-dd01ca4f1dd6",
                        "glosses": [
                            "Qualifie des attributs ou des qualités qui sont susceptibles d’une très grande généralité, comme « vrai » ou « bon »."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bdfbcfc8-e9f7-3337-884b-f79f844efeed",
                        "entry_id": "5684f5e3-5fd1-30d4-8296-dd01ca4f1dd6",
                        "glosses": [
                            "Qualifie les idées qui dérivent immédiatement de la raison pure, dans la philosophie de Emmanuel Kant."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fbb8ae3a-7724-362f-bd61-dc9a3ffab68d",
                        "entry_id": "5684f5e3-5fd1-30d4-8296-dd01ca4f1dd6",
                        "glosses": [
                            "Qui est au-dessus du monde et supérieur à lui."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "245a739b-affc-4f64-9504-660b3fd87f18",
                                "sense_id": "fbb8ae3a-7724-362f-bd61-dc9a3ffab68d",
                                "text": "On doit se rappeler que […] l'islam insiste sur la communauté, non sur l'individu, et que la croyance religieuse est, en même temps, de ce monde et de l'autre ; autrement dit transcendante ou eschatologique et immanente en une seule et même fois."
                            },
                            {
                                "example_id": "59f7d2bd-f474-41bc-9ec4-78e0e8cb99ad",
                                "sense_id": "fbb8ae3a-7724-362f-bd61-dc9a3ffab68d",
                                "text": "La haine antijuive n'est pas simplement une forme de racisme ou une allophobie ordinaire. Celles-ci sont contingentes, issues de rapports de voisinage, placées sous le signe du quotidien. […]. Mais la haine du Juif est transcendante, elle n'a besoin ni de sa présence ici ni de son existence ailleurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19a980cc-e3e2-4f7f-aa56-e5869d3dae76",
                        "source_entry_id": "5684f5e3-5fd1-30d4-8296-dd01ca4f1dd6",
                        "target_lang_word": "transcendent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transcendent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ac6dfe7-0633-39db-a9dc-05612e6c1ab1",
                                        "entry_id": "061ad924-4a35-34e2-906f-e7edbcf8db16",
                                        "glosses": [
                                            "Surpassing usual limits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1566fd83-a8db-4768-98cc-154cc477b3cd",
                                                "sense_id": "4ac6dfe7-0633-39db-a9dc-05612e6c1ab1",
                                                "text": "In sculpture and in the drama, in Aristophanic farce and in hieratic rituals, in pictorial art and in the stream of literature, the phallus is transcendent."
                                            },
                                            {
                                                "example_id": "b3cd2865-85d0-4623-9669-0740b9ee9a77",
                                                "sense_id": "4ac6dfe7-0633-39db-a9dc-05612e6c1ab1",
                                                "text": "\"One shot. Wars can't be won with just one... oh. Oh my. You utterly transcendent idiots should not have put a transponder there.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88a2af37-ff46-348a-9dcb-7a4639b05209",
                                        "entry_id": "061ad924-4a35-34e2-906f-e7edbcf8db16",
                                        "glosses": [
                                            "Supreme in excellence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf050703-979b-4f79-8cb9-a65d6ef4dda7",
                                                "sense_id": "88a2af37-ff46-348a-9dcb-7a4639b05209",
                                                "text": "Both stood silent, gazing on each other; Walter was actually lost in admiration of Lady Marchmont's transcendent beauty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf8aad68-8b3b-3c7d-a18a-dddc4ee3fe1c",
                                        "entry_id": "061ad924-4a35-34e2-906f-e7edbcf8db16",
                                        "glosses": [
                                            "Beyond the range of usual perception."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c997af1c-7482-33a5-ba92-9465b46b9b94",
                                        "entry_id": "061ad924-4a35-34e2-906f-e7edbcf8db16",
                                        "glosses": [
                                            "Free from constraints of the material world."
                                        ],
                                        "tags": [],
