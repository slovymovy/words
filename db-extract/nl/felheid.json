                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b04a8b00-74d4-3af3-a9f1-7fee3dde4acb",
                                        "entry_id": "561e243b-50c1-3cd3-8ccf-8c63e68e4583",
                                        "glosses": [
                                            "acuteness or acuity."
                                        ],
                                        "tags": [
