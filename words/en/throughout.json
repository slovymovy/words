                },
                {
                    "sense_id": "54b7303e-8536-39e9-86d6-f4a9cdf70ebb",
                    "sense_definition": "During an entire period of time; from the beginning to the end.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extent_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He remained silent <w>throughout</w> and did not answer any questions.",
                            "target_lang_translations": {
                                "ru": "Он молчал <w>всё это время</w> и не отвечал ни на какие вопросы.",
                                "tr": "Süreç <w>boyunca</w> sessiz kaldı ve hiçbir soruya cevap vermedi."
                            }
                        },
                        {
                            "text": "The team played well <w>throughout</w>, maintaining their lead until the end.",
                            "target_lang_translations": {
                                "ru": "Команда играла хорошо <w>от начала до конца</w>, сохраняя лидерство до финала.",
                                "tr": "Takım <w>baştan sona</w> iyi oynadı ve sonuna kadar üstünlüğünü korudu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "remained calm throughout",
                        "supported throughout"
                    ],
                    "target_lang_definitions": {
                        "ru": "В течение всего периода времени; от начала до конца.",
                        "tr": "Tüm zaman dilimi boyunca; başından sonuna kadar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всё время",
                                "target_lang_sense_clarification": "постоянно"
                            },
                            {
                                "target_lang_word": "от начала до конца",
                                "target_lang_sense_clarification": "весь период"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "baştan sona",
                                "target_lang_sense_clarification": "süreç boyunca"
                            },
                            {
                                "target_lang_word": "boyunca",
                                "target_lang_sense_clarification": "tüm süreçte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f511f49-8460-336b-b2c4-0654b02caae7",
                    "sense_definition": "Extending to the edge of the field or quarter in a coat of arms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shield featured a red cross <w>throughout</w> on a silver background.",
                            "target_lang_translations": {
                                "ru": "На щите был изображен красный крест <w>до краев</w> на серебряном фоне.",
                                "tr": "Kalkan, gümüş zemin üzerine <w>uçtan uca</w> uzanan kırmızı bir haç içeriyordu."
                            }
                        },
                        {
                            "text": "He described the ancient coat of arms as having a pile <w>throughout</w>.",
                            "target_lang_translations": {
                                "ru": "Он описал старинный герб как имеющий клин, доходящий <w>до краев</w>.",
                                "tr": "Tarihi armayı, <w>kenarlara kadar uzanan</w> bir kazık motifine sahip olarak tanımladı."
                            }
                        }
