                        ]
                    },
                    {
                        "translation_id": "5b65314f-bbb8-4d77-b666-765f98a13e57",
                        "source_entry_id": "752d7492-d5ec-3731-8da7-71d225c1efc1",
                        "source_sense_description": "leadwort",
                        "target_lang_word": "dentelaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dentelaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a08a195e-78a0-3275-9394-d53df8eaeebe",
                                        "entry_id": "e6131ca2-12d0-3187-86e7-87268459f63e",
                                        "glosses": [
                                            "Nom vernaculaire du plumbago d’Europe et d’espèces voisines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26c036ca-853e-42f0-9790-3de81fdd7238",
                                                "sense_id": "a08a195e-78a0-3275-9394-d53df8eaeebe",
                                                "text": "Vlooienkruid, n. [H n.] Herbe aux puces f., plantain pucier ou pulicaire, psyllion m. (Plantago psyllium) ; aunée ou inule pulicaire (Inula pulicaria) ; — pulicaire f. (Pulicaria) ; persicaire f., curage, piment ou poivre d’eau m. (Polygonum hydropiper), herbe au cancer, dentelaire f. (Plumbago europæa), conise ou conyze f. (Conyza). — Chasse-puce, pouliot sauvage m. (Mentha puligium ^([sic]))."
                                            },
                                            {
                                                "example_id": "f5199b4b-5b5b-4b05-9c92-5b449ce6e42f",
                                                "sense_id": "a08a195e-78a0-3275-9394-d53df8eaeebe",
                                                "text": "Nous traiterons ici la dentelaire vivace légèrement arbustive et couvre-sol. Elle ne craint pas le gel et possède de magnifiques fleurs bleu gentiane en été et en automne."
                                            },
                                            {
                                                "example_id": "9d4d0695-37ab-40ef-be91-f1137870e9b9",
                                                "sense_id": "a08a195e-78a0-3275-9394-d53df8eaeebe",
                                                "text": "La racine de dentelaire passait autrefois pour guérir les maux de dents (d'où le nom de la plante). Toxique, on ne l'utilisait que pour l'usage externe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7862f890-ef13-4a59-a87f-0a5c16d56adf",
                        "source_entry_id": "752d7492-d5ec-3731-8da7-71d225c1efc1",
                        "source_sense_description": "leadwort",
                        "target_lang_word": "plumbago",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plumbago",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b8118a1-9614-3b80-b701-b488a394feb8",
                                        "entry_id": "e9c9d85a-a230-3ff6-b0c8-32d5dd52f186",
                                        "glosses": [
                                            "Genre de plantes vivaces plombaginacées, également appelées dentelaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c906b423-d9c7-42ab-8ede-179f9fdfb0f3",
                                                "sense_id": "2b8118a1-9614-3b80-b701-b488a394feb8",
                                                "text": "Plus haut, là où le terrain devenait pentu, les plumbagos prenaient le relais, puis venaient les agapanthes et, enfin, les pieds de lavande."
                                            },
                                            {
                                                "example_id": "14191afb-ec1e-4f2a-a306-338f3448d763",
                                                "sense_id": "2b8118a1-9614-3b80-b701-b488a394feb8",
                                                "text": "Le plumbago, plus connu sous le nom de « Dentelaire du Cap » forme un buisson couvert de fleurs bleu pâle tout au long de l'été."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
