                                        "examples": [
                                            {
                                                "example_id": "6c56e0c3-e0c9-423b-9192-f7edbf92e8ef",
                                                "sense_id": "1017f352-69ae-3dde-9e2b-ae623a1ec823",
                                                "text": "Douleur fulgurante, unilatérale, en éclairs (décharges électriques), dans le territoire d’une ou plusieurs branches du trijumeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc55ea3f-a2d2-315f-81ad-772b6b511c8e",
                                        "entry_id": "85cdfd04-50f2-3cb9-a809-9afb21a12c95",
                                        "glosses": [
