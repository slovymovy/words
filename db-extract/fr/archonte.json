                                        "entry_id": "c4cad1f1-1ab3-3ea9-a66c-b0036aa44d52",
                                        "glosses": [
                                            "πλούσιος άνδρας με θέση κύρους που φέρεται γενναιόδωρα και μεταφορικά όποιος φέρεται με παρόμοιο τρόπο χωρίς απαραιτήτως να είναι εύπορος"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fda9a72-a869-475d-8dc1-06fb3eba6b5f",
                                                "sense_id": "03eb12c5-ed65-3662-8e16-d9d1b78d75c9",
                                                "text": "Ο Κώστας είναι άρχοντας, καθαρός, καλοντυμένος, ευγενής, πάντα κερνάει."
                                            },
                                            {
                                                "example_id": "94d5a7c5-e627-474a-a61c-13a8392771bb",
                                                "sense_id": "03eb12c5-ed65-3662-8e16-d9d1b78d75c9",
                                                "text": "Είναι μισθωτός, αλλά θέλει να ζει σαν άρχοντας."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12b242f1-8615-30c0-a8d7-0286f426d1c8",
                                        "entry_id": "c4cad1f1-1ab3-3ea9-a66c-b0036aa44d52",
                                        "glosses": [
                                            "ο κυβερνήτης μιας περιοχής, ο αξιωματούχος, αριστοκράτης ή ευγενής που δικοικούσε μια περιοχή"
                                        ],
                                        "tags": [
                                            "παρωχημένη σημασία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aa1df01-0eae-472d-a409-18560a50cd8f",
                                                "sense_id": "12b242f1-8615-30c0-a8d7-0286f426d1c8",
                                                "text": "(στην Ελλάδα) τσιφλικάς, προύχοντας, δημογέροντας"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "735ba6a7-9c84-3172-92eb-e5456cf6dc93",
                                        "entry_id": "c4cad1f1-1ab3-3ea9-a66c-b0036aa44d52",
                                        "glosses": [
                                            "επίσημος τίτλος"
                                        ],
                                        "tags": [
                                            "αρχαία Αθήνα"
                                        ],
                                        "examples": [
                                            {
