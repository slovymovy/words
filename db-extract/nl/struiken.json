                "senses": [
                    {
                        "sense_id": "d9fa1f3b-0525-3050-951c-f63c9faa0b7d",
                        "entry_id": "d84ab312-3370-3ce3-a973-ed9c8510cd21",
                        "glosses": [
                            "een struik gaan vormen, dicht bij de grond scheuten of blaadjes krijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fcede45-e0da-4014-b6fb-ef12a1c6e24d",
                                "sense_id": "d9fa1f3b-0525-3050-951c-f63c9faa0b7d",
                                "text": "Door het mooie weer begon het gras al vroeg in het jaar te struiken."
                            },
                            {
                                "example_id": "b8516866-20b6-4069-b4cf-7715c081fd09",
                                "sense_id": "d9fa1f3b-0525-3050-951c-f63c9faa0b7d",
                                "text": "Er waren geen zichtbare remsporen, dus na een kort onderzoek concludeerden de instanties dat de automobilist de waarheid sprak en dat ze opeens tussen de struiken was opgedoken en op de weg was gaan staan, zodat de automobilist met volle snelheid tegen haar op was geknald."
                            },
                            {
                                "example_id": "38d3ba99-cf54-4848-85ce-53616934422d",
                                "sense_id": "d9fa1f3b-0525-3050-951c-f63c9faa0b7d",
                                "text": "Tegen de middag bereikten we een donker en ontoegankelijk eikenbos met struiken en hoge varens."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7949817-8190-3e26-879d-b2c144492e9e",
                        "entry_id": "d84ab312-3370-3ce3-a973-ed9c8510cd21",
                        "glosses": [
                            "struikelen"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "29b27fe9-a50a-4af2-a386-1db6edfb360f",
                                "sense_id": "e7949817-8190-3e26-879d-b2c144492e9e",
                                "text": "Geen mens is zo wijs, of hij struikt wel op 't gladde ijs."
                            }
                        ]
                    }
                ],
