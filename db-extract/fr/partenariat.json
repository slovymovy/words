        "fr-extract.jsonl": [
            {
                "entry_id": "dcaf2d81-6125-3aa1-b4dd-1d11dd4da20b",
                "word": "partenariat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "17bf4f60-353c-488e-8132-bd47d9379f97",
                        "entry_id": "dcaf2d81-6125-3aa1-b4dd-1d11dd4da20b",
                        "tags": [
                            "plural"
                        ],
                        "form": "partenariats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4dbbb4b-5ce2-3e72-b82f-a08d3c214810",
                        "entry_id": "dcaf2d81-6125-3aa1-b4dd-1d11dd4da20b",
                        "glosses": [
                            "Association de différents intervenants qui, tout en maintenant leur autonomie, acceptent de mettre en commun leurs efforts en vue de réaliser un objectif commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "597bf806-0e7b-465a-8f30-d6780f1106c2",
                                "sense_id": "a4dbbb4b-5ce2-3e72-b82f-a08d3c214810",
                                "text": "Cette année a vu éclore les fruits de projets longuement mûris et discutés, ainsi que d’autres partenariats plus rapidement conclus."
                            },
                            {
                                "example_id": "96892c3e-5047-4f94-8673-4c6a90950432",
                                "sense_id": "a4dbbb4b-5ce2-3e72-b82f-a08d3c214810",
                                "text": "Le partenariat public privé (PPP) est un mode de financement par lequel l’autorité publique fait appel à des prestataires privés pour financer et gérer un équipement assurant ou contribuant au service public."
                            },
                            {
                                "example_id": "41374dfe-43f8-45ed-9cf1-454e7913b06a",
                                "sense_id": "a4dbbb4b-5ce2-3e72-b82f-a08d3c214810",
                                "text": "Certains « youtubeurs » concluent un ou des partenariats commerciaux avec une entreprise en se faisant parrainer ou en valorisant un ou plusieurs de leurs produits…"
                            }
                        ]
                    },
                    {
                        "sense_id": "3f07a96f-a612-3ec1-a5c6-2546e6738b50",
                        "entry_id": "dcaf2d81-6125-3aa1-b4dd-1d11dd4da20b",
                        "glosses": [
                            "partenariat enregistré : Contrat signé entre deux personnes majeures, de même sexe et n’ayant pas de liens de parenté, pour organiser leur vie commune selon des obligations et des droits spécifiques similaire à celles et ceux du mariage."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "088825c3-c716-49ef-9ce5-be505c421b96",
                        "source_entry_id": "dcaf2d81-6125-3aa1-b4dd-1d11dd4da20b",
                        "target_lang_word": "Partnerschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Partnerschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5230870-7170-3d9f-a341-8083f75baa2d",
                                        "entry_id": "a5bf266b-9d37-3186-9b03-1cd18f0c2501",
                                        "glosses": [
                                            "gemeinschaftliche Zusammenarbeit zwischen unterschiedlichen Gruppierungen, Organisationen oder politischen Einrichtungen, die auf mehreren Ebenen wirken kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c60ec95-1f62-49f8-a6ba-8f4849971012",
                                                "sense_id": "f5230870-7170-3d9f-a341-8083f75baa2d",
                                                "text": "Mehrere Umweltgruppen vereinbarten eine Partnerschaft zum Thema Artenschutz."
                                            },
                                            {
                                                "example_id": "d98d7a0e-d0eb-4e7f-8af5-866b97658594",
                                                "sense_id": "f5230870-7170-3d9f-a341-8083f75baa2d",
                                                "text": "„Sylvia wusste nicht, worum sie die beiden am meisten beneidete: die unkomplizierte, alltägliche Partnerschaft, die gemeinsame Liebe zu den Büchern oder die offensichtliche körperliche Intimität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49fadb61-887d-3116-894c-a5bcb7fd5c3d",
                                        "entry_id": "a5bf266b-9d37-3186-9b03-1cd18f0c2501",
                                        "glosses": [
                                            "(Paar-)Beziehung zwischen zwei Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27d76558-b64e-40ea-bcb4-1ce31ec04d0c",
                                                "sense_id": "49fadb61-887d-3116-894c-a5bcb7fd5c3d",
                                                "text": "Eine Form der Partnerschaft zwischen Mann und Frau bildet die Ehe."
                                            },
                                            {
                                                "example_id": "f4b1d80e-ec63-4e48-997b-c7fc655fa5bb",
                                                "sense_id": "49fadb61-887d-3116-894c-a5bcb7fd5c3d",
                                                "text": "„Und gerade Frauen speichern positive oder negative Prognosen in Bezug auf Partnerschaft, Flirt oder Sexleben nicht ausnahmslos unter ‚Quatsch‘ ab.“"
                                            },
                                            {
                                                "example_id": "2fc4b8c7-29bc-4cb9-beee-1a89a5c773f2",
                                                "sense_id": "49fadb61-887d-3116-894c-a5bcb7fd5c3d",
                                                "text": "„Konflikte, so wurde bereits vor Jahren hochgerechnet, steigen nach der Geburt in Partnerschaften um den Faktor neun an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1db7f78f-c35c-37e9-afca-ff422ac47a8f",
                                        "entry_id": "a5bf266b-9d37-3186-9b03-1cd18f0c2501",
                                        "glosses": [
                                            "Gemeinschaft mehrerer natürlicher oder juristischer Personen"
                                        ],
                                        "tags": [
                                            "Rechtswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21541bc8-8f4e-4617-bda6-42d87ea5f60f",
                                                "sense_id": "1db7f78f-c35c-37e9-afca-ff422ac47a8f",
                                                "text": "Die beiden Unternehmen bildeten eine Partnerschaft um gemeinsam den europäischen Markt zu erobern."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
