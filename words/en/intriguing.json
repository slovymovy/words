{
    "word_family": [
        "intrigue",
        "intriguer",
        "intriguingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3e06f0c1-5fd6-3fa5-869a-fe7f4a82b24b",
                    "sense_definition": "Causing a desire to know more; fascinating or mysterious.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "fascinating_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective found an <w>intriguing</w> clue that changed the direction of the investigation.",
                            "target_lang_translations": {
                                "ru": "Детектив обнаружил <w>интригующую</w> улику, которая изменила ход расследования.",
                                "de": "Der Detektiv fand eine <w>faszinierende</w> Spur, die die Richtung der Ermittlung veränderte."
                            }
                        },
                        {
                            "text": "She has an <w>intriguing</w> personality that makes everyone want to talk to her.",
                            "target_lang_translations": {
                                "ru": "У нее <w>интригующая</w> личность, из-за которой всем хочется с ней пообщаться.",
                                "de": "Sie hat eine <w>interessante</w> Persönlichkeit, die bewirkt, dass jeder mit ihr sprechen möchte."
                            }
                        }
                    ],
                    "synonyms": [
                        "fascinating",
                        "interesting",
                        "mysterious",
                        "enigmatic"
                    ],
                    "antonyms": [
                        "boring",
                        "dull",
                        "uninteresting"
                    ],
                    "common_phrases": [
                        "an intriguing idea",
                        "find something intriguing",
                        "most intriguing",
                        "intriguing possibility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий желание узнать больше; увлекательный или таинственный.",
                        "de": "Neugier weckend; faszinierend oder geheimnisvoll."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интригующий",
                                "target_lang_sense_clarification": "вызывающий любопытство"
                            },
                            {
                                "target_lang_word": "увлекательный",
                                "target_lang_sense_clarification": "интересный"
                            },
                            {
                                "target_lang_word": "занимательный",
                                "target_lang_sense_clarification": "любопытный"
                            },
                            {
                                "target_lang_word": "захватывающий",
                                "target_lang_sense_clarification": "очень интересный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "faszinierend",
                                "target_lang_sense_clarification": "Faszination weckend"
                            },
                            {
                                "target_lang_word": "fesselnd",
                                "target_lang_sense_clarification": "die Aufmerksamkeit packend"
                            },
                            {
                                "target_lang_word": "interessant",
                                "target_lang_sense_clarification": "Neugier weckend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64c1b36e-91a2-3ae9-96ea-4673f8c8d37c",
                    "sense_definition": "Involving oneself in secret plots or schemes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scheming_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>intriguing</w> nobles whispered in the dark corners of the palace.",
                            "target_lang_translations": {
                                "ru": "<w>Интригующие</w> дворяне шептались в темных углах дворца.",
                                "de": "Die <w>intriganten</w> Adligen flüsterten in den dunklen Ecken des Palastes."
                            }
                        },
                        {
                            "text": "He lost his position because of his <w>intriguing</w> nature and lack of loyalty.",
                            "target_lang_translations": {
                                "ru": "Он потерял свою должность из-за своей <w>интриганской</w> натуры и недостатка преданности.",
                                "de": "Er verlor seine Stellung wegen seines <w>intriganten</w> Wesens und mangelnder Loyalität."
                            }
                        }
                    ],
                    "antonyms": [
                        "honest",
                        "open"
                    ],
                    "common_phrases": [
                        "intriguing politicians",
                        "intriguing courtiers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвующий в тайных заговорах или махинациях.",
                        "de": "In geheime Pläne oder Ränkespiele verwickelt; intrigant."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интригующий",
                                "target_lang_sense_clarification": "плетущий интриги"
                            },
                            {
                                "target_lang_word": "интриганский",
                                "target_lang_sense_clarification": "склонный к интригам"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "intrigant",
                                "target_lang_sense_clarification": "Ränke schmiedend"
                            },
                            {
                                "target_lang_word": "ränkesüchtig",
                                "target_lang_sense_clarification": "zu Ränkespielen neigend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "405af882-8a8e-37fd-8bf1-22fd8d55bf4d",
                    "sense_definition": "Having clandestine or illicit romantic affairs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel tells the story of an <w>intriguing</w> woman who scandalized society.",
                            "target_lang_translations": {
                                "ru": "Роман рассказывает историю <w>интригующей</w> женщины, которая шокировала общество.",
                                "de": "Der Roman erzählt die Geschichte einer <w>eine Affäre habenden</w> Frau, die die Gesellschaft schockierte."
                            }
                        },
                        {
                            "text": "Rumors spread quickly about the <w>intriguing</w> couple and their secret meetings.",
                            "target_lang_translations": {
                                "ru": "Слухи об <w>интригующей</w> паре и их тайных встречах распространились быстро.",
                                "de": "Schnell verbreiteten sich Gerüchte über das <w>heimliche Liaisonen pflegende</w> Paar und seine geheimen Treffen."
                            }
                        }
                    ],
                    "antonyms": [
                        "faithful",
                        "chaste"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usage related to illicit intercourse is largely archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий тайные или незаконные романтические связи.",
                        "de": "Heimliche oder unerlaubte Liebschaften führend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интригующий",
                                "target_lang_sense_clarification": "ведущий двойную игру"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "eine Affäre habend",
                                "target_lang_sense_clarification": "heimliche Liebschaften pflegend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee833206-f230-3407-9ef9-c34e71920afa",
                    "sense_definition": "Present participle of <w>intrigue</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mystery is <w>intriguing</w> me more than I expected.",
                            "target_lang_translations": {
                                "ru": "Эта тайна <w>интригует</w> меня больше, чем я ожидал.",
                                "de": "Das Geheimnis <w>fasziniert</w> mich mehr, als ich erwartet hatte."
                            }
                        },
                        {
                            "text": "They were accused of <w>intriguing</w> against the government to seize power.",
                            "target_lang_translations": {
                                "ru": "Их обвинили в том, что они <w>интриговали</w> против правительства с целью захвата власти.",
                                "de": "Sie wurden beschuldigt, gegen die Regierung zu <w>intrigieren</w>, um die Macht zu ergreifen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола intrigue (интриговать).",
                        "de": "Partizip Präsens des Verbs to intrigue (faszinieren / intrigieren)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интригующий",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "faszinierend",
                                "target_lang_sense_clarification": "im Sinne von neugierig machend"
                            },
                            {
                                "target_lang_word": "intrigierend",
                                "target_lang_sense_clarification": "im Sinne von Ränke schmiedend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "503821c0-01f5-32ee-b03c-36bd908c3674",
                    "sense_definition": "The act of making secret plans; plotting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scheming_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>intriguings</w> of the court eventually led to a rebellion.",
                            "target_lang_translations": {
                                "ru": "Постоянные <w>интриги</w> при дворе в конце концов привели к восстанию.",
                                "de": "Die ständigen <w>Intrigen</w> am Hofe führten schließlich zu einer Rebellion."
                            }
                        },
                        {
                            "text": "She grew tired of the petty <w>intriguings</w> among the committee members.",
                            "target_lang_translations": {
                                "ru": "Она устала от мелких <w>интриг</w> среди членов комитета.",
                                "de": "Sie war die kleinlichen <w>Ränkespiele</w> unter den Ausschussmitgliedern leid."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по созданию тайных планов; плетение интриг.",
                        "de": "Das Schmieden geheimer Pläne; Ränkespiel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интриги",
                                "target_lang_sense_clarification": "тайные планы"
                            },
                            {
                                "target_lang_word": "козни",
                                "target_lang_sense_clarification": "злые умыслы"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Intrigen",
                                "target_lang_sense_clarification": "geheime Ränkespiele"
                            },
                            {
                                "target_lang_word": "Ränkespiele",
                                "target_lang_sense_clarification": "hinterhältige Pläne"
                            }
                        ]
                    }
                }
            ]
        }
    ]
