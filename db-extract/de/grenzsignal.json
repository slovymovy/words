                "senses": [
                    {
                        "sense_id": "7468040d-c906-3bae-a1e0-0f4e9fe94b0d",
                        "entry_id": "928c079b-e6ac-31d4-ae0c-475ced3b9f92",
                        "glosses": [
                            "phonetische (lautliche) Erscheinung, die die Grenze - den Anfang oder das Ende - einer sprachlichen Einheit (zum Beispiel eines Wortes) anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e008052b-937c-40aa-9094-470c789248a8",
                                "sense_id": "7468040d-c906-3bae-a1e0-0f4e9fe94b0d",
                                "text": "„Hieraus resultiert auch, dass diese sogenannten harten Einsätze für Deutsche in morphologischer Hinsicht als starkes Grenzsignal wirken, was für das Dänische nicht zutreffend ist, da sich der (phonemisch relevante) Stoßton immer im In- oder Auslaut von Wörtern befindet.“"
                            },
                            {
                                "example_id": "ee2c4a7c-a68f-4d4a-9cb7-90ca3e573f05",
                                "sense_id": "7468040d-c906-3bae-a1e0-0f4e9fe94b0d",
                                "text": "„Grenzsignale können segmental (Laute, Lautkombinationen) oder suprasegmental (Akzent, Pause, Tempo) sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
