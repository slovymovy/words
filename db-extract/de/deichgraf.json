                ],
                "senses": [
                    {
                        "sense_id": "561a269e-799f-3943-9094-38380bd68fca",
                        "entry_id": "f2c0fd43-e42a-3ce3-9330-ecfa632591e3",
                        "glosses": [
                            "Vorsteher eines Deichverbandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "769500c5-5294-4ab1-9cda-ef6910361b18",
                                "sense_id": "561a269e-799f-3943-9094-38380bd68fca",
                                "text": "„Der Deichgraf ist der Vorsteher eines Deichverbandes; dieser errichtete die Deiche und hält sie instand.“"
                            },
                            {
                                "example_id": "336a7a40-aa9c-4377-8552-478baf985ce5",
                                "sense_id": "561a269e-799f-3943-9094-38380bd68fca",
                                "text": "„Eine zentrale Figur in Theodor Storms Erzählung »Der Schimmelreiter« ist der Deichgraf Hauke Haien.“"
                            },
                            {
                                "example_id": "f04a2239-ec84-4120-8bd2-5428e6b2771b",
                                "sense_id": "561a269e-799f-3943-9094-38380bd68fca",
                                "text": "„Meine Mutter schüttelte den Kopf, und der Deichgraf, den massigen Oberkörper über den Tisch beugend: Er muß einschreiten, Jens muß da einschreiten.“"
                            },
                            {
                                "example_id": "3fa480dc-d526-40d8-aa6d-3bf6aa21128a",
                                "sense_id": "561a269e-799f-3943-9094-38380bd68fca",
                                "text": "„Sie haben wohl davon gehört, wie er 1997 die Folgen der großen Oderflut linderte, wie er sich einen Namen als Krisenmanager machte und bald von vielen ‚Der Deichgraf’ genannt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
