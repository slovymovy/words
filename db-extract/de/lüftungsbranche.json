                "senses": [
                    {
                        "sense_id": "29b485d8-8ab0-3d06-aeb4-970151a7f3e3",
                        "entry_id": "fe58b7c9-baa5-3385-b0d2-b47dba07d267",
                        "glosses": [
                            "beruflicher oder unternehmerischer Tätigkeitsbereich mit Lüftungstechnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc00b568-6ad8-4e8c-a0c3-1f61866eeea5",
                                "sense_id": "29b485d8-8ab0-3d06-aeb4-970151a7f3e3",
                                "text": "„Der Fachverband Gebäude-Klima (FGK) hat seinen jährlichen \"Wegweiser durch die Klima- und Lüftungsbranche“ neu aufgelegt.“"
                            },
                            {
                                "example_id": "2af6ba04-5b73-4c1a-b5b8-3cf166d7c564",
                                "sense_id": "29b485d8-8ab0-3d06-aeb4-970151a7f3e3",
                                "text": "„Viele aus der Lüftungsbranche fanden den Weg zu uns!“"
                            },
                            {
                                "example_id": "db051899-c0ed-459b-a7fb-14adef4a8256",
                                "sense_id": "29b485d8-8ab0-3d06-aeb4-970151a7f3e3",
                                "text": "„Zu unseren Stammkunden gehören Unternehmen aus dem Fassadenbau, dem Stahlhallenbau und der Lüftungsbranche.“"
                            },
                            {
                                "example_id": "0067446c-aa91-426c-a207-e482b89d00f7",
                                "sense_id": "29b485d8-8ab0-3d06-aeb4-970151a7f3e3",
                                "text": "„Die Lüftungsbranche zählt als Querschnittstechnologie mit Problemlösekompetenz zu den innovativen und zukunftsträchtigen Wirtschaftszweigen in Deutschland.“"
                            },
                            {
                                "example_id": "9abe4ed3-39fe-4287-97b1-4a76f2141a58",
                                "sense_id": "29b485d8-8ab0-3d06-aeb4-970151a7f3e3",
                                "text": "„Schon lange war der Gedanke in mir, etwas eigenständiges, in der Lüftungsbranche, Bereiche Service, Reparaturen und Instandhaltung zu schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
