{
    "word_family": [
        "quayside"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "713cb301-3b4d-34cd-bef0-f45923e79582",
                    "sense_definition": "A stone or concrete structure built parallel to the bank of a waterway, used for loading and unloading vessels; a wharf.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waterfront_structures",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large cargo ship was safely moored at the <w>quay</w> while workers unloaded the heavy containers.",
                            "target_lang_translations": {
                                "ru": "Большое грузовое судно было благополучно пришвартовано у <w>причала</w>, пока рабочие разгружали тяжелые контейнеры."
                            }
                        },
                        {
                            "text": "We took a pleasant evening walk along the busy <w>quay</w> to watch the fishing boats return to the harbor.",
                            "target_lang_translations": {
                                "ru": "Мы совершили приятную вечернюю прогулку по оживленной <w>набережной</w>, чтобы посмотреть, как рыбацкие лодки возвращаются в гавань."
                            }
                        }
                    ],
                    "synonyms": [
                        "wharf",
                        "pier",
                        "dock"
                    ],
                    "common_phrases": [
                        "along the quay",
                        "busy quay",
                        "stone quay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Каменное или бетонное сооружение, построенное параллельно берегу водного пути, используемое для погрузки и разгрузки судов; набережная или причал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набережная",
                                "target_lang_sense_clarification": "укрепленный берег или улица вдоль него"
                            },
                            {
                                "target_lang_word": "причал",
                                "target_lang_sense_clarification": "сооружение для швартовки судов"
                            },
                            {
                                "target_lang_word": "пристань",
                                "target_lang_sense_clarification": "место для стоянки и причаливания судов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "908b8518-d86c-33c8-8fc0-62b644907bcd",
                    "sense_definition": "To land or tie up a vessel at a quay, especially used in the phrase \"quay up\".",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "docking_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain instructed the crew to <w>quay</w> up before the storm made the harbor waters too rough.",
                            "target_lang_translations": {
                                "ru": "Капитан приказал команде <w>причалить</w> до того, как из-за шторма вода в гавани станет слишком бурной."
                            }
                        },
                        {
                            "text": "It is difficult to <w>quay</w> a vessel of this size without the assistance of a local harbor pilot.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>пришвартовать</w> судно такого размера без помощи местного портового лоцмана."
                            }
                        }
                    ],
                    "synonyms": [
                        "dock",
                        "moor",
                        "tie up"
                    ],
                    "common_phrases": [
                        "quay up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причаливать или швартовать судно у набережной или причала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причаливать",
                                "target_lang_sense_clarification": "подходить и крепиться к причалу"
                            },
                            {
                                "target_lang_word": "швартоваться",
                                "target_lang_sense_clarification": "закреплять судно у причала"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2228763a-b041-3688-a51f-26baac4e7ff3",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Professor <w>Quay</w> to deliver the keynote lecture on maritime history.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили профессора <w>Квея</w> выступить с пленарным докладом по истории мореплавания."
                            }
                        },
                        {
                            "text": "The local library was named in honor of the philanthropist Arthur <w>Quay</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа Артура <w>Квея</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "This is a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Квей",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ba7eb5ba-3464-3a4a-a8fd-f81d12733d76",
                    "sense_definition": "Alternative spelling of <w>qway</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old manuscript, the scribe used the word <w>quay</w> to describe a land that was very distant.",
                            "target_lang_translations": {
                                "ru": "В старинной рукописи писец использовал слово quay для описания земли, которая была очень <w>далёкой</w>."
                            }
                        },
                        {
                            "text": "The traveler journeyed to a <w>quay</w> country far beyond the northern mountains.",
                            "target_lang_translations": {
                                "ru": "Путешественник отправился в <w>далёкую</w> страну далеко за северными горами."
                            }
                        }
                    ],
                    "synonyms": [
                        "far",
                        "distant"
                    ],
                    "antonyms": [
                        "near",
                        "close"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or historical spelling variant."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Альтернативное написание слова qway (далекий, отдаленный)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "далёкий",
                                "target_lang_sense_clarification": "находящийся на большом расстоянии"
                            },
                            {
                                "target_lang_word": "отдалённый",
                                "target_lang_sense_clarification": "далекий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0fd37c9a-e9b1-33c8-85fb-7cc8be8827e0",
                    "sense_definition": "Alternative spelling of <w>qway</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distance_adverbs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arrow flew <w>quay</w> into the forest, making it impossible for the archers to retrieve.",
                            "target_lang_translations": {
                                "ru": "Стрела улетела <w>далеко</w> в лес, так что лучники не смогли её вернуть."
                            }
                        },
                        {
                            "text": "They traveled <w>quay</w> beyond the borders of their homeland to find new pastures.",
                            "target_lang_translations": {
                                "ru": "Они ушли <w>далеко</w> за пределы своей родины в поисках новых пастбищ."
                            }
                        }
                    ],
                    "synonyms": [
                        "far",
                        "afar"
                    ],
                    "antonyms": [
                        "near",
                        "close"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or historical spelling variant."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Альтернативное написание слова qway (далеко, вдали)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "далеко",
                                "target_lang_sense_clarification": "на большое расстояние"
                            },
                            {
                                "target_lang_word": "вдаль",
                                "target_lang_sense_clarification": "в отдаленное место"
                            }
                        ]
                    }
                }
            ]
        }
    ]
