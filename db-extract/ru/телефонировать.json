                                "target_senses": [
                                    {
                                        "sense_id": "f97cca5a-0163-3e76-b558-e9eb779f4945",
                                        "entry_id": "9ac17b31-a90a-393a-9347-56f61caaf164",
                                        "glosses": [
                                            "mithilfe eines Telefons mit jemandem sprechen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e7efb4f-76e9-41b5-8e1f-4ec1bdb2f90a",
                                                "sense_id": "f97cca5a-0163-3e76-b558-e9eb779f4945",
                                                "text": "Sei gefälligst still, ich telefoniere gerade!"
                                            },
                                            {
                                                "example_id": "d90c277b-85ce-4dc7-b44c-9798c07dca0d",
                                                "sense_id": "f97cca5a-0163-3e76-b558-e9eb779f4945",
                                                "text": "Am besten wird es sein, wenn wir morgen noch einmal miteinander telefonieren."
                                            },
                                            {
                                                "example_id": "2bec69c0-b16b-49c0-885f-894e67b7f0cb",
                                                "sense_id": "f97cca5a-0163-3e76-b558-e9eb779f4945",
                                                "text": "In einer fremden Sprache zu telefonieren ist besonders schwierig."
                                            },
                                            {
                                                "example_id": "61b67695-8467-47fe-82fc-94221c52ad81",
                                                "sense_id": "f97cca5a-0163-3e76-b558-e9eb779f4945",
                                                "text": "„Redakteurin und Informant mailten und telefonierten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "34d4bb3a-8ec9-3a42-b1c9-a25e2e12d173",
                                        "entry_id": "9ac17b31-a90a-393a-9347-56f61caaf164",
                                        "glosses": [
                                            "jemandem etwas telefonisch wissen lassen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50b3d6c5-876b-4f57-bfc5-f6f981cce3a1",
                                                "sense_id": "34d4bb3a-8ec9-3a42-b1c9-a25e2e12d173",
                                                "text": "Sie telefonierten ihr die Lage in den besetzten Nachbarorten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "41933da5-9f6d-3c0c-bab3-bd5c3924a2ca",
                                        "entry_id": "9ac17b31-a90a-393a-9347-56f61caaf164",
                                        "glosses": [
                                            "mit jemandem telefonisch in Verbindung treten"
                                        ],
                                        "tags": [
                                            "Swiss Standard German",
                                            "especially",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "114800cb-1ea4-4c43-a89c-c08637f205d9",
                                                "sense_id": "41933da5-9f6d-3c0c-bab3-bd5c3924a2ca",
                                                "text": "„Telefonieren Sie unserer Personalabteilung zwecks Vereinbarung einer unverbindlichen Besprechung (auch ausserhalb der Geschäftszeit möglich).“"
                                            }
