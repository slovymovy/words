                {
                    "sense_id": "1e476caf-80b5-3bc0-8fe3-0eaca078b992",
                    "sense_definition": "A system of exercises and breathing control used for health and relaxation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She goes to a <w>yoga</w> class every Tuesday morning.",
                            "target_lang_translations": {
                                "ru": "Она ходит на занятия <w>йогой</w> каждый вторник утром.",
                                "zh": "她每周二早上都去上<w>瑜伽</w>课。"
                            }
                        },
                        {
                            "text": "Practicing <w>yoga</w> helps him relax after work.",
                            "target_lang_translations": {
                                "ru": "Занятия <w>йогой</w> помогают ему расслабиться после работы.",
                                "zh": "练习<w>瑜伽</w>能帮他在下班后放松身心。"
                            }
                        }
