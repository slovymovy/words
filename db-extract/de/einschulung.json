                ],
                "senses": [
                    {
                        "sense_id": "d6def0f5-037e-38c7-9033-97172f1bfca8",
                        "entry_id": "d0537be1-d710-35a1-b853-f46729535a52",
                        "glosses": [
                            "Aufnahme eines Kindes in eine Schule; insbesondere die erste Aufnahme in die Grundschule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e80ffc7-2b1f-459d-b537-500f93ecfbd6",
                                "sense_id": "d6def0f5-037e-38c7-9033-97172f1bfca8",
                                "text": "Ich kann mich noch sehr gut an den Tag meiner Einschulung erinnern."
                            },
                            {
                                "example_id": "574ac2a7-d455-482a-b1ba-371d96d28c56",
                                "sense_id": "d6def0f5-037e-38c7-9033-97172f1bfca8",
                                "text": "Die Einschulungen meiner Geschwister waren sehr schön."
                            },
                            {
                                "example_id": "f0f91437-4a10-4cfa-a5eb-04bbb0025279",
                                "sense_id": "d6def0f5-037e-38c7-9033-97172f1bfca8",
                                "text": "„Vor der Einschulung mußte ich zur Pockenimpfung.“"
                            },
                            {
                                "example_id": "28215722-f86a-40da-ba11-943a6ccf65b2",
                                "sense_id": "d6def0f5-037e-38c7-9033-97172f1bfca8",
                                "text": "„[Primo] Levi (1919-1987) […] wuchs in einem gebildeten Elternhaus mit großer Leidenschaft zur Literatur auf - Primo konnte bereits vor seiner Einschulung lesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e15a6e7d-bd2a-33ac-b04d-cf0f2f3cf752",
                        "entry_id": "d0537be1-d710-35a1-b853-f46729535a52",
                        "glosses": [
                            "Einweisung, Unterweisung in eine neue Tätigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03430081-afc9-4508-8b8a-38cbbd9886b1",
                                "sense_id": "e15a6e7d-bd2a-33ac-b04d-cf0f2f3cf752",
                                "text": "„Die Drohnen, die durch einen Elektromotor angetrieben werden, sind nach einer kurzen Einschulung einfach zu bedienen.“"
                            },
                            {
                                "example_id": "fcea67e6-8c61-45a9-b34a-32aa573de298",
                                "sense_id": "e15a6e7d-bd2a-33ac-b04d-cf0f2f3cf752",
                                "text": "„Danach absolvierte Bundesminister Andrä Rupprechter eine Harvester-Einschulung am Simulationsgerät.“"
                            },
                            {
                                "example_id": "df44472e-fd30-4ee7-a643-57186b9f076b",
                                "sense_id": "e15a6e7d-bd2a-33ac-b04d-cf0f2f3cf752",
                                "text": "„Die Einschulung gemäß Abs. 2 ist für Betriebswärter gemäß Abs. 4 unabhängig von ihrer Dauer unter der Leitung eines einschulenden Betriebswärters oder von Personen möglich, die ihre Befähigung zur Einschulung auf andere Weise als durch ein Betriebswärterzeugnis nachgewiesen haben.“"
                            },
                            {
                                "example_id": "006e4061-64ed-4c16-b630-662f2cb95db3",
                                "sense_id": "e15a6e7d-bd2a-33ac-b04d-cf0f2f3cf752",
                                "text": "„‚In der Zustellung können wir nicht aufstocken, da würde die Einschulung zu viel Zeit in Anspruch nehmen‘, sagt Post-Sprecher Michael Homola.“"
                            },
                            {
                                "example_id": "8b356491-0810-4f95-91c7-952e2a9c71dd",
                                "sense_id": "e15a6e7d-bd2a-33ac-b04d-cf0f2f3cf752",
                                "text": "„Noch besser ist ein Servicepaket mit Einschulung, Anpassung und Hot-Line […].“"
                            },
                            {
                                "example_id": "ae2c0fbf-a8c9-402f-9e98-aba29a02e4ff",
                                "sense_id": "e15a6e7d-bd2a-33ac-b04d-cf0f2f3cf752",
                                "text": "„Die Software bietet keine Einschulung, um sich in die Aufgabe und den Umgang mit ihr einzuarbeiten.“"
                            },
                            {
                                "example_id": "f54bfb38-f826-4601-a642-7d9789eb198c",
                                "sense_id": "e15a6e7d-bd2a-33ac-b04d-cf0f2f3cf752",
                                "text": "„Die Einschulung bei der Maschine dauert 6 Monate.“"
                            },
                            {
                                "example_id": "aa9a6058-ec19-49fa-b3d7-c04692fd6125",
                                "sense_id": "e15a6e7d-bd2a-33ac-b04d-cf0f2f3cf752",
                                "text": "„‚Durch die jahrelange Zusammenarbeit mit denselben Trainern, sind unsere Bildungsmaßnahmen einheitlich, und es ist keine Einschulung von Externen mehr nötig‘, sagt Alexander Pertele von der Privatbrauerei Stiegl.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
