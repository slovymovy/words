                "senses": [
                    {
                        "sense_id": "7e1d0038-0ecd-3ffd-914d-e0dfc3713afb",
                        "entry_id": "0eea546d-43b7-3fe7-b609-c7380a28ae59",
                        "glosses": [
                            "umocowana w ścianie rama, do której przymocowuje się okna lub drzwi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6462889e-1cdc-43a2-8808-eff0a94d1eea",
                                "sense_id": "7e1d0038-0ecd-3ffd-914d-e0dfc3713afb",
                                "text": "Był wyższy niż futryna i tak silny, że mógłby trolla rozedrzeć na kawałki, czego jednak nigdy nie robił, gdyż był również osobnikiem głęboko moralnym"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cde2ceab-e531-4c0f-9c28-b17e698ea835",
                        "source_entry_id": "0eea546d-43b7-3fe7-b609-c7380a28ae59",
                        "source_sense_id": "7e1d0038-0ecd-3ffd-914d-e0dfc3713afb",
                        "target_lang_word": "doorpost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doorpost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "805d1b59-fe03-3caf-8210-2283914fe907",
                                        "entry_id": "88bf502f-50e4-388d-9719-a84ec2b3e510",
                                        "glosses": [
                                            "Either of the upright posts on either side of a door, which together support a lintel; doorjamb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82eb350f-2949-4872-83c0-57ad41401414",
                                                "sense_id": "805d1b59-fe03-3caf-8210-2283914fe907",
                                                "text": "In every house a he-lamb was to be slain, and its blood to be sprinkled on the doorposts of the house."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4c96faf-7ac5-4b00-8b0b-bb4f9f903dfe",
                        "source_entry_id": "0eea546d-43b7-3fe7-b609-c7380a28ae59",
