                "senses": [
                    {
                        "sense_id": "1c295d44-5d99-3323-ae9f-300ada3282c0",
                        "entry_id": "ed998c89-ce11-30b8-aece-5cd830881bf6",
                        "glosses": [
                            "Joueur ou joueuse de boules."
                        ],
                        "tags": [
                            "Provence",
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "f77584f4-265f-4962-83ea-621513382478",
                                "sense_id": "1c295d44-5d99-3323-ae9f-300ada3282c0",
                                "text": "Les désirs des plus jeunes sont violents et brefs, tandis que les vices des plus âgés ne dépassent pas les associations de boulomanes, les banquets des amicales et les cercles où l'on joue gros jeu sur le hasard des cartes."
                            },
                            {
                                "example_id": "7df6cf9e-4366-4d55-bd24-663238e98b50",
                                "sense_id": "1c295d44-5d99-3323-ae9f-300ada3282c0",
                                "text": "Derrière les vitres, entre les coupes argentées ramenées des stades et le boulomane en faux bronze qui lève le pied et jette la boule."
                            },
                            {
                                "example_id": "333b8253-e4b8-42f2-bb71-f6e6f2060586",
                                "sense_id": "1c295d44-5d99-3323-ae9f-300ada3282c0",
                                "text": "Les terrains vagues du Lazaret sont, tout le monde le sait, fréquentés, pendant toute la semaine, par des boulomanes enragés. Toute la journée les joueurs se réunissent par groupes et engagent de longues parties."
                            }
                        ]
                    }
                ],
