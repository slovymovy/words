{
    "word_family": [
        "decent",
        "indecency",
        "indecent"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d8322bb3-b599-3175-905a-360ea541d5d6",
                    "sense_definition": "The quality of behaving in a way that is considered polite, moral, and socially acceptable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Have you no sense of <w>decency</w>, sir?",
                            "target_lang_translations": {
                                "zh": "先生，您难道一点都不知<w>体面</w>吗？"
                            }
                        },
                        {
                            "text": "He had the <w>decency</w> to apologize for his rude behavior after the meeting.",
                            "target_lang_translations": {
                                "zh": "会议结束后，他还算<w>知礼</w>，为自己的无礼行为道了歉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "propriety",
                        "decorum",
                        "respectability"
                    ],
                    "antonyms": [
                        "indecency",
                        "impropriety"
                    ],
                    "common_phrases": [
                        "sense of decency",
                        "have the decency"
                    ],
                    "target_lang_definitions": {
                        "zh": "符合道德标准、礼貌且合乎社会规范的得体举止或品质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "得体",
                                "target_lang_sense_clarification": "言行举止合乎礼仪与道德"
                            },
                            {
                                "target_lang_word": "体面",
                                "target_lang_sense_clarification": "符合身份或社会期许的尊严与合度"
                            },
                            {
                                "target_lang_word": "正派",
                                "target_lang_sense_clarification": "品行端正、符合道德"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9201ca7d-1269-3d8a-ab4a-a2da0804b0e8",
                    "sense_definition": "A specific action or detail that is considered polite, proper, or appropriate in a given situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She observed all the small <w>decencies</w> of formal dining without hesitation.",
                            "target_lang_translations": {
                                "zh": "她毫不迟疑地遵循了正式晚宴中的所有繁琐<w>礼节</w>。"
                            }
                        },
                        {
                            "text": "The ceremony was stripped of its traditional <w>decencies</w> to save time.",
                            "target_lang_translations": {
                                "zh": "为了节省时间，该仪式省略了传统的各项<w>规矩</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "courtesy",
                        "etiquette"
                    ],
                    "target_lang_definitions": {
                        "zh": "在特定场合中被视为有礼、恰当的礼节、规矩或行为细节（常用复数）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "礼节",
                                "target_lang_sense_clarification": "日常社交或正式场合中的礼貌规范"
                            },
                            {
                                "target_lang_word": "规矩",
                                "target_lang_sense_clarification": "社交或仪式中应当遵循的得体举止"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}