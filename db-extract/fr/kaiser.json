        "fr-extract.jsonl": [
            {
                "entry_id": "ac3d0a3e-e4f3-391b-bd64-e71fc6649eff",
                "word": "kaiser",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dea41365-3a49-453d-8ba9-c466bc9adbfc",
                        "entry_id": "ac3d0a3e-e4f3-391b-bd64-e71fc6649eff",
                        "tags": [
                            "plural"
                        ],
                        "form": "kaisers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fdc96921-97d8-3e4c-8bed-d4c1fa3fd396",
                        "entry_id": "ac3d0a3e-e4f3-391b-bd64-e71fc6649eff",
                        "glosses": [
                            "Empereur du Saint-Empire romain germanique (962-1806) de l'Empire d’Autriche (1806-1918) ou de l'Empire allemand (1871-1918)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98675419-689b-45c9-a98d-30c6682bad75",
                                "sense_id": "fdc96921-97d8-3e4c-8bed-d4c1fa3fd396",
                                "text": "Le président du Conseil témoignait à la même époque de sa fermeté pacifique en ramenant dédaigneusement dans les lignes le kaiser en quête, ou plutôt en velléité d'aventures."
                            },
                            {
                                "example_id": "c87db926-e35e-4b0c-8aea-b0ab0aac3e58",
                                "sense_id": "fdc96921-97d8-3e4c-8bed-d4c1fa3fd396",
                                "text": "L'hôtel avait eu l'honneur d'accueillir le Kaiser qui ne savait pas mettre ses chaussures tout seul, plusieurs grands-ducs, une comtesse allemande dont, à son grand regret, le portier devait taire le nom, bien qu'elle ait laissé en ville un souvenir ineffaçable et, enfin, Anatole France."
                            },
                            {
                                "example_id": "17dad12d-58ae-46c0-840c-fcfad73e7a99",
                                "sense_id": "fdc96921-97d8-3e4c-8bed-d4c1fa3fd396",
                                "text": "Confusion : le kaiser s'est enfui en Hollande, mais le militarisme demeure et les chefs sociaux-démocrates du nouveau régime, républicain, font alliance avec les généraux monarchistes et les corps francs à croix gammée contre les spartakistes."
                            },
                            {
                                "example_id": "5243b5e9-58b8-490a-b715-805bccefd945",
                                "sense_id": "fdc96921-97d8-3e4c-8bed-d4c1fa3fd396",
                                "text": "Le kaiser Joseph II et la tsarine Catherine II, les césars de l'Est, se rapprochaient l'un de l'autre. Le 30 avril, la flotte arriva à Krementchouk, retardée par des vents violents."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2121a16e-2276-494d-93a1-2ccdbd18e141",
                        "source_entry_id": "ac3d0a3e-e4f3-391b-bd64-e71fc6649eff",
                        "source_sense_id": "fdc96921-97d8-3e4c-8bed-d4c1fa3fd396",
                        "target_lang_word": "Kaiser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaiser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c6f6c5a-1cc6-3199-9e2f-1a7f506b8e6d",
                                        "entry_id": "023619df-f45c-33f1-831a-52f873f6f2d0",
                                        "glosses": [
                                            "Titel des höchsten weltlichen Herrschers in bestimmten Monarchien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33d7056-1f91-403e-9971-0047fbfb38b9",
                                                "sense_id": "7c6f6c5a-1cc6-3199-9e2f-1a7f506b8e6d",
                                                "text": "England hat keinen Kaiser, England hat Könige und Königinnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e433de6e-5f73-3385-8652-7b99cb6a1078",
                                        "entry_id": "023619df-f45c-33f1-831a-52f873f6f2d0",
                                        "glosses": [
                                            "Inhaber des Titels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "199c3efe-d613-4283-97f8-93e2f801156e",
                                                "sense_id": "e433de6e-5f73-3385-8652-7b99cb6a1078",
                                                "text": "Der österreichische Kaiser Franz Joseph war beim Volk sehr beliebt."
                                            },
                                            {
                                                "example_id": "0a0c8106-b712-46f7-b93c-aa220b043977",
                                                "sense_id": "e433de6e-5f73-3385-8652-7b99cb6a1078",
                                                "text": "„Daher ist das Verlangen des Paares, sich außerhalb von Wien zu verlustieren, weit weg von dem mürrischen alten Kaiser, nur allzu verständlich.“"
                                            },
                                            {
                                                "example_id": "1f35f45f-4820-45be-a218-e498b8dbb73f",
                                                "sense_id": "e433de6e-5f73-3385-8652-7b99cb6a1078",
                                                "text": "„Der Kaiser kennt keine Parteien mehr, hier steht es schwarz auf weiß, das Land keine Rassen mehr, alle sprechen eine Sprache, alle verteidigen eine Mutter, Deutschland.“"
                                            },
                                            {
                                                "example_id": "b4114a28-881c-4178-8134-1dbd1683948c",
                                                "sense_id": "e433de6e-5f73-3385-8652-7b99cb6a1078",
                                                "text": "„Am 23. Dezember 176 ließen sich der Kaiser und sein Sohn Commodus in Rom mit einem Triumphzug feiern.“"
                                            },
                                            {
                                                "example_id": "2d88e7e0-1fb2-459e-946b-d6cda24c6742",
                                                "sense_id": "e433de6e-5f73-3385-8652-7b99cb6a1078",
                                                "text": "„Der Kaiser hatte seine Nordlandfahrt abgebrochen und war auf dem Weg zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kaiser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "031b4c67-c9f6-30ce-aae6-06e8cb001bb0",
                                        "entry_id": "d85a3b92-e86a-3cd1-9359-8837bc305d3f",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce07418-f4ae-456b-9029-91b66bca9b30",
                                                "sense_id": "031b4c67-c9f6-30ce-aae6-06e8cb001bb0",
                                                "text": "Die neuen Nachbarn heißen Kaiser, wusstest du das schon?"
                                            },
                                            {
                                                "example_id": "42fcd93b-6efd-4d04-9786-9884ead0da20",
                                                "sense_id": "031b4c67-c9f6-30ce-aae6-06e8cb001bb0",
                                                "text": "Frau Kaiser ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "bdf5e1e1-5d9d-47fd-be8c-54e3fc1431e0",
                                                "sense_id": "031b4c67-c9f6-30ce-aae6-06e8cb001bb0",
                                                "text": "Herr Kaiser wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "8d69016d-9f90-45ab-8e39-c01fe81c36f5",
                                                "sense_id": "031b4c67-c9f6-30ce-aae6-06e8cb001bb0",
                                                "text": "Die Kaisers fliegen heute nach Bali."
                                            },
                                            {
                                                "example_id": "e4b4d112-dec7-4ed0-88cf-14522f2247d2",
                                                "sense_id": "031b4c67-c9f6-30ce-aae6-06e8cb001bb0",
                                                "text": "Der Kaiser trägt nie die Pullover, die die Kaiser ihm strickt."
                                            },
                                            {
                                                "example_id": "b3bdce00-a79f-4984-a036-c41d01494e82",
                                                "sense_id": "031b4c67-c9f6-30ce-aae6-06e8cb001bb0",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kaiser kommt, geht der Herr Kaiser.“"
                                            },
                                            {
                                                "example_id": "b4b50c05-8eb6-434b-abeb-d39834698359",
                                                "sense_id": "031b4c67-c9f6-30ce-aae6-06e8cb001bb0",
                                                "text": "Kaiser kommt und geht."
                                            },
                                            {
                                                "example_id": "60e4dbff-b9e6-4bb1-a6cd-16184e67b655",
                                                "sense_id": "031b4c67-c9f6-30ce-aae6-06e8cb001bb0",
                                                "text": "Kaisers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfd9e857-2a23-447d-b401-2ab9191448f7",
                        "source_entry_id": "ac3d0a3e-e4f3-391b-bd64-e71fc6649eff",
                        "source_sense_id": "fdc96921-97d8-3e4c-8bed-d4c1fa3fd396",
                        "target_lang_word": "Kaiser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaiser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93f94e42-52ac-3752-861b-fc8e2e01be80",
                                        "entry_id": "b131998b-e34a-3a69-9e52-f8e03e8500b2",
                                        "glosses": [
                                            "An emperor of a German-speaking country, particularly the Holy Roman Empire (962–1806), the Austrian Empire/Austria-Hungary (1806–1918), or the German Empire (1871–1918) — often specifically Wilhelm II."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb3ac1f3-4e40-36c0-b248-e1ddd5014206",
                                        "entry_id": "b131998b-e34a-3a69-9e52-f8e03e8500b2",
                                        "glosses": [
                                            "Any emperor or autocrat, or one who attempts to be one."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f3a3a8-bcf5-4281-a350-7f879a434c30",
                                                "sense_id": "bb3ac1f3-4e40-36c0-b248-e1ddd5014206",
                                                "text": "And Black Ivo is a veritable Kaiser."
                                            },
                                            {
                                                "example_id": "98c96a1a-988f-4498-813e-18ed4b799880",
                                                "sense_id": "bb3ac1f3-4e40-36c0-b248-e1ddd5014206",
                                                "text": "[…] that President Poincare, the first servant of France, is still Louis XIV, the former War-Lord, the Kaiser of France […]"
                                            },
                                            {
                                                "example_id": "53000d4c-0878-40da-b3fe-32b9564f5748",
                                                "sense_id": "bb3ac1f3-4e40-36c0-b248-e1ddd5014206",
                                                "text": "Senator Sherman vigorously assailed the Shantung agreement, declaring that it would make the Mikado a veritable Kaiser of the Far East and alienate the sympathies of the 400,000,000 Chinese – from the people of the United States."
                                            },
                                            {
                                                "example_id": "23a2360c-deca-4fd7-9f9d-0b2d6e22f6ec",
                                                "sense_id": "bb3ac1f3-4e40-36c0-b248-e1ddd5014206",
                                                "text": "[…] which, from the banking point of view, the National City Bank is a veritable kaiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8438d5f3-d43a-3ba1-981b-fe6c253e7fd5",
                                        "entry_id": "b131998b-e34a-3a69-9e52-f8e03e8500b2",
                                        "glosses": [
                                            "A Kaiser roll: a round, pinwheel-shaped roll."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
