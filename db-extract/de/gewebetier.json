                "senses": [
                    {
                        "sense_id": "f096b3c9-b949-35c0-8024-c6f9c1e0b7ec",
                        "entry_id": "155606ae-4871-32a5-b7a2-480ef1a3450a",
                        "glosses": [
                            "hypothetisches Taxon in der Systematik der vielzelligen Tiere, mit Ausnahme der Schwämme und der Placozoa"
                        ],
                        "tags": [
                            "Singular selten"
                        ],
                        "examples": [
                            {
                                "example_id": "3f25220f-9920-4bc2-9481-201fc9485b07",
                                "sense_id": "f096b3c9-b949-35c0-8024-c6f9c1e0b7ec",
                                "text": "„Das Unterreich der Urtiere und das Unterreich der Gewebetiere. Das Unterreich der Gewebetiere wird dann weiter aufgeteilt in Stämme, zum Beispiel den Stamm der Plattwürmer, den der Gliederfüßer oder den der Wirbeltiere.“"
                            },
                            {
                                "example_id": "1fca1b43-9cca-4575-a756-393923f2d0f3",
                                "sense_id": "f096b3c9-b949-35c0-8024-c6f9c1e0b7ec",
                                "text": "„Die anderen neu auftretenden Stämme gehören alle zur Abteilung der Eumetazoa oder Gewebetiere, d. h. Mehrzeller mit schon hochspezialisierten Organen […].“"
                            },
                            {
                                "example_id": "87522af2-3c5c-40cf-8b6c-82147f18af3f",
                                "sense_id": "f096b3c9-b949-35c0-8024-c6f9c1e0b7ec",
                                "text": "„Wir haben gesehen, daß die erste Stufe zum Gewebetier, die Gitterkugel Volvox, rund wie ein Hühnerei ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
