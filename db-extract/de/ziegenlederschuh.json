                        "examples": [
                            {
                                "example_id": "23f01eff-fe9a-4e13-865a-61cd4f90dc38",
                                "sense_id": "e83fb52c-f72f-3648-b700-7b475f1c2c9c",
                                "text": "„Neal tauschte seinen Morgenmantel gegen die Kleidung des geheimnisvollen Mr Frazier: eine braune Hose, ein hellblaues Sporthemd und Ziegenlederschuhe.“"
                            },
                            {
                                "example_id": "56988501-ec66-47a5-8f7c-e531e27d49aa",
                                "sense_id": "e83fb52c-f72f-3648-b700-7b475f1c2c9c",
                                "text": "„Auf einem Rohrstuhl saß ein alter Mann in einem staubigen schwarzen Frack. Gestreifte Hosen und graue Weste. Schwarze, knöchelhohe Ziegenlederschuhe und Englischleder-Gamaschen mit Perlmuttknöpfen.“"
                            }
                        ],
