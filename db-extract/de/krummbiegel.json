                "senses": [
                    {
                        "sense_id": "f0081cb3-24e1-3aa4-9b78-55abf651ffff",
                        "entry_id": "d3d5a2fd-b45a-3e02-b887-52dd7f78d18a",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "852a5518-79d8-4b10-b6f9-10357b0ddc7f",
                                "sense_id": "f0081cb3-24e1-3aa4-9b78-55abf651ffff",
                                "text": "Frau Krummbiegel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6f99496c-a715-4da1-a9fd-f37e46b2f9bc",
                                "sense_id": "f0081cb3-24e1-3aa4-9b78-55abf651ffff",
                                "text": "Herr Krummbiegel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0d243053-1932-48ec-ae82-d9102a2350e7",
                                "sense_id": "f0081cb3-24e1-3aa4-9b78-55abf651ffff",
                                "text": "Die Krummbiegels kommen heute aus dem Fichtelgebirge."
                            },
                            {
                                "example_id": "a06fac0d-6b14-4213-91c0-528cc73007df",
                                "sense_id": "f0081cb3-24e1-3aa4-9b78-55abf651ffff",
                                "text": "Der Krummbiegel trägt nie die Schals, die die Krummbiegel ihm strickt."
                            },
                            {
                                "example_id": "75f9e868-1798-423a-ba12-6d69d68f126e",
                                "sense_id": "f0081cb3-24e1-3aa4-9b78-55abf651ffff",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Krummbiegel kommt, geht der Herr Krummbiegel.“"
                            },
                            {
                                "example_id": "6cc50f1f-488b-458a-8c0d-4d6bb30a9d9d",
                                "sense_id": "f0081cb3-24e1-3aa4-9b78-55abf651ffff",
                                "text": "Krummbiegel kommt und geht."
                            },
                            {
                                "example_id": "a473aa99-3117-4c76-b76a-1b385c162665",
                                "sense_id": "f0081cb3-24e1-3aa4-9b78-55abf651ffff",
                                "text": "Krummbiegels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
