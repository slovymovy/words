                        "examples": [
                            {
                                "example_id": "2592b181-9931-4dcc-b919-63ceed357cd2",
                                "sense_id": "b4e5d622-12de-3e99-9641-5462d5aa6df1",
                                "text": "Cirkelspeelster Yvette Broch blikt vooruit op de halve finale tegen Polen op het WK handbal in Denemarken."
                            },
                            {
                                "example_id": "4bd2f2d4-1376-48f5-b9b6-489b41640d07",
                                "sense_id": "b4e5d622-12de-3e99-9641-5462d5aa6df1",
                                "text": "De wapens van Nederland zijn vooral snelheid en het team. \"Daar kunnen we ons voordeel mee doen\", zegt cirkelspeelster Dannick Snelder. Russische handbalsters lijken soms net robots die vaak als individuen opereren. Opdrachten worden uitgevoerd zoals de bondscoach het eist. Zonder franje en vooral zonder emotie speelt Rusland op de automatische piloot zijn wedstrijden."
                            },
                            {
                                "example_id": "d5338fdf-4de9-45a9-80b5-08149e01adbb",
                                "sense_id": "b4e5d622-12de-3e99-9641-5462d5aa6df1",
                                "text": "Cirkelspeelster Yvette Broch is weliswaar nog niet helemaal hersteld van haar kwetsuur, maar zij kan met pijnstillers gewoon aantreden. \"Je voelt de gretigheid en de honger in de groep. We hebben er gewoon zin in.\""
                            }
                        ]
                    }
