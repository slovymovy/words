                    {
                        "translation_id": "1435253f-dcf6-4ed5-a00c-3ac664e67e24",
                        "source_entry_id": "de35b5ab-a9fc-3100-8e0d-575aaa2666e9",
                        "source_sense_id": "3c6df1ea-c46e-32d9-bee9-c026bba1fbe7",
                        "source_sense_description": "Frau, die noch kein Kind geboren hat",
                        "target_lang_word": "nullipara",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nullipara",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3917f33a-60dc-3aa3-882b-29297b62b397",
                                        "entry_id": "e7ec7083-7354-39e7-b809-6b115cc77229",
                                        "glosses": [
                                            "A woman who has never carried a pregnancy beyond 20 weeks (one who has never given birth). It includes women who have experienced spontaneous miscarriages and induced abortions before the mid-point of pregnancy, but not women who have experienced pregnancy loss after 20 weeks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce99d0eb-38e5-437b-88e6-329a5ef4e5b7",
                                                "sense_id": "3917f33a-60dc-3aa3-882b-29297b62b397",
                                                "text": "The active phase of labour lasts on average 8 hours for the nullipara and 6 hours for the multipara."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4186dcc8-9dde-4ab8-90c1-9490b1778c85",
                        "source_entry_id": "de35b5ab-a9fc-3100-8e0d-575aaa2666e9",
                        "source_sense_id": "3c6df1ea-c46e-32d9-bee9-c026bba1fbe7",
                        "source_sense_description": "Frau, die noch kein Kind geboren hat",
                        "target_lang_word": "nullipare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nullipare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "948f6d52-4357-3f52-ba84-eae184b4de7b",
                                        "entry_id": "5c56bd38-00ba-3607-8b22-40c7abde2cd3",
                                        "glosses": [
                                            "Qui n'a jamais accouché ou mis bas."
                                        ],
                                        "tags": [
                                            "Reproduction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "928f2008-b8ba-4824-88bf-fa49e8d4ed51",
                                                "sense_id": "948f6d52-4357-3f52-ba84-eae184b4de7b",
                                                "text": "Une quatrième geste nullipare est une femme enceinte pour la quatrième fois mais dont les trois premières grossesses n'ont pas abouti à un enfant."
                                            },
                                            {
                                                "example_id": "d96cea62-f28c-4cbc-ae44-620a21d344c5",
                                                "sense_id": "948f6d52-4357-3f52-ba84-eae184b4de7b",
                                                "text": "S'il n'est pas question de remettre en cause le principe de l'anonymat et de la gratuité, le Parlement pourrait alléger le dispositif et l'étendre aux femmes nullipares."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nullipare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ae49e70-a18b-3694-ac50-c55630757fe4",
                                        "entry_id": "f3bd0bf6-20bb-3ec7-8916-2f25f37a4f71",
                                        "glosses": [
                                            "Femme qui n'a jamais mis bas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9522df8-1868-4540-8de9-7fd700814eab",
                                                "sense_id": "0ae49e70-a18b-3694-ac50-c55630757fe4",
                                                "text": "Le stérilet n’est pas contre-indiqué chez une nullipare."
                                            },
                                            {
                                                "example_id": "dfa41e6a-abca-4af5-91f3-733fba4b7fc5",
                                                "sense_id": "0ae49e70-a18b-3694-ac50-c55630757fe4",
                                                "text": "Longtemps réservé aux femmes ayant déjà eu des enfants, le DIU peut aujourd’hui être proposé aux nullipares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
