                "senses": [
                    {
                        "sense_id": "fe85d102-f039-335e-9049-009006ba60d3",
                        "entry_id": "e3f93446-33f4-3efe-8881-0c9268b987ef",
                        "glosses": [
                            "Variante rare du verbe shampouiner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cf1e7b7-102c-4b7a-8f54-0bd05110c589",
                                "sense_id": "fe85d102-f039-335e-9049-009006ba60d3",
                                "text": "Elle s’avance vers moi, me prend la main et nous nous dirigeons vers la cabine de douche, règle l’eau à bonne température puis me pousse dessous, elle me mouille, me shampoigne la tête, ça mousse et ça pique les yeux."
                            },
                            {
                                "example_id": "c2aab935-59eb-41fa-8037-8dba78ddbee6",
                                "sense_id": "fe85d102-f039-335e-9049-009006ba60d3",
                                "text": "Mais déjà une voix me shampoigne les oreilles : — Vous allez loin, comme ça ?"
                            }
                        ]
                    }
                ],
