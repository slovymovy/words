    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "49c8d18f-9381-396d-8cf2-9c3b496b1dbd",
                    "sense_definition": "przerwać połączenie czegoś ze źródłem zasilania lub inną całością",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fizyczne rozdzielenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyjściem z domu muszę <w>odłączyć</w> żelazko od prądu.",
                            "target_lang_translations": {
                                "en": "Before leaving the house, I must <w>unplug</w> the iron from the power outlet."
                            }
                        },
                        {
                            "text": "Technik przypadkowo <w>odłączył</w> kabel zasilający podczas naprawy komputera.",
                            "target_lang_translations": {
                                "en": "The technician accidentally <w>disconnected</w> the power cable while repairing the computer."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozłączyć",
                        "wyłączyć"
                    ],
                    "antonyms": [
                        "podłączyć",
                        "przyłączyć"
                    ],
                    "common_phrases": [
                        "odłączyć od prądu",
                        "odłączyć od sieci"
                    ],
                    "target_lang_definitions": {
                        "en": "to break a connection to a power source, network, or larger system"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disconnect",
                                "target_lang_sense_clarification": "break an electrical or network connection"
                            },
                            {
                                "target_lang_word": "unplug",
                                "target_lang_sense_clarification": "remove a plug from an electrical socket"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38723734-16a0-34e3-884c-da6de0aec314",
                    "sense_definition": "oddzielić kogoś lub coś od reszty grupy bądź zbiorowości",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fizyczne rozdzielenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gęsta mgła w górach sprawiła, że przewodnik musiał <w>odłączyć</w> słabszych turystów od głównej grupy.",
                            "target_lang_translations": {
                                "en": "Dense fog in the mountains meant that the guide had to <w>separate</w> the weaker hikers from the main group."
                            }
                        },
                        {
                            "text": "Zarząd postanowił <w>odłączyć</w> nierentowny oddział i utworzyć osobną firmę.",
                            "target_lang_translations": {
                                "en": "The board decided to <w>spin off</w> the unprofitable division and create a separate company."
                            }
                        }
                    ],
                    "synonyms": [
                        "odseparować",
                        "odizolować",
                        "oddzielić"
                    ],
                    "antonyms": [
                        "przyłączyć",
                        "dołączyć"
                    ],
                    "common_phrases": [
                        "odłączyć od grupy"
                    ],
                    "target_lang_definitions": {
                        "en": "to separate someone or something from the rest of a group or collective"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "separate",
                                "target_lang_sense_clarification": "divide from a group or larger whole"
                            },
                            {
                                "target_lang_word": "detach",
                                "target_lang_sense_clarification": "remove or unfasten from an organization or group"
                            },
                            {
                                "target_lang_word": "isolate",
                                "target_lang_sense_clarification": "keep apart from others"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}