                    "frequency": "Middle",
                    "semantic_group_id": "securite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>patrouille</w> de police surveille les abords de la gare chaque soir."
                        },
                        {
                            "text": "Les soldats ont croisé une <w>patrouille</w> ennemie lors de leur mission dans la forêt."
                        }
                    ],
                    "synonyms": [
