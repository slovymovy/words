        "nl-extract.jsonl": [
            {
                "entry_id": "74f37e2b-f9c1-3bf4-8204-3c8374f101a7",
                "word": "afhangend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9ada43a2-07fd-3051-b691-45d56818601d",
                        "entry_id": "74f37e2b-f9c1-3bf4-8204-3c8374f101a7",
                        "glosses": [
                            "naar beneden hangend; naar beneden gaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75c12214-095a-42d2-bdaf-a5913cb66507",
                                "sense_id": "9ada43a2-07fd-3051-b691-45d56818601d",
                                "text": "Volgens Staatsbosbeheer zijn de veldwespen sociaal en leven ze in vrij kleine volken. Ze vallen tijdens hun vlucht op door de naar achter afhangende poten. De wesp vestigde zich voornamelijk rond de Zuid-Limburgse mergelgroeves."
                            },
                            {
                                "example_id": "8a24e5e0-a62e-4519-b34c-592be666328a",
                                "sense_id": "9ada43a2-07fd-3051-b691-45d56818601d",
                                "text": "Toen Astrid erachter kwam dat het schilderij weg was, moest ze wel even huilen. Ze kreeg het ooit van haar oudtante en het betekent heel veel voor haar. ,,Ik heb eigenlijk helemaal niets van mijn familie, dit is het enige. Ik herkende mezelf in de vrouw op het schilderij. Een slanke vrouw met afhangende schouders, dat heb ik ook. Het had gewoon niet verkocht mogen worden\", vertelde ze geëmotioneerd aan NHNieuws."
                            },
                            {
                                "example_id": "7503b64e-2aea-4112-9dbf-a1bee33d8679",
                                "sense_id": "9ada43a2-07fd-3051-b691-45d56818601d",
                                "text": "Halfgesloten ogen, dunne lippen en afhangende mondhoeken."
                            }
                        ]
                    }
                ],
