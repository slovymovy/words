                ],
                "senses": [
                    {
                        "sense_id": "517aa353-d8cb-35af-8635-247eaf076829",
                        "entry_id": "cd1cf6ca-2fd6-3b6c-9c22-64372133a66c",
                        "glosses": [
                            "Person, die auf die Seite des Gegners wechselt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef1f1656-bf43-4321-adf0-c115c07a813c",
                                "sense_id": "517aa353-d8cb-35af-8635-247eaf076829",
                                "text": "Ein griechischer Überläufer verriet den Persern, wie sie die Stellung der Spartaner umgehen und diese von hinten angreifen konnten."
                            },
                            {
                                "example_id": "9a552a41-06a5-484c-8230-0c99be94c5cc",
                                "sense_id": "517aa353-d8cb-35af-8635-247eaf076829",
                                "text": "„Meine Meldung von den Überläufern schien ihn zu beunruhigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "43e342c6-ecc2-3a5f-a2db-1b241e492318",
                        "entry_id": "cd1cf6ca-2fd6-3b6c-9c22-64372133a66c",
                        "glosses": [
                            "Wildschwein im zweiten Lebensjahr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1163623a-45fe-4f08-a821-09aa5c74152f",
                                "sense_id": "43e342c6-ecc2-3a5f-a2db-1b241e492318",
                                "text": "„Weibliche Überläufer bleiben in der Rotte beim Muttertier (Bache).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14cf3cb7-4b5c-4f63-b042-962ec8f8c008",
                        "source_entry_id": "cd1cf6ca-2fd6-3b6c-9c22-64372133a66c",
                        "source_sense_id": "517aa353-d8cb-35af-8635-247eaf076829",
                        "source_sense_description": "Person, die auf die Seite des Gegners wechselt",
                        "target_lang_word": "turncoat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turncoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5d2b23e-b357-3957-8b68-273ab89add9f",
                                        "entry_id": "b208e81f-6415-3cc9-a21b-005cfe398329",
                                        "glosses": [
                                            "A traitor; one who turns against a previous affiliation or allegiance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79de9f23-f238-452e-92d8-341c334b7c1b",
                                                "sense_id": "f5d2b23e-b357-3957-8b68-273ab89add9f",
                                                "text": "But some will cry Turncoat, and rip up old stories, / How I always pretended to be for the tories: […]"
                                            },
                                            {
                                                "example_id": "736ee5c8-db73-4bde-a6d6-0419cb8811b9",
                                                "sense_id": "f5d2b23e-b357-3957-8b68-273ab89add9f",
                                                "text": "Federal prosecutors say that in addition to turncoat witnesses, they are armed with secretly recorded conversations made in the Camden, N.J., office of Mr. Stanfa's lawyer, Salvatore Avena, who has also been indicted on racketeering charges."
                                            },
                                            {
                                                "example_id": "8f435f41-6759-4f28-8c47-a0c9f5dccb9a",
                                                "sense_id": "f5d2b23e-b357-3957-8b68-273ab89add9f",
                                                "text": "The opposition members chanted slogans against the turncoats and termed the speaker’s attitude as partial. To them the speaker was promoting 'lotacracy' in the province, prompting them to chant 'go Speaker go', and 'lota speaker'."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "turncoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7aff3362-3a13-31c6-9716-6d6e38e0f6c9",
                                        "entry_id": "0042ffa0-12dc-3b3a-8bf1-17d461747be4",
                                        "glosses": [
                                            "To act as a turncoat; to betray"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e1c1e96-d274-4349-ab34-037bafd76e76",
                        "source_entry_id": "cd1cf6ca-2fd6-3b6c-9c22-64372133a66c",
                        "source_sense_id": "517aa353-d8cb-35af-8635-247eaf076829",
                        "source_sense_description": "Person, die auf die Seite des Gegners wechselt",
                        "target_lang_word": "transfuge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transfuge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b59bc458-0ef2-308e-87c5-3675d6237d0f",
                                        "entry_id": "210ddc21-9fca-3470-9497-9648c06398cd",
                                        "glosses": [
                                            "Celui qui, à la guerre, abandonne les troupes dont il fait partie pour passer à l’ennemi."
                                        ],
                                        "tags": [
                                            "Au masculin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29698a94-ecac-41c8-904c-66a57a4a913d",
                                                "sense_id": "b59bc458-0ef2-308e-87c5-3675d6237d0f",
                                                "text": "Ce n’était pas la première fois qu’un officier des troupes auxiliaires se retournait contre l’Empire. Bien sûr, ces transfuges étaient particulièrement dangereux parce qu’ils connaissaient de l’intérieur l’armée contre laquelle ils se battaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f222725-ceed-3de2-b461-13152483a299",
                                        "entry_id": "210ddc21-9fca-3470-9497-9648c06398cd",
                                        "glosses": [
                                            "Personne qui fuit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67a8584d-e894-40cd-9a51-5316f144702a",
                                                "sense_id": "1f222725-ceed-3de2-b461-13152483a299",
                                                "text": "Le transfuge a traversé la frontière maritime en mer Jaune, alors que la plupart de ceux qui fuient la Corée du Nord passent d’abord par la Chine voisine, puis par un pays tiers comme la Thaïlande, avant de rejoindre la Corée du Sud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c4a9d78-8931-373f-aff6-afa26b0bbdfd",
                                        "entry_id": "210ddc21-9fca-3470-9497-9648c06398cd",
                                        "glosses": [
                                            "Quiconque abandonne son parti pour passer dans le parti contraire."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b1955e3-f8c5-3eff-887f-9416566dc86a",
                                        "entry_id": "210ddc21-9fca-3470-9497-9648c06398cd",
                                        "glosses": [
                                            "Défecteur qui livre des secrets et renseignement à celui qui était auparavant son ennemi."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
