                                                "sense_id": "bcf51ab1-f9a7-30a6-af59-1c9b00eb0392",
                                                "text": "The majority of large land mammals are ungulates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6df60b2d-1edc-33a0-963c-238656749cac",
