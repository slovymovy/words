{
    "word_family": [
        "inquiry",
        "inquirer",
        "inquiringly",
        "inquisitive",
        "inquisition"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fda1921c-e39d-37cf-959d-47caa065ed27",
                    "sense_definition": "To ask for information or to seek knowledge about something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "asking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "May I <w>inquire</w> to whom I have the honor of speaking?",
                            "target_lang_translations": {
                                "ru": "Могу ли я <w>осведомиться</w>, с кем имею честь говорить?",
                                "de": "Darf ich <w>mich erkundigen</w>, mit wem ich die Ehre habe zu sprechen?"
                            }
                        },
                        {
                            "text": "She decided to <w>inquire</w> about the price of the antique vase before buying it.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>спросить</w> о цене антикварной вазы перед покупкой.",
                                "de": "Sie beschloss, sich vor dem Kauf nach dem Preis der antiken Vase zu <w>erkundigen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "frain"
                    ],
                    "antonyms": [
                        "answer",
                        "reply",
                        "respond"
                    ],
                    "common_phrases": [
                        "inquire about the price",
                        "inquire within"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запрашивать информацию или стремиться получить знания о чем-либо.",
                        "de": "Um Informationen bitten oder versuchen, Wissen über etwas zu erlangen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осведомляться",
                                "target_lang_sense_clarification": "вежливая форма запроса информации"
                            },
                            {
                                "target_lang_word": "спрашивать",
                                "target_lang_sense_clarification": "узнавать что-либо у кого-либо"
                            },
                            {
                                "target_lang_word": "справляться",
                                "target_lang_sense_clarification": "обращаться за сведениями"
                            },
                            {
                                "target_lang_word": "интересоваться",
                                "target_lang_sense_clarification": "проявлять интерес к информации"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich erkundigen",
                                "target_lang_sense_clarification": "sich höflich nach Informationen oder dem Befinden erkundigen"
                            },
                            {
                                "target_lang_word": "nachfragen",
                                "target_lang_sense_clarification": "um eine Auskunft bitten oder eine Frage stellen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aebad72b-c58f-341e-9629-2600006f7b79",
                    "sense_definition": "To conduct a formal investigation or systematic study into a matter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "investigating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are already <w>inquiring</w> into the incident to find the cause.",
                            "target_lang_translations": {
                                "ru": "Полиция уже <w>расследует</w> инцидент, чтобы выяснить причину.",
                                "de": "Die Polizei <w>untersucht</w> den Vorfall bereits, um die Ursache zu finden."
                            }
                        },
                        {
                            "text": "A special committee was formed to <w>inquire</w> into the allegations of corruption.",
                            "target_lang_translations": {
                                "ru": "Был сформирован специальный комитет для <w>расследования</w> обвинений в коррупции.",
                                "de": "Ein Sonderausschuss wurde gebildet, um die Korruptionsvorwürfe zu <w>untersuchen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "frain"
                    ],
                    "antonyms": [
                        "ignore",
                        "neglect"
                    ],
                    "common_phrases": [
                        "inquire into the matter",
                        "inquire into the cause"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить официальное расследование или систематическое изучение вопроса.",
                        "de": "Eine formelle Untersuchung oder systematische Prüfung einer Angelegenheit durchführen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расследовать",
                                "target_lang_sense_clarification": "проводить официальное следствие"
                            },
                            {
                                "target_lang_word": "наводить справки",
                                "target_lang_sense_clarification": "собирать информацию по делу"
                            },
                            {
                                "target_lang_word": "изучать",
                                "target_lang_sense_clarification": "систематически исследовать вопрос"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "untersuchen",
                                "target_lang_sense_clarification": "einen Sachverhalt oder Vorfall genau prüfen"
                            },
                            {
                                "target_lang_word": "nachforschen",
                                "target_lang_sense_clarification": "intensiv Informationen über etwas sammeln"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dad37e8-4126-3a7e-b92a-2e29bdb08e5a",
                    "sense_definition": "To call or name something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old texts, the region was one that people would <w>inquire</w> by a different name.",
                            "target_lang_translations": {
                                "ru": "В старых текстах этот регион был тем, который люди <w>именовали</w> другим названием.",
                                "de": "In den alten Texten wurde die Region von den Menschen mit einem anderen Namen <w>bezeichnet</w>."
                            }
                        },
                        {
                            "text": "The poet used the term to <w>inquire</w> the ancient lands of his ancestors.",
                            "target_lang_translations": {
                                "ru": "Поэт использовал этот термин, чтобы <w>назвать</w> древние земли своих предков.",
                                "de": "Der Dichter verwendete den Begriff, um die alten Länder seiner Vorfahren zu <w>nennen</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Называть или именовать что-либо (устаревшее).",
                        "de": "Etwas benennen oder bezeichnen (veraltet)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "именовать",
                                "target_lang_sense_clarification": "давать название"
                            },
                            {
                                "target_lang_word": "называть",
                                "target_lang_sense_clarification": "давать имя или обозначение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nennen",
                                "target_lang_sense_clarification": "einen Namen oder eine Bezeichnung geben"
                            },
                            {
                                "target_lang_word": "bezeichnen",
                                "target_lang_sense_clarification": "einen Namen für etwas verwenden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}