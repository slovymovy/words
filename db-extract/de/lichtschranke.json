                        "sense_id": "255c087d-256a-3300-9cd0-20d8233ddee8",
                        "entry_id": "a0e5f095-1a70-398d-9c6d-6e8916d3a11c",
                        "glosses": [
                            "ein System mit offenem Lichtstrahl, das die Unterbrechung dieses Lichtstrahls erkennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c4a44eb-25e7-43da-8a13-62310532e0e7",
                                "sense_id": "255c087d-256a-3300-9cd0-20d8233ddee8",
                                "text": "Die kleine Kolonne hatte einen auf dem Fahrrad deponierten Sprengsatz ausgelöst - indem sie eine Lichtschranke unterbrach."
                            },
                            {
                                "example_id": "0e76fed8-6024-4fbd-99c5-6694fda9e74b",
                                "sense_id": "255c087d-256a-3300-9cd0-20d8233ddee8",
                                "text": "Er kann zum Beispiel im Warenhaus einen Piepton auslösen, wenn er, ohne bezahlt zu haben, an der Kasse vorbei durch eine Lichtschranke geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
