                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad3d74f0-77c2-4129-ab64-526490222afe",
                                                "sense_id": "852c2a31-0240-34b8-a0fc-07a13f49839e",
                                                "text": "„‚Dich scheint es ja ganz schön erwischt zu haben‘, sagte Vera, ‚ich muß rein. Tschüs!‘“"
                                            },
                                            {
                                                "example_id": "fb07fc5c-8b0e-46df-abe2-f3ab4ec85cff",
                                                "sense_id": "852c2a31-0240-34b8-a0fc-07a13f49839e",
                                                "text": "„»Tschüs, Tantchen!« ruft er und verschwindet in der Dunkelheit.“"
