            {
                "entry_id": "47bed829-7081-31c9-8299-0885da435571",
                "word": "metaphysician",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "29b2fb12-889d-414b-a030-790f69c07185",
