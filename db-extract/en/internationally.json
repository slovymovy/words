                            "comparative"
                        ],
                        "form": "more internationally"
                    },
                    {
                        "form_id": "e7f6a829-df3e-498c-9415-3006d85e3440",
                        "entry_id": "2a5f8358-7541-3446-ba2f-94469f07cb3d",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most internationally"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a009e2a-74c2-37da-9524-18a26d155f9e",
                        "entry_id": "2a5f8358-7541-3446-ba2f-94469f07cb3d",
                        "glosses": [
                            "In an international manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e447d855-d0c1-4ed7-81c7-7548212d4ee6",
                                "sense_id": "1a009e2a-74c2-37da-9524-18a26d155f9e",
                                "text": "Internationally, the shipping container had already proven its worth, and by the early 1960s battles were being fought over what their standardised dimensions would be (their expected proliferation was not in question)."
                            },
                            {
                                "example_id": "a8f280d6-5e65-4054-87a0-b50de8fb1a96",
                                "sense_id": "1a009e2a-74c2-37da-9524-18a26d155f9e",
                                "text": "About 1.4 billion people traveled internationally last year, which is 99% of the number who did the same in 2019, the last full year before Covid-19 hit the world."
                            },
                            {
                                "example_id": "b1e34f91-d9be-4fdd-b7f6-e42fedbcfe42",
                                "sense_id": "1a009e2a-74c2-37da-9524-18a26d155f9e",
                                "text": "The executive order specifically named Tren de Aragua and the Salvadoran MS-13 gang, citing their “campaigns of violence and terror in the United States and internationally” as threats to “the stability of the international order in the Western Hemisphere.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78da3874-f000-4920-aa14-783a35f57a6e",
                        "source_entry_id": "2a5f8358-7541-3446-ba2f-94469f07cb3d",
                        "source_sense_id": "1a009e2a-74c2-37da-9524-18a26d155f9e",
                        "source_sense_description": "in an international manner",
                        "target_lang_word": "internationalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "internationalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9387743-9bb1-3598-a841-7c7c837f1d6d",
                                        "entry_id": "e5690d3a-0afe-393c-b274-cd58e4604f43",
                                        "glosses": [
                                            "D’une façon internationale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4c7af3a-2f13-41fb-8c1a-247c17c3c62b",
                                                "sense_id": "d9387743-9bb1-3598-a841-7c7c837f1d6d",
                                                "text": "Dès qu’il y a nécessité actuelle de sortir des théories absolues du libre échange, et de traiter internationalement dans le système mitigé du moyen terme, d’un certain juste milieu entre le libre échange et la protection tout à fait systématique."
                                            },
                                            {
                                                "example_id": "4046a14e-c1bb-4206-9510-e1eccd026114",
                                                "sense_id": "d9387743-9bb1-3598-a841-7c7c837f1d6d",
                                                "text": "Ce gouvernement [de l’Italie] doit éviter de trop délibérer diplomatiquement, internationalement sur la loi des garanties [relative à la papauté]."
                                            },
                                            {
                                                "example_id": "59d7eda2-9de2-47c7-b01a-2be9c67d2d9a",
                                                "sense_id": "d9387743-9bb1-3598-a841-7c7c837f1d6d",
                                                "text": "Même s’il enchaîne dès le lendemain avec un voyage à Marseille pour célébrer l’« esprit olympique » internationalement, il aura du mal à ne pas revenir aux réalités du moment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
