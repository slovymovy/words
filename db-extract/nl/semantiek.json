        "nl-extract.jsonl": [
            {
                "entry_id": "0ab2e749-d12e-3d9c-bb88-1ccb458523a3",
                "word": "semantiek",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "64929230-1fb9-3581-978b-588152cbfbad",
                        "entry_id": "0ab2e749-d12e-3d9c-bb88-1ccb458523a3",
                        "glosses": [
                            "wetenschap die zich bezighoudt met de betekenis van taalkundige constructies zoals woorden (woordsemantiek) en zinnen (zinssemantiek)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64d8da0a-c346-4811-8158-5b63ba790809",
                                "sense_id": "64929230-1fb9-3581-978b-588152cbfbad",
                                "text": "Uiteindelijk is het geloof allemaal een kwestie van interpretatie en semantiek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b685c9a5-42d2-4240-89bf-5bca1ba7d827",
                        "source_entry_id": "0ab2e749-d12e-3d9c-bb88-1ccb458523a3",
                        "source_sense_id": "64929230-1fb9-3581-978b-588152cbfbad",
                        "source_sense_description": "taalkunde",
                        "target_lang_word": "Semantik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Semantik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5ee219a-1752-3bde-bfaf-c2cb3960cdef",
                                        "entry_id": "b851601d-0a7c-3b92-b238-8a789032de1b",
                                        "glosses": [
                                            "Disziplin der die Lehre von der Bedeutung von einfachen und komplexen sprachlichen Zeichen, also Morphemen, Wörtern, Sätzen und so weiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "655a0a63-fd41-488b-b4e5-9f1828d14f19",
                                                "sense_id": "d5ee219a-1752-3bde-bfaf-c2cb3960cdef",
                                                "text": "Unter Semantik werden in der Linguistik unterschiedliche Ansätze verstanden."
                                            },
                                            {
                                                "example_id": "a6d15bc7-022d-401b-b611-66d7b318e5d0",
                                                "sense_id": "d5ee219a-1752-3bde-bfaf-c2cb3960cdef",
                                                "text": "„Von diesem Bedeutungsgehalt, mit dem sich die Semantik beschäftigt, wollen wir in unserer Untersuchung zunächst einmal absehen.“"
                                            },
                                            {
                                                "example_id": "69ef5dd9-59cf-4d98-ad86-737150f17dc8",
                                                "sense_id": "d5ee219a-1752-3bde-bfaf-c2cb3960cdef",
                                                "text": "„Für die Semantik löst sich das Problem am ehesten in einer Theorie sprachlichen Handelns, in der sich die Dialektik von System und Prozeß wiederfindet im Wechselverhältnis von Regeln kommunikativen Handelns und der Veränderbarkeit solcher Regeln in der Praxis.“"
                                            },
                                            {
                                                "example_id": "46caa9e5-155d-4e6e-9ae9-2076e2f051a4",
                                                "sense_id": "d5ee219a-1752-3bde-bfaf-c2cb3960cdef",
                                                "text": "„Der Text ist dazu da, diese schon in Tönen ausgedrückten Emotionen mit Worten zu versehen, die durch ihre Semantik und ihre poetische Anpassung an die Musik diesen Gefühlsausdruck vervollkommnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c090d68-22ff-31e3-ab59-0c8ca52a63d2",
                                        "entry_id": "b851601d-0a7c-3b92-b238-8a789032de1b",
                                        "glosses": [
                                            "Bedeutung, Inhalt sprachlicher Ausdrücke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49931744-1560-4950-b6c8-6ae1a1dda49e",
                                                "sense_id": "9c090d68-22ff-31e3-ab59-0c8ca52a63d2",
                                                "text": "Die Semantik dieses Wortes ist noch unklar."
                                            },
                                            {
                                                "example_id": "59ecef32-72c9-47a0-a5de-1ee241de7890",
                                                "sense_id": "9c090d68-22ff-31e3-ab59-0c8ca52a63d2",
                                                "text": "„Das wirkungsmächtigste Element religiöser Semantik in der Gegenwart ist die Apokalyptik.“"
                                            },
                                            {
                                                "example_id": "0c2e5f77-3205-410e-ace3-62bcc067443b",
                                                "sense_id": "9c090d68-22ff-31e3-ab59-0c8ca52a63d2",
                                                "text": "„Auch die Bedeutung einzelner Wörter oder deren mehrere Bedeutungen, also ihre Semantik, lässt Witze entstehen.“"
                                            },
                                            {
                                                "example_id": "181f229f-1cda-4037-b221-58bc85dccb73",
                                                "sense_id": "9c090d68-22ff-31e3-ab59-0c8ca52a63d2",
                                                "text": "„Es können weitere Bemerkungen zu Lautstand, Morphologie, Semantik, Beleglage oder Wortgeschichte folgen, falls dies als notwendig erscheint.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96c305fd-1cd2-3753-a4cc-4b57e3aa27ab",
                                        "entry_id": "b851601d-0a7c-3b92-b238-8a789032de1b",
                                        "glosses": [
                                            "Teilbereich der Semiotik (neben Pragmatik und Syntax)"
                                        ],
                                        "tags": [
                                            "Semiotik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74bea9d1-fbcb-4dc8-bda0-b8a83a9e80e6",
                        "source_entry_id": "0ab2e749-d12e-3d9c-bb88-1ccb458523a3",
                        "source_sense_id": "64929230-1fb9-3581-978b-588152cbfbad",
                        "source_sense_description": "taalkunde",
                        "target_lang_word": "semantics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semantics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                        "entry_id": "73a5212c-1abf-34fd-b268-8a851a29c43c",
                                        "glosses": [
                                            "A branch of linguistics studying the meaning of words."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a2e1710-b4ce-48e7-98a2-c6699595f3b4",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "Holonym: linguistics"
                                            },
                                            {
                                                "example_id": "d87fefb3-4339-48f7-bb65-43d7b384345f",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "Meronyms: semasiology, onomasiology"
                                            },
                                            {
                                                "example_id": "ce9e5e7c-f4fc-4fa4-9f6b-75a3deb34e30",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "lexical semantics"
                                            },
                                            {
                                                "example_id": "9108ccde-9669-45df-b602-1633e33633ee",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "cognitive semantics"
                                            },
                                            {
                                                "example_id": "6a582255-d950-4100-8599-c31d0b6ff7f0",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "computational semantics"
                                            },
                                            {
                                                "example_id": "620ddc9a-1ce4-4164-a414-d43aaace3dc9",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "historical semantics"
                                            },
                                            {
                                                "example_id": "603f24f4-d1af-4542-8870-2be9c2f9194f",
                                                "sense_id": "78ec213f-d15b-34be-a5f5-de9eb074a846",
                                                "text": "Semantics is a foundation of lexicography."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8026201-a3e4-3028-bf88-d451f4051b6b",
                                        "entry_id": "73a5212c-1abf-34fd-b268-8a851a29c43c",
                                        "glosses": [
                                            "The study of the relationship between words and their meanings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cafa6f3d-61ca-457f-b24f-744826efc8af",
                                                "sense_id": "b8026201-a3e4-3028-bf88-d451f4051b6b",
                                                "text": "In fact, nowadays a lot is known about the semantics of natural languages, and it is surprisingly easy to build semantic representations which partially capture the meaning of sentences or even entire discourses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6334e352-28ff-3233-a22e-16982393cf2c",
                                        "entry_id": "73a5212c-1abf-34fd-b268-8a851a29c43c",
                                        "glosses": [
                                            "The meaning or set of meanings of a linguistic element, such as a word, morpheme or utterance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cbf08cf-2a15-49bf-8123-b454bb524a86",
                                                "sense_id": "6334e352-28ff-3233-a22e-16982393cf2c",
                                                "text": "In very ancient or poorly documented languages, the precise semantics of words tend to be uncertain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d808d651-2c89-3649-bc10-57e5b3de6a60",
                                        "entry_id": "73a5212c-1abf-34fd-b268-8a851a29c43c",
                                        "glosses": [
                                            "The meaning or set of meanings of a linguistic element, such as a word, morpheme or utterance.",
                                            "The meanings of individual words, as opposed to the overall meaning of a passage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e494816-3dbb-4402-9dec-12f42c28b471",
                                                "sense_id": "d808d651-2c89-3649-bc10-57e5b3de6a60",
                                                "text": "The semantics of the terms used are debatable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "858ad482-104f-3beb-997a-0f07c7b053cb",
                                        "entry_id": "73a5212c-1abf-34fd-b268-8a851a29c43c",
                                        "glosses": [
                                            "The meaning of computer language constructs, in contrast to their form or syntax."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70884ad8-2994-421b-bc0a-6d5c1c42de48",
                                                "sense_id": "858ad482-104f-3beb-997a-0f07c7b053cb",
                                                "text": "file sharing and locking semantics"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a11f6a9f-97a2-3127-8c6a-474ce1b2beb4",
                                        "entry_id": "73a5212c-1abf-34fd-b268-8a851a29c43c",
                                        "glosses": [
                                            "Pettiness or triviality."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdc1c5d2-43e2-40b8-9a87-06d9e3b014ae",
                                                "sense_id": "a11f6a9f-97a2-3127-8c6a-474ce1b2beb4",
                                                "text": "Who cares? This is all just semantics!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b66a270b-ddd5-412b-9bec-ec1a0e28b260",
                        "source_entry_id": "0ab2e749-d12e-3d9c-bb88-1ccb458523a3",
                        "source_sense_id": "64929230-1fb9-3581-978b-588152cbfbad",
                        "source_sense_description": "taalkunde",
                        "target_lang_word": "sémantique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sémantique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2aaed737-2126-37ac-b282-3a43ceaecee1",
                                        "entry_id": "6011d081-8d51-3b56-9480-2d6a37326cd9",
                                        "glosses": [
                                            "Relatif à la signification et au sens des unités linguistiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33853831-87a7-4efb-b468-eefa664849af",
                                                "sense_id": "2aaed737-2126-37ac-b282-3a43ceaecee1",
                                                "text": "L’aire sémantique de aéronef avec cette signification y est délimitée par rapport à aérostat désignant un ballon non dirigeable et aéronat réservé au ballon dirigeable."
                                            },
                                            {
                                                "example_id": "751f02c9-14ff-4a0f-a83e-8f387f30ec06",
                                                "sense_id": "2aaed737-2126-37ac-b282-3a43ceaecee1",
                                                "text": "Le second obstacle sémantique qui s’oppose à ce qu’on considère que \"-aille\" construit du collectif, c’est le fait que le nom de base auquel s’applique ce suffixe peut ne pas renvoyer à des individus."
                                            },
                                            {
                                                "example_id": "630a6a26-cfa6-4310-be81-e1e09aa8b2e4",
                                                "sense_id": "2aaed737-2126-37ac-b282-3a43ceaecee1",
                                                "text": "Par exemple : pardonner v.tr.dir. « 1. accorder le pardon, 2. recevoir le pardon » est à la fois un togolisme grammatical, (v.tr.ind. → v.tr.dir.) et une innovation sémantique de par l’extension de sens."
                                            },
                                            {
                                                "example_id": "c4649749-3759-4ff5-b3b2-649200fb2b61",
                                                "sense_id": "2aaed737-2126-37ac-b282-3a43ceaecee1",
                                                "text": "Il existe toutefois des logogrammes « muets », appelés déterminatifs ou classificateurs (ou encore déterminants sémantiques). Ce type de logogrammes, qui est attesté par exemple en égyptien ancien et en maya, ne sert qu'à donner des indications sémantiques, lexicales ou grammaticales, et n'est pas associé à une forme sonore."
                                            },
                                            {
                                                "example_id": "417087aa-b871-47c0-a6e2-632d1506e5c8",
                                                "sense_id": "2aaed737-2126-37ac-b282-3a43ceaecee1",
                                                "text": "Certains ne verront là que querelle sémantique insignifiante. C'est se condamner à ne rien comprendre à l'enjeu. Leurs raisonnements sont construits sur des mots dont ils ignorent le sens. Comment pourraient-ils raisonner juste?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf72533-4213-3ad5-8975-9eac00192caa",
                                        "entry_id": "6011d081-8d51-3b56-9480-2d6a37326cd9",
                                        "glosses": [
                                            "Qui a un sens, en parlant d’une phrase, par opposition à asémantique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sémantique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f70f0279-9d26-387f-b29f-973542d97c76",
                                        "entry_id": "2ef3424a-507f-3136-9d6a-b6db1ca12254",
                                        "glosses": [
                                            "Étude de la signification des mots et des propositions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2942acbb-b078-452c-9146-25a437956b72",
                                                "sense_id": "f70f0279-9d26-387f-b29f-973542d97c76",
                                                "text": "L'origine onomatopéique d'un lexème est une question diachronique, sans pertinence en tant que telle pour la sémantique de la parole : ainsi, il n'est pas fondamental pour nous de trancher parmi les nombreux cas qui peuvent faire débats (quid de gong, flaque, grogner, grommeler, siffler, claquer, vrombir... ?)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30708067-dd40-3316-b644-a5358a30bd56",
                                        "entry_id": "2ef3424a-507f-3136-9d6a-b6db1ca12254",
                                        "glosses": [
                                            "Art de mouvoir les troupes à l’aide de signaux."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
