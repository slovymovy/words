                ],
                "senses": [
                    {
                        "sense_id": "4ab5cf03-7ee2-34d1-bad0-7e420f9ab370",
                        "entry_id": "15ad261f-319d-38da-8b5b-2df646c2acc8",
                        "glosses": [
                            "aktywna forma demonstracji lub protestu w sprawie społecznej lub politycznej przed siedzibą jakiejś instytucji lub w innym publicznym miejscu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8c227eb-4a00-4679-aa69-8887c53cfd0c",
                                "sense_id": "4ab5cf03-7ee2-34d1-bad0-7e420f9ab370",
                                "text": "Pikieta przed ambasadą Chin skandowała hasła za wolnym Tybetem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "12ad7e62-c1b2-3543-96c8-656de561b8a6",
                        "entry_id": "15ad261f-319d-38da-8b5b-2df646c2acc8",
                        "glosses": [
                            "grupa robotników obnosząca plakaty przed strajkującym zakładem i blokująca wejście łamistrajków"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fe515eda-bb95-4771-89d6-c863e4ab31ac",
                                "sense_id": "12ad7e62-c1b2-3543-96c8-656de561b8a6",
                                "text": "Pikieta strajkujących związkowców nie wpuściła dyrektora na teren fabryki."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "32f93749-2ed3-3cad-9f9d-7a8aedaa2d97",
                        "entry_id": "15ad261f-319d-38da-8b5b-2df646c2acc8",
                        "glosses": [
                            "jedna ze starych gier karcianych dla dwóch osób, pochodząca z Francji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "021bb139-b5c7-4320-a191-3bea23611c70",
                                "sense_id": "32f93749-2ed3-3cad-9f9d-7a8aedaa2d97",
                                "text": "Zwycięzcą w pikietę jest gracz, który uzyskał w całej grze więcej punktów."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "6f0951ae-5e84-3c24-b41e-b2604221b0d3",
                        "entry_id": "15ad261f-319d-38da-8b5b-2df646c2acc8",
                        "glosses": [
                            "określenie jednostki piechoty, kawalerii albo wysuniętego posterunku wojskowego"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a8e0fe29-1611-45b7-9c21-bd2afa233e62",
                                "sense_id": "6f0951ae-5e84-3c24-b41e-b2604221b0d3",
                                "text": "Cała pikieta liczyła pięć drużyn pod dowództwem porucznika."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "ba32ba6d-f3ca-38db-b84b-db1172efda30",
                        "entry_id": "15ad261f-319d-38da-8b5b-2df646c2acc8",
                        "glosses": [
                            "punkt pomiaru wysokościowego lub sytuacyjnego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59bfcddd-ebfd-41fe-a542-be00d30f32fa",
                                "sense_id": "ba32ba6d-f3ca-38db-b84b-db1172efda30",
                                "text": "Aby określić pikietę, należy wykonać trzy dokładne pomiary."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "316ca40d-176c-351a-bfff-be938a274d1b",
                        "entry_id": "15ad261f-319d-38da-8b5b-2df646c2acc8",
                        "glosses": [
                            "gejowskie miejsce spotkań osób poszukujących anonimowego seksu"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "626a7779-f0d9-4941-81d3-12116f41dd28",
                                "sense_id": "316ca40d-176c-351a-bfff-be938a274d1b",
                                "text": "Pod Teatrem Słowackiego była kiedyś najsłynniejsza pikieta w mieście."
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    },
                    {
                        "sense_id": "43021ecf-9f5f-3800-a069-15fc1c9f889f",
                        "entry_id": "15ad261f-319d-38da-8b5b-2df646c2acc8",
                        "glosses": [
                            "w krokiecie kołek, od którego rozpoczynana jest gra"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b382e4fc-fd74-4409-a9f1-bbcf984a5f4a",
                                "sense_id": "43021ecf-9f5f-3800-a069-15fc1c9f889f",
                                "text": "W krokiecie kulę przetacza się według ustalonego porządku począwszy od pikiety poprzez sześć bramek."
                            }
                        ],
                        "sense_index_json": "\"1.7\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6475f6a6-7164-44bf-b21f-d7f72b155d9e",
                        "source_entry_id": "15ad261f-319d-38da-8b5b-2df646c2acc8",
                        "source_sense_id": "32f93749-2ed3-3cad-9f9d-7a8aedaa2d97",
                        "target_lang_word": "piquet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piquet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d87ae013-c89b-3b19-9fc5-2ccd93deef64",
                                        "entry_id": "0a7b9790-f6ac-36ff-b656-70714df73eba",
                                        "glosses": [
                                            "A game of cards for two people, with thirty-two cards, all the deuces, threes, fours, fives, and sixes being set aside."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb8a14e5-406e-450f-91ad-1f8a8bd7e67d",
                                                "sense_id": "d87ae013-c89b-3b19-9fc5-2ccd93deef64",
                                                "text": "Maria my love you look grave. Come, you sit down to Piquet with Mr. Surface."
                                            },
                                            {
                                                "example_id": "13bc962d-7713-464a-81ba-ac344becf66c",
                                                "sense_id": "d87ae013-c89b-3b19-9fc5-2ccd93deef64",
                                                "text": "The two wedding parties met constantly in each other's apartments. After two or three nights the gentlemen of an evening had a little piquet, as their wives sate and chatted apart."
                                            },
                                            {
                                                "example_id": "31f5efe5-2bc5-4e49-a6ac-e4064cc2e8fc",
                                                "sense_id": "d87ae013-c89b-3b19-9fc5-2ccd93deef64",
                                                "text": "They would kick off their shoes and play piquet by candle-light."
                                            },
                                            {
                                                "example_id": "af9c4183-bf1f-466a-a67b-c31f828b0357",
                                                "sense_id": "d87ae013-c89b-3b19-9fc5-2ccd93deef64",
                                                "text": "We shall together challenge the Chevalier de Belleroche to piquet; and, while we are winning money from him, we shall have the even greater pleasure of hearing you sing with your charming teacher, to whom I shall propose it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "piquet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "307af89a-e091-3e73-91f6-d7cc0eae0d79",
                                        "entry_id": "6ed7fb6e-919c-3289-a6fe-f52055b9be7a",
                                        "glosses": [
                                            "Archaic form of picket."
                                        ],
                                        "tags": [
                                            "alt-of",
