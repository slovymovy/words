                        "translation_id": "bb43140c-b9fa-4bd1-88c6-ecc54d6a42a3",
                        "source_entry_id": "3f06c085-2d37-3ccd-92dd-67e6f146a0e0",
                        "source_sense_id": "a661daf1-fd4b-39e8-8cd1-8214846eb3c8",
