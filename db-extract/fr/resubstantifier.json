                "senses": [
                    {
                        "sense_id": "a331dc6a-779b-3328-8dae-96fd161f16fe",
                        "entry_id": "8e4c8a18-7a97-3e1e-94c6-028e942b094f",
                        "glosses": [
                            "Substantifier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f34ad75f-2a0b-4b4e-835c-f201b734532f",
                                "sense_id": "a331dc6a-779b-3328-8dae-96fd161f16fe",
                                "text": "Cette reconnaissance d'une liberté transcendantale permettrait alors d'éviter la tentation de \"resubstantifier\" la \"fonction symbolique\"."
                            },
                            {
                                "example_id": "dd5c589b-fa72-43b0-af25-9196e6fa3d86",
                                "sense_id": "a331dc6a-779b-3328-8dae-96fd161f16fe",
                                "text": "Je ne peux qu’effleurer le sujet, en donner la structure fondamentale et conclure, tout penaud, que le vide dont parlait Todd n’est qu’apparent, ce qu’il ne nie pas (c’est Todd tout de même, oh !), et qu’il existe un discours clé en main prêt à resubstantifier le discours du capitalisme (le capitalisme ne parle pas, c'est un raccourci)."
                            }
                        ]
                    }
                ],
