                "senses": [
                    {
                        "sense_id": "04b35677-67e5-3898-b603-2d01c746c04b",
                        "entry_id": "265d80ec-e0e0-37e4-a44a-b76bad49ac9d",
                        "glosses": [
                            "Verkäufer, der seine Waren vom Boot aus anbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5fd3ca9-9ed9-4e7f-8bf2-38d454831270",
                                "sense_id": "04b35677-67e5-3898-b603-2d01c746c04b",
                                "text": "„Ein Boot, wie es die brasilianischen Flusshändler benutzten, war angelandet.“"
                            },
                            {
                                "example_id": "998a5907-9a7d-4332-af90-483aec119057",
                                "sense_id": "04b35677-67e5-3898-b603-2d01c746c04b",
                                "text": "„Kurz vor uns war der Flusshändler hier.“"
                            },
                            {
                                "example_id": "765cf382-e649-4f2a-891f-727b86911412",
                                "sense_id": "04b35677-67e5-3898-b603-2d01c746c04b",
                                "text": "„Im 12. Jahrhundert lag die Verwaltung von Paris in den Händen der Flusshändler, die die Navigation auf der Seine kontrollierten.“"
                            },
                            {
                                "example_id": "f984d7a6-52e9-4b81-9a40-bba8e9f3a90e",
                                "sense_id": "04b35677-67e5-3898-b603-2d01c746c04b",
                                "text": "„Das heutige London hat nur wenig mit den Siedlungen gemein, die einst an den Ufern der Themse wie Pilze aus dem Boden schossen, um Behausungen für die Flusshändler auf ihrem Weg zum Meer zu schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
