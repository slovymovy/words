{
    "word_family": [
        "sensation",
        "sense",
        "sensationalism",
        "sensationalist",
        "sensationalize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b707bbb2-8ab6-371a-9aba-9cf7c769e369",
                    "sense_definition": "Provoking a strong reaction of interest, excitement, or shock.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "exciting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper published a <w>sensational</w> story about the secret life of the politician.",
                            "target_lang_translations": {
                                "zh": "那家报纸刊登了一篇关于这位政客私生活的<w>耸人听闻的</w>报道。"
                            }
                        },
                        {
                            "text": "The <w>sensational</w> headlines caused a lot of public debate.",
                            "target_lang_translations": {
                                "zh": "那些<w>轰动的</w>头条新闻引发了大量的公众讨论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dramatic",
                        "shocking",
                        "exciting"
                    ],
                    "antonyms": [
                        "boring",
                        "dull"
                    ],
                    "common_phrases": [
                        "sensational news",
                        "sensational headline"
                    ],
                    "target_lang_definitions": {
                        "zh": "引起轰动的，耸人听闻的；引人注目或引起强烈震惊的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轰动的",
                                "target_lang_sense_clarification": "指引起广泛关注和热议的"
                            },
                            {
                                "target_lang_word": "耸人听闻的",
                                "target_lang_sense_clarification": "常指新闻或言论夸大其词以引起震惊的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d48c0de-026d-33b9-a43a-0173c52a350f",
                    "sense_definition": "Exceptionally great or impressive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excellent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team gave a <w>sensational</w> performance to win the championship game.",
                            "target_lang_translations": {
                                "zh": "该队表现<w>绝妙</w>，赢得了冠军赛。"
                            }
                        },
                        {
                            "text": "She looked <w>sensational</w> in her new dress at the party.",
                            "target_lang_translations": {
                                "zh": "在聚会上，她穿着新裙子看起来非常<w>惊艳</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amazing",
                        "fantastic",
                        "wonderful"
                    ],
                    "antonyms": [
                        "terrible",
                        "awful"
                    ],
                    "common_phrases": [
                        "sensational performance",
                        "sensational display"
                    ],
                    "target_lang_definitions": {
                        "zh": "极好的，绝妙的，令人赞叹的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绝妙的",
                                "target_lang_sense_clarification": "形容表现或效果极其出色"
                            },
                            {
                                "target_lang_word": "极好的",
                                "target_lang_sense_clarification": "指非常棒、极其令人赞叹的"
                            },
                            {
                                "target_lang_word": "惊艳的",
                                "target_lang_sense_clarification": "常用于形容外貌、打扮令人眼前一亮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03ea85f2-9b67-3b5a-a026-53e114c29beb",
                    "sense_definition": "Piquing or arousing the senses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exciting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef created a <w>sensational</w> dish that delighted everyone at the table.",
                            "target_lang_translations": {
                                "zh": "主厨制作了一道<w>令人陶醉的</w>美味佳肴，让餐桌上的每位客人都赞不绝口。"
                            }
                        },
                        {
                            "text": "The music provided a <w>sensational</w> experience for the audience.",
                            "target_lang_translations": {
                                "zh": "这音乐给观众带来了一种<w>刺激感官的</w>体验。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stimulating",
                        "thrilling"
                    ],
                    "target_lang_definitions": {
                        "zh": "激发感官的，令人陶醉或刺激感官的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "令人陶醉的",
                                "target_lang_sense_clarification": "指在感官上带来极大享受的"
                            },
                            {
                                "target_lang_word": "刺激感官的",
                                "target_lang_sense_clarification": "指激发触觉、味觉、听觉等感官体验的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c367cf33-558e-3705-aa45-9509c87fe893",
                    "sense_definition": "Relating to the physical senses or the process of sensation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor examined the <w>sensational</w> nerves to determine the cause of the numbness.",
                            "target_lang_translations": {
                                "zh": "医生检查了<w>感觉</w>神经，以确定麻木的原因。"
                            }
                        },
                        {
                            "text": "The study focuses on the <w>sensational</w> pathways in the human body.",
                            "target_lang_translations": {
                                "zh": "该研究重点关注人体内的<w>知觉</w>传导通路。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sensory"
                    ],
                    "target_lang_definitions": {
                        "zh": "感觉的，知觉的；与身体感官或知觉过程相关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "感觉的",
                                "target_lang_sense_clarification": "指生理上的感觉或知觉"
                            },
                            {
                                "target_lang_word": "知觉的",
                                "target_lang_sense_clarification": "生理学或医学用语，指神经系统知觉方面的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}