                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c0a9f52-f634-4ed9-ad08-8b500c93acb3",
                                "sense_id": "57883df4-8928-31a1-885e-cffd17c080c9",
                                "text": "Bientôt l’indécourageable Autriche forma une troisième armée, qu’elle confia au baron d’Alvinzi, très-vieux, mais très-brave général."
                            },
                            {
                                "example_id": "2335421e-9db2-4f76-a9f3-418b7cc37cbb",
                                "sense_id": "57883df4-8928-31a1-885e-cffd17c080c9",
                                "text": "Aux plaines blanches succèdent d’autres plaines blanches, toujours comme a dit le susdit père Hugo.\nLe cycliste pédale, indécourageable."
                            },
                            {
                                "example_id": "bcd68c1a-c8b5-41bc-8ad7-a2a94f767b58",
                                "sense_id": "57883df4-8928-31a1-885e-cffd17c080c9",
                                "text": "Pourquoi, ce soir-là même, si son amour savait être assez éloquent, ne recevrait-il pas enfin la récompense de son indécourageable fidélité ?"
                            }
                        ]
                    }
