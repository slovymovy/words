                                "target_senses": [
                                    {
                                        "sense_id": "d627364b-5d11-30d3-852e-ce9d631d03b6",
                                        "entry_id": "13203368-f402-30c9-9667-e579c3bfed56",
                                        "glosses": [
                                            "zu etwas gezwungen, veranlasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1098bb36-f71b-4c8d-adf7-6857eec53b77",
                                                "sense_id": "d627364b-5d11-30d3-852e-ce9d631d03b6",
                                                "text": "Sie wollte dem zu einem langen Krankenlager verdammten Kind ein bisschen Abwechslung verschaffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0129accb-5153-3073-9630-a6208bc4ec49",
                                        "entry_id": "13203368-f402-30c9-9667-e579c3bfed56",
                                        "glosses": [
                                            "mit einem Fluch belegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e8aa2ed-e01e-4802-8504-1d2bc4f68c7f",
                                                "sense_id": "0129accb-5153-3073-9630-a6208bc4ec49",
                                                "text": "„Als der Polizeiwagen mit Breivik beim Gericht vorfuhr, schlugen wütende Passanten auf die Scheiben und schrien »verdammter Verräter«.“"
                                            },
                                            {
                                                "example_id": "23cbf78c-9297-4613-b872-a8bc6bdf666f",
                                                "sense_id": "0129accb-5153-3073-9630-a6208bc4ec49",
                                                "text": "Ich bin es verdammt nochmal leid, das immer wieder sagen zu müssen!"
                                            },
                                            {
                                                "example_id": "028069d2-fa4b-4fc7-ab19-f23b89ee4c94",
                                                "sense_id": "0129accb-5153-3073-9630-a6208bc4ec49",
                                                "text": "„Er mußte diesem verdammten Schafhirten einmal die Leviten lesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "be54793b-3a45-3488-917d-36e70915cfb0",
                                        "entry_id": "13203368-f402-30c9-9667-e579c3bfed56",
                                        "glosses": [
                                            "in hohem Maße, besonders"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fcf172c-0013-44f0-8fae-bf27a4fb7342",
                                                "sense_id": "be54793b-3a45-3488-917d-36e70915cfb0",
                                                "text": "Heike ist verdammt glücklich über ihren Freund, da dieser ihr immer zur Seite steht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
