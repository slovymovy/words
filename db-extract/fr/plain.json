                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "eb050014-3167-4389-8088-f9e28fc83f98",
                                "sense_id": "c57e9584-f52a-36ca-b541-d51622dc0592",
                                "text": "Ce terrain est plain. La plaine campagne."
                            },
                            {
                                "example_id": "aaaf0635-eae1-4100-9a3d-46ca208e98d0",
                                "sense_id": "c57e9584-f52a-36ca-b541-d51622dc0592",
                                "text": "Les deux plateaux peuvent ne pas porter, pourtant, les mêmes poids ; pour revenir à un fléau plain, il suffit de changer la longueur des bras."
                            }
                        ]
                    },
                    {
                        "sense_id": "6afee5a9-a648-3749-ba7b-6872e818e688",
                        "entry_id": "73af8705-af40-3778-a50a-f8490255b52a",
                        "glosses": [
