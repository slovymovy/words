                "senses": [
                    {
                        "sense_id": "1be6de0b-dfca-36af-9bbb-02b28cdc18a7",
                        "entry_id": "adae2548-f96e-3157-be91-eb9e09e74755",
                        "glosses": [
                            "in der Art eines Klischees, einem Klischee entsprechend"
