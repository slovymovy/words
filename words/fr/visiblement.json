            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                    "sense_definition": "D'une manière évidente ; selon toute apparence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat était <w>visiblement</w> soulagé d'entendre les résultats de l'examen.",
                            "target_lang_translations": {
                                "en": "The candidate was <w>clearly</w> relieved to hear the exam results.",
                                "ru": "Кандидат <w>явно</w> испытал облегчение, услышав результаты экзамена.",
                                "de": "Der Kandidat war <w>offensichtlich</w> erleichtert, die Ergebnisse der Prüfung zu erfahren.",
                                "es": "El candidato estaba <w>evidentemente</w> aliviado al conocer los resultados del examen.",
                                "zh": "考生听到考试结果时，<w>显然</w>松了一口气。"
                            }
                        },
                        {
                            "text": "<w>Visiblement</w>, personne n'avait pensé à fermer les fenêtres avant l'orage.",
                            "target_lang_translations": {
                                "en": "<w>Clearly</w>, nobody had thought to close the windows before the storm.",
                                "ru": "<w>Очевидно</w>, никто не подумал закрыть окна перед грозой.",
                                "de": "<w>Offensichtlich</w> hatte niemand daran gedacht, die Fenster vor dem Gewitter zu schließen.",
                                "es": "<w>Evidentemente</w>, nadie había pensado en cerrar las ventanas antes de la tormenta.",
                                "zh": "<w>显然</w>，暴风雨来临前，没有人想到要关窗户。"
                            }
                        }
                    ],
                    "synonyms": [
                        "apparemment"
                    ],
                    "common_phrases": [
                        "visiblement ému",
                        "visiblement agacé"
                    ],
                    "target_lang_definitions": {
                        "en": "In an evident manner; seemingly, judging by appearances.",
                        "ru": "Очевидным образом, судя по внешним признакам.",
                        "de": "Auf offensichtliche Weise; dem äußeren Anschein nach.",
                        "es": "De manera evidente o según todas las apariencias.",
                        "zh": "以明显的方式表现出来；从表面迹象看来或推测。"
                    },
                    "translations": {
