                        "glosses": [
                            "An Australian honeyeater, the scarlet myzomela (Myzomela sanguinolenta)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69022703-bd5c-41b7-848a-3f5eaf22e277",
                                "sense_id": "f78b12dd-2dab-3c63-84a5-a50c1197ce85",
                                "text": "I was watching a lovely little read-headed honey-eater—that beautiful scarlet and black bird, familiarly known as the bloodbird— feeding busily in the top of a small turpentine tree, and ceasing operations now and again to utter his little running call."
                            },
                            {
                                "example_id": "6d3584a7-63f4-4cc4-9a5d-91b69bec85f8",
                                "sense_id": "f78b12dd-2dab-3c63-84a5-a50c1197ce85",
                                "text": "At first only one bloodbird dipped low to catch insects in the last of the milkweed bursting their pods in the fields."
                            }
                        ]
                    }
