                                    {
                                        "sense_id": "9342a841-bd95-30d5-8ee3-c34eeb9a2f25",
                                        "entry_id": "dbf8fbb2-ef88-365d-8034-80a10c4e2227",
                                        "glosses": [
                                            "een langs kust of oever gebouwde constructie om de kracht van golven en stroom te weerstaan of te absorberen om daarmee de wal tegen afkalving te beschermen en/of rustig water als anker/aanlegplaats te verkrijgen"
                                        ],
                                        "tags": [
                                            "waterbeheer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b41889-8128-41fe-aed2-0d648699fffb",
                                                "sense_id": "9342a841-bd95-30d5-8ee3-c34eeb9a2f25",
                                                "text": "Een golfbreker kan massief zijn, van zand en steen, maar kan ook bestaan uit een enkele of dubbele rij houten palen."
                                            }
                                        ]
                                    }
                                ]
                            }
