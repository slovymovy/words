                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db77c003-4b4e-47cc-9349-683785e6b0ac",
                                "sense_id": "414fda46-31b2-3bd5-aeb1-53870fd82675",
                                "text": "„Bis mich vor einigen Jahren in Berlin eine Frau darauf ansprach, war mir nie aufgefallen, dass ich in meinem ganzen Leben noch keine einzige Müllfrau gesehen hatte.“"
                            }
