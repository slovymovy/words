                                        "entry_id": "fc307f45-ec73-3658-8b11-8a88dff67b9e",
                                        "glosses": [
                                            "Lac situé au Nord de la ville de Managua."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62b346a8-d406-4dcf-a7db-19407e9a5e3f",
                                                "sense_id": "17a97665-41bf-3a1c-bc9a-d5dd37f1abed",
                                                "text": "Le lac est uni par la petite rivière Tipitapa, qui a 20 milles de long, au lac Managua, situé à un niveau un peu plus élevé au-dessus de la mer."
                                            }
                                        ]
