                ],
                "senses": [
                    {
                        "sense_id": "350e1bd9-225d-37ea-9621-b776089e2cfe",
                        "entry_id": "866b9203-8601-39ef-b46a-0c5f5d6acf91",
                        "glosses": [
                            "einem Tentakel ähnelnd, an einen Tentakel erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c72ea8d-75dc-4861-a086-547789bbdbb0",
                                "sense_id": "350e1bd9-225d-37ea-9621-b776089e2cfe",
                                "text": "„Darunter befand sich ein maulartiger, mindestens halb um den Kopf reichender Schlitz, an dessen Seiten je ein tentakelartiger Fortsatz mit löffelartig ausgeformter Spitze herabhing, der offensichtlich dazu diente, Nahrung zum Maul zu führen.“"
                            },
                            {
                                "example_id": "fe7fb75f-77ee-4405-b689-01c2a51507dd",
                                "sense_id": "350e1bd9-225d-37ea-9621-b776089e2cfe",
                                "text": "„Wir erkannten, dass dieses Etwas nicht, wie wir geglaubt hatten, eine in die Flüssigkeit abgetauchte Kreatur war, sondern dass die Flüssigkeit selbst ihren abscheulichen Hals und Kopf emporreckte und nun diese grässlichen Arme ausformte, von denen tentakelartige Fortsätze nach uns fingerten, die ihnen Klauen oder Hände ersetzten!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
