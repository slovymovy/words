                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>intérieur</w> a marqué de nombreux points grâce à sa grande taille."
                        },
                        {
                            "text": "L'entraîneur cherche un nouvel <w>intérieur</w> pour renforcer le secteur défensif."
