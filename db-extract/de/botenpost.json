                ],
                "senses": [
                    {
                        "sense_id": "9a267123-e555-32bf-91c9-e1cbf7f9fadf",
                        "entry_id": "e592ab55-1b42-3780-9b0f-6a0d15830590",
                        "glosses": [
                            "Beförderung der Post durch Boten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeaa7fed-86b4-4691-b36d-f061461978bc",
                                "sense_id": "9a267123-e555-32bf-91c9-e1cbf7f9fadf",
                                "text": "„Im Innern nicht an Bahnen gelegene Postanstalten werden durch regelmäßige Botenposten, in Deutsch-Südwestaftika auch durch die landesüblichen Karrenposten und durch Reitposten versorgt.“"
                            },
                            {
                                "example_id": "194f5179-1985-45ed-9141-4851c93ab532",
                                "sense_id": "9a267123-e555-32bf-91c9-e1cbf7f9fadf",
                                "text": "„Nachdem die im Hochmittelalter aufblühenden Städte zunächst zur Übermittlung ihres Schriftwechsels auf Amtspersonen oder angesehende Bürger zurückgegriffen hatten, entwickelten sich etwa ab der Mitte des 13. Jahrhunderts eigene städtische Botenposten.“"
                            },
                            {
                                "example_id": "450c0f13-2061-4c6b-981e-ba787bea8008",
                                "sense_id": "9a267123-e555-32bf-91c9-e1cbf7f9fadf",
                                "text": "„Die erste durch Deutschland führende Botenpost von Innsbruck nach Mecheln ist bereits 1490 belegt, verkehrte aber zunächst unregelmäßig und nur für das Herrscherhaus und dessen Verwaltung.“"
                            },
                            {
                                "example_id": "a29480e2-a73d-470a-8f80-b3dfa145ae87",
                                "sense_id": "9a267123-e555-32bf-91c9-e1cbf7f9fadf",
                                "text": "„Neben den Boteneinrichtungen von Herrschern, Klöstern und Städten existierte in Süddeutschland wohl schon seit dem ausgehenden Mittelalter eine lokale Botenpost durch Metzger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0321bc3c-1492-3806-a983-092658b61537",
                        "entry_id": "e592ab55-1b42-3780-9b0f-6a0d15830590",
                        "glosses": [
                            "das durch Boten beförderte Postgut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e986ed9-f725-4934-8e0c-eeb90a99f854",
                                "sense_id": "0321bc3c-1492-3806-a983-092658b61537",
                                "text": "„Belege städtischer Botenpost sind schwer auffindbar, da sie meist in Archiven aufbewahrt werden und nur selten an die Öffentlichkeit gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
