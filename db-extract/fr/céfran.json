                "senses": [
                    {
                        "sense_id": "7216d3a9-c6d9-3035-951f-c38507cbd43d",
                        "entry_id": "e7b6cdd5-147f-3b75-897f-f829a30e664f",
                        "glosses": [
                            "Français (langue)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7128c36b-0bea-44d7-8bbb-ab5623c16de1",
                                "sense_id": "7216d3a9-c6d9-3035-951f-c38507cbd43d",
                                "text": "Les jeunes composent le céfran avant tout pour se distancier des adultes. Or les quinquagénaires et les quadragénaires — l’ancienne génération de mai 68 — adopte assez rapidement le céfran, du moins partiellement, si bien que les jeunes sont forcés de changer rapidement leur sociolecte !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b4ae778a-7215-3010-aabe-c2fdf754d07a",
                "word": "Céfran",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "100b5cb2-034d-4091-9786-daeeab431de1",
                        "entry_id": "b4ae778a-7215-3010-aabe-c2fdf754d07a",
                        "tags": [
