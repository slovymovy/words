                                                "example_id": "2eedde17-6e65-4aa7-bd74-85fde8b722dd",
                                                "sense_id": "b62e51b8-5f30-3c2b-860e-499764323eee",
                                                "text": "„Nepenthes papuana ist eine fleischfressende Pflanze aus der Gattung der Kannenpflanzen (Nepenthes). Sie wurde um 1910 vom Naturforscher Benedictus Hubertus Danser erstbeschrieben.“"
                                            },
                                            {
                                                "example_id": "5ff96550-4592-47f4-9e8e-da32ad73bea8",
                                                "sense_id": "b62e51b8-5f30-3c2b-860e-499764323eee",
                                                "text": "„Der Berg und seine Unwegsamkeit, sie schreiben auf diese Weise am Text des Naturforschers mit.“"
                                            },
                                            {
                                                "example_id": "262b01c2-3b01-4934-98f2-08bf8bd82917",
                                                "sense_id": "b62e51b8-5f30-3c2b-860e-499764323eee",
                                                "text": "„Er hatte seine Karriere als Schriftsteller und Naturforscher in den literarischen Salons in Paris begonnen, wo er mit Menschen wie Prosper Mérimée und Stendhal Freundschaft geschlossen hatte.“"
                                            },
                                            {
                                                "example_id": "4b857cf6-2cc1-49e7-802c-cf9c2f0f4596",
                                                "sense_id": "b62e51b8-5f30-3c2b-860e-499764323eee",
                                                "text": "„Im Frühjahr 1790 brach der deutsche Naturforscher und Publizist Georg Forster auf zu einer Reise, die ihn durch das Rheintal zwischen Bingen und Koblenz führen sollte.“"
                                            },
                                            {
                                                "example_id": "7b34e798-a359-42f1-b2f1-0a81f5b09d4d",
                                                "sense_id": "b62e51b8-5f30-3c2b-860e-499764323eee",
                                                "text": "„Der deutsche Naturforscher Alexander von Humboldt (1769-1859) gilt als der Begründer der Biogeographie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
