                                "target_senses": [
                                    {
                                        "sense_id": "2a88b1df-911c-3e27-9f20-28acade9de3b",
                                        "entry_id": "344ab80a-bf82-3e8c-ba77-4924fb18d78b",
                                        "glosses": [
                                            "Autre orthographe de OLAF, organisme de lutte contre les fraudes aux subventions européennes."
                                        ],
                                        "tags": [
                                            "European-Union"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b46a20cb-898d-400d-bfe5-9643fe0b8ab0",
                                                "sense_id": "2a88b1df-911c-3e27-9f20-28acade9de3b",
                                                "text": "Dans un e-mail envoyé au personnel le 21 novembre, que nous avons pu consulter, la présidente de l’université explique qu’il s’agit en réalité d’une « procédure de contrôle tout à fait ordinaire » de l’Olaf, concernant le contrôle de la gestion de fonds européens."
                                            },
                                            {
                                                "example_id": "e951b7e9-456d-4e24-bcfd-081591659cf4",
                                                "sense_id": "2a88b1df-911c-3e27-9f20-28acade9de3b",
                                                "text": "Qu’est-ce que l’Olaf, l’Office européen de lutte antifraude ?"
                                            },
                                            {
                                                "example_id": "45406f62-8e95-4024-8daa-b32636a149f4",
                                                "sense_id": "2a88b1df-911c-3e27-9f20-28acade9de3b",
                                                "text": "Quel est le rôle de l’Olaf ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Olaf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bbaeaebe-7600-3adb-a576-98e907abd179",
                                        "entry_id": "6e07eef2-bb58-38da-a2b0-6197a8bf981f",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0b577ec-1532-451e-aff0-b004799b8f44",
                                                "sense_id": "bbaeaebe-7600-3adb-a576-98e907abd179",
                                                "text": "« Son prénom est Olaf… Les pêcheurs qui font le hareng et qui vont parfois jusqu’en Norvège disent qu’il y a là-bas beaucoup de gens qui s’appellent ainsi… »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
