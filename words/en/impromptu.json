{
    "word_family": [
        "extemporize",
        "improvise"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "32fe3d17-5ae7-34a6-a421-bc3cb5dd50a8",
                    "sense_definition": "Done or made without prior preparation, planning, or rehearsal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "improvisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party began with an <w>impromptu</w> rendition of a popular song.",
                            "target_lang_translations": {
                                "nl": "Het feest begon met een <w>geïmproviseerde</w> vertolking van een populair lied."
                            }
                        },
                        {
                            "text": "She gave an <w>impromptu</w> speech after being asked to say a few words.",
                            "target_lang_translations": {
                                "nl": "Ze hield een <w>onvoorbereide</w> toespraak nadat haar gevraagd was een paar woorden te zeggen."
                            }
                        }
                    ],
                    "synonyms": [
                        "unplanned",
                        "improvised",
                        "off-the-cuff",
                        "offhand",
                        "spur-of-the-moment"
                    ],
                    "common_phrases": [
                        "impromptu speech",
                        "impromptu meeting",
                        "impromptu performance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zonder voorbereiding of planning uitgevoerd of gemaakt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geïmproviseerd",
                                "target_lang_sense_clarification": "algemene term voor iets dat ter plekke is bedacht"
                            },
                            {
                                "target_lang_word": "onvoorbereid",
                                "target_lang_sense_clarification": "zonder enige voorbereiding"
                            },
                            {
                                "target_lang_word": "voor de vuist weg",
                                "target_lang_sense_clarification": "spontaan en zonder voorbereiding"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b966d42d-8f27-3b92-be33-272a04e3a09e",
                    "sense_definition": "A piece of work or performance created on the spot without preparation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "improvisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian's <w>impromptu</w> was the highlight of the entire show.",
                            "target_lang_translations": {
                                "nl": "De <w>improvisatie</w> van de cabaretier was het hoogtepunt van de hele show."
                            }
                        },
                        {
                            "text": "He delivered a clever <w>impromptu</w> that delighted the audience.",
                            "target_lang_translations": {
                                "nl": "Hij leverde een slimme <w>improvisatie</w> die het publiek vermaakte."
                            }
                        }
                    ],
                    "synonyms": [
                        "improvised"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een werk of optreden dat ter plekke is gecreëerd zonder voorbereiding."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "improvisatie",
                                "target_lang_sense_clarification": "een spontane creatie of uitvoering"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf4003fa-58f6-37bf-841d-eb7d52d634ce",
                    "sense_definition": "A short musical composition, often for solo instrument, that sounds like an improvisation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "improvisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist played a beautiful <w>impromptu</w> by Schubert.",
                            "target_lang_translations": {
                                "nl": "De pianist speelde een prachtig <w>impromptu</w> van Schubert."
                            }
                        },
                        {
                            "text": "This <w>impromptu</w> captures a sense of spontaneous musical expression.",
                            "target_lang_translations": {
                                "nl": "Dit <w>impromptu</w> vangt een gevoel van spontane muzikale expressie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een kort muziekstuk, vaak voor een solo-instrument, dat klinkt als een improvisatie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "impromptu",
                                "target_lang_sense_clarification": "een muzikale compositie die een spontaan karakter heeft"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}