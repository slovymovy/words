                                    {
                                        "sense_id": "6ebd2268-e42d-3f75-9c0b-f2bc736072fd",
                                        "entry_id": "90de08b0-0c5b-3b12-993d-957fd47ed4b4",
                                        "glosses": [
                                            "zdolność pozazmysłowego przewidywania przyszłości lub poznawania zjawisk niemożliwych do postrzegania zmysłami"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bb319a3-14e6-43d3-9f9b-5e14f9563faa",
                                                "sense_id": "6ebd2268-e42d-3f75-9c0b-f2bc736072fd",
                                                "text": "Opatka obdarzona była darami jasnowidzenia i proroctwa."
