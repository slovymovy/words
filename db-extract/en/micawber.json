                        "entry_id": "dc666b44-e9e9-3564-9a1b-a9707b7d65a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "micawbers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40673006-7096-3a32-a338-a5702e12ebdc",
                        "entry_id": "dc666b44-e9e9-3564-9a1b-a9707b7d65a3",
                        "glosses": [
                            "Alternative letter-case form of Micawber; a person of modest income or background who remains optimistic that their situation will improve."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f8e37936-d732-474b-ac30-b0768aaeb1a8",
                                "sense_id": "40673006-7096-3a32-a338-a5702e12ebdc",
                                "text": "My grandfather was something of a micawber, never letting setbacks or misfortune drag down his cheery disposition."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a2848cdc-4ae4-37b5-800a-fd6b39263345",
