                        "glosses": [
                            "Preuve contraire à une preuve fournie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db116897-19b9-4cfa-a9e5-b3ec6bd5dda0",
                                "sense_id": "6a684824-49d3-3aee-befb-2d26e6452764",
                                "text": "Il est vrai qu’une partie demanderesse ne peut scinder sa preuve d’expertise afin d’en présenter une partie en demande principale et une autre partie en contre-preuve."
                            },
                            {
                                "example_id": "eb9d22f9-f5c4-48a0-a8a2-c4e4afc61632",
                                "sense_id": "6a684824-49d3-3aee-befb-2d26e6452764",
                                "text": "L’audience étant poursuivie sur un simple acte, de deux choses l’une : ou il n’y a pas de reproches, et dans ce cas les parties, déposant leurs conclusions au fond, cherchent à tirer de l’enquête les preuves ou contre-preuves qu’elle peut fournir ; alors l’affaire marche au fond, comme si l’enquête n'eût pas eu lieu, sauf qu’on invoque les dépositions."
                            }
                        ]
                    }
