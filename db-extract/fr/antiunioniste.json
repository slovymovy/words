                    {
                        "sense_id": "7ac79433-76df-334d-9299-42a0bcbf153a",
                        "entry_id": "53533a0f-7106-3693-a991-db809f4d30c0",
                        "glosses": [
                            "Personne opposée à la réunion de deux sectes religieuses, de deux pays, de deux peuples."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3afca195-f7f0-4db8-965d-610ffc1a58ee",
                                "sense_id": "7ac79433-76df-334d-9299-42a0bcbf153a",
                                "text": "À une exception près : il n'y aura pas d’antiunionistes dans les trois Églises qui fusionnent. C’est l’espérance d'un nouveau départ."
                            },
                            {
                                "example_id": "250e57d4-90c5-472b-8372-136554c327bd",
                                "sense_id": "7ac79433-76df-334d-9299-42a0bcbf153a",
                                "text": "Mais l’état de grâce est bref. En juillet 1912, sous la pression d’un groupe d'officiers antiunionistes stambouliotes en liaison avec des antiunionistes macédoniens, le sultan appelle au pouvoir un nouveau vizir qui forme un gouvernement d’où sont exclus tous les unionistes."
                            }
                        ]
                    }
