                "senses": [
                    {
                        "sense_id": "ec83c123-0825-392f-bd35-b66c7cfe9263",
                        "entry_id": "aa0ae8ae-52bd-3d36-98ee-9f20a8883834",
                        "glosses": [
                            "centrum van de stad met veel winkels en uitgaansgelegenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a771000-c7db-49b1-a4b0-634ad9f327f9",
                                "sense_id": "ec83c123-0825-392f-bd35-b66c7cfe9263",
                                "text": "PvdA-fractievoorzitter Fred Rijkens deed de suggestie om 'als stok achter de deur' reclamebelasting voor centrumondernemers in te voeren om geld op tafel te krijgen die het stadshart aantrekkelijker kunnen maken. Maar daar voelt Meulenkamp niets voor."
                            },
                            {
                                "example_id": "d819ff20-aa8d-4b69-8129-4bc525bc0ae7",
                                "sense_id": "ec83c123-0825-392f-bd35-b66c7cfe9263",
                                "text": "Het doel is om de stad duurzamer te maken. Het stadshart moet zoveel mogelijk autovrij gemaakt worden en geparkeerde auto's moeten verdwijnen langs de grachten. In 2025, wanneer de stad 750 jaar bestaat, moeten er 7000 tot 10.000 minder parkeerplaatsen zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a648dd46-143f-45a2-8cb9-16344a637631",
                        "source_entry_id": "aa0ae8ae-52bd-3d36-98ee-9f20a8883834",
                        "source_sense_id": "ec83c123-0825-392f-bd35-b66c7cfe9263",
                        "target_lang_word": "city",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "city",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60feeddf-3869-398a-adbd-06e28c063e41",
                                        "entry_id": "33fb848f-b0b9-3625-9df7-e7e1885518ed",
                                        "glosses": [
                                            "A large settlement, bigger than a town; sometimes with a specific legal definition, depending on the place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6adfb722-c7a2-4621-b238-412378016c18",
                                                "sense_id": "60feeddf-3869-398a-adbd-06e28c063e41",
                                                "text": "São Paulo is the largest city in South America."
                                            },
                                            {
                                                "example_id": "9a2d4620-7c73-4bb7-aca0-c7425ee754ab",
                                                "sense_id": "60feeddf-3869-398a-adbd-06e28c063e41",
                                                "text": "Ah, knovv you not the Citie fauours them, / And they haue troupes of Souldiers at their beck?"
                                            },
                                            {
                                                "example_id": "3abbdfc2-3a29-46e3-a913-e16914682507",
                                                "sense_id": "60feeddf-3869-398a-adbd-06e28c063e41",
                                                "text": "So this was my future home, I thought![…]Backed by towering hills, the but faintly discernible purple line of the French boundary off to the southwest, a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "6614c241-dba4-4ed4-b8b0-42b4ff731ac8",
                                                "sense_id": "60feeddf-3869-398a-adbd-06e28c063e41",
                                                "text": "But clever cities will not necessarily be better ones."
                                            },
                                            {
                                                "example_id": "1785ab03-1510-4874-948e-179976bfa78e",
                                                "sense_id": "60feeddf-3869-398a-adbd-06e28c063e41",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains. Isolating a city’s effluent and shipping it away in underground sewers has probably saved more lives than any medical procedure except vaccination."
                                            },
                                            {
                                                "example_id": "6b121129-bed8-4ccf-96ae-4dc3725fe9ff",
                                                "sense_id": "60feeddf-3869-398a-adbd-06e28c063e41",
                                                "text": "All our stations have changed. We have to constrain numbers. We have to mandate face coverings. These are massive changes in what is a public transport city. This is not a car city."
                                            },
                                            {
                                                "example_id": "7c6584b4-27cf-41a6-8b48-51746a114ac7",
                                                "sense_id": "60feeddf-3869-398a-adbd-06e28c063e41",
                                                "text": "The Ukrainian government says Kyiv, Vinnytsia, Odesa, Zaporizhzhia and other cities have suffered a barrage of drone attacks, and pleaded with Western countries to step up their assistance in the face of the new challenge. […] But Ukraine claimed its forces had shot down one of these drones for the first time last month near the city of Kupyansk in Kharkiv."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d75987c8-7e69-33e4-9c4f-41eaa212fdb5",
                                        "entry_id": "33fb848f-b0b9-3625-9df7-e7e1885518ed",
                                        "glosses": [
                                            "A settlement granted special status by royal charter or letters patent; traditionally, a settlement with a cathedral regardless of size."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac419e88-1a96-40db-a9a6-778ffa638757",
                                                "sense_id": "d75987c8-7e69-33e4-9c4f-41eaa212fdb5",
                                                "text": "Manchester, incorporated in 1838, was made the centre of a bishopric in 1847 and became a city in 1853. Liverpool was transformed into a city by Royal Charter when the new diocese of Liverpool was created in 1880."
                                            },
                                            {
                                                "example_id": "908a0c21-8517-4200-a87c-2073d9750e25",
                                                "sense_id": "d75987c8-7e69-33e4-9c4f-41eaa212fdb5",
                                                "text": "St Davids itself is the smallest city in Great Britain, with a population of less than 2,000."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "965caf43-d59b-3a14-b84c-47dfae4e34ba",
                                        "entry_id": "33fb848f-b0b9-3625-9df7-e7e1885518ed",
                                        "glosses": [
                                            "The central business district; downtown."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99250f40-0642-4aa6-9dea-06ddb8c385d1",
                                                "sense_id": "965caf43-d59b-3a14-b84c-47dfae4e34ba",
                                                "text": "I'm going into the city today to do some shopping."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "182703b0-b3da-3bce-b27a-5e46e3ade9a1",
                                        "entry_id": "33fb848f-b0b9-3625-9df7-e7e1885518ed",
                                        "glosses": [
                                            "A large amount of something (used after the noun)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
