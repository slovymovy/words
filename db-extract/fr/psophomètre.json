                        "entry_id": "7b4fad8a-cbf8-38f1-b995-54815d80b91b",
                        "glosses": [
                            "Appareil de mesure et de visualisation des parasites à diverses tensions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ed4ab2-d72a-4ff3-bc44-bd23f2f5b2af",
                                "sense_id": "697252ac-bb12-3ec3-9d32-c18442af45c2",
                                "text": "Le psophomètre permet de mesurer le rapport signal à bruit d’un appareil audio (ampli ou autre)."
                            },
                            {
                                "example_id": "1b3f1746-b31c-42bc-bf13-f7a6602307ba",
                                "sense_id": "697252ac-bb12-3ec3-9d32-c18442af45c2",
                                "text": "Alors qu’un multimètre peine à mesurer un bruit de 10mV, 1mV pour les plus performants, le psophomètre lui déviera à pleine échelle en présence d’un bruit de 0,01mV avec pour celui que je possède une sensibilité de 0,05nV."
                            }
                        ]
                    }
                ],
