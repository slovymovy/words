                                "target_senses": [
                                    {
                                        "sense_id": "9045c63d-87d2-336b-8d20-1797b4f81ca6",
                                        "entry_id": "13bc2c33-6764-3d56-8e9b-2817e81202c9",
                                        "glosses": [
                                            "durch mechanische Einwirkung entstandene Vertiefung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "730c9dbb-98b4-4e9a-a00f-5ef3a758a347",
                                                "sense_id": "9045c63d-87d2-336b-8d20-1797b4f81ca6",
                                                "text": "Beim Einparken hat der Kotflügel eine Delle bekommen."
                                            }
