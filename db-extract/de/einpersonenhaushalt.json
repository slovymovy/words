                ],
                "senses": [
                    {
                        "sense_id": "842e6f9b-eb2e-3e56-9313-d9f6c4c21fe3",
                        "entry_id": "6e87dc70-3814-3860-91e2-31489140e04c",
                        "glosses": [
                            "aus genau einer Person bestehender Haushalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b5757ab-fb2b-4ebb-b4b8-f8c0a4482ed6",
                                "sense_id": "842e6f9b-eb2e-3e56-9313-d9f6c4c21fe3",
                                "text": "„SPÖ-Bundesgeschäftsführer Max Lercher wirft der Ministerin vor, von der Lebensrealität der Menschen keine Ahnung zu haben, und weist sie darauf hin, dass die Armutsgefährdungsschwelle für einen Einpersonenhaushalt laut Statistik Austria derzeit bei 1.238 Euro im Monat liege.“"
                            },
                            {
                                "example_id": "be50d72b-2214-44b2-bc6d-9dd815cd3215",
                                "sense_id": "842e6f9b-eb2e-3e56-9313-d9f6c4c21fe3",
                                "text": "„Damit lebte im vergangenen Jahr jeder fünfte Mensch in Deutschland in einem Einpersonenhaushalt, berichtete das Statistische Bundesamt am Dienstag über die Zusammensetzung der 41,4 Millionen privaten Haushalte in Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
