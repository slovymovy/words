                "senses": [
                    {
                        "sense_id": "2678ab24-5354-3fe1-afcc-57eaeb73bf8b",
                        "entry_id": "b88fd053-a32c-3586-bf71-c4ca19779f35",
                        "glosses": [
                            "Speicherung von Daten auf einem Datenträger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99403a32-bc86-4ba8-bdde-3a8c2e9198b9",
                                "sense_id": "2678ab24-5354-3fe1-afcc-57eaeb73bf8b",
                                "text": "„Diese untersagt die Aufbewahrung bzw. Speicherung von persönlichen Daten, anhand derer User identifiziert werden können, für einen längeren Zeitraum als notwendig, um den Zweck der Datenspeicherung zu erfüllen.“"
                            },
                            {
                                "example_id": "25c2721a-ddfd-464c-973f-18cd88a88ba9",
                                "sense_id": "2678ab24-5354-3fe1-afcc-57eaeb73bf8b",
                                "text": "„Die Skepsis gegen die zentrale Datenspeicherung hatte bereits bei der Abstimmung im Mai 2009 über den Biometrie-Pass eine Rolle gespielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
