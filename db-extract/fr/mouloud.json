                "senses": [
                    {
                        "sense_id": "c11770e8-fe9b-3319-ab2a-e41477b94c47",
                        "entry_id": "8a461db2-57de-3795-bff4-77a1e11764f5",
                        "glosses": [
                            "Personne d’origine maghrébine."
                        ],
                        "tags": [
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "068c274e-6883-438d-ac13-c8747f04af4e",
                                "sense_id": "c11770e8-fe9b-3319-ab2a-e41477b94c47",
                                "text": "Pour lui, tout était simple, simplissime : Dieu était grand, blanc, blond et musclé […] Les Arabes : même s’il s’agissait d’un prix Nobel de physique du Caire étaient tous des « moulouds »"
                            },
                            {
                                "example_id": "433766c3-8bbe-4656-af08-5d62df9d2d9f",
                                "sense_id": "c11770e8-fe9b-3319-ab2a-e41477b94c47",
                                "text": "Anvers est remplie de moulouds et de feujs."
                            },
                            {
                                "example_id": "d4dcf1af-0324-4fca-b6db-5deaeca9e3a9",
                                "sense_id": "c11770e8-fe9b-3319-ab2a-e41477b94c47",
                                "text": "La France aux Français, et la mouloudie aux moulouds."
                            },
                            {
                                "example_id": "eb909735-9a93-4b9f-9096-0c416062b1ee",
                                "sense_id": "c11770e8-fe9b-3319-ab2a-e41477b94c47",
                                "text": "Quant à dire que les bicots troisième génération sont là pour faire péter les diplômes, à part le CAP molotov on voit pas trop ce qu'ils ont comme diplôme les moulouds."
                            }
                        ]
                    }
