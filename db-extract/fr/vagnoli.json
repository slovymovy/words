                    {
                        "sense_id": "5eed144f-bca8-3105-8008-f350df5ea03a",
                        "entry_id": "9e309b39-dd82-32a6-a3c7-362f921d917f",
                        "glosses": [
                            "Chasseur qui prend les vanneaux par une tenderie spéciale."
                        ],
                        "tags": [
                            "Ardennes"
                        ],
                        "examples": [
                            {
                                "example_id": "df5244df-1adf-4bc9-8e3e-ca8b746d9182",
                                "sense_id": "5eed144f-bca8-3105-8008-f350df5ea03a",
                                "text": "Qu'on empêche donc aussi les vagnolis d'appeauter les vanneaux."
                            },
                            {
                                "example_id": "51f01bdb-b159-4de4-a1dd-c58c4e132d79",
                                "sense_id": "5eed144f-bca8-3105-8008-f350df5ea03a",
                                "text": "Même entre eux les vagnolis ne disent rien. Un vagnoli ne saura jamais ce que son confrère, qui tend à quelques kilomètres, prend durant une campagne."
                            },
                            {
                                "example_id": "212a4d2e-fcb3-4150-b315-739b40473db1",
                                "sense_id": "5eed144f-bca8-3105-8008-f350df5ea03a",
                                "text": "Assumant sans complexe ma passion pour la chasse et mon titre de vagnolis - de tendeur de vanneaux - je considère que j'ai le devoir, pour enrichir la réflexion, d'apporter ma contribution à l'étude de l'impact de la Révolution de 1789 sur la chasse."
                            }
                        ]
                    }
