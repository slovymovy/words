                "senses": [
                    {
                        "sense_id": "6b0d67e2-c3d4-38c2-99c5-8f69170749b4",
                        "entry_id": "6c8a1a0d-025d-39b0-bdd4-220e0aacae76",
                        "glosses": [
                            "Valoriser en passant de produits de base à des produits à bonne valeur ajoutée, ou de simples produits à des solutions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcee8026-ff42-4249-b734-589867f49abb",
                                "sense_id": "6b0d67e2-c3d4-38c2-99c5-8f69170749b4",
                                "text": "Pour « décommoditiser » leur activité, Hax et Wilde suggèrent d’avoir recours à la stratégie de solution client complète (l’entreprise répond aux attentes du client et donc celui-ci s’intéresse à nouveau aux produits de l’entreprise) ou à chercher le verrouillage du système."
                            },
                            {
                                "example_id": "23145543-29a3-4392-90f1-34cc353a89e1",
                                "sense_id": "6b0d67e2-c3d4-38c2-99c5-8f69170749b4",
                                "text": "Notre objectif est de décommoditiser le cacao tout en stimulant l'accès au marché aux petits producteurs."
                            },
                            {
                                "example_id": "1af0f0cc-99cc-4239-96b7-f25c83c778a8",
                                "sense_id": "6b0d67e2-c3d4-38c2-99c5-8f69170749b4",
                                "text": "Nous avons essayé de “décommoditiser” le liège, résume Carlos de Jesus."
                            }
                        ]
                    }
                ],
