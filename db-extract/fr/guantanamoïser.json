                        "glosses": [
                            "Donner un caractère rappelant la prison de Guantanamo à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc814a6e-e1ad-4308-9d00-ad0cd073dad9",
                                "sense_id": "7b42c971-b1eb-345d-98af-90a4ce6572de",
                                "text": "Il aurait à cette occasion recommandé de «guantanamoïser» le système des prisons en Irak."
                            }
                        ]
                    },
                    {
                        "sense_id": "473c532f-9a19-3d42-aaeb-7dc37efe7e56",
