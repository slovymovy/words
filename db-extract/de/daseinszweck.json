                "senses": [
                    {
                        "sense_id": "122d803c-c570-3aac-835d-165a6fc45ac7",
                        "entry_id": "470ddb05-1c78-3b42-a352-954faae6778f",
                        "glosses": [
                            "Sinn des Daseins, Ziel oder Nutzen der Existenz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "924f8a87-57bc-41a0-b777-bdabad6124dc",
                                "sense_id": "122d803c-c570-3aac-835d-165a6fc45ac7",
                                "text": "„Mitarbeitende wollen erkennen können, dass ihr Beitrag sinnvoll eingebunden ist in den übergeordneten Daseinszweck des Unternehmens.“"
                            },
                            {
                                "example_id": "a3de68e3-296c-49b1-bba4-8c45acbdc33f",
                                "sense_id": "122d803c-c570-3aac-835d-165a6fc45ac7",
                                "text": "„Aus den verschiedenen Antworten entwickelten sich unterschiedliche Lebensmodelle, die dem Menschen ein bestimmtes Handeln zur Erfüllung seines Daseinszwecks vorschrieben.“"
                            },
                            {
                                "example_id": "071b5be3-859f-4f5c-94e0-8842788b15d5",
                                "sense_id": "122d803c-c570-3aac-835d-165a6fc45ac7",
                                "text": "„Ein wichtiger Bestandteil unseres Daseinszwecks ist es nun aber, mit unseren und für unsere Mitmenschen zu arbeiten.“"
                            },
                            {
                                "example_id": "5d717054-1f6b-414f-9e5d-f43a67cd2417",
                                "sense_id": "122d803c-c570-3aac-835d-165a6fc45ac7",
                                "text": "„Das Glück seiner Untertanen sei der einzige Daseinszweck eines Fürsten und nur der ein guter Fürst, der diese Einsicht als einzigen moralischen Antrieb seines Tuns empfinde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
