                "senses": [
                    {
                        "sense_id": "867eec87-b4a3-36c7-aa0c-15f5523f89ef",
                        "entry_id": "067bb872-e860-353f-ad28-fc852138b1c0",
                        "glosses": [
                            "Fehlen von körperlicher Ausdauer und Kraft, mangelnde Fitness"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42b6342a-3c2a-4f6a-a995-1e5e617a2578",
                                "sense_id": "867eec87-b4a3-36c7-aa0c-15f5523f89ef",
                                "text": "Konditionsmängel kann man mit Lauftraining beseitigen."
                            },
                            {
                                "example_id": "512dfd2b-1eb2-4925-b708-5822a786019c",
                                "sense_id": "867eec87-b4a3-36c7-aa0c-15f5523f89ef",
                                "text": "[Boxen:] „Er gewann umstritten nach Punkten, zeigte aber wie häufig in seinen Kämpfen Konditionsmängel.“"
                            },
                            {
                                "example_id": "31c149b8-2da3-40f9-8c54-59a5dedd61ae",
                                "sense_id": "867eec87-b4a3-36c7-aa0c-15f5523f89ef",
                                "text": "[Boxen:] „Joppy hatte gegen Ende des Kampfes Konditionsmängel offenbart und versuchte dies durch Klammern und Ausweichen zu kompensieren.“"
                            },
                            {
                                "example_id": "0706ff6d-9d7d-4fa6-9268-c07a3763ab4f",
                                "sense_id": "867eec87-b4a3-36c7-aa0c-15f5523f89ef",
                                "text": "[Fußball:] „Wie schon bei seiner Präsentation am vergangenen Donnerstag in Rosario, wo er vor 40.000 begeisterten Zuschauern im Freundschaftsspiel gegen Emelec aus Ecuador ein wunderschönes Tor zum 1:0-Sieg schoß, zeigte sich Maradona spielerisch von seiner besten Seite, auch wenn ihn deutliche Konditionsmängel schwer nach Luft japsen ließen und zu mancher Verschnaufpause nötigten.“"
                            },
                            {
                                "example_id": "1fb87666-d54f-4da8-87cc-814c70ccb857",
                                "sense_id": "867eec87-b4a3-36c7-aa0c-15f5523f89ef",
                                "text": "[Fußball:] „Christian Wörns mäkelte nach dem 2:2 in der Bundesliga gegen Hannover, einige Spieler seien nach 60 Minuten „platt“ gewesen. Watzke, der schon früher mit van Marwijk häufiger aneinander gerasselt war, nahm die Vorlage auf und stellte öffentlich fest, er wolle dieser Frage der Konditionsmängel nachgehen.“"
                            },
                            {
                                "example_id": "f0c4fb76-65af-44a2-8e17-e725b434c86d",
                                "sense_id": "867eec87-b4a3-36c7-aa0c-15f5523f89ef",
                                "text": "[Fußball:] „»Da habe ich schon im Vorjahr gesagt, man soll Demir einfach mal in Ruhe lassen. Es war Unsinn, ihn bereits als neuen Messi zu bejubeln, wenn er dreimal hintereinander fehlerfrei einen Ball gestoppt hat. Genauso ist es Quatsch, jetzt einen Teenager wegen angeblicher oder tatsächlicher Konditionsmängel zu verdammen.«“"
                            },
                            {
                                "example_id": "1140c42e-e853-4187-966d-ff924d828743",
                                "sense_id": "867eec87-b4a3-36c7-aa0c-15f5523f89ef",
                                "text": "[Eiskunstlaufen:] „»Sie kann sich nicht quälen«, rügt Peter Krick, Sportdirektor der Deutschen Eislauf-Union (DEU), und erhebt gegen die 18jährige den schlimmsten Vorwurf, den man einer sporttreibenden Person deutscher Provenienz machen kann: Konditionsmängel.“"
                            },
                            {
                                "example_id": "55e6742e-a4fc-40dc-a1cb-bec09255caa8",
                                "sense_id": "867eec87-b4a3-36c7-aa0c-15f5523f89ef",
                                "text": "[…] „Ich checke Distanzen und Schwierigkeitsgrade im 220 Kilometer langen Loipennetz und sortiere lange Routen wie die schwarze Rittisloipe erstmal wegen Konditionsmangel aus.“"
                            },
                            {
                                "example_id": "5be4bbc4-3d35-418d-8238-fdd17acc1b2a",
                                "sense_id": "867eec87-b4a3-36c7-aa0c-15f5523f89ef",
                                "text": "„Ursächlich für die meisten Skiverletzungen ist jene Trias aus Imponiergehabe, Konditionsmangel und Dummheit, die sogar Untrainierte und Anfänger dazu bewegt, ohne Rücksicht auf eigene oder fremde Knochen durch die Mugeln zu preschen, wie der Österreicher die Buckelpiste nennt - die resultierenden Stürze sind allenfalls mit den Mitteln der Ballistik zu beschreiben.“"
                            },
                            {
                                "example_id": "3369a6f0-82f2-4045-b610-7a8131f0652a",
                                "sense_id": "867eec87-b4a3-36c7-aa0c-15f5523f89ef",
                                "text": "„Nach einer Corona-Erkrankung Ende 2021 litt sie wochenlang unter Lungenproblemen mit entsprechenden Konditionsmängeln.“"
                            },
                            {
                                "example_id": "650bf193-2f15-4c83-9fa0-5a92262e0453",
                                "sense_id": "867eec87-b4a3-36c7-aa0c-15f5523f89ef",
                                "text": "[Herzinsuffizienz:] „Experten kritisieren: Häufig vergeht geraume Zeit, bis Betroffene die richtigen Diagnose erhalten. »Symptome wie Atemnot werden als Konditionsmangel oder Altersschwäche fehlinterpretiert«, so Rudolf Berger vom Krankenhaus der Barmherzigen Brüder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
