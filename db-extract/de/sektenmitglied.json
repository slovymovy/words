                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44ddef58-d230-43ef-bb76-d121d6723920",
                                "sense_id": "50cd04cd-294b-32b2-80a2-74288e62a675",
                                "text": "„Ein fünftes Sektenmitglied wurde angeklagt, einen Fall von Kindesmissbrauch nicht gemeldet zu haben.“"
                            },
                            {
                                "example_id": "92bc399f-2cc1-479e-ae7e-b3cd8a4aeb16",
                                "sense_id": "50cd04cd-294b-32b2-80a2-74288e62a675",
                                "text": "„Am 14. November 1978 reiste der Abgeordnete mit einer Delegation aus Journalisten, ehemaligen Sektenmitgliedern und Anwälten nach Guyana, um das Dschungelcamp genauer zu inspizieren.“"
                            },
                            {
                                "example_id": "b63086b3-d971-4cd4-8b18-64a52a323b75",
                                "sense_id": "50cd04cd-294b-32b2-80a2-74288e62a675",
                                "text": "„Die Kinder der Sektenmitglieder waren dabei anwesend; mal als Zuschauer, mal als Teilnehmer.“"
