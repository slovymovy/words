                        "glosses": [
                            "Salz, das als Streumittel bei der Glatteisbekämpfung verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c211bc37-049c-4a58-a837-ee203aa50911",
                                "sense_id": "3a38ec88-f94a-3890-9ec3-b734ba1f1a18",
                                "text": "„Bei Bedarf könnte ein Helikopter Tausalz über das Dach streuen, wie es in einer Mitteilung vom Freitag heisst.“"
                            },
                            {
                                "example_id": "fa21ee58-9399-40fd-a01b-ffae101b15f0",
                                "sense_id": "3a38ec88-f94a-3890-9ec3-b734ba1f1a18",
                                "text": "„Die Frostperiode dauert mittlerweile bereits so lange, dass die Vorräte an Tausalz und Rollsplit in den US-Lagern zur Neige gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
