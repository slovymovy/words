                ],
                "senses": [
                    {
                        "sense_id": "d705eb05-ad44-3a66-b51a-bee37c9be14b",
                        "entry_id": "655c788c-3358-3454-8cd5-410640de9ebc",
                        "glosses": [
                            "Vertreter einer Gruppe von scheuen, nachtaktiven, baumlebenden Nagetieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a51c4485-3897-4120-a596-95eaa50f7f27",
                                "sense_id": "d705eb05-ad44-3a66-b51a-bee37c9be14b",
                                "text": "Die Bilche stehen zwischen den Mäusen und Eichhörnchen und leben von Samen, Früch[t]en, Insekten und Vogelbrut."
                            },
                            {
                                "example_id": "2db67b9b-7276-463b-a4d4-405dd6ad5d64",
                                "sense_id": "d705eb05-ad44-3a66-b51a-bee37c9be14b",
                                "text": "„Zwei Bilche, kleine Schlafmäuse, die beim Anblick meines dampfenden Körpers Schutz in der Weite der Heidelbeersträucher suchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e12d1dfb-2c59-465c-b475-e5edeae54c7b",
                        "source_entry_id": "655c788c-3358-3454-8cd5-410640de9ebc",
                        "source_sense_id": "d705eb05-ad44-3a66-b51a-bee37c9be14b",
                        "source_sense_description": "Zoologie: Vertreter einer Gruppe von scheuen, nachtaktiven, baumlebenden Nagetieren",
                        "target_lang_word": "dormouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dormouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6022c5a0-0fe2-3856-b320-570de5fc29c4",
                                        "entry_id": "7ff6232a-a5c0-3d51-b8e6-3f7bb09e8296",
                                        "glosses": [
                                            "Any of several species of small, mostly European rodents of the family Gliridae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b44ba363-b7f3-44ab-b3dc-306d8cc82498",
                                                "sense_id": "6022c5a0-0fe2-3856-b320-570de5fc29c4",
                                                "text": "For a long time the dormouse and polecat had seemed to him overfeeble enemies for his restless valour, even as the granary floor seemed to afford too narrow a field. Every day he read the papers of the previous day in the servants' hall of the houses he visited, and it appeared to him that this war in America, which was hailed as the awakening of the spirit of liberty and justice in the New World, ought to produce a revolution in France."
                                            },
                                            {
                                                "example_id": "86b9ab03-1c4b-4dc9-8991-1dc28dfc7a0f",
                                                "sense_id": "6022c5a0-0fe2-3856-b320-570de5fc29c4",
                                                "text": "Restoration such as this must work around wildlife habitats, and NR came to discover that almost the entire line was a haven for dormice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3ea1c64-4671-3cf0-8040-b9877a8297ef",
                                        "entry_id": "7ff6232a-a5c0-3d51-b8e6-3f7bb09e8296",
                                        "glosses": [
                                            "Any of several species of small, mostly European rodents of the family Gliridae.",
                                            "Glis glis (edible dormouse)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8feb55f8-2dc9-37cb-a066-5cacd91cb266",
                                        "entry_id": "7ff6232a-a5c0-3d51-b8e6-3f7bb09e8296",
                                        "glosses": [
                                            "Any of several species of small, mostly European rodents of the family Gliridae.",
                                            "Muscardinus avellanarius (hazel dormouse)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fe9cd4e-49c2-36d2-a18a-897f88135bd1",
                                        "entry_id": "7ff6232a-a5c0-3d51-b8e6-3f7bb09e8296",
                                        "glosses": [
                                            "A person who sleeps a great deal, or who falls asleep readily (by analogy with the sound hibernation of the dormouse)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d664cbdd-0ceb-445a-9ccc-38800c185217",
                        "source_entry_id": "655c788c-3358-3454-8cd5-410640de9ebc",
                        "source_sense_id": "d705eb05-ad44-3a66-b51a-bee37c9be14b",
                        "source_sense_description": "Zoologie: Vertreter einer Gruppe von scheuen, nachtaktiven, baumlebenden Nagetieren",
                        "target_lang_word": "loir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abf47695-675e-3161-a432-372e4d29520c",
                                        "entry_id": "96eb8b7f-6c1a-30aa-8164-3581f713d679",
                                        "glosses": [
                                            "Petit mammifère de la famille des gliridés ou myoxidés, sous-ordre des myomorphes, ordre des rongeurs vrais ; il en existe plusieurs espèces en Europe, en Asie et en Afrique."
                                        ],
                                        "tags": [
                                            "Glirologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7786c92-85d1-4b86-8db8-5e56c2e09b20",
                                                "sense_id": "abf47695-675e-3161-a432-372e4d29520c",
                                                "text": "Le loir gris atteint près de quinze à vingt centimètres de long, queue non comprise, essentiellement végétarien, il engraisse fortement juste avant l’hibernation."
                                            },
                                            {
                                                "example_id": "b60db7f6-311c-4d44-9fa0-7ddf9b3fe7c2",
                                                "sense_id": "abf47695-675e-3161-a432-372e4d29520c",
                                                "text": "Il faut donc conclure qu’à l’instar de l’ours, du loir et de la marmotte, Gaston hiberne!"
                                            },
                                            {
                                                "example_id": "46cde2a6-28e1-4c15-9f2c-c84086b3c91c",
                                                "sense_id": "abf47695-675e-3161-a432-372e4d29520c",
                                                "text": "Tout à coup, dans le grenier, les loirs commencèrent une sarabande, qui se termina par une bagarre, avec des bonds et des cris pointus. Puis, le silence se fit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
