                    {
                        "sense_id": "10a7d946-4aba-302c-ac75-ab1e3bb89b57",
                        "entry_id": "da61d878-289c-33fb-85f1-5c39929b8f2d",
                        "glosses": [
                            "Tissu de nouvelle formation, tumeur accidentelle et anormale qui se développe sur une partie du corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "568cb413-f51b-4d38-b3bb-8ed92db64cdf",
                                "sense_id": "10a7d946-4aba-302c-ac75-ab1e3bb89b57",
                                "text": "Le terme de « néoplasme » utilisé ici doit s’entendre comme « tumeur » et ne préjuge donc pas de la nature bénigne ou maligne du nodule."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3591810a-aa03-4187-83a0-49c3fe091205",
                        "source_entry_id": "da61d878-289c-33fb-85f1-5c39929b8f2d",
                        "source_sense_id": "10a7d946-4aba-302c-ac75-ab1e3bb89b57",
                        "target_lang_word": "neoplasm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neoplasm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e7c0ef3-d40d-3946-a4b0-b0fb139ded20",
                                        "entry_id": "81da8bc4-97ae-3f97-b6ef-9932a828695c",
                                        "glosses": [
                                            "An abnormal new growth of disorganized tissue in animals or plants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b3a990-ec51-4040-95c1-852154e1f164",
                                                "sense_id": "4e7c0ef3-d40d-3946-a4b0-b0fb139ded20",
                                                "text": "Other and less common causes for an oromaxillary fistula are infections, cysts and neoplasms of the maxilla which may destroy the intervening bone, resulting in a fistula between the maxillary sinus and the oral cavity."
                                            },
                                            {
                                                "example_id": "08419a21-d6c3-4d97-b77d-26d5991f1b2d",
                                                "sense_id": "4e7c0ef3-d40d-3946-a4b0-b0fb139ded20",
                                                "text": "While we cannot firmly attribute the cause of the benign neoplasm to the irregularity in your genetic makeup, we can confirm that the progressive damage renders you unable to conceive a child."
                                            },
                                            {
                                                "example_id": "7d8f3cb6-d600-4072-a382-aad696a0d0f7",
                                                "sense_id": "4e7c0ef3-d40d-3946-a4b0-b0fb139ded20",
                                                "text": "Angiosarcoma is the most-common differentiated malignant neoplasm of the heart and accounts for 10–15% of primary cardiac malignancies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
