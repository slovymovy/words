                        "glosses": [
                            "wyraz niemający własnego akcentu i tworzący całość akcentową z wyrazem go poprzedzającym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4981c405-132b-456e-88af-d343e9f90462",
                                "sense_id": "b9b712e1-0aa9-33df-967d-064836d8c2b1",
                                "text": "Mogą one poprzedzać taki wyraz (proklityki, np. do domu, u stóp), albo następować po nim (enklityki, por.: bij go, daj mi)."
                            }
                        ],
