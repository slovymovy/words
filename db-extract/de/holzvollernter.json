                        "examples": [
                            {
                                "example_id": "3e5976c4-4340-417e-b2e1-245f3f042c94",
                                "sense_id": "ed6f3b1e-34c6-397e-b95e-cf6973e201af",
                                "text": "„Ein Holzvollernter begann auf dem Berg damit, die Fichten und Eschen abzuschneiden […].“"
                            },
                            {
                                "example_id": "d02a018b-fb56-4a81-a705-859e84f2d183",
                                "sense_id": "ed6f3b1e-34c6-397e-b95e-cf6973e201af",
                                "text": "„Der große Fällbagger, ein Holzvollernter, arbeitet sich mit seiner Kralle durch das abgezäunte Gebiet und fällt einen Baum nach dem anderen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
