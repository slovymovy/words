                    },
                    {
                        "form_id": "4496d99e-0f5b-4305-a30e-d57320f299ab",
                        "entry_id": "edb1e26f-106f-3ba9-bfd2-4d843df02b87",
                        "tags": [],
                        "form": "plastique"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae901ca1-409e-3dd7-ba32-52d511413aff",
                        "entry_id": "edb1e26f-106f-3ba9-bfd2-4d843df02b87",
                        "glosses": [
                            "Explosif très puissant composé d’hexogène ou de penthrite, de liant comme la gomme butadiène-styrène, de plastifiants et parfois d’huile minérale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4368d646-68a9-4868-b103-658066a3a44e",
                                "sense_id": "ae901ca1-409e-3dd7-ba32-52d511413aff",
                                "text": "Le sabotage a été fait au plastic."
                            },
                            {
                                "example_id": "fc3f5ec3-04e9-48f1-9574-ab8e700ae9ea",
                                "sense_id": "ae901ca1-409e-3dd7-ba32-52d511413aff",
                                "text": "Le jour tant attendu arriva : des camions passèrent le pont-levis et s’offrit à nos yeux l’inoubliable et bouleversant spectacle de containers chargés d’armes parachutées d’Angleterre. Ils furent ouverts avec un respect infini : les mitraillettes Sten, les impressionnants fusils-mitrailleurs Bren à chargeur courbe, les grenades défensives avec leur goupille et leur cuiller qui exploseraient, une fois armées, en gerbes d’éclats meurtriers, les colts 11,43, les charges de plastic Gamon, en forme de grosses poires noires, destinées à faire sauter les ponts ou les blindés, furent alignés sur des bâches."
                            },
                            {
                                "example_id": "cddc2cbd-0470-447d-968d-ac11384c47eb",
                                "sense_id": "ae901ca1-409e-3dd7-ba32-52d511413aff",
                                "text": "Son idée était de sortir discrètement de la mosquée, de repérer les charges de plastic posées par les hommes de sable et de déclencher leur explosion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "400f4c68-ee23-4a9e-bc24-02ebe22b1170",
                        "source_entry_id": "edb1e26f-106f-3ba9-bfd2-4d843df02b87",
                        "source_sense_id": "ae901ca1-409e-3dd7-ba32-52d511413aff",
                        "source_sense_description": "Explosif",
                        "target_lang_word": "Plastiksprengstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plastiksprengstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a257300a-e258-3d4e-9bfc-85bd79dbc363",
                                        "entry_id": "88692427-22bc-31d8-99e1-0143f4624e5b",
                                        "glosses": [
                                            "Sprengstoff, der weich und formbar (plastisch) ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "815d9148-fe4d-45ab-943a-d4b0f2814047",
                                                "sense_id": "a257300a-e258-3d4e-9bfc-85bd79dbc363",
                                                "text": "„Das kleinere Päckchen, das sie vor sich haben, enthält einen hochexplosiven Plastiksprengstoff, der von Leuten, die etwas von solchen Sachen verstehen, hoch geschätzt wird.“"
                                            },
                                            {
                                                "example_id": "5d462f60-f68a-4a33-af93-d7ad1c661c95",
                                                "sense_id": "a257300a-e258-3d4e-9bfc-85bd79dbc363",
                                                "text": "„Und nun stand der Kerl, der Plastiksprengstoff, Zünder und Sprengkapseln nach militärischen Qualitätsstandards besorgt hatte, ganz in seiner Nähe.“"
                                            },
                                            {
                                                "example_id": "6a7c51cc-55f6-4a4b-a566-9d5ece708231",
                                                "sense_id": "a257300a-e258-3d4e-9bfc-85bd79dbc363",
                                                "text": "„›Jedes Implantat enthält zwei Gramm des Plastiksprengstoffs PVV-5A - nicht viel, aber genug, um einen Drachenkopf von innen explodieren zu lassen.‹“"
                                            },
                                            {
                                                "example_id": "b6836b65-87a1-4a42-8987-82587f7c5dbe",
                                                "sense_id": "a257300a-e258-3d4e-9bfc-85bd79dbc363",
                                                "text": "„Fjodor Sacharow aktivierte den Zeitzünder für die Serie von 30 Sprengladungen überall im Gewölbekeller; der ganze Plastiksprengstoff unter dem Schloss würde mit einem Mal hochgehen.“"
                                            },
                                            {
                                                "example_id": "98a8e56a-1585-4fb8-900c-d7a2111393f6",
                                                "sense_id": "a257300a-e258-3d4e-9bfc-85bd79dbc363",
                                                "text": "„Der Fußboden war mit aufgeschlagenen Zeitungen bedeckt. Darauf lagen in regelmäßigen Abständen kleine Päckchen mit, so nahm Ian an, Plastiksprengstoff, und sorgfältig verdrahtete Apparate, die Sprengzünder sein mussten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
