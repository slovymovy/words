                        "examples": [
                            {
                                "example_id": "fc8fd1a7-ff4b-4ca4-a0c7-d9baecbe96c2",
                                "sense_id": "fcefaf34-050d-3d9d-a49d-7c7a2e7ee4eb",
                                "text": "Воровство среди генералов и дедовщина среди солдат являются лишь следствием страшного социального закона: наша армия создана из людей, которых общество сочло людьми второго сорта.",
                                "translation": "Zlodějina mezi generály a šikana mezi vojáky jsou pouze následkem strašného sociálního zákona: naše vojsko se skládá z lidí, které společnost považuje za lidi druhé třídy."
                            }
                        ]
                    }
