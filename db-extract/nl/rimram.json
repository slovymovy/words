                "senses": [
                    {
                        "sense_id": "6c778d76-d0c7-39eb-ba25-0b9526017d94",
                        "entry_id": "8f2771cb-af1f-3173-a6ff-0b21859f46e4",
                        "glosses": [
                            "holle, opgeblazen maar verder inhoudsloze prietpraat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4fd01d6-6dae-4c19-938f-22e20575da7b",
                                "sense_id": "6c778d76-d0c7-39eb-ba25-0b9526017d94",
                                "text": "Soms werd de eurosceptische stelling met minder ideologische rimram bekritiseerd. Dan klonk losjes het 'hand in eigen boezem'- argument: 'ons' Griekenland en Italië zijn ook zo corrupt en chaotisch als de pest en toch gaat het goed. Beter meer corruptie binnen de EU dan aan haar buitengrens."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d84a193-2817-3096-b7dc-fb60d55a9901",
                        "entry_id": "8f2771cb-af1f-3173-a6ff-0b21859f46e4",
                        "glosses": [
                            "alle zinnige en onzinnige zaken die ergens bij horen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44b3fd47-057f-4b07-adb2-d395ff99b48d",
                                "sense_id": "6d84a193-2817-3096-b7dc-fb60d55a9901",
                                "text": ",,We hebben heel lang gesteggeld over de uitzendduur. Die was onbeperkt en gaat nu naar maximaal achttien maanden. Maar het belangrijkste is dat gedetacheerde werknemers vanaf dag één hetzelfde salaris verdienen, inclusief vakantietoeslagen, dertiende maand en andere rimram."
                            }
                        ]
                    }
