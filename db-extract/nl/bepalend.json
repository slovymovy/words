                                    {
                                        "sense_id": "1a1b51d2-8854-3cd8-a18a-98da7b4b348f",
                                        "entry_id": "23b83747-0386-3f6c-aba8-397d8a48275a",
                                        "glosses": [
                                            "Serving to define or distinguish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de318d2-cb02-4595-9785-52611f4afb8d",
                                                "sense_id": "1a1b51d2-8854-3cd8-a18a-98da7b4b348f",
                                                "text": "The ability to reproduce is a defining characteristic of living organisms."
                                            }
                                        ]
