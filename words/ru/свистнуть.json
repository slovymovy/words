{
    "word_family": [
        "свист",
        "свисток",
        "свистулька",
        "свистеть",
        "свирестеть"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "062c7a6e-3c1b-3c2c-b900-339af92eafcd",
                    "sense_definition": "Издать резкий звук с помощью губ или специального приспособления.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мальчик громко <w>свистнул</w>, чтобы позвать собаку.",
                            "target_lang_translations": {
                                "en": "The boy <w>whistled</w> loudly to call the dog."
                            }
                        },
                        {
                            "text": "Судья <w>свистнул</w>, и матч закончился.",
                            "target_lang_translations": {
                                "en": "The referee <w>whistled</w>, and the match was over."
                            }
                        }
                    ],
                    "common_phrases": [
                        "громко свистнуть"
                    ],
                    "target_lang_definitions": {
                        "en": "To produce a sharp sound using the lips or a special device."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whistle",
                                "target_lang_sense_clarification": "to make a clear, high-pitched sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e7a63c1-880e-3b6e-93a8-2f0da145b645",
                    "sense_definition": "Тайно или незаконно присвоить чужую вещь.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Кто-то <w>свистнул</w> мой кошелек в переполненном автобусе.",
                            "target_lang_translations": {
                                "en": "Someone <w>swiped</w> my wallet on the crowded bus."
                            }
                        },
                        {
                            "text": "Он <w>свистнул</w> яблоко с прилавка, пока продавец отвернулся.",
                            "target_lang_translations": {
                                "en": "He <w>pinched</w> an apple from the counter while the seller was looking away."
                            }
                        }
                    ],
                    "synonyms": [
                        "украсть",
                        "стащить",
                        "умыкнуть"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Разговорное слово, часто используется в бытовом контексте."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To secretly or illegally take someone else's property."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swipe",
                                "target_lang_sense_clarification": "informal term for stealing something quickly"
                            },
                            {
                                "target_lang_word": "pinch",
                                "target_lang_sense_clarification": "informal term for stealing something small"
                            },
                            {
                                "target_lang_word": "nick",
                                "target_lang_sense_clarification": "British informal term for stealing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2269a5f9-7151-309d-b7dc-3e30bb3aa781",
                    "sense_definition": "Сильно и резко ударить кого-либо или что-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Кучер <w>свистнул</w> кнутом по спине уставшей лошади.",
                            "target_lang_translations": {
                                "en": "The coachman <w>lashed</w> the tired horse's back with his whip."
                            }
                        },
                        {
                            "text": "Он <w>свистнул</w> его палкой по плечу в пылу ссоры.",
                            "target_lang_translations": {
                                "en": "He <w>whipped</w> him on the shoulder with a stick in the heat of the argument."
                            }
                        }
                    ],
                    "synonyms": [
                        "хлестнуть",
                        "ударить"
                    ],
                    "common_phrases": [
                        "свистнуть кнутом"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Просторечное выражение."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To strike someone or something with force and a sharp sound."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lash",
                                "target_lang_sense_clarification": "to strike with a whip or similar object"
                            },
                            {
                                "target_lang_word": "whip",
                                "target_lang_sense_clarification": "to strike suddenly and sharply"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}