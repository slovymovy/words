                "senses": [
                    {
                        "sense_id": "27769fd6-4836-3f93-ac4f-5055ab6a7395",
                        "entry_id": "0b6d443a-b6fb-3328-901c-6976d45449c1",
                        "glosses": [
                            "Herrschaft, die mit willkürlicher Gewalt ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db5ee77e-78ad-42c9-8c80-9a271f4740fa",
                                "sense_id": "27769fd6-4836-3f93-ac4f-5055ab6a7395",
                                "text": "„Für die Schwarzen, egal welchen Bildungsstandes, gibt es als Strafe weiterhin Hiebe mit der Peitsche aus Flusspferdhaut, wie einst unter Leopolds Gewaltherrschaft.“"
                            },
                            {
                                "example_id": "4fa3b46e-de1a-4ca8-b6ee-d32c3d6c62f6",
                                "sense_id": "27769fd6-4836-3f93-ac4f-5055ab6a7395",
                                "text": "„Während er im Westen weithin als Diktator eingeschätzt wird, findet er in Afrika trotz seiner Gewaltherrschaft und der Zerstörung seines Landes eine erstaunlich positive Resonanz.“"
                            },
                            {
                                "example_id": "58610659-642b-4482-b341-af58a2f76b0a",
                                "sense_id": "27769fd6-4836-3f93-ac4f-5055ab6a7395",
                                "text": "[Richard von Weizsäcker, 8. Mai 1985:] […] „»Der 8. Mai war ein Tag der Befreiung. Er hat uns alle befreit von dem menschenverachtenden System der nationalsozialistischen Gewaltherrschaft.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
