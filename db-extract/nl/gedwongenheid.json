                        "sense_id": "4cf2ba02-3f5a-3e01-8294-87c43ecd056c",
                        "entry_id": "15adc7ee-1995-3669-bb6a-2a73e4fd4d7b",
                        "glosses": [
                            "een gevoel dat door een moeilijke misschien zelfs wel schaamtevolle situatie wordt opgewekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22156256-1862-492a-ae57-cdd79eed8467",
                                "sense_id": "4cf2ba02-3f5a-3e01-8294-87c43ecd056c",
                                "text": "Zij stak de sleutel in het slot, ging hem voor, hij hielp haar met haar mantel, en het was zo gezellig en vanzelfsprekend als de thuiskomst na een geïmproviseerd huwelijksreisje; maar toen zij eenmaal boven waren, in helderder lamplicht, met een schemerlamp erbij, die de kamer niet warmer maakte, werd hij voor het eerst iets gewaar van de gedwongenheid, die hij verwacht had, wanneer zijn gespreksstof uitgeput zou raken."
                            }
                        ]
                    }
