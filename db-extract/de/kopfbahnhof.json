                "senses": [
                    {
                        "sense_id": "18371f22-f9cf-31e4-a45a-0157da2548bd",
                        "entry_id": "df4f49d2-b8c9-3883-b5cf-e0e1931427cf",
                        "glosses": [
                            "a train station which trains can enter in one direction only; a terminus (but not necessarily as a final destination; often conditioned by existing urban development at the time of railway construction)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "5d41435f-7b2d-40d7-bcf0-4e8084f4b453",
                                "sense_id": "18371f22-f9cf-31e4-a45a-0157da2548bd",
                                "text": "Der Frankfurter Hauptbahnhof ist ein Kopfbahnhof und dennoch ein verkehrsreicher Durchgangsbahnhof.",
                                "translation": "Frankfurt main station is a terminus station, but nevertheless a busy through station.",
                                "english": "Frankfurt main station is a terminus station, but nevertheless a busy through station."
                            }
                        ]
                    }
                ],
