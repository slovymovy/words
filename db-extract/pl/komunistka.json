                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7d82de8-1679-486e-9b5b-c03d231439e9",
                                "sense_id": "5a4e980b-26d7-3c10-affb-7e86be6e6ec0",
                                "text": "Czytam sobie dyskusję na facebooku i doszłam do wniosku, że chyba jestem komunistką, przynajmniej w oczach zwolenników prywatyzacji i takich tam."
                            }
