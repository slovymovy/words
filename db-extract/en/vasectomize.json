                                "sense_id": "cb1f875c-7621-3abd-947d-1ff89515ef11",
                                "text": "\"No previous attempts had been made to vasectomize a donkey, let alone an entire population.\""
                            },
                            {
                                "example_id": "294fb3b7-f721-42bb-9b18-b952976d1391",
                                "sense_id": "cb1f875c-7621-3abd-947d-1ff89515ef11",
                                "text": "\"One or two female mice are placed with the vasectomized male and are checked for plugs the following morning.\""
                            },
                            {
                                "example_id": "4eac0ed8-8d29-4e03-9376-42d70ef2fa8d",
                                "sense_id": "cb1f875c-7621-3abd-947d-1ff89515ef11",
                                "text": "\"In February 1986, 20 dominant stallions were vasectomized in the Beaty Butte area in the southeast corner of Oregon.\""
                            }
