                "senses": [
                    {
                        "sense_id": "6db9517e-1302-3d1e-9058-283478d31c64",
                        "entry_id": "83500bed-643d-3d7a-a298-478c2d1677eb",
                        "glosses": [
                            "Technikraum in einem Gebäude oder Bauwerk, in dem die zentrale Lüftungstechnik steht und betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eebf271-ce0f-4c98-8b8b-6d281c968b10",
                                "sense_id": "6db9517e-1302-3d1e-9058-283478d31c64",
                                "text": "„Zur Verbindung der unterirdischen Lüftungsstationen mit der Bergoberfläche mussten vertikale Luftschächte erstellt werden mit einem Durchmesser von 6 m.“"
                            },
                            {
                                "example_id": "c1f463ad-05c7-4b15-88eb-111f2cff364b",
                                "sense_id": "6db9517e-1302-3d1e-9058-283478d31c64",
                                "text": "„Die zentral angeordnete Bedieneinheit (ZS-Plus) ermöglicht den Anschluss von bis zu sechs Lüftungsstationen Z-WRG Plus für den Betrieb in den untenstehend beschriebenen Programmfunktion bei fünf Luftleistungsstufen.“"
                            },
                            {
                                "example_id": "c968fd84-a4b1-4eef-8ef1-d65d6fab77a2",
                                "sense_id": "6db9517e-1302-3d1e-9058-283478d31c64",
                                "text": "„Auch der Bereitschaftsraum mit seinem gastronomischen Betrieb hat seine eigene Lüftungsstation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d080e446-9230-3e12-97d3-82f5091a612d",
                        "entry_id": "83500bed-643d-3d7a-a298-478c2d1677eb",
                        "glosses": [
                            "separater Bau oder Gebäude in dem Lüftungstechnik steht und betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95c015c9-0f8d-4639-a610-7762f122a0ad",
                                "sense_id": "d080e446-9230-3e12-97d3-82f5091a612d",
                                "text": "„Die restliche Lüftung wird durch zentrale Lüftungsstationen betrieben und über Kanäle sowohl in die arena als auch in den Club verteilt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3a6238bd-166f-3761-b051-6f733ecd0d8e",
                        "entry_id": "83500bed-643d-3d7a-a298-478c2d1677eb",
                        "glosses": [
                            "Gerät oder technische Einheit die Luft bewegt oder durch die Luft strömt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e011b6a1-cbe9-4a50-b322-f8918d30c421",
                                "sense_id": "3a6238bd-166f-3761-b051-6f733ecd0d8e",
                                "text": "„Durch die neuen Lüftungsstationen können wir jetzt auch wieder Versuche zeigen und den Unterricht lebendiger Gestalten\", stellt Herr Ruppert fest.“"
                            },
                            {
                                "example_id": "ffa04544-2762-4ad8-b2c4-0c51546375ee",
                                "sense_id": "3a6238bd-166f-3761-b051-6f733ecd0d8e",
                                "text": "„Über die kompakte Lüftungsstation wird diese mit Hilfe der Abwärme der verbrauchten Luft nahezu auf Zimmertemperatur erwärmt und dann in alle Räume weiter geleitet.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
