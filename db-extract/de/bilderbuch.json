                    }
                ],
                "senses": [
                    {
                        "sense_id": "316fdd9e-8df4-3445-8114-53f634445705",
                        "entry_id": "7a3773b0-2284-3629-9fe1-64153f77a028",
                        "glosses": [
                            "Buch mit vielen Bildern und wenig Text"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5b64fe5-7811-4bce-85e0-f5e74ceab7d9",
                                "sense_id": "316fdd9e-8df4-3445-8114-53f634445705",
                                "text": "Man dachte immer, unsere Nachbarn sind eine Familie wie im Bilderbuch – und dann so was!"
                            },
                            {
                                "example_id": "20692e20-2280-4848-aad0-b671ca6da7e1",
                                "sense_id": "316fdd9e-8df4-3445-8114-53f634445705",
                                "text": "Die Seiten von Bilderbüchern für die Allerkleinsten bestehen meist aus reißfestem Karton."
                            },
                            {
                                "example_id": "1f33753a-8748-45d3-9a54-c6db0b8151e7",
                                "sense_id": "316fdd9e-8df4-3445-8114-53f634445705",
                                "text": "„Das eine mit Itzig Finkelstein fuhr drei Stunden lang in halsbrecherischer Fahrt durch eine Sand- und Steinwüste, die Itzig Finkelstein von Bilderbüchern und Postkarten her bekannt vorkam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1bfb5cbd-dc82-38ef-bf2a-1a01f1647012",
                        "entry_id": "7a3773b0-2284-3629-9fe1-64153f77a028",
                        "glosses": [
                            "ein illustriertes Buch"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "68a7713f-1ca6-4d19-a51b-babd74eede98",
                                "sense_id": "1bfb5cbd-dc82-38ef-bf2a-1a01f1647012",
                                "text": "„Für Kreszentia hat Mühsam in der Haft zwei Bilderbücher geschrieben, Gedichte mit getuschten Federzeichnungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
