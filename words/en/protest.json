{
    "word_family": [
        "protester",
        "protestation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5687530-8fd0-3123-b1d6-cca7f3bc8987",
                    "sense_definition": "A public demonstration or organized effort to show disapproval of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We held a large <w>protest</w> in front of City Hall to demand changes.",
                            "target_lang_translations": {
                                "ru": "Мы провели масштабный <w>протест</w> перед мэрией, требуя перемен.",
                                "zh": "我们在市政厅前举行了一场大规模<w>抗议</w>活动，要求进行变革。"
                            }
                        },
                        {
                            "text": "The students organized a peaceful <w>protest</w> against the new university rules.",
                            "target_lang_translations": {
                                "ru": "Студенты организовали мирный <w>протест</w> против новых правил университета.",
                                "zh": "学生们组织了一场和平<w>抗议</w>，反对学校的新规定。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "peaceful protest",
                        "street protest",
                        "hold a protest",
                        "protest movement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичное мероприятие или организованные действия для выражения несогласия с чем-либо.",
                        "zh": "为表达对某事的不满而进行的公开示威或有组织的活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протест",
                                "target_lang_sense_clarification": "общее понятие"
                            },
                            {
                                "target_lang_word": "демонстрация",
                                "target_lang_sense_clarification": "шествие"
                            },
                            {
                                "target_lang_word": "митинг",
                                "target_lang_sense_clarification": "собрание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抗议",
                                "target_lang_sense_clarification": "一般性抗议活动"
                            },
                            {
                                "target_lang_word": "示威",
                                "target_lang_sense_clarification": "公开的游行或集会"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e7567e2-ebd7-3554-b84f-a0014560f543",
                    "sense_definition": "A formal statement expressing objection, dissent, or disapproval.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They lodged a formal <w>protest</w> with the authorities regarding the unfair decision.",
                            "target_lang_translations": {
                                "ru": "Они подали официальный <w>протест</w> властям по поводу несправедливого решения.",
                                "zh": "他们就这项不公正的决定向当局提交了正式<w>抗议</w>。"
                            }
                        },
                        {
                            "text": "He resigned from the committee in <w>protest</w> over the new policy.",
                            "target_lang_translations": {
                                "ru": "Он вышел из комитета в знак <w>протеста</w> против новой политики.",
                                "zh": "他因<w>抗议</w>新政策而辞去了委员会的职务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "objection",
                        "dissent",
                        "protestation"
                    ],
                    "common_phrases": [
                        "lodge a protest",
                        "in protest",
                        "under protest",
                        "without protest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заявление, выражающее возражение или несогласие.",
                        "zh": "表达反对、异议或不满的正式声明。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протест",
                                "target_lang_sense_clarification": "официальное возражение"
                            },
                            {
                                "target_lang_word": "возражение",
                                "target_lang_sense_clarification": "несогласие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抗议",
                                "target_lang_sense_clarification": "正式的反对意见"
                            },
                            {
                                "target_lang_word": "异议",
                                "target_lang_sense_clarification": "不同意见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08973dda-e5b6-3b5c-a372-4c7b22fa0d55",
                    "sense_definition": "A formal declaration by a notary public that a bill of exchange has been dishonored.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank issued a <w>protest</w> after the payment was refused.",
                            "target_lang_translations": {
                                "ru": "Банк оформил <w>протест</w> после отказа в платеже.",
                                "zh": "在付款被拒绝后，银行出具了<w>拒绝证书</w>。"
                            }
                        },
                        {
                            "text": "A notary was called to prepare the <w>protest</w> for the unpaid note.",
                            "target_lang_translations": {
                                "ru": "Нотариуса вызвали для составления <w>протеста</w> по неоплаченному векселю.",
                                "zh": "有人请了公证人来为这张未付票据准备<w>拒绝证书</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный акт нотариуса, удостоверяющий отказ в платеже по векселю.",
                        "zh": "公证人出具的证明票据被拒付的正式文书。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протест",
                                "target_lang_sense_clarification": "финансовый/юридический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拒绝证书",
                                "target_lang_sense_clarification": "法律及金融术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04a50ec1-e2b5-3c36-86eb-959cfc26a745",
                    "sense_definition": "To express strong disagreement or disapproval, especially publicly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thousands of people took to the streets to <w>protest</w> against the war.",
                            "target_lang_translations": {
                                "ru": "Тысячи людей вышли на улицы, чтобы <w>протестовать</w> против войны.",
                                "zh": "成千上万的人走上街头，<w>抗议</w>战争。"
                            }
                        },
                        {
                            "text": "The workers are <w>protesting</w> for better wages and safer conditions.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>протестуют</w>, требуя повышения зарплаты и безопасных условий труда.",
                                "zh": "工人们正在<w>抗议</w>，要求提高工资并改善安全条件。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "protest against",
                        "protest loudly",
                        "right to protest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать решительное несогласие или неодобрение, особенно публично.",
                        "zh": "表达强烈的不同意或不满，尤指公开表达。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протестовать",
                                "target_lang_sense_clarification": "выражать несогласие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抗议",
                                "target_lang_sense_clarification": "表达不满"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6636cdaf-4dfa-3484-b7d3-c9c649f4c785",
                    "sense_definition": "To publicly demonstrate against or object to a specific action or decision directly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Local residents <w>protested</w> the demolition of the historic school building.",
                            "target_lang_translations": {
                                "ru": "Местные жители <w>протестовали</w> против сноса исторического здания школы.",
                                "zh": "当地居民<w>反对</w>拆除那座历史悠久的校舍。"
                            }
                        },
                        {
                            "text": "Students <w>protested</w> the tuition increase by blocking the entrance.",
                            "target_lang_translations": {
                                "ru": "Студенты <w>протестовали</w> против повышения платы за обучение, заблокировав вход.",
                                "zh": "学生们通过封锁入口来<w>抗议</w>学费上涨。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "protest the decision",
                        "protest the war"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публично выступать против конкретного действия или решения.",
                        "zh": "公开反对某项具体行动或决定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступать против",
                                "target_lang_sense_clarification": "противодействовать"
                            },
                            {
                                "target_lang_word": "протестовать",
                                "target_lang_sense_clarification": "против чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反对",
                                "target_lang_sense_clarification": "对某事持异议"
                            },
                            {
                                "target_lang_word": "抗议",
                                "target_lang_sense_clarification": "公开表示反对"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a659d694-9b09-32a9-9eb0-7e0e79c21548",
                    "sense_definition": "To state something firmly and solemnly, especially to deny a charge or doubt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect continued to <w>protest</w> his innocence despite the evidence.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый продолжал <w>настаивать</w> на своей невиновности, несмотря на улики.",
                                "zh": "尽管有证据，嫌疑人仍继续<w>坚称</w>自己是无辜的。"
                            }
                        },
                        {
                            "text": "She <w>protested</w> that she had never met the man before in her life.",
                            "target_lang_translations": {
                                "ru": "Она <w>уверяла</w>, что никогда раньше не встречала этого мужчину.",
                                "zh": "她<w>坚称</w>自己这辈子从未见过那个人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "protest one's innocence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердо и торжественно утверждать что-либо, особенно отрицая обвинение.",
                        "zh": "坚定且郑重地陈述某事，尤指否认指控或怀疑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настаивать",
                                "target_lang_sense_clarification": "твердо утверждать"
                            },
                            {
                                "target_lang_word": "уверять",
                                "target_lang_sense_clarification": "убеждать в истинности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坚称",
                                "target_lang_sense_clarification": "坚定地声称"
                            },
                            {
                                "target_lang_word": "申辩",
                                "target_lang_sense_clarification": "为自己辩解"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}