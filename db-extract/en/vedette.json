                "senses": [
                    {
                        "sense_id": "9a185452-fda3-3492-ac05-cbe50380dcb7",
                        "entry_id": "21994943-e17f-3088-adcf-ca1658c09da4",
                        "glosses": [
                            "A sentinel, usually on horseback, stationed on the outpost of an army, to watch an enemy and give notice of danger."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7bbd52a1-70f9-48aa-86b0-e67804a62ef1",
                                "sense_id": "9a185452-fda3-3492-ac05-cbe50380dcb7",
                                "text": "The enemy made no effort to pursue Marshal Blücher. On the contrary, a patrole which I sent to Sombref in the morning found all quiet; and the enemy's vedettes fell back as the patrole advanced."
                            },
                            {
                                "example_id": "83ba4607-b0a8-48d0-a595-de2c6bc6cde7",
                                "sense_id": "9a185452-fda3-3492-ac05-cbe50380dcb7",
                                "text": "My goal was Desolation Peak, the cabin where rookie vedette Jack Kerouac spent 63 eventful days in the summer of 1956."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d34eb38-56a9-334e-9b05-ca67fd068f1c",
                        "entry_id": "21994943-e17f-3088-adcf-ca1658c09da4",
                        "glosses": [
                            "A cabaret performer, usually the main female artist of a show."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85139b58-fb62-4e22-85bc-5acaad1b013b",
                                "sense_id": "5d34eb38-56a9-334e-9b05-ca67fd068f1c",
                                "text": "Josephine Baker arrived in Cuba in 1951. When this famous black American vedette arrived—she who had first enraptured Paris and later the rest of Europe—Rita Montaner played a trick on her. La Baker, as well as Cuban vedettes and rumba dancers, had conquered Europe by selling exoticism to an avid European public."
                            }
                        ]
                    }
                ],
