                                "target_senses": [
                                    {
                                        "sense_id": "8556c8af-fbe9-39c4-a40c-bde13cc73d8c",
                                        "entry_id": "5e0f13ad-e16d-3eb7-abd4-24af1da712cf",
                                        "glosses": [
                                            "Fait de détoxifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0f5f5e-77f6-4278-b2de-64336cc21192",
                                                "sense_id": "8556c8af-fbe9-39c4-a40c-bde13cc73d8c",
                                                "text": "Les bactéries Escherichia coli ont été rendues résistantes à de fortes concentrations de mercure grâce à l’insertion d’un gène leur permettant de produire de la métallothionéine, une protéine jouant un rôle de détoxification de l’organisme chez la souris."
                                            },
                                            {
                                                "example_id": "6da7db87-56f5-454d-9b3d-a5895ea48515",
                                                "sense_id": "8556c8af-fbe9-39c4-a40c-bde13cc73d8c",
                                                "text": "Il permet la détoxification, la relaxation et le drainage du corps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d563cc1-4ed7-4756-a27e-12c45312714b",
                        "source_entry_id": "173c5666-14ae-36c9-8061-8425fdcb88d3",
                        "source_sense_id": "2ad8f62d-ad04-3253-98a3-1f76aedf7133",
                        "source_sense_description": "detoxification",
                        "target_lang_word": "Entgiftung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entgiftung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a257c8c-be94-31e1-b915-ed13456e91e4",
                                        "entry_id": "2a17cb41-c3c8-3d1c-ab61-313211146ff1",
                                        "glosses": [
                                            "Befreiung eines Körpers oder Gegenstandes von schädlichen Substanzen (Giften)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35b7cfb6-1c41-47e1-bdef-9109d3a4593a",
                                                "sense_id": "7a257c8c-be94-31e1-b915-ed13456e91e4",
                                                "text": "Die Entgiftung dioxinverseuchter Böden ist sehr aufwendig."
                                            },
                                            {
                                                "example_id": "9f827c61-9032-40c7-987a-a13bc2b27c52",
                                                "sense_id": "7a257c8c-be94-31e1-b915-ed13456e91e4",
                                                "text": "„Nachdem wir eine Nacht lang bei Dunning gesessen und auf den Tod gewartet hatten, wurde die Angelegenheit schließlich einem Arzt übergeben, und Dunning wurde zur Entgiftung in eine Privatklinik gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b9eb69c-ed45-4254-a2ae-e93ea4d0c8f8",
                        "source_entry_id": "173c5666-14ae-36c9-8061-8425fdcb88d3",
                        "source_sense_id": "2ad8f62d-ad04-3253-98a3-1f76aedf7133",
                        "source_sense_description": "detoxification",
                        "target_lang_word": "Entschlackung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entschlackung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec507a44-959c-3852-8391-e1e913575e11",
                                        "entry_id": "a3367923-e5d9-38c8-9922-a8377e8474c2",
                                        "glosses": [
                                            "Befreiung von überflüssigen Rückständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dad6d7d8-f351-4f39-b38a-0f4223ae5c11",
                                                "sense_id": "ec507a44-959c-3852-8391-e1e913575e11",
                                                "text": "„»I brauch keine Entschlackung, i bin ja kein Hochofen!«, hatte der Hausner Hansl darauf gesagt.“"
                                            },
                                            {
                                                "example_id": "6bde90e0-ac4a-4d3f-bd12-37d5fce93eb3",
                                                "sense_id": "ec507a44-959c-3852-8391-e1e913575e11",
                                                "text": "„Im Gefängnis arbeitete er in einem Hochofen, bei der Entschlackung.“"
                                            },
                                            {
                                                "example_id": "dcb8fa23-1e58-41c4-885f-fd4e43b24600",
                                                "sense_id": "ec507a44-959c-3852-8391-e1e913575e11",
                                                "text": "„Beschickung und Entschlackung erfolgen ähnlich wie bei den Hochöfen.“"
                                            },
                                            {
                                                "example_id": "3416dfd9-2fd1-4c28-af1a-09518d692c7f",
                                                "sense_id": "ec507a44-959c-3852-8391-e1e913575e11",
                                                "text": "„Nach internen Einschätzungen des Bundeswirtschaftsministeriums behindern insbesondere Wirtschaftsverbände die Entschlackung der Verwaltung und damit ein wesentliches Ziel der Reform-Agenda 2010 des Bundeskanzlers.“"
                                            },
                                            {
                                                "example_id": "7a6d3d4e-5419-45a2-b70e-387c3adb9fe2",
                                                "sense_id": "ec507a44-959c-3852-8391-e1e913575e11",
                                                "text": "„Mit der Entschlackung der Strukturen werden auch Änderungen an Lösungen erheblich vereinfacht und so tendenziell beschleunigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
