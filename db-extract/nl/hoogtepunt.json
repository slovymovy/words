                                "sense_id": "fa1e5a43-2123-3313-85d9-17a541bf5fd1",
                                "text": "De zonsopgang was het hoogtepunt van onze wandeling.",
                                "translation": "The sunrise was the zenith of our hike.",
                                "english": "The sunrise was the zenith of our hike."
                            },
