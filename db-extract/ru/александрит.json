                                                "sense_id": "6b019bb4-2f84-306d-be06-c29a31679ed5",
                                                "text": "„Alexandrite mit starkem Farbwechsel aus Brasilien gehören zu den seltensten und wertvollsten Edelsteinen der Welt.“"
                                            },
                                            {
                                                "example_id": "810bbb7c-4f70-48b8-85a8-1c8ca7536bcc",
                                                "sense_id": "6b019bb4-2f84-306d-be06-c29a31679ed5",
                                                "text": "„Die Hand griff nach dem Schmuck, hielt ihn etwas hoch, der farbige Widerschein des Alexandriten lag auf dem Gelenk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
