                    "sense_id": "6b7b42ee-56c4-3e5b-8376-d378d5d72650",
                    "sense_definition": "Enlever la peau ou l'écorce d'un fruit, d'un légume ou d'un aliment.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu dois <w>peler</w> les pommes de terre avant de les faire cuire dans l'eau."
                        },
                        {
                            "text": "Il préfère toujours <w>peler</w> une pomme avant de la croquer."
                        }
                    ],
                    "common_phrases": [
