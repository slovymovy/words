                                                "sense_id": "6f15359c-9a05-3c0a-b3e9-074b99971733",
                                                "text": "„Surfst du im Internet?“ ‒ „Ja!“"
                                            },
                                            {
                                                "example_id": "391fc20c-6ef1-4d70-ba17-0c5b09319c96",
                                                "sense_id": "6f15359c-9a05-3c0a-b3e9-074b99971733",
                                                "text": "„Hast du mich betrogen?“ ‒ „Ja.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "ja",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90f14105-7da5-3d46-a5a2-84320bb7ac61",
                                        "entry_id": "529f9dc7-1a20-3ae0-82bc-b4f3392cf9b4",
                                        "glosses": [
                                            "bekanntlich (ist das so)"
                                        ],
                                        "tags": [
                                            "unbetont",
                                            "nimmt Bezug auf das Wissen",
                                            "das der Hörer bereits hat; meist in der gesprochenen Sprache verwendet; betont die Faktizität eines Aufforderungs- oder Aussagesatzes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4c024cc-bb77-4e91-9b20-0895311cac2c",
                                                "sense_id": "90f14105-7da5-3d46-a5a2-84320bb7ac61",
                                                "text": "Wir haben ja jetzt einen neuen Papst."
                                            },
                                            {
                                                "example_id": "d9185cdf-1bd7-4e2a-adfa-9fc6603bb8c3",
                                                "sense_id": "90f14105-7da5-3d46-a5a2-84320bb7ac61",
                                                "text": "Heute ist mein großer Tag, aber das weißt du ja schon."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "46a19778-52ec-3a86-a782-e309e496e4b5",
                                        "entry_id": "529f9dc7-1a20-3ae0-82bc-b4f3392cf9b4",
                                        "glosses": [
                                            "unbedingt"
                                        ],
                                        "tags": [
                                            "betont",
                                            "Ausdruck dringender Mahnung in Aufforderungssätzen",
                                            "oft ohne eigenständige Bedeutung",
                                            "nur zum Ausdruck der Dringlichkeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6434c73-e16e-42c8-bfe9-0dc90aece94e",
                                                "sense_id": "46a19778-52ec-3a86-a782-e309e496e4b5",
                                                "text": "Komm mir ja nüchtern nach Hause!"
                                            },
                                            {
                                                "example_id": "7750b451-fe3f-4534-9f63-e56db34a37d7",
                                                "sense_id": "46a19778-52ec-3a86-a782-e309e496e4b5",
                                                "text": "Nach l, m, n, r, das merke ja, schreib nie tz und nie ck."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "15075c0b-235c-358c-b5d2-1fb8b3053332",
                                        "entry_id": "529f9dc7-1a20-3ae0-82bc-b4f3392cf9b4",
                                        "glosses": [
                                            "sogar, sozusagen"
                                        ],
                                        "tags": [
                                            "unbetont",
                                            "leitet eine Verstärkung/Präzisierung des bereits Gesagten ein"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aac0090e-a9d9-490e-8781-bf6573349db2",
                                                "sense_id": "15075c0b-235c-358c-b5d2-1fb8b3053332",
                                                "text": "Er kam angetrunken nach Hause, ja regelrecht besoffen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "ja",
