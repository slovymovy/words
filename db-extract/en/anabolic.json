                    {
                        "translation_id": "ac7ebf34-c985-4897-9335-cb894bcdf1d9",
                        "source_entry_id": "95045d33-cdf2-302f-a9ef-d725ccfcfba4",
                        "source_sense_id": "44919b22-9e5a-30bd-a0fd-5f41b93e436e",
                        "source_sense_description": "anabolic steroid",
                        "target_lang_word": "Anabolikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anabolikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2f05dec-a94a-33e6-9da8-be5660042380",
                                        "entry_id": "0c6b2124-3d35-36d4-b459-6f4132e1605c",
                                        "glosses": [
                                            "Substanz, die den Aufbaustoffwechsel (Anabolismus) anregt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a7c3fb-78da-4cf5-a236-09082c3f6235",
                                                "sense_id": "d2f05dec-a94a-33e6-9da8-be5660042380",
                                                "text": "„Anabolika werden nur selten therapeutisch eingesetzt, z. B. bei ausgeprägten Schwächezuständen.“"
                                            },
                                            {
                                                "example_id": "7b67c483-97ef-4d17-b608-e6f7bdffa003",
                                                "sense_id": "d2f05dec-a94a-33e6-9da8-be5660042380",
                                                "text": "„In der Humanmedizin verwendet man Anabolika vor allem im Rahmen der Therapie des hormonell bedingten Minderwuchses.“"
                                            },
                                            {
                                                "example_id": "ebf0f3bd-99a8-4efe-919f-ad365545b956",
                                                "sense_id": "d2f05dec-a94a-33e6-9da8-be5660042380",
                                                "text": "„Eine vielfache, illegale Anwendung finden Anabolika in einigen Sportarten.“"
                                            },
                                            {
                                                "example_id": "bc81741b-3e0a-43e5-a6db-d071d1d5bd5f",
                                                "sense_id": "d2f05dec-a94a-33e6-9da8-be5660042380",
                                                "text": "„In der Viehzucht werden in einigen Ländern Anabolika verarbeitet, um die Fleischmenge zu steigern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
