                "senses": [
                    {
                        "sense_id": "b417246a-f4ba-37ff-9072-0cd2f9618a70",
                        "entry_id": "1998690c-43b3-3373-934e-8db66e56f6cd",
                        "glosses": [
                            "mittlerer Teil Deutschlands, wie es jeweils zu der infragekommenden Zeit definiert wurde"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "8b42a818-d146-46cf-99e9-5ea1d41481d9",
                                "sense_id": "b417246a-f4ba-37ff-9072-0cd2f9618a70",
                                "text": "Kehren wir zum Abschluß noch einmal unmittelbar zu Karl IV. und Mitteldeutschland zurück. Worüber ist das Verhältnis der beiden Seiten, wenn nicht allein über den Urkundenverkehr, noch zu beschreiben?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "339fea35-6efa-3b07-ab37-7d44db87b1ab",
                        "entry_id": "1998690c-43b3-3373-934e-8db66e56f6cd",
                        "glosses": [
                            "unscharf abgegrenztes, „zentral“ in Deutschland befindliches Gebiet, das die Bundesländer Sachsen, Sachsen-Anhalt und Thüringen umfasst"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "ca3b32f0-150c-4b77-9e5d-0b363f862621",
                                "sense_id": "339fea35-6efa-3b07-ab37-7d44db87b1ab",
                                "text": "„Seit der deutschen Einheit 1990 gibt es Bestrebungen das Attribut Mitteldeutschland zunehmend den Bundesländern Sachsen, Sachsen-Anhalt und Thüringen, als „Kerngebiet“ zusammengefasst, zuzuordnen.“"
                            },
                            {
                                "example_id": "667b8bb0-21e5-4c76-ad71-2119cfe0354b",
                                "sense_id": "339fea35-6efa-3b07-ab37-7d44db87b1ab",
                                "text": "„Um ein Bild von der Dichte des Poststraßennetzes zu geben, wird hier ein Ausschnitt der Poststraßen in Mitteldeutschland gezeigt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
