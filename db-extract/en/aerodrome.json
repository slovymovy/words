                                    {
                                        "sense_id": "ddca3042-e64a-3b1e-8d0f-80376b9f5289",
                                        "entry_id": "48a026d9-1dfb-335a-a08d-8ee507f93379",
                                        "glosses": [
                                            "Aéronef."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "735ee481-3b00-48da-9fcb-ea4eedf5846d",
                                                "sense_id": "ddca3042-e64a-3b1e-8d0f-80376b9f5289",
                                                "text": "Signaler la présence des aérodromes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17e52906-9ef9-3d57-a5f3-5546cdf083aa",
                                        "entry_id": "48a026d9-1dfb-335a-a08d-8ee507f93379",
                                        "glosses": [
                                            "Terrain aménagé pour l’atterrissage, le stationnement, l'entretien et le décollage habituels des aéronefs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d29ba297-d8b7-45ab-b63f-e295c4dcf281",
                                                "sense_id": "17e52906-9ef9-3d57-a5f3-5546cdf083aa",
                                                "text": "La plupart des personnes venues assister à notre décollage étaient encore sur l’aérodrome à 10 heures et demie."
                                            },
                                            {
                                                "example_id": "61d05b56-f33d-4a1d-aea3-1b48b3ecf2ab",
                                                "sense_id": "17e52906-9ef9-3d57-a5f3-5546cdf083aa",
                                                "text": "La 8ᵉ force aérienne avait d'abord calculé qu'il lui faudrait achever 61 aérodromes avant la fin 1943 ; mais elle finit par en construire 120, mobilisant un million de mois-hommes de travail, et couvrant 42 millions de mètres carrés de béton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10f20537-7d8e-4a25-8d89-0fc38dd2e3b0",
                        "source_entry_id": "a213c6ab-cc4d-349f-ab85-9a130084be40",
                        "source_sense_description": "airfield",
                        "target_lang_word": "Flugplatz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flugplatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b222bb8-5d20-3613-9e34-af3c4e8f4bd3",
                                        "entry_id": "78333f4b-0caf-3fdb-9e73-800386e75f6b",
                                        "glosses": [
                                            "Start- und Landeplatz für Flugzeuge"
                                        ],
                                        "tags": [
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "296f12f1-28b0-4258-82e0-244e4ba1e11e",
                                                "sense_id": "4b222bb8-5d20-3613-9e34-af3c4e8f4bd3",
                                                "text": "Nicht weit von uns gibt es einen kleinen Flugplatz."
                                            },
                                            {
                                                "example_id": "1f4b7048-31a4-4681-ae00-37377a29a343",
                                                "sense_id": "4b222bb8-5d20-3613-9e34-af3c4e8f4bd3",
                                                "text": "„Auf der Fahrt vom Flugplatz hatte ich bemerkt, dass färöische Dörfer oft aus kleinen Häuseransammlungen bestehen, wo es nicht mal einen Laden gibt.“"
                                            },
                                            {
                                                "example_id": "e661c9aa-954d-46e9-95a5-cef17cdbcb09",
                                                "sense_id": "4b222bb8-5d20-3613-9e34-af3c4e8f4bd3",
                                                "text": "„Wir waren froh, wenn wir auf dem Flugplatz irgendwo sitzen konnten, die Leute saßen oder lagen in Scharen auf dem Boden.“"
                                            },
                                            {
                                                "example_id": "afd56b5c-dd10-4cb3-9270-cead210a3748",
                                                "sense_id": "4b222bb8-5d20-3613-9e34-af3c4e8f4bd3",
                                                "text": "„Zuvor hatte sie noch dort gestanden und das Gesicht an eines der großen Fenster gedrückt, die auf den betonierten Flugplatz hinausgingen, wo die Maschinen warteten.“"
                                            },
                                            {
                                                "example_id": "932bd06e-3a7f-4a6e-8d21-88730a3571e9",
                                                "sense_id": "4b222bb8-5d20-3613-9e34-af3c4e8f4bd3",
                                                "text": "„Tiefer Schnee bedeckte den Flugplatz Saki.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2323efa2-3a0a-3ba4-b882-4cb81a01ff55",
                                        "entry_id": "78333f4b-0caf-3fdb-9e73-800386e75f6b",
                                        "glosses": [
                                            "Start- und Landeplatz, der kleiner als ein Flughafen ist und nicht über einen Tower verfügt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f4d7d55-a034-48ae-8be4-06b12ab09ec3",
                                                "sense_id": "2323efa2-3a0a-3ba4-b882-4cb81a01ff55",
                                                "text": "Auf Island hat fast jedes Dorf einen eigenen Flugplatz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2091784c-df30-371a-9d95-e06f4a069e7f",
                                        "entry_id": "78333f4b-0caf-3fdb-9e73-800386e75f6b",
                                        "glosses": [
                                            "Sitzplatz in einem Verkehrsflugzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "216e8798-98fc-4bb0-bd52-b3a7693fe0d5",
                                                "sense_id": "2091784c-df30-371a-9d95-e06f4a069e7f",
                                                "text": "Ist noch ein Flugplatz frei?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
