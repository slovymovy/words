                        "examples": [
                            {
                                "example_id": "7a7a2b20-0aa0-4773-b44c-9518a4bdfe79",
                                "sense_id": "bf9aaf4b-90a1-330b-9ff4-173cf989a57a",
                                "text": "Comme sur tous les villages de course, tu trouveras des marques partenaires, okazou t’as pas pensé à t’acheter un kway pour le lendemain ou si, sur un coup de tête tu veux t’inscrire au marathon de La Rochelle."
                            },
                            {
                                "example_id": "025f5fba-56d1-4289-a407-33e4b22e8a55",
                                "sense_id": "bf9aaf4b-90a1-330b-9ff4-173cf989a57a",
                                "text": "Il ne me reste qu’à ajouter … des gateaux pour la route, histoire que j’aie quelque-chose dans l’estomac okazou un Tordudelatête m’interdisait de me sustanter pendant mon marathon / accouchement."
                            },
                            {
                                "example_id": "380bfb14-db64-4602-a448-8210cb69ecc0",
                                "sense_id": "bf9aaf4b-90a1-330b-9ff4-173cf989a57a",
                                "text": "Bonjour, il se peut que ma demande soit trop exigeante, mais je la formule malgré tout, okazou un bon samaritain serait au poste."
                            }
                        ]
                    }
