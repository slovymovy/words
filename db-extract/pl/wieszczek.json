                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f3fd5abb-36d0-4247-8915-b97a5c3fae69",
                                "sense_id": "b26f06d1-b0d2-346b-b135-5524381ac4aa",
                                "text": "Wszyscy dobrze znali przepowiednię wieszczka Helenosa."
