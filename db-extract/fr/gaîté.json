                    },
                    {
                        "form_id": "3f144389-82ac-4346-9464-113de40ac542",
                        "entry_id": "e1de622d-64fe-36b4-a5a6-8d250fd110d2",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "gaité"
                    },
                    {
                        "form_id": "e951d3cc-3094-400c-8bfe-b44e59f7589d",
                        "entry_id": "e1de622d-64fe-36b4-a5a6-8d250fd110d2",
                        "tags": [],
                        "form": "gaieté"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "754e9fd2-9816-353a-988b-5faf4b1c21e3",
                        "entry_id": "e1de622d-64fe-36b4-a5a6-8d250fd110d2",
                        "glosses": [
                            "Belle humeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a0f31d7-612d-4dc9-a062-471f68ad428d",
                                "sense_id": "754e9fd2-9816-353a-988b-5faf4b1c21e3",
                                "text": "Il aimait fort les chansons de table ; et en cela il n’est pas blâmable, car depuis qu’elles ne sont plus d’usage le Français a beaucoup perdu de sa gaîté."
                            },
                            {
                                "example_id": "488bbaa7-69fc-4146-b902-832ef05f1cd2",
                                "sense_id": "754e9fd2-9816-353a-988b-5faf4b1c21e3",
                                "text": "Quelques pages plus loin, vous retrouverez la vivacité impétueuse de Lovelace, son incorrigible folie, et cette gaîté non plus du vice, mais du remords qui cherche à s’étourdir."
                            },
                            {
                                "example_id": "513b0833-6d71-4952-abe4-df9aab207ee7",
                                "sense_id": "754e9fd2-9816-353a-988b-5faf4b1c21e3",
                                "text": "Dans son numéro du 15 janvier 1899, le journal bimensuel parisien le Correspondant médical tirait la sonnette d’alarme en disant : « L'enfant boit ! […]. Les nourrices donnent du vin à leurs nourrissons et s’ébaudissent de leur exubérante gaîté. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "384d277c-4e6b-3dd9-b595-edfa89d86a3d",
                        "entry_id": "e1de622d-64fe-36b4-a5a6-8d250fd110d2",
                        "glosses": [
                            "Vivacité, en parlant d’un cheval."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "092dde3c-6a2c-3e81-96fd-3fd248411b65",
                        "entry_id": "e1de622d-64fe-36b4-a5a6-8d250fd110d2",
                        "glosses": [
                            "Paroles ou actions gaies ou folâtres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed02a2f-94b1-4ef5-b14c-a29e73b6ac7e",
                                "sense_id": "092dde3c-6a2c-3e81-96fd-3fd248411b65",
                                "text": "Il n'y avait pas moyen de se fâcher contre cette créature. Pibrac et Delle ne purent pas s'empêcher de rire aussi. La glace était rompue et la conversation tourna vite à la gaîté."
                            },
                            {
                                "example_id": "65439835-5b43-40bf-b2ef-3eb801328f08",
                                "sense_id": "092dde3c-6a2c-3e81-96fd-3fd248411b65",
                                "text": "[…] ; sa mère est une cyclothymique avérée passant, sans motifs apparents, d'un sentiment profond d'ennui à celui d'une gaîté plus ou moins exubérante."
                            },
                            {
                                "example_id": "a95744dc-aa92-46da-b3e6-0824de4fadff",
                                "sense_id": "092dde3c-6a2c-3e81-96fd-3fd248411b65",
                                "text": "Ce type long et sardonique aime le vin : dans ses gaîtés, il lui arrive de tenir des propos que les deux autres couvrent précipitamment d’éclats de rire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40f0e9dc-af2f-49a5-9f87-b73c7ab1d889",
                        "source_entry_id": "e1de622d-64fe-36b4-a5a6-8d250fd110d2",
                        "target_lang_word": "cheerfulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheerfulness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86438433-9995-312b-a425-48f481e9554e",
                                        "entry_id": "22992355-ca5c-36ce-8567-edbb80c94af2",
                                        "glosses": [
                                            "The state of being cheerful; joy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50aa49d1-e64f-4ddc-8391-7d8377c3d509",
                                                "sense_id": "86438433-9995-312b-a425-48f481e9554e",
                                                "text": "Or he that exhorteth, on exhortation: he that giueth, let him doe it with simplicitie: hee that ruleth, with diligence: hee that sheweth mercy, with cheerefulnesse."
                                            },
                                            {
                                                "example_id": "1d546bda-b067-418d-8b73-1f63d0495500",
                                                "sense_id": "86438433-9995-312b-a425-48f481e9554e",
                                                "text": "The banded ones were all dressed in white gowns - a gay survival from Old Style days, when cheerfulness and May-time were synonyms - days before the habit of taking long views had reduced emotions to a monotonous average."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
