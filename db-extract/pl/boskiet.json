                    {
                        "translation_id": "36d8aa16-a1e1-4cba-9c74-dfe70b26d283",
                        "source_entry_id": "4785df05-a56f-3fc9-9aaf-ab385c607452",
                        "source_sense_id": "5bf431ff-e75d-321c-9635-e2ef0499b887",
                        "target_lang_word": "bosquet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bosquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2759be8f-5f5c-3618-aa3b-994a3d78190c",
                                        "entry_id": "5d7048c9-e0d8-3a9b-a4cd-71d74c709756",
                                        "glosses": [
                                            "Petit bois ; touffe d’arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10d0a9e6-f760-4c85-93f4-cce543d6fd79",
                                                "sense_id": "2759be8f-5f5c-3618-aa3b-994a3d78190c",
                                                "text": "Comme il y avait d’autres bosquets de cette sorte entre les grands chênes, je demandai pourquoi l’assassin avait choisi celui-ci plutôt que les autres."
                                            },
                                            {
                                                "example_id": "6240e240-d84c-4b80-911d-1c5e0e9015d7",
                                                "sense_id": "2759be8f-5f5c-3618-aa3b-994a3d78190c",
                                                "text": "La terre que l’aïeul paternel de Saint-Ybars, émigré du Canada en Louisiane, avait achetée en 1749, n’était alors qu’un désert dont le centre était occupé par un bosquet de chênes séculaires."
                                            },
                                            {
                                                "example_id": "68b8eb0b-32b4-4e2d-9f27-2438c7cae518",
                                                "sense_id": "2759be8f-5f5c-3618-aa3b-994a3d78190c",
                                                "text": "Le jardin est si dépouillé que rien ne cache plus l’insignifiance de ce qui est, ici, concédé à l’agrément : les carcasses des charmilles, les bosquets maigres grelottent sous la pluie éternelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "571e6ba1-fb9a-35ff-abfc-f44a0d0c06bf",
                                        "entry_id": "5d7048c9-e0d8-3a9b-a4cd-71d74c709756",
                                        "glosses": [
                                            "Pièce de jardin plantée d’arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "765c4b66-7e91-4316-9458-5de5d92ef749",
                                                "sense_id": "571e6ba1-fb9a-35ff-abfc-f44a0d0c06bf",
                                                "text": "Madame C*** se levait ordinairement vers les cinq heures du matin pour aller se promener dans un petit bosquet au bout de son jardin."
                                            },
                                            {
                                                "example_id": "89bbe3e0-4346-4840-bd36-b7a04477b867",
                                                "sense_id": "571e6ba1-fb9a-35ff-abfc-f44a0d0c06bf",
                                                "text": "Ces arbrisseaux font aussi un très bel effet dans les bosquets et les boulingrins à cause de l’aspect de leurs fruits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24d220ec-8baf-4500-bfef-aa79f30ed662",
                        "source_entry_id": "4785df05-a56f-3fc9-9aaf-ab385c607452",
                        "source_sense_id": "5bf431ff-e75d-321c-9635-e2ef0499b887",
                        "target_lang_word": "Boskett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boskett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ca3b9b1-4ec4-313d-84e6-d9b856e23286",
                                        "entry_id": "26927e4e-3049-323b-a994-be84f6f6c6e1",
                                        "glosses": [
                                            "Gruppe von Gehölzen (Bäumen, Büschen) in einer Gartenanlage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4349834d-533d-41df-b342-0228c3b1c219",
                                                "sense_id": "9ca3b9b1-4ec4-313d-84e6-d9b856e23286",
                                                "text": "„Ein einziges Mal hat Hoffmann die Natur vulgarisiert, hat sie auf die Perspektiven einer verschwommenen Landschaft mit den kläglichen Ausmaßen eines Bosketts beschränkt, in dem es von Kreaturen spukt, die zweifellos dem Geiste Jean-Jacques Rousseaus entstammen.“"
                                            },
                                            {
                                                "example_id": "7771207d-ca8d-4b32-a537-ee6aaae4cde6",
                                                "sense_id": "9ca3b9b1-4ec4-313d-84e6-d9b856e23286",
                                                "text": "„Sie liefen hinter das Haus über einen kiesbestreuten Gartenweg, der Franzose zupfte Pierre am Arm und zeigte auf ein Boskett.“"
                                            },
                                            {
                                                "example_id": "7c93bad2-c3de-46c7-8ae0-09a05eab1a54",
                                                "sense_id": "9ca3b9b1-4ec4-313d-84e6-d9b856e23286",
                                                "text": "„Eins der Bosketts, das dem Sonnenbrand am meisten ausgesetzt war, zeigte viel Gelb, und er sah eben scharf hin, um sich zu vergewissern, ob es gelbe Blüten oder nur von der Sonne verbrannte Blätter seien, als er aus ebendiesem Boskett die Gestalten des St. Arnaudschen Paares hervortreten sah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
