                "senses": [
                    {
                        "sense_id": "07f69281-4f68-301d-a8ad-e31635c524f3",
                        "entry_id": "ed3b9624-e2c7-3246-913c-4d8e6a0df272",
                        "glosses": [
                            "Pertaining to, or connected with, recognition.",
                            "Pertaining to recognizing (matching a current perception with a memory)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ba5ad084-6426-4531-a300-c42268838ad7",
                                "sense_id": "07f69281-4f68-301d-a8ad-e31635c524f3",
                                "text": "A pun, and its recognitory laugh, must be co-instantaneous."
                            },
                            {
                                "example_id": "1a149cb2-0c10-4118-859d-9cd7c84450d5",
                                "sense_id": "07f69281-4f68-301d-a8ad-e31635c524f3",
                                "text": "[…] two dogs, with a snarling sort of bark, made their appearance from a neighbouring pig-stye, but, instead of following up the attack, came forward whimpering and whining a recognitory welcome to Jim, while they described sundry circles around him expressive of their joy at the meeting."
                            },
                            {
                                "example_id": "7d0c4550-7837-466c-8115-635c819749ef",
                                "sense_id": "07f69281-4f68-301d-a8ad-e31635c524f3",
                                "text": "Glancing across to our corner, he nodded to Francis, a flashing-eyed, recognitory nod, as from one power to another."
                            },
                            {
                                "example_id": "8594aa0a-b75e-4d07-b205-9da55691d49c",
                                "sense_id": "07f69281-4f68-301d-a8ad-e31635c524f3",
                                "text": "[…] we must be cautious about inferring the same recognitory processes are going on in infancy as in adulthood. The fact that an infant dishabituates to a male face after seeing a series of female faces, tells us nothing about whether any of these stimuli seem familiar to the infant, or carry the conceptual meaning involved in the judgment, “Oh, that’s not a woman.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "9852d434-241a-3830-b927-5216eb66903b",
                        "entry_id": "ed3b9624-e2c7-3246-913c-4d8e6a0df272",
                        "glosses": [
                            "Pertaining to, or connected with, recognition.",
                            "Pertaining to recognizing (acknowledging the existence, status or validity of something)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5635e2c5-5ea1-4487-9dd9-687130f2344f",
                                "sense_id": "9852d434-241a-3830-b927-5216eb66903b",
                                "text": "[…] there is not one decisive intimation, not one conclusive sentence in those authors, nor one decree in those councils, recognitory of the existence or explanatory of the duties of such a body."
                            }
                        ]
                    }
