                ],
                "senses": [
                    {
                        "sense_id": "1c1b2976-e5e9-36b8-a2c5-c240b7781be7",
                        "entry_id": "17f3f170-11c7-30f1-91c2-5e68725f0ffa",
                        "glosses": [
                            "außerhalb des normalen Fahrplans zu einem bestimmten Zweck verkehrender Zug"
                        ],
                        "tags": [
                            "Schienenverkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "21e8cb1b-f8ec-4fbb-8626-3eb9a3ba84f6",
                                "sense_id": "1c1b2976-e5e9-36b8-a2c5-c240b7781be7",
                                "text": "„Unterdessen stand in Davos der Sonderzug für den Sarg bereit.“"
                            },
                            {
                                "example_id": "52b49d0d-4fad-4b01-b13d-61558ae56ee8",
                                "sense_id": "1c1b2976-e5e9-36b8-a2c5-c240b7781be7",
                                "text": "„Mit dem Sonderzug war er nach Emden gereist, da Norddeich noch keinen Eisenbahnanschluss hatte.“"
                            },
                            {
                                "example_id": "b60b284d-52f7-4bcb-aa6f-ab3bbc128ec0",
                                "sense_id": "1c1b2976-e5e9-36b8-a2c5-c240b7781be7",
                                "text": "„Am Donnerstag erwartet der SCR bis zu 5.000 Zuschauer im Tivoli Neu, via Sonderzug reisen dabei etwas mehr als 1.000 Altach-Fans an.“"
                            },
                            {
                                "example_id": "803bddd5-6268-47c0-9b59-7abfccbce434",
                                "sense_id": "1c1b2976-e5e9-36b8-a2c5-c240b7781be7",
                                "text": "„Trotzdem brauchte er lange bis Cerda, die Straße war verstopft von Fahrzeugen, obschon es noch sehr zeitig war und Sonderzüge nach Palermo unterwegs waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
