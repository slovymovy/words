                                "sense_id": "f912ccfb-aeed-32d0-bd87-4d423a2a6671",
                                "text": "Ania ubiera się zwyczajnie i bez gustu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "89652967-15ba-3a7c-b140-cd80bea36af4",
                        "entry_id": "348f13ff-5883-30bb-ac37-7e156ac46b85",
                        "glosses": [
                            "bez trudu; po prostu"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9f77e305-46eb-4ed6-8d94-8895b006fef8",
                                "sense_id": "89652967-15ba-3a7c-b140-cd80bea36af4",
                                "text": "– Jak udało ci się tam wejść bez przepustki? – Zwyczajnie! Tak naprawdę dostać się tam może każdy, bo przy wejściu nie ma już kontroli."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ae360ce-75c7-416c-b391-337d62367fa1",
                        "source_entry_id": "348f13ff-5883-30bb-ac37-7e156ac46b85",
                        "source_sense_id": "f912ccfb-aeed-32d0-bd87-4d423a2a6671",
                        "target_lang_word": "ordinarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ordinarily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b865ab3b-20a1-3d8e-aee8-db10eebfbe68",
                                        "entry_id": "ecafa3be-a3eb-3029-854e-f756c35e1e3d",
                                        "glosses": [
                                            "In accordance with normal custom or routine; as a matter of established occurrence."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c5aa90b-809a-404b-b2d4-06aee72c178e",
                                                "sense_id": "b865ab3b-20a1-3d8e-aee8-db10eebfbe68",
                                                "text": "It is ordinarily seene how good intentions, being managed without moderation, thrust men into most vicious effects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d96ea233-674b-3f6a-a58a-2ca36a8eb4bf",
                                        "entry_id": "ecafa3be-a3eb-3029-854e-f756c35e1e3d",
                                        "glosses": [
                                            "Usually or as a general rule; commonly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c79e1ef9-f0c1-481c-ac0c-85b0334a40c0",
                                                "sense_id": "d96ea233-674b-3f6a-a58a-2ca36a8eb4bf",
                                                "text": "Ordinarily I go to the match on a Saturday."
                                            },
                                            {
                                                "example_id": "e6699d06-b208-45f9-bf94-5a017098ddde",
                                                "sense_id": "d96ea233-674b-3f6a-a58a-2ca36a8eb4bf",
                                                "text": "I'm ordinarily supportive of free speech, but this dispay is obnoxious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "906ca307-a35b-3b70-b90b-c310c98eb69e",
                                        "entry_id": "ecafa3be-a3eb-3029-854e-f756c35e1e3d",
                                        "glosses": [
                                            "In the usual manner; unexceptionally."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50200c2b-5c0f-433d-80b8-08be4c4ab4e1",
                                                "sense_id": "906ca307-a35b-3b70-b90b-c310c98eb69e",
                                                "text": "The man was ordinarily dressed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72ce1ae5-9ef9-4d10-a0fc-969f439b76e3",
                        "source_entry_id": "348f13ff-5883-30bb-ac37-7e156ac46b85",
                        "source_sense_id": "f912ccfb-aeed-32d0-bd87-4d423a2a6671",
                        "target_lang_word": "commonly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commonly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12fdaeec-8c15-3724-bbff-91fb356be5da",
                                        "entry_id": "ec30230c-7d56-331a-ac5c-56cfb0dd20b9",
                                        "glosses": [
                                            "As a rule; frequently; usually."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c41fdf-8ecc-4573-a9a8-a56295eefb80",
                                                "sense_id": "12fdaeec-8c15-3724-bbff-91fb356be5da",
                                                "text": "The class of antidepressants most commonly associated with sexual dysfunction is selective serotonin reuptake inhibitors, or SSRIs, which treat depression by ultimately increasing levels of the neurotransmitter serotonin in the brain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9d6d52-0811-3b03-8ab4-f2ad18278546",
                                        "entry_id": "ec30230c-7d56-331a-ac5c-56cfb0dd20b9",
                                        "glosses": [
                                            "In common; familiarly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d212467b-6861-4652-9b67-f99989fe7946",
                                                "sense_id": "9f9d6d52-0811-3b03-8ab4-f2ad18278546",
                                                "text": "As he thereon stood gazing, he might see / The blessed Angels to and fro descend / From highest heaven in gladsome companee, / And with great joy into that Citie wend, / As commonly as friend does with his frend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f6ff27d-2d0f-4886-8bde-c2bf04edbcce",
                        "source_entry_id": "348f13ff-5883-30bb-ac37-7e156ac46b85",
                        "source_sense_id": "f912ccfb-aeed-32d0-bd87-4d423a2a6671",
                        "target_lang_word": "simply",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simply",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d47a07a-ad66-3934-90dd-1b9f73795e4a",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "In a simple way or state; considered in or by itself; without addition; alone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b66f9c70-a612-388b-bf5e-9152a8accd68",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "Plainly; without art or subtlety"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6239f6ba-01b4-3d8b-a5e8-60eb17e413e7",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "Foolishly; stupidly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "454d6451-9736-47ee-8ab1-11a1dd0f16a8",
                                                "sense_id": "6239f6ba-01b4-3d8b-a5e8-60eb17e413e7",
                                                "text": "Mrs. Thorold had told her sons that a young lady was visiting at the house, whose history she had given them in short hand, describing her as a dependent on the late Mrs. Willoughby, whom her son had very simply intended to marry at Alvestone […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "Merely; solely."
                                        ],
                                        "tags": [
                                            "focus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd31c40-ee5f-45ef-9d10-293011cade0f",
                                                "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                                                "text": "I was simply asking a question."
                                            },
                                            {
                                                "example_id": "3cd986d7-c28f-422e-8cc3-199fa000c23f",
                                                "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails.[…]This set-up solves several problems […]. Stopping high-speed trains wastes energy and time, so why not simply slow them down enough for a moving platform to pull alongside?"
                                            },
                                            {
                                                "example_id": "5340c159-097f-40d5-b230-737c3eb94215",
                                                "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                                                "text": "Rather than scanning a boarding pass or handing over a passport, you simply stare into a camera and you’re verified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea90e5ba-1156-3ff1-9e79-34b5f130a638",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "absolutely, positively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d513240-f09e-41a1-876c-467b420ad4ed",
                                                "sense_id": "ea90e5ba-1156-3ff1-9e79-34b5f130a638",
                                                "text": "That was a simply wonderful dessert."
                                            },
                                            {
                                                "example_id": "2f3747f7-c95a-4ac2-9b0f-57c0eeb5ab57",
                                                "sense_id": "ea90e5ba-1156-3ff1-9e79-34b5f130a638",
                                                "text": "What about the way you love me? / And the way you squeeze me? / Simply beautiful"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a62f13d8-c8e9-3a75-86a4-b896b73ab361",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "Frankly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3b4fdc9-320f-49d4-be2a-7e06164b600c",
                                                "sense_id": "a62f13d8-c8e9-3a75-86a4-b896b73ab361",
                                                "text": "Simply, he just fired you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fec2f9f8-4959-487d-9aa9-a3ef7ba8593f",
                        "source_entry_id": "348f13ff-5883-30bb-ac37-7e156ac46b85",
                        "source_sense_id": "f912ccfb-aeed-32d0-bd87-4d423a2a6671",
                        "target_lang_word": "simplement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simplement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e02f41a-2b6e-3764-824b-05b740439d1d",
                                        "entry_id": "179b4961-5ac2-366d-88ff-88a5f0834bb5",
                                        "glosses": [
                                            "Sans complication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c19d1fcd-39ba-487f-8ff3-f915425be6ad",
                                                "sense_id": "3e02f41a-2b6e-3764-824b-05b740439d1d",
                                                "text": "L’action de cette pièce est conduite simplement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea48e98d-9c1e-3255-b03a-6e01ada3b8d6",
                                        "entry_id": "179b4961-5ac2-366d-88ff-88a5f0834bb5",
                                        "glosses": [
                                            "Seulement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "652e3925-d16b-4989-b4bb-321a69933fc3",
                                                "sense_id": "ea48e98d-9c1e-3255-b03a-6e01ada3b8d6",
                                                "text": "S'il n'y a aucun signe plessimétrique ou stéthoscopique indiquant une lésion superficielle du poumon, et si la respiration est simplement affaiblie, on ne peut guère hésiter qu'entre l'existence d'indurations centrales ou disséminées et un état emphysémateux du poumon."
                                            },
                                            {
                                                "example_id": "dc5fa188-9205-4a0d-80c0-f10fede7cf77",
                                                "sense_id": "ea48e98d-9c1e-3255-b03a-6e01ada3b8d6",
                                                "text": "Mais aussi parce que nous nous trouvons à la veille d’une tragédie. L’angoisse monte, celle de perdre nos proches, ou simplement celle de mourir."
                                            },
                                            {
                                                "example_id": "66744014-756c-43a6-8e13-2d12d0176fba",
                                                "sense_id": "ea48e98d-9c1e-3255-b03a-6e01ada3b8d6",
                                                "text": "Avez-vous jamais rien vu qui paraisse plus contraire [les lois de l’Évangile et les lois du monde] ? Et cependant, quand je vous dis que nos pères ont accordé ces choses, vous me dites simplement que cela vous étonne."
                                            },
                                            {
                                                "example_id": "d583d11f-963e-44f6-96f7-dc02d55379dc",
                                                "sense_id": "ea48e98d-9c1e-3255-b03a-6e01ada3b8d6",
                                                "text": "[…] mais dans la pensée que ce n’est pas votre faute [si je n’ai pas reçu vos dernières nouvelles], je ne fais simplement que me plaindre de l’infidélité de nos courriers […]"
                                            },
                                            {
                                                "example_id": "a67d545c-214b-4db6-9fb6-26de0039a52a",
                                                "sense_id": "ea48e98d-9c1e-3255-b03a-6e01ada3b8d6",
                                                "text": "Mais Longin ne fut pas simplement un critique habile, ce fut un ministre d’État considérable […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fcbca2c-557a-3f93-9bbb-3efcb7c7a93c",
                                        "entry_id": "179b4961-5ac2-366d-88ff-88a5f0834bb5",
                                        "glosses": [
                                            "D’une manière simple, sans recherche, sans ornement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "458cf6bd-61c1-4c38-a4f1-23bf58a5afa4",
                                                "sense_id": "0fcbca2c-557a-3f93-9bbb-3efcb7c7a93c",
                                                "text": "[…] la tristesse doit parler simplement, si elle veut nous intéresser […]"
                                            },
                                            {
                                                "example_id": "471ba7a0-2d2b-4baa-bfb8-a99aaa732655",
                                                "sense_id": "0fcbca2c-557a-3f93-9bbb-3efcb7c7a93c",
                                                "text": "On s’accoutume à bien parler en lisant souvent ceux qui ont bien écrit ; on se fait une habitude d’exprimer simplement et noblement sa pensée sans effort."
                                            },
                                            {
                                                "example_id": "c00fde5a-dc4e-45d0-b634-6e84423c767c",
                                                "sense_id": "0fcbca2c-557a-3f93-9bbb-3efcb7c7a93c",
                                                "text": "S’il [Marivaux] ne pouvait se résoudre à dire simplement les choses même les plus communes, du moins la facilité avec laquelle il parlait de la sorte, semblait demander grâce pour ses écrits […]"
                                            },
                                            {
                                                "example_id": "6a9aaa00-64f5-4e3c-98b1-0eef287a8b3c",
                                                "sense_id": "0fcbca2c-557a-3f93-9bbb-3efcb7c7a93c",
                                                "text": "Sitôt que la petite maison de Mont-Louis fut prête, je la fis meubler proprement, simplement, et retournai m’y établir, ne pouvant renoncer à cette loi que je m’étais faite, en quittant l’Ermitage, d’avoir toujours mon logement à moi : mais je ne pus me résoudre non plus à quitter mon appartement du petit château."
                                            },
                                            {
                                                "example_id": "94693a57-2b6f-4141-9c34-218f2a265261",
                                                "sense_id": "0fcbca2c-557a-3f93-9bbb-3efcb7c7a93c",
                                                "text": "Mais, madame, vous serez la seule, à cette fête, mise aussi simplement […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48513f0c-cbef-3fff-97a2-ac1631312bef",
                                        "entry_id": "179b4961-5ac2-366d-88ff-88a5f0834bb5",
                                        "glosses": [
                                            "Naïvement, sans détour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5948b4d-397f-42ba-93a9-4035151db0e5",
                                                "sense_id": "48513f0c-cbef-3fff-97a2-ac1631312bef",
                                                "text": "Elle était heureuse simplement, sans réflexion et sans autre désir que celui de voir son bonheur durer éternellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53009f6e-fd63-3c28-91ac-32f2d226cef8",
                                        "entry_id": "179b4961-5ac2-366d-88ff-88a5f0834bb5",
                                        "glosses": [
                                            "Bonnement, sans finesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44cce4ec-ad83-42b4-bd38-e5ba3c845294",
                                                "sense_id": "53009f6e-fd63-3c28-91ac-32f2d226cef8",
                                                "text": "C’est un bon homme, il y procède simplement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
