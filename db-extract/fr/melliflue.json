                    },
                    {
                        "translation_id": "eb277d19-f90a-438d-a2cf-2879a3d25bb2",
                        "source_entry_id": "af364804-ffd8-31b9-aa3a-bd9efb75d4c7",
                        "source_sense_id": "1c6b3e08-303c-38df-b87f-24d8c928a7e0",
                        "target_lang_word": "mellifluous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mellifluous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65357a02-49f5-3003-a9c2-2ca2cd4bcd53",
                                        "entry_id": "dd001668-7d3d-32df-bd68-71a79d960d8a",
                                        "glosses": [
                                            "Flowing like honey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f579630-8ff8-4349-8274-12a7ff08639d",
                                                "sense_id": "65357a02-49f5-3003-a9c2-2ca2cd4bcd53",
                                                "text": "Though in heaven the trees / Of life ambrosial fruitage bear, and vines / Yield nectar; though from off the boughs each morn / VVe brush mellifluous devvs, and find the ground / Cover'd vvith pearly grain[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5069e7a9-2e16-3539-b994-93aab5c29dcc",
                                        "entry_id": "dd001668-7d3d-32df-bd68-71a79d960d8a",
                                        "glosses": [
                                            "Sweet, smooth and musical; pleasant to hear (generally used of a person's voice, tone or writing style)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc93b5d8-fae4-4f18-94e5-ca5b999c361e",
                                                "sense_id": "5069e7a9-2e16-3539-b994-93aab5c29dcc",
                                                "text": "[…] Socrates […] VVisest of men; from vvhose mouth issued forth / Mellifluous streams that vvater'd all the schools / Of Academicks old and nevv […]"
                                            },
                                            {
                                                "example_id": "3501d175-70ca-40f2-a891-27b173aed184",
                                                "sense_id": "5069e7a9-2e16-3539-b994-93aab5c29dcc",
                                                "text": "Join'd to Theſe [birds], / Thouſands beſide, thick as the covering Leaves / VVhich ſpeck them o'er, their Modulations mix / Mellifluous."
                                            },
                                            {
                                                "example_id": "39863e33-4181-4c3d-a8cd-b72e7b5ea7b8",
                                                "sense_id": "5069e7a9-2e16-3539-b994-93aab5c29dcc",
                                                "text": "No verses can be more mellifluous than Petrarch's: something of this will perhaps be attributed to the softness of the Italian language; but the English tongue is also capable of it, however obstinately Johnson may have pronounced otherwise."
                                            },
                                            {
                                                "example_id": "94b896e4-cd49-489c-9200-0106bdaf8327",
                                                "sense_id": "5069e7a9-2e16-3539-b994-93aab5c29dcc",
                                                "text": "The only novels with which the weary Titan refreshes his mind are those of Thackeray, sometimes of Trollope; the more frivolous sometimes go so far as to sip a little of the honey that falls from the mellifluous lips of Mr A. C. Benson."
                                            },
                                            {
                                                "example_id": "fc427dd4-b893-45fe-b18d-a79ec7d5f51d",
                                                "sense_id": "5069e7a9-2e16-3539-b994-93aab5c29dcc",
                                                "text": "Certainly, he [Richard Ashcroft] returns explicitly to the sound of Urban Hymns on his fourth solo album: neat, sad strings, unhurried percussion and his mellifluous foghorn of a voice."
                                            },
                                            {
                                                "example_id": "7991e72b-9bf3-41cb-aa62-5fe8408303e5",
                                                "sense_id": "5069e7a9-2e16-3539-b994-93aab5c29dcc",
                                                "text": "His [Roy Orbison's] iconic look, mellifluous croon and timeless songwriting means that he retains a strong fanbase."
                                            },
                                            {
                                                "example_id": "8d080311-f149-4506-8cc3-d5b5628e0092",
                                                "sense_id": "5069e7a9-2e16-3539-b994-93aab5c29dcc",
                                                "text": "Radio proved a perfect fit for the mellifluous tones of Mr. Pence, who called himself “Rush Limbaugh on decaf.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
