                "senses": [
                    {
                        "sense_id": "3ceff803-497d-3be6-be80-05ddb88340b6",
                        "entry_id": "58f1154b-6c02-3454-8eb4-36673f23ce87",
                        "glosses": [
                            "medizinische Binde aus nur mäßig dehnungsfähigen Materialien"
                        ],
                        "tags": [
                            "Technische Orthopädie"
                        ],
                        "examples": [
                            {
                                "example_id": "b2fdcfce-8c63-4bf6-9ff8-a936a9a166e9",
                                "sense_id": "3ceff803-497d-3be6-be80-05ddb88340b6",
                                "text": "„Langzugbinden werden meistens an Hand und Handgelenk sowie an Fuß- und Sprunggelenk verwendet, um die Beweglichkeit dieser Gelenke zu erhalten. Kurzzugbinden werden vorzugsweise an den übrigen Extremitätenanteilen benutzt.“"
                            },
                            {
                                "example_id": "d838baa4-47b2-44b5-b4f7-2df3d1e85151",
                                "sense_id": "3ceff803-497d-3be6-be80-05ddb88340b6",
                                "text": "Langzugbinden aus dehnungsfähigeren Materialien für Tiefenwirkung und statischen Druck kommen bei mobilen, Kurzzugbinden mit weniger elastischen Materialien für Oberflächenwirkung kommen bei bettlägerigen Patienten zum Einsatz."
                            },
                            {
                                "example_id": "099809c7-c691-4d09-b98b-ce41c34181a6",
                                "sense_id": "3ceff803-497d-3be6-be80-05ddb88340b6",
                                "text": "„Während die Langzugbinde in ihrer Anlagetechnik leicht zu erlernen ist, so daß der Patient sie selbst wickeln kann, ist die Technik mit der Kurzzugbinde schwierig, so daß eine geschulte Kraft die Binde anlegen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
