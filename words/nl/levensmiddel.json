                        "voedsel",
                        "voeding"
                    ],
                    "common_phrases": [
                        "essentieel levensmiddel"
                    ],
                    "target_lang_definitions": {
                        "en": "A nutrient or food item that serves to nourish the body."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "foodstuff",
                                "target_lang_sense_clarification": "an item of food"
                            },
                            {
                                "target_lang_word": "food product",
                                "target_lang_sense_clarification": "any article used for food or drink by humans"
                            },
                            {
                                "target_lang_word": "staple food",
                                "target_lang_sense_clarification": "a food that is eaten routinely and in such quantities that it constitutes a dominant portion of a standard diet"
                            }
