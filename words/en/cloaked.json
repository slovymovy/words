    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b46422c4-2308-3f82-8933-afc32e96ed8e",
                    "sense_definition": "simple past and past participle of <w>cloak</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thick fog <w>cloaked</w> the valley during the early morning hours.",
                            "target_lang_translations": {
                                "de": "Dichter Nebel <w>hüllte</w> das Tal in den frühen Morgenstunden <w>ein</w>."
                            }
                        },
                        {
                            "text": "The company <w>cloaked</w> its true financial motives in legal jargon.",
                            "target_lang_translations": {
                                "de": "Das Unternehmen <w>verschleierte</w> seine wahren finanziellen Motive hinter juristischem Fachjargon."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past form"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Präteritum und Partizip Perfekt von 'cloak': einhüllen, verhüllen oder verschleiern."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "hüllte ein",
                                "target_lang_sense_clarification": "Präteritum von einhüllen"
                            },
                            {
                                "target_lang_word": "verschleierte",
                                "target_lang_sense_clarification": "Präteritum von verschleiern (übertragen)"
                            },
                            {
                                "target_lang_word": "eingehüllt",
                                "target_lang_sense_clarification": "Partizip Perfekt von einhüllen"
                            },
                            {
                                "target_lang_word": "verschleiert",
                                "target_lang_sense_clarification": "Partizip Perfekt von verschleiern"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "98717eae-2285-3672-8845-95cc809568df",
                    "sense_definition": "Concealed, covered, or hidden from sight or understanding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire operation was <w>cloaked</w> in secrecy to prevent any media leaks.",
                            "target_lang_translations": {
                                "de": "Die gesamte Operation war in Geheimhaltung <w>gehüllt</w>, um Informationslecks an die Medien zu verhindern."
                            }
                        },
                        {
                            "text": "He was a tall stranger, entirely <w>cloaked</w> in mystery.",
                            "target_lang_translations": {
                                "de": "Er war ein großer Fremder, völlig in Geheimnisse <w>gehüllt</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cloaked in secrecy",
                        "cloaked in mystery",
                        "cloaked in darkness"
                    ],
                    "target_lang_definitions": {
                        "de": "Verhüllt, verborgen oder vor Blicken bzw. dem Verständnis versteckt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gehüllt",
                                "target_lang_sense_clarification": "in etwas eingehüllt (z. B. Geheimnis)"
                            },
                            {
                                "target_lang_word": "verschleiert",
                                "target_lang_sense_clarification": "unklar gemacht, versteckt"
                            },
                            {
                                "target_lang_word": "verborgen",
                                "target_lang_sense_clarification": "versteckt, nicht sichtbar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0d13959-ceed-35dc-adda-604cbe2ecfcd",
                    "sense_definition": "Wearing a cloak or similar loose outer garment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>cloaked</w> figure stepped out from the shadows of the ancient castle.",
                            "target_lang_translations": {
                                "de": "Eine Gestalt <w>im Umhang</w> trat aus den Schatten der alten Burg hervor."
                            }
                        },
                        {
                            "text": "The actor entered the dark stage as a <w>cloaked</w> traveller.",
                            "target_lang_translations": {
                                "de": "Der Schauspieler betrat die dunkle Bühne als Reisender <w>mit Umhang</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "becloaked"
                    ],
                    "common_phrases": [
                        "cloaked figure"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Umhang oder ein ähnliches weites Obergewand tragend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "im Umhang",
                                "target_lang_sense_clarification": "einen Umhang tragend"
                            },
                            {
                                "target_lang_word": "bemantelt",
                                "target_lang_sense_clarification": "mit einem Mantel oder Umhang bekleidet (gehoben)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0faa7e3-de2f-3b22-b4d6-675187ec8c08",
                    "sense_definition": "Made invisible through advanced or futuristic technology.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radar failed to detect the <w>cloaked</w> vessel approaching the station.",
                            "target_lang_translations": {
                                "de": "Das Radar konnte das sich der Station nähernde, <w>getarnte</w> Schiff nicht erfassen."
                            }
                        },
                        {
                            "text": "In the science fiction story, pilots could fly <w>cloaked</w> ships past enemy defenses.",
                            "target_lang_translations": {
                                "de": "In der Science-Fiction-Geschichte konnten Piloten <w>getarnte</w> Schiffe an den feindlichen Verteidigungsanlagen vorbeifliegen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cloaked ship",
                        "cloaked vessel"
                    ],
                    "target_lang_definitions": {
                        "de": "Durch fortschrittliche oder futuristische Technologie unsichtbar gemacht oder getarnt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "getarnt",
                                "target_lang_sense_clarification": "unsichtbar gemacht (Sci-Fi/Militär)"
                            },
                            {
                                "target_lang_word": "unsichtbar",
                                "target_lang_sense_clarification": "nicht sichtbar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}