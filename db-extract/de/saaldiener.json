                        "examples": [
                            {
                                "example_id": "07a043e5-7651-446a-8e15-b0b9f0d4e945",
                                "sense_id": "a12aab1a-b824-3d69-a4e5-fc60ebb2b8b8",
                                "text": "„Erst als ihnen der Saaldiener die Geschichte des Weinkellers erzählt, schrecken sie auf.“"
                            },
                            {
                                "example_id": "2f3bcc0e-42ee-4154-8bc6-199a84d8ee1c",
                                "sense_id": "a12aab1a-b824-3d69-a4e5-fc60ebb2b8b8",
                                "text": "„Er rannte an den gelangweilt wartenden Saaldienern vorbei, immer hoffend, nicht auf Helen zu treffen.“"
                            },
                            {
                                "example_id": "41cc8286-1951-4c81-a871-2cc4effe8e64",
                                "sense_id": "a12aab1a-b824-3d69-a4e5-fc60ebb2b8b8",
                                "text": "„Der Vater stammte aus einem Bauernhaus in Niederösterreich und war nach seinem Ausscheiden aus der Armee Saaldiener im Wiener Polytechnikum.“"
                            }
                        ],
