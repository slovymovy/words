                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The Western <w>Bug</w> forms part of the border between Poland and Ukraine.",
                            "target_lang_translations": {
                                "ru": "Западный <w>Буг</w> образует часть границы между Польшей и Украиной.",
                                "tr": "Batı <w>Bug</w> Nehri, Polonya ile Ukrayna arasındaki sınırın bir kısmını oluşturur."
                            }
                        },
                        {
                            "text": "They went fishing along the banks of the <w>Bug</w> river.",
                            "target_lang_translations": {
                                "ru": "Они отправились на рыбалку на берега реки <w>Буг</w>.",
                                "tr": "<w>Bug</w> nehrinin kıyılarında balık tutmaya gittiler."
                            }
