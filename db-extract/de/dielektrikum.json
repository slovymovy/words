                "senses": [
                    {
                        "sense_id": "a2939811-4985-3c04-8885-32e9137c428d",
                        "entry_id": "ece3f3fb-c5c9-3270-8f99-09041de93b42",
                        "glosses": [
                            "elektrisch schwach- oder nichtleitende Substanz, in der die vorhandenen Ladungsträger nicht frei beweglich sind"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "41dbfd60-0f00-4f55-9ae1-ac42d037b180",
                                "sense_id": "a2939811-4985-3c04-8885-32e9137c428d",
                                "text": "„Bei kapazitiven Sensoren wirkt die Feuchtigkeit auf das Dielektrikum und ändert so die Kapazität des Sensors, […]“"
                            },
                            {
                                "example_id": "180fa54f-e90e-47ce-89b5-d765aa6a4dc3",
                                "sense_id": "a2939811-4985-3c04-8885-32e9137c428d",
                                "text": "„Metallisiert werden Kunststofffolien als Dielektrikum eingesetzt und zu Kondensatoren zusammengerollt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
