                    },
                    {
                        "sense_id": "6ea1095a-a267-3790-99da-3233e551492d",
                        "entry_id": "52df23cf-06bc-3f96-ae09-98a7e35856a9",
                        "glosses": [
                            "Celui ou celle qui professe le changement social par des réformes."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "778d3661-9a04-414d-914b-d084216b267d",
                                "sense_id": "6ea1095a-a267-3790-99da-3233e551492d",
                                "text": "Ce réformiste en politique est jugé diversement par ses propres contemporains."
                            },
                            {
                                "example_id": "9f45d144-dd6d-4916-9e3c-35699b8c1865",
                                "sense_id": "6ea1095a-a267-3790-99da-3233e551492d",
                                "text": "Un de nos réformistes les plus distingués, Henri Turot, longtemps rédacteur de la Petite République et conseiller municipal de Paris, a écrit un livre sur les « prolétaires de l'amour » ; il désigne ainsi les prostituées de bas étage."
                            }
                        ]
                    }
