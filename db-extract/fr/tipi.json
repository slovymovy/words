            {
                "entry_id": "5650c8b9-e134-3c0e-a6a9-8f29bb95ea00",
                "word": "tipi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a273bd6-704d-4276-bbf9-6002542aceb3",
