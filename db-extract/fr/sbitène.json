                "senses": [
                    {
                        "sense_id": "11fc05bc-d098-3426-9342-d3ae5a5eb9c9",
                        "entry_id": "d50875cd-61cc-3c96-a7e3-1ec259bc3b4d",
                        "glosses": [
                            "Sorte d’hydromel russe, fort épicé."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b5806497-e577-478e-b4d9-3ea8bd286795",
                                "sense_id": "11fc05bc-d098-3426-9342-d3ae5a5eb9c9",
                                "text": "Sans se faire prier, le père Minaï, colosse à barbe d’ébène, ventripotent comme un samovar monstre où bout le sbitène de tout un marché transi de froid, grimpa sur le timonier qui faillit crouler sous son poids."
                            },
                            {
                                "example_id": "f3e5fcb5-3ed7-4fe8-a503-5f7ec3bb22c3",
                                "sense_id": "11fc05bc-d098-3426-9342-d3ae5a5eb9c9",
                                "text": "Celle d’angle donnait asile à un vendeur de sbitène, possesseur d’un samovar en cuivre rouge et d’une trogne si rubiconde que, de loin, n’eût été sa barbe de jais, on l’aurait prix aussi pour un samovar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7825c124-6ca4-4966-92d8-c65c6af65b81",
                        "source_entry_id": "d50875cd-61cc-3c96-a7e3-1ec259bc3b4d",
                        "source_sense_id": "11fc05bc-d098-3426-9342-d3ae5a5eb9c9",
