                    {
                        "sense_id": "7530f34d-b5cc-3445-8721-1e382ce0d14e",
                        "entry_id": "583aad0b-f350-334f-8d16-47a1420b8bf6",
                        "glosses": [
                            "abgerundeter (Berg-)Gipfel"
                        ],
                        "tags": [
                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "c45848fa-faed-4321-b8b2-1810107e906b",
                                "sense_id": "7530f34d-b5cc-3445-8721-1e382ce0d14e",
                                "text": "„Der Gupf – das sind etwa zwei Millionen Kubikmeter Gestein, die sich vom Berg lösen würden, so viel wie 2 000 Einfamilienhäuser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
