                        "entry_id": "b26f98d0-72dd-35c0-813c-410db7984b58",
                        "glosses": [
                            "ein vorgeschobener, großer, mit Türmen versehener Baukörper im Westteil großer karolingischer und romanischer Kloster- und Bischofskirchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "058e9263-0b6d-4b7d-8015-0809e3f09840",
                                "sense_id": "1c2cc9cf-c888-37fc-ab33-471722c9d1c5",
                                "text": "Das bollwerkartige Westwerk symbolisierte die “ecclesia militans“ wohingegen die östlichen Kirchenteile die “ecclesia triumphans\" repräsentieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
