                        "examples": [
                            {
                                "example_id": "ee1ff44c-c5c9-4abb-a99d-968dc9cec3ad",
                                "sense_id": "6cf2bc18-6ccb-34b8-a8b0-666f199d4930",
                                "text": "On dit que les Juifs sont les crucifieurs du Christ, mais les Romains crucifiaient déjà bien avant eux."
                            },
                            {
                                "example_id": "7fa598fb-5ae6-4bd2-8a2b-7b3b03fc7fc8",
                                "sense_id": "6cf2bc18-6ccb-34b8-a8b0-666f199d4930",
                                "text": "Le futur crucifié se transforme en crucifieur par refus du sacrifice."
                            }
                        ]
                    }
                ],
