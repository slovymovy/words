                    {
                        "sense_id": "860a959f-4695-3f0f-bd13-18f786473909",
                        "entry_id": "0f9dbec9-a021-335b-8309-2f2febee0cdb",
                        "glosses": [
                            "Qui peut être modélisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efca27ed-8a89-4b4f-b25b-5413140cf58c",
                                "sense_id": "860a959f-4695-3f0f-bd13-18f786473909",
                                "text": "Il subvertit l'ordre marchand, bouscule la hiérarchie et transgresse les règles établies, justement parce qu'il n'est pas modélisable."
                            },
                            {
                                "example_id": "6b5afbff-a9f9-4e4c-98bc-46e7ee2bab3c",
                                "sense_id": "860a959f-4695-3f0f-bd13-18f786473909",
                                "text": "Il faut changer de mode de rémunération à l’acte pour aller vers des contrats individuels ou de groupe modélisables en fonction des spécialités et du lieu d’exercice, permettant de gérer à la fois l’installation et une nouvelle hiérarchie dans la rémunération."
                            },
                            {
                                "example_id": "3065e946-3786-4c1d-9c08-8faba9d44dda",
                                "sense_id": "860a959f-4695-3f0f-bd13-18f786473909",
                                "text": "Les entreprises, individuellement, peuvent très bien adopter une stratégie concertée anti-concurrentielle (c’est aussi modélisable en théorie des jeux de coordination, avec le système de prix faussés comme équilibre de Nash pour tous les joueurs/entreprises)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f30e772e-d9e4-4b64-b331-2224cf529ef4",
                        "source_entry_id": "0f9dbec9-a021-335b-8309-2f2febee0cdb",
                        "source_sense_id": "860a959f-4695-3f0f-bd13-18f786473909",
