                                        "glosses": [
                                            "Of or pertaining to sound reproduction using two channels to give a more natural two-dimensional sound distribution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd3d291f-2cd0-4c5c-9e2f-cb92667c642a",
                                                "sense_id": "998d7abe-d676-3bfb-8a6f-62b4c0637fb6",
                                                "text": "[…] this 1953 Hansel und Gretel is a classic example of how a well produced mono recording can seem more stereophonic than many of its later stereophonic rivals."
                                            }
                                        ]
                                    }
                                ]
