                {
                    "sense_id": "50bc3f38-765c-3d85-b952-282330c47987",
                    "sense_definition": "plotseling bang worden door een onverwachte gebeurtenis",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moest erg <w>schrikken</w> toen de hond plotseling hard begon te blaffen.",
                            "target_lang_translations": {
                                "en": "I was very <w>startled</w> when the dog suddenly started barking loudly."
                            }
                        },
                        {
                            "text": "Je moet niet zo hard <w>schrikken</w> van een klein beetje lawaai in de gang.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>get such a fright</w> from a little bit of noise in the hallway."
                            }
                        }
                    ],
                    "synonyms": [
