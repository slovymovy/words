    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0044a17e-398f-34cc-b232-6b6d1da59889",
                    "sense_definition": "To buy or obtain something by paying money for it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_buy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>purchase</w> a new car after saving money for two years.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>купить</w> новую машину, копив деньги два года.",
                                "tr": "İki yıl para biriktirdikten sonra yeni bir araba <w>satın almaya</w> karar verdik.",
                                "zh": "存了两年钱后，我们决定<w>购买</w>一辆新车。"
                            }
                        },
                        {
                            "text": "Customers can <w>purchase</w> tickets online or at the box office.",
                            "target_lang_translations": {
                                "ru": "Покупатели могут <w>приобрести</w> билеты онлайн или в кассе.",
                                "tr": "Müşteriler biletleri çevrim içi olarak veya gişeden <w>satın alabilirler</w>.",
                                "zh": "顾客可以在线或在售票处<w>购买</w>票。"
                            }
                        }
                    ],
                    "synonyms": [
                        "procure",
                        "buy"
                    ],
                    "common_phrases": [
                        "purchase goods",
                        "purchase online",
                        "purchase a ticket"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покупать или приобретать что-либо, платя за это деньги.",
                        "tr": "Para ödeyerek bir şeyi satın almak veya elde etmek.",
                        "zh": "通过支付金钱来买或获得某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покупать",
                                "target_lang_sense_clarification": "приобретать за деньги"
                            },
                            {
                                "target_lang_word": "приобретать",
                                "target_lang_sense_clarification": "получать в собственность"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "satın almak",
                                "target_lang_sense_clarification": "ödeme yaparak edinmek"
                            },
                            {
                                "target_lang_word": "edinmek",
                                "target_lang_sense_clarification": "mülkiyetine geçirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "购买",
                                "target_lang_sense_clarification": "正式的买入行为"
                            },
                            {
                                "target_lang_word": "买",
                                "target_lang_sense_clarification": "通用的买入行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee6131c3-a731-37a2-9c82-ea81277d46ed",
                    "sense_definition": "To be sufficient to buy something; to provide the financial power to obtain something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her savings <w>purchased</w> her freedom from debt and allowed her to start fresh.",
                            "target_lang_translations": {
                                "ru": "Её сбережения <w>купили</w> ей свободу от долгов и позволили начать всё сначала.",
                                "tr": "Tasarrufları borçlarından kurtulmasını <w>sağladı</w> ve yeni bir başlangıç yapmasına izin verdi.",
                                "zh": "她的积蓄让她<w>换取</w>了债务的解脱，并使她能够重新开始。"
                            }
                        },
                        {
                            "text": "A small amount of money <w>purchased</w> a surprising amount of food at the market.",
                            "target_lang_translations": {
                                "ru": "На небольшую сумму денег на рынке удалось <w>купить</w> удивительно много еды.",
                                "tr": "Pazarda az miktarda bir para şaşırtıcı miktarda yiyecek <w>almaya yetti</w>.",
                                "zh": "在市场上，少量的钱竟然<w>买得起</w>惊人数量的食物。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть достаточным для покупки чего-либо; обеспечивать финансовую возможность получить что-либо.",
                        "tr": "Bir şeyi satın almaya yetmek; bir şeyi elde edecek finansal gücü sağlamak.",
                        "zh": "足以支付某物的费用；提供获得某物的经济能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покупать",
                                "target_lang_sense_clarification": "быть достаточным для оплаты"
                            },
                            {
                                "target_lang_word": "приобретать",
                                "target_lang_sense_clarification": "позволять купить"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "satın almaya yetmek",
                                "target_lang_sense_clarification": "maddi olarak karşılamak"
                            },
                            {
                                "target_lang_word": "sağlamak",
                                "target_lang_sense_clarification": "imkan tanımak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "买得起",
                                "target_lang_sense_clarification": "有足够的钱购买"
                            },
                            {
                                "target_lang_word": "足以支付",
                                "target_lang_sense_clarification": "在财务上能够负担"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc105667-4a6f-35d7-9561-95f8cd61ee61",
                    "sense_definition": "To obtain something through significant effort, sacrifice, or difficulty rather than money.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sought to <w>purchase</w> favor with the king through constant flattery.",
                            "target_lang_translations": {
                                "ru": "Он стремился <w>купить</w> расположение короля постоянной лестью.",
                                "tr": "Sürekli övgülerle kralın gözüne girmeyi <w>satın almaya</w> çalıştı.",
                                "zh": "他试图通过不断的奉承来<w>换取</w>国王的青睐。"
                            }
                        },
                        {
                            "text": "The victory was <w>purchased</w> at the cost of many lives.",
                            "target_lang_translations": {
                                "ru": "Эта победа была <w>куплена</w> ценой многих жизней.",
                                "tr": "Zafer, birçok can pahasına <w>kazanıldı</w>.",
                                "zh": "这场胜利是<w>赢得</w>的，但付出了许多生命的代价。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "literary or figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Получить что-либо ценой значительных усилий, жертв или трудностей, а не за деньги.",
                        "tr": "Para yerine büyük çaba, fedakarlık veya zorluklarla bir şey elde etmek.",
                        "zh": "通过巨大的努力、牺牲或困难而非金钱来获得某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покупать",
                                "target_lang_sense_clarification": "переносное значение: добывать ценой жертв"
                            },
                            {
                                "target_lang_word": "доставаться",
                                "target_lang_sense_clarification": "приобретаться с трудом"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bedel ödeyerek kazanmak",
                                "target_lang_sense_clarification": "fedakarlıkla elde etmek"
                            },
                            {
                                "target_lang_word": "satın almak",
                                "target_lang_sense_clarification": "mecazi anlamda elde etmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "换取",
                                "target_lang_sense_clarification": "通过代价获得"
                            },
                            {
                                "target_lang_word": "赢得",
                                "target_lang_sense_clarification": "通过努力或牺牲获得"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a46f2aab-af77-37d8-be68-c09552c724bd",
                    "sense_definition": "The act of buying something for a price.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>purchase</w> of the house took several months to complete.",
                            "target_lang_translations": {
                                "ru": "<w>Покупка</w> дома заняла несколько месяцев.",
                                "tr": "Evin <w>satın alınması</w> birkaç ay sürdü.",
                                "zh": "这栋房子的<w>购买</w>过程花了几个月才完成。"
                            }
                        },
                        {
                            "text": "Please keep your receipt as proof of <w>purchase</w> in case you need to return the item.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, сохраните чек как доказательство <w>покупки</w> на случай, если вам понадобится вернуть товар.",
                                "tr": "Ürünü iade etmeniz gerekebileceği ihtimaline karşı lütfen makbuzunuzu <w>satın alma</w> kanıtı olarak saklayın.",
                                "zh": "请保留好收据作为<w>购买</w>凭证，以备需要退货时使用。"
                            }
