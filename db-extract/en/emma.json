                                "target_senses": [
                                    {
                                        "sense_id": "4332b7ea-8496-334a-846d-87169a7e522c",
                                        "entry_id": "b50f0124-2df1-3027-a085-305d9ff54036",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d303b6f6-a96b-405d-b165-1ce2fd3c144c",
                                                "sense_id": "4332b7ea-8496-334a-846d-87169a7e522c",
                                                "text": "Die kleine Emma möchte im Kinderparadies abgeholt werden."
                                            },
                                            {
                                                "example_id": "70435eac-758a-480a-9c1b-a829f16c7218",
                                                "sense_id": "4332b7ea-8496-334a-846d-87169a7e522c",
                                                "text": "Emma Mustermann ist ein schönes Mädchen."
                                            },
                                            {
                                                "example_id": "aa099067-027e-4f71-ba0c-35f491805b7a",
                                                "sense_id": "4332b7ea-8496-334a-846d-87169a7e522c",
                                                "text": "Emma ist 20 Jahre alt."
                                            },
                                            {
                                                "example_id": "e9174fda-13d9-49ee-b726-50de5fe731da",
                                                "sense_id": "4332b7ea-8496-334a-846d-87169a7e522c",
                                                "text": "Grüß bitte Emma Mustermann herzlich von mir."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Emma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                        "entry_id": "00edb860-487e-33db-a915-a5060d4ddf1c",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32b471e-2c28-4223-a73b-e68cee9b2848",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Frau Emma ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "a0fb269b-dec4-4202-ae76-21f97780e6bb",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Herr Emma wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "4843e88e-b505-4d73-9444-6c0cfb6f4c7e",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Die Emmas kommen heute aus Saarbrücken."
                                            },
                                            {
                                                "example_id": "67a1083a-1229-4bba-a8b0-eaf2af2a04f9",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Der Emma trägt nie die Schals, die die Emma ihm strickt."
                                            },
                                            {
                                                "example_id": "506b55be-cc95-4718-a7fe-b0844eda134b",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Emma kommt, geht der Herr Emma.“"
                                            },
                                            {
                                                "example_id": "b9244884-a6b5-4674-9d4d-2d3b53b5a914",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Emma kommt und geht."
                                            },
                                            {
                                                "example_id": "9cb5374b-033e-4356-beaf-4e2a8be7fe81",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Emmas kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "671c24e6-7274-47a4-94b6-553409a797ef",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "An verregneten Herbsttagen ist Familie Emmas liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "78441aac-9746-4503-81e7-b9c79a1c89a3",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Emma das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
