                "senses": [
                    {
                        "sense_id": "c69b61ee-01c1-385f-a1ac-1388920584aa",
                        "entry_id": "bc88373c-efdc-3d30-92ec-b88c198eef1d",
                        "glosses": [
                            "Commune, ville et chef-lieu de la province de Flandre-Orientale de la région flamande de Belgique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76b0b05c-05ed-4e8b-adeb-881048018517",
                                "sense_id": "c69b61ee-01c1-385f-a1ac-1388920584aa",
                                "text": "En faisant becqueter à des souris du carmellose (E466) et du polysorbate 80 (E433), les chercheurs des universités d’Atlanta (Géorgie) et de Gand (Belgique) se sont rendu compte que les bactéries intestinales, au lieu de digérer les aliments, se mettaient à ronger la paroi du tube digestif (« Nature », février 2015)."
                            },
                            {
                                "example_id": "551d1bb1-0a4d-40e0-8bca-b11199b4dd0c",
                                "sense_id": "c69b61ee-01c1-385f-a1ac-1388920584aa",
                                "text": "Le Slovène ne participera ni à Gand-Wevelgem, dimanche, ni à À travers la Flandre, mercredi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65eed82c-6b0e-4835-8ecc-6e59247cec83",
