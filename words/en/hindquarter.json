    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc244cfd-c190-3983-8afa-909bad5805f5",
                    "sense_definition": "The back legs and rear portion of a four-legged animal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog sat quietly on its <w>hindquarters</w> while waiting for the trainer's command.",
                            "target_lang_translations": {
                                "ru": "Собака спокойно сидела на <w>задних лапах</w>, ожидая команды дрессировщика."
                            }
                        },
                        {
                            "text": "Muscular power in the horse's <w>hindquarters</w> allows it to jump over tall obstacles easily.",
                            "target_lang_translations": {
                                "ru": "Мускульная сила в <w>задней части тела</w> лошади позволяет ей легко перепрыгивать высокие препятствия."
                            }
                        }
                    ],
                    "synonyms": [
                        "haunches",
                        "rump"
                    ],
                    "antonyms": [
                        "forequarters"
                    ],
                    "common_phrases": [
                        "on its hindquarters",
                        "powerful hindquarters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задняя часть туловища и задние конечности четвероногого животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задняя часть туловища",
                                "target_lang_sense_clarification": "у животных"
                            },
                            {
                                "target_lang_word": "задние ноги",
                                "target_lang_sense_clarification": "задние конечности животного"
                            },
                            {
