                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ada7bca5-eedc-4cc5-85a4-0d5c520b5da9",
                                "sense_id": "98a881f0-ad08-37d4-a7f4-0e376bf8cbe1",
                                "text": "Gänsegeier sind sehr gesellig und brüten meist in Kolonien."
                            },
                            {
                                "example_id": "708c3658-1d8e-4217-ab62-4aa70841fbc2",
                                "sense_id": "98a881f0-ad08-37d4-a7f4-0e376bf8cbe1",
                                "text": "„Dennoch untersuchen der an der Universität Montpellier tätige Biologe und seine Kollegen genau, ob sich das Verhalten der Gänsegeier durch die Kadaverablage an festen Futterplätzen ändert.“"
                            }
