                    {
                        "sense_id": "87c00151-1113-3618-9cb7-6e700b0d9884",
                        "entry_id": "90e9ecb1-ac6f-33b6-85c0-91c6bbdcc9b1",
                        "glosses": [
                            "Difficult to endure; arduous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11867e60-3c8d-4aab-a6ce-58b179fc8bc4",
                                "sense_id": "87c00151-1113-3618-9cb7-6e700b0d9884",
                                "text": "\"Do you not find,\" he said, \"that with your short sight it is a little trying to do so much typewriting?\""
                            },
                            {
                                "example_id": "d9aab050-cc64-4473-9dba-46a635c1239b",
                                "sense_id": "87c00151-1113-3618-9cb7-6e700b0d9884",
                                "text": "Troutbeck is a tiny village midway between Penrith and Keswick in a very sparsely populated part of Cumberland, and it used to be said by facetious travellers that the reason why it ever had a station at all was to give the engine a rest after it had struggled up the long and trying incline from Threlkeld."
                            },
                            {
                                "example_id": "6c0e14b5-00de-42db-a93e-dadabc66b024",
                                "sense_id": "87c00151-1113-3618-9cb7-6e700b0d9884",
                                "text": "Tryin’ times, what the world is talkin’ about / You got confusion all over the land, yeah"
                            }
                        ]
                    },
