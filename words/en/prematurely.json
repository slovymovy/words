{
    "word_family": [
        "premature",
        "prematurity"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ed94aaa0-4a19-3f6f-9085-eb022647a973",
                    "sense_definition": "In a manner that happens before the expected or natural time; too soon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>prematurely</w> announce the new product before it was ready.",
                            "target_lang_translations": {
                                "zh": "公司决定在产品准备好之前<w>过早地</w>发布了新产品。",
                                "ru": "Компания решила <w>преждевременно</w> объявить о новом продукте до того, как он был готов."
                            }
                        },
                        {
                            "text": "He <w>prematurely</w> ended the meeting before everyone had a chance to speak.",
                            "target_lang_translations": {
                                "zh": "大家还没来得及发言，他就<w>提前</w>结束了会议。",
                                "ru": "Он <w>преждевременно</w> завершил встречу до того, как у каждого появилась возможность высказаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "early",
                        "untimely"
                    ],
                    "antonyms": [
                        "belatedly"
                    ],
                    "common_phrases": [
                        "prematurely end",
                        "prematurely announce"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在预期或自然时间之前发生，即过早地。",
                        "ru": "Раньше ожидаемого или положенного времени; слишком рано или до срока."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "过早地",
                                "target_lang_sense_clarification": "强调动作或事件发生的时间早于预期。"
                            },
                            {
                                "target_lang_word": "提前",
                                "target_lang_sense_clarification": "指在预定时间之前完成某事。"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "преждевременно",
                                "target_lang_sense_clarification": "раньше положенного срока или до наступления готовности"
                            },
                            {
                                "target_lang_word": "слишком рано",
                                "target_lang_sense_clarification": "раньше, чем следовало бы"
                            },
                            {
                                "target_lang_word": "досрочно",
                                "target_lang_sense_clarification": "раньше установленного срока"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}