                "senses": [
                    {
                        "sense_id": "17166a3c-8fd9-32c6-9660-1e682ebaf76b",
                        "entry_id": "71b1a9d7-5006-3858-bc5b-ca68aa53a9e2",
                        "glosses": [
                            "Gruppe von Jungen, die eine Mannschaft bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9939426-533d-4a7c-b188-6be2aed9e4df",
                                "sense_id": "17166a3c-8fd9-32c6-9660-1e682ebaf76b",
                                "text": "„Die A-Mannschaft des Vereins fristete derzeit ein klägliches Dasein in der untersten Liga, während die Jugendmannschaften im vergangenen Jahr einen gewissen Erfolg hatten verbuchen können. Das galt vor allem für die Jungenmannschaft der Dreizehnjährigen, die in ihrer Liga an der Spitze lag und zwei Spieler in die Bezirksmannschaft entsenden konnte.“"
                            },
                            {
                                "example_id": "6b5e22e5-6778-4a90-a2bc-a229818a7adb",
                                "sense_id": "17166a3c-8fd9-32c6-9660-1e682ebaf76b",
                                "text": "„Ich habe weiter in meiner Jungenmannschaft gespielt, musste dann aber öfter mal fehlen, weil ich mit der Auswahl unterwegs war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
