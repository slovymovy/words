{
    "word_family": [
        "rainbow",
        "raincoat",
        "raindrop",
        "rainfall",
        "rainless",
        "rainstorm",
        "rainwater",
        "rainy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be5d79d1-a2b5-3e24-8045-f8256ad16ca2",
                    "sense_definition": "Condensed water falling from a cloud in separate drops",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have been having a lot of <w>rain</w> lately so the garden is very green.",
                            "target_lang_translations": {
                                "ru": "В последнее время у нас часто идут <w>дожди</w>, поэтому сад очень зелёный."
                            }
                        },
                        {
                            "text": "The <w>heavy</w> <w>rain</w> caused the river to overflow its banks.",
                            "target_lang_translations": {
                                "ru": "Сильный <w>дождь</w> заставил реку выйти из берегов."
                            }
                        }
                    ],
                    "synonyms": [
                        "precipitation",
                        "rainfall"
                    ],
                    "common_phrases": [
                        "heavy rain",
                        "light rain",
                        "pouring rain",
                        "steady rain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конденсированная вода, выпадающая из облака в виде отдельных капель"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дождь",
                                "target_lang_sense_clarification": "атмосферные осадки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f325487-fc74-3946-b576-2adf631733e6",
                    "sense_definition": "A large quantity of things falling or moving through the air together",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "falling_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>rain</w> of confetti fell on the parade participants as they passed by.",
                            "target_lang_translations": {
                                "ru": "<w>Дождь</w> из конфетти посыпался на участников парада, когда они проходили мимо."
                            }
                        },
                        {
                            "text": "The archers released their strings and a <w>rain</w> of arrows filled the sky.",
                            "target_lang_translations": {
                                "ru": "Лучники спустили тетиву, и <w>град</w> стрел заполнил небо."
                            }
                        }
                    ],
                    "synonyms": [
                        "shower",
                        "cascade",
                        "torrent"
                    ],
                    "common_phrases": [
                        "rain of arrows",
                        "rain of sparks",
                        "rain of confetti"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое количество предметов, падающих или движущихся в воздухе вместе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дождь",
                                "target_lang_sense_clarification": "поток падающих предметов"
                            },
                            {
                                "target_lang_word": "град",
                                "target_lang_sense_clarification": "множество, обилие чего-либо"
                            },
                            {
                                "target_lang_word": "ливень",
                                "target_lang_sense_clarification": "бурный поток чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d23e7d27-0f9c-3eaf-8211-320328dc9946",
                    "sense_definition": "To have water fall from the sky in drops",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weather_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It looks like it is going to <w>rain</w> so you should take an umbrella.",
                            "target_lang_translations": {
                                "ru": "Похоже, собирается <w>дождь</w>, так что тебе стоит взять зонт."
                            }
                        },
                        {
                            "text": "It <w>started</w> <w>to</w> <w>rain</w> just as we arrived at the park for our picnic.",
                            "target_lang_translations": {
                                "ru": "<w>Дождь</w> начался как раз в тот момент, когда мы приехали в парк на пикник."
                            }
                        }
                    ],
                    "synonyms": [
                        "pour",
                        "drizzle"
                    ],
                    "common_phrases": [
                        "start to rain",
                        "threaten to rain",
                        "rain cats and dogs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпадать из неба в виде капель воды"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "об осадках"
                            },
                            {
                                "target_lang_word": "лить",
                                "target_lang_sense_clarification": "о сильном дожде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9d6cbf7-6436-312d-b36c-2e8b37b3fed3",
                    "sense_definition": "To fall down in large amounts like raindrops",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "falling_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tears <w>rained</w> down her face as she said goodbye to her best friend.",
                            "target_lang_translations": {
                                "ru": "Слёзы <w>лились</w> по её лицу, когда она прощалась с лучшей подругой."
                            }
                        },
                        {
                            "text": "Golden leaves <w>rained</w> from the trees during the autumn windstorm.",
                            "target_lang_translations": {
                                "ru": "Золотые листья <w>сыпались</w> с деревьев во время осенней бури."
                            }
                        }
                    ],
                    "synonyms": [
                        "shower",
                        "fall",
                        "pour"
                    ],
                    "common_phrases": [
                        "rain down",
                        "rain from above"
                    ],
                    "target_lang_definitions": {
                        "ru": "Падать в больших количествах, подобно каплям дождя"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыпаться дождём",
                                "target_lang_sense_clarification": "падать во множестве"
                            },
                            {
                                "target_lang_word": "литься",
                                "target_lang_sense_clarification": "о слезах или свете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2f36406-58c4-3542-8f09-880608a573b3",
                    "sense_definition": "To send or give something in large, rapid quantities",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "giving_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry fans <w>rained</w> insults on the referee after the controversial decision.",
                            "target_lang_translations": {
                                "ru": "Разгневанные фанаты <w>осыпали</w> судью оскорблениями после спорного решения."
                            }
                        },
                        {
                            "text": "The boxer <w>rained</w> <w>punches</w> on his opponent until the round ended.",
                            "target_lang_translations": {
                                "ru": "Боксёр <w>обрушил</w> град ударов на своего противника, пока раунд не закончился."
                            }
                        }
                    ],
                    "synonyms": [
                        "bestow",
                        "heap",
                        "lavish"
                    ],
                    "common_phrases": [
                        "rain blows",
                        "rain punches",
                        "rain insults"
                    ],
                    "target_lang_definitions": {
                        "ru": "Посылать или давать что-либо в больших, стремительных количествах"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осыпать",
                                "target_lang_sense_clarification": "давать в избытке"
                            },
                            {
                                "target_lang_word": "сыпаться градом",
                                "target_lang_sense_clarification": "о большом количестве ударов или оскорблений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "544e9ef8-b6e1-381f-a380-b999f37e4d92",
                    "sense_definition": "An obsolete form of <w>reign</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In old texts you might find the word <w>rain</w> used where we now use reign.",
                            "target_lang_translations": {
                                "ru": "В старых текстах можно встретить слово rain там, где мы сейчас используем <w>reign</w>."
                            }
                        },
                        {
                            "text": "Such wondrous science in mans witt to <w>rain</w>.",
                            "target_lang_translations": {
                                "ru": "Такая дивная наука в человеческом уме <w>царствует</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "used in historical texts instead of reign"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма слова reign (царствовать)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "царствовать",
                                "target_lang_sense_clarification": "устаревшее написание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ba1f0db1-d3d1-3df5-9cb9-e3b7b51d2e2c",
                    "sense_definition": "A female given name",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Rain</w> chose her name because she loves the sound of storms.",
                            "target_lang_translations": {
                                "ru": "Моя подруга <w>Рейн</w> выбрала себе такое имя, потому что любит шум грозы."
                            }
                        },
                        {
                            "text": "The actress named her daughter <w>Rain</w> to reflect her love of nature.",
                            "target_lang_translations": {
                                "ru": "Актриса назвала свою дочь <w>Рейн</w>, чтобы отразить свою любовь к природе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рейн",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}