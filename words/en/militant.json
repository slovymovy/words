{
    "word_family": [
        "militancy",
        "militantly",
        "militarism",
        "militarist",
        "militarize",
        "military"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c9bd4233-f414-38ec-b7cd-1b7102bf29bd",
                    "sense_definition": "Engaged in warfare or having a strong tendency to fight; aggressive and warlike.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aggression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to adopt a <w>militant</w> policy to address the border dispute.",
                            "target_lang_translations": {
                                "ru": "Правительство решило принять <w>воинственную</w> политику для решения пограничного спора."
                            }
                        },
                        {
                            "text": "The rise of <w>militant</w> groups in the region has caused significant international concern.",
                            "target_lang_translations": {
                                "ru": "Рост <w>воинствующих</w> группировок в регионе вызвал серьезную международную озабоченность."
                            }
                        }
                    ],
                    "synonyms": [
                        "warrish"
                    ],
                    "antonyms": [
                        "peaceful",
                        "pacific"
                    ],
                    "common_phrases": [
                        "militant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвующий в военных действиях или имеющий сильную склонность к борьбе; агрессивный и воинственный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воинственный",
                                "target_lang_sense_clarification": "склонный к войне или агрессии"
                            },
                            {
                                "target_lang_word": "воинствующий",
                                "target_lang_sense_clarification": "активно враждебный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60280292-e2e5-3f3a-a0bb-605217613366",
                    "sense_definition": "Aggressively active in supporting a political or social cause; combative and uncompromising.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "activism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She became a <w>militant</w> campaigner for environmental protection after the oil spill.",
                            "target_lang_translations": {
                                "ru": "После разлива нефти она стала <w>радикальной</w> активисткой движения за защиту окружающей среды."
                            }
                        },
                        {
                            "text": "The union took a <w>militant</w> stance during the negotiations for better wages.",
                            "target_lang_translations": {
                                "ru": "Профсоюз занял <w>боевую</w> позицию во время переговоров о повышении зарплаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "warrish"
                    ],
                    "antonyms": [
                        "moderate",
                        "passive"
                    ],
                    "common_phrases": [
                        "militant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Агрессивно активный в поддержке политического или общественного дела; боевой и бескомпромиссный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боевой",
                                "target_lang_sense_clarification": "активный и решительный в действиях"
                            },
                            {
                                "target_lang_word": "радикальный",
                                "target_lang_sense_clarification": "бескомпромиссный в методах"
                            },
                            {
                                "target_lang_word": "воинствующий",
                                "target_lang_sense_clarification": "непримиримый в убеждениях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93c9d50c-0c41-3baa-8947-b30a9a27ca5d",
                    "sense_definition": "A person who uses aggressive or violent methods to support a political or social cause.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "activism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>militants</w> occupied the building to protest the new law.",
                            "target_lang_translations": {
                                "ru": "<w>Боевики</w> захватили здание в знак протеста против нового закона."
                            }
                        },
                        {
                            "text": "Security forces are monitoring the activities of several known <w>militants</w> in the city.",
                            "target_lang_translations": {
                                "ru": "Силы безопасности следят за деятельностью нескольких известных в городе <w>экстремистов</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "pacifist",
                        "moderate"
                    ],
                    "common_phrases": [
                        "militant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, использующий агрессивные или насильственные методы для поддержки политического или общественного дела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боевик",
                                "target_lang_sense_clarification": "участник вооруженной группировки"
                            },
                            {
                                "target_lang_word": "активист",
                                "target_lang_sense_clarification": "радикальный сторонник движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a07579f4-5076-3371-8ad9-912202f06dc0",
                    "sense_definition": "A person engaged in combat or warfare; a soldier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aggression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The treaty was signed by both the regular army and the independent <w>militants</w>.",
                            "target_lang_translations": {
                                "ru": "Договор был подписан как регулярной армией, так и независимыми <w>бойцами</w>."
                            }
                        },
                        {
                            "text": "He lived the life of a <w>militant</w> for years before returning to civilian life.",
                            "target_lang_translations": {
                                "ru": "Он годами жил жизнью <w>солдата</w>, прежде чем вернуться к гражданской жизни."
                            }
                        }
                    ],
                    "antonyms": [
                        "civilian"
                    ],
                    "common_phrases": [
                        "militant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, участвующий в бою или войне; солдат или боец."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боец",
                                "target_lang_sense_clarification": "участник сражений"
                            },
                            {
                                "target_lang_word": "комбатант",
                                "target_lang_sense_clarification": "лицо, принимающее участие в конфликте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b26cce8-4a28-30e2-9116-75b55d13d8b5",
                    "sense_definition": "A supporter of the Trotskyist political views associated with the newspaper 'Militant'.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the 1980s, the <w>militant</w> tendency had a significant influence on the local council.",
                            "target_lang_translations": {
                                "ru": "В 1980-х годах течение <w>«Милитант»</w> имело значительное влияние на местный совет."
                            }
                        },
                        {
                            "text": "He was known as a dedicated <w>militant</w> within the labor movement.",
                            "target_lang_translations": {
                                "ru": "Он был известен как преданный <w>активист</w> внутри рабочего движения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "militant"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily UK political context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сторонник троцкистских политических взглядов, связанных с газетой «Militant» (в контексте Великобритании)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "троцкист",
                                "target_lang_sense_clarification": "последователь троцкизма"
                            },
                            {
                                "target_lang_word": "член группы «Милитант»",
                                "target_lang_sense_clarification": "участник конкретной политической фракции"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}