                                    {
                                        "sense_id": "943b3ff8-1bd3-3344-a1d7-b486b2fcd8c5",
                                        "entry_id": "7f4992cb-1243-3f62-b7e9-cc3ccf4dca88",
                                        "glosses": [
                                            "die nordöstlichste Provinz Chinas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1952faf1-a641-4395-b358-a53d4dbd3e74",
                                                "sense_id": "943b3ff8-1bd3-3344-a1d7-b486b2fcd8c5",
                                                "text": "Die meisten Bewohner Heilongjiangs sind Han-Chinesen."
                                            },
                                            {
                                                "example_id": "f6e7fcc5-6314-418e-9404-06f356d42db1",
                                                "sense_id": "943b3ff8-1bd3-3344-a1d7-b486b2fcd8c5",
                                                "text": "Seit der wirtschaftlichen Reform versuchen sich Harbin und die Provinz Heilongjiang als Brückenkopf im Handel mit Russland zu profilieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d6ab123-eded-4ab7-bfd9-882f495ce4cc",
                        "source_entry_id": "2c3b8e62-8da3-32f7-ac8e-0c0bb5fb92c0",
                        "target_lang_word": "Heilongjiang",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heilongjiang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d0bfa67-56bb-32a2-9ea7-adc101eb9894",
                                        "entry_id": "6c686dec-5f62-37ca-a0dd-4c809139d168",
                                        "glosses": [
                                            "A province in northeastern China. Capital: Harbin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0900d79-d9b1-4141-a972-c00cea2aa37e",
                                                "sense_id": "5d0bfa67-56bb-32a2-9ea7-adc101eb9894",
                                                "text": "Zhang Zuo-lin (1873-1928), a former bandit chief who joined the army, was appointed governor of Moukden by Yuan Shi-kai in exchange for services rendered. Using political intrigue and military pressure, he got Heilongjiang (1917) and Jilin (1919) under his control, thus becoming master of the three provinces of Manchuria."
                                            },
                                            {
                                                "example_id": "23e53586-e1a2-41b3-8ce4-fce676f450ad",
                                                "sense_id": "5d0bfa67-56bb-32a2-9ea7-adc101eb9894",
                                                "text": "Yu Changwu from the northeastern province of Heilongjiang has urged the ruling Communist Party to honor its “revolutionary ideals and pledges” and hand land back to the farmers."
                                            },
                                            {
                                                "example_id": "d239c398-9f6b-4859-ba69-4c86b893179c",
                                                "sense_id": "5d0bfa67-56bb-32a2-9ea7-adc101eb9894",
                                                "text": "A series of new COVID-19 cases in China's far northeastern Heilongjiang province is raising concern that a second wave of the virus could emerge in the Asian country."
                                            },
                                            {
                                                "example_id": "5e3daf70-94f8-43d6-b0e4-d87bfdba0d9d",
                                                "sense_id": "5d0bfa67-56bb-32a2-9ea7-adc101eb9894",
                                                "text": "During this period, minimum temperatures in some parts of Inner Mongolia and Heilongjiang could fall to below minus 30 degrees Celsius."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b24c5bc3-38ef-3cab-8d18-0567545572a6",
                                        "entry_id": "6c686dec-5f62-37ca-a0dd-4c809139d168",
                                        "glosses": [
                                            "Alternative form of Heilong Jiang, the Amur River: a major river in the Far East of Russia and Northeastern China."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b30f2522-78b9-44db-bfa4-fbece83e45dc",
                                                "sense_id": "b24c5bc3-38ef-3cab-8d18-0567545572a6",
                                                "text": "In 1848, Russian Senior Naval Captain Nevelskoiy and his military transport ship set sail to invade China's Heilongjiang [Amur-river] River estuary and the Sakhalin island. In 1850, Miaojie on the Heilongjiang River estuary was forcibly occupied, turned into a stronghold for aggression and renamed Nikolayevsk after the czar. In April 1853, Czar Nicholas I brazenly ordered the invasion and occupation of China's Sakhalin island."
                                            },
                                            {
                                                "example_id": "5bb1cf07-369b-466c-aa79-5e83cce7f6b2",
                                                "sense_id": "b24c5bc3-38ef-3cab-8d18-0567545572a6",
                                                "text": "More than 7,000 people of Hailanpao and the sixty-four villages east of the Heilongjiang River were murdered, burned to death or drowned in the river."
                                            },
                                            {
                                                "example_id": "8cca0835-3c2e-49ca-a9f2-8c499a668159",
                                                "sense_id": "b24c5bc3-38ef-3cab-8d18-0567545572a6",
                                                "text": "The Songhua is a major tributary of the Heilongjiang River, which crosses the border near the Russian city of Khabarovsk."
                                            },
                                            {
                                                "example_id": "7b776deb-afde-4a0e-bc7f-b6170487910a",
                                                "sense_id": "b24c5bc3-38ef-3cab-8d18-0567545572a6",
                                                "text": "Hunting was central to Oroqen culture, with kills shared among families. The semi-nomadic people lived along the banks of the Heilongjiang (“black dragon river”), a long, dark, snaking body of water forming the border between northeast China and Russia, in tepee-like structures called djiu, which were built of birch bark."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
