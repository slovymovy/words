    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e46ed72-6bf4-3a34-be36-56b0129395f8",
                    "sense_definition": "The joint in the middle of the human leg that allows it to bend.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomy_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fell down on the pavement and scraped his <w>knee</w>.",
                            "target_lang_translations": {
                                "ru": "Он упал на тротуар и ободрал <w>колено</w>.",
                                "zh": "他摔倒在人行道上，擦伤了<w>膝盖</w>。"
                            }
                        },
                        {
                            "text": "She got down on her <w>knees</w> to look for the ring under the sofa.",
                            "target_lang_translations": {
                                "ru": "Она встала на <w>колени</w>, чтобы поискать кольцо под диваном.",
                                "zh": "她跪下来，在沙发下面找戒指。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on one's knees",
                        "bend one's knees",
                        "scrape one's knee",
                        "weak at the knees"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сустав в середине ноги человека, позволяющий ей сгибаться.",
                        "zh": "人腿中间使腿能够弯曲的关节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колено",
                                "target_lang_sense_clarification": "сустав"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "膝盖",
                                "target_lang_sense_clarification": "人体腿中间可弯曲的关节"
                            },
                            {
                                "target_lang_word": "膝",
                                "target_lang_sense_clarification": "较书面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "251b9776-1267-385f-9db1-3cec260593a4",
                    "sense_definition": "The part of a piece of clothing, such as trousers, that covers the knee.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>knees</w> of his gardening jeans were covered in mud and grass stains.",
                            "target_lang_translations": {
                                "ru": "<w>Колени</w> его джинсов для работы в саду были покрыты грязью и пятнами от травы.",
                                "zh": "他那条干园艺活时穿的牛仔裤<w>膝部</w>沾满了泥和草渍。"
                            }
                        },
                        {
                            "text": "She sewed a patch onto the torn <w>knee</w> of her son's trousers.",
                            "target_lang_translations": {
                                "ru": "Она пришила заплатку на порванное <w>колено</w> брюк своего сына.",
                                "zh": "她在儿子裤子破了的<w>膝部</w>缝了一块补丁。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reinforced knee",
                        "torn knee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть одежды (например, брюк), закрывающая колено.",
                        "zh": "衣物（如裤子）上覆盖膝盖的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колено",
                                "target_lang_sense_clarification": "часть одежды"
