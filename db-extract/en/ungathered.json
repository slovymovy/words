                        "examples": [
                            {
                                "example_id": "2dde9952-80a1-4f46-b672-582e26e5e441",
                                "sense_id": "fff66fac-8105-35b6-9ea9-a8cdbd69b43b",
                                "text": "My researches have included extensive and varied fields of fact and of thought, even though very much in those fields has been left ungathered."
                            },
                            {
                                "example_id": "6c544cd6-b4d6-4db2-a555-7ea71f633f3f",
                                "sense_id": "fff66fac-8105-35b6-9ea9-a8cdbd69b43b",
                                "text": "The next device of Ismael was to call the Mussulmans of the interior into the fortresses, and when we protested against this as dangerous and utterly uncalled for, the pasha sent a counter order; but the bearers of it met the unfortunate Mussulmans by the way, having abandoned everything, thrown their silkworms to the fowls, and left their crops ungathered, and being ready to vent their hostility on the innocent Christian population, whom they made responsible for the disaster."
                            }
                        ]
                    },
