                                                "text": "Изменена видовая принадлежность микроорганизмов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "877811df-9fb4-3c22-bd42-2973c4aea52a",
                                        "entry_id": "288e03f1-b56a-31da-81ca-c4eb1f8f572b",
                                        "glosses": [
                                            "предмет, входящий в состав чего-либо, дополняющий что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
