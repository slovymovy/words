                "senses": [
                    {
                        "sense_id": "78c6f4b0-4e22-3470-a2e3-b2c4b187b7c5",
                        "entry_id": "7700db9b-ef28-315a-92c8-026c4df302c8",
                        "glosses": [
                            "To explain by, or accommodate to, the Platonic philosophy."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2c56b068-9b89-4883-902a-003662ab5fb1",
                                "sense_id": "78c6f4b0-4e22-3470-a2e3-b2c4b187b7c5",
                                "text": "Either Plato philonized, or Philo platonized"
                            }
                        ]
                    },
                    {
                        "sense_id": "493e09f2-457d-3856-9930-17a744c3efa5",
                        "entry_id": "7700db9b-ef28-315a-92c8-026c4df302c8",
                        "glosses": [
                            "To adopt the opinion of Plato or his followers."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "48f4a054-e8a4-4834-9435-a1331916c0f2",
                                "sense_id": "493e09f2-457d-3856-9930-17a744c3efa5",
                                "text": "He platonizes , after the manner of Origen , in some parts of his writings ; yet he is cited by Athanasius as a witness of the Son's consubstantiality with the Father"
                            }
                        ]
                    }
                ],
