                "senses": [
                    {
                        "sense_id": "bd6ed316-0fd9-324e-af9a-ac06ae837df8",
                        "entry_id": "049e8aa3-1202-31ee-a901-fa7627150ed6",
                        "glosses": [
                            "Person, die sich mit einer Tauchausrüstung unter Wasser bewegt und dabei in große Tiefen vorstößt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96f8065c-9005-4158-a4fc-080bd3cc9e9b",
                                "sense_id": "bd6ed316-0fd9-324e-af9a-ac06ae837df8",
                                "text": "Wer mit normaler Ausrüstung unter 40 Meter herabtaucht, darf sich Tiefseetaucher nennen."
                            },
                            {
                                "example_id": "4a00ec19-0c91-4e68-9b36-384326cfa17d",
                                "sense_id": "bd6ed316-0fd9-324e-af9a-ac06ae837df8",
                                "text": "Der Tiefseetaucher im Taucherschutzanzug kommt vielleicht 300 m unter die Meeresoberfläche im Tauchgebiet."
                            },
                            {
                                "example_id": "97c73cc8-9748-40fc-b3c1-79c1744e0b26",
                                "sense_id": "bd6ed316-0fd9-324e-af9a-ac06ae837df8",
                                "text": "Der Tiefseetaucher hat ständig das Risiko abzuwägen, das eine drohende Taucherkrankheit darstellt. Er muss deshalb viele Tauchstopps einlegen, bei denen er auf gleicher Tauchhöhe bleibt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
