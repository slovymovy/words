{
    "word_family": [
        "begin",
        "beginning",
        "begun"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d6964d3b-343d-3efb-8370-cba28f0b648d",
                    "sense_definition": "A person who is starting to learn or do something for the first time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "learning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This yoga class is perfect for a <w>beginner</w> who has never tried it before.",
                            "target_lang_translations": {
                                "ru": "Этот класс йоги идеально подходит для <w>новичка</w>, который никогда не пробовал этого раньше."
                            }
                        },
                        {
                            "text": "Even a complete <w>beginner</w> can learn to play a simple song on the piano in one day.",
                            "target_lang_translations": {
                                "ru": "Даже абсолютный <w>новичок</w> может научиться играть простую песню на пианино за один день."
                            }
                        }
                    ],
                    "synonyms": [
                        "learner",
                        "novice",
                        "newcomer",
                        "rookie",
                        "starter"
                    ],
                    "antonyms": [
                        "expert",
                        "master",
                        "veteran",
                        "specialist"
                    ],
                    "common_phrases": [
                        "complete beginner",
                        "beginner level",
                        "absolute beginner",
                        "beginner course"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который только начинает изучать или делать что-либо впервые."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "человек, недавно начавший заниматься чем-либо"
                            },
                            {
                                "target_lang_word": "начинающий",
                                "target_lang_sense_clarification": "тот, кто делает первые шаги в какой-либо области"
                            },
                            {
                                "target_lang_word": "дебютант",
                                "target_lang_sense_clarification": "тот, кто впервые выступает или пробует себя в новом деле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6c149e1-d89f-38ab-847e-21ad27ca3b57",
                    "sense_definition": "A person who starts or initiates a process, event, or action.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "initiator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>beginner</w> of the project explained the original vision to the new team members.",
                            "target_lang_translations": {
                                "ru": "<w>Инициатор</w> проекта объяснил первоначальное видение новым членам команды."
                            }
                        },
                        {
                            "text": "As the <w>beginner</w> of the games, she had the honor of lighting the ceremonial torch.",
                            "target_lang_translations": {
                                "ru": "Как <w>человеку, открывающему</w> игры, ей выпала честь зажечь церемониальный факел."
                            }
                        }
                    ],
                    "synonyms": [
                        "founder",
                        "initiator",
                        "originator"
                    ],
                    "common_phrases": [
                        "beginner of the games"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который инициирует или дает начало процессу, событию или действию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инициатор",
                                "target_lang_sense_clarification": "лицо, положившее начало чему-либо"
                            },
                            {
                                "target_lang_word": "основатель",
                                "target_lang_sense_clarification": "тот, кто заложил основу процесса или организации"
                            },
                            {
                                "target_lang_word": "зачинатель",
                                "target_lang_sense_clarification": "тот, кто начал какое-либо важное дело"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c342247e-4537-3755-9ba4-9b4ca98a3579",
                    "sense_definition": "An actor who is required to be on stage at the very start of a play or scene.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theater",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stage manager called for <w>beginners</w> to take their positions five minutes before the curtain rose.",
                            "target_lang_translations": {
                                "ru": "Помощник режиссера вызвал <w>актеров первой сцены</w> занять свои места за пять минут до поднятия занавеса."
                            }
                        },
                        {
                            "text": "All <w>beginners</w> for the first act were already waiting nervously in the wings.",
                            "target_lang_translations": {
                                "ru": "Все <w>участники начала</w> первого акта уже нервно ждали за кулисами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "call for beginners"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in theater"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Актер, который должен находиться на сцене в самом начале пьесы или сцены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "актер, начинающий действие",
                                "target_lang_sense_clarification": "театральный термин для участников первой сцены"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}