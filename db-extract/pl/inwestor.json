                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "инве́стор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0f648e55-9eab-3bd2-9a8d-dfa1a1f9715f",
                                        "entry_id": "91c19de5-f370-3ea9-996b-a99940b536d7",
                                        "glosses": [
                                            "экон. человек или организация, вкладывающие средства в какое-либо дело, бизнес, по отношению к этому бизнесу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a837b1-db55-444b-b60e-f06b5e2b5c48",
                                                "sense_id": "0f648e55-9eab-3bd2-9a8d-dfa1a1f9715f",
                                                "text": "Поэтому ни один потенциальный инвестор ― ни отечественный, ни иностранный ― не будет тратиться на завод, контрольный пакет акций которого держит трудовой коллектив."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
