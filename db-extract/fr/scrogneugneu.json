                    {
                        "sense_id": "3e31d7fc-8d01-3c29-a386-1d324d2ee5f5",
                        "entry_id": "87f511ee-8de0-3764-ba9a-8769f52ef789",
                        "glosses": [
                            "Juron qui exprime le déplaisir."
                        ],
                        "tags": [
                            "euphemism"
                        ],
                        "examples": [
                            {
                                "example_id": "63cb15ca-5d88-4b02-b40e-2c3cc9475c9f",
                                "sense_id": "3e31d7fc-8d01-3c29-a386-1d324d2ee5f5",
                                "text": "Scrogneugneu ! Scrogneugneu ! Scrogneugneu ! Scrogneugneu ! Si ce n’est pas la honte ça ! Frapper un vieil homme comme moi, au soir de sa vie !"
                            },
                            {
                                "example_id": "389ae546-5a26-43b5-9b77-14854623325a",
                                "sense_id": "3e31d7fc-8d01-3c29-a386-1d324d2ee5f5",
                                "text": "Sans devenir un spécialiste d’histoire, vous devez bon gré mal gré vous y mettre, scrogneugneu ! La maîtrise s’affirme d’abord par un rappel à l’ordre : […]."
                            }
                        ]
                    }
                ],
