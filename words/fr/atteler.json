            "senses": [
                {
                    "sense_id": "6d5c275c-e6ad-3adf-be78-8b42ec6d3187",
                    "sense_definition": "Se consacrer avec détermination à une tâche complexe ou exigeante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe doit s'<w>atteler</w> sans attendre à la préparation de ce nouveau projet."
                        },
                        {
                            "text": "Dès le matin, les étudiants se sont <w>attelés</w> à réviser leurs examens."
                        }
                    ],
                    "synonyms": [
                        "s'appliquer",
                        "s'attaquer",
                        "se consacrer"
                    ],
                    "common_phrases": [
                        "s'atteler à la tâche",
                        "s'atteler au travail"
                    ]
                },
                {
                    "sense_id": "add34cd6-45f7-3b3a-b61a-4b476886569c",
                    "sense_definition": "Attacher des animaux de trait à un véhicule, une charrue ou une charge.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "traction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fermier prend le temps d'<w>atteler</w> les chevaux avant de partir labourer le champ."
                        },
                        {
                            "text": "À l'époque, on <w>attelait</w> souvent plusieurs bœufs pour tirer cette lourde charrue."
                        }
                    ],
                    "antonyms": [
                        "dételer"
                    ],
                    "common_phrases": [
                        "atteler les chevaux",
                        "atteler un chariot"
                    ]
                },
                {
                    "sense_id": "62d369ad-a4b8-3240-9d54-a1cee005c224",
                    "sense_definition": "Accrocher une remorque ou un engin à un véhicule automobile tracteur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "traction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir en vacances, nous devons <w>atteler</w> la caravane à notre voiture."
                        },
                        {
                            "text": "Il a vérifié les fixations après avoir <w>attelé</w> la remorque au tracteur."
                        }
                    ],
                    "synonyms": [
                        "accrocher"
                    ],
                    "antonyms": [
                        "dételer"
                    ],
                    "common_phrases": [
                        "atteler une remorque",
                        "atteler une caravane"
                    ]
                },
                {
                    "sense_id": "ca94a070-36ae-3412-9502-83db8f3194df",
                    "sense_definition": "Assujettir quelqu'un à un travail pénible et astreignant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a <w>attelé</w> tous ses collaborateurs à cette vérification fastidieuse."
                        },
                        {
                            "text": "Les ouvriers étaient <w>attelés</w> à la chaîne de montage sans aucun répit."
                        }
                    ],
                    "synonyms": [
                        "assujettir",
                        "astreindre"
                    ]
                }
            ]
        }
    ]
