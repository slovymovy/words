                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42188fa9-a558-4085-929a-745e9100dc51",
                                                "sense_id": "f0d65742-56d6-318f-9fe7-fc8ab34d2ab4",
                                                "text": "Kiedy mam chandrę, zjadam torebkę cukierków i od razu mi lepiej."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "2bfdfb77-42a9-3494-9584-e2607cfe8c32",
                                        "entry_id": "795808c3-d7e5-3944-8b9f-4fdf6edc24fc",
                                        "glosses": [
                                            "mniejsza torba do przechowywania osobistych drobiazgów wykonana z wytrzymałych materiałów noszona najczęściej przez kobiety na ramieniu lub w dłoni"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cce30d3a-87eb-419d-987d-cbe2e150fcd2",
                                                "sense_id": "2bfdfb77-42a9-3494-9584-e2607cfe8c32",
                                                "text": "Czy nosisz gaz pieprzowy w torebce?"
                                            },
                                            {
                                                "example_id": "a0938a0e-d717-4013-91ba-2772970791e0",
                                                "sense_id": "2bfdfb77-42a9-3494-9584-e2607cfe8c32",
                                                "text": "Najbardziej popularne przedmioty noszone w torebkach są banalne i oczywiste: portfele, błyszczyki, klucze i telefony komórkowe"
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "930ef823-ab85-3444-a42d-bf8d2685d170",
                                        "entry_id": "795808c3-d7e5-3944-8b9f-4fdf6edc24fc",
                                        "glosses": [
                                            "pękający owoc suchy podzielony w środku na komory"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a448f9fc-24b9-42ae-b557-67801f3dc4a7",
                                                "sense_id": "930ef823-ab85-3444-a42d-bf8d2685d170",
                                                "text": "Przykładem rośliny posiadającej torebki jest mak"
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "bdd09038-1ac8-398a-8f58-33f4d05a9672",
                                        "entry_id": "795808c3-d7e5-3944-8b9f-4fdf6edc24fc",
                                        "glosses": [
                                            "osłona występująca na powierzchni pęcherzyka jajnikowego złożona z komórek fibroblastycznych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80168d07-4fe6-4dba-9511-9876bd93073e",
                                                "sense_id": "bdd09038-1ac8-398a-8f58-33f4d05a9672",
                                                "text": "Usunięcie torebki likwiduje mechaniczną przeszkodę jajeczkowania"
                                            }
                                        ],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "e9403515-da1f-3b8b-81b3-79869733d872",
                                        "entry_id": "795808c3-d7e5-3944-8b9f-4fdf6edc24fc",
                                        "glosses": [
                                            "zob. torebka stawowa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b237cb-8914-424d-b91e-e0c153b7fa6b",
                                                "sense_id": "e9403515-da1f-3b8b-81b3-79869733d872",
                                                "text": "Ogólny kształt torebki stawowej można porównać do cylindra „wtłoczonego” do środka jamy stawu od strony tylnej"
                                            }
                                        ],
                                        "sense_index_json": "\"1.7\""
                                    },
                                    {
                                        "sense_id": "f14488bd-fae1-3d24-a6f1-9d728ab63465",
                                        "entry_id": "795808c3-d7e5-3944-8b9f-4fdf6edc24fc",
                                        "glosses": [
                                            "zob. torebka włosowa"
                                        ],
