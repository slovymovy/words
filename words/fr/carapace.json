    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22f48422-03b6-3638-92d1-b6c987e1017e",
                    "sense_definition": "Enveloppe osseuse et cornée qui protège le corps de la tortue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zoologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La tortue rentre lentement sa tête sous sa <w>carapace</w> lorsqu'elle a peur."
                        },
                        {
                            "text": "Cette vieille tortue terrestre possède une <w>carapace</w> particulièrement solide et bombée."
                        }
                    ],
                    "synonyms": [
                        "cuirasse"
                    ],
                    "common_phrases": [
                        "carapace de tortue"
                    ]
                },
                {
                    "sense_id": "956006fd-6914-3fe3-bfe4-f32a240b7ab1",
                    "sense_definition": "Enveloppe externe dure ou chitineuse qui recouvre le corps de certains crustacés.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zoologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut casser la <w>carapace</w> du homard pour pouvoir déguster sa chair."
                        },
                        {
                            "text": "Le cuisinier utilise chaque <w>carapace</w> de crevette pour préparer un bouillon savoureux."
                        }
                    ],
                    "synonyms": [
                        "exosquelette"
                    ],
                    "common_phrases": [
                        "carapace de crabe",
                        "carapace de homard"
                    ]
                },
                {
                    "sense_id": "c196ad3e-a123-3ae5-a6b6-6ec8cf0d1985",
                    "sense_definition": "Attitude ou comportement servant de protection psychologique face aux épreuves ou aux autres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette rupture difficile, elle s'est forgé une véritable <w>carapace</w> pour ne plus souffrir."
                        },
                        {
                            "text": "Derrière cette froide <w>carapace</w>, il cache une grande sensibilité."
                        }
                    ],
                    "synonyms": [
                        "cuirasse",
                        "blindage",
                        "armure"
                    ],
                    "common_phrases": [
                        "se forger une carapace",
                        "fendre la carapace",
                        "sortir de sa carapace"
                    ]
                },
                {
                    "sense_id": "970e85d1-4b3f-3c78-9b1b-e4f44316e113",
                    "sense_definition": "Structure rigide ou blindage servant de protection matérielle à un objet ou à une personne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'engin d'exploration est protégé par une épaisse <w>carapace</w> en métal résistant à la pression."
                        },
                        {
                            "text": "Le véhicule militaire est équipé d'une solide <w>carapace</w> d'acier contre les éclats."
                        }
                    ],
                    "synonyms": [
                        "blindage",
                        "bouclier",
                        "armature"
                    ],
                    "common_phrases": [
                        "carapace d'acier",
                        "carapace protectrice"
                    ]
                }
            ]
        }
    ]
