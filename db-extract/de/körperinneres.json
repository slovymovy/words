                "senses": [
                    {
                        "sense_id": "dd313d71-dedf-33a3-9d77-12078911dc69",
                        "entry_id": "f78adae6-5a40-3408-8c12-d6f213242c42",
                        "glosses": [
                            "innerer Teil eines (menschlichen) Körpers"
