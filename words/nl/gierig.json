{
    "word_family": [
        "gier",
        "gierigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1c76b35c-575e-3587-a90b-c11de0836abc",
                    "sense_definition": "niet bereid om geld of bezittingen met anderen te delen of uit te geven",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>gierige</w> man wilde ons niet trakteren op een biertje nadat we hem hadden geholpen.",
                            "target_lang_translations": {
                                "en": "That <w>stingy</w> man didn't want to buy us a beer after we had helped him.",
                                "zh": "在我们帮了他之后，那个<w>吝啬</w>的男人连杯啤酒都不肯请我们喝。"
                            }
                        },
                        {
                            "text": "Hij is zo <w>gierig</w> dat hij nooit een fooi geeft in een restaurant.",
                            "target_lang_translations": {
                                "en": "He is so <w>stingy</w> that he never leaves a tip in a restaurant.",
                                "zh": "他太<w>小气</w>了，在餐厅从不给小费。"
                            }
                        }
                    ],
                    "synonyms": [
                        "krenterig",
                        "vrekkig",
                        "schraperig"
                    ],
                    "antonyms": [
                        "gul"
                    ],
                    "common_phrases": [
                        "een gierige vrek",
                        "erg gierig zijn"
                    ],
                    "target_lang_definitions": {
                        "en": "unwilling to spend or share money or possessions with others",
                        "zh": "不愿意花钱或与他人分享财物"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stingy",
                                "target_lang_sense_clarification": "unwilling to spend or share; ungenerous"
                            },
                            {
                                "target_lang_word": "mean",
                                "target_lang_sense_clarification": "not willing to give or share things, especially money"
                            },
                            {
                                "target_lang_word": "miserly",
                                "target_lang_sense_clarification": "extremely unwilling to spend money"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吝啬",
                                "target_lang_sense_clarification": "形容人小气，不舍得花钱或分享"
                            },
                            {
                                "target_lang_word": "小气",
                                "target_lang_sense_clarification": "形容人不大方，斤斤计较"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55f25120-0f12-3b85-a829-71e864515d88",
                    "sense_definition": "een sterk verlangen hebben om meer te bezitten dan men nodig heeft",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>gierige</w> zakenman wilde alle winst voor zichzelf houden.",
                            "target_lang_translations": {
                                "en": "The <w>greedy</w> businessman wanted to keep all the profit for himself.",
                                "zh": "那个<w>贪婪</w>的商人想把所有利润都据为己有。"
                            }
                        },
                        {
                            "text": "Zijn <w>gierige</w> blik verraadde dat hij alleen aan zijn eigen belang dacht.",
                            "target_lang_translations": {
                                "en": "His <w>greedy</w> look revealed that he was only thinking of his own interests.",
                                "zh": "他那<w>贪心</w>的眼神暴露了他只顾及自己的利益。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hebzuchtig",
                        "inhalig"
                    ],
                    "common_phrases": [
                        "gierig naar macht"
                    ],
                    "target_lang_definitions": {
                        "en": "having a strong desire to possess more than one needs",
                        "zh": "有强烈的欲望想要拥有超过自己所需的财物"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "greedy",
                                "target_lang_sense_clarification": "having an excessive desire for food, money, or possessions"
                            },
                            {
                                "target_lang_word": "avaricious",
                                "target_lang_sense_clarification": "extremely greedy for wealth or material gain"
                            },
                            {
                                "target_lang_word": "grasping",
                                "target_lang_sense_clarification": "excessively greedy for material gain"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贪婪",
                                "target_lang_sense_clarification": "形容贪得无厌，欲望强烈"
                            },
                            {
                                "target_lang_word": "贪心",
                                "target_lang_sense_clarification": "形容想要得到更多，不知满足"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}