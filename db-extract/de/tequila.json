                "senses": [
                    {
                        "sense_id": "2dba20ca-8e13-3790-bc99-4648574a2aef",
                        "entry_id": "17ea64ef-843f-3858-8d58-a6e35203b9d0",
                        "glosses": [
                            "hochprozentiger Branntwein aus Mexiko, der aus Pulque (dem vergorenen Saft der Blauen Agave (Agave tequilana)) gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e655e251-38f2-4a7f-b89c-582eedf01d57",
                                "sense_id": "2dba20ca-8e13-3790-bc99-4648574a2aef",
                                "text": "„Tequila ist aber auch gemein: Tut farblich so, als wäre es Wasser, wirkt aber vollkommen anders.“"
                            },
                            {
                                "example_id": "1f5b97bf-ca6f-4f93-a758-cce4ce187a3b",
                                "sense_id": "2dba20ca-8e13-3790-bc99-4648574a2aef",
                                "text": "„Ich durfte Herrn Kilmister von da an noch ein paar Tequila servieren, war aber ansonsten abgemeldet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81953d6d-f8b1-46b3-b11a-7e6cc87d44ab",
                        "source_entry_id": "17ea64ef-843f-3858-8d58-a6e35203b9d0",
                        "source_sense_id": "2dba20ca-8e13-3790-bc99-4648574a2aef",
                        "source_sense_description": "hochprozentiger Branntwein aus Mexiko",
                        "target_lang_word": "tequila",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tequila",
