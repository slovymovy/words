                    {
                        "translation_id": "1bde40de-0a25-491c-8ae0-2306f07d7dc0",
                        "source_entry_id": "ee546391-615b-313b-a888-d64e6a6a0144",
                        "source_sense_description": "appendage added to something else",
                        "target_lang_word": "Anhängsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anhängsel",
