                                                "example_id": "a2db841e-a222-49af-ba1d-217e0d8d1be9",
                                                "sense_id": "2b64a88f-f889-3bfd-ad7c-0d5e80c6d7cc",
                                                "text": "Elle sonne. Une servante ouvre. Bien jolie et délurée, la soubrette !"
                                            },
