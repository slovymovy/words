                        ],
                        "form": "die Innenraumluft"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b17a6748-2ae3-316c-954d-5dfc4a8727a9",
                        "entry_id": "76198edb-e9fd-3f0b-abee-824d87cce233",
                        "glosses": [
                            "Luft in Räumen innerhalb eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "027306cc-0320-4209-ba44-796d481ffd73",
                                "sense_id": "b17a6748-2ae3-316c-954d-5dfc4a8727a9",
                                "text": "Karl bemerkte die schlechte Innenraumluft, als er in den Gerichtssaal kam."
                            },
                            {
                                "example_id": "5cec2cfe-d12e-4861-a2a2-cc26b266b069",
                                "sense_id": "b17a6748-2ae3-316c-954d-5dfc4a8727a9",
                                "text": "„Eine möglichst unbelastete und klimatisch behagliche Innenraumluft hat damit für das Wohlbefinden und die Gesundheit eine entscheidende Bedeutung.“"
                            },
                            {
                                "example_id": "f834b2f4-f24b-46ef-8768-5591c275af55",
                                "sense_id": "b17a6748-2ae3-316c-954d-5dfc4a8727a9",
                                "text": "„Die Qualität der Innenraumluft ist deshalb wichtig für das Wohlbefinden der Menschen.“"
                            },
                            {
                                "example_id": "90df77ef-b111-4f73-b354-0d0b88776a8b",
                                "sense_id": "b17a6748-2ae3-316c-954d-5dfc4a8727a9",
                                "text": "„Die Innenraumluft wird darüber hinaus durch Ausdünstungen von Möbeln oder Farben, beispielsweise von Formaldehyd, Dioxine, PCB oder Weichmacher, verunreinigt.“"
                            },
                            {
                                "example_id": "76b36b3c-28db-4c02-9135-da13542058f9",
                                "sense_id": "b17a6748-2ae3-316c-954d-5dfc4a8727a9",
                                "text": "„Richtwert I (RW I - Vorsorgerichtwert) beschreibt die Konzentration eines Stoffes in der Innenraumluft, bei der bei einer Einzelstoffbetrachtung nach gegenwärtigem Erkenntnisstand auch dann keine gesundheitliche Beeinträchtigung zu erwarten ist, wenn ein Mensch diesem Stoff lebenslang ausgesetzt ist.“"
                            },
                            {
                                "example_id": "b397399b-5c51-4135-9724-278c87da51b8",
                                "sense_id": "b17a6748-2ae3-316c-954d-5dfc4a8727a9",
                                "text": "„Die Menschen verbringen heute über 90 % des Tages in geschlossenen Räumen. Eine gute und gesunde Innenraumluft ist daher von erheblicher Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
