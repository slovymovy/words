                        ],
                        "form": "den Markgrafen"
                    },
                    {
                        "form_id": "c3fbbc7e-f793-4808-bd96-8e34c31603a5",
                        "entry_id": "5f11e89a-8bee-36d2-8a48-38b09aaba86b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Markgrafen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "baaf7b71-26d7-3600-8195-043128f45df7",
                        "entry_id": "5f11e89a-8bee-36d2-8a48-38b09aaba86b",
                        "glosses": [
                            "Befehlshaber eines Grenzgebiets, einer sogenannten Mark, mit bestimmten Rechten"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "78fa0f3b-04fa-4c65-8f9a-1ed322696119",
                                "sense_id": "baaf7b71-26d7-3600-8195-043128f45df7",
                                "text": "„Die askanischen Markgrafen befanden sich, wie erst in Zeugnissen des 13. Jahrhunderts in Erscheinung tritt, im Besitz des Reichsamtes des Erzkämmerers.“"
                            },
                            {
                                "example_id": "9dbd5d47-cc94-4c10-bb96-ee21fc86cb35",
                                "sense_id": "baaf7b71-26d7-3600-8195-043128f45df7",
                                "text": "„Die Nürnberger wiederum gewannen im Landshuter Krieg erhebliches Gebiet, was die Auseinandersetzungen mit den Markgrafen, mit denen die Reichsstadt seit Generationen im Streit lag, weiter verschärfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b19472a-eb9b-455d-b3fd-4ef028591466",
                        "source_entry_id": "5f11e89a-8bee-36d2-8a48-38b09aaba86b",
                        "source_sense_id": "baaf7b71-26d7-3600-8195-043128f45df7",
                        "source_sense_description": "historisch: Befehlshaber eines Marks",
                        "target_lang_word": "margrave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "margrave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02322788-544d-30cb-a3bb-c088070d4b2b",
                                        "entry_id": "7e812112-f551-353b-88f8-485efacc7381",
                                        "glosses": [
                                            "A feudal era military-administrative officer of comital rank in the Carolingian empire and some successor states, originally in charge of a border area."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3732f520-ddab-453c-bede-218b00e1bb34",
                                                "sense_id": "02322788-544d-30cb-a3bb-c088070d4b2b",
                                                "text": "1973: Among pulverised heads of stone margraves and electors, reconnoitering a likely-looking cabbage patch, all of a sudden Slothrop picks up the scent of an unmistakable no it can’t be yes it is it’s a REEFER! — Thomas Pynchon, Gravity’s Rainbow"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fc9a936-0470-3d55-852b-0ab29e79a713",
                                        "entry_id": "7e812112-f551-353b-88f8-485efacc7381",
                                        "glosses": [
                                            "A hereditary ruling prince in certain feudal states of the Holy Roman Empire and elsewhere; the titular equivalent became known as marquis or marquess."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c6c578f-192e-4e23-8ff7-f87604e3b569",
                                                "sense_id": "2fc9a936-0470-3d55-852b-0ab29e79a713",
                                                "text": "The Margrave of Bruges was their head."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b378503e-19de-435f-8802-b136f68e1eb7",
                        "source_entry_id": "5f11e89a-8bee-36d2-8a48-38b09aaba86b",
                        "source_sense_id": "baaf7b71-26d7-3600-8195-043128f45df7",
                        "source_sense_description": "historisch: Befehlshaber eines Marks",
                        "target_lang_word": "marquis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marquis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f267d2b-d7db-35f3-a061-ae5d5fcf18c4",
                                        "entry_id": "cd067156-7fd0-3abf-a6a5-447b3f296b97",
                                        "glosses": [
                                            "Seigneur préposé à la garde des marches, des frontières d’un état."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57a5ca94-cdd2-38f5-b628-3f109cf9acf2",
                                        "entry_id": "cd067156-7fd0-3abf-a6a5-447b3f296b97",
                                        "glosses": [
                                            "Titre de dignité que l’on donnait à celui qui possédait une terre érigée en marquisat par lettre patente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779ed3f5-a816-4208-9916-f26f8a303ad9",
                                                "sense_id": "57a5ca94-cdd2-38f5-b628-3f109cf9acf2",
                                                "text": "Des impôts considérables accablaient les vilains, écrasait les pauvres gens, épargnant les princes et les ducs, les comtes et les marquis."
                                            },
                                            {
                                                "example_id": "ed472da3-7bfe-42cc-8c01-c3bbc267c544",
                                                "sense_id": "57a5ca94-cdd2-38f5-b628-3f109cf9acf2",
                                                "text": "L’Invincible Armada devait avoir pour amiral le marquis de Santa-Cruz ; mais il mourut pendant les préparatifs, et le commandement fut donné au duc de Medina-Sidonia, marin de cour, dont la présomption égalait l’ignorance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a0fbd71-6369-3080-9153-de932c01cdc3",
                                        "entry_id": "cd067156-7fd0-3abf-a6a5-447b3f296b97",
                                        "glosses": [
                                            "Simple titre de noblesse, plus haut qu'un comte et plus bas qu'un duc."
                                        ],
                                        "tags": [
                                            "Aujourd’hui"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0be8f54a-343f-438a-9cf4-dae911f9ba47",
                                                "sense_id": "1a0fbd71-6369-3080-9153-de932c01cdc3",
                                                "text": "La société enrichie la veille par des spéculations, honnêtes ou non, joignait à ses richesses des titres nobiliaires ; chacun s'improvisait comte, marquis ou baron."
                                            },
                                            {
                                                "example_id": "c6726fcf-02ce-4664-8f22-b60f7fe059e6",
                                                "sense_id": "1a0fbd71-6369-3080-9153-de932c01cdc3",
                                                "text": "Le vieux marquis tolérait que les pauvres vinssent ramasser les branches mortes, […]."
                                            },
                                            {
                                                "example_id": "1061b50d-e35a-4798-93c5-41dae91ac1dd",
                                                "sense_id": "1a0fbd71-6369-3080-9153-de932c01cdc3",
                                                "text": "C’est un marquis de Carabas : se dit, par allusion au conte du Chat botté, d’un homme qui possède ou qui se vante de posséder un grand nombre de terres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aa1b30d-c909-3579-8d11-a3255f1712dc",
                                        "entry_id": "cd067156-7fd0-3abf-a6a5-447b3f296b97",
                                        "glosses": [
                                            "Chapeau à trois pointes, tricorne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "432589c9-abee-438e-be4e-92478816b493",
                                                "sense_id": "2aa1b30d-c909-3579-8d11-a3255f1712dc",
                                                "text": "Le père avait l’air d'un grand seigneur, en veston du matin au soir et coiffé d’un chapeau marquis."
                                            },
                                            {
                                                "example_id": "26312e2b-7566-42f0-b56b-203423b175d9",
                                                "sense_id": "2aa1b30d-c909-3579-8d11-a3255f1712dc",
                                                "text": "La mode était aux chapeaux cloches, aux petits marquis fort seyants, aux turbans ornés parfois d’un chou de ruban."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
