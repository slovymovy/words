                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b167b08f-56ac-4dba-9ccd-6171415f7d1d",
                        "source_entry_id": "6995117b-d1d6-38bb-b53c-399cb55727ca",
                        "source_sense_id": "d9bb4ad7-77e8-30a7-b4d5-d13239c91e1a",
                        "target_lang_word": "Entenvogel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entenvogel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ff73044-810b-37d6-acab-6628032b39cb",
                                        "entry_id": "4e996891-8cbb-352d-8309-026cac382f75",
                                        "glosses": [
                                            "Mitglied der Vogelfamilie der Entenvögel oder Anatidae (Anatiden)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42ba8480-3a89-4401-b3e5-480f454ae284",
                                                "sense_id": "0ff73044-810b-37d6-acab-6628032b39cb",
                                                "text": "„Los geht es bei frühen Entensauriern, Dötzi und der Venus von Willendorf, dann folgen Mumien, die Sphinx und eine Caesar-Büste, bis der Besucher schließlich bei \"Zwei Enten in Betrachtung des Mondes\", kubistischen Donald-Duck-Varianten und der Künstlergruppe \"Die blaue Ente\" anlangt. Die Künstlergruppe \"interDuck\" hat das Enten-Paralleluniversum in den 1980er Jahren ins Leben gerufen und entdeckt seitdem immer neue Facetten der Anatiden, wie Entenvögel mit wissenschaftlichem Namen heißen. Die Besucher sollten die Scheu im Umgang mit Kunst verlieren, sagte \"interDuck\"-Geschäftsführerin Anke Doepner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e64b57d-6432-4621-96ba-fcabf2ac6e5d",
                        "source_entry_id": "6995117b-d1d6-38bb-b53c-399cb55727ca",
                        "source_sense_id": "d9bb4ad7-77e8-30a7-b4d5-d13239c91e1a",
                        "target_lang_word": "serretta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b44b293d-3a40-41a5-b835-f32c91d6cf1b",
                        "source_entry_id": "6995117b-d1d6-38bb-b53c-399cb55727ca",
                        "source_sense_id": "d9bb4ad7-77e8-30a7-b4d5-d13239c91e1a",
                        "target_lang_word": "крохаль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "крохаль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "708447e0-8df3-36da-9f74-f13ea4beb7b1",
                                        "entry_id": "a165c88b-4789-3247-8fa5-46e219465849",
                                        "glosses": [
                                            "орнитол. средняя пёстрая водоплавающая птица семейства утиных с длинным цилиндрическим зубчатым клювом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e9425b-632d-47e9-b67e-124d8752f4d2",
                                                "sense_id": "708447e0-8df3-36da-9f74-f13ea4beb7b1",
                                                "text": "У нас почти нечего было есть; но как нарочно во втором часу показалось в близости несколько крохалей (большой род диких уток), из которых одного я застрелил, a другого, не могшего ещё летать, собака поймала."
                                            },
                                            {
                                                "example_id": "f3066c9e-34a7-4cb7-83b9-811711944009",
                                                "sense_id": "708447e0-8df3-36da-9f74-f13ea4beb7b1",
                                                "text": "Крохаль больше дворовой утки; его красные ноги у него не совсем в заду, как у гагары; нос красный с чёрным, тонкий, с зазубринами и на конце загнут крючком. Летает довольно бойко и живёт преимущественно на проточной воде, по речкам и большим озёрам .."
                                            },
                                            {
                                                "example_id": "82d03ce3-1b53-40a9-982f-1437070ea4b4",
                                                "sense_id": "708447e0-8df3-36da-9f74-f13ea4beb7b1",
                                                "text": "Раза два мы вспугивали белых крохалей, с чёрной головой и с красным носом. Птицы эти остаются на зимовку в Уссурийском крае и приобретают белую защитную окраску."
                                            },
                                            {
                                                "example_id": "ea70b75a-d5eb-45b4-8e5a-f5583c4a05d2",
                                                "sense_id": "708447e0-8df3-36da-9f74-f13ea4beb7b1",
                                                "text": ".. я решил возвращаться к большаку. И тут неожиданно увидел на кромке майны спокойно стоящего крохаля. Черноголовый, с длинным узким красным носом, белой грудкой и боками, крохаль ощипывался, охорашивался, время от времени внимательно осматриваясь вокруг."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92eba37c-8078-387b-a2a7-c33950402ab6",
                                        "entry_id": "a165c88b-4789-3247-8fa5-46e219465849",
                                        "glosses": [
                                            "разг. рег. (пинежск.) мн. ч. прозвище жителей деревни Прилук Пинежского района Архангельской области"
                                        ],
                                        "tags": [
                                            "шуточн.",
                                            "колл."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61a2bd02-78b5-4f72-b3e2-4f6962a2819e",
                                                "sense_id": "92eba37c-8078-387b-a2a7-c33950402ab6",
                                                "text": "В Сурском кусте деревень Пинежского района бытовала следующая песня: Сура — галичи (галки), Засурье — заецы (зайцы), В Похурове — кузнецы, А в Прилуке — крохали, Осаново — вороны и т. д."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
