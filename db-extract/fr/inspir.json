                        "glosses": [
                            "Phase d'inspiration (souvent dans le cadre d'exercices de méditation, de concentration ou de détente)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8b15015-d797-4c94-9077-af72def324db",
                                "sense_id": "c9d0bed4-83fe-3939-97cd-6005fdcc72ad",
                                "text": "Être davantage présent à ce souffle qui va et vient en moi, c'est être davantage présent à la Vie qui circule, c'est entrer dans le mouvement de la Vie : recevoir à l'inspir, se donner à l'expir, s'abandonner entre l'expir et l'inspir."
                            },
                            {
                                "example_id": "4c828355-b8c1-4de4-b35f-17ec1bb14af3",
                                "sense_id": "c9d0bed4-83fe-3939-97cd-6005fdcc72ad",
                                "text": "Respirer, c’est un inspir et un expir."
                            },
                            {
                                "example_id": "9902baf0-d6c9-4585-a735-4277c80ce653",
                                "sense_id": "c9d0bed4-83fe-3939-97cd-6005fdcc72ad",
                                "text": "Sur une inspir, les jambes montent à la verticale, le poids du corps se porte sur les épaules."
                            }
                        ]
