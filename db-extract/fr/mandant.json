                    },
                    {
                        "form_id": "2d3e7e42-6656-4921-a38b-466f7af3eeec",
                        "entry_id": "8bb5cfca-451d-33fb-9327-b4a2eceedfa9",
                        "tags": [
                            "feminine"
                        ],
                        "form": "mandante"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "483567ba-007c-3dbf-bad2-e1ff0279fead",
                        "entry_id": "8bb5cfca-451d-33fb-9327-b4a2eceedfa9",
                        "glosses": [
                            "Personne physique ou personne morale qui, par un mandat, donne pouvoir à un autre d’agir en son nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9f8bc02-34b5-4d2f-ac1c-f47fd49a53b8",
                                "sense_id": "483567ba-007c-3dbf-bad2-e1ff0279fead",
                                "text": "Beaucoup de mes interlocuteurs me signalent encore, […], la conception qu’on a du suffrage universel en ces contrées, où l’homme politique doit accepter d’être, dans la métropole, le protecteur, le soutien, le truchement de ses mandants."
                            },
                            {
                                "example_id": "250ae5c5-d277-45dd-8cf4-1ad2609f112e",
                                "sense_id": "483567ba-007c-3dbf-bad2-e1ff0279fead",
                                "text": "En cas de cessation de ses relations avec le mandant, l’agent commercial a droit à une indemnité compensatrice en réparation du préjudice subi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5acd5971-b843-463f-a660-45d96097938c",
                        "source_entry_id": "8bb5cfca-451d-33fb-9327-b4a2eceedfa9",
                        "source_sense_id": "483567ba-007c-3dbf-bad2-e1ff0279fead",
                        "source_sense_description": "Personne qui délègue son pouvoir",
                        "target_lang_word": "Auftraggeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auftraggeber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                        "entry_id": "649105dc-9511-3462-9a48-bee35e6a2be4",
                                        "glosses": [
                                            "Person, Firma oder auch Institution, die einen Auftrag erteilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e7a934f-490f-4210-9b1d-1dc6f1731a9f",
                                                "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                                "text": "„Deshalb haben die vier Fahnder jetzt Klage gegen Gutachter H. eingereicht und auch seinem Auftraggeber, dem Land Hessen, den Streit erklärt.“"
                                            },
                                            {
                                                "example_id": "e917f320-89d2-4faf-8563-3294050049a7",
                                                "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                                "text": "„Nach mehrmaliger Umarbeitung fand das Werk die Zufriedenheit der Auftraggeber …“"
                                            },
                                            {
                                                "example_id": "7d8d4bd8-8fe2-41d7-bded-8785b676d863",
                                                "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                                "text": "„Auftraggeber war der in Paris ausgebildete und zu den führenden Gelehrten der Universität Löwen gehörende Grammatiker und Jurist Antonius Haneron.“"
                                            },
                                            {
                                                "example_id": "d029f9b8-c899-431f-b35a-7b07f1c7d82c",
                                                "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                                "text": "„Vom Gewölbe des Archivs geschützt, hatte er sich auf eine Beschäftigung zurückgezogen, die vermutlich nicht im Sinne seiner Auftraggeber lag, als sie ihm das Amt des Archivars zuerkannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
