    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14c5f90b-e1ca-3266-9cd0-bda2e3abb95b",
                    "sense_definition": "Personal magnetism, confidence, or charm that makes someone successful and appealing to others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "charisma",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long vacation, she finally got her <w>mojo</w> back and finished the project.",
                            "target_lang_translations": {
                                "ru": "После долгого отпуска она наконец вернула свой <w>кураж</w> и закончила проект."
                            }
                        },
                        {
                            "text": "He seems to have lost his <w>mojo</w> lately, struggling to connect with his audience.",
                            "target_lang_translations": {
                                "ru": "Похоже, в последнее время он растерял свое <w>обаяние</w>, с трудом находя контакт с аудиторией."
                            }
                        }
                    ],
                    "common_phrases": [
