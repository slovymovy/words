                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c7297a6f-979a-3e42-84a7-2327a02ebb59",
                        "entry_id": "acc9b333-e2cf-39a5-9fc8-e1bb92d65f65",
                        "glosses": [
                            "uznawanie czegoś za nieistotne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23ee5692-bca8-4e8e-b8cb-652d87579325",
                                "sense_id": "c7297a6f-979a-3e42-84a7-2327a02ebb59",
                                "text": "W regionie Delty Nigru codziennie bez większej reakcji ze strony społeczności międzynarodowej, miejscowych władz i z całkowitym lekceważeniem lokalnej społeczności, wielkie międzynarodowe koncerny naftowe eksploatują zasoby ropy naftowej, powodując wielkie zniszczenia środowiska"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b9be4fb-0c95-4756-8e44-a52d8446dffb",
                        "source_entry_id": "acc9b333-e2cf-39a5-9fc8-e1bb92d65f65",
                        "source_sense_id": "01b011aa-5d45-3b99-891b-fdf487416035",
                        "target_lang_word": "disdain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disdain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "393bc841-b09c-3294-b83e-0b442f28fd26",
                                        "entry_id": "d6de0ead-433c-3881-8ac6-a32f955a897b",
                                        "glosses": [
                                            "To regard (someone or something) with strong contempt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c9558e8-23a3-4d30-8ac8-9c8075635daf",
                                                "sense_id": "393bc841-b09c-3294-b83e-0b442f28fd26",
                                                "text": "When the Philistine […] saw David, he disdained him; for he was but a youth."
                                            },
                                            {
                                                "example_id": "2bc755f8-6787-45dc-b8c1-223d7cdf91f6",
                                                "sense_id": "393bc841-b09c-3294-b83e-0b442f28fd26",
                                                "text": "The Messiah, Jesus the son of Mary, is but the apostle of God and His Word, […] The Messiah doth surely not disdain to be a servant of God, nor do the angels who are nigh to Him; and whosoever disdains His service and is too proud, He will gather them altogether to Himself. But as for those who believe and do what is right, He will pay their hire and will give increase to them of His grace. But as for those who disdain and are too proud, He will punish them with a grievous woe, and they shall not find for them other than God a patron or a help."
                                            },
                                            {
                                                "example_id": "55abe336-28fb-4a43-b5fa-120cdd4c35d3",
                                                "sense_id": "393bc841-b09c-3294-b83e-0b442f28fd26",
                                                "text": "The country’s first black president, and its first president to reach adulthood after the Vietnam War and Watergate, Mr. Obama seemed like a digital-age leader who could at last dislodge the stalemate between those who clung to the government of the Great Society, on the one hand, and those who disdained the very idea of government, on the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57a84874-d89b-35f6-8d67-a3306b7ab8be",
                                        "entry_id": "d6de0ead-433c-3881-8ac6-a32f955a897b",
                                        "glosses": [
                                            "To be indignant or offended."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9512553d-4af7-4065-8a2e-6c07f931c9d9",
                                                "sense_id": "57a84874-d89b-35f6-8d67-a3306b7ab8be",
                                                "text": "When the chefe prestes and scribes sawe, the marveylles that he dyd [...], they desdayned, and sayde unto hym: hearest thou what these saye?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disdain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a080545-27bb-36ab-a5b8-b5c3f23b815a",
                                        "entry_id": "af5ad3c9-32dd-3af6-814d-b3c071aeed01",
                                        "glosses": [
                                            "A feeling of contempt or scorn."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9138aba2-df36-495c-9881-00d119efa579",
                                                "sense_id": "9a080545-27bb-36ab-a5b8-b5c3f23b815a",
                                                "text": "The cat viewed the cheap supermarket catfood with disdain and stalked away."
                                            },
                                            {
                                                "example_id": "6d14acb4-a119-4a06-8c32-b5df6e0800b1",
                                                "sense_id": "9a080545-27bb-36ab-a5b8-b5c3f23b815a",
                                                "text": "He that with ſhepheards and a litle ſpoyle,\nDurſt in diſdaine of wrong and tyrannie,\nDefend his freedome gainſt a Monarchie:\nWhat will he doe ſupported by a king?"
                                            },
                                            {
                                                "example_id": "7323c2fc-94dc-4826-89fd-195e089cd00d",
                                                "sense_id": "9a080545-27bb-36ab-a5b8-b5c3f23b815a",
                                                "text": "Disdain and scorn ride sparkling in her eyes."
                                            },
                                            {
                                                "example_id": "b1d2f414-6c47-4810-8cb2-894e34d3e9f3",
                                                "sense_id": "9a080545-27bb-36ab-a5b8-b5c3f23b815a",
                                                "text": "Everything that could go right for England did although they never felt lucky and they chuckled at Kane’s third that ricocheted off his heel while he was looking the other way. Somewhere in the Moscow outskirts one could only guess at the grand disdain Cristiano Ronaldo will have felt at being supplanted as the tournament’s top scorer in that manner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b11ae4f-0e18-3b3a-97ca-5ca84195b299",
                                        "entry_id": "af5ad3c9-32dd-3af6-814d-b3c071aeed01",
                                        "glosses": [
                                            "That which is worthy to be disdained or regarded with contempt and aversion."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86896d7e-95d7-4b58-b512-ae17133dba01",
                                                "sense_id": "8b11ae4f-0e18-3b3a-97ca-5ca84195b299",
                                                "text": "Most loathsom, filthy, foul, and full of vile Disdain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3416f395-0f60-3ee9-a45e-da7d2e4d4438",
                                        "entry_id": "af5ad3c9-32dd-3af6-814d-b3c071aeed01",
                                        "glosses": [
                                            "The state of being despised; shame."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ab3430f-a488-4f0b-9798-c770fabce71f",
                                                "sense_id": "3416f395-0f60-3ee9-a45e-da7d2e4d4438",
                                                "text": "The leaves and fruit maintain'd with beauty's sun ; Exempt from envy , but not from disdain"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d13953fe-4f98-4e4f-982a-af67a6fe7815",
                        "source_entry_id": "acc9b333-e2cf-39a5-9fc8-e1bb92d65f65",
                        "source_sense_id": "01b011aa-5d45-3b99-891b-fdf487416035",
                        "target_lang_word": "contempt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contempt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e29a46b0-f808-3bb0-88fb-7c93c9ae464d",
                                        "entry_id": "14cadef7-ac65-3dda-be41-9a9371d94f1d",
                                        "glosses": [
                                            "The state or act of contemning; the feeling or attitude of regarding someone or something as inferior, base, or worthless; scorn, disdain."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508c7113-2a50-47af-84d9-24237ef1585a",
                                                "sense_id": "e29a46b0-f808-3bb0-88fb-7c93c9ae464d",
                                                "text": "And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes. He said that if you wanted to do anything for them, you must rule them, not pamper them."
                                            },
                                            {
                                                "example_id": "674737d0-5f75-4ffc-ad09-2448db4917b7",
                                                "sense_id": "e29a46b0-f808-3bb0-88fb-7c93c9ae464d",
                                                "text": "Transport Minister Marples, meanwhile, used arrogant rhetoric and showed his personal contempt for railways when confirming in Parliament that a third of the network was to be closed even before the survey results were known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cfe7a73-2c05-3eb9-a648-ae875f94dadb",
                                        "entry_id": "14cadef7-ac65-3dda-be41-9a9371d94f1d",
                                        "glosses": [
                                            "The state of being despised or dishonored; disgrace."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "896cd3bb-a3f6-33c5-82af-51ac821c1c0e",
                                        "entry_id": "14cadef7-ac65-3dda-be41-9a9371d94f1d",
                                        "glosses": [
                                            "Open disrespect or willful disobedience of the authority of a court of law or legislative body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3711ef46-e0c9-40fe-800a-a27ae8c7ec47",
                                                "sense_id": "896cd3bb-a3f6-33c5-82af-51ac821c1c0e",
                                                "text": "The panel voted unanimously on Tuesday to recommend charging Mr. [Stephen K.] Bannon with criminal contempt of Congress for defying its subpoena, sending the issue to the House."
                                            },
                                            {
                                                "example_id": "5e01cf06-27c9-41fe-8456-9aa0b1297006",
                                                "sense_id": "896cd3bb-a3f6-33c5-82af-51ac821c1c0e",
                                                "text": "Justice Merchan has yet to issue a ruling on whether to find Mr. Trump in contempt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c713316-f579-3e52-b97f-7fa263b932bd",
                                        "entry_id": "14cadef7-ac65-3dda-be41-9a9371d94f1d",
                                        "glosses": [
                                            "Ellipsis of contempt factor."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
