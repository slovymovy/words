                ],
                "translations": [
                    {
                        "translation_id": "ee6d9ad7-fa6f-47da-807d-18e4525f4e00",
                        "source_entry_id": "0561dfb9-1747-3671-bffe-b6e69efc2927",
                        "source_sense_id": "84828dd3-eada-35af-a7e6-d12e15ce7f74",
