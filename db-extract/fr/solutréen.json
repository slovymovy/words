                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11ce25ec-c555-384d-825d-6ba81495e317",
                                        "entry_id": "c5c75416-22cb-3aff-9172-d0b86a5e6eb3",
                                        "glosses": [
                                            "Of or pertaining to the Solutrean material culture or the Solutrean hypothesis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd783762-5a74-4ad2-a50a-b414a84c1df4",
                                                "sense_id": "11ce25ec-c555-384d-825d-6ba81495e317",
                                                "text": "Childbirth was only suggested by these features in the Solutrean culture, but now all is made definite and explicit as she is shown seated upon the leopard throne with the divine child emerging between her legs."
                                            },
                                            {
                                                "example_id": "f00ba408-6dde-4cf2-bce9-8b5265519716",
                                                "sense_id": "11ce25ec-c555-384d-825d-6ba81495e317",
                                                "text": "Solutrean points resemble the canines of the sabre-toothed cats."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Solutrean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a84bfa3e-5ae9-3d51-af35-eb39c229634c",
                                        "entry_id": "573e4206-5dcc-310e-8232-881d285bb81b",
                                        "glosses": [
                                            "A member of a hypothetical Paleolithic people who migrated from Europe to North America in the context of the widely rejected Solutrean hypothesis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6967812f-049b-4e38-92be-99aa587e42f2",
                                                "sense_id": "a84bfa3e-5ae9-3d51-af35-eb39c229634c",
                                                "text": "2018 Historically Speaking: The Solutrean Migration\nIt was deemed the explorers would have originated in Spain, France and Portugal. They must have traveled along the ice sheets in animal-skin boats, simlar to those of the the Inuits. These tribes, called Solutreans, settled in at least five separate regions surrounding Chesapeake Bay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
