                ],
                "senses": [
                    {
                        "sense_id": "0bdbb8a2-953e-372c-bb42-478205baca99",
                        "entry_id": "9e26d79c-d130-3738-be64-7a05bf9091e8",
                        "glosses": [
                            "im Bereich der ordentlichen Gerichtsbarkeit der oberste Gerichtshof in der Bundesrepublik Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37ef7dca-3a4d-4c76-be19-0ef085c3a665",
                                "sense_id": "0bdbb8a2-953e-372c-bb42-478205baca99",
                                "text": "Die Verdächtigen sollen einem Haftrichter beim Bundesgerichtshof vorgeführt werden."
                            },
                            {
                                "example_id": "4ec5128c-9e4b-462f-b353-dd15c2606da5",
                                "sense_id": "0bdbb8a2-953e-372c-bb42-478205baca99",
                                "text": "„Der Bundesgerichtshof in Karlsruhe (BGH) hat jetzt klargestellt, dass Vermieter die Wohnung bereits kündigen können, wenn mehr als eine Monatsmiete auf dem Konto fehlt – allerdings per fristgerechter Kündigung; dabei müssen die gesetzlichen oder die vereinbarten Fristen beachtet werden.“"
                            },
                            {
                                "example_id": "4ff19255-5b49-4c3c-a69f-704c8e4c1d26",
                                "sense_id": "0bdbb8a2-953e-372c-bb42-478205baca99",
                                "text": "„Das Gericht orientiert sich an einer Entscheidung des Bundesgerichtshofes, danach kommt gleich nach dem Willen Gottes der Wille des Verstorbenen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
