                "senses": [
                    {
                        "sense_id": "32304f34-4296-3e25-a416-b1c5cbf22397",
                        "entry_id": "b56a90ea-b560-3296-bc75-24c8585df2c1",
                        "glosses": [
                            "Commune française du département de l’Aisne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bac4358c-fb3b-4f2c-8364-ce8037e3546a",
                                "sense_id": "32304f34-4296-3e25-a416-b1c5cbf22397",
                                "text": "A Faucoucourt, continuer vers Anizy-le-Château ou tourner à droite et se rendre à Prémontré par Suzy. Après ce village, vers le sommet de la côte, observer le calcaire dolomitique à « têtes de chats » du Lutétien inférieur."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
