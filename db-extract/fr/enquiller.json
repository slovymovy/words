                ],
                "senses": [
                    {
                        "sense_id": "f0398b4d-1c82-3423-9214-234da4bdf96a",
                        "entry_id": "4d7c9eb7-ca3f-39dc-9e2c-f6b68a284d6f",
                        "glosses": [
                            "Introduire, enfiler, mettre."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "da035a87-66d7-45e0-87d9-8e9a5e88d203",
                                "sense_id": "f0398b4d-1c82-3423-9214-234da4bdf96a",
                                "text": "Pas moyen d’enquiller la tige métallique, elle va finir par se casser !"
                            },
                            {
                                "example_id": "3cd964cc-8591-4ecb-9ec7-860776f4eda2",
                                "sense_id": "f0398b4d-1c82-3423-9214-234da4bdf96a",
                                "text": "Moi, je préférerais que tu enquilles la disquette au lieu de te tirer avec..."
                            }
                        ]
                    },
                    {
                        "sense_id": "2be6d49b-c6f6-35f4-989d-229a53f00104",
                        "entry_id": "4d7c9eb7-ca3f-39dc-9e2c-f6b68a284d6f",
                        "glosses": [
                            "Entrer dans (une voie, un couloir ...)."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f6a53156-9448-4085-9de1-0962af151d6f",
                                "sense_id": "2be6d49b-c6f6-35f4-989d-229a53f00104",
                                "text": "Voyant le chasseur enquiller dans la taule, Dick remarqua :\n- On est annoncés!"
                            },
                            {
                                "example_id": "307711f4-af6e-42c0-aac2-0dc0d17bdda2",
                                "sense_id": "2be6d49b-c6f6-35f4-989d-229a53f00104",
                                "text": "Réal et lui enquillèrent les marches qui conduisaient aux entrailles de l'immeuble."
                            }
                        ]
                    },
                    {
                        "sense_id": "836a3bbc-aa09-3da2-a136-f5b03ebc357e",
                        "entry_id": "4d7c9eb7-ca3f-39dc-9e2c-f6b68a284d6f",
                        "glosses": [
                            "Faire sans attendre ; enchaîner."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "83ed5d6f-86fc-4cf2-bffc-a3d050664653",
                                "sense_id": "836a3bbc-aa09-3da2-a136-f5b03ebc357e",
                                "text": "Quatre à quatre, j’ai enquillé les marches."
                            },
                            {
                                "example_id": "7e3d0857-8f5d-402a-95be-5d250c6153b3",
                                "sense_id": "836a3bbc-aa09-3da2-a136-f5b03ebc357e",
                                "text": "Elle doit se faire chier à lui toaster les tartines de son petit-déjeuner avant même que le réveil ne sonne, puis à enquiller sur le ménage, bien astiquer les carreaux de la douche, vider toutes les poubelles, passer l'aspirateur […]."
                            },
                            {
                                "example_id": "5906ac32-8e18-43be-b002-420c4137dc3d",
                                "sense_id": "836a3bbc-aa09-3da2-a136-f5b03ebc357e",
                                "text": "Car, après avoir enquillé les mandats de maire, de député, de ministre et de président, il a eu une révélation : la démocratie, c’est dépassé."
                            }
                        ]
                    },
                    {
                        "sense_id": "e87f37c4-3de2-3be0-933b-309cf01d6c90",
                        "entry_id": "4d7c9eb7-ca3f-39dc-9e2c-f6b68a284d6f",
                        "glosses": [
                            "Entrer ; s’introduire."
                        ],
                        "tags": [
                            "familiar",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "dcce5c38-20e9-4eaa-855d-ba843ae603ea",
                                "sense_id": "e87f37c4-3de2-3be0-933b-309cf01d6c90",
                                "text": "Il s’est enquillé précipitamment dans la rue Alézard mais les flics l’avaient déjà repéré."
                            }
                        ]
                    },
                    {
                        "sense_id": "89af2fc4-e9b5-32ee-a91f-5813da692208",
                        "entry_id": "4d7c9eb7-ca3f-39dc-9e2c-f6b68a284d6f",
                        "glosses": [
                            "Supporter."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "032db74c-8fa6-4192-aa03-9ba7045d5fc8",
                                "sense_id": "89af2fc4-e9b5-32ee-a91f-5813da692208",
                                "text": "Heureusement qu'on a les points de vue de Cole et Helen pour voir un peu moins celui de Noah parce que je peux pas l’enquiller. — (https://www.madmoizelle.com/the-affair-saison-2-critique-481679)"
                            }
                        ]
                    }
