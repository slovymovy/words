                    {
                        "translation_id": "dcccc632-9808-4c9c-a718-7486092eb494",
                        "source_entry_id": "e17b8801-98d1-3176-8a9c-387d3551dfe0",
                        "source_sense_description": "a woman who lives with a man, but who is not a wife",
                        "target_lang_word": "concubine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concubine",
