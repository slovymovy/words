                    {
                        "sense_id": "f238cf82-fa20-3e4c-b55f-3158d7c90fa7",
                        "entry_id": "acd76e34-d3de-37c3-9481-de2342432c50",
                        "glosses": [
                            "wyrażanie dezaprobaty względem osoby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dcb0016-6300-4fa3-bc77-d5371ff23fe4",
                                "sense_id": "f238cf82-fa20-3e4c-b55f-3158d7c90fa7",
                                "text": "Dla odstępcy od drogi surowa jest kara, / kto karcenia nie znosi, ten umrze"
                            },
                            {
                                "example_id": "faf51c42-380b-463f-9b39-9cff3c3796ab",
                                "sense_id": "f238cf82-fa20-3e4c-b55f-3158d7c90fa7",
                                "text": "Wykład dotyczył regulacji prawnych związanych z karceniem małoletnich w prawie polskim."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
