    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "18c1f71d-6135-3063-a6ac-7a2bf9736a15",
                "word": "hoopla",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "11b5eb80-3779-45eb-979f-bcb61c7b3a2b",
                        "entry_id": "18c1f71d-6135-3063-a6ac-7a2bf9736a15",
                        "tags": [
                            "plural"
                        ],
                        "form": "hooplas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3cb8a621-4ae8-3a83-86fa-801dac3625ad",
                        "entry_id": "18c1f71d-6135-3063-a6ac-7a2bf9736a15",
                        "glosses": [
                            "A bustling to-do, excited speech or noise."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2a768c9d-4dcc-40ea-9bb7-85ffc8006928",
                                "sense_id": "3cb8a621-4ae8-3a83-86fa-801dac3625ad",
                                "text": "Say you don't know me, or recognize my face / Say you don't care who goes to that kind of place / Knee deep in the hoopla, sinking in your fight / Too many runaways eating up the night"
                            },
                            {
                                "example_id": "bc137671-9d0b-4be8-ac00-7ae115955dd3",
                                "sense_id": "3cb8a621-4ae8-3a83-86fa-801dac3625ad",
                                "text": "Campers enjoyed all of the traditional camp hoopla: color wars, shared team games with other camps and young eager college students spending their summer as counselors."
                            },
                            {
                                "example_id": "d07fd3a0-5bff-41a4-b7fd-93bb245b4d63",
                                "sense_id": "3cb8a621-4ae8-3a83-86fa-801dac3625ad",
                                "text": "Some astronomers dislike the whole supermoon hoopla. They point out that the term originated with astrology, not astronomy; that perigee full moons are not all that rare, coming an average of every 13 months; and that their apparently swollen dimensions are often as much a matter of optical illusion and wishful blinking as of relative lunar nearness."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0fed00d-18d2-3225-91fa-08a5cfcd22a1",
                        "entry_id": "18c1f71d-6135-3063-a6ac-7a2bf9736a15",
                        "glosses": [
                            "A carnival game in which the player attempts to throw hoops around pegs."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ac1eddc-4a64-4e7e-8223-616cfe91ea7c",
                        "source_entry_id": "18c1f71d-6135-3063-a6ac-7a2bf9736a15",
                        "source_sense_description": "clamour, brouhaha",
                        "target_lang_word": "Bohei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bohei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57c08386-cab3-3d3e-89a3-65899e13ed05",
                                        "entry_id": "f8943f78-82ac-3192-a967-6c4b4b896a07",
                                        "glosses": [
                                            "unverhältnismäßig großes, unnötiges Aufsehen, das jemand oder etwas erfährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec8ea43d-8bfc-4f41-b3c0-50b7dfa0a683",
                                                "sense_id": "57c08386-cab3-3d3e-89a3-65899e13ed05",
                                                "text": "„Das Bohei um den McLaren-Piloten droht an diesem Wochenende auszuufern, wenn Hamilton beim Grand Prix von England in Silverstone aufs Gaspedal tritt, nur eine Autostunde entfernt von seinem Geburtsort Hertfordshire.“"
                                            },
                                            {
                                                "example_id": "44f564e1-764f-4f5b-a7fe-0e80068cea25",
                                                "sense_id": "57c08386-cab3-3d3e-89a3-65899e13ed05",
                                                "text": "„Insgesamt ist aber der Bohei um den weißen Trüffel ein ziemlicher Lifestyle-Wahnsinn.“"
                                            },
                                            {
                                                "example_id": "98a589b8-89dc-4ded-aa5c-0bd3cb27f428",
                                                "sense_id": "57c08386-cab3-3d3e-89a3-65899e13ed05",
                                                "text": "„Erinnern Sie sich noch an den Bohei um die Akten des Staatssicherheitsdienstes? Öffnen oder nicht? Dabei waren das meist noch handschriftliche Unterlagen.“"
                                            },
                                            {
                                                "example_id": "35ef2a88-f00d-4f23-abd6-628871c81b3f",
                                                "sense_id": "57c08386-cab3-3d3e-89a3-65899e13ed05",
                                                "text": "„Es wurde viel Bohei um die Einführung des erzählenden Ichs im Journalismus gemacht, denn dieses Ich steht bei uns für Subjektivismus, also für den Todfeind der objektiven Berichterstattung schlechthin, aber ich glaube, darum ging es Hunter S. Thompson überhaupt nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e0712f2-81c3-40e5-9551-50867f3801fa",
                        "source_entry_id": "18c1f71d-6135-3063-a6ac-7a2bf9736a15",
                        "source_sense_description": "clamour, brouhaha",
                        "target_lang_word": "Gedöns",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gedöns",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93e8dcad-a07b-371c-9863-e4dd470e0e40",
                                        "entry_id": "4cf5a41d-f11c-3abc-ae99-56147d050adc",
                                        "glosses": [
                                            "unnötiger Aufwand, übertriebenes Getue"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f6fdd2b-2046-45cc-8064-442d4dbe354c",
                                                "sense_id": "93e8dcad-a07b-371c-9863-e4dd470e0e40",
                                                "text": "Mach doch nicht so’n Gedöns! (= Mach nicht soviel Aufhebens um etwas!)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1737d97b-9a6d-3939-a045-2126f051afc9",
                                        "entry_id": "4cf5a41d-f11c-3abc-ae99-56147d050adc",
                                        "glosses": [
                                            "unnötige Gegenstände, Kram"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90a00cfa-5b63-4202-aaab-1d7a54817b43",
                                                "sense_id": "1737d97b-9a6d-3939-a045-2126f051afc9",
                                                "text": "Räum jetzt erst mal das ganze Gedöns hier weg!"
                                            },
                                            {
                                                "example_id": "a574ab1a-b63e-4f60-8a30-d11073476aec",
                                                "sense_id": "1737d97b-9a6d-3939-a045-2126f051afc9",
                                                "text": "„Auf dem Dachboden stand bald noch mehr Plunder und Gedöns rum als im Keller.“"
                                            },
                                            {
                                                "example_id": "a6ca0919-1c51-4699-879a-4597dca8f7f8",
                                                "sense_id": "1737d97b-9a6d-3939-a045-2126f051afc9",
                                                "text": "Nurjan, die jüngere Tochter, erinnert sich genau, wie es war, wenn die Familie, das Auto voll bepackt, wieder nach Deutschland zurückkam. „Anstatt dass wir irgendetwas gekauft haben, haben unsere Eltern Paprika und Auberginen und das ganze Gedöns gebracht. Weil es besser geschmeckt hat, weil es sie in Deutschland nicht gab, weil es Teil der Kultur war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "181e10a7-baf5-443f-b347-ad10943be61b",
                        "source_entry_id": "18c1f71d-6135-3063-a6ac-7a2bf9736a15",
                        "source_sense_description": "clamour, brouhaha",
                        "target_lang_word": "Rummel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rummel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "421d1225-d085-3d49-a143-54dd94d255cd",
                                        "entry_id": "3ed3233f-748c-31b7-9fe0-136181039dbe",
                                        "glosses": [
                                            "lärmende Geschäftigkeit; viel Aufhebens"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d80551d7-d711-4640-b2e2-d84be2e492e3",
                                                "sense_id": "421d1225-d085-3d49-a143-54dd94d255cd",
                                                "text": "An meinem Urlaubsort herrschte jeden Abend ein wilder Rummel."
                                            },
                                            {
                                                "example_id": "90a200f8-6336-4d80-8822-2bd71cfba928",
                                                "sense_id": "421d1225-d085-3d49-a143-54dd94d255cd",
                                                "text": "Der Rummel des Festes legte sich erst in den Morgenstunden."
                                            },
                                            {
                                                "example_id": "59b35e60-5682-4974-a8d9-8c80644c01a7",
                                                "sense_id": "421d1225-d085-3d49-a143-54dd94d255cd",
                                                "text": "In der Affäre wollte die Partei keinen Rummel provozieren."
                                            },
                                            {
                                                "example_id": "d975cc94-e620-49f4-9a8c-b2472b309326",
                                                "sense_id": "421d1225-d085-3d49-a143-54dd94d255cd",
                                                "text": "Macht nicht solch einen Rummel!"
                                            },
                                            {
                                                "example_id": "459c937c-aea4-4a7a-b3a6-9063948682b2",
                                                "sense_id": "421d1225-d085-3d49-a143-54dd94d255cd",
                                                "text": "Diesen Rummel mache ich nicht mit!"
                                            },
                                            {
                                                "example_id": "f0d9618f-7b56-4f28-b4e0-9ab44fa4bd93",
                                                "sense_id": "421d1225-d085-3d49-a143-54dd94d255cd",
                                                "text": "Was hast du nur wieder für einen Rummel veranstaltet?!"
                                            },
                                            {
                                                "example_id": "1c4b2627-40fd-437c-818b-b0b9354ba6ec",
                                                "sense_id": "421d1225-d085-3d49-a143-54dd94d255cd",
                                                "text": "Das Revolverblatt inszenierte reißerisch einen Rummel um diese Bagatellen."
                                            },
                                            {
                                                "example_id": "f9a6a4bd-c4d7-41df-b76b-8a59bd7c7e33",
                                                "sense_id": "421d1225-d085-3d49-a143-54dd94d255cd",
                                                "text": "Nach den durchgearbeiteten Tagen war nun endlich der Rummel vorbei."
                                            },
                                            {
                                                "example_id": "8ad5bfc3-c1b6-44fc-8fe5-4a134848a9b7",
                                                "sense_id": "421d1225-d085-3d49-a143-54dd94d255cd",
                                                "text": "„Freerider und Tourengeher suchen auf unberührten Pisten die große Freiheit in den Bergen, das Glücksgefühl im Pulverschnee abseits des Rummels der Skigebiete.“"
                                            },
                                            {
                                                "example_id": "f0710669-0e16-4cfe-8a25-cb9ddc9a057e",
                                                "sense_id": "421d1225-d085-3d49-a143-54dd94d255cd",
                                                "text": "„Er will vom Rummel um seine Person nichts mehr wissen, die Frau stirbt, er sitzt wieder auf dem Kutschbock, bei jedem Wetter, ein Relikt aus vergangener Zeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2504eab8-fbef-37ad-9b25-c502fadae7f2",
                                        "entry_id": "3ed3233f-748c-31b7-9fe0-136181039dbe",
                                        "glosses": [
                                            "Jahrmarkt"
                                        ],
                                        "tags": [
                                            "North German",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86728ced-a22c-4f8c-add3-f9a003ab3889",
                                                "sense_id": "2504eab8-fbef-37ad-9b25-c502fadae7f2",
                                                "text": "Jeden Herbst gibt es hier einen Rummel."
                                            },
                                            {
                                                "example_id": "ea36e411-d627-47f6-9632-478a7c8c749c",
                                                "sense_id": "2504eab8-fbef-37ad-9b25-c502fadae7f2",
                                                "text": "Für das kommende Wochenende wurde ein Rummel mit Karussells und Schießbuden aufgebaut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "510003aa-efcf-37e5-8364-af58cf60d7d8",
                                        "entry_id": "3ed3233f-748c-31b7-9fe0-136181039dbe",
                                        "glosses": [
                                            "Platz, auf dem [2] stattfindet"
                                        ],
                                        "tags": [
                                            "North German",
                                            "especially",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d03bbc79-6394-4bfa-bf89-b47618692531",
                                                "sense_id": "510003aa-efcf-37e5-8364-af58cf60d7d8",
                                                "text": "Lass uns doch heute mit den Kindern auf den Rummel gehen!"
                                            },
                                            {
                                                "example_id": "14e9c73e-7f0e-4323-b5e7-08ba62ab41c6",
                                                "sense_id": "510003aa-efcf-37e5-8364-af58cf60d7d8",
                                                "text": "„Man zahlte Eintritt und stand auf einem riesigen Rummel und durfte alles fahren und ausprobieren, was man wollte und wie oft man wollte.“"
                                            },
                                            {
                                                "example_id": "ba3b7975-f3b7-44de-861c-eacacdc52bff",
                                                "sense_id": "510003aa-efcf-37e5-8364-af58cf60d7d8",
                                                "text": "„Der Rummel war wie jedes Jahr überfüllt und ich versuchte mir einen Weg durch die dichte Menschenmasse zu bahnen.“"
                                            },
                                            {
                                                "example_id": "fe74149b-d6d5-44f6-b20b-4f985675ab5b",
                                                "sense_id": "510003aa-efcf-37e5-8364-af58cf60d7d8",
                                                "text": "„Aufgespannt kann ein Parapluie zur tödlichen Waffe werden, was in der alkoholisiert hysterischen Atmosphäre eines derartigen Rummels nicht selten zur Realität wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22207a2e-a75b-422e-8722-b962135e85dc",
                        "source_entry_id": "18c1f71d-6135-3063-a6ac-7a2bf9736a15",
                        "source_sense_description": "clamour, brouhaha",
                        "target_lang_word": "кутерьма́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кутерьма́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "59efccee-0f4e-39c9-9d9a-297f470cc484",
                                        "entry_id": "9a13f11e-0728-3217-a1c8-6bc396e50296",
                                        "glosses": [
                                            "разг. суматоха, беспорядочные действия или движения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "236f314f-a6f3-4ae8-ab6b-6ead46ebe680",
                                                "sense_id": "59efccee-0f4e-39c9-9d9a-297f470cc484",
                                                "text": "В бюро нашем кутерьма: потерялась шифрованная депеша о забастовке на патронном заводе, беда, просто беда, ищем, ищем, головы потеряли."
                                            },
                                            {
                                                "example_id": "ad69fc0c-6969-4e98-a373-61b5966ffda4",
                                                "sense_id": "59efccee-0f4e-39c9-9d9a-297f470cc484",
                                                "text": "А кутерьма снежинок за окном становилась все сумбурней."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6df27e44-7a97-4e90-9d89-2d6a1cc964fb",
                        "source_entry_id": "18c1f71d-6135-3063-a6ac-7a2bf9736a15",
                        "source_sense_description": "clamour, brouhaha",
                        "target_lang_word": "шуми́ха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шуми́ха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bc979e3c-aef7-3a16-bf09-31ad2e896f7f",
                                        "entry_id": "0ce0a1e8-b462-35ab-a21c-3252d5709ce5",
                                        "glosses": [
                                            "разг., неодобр. оживлённые толки, разговоры по поводу чего-либо, шум"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "526e9333-a0e8-41f5-987c-3aaa9ffe43ea",
                                                "sense_id": "bc979e3c-aef7-3a16-bf09-31ad2e896f7f",
                                                "text": "В голове Алексея Алексеевича мелькали теперь мысли о том, что \"вот они, старые теоретики-то, фразеры, носящиеся в облаках и не знающие фактов, вечно ораторствуют, вечно стараются подвести все под какую-нибудь систему и любуются шумихой своих собственных фраз."
                                            },
                                            {
                                                "example_id": "7fa721fb-c1d6-4d30-8721-4fafaccf8b55",
                                                "sense_id": "bc979e3c-aef7-3a16-bf09-31ad2e896f7f",
                                                "text": "Несмотря на ранний утренний час, в великолепной спальне четырнадцатилетнего императора Петра II царила не тишина, а, наоборот, большая «шумиха»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29a7a21a-67d8-3210-8388-ca10838c500d",
                                        "entry_id": "0ce0a1e8-b462-35ab-a21c-3252d5709ce5",
                                        "glosses": [
                                            "устар. мишура, разбитая в тонкие листочки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5370d50-8b97-4849-a848-3cd8be4970bc",
                                                "sense_id": "29a7a21a-67d8-3210-8388-ca10838c500d",
                                                "text": "Дом его, построенный из гнилушек, казался великолепным, ибо украшен был — шумихою и фальшивыми бриллиянтами…"
                                            },
                                            {
                                                "example_id": "42985674-852d-4b11-9d44-3756a9b29ade",
                                                "sense_id": "29a7a21a-67d8-3210-8388-ca10838c500d",
                                                "text": "Так пусть фортуны чада, // Возлегши на цветах, // Среди обилий сада, // Курений в облаках, // Наместо чиста злата, // Шумихи любят блеск; // Пусть лира тарова̀та // Их умножа̀ет плеск…"
                                            },
                                            {
                                                "example_id": "ff2f43d5-8737-46ee-b4a5-c68dffc21623",
                                                "sense_id": "29a7a21a-67d8-3210-8388-ca10838c500d",
                                                "text": "С шумом и треском взрывалась митральезы, шутихи и шумихи, повешенные на пальто неизвестного."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26d3e87f-d980-42a5-a98e-b5403613a63a",
                        "source_entry_id": "18c1f71d-6135-3063-a6ac-7a2bf9736a15",
                        "source_sense_description": "clamour, brouhaha",
                        "target_lang_word": "ажиота́ж",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ажиота́ж",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9591c20f-324e-335a-a833-0d2cb6e07fa8",
                                        "entry_id": "1a6c78e5-dc77-3fd4-bd3b-407fa2f0fad2",
                                        "glosses": [
                                            "фин. спекулятивная горячка на биржах и рынках; повышенный спрос на что-либо, вызванный какими-либо событиями или слухами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83db3ce1-07ea-483e-a65c-c517a91099e1",
                                                "sense_id": "9591c20f-324e-335a-a833-0d2cb6e07fa8",
                                                "text": "Причина столь неожиданного для потребителя факта — нехватка муки высшего сорта, ажиотаж последовал вслед за ощутимым дефицитом продовольственной пшеницы."
                                            },
                                            {
                                                "example_id": "80ea9426-7c69-411d-bfe8-5ee780b731c7",
                                                "sense_id": "9591c20f-324e-335a-a833-0d2cb6e07fa8",
                                                "text": "Последние новости из Ирака вызвали сильный ажиотаж среди нефтяных брокеров."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "def5ef14-582b-389e-90f1-d3180ee15b9c",
                                        "entry_id": "1a6c78e5-dc77-3fd4-bd3b-407fa2f0fad2",
                                        "glosses": [
                                            "перен. сильное возбуждение, борьба интересов вокруг какого-либо дела, вопроса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e05c9c01-939b-4a85-ad61-e570e5033e47",
                                                "sense_id": "def5ef14-582b-389e-90f1-d3180ee15b9c",
                                                "text": "Считается, что она позволит ликвидировать нездоровый ажиотаж автозаводов вокруг гособоронзаказа, когда победителем в итоге выходит тот, у кого лобби сильней."
                                            },
                                            {
                                                "example_id": "20881b54-4dd1-4ec5-bc7a-e4c513f6c8ff",
                                                "sense_id": "def5ef14-582b-389e-90f1-d3180ee15b9c",
                                                "text": "Первый автомат был построен Торресом еще в 1911 г. и показан в Париже три года спустя, вызвав небывалый ажиотаж у публики."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
