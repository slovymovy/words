                "senses": [
                    {
                        "sense_id": "77a347ab-83a2-3f33-8286-a30e929fe87e",
                        "entry_id": "9fa37520-1367-3539-8121-0f0d5f2886d9",
                        "glosses": [
                            "het omschrijven van een begrip door de ontkenning van iets met de tegengestelde betekenis, veelal met het doel juist een sterke bevestiging uit te drukken"
                        ],
                        "tags": [
                            "stijlfiguur"
                        ],
                        "examples": [
                            {
                                "example_id": "c3a53a6b-d52a-4aa9-8449-1ea1997e6767",
                                "sense_id": "77a347ab-83a2-3f33-8286-a30e929fe87e",
                                "text": "De litotes wordt vaak aangewend met ironische bedoeling."
                            },
                            {
                                "example_id": "ae0bfe0c-4b16-4a52-8fcf-d71b260ab4b0",
                                "sense_id": "77a347ab-83a2-3f33-8286-a30e929fe87e",
                                "text": "'Het gaat niet slecht, hè?' is een litotes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b997fe82-779f-4c49-8b8e-d32d7b06cfa1",
