                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b94ac3c-f4ae-46c3-8f12-7e80e3a49b72",
                        "source_entry_id": "9d997f1d-cdad-37cb-ab57-7921a268e9cf",
                        "source_sense_id": "81a86f56-3178-3cd7-9171-f364115afbf7",
                        "source_sense_description": "Ensemble des moyens et méthodes de transport, de manutention ou de ravitaillement",
                        "target_lang_word": "Logistik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Logistik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02b741b7-1822-37b1-82a1-b22fb0644737",
                                        "entry_id": "2423e70a-73aa-37f7-a7f4-fe6056b757ed",
                                        "glosses": [
                                            "integrierte Planung, Organisation, Steuerung, Abwicklung und Kontrolle des Waren- und des zugehörigen Informationsflusses im industriellen Fertigungsprozess vom Lieferanten über die eigene Fertigung bis zur Auslieferung an den Kunden, ja häufig bis zur Entsorgung der produzierten Produkte"
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ece00ab-143a-4ec2-9fe6-4284541d6fd0",
                                                "sense_id": "02b741b7-1822-37b1-82a1-b22fb0644737",
                                                "text": "Im Bereich Logistik müssen wir viele Prozesse neu gestalten."
                                            },
                                            {
                                                "example_id": "facc0cba-0439-431f-a5f5-77dacd0ac2d9",
                                                "sense_id": "02b741b7-1822-37b1-82a1-b22fb0644737",
                                                "text": "Die Logistik umfasst die gesamte Infrastruktur und alle Aktivitäten zur physischen Raum- und Zeitüberbrückung von Gütern und Personen im Fertigungsprozess."
                                            },
                                            {
                                                "example_id": "dd58784f-9b63-4e3e-b523-99e4df6321b4",
                                                "sense_id": "02b741b7-1822-37b1-82a1-b22fb0644737",
                                                "text": "„Zu den Druckkosten kämen weitere Kosten in wohl dreistelliger Millionenhöhe für die Logistik des Umtausches hinzu: Die alten 500-Euro-Scheine müssen eingezogen und vernichtet und neue Scheine, vor allem 100-Euro- und 200-Euro-Scheine, bereitgestellt werden.“"
                                            },
                                            {
                                                "example_id": "db0da11b-069f-4cfa-ada6-bc7e4a8b6a15",
                                                "sense_id": "02b741b7-1822-37b1-82a1-b22fb0644737",
                                                "text": "„Um diese Arbeiten und die damit gleisgebundene Logistik der Baumaßnahme durchführen zu können, ist es notwendig, die Bahnübergänge kommende Woche von Mittwoch bis Samstag voll zu sperren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2ad19a5e-4d97-326e-8c7b-ad82223ed2e7",
                                        "entry_id": "2423e70a-73aa-37f7-a7f4-fe6056b757ed",
                                        "glosses": [
                                            "Teil des Militärs, der die gesamte Versorgung sicherstellt und leistet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db0d1ee4-cf0f-4345-861b-0b6eb61535c6",
                                                "sense_id": "2ad19a5e-4d97-326e-8c7b-ad82223ed2e7",
                                                "text": "Die schnelle Einsatztruppe kann wirklich schnell vor Ort sein, aber die Logistik braucht mehr Zeit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6eed2810-fa85-3bf6-b5ff-c6bf32e13b96",
                                        "entry_id": "2423e70a-73aa-37f7-a7f4-fe6056b757ed",
                                        "glosses": [
                                            "ein Teilgebiet der Logik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba0d1761-3f29-4841-bc38-fbbbdb638d93",
                                                "sense_id": "6eed2810-fa85-3bf6-b5ff-c6bf32e13b96",
                                                "text": "Bei Platon ist die Logistik eine untergeordnete Wissenschaft."
                                            },
                                            {
                                                "example_id": "38b618f5-5be2-421f-b1a1-cfabd285bbf8",
                                                "sense_id": "6eed2810-fa85-3bf6-b5ff-c6bf32e13b96",
                                                "text": "„Curt Christian, * 30. Mai 1920 Linz, † 29. März 2010 Wien, Naturwissenschaftler, 1969 bis 1990 Professor für Logistik (symbolische Logik) an der Universität Wien und Institutsvorstand.“"
                                            },
                                            {
                                                "example_id": "7fd36f14-12b3-4aa0-a783-4718f72cb675",
                                                "sense_id": "6eed2810-fa85-3bf6-b5ff-c6bf32e13b96",
                                                "text": "„Das hier verwendete Wort ‚Logistik‘ ist eine heute weniger gebräuchliche Bezeichnung für die symbolische Logik.“"
                                            },
                                            {
                                                "example_id": "95dd16eb-2b4a-4ede-9f82-69b226053775",
                                                "sense_id": "6eed2810-fa85-3bf6-b5ff-c6bf32e13b96",
                                                "text": "„Am Beginn des Aufschwungs stand die Gründung des Instituts für Logistik an der Universität Wien 1966 und sein Gründungsvorstand Curt Christian.“"
                                            },
                                            {
                                                "example_id": "28bc141e-675a-4439-944b-6057b160ac08",
                                                "sense_id": "6eed2810-fa85-3bf6-b5ff-c6bf32e13b96",
                                                "text": "„Die Logistik als Teilbereich der philosophischen Logik versucht, Störeinflüssen auf logische Kalküle (z.B. denkpsychologische oder ontologische Störungen) dadurch aus dem Wege zu gehen, daß dem Gegenstandsbereich Zeichen zugeordnet werden.“"
                                            },
                                            {
                                                "example_id": "f60e7e3a-c0f6-4866-8e90-7ae697d35b31",
                                                "sense_id": "6eed2810-fa85-3bf6-b5ff-c6bf32e13b96",
                                                "text": "„Außer den Bezeichnungen ‚symbolische Logik‘ und ‚mathematische Logik‘ wird auch, besonders auf dem europäischen Kontinent, die Bezeichnung ‚Logistik‘ verwendet; sie ist kurz und erlaubt die Bildung des Adjektivs ‚logistisch‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
