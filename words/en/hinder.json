                                "ru": "Сильный снегопад начал <w>затруднять</w> движение транспорта по всему городу в утренний час пик."
                            }
                        },
                        {
                            "text": "Please do not <w>hinder</w> me from finishing my work on time.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>мешайте</w> мне закончить работу вовремя."
                            }
                        }
                    ],
                    "synonyms": [
                        "delay",
                        "impede",
                        "prevent",
                        "restrain"
                    ],
                    "antonyms": [
                        "aid",
                        "abet",
                        "further"
