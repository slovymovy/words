                        "examples": [
                            {
                                "example_id": "6928c4ca-b475-4406-bb1c-b2c788262bb8",
                                "sense_id": "ed156a03-8307-3d23-b6d4-fb4742ead41b",
                                "text": "Peter, after the manner of man at the breakfast table, had allowed half his kedgeree to get cold and was sniggering over a letter."
                            },
                            {
                                "example_id": "ae897245-2a9b-4dd4-9ebb-2db7fdc81861",
                                "sense_id": "ed156a03-8307-3d23-b6d4-fb4742ead41b",
                                "text": "Kedgeree was the invention of the British in colonial India, but was inspired by khichuri, a more ancient dish of rice and lentils, so here I’ve reinstated the pulses in the form of mung dal and peas: an Indian dish, adapted by the British, and changed again by an Indian living in Britain."
                            }
