                            {
                                "example_id": "65d9718a-b75f-479a-bd64-007f890bd1c0",
                                "sense_id": "e5af4d94-a035-3bef-95d7-69ccc13f3cb4",
                                "text": "Le froid endurcit la peau, il fait des tensions de nerfs, roidissemens et des convulsions."
                            },
                            {
                                "example_id": "f117f7e2-c650-4ae9-833b-b164cdf83945",
                                "sense_id": "e5af4d94-a035-3bef-95d7-69ccc13f3cb4",
                                "text": "La persistance de sa vie irrita l’enfant. Il se mit à l’étrangler ; et les convulsions de l’oiseau faisaient battre son cœur, l’emplissaient d’une volupté sauvage et tumultueuse. Au dernier roidissement, il se sentit défaillir."
                            }
                        ]
