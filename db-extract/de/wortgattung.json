                "senses": [
                    {
                        "sense_id": "72b193fa-3890-3822-9173-2a6b34e9b31c",
                        "entry_id": "b7c891f5-71d9-38f8-9c85-f946082a3c22",
                        "glosses": [
                            "inhaltlich definierte Klasse von Wörtern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b98ef45-c670-4e19-b034-f25417ecf2fc",
                                "sense_id": "72b193fa-3890-3822-9173-2a6b34e9b31c",
                                "text": "„Wohl kaum eine Wortgattung unterliegt einem derart schnellen Wandel wie die der Schimpfwörter.“"
                            },
                            {
                                "example_id": "016cc525-4725-4236-8392-1c8d11f9d759",
                                "sense_id": "72b193fa-3890-3822-9173-2a6b34e9b31c",
                                "text": "Hinderschiedt behandelt im Kapitel „Zum Verhältnis von Vers und Wortgattung. Schematische Analyse“ Besonderheiten des Verses im Heliand."
                            },
                            {
                                "example_id": "1fec20a5-56a0-48ed-b847-0a2b7f874357",
                                "sense_id": "72b193fa-3890-3822-9173-2a6b34e9b31c",
                                "text": "„Das Wort Spielzeug gehört zu der Wortgattung der Kollektiva, es fasst also verschiedene Dinge in sich ein.“"
                            },
                            {
                                "example_id": "fb2490ee-9ee8-4e3b-8198-3e52af336fde",
                                "sense_id": "72b193fa-3890-3822-9173-2a6b34e9b31c",
                                "text": "„Hatte sie jedoch Tastzeichen für Farbenworte erlernt, so war beim Lernen dieser Wortgattung eine Assoziation mit unmittelbaren Tastempfindungen ausgeschlossen und es konnten darum beim späteren Gebrauche dieser Worte auch keine Assoziationen vollzogen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
