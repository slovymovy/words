                "senses": [
                    {
                        "sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                        "entry_id": "8c58b2c1-c5fe-309b-b9f8-d268bd364821",
                        "glosses": [
                            "Fachsprache, mit speziellen Fachausdrücken erweiterte Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "131d5d9d-ca13-4c6b-bb69-9e2c44bf6f01",
                                "sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                                "text": "Die Vorträge wurden im Fachjargon geführt, so dass ein Nichtfachmann kaum etwas verstand."
                            },
                            {
                                "example_id": "802b495f-a9af-4adb-b9de-dbd780a6d5ac",
                                "sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                                "text": "„Hier sind wir in einem anderen Bereich, auf einer anderen Kommunikationsstufe der Sportsprache, die man als Fachjargon oder auch als Sportlersprache bezeichnet hat.“"
                            },
                            {
                                "example_id": "0624cef9-fc32-4baf-a725-ac1fda3d0a10",
                                "sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                                "text": "„Es ärgerte mich, daß ich nicht wenigstens den Fachjargon beherrschte.“"
                            },
                            {
                                "example_id": "abd58e1f-8426-426d-bd10-c832040e60c2",
                                "sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                                "text": "„Im wissenschaftlichen Fachjargon nennt man so etwas »Falsifizierbarkeit«.“"
                            },
                            {
                                "example_id": "365fee43-f208-4425-b1fc-740e5315d454",
                                "sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                                "text": "„Fachjargon ist dabei noch ein harmloser Ausdruck für das Wissenschaftsdeutsch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34fb38be-295e-4bed-83d1-5111cfca1b3a",
                        "source_entry_id": "8c58b2c1-c5fe-309b-b9f8-d268bd364821",
                        "source_sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                        "source_sense_description": "Linguistik: Fachsprache, mit speziellen Fachausdrücken erweiterte Sprache",
                        "target_lang_word": "jargon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jargon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5f5ddc6-8790-3b47-9ef9-b13e9ec1b160",
                                        "entry_id": "8fbcb4d8-1127-3f7b-af4d-82ddab38f2d8",
                                        "glosses": [
                                            "A technical terminology unique to a particular subject."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64970c2b-420f-49d3-a9a1-755da46703b7",
                                                "sense_id": "e5f5ddc6-8790-3b47-9ef9-b13e9ec1b160",
                                                "text": "That’s one of the biggest hurdles of managing a router and your network security in general, it’s a massive chore that is fraught with technical jargon, hurdles and screens saying ‘no’, ‘invalid’ or ‘not available’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b86e97f-a6a4-3233-8168-6263209811d0",
                                        "entry_id": "8fbcb4d8-1127-3f7b-af4d-82ddab38f2d8",
                                        "glosses": [
                                            "A language characteristic of a particular group."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "483e5803-f1e8-44f1-bcb3-a3770be50527",
                                                "sense_id": "0b86e97f-a6a4-3233-8168-6263209811d0",
                                                "text": "They [the Normans] abandoned their native speech, and adopted the French tongue, in which Latin was the predominant element. They speedily raised their new language to a dignity and importance which it had never before possessed. They found it a barbarous jargon; they fixed it in writing; and they employed it in legislation, in poetry, and in romance."
                                            },
                                            {
                                                "example_id": "97b11eb6-d9d9-433e-9ad4-556d7e95c1ee",
                                                "sense_id": "0b86e97f-a6a4-3233-8168-6263209811d0",
                                                "text": "In fact all the competing theories have developed their own specialized jargons and have a tendency to be difficult to penetrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "688494c4-b840-3235-bf73-2f2339eff501",
                                        "entry_id": "8fbcb4d8-1127-3f7b-af4d-82ddab38f2d8",
                                        "glosses": [
                                            "Speech or language that is incomprehensible or unintelligible; gibberish."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "jargon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a97da8b-d1d2-320a-b735-b942956c1ab8",
                                        "entry_id": "f1246eb3-23f2-34b1-b33d-1507cba375b2",
                                        "glosses": [
                                            "To utter jargon; to emit confused or unintelligible sounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "471bfb85-6445-4033-972c-c0fb192b6948",
                                                "sense_id": "9a97da8b-d1d2-320a-b735-b942956c1ab8",
                                                "text": "Human ill-nature needs but some Homoiousian iota, or even the pretence of one; and will flow copiously through the eye of a needle: thus always must mortals go jargoning and fuming […]."
                                            },
                                            {
                                                "example_id": "706acf88-2787-44df-941f-e22ba372f622",
                                                "sense_id": "9a97da8b-d1d2-320a-b735-b942956c1ab8",
                                                "text": "Prussian Trenck, the poor subterranean Baron, jargons and jangles in an unmelodious manner."
                                            },
                                            {
                                                "example_id": "9711857d-6ef3-4746-b408-99e69bd404f1",
                                                "sense_id": "9a97da8b-d1d2-320a-b735-b942956c1ab8",
                                                "text": "[T]he noisy jay, / Jargoning like a foreigner at his food; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jargon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86c71d0b-c1b1-3845-9b28-3340a8661e54",
                                        "entry_id": "58cd617c-829c-3440-8178-318d5bb43ad7",
                                        "glosses": [
                                            "Alternative form of jargoon (“A variety of zircon”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07b8fade-9e6d-416e-a1f9-be7de225a7f5",
                        "source_entry_id": "8c58b2c1-c5fe-309b-b9f8-d268bd364821",
                        "source_sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                        "source_sense_description": "Linguistik: Fachsprache, mit speziellen Fachausdrücken erweiterte Sprache",
                        "target_lang_word": "lingo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lingo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31b42596-5f9a-3bb0-89f9-ca56a441ff99",
                                        "entry_id": "e90a6521-3ea1-3b4b-9e73-7af0a1d6b403",
                                        "glosses": [
                                            "Language, especially language peculiar to a particular group, field, or region; jargon or a dialect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4737bdf7-084c-4fae-b134-6869f8c7346e",
                                                "sense_id": "31b42596-5f9a-3bb0-89f9-ca56a441ff99",
                                                "text": "[...] I have Thoughts to tarry a ſmall Matter in Town, to learn ſomewhat of your Lingo firſt, before I croſs the Seas."
                                            },
                                            {
                                                "example_id": "c07fd877-b04c-42b9-96a2-e2c1fddd006e",
                                                "sense_id": "31b42596-5f9a-3bb0-89f9-ca56a441ff99",
                                                "text": "\"You see, ma'am, I can't divest myself of my professional lingo,\" observed Mr. Banks."
                                            },
                                            {
                                                "example_id": "38c4c80f-c843-4e05-9908-d6adf25f0ccf",
                                                "sense_id": "31b42596-5f9a-3bb0-89f9-ca56a441ff99",
                                                "text": "Nobody could make out plain what she said, for she was mainly jabbering Swede lingo, but there was English enough, of a kind, to give us some idee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f72a321d-efa7-3f15-a206-bc2cdadd71e5",
                                        "entry_id": "e90a6521-3ea1-3b4b-9e73-7af0a1d6b403",
                                        "glosses": [
                                            "An Aboriginal language."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ac381d2-6b95-4b29-94d5-ec79c9b01bcd",
                                                "sense_id": "f72a321d-efa7-3f15-a206-bc2cdadd71e5",
                                                "text": "Granny Ava was the link: the last heathen of the family to speak the lingo fluently, before the Church waltzed in and jammed the Lord's Prayer in Granny Ruth's twelve-year-old mouth instead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
