                                ]
                            },
                            {
                                "target_word": "compilador",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "1f8667f2-dfa5-37f5-a8ec-503374e579e5",
                                        "entry_id": "5980df27-9582-39c2-a6b7-e785cd582080",
                                        "glosses": [
                                            "Programa que transforma el código fuente escrito por los programadores a otro lenguaje."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38200cca-781c-4131-a511-fd53bf537a8a",
                                                "sense_id": "1f8667f2-dfa5-37f5-a8ec-503374e579e5",
                                                "text": "Pero, debido a su dificultad y coste, se han desarrollado procedimientos de programación automática que se valen del empleo de lenguajes evolucionados, mucho más cómodos de utilizar, siendo posible la conversión de un programa escrito en uno de estos lenguajes a lenguaje de máquina mediante el auxilio de superprogramas traductores (ensambladores o compiladores, según los casos)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "661fe459-f568-47bb-a8c7-546637630068",
                        "source_entry_id": "f505cb50-d682-3a3d-8515-8c5da8020819",
                        "source_sense_id": "bb4afe73-f54f-34da-a947-460fea949b48",
                        "target_lang_word": "Kompilierer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a7158e63-caf5-4996-965f-7784f016ca51",
                        "source_entry_id": "f505cb50-d682-3a3d-8515-8c5da8020819",
                        "source_sense_id": "bb4afe73-f54f-34da-a947-460fea949b48",
                        "target_lang_word": "компилятор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "компилятор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "df89183f-dd79-3042-98cb-01dd942823df",
                                        "entry_id": "423c7fe8-68ea-3faa-a5f2-4191848171bc",
                                        "glosses": [
                                            "автор компиляции — произведения, составленного путём использования чужих трудов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7ec3110-83ca-46bb-a458-a3025feddb73",
                                                "sense_id": "df89183f-dd79-3042-98cb-01dd942823df",
                                                "text": "Любой компилятор, собрав вырезки из газет, мог бы написать именно так об американской школе и об американских пионерах."
                                            },
                                            {
                                                "example_id": "075c3bed-9ee0-45b8-be54-4cb772c90f07",
                                                "sense_id": "df89183f-dd79-3042-98cb-01dd942823df",
                                                "text": "Добросовестных компиляторов ещё можно терпеть, но демагогии нет места в науке."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "компилятор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "392db253-81ad-3569-9f5e-d0723572b34a",
                                        "entry_id": "ad8b7610-b11f-3907-bf7f-2e47e12532ea",
                                        "glosses": [
                                            "комп. транслятор, который осуществляет компиляцию — перевод исходной программы в эквивалентную ей результирующую программу на языке машинных команд или на языке ассемблера"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0237e949-915f-4f53-a353-b1e129a8f5e8",
                                                "sense_id": "392db253-81ad-3569-9f5e-d0723572b34a",
                                                "text": "Кроме собственно процессоров, Intel также обеспечивает разработчиков устройств всем необходимым для создания набора приложений: компиляторами, программными библиотеками, средствами для миграции на новые продукты, средствами для кросс-разработки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
