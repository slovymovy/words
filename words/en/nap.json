{
    "word_family": [
        "napper",
        "nappiness",
        "nappy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7db69d33-12da-39dc-8914-b50646246f6b",
                    "sense_definition": "To sleep for a short period of time, especially during the day.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "short sleep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby usually <w>naps</w> for two hours after lunch.",
                            "target_lang_translations": {
                                "ru": "Ребёнок обычно <w>спит</w> два часа после обеда.",
                                "zh": "婴儿午饭后通常会<w>小睡</w>两个小时。"
                            }
                        },
                        {
                            "text": "I like to <w>nap</w> on the sofa during the weekend.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>вздремнуть</w> на диване в выходные.",
                                "zh": "周末我喜欢在沙发上<w>打盹</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snooze",
                        "doze",
                        "kip"
                    ],
                    "common_phrases": [
                        "nap on the sofa",
                        "nap during the day"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спать в течение короткого периода времени, особенно днем.",
                        "zh": "在白天小睡一会儿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вздремнуть",
                                "target_lang_sense_clarification": "немного поспать"
                            },
                            {
                                "target_lang_word": "дремать",
                                "target_lang_sense_clarification": "находиться в полусонном состоянии"
                            },
                            {
                                "target_lang_word": "кемарить",
                                "target_lang_sense_clarification": "дремать (разговорное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小睡",
                                "target_lang_sense_clarification": "短暂的睡眠"
                            },
                            {
                                "target_lang_word": "打盹",
                                "target_lang_sense_clarification": "处于半睡半醒的状态"
                            },
                            {
                                "target_lang_word": "午睡",
                                "target_lang_sense_clarification": "特指午间的睡眠"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "500c5e36-4849-38d9-aa79-774363c38243",
                    "sense_definition": "To be off one's guard or unprepared for a situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regulators were caught <w>napping</w> by the sudden financial collapse.",
                            "target_lang_translations": {
                                "ru": "Регуляторы были <w>застигнуты врасплох</w> внезапным финансовым крахом.",
                                "zh": "监管机构因突如其来的金融崩溃而<w>措手不及</w>。"
                            }
                        },
                        {
                            "text": "Don't let the competition catch you <w>napping</w> during the negotiations.",
                            "target_lang_translations": {
                                "ru": "Не позволяйте конкурентам <w>застать вас врасплох</w> во время переговоров.",
                                "zh": "在谈判过程中，别让竞争对手让你<w>措手不及</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "caught napping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть застигнутым врасплох или оказаться неподготовленным к ситуации.",
                        "zh": "因疏忽或未准备好而措手不及。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зевать",
                                "target_lang_sense_clarification": "проявлять невнимательность"
                            },
                            {
                                "target_lang_word": "прозевать",
                                "target_lang_sense_clarification": "упустить момент из-за небрежности"
                            },
                            {
                                "target_lang_word": "быть застигнутым врасплох",
                                "target_lang_sense_clarification": "оказаться неготовым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "措手不及",
                                "target_lang_sense_clarification": "因没有准备而手忙脚乱"
                            },
                            {
                                "target_lang_word": "疏忽",
                                "target_lang_sense_clarification": "因不注意而导致失误"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a537549f-a677-386b-a0a1-9d5f29b7da31",
                    "sense_definition": "To cover a food item lightly with a sauce.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef decided to <w>nap</w> the poached pear with a rich chocolate sauce.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>полить</w> грушу-пашот густым шоколадным соусом.",
                                "zh": "厨师决定在水煮梨上<w>淋</w>一层浓郁的巧克力酱。"
                            }
                        },
                        {
                            "text": "The fish was lightly <w>napped</w> with a lemon butter glaze before serving.",
                            "target_lang_translations": {
                                "ru": "Перед подачей рыбу слегка <w>покрыли</w> лимонно-масляной глазурью.",
                                "zh": "鱼在上菜前被轻轻<w>浇</w>上了一层柠檬黄油釉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "napped with sauce"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical culinary term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка покрыть блюдо соусом.",
                        "zh": "在食物上淋一层薄薄的酱汁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наппировать",
                                "target_lang_sense_clarification": "кулинарный термин: покрывать соусом"
                            },
                            {
                                "target_lang_word": "поливать",
                                "target_lang_sense_clarification": "слегка покрывать соусом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "淋",
                                "target_lang_sense_clarification": "在食物上浇上酱汁"
                            },
                            {
                                "target_lang_word": "浇",
                                "target_lang_sense_clarification": "将液体覆盖在食物表面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f9dc92a-cb67-3e7a-9ac9-a0c38c8c984f",
                    "sense_definition": "To form or raise a soft or fuzzy surface on fabric or leather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fabric texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine is designed to <w>nap</w> the wool to make it softer.",
                            "target_lang_translations": {
                                "ru": "Машина предназначена для того, чтобы <w>ворсовать</w> шерсть, делая её мягче.",
                                "zh": "这台机器旨在将羊毛<w>起绒</w>，使其更柔软。"
                            }
                        },
                        {
                            "text": "They <w>nap</w> the leather to give it a suede-like finish.",
                            "target_lang_translations": {
                                "ru": "Они <w>начёсывают</w> кожу, чтобы придать ей вид замши.",
                                "zh": "他们将皮革<w>起绒</w>，以赋予其类似麂皮的质感。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать мягкую или пушистую поверхность на ткани или коже.",
                        "zh": "使织物或皮革表面起绒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворсовать",
                                "target_lang_sense_clarification": "наводить ворс на ткани"
                            },
                            {
                                "target_lang_word": "начёсывать",
                                "target_lang_sense_clarification": "создавать пушистую поверхность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "起绒",
                                "target_lang_sense_clarification": "使织物表面产生绒毛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1748247e-8216-399d-8e8d-9953f22194cf",
                    "sense_definition": "To grab or seize something suddenly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief tried to <w>nap</w> the purse from the table.",
                            "target_lang_translations": {
                                "ru": "Вор попытался <w>стащить</w> сумочку со стола.",
                                "zh": "小偷试图从桌子上<w>抢走</w>钱包。"
                            }
                        },
                        {
                            "text": "He managed to <w>nap</w> the last cookie before anyone else saw it.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>схватить</w> последнее печенье прежде, чем кто-либо другой его заметил.",
                                "zh": "他在别人看到之前成功<w>抢走</w>了最后一块饼干。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно схватить или стащить что-либо.",
                        "zh": "突然抓取或夺走某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стащить",
                                "target_lang_sense_clarification": "украсть или быстро взять"
                            },
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "резко взять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抢走",
                                "target_lang_sense_clarification": "迅速夺取"
                            },
                            {
                                "target_lang_word": "抓取",
                                "target_lang_sense_clarification": "突然拿走"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1480827c-e740-30d7-96f0-17d66eda6ad9",
                    "sense_definition": "A short period of sleep, especially one taken during the day.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "short sleep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I feel much better after taking a quick <w>nap</w>.",
                            "target_lang_translations": {
                                "ru": "Я чувствую себя гораздо лучше после того, как немного <w>вздремнул</w>.",
                                "zh": "<w>小睡</w>片刻后，我感觉好多了。"
                            }
                        },
                        {
                            "text": "He usually takes a short <w>nap</w> after he finishes his lunch.",
                            "target_lang_translations": {
                                "ru": "Обычно он <w>спит</w> недолго после обеда.",
                                "zh": "他通常在吃完午饭后<w>小睡</w>一会儿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rest",
                        "sleep",
                        "shut-eye",
                        "snooze"
                    ],
                    "common_phrases": [
                        "take a nap",
                        "short nap",
                        "afternoon nap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий период сна, особенно в дневное время.",
                        "zh": "短暂的睡眠，尤指白天的小睡。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "короткий сон",
                                "target_lang_sense_clarification": "непродолжительный отдых"
                            },
                            {
                                "target_lang_word": "дневной сон",
                                "target_lang_sense_clarification": "сон в светлое время суток"
                            },
                            {
                                "target_lang_word": "дрёма",
                                "target_lang_sense_clarification": "состояние полусна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小睡",
                                "target_lang_sense_clarification": "短暂的休息"
                            },
                            {
                                "target_lang_word": "午觉",
                                "target_lang_sense_clarification": "午间的睡眠"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af7681e7-34ad-33f2-958c-beba0792b808",
                    "sense_definition": "A soft or fuzzy surface, generally on fabric or leather.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fabric texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick <w>nap</w> of the rug felt very soft under my bare feet.",
                            "target_lang_translations": {
                                "ru": "Густой <w>ворс</w> ковра казался очень мягким под босыми ногами.",
                                "zh": "地毯厚实的<w>绒毛</w>在我的赤脚下感觉非常柔软。"
                            }
                        },
                        {
                            "text": "You can see the <w>nap</w> of the velvet changing color when you brush it.",
                            "target_lang_translations": {
                                "ru": "Можно заметить, как <w>ворс</w> бархата меняет цвет, если провести по нему рукой.",
                                "zh": "当你刷天鹅绒时，可以看到它的<w>绒面</w>在变色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "thick nap",
                        "nap of the rug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая или пушистая поверхность ткани или кожи.",
                        "zh": "织物或皮革表面的绒毛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворс",
                                "target_lang_sense_clarification": "слой волосков на ткани"
                            },
                            {
                                "target_lang_word": "пушок",
                                "target_lang_sense_clarification": "нежный ворс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绒毛",
                                "target_lang_sense_clarification": "织物表面的细毛"
                            },
                            {
                                "target_lang_word": "绒面",
                                "target_lang_sense_clarification": "有绒毛的表面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4f90700-1ebf-349f-ba03-8da30f65fe33",
                    "sense_definition": "The common direction of the hairs or fibers making up the pile on some kinds of fabric.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fabric texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure all fabric pieces are cut with the <w>nap</w> going the same direction.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что все детали ткани выкроены с <w>ворсом</w>, направленным в одну сторону.",
                                "zh": "确保所有布料裁剪时<w>绒毛方向</w>一致。"
                            }
                        },
                        {
                            "text": "If you brush against the <w>nap</w>, the material looks much darker.",
                            "target_lang_translations": {
                                "ru": "Если провести против <w>ворса</w>, материал выглядит намного темнее.",
                                "zh": "如果你逆着<w>绒毛方向</w>刷，布料看起来会深得多。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "with the nap",
                        "against the nap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направление волосков или волокон, образующих ворс на ткани.",
                        "zh": "织物表面绒毛的生长方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направление ворса",
                                "target_lang_sense_clarification": "ориентация волокон ткани"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绒毛方向",
                                "target_lang_sense_clarification": "织物纹理的走向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df195a29-ac78-3394-b7fb-3dda32b6136f",
                    "sense_definition": "A type of bet in British horse racing, based on an expert's best tip for the day.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The racing correspondent's <w>nap</w> for today is a horse named Silver Bullet.",
                            "target_lang_translations": {
                                "ru": "<w>Верняком</w> от спортивного обозревателя на сегодня является лошадь по кличке Серебряная Пуля.",
                                "zh": "赛马记者今天推荐的<w>稳赢马</w>是一匹名叫“银弹”的马。"
                            }
                        },
                        {
                            "text": "He placed a large bet on the tipster's <w>nap</w> of the day.",
                            "target_lang_translations": {
                                "ru": "Он сделал крупную ставку на <w>лучшую ставку</w> дня от типстера.",
                                "zh": "他在专家当天的<w>稳赢马</w>上押了重注。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nap of the day"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид ставки в британских скачках, основанный на лучшем совете эксперта на день.",
                        "zh": "英国赛马中专家推荐的胜算最高的马。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верняк",
                                "target_lang_sense_clarification": "лучшая ставка дня (сленг)"
                            },
                            {
                                "target_lang_word": "лучшая ставка",
                                "target_lang_sense_clarification": "совет эксперта на скачках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "稳赢马",
                                "target_lang_sense_clarification": "专家推荐的胜算最大的马"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "423ad9dd-c2b6-32db-aa07-92b6c1cd48ce",
                    "sense_definition": "A card game in which players take tricks, properly known as Napoleon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "card games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors spent their evening playing a few rounds of <w>nap</w>.",
                            "target_lang_translations": {
                                "ru": "Матросы провели вечер за несколькими раундами в <w>наполеон</w>.",
                                "zh": "水手们晚上玩了几局<w>拿破仑牌</w>。"
                            }
                        },
                        {
                            "text": "He learned how to play <w>nap</w> from his grandfather during the holidays.",
                            "target_lang_translations": {
                                "ru": "Он научился играть в <w>наполеон</w> у своего дедушки во время каникул.",
                                "zh": "假期里他从祖父那里学会了玩<w>拿破仑牌</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
