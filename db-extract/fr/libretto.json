                ],
                "senses": [
                    {
                        "sense_id": "60b88e2d-6047-3f74-8c92-662b5376b26e",
                        "entry_id": "b78ab8d5-adce-3112-9a95-e55ca50a2dbf",
                        "glosses": [
                            "Paroles d’une partition, par opposition à la musique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5b688a6a-3e9c-36e1-95aa-e03e459f774e",
                        "entry_id": "b78ab8d5-adce-3112-9a95-e55ca50a2dbf",
                        "glosses": [
                            "Explication d’une pantomime ou d’un ballet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c1cacfc-7e46-4304-b678-6fb9b106885f",
                                "sense_id": "5b688a6a-3e9c-36e1-95aa-e03e459f774e",
                                "text": "Pourtant ils étaient les auteurs et les acteurs de petits poèmes gymnastiques d’une invention toute neuve. Voici le libretto d’une de ces fantaisies dont le Cirque conserve encore la mémoire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36506421-b227-4790-b251-372f1da32c80",
                        "source_entry_id": "b78ab8d5-adce-3112-9a95-e55ca50a2dbf",
                        "target_lang_word": "Libretto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Libretto",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dacbeb06-7374-388e-96e1-fb54b68301bb",
                                        "entry_id": "f51acec1-e7c8-3221-9c8c-27737f91c629",
                                        "glosses": [
                                            "Textbuch eines musikalischen Werks, vor allem von Bühnenstücken (Oper, Operette, Singspiel)"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe2eea77-159d-4237-8269-7f417bdca3dc",
                                                "sense_id": "dacbeb06-7374-388e-96e1-fb54b68301bb",
                                                "text": "„Die Pianistin und Komponistin Clara Schumann bat sie, das Libretto für eine Oper ihres Mannes Robert zu schreiben.“"
                                            },
                                            {
                                                "example_id": "a17ed24c-3d17-4901-a6c0-61ffb1612dbd",
                                                "sense_id": "dacbeb06-7374-388e-96e1-fb54b68301bb",
                                                "text": "„Die Dramentexte, die Bühnenmusik, die Libretti, die Maschinerie, die Inszenierung und die Dekors haben für ihn bald kein Geheimnis.“"
                                            },
                                            {
                                                "example_id": "3a143373-202d-446b-8b26-9d474fc766fa",
                                                "sense_id": "dacbeb06-7374-388e-96e1-fb54b68301bb",
                                                "text": "„Die Zeit war zu kurz, um nach Italien zu schreiben; ich bot mich an, ihm sogleich ein Libretto zu verfassen, man nahm mich beim Wort, und am nächsten Tag gab ich ihm den ersten Akt.“"
                                            },
                                            {
                                                "example_id": "fd03bb19-4ed8-4a75-a2e2-785c97b96e12",
                                                "sense_id": "dacbeb06-7374-388e-96e1-fb54b68301bb",
                                                "text": "„Das ist einerseits sehr ernst gemeint; seine eigenen Versuche, auf der Bühne zu reüssieren, sind Vergangenheit, die Form des Librettos eingeschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08c519a0-67e0-4043-942a-65821ba06477",
                        "source_entry_id": "b78ab8d5-adce-3112-9a95-e55ca50a2dbf",
                        "target_lang_word": "libretto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "libretto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7d031cb-c656-37e5-b6a7-7de38e5bc1ab",
                                        "entry_id": "6758bb44-83db-3abb-9eaf-289780cc3061",
                                        "glosses": [
                                            "The text of a dramatic musical work, such as an opera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64f5731c-9295-41b9-a828-885daab3a950",
                                                "sense_id": "e7d031cb-c656-37e5-b6a7-7de38e5bc1ab",
                                                "text": "From Mozart's letters we know that the composer decided to enlarge the part of Osmin, the harem keeper, because the originator of the part, Ludwig Fischer, had a freakishly low bass voice that Mozart wanted to exploit. Osmin's principal arias and ensembles were duly lengthened beyond what appeared in the original libretto, and he was given yet another song in the third act."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48f36292-0792-3ad6-9929-dedb715ea655",
                                        "entry_id": "6758bb44-83db-3abb-9eaf-289780cc3061",
                                        "glosses": [
                                            "A book containing such a text."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
