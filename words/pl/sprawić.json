{
    "word_family": [
        "sprawca",
        "sprawczyni",
        "sprawczy",
        "sprawiedliwy",
        "sprawiedliwość"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33a70782-6481-3361-bd9e-59807f31019c",
                    "sense_definition": "powodować, że coś się dzieje lub zaistnieje",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "przyczyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Silny wiatr <w>sprawił</w>, że drzewo przewróciło się na drogę.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер <w>вызвал</w> падение дерева на дорогу."
                            }
                        },
                        {
                            "text": "Jej obecność <w>sprawiła</w>, że wszyscy poczuli się lepiej.",
                            "target_lang_translations": {
                                "ru": "Её присутствие <w>сделало</w> так, что все почувствовали себя лучше."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sprawić że"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать появление чего-либо или приводить к какому-либо результату"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызвать",
                                "target_lang_sense_clarification": "привести к какому-либо событию или состоянию"
                            },
                            {
                                "target_lang_word": "сделать так, чтобы",
                                "target_lang_sense_clarification": "конструкция для описания причины действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac9edab3-4d95-3268-bacc-b5b09ab5b4bb",
                    "sense_definition": "wywoływać u kogoś określone odczucia lub stan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "przyczyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten prezent <w>sprawił</w> jej ogromną radość.",
                            "target_lang_translations": {
                                "ru": "Этот подарок <w>доставил</w> ей огромную радость."
                            }
                        },
                        {
                            "text": "Jego słowa <w>sprawiły</w> mi wielki ból.",
                            "target_lang_translations": {
                                "ru": "Его слова <w>причинили</w> мне большую боль."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sprawić radość",
                        "sprawić kłopot"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать у кого-либо определенные чувства или состояние"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доставить",
                                "target_lang_sense_clarification": "о чувствах, например, доставить радость"
                            },
                            {
                                "target_lang_word": "причинить",
                                "target_lang_sense_clarification": "о негативных чувствах, например, причинить боль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18fd0002-edf6-342f-9ab2-52bd68eda95d",
                    "sense_definition": "kupić coś dla siebie lub kogoś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zakupy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę w końcu <w>sprawić</w> sobie nowy telefon.",
                            "target_lang_translations": {
                                "ru": "Мне нужно наконец <w>купить</w> себе новый телефон."
                            }
                        },
                        {
                            "text": "Rodzice chcieli <w>sprawić</w> dziecku wymarzony rower na urodziny.",
                            "target_lang_translations": {
                                "ru": "Родители хотели <w>купить</w> ребенку велосипед, о котором он мечтал, на день рождения."
                            }
                        }
                    ],
                    "synonyms": [
                        "kupić"
                    ],
                    "common_phrases": [
                        "sprawić sobie"
                    ],
                    "target_lang_definitions": {
                        "ru": "приобрести что-либо для себя или для кого-то другого"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купить",
                                "target_lang_sense_clarification": "приобрести за деньги"
                            },
                            {
                                "target_lang_word": "приобрести",
                                "target_lang_sense_clarification": "более формальный вариант покупки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "253e7d2e-f443-3e69-9fbb-64daaf2b5b10",
                    "sense_definition": "poradzić sobie w trudnej sytuacji",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zarządzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mimo wielu problemów, jakoś <w>sprawił</w> się w tej nowej pracy.",
                            "target_lang_translations": {
                                "ru": "Несмотря на множество проблем, он как-то <w>справился</w> на этой новой работе."
                            }
                        },
                        {
                            "text": "Nie wiedziałem, czy <w>sprawię</w> się z tym zadaniem na czas.",
                            "target_lang_translations": {
                                "ru": "Я не знал, <w>справлюсь</w> ли я с этим заданием вовремя."
                            }
                        }
                    ],
                    "synonyms": [
                        "poradzić sobie"
                    ],
                    "target_lang_definitions": {
                        "ru": "справиться с трудной ситуацией или задачей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "справиться",
                                "target_lang_sense_clarification": "успешно выполнить задачу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d0854fd-faf2-355a-b4b3-423b78299bad",
                    "sense_definition": "aspekt dokonany od <w>sprawiać</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy możesz <w>sprawić</w>, aby twój kolega poszedł do domu?",
                            "target_lang_translations": {
                                "ru": "Можешь <w>сделать</w> так, чтобы твой коллега пошел домой?"
                            }
                        },
                        {
                            "text": "Boże, <w>spraw</w>, żeby tak było.",
                            "target_lang_translations": {
                                "ru": "Боже, <w>сделай</w> так, чтобы это было правдой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aspekt dokonany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид глагола sprawiać"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделать",
                                "target_lang_sense_clarification": "в значении побуждения к действию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
