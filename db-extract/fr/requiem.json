                                    {
                                        "sense_id": "7a29511d-228d-35ff-9221-cbd3b307fb83",
                                        "entry_id": "a9f364f9-e16b-3e59-89b4-363e2435be75",
                                        "glosses": [
                                            "Totenmesse der katholischen Liturgie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8028f09-7519-41ae-9d07-30d9352ab1c5",
                                                "sense_id": "7a29511d-228d-35ff-9221-cbd3b307fb83",
                                                "text": "Das Requiem für unseren ehemaligen Pfarrer an Sankt Sophien feiern wir am Dienstag, dem 26. Juli, um 10.30 Uhr in der Dominikanerkirche Sankt Paulus."
                                            },
                                            {
                                                "example_id": "b611e84c-bc00-43ee-a6cb-ec57bfc23ac4",
                                                "sense_id": "7a29511d-228d-35ff-9221-cbd3b307fb83",
                                                "text": "Der liturgische Ablauf eines Requiems gleicht dem der heiligen Messe an Werktagen in Bußzeiten (Advent, Fastenzeit)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1588ca2d-8c10-3dc4-aa43-7da403a882a0",
                                        "entry_id": "a9f364f9-e16b-3e59-89b4-363e2435be75",
                                        "glosses": [
                                            "Komposition, gespielt bei einer Totenmesse ^([1])"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f4e6b4c-79fb-4e6f-b0cf-f00663846825",
                                                "sense_id": "1588ca2d-8c10-3dc4-aa43-7da403a882a0",
                                                "text": "Der Komponist Howard Moody hat ein neues Requiem geschrieben, das unter Beteiligung eines Kinderchors aufgeführt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0026fbf-4965-461e-a111-bbb652113fd1",
                        "source_entry_id": "a1be2702-161e-35e5-a8e5-6b158789d947",
                        "target_lang_word": "Totenmesse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Totenmesse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96c37476-053a-304f-ad7e-0046f3667749",
                                        "entry_id": "5be3cdcd-3fe8-3c0f-a1ad-c93ab9babdeb",
                                        "glosses": [
                                            "die Messfeier für Verstorbene"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a48fadea-618e-4d41-ba0c-c1b994e15b8d",
                                                "sense_id": "96c37476-053a-304f-ad7e-0046f3667749",
                                                "text": "Rhythmus und Ablauf des Stücks werden von sechs liturgischen Teilen der lateinischen Totenmesse, die als Grundgerüst fungieren, und neun eingeschobenen Gedichtvertonungen des Poeten Wilfred Owen bestimmt."
                                            },
                                            {
                                                "example_id": "31c3f06b-727a-46c8-9073-4eebf46ea15d",
                                                "sense_id": "96c37476-053a-304f-ad7e-0046f3667749",
                                                "text": "„Am dritten Tage ließ man buddhistische Mönche kommen und die Totenmesse lesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c89114a-0df9-3f2a-a8d1-d872a4d80bce",
                                        "entry_id": "5be3cdcd-3fe8-3c0f-a1ad-c93ab9babdeb",
                                        "glosses": [
                                            "die Messfeier für einen Verstorbenen, meist unmittelbar vor seiner Beerdigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676f0bc8-1992-43d8-aae1-830d8e6c3103",
                                                "sense_id": "6c89114a-0df9-3f2a-a8d1-d872a4d80bce",
                                                "text": "Die Totenmesse fand vor der Beerdigung statt."
                                            },
                                            {
                                                "example_id": "0351039b-8690-41c8-818e-94cd87fbec3a",
                                                "sense_id": "6c89114a-0df9-3f2a-a8d1-d872a4d80bce",
                                                "text": "„Reverend William Clarke hielt die Totenmesse und trug ein von Louis verfasstes Gebet vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "82da124a-9871-33e9-b0e1-cb3269b148c4",
                                        "entry_id": "5be3cdcd-3fe8-3c0f-a1ad-c93ab9babdeb",
                                        "glosses": [
                                            "eine Komposition zur feierlich-musikalischen Ausgestaltung von [1]"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18b4993c-4c42-4751-9d8c-3af44ef3aef5",
                                                "sense_id": "82da124a-9871-33e9-b0e1-cb3269b148c4",
                                                "text": "\"Totenmessen gibt es so viele. Es ist müßig, ihnen eine weitere hinzuzufügen.\""
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
