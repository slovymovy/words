                    {
                        "translation_id": "d34255a5-6328-4cb9-af5b-8105a0de9e76",
                        "source_entry_id": "a100d803-a3c4-3a92-b3bc-8db9c77597af",
                        "source_sense_id": "cb160ae3-b8d8-3b6f-9462-69c340ed9cf7",
                        "target_lang_word": "méphistophélique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méphistophélique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a35cf56-81c3-3cc3-bf45-e686d7465646",
                                        "entry_id": "259a18f6-ceb8-3f9b-84c4-b9fdcea28879",
                                        "glosses": [
                                            "Qui a la méchanceté de Méphistophélès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8744187-d2a9-48ef-bf9e-cddb5435879e",
                                                "sense_id": "8a35cf56-81c3-3cc3-bf45-e686d7465646",
                                                "text": "Une habileté, une perfidie, une perversité méphistophélique."
                                            },
                                            {
                                                "example_id": "75267557-5c38-4a6a-b52f-799ec72960c6",
                                                "sense_id": "8a35cf56-81c3-3cc3-bf45-e686d7465646",
                                                "text": "Il y a un esprit méphistophélique là-dedans, sur mon honneur."
                                            },
                                            {
                                                "example_id": "ab950622-88bd-4452-b690-451357564c9d",
                                                "sense_id": "8a35cf56-81c3-3cc3-bf45-e686d7465646",
                                                "text": "Ducup commençait à avoir les lèvres sèches, le débit moins rapide. Il ne voyait pas Loursat mais le sentait, là, à sa droite, ramassé et méphistophélique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38a808f2-0204-33c5-9a11-541f97251111",
                                        "entry_id": "259a18f6-ceb8-3f9b-84c4-b9fdcea28879",
                                        "glosses": [
                                            "Qui rappelle l’apparence physique ou le caractère du démon nommé Méphistophélès dans la légende de Faust."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b23aac6-88f4-4e0c-8383-0315a4cf49e4",
                                                "sense_id": "38a808f2-0204-33c5-9a11-541f97251111",
                                                "text": "Prêt à tout pour éviter l’humiliation d’une défaite, pariant sur une droitisation de l’électorat, Sarkozy, encouragé par l’inévitable Patrick Buisson, mentor méphistophélique, agite des idées de plus en plus extrêmes."
                                            },
                                            {
                                                "example_id": "dab4747d-169b-4804-bbc3-2823bcbd2c01",
                                                "sense_id": "38a808f2-0204-33c5-9a11-541f97251111",
                                                "text": "— Je n’aime pas cette coiffure, Benjamin, elle te donne l’air méphistophélique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
