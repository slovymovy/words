                "senses": [
                    {
                        "sense_id": "e58c26cc-cf2f-3d05-9cc2-694e5ad7dc76",
                        "entry_id": "4275efa8-54e0-397f-b940-086993a149d6",
                        "glosses": [
                            "einem Zyklon ähnelnd, an einen Zyklon erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86fe2486-67c2-4df1-bae7-55fc94211758",
                                "sense_id": "e58c26cc-cf2f-3d05-9cc2-694e5ad7dc76",
                                "text": "„Nichts klingt so sehr nach Spaß, wie aus den Klamotten gerissen zu werden, wenn der Fallschirm einen mit dem Mitgefühl einer Henkerschlinge in den Himmel schleudert. Und das, bevor man die nächsten 20 bis 30 Minuten bei Minusgraden über der Erde baumelte, während man bei zyklonartigem Wind in Richtung des vom Feind besetzten Gebiets unterwegs war.“"
                            }
                        ],
