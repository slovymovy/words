                "senses": [
                    {
                        "sense_id": "0c4fc77d-4bd7-35d8-ac58-9d085cf2775e",
                        "entry_id": "579cd0a2-cdc9-3642-86df-6b295c151c78",
                        "glosses": [
                            "Obstacle, difficulté matérielle ou d’autre nature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82781381-c599-4b9e-994b-2eec351423e1",
                                "sense_id": "0c4fc77d-4bd7-35d8-ac58-9d085cf2775e",
                                "text": "Comme pendant sa jeunesse il avait été manégé par quelques-unes des femmes les plus spirituelles de la cour de Louis XV, il ne désespérait pas trop de préserver la comtesse de tout encombre…"
                            },
                            {
                                "example_id": "bcd8a0cc-119b-4f40-9501-51d72a2dd042",
                                "sense_id": "0c4fc77d-4bd7-35d8-ac58-9d085cf2775e",
                                "text": "La mère Camille vécut là pendant quarante-cinq ans, non point sans traverses, car elle était vouée aux encombres et aux catastrophes ; mais les revers semblaient ne pas l’atteindre et sa bonne humeur s’en augmentait."
                            }
                        ]
                    }
                ],
