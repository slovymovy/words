                    {
                        "translation_id": "f0f44f5e-b7ec-4b09-846c-1f81ae31f9f0",
                        "source_entry_id": "0e66b584-516c-3a7b-8339-62808d1b2d21",
                        "source_sense_id": "ee7ef420-d107-3436-a415-12e781fefa35",
                        "target_lang_word": "enregistreur de vol",
