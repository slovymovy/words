{
    "word_family": [
        "latitudinal",
        "latitudinarian"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5eaee796-8a7c-3981-87f8-ab33cd4e2058",
                    "sense_definition": "The angular distance north or south from a planet's equator, or a region at a specific distance from the equator.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The oat is hardier than wheat and ripens in higher <w>latitudes</w>.",
                            "target_lang_translations": {
                                "ru": "Овес более вынослив, чем пшеница, и созревает в более высоких <w>широтах</w>."
                            }
                        },
                        {
                            "text": "The city is located at a high <w>latitude</w> where the winters are very long.",
                            "target_lang_translations": {
                                "ru": "Город расположен на высокой <w>широте</w>, где зимы очень длинные."
                            }
                        }
                    ],
                    "antonyms": [
                        "longitude"
                    ],
                    "common_phrases": [
                        "high latitude",
                        "northern latitude",
                        "degree of latitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угловое расстояние к северу или югу от экватора планеты или регион, находящийся на определенном расстоянии от экватора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "широта",
                                "target_lang_sense_clarification": "географическая координата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9ff0ed7-ef91-38be-8768-bbf91121883e",
                    "sense_definition": "An imaginary line around a planet running parallel to the equator.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The 38th parallel is a famous line of <w>latitude</w>.",
                            "target_lang_translations": {
                                "ru": "38-я параллель — известная линия <w>широты</w>."
                            }
                        },
                        {
                            "text": "Maps show lines of <w>latitude</w> and longitude to help with navigation.",
                            "target_lang_translations": {
                                "ru": "На картах показаны линии <w>широты</w> и долготы для помощи в навигации."
                            }
                        }
                    ],
                    "synonyms": [
                        "parallel"
                    ],
                    "common_phrases": [
                        "line of latitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воображаемая линия вокруг планеты, проходящая параллельно экватору."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "параллель",
                                "target_lang_sense_clarification": "линия на карте"
                            },
                            {
                                "target_lang_word": "широта",
                                "target_lang_sense_clarification": "линия широты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8cd781d-00c8-3bce-88ac-f644a4fcf48f",
                    "sense_definition": "The freedom to choose what you do or to change how you do something; scope for action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His parents gave him a great deal of <w>latitude</w> in choosing his career.",
                            "target_lang_translations": {
                                "ru": "Родители предоставили ему большую <w>свободу</w> в выборе карьеры."
                            }
                        },
                        {
                            "text": "The manager has considerable <w>latitude</w> to make decisions without consulting the board.",
                            "target_lang_translations": {
                                "ru": "У менеджера есть значительная <w>свобода действий</w> для принятия решений без консультации с советом директоров."
                            }
                        }
                    ],
                    "antonyms": [
                        "restriction",
                        "limitation"
                    ],
                    "common_phrases": [
                        "considerable latitude",
                        "give someone latitude",
                        "wide latitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свобода выбора действий или изменения способов их выполнения; простор для деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свобода",
                                "target_lang_sense_clarification": "отсутствие ограничений в действиях"
                            },
                            {
                                "target_lang_word": "самостоятельность",
                                "target_lang_sense_clarification": "возможность действовать без вмешательства"
                            },
                            {
                                "target_lang_word": "воля",
                                "target_lang_sense_clarification": "свобода действий"
                            },
                            {
                                "target_lang_word": "простор",
                                "target_lang_sense_clarification": "возможность для маневра или действий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "341b6784-204b-3970-9f7c-910acfb4ecb4",
                    "sense_definition": "The range of exposure within which a light-sensitive material will produce an acceptable image.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This film has a wide exposure <w>latitude</w> which helps in difficult lighting.",
                            "target_lang_translations": {
                                "ru": "Эта пленка обладает большой экспозиционной <w>широтой</w>, что помогает при сложном освещении."
                            }
                        },
                        {
                            "text": "Digital sensors often have less <w>latitude</w> than traditional film when highlights are blown.",
                            "target_lang_translations": {
                                "ru": "Цифровые сенсоры часто имеют меньшую <w>широту</w>, чем традиционная пленка, при пересвете ярких участков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "exposure latitude"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Диапазон экспозиции, в пределах которого светочувствительный материал позволяет получить приемлемое изображение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фотографическая широта",
                                "target_lang_sense_clarification": "диапазон экспозиции"
                            },
                            {
                                "target_lang_word": "широта",
                                "target_lang_sense_clarification": "в контексте фотоматериалов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a92d8b41-fe31-33f2-9c07-7793bcd67a18",
                    "sense_definition": "The angular distance of a celestial body from the ecliptic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomers calculate the celestial <w>latitude</w> to determine the position of the star.",
                            "target_lang_translations": {
                                "ru": "Астрономы вычисляют небесную <w>широту</w>, чтобы определить положение звезды."
                            }
                        },
                        {
                            "text": "The planet's orbital <w>latitude</w> varies slightly over long periods of time.",
                            "target_lang_translations": {
                                "ru": "Орбитальная <w>широта</w> планеты незначительно меняется в течение длительных периодов времени."
                            }
                        }
                    ],
                    "common_phrases": [
                        "celestial latitude"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Угловое расстояние небесного тела от эклиптики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "широта",
                                "target_lang_sense_clarification": "астрономическая координата"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}