                    },
                    {
                        "sense_id": "9d050129-2cdc-38b4-a8ae-8b566702c0b3",
                        "entry_id": "ea40c706-afba-37b7-b28d-fa4f20569413",
                        "glosses": [
                            "Träger des Titels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a86a90b-ca6c-414e-b6b9-0932207dff76",
                                "sense_id": "9d050129-2cdc-38b4-a8ae-8b566702c0b3",
                                "text": "Auf ihrer Reise durch Ägypten besuchten sie auch das Grab eines Pharaos."
                            },
                            {
                                "example_id": "7b6cc2db-d191-4714-94cb-cc328b83be2f",
                                "sense_id": "9d050129-2cdc-38b4-a8ae-8b566702c0b3",
                                "text": "„Der Pharao trägt eine feierliche Königstitulatur aus fünf Namen, die ihrerseits jeweils aus mehreren Bestandteilen bestehen können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8330a007-1144-46ec-935f-ffbb0c523e71",
                        "source_entry_id": "ea40c706-afba-37b7-b28d-fa4f20569413",
                        "source_sense_id": "8f926204-6194-37ee-b6fa-a7106d8da270",
                        "source_sense_description": "Titel altägyptischer Könige",
                        "target_lang_word": "pharaoh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pharaoh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13d020e9-dde5-368e-b43a-a04996f5aeb2",
                                        "entry_id": "4d3b4a0b-3bb7-31ae-bfba-374c8b930d39",
                                        "glosses": [
                                            "The supreme ruler of Ancient Egypt; a formal address for the sovereign seat of power as personified by the \\\"king\\\" in an institutional role of Horus son of Osiris; often used by metonymy for Ancient Egyptian sovereignty"
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "784beacd-99bf-4679-95da-644d4b88d718",
                                                "sense_id": "13d020e9-dde5-368e-b43a-a04996f5aeb2",
                                                "text": "Instances: see Thesaurus:pharaoh"
                                            },
                                            {
                                                "example_id": "03bcb817-b988-43af-ba0c-aae45d51d261",
                                                "sense_id": "13d020e9-dde5-368e-b43a-a04996f5aeb2",
                                                "text": "And the Egyptians ſhall know that I am the Lord, when I haue gotten me honour vpon Pharaoh, vpon his charets, and vpon his horſemen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77205a7b-67ea-3897-af96-b4fbf01331e9",
                                        "entry_id": "4d3b4a0b-3bb7-31ae-bfba-374c8b930d39",
                                        "glosses": [
                                            "The card game faro."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88121ec6-f598-4c52-b976-a4201c203db2",
                                                "sense_id": "77205a7b-67ea-3897-af96-b4fbf01331e9",
                                                "text": "\"I pray, when I play pharaoh at White's, that the cards fall as they have come to my hand in this large gamble,\" Anstis said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60e73cd2-3ed3-455d-be1c-10f9eeffb62f",
                        "source_entry_id": "ea40c706-afba-37b7-b28d-fa4f20569413",
                        "source_sense_id": "8f926204-6194-37ee-b6fa-a7106d8da270",
                        "source_sense_description": "Titel altägyptischer Könige",
                        "target_lang_word": "pharaon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pharaon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "beb63c9b-93b3-3caa-9251-e523dc64d677",
                                        "entry_id": "2d6d4ae3-07d9-3d7c-8d4c-07f75aa382b1",
                                        "glosses": [
                                            "Souverain de l’Égypte antique."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f2bba16-3102-4421-9435-2cde49493e2c",
                                                "sense_id": "beb63c9b-93b3-3caa-9251-e523dc64d677",
                                                "text": "Un jour Marcel voulut faire poser Baptiste en costume de pharaon, pour son tableau du Passage de la mer Rouge."
                                            },
                                            {
                                                "example_id": "d7043379-75d5-492a-803f-2cb1cff31389",
                                                "sense_id": "beb63c9b-93b3-3caa-9251-e523dc64d677",
                                                "text": "La combinaison aon se prononce an nasal, a, on nasal, et a-on. Elle a le son nasal an dans faon (petit d’une biche, etc.), […] Partout ailleurs, aon se prononce a-on : Craone (ville de l’arrondissement de Laon), Lycaon (roi d’Arcadie), Phaon (personnage de l’histoire grecque), Pharaons (rois d’Égypte), etc. —Dites kra-òne, lika-on, fa-on, fara-on."
                                            },
                                            {
                                                "example_id": "c4db02fc-90d7-4e4f-bbef-fd7ce0378fc9",
                                                "sense_id": "beb63c9b-93b3-3caa-9251-e523dc64d677",
                                                "text": "Nous semblions entre les maisons\nOnde ouverte de la Mer Rouge\nLui les Hébreux moi Pharaon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b73c9e80-465a-39f2-93e3-af022bd16936",
                                        "entry_id": "2d6d4ae3-07d9-3d7c-8d4c-07f75aa382b1",
                                        "glosses": [
                                            "Pouvoir d’État égyptien."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f1a1235-1ddf-48e1-9e71-0e4191c86953",
                                                "sense_id": "b73c9e80-465a-39f2-93e3-af022bd16936",
                                                "text": "Qu’il y ait un affrontement entre le Prophète et le pharaon dans les pays comme l’Égypte, cela est certain ; c’est un affrontement très ancien […] L’égyptianisme (nationalisme territorial d’État : le pharaon) restera opposé à l’arabo-islamisme (le Prophète) longtemps encore."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pharaon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d306e74b-0e90-3953-ae3d-dae7609e1d99",
                                        "entry_id": "b232d07c-f76f-343c-a0f3-0133f74c5abc",
                                        "glosses": [
                                            "Ancien jeu de cartes ressemblant au lansquenet et se joue entre un banquier et des pontes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a88cfdc-a820-4570-b3b7-2653483398d8",
                                                "sense_id": "d306e74b-0e90-3953-ae3d-dae7609e1d99",
                                                "text": "Le principal théâtre de mes exploits devait être l'hôtel de Transylvanie, où il y avait une table de pharaon dans une salle et divers autres jeux de cartes et de dés dans la galerie."
                                            },
                                            {
                                                "example_id": "df5d9156-aef6-497c-8274-f6a26bd6d286",
                                                "sense_id": "d306e74b-0e90-3953-ae3d-dae7609e1d99",
                                                "text": "On voulut faire un pharaon; nous étions trente assis autour d’une table verte ; mais la conversation était tellement animée, qu’on oubliait de jouer."
                                            },
                                            {
                                                "example_id": "948c5b6c-60de-4630-8d5c-7ac6c3e7d4aa",
                                                "sense_id": "d306e74b-0e90-3953-ae3d-dae7609e1d99",
                                                "text": "En attendant, messieurs, comme vous êtes fort sérieux et encore tout endormis de l’amabilité de l’hôtel Marcilly, jouons à ce jeu italien que je vous ai appris l’autre jour, le pharaon. M. de Vassignies, qui ne le sait pas, taillera ; Goëllo ne pourra pas dire que j’arrange les règles du jeu pour gagner toujours. Qui sait le pharaon ici ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
