                                                "text": "Will these moist trees […]page thy heels"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "025451f8-d1b6-3684-9e0e-e947dbc56da7",
                                        "entry_id": "33f14d0c-536c-3287-8a9d-d712d505ae31",
                                        "glosses": [
                                            "To call or summon (someone)."
                                        ],
                                        "tags": [
                                            "US",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b4a59cd-18bf-3983-8cf3-f117b77797fe",
                                        "entry_id": "33f14d0c-536c-3287-8a9d-d712d505ae31",
                                        "glosses": [
                                            "To contact (someone) by means of a pager or other mobile device."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0756adfd-44ce-413a-83c4-dcc34b00cdbc",
                                                "sense_id": "3b4a59cd-18bf-3983-8cf3-f117b77797fe",
                                                "text": "I'll be out all day, so page me if you need me."
                                            },
                                            {
                                                "example_id": "cb62f748-807a-4fc6-a149-137cb87334e5",
                                                "sense_id": "3b4a59cd-18bf-3983-8cf3-f117b77797fe",
                                                "text": "It's not even eight thirty and Murray is paging me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "717993b6-ce9c-3dcd-ae19-21a483aebc4d",
                                        "entry_id": "33f14d0c-536c-3287-8a9d-d712d505ae31",
                                        "glosses": [
                                            "To call (somebody) using a public address system to find them."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6025f2b-16c0-4044-83f0-78a56388c34e",
                                                "sense_id": "717993b6-ce9c-3dcd-ae19-21a483aebc4d",
                                                "text": "An SUV parked me in. Could you please page its owner?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3a14a14-74a5-47ba-9da3-4a385a9be02e",
                        "source_entry_id": "67d5a41f-05d5-3f06-914b-56ba7cebf09b",
                        "source_sense_id": "4494758f-f0c4-3441-806e-77406d31916e",
                        "target_lang_word": "paje",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paje",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "407f5c50-737f-3743-82a8-f838aab495e1",
                                        "entry_id": "5bde3bf5-62a7-3617-86bb-d2aef4fdd247",
                                        "glosses": [
                                            "Mozo de servicio doméstico personal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c4fad56-24c1-4d29-9f45-e4e7ab4e6d6e",
                                                "sense_id": "407f5c50-737f-3743-82a8-f838aab495e1",
                                                "text": "E tiráronle de la villa muchos tiros de ballestas fuertes, de los quales ninguno le enpesçió; pero fué ferido junto con él el caballo en que venía un paje suyo con una lanza, e el cauallo morió."
                                            },
                                            {
                                                "example_id": "f2d3b53a-21f0-44ab-ac05-11c39bbd6e87",
                                                "sense_id": "407f5c50-737f-3743-82a8-f838aab495e1",
                                                "text": "la dama ni siquiera miró al pobre muchacho, que sintió un dolor inmenso por este desaire, mucho más cuando vio que detrás bajaba el mayor y más antipático de los muchachos, sus rivales, vestido con la historiada librea, desempeñando el papel de paje con más gravedad que él."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "430121ce-647f-349e-8878-f79b8febbc1f",
                                        "entry_id": "5bde3bf5-62a7-3617-86bb-d2aef4fdd247",
                                        "glosses": [
                                            "Aprendiz de grumete."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc282370-40e6-4397-b723-80c6a236e86e",
                                                "sense_id": "430121ce-647f-349e-8878-f79b8febbc1f",
                                                "text": "Pues ahora navegando con este presupuesto, el capitán o maestre y su gente deben ir muy sobre el aviso y recato de no ser salteados, llevando siempre un paje o grumete en la gavia, que descubra la mar a todas partes."
                                            },
                                            {
                                                "example_id": "81f0f053-149c-4ab9-8780-e33418484236",
                                                "sense_id": "430121ce-647f-349e-8878-f79b8febbc1f",
                                                "text": "el artillero de mar gana veinticuatro pesos al mes, el marinero dieciocho, el grumete doce y el paje seis."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fb1762fa-47d9-3a2d-a2ae-a63d1bfe0afb",
                                        "entry_id": "5bde3bf5-62a7-3617-86bb-d2aef4fdd247",
                                        "glosses": [
                                            "Clérigo que presta servicios de paje₁ a un prelado."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcfb4615-1312-44df-a6ec-b51e5ef1b0c7",
                                                "sense_id": "fb1762fa-47d9-3a2d-a2ae-a63d1bfe0afb",
                                                "text": "Y esto procedería de que entonces no llevaban fausto, ni aparato de muchos criados a quien aprovechar porque iban de pueblo en pueblo con sólo un compañero (si era fraile el obispo), o con un clérigo y un paje, o cuando mucho, con un par de pajes, más para compañía que para servicio."
                                            },
                                            {
                                                "example_id": "2e1d5a2f-4478-4aa0-93d3-bff5c760c8db",
                                                "sense_id": "fb1762fa-47d9-3a2d-a2ae-a63d1bfe0afb",
                                                "text": "Como era tarde, el señor obispo había despedido al paje, al secretario, a todos, y se había servido por sí mismo su colación."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b7c3756c-433b-311d-95a1-68028946fb5d",
                                        "entry_id": "5bde3bf5-62a7-3617-86bb-d2aef4fdd247",
                                        "glosses": [
                                            "Dispositivo para recoger las faldas y evitar que arrastren por el suelo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "bbc4d38a-a28e-3f58-ba2f-da83938d8aaf",
                                        "entry_id": "5bde3bf5-62a7-3617-86bb-d2aef4fdd247",
                                        "glosses": [
                                            "Mueble de tocador dotado de un espejo y una balda o mesa."
                                        ],
