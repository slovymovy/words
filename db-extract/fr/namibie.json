        "fr-extract.jsonl": [
            {
                "entry_id": "48a0c07b-0c03-3481-8cd9-03154098ce22",
                "word": "Namibie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bd9e5e4f-84d4-31fb-9a93-902c1df5a3ce",
                        "entry_id": "48a0c07b-0c03-3481-8cd9-03154098ce22",
                        "glosses": [
                            "Pays situé en Afrique australe, entouré à l’ouest par l’océan Atlantique, au nord par l’Angola, au sud par l’Afrique du Sud, à l’est par le Botswana et au nord-est par le Zimbabwe et la Zambie, et dont la capitale est Windhoek."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "e23366eb-7862-45b9-a026-70fda1fd6c4f",
                                "sense_id": "bd9e5e4f-84d4-31fb-9a93-902c1df5a3ce",
                                "text": "Un couple de guépards de Namibie a été relâché dans la nature en Inde, dans le cadre d’un projet visant à réintroduire ces félins, disparus du pays il y a plus de soixante-dix ans, a annoncé dimanche le ministre de l’Environnement, Bhupender Yadav."
                            },
                            {
                                "example_id": "3735d48e-ff3f-45c5-b38b-d2910c9c7cc6",
                                "sense_id": "bd9e5e4f-84d4-31fb-9a93-902c1df5a3ce",
                                "text": "La capitaine Andrés Vilaseca a annoncé la couleur : « Nous nous sommes fixé un objectif : gagner les matchs contre l’Italie et la Namibie. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b24b49f-ed65-4f19-a7bd-3a5296f74481",
                        "source_entry_id": "48a0c07b-0c03-3481-8cd9-03154098ce22",
                        "source_sense_id": "bd9e5e4f-84d4-31fb-9a93-902c1df5a3ce",
                        "target_lang_word": "Namibia",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namibia",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7cc83a8-9511-368b-9c11-9960a1769c3d",
                                        "entry_id": "ac7f885b-1551-37b4-86bd-79009284db00",
                                        "glosses": [
                                            "Staat im Westen Südafrikas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "735b44e0-32e5-4d7c-b7a0-078f3ce1645e",
                                                "sense_id": "f7cc83a8-9511-368b-9c11-9960a1769c3d",
                                                "text": "Für etwa 26.000 der zweieinhalb Millionen Einwohner Namibias ist Deutsch die Muttersprache."
                                            },
                                            {
                                                "example_id": "b6da8245-c3cb-4151-b7a4-888663502b62",
                                                "sense_id": "f7cc83a8-9511-368b-9c11-9960a1769c3d",
                                                "text": "Windhuk ist die Hauptstadt von Namibia."
                                            },
                                            {
                                                "example_id": "94cd86ce-59af-4db2-a3b0-ea394ee7915a",
                                                "sense_id": "f7cc83a8-9511-368b-9c11-9960a1769c3d",
                                                "text": "Das Gebiet des heutigen Namibia wird als einer der ältesten Teile der Erdkruste bezeichnet."
                                            },
                                            {
                                                "example_id": "f5f3b893-c7c0-4737-ab74-c0ae26f2a13a",
                                                "sense_id": "f7cc83a8-9511-368b-9c11-9960a1769c3d",
                                                "text": "„Ahtisaari wurde für sein Lebenswerk als UN-Vermittler geehrt, etwa im Kosovo, aber auch in Indonesien und Namibia.“"
                                            },
                                            {
                                                "example_id": "8034ceca-ebc5-4840-92ec-42fb41d7bf2f",
                                                "sense_id": "f7cc83a8-9511-368b-9c11-9960a1769c3d",
                                                "text": "„Auch wenn die Schätzungen zu Hebungen in Afrika sehr weit auseinandergehen, gibt es doch Hinweise darauf, dass zum Beispiel das Gebirgsgebiet Namibias, welches aktuell bis über 2000 Meter hoch aufragt, in den letzten 10 Millionen Jahren um etwa 1000 Meter angehoben wurde.“"
                                            },
                                            {
                                                "example_id": "d1dca83d-428a-4329-a7b1-35f50ee79dca",
                                                "sense_id": "f7cc83a8-9511-368b-9c11-9960a1769c3d",
                                                "text": "„Der starke Auftrieb im Benguelastrom macht Namibia heute zu einer der größten Fischereinationen der Welt.“"
                                            },
                                            {
                                                "example_id": "0a4943f8-1cf2-44c5-80ec-d1be19b82536",
                                                "sense_id": "f7cc83a8-9511-368b-9c11-9960a1769c3d",
                                                "text": "„Wie sich herausstellte, fuhr auch sie bis nach Namibia.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Namibia",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "046ab31d-a54c-396c-aeb5-a5b822f2b6f5",
                                        "entry_id": "0ed0b125-d2e9-3de8-af54-3586458d4de8",
                                        "glosses": [
                                            "ein Asteroid"
                                        ],
                                        "tags": [],
                                        "examples": [
