                "translations": [
                    {
                        "translation_id": "6126357f-29ba-4dc7-8b51-09c506d5a2b4",
                        "source_entry_id": "232343d1-d8c9-359c-8f66-1d81673ea4f3",
                        "source_sense_id": "ca8bfc36-b499-3c5d-a1bc-4d0459e3c69f",
                        "source_sense_description": "lokale vertegenwoording van een grotere organisatie",
                        "target_lang_word": "Agentur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agentur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5631172e-d35d-392f-9ca0-3e24c89f070a",
                                        "entry_id": "8fb2d451-e90d-3e8b-8815-1cf59699230d",
                                        "glosses": [
                                            "Büro, das Vermittlungsdienstleistungen erbringt oder die Interessenvertretung für seine Kunden übernimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46758814-dfe7-4140-8e59-74aea5bbef61",
                                                "sense_id": "5631172e-d35d-392f-9ca0-3e24c89f070a",
                                                "text": "„Draußen auf der Straße ging der Buchbinder vorüber, der neben seinem Geschäft im Dorf auch die Agentur der Lebens- und Feuerversicherung führte.“"
                                            },
                                            {
                                                "example_id": "31d73787-5023-4423-ae44-ddf56cef1f4d",
                                                "sense_id": "5631172e-d35d-392f-9ca0-3e24c89f070a",
                                                "text": "„Vor Weihnachten hatte ich jemanden besorgt, der für mich bei den Agenturen einsprang, und hatte Hadley geschrieben, sie solle kommen, dann könnten wir über die Feiertage zusammen Ski laufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3fc45c4b-81dd-3cca-9aa6-882f09648d84",
                                        "entry_id": "8fb2d451-e90d-3e8b-8815-1cf59699230d",
                                        "glosses": [
                                            "Nachrichten- oder Presseagentur"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "781ae3b3-3db8-42bc-965f-895b8e1fa010",
                                                "sense_id": "3fc45c4b-81dd-3cca-9aa6-882f09648d84",
                                                "text": "Verschiedene Agenturen brachten zeitgleich die Meldung über den Rücktritt des Ministerpräsidenten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "56ef87d1-83aa-3bfc-9d90-b6c5cb6684de",
                                        "entry_id": "8fb2d451-e90d-3e8b-8815-1cf59699230d",
                                        "glosses": [
                                            "Bundesanstalt oder eine ihrer Filialen"
                                        ],
                                        "tags": [
                                            "seit etwa 2000 in Deutschland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c374617b-60e7-4ed1-b707-f416ab53e597",
                                                "sense_id": "56ef87d1-83aa-3bfc-9d90-b6c5cb6684de",
                                                "text": "Was früher anschaulich „Bundesschuldenverwaltung“ hieß, wurde zunächst in den Euphemismus „Bundeswertpapierverwaltung“ umbenannt und wird jetzt in der „Bundesrepublik Deutschland Finanzagentur GmbH“ mit erledigt."
                                            },
                                            {
                                                "example_id": "3f7fbddf-0d54-4fa2-904c-e923e216a762",
                                                "sense_id": "56ef87d1-83aa-3bfc-9d90-b6c5cb6684de",
                                                "text": "„In Neuköllner und Reinickendorfer Arbeitsagenturen haben Hartz-IV-Empfänger die Möglichkeit, das Geld per Chipkarte an Kassenautomaten in den Agenturen zu ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00bf419e-3d02-4fd1-bd20-83a05f6ca703",
                        "source_entry_id": "232343d1-d8c9-359c-8f66-1d81673ea4f3",
                        "source_sense_id": "ca8bfc36-b499-3c5d-a1bc-4d0459e3c69f",
                        "source_sense_description": "lokale vertegenwoording van een grotere organisatie",
                        "target_lang_word": "agency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab83f932-27bd-3eb0-921c-77ac7e3c68c3",
                                        "entry_id": "29f1faec-8132-3532-861a-0b89907085e6",
                                        "glosses": [
                                            "The capacity, condition, or state of acting or of exerting power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e92919e-e3d5-4fc1-a117-4c4fa732ef9c",
                                                "sense_id": "ab83f932-27bd-3eb0-921c-77ac7e3c68c3",
                                                "text": "A few advances there are in the following papers tending to assert the superintendence and agency of Providence in the natural world."
                                            },
                                            {
                                                "example_id": "5b4d4a3b-2e3f-4239-b86b-78d3a04ffcb9",
                                                "sense_id": "ab83f932-27bd-3eb0-921c-77ac7e3c68c3",
                                                "text": "Because structure in this argument means institutions— pregiven norms, values, beliefs, and practices— it is open-textured, incomplete, cannot guarantee its own applications, therefore, all behavior is action, has agency (Garfinkel 1964; Strauss et al. 1963)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6a76428-cd64-3c73-96f3-308ccb960a9e",
                                        "entry_id": "29f1faec-8132-3532-861a-0b89907085e6",
                                        "glosses": [
                                            "The capacity of individuals to act independently and to make their own free choices."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb5a7e99-2902-4de0-8943-15da6f5df8a5",
                                                "sense_id": "d6a76428-cd64-3c73-96f3-308ccb960a9e",
                                                "text": "moral agency"
                                            },
                                            {
                                                "example_id": "094abd9d-c8a6-4fa0-99ba-a72103f5d28e",
                                                "sense_id": "d6a76428-cd64-3c73-96f3-308ccb960a9e",
                                                "text": "individual agency"
                                            },
                                            {
                                                "example_id": "ce19b860-c475-4b0b-ac16-904188b8c736",
                                                "sense_id": "d6a76428-cd64-3c73-96f3-308ccb960a9e",
                                                "text": "Formally, capitalism performs its fundamental gesture—reappropriation without transformation. This bears on the question of subjective agency because this “reappropriation without transformation” is exactly what agency seeks to avoid; such a process indicates, in fact, that one's agency has failed, that one really had no agency in the first place."
                                            },
                                            {
                                                "example_id": "2e7c39b0-4d38-4117-9283-79ba2a916fd8",
                                                "sense_id": "d6a76428-cd64-3c73-96f3-308ccb960a9e",
                                                "text": "Strictly speaking, at the level of personal agency one could say that power is a condition where one is “enabled.” I would contend that this is a condition of personal agency."
                                            },
                                            {
                                                "example_id": "5a44a9ad-c9eb-4fa9-b5a4-471b13365d85",
                                                "sense_id": "d6a76428-cd64-3c73-96f3-308ccb960a9e",
                                                "text": "The feeling of being in control of one's body should involve the sense of body-ownership, plus an additional sense of agency."
                                            },
                                            {
                                                "example_id": "a44359c7-d5ae-482d-88e7-0ceb78879307",
                                                "sense_id": "d6a76428-cd64-3c73-96f3-308ccb960a9e",
                                                "text": "SCP-3125 incarnated the following winter.\nIts first act upon its arrival — or, depending on the degree of intelligent agency you ascribed to it, the first side-effect of its arrival — was the neutralisation of the Foundation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "005b54cf-bbd5-38e0-b321-5e8b16ee2bfb",
                                        "entry_id": "29f1faec-8132-3532-861a-0b89907085e6",
                                        "glosses": [
                                            "A medium through which power is exerted or an end is achieved."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0076c056-f4df-3bd4-a46a-2eb4889b5b92",
                                        "entry_id": "29f1faec-8132-3532-861a-0b89907085e6",
                                        "glosses": [
                                            "The office or function of an agent; also, the relationship between a principal and that person's agent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab911762-c45d-42a4-8c9c-8939c6dea5a0",
                                                "sense_id": "0076c056-f4df-3bd4-a46a-2eb4889b5b92",
                                                "text": "authority of agency"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71def32a-9b80-396b-b080-78765b3a1dac",
                                        "entry_id": "29f1faec-8132-3532-861a-0b89907085e6",
                                        "glosses": [
                                            "An establishment engaged in doing business for another; also, the place of business or the district of such an agency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22b7c052-6258-44e5-b0b7-6fe75abfb887",
                                                "sense_id": "71def32a-9b80-396b-b080-78765b3a1dac",
                                                "text": "As an employment agency you have a responsibility to supply work to the individual agency worker, as well as a service to the client."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11f90624-722e-3809-a4d4-a6e28858efaa",
                                        "entry_id": "29f1faec-8132-3532-861a-0b89907085e6",
                                        "glosses": [
                                            "A department or other administrative unit of a government; also, the office or headquarters of, or the district administered by, such unit of government."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6059578b-d668-463b-abb2-772d7fd4e30f",
                                                "sense_id": "11f90624-722e-3809-a4d4-a6e28858efaa",
                                                "text": "Agency for Toxic Substances and Disease Registry"
                                            },
                                            {
                                                "example_id": "831e134c-9117-437f-9cfd-bdd02527a377",
                                                "sense_id": "11f90624-722e-3809-a4d4-a6e28858efaa",
                                                "text": "Central Intelligence Agency"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
