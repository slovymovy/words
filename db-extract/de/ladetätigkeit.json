                        "examples": [
                            {
                                "example_id": "39b9785a-19cb-4c1e-98c0-0a99e94e09b7",
                                "sense_id": "8c9d254d-0cba-3fee-99bb-943fc89df3c1",
                                "text": "„Die Exekutive befürchte, es werde durch die Behindertenrampe zu einer Einengung des Gehsteigs kommen, außerdem wäre in diesem Bereich die Ladetätigkeit nicht mehr möglich.“"
                            },
                            {
                                "example_id": "a073cf8b-ab8d-4033-b85e-4dcaa3d0aa02",
                                "sense_id": "8c9d254d-0cba-3fee-99bb-943fc89df3c1",
                                "text": "„Der Clou der neuen Parkscheibe ist nun, dass man auf der Rückseite bis zu 15 Minuten Ladetätigkeit einstellen und seine Telefonnummer eintragen kann - um im Fall einer Behinderung eben schnell erreichbar zu sein.“"
                            }
                        ],
