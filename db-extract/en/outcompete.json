                        "source_sense_id": "399d9dce-c9cd-3279-b906-758ef2a25e88",
                        "source_sense_description": "be much more successful than a competitor",
                        "target_lang_word": "verdrängen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdrängen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c70e8e26-00f5-3101-a5bf-6d9d4ae0844c",
                                        "entry_id": "0cb2a10d-0812-3749-a9a3-58ce165e1beb",
                                        "glosses": [
                                            "jemanden oder etwas von seiner Stelle drängen oder schieben; den Platz von etwas einnehmen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c697194d-20ae-48f2-b2f4-43c2564d9fc4",
                                                "sense_id": "c70e8e26-00f5-3101-a5bf-6d9d4ae0844c",
                                                "text": "Archimedisches Prinzip: Die Auftriebskraft eines Körpers in einem Medium ist genauso groß wie die Gewichtskraft des vom Körper verdrängten Mediums."
                                            },
                                            {
                                                "example_id": "f73d0950-9ebb-43d3-afb6-2fb812783744",
                                                "sense_id": "c70e8e26-00f5-3101-a5bf-6d9d4ae0844c",
                                                "text": "„In den 1970er Jahren verdrängten die aufkommenden Zentralheizungen die bis dahin üblichen Ofenheizungen.“"
                                            },
                                            {
                                                "example_id": "0b00ac1c-2900-4040-a2d0-d2569214b97a",
                                                "sense_id": "c70e8e26-00f5-3101-a5bf-6d9d4ae0844c",
                                                "text": "„Ölheizungen wurden fast völlig vom Markt verdrängt: Im Jahr 2000 war noch jeder fünfte Neubau mit einer Ölheizung ausgestattet, 2022 dann nur noch 0,4 Prozent.“"
                                            },
                                            {
                                                "example_id": "013b8eb2-6753-4487-9e72-ab0ca26c75b3",
                                                "sense_id": "c70e8e26-00f5-3101-a5bf-6d9d4ae0844c",
                                                "text": "In Österreich konnte „Griechischer Wein“ von Udo Jürgens erst 1975, nach 52 Wochen, von der Spitze der Hitparade verdrängt werden in Deutschland schon 1974 nach nur 36 Wochen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b0c667e-6e80-317a-9e25-429ee77c1431",
                                        "entry_id": "0cb2a10d-0812-3749-a9a3-58ce165e1beb",
                                        "glosses": [
                                            "etwas aus seinem Bewusstsein ausschließen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46698e7c-d578-47fc-a4e9-e2a5d1be7a61",
                                                "sense_id": "3b0c667e-6e80-317a-9e25-429ee77c1431",
                                                "text": "„Die meisten Menschen verdrängen die eigene Vergänglichkeit.“"
                                            },
                                            {
                                                "example_id": "e3839193-9e27-4ddb-a478-531587028850",
                                                "sense_id": "3b0c667e-6e80-317a-9e25-429ee77c1431",
                                                "text": "Als Verdrängung wird in der Psychoanalyse ein möglicher Abwehrmechanismus bezeichnet, in dem tabuierte und bedrohliche Bewusstseinsinhalte, die nach Sigmund Freud aus dem Es stammen, mittels des wertenden und verdrängenden Überichs vom Bewusstsein des Menschen ausgeschlossen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
