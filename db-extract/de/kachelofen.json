                    },
                    {
                        "form_id": "8d73d787-4393-4e9c-8a2b-d34a1335f1ff",
                        "entry_id": "4b981ff3-e82f-37bf-965b-959e7de2d80f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kachelöfen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3ef0862-f43a-3a59-af52-e35c2e250be0",
                        "entry_id": "4b981ff3-e82f-37bf-965b-959e7de2d80f",
                        "glosses": [
                            "ein wärmespeicherndes Heizsystem im Wohnraum, meist beheizt mit Holz- oder auch Gasöfen, bei dem die Heizquelle (Brenner) mit Kacheln (geformten Fliesen) ummauert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9885f33e-ec95-409a-aab8-16dd7d005f33",
                                "sense_id": "e3ef0862-f43a-3a59-af52-e35c2e250be0",
                                "text": "Unser Kachelofen erzeugt eine wunderbare Wärme."
                            },
                            {
                                "example_id": "9cf00388-9b23-4380-b1ca-13d1c60f4dc1",
                                "sense_id": "e3ef0862-f43a-3a59-af52-e35c2e250be0",
                                "text": "„Gewissenhaft dienten darüber hinaus den Eichsfeldern solch ruhige Tage, um an den bullernden Kachelöfen den physischen und psychischen Nachlass des verflossenen Jahres zu ordnen.“"
                            },
                            {
                                "example_id": "4ee80c93-cf2b-49d4-950b-693f49337f53",
                                "sense_id": "e3ef0862-f43a-3a59-af52-e35c2e250be0",
                                "text": "„Selbst der alte dunkelbraune Kachelofen steht noch da.“"
                            },
                            {
                                "example_id": "71499a26-2b94-4a57-959d-62d5ce0654b7",
                                "sense_id": "e3ef0862-f43a-3a59-af52-e35c2e250be0",
                                "text": "„In den Wohnungen gab es ein Badezimmer, Stuck an den Decken und Kachelöfen.“"
                            },
                            {
                                "example_id": "7195141f-48a0-4fc2-b65f-f156f33efacb",
                                "sense_id": "e3ef0862-f43a-3a59-af52-e35c2e250be0",
                                "text": "„An jenen Herbstnachmittagen, die sich in Richtung Advent neigten, saßen wir in der Stube, nah am Kachelofen, den Großvater am frühen Morgen, wenn wir noch schliefen, angeheizt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
