                        "form": "die Gedenkstätte"
                    },
                    {
                        "form_id": "638fec58-9216-4dfc-8ad9-a0dd2f6a360d",
                        "entry_id": "df170a5e-a0b7-3f2a-82a9-9a90feba53ea",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gedenkstätten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ce66664-a95f-3f7d-b5ea-1e89f6c8e45c",
                        "entry_id": "df170a5e-a0b7-3f2a-82a9-9a90feba53ea",
                        "glosses": [
                            "ein Platz, der dazu eingerichtet und vorgesehen ist, dass man sich etwas Vergangenes ins Gedächtnis rufen kann/soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "408f86d6-8cd9-4ccb-a4dc-2eb03afad832",
                                "sense_id": "5ce66664-a95f-3f7d-b5ea-1e89f6c8e45c",
                                "text": "„Auf dem Gelände des ehemaligen Lagers ist unter freiem Himmel eine Gedenkstätte entstanden.“"
                            },
                            {
                                "example_id": "6dab3b85-b053-4c69-a71b-572df904f9e1",
                                "sense_id": "5ce66664-a95f-3f7d-b5ea-1e89f6c8e45c",
                                "text": "„Ich mache keinen Unterschied zwischen KZ, Gedenkstätte und Stadt.“"
                            },
                            {
                                "example_id": "7921ea14-743a-4def-9785-e4df64775425",
                                "sense_id": "5ce66664-a95f-3f7d-b5ea-1e89f6c8e45c",
                                "text": "„In ihm sind eine Gedenkstätte, ein Museum und eine Musikbibliothek untergebracht.“"
                            },
                            {
                                "example_id": "26182b13-107e-4897-84de-7d9d7d512571",
                                "sense_id": "5ce66664-a95f-3f7d-b5ea-1e89f6c8e45c",
                                "text": "„Allerhand Flugblätter wurden verteilt, an Allerheiligen war der Besuch der nationalen Gedenkstätten größer als in früheren Jahren.“"
                            },
                            {
                                "example_id": "c3328081-6830-4f52-9fd0-ec52f939bbae",
                                "sense_id": "5ce66664-a95f-3f7d-b5ea-1e89f6c8e45c",
                                "text": "„Das mag besonders schwerfallen am Beispiel der Treptower Gedenkstätte mit dem Bronzekoloß in pathetischer Heldenpose und den stalinistischen Spruchweisheiten an schweren Sarkophagen.“"
                            },
                            {
                                "example_id": "c4efed71-9837-4549-812e-9334d883109e",
                                "sense_id": "5ce66664-a95f-3f7d-b5ea-1e89f6c8e45c",
                                "text": "„Die Stadt Überlingen errichtete 1984 eine Gedenkstätte am Eingang des Stollens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82f9b387-c9dd-412f-b09e-2d722d9cfa2c",
                        "source_entry_id": "df170a5e-a0b7-3f2a-82a9-9a90feba53ea",
                        "source_sense_id": "5ce66664-a95f-3f7d-b5ea-1e89f6c8e45c",
                        "target_lang_word": "memorial",
