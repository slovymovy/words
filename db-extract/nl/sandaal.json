                            "schoeisel"
                        ],
                        "examples": [
                            {
                                "example_id": "97267d19-029a-4719-ab7e-2a7911ccab6b",
                                "sense_id": "1c897ab4-f2f5-342c-8e8d-396cf95ea237",
                                "text": "Een sandaal met sleehak."
                            },
                            {
                                "example_id": "8447ff00-9526-4838-8bf9-725af27fc252",
                                "sense_id": "1c897ab4-f2f5-342c-8e8d-396cf95ea237",
                                "text": "Jesus was er ook bij, een jonge hiker met lang haar, vlassige baard, sandalen en witte kleren."
                            }
                        ]
                    },
                    {
                        "sense_id": "de39d4ea-1560-35f4-9dc7-4509766ada4a",
                        "entry_id": "74e2a7f9-40b2-37a7-827b-ab4876c05aa4",
                        "glosses": [
                            "lange doek met de breedte van de Torarol die vanaf de achterkant ervan met de rol mee wordt gewikkeld"
                        ],
                        "tags": [
