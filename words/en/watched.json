                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He glanced at his <watched> wrist to check the time before leaving.",
                            "target_lang_translations": {
                                "ru": "Он взглянул на свое запястье <с часами>, чтобы проверить время перед уходом.",
