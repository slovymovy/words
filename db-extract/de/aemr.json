        "de-extract.jsonl": [
            {
                "entry_id": "6f1b3f47-69ed-3143-ba9b-7896fc3dd4b5",
                "word": "AEMR",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7feb21f0-9bc4-312d-b4ae-551780aa1588",
                        "entry_id": "6f1b3f47-69ed-3143-ba9b-7896fc3dd4b5",
                        "glosses": [
                            "Allgemeine Erklärung der Menschenrechte"
                        ],
                        "tags": [
                            "Akronym"
                        ],
                        "examples": [
                            {
                                "example_id": "cd9a5c00-9e29-47d8-a90a-ccc761fa1dc7",
                                "sense_id": "7feb21f0-9bc4-312d-b4ae-551780aa1588",
                                "text": "Die AEMR bildet die Grundlage für den internationalen Menschenrechtsschutz und enthält bereits die zentralen politischen, bürgerlichen, wirtschaftlichen, sozialen und kulturellen Menschenrechte."
                            },
                            {
                                "example_id": "70b2600e-9791-4a91-b87b-d3e4a8fb9964",
                                "sense_id": "7feb21f0-9bc4-312d-b4ae-551780aa1588",
                                "text": "Diese wurden seit der Verabschiedung der AEMR im Jahr 1948 kontinuierlich präzisiert und in zahlreichen Konventionen und Resolutionen völkerrechtlich bindend verankert."
                            },
                            {
                                "example_id": "8ecef0bb-df94-4160-b787-61b93c620748",
                                "sense_id": "7feb21f0-9bc4-312d-b4ae-551780aa1588",
                                "text": "Die Allgemeine Erklärung der Menschenrechte (AEMR) nahm nicht nur zahlreiche Inhalte staatlicher Grundrechte auf."
                            },
                            {
                                "example_id": "66767cb5-74fc-4205-a1d7-19666c8c1549",
                                "sense_id": "7feb21f0-9bc4-312d-b4ae-551780aa1588",
                                "text": "Als besonders bedeutsam ist die in Artikel 21 AEMR zum Ausdruck gebrachte Verbindung der Menschrechtsidee mit der Staatsform der Demokratie hervorzuheben."
                            },
                            {
                                "example_id": "9be9a443-e0b8-4073-953a-04dda6021f83",
                                "sense_id": "7feb21f0-9bc4-312d-b4ae-551780aa1588",
                                "text": "Einen Bestandsschutz der in der AEMR aufgeführten Rechte bietet Art. 30 AEMR. Danach darf sich kein Individuum, Gruppe oder Staat auf ein darin verbürgtes Recht oder Freiheit berufen, um ein anderes in der AEMR enthaltenes Recht und Freiheit zu beseitigen (AEMR 1948: 189)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
