                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "972e0a42-ab06-4fe0-93c4-96eda6fe9f67",
                        "entry_id": "c11096dc-dd12-35f4-8179-6b262e5e7826",
                        "tags": [
