                "senses": [
                    {
                        "sense_id": "7af51c77-cebc-3e07-b2a8-e62f06be513f",
                        "entry_id": "b6b424cb-12a8-343d-a80b-8bbbcf398098",
                        "glosses": [
                            "Einstellung, sich (übermäßig) auf die Vergangenheit zu konzentrieren; Haltung, an alten Dingen, an alten Gewohnheiten festhalten zu wollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f68e0f66-ac68-4524-a1c0-00af678c5d07",
                                "sense_id": "7af51c77-cebc-3e07-b2a8-e62f06be513f",
                                "text": "„Wir leisten es uns, eine Tankstelle unter Denkmalschutz zu stellen und vergessen über unserer Vergangenheitsverliebtheit die Zukunft.“"
                            },
                            {
                                "example_id": "d3dcbdf6-64ac-4e19-ae75-d4c915c43d73",
                                "sense_id": "7af51c77-cebc-3e07-b2a8-e62f06be513f",
                                "text": "„So naiv diese Einseitigkeit meiner Ansicht nach ist, als Gegenbewegung zur Vergangenheitsverliebtheit mancher therapeutischer Verfahren ist sie mit Sicherheit wichtig.“"
                            },
                            {
                                "example_id": "1edf38f6-f67a-4806-9c26-3d01c003370f",
                                "sense_id": "7af51c77-cebc-3e07-b2a8-e62f06be513f",
                                "text": "„Ebenso verfehlt wäre, die Notiz mit dem Topos der romantischen Vergangenheitsverliebtheit zu korrelieren.“"
                            },
                            {
                                "example_id": "43ed3196-d988-485e-a247-5d494459c4b7",
                                "sense_id": "7af51c77-cebc-3e07-b2a8-e62f06be513f",
                                "text": "„Ihre Vergangenheitsverliebtheit perfektionierte die inzwischen 32-jährige Elizabeth ‚Lizzy‘ Grant mit Retro-Sound und Vintage-Gebaren auf drei Alben.“"
                            },
                            {
                                "example_id": "13f24f71-2612-49e4-a95d-a86f09138ee6",
                                "sense_id": "7af51c77-cebc-3e07-b2a8-e62f06be513f",
                                "text": "„Ebenso unterhaltsam sind Janelle Monáes neue Songs, mit denen sie sich bei aller Vergangenheitsverliebtheit um einen modernen Sound bemüht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
