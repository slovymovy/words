                                "target_senses": [
                                    {
                                        "sense_id": "b2f1cd25-cc9c-379c-964e-fb33964222ad",
                                        "entry_id": "83f4dac6-a940-35f8-b6d8-f40b1e962138",
                                        "glosses": [
                                            "haşhaş başlarında yapılan çizintilerden sızarak pıhtılaşan süt"
                                        ],
                                        "tags": [],
