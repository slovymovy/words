                    {
                        "sense_id": "06d5215a-ea8c-3c85-8b6e-215e6fc5581f",
                        "entry_id": "3aa6c32b-a995-3cd4-a226-64db4921b552",
                        "glosses": [
                            "Personne chargée d’aider le personnel soignant dans un hôpital."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cf73203-7d65-4200-9ab7-3da8fd99f417",
                                "sense_id": "06d5215a-ea8c-3c85-8b6e-215e6fc5581f",
                                "text": "Deux aides-soignantes venues très tôt m’avaient lavé, soupesé, tourné et retourné, avaient contrôlé la perfusion, pris la température, contrôlé la tension, changé la literie."
                            }
                        ]
                    }
                ],
