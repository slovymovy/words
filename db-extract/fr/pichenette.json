        "fr-extract.jsonl": [
            {
                "entry_id": "2b14835d-ffb8-323b-835e-7019081656ee",
                "word": "pichenette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a0da8c2-aa20-47fe-84ae-6fd01f8ea699",
                        "entry_id": "2b14835d-ffb8-323b-835e-7019081656ee",
                        "tags": [
                            "plural"
                        ],
                        "form": "pichenettes"
                    },
                    {
                        "form_id": "6a9eebef-61bb-4863-b646-95b42284ec95",
                        "entry_id": "2b14835d-ffb8-323b-835e-7019081656ee",
                        "tags": [
                            "Québec"
                        ],
                        "form": "pichenotte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a700c51e-01bb-327e-b357-c30fdaab2168",
                        "entry_id": "2b14835d-ffb8-323b-835e-7019081656ee",
                        "glosses": [
                            "Coup de doigt que l’on donne du majeur ou de l'auriculaire, lorsque, après l’avoir plié et raidi contre le pouce, on le lâche sur le visage, le nez, les oreilles, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10a17c7c-9e9d-40fc-b986-1c2a98937ded",
                                "sense_id": "a700c51e-01bb-327e-b357-c30fdaab2168",
                                "text": "Il jouait on ne sait quel effrayant jeu de cache-cache avec la mort ; chaque fois que la face camarde du spectre s’approchait, le gamin lui donnait une pichenette."
                            },
                            {
                                "example_id": "ec6bc95e-93ee-4a6f-b28e-c3d9ef14ebd6",
                                "sense_id": "a700c51e-01bb-327e-b357-c30fdaab2168",
                                "text": "D’une pichenette il fait disparaître un grain de poussière égaré sur sa manche, puis, automatiquement, en faisant aller les bras, il manœuvre en criant : une, deux ; une, deux."
                            },
                            {
                                "example_id": "f5ddd49f-6fdf-485c-898e-5c2155217942",
                                "sense_id": "a700c51e-01bb-327e-b357-c30fdaab2168",
                                "text": "On remarqua soudain qu’il rajustait sa perruque et faisait des pichenettes sur son jabot, d’où l’on augura que la voiture était en vue."
                            },
                            {
                                "example_id": "626a6858-b65e-4ac0-b166-6af26c9f4880",
                                "sense_id": "a700c51e-01bb-327e-b357-c30fdaab2168",
                                "text": "Tout en trempant le croissant dans le café au lait et donnant des pichenettes à son journal pour qu’il pût se tenir grand ouvert sans qu’elle eût besoin de détourner son autre main des trempettes, elle disait : « Quelle horreur ! Cela dépasse en horreur les plus affreuses tragédies. »"
                            },
                            {
                                "example_id": "ed44ce87-5838-4dba-82bf-73739a37298f",
                                "sense_id": "a700c51e-01bb-327e-b357-c30fdaab2168",
                                "text": "De temps en temps, mon père ouvrait la bouche et attrapait au vol une pastille qu’il avait lancée en l’air d’une pichenette de l’index."
                            },
                            {
                                "example_id": "fa557c14-b8d5-40c9-85db-7b7d3200524a",
                                "sense_id": "a700c51e-01bb-327e-b357-c30fdaab2168",
                                "text": "Vargas inventait des histoires du haut de sa montagne, puis il leur donnait une pichenette et les regardait dévaler la pente."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3304261-c3ce-3733-954a-523dd6ef24bf",
                        "entry_id": "2b14835d-ffb8-323b-835e-7019081656ee",
                        "glosses": [
                            "Dans le contexte des téléphones intelligents, mouvement horizontal ou vertical rapide de l’index sur l’écran tactile."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "620813b1-29da-441f-847a-47ca10553a1a",
                        "source_entry_id": "2b14835d-ffb8-323b-835e-7019081656ee",
                        "target_lang_word": "Schnipser",
                        "target_lang_code": "de",
