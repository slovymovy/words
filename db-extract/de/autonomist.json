                "senses": [
                    {
                        "sense_id": "c382db20-9dc1-3e07-b62d-cc1b433283e8",
                        "entry_id": "993974dd-6f0e-3fa9-867e-3d5718952150",
                        "glosses": [
                            "Person, die eine Autonomie befürwortet, anstrebt und/oder für sie kämpft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "295a87ba-fc92-40dc-a449-1e62895fbcb4",
                                "sense_id": "c382db20-9dc1-3e07-b62d-cc1b433283e8",
                                "text": "„Trotz des Widerstandes errangen die Autonomisten bei den Reichstagswahlen am 10. Januar 1877 fünf Abgeordnetenmandate, obwohl sie noch bei den Wahlen 1874 keinen einzigen Abgeordneten stellen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5ae5230-6d64-4556-acd1-d4690534536f",
                        "source_entry_id": "993974dd-6f0e-3fa9-867e-3d5718952150",
                        "source_sense_id": "c382db20-9dc1-3e07-b62d-cc1b433283e8",
                        "source_sense_description": "Politik: Person, die eine Autonomie befürwortet, anstrebt und/oder für sie kämpft",
                        "target_lang_word": "autonomist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autonomist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b45ef16-ad3c-3214-b02b-f7204f78548b",
                                        "entry_id": "81c6c863-34de-3fb2-b1cf-c724ec77d8be",
                                        "glosses": [
                                            "An advocate of autonomy or autonomism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa676b89-40c5-4326-bb2e-2861a331b106",
                        "source_entry_id": "993974dd-6f0e-3fa9-867e-3d5718952150",
                        "source_sense_id": "c382db20-9dc1-3e07-b62d-cc1b433283e8",
                        "source_sense_description": "Politik: Person, die eine Autonomie befürwortet, anstrebt und/oder für sie kämpft",
                        "target_lang_word": "autonomiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autonomiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1d0a23e-5ecf-3d3c-b53f-b689135c5f47",
                                        "entry_id": "b8b1101d-3b05-3a8d-9d40-59b164ee1299",
                                        "glosses": [
                                            "Relatif à l’autonomie politique d’un groupe humain, ou d’un territoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "328bd0fa-ed30-45cc-8722-76e291671d98",
                                                "sense_id": "d1d0a23e-5ecf-3d3c-b53f-b689135c5f47",
                                                "text": "La propagande autonomiste n’en a cure, elle ne s’efforce pas de persuader, elle intimide et assène des contre-vérités."
                                            },
                                            {
                                                "example_id": "0f1c941d-3066-4596-8d83-79e734cd934c",
                                                "sense_id": "d1d0a23e-5ecf-3d3c-b53f-b689135c5f47",
                                                "text": "« En même temps » corses et français, les insulaires ne sont pas tous ennemis de ce paradoxe du balancement, qui se retrouve également chez les dirigeants autonomistes et nationalistes qu’ils ont élus conjointement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b1d5da6-f93a-36a7-952c-d23179e23d89",
                                        "entry_id": "b8b1101d-3b05-3a8d-9d40-59b164ee1299",
                                        "glosses": [
                                            "Propre à une position selon laquelle le Québec doit activement aller chercher de nouveaux pouvoirs (constitutionnels ou administratifs) auprès du gouvernement fédéral, en refusant le statu quo, mais sans chercher la souveraineté."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dde6b6ed-4bec-498c-aed5-5ab80d285dbb",
                                                "sense_id": "7b1d5da6-f93a-36a7-952c-d23179e23d89",
                                                "text": "Vision autonomiste, projet autonomiste, position autonomiste, discours autonomiste."
                                            },
                                            {
                                                "example_id": "53f5cc75-1a5b-45f4-901f-a033859705b9",
                                                "sense_id": "7b1d5da6-f93a-36a7-952c-d23179e23d89",
                                                "text": "La position autonomiste de Mario Dumont lui permettait déjà de siphonner les votes des péquistes désenchantés soit par le leadership d’André Boiclair, soit par la perspective d’un autre référendum, ou par les deux."
                                            },
                                            {
                                                "example_id": "593c5315-9e6c-4c37-b194-110fdab18472",
                                                "sense_id": "7b1d5da6-f93a-36a7-952c-d23179e23d89",
                                                "text": "Son propos est demeuré ambigu, volontairement peut-on penser, car parler de partition est certainement la meilleure façon pour lui de raviver la polarisation traditionnelle entre fédéralistes et souverainistes pour ainsi ramener au bercail les brebis attirées par le discours autonomiste de Mario Dumont."
                                            },
                                            {
                                                "example_id": "536a4ed6-c872-439d-99c3-50536b325c10",
                                                "sense_id": "7b1d5da6-f93a-36a7-952c-d23179e23d89",
                                                "text": "Ministre responsable des Affaires intergouvernementales canadiennes, Benoît Pelletier est certainement le ministre le plus autonomiste du gouvernement Charest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "autonomiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c8700f7-474a-37d6-9783-23f77efff5f0",
                                        "entry_id": "d511e30a-1cf5-30a6-bf26-3a4c73d7c89d",
                                        "glosses": [
                                            "Personne revendiquant l’autonomie d’un territoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba40500-f2b7-47f9-b269-88b0209cddd5",
                                                "sense_id": "9c8700f7-474a-37d6-9783-23f77efff5f0",
                                                "text": "Les autonomistes ou fédéralistes bretons vont jusqu’à prétendre, au contraire, que la Bretagne est mal traitée, mal desservie, mal outillée, maintenue de parti pris, en état de pauvreté. De telles outrances, il serait superflu de les discuter."
                                            },
                                            {
                                                "example_id": "73e60ae0-5029-44ca-8a83-76a9fc0126f2",
                                                "sense_id": "9c8700f7-474a-37d6-9783-23f77efff5f0",
                                                "text": "Relevons qu’une démarche du même type est pratiquée par les autonomistes corses ou bretons en lutte contre les institutions françaises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5754afd7-36a1-3c89-892f-d3d4249051dc",
                                        "entry_id": "d511e30a-1cf5-30a6-bf26-3a4c73d7c89d",
                                        "glosses": [
                                            "Membre d'un groupuscule libertaire plus ou moins violent."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dd8a853-65de-4696-872e-22763c911138",
                                                "sense_id": "5754afd7-36a1-3c89-892f-d3d4249051dc",
                                                "text": "Deux méfiances sont particulièrement originales. Les « autonomistes » italiens voient poindre à l'horizon un étatisme transidéologique unissant dans une même tentative de domination le parti communiste et la démocratie chrétienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
