{
    "word_family": [
        "jagen",
        "jager",
        "jacht",
        "aanjagen",
        "wegjagen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f793b98-178b-3796-95b6-1d878adb60f7",
                    "sense_definition": "Dieren of mensen uit hun schuilplaats of verblijfplaats verdrijven door ze schrik aan te jagen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verjagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jagers probeerden het wild <w>op</w> te <w>jagen</w> met behulp van getrainde honden.",
                            "target_lang_translations": {
                                "en": "The hunters tried to <w>flush out</w> the game using trained dogs."
                            }
                        },
                        {
                            "text": "Door het harde lawaai <w>joegen</w> ze de vogels uit de struiken <w>op</w>.",
                            "target_lang_translations": {
                                "en": "Because of the loud noise, they <w>startled</w> the birds out of the bushes."
                            }
                        }
                    ],
                    "synonyms": [
                        "opschrikken",
                        "verjagen",
                        "verdrijven"
                    ],
                    "antonyms": [
                        "lokken"
                    ],
                    "common_phrases": [
                        "wild opjagen",
                        "vogels opjagen"
                    ],
                    "target_lang_definitions": {
                        "en": "To drive animals or people out of their hiding place or shelter by scaring them."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flush out",
                                "target_lang_sense_clarification": "to force game or animals out of hiding"
                            },
                            {
                                "target_lang_word": "startle",
                                "target_lang_sense_clarification": "to scare animals into flight"
                            },
                            {
                                "target_lang_word": "drive out",
                                "target_lang_sense_clarification": "to force animals or people to leave a place"
                            },
                            {
                                "target_lang_word": "shoo",
                                "target_lang_sense_clarification": "to scare away birds or small animals"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc6952ed-1b58-385d-92e8-87fcce83ca8e",
                    "sense_definition": "Iemand haasten, onder druk zetten of opjutten om sneller te handelen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "haasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet me niet zo <w>opjagen</w>, want daar ga ik alleen maar meer fouten door maken.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>rush</w> me like that, because it will only make me make more mistakes."
                            }
                        },
                        {
                            "text": "De baas <w>jaagt</w> het personeel voortdurend <w>op</w> om de deadline te halen.",
                            "target_lang_translations": {
                                "en": "The boss is constantly <w>hurrying</w> the staff to meet the deadline."
                            }
                        }
                    ],
                    "synonyms": [
                        "opjutten",
                        "haasten",
                        "opzwepen",
                        "aanjagen"
                    ],
                    "antonyms": [
                        "kalmeren",
                        "geruststellen"
                    ],
                    "common_phrases": [
                        "iemand opjagen",
                        "zichzelf opjagen"
                    ],
                    "target_lang_definitions": {
                        "en": "To hurry someone, put them under pressure, or egg them on to act faster."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rush",
                                "target_lang_sense_clarification": "to force someone to act too quickly"
                            },
                            {
                                "target_lang_word": "hurry",
                                "target_lang_sense_clarification": "to pressure someone to move faster"
                            },
                            {
                                "target_lang_word": "hustle",
                                "target_lang_sense_clarification": "to urge or push someone to act quickly"
                            },
                            {
                                "target_lang_word": "press",
                                "target_lang_sense_clarification": "to put pressure on someone to meet a deadline"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}