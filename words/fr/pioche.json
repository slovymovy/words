                    "frequency": "High",
                    "semantic_group_id": "outil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ouvrier utilise une <w>pioche</w> pour casser la roche avant de poser les tuyaux."
                        },
                        {
                            "text": "Il a pris sa pelle et sa <w>pioche</w> pour préparer la terre du jardin."
                        }
                    ],
                    "synonyms": [
