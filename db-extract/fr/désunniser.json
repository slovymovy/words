                "senses": [
                    {
                        "sense_id": "65de6ab1-85fb-34f2-bd1f-36b9d5145dbb",
                        "entry_id": "9907e761-268c-3dbc-995c-d86fb0fcf58b",
                        "glosses": [
                            "Enlever son caractère sunnite à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e0d35eb-8fe8-438b-adf8-d21e4db49c3b",
                                "sense_id": "65de6ab1-85fb-34f2-bd1f-36b9d5145dbb",
                                "text": "Plutôt que de dé-baasifier et de désunniser grosso modo l’appareil d'État, il fallait inventer une formule qui garantisse à la minorité sunnite arabe d’avoir quand même des intérêts dans le nouveau régime, et c’est ça l’échec de la démocratie en Irak."
                            },
                            {
                                "example_id": "e21a952a-834b-475d-9c39-11d2ccd07132",
                                "sense_id": "65de6ab1-85fb-34f2-bd1f-36b9d5145dbb",
                                "text": "Donc, à long terme, l'Algérie se \"désunnisera\" comme le reste de l'Ancien Monde."
                            }
                        ]
                    }
                ],
