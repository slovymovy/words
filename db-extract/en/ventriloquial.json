                        "glosses": [
                            "Of or relating to ventriloquy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7edb974f-a7e9-478a-83c3-f5985458d069",
                                "sense_id": "5fc053e3-4dd7-3a5b-b2be-e52479fbca7a",
                                "text": "Her voice came, muffled, as if from the back of the top of his head. The ventriloquial effect was startling."
                            },
                            {
                                "example_id": "2ffdecbd-044a-475a-ad1f-80fcd4d491fa",
                                "sense_id": "5fc053e3-4dd7-3a5b-b2be-e52479fbca7a",
                                "text": "Learn the ventriloquial alphabet: A C D E G H I J K L N O Q R S T U X Z"
                            }
                        ]
                    },
                    {
                        "sense_id": "fcdf3f37-9274-3907-92df-5fb80a10a93d",
                        "entry_id": "e3721470-e2f2-38f9-9a71-c3f39409d5ee",
                        "glosses": [
                            "Spoken to oneself."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1dba051-dcfc-4fa3-8cf5-d0c55f597417",
                                "sense_id": "fcdf3f37-9274-3907-92df-5fb80a10a93d",
                                "text": "He threw half-crowns up into the air until they disappeared into the central blue, and then held a ventriloquial conversation, not in the best of taste, with the celestial spirits, who having caught the coins announced their intention of sticking to them."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9e0781d-9ec8-3093-b784-9507b7a0862e",
                        "entry_id": "e3721470-e2f2-38f9-9a71-c3f39409d5ee",
                        "glosses": [
                            "Of bird vocalisations, sounding as though emanating from a location other than where the vocalising bird is."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6398de67-0bfd-4cbd-bed2-80a4b032abe0",
                                "sense_id": "a9e0781d-9ec8-3093-b784-9507b7a0862e",
                                "text": "We tried this a couple of times with no luck whatsoever, partly because whipbirds are notoriously ventriloquial and we could never agree on where the call was coming from."
                            }
                        ]
                    }
