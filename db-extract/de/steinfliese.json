                    {
                        "sense_id": "e0480d95-8aca-36ad-87e1-d87e8fec62c8",
                        "entry_id": "6c3e7eca-a272-3513-88b9-8f06d88af54f",
                        "glosses": [
                            "Fliese, die aus Stein besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "936f322f-f49c-455f-8033-ea4a6a0d2096",
                                "sense_id": "e0480d95-8aca-36ad-87e1-d87e8fec62c8",
                                "text": "„Wir bewegen uns darauf zu, der Tschador meiner Mutter schleift über den Boden, sie schwebt über die spiegelglatten Steinfliesen wie ein schwarzer Engel.“"
                            },
                            {
                                "example_id": "d1c1b224-ddd5-4d4c-afee-8756d55813f7",
                                "sense_id": "e0480d95-8aca-36ad-87e1-d87e8fec62c8",
                                "text": "„Die Finger lagen lose um die Zigarette, schnippten in regelmäßigen Abständen die Asche auf die Steinfliesen, wo sie sich aufzulösen schien und verschwand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
