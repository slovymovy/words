                    "sense_id": "82ba82de-4b30-3279-a745-78701e4157b2",
                    "sense_definition": "zu keiner Zeit; zu keinem Zeitpunkt",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "zeitpunkt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich werde <w>nie</w> mit dir in dieses Restaurant gehen.",
                            "target_lang_translations": {
                                "en": "I will <w>never</w> go to this restaurant with you.",
                                "ru": "Я <w>никогда</w> не пойду с тобой в этот ресторан.",
                                "nl": "Ik zal <w>nooit</w> met jou naar dit restaurant gaan.",
                                "pl": "<w>Nigdy</w> nie pójdę z tobą do tej restauracji.",
                                "fr": "Je n'irai <w>jamais</w> dans ce restaurant avec toi.",
                                "it": "Non andrò <w>mai</w> in questo ristorante con te.",
                                "cs": "S tebou do téhle restaurace <w>nikdy</w> nepůjdu.",
                                "tr": "Seninle bu restorana <w>asla</w> gitmeyeceğim.",
                                "es": "<w>Nunca</w> iré a este restaurante contigo.",
                                "zh": "我<w>决不</w>会和你一起去这家餐馆。"
                            }
                        },
                        {
                            "text": "Wir haben noch <w>nie</w> eine so schöne Stadt gesehen.",
                            "target_lang_translations": {
                                "en": "We have <w>never</w> seen such a beautiful city before.",
                                "ru": "Мы ещё <w>никогда</w> не видели такого красивого города.",
                                "nl": "We hebben nog <w>nooit</w> zo'n mooie stad gezien.",
                                "pl": "Jeszcze <w>nigdy</w> nie widzieliśmy tak pięknego miasta.",
                                "fr": "Nous n'avons encore <w>jamais</w> vu une aussi belle ville.",
                                "it": "Non abbiamo ancora <w>mai</w> visto una città così bella.",
                                "cs": "Ještě <w>nikdy</w> jsme neviděli tak krásné město.",
                                "tr": "Daha önce <w>hiç</w> bu kadar güzel bir şehir görmemiştik.",
                                "es": "<w>Nunca</w> habíamos visto una ciudad tan hermosa.",
                                "zh": "我们还<w>从未</w>见过如此美丽的城市。"
                            }
                        }
                    ],
                    "synonyms": [
