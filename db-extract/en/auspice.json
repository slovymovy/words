                    {
                        "translation_id": "82ad4a1d-36ef-4f36-bca8-a8d1ef34e78e",
                        "source_entry_id": "e4d35695-9899-3b3b-be77-75e85e07dcdb",
                        "source_sense_description": "patronage",
                        "target_lang_word": "проте́кция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "проте́кция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "25f30d4a-d6ba-305c-80ad-40323c6ccbd0",
                                        "entry_id": "2e941397-eb5f-3398-827a-6c8e13701b1c",
                                        "glosses": [
                                            "покровительство, влиятельная поддержка со стороны кого-либо в устройстве чьих-либо дел"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb98cb4a-793e-4ef3-b8d0-eda29f22fde8",
                                                "sense_id": "25f30d4a-d6ba-305c-80ad-40323c6ccbd0",
                                                "text": "Князь Андрей, любивший покровительственные отношения к молодым людям, польщенный тем, что к нему обращались за протекцией, и хорошо расположенный к Борису, который умел ему понравиться накануне, желал исполнить желание молодого человека."
                                            },
                                            {
                                                "example_id": "e7991f59-b29e-4d21-ae6d-75980dbe9abe",
                                                "sense_id": "25f30d4a-d6ba-305c-80ad-40323c6ccbd0",
                                                "text": "Бескорыстием и прочими административными добродетелями им надо было только прикрываться, чтобы заслужить любовь главы, получить его дочь, а стало быть, и протекцию и покровительство."
                                            },
                                            {
                                                "example_id": "be7c4b62-d487-4a61-81c3-e0a064fd89d5",
                                                "sense_id": "25f30d4a-d6ba-305c-80ad-40323c6ccbd0",
                                                "text": "Сам поверенный, которого я встречал на горных заводах, был одной из тех неопределенных и бесцветных личностей, которыми особенно богато наше время; они являются неизвестно откуда, по каким-то таинственнейшим протекциям занимают самые теплые местечки, наживают кругленькие капиталы и исчезают неизвестно куда."
                                            },
                                            {
                                                "example_id": "09209a79-5894-4c15-861c-494d1a8adc15",
                                                "sense_id": "25f30d4a-d6ba-305c-80ad-40323c6ccbd0",
                                                "text": "Приехал в хвосте генерал-губернаторской свиты и, благодаря столичной протекции, получил тёплое место на приисках."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c4741b1-e1cd-4d44-8b3a-27442ff45402",
                        "source_entry_id": "e4d35695-9899-3b3b-be77-75e85e07dcdb",
                        "source_sense_description": "omen",
                        "target_lang_word": "voorteken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voorteken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "64d21714-eba9-3a8b-86a0-b06d7f07f71b",
                                        "entry_id": "48da7cad-cb53-3b4a-b824-656ce601dc3f",
                                        "glosses": [
                                            "een min of meer vaag signaal dat aan een gebeurtenis voorafgaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea48fdcc-f8ce-497f-a80b-dc0c3bd04790",
                                                "sense_id": "64d21714-eba9-3a8b-86a0-b06d7f07f71b",
                                                "text": "De ratten verlaten het schip, dat is een ongunstig voorteken."
                                            },
                                            {
                                                "example_id": "a16b8385-9da2-4165-b732-bf1b70d1f5e6",
                                                "sense_id": "64d21714-eba9-3a8b-86a0-b06d7f07f71b",
                                                "text": "Maar wij hebben steeds meer energie gestoken in het rationeel doorgronden van natuurlijke gebeurtenissen: er zijn geen voortekenen of openbaringen meer, geen vloeken of profetieën; onze toekomst zal niet in godshuizen maar in laboratoria worden ontsluierd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4b899cc-497d-3c9f-901c-fe53c617aa59",
                                        "entry_id": "48da7cad-cb53-3b4a-b824-656ce601dc3f",
                                        "glosses": [
                                            "het voor een getal genoteerde plus- of minteken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8a694f-b97f-4788-8a17-a726aeee8c10",
                                                "sense_id": "b4b899cc-497d-3c9f-901c-fe53c617aa59",
                                                "text": "Negatieve getallen worden genoteerd met het voorteken “-”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a08236f5-abd6-3b05-b85f-90833a6626d8",
                                        "entry_id": "48da7cad-cb53-3b4a-b824-656ce601dc3f",
                                        "glosses": [
                                            "een symbool op of tussen de lijnen van een notenbalk dat aangeeft dat vanaf dat punt, de toonhoogte hoger (kruis) of lager (mol) moet zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd7f51e9-2af2-41fc-9ff1-978587eac336",
                                                "sense_id": "a08236f5-abd6-3b05-b85f-90833a6626d8",
                                                "text": "Zonder verdere aanwijzingen blijft het voorteken van kracht tot de maatstreep."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voorteken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ecbc2683-ba1a-39dc-8fe6-ade78b4e15fd",
                                        "entry_id": "0895fff5-9014-3d0a-8492-4008418e6af9",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van voortekenen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "with-subordinate-clause"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0bc12d0-547f-4566-8192-2e5b4ee5eee6",
                                                "sense_id": "ecbc2683-ba1a-39dc-8fe6-ade78b4e15fd",
                                                "text": "... dat ik voorteken."
                                            }
