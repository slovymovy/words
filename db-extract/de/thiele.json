                ],
                "senses": [
                    {
                        "sense_id": "01800600-4a6a-315f-9a5a-c901fe182dff",
                        "entry_id": "8c904c70-dad2-3281-998a-7a377542c24a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a15829f-6518-4833-9eb4-c05f1b0fce7e",
                                "sense_id": "01800600-4a6a-315f-9a5a-c901fe182dff",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Thiele kommt, geht der Herr Thiele.“"
                            },
                            {
                                "example_id": "efb496cc-b072-4627-bfc5-0e971db4105e",
                                "sense_id": "01800600-4a6a-315f-9a5a-c901fe182dff",
                                "text": "Thiele kommt und geht."
                            },
                            {
                                "example_id": "da36a294-5809-4ee7-9c4f-873af15f2049",
                                "sense_id": "01800600-4a6a-315f-9a5a-c901fe182dff",
                                "text": "Thieles kamen, sahen und siegten."
                            },
                            {
                                "example_id": "21173665-000c-4fa5-9152-53e70261a33c",
                                "sense_id": "01800600-4a6a-315f-9a5a-c901fe182dff",
                                "text": "Der Thiele trägt nie die Schals, die die Thiele ihm strickt."
                            },
                            {
                                "example_id": "9b90ee5a-0bc7-4082-9ad0-6c012a97cbfc",
                                "sense_id": "01800600-4a6a-315f-9a5a-c901fe182dff",
                                "text": "Frau Thiele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ee6a62d6-b65f-44ea-8653-d7142e157e07",
                                "sense_id": "01800600-4a6a-315f-9a5a-c901fe182dff",
                                "text": "Herr Thiele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c79305a9-5dbe-4d86-b02a-c67537dbc800",
                                "sense_id": "01800600-4a6a-315f-9a5a-c901fe182dff",
                                "text": "Die Thieles fahren heute nach Magdeburg."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
