                    {
                        "form_id": "0bdac839-422f-40a9-929b-a95c3179f5ec",
                        "entry_id": "cc1ed10f-42a2-3cdd-915e-2548e02969a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "Fragewörter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0bb0a13-7531-3851-b529-6e9f6ed9e282",
                        "entry_id": "cc1ed10f-42a2-3cdd-915e-2548e02969a0",
                        "glosses": [
                            "soru zamiri"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc7a704-16d9-4ec5-b13f-608df6f98f20",
                                "sense_id": "e0bb0a13-7531-3851-b529-6e9f6ed9e282",
                                "text": "Der Satz „Wann kommt Peter zu Besuch?“ enthält mit „wann\" ein Frageadverb als Fragewort.",
                                "translation": "\"Peter ne zaman ziyarete geliyor?\" cümlesi, soru kelimesi \"ne zaman\" olan bir soru zamiri ihtiva eder."
                            },
                            {
                                "example_id": "a22037a3-4715-481f-899a-46cd2e32a8ec",
                                "sense_id": "e0bb0a13-7531-3851-b529-6e9f6ed9e282",
                                "text": "„Aneinandergereihte Fragen oder Fragewörter können mit Komma verbunden werden.“",
                                "translation": "Dizili sorular veya soru zamirleri virgülle birbirine bağlanabilir."
                            },
                            {
                                "example_id": "3107c857-d9c1-428f-af7a-5abe4647cebe",
                                "sense_id": "e0bb0a13-7531-3851-b529-6e9f6ed9e282",
                                "text": "Der Satz „Wer kommt heute zu Besuch?“ enthält mit „wer“ ein Fragepronomen als Fragewort.",
                                "translation": "\"Bugün ziyarete kim geliyor?\" cümlesi soru zamiri olarak \"kim\" ile bir soru zamiri ihtiva eder."
                            },
                            {
                                "example_id": "90dd51a5-9c98-41ab-9ce6-e586bc9d4e24",
                                "sense_id": "e0bb0a13-7531-3851-b529-6e9f6ed9e282",
                                "text": "„Man nennt diese Fürwörter Fragewörter (Interrogativpronomen). Beisp. Wer wohnt in diesem Hause? Was trinkst Du?“",
                                "translation": "Bu zamirlere soru zamirleri denir. Mes. Bu evde kim yaşıyor? Ne içiyorsun?"
                            }
                        ]
                    }
                ],
