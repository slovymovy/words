                "senses": [
                    {
                        "sense_id": "dfd1e9d2-b01d-33fa-b137-409b674b235e",
                        "entry_id": "86634ccc-74a4-3cc4-9ca0-a1be4cca0b07",
                        "glosses": [
                            "Sorte de bière brassée dans les environs de la ville de Chimay."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "308c3f4c-c158-4450-97bf-9a2b2e0d6a99",
                                "sense_id": "dfd1e9d2-b01d-33fa-b137-409b674b235e",
                                "text": "Chez moi, je me suis décapsulé une Chimay rouge histoire de voir venir. Deux mois ! Je dégustais un bonheur à peine supportable tellement il coulait vite et fort dans mes veines."
                            },
                            {
                                "example_id": "21a21d6d-7c1f-45c3-aa62-80ffa4bfe7a4",
                                "sense_id": "dfd1e9d2-b01d-33fa-b137-409b674b235e",
                                "text": "— Qu'est-ce qu'on boit là-dessus ? Une Chimay ? Qui prendra une Chimay ? De deux choses l'une, j'en ai de la bleue, j'en ai de la rouge !"
                            },
                            {
                                "example_id": "20818041-f21a-4c37-ba47-727f62643e19",
                                "sense_id": "dfd1e9d2-b01d-33fa-b137-409b674b235e",
                                "text": "Encore deux Chimay, avec du fromage, patron ! réclama Sébastien."
                            }
                        ]
                    }
