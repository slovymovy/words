                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a8bac0d-d4c4-3b1e-8e33-ebf92ccbcfa6",
                        "entry_id": "241cf256-c8fe-3c49-87b6-bbc6831c24a4",
                        "glosses": [
                            "A heavy weatherproof jacket with an attached hood; a parka or windcheater."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f7b868c-33e5-41ae-8b54-7d011e17cb60",
                                "sense_id": "1a8bac0d-d4c4-3b1e-8e33-ebf92ccbcfa6",
                                "text": "Don't ever use the hood on your anorak; and, if you do, for heaven's sake don't pull the string tight so that you peep out like a little baby in a siren suit."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6214d1f-1008-3e90-b7ea-7bb85c71dc39",
                        "entry_id": "241cf256-c8fe-3c49-87b6-bbc6831c24a4",
                        "glosses": [
                            "A person with an unusual or obsessive interest in a niche subject, especially trains."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "901b3cf1-3d84-429d-a42b-1d5eae9ea80f",
                                "sense_id": "f6214d1f-1008-3e90-b7ea-7bb85c71dc39",
                                "text": "He has described himself as the uber-geek, an anorak's anorak, a standard bearer for fellow Star Trekkies everywhere, and his air of bland, amiable bafflement has served him remarkably well in a string of TV and film roles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c699386-ae0f-44b2-9f46-c2bca9a8d270",
                        "source_entry_id": "241cf256-c8fe-3c49-87b6-bbc6831c24a4",
                        "source_sense_description": "heavy weatherproof jacket",
                        "target_lang_word": "bunda",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bunda",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "f90b73ae-8e81-330b-8e0b-71904af1f7d1",
                                        "entry_id": "d340dcd0-5065-38eb-8459-1899540253a9",
                                        "glosses": [
                                            "druh svrchního oblečení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18c881d3-9bff-4b7a-b7a7-9b537818c848",
                                                "sense_id": "f90b73ae-8e81-330b-8e0b-71904af1f7d1",
                                                "text": "Chci si koupit bundu Diesel, ale nemám na ni."
                                            },
                                            {
                                                "example_id": "c8dd7a96-71f4-4e5b-ad94-659bb31ead69",
                                                "sense_id": "f90b73ae-8e81-330b-8e0b-71904af1f7d1",
                                                "text": "Když mám na sobě koženou italskou bundu za 2 tisíce euro, tak na mě ženský dost koukají."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5749bc77-3969-4d00-b1cb-045d46c03d84",
                        "source_entry_id": "241cf256-c8fe-3c49-87b6-bbc6831c24a4",
                        "source_sense_description": "heavy weatherproof jacket",
                        "target_lang_word": "zimní bunda",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "54da2be7-db5e-49b7-a047-f604abfc5322",
                        "source_entry_id": "241cf256-c8fe-3c49-87b6-bbc6831c24a4",
