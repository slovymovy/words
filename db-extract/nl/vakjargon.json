                "senses": [
                    {
                        "sense_id": "1596607d-af04-32f2-985e-328c56ecb375",
                        "entry_id": "02744bb2-5b0f-3919-9e1a-a613b46323db",
                        "glosses": [
                            "woorden en uitdrukkingen die alleen binnen één bepaald vakgebied worden gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b65115a-6a60-459d-99c2-56256e3471e7",
                                "sense_id": "1596607d-af04-32f2-985e-328c56ecb375",
                                "text": "Over dat percentage, in het vakjargon de output floor genoemd, is jarenlang gesteggeld. Europa wilde minder strenge regels dan de Verenigde Staten, en had liefst een output floor van 70 procent gezien. De VS pleitten eerst voor 80 procent, daarna voor 75 procent. Amerikaanse banken kunnen die strenge eisen beter de baas, omdat ze minder hypotheekleningen op hun balans hebben."
                            },
                            {
                                "example_id": "5dc5fb5b-be01-4501-bb68-627cd4d88b15",
                                "sense_id": "1596607d-af04-32f2-985e-328c56ecb375",
                                "text": "De box bereid jonge meisjes voor op de eerste menstruatie, of zoals de dames inmiddels inmiddels in vakjargon zeggen: de menarche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a67d03f-b2a5-4b25-91db-4a37484140ac",
                        "source_entry_id": "02744bb2-5b0f-3919-9e1a-a613b46323db",
                        "source_sense_id": "1596607d-af04-32f2-985e-328c56ecb375",
                        "target_lang_word": "Fachsprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fachsprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23081ca0-9061-3f0a-9a48-12864716629c",
                                        "entry_id": "a7a6ab2e-9d0d-3015-8458-ee481aed9df8",
                                        "glosses": [
                                            "die für ein bestimmtes Fach spezifischen Sprachformen und Begriffe"
                                        ],
                                        "tags": [
                                            "Soziolinguistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57612a23-8fb8-4ea1-bfe3-9dded9a409f1",
                                                "sense_id": "23081ca0-9061-3f0a-9a48-12864716629c",
                                                "text": "Das Wichtigste an Fachsprachen ist ihr Fachwortschatz, also die Gesamtheit der Fachwörter."
                                            },
                                            {
                                                "example_id": "e05a97c0-a7a2-4385-ad2c-30793db612c3",
                                                "sense_id": "23081ca0-9061-3f0a-9a48-12864716629c",
                                                "text": "„Zu letzteren gehören beispielsweise solche nach Berücksichtigung der gesprochenen Sprache sowie von Szene- oder bestimmten Fachsprachen.“"
                                            },
                                            {
                                                "example_id": "26db6ba6-31bf-469b-8017-89b732e1b778",
                                                "sense_id": "23081ca0-9061-3f0a-9a48-12864716629c",
                                                "text": "„Aber auch in der Alltagssprache der Menschen in beiden Staaten wie in den Fachsprachen gab es die eine oder andere Unterschiedlichkeit.“"
                                            },
                                            {
                                                "example_id": "c35aa0b2-aa37-448b-a6a1-bf7ac1401c49",
                                                "sense_id": "23081ca0-9061-3f0a-9a48-12864716629c",
                                                "text": "„Nicht nur die Anschauungen über Erotik, Sexualität und Pornographie waren und sind einem ständigen Wandel unterworfen, sondern auch die auf sie referierenden »Wörter der Lust« - in der Gemeinsprache, in der Fachsprache, in der Sondersprache, in der Regionalsprache und in den Dialekten.“"
                                            },
                                            {
                                                "example_id": "ecd124b8-4532-4309-af5e-3498af012a73",
                                                "sense_id": "23081ca0-9061-3f0a-9a48-12864716629c",
                                                "text": "„Es handelt sich um terminologisierte Wörter, die einen wesentlichen Bestandteil der Fachsprachen ausmachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a13f8353-4425-3d89-bc90-80e7db6a3970",
                                        "entry_id": "a7a6ab2e-9d0d-3015-8458-ee481aed9df8",
                                        "glosses": [
                                            "alle in einem bestimmten Fach verwendeten Sprachformen und Begriffe"
                                        ],
                                        "tags": [
                                            "Soziolinguistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13884fba-c660-4ba8-8f86-ad21dc4ee34d",
                                                "sense_id": "a13f8353-4425-3d89-bc90-80e7db6a3970",
                                                "text": "Das Wichtigste an Fachsprachen ist ihr Fachwortschatz, also die Gesamtheit der Fachwörter."
                                            },
                                            {
                                                "example_id": "dadaa370-8651-4bb8-aff1-349d18c8bd04",
                                                "sense_id": "a13f8353-4425-3d89-bc90-80e7db6a3970",
                                                "text": "„Zu letzteren gehören beispielsweise solche nach Berücksichtigung der gesprochenen Sprache sowie von Szene- oder bestimmten Fachsprachen.“"
                                            },
                                            {
                                                "example_id": "b0c97351-6086-479e-beb3-737d40e0e54c",
                                                "sense_id": "a13f8353-4425-3d89-bc90-80e7db6a3970",
                                                "text": "„Aber auch in der Alltagssprache der Menschen in beiden Staaten wie in den Fachsprachen gab es die eine oder andere Unterschiedlichkeit.“"
                                            },
                                            {
                                                "example_id": "665b660f-0311-4c5f-a200-65f6afd09127",
                                                "sense_id": "a13f8353-4425-3d89-bc90-80e7db6a3970",
                                                "text": "Fachsprache wird nach den Ebenen der Kommunikation eingeteilt in „»wissenschaftliche Fachsprache« (Wissenschaftssprache/Theoriesprache), »Werkstattsprache« (Betriebssprache, Produktionssprache) und »Verkäufersprache« (Verkaufssprache, Verteilersprache) […]“"
                                            },
                                            {
                                                "example_id": "3b292e9c-9235-4f85-958b-c67c9daed85a",
                                                "sense_id": "a13f8353-4425-3d89-bc90-80e7db6a3970",
                                                "text": "„Die meisten Fachsprachen sind regional beschränkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7b408c6-3752-47d4-88a1-e3033ceea639",
                        "source_entry_id": "02744bb2-5b0f-3919-9e1a-a613b46323db",
                        "source_sense_id": "1596607d-af04-32f2-985e-328c56ecb375",
                        "target_lang_word": "Fachjargon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fachjargon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                                        "entry_id": "8c58b2c1-c5fe-309b-b9f8-d268bd364821",
                                        "glosses": [
                                            "Fachsprache, mit speziellen Fachausdrücken erweiterte Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "131d5d9d-ca13-4c6b-bb69-9e2c44bf6f01",
                                                "sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                                                "text": "Die Vorträge wurden im Fachjargon geführt, so dass ein Nichtfachmann kaum etwas verstand."
                                            },
                                            {
                                                "example_id": "802b495f-a9af-4adb-b9de-dbd780a6d5ac",
                                                "sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                                                "text": "„Hier sind wir in einem anderen Bereich, auf einer anderen Kommunikationsstufe der Sportsprache, die man als Fachjargon oder auch als Sportlersprache bezeichnet hat.“"
                                            },
                                            {
                                                "example_id": "0624cef9-fc32-4baf-a725-ac1fda3d0a10",
                                                "sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                                                "text": "„Es ärgerte mich, daß ich nicht wenigstens den Fachjargon beherrschte.“"
                                            },
                                            {
                                                "example_id": "abd58e1f-8426-426d-bd10-c832040e60c2",
                                                "sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                                                "text": "„Im wissenschaftlichen Fachjargon nennt man so etwas »Falsifizierbarkeit«.“"
                                            },
                                            {
                                                "example_id": "365fee43-f208-4425-b1fc-740e5315d454",
                                                "sense_id": "dca52ad1-3790-3c81-8413-4440cb3e7280",
                                                "text": "„Fachjargon ist dabei noch ein harmloser Ausdruck für das Wissenschaftsdeutsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d1145ac-4362-4799-be8c-9e40ec24677f",
                        "source_entry_id": "02744bb2-5b0f-3919-9e1a-a613b46323db",
                        "source_sense_id": "1596607d-af04-32f2-985e-328c56ecb375",
