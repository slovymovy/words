{
    "word_family": [
        "part-time",
        "overtime",
        "timekeeper"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f4c3610f-a141-31ec-a231-dc1e153c365b",
                    "sense_definition": "Occupying or using the whole of someone's available working time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "employment_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is looking for a <w>fulltime</w> job after graduating from university this summer.",
                            "target_lang_translations": {
                                "ru": "Она ищет работу на <w>полную ставку</w> после окончания университета этим летом."
                            }
                        },
                        {
                            "text": "The company offers a <w>fulltime</w> position with health insurance and other benefits.",
                            "target_lang_translations": {
                                "ru": "Компания предлагает <w>полноценную</w> должность с медицинской страховкой и другими льготами."
                            }
                        }
                    ],
                    "synonyms": [
                        "full-time"
                    ],
                    "antonyms": [
                        "part-time"
                    ],
                    "common_phrases": [
                        "fulltime job",
                        "fulltime employment",
                        "fulltime position",
                        "fulltime student"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимающий всё стандартное рабочее время человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "о рабочем дне или ставке"
                            },
                            {
                                "target_lang_word": "полноценный",
                                "target_lang_sense_clarification": "о занятости или позиции"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7839c4c6-57d6-3248-b917-71ee958869d9",
                    "sense_definition": "On a basis that occupies the whole of the standard working week.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "employment_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to work <w>fulltime</w> to save enough money for a new car.",
                            "target_lang_translations": {
                                "ru": "Он решил работать <w>полный рабочий день</w>, чтобы накопить достаточно денег на новую машину."
                            }
                        },
                        {
                            "text": "Many people prefer to work <w>fulltime</w> because it provides a more stable income.",
                            "target_lang_translations": {
                                "ru": "Многие люди предпочитают работать <w>на полную ставку</w>, потому что это обеспечивает более стабильный доход."
                            }
                        }
                    ],
                    "synonyms": [
                        "full-time"
                    ],
                    "antonyms": [
                        "part-time"
                    ],
                    "common_phrases": [
                        "work fulltime",
                        "employed fulltime",
                        "study fulltime"
                    ],
                    "target_lang_definitions": {
                        "ru": "На основе, которая занимает всю стандартную рабочую неделю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на полную ставку",
                                "target_lang_sense_clarification": "о режиме работы"
                            },
                            {
                                "target_lang_word": "полный рабочий день",
                                "target_lang_sense_clarification": "о графике работы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}