                                "target_senses": [
                                    {
                                        "sense_id": "29943a7f-5907-3307-a650-cc9388e21d58",
                                        "entry_id": "2d6ec17f-e2c7-37b3-9116-4bb23776914d",
                                        "glosses": [
                                            "Designed to be worn with comfort by people with a wide range of sizes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d5f2319-162c-3ca9-a2ad-9dc0363aa305",
                                        "entry_id": "2d6ec17f-e2c7-37b3-9116-4bb23776914d",
                                        "glosses": [
                                            "Suitable for a wide range of tastes, opinions, situations, etc."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "not-comparable",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c86d178-a4d7-46c8-a25e-4ec6b0ac6669",
                                                "sense_id": "3d5f2319-162c-3ca9-a2ad-9dc0363aa305",
                                                "text": "Long before popular music evolved its many genres and subgenres, the industry was driven by a simple one-size-fits-all philosophy uncomplicated by impassioned debates over the origins of trip hop or the difference between deatchore and screamo."
                                            },
                                            {
                                                "example_id": "e1fd27e4-c2f5-487b-9b79-79bf61aef212",
                                                "sense_id": "3d5f2319-162c-3ca9-a2ad-9dc0363aa305",
                                                "text": "What about overcrowding?\n[…] DfT admits that there is no one-size-fits-all approach and that individual operators are best placed to implement locally based safety plans."
                                            },
                                            {
                                                "example_id": "ec848835-96d9-403d-b8af-5c8cb4af7477",
                                                "sense_id": "3d5f2319-162c-3ca9-a2ad-9dc0363aa305",
                                                "text": "As with other tourist lines, actual peak demand is from mid-morning to late afternoon - 'off peak' in conventional fares jargon. This can (and does) result in overcrowding at off-peak times and near empty trains at 'peak' hours. National one-size-fits-all simply does not apply on the S&C."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
