                        "source_sense_id": "02acc581-aca4-3320-9d6c-f27c33ed5965",
                        "source_sense_description": "etwas, das live übertragen wird, meistens per Fernsehen, Internet oder Radio",
                        "target_lang_word": "прямой эфир",
