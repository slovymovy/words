                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dirigent sloeg de <w>maat</w> met zijn stokje.",
                            "target_lang_translations": {
                                "en": "The conductor beat <w>time</w> with his baton.",
                                "ru": "Дирижер отбивал <w>такт</w> своей палочкой.",
                                "pl": "Dyrygent wybijał <w>takt</w> swoją batutą.",
                                "de": "Der Dirigent schlug den <w>Takt</w> mit seinem Taktstock.",
                                "fr": "Le chef d'orchestre battait la <w>mesure</w> avec sa baguette.",
                                "it": "Il direttore batteva il <w>tempo</w> con la sua bacchetta.",
                                "cs": "Dirigent udával <w>takt</w> svou taktovkou.",
                                "tr": "Şef, batonuyla <w>tempoyu</w> tutuyordu.",
                                "es": "El director marcaba el <w>compás</w> con su batuta."
                            }
                        },
                        {
                            "text": "Het is moeilijk om tijdens het dansen goed in de <w>maat</w> te blijven.",
                            "target_lang_translations": {
                                "en": "It is difficult to keep <w>time</w> well while dancing.",
                                "ru": "Во время танца трудно все время попадать в <w>такт</w>.",
                                "pl": "Trudno jest dobrze trzymać się <w>taktu</w> podczas tańca.",
                                "de": "Es ist schwierig, beim Tanzen gut im <w>Takt</w> zu bleiben.",
                                "fr": "Il est difficile de bien rester en <w>mesure</w> tout en dansant.",
                                "it": "È difficile andare a <w>tempo</w> mentre si balla.",
                                "cs": "Při tanci je těžké udržet se správně v <w>rytmu</w>.",
                                "tr": "Dans ederken <w>ritme</w> ayak uydurmak zordur.",
                                "es": "Es difícil mantener bien el <w>ritmo</w> mientras se baila."
                            }
                        }
