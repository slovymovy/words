            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3704f2d3-e270-3109-9236-433853cebd5f",
                    "sense_definition": "Wat geleidelijk overgaat of veranderlijk is; niet vastgesteld.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geleidelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijf hanteert <w>glijdende</w> werktijden voor alle medewerkers.",
                            "target_lang_translations": {
                                "en": "The company uses <w>flexible</w> working hours for all employees."
                            }
                        },
                        {
                            "text": "We moeten oppassen dat dit besluit niet leidt tot een <w>glijdende</w> schaal van verdere bezuinigingen.",
                            "target_lang_translations": {
                                "en": "We must be careful that this decision does not lead to a <w>slippery</w> slope of further budget cuts."
                            }
                        }
                    ],
                    "synonyms": [
                        "flexibel",
                        "variabel"
                    ],
                    "common_phrases": [
                        "glijdende schaal",
                        "glijdende werktijden"
                    ],
                    "target_lang_definitions": {
                        "en": "That transitions gradually or is variable; not fixed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sliding",
                                "target_lang_sense_clarification": "flexible or adjustable scale/hours"
                            },
                            {
                                "target_lang_word": "flexible",
                                "target_lang_sense_clarification": "not fixed, subject to change"
                            },
                            {
                                "target_lang_word": "variable",
                                "target_lang_sense_clarification": "changeable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6d5034d-9606-3b25-afd7-011135540c35",
                    "sense_definition": "Zich soepel en zonder schokken over een oppervlak voortbewegend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De scheidsrechter floot voor een overtreding van de <w>glijdende</w> verdediger.",
                            "target_lang_translations": {
                                "en": "The referee blew for a foul by the <w>sliding</w> defender."
                            }
                        },
                        {
                            "text": "Het schip maakte een soepele, <w>glijdende</w> beweging over het rimpelloze water.",
                            "target_lang_translations": {
                                "en": "The ship made a smooth, <w>gliding</w> motion across the rippless water."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glijdende beweging"
                    ],
                    "target_lang_definitions": {
                        "en": "Moving smoothly and without jerks over a surface."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sliding",
                                "target_lang_sense_clarification": "moving smoothly across a surface"
                            },
                            {
                                "target_lang_word": "gliding",
                                "target_lang_sense_clarification": "moving smoothly and effortlessly"
                            }
                        ]
                    }
                }
            ]
        },
