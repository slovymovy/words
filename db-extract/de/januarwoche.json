                "senses": [
                    {
                        "sense_id": "9db3d5ce-5ac2-3d0e-87aa-8ed373a4085f",
                        "entry_id": "141de9bf-0538-3239-87d5-3c9052cc2e4d",
                        "glosses": [
                            "Woche im Januar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5758902-5f29-4da6-9675-3348de07e15a",
                                "sense_id": "9db3d5ce-5ac2-3d0e-87aa-8ed373a4085f",
                                "text": "Danella kam in der zweiten Januarwoche und blieb bis Ostern."
                            },
                            {
                                "example_id": "47f86128-0975-4959-953d-d5963530d5b1",
                                "sense_id": "9db3d5ce-5ac2-3d0e-87aa-8ed373a4085f",
                                "text": "„In der ersten Januarwoche beschäftigten sich die Siedler mit der Wäschekonfektion.“"
                            },
                            {
                                "example_id": "a06ede69-b941-4f7a-9dde-7f40f44d07d6",
                                "sense_id": "9db3d5ce-5ac2-3d0e-87aa-8ed373a4085f",
                                "text": "„Im September 1505, nur wenige Monate nachdem sich Julius an die Eidgenossenschaft gewandt hatte, machten sich 150 Mann auf den Weg und trafen in der vorletzten Januarwoche des Jahres 1506 im Vatikan ein.“"
                            },
                            {
                                "example_id": "828bdbd4-25c4-45af-8f4c-7d7e605fb072",
                                "sense_id": "9db3d5ce-5ac2-3d0e-87aa-8ed373a4085f",
                                "text": "„Auf den Straßen und Gutshöfen waren in diesen Januarwochen fast nur noch Frauen, Kinder und alte Männer zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
