                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78d04318-2f98-3e65-8622-29ad46ec49e6",
                                        "entry_id": "331a492f-6896-3951-afd1-aace9b2cc857",
                                        "glosses": [
                                            "To upset or distress (a person)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90fa64e0-35d3-4b0e-81a8-ef118a8975d6",
                                                "sense_id": "78d04318-2f98-3e65-8622-29ad46ec49e6",
                                                "text": "Seeing the car accident really shook her up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5c93299-14b4-35a9-ada1-af68b7437546",
                                        "entry_id": "331a492f-6896-3951-afd1-aace9b2cc857",
                                        "glosses": [
                                            "To reorganize, to make reforms in."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6790c04-90cf-4d23-bacf-9a8cd09cff6a",
                                                "sense_id": "e5c93299-14b4-35a9-ada1-af68b7437546",
                                                "text": "The new boss is going to shake things up, so be aware."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7dd518a8-c2ce-41df-8166-af7fce482e32",
