                "senses": [
                    {
                        "sense_id": "ec30e94e-1d13-3a03-a573-81d719c38817",
                        "entry_id": "e2924761-479e-3482-bc1b-381e1dfe0232",
                        "glosses": [
                            "Verletzung, die von einem auf den Verletzten abgeschossenen Pfeil stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01cf3e2c-e7a8-41cf-aa8c-2c96deb45d28",
                                "sense_id": "ec30e94e-1d13-3a03-a573-81d719c38817",
                                "text": "„Seine Pfeilwunde hatte sich als harmloser herausgestellt, als er befürchtet hatte.“"
                            },
                            {
                                "example_id": "ef89e7f8-57b5-4ce3-9fde-d8d794928e79",
                                "sense_id": "ec30e94e-1d13-3a03-a573-81d719c38817",
                                "text": "„Dem norwegischen Ethnografen Carl Sofus Lumholtz zufolge benutzten die Ureinwohner Nordamerikas Peyote, um körperliche Leiden wie Schlangenbisse, Skorpionstiche, Zahnschmerzen, Verbrennungen, Pfeilwunden oder Rheuma zu lindern.“"
                            },
                            {
                                "example_id": "965ae1df-09b6-4fc5-9d5a-dd8d3cd41df9",
                                "sense_id": "ec30e94e-1d13-3a03-a573-81d719c38817",
                                "text": "„Physische Belege für Verletzungen durch Waffen finden sich in mittelalterlichen Bestattungen kaum und Spuren von Pfeilwunden sind außergewöhnlich selten […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
