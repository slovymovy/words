                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8605bde-8d36-45ee-9136-d05aa6b52bb7",
                                "sense_id": "d8ab5e36-dd26-3e2b-9a41-8762768c4039",
                                "text": "„Die Öffentlichkeit erfuhr von den beiden Verbindungen erst 2005, als Gabriel mittlerweile doch wieder für einen Posten in der Bundespolitik gehandelt wurde.“"
                            },
                            {
                                "example_id": "8d449a6d-6f55-45ac-9fa3-034a430e9818",
                                "sense_id": "d8ab5e36-dd26-3e2b-9a41-8762768c4039",
                                "text": "„Wichtige Kriterien dieser Studien sind die Wirksamkeit, die Wirtschaftlichkeit, die Rechtmässigkeit und die Zweckmässigkeit von Bundespolitiken.“"
                            }
