                "senses": [
                    {
                        "sense_id": "23f5b899-6f78-3d66-935e-ed9fcf2863c6",
                        "entry_id": "c89a91e7-4ee5-301d-83ef-c49b81481891",
                        "glosses": [
                            "Enlever la gourmette à un cheval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1019e4-7da3-487e-a1df-ab41f62710c2",
                                "sense_id": "23f5b899-6f78-3d66-935e-ed9fcf2863c6",
                                "text": "On ne débride pas habituellement les chevaux qui ne sont que légèrement échauffés, on les dégourme on les attache par les rênes de la bride aux fuseaux du râtelier, on fait absolument net devant eux, soit dans le râtelier, soit dans l’auge."
                            }
                        ]
                    },
                    {
                        "sense_id": "5893fdea-db39-32ed-9c1a-4f9353dc5681",
                        "entry_id": "c89a91e7-4ee5-301d-83ef-c49b81481891",
                        "glosses": [
                            "Se racler la gorge pour la nettoyer."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "b2194b02-6294-4abe-8363-cfedeacf5b0a",
                                "sense_id": "5893fdea-db39-32ed-9c1a-4f9353dc5681",
                                "text": "Maryse, en coulisses, prépare sa courte apparition sur scène : elle enfile sa jupe à pois, rajoute du rouge à lèvres, se dégourme, pratique ses grimaces, et court les faire sur la scène."
                            }
                        ]
                    }
                ],
