                                        "sense_id": "8ceb8e16-e121-31fb-ba06-c390db308147",
                                        "entry_id": "c3aa496c-6bbe-3398-b0a2-a549213cbe71",
                                        "glosses": [
                                            "Mot qui lie le sujet d’une proposition avec l’attribut. En français, le verbe être est une copule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "601becd9-41c9-467c-a390-a926c8f438c2",
                                                "sense_id": "8ceb8e16-e121-31fb-ba06-c390db308147",
                                                "text": "C’est d’ailleurs pourquoi le ressort actif du jugement, qui est sa copule, est toujours un verbe, qui est précisément le verbe est."
                                            },
                                            {
                                                "example_id": "eb018a44-99a1-4f07-8e11-f6cf491008f5",
                                                "sense_id": "8ceb8e16-e121-31fb-ba06-c390db308147",
                                                "text": "Soit la proposition : « la fleur est rouge » (ou : « l’homme est mortel », etc.). Cette proposition est composée de deux noms, imposés à un même substrat ou sujet et liés par la copule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "542a1838-50d3-344f-bd54-c35e38615f89",
                                        "entry_id": "c3aa496c-6bbe-3398-b0a2-a549213cbe71",
                                        "glosses": [
                                            "Verbe être qui lie le prédicat au sujet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "599967be-e9ce-3315-8c4b-05bf60bf179a",
