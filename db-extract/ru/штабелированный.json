                                            {
                                                "example_id": "97693004-4cbf-44d9-bbd7-becb89d0133a",
                                                "sense_id": "ee227fd2-2aa4-380b-9fe6-6d6d1e1045c5",
                                                "text": "a stacked deck of cards"
                                            },
                                            {
                                                "example_id": "903bebce-fa6f-4560-8ff3-408441300fea",
                                                "sense_id": "ee227fd2-2aa4-380b-9fe6-6d6d1e1045c5",
                                                "text": "That game is stacked. Don't even try it."
                                            },
                                            {
                                                "example_id": "b50278bc-2e09-4a63-b41d-cf4c4e2a1383",
                                                "sense_id": "ee227fd2-2aa4-380b-9fe6-6d6d1e1045c5",
                                                "text": "And I tread a troubled track / My odds are stacked / I'll go back to black"
                                            }
