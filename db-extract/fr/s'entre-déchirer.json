                ],
                "senses": [
                    {
                        "sense_id": "a76ec3f3-cc06-374a-be39-e85c14b2303b",
                        "entry_id": "f537de12-4d3c-326e-9335-dd4734f7c0f0",
                        "glosses": [
                            "Se déchirer mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d288f9e-3616-461d-946f-bae7ef600609",
                                "sense_id": "a76ec3f3-cc06-374a-be39-e85c14b2303b",
                                "text": "Il nous ressemble trop pour que nous prélevions sur lui un tribut ; car les chiens ne doivent pas s’entre-déchirer quand les loups et les renards abondent."
                            },
                            {
                                "example_id": "f8ed817b-13f9-4390-9df4-39859468b0f6",
                                "sense_id": "a76ec3f3-cc06-374a-be39-e85c14b2303b",
                                "text": "— La guerre n’est jamais drôle. Mais je me demande si une vraie guerre n’est pas un peu moins malsaine que cette situation où les Français s’entre-déchirent."
                            },
                            {
                                "example_id": "f62f785c-4897-44ad-8c1c-07ba573d542d",
                                "sense_id": "a76ec3f3-cc06-374a-be39-e85c14b2303b",
                                "text": "Par la suite, en Europe, des féodaux belliqueux s’entre-déchirèrent pendant un millénaire, tandis que les musulmans arabes et turcs dominaient la Méditerranée."
                            }
                        ]
                    }
