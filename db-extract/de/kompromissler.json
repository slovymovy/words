                "senses": [
                    {
                        "sense_id": "255f5c1f-e33d-3182-a4f9-0371a4f89449",
                        "entry_id": "d2df4b7a-5f33-328c-96ff-92e97304a92c",
                        "glosses": [
                            "Person, die einer deutlichen Stellungnahme und Entscheidung ausweicht und (zu früh zu faule) Kompromisse eingeht"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "9a2e7650-a49a-4f9e-ba30-c7206a683b71",
                                "sense_id": "255f5c1f-e33d-3182-a4f9-0371a4f89449",
                                "text": "„Indem klare Gegensätzlichkeiten betont und mögliche Gemeinsamkeiten negiert werden, lässt sich das Profil der präferierten Alternative soweit schärfen, dass sie gegen ‚Kompromissler‘ jedweder Couleur behauptet werden kann.“"
                            },
                            {
                                "example_id": "9cf7ae97-63f4-497a-8b20-e6b5674e88cb",
                                "sense_id": "255f5c1f-e33d-3182-a4f9-0371a4f89449",
                                "text": "„Gorbatschow also schlüpfte für viele aus der Rolle des erklärten Erneuerers in die Rolle des Kompromisslers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
