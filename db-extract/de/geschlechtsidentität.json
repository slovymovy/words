                        "glosses": [
                            "Empfinden/Erleben der Zugehörigkeit zu einem Geschlecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e457fcfe-12b1-4c06-8cfa-35e54000c783",
                                "sense_id": "916c6726-745f-335f-8fa8-bc4917016fdf",
                                "text": "„Die Geschlechtsidentität bezeichnet das Selbsterleben eines Menschen, bezogen auf sein Geschlecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca722a7e-6317-4b47-a9f3-d2545a3973b6",
                        "source_entry_id": "1c2a2f33-8ab5-33d3-ae66-ff1f53b73386",
                        "source_sense_id": "916c6726-745f-335f-8fa8-bc4917016fdf",
                        "source_sense_description": "Empfinden/Erleben der Zugehörigkeit zu einem Geschlecht",
                        "target_lang_word": "gender identity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gender identity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a36ebbe8-09d3-3d09-890e-6e15bf44548b",
                                        "entry_id": "4315e72a-2c1f-346e-9069-9205701857ff",
                                        "glosses": [
                                            "An individual's internal sense of self as belonging to a particular gender or genders, or to no gender."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f13adb09-6cb0-45d3-9118-023e1e5586ff",
                                                "sense_id": "a36ebbe8-09d3-3d09-890e-6e15bf44548b",
                                                "text": "\"Um... is there a better way to put it than 'female forms'? I mean, Justin's gender identity isn't getting morphed, is it?\""
                                            },
                                            {
                                                "example_id": "4d034851-dd58-477b-91d7-7559e88006a4",
                                                "sense_id": "a36ebbe8-09d3-3d09-890e-6e15bf44548b",
                                                "text": "Gender identity development may be conceptualized as a continuous, lifelong process of gender self-categorization, which involves matching oneself to a gender group that seems to be a “best fit” using information related to a number of interactive factors such as an internal sense of gendered self, gendered attributes, and other people’s perceptions (Jackson & Bussey, 2023, 2024)."
                                            },
                                            {
                                                "example_id": "57672249-5921-4178-ab3a-116bbd38e0b0",
                                                "sense_id": "a36ebbe8-09d3-3d09-890e-6e15bf44548b",
                                                "text": "AB-89 would have required that participation in sex-segregated California school programs, athletic teams, and facility use be based on a pupil’s sex, not gender identity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
