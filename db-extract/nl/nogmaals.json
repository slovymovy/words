        "nl-extract.jsonl": [
            {
                "entry_id": "b420bc74-addf-3ab0-8f03-c4aa179cc843",
                "word": "nogmaals",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5373eed4-8a7c-343c-96ca-c7e398f1ee57",
                        "entry_id": "b420bc74-addf-3ab0-8f03-c4aa179cc843",
                        "glosses": [
                            "nog een keer , opnieuw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85b8379e-3f3a-44b7-a9e2-c50c48cc65fd",
                                "sense_id": "5373eed4-8a7c-343c-96ca-c7e398f1ee57",
                                "text": "Blijkbaar werkte mijn actie wel, dus ik schopte nogmaals wat zand waardoor de ratelslang sierlijk de struiken ingleed. Ik wachtte een paar minuten tot de kust echt veilig was."
                            },
                            {
                                "example_id": "9cb6f2dd-48a8-4d4c-b8b8-c0688c47751b",
                                "sense_id": "5373eed4-8a7c-343c-96ca-c7e398f1ee57",
                                "text": "'Dan zal ik het je nogmaals vragen: met welk geld ga je die broeikassen bouwen?' Het lukt haar niet meer om zachtjes te praten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3257f24f-83aa-4bef-8825-e2850ebff29b",
                        "source_entry_id": "b420bc74-addf-3ab0-8f03-c4aa179cc843",
                        "source_sense_id": "5373eed4-8a7c-343c-96ca-c7e398f1ee57",
