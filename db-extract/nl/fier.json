                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ac9041c-d0ac-32c0-92b9-8dba5528b334",
                        "entry_id": "7c1c7013-1569-37cf-9956-cd07bfb2bf0f",
                        "glosses": [
                            "trots"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f53d46a5-709f-4719-ae77-ad0f2855bc4b",
                                "sense_id": "1ac9041c-d0ac-32c0-92b9-8dba5528b334",
                                "text": "Maar hoe zit het in Wallonië? Bezuiden de in 1963 vastgelegde taalgrens is men fier op zijn bossen, rivieren en la cuisine du terroir, de streekkeuken. Ernstig wordt er gesproken over het Marshallplan voor Wallonië, dat het gewest moet helpen aan la relance, de economische heropleving."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b049f78-9d19-4950-81ae-4147b8cca308",
                        "source_entry_id": "7c1c7013-1569-37cf-9956-cd07bfb2bf0f",
                        "source_sense_id": "1ac9041c-d0ac-32c0-92b9-8dba5528b334",
                        "source_sense_description": "trots",
                        "target_lang_word": "stolz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stolz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab39c530-86e4-36c1-9ad3-f727bca7b824",
                                        "entry_id": "7436a066-6197-36cc-a643-c617341cb4a5",
                                        "glosses": [
                                            "seiner Fähigkeiten und Leistungen bewusst und erfreut darüber, im Selbstgefühl gestärkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efbec9b4-b1a3-41b8-9e88-2eb693925178",
                                                "sense_id": "ab39c530-86e4-36c1-9ad3-f727bca7b824",
                                                "text": "„Ausgerechnet Neuseeland, dessen Einwohner sich nach einem flugunfähigen Vogel stolz Kiwis nennen, hat sich diesem ungewöhnlichen Flugsport verschrieben.“"
                                            },
                                            {
                                                "example_id": "07d7e3b2-8bf3-432e-b0c0-254de34c90ba",
                                                "sense_id": "ab39c530-86e4-36c1-9ad3-f727bca7b824",
                                                "text": "Die bestandene Prüfung machte ihn sehr stolz."
                                            },
                                            {
                                                "example_id": "109b038c-57a8-4b96-ad31-7a7d88ebd07e",
                                                "sense_id": "ab39c530-86e4-36c1-9ad3-f727bca7b824",
                                                "text": "Der stolze Vater gab auf die Geburt seiner Tochter einen aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e08eda09-60bd-35be-bdda-915fb790be43",
                                        "entry_id": "7436a066-6197-36cc-a643-c617341cb4a5",
                                        "glosses": [
                                            "eingebildet, hochnäsig, viel Selbstbewusstsein besitzend, auf hohem Ross"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2157b3f-8c63-495a-a24d-947f87aa335d",
                                                "sense_id": "e08eda09-60bd-35be-bdda-915fb790be43",
                                                "text": "Annette ist viel zu stolz, um sich zu entschuldigen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "62e0c90b-d636-3ed3-97f0-05dbeb0db3b5",
                                        "entry_id": "7436a066-6197-36cc-a643-c617341cb4a5",
                                        "glosses": [
                                            "erhebend, eindrucksvoll, außergewöhnlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0be70b14-9276-4517-8952-0a41b4c6ce3e",
                                                "sense_id": "62e0c90b-d636-3ed3-97f0-05dbeb0db3b5",
                                                "text": "Als sie für ihr Land den Sieg holte, war es ein stolzer Augenblick."
                                            },
                                            {
                                                "example_id": "dfbe9761-b614-4dfa-80a3-c85d9cebf99f",
                                                "sense_id": "62e0c90b-d636-3ed3-97f0-05dbeb0db3b5",
                                                "text": "Dieser stolze Augenblick wird ewig im Gedächtnis unseres Landes bleiben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "386ed7f2-0320-3ffa-9dce-115541e69e45",
                                        "entry_id": "7436a066-6197-36cc-a643-c617341cb4a5",
                                        "glosses": [
                                            "groß, mächtig, beeindruckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48e5eb68-b593-4cff-a360-2eda9e12022a",
                                                "sense_id": "386ed7f2-0320-3ffa-9dce-115541e69e45",
                                                "text": "Der Eiffelturm ist ein stolzes Gebäude."
                                            },
                                            {
                                                "example_id": "6817aa11-00d0-437e-bbc9-294f13df419c",
                                                "sense_id": "386ed7f2-0320-3ffa-9dce-115541e69e45",
                                                "text": "Die „Queen Mary II“ ist ein stolzes Schiff."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "888ebbeb-d1a4-30f5-884f-771c3db9da0f",
                                        "entry_id": "7436a066-6197-36cc-a643-c617341cb4a5",
                                        "glosses": [
                                            "sehr hoch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e0ecac0-c5fa-4aed-bbb1-0e349b548c24",
                                                "sense_id": "888ebbeb-d1a4-30f5-884f-771c3db9da0f",
                                                "text": "Für dies einfache Hemd ist das ein stolzer Preis."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "531ca298-65c8-327c-8a08-fb2fdd99fde8",
                                        "entry_id": "7436a066-6197-36cc-a643-c617341cb4a5",
                                        "glosses": [
                                            "spröde, unnahbar, zurückhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "919a51c7-9f74-4bc4-92c4-f7f55a92eda2",
                                                "sense_id": "531ca298-65c8-327c-8a08-fb2fdd99fde8",
                                                "text": "Das Herz der stolzen Jungfrau kann niemand gewinnen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "6f0fa983-6af4-3e95-81b3-0226856f9896",
                                        "entry_id": "7436a066-6197-36cc-a643-c617341cb4a5",
                                        "glosses": [
                                            "unartig, frech, ungehorsam"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb93da8f-4a1e-4f5b-abe2-b5d8761de9f0",
                                                "sense_id": "6f0fa983-6af4-3e95-81b3-0226856f9896",
                                                "text": "Dies ist ein stolzes Kind. Es treibt den ganzen Tag nur Schabernack."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
