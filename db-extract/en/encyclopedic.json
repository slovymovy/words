                                    },
                                    {
                                        "sense_id": "26813960-64ee-32d8-9c13-759d4a591131",
                                        "entry_id": "2b189555-c88e-3528-8e81-8390a54a3492",
                                        "glosses": [
                                            "Vollständigkeit anstrebend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae484ec7-a1a1-475b-8e04-76ffc77cdc9d",
                                                "sense_id": "26813960-64ee-32d8-9c13-759d4a591131",
                                                "text": "„Das Gipfelerlebnis, das die Vulkane ihrem Besteiger gewähren, ist kein sentimentalischer Blick auf die Landschaft, sondern ein seltener Moment wissenschaftlicher Synthese und enzyklopädischer Ganzheit.“"
                                            },
                                            {
                                                "example_id": "29416c9c-1daa-4228-9dd6-e18ab8ba35f9",
                                                "sense_id": "26813960-64ee-32d8-9c13-759d4a591131",
                                                "text": "„Soeben hat der tiefgründigste und enzyklopädischste unter den heutigen Faust-Kennern, Michael Jaeger, eine ebenso aufregende wie konzise Studie »zur Aktualität Goethes« publiziert…“"
                                            },
                                            {
                                                "example_id": "8c6bebf2-0980-4133-9465-8d146aeb9b26",
                                                "sense_id": "26813960-64ee-32d8-9c13-759d4a591131",
                                                "text": "„Das enzyklopädische Schlusskapitel, in dem Mérimée zeitgenössisches Wissen über Zigeuner zusammengeschrieben hat, belehrt uns, genau gelesen, noch eines anderen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
