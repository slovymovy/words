                {
                    "sense_id": "e68d56cf-169d-31ba-a404-ed03813b0e36",
                    "sense_definition": "Devenir dur ou consistant sous l'action d'un élément naturel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "solidification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En séchant au soleil, cette colle <w>durcit</w> très rapidement.",
                            "target_lang_translations": {
                                "en": "As it dries in the sun, this glue <w>hardens</w> very quickly.",
                                "ru": "Высыхая на солнце, этот клей очень быстро <w>затвердевает</w>.",
                                "de": "Beim Trocknen in der Sonne <w>härtet</w> dieser Kleber sehr schnell <w>aus</w>.",
                                "es": "Al secarse al sol, este pegamento <w>endurece</w> muy rápidamente.",
                                "zh": "这种胶水在太阳下晒干时<w>变硬</w>得很快。"
                            }
                        },
                        {
                            "text": "Le ciment frais commence à <w>durcir</w> après quelques minutes.",
                            "target_lang_translations": {
                                "en": "Fresh cement begins to <w>harden</w> after a few minutes.",
                                "ru": "Свежий цемент начинает <w>схватываться</w> через несколько минут.",
                                "de": "Frischer Zement beginnt nach wenigen Minuten <w>abzubinden</w>.",
                                "es": "El cemento fresco empieza a <w>fraguar</w> al cabo de unos minutos.",
                                "zh": "新拌的水泥几分钟后便开始<w>凝结</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "durcir à l'air",
                        "durcir avec le temps"
                    ],
                    "target_lang_definitions": {
                        "en": "To become hard or solid through the effect of natural conditions.",
                        "ru": "Становиться твёрдым или плотным под воздействием природных условий.",
                        "de": "Unter dem Einfluss natürlicher Bedingungen hart oder fest werden.",
                        "es": "Volverse duro o consistente por la acción de condiciones naturales, como el sol o el aire.",
                        "zh": "在阳光、空气等自然条件的作用下变硬或变得坚实。"
                    },
