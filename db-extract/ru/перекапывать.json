                ],
                "senses": [
                    {
                        "sense_id": "a0cca548-bda7-373c-b5c9-fe79f6eff9e4",
                        "entry_id": "c9978c5a-5c94-33f1-b4b0-4226a39c2591",
                        "glosses": [
                            "копать что-либо в полном объеме или почти все"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc372087-d2cd-4e41-981b-345b8010c03b",
                                "sense_id": "a0cca548-bda7-373c-b5c9-fe79f6eff9e4",
                                "text": "После просушки почвы в неё вносят нужные питательные вещества, после чего перекапывают с переворотом пласта на 50 см."
                            },
                            {
                                "example_id": "8abf9a7d-b12b-41ac-a620-4031663ef82c",
                                "sense_id": "a0cca548-bda7-373c-b5c9-fe79f6eff9e4",
                                "text": "Вместо охоты мы ходили на золотоносное плоскогорье. Восемь дней мы перекапывали там песок и промывали его в воде…"
                            }
                        ]
                    },
                    {
                        "sense_id": "e4054540-3327-397a-be01-6d57d11eb273",
                        "entry_id": "c9978c5a-5c94-33f1-b4b0-4226a39c2591",
                        "glosses": [
                            "вскапывать заново, ещё раз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da482f73-7aa8-4ed7-bd02-b4ccb3add0d6",
                                "sense_id": "e4054540-3327-397a-be01-6d57d11eb273",
                                "text": "Помню, уже после уборки урожая ходили с бабушкой на поля, перекапывали землю в надежде хоть что-то найти."
                            }
                        ]
                    },
                    {
                        "sense_id": "a68e1787-55f2-3e78-bc55-0ccfe806df1e",
                        "entry_id": "c9978c5a-5c94-33f1-b4b0-4226a39c2591",
                        "glosses": [
                            "вскапывая, собирать что-либо растущее в земле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ba3e79e-fd24-4571-823b-d1b952118958",
                                "sense_id": "a68e1787-55f2-3e78-bc55-0ccfe806df1e",
                                "text": "Орудия ― долой с передков, да как ахнут из трёхдюймовок по огородам, а там бабы перекапывали картошку…"
                            }
                        ]
                    },
                    {
                        "sense_id": "f1d99626-6add-30ab-bd40-7ef4a64199f3",
                        "entry_id": "c9978c5a-5c94-33f1-b4b0-4226a39c2591",
                        "glosses": [
                            "выкапывать поперек чего-либо ров, канаву"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b66ac13-2f89-4c1a-9a81-e047989cf10c",
                                "sense_id": "f1d99626-6add-30ab-bd40-7ef4a64199f3",
                                "text": "Наступила ночь. Набат продолжал гудеть. Стрельцы вооружались и укрепляли Кремль. Переводили туда свои семьи, перекапывали улицы, строили надолбы и ожидали нападения служилых людей, бывших при царях в Троицкой лавре."
                            },
                            {
                                "example_id": "7d0a76d4-1b19-4689-979f-f4eccdc5c0f8",
                                "sense_id": "f1d99626-6add-30ab-bd40-7ef4a64199f3",
                                "text": "Какие-то люди рыли канаву. «Поразительная страсть всё копать и перекапывать! ― подумал Фёдор Васильевич. ― Сегодня заливают асфальтом, завтра ломают и перекапывают»."
                            }
                        ]
                    },
                    {
                        "sense_id": "b34b87c9-8b67-3545-a7b4-65c36d2d84a6",
                        "entry_id": "c9978c5a-5c94-33f1-b4b0-4226a39c2591",
                        "glosses": [
                            "в поисках чего-либо пересматривать, перебирать что-либо, создавая беспорядок; перерывать"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8f832e5d-6fc3-32a9-8e20-d67b9c170e2d",
                        "entry_id": "c9978c5a-5c94-33f1-b4b0-4226a39c2591",
                        "glosses": [
                            "разг. копать дольше других, вскапывать больше других"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "958eb287-3e59-4055-a2dc-316aafdfff38",
                        "source_entry_id": "c9978c5a-5c94-33f1-b4b0-4226a39c2591",
                        "target_lang_word": "umgraben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umgraben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbe85a28-72f0-39f2-b1a1-d8688b08e5a5",
                                        "entry_id": "e7aee238-8a3f-3035-a07f-61d583fd5749",
                                        "glosses": [
                                            "die oberste Erdschicht mithilfe eines Spatens umwenden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50ae1c23-1c11-402b-9342-4ef75ea956b7",
                                                "sense_id": "bbe85a28-72f0-39f2-b1a1-d8688b08e5a5",
                                                "text": "Er gräbt den Garten um, damit der Boden gelockert ist."
                                            }
                                        ],
