                            "dative",
                            "plural"
                        ],
                        "form": "den Konkreta"
                    },
                    {
                        "form_id": "e48af3e5-13e0-42a6-8e51-ca1fec0992f0",
                        "entry_id": "831cbeb9-9c14-3155-be5a-d004086d464d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Konkretum"
                    },
                    {
                        "form_id": "6379a3e1-a626-4376-86e7-f8b5e374bc3e",
                        "entry_id": "831cbeb9-9c14-3155-be5a-d004086d464d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Konkreta"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e06d601-ad03-35e7-b0e9-1900d0dbed39",
                        "entry_id": "831cbeb9-9c14-3155-be5a-d004086d464d",
                        "glosses": [
                            "etwas Gegenständliches, sinnlich Wahrnehmbares"
                        ],
                        "tags": [
                            "eher selten und dann meist im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "84c07aff-0416-4cb5-bb18-418f5ba6c069",
                                "sense_id": "5e06d601-ad03-35e7-b0e9-1900d0dbed39",
                                "text": "„Über Konkreta, also Gegenstände und Wesen, die man sehen oder zumindest hören kann, vermag der Mensch je nach Sprachbegabung zutreffende Aussagen zu machen.“"
                            },
                            {
                                "example_id": "78018142-78df-427a-8279-6a1fa2edee6b",
                                "sense_id": "5e06d601-ad03-35e7-b0e9-1900d0dbed39",
                                "text": "„Wobei man natürlich nicht außer acht lassen darf, daß es sich beim Menschen um ein Konkretum, bei der Freiheit hingegen um ein Abstraktum handelt.“"
                            },
                            {
                                "example_id": "8625ec0c-ac3a-4069-b673-5a3d5116300b",
                                "sense_id": "5e06d601-ad03-35e7-b0e9-1900d0dbed39",
                                "text": "„Denn das Preziöse dieser, wie überhaupt barocker Ausdrucksweise liegt zum großen Teile in dem extremen Rückgang auf die Worte für Konkreta.“"
                            },
                            {
                                "example_id": "de422953-3ab7-4758-87ae-e0832686f774",
                                "sense_id": "5e06d601-ad03-35e7-b0e9-1900d0dbed39",
                                "text": "„Nur Konkreta, Herd und Tür, der einzelne Wald und das einzelne Feld, dieser Fluß und jener Berg, verdichten sich ihm zu Wesen.“"
                            },
                            {
                                "example_id": "2f83c819-18b7-4c38-ae37-188396cb349e",
                                "sense_id": "5e06d601-ad03-35e7-b0e9-1900d0dbed39",
                                "text": "„Ein einzelnes Symbol zur Veranschaulichung der Poesie ist z. B. die Lyra. … Für die Stärke dient das Symbol \"Eiche\" oder \"Löwe\". Dasselbe Konkretum kann dienen zur Allegorie eines Gattungsbegriffes (z. B. die einzelnen Eigenschaften der Eiche für einen Charakter).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "151ec50f-d162-3d4b-bc84-10eeb35c388c",
                        "entry_id": "831cbeb9-9c14-3155-be5a-d004086d464d",
                        "glosses": [
                            "Substantiv, das Gegenständliches bezeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2354db5-aada-4bc2-9a06-69e9b472da0c",
                                "sense_id": "151ec50f-d162-3d4b-bc84-10eeb35c388c",
                                "text": "„Stein“, „Stuhl“, „Chomsky“, „Mensch“ sind Beispiele für Konkreta."
                            },
                            {
                                "example_id": "56ff76e1-8dc6-4f2d-bbc0-fbbc36360d90",
                                "sense_id": "151ec50f-d162-3d4b-bc84-10eeb35c388c",
                                "text": "„Die ganzheitliche Beschreibung eignet sich vor allem für Konkreta, für Kollektiva und bestimmte Verbklassen.“"
                            },
                            {
                                "example_id": "d383327e-c9b6-4733-83b0-3aed29dd77b1",
                                "sense_id": "151ec50f-d162-3d4b-bc84-10eeb35c388c",
                                "text": "„Vorweg muß vor der Annahme gewarnt werden, als seien Konkreta und Abstrakta von vornherein festgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
