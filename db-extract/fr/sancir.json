                        "glosses": [
                            "En parlant d'un navire, couler bas en plongeant d’abord son avant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6f3aa2e-5a16-4264-ba02-b614e9547817",
                                "sense_id": "aeb3fa40-4ee6-381c-9b20-ad21d0a318cb",
                                "text": "Notre chaloupe faisait eau de toutes parts, elle était usée jusqu'à la corde et chaque fois qu'un orage éclatait … nous craignions de sancir."
                            },
                            {
                                "example_id": "7bbc64ce-4d87-486b-a7ed-4a50eb5b06cb",
                                "sense_id": "aeb3fa40-4ee6-381c-9b20-ad21d0a318cb",
                                "text": "Sancir. Chavirer par l'avant cul par-dessus tête."
                            }
                        ]
                    }
