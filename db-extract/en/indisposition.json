    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5092d157-5609-3898-b903-7d021c381d70",
                "word": "indisposition",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7bf11d32-96cb-418a-bc9e-75ef41317cb9",
                        "entry_id": "5092d157-5609-3898-b903-7d021c381d70",
                        "tags": [
                            "plural"
                        ],
                        "form": "indispositions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59803307-d38b-36ee-9c43-29f23b1301ec",
                        "entry_id": "5092d157-5609-3898-b903-7d021c381d70",
                        "glosses": [
                            "A mild illness, the state of being indisposed."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "418c2696-8d9c-493d-8489-7e8b2272a3cc",
                                "sense_id": "59803307-d38b-36ee-9c43-29f23b1301ec",
                                "text": "I was scarce sooner recovered from my indisposition than Amelia herself fell ill."
                            },
                            {
                                "example_id": "e0923170-91ed-461d-8ace-68bc9540124a",
                                "sense_id": "59803307-d38b-36ee-9c43-29f23b1301ec",
                                "text": "She began not to understand a word they said, and was obliged to plead indisposition and excuse herself."
                            },
                            {
                                "example_id": "a64834f2-8c3a-4c1b-a384-f8384958e356",
                                "sense_id": "59803307-d38b-36ee-9c43-29f23b1301ec",
                                "text": "During those three hellish days at Gettysburg, General Robert E. Lee was badly suffering from a severe case of diarrhea after having eaten too many cherries, an indisposition—given his ill-considered and ultimately amateurishly fatal decision for the Confederacy to attack from the front (and relatively below) on July 3, 1863—that cost his army a victory that day, an incredible mismaneuver and unstrategic folly that became, as it turned out, the turning-point of the entire war that led to the full and final defeat of the South."
                            }
                        ]
                    },
                    {
                        "sense_id": "c902d176-9154-3b83-909a-05c12bb07f16",
                        "entry_id": "5092d157-5609-3898-b903-7d021c381d70",
                        "glosses": [
                            "A state of not being disposed to do something; disinclination; unwillingness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5c524e9d-18bf-4cbc-8e28-48648c3c3815",
                                "sense_id": "c902d176-9154-3b83-909a-05c12bb07f16",
                                "text": "He argued that the progress of wealth could be impeded not only by an indisposition to produce, but also by an indisposition to consume […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "58a6835a-2d5b-3478-a599-91b2b4215bf0",
                        "entry_id": "5092d157-5609-3898-b903-7d021c381d70",
                        "glosses": [
                            "A bad mood or disposition."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f9ccf5b7-1374-441f-b009-7231a19fa32b",
                                "sense_id": "58a6835a-2d5b-3478-a599-91b2b4215bf0",
                                "text": "1597, Francis Bacon, Essays\nDoth any man doubt, that if there were taken out of men's minds, vain opinions, flattering hopes, false valuations, imaginations as one would, and the like, but it would leave the minds, of a number of men, poor shrunken things, full of melancholy and indisposition, and unpleasing to themselves?"
                            }
                        ]
                    }
                ],
