                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er rannte, so schnell er konnte, um seine <w>Verfolger</w> abzuschütteln."
                        },
                        {
                            "text": "Der Spion bemerkte einen heimlichen <w>Verfolger</w> auf der anderen Straßenseite."
                        }
                    ],
                    "synonyms": [
                        "Jäger",
                        "Häscher"
                    ],
