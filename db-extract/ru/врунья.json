                        "tags": [],
                        "examples": [
                            {
                                "example_id": "236f0748-ef9e-45dc-a01e-b1e67130f550",
                                "sense_id": "786c2e83-1ce3-3386-b380-aba87a3a81c7",
                                "text": "― Сама врёшь! Сама врунья!"
                            },
                            {
                                "example_id": "b58c558f-333d-412f-a0d1-b636e960ba71",
                                "sense_id": "786c2e83-1ce3-3386-b380-aba87a3a81c7",
                                "text": "Вы врунья, сударыня! Вот упрямый народ! Так и норовят одурачить бедного своего повелителя!"
                            }
                        ]
                    }
