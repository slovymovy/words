                ],
                "senses": [
                    {
                        "sense_id": "4fb65d63-d06b-34e5-9260-c5eb6f0771f7",
                        "entry_id": "68d3b86a-e26f-3a75-9d6a-5cc35ab73b82",
                        "glosses": [
                            "Médecin spécialiste des maladies cancéreuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed311d8-37fd-40b4-b7de-3a00044e8e9b",
                                "sense_id": "4fb65d63-d06b-34e5-9260-c5eb6f0771f7",
                                "text": "L’urologue, cancérologue spécialiste d’organe, est le premier intervenant dans plus de 95 % de la prise en charge des cancers urologiques ; 97 % de la cancérologie urologique sont pratiqués en dehors des centres anticancéreux."
                            },
                            {
                                "example_id": "6d7bfb85-44f8-4c1c-8fd2-e55a46247aa3",
                                "sense_id": "4fb65d63-d06b-34e5-9260-c5eb6f0771f7",
                                "text": "Cette approche, l’électrochimiothérapie, a été saluée par les applaudissements nourris de la communauté des cancérologues venus des quatre coins de la planète."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4e12453-2436-4f7d-8ddd-9da47d63c4ec",
                        "source_entry_id": "68d3b86a-e26f-3a75-9d6a-5cc35ab73b82",
                        "source_sense_id": "4fb65d63-d06b-34e5-9260-c5eb6f0771f7",
                        "target_lang_word": "Onkologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Onkologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27286a3b-5bf1-30f4-b31f-d19c8d2737e0",
                                        "entry_id": "d30886c5-1c11-3c00-b8a8-4ca3912e6d71",
                                        "glosses": [
                                            "Mediziner, der sich auf die Behandlung von Krebs spezialisiert hat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eb2cd86-a7c8-4473-ae83-23b47b7c997e",
                                                "sense_id": "27286a3b-5bf1-30f4-b31f-d19c8d2737e0",
                                                "text": "Für die Strahlenbehandlung musste sie nun zum Onkologen."
                                            },
                                            {
                                                "example_id": "4dc761e1-c1e3-4729-9585-ec72e07fbbfd",
                                                "sense_id": "27286a3b-5bf1-30f4-b31f-d19c8d2737e0",
                                                "text": "„Professor Doktor Pitter Pille ist internistischer Onkologe an einer großen Universitätsklinik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "295aa2cd-c8cd-4013-9f7e-10b730d5e2b1",
                        "source_entry_id": "68d3b86a-e26f-3a75-9d6a-5cc35ab73b82",
                        "source_sense_id": "4fb65d63-d06b-34e5-9260-c5eb6f0771f7",
                        "target_lang_word": "Onkologin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Onkologin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c99f48b4-56fe-3d82-97f6-18d34d558e83",
                                        "entry_id": "d8672859-622f-31b2-916a-b814ee13e376",
                                        "glosses": [
                                            "Medizinerin, die sich auf die Behandlung von Krebs spezialisiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "912c0647-7192-470a-8266-0f361b953fef",
                                                "sense_id": "c99f48b4-56fe-3d82-97f6-18d34d558e83",
                                                "text": "\"Gerade als ich genug Mut zusammengekratzt hatte, um mir eine Schwangerschaft vorstellen zu können, sah ich im Wartezimmer meiner Onkologin ein kleines Mädchen, das ein rosarotes Stoffhäschen in der Hand hielt.\""
                                            },
                                            {
                                                "example_id": "67e3b6df-8dad-4703-a157-c6259e459088",
                                                "sense_id": "c99f48b4-56fe-3d82-97f6-18d34d558e83",
                                                "text": "\"Aufgrund der Aggressivität des Krebses wurde seitens der Onkologin eine Chemotherapie empfohlen.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4825aa7-3560-48d3-be59-bb3b320b3754",
                        "source_entry_id": "68d3b86a-e26f-3a75-9d6a-5cc35ab73b82",
                        "source_sense_id": "4fb65d63-d06b-34e5-9260-c5eb6f0771f7",
                        "target_lang_word": "oncologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oncologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38b223ef-c0eb-3ec3-adab-a8bf366bce1d",
                                        "entry_id": "21c743a9-69d3-36c5-aa17-851816248502",
                                        "glosses": [
                                            "A doctor or scientist who specializes in oncology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42d67515-23a2-4e2f-a314-93f8bfcd2479",
                                                "sense_id": "38b223ef-c0eb-3ec3-adab-a8bf366bce1d",
                                                "text": "There's been a lot of screening, and people still die,\" says Ian Thompson, a urologic oncologist at the University of Texas Health Science Center, San Antonio."
                                            },
                                            {
                                                "example_id": "271723b9-cbf4-475f-86ab-5a748ae68912",
                                                "sense_id": "38b223ef-c0eb-3ec3-adab-a8bf366bce1d",
                                                "text": "When considered in combination with the use of antiangiogenic therapy, this diagnostic tool is easy to apply and has broad utility among medical oncologists to avoid the risk of hemosputum in the great vessels [ 5 ]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
