                                        "examples": [
                                            {
                                                "example_id": "02965da2-afe5-4220-bb41-207d18384621",
                                                "sense_id": "bb043307-62dd-3686-9d37-553fae1fd563",
                                                "text": "Toen Judas die woorden hoorde, kon hij zich niet beheersen en schreeuwde hij boven het rumoer van de menigte uit: 'Jullie hebben niet de moed om die dingen in zijn bijzijn te zeggen; ik zeg dat jullie de godslasteraars zijn."
                                            },
                                            {
                                                "example_id": "8df70533-e864-4e34-ab3c-6dace971087c",
                                                "sense_id": "bb043307-62dd-3686-9d37-553fae1fd563",
                                                "text": "Dezelfde dag zet bovendien een Pakistaanse cricketspeler omgerekend zo'n 20.000 euro op het hoofd van \"godslasteraar\" Geert Wilders. De PVV-leider zegt al honderden dreigementen te hebben ontvangen."
                                            }
                                        ]
                                    }
                                ]
                            }
