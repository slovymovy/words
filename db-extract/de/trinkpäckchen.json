                        "entry_id": "f958bb31-89f5-32ba-addf-5e1750f6d2f7",
                        "glosses": [
                            "Behältnis aus Karton oder Kunststoff, in dem sich eine Flüssigkeit zum Trinken befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a223fb2-50f4-4621-935d-4059e039aad9",
                                "sense_id": "b6b6259f-bb05-3076-beb3-65bd8a7f0548",
                                "text": "„Am Nachmittag liegen sie noch immer da. Auch die durchsichtige Hülle des Strohhalms vom Trinkpäckchen aus der Minibar liegt noch im Schlafzimmer neben der Stehlampe.“"
                            },
                            {
                                "example_id": "62919819-2854-4c09-975e-e2bdd99fb6f2",
                                "sense_id": "b6b6259f-bb05-3076-beb3-65bd8a7f0548",
                                "text": "„Der Bus hatte die Flüchtlinge vom Flughafen Hannover abgeholt, als Willkommensgeschenk drückte der Busfahrer seinen Passagieren Trinkpäckchen in die Hand.“"
                            }
                        ],
