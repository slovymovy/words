                        {
                            "text": "Een voorbijganger <w>merkte</w> <w>op</w> dat de dop nog op de lens zat.",
                            "target_lang_translations": {
                                "en": "A passerby <w>remarked</w> that the cap was still on the lens.",
                                "ru": "Прохожий <w>заметил</w>, что крышка всё ещё была на объективе.",
                                "pl": "Przechodzień <w>zauważył</w>, że dekielek wciąż znajduje się na obiektywie.",
                                "de": "Ein Passant <w>bemerkte</w>, dass die Kappe noch auf dem Objektiv saß.",
                                "fr": "Un passant a <w>fait remarquer</w> que le bouchon était encore sur l'objectif.",
                                "it": "Un passante <w>ha fatto notare</w> che il copriobiettivo era ancora sulla lente.",
                                "cs": "Kolemjdoucí <w>poznamenal</w>, že na objektivu je stále ještě krytka.",
                                "tr": "Yoldan geçen biri, kapağın hâlâ lensin üzerinde olduğunu <w>belirtti</w>.",
                                "es": "Un transeúnte <w>comentó</w> que la tapa todavía estaba puesta en la lente.",
                                "zh": "一名路人<w>指出</w>镜头盖还扣在上面。"
                            }
                        },
                        {
                            "text": "Hij <w>merkte</w> terecht <w>op</w> dat we nog niet klaar waren met het project.",
                            "target_lang_translations": {
                                "en": "He rightly <w>noted</w> that we were not yet finished with the project.",
                                "ru": "Он справедливо <w>отметил</w>, что мы ещё не закончили проект.",
                                "pl": "Słusznie <w>zauważył</w>, że jeszcze nie skończyliśmy projektu.",
                                "de": "Er <w>merkte</w> zu Recht <w>an</w>, dass wir mit dem Projekt noch nicht fertig waren.",
                                "fr": "Il a justement <w>fait observer</w> que nous n'avions pas encore terminé le projet.",
                                "it": "<w>Ha osservato</w> giustamente che non avevamo ancora finito il progetto.",
                                "cs": "Správně <w>podotkl</w>, že s projektem ještě nejsme hotovi.",
                                "tr": "Projeyi henüz bitirmediğimizi haklı olarak <w>dile getirdi</w>.",
                                "es": "<w>Señaló</w> con razón que todavía no habíamos terminado el proyecto.",
                                "zh": "他有理有据地<w>指出</w>我们还没有完成这个项目。"
                            }
                        }
