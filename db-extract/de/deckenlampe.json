                                        "entry_id": "88bcbf25-0f91-32db-a276-d13852347f9d",
                                        "glosses": [
                                            "A compartment above the seats for stowing luggage in a passenger aircraft."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fce97ab2-83c2-4faa-a5de-1b5bb3a25d52",
                                                "sense_id": "70a2e456-be90-33e2-a53a-b16688172a77",
                                                "text": "There was no room left in the overheads for our luggage, our seats did not recline, and the washrooms were right behind us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "253017a7-4628-30c6-828a-61a300997d1b",
                                        "entry_id": "88bcbf25-0f91-32db-a276-d13852347f9d",
                                        "glosses": [
                                            "The system of overhead wires used to power electric transport, such as streetcars, trains, or buses."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad39d02c-d845-3887-9818-b493c4f7841c",
                                        "entry_id": "88bcbf25-0f91-32db-a276-d13852347f9d",
                                        "glosses": [
                                            "Data or steps of computation used only to facilitate the computations in the system and not directly related to the actual program code or data being processed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecd3373c-c273-4249-a022-50a5e61dce4d",
                                                "sense_id": "ad39d02c-d845-3887-9818-b493c4f7841c",
                                                "text": "Network overhead is the header data that is required to route and transport data over the network, whereas fork overhead is the additional time and memory cost of creating and managing new processes within the operating system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "957ecb45-30a0-3931-848c-472037d59aa8",
                                        "entry_id": "88bcbf25-0f91-32db-a276-d13852347f9d",
                                        "glosses": [
                                            "An overhead throw."
                                        ],
