                ],
                "senses": [
                    {
                        "sense_id": "60fb2557-7905-3791-bbae-743b823d4284",
                        "entry_id": "972b91a3-adef-34f2-88f6-d707caf5d56e",
                        "glosses": [
                            "A police officer, usually a male."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24379d2b-dc87-4a27-b67c-5faa85887f3d",
                                "sense_id": "60fb2557-7905-3791-bbae-743b823d4284",
                                "text": "The policeman who arrests the \"Red\" does not understand the theories the \"Red\" is preaching; if he did, his own position as bodyguard of the monied class might seem less pleasant to him."
                            },
                            {
                                "example_id": "93617855-7138-4600-936c-a7540f86d798",
                                "sense_id": "60fb2557-7905-3791-bbae-743b823d4284",
                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                            },
                            {
                                "example_id": "a9eac769-d510-4e14-b7b2-c68572a22dc6",
                                "sense_id": "60fb2557-7905-3791-bbae-743b823d4284",
                                "text": "Still agitated, she watched resentfully as two traffic policemen remounted their motorcycles."
                            }
                        ]
                    },
                    {
                        "sense_id": "a198f39c-877d-3ad4-a59a-3c16d2f990fd",
                        "entry_id": "972b91a3-adef-34f2-88f6-d707caf5d56e",
                        "glosses": [
                            "A glass rod capped at one end with rubber, used in a chemistry laboratory for gravimetric analysis."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8c613385-770d-313b-b0ba-7c5ea4be5d58",
                        "entry_id": "972b91a3-adef-34f2-88f6-d707caf5d56e",
                        "glosses": [
                            "Any skipper of the genus Coeliades."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bc384f96-4702-332f-821f-cbdf87167c60",
                        "entry_id": "972b91a3-adef-34f2-88f6-d707caf5d56e",
