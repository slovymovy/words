        "fr-extract.jsonl": [
            {
                "entry_id": "7788e789-e307-31fb-a4cf-6d13955875cd",
                "word": "pantoute",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "93726212-e9bc-3bbb-8fb4-0acca7bd07b4",
                        "entry_id": "7788e789-e307-31fb-a4cf-6d13955875cd",
                        "glosses": [
                            "Du tout."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "2a0a0c80-fab6-40de-b9de-188366b90f91",
                                "sense_id": "93726212-e9bc-3bbb-8fb4-0acca7bd07b4",
                                "text": "— On n'a rien trouvé pantoute, lieutenant, répondit Lapointe sur un ton très militaire."
                            },
                            {
                                "example_id": "68d12be0-af05-4022-b1ee-3a9d6beb2c7b",
                                "sense_id": "93726212-e9bc-3bbb-8fb4-0acca7bd07b4",
                                "text": "Est-ce mal, docteur ? Réponse courte ? Pantoute."
                            },
                            {
                                "example_id": "b1f3278c-41c8-452c-b6e0-73839f3a7c67",
                                "sense_id": "93726212-e9bc-3bbb-8fb4-0acca7bd07b4",
                                "text": "«Ce n’est pas réglé pantoute», a laissé tomber François Legault, rappelant qu’il manquera 5 milliards $ par année pour financer adéquatement les besoins en santé."
                            },
                            {
                                "example_id": "ef353938-c51d-4704-9f74-c7dcb08e7474",
                                "sense_id": "93726212-e9bc-3bbb-8fb4-0acca7bd07b4",
                                "text": "Y mouillera pus pantoute, pantoute\nY mouillera pus pantoute\nLa compagnie des parapluies\nEst virée en banqueroute!"
                            },
                            {
                                "example_id": "40a20ea5-eff3-412f-956e-897e7f066a78",
                                "sense_id": "93726212-e9bc-3bbb-8fb4-0acca7bd07b4",
                                "text": "Je n’en veux pas pantoute."
                            },
                            {
                                "example_id": "c2ab273a-576f-419d-8c41-d0cb0507d55b",
                                "sense_id": "93726212-e9bc-3bbb-8fb4-0acca7bd07b4",
                                "text": "Il n’en reste plus pantoute."
                            }
                        ]
                    }
                ],
