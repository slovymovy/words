                    {
                        "sense_id": "77d652fd-2de4-3e7e-8644-6258e61248a6",
                        "entry_id": "ffdbfeaf-bdf5-3381-aa2a-5a2745c72c57",
                        "glosses": [
                            "Action de lever la main, les pieds en battant la mesure."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "841d7db9-5959-3a75-92fa-85e80c457ab4",
                        "entry_id": "ffdbfeaf-bdf5-3381-aa2a-5a2745c72c57",
                        "glosses": [
                            "Temps pendant lequel on lève le pied, la main."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dda968ea-92ae-3712-8648-95826bb2a5bd",
                        "entry_id": "ffdbfeaf-bdf5-3381-aa2a-5a2745c72c57",
                        "glosses": [
                            "Action de lever un plan ou ce plan lui-même ; lever."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5d388fc-79d1-40e7-acc5-e5080448924a",
                                "sense_id": "dda968ea-92ae-3712-8648-95826bb2a5bd",
                                "text": "Un réseau géodésique a été créé sur l'atoll de Raroia à l'occasion du levé du chenal menant de la passe Ngarue jusqu'au village de Ngarumaova. Les travaux se sont déroulés pour l'essentiel en 1994 et ont été complétés en juin 1997."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ed34d9b-5079-38b6-ad60-5e23fd0f1b92",
                        "entry_id": "ffdbfeaf-bdf5-3381-aa2a-5a2745c72c57",
                        "glosses": [
                            "Se dit de l’ours quand il est représenté debout sur ses pattes arrière. À rapprocher de debout, en pied et rampant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3b5c66d-fcea-4d0f-8c79-49f1fa575cd6",
                                "sense_id": "3ed34d9b-5079-38b6-ad60-5e23fd0f1b92",
                                "text": "D’or au chêne arraché de sinople, à l’ours levé de sable, à senestre, appuyé contre le fût de l’arbre ; à la bordure de gueules chargée de huit flanchis d’or, 3, 2 et 3, qui est de la famille Picassarry → voir illustration « ours levé »"
                            }
                        ]
                    },
                    {
                        "sense_id": "0fa0f327-9fca-349e-afaf-2e732413e86e",
                        "entry_id": "ffdbfeaf-bdf5-3381-aa2a-5a2745c72c57",
                        "glosses": [
                            "Se dit d’un membre qui est représenté avec une position plus haute que les autres membres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61e1a522-1a86-4e8c-bb99-c30b4bcc749a",
                                "sense_id": "0fa0f327-9fca-349e-afaf-2e732413e86e",
                                "text": "D’argent à cinq flammes de gueules issant d’un mont de sable chargé d’une main index levé d’or et posé sur un lac d’azur, qui est de → voir illustration « index levé »"
                            }
                        ]
                    },
                    {
                        "sense_id": "cefc2a10-db37-378b-9a2e-9f4cd1778aae",
                        "entry_id": "ffdbfeaf-bdf5-3381-aa2a-5a2745c72c57",
                        "glosses": [
                            "Résultat d’un lever."
                        ],
                        "tags": [],
                        "examples": []
                    },
