{
    "word_family": [
        "intellectual",
        "intellectualize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4998b4d-47ff-3ba2-b9e5-73ed620ba2fe",
                    "sense_definition": "The human faculty of thinking, reasoning, and understanding concepts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cognitive_faculty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>intellect</w> allows humans to solve complex problems through logic.",
                            "target_lang_translations": {
                                "zh": "<w>智力</w>使人类能够通过逻辑解决复杂的问题。"
                            }
                        },
                        {
                            "text": "Art often appeals to the emotions rather than the <w>intellect</w>.",
                            "target_lang_translations": {
                                "zh": "艺术往往诉诸情感，而非<w>理智</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intelligence",
                        "mind",
                        "reason"
                    ],
                    "target_lang_definitions": {
                        "zh": "人类思考、推理和理解概念的能力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "智力",
                                "target_lang_sense_clarification": "指人类进行逻辑思维和理解抽象概念的认知能力。"
                            },
                            {
                                "target_lang_word": "理智",
                                "target_lang_sense_clarification": "指辨别是非、进行理性思考的能力。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2653558-3d18-3e13-9c92-88b6973d1443",
                    "sense_definition": "The level of mental ability or intelligence possessed by a person.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cognitive_faculty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was admired for her sharp <w>intellect</w> and quick wit.",
                            "target_lang_translations": {
                                "zh": "她因敏锐的<w>才智</w>和机智的反应而受到钦佩。"
                            }
                        },
                        {
                            "text": "The job requires a person of high <w>intellect</w> to manage the data.",
                            "target_lang_translations": {
                                "zh": "这份工作需要一个<w>才智</w>过人的人来管理这些数据。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intelligence",
                        "brains",
                        "wit"
                    ],
                    "target_lang_definitions": {
                        "zh": "一个人所拥有的智力水平或聪明程度。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "才智",
                                "target_lang_sense_clarification": "指一个人的聪明才干和智力水平。"
                            },
                            {
                                "target_lang_word": "智慧",
                                "target_lang_sense_clarification": "指分析、判断和解决问题的能力。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "313d25e9-6687-36ea-85a4-9a29d3de1e9f",
                    "sense_definition": "A person who is highly intelligent and interested in serious study or thought.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cognitive_faculty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many of the country's greatest <w>intellects</w> gathered to discuss the new policy.",
                            "target_lang_translations": {
                                "zh": "该国许多最伟大的<w>知识分子</w>齐聚一堂，讨论这项新政策。"
                            }
                        },
                        {
                            "text": "He is considered one of the leading <w>intellects</w> in the field of physics.",
                            "target_lang_translations": {
                                "zh": "他被认为是物理学领域最顶尖的<w>知识分子</w>之一。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intellectual"
                    ],
                    "target_lang_definitions": {
                        "zh": "指智力超群且热衷于严肃学术研究或思想探讨的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "知识分子",
                                "target_lang_sense_clarification": "指具有较高文化水平、从事脑力劳动的人。"
                            },
                            {
                                "target_lang_word": "智者",
                                "target_lang_sense_clarification": "指非常有智慧、思想深邃的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}