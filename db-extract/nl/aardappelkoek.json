                        "examples": [
                            {
                                "example_id": "9ae914b8-9d18-4bbb-a8cf-f7b7bf499407",
                                "sense_id": "b5987caf-ca8e-32f8-b286-3cd102607e90",
                                "text": "Wij, de huisgenoten, dienden het gekruide bier en de punch, de saffraankoek, de aardappelkoek, pasteitjes en peperkoek rond, zoals op Menfreya door vele generaties op Kerstmis was gedaan."
                            },
                            {
                                "example_id": "7e890771-4ee1-4f9e-b1f8-9d015fe0b376",
                                "sense_id": "b5987caf-ca8e-32f8-b286-3cd102607e90",
                                "text": "Aardappelkoek, naar het recept van de vader van Ronald: Je laat jezelf toch niet door een kóókboek vertellen wat je moet doen? Ziehier in een notendop de levensfilosofie van Gipharts vader Rob."
                            }
                        ]
