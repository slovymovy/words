                "senses": [
                    {
                        "sense_id": "ed4d358f-0dce-3e2a-9494-bc045b944809",
                        "entry_id": "09bf4cee-8842-30b7-9d57-69f28b170bef",
                        "glosses": [
                            "(massive) aufrollbare Jalousie (insbesondere an der Außenseite von Fenstern oder Türen eines Geschäftes)"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "4561948c-9e6a-4642-b8ef-873dd98c8740",
                                "sense_id": "ed4d358f-0dce-3e2a-9494-bc045b944809",
                                "text": "„Wellblech für Rollbalken wird aus Triest eingeführt.“"
                            },
                            {
                                "example_id": "6ad505ba-ca15-4437-8b81-fb1b8af9b1d9",
                                "sense_id": "ed4d358f-0dce-3e2a-9494-bc045b944809",
                                "text": "„Und schon war er verschwunden, und schon hörte ich vor der Tür den Rollbalken niederrollen.“"
                            },
                            {
                                "example_id": "9bc260a7-900d-4204-aae9-20369dc02ff1",
                                "sense_id": "ed4d358f-0dce-3e2a-9494-bc045b944809",
                                "text": "„Die Kaufhäuser und Geschäfte müssen schon um sieben Uhr abends die Rollbalken runterlassen.“"
                            },
                            {
                                "example_id": "a0ab40f2-4b49-4840-8e78-1b0a7d721ed6",
                                "sense_id": "ed4d358f-0dce-3e2a-9494-bc045b944809",
                                "text": "„Die Entdeckungsgeschichte des einstigen Tanzcafés auf der anderen Straßenseite – versteckt hinter rostigen Rollbalken – ist eine kuriose: Zuerst meldet sich die Hausverwaltung nicht auf Anfragen, dann gibt es keinen Schlüssel zu den Räumen.“"
                            },
                            {
                                "example_id": "19a7f4fb-9139-4d20-8acb-b741043e290c",
                                "sense_id": "ed4d358f-0dce-3e2a-9494-bc045b944809",
                                "text": "„Als ein Schuss fiel, wurden beim Parlament Rollbalken heruntergelassen.“"
                            },
                            {
                                "example_id": "19be6a0b-acdf-42b0-8ec4-c26e376d7968",
                                "sense_id": "ed4d358f-0dce-3e2a-9494-bc045b944809",
                                "text": "„Sie wäre lieber nicht mit dem Mann allein geblieben. Unwillkürlich prüfte sie, ob der Laden Rollbalken hatte, die er herunterlassen könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "028a2189-5a76-3c71-bd3d-0f3db148237d",
                        "entry_id": "09bf4cee-8842-30b7-9d57-69f28b170bef",
                        "glosses": [
                            "Element zur Navigation auf einer grafischen Benutzeroberfläche, mithilfe dessen der sichtbare Ausschnitt eines bestimmten Inhalts (zum Beispiel: Grafik, Text) vertikal oder horizontal verschoben werden kann"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "ed956877-fb9e-40b9-b9ab-a65c7014dfa8",
                                "sense_id": "028a2189-5a76-3c71-bd3d-0f3db148237d",
                                "text": "„Fenster haben ferner einen Rollbalken, der es gestattet, mit der Maus den Fensterinhalt wie eine Schriftrolle vorwärts- und rückwärts zu bewegen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
