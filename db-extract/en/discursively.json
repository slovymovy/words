                ],
                "senses": [
                    {
                        "sense_id": "9291eb16-ca00-3c40-8b0a-343591030d2c",
                        "entry_id": "a8706aa1-b877-3bf1-b108-ed73d372d6ea",
                        "glosses": [
                            "In a discursive manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcc4ea8c-eaac-4ce3-b6f8-9adcb01e5fbe",
                                "sense_id": "9291eb16-ca00-3c40-8b0a-343591030d2c",
                                "text": "If then I seem to step somewhat too discursively from point to point of my topic, let me suggest that I do so in the hope of thus the better keeping unbroken that chain of graduated impression by which alone the intellect of Man can expect to encompass the grandeurs of which I speak, and, in their majestic totality, to comprehend them."
                            },
                            {
                                "example_id": "4328ba7e-0f52-4f06-a26f-8b8152a1b2c6",
                                "sense_id": "9291eb16-ca00-3c40-8b0a-343591030d2c",
                                "text": "There were certain things […] that pricked him to talk discursively and incautiously; but now he realized that he had only been talking like a character in a novel, and not a very good novel."
                            },
                            {
                                "example_id": "95c3d447-5115-4625-b42d-46ad967e89e9",
                                "sense_id": "9291eb16-ca00-3c40-8b0a-343591030d2c",
                                "text": "We are dealing in the Iliad with a commanding vision of man, articulate in every detail, not with a tale of adventure automatically or discursively carried forward."
                            },
                            {
                                "example_id": "402b98de-cc1a-4ab2-8244-d8e7ab761856",
                                "sense_id": "9291eb16-ca00-3c40-8b0a-343591030d2c",
                                "text": "In that realm, which was discursively constructed and called the Orient, certain kinds of assertions could be made, all of them possessing the same powerful generality and cultural validity."
                            }
                        ]
                    }
                ],
