                "senses": [
                    {
                        "sense_id": "1acd1c36-c30c-3ad5-a3be-65688958f855",
                        "entry_id": "13f7d78c-e5bc-3900-bfb8-973a78beb6a2",
                        "glosses": [
                            "Krieg, bei dem die Truppen mindestens einer Partei gegen den Gegner aktiv vorrücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7236b19b-bdf6-40b3-adad-4da655ba8dcf",
                                "sense_id": "1acd1c36-c30c-3ad5-a3be-65688958f855",
                                "text": "„Offenbar war die Partisanenpsychose ein Phänomen des Bewegungskrieges, das verschwand, sobald die Fronten erstarrten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16102e0e-d58b-44c8-a6e7-82008ecc8633",
                        "source_entry_id": "13f7d78c-e5bc-3900-bfb8-973a78beb6a2",
                        "source_sense_id": "1acd1c36-c30c-3ad5-a3be-65688958f855",
                        "source_sense_description": "Krieg, bei dem die Truppen mindestens einer Partei gegen den Gegner aktiv vorrücken",
                        "target_lang_word": "guerre de mouvement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guerre de mouvement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d5e49e5-7700-3bd4-a121-07a373c15dd1",
                                        "entry_id": "532d3d5a-48b3-3bf5-9156-18c485055958",
                                        "glosses": [
                                            "Guerre où les mouvements de troupes sont nombreux et jouent un grand rôle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8dfb1b4-a8eb-4878-a5c1-dd88527ee92f",
                                                "sense_id": "0d5e49e5-7700-3bd4-a121-07a373c15dd1",
                                                "text": "La guerre prend un double visage : elle est en même temps une guerre de position et une guerre de mouvement."
                                            },
                                            {
                                                "example_id": "bd9397b6-cd52-4339-a48e-ecd12e8a2d12",
                                                "sense_id": "0d5e49e5-7700-3bd4-a121-07a373c15dd1",
                                                "text": "Sur le plan proprement militaire, c'est la différence entre les guerres napoléoniennes et la guerre de 1914-1918 qui illustre le mieux le contraste entre guerre de mouvement et guerre de position, et qui atteste que, dans ce domaine aussi,l’évolution conduit de l’une à l’autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae83da42-ccdc-3d76-a02e-89483ed04338",
                                        "entry_id": "532d3d5a-48b3-3bf5-9156-18c485055958",
                                        "glosses": [
                                            "Être partout, sur tous les fronts, pour gagner un combat."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d622bf16-32fc-4516-95d5-a0f4522252b5",
                                                "sense_id": "ae83da42-ccdc-3d76-a02e-89483ed04338",
                                                "text": "La double triangulation, qui consiste à incarner les progressistes en matière écologique et les conservateurs sur l’immigration, n’est pas possible sur la durée. C’est une guerre de mouvement, qui risque de nous offrir uniquement des succès tactiques à court terme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
