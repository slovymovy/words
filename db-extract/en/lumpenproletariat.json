                                        "sense_id": "591eaa7a-1aa4-3176-9ce2-ddeeaffbcd9e",
                                        "entry_id": "40b10946-3273-3d52-84bc-bc56ef9616f4",
                                        "glosses": [
                                            "Terme d’origine marxiste, désignant une population située socialement sous le prolétariat, du point de vue des conditions de travail et de vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f944279-f746-4aae-82d6-943a32886dd3",
                                                "sense_id": "591eaa7a-1aa4-3176-9ce2-ddeeaffbcd9e",
                                                "text": "[..] par admiration pour Jaurès, et surtout par mépris des patrons, qu’il jugeait incompétents, étant, lui, parti du lumpenproletariat, et parvenu par son intelligence au rang d’employé [..]"
                                            },
                                            {
                                                "example_id": "c0ed84d2-f162-4c8b-82ac-debd7afb8651",
                                                "sense_id": "591eaa7a-1aa4-3176-9ce2-ddeeaffbcd9e",
                                                "text": "Elle mit leurs réactions sur le compte de leur haine du lumpenproletariat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32626b65-58d9-3880-bef5-80ff0025cee7",
                                        "entry_id": "40b10946-3273-3d52-84bc-bc56ef9616f4",
                                        "glosses": [
                                            "Appellations des populations vivant dans la misère durant l’époque industrielle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e0adb06-3218-4da2-a399-fbdfc4d838e1",
                        "source_entry_id": "3f1be38c-f37b-3f05-a5d6-54c334e6b716",
                        "source_sense_description": "in Marxism: the lowest stratum of the proletariat",
                        "target_lang_word": "Lumpenproletariat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lumpenproletariat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f17fe1dc-c170-301e-be1e-0fdf8c0911be",
                                        "entry_id": "7687741a-2512-3dbc-b7da-ededc08567b3",
                                        "glosses": [
                                            "„unterste Gesellschaftsschicht ohne Klassenbewusstsein“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dab3171-069b-443a-a9d3-7d07a5376f1f",
                                                "sense_id": "f17fe1dc-c170-301e-be1e-0fdf8c0911be",
                                                "text": "„Die Schwienteks, die Choloneks und ihre Nachbarn sind ein grotesk beschriebenes Lumpenproletariat, gerne mit Ambitionen in Richtung Bürgerlichkeit.“"
                                            },
                                            {
                                                "example_id": "6362403e-1d21-40e3-9300-2a3e87ed5bed",
                                                "sense_id": "f17fe1dc-c170-301e-be1e-0fdf8c0911be",
                                                "text": "„An vielen Orten hielt sich die eingesessene tschechische Bevölkerung – das Lumpenproletariat, das es in allen Städten von einer bestimmten Größe an gibt, vielleicht ausgenommen – bei Brutalitäten gegenüber den eingesessenen Deutschen zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
