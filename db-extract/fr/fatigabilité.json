                "senses": [
                    {
                        "sense_id": "c8d06860-608c-31b2-8aae-0d781ca4e32a",
                        "entry_id": "1ff97034-3c9f-3445-b9b5-3d5bdd1e05ba",
                        "glosses": [
                            "Qualité de ce qui est fatigable ; propension à se fatiguer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e1347a0-ded4-4980-bff4-0e792d4b9d2d",
                                "sense_id": "c8d06860-608c-31b2-8aae-0d781ca4e32a",
                                "text": "L’étude a été conduite dans trois perspectives : rapidité, régularité et fatigabilité neuromusculaire."
                            },
                            {
                                "example_id": "2edb1549-ed4b-4f2c-901c-7ad5e73689d5",
                                "sense_id": "c8d06860-608c-31b2-8aae-0d781ca4e32a",
                                "text": "Cette fatigabilité diurne, rapportée par un tiers des sujets dépressifs âgés, est trop souvent banalisée et mise sur le compte du vieillissement, du ralentissement lié à l'âge et des pathologies associées."
                            },
                            {
                                "example_id": "9cc72737-6361-4bfe-bf37-1a872dbf5493",
                                "sense_id": "c8d06860-608c-31b2-8aae-0d781ca4e32a",
                                "text": "Les symptômes sont une plus grande fatigabilité, puis une toux, et des troubles cardiaques qui peuvent provoquer secondairement des syncopes."
                            }
                        ]
                    }
                ],
