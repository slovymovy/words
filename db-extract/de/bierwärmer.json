                "senses": [
                    {
                        "sense_id": "e308a5d2-7d15-3611-a21b-e11484c1b84e",
                        "entry_id": "7e75a109-9f5b-34b5-a2f3-efaaa529a613",
                        "glosses": [
                            "heißes Wasser enthaltendes metallisches Gefäß, mit dem man Bier in einem Glas erwärmen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63741392-0ccb-4fbf-a79b-7ae4c95a7166",
                                "sense_id": "e308a5d2-7d15-3611-a21b-e11484c1b84e",
                                "text": "„Der Kläger verlangte keinen Bierwärmer, weil er kaltes Bier bevorzugt.“"
                            },
                            {
                                "example_id": "6d2b6289-a069-4990-9456-a887c2496fe6",
                                "sense_id": "e308a5d2-7d15-3611-a21b-e11484c1b84e",
                                "text": "„In Biergärten und anderen Ausschankörtlichkeiten hat das Bier aus Fässern zumeist dieselbe Temperatur, wohingegen viele Menschen sehr individuelle Vorlieben bezüglich der richtigen Temperatur haben. Daher gibt es sogenannte Bierwärmer, mit denen ein Bier individuell temperiert werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
