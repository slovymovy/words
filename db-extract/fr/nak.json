            {
                "entry_id": "202fbe34-67f5-30bf-8574-d58a2ad3485d",
                "word": "NaK",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6426ee8c-04eb-35e3-b5df-ffb27f3629ed",
                        "entry_id": "202fbe34-67f5-30bf-8574-d58a2ad3485d",
                        "glosses": [
                            "Alliage de sodium et de potassium qui a la particularité d’être liquide à température ambiante et qui est très réactif à l’eau et aux matériaux organiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "115737b5-5b3f-4ddb-bb44-7bd0e6484a26",
                                "sense_id": "6426ee8c-04eb-35e3-b5df-ffb27f3629ed",
                                "text": "Schreier de Vienne suggéra, vers la même époque, le sodium-potassium : le NaK, au contact des matières organiques et de l’humidité, provoque une explosion avec flamme et fumée."
                            },
                            {
                                "example_id": "027d1486-36ce-4993-9f34-04d869427db5",
                                "sense_id": "6426ee8c-04eb-35e3-b5df-ffb27f3629ed",
                                "text": "Le NaK a été utilisé d’une part pour réduire le gradient longitudinal de la température et d’autre part pour supprimer les résistances thermiques radiales qu’introduiraient des espaces gazeux."
                            }
                        ]
                    }
                ],
