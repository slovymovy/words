                "translations": [
                    {
                        "translation_id": "4185acab-9275-496f-b485-771c723c608c",
                        "source_entry_id": "a9d4fb64-a2f3-3658-8d02-daf84a3efb06",
                        "target_lang_word": "晶体管",
                        "target_lang_code": "zh",
