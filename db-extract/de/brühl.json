                "senses": [
                    {
                        "sense_id": "e28d1b8c-0dc0-30b1-90d5-64a5a8022899",
                        "entry_id": "8b8169ba-8098-3b63-a5f3-d73f58f450f4",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b951c7a8-f5f0-42a2-a18d-83b108d2592e",
                                "sense_id": "e28d1b8c-0dc0-30b1-90d5-64a5a8022899",
                                "text": "Brühls kamen, sahen und siegten."
                            },
                            {
                                "example_id": "16ad5749-dd84-4315-a325-fc854201a70a",
                                "sense_id": "e28d1b8c-0dc0-30b1-90d5-64a5a8022899",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brühl kommt, geht der Herr Brühl.“"
                            },
                            {
                                "example_id": "46e6832d-df7a-45c8-be95-ac7361bde061",
                                "sense_id": "e28d1b8c-0dc0-30b1-90d5-64a5a8022899",
                                "text": "Der Brühl trägt nie die Schals, die die Brühl ihm strickt."
                            },
                            {
                                "example_id": "1fdacbd4-4ef5-4676-916b-b8a7c9f5dab8",
                                "sense_id": "e28d1b8c-0dc0-30b1-90d5-64a5a8022899",
                                "text": "Brühl kommt und geht."
                            },
                            {
                                "example_id": "bca7ee93-e441-4e49-9f5c-47b6cbc1ac90",
                                "sense_id": "e28d1b8c-0dc0-30b1-90d5-64a5a8022899",
                                "text": "Frau Brühl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "84d6ff99-e63c-4b78-a72e-1a5eb40d6a3d",
                                "sense_id": "e28d1b8c-0dc0-30b1-90d5-64a5a8022899",
                                "text": "Herr Brühl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bec71496-13bb-4e0f-9daa-6b9ecd1f6a5d",
                                "sense_id": "e28d1b8c-0dc0-30b1-90d5-64a5a8022899",
                                "text": "Die Brühls fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
