                ],
                "senses": [
                    {
                        "sense_id": "82fa3b85-41e5-34ef-a59f-857fc3e08075",
                        "entry_id": "8c7d22a9-1603-34a2-8551-7242fc715809",
                        "glosses": [
                            "To torment or provoke."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52698ebc-1cf8-4640-9648-752b837ea0d6",
                                "sense_id": "82fa3b85-41e5-34ef-a59f-857fc3e08075",
                                "text": "Creditors, snarling, hound him on from without; mocked Hopes, lost Labours, bearbait him from within: to these torments his fixed-idea keeps him chained."
                            },
                            {
                                "example_id": "1d15815e-5a00-42ae-9209-a15095c667f9",
                                "sense_id": "82fa3b85-41e5-34ef-a59f-857fc3e08075",
                                "text": "He used to fight the larger negro boys when they would bearbait dogs by tying tin cans to their tails."
                            },
                            {
                                "example_id": "79844e26-de6c-42b4-96f1-2e27f15bb931",
                                "sense_id": "82fa3b85-41e5-34ef-a59f-857fc3e08075",
                                "text": "Talk show hosts bearbaited them, photo editors published unflattering, even demeaning pictures, and the print media ridiculed their intelligence, education, hair, clothing, and personal relationship—rather than addressing the issues."
                            },
                            {
                                "example_id": "28f7ef0d-3a5c-4c10-b7a7-fd66ba89c6a5",
                                "sense_id": "82fa3b85-41e5-34ef-a59f-857fc3e08075",
                                "text": "That was why they bearbaited him in the first place—they hoped for some uncivilized response they could further ridicule."
                            }
                        ]
                    }
