                "senses": [
                    {
                        "sense_id": "c04e11bc-34a2-36e4-811d-a33a2e178e05",
                        "entry_id": "d321362f-943d-3279-b369-4bd26b6f29aa",
                        "glosses": [
                            "Conflit durable, persistant, permanent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1762970-0918-49d5-ae75-5e062779a328",
                                "sense_id": "c04e11bc-34a2-36e4-811d-a33a2e178e05",
                                "text": "Der Dauerkonflikt zwischen ihnen ist wirklich lästig.",
                                "translation": "Le conflit permanent entre eux est vraiment pesant."
                            },
                            {
                                "example_id": "c36f58d1-8463-4d30-b797-c39a3322dee4",
                                "sense_id": "c04e11bc-34a2-36e4-811d-a33a2e178e05",
                                "text": "Der Dauerkonflikt zwischen Katholiken und Protestanten mündete in verheerende Kriege.",
                                "translation": "Le conflit durable entre les catholiques et les protestants déboucha sur des guerres terribles."
                            },
                            {
                                "example_id": "0c6be1e9-59ef-4c22-a280-b809983da609",
                                "sense_id": "c04e11bc-34a2-36e4-811d-a33a2e178e05",
                                "text": "Ölmultis und Umweltaktivisten stehen unter Dauerkonflikt.",
                                "translation": "Les multinationales pétrolières et les activistes écologistes sont en conflit permanent."
                            }
                        ]
                    }
