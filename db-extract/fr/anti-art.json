            {
                "entry_id": "4d31d2d0-d5ab-3ab7-8fef-eddb111a8eae",
                "word": "anti-art",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2fb56da8-0ee8-43a8-a245-73a920743073",
                        "entry_id": "4d31d2d0-d5ab-3ab7-8fef-eddb111a8eae",
                        "tags": [],
                        "form": "antiart"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b46e718-e918-3624-a44e-d98c6e4e56cb",
                        "entry_id": "4d31d2d0-d5ab-3ab7-8fef-eddb111a8eae",
                        "glosses": [
                            "Ensemble de concepts et d'attitudes initiés par le dadaïsme qui rejettent l’art établi, traditionnel, et peuvent eux-mêmes prendre ou non la forme d’art."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc6f3683-b911-4bee-acde-4c1652c8e596",
                                "sense_id": "8b46e718-e918-3624-a44e-d98c6e4e56cb",
                                "text": "Défini dans ses principes fondamentaux par les artistes conceptuels, l’art contemporain se pose comme anti-art, comme critique de l’esthétisme, du formalisme et de la représentation."
                            },
                            {
                                "example_id": "8e050a60-73eb-4297-a88f-bca4321a76e2",
                                "sense_id": "8b46e718-e918-3624-a44e-d98c6e4e56cb",
                                "text": "L’art actuel a le sens de la provocation et de la rupture qui l’amènent à la limite du kitsch, forme d’anti-art ou d’art populaire que Dada ou le Pop Art avaient remis à l’honneur."
                            }
                        ]
                    }
                ],
