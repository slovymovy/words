                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2bb909e-356c-4efc-b3d1-ccfe92c63d54",
                                "sense_id": "43e5cb5d-69c2-373e-8349-3db6683dfb93",
                                "text": "К Ларину явилась за помощью депутация от авиационных заводов, когда они были в бедственном положении."
                            },
                            {
                                "example_id": "0b79cca3-c7b7-436e-9bbe-5079cd392afc",
                                "sense_id": "43e5cb5d-69c2-373e-8349-3db6683dfb93",
                                "text": "Депутация, возглавляемая сотником Портновым, в июле 1770 года прибыла в Царское Село, где жила Екатерина."
                            }
                        ]
                    }
