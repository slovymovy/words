                    },
                    {
                        "translation_id": "fcd47408-037a-4d88-8081-921a2ee08506",
                        "source_entry_id": "faa09fe9-e69b-3865-9ae0-378fec74892b",
                        "source_sense_description": "able to cause disease",
                        "target_lang_word": "ziekteverwekkend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ziekteverwekkend",
