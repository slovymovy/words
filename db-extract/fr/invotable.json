                    {
                        "sense_id": "876ac820-bcf5-317a-a4fc-bbf9c47b54b1",
                        "entry_id": "56215aea-2fd4-37e5-9542-2055bb17ef1e",
                        "glosses": [
                            "Qui ne peut pas être voté, généralement en parlant d’une loi ou d’un texte juridique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7043b5e1-c764-403f-86f9-75ccd4d1e32e",
                                "sense_id": "876ac820-bcf5-317a-a4fc-bbf9c47b54b1",
                                "text": "Jean-Vincent Placé …, chef de file des sénateurs écologistes, dit «stop au pacte de responsabilité» qui est «invotable en l’état» et «ne sera pas voté par la majorité»."
                            },
                            {
                                "example_id": "85b4c2a3-00e5-48ec-a499-99117cd4e6d3",
                                "sense_id": "876ac820-bcf5-317a-a4fc-bbf9c47b54b1",
                                "text": "Reste à voir quel texte sortira du Sénat. Certains socialistes espèrent que le projet de loi y sera tellement modifié qu’il deviendra invotable par la majorité."
                            },
                            {
                                "example_id": "e5a4ad72-edf8-48ec-bcd3-5e27a3ec4c34",
                                "sense_id": "876ac820-bcf5-317a-a4fc-bbf9c47b54b1",
                                "text": "Dans dix-huit jours Eva l’invotable fera 2 %. Elle n’aurait pas dû se présenter."
                            }
                        ]
                    }
                ],
