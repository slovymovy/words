                        "entry_id": "1950b470-4471-3a2b-8041-5e113987e692",
                        "glosses": [
                            "Betriebsstätte eines Eisenbahnunternehmens, in der etwa Waggons, Lokomotiven und Triebwagen überprüft und gegebenenfalls repariert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89bc2ee3-cb4a-4c38-8433-d6e3955432c3",
                                "sense_id": "a5fe72e8-6d03-3fea-9b63-8a8582d10138",
                                "text": "Im Ausbesserungswerk wurde der Defekt behoben."
                            },
                            {
                                "example_id": "8c3a25ac-582e-411a-8846-51a5bd2d8137",
                                "sense_id": "a5fe72e8-6d03-3fea-9b63-8a8582d10138",
                                "text": "„Das bedeutet, dass die Bahn Zusagen über Investitionen in Strecken oder Ausbesserungswerke an die Bedingung geknüpft haben könnte, dass die Länder sie vor Konkurrenz schützt [sic!].“"
                            },
                            {
                                "example_id": "10d50945-84c5-490c-ae68-400089091631",
                                "sense_id": "a5fe72e8-6d03-3fea-9b63-8a8582d10138",
                                "text": "„An 67 Zügen werden die schweren Teile ausgetauscht. Die Ausbesserungswerke haben damit immer noch zu tun.“"
                            }
                        ],
