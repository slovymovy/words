                        "entry_id": "72cc9d0d-3d87-31d8-b1d6-ed4f2aa081a0",
                        "glosses": [
                            "An ornamental shrub, Daphne mezereum, having purple flowers and bright red fruit."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
