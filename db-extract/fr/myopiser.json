                "senses": [
                    {
                        "sense_id": "04bafd14-03d7-3ddb-9710-d454d5919b37",
                        "entry_id": "c690ddb4-f79f-3787-af51-12ce02a4aabf",
                        "glosses": [
                            "Faire tendre vers la myopie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b0f0998-9148-4666-829a-27e857e4cb9f",
                                "sense_id": "04bafd14-03d7-3ddb-9710-d454d5919b37",
                                "text": "La monovision peut être réalisée par une chirurgie cornéenne (Lasik PKR) ou critallinienne (en choisissant la puissance de l’implant de manière à myopiser un œil et emmétropiser l’autre)."
                            },
                            {
                                "example_id": "50d11629-2d6a-4b20-9e84-28a14cfcb04c",
                                "sense_id": "04bafd14-03d7-3ddb-9710-d454d5919b37",
                                "text": "Son principe est de myopiser d’environ 1 à 2 D un des deux yeux permettant une vision de près sans correction additionnelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "2690b5d5-d45b-3fd5-a378-f11970749fcc",
                        "entry_id": "c690ddb4-f79f-3787-af51-12ce02a4aabf",
                        "glosses": [
                            "Devenir myope."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "69f864ca-b6da-448c-aab1-96704fab45ff",
                                "sense_id": "2690b5d5-d45b-3fd5-a378-f11970749fcc",
                                "text": "Il y a 10 ans, j’apprenais à lire et je commençais à me myopiser."
                            }
                        ]
                    }
