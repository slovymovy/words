                ],
                "senses": [
                    {
                        "sense_id": "9109aa32-d9ff-3491-a882-d0b8f42a3f8a",
                        "entry_id": "c325016c-6f39-3f1f-93ac-2105e45efd32",
                        "glosses": [
                            "technische Einrichtung, die ein in Bewegung befindliches Fahrzeug abbremst (, d.h. die Geschwindigkeit verringert)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8f9eee6-5367-4dd4-89f8-386054834f9e",
                                "sense_id": "9109aa32-d9ff-3491-a882-d0b8f42a3f8a",
                                "text": "[Fahrräder:] „Eine gute Beleuchtung, eine funktionierende Bremsanlage und eine geölte und exakt eingestellte Gangschaltung gehören zur Grundausstattung - auch um Unfälle zu vermeiden.“"
                            },
                            {
                                "example_id": "c9b5f21d-1802-4328-8ce0-4da1c44f5381",
                                "sense_id": "9109aa32-d9ff-3491-a882-d0b8f42a3f8a",
                                "text": "„Mit den schnellen E-Bikes sind auch unsportliche Fahrer mit Geschwindigkeiten von 35 km/h und schneller unterwegs. Da ist eine gute Bremsanlage lebenswichtig.“"
                            },
                            {
                                "example_id": "5aaac11e-b289-486f-af68-3ddef8b6f04a",
                                "sense_id": "9109aa32-d9ff-3491-a882-d0b8f42a3f8a",
                                "text": "„In einer Stichprobe […] haben drei von vier Werkstätten bei der Kontrolle der Bremsanlage geschlampt.“"
                            },
                            {
                                "example_id": "a78d313e-5390-4259-be0b-e74acef4c72b",
                                "sense_id": "9109aa32-d9ff-3491-a882-d0b8f42a3f8a",
                                "text": "„In der Automobilbranche […] arbeitet man […] an der Entwicklung von Filtern, die den feinen Bremsstaub direkt an den Bremsanlagen absaugen sollen.“"
                            },
                            {
                                "example_id": "a536cffa-1d08-4a0c-a5eb-9459e11d811b",
                                "sense_id": "9109aa32-d9ff-3491-a882-d0b8f42a3f8a",
                                "text": "„Da ein Zugführer im Dunkeln nicht erkennen konnte, ob ein Mensch auf den Gleisen stand, leitete er eine Gefahrenbremsung ein. An der Bremsanlage entstand dadurch ein Schaden von 5.000 Euro.“"
                            },
                            {
                                "example_id": "c523f317-3f4a-4042-96e1-d9335745ade8",
                                "sense_id": "9109aa32-d9ff-3491-a882-d0b8f42a3f8a",
                                "text": "[Formel 1:] „Nick Heidfeld aus Mönchengladbach hatte am Vormittag noch Probleme mit seinem BMW-Sauber, an dem die Bremsanlage gewechselt werden musste […].“"
                            },
                            {
                                "example_id": "6928df90-c1c8-4865-b861-cc50dbe5fa6f",
                                "sense_id": "9109aa32-d9ff-3491-a882-d0b8f42a3f8a",
                                "text": "„Ein Fehler in der Bremsanlage hatte zu einer Notbremsung geführt.“"
                            },
                            {
                                "example_id": "a5978c15-5a5e-4218-afd5-50be4e01dc4b",
                                "sense_id": "9109aa32-d9ff-3491-a882-d0b8f42a3f8a",
                                "text": "„Die Gefahrgutspezialisten hatten bei dem Sattelzug zunächst einen Druckverlust an der Bremsanlage festgestellt. Dann wurden weitere erhebliche Mängel an der Bremsanlage der Zugmaschine und am Sattelauflieger festgestellt.“"
                            },
                            {
                                "example_id": "38920bfc-aa5e-4179-99e2-4d3ff0118a92",
                                "sense_id": "9109aa32-d9ff-3491-a882-d0b8f42a3f8a",
                                "text": "„Polizeibeamte haben am Donnerstag an der Autobahn-Raststätte Dresdner Tor vier marode Lkw aus dem Verkehr gezogen. […] Bei allen Fahrzeugen waren die Bremsanlagen sehr mangelhaft und die Ladungen unzureichend gesichert.“"
                            },
                            {
                                "example_id": "bdacd6e5-d150-4391-91c9-8583153e7f5f",
                                "sense_id": "9109aa32-d9ff-3491-a882-d0b8f42a3f8a",
                                "text": "„Als der Fahrer für eine Kontrolle auf dem nächsten Parkplatz hielt, kamen aber zahlreiche Mängel zutage. Unter anderem waren laut Polizei Teile der Bremsanlage sowie mehrere Stoßdämpfer kaputt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
