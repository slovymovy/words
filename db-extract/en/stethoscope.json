                    {
                        "translation_id": "465260b6-f483-4b3d-97e5-8b5f9d6ee41a",
                        "source_entry_id": "ee4cd1e5-121c-3173-b90b-b00d6a3eda46",
                        "source_sense_id": "12377930-3877-3f86-8e1e-1eb0489845c2",
