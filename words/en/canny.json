{
    "word_family": [
        "canniness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "057362c3-2bae-340f-b182-76f001cc957d",
                    "sense_definition": "Having or showing shrewdness and good judgment, especially in money or business matters.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>canny</w> lawyer knew exactly how to negotiate the contract to his client's advantage.",
                            "target_lang_translations": {
                                "zh": "那位<w>精明</w>的律师非常清楚该如何谈判合同，才能对自己的客户最有利。"
                            }
                        },
                        {
                            "text": "She is a <w>canny</w> investor who always researches the market before making any big decisions.",
                            "target_lang_translations": {
                                "zh": "她是个<w>精明</w>的投资者，做任何重大决定前总会先研究市场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prudent"
                    ],
                    "common_phrases": [
                        "canny investor",
                        "canny business move"
                    ],
                    "target_lang_definitions": {
                        "zh": "精明而判断力强的，尤指在金钱或商业事务上很会拿主意。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "精明",
                                "target_lang_sense_clarification": "指人在金钱、商业或处事上判断准确、会盘算"
                            },
                            {
                                "target_lang_word": "老练",
                                "target_lang_sense_clarification": "强调头脑灵活、善于权衡利弊"
                            },
                            {
                                "target_lang_word": "明智",
                                "target_lang_sense_clarification": "较正式，指审慎而有见识"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b520eab6-164b-3a81-91ef-021002e5f9f2",
                    "sense_definition": "Careful and cautious in one's actions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician gave a <w>canny</w> response to avoid answering the difficult question directly.",
                            "target_lang_translations": {
                                "zh": "那位政客给出了一个<w>谨慎</w>的回答，以避免直接回答那个棘手的问题。"
                            }
                        },
                        {
                            "text": "You should be <w>canny</w> when walking alone in an unfamiliar part of the city at night.",
                            "target_lang_translations": {
                                "zh": "晚上独自在城市陌生地区行走时，你应该保持<w>谨慎</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chary",
                        "prudent"
                    ],
                    "common_phrases": [
                        "be canny"
                    ],
                    "target_lang_definitions": {
                        "zh": "行动上小心谨慎的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "谨慎",
                                "target_lang_sense_clarification": "做事小心，避免风险或失误"
                            },
                            {
                                "target_lang_word": "小心",
                                "target_lang_sense_clarification": "强调提高警觉、留神"
                            },
                            {
                                "target_lang_word": "审慎",
                                "target_lang_sense_clarification": "较正式，指言行不冒进"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16182c65-aea6-3757-a0ff-368e95c2b3e3",
                    "sense_definition": "Economical and thrifty with money or resources.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "frugality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By making <w>canny</w> investments, they managed to save enough for a comfortable retirement.",
                            "target_lang_translations": {
                                "zh": "靠着<w>节俭</w>而明智的投资，他们攒下了足够的钱，得以安享退休生活。"
                            }
                        },
                        {
                            "text": "He is known for his <w>canny</w> spending habits, rarely buying anything he does not truly need.",
                            "target_lang_translations": {
                                "zh": "他以<w>节俭</w>的消费习惯闻名，几乎不会买任何自己并不真正需要的东西。"
                            }
                        }
                    ],
                    "synonyms": [
                        "economical",
                        "frugal",
                        "thrifty"
                    ],
                    "common_phrases": [
                        "canny investments"
                    ],
                    "target_lang_definitions": {
                        "zh": "在金钱或资源使用上节省、俭朴的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "节俭",
                                "target_lang_sense_clarification": "花钱省、不过度消费"
                            },
                            {
                                "target_lang_word": "俭省",
                                "target_lang_sense_clarification": "重视节省金钱或资源"
                            },
                            {
                                "target_lang_word": "省钱",
                                "target_lang_sense_clarification": "指用钱很省、很会过日子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92ab14e1-f08a-30f8-ac0d-02352a2392ab",
                    "sense_definition": "Gentle, quiet, or steady in movement or behavior.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gentleness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trainer looked for a <w>canny</w> horse that would be safe for a beginner to ride.",
                            "target_lang_translations": {
                                "zh": "训练员在寻找一匹<w>温顺</w>的马，让初学者骑起来也安全。"
                            }
                        },
                        {
                            "text": "Please be <w>canny</w> with this fragile letter while you handle it.",
                            "target_lang_translations": {
                                "zh": "你拿这封易损的信时，请一定要<w>轻着点</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Scottish English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动作或举止轻柔、安静或平稳的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "温顺",
                                "target_lang_sense_clarification": "指性情或动作柔和，不躁不猛"
                            },
                            {
                                "target_lang_word": "轻柔",
                                "target_lang_sense_clarification": "指动作轻柔、平稳"
                            },
                            {
                                "target_lang_word": "平稳",
                                "target_lang_sense_clarification": "强调行为安静稳当"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf4c181b-b36d-3617-a666-6fdad3c13967",
                    "sense_definition": "Friendly, pleasant, or agreeable.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pleasantness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is such a <w>canny</w> lass who always makes everyone feel welcome.",
                            "target_lang_translations": {
                                "zh": "她真是个<w>和善</w>的姑娘，总能让每个人都感到宾至如归。"
                            }
                        },
                        {
                            "text": "We had a <w>canny</w> time chatting by the fire all evening.",
                            "target_lang_translations": {
                                "zh": "我们在火炉边聊了一整晚，度过了一段<w>愉快</w>的时光。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Northern English and Scottish English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "友好、令人愉快或随和的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "和善",
                                "target_lang_sense_clarification": "待人友好、容易亲近"
                            },
                            {
                                "target_lang_word": "讨人喜欢",
                                "target_lang_sense_clarification": "给人愉快舒服的感觉"
                            },
                            {
                                "target_lang_word": "和气",
                                "target_lang_sense_clarification": "性格随和、令人愉快"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b28c5af9-7e30-325f-9ded-9ba176dcb959",
                    "sense_definition": "Used to emphasize that something is quite large or significant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That is a <w>canny</w> big house for just two people to live in.",
                            "target_lang_translations": {
                                "zh": "对只有两个人住来说，那房子<w>相当</w>大。"
                            }
                        },
                        {
                            "text": "They faced a <w>canny</w> long wait before the train finally arrived at the station.",
                            "target_lang_translations": {
                                "zh": "火车终于进站前，他们等了<w>相当</w>长的时间。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Northern English and Scottish English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于强调某事物相当大或相当重要。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "相当",
                                "target_lang_sense_clarification": "用于加强程度，表示“颇为、相当”"
                            },
                            {
                                "target_lang_word": "挺",
                                "target_lang_sense_clarification": "口语中表示程度较高"
                            },
                            {
                                "target_lang_word": "很",
                                "target_lang_sense_clarification": "表示数量或程度明显大"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ab60941f-0e71-3757-b2d6-b31fee42d85d",
                    "sense_definition": "Sounding thin, metallic, or hollow, as if coming through a tin can.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audio quality was poor and sounded quite <w>canny</w> through the cheap speakers.",
                            "target_lang_translations": {
                                "zh": "音质很差，通过廉价扬声器听起来相当<w>空洞刺耳</w>。"
                            }
                        },
                        {
                            "text": "Adjust the settings so the recording does not sound so <w>canny</w>.",
                            "target_lang_translations": {
                                "zh": "调一下设置，别让录音听起来那么<w>金属空洞</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "canny sound"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容声音细薄、带金属感或空洞，好像从铁罐里传出来一样。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尖细",
                                "target_lang_sense_clarification": "指声音薄、发尖，带金属感"
                            },
                            {
                                "target_lang_word": "空洞",
                                "target_lang_sense_clarification": "指声音空空的、不丰满"
                            },
                            {
                                "target_lang_word": "金属空洞",
                                "target_lang_sense_clarification": "指像廉价设备放出的金属质感声音"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cc07e705-3085-3521-932e-f0c25e288f6e",
                    "sense_definition": "In a gentle, quiet, or careful manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should drive <w>canny</w> on these icy roads to stay safe.",
                            "target_lang_translations": {
                                "zh": "在这种结冰的路上开车，你得开得<w>小心</w>些才安全。"
                            }
                        },
                        {
                            "text": "He sits very <w>canny</w> while waiting for his turn to speak.",
                            "target_lang_translations": {
                                "zh": "他等着轮到自己发言时，坐得很<w>安静</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "drive canny"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Northern English and Scottish English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以轻柔、安静或小心的方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小心",
                                "target_lang_sense_clarification": "指动作或行为时小心地进行"
                            },
                            {
                                "target_lang_word": "轻轻地",
                                "target_lang_sense_clarification": "指轻轻地、稳稳地"
                            },
                            {
                                "target_lang_word": "谨慎地",
                                "target_lang_sense_clarification": "指安静而谨慎地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88cef602-3b65-3f02-965c-58c6e6d150bb",
                    "sense_definition": "To a great degree; very or considerably.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>canny</w> long journey, but we finally reached our destination.",
                            "target_lang_translations": {
                                "zh": "这段旅程<w>相当</w>漫长，不过我们最终还是到了目的地。"
                            }
                        },
                        {
                            "text": "We are <w>canny</w> near home now, so we will be there in five minutes.",
                            "target_lang_translations": {
                                "zh": "我们现在<w>很</w>靠近家了，五分钟后就能到。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in Northern English and Scottish English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在很大程度上；很，十分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "相当",
                                "target_lang_sense_clarification": "表示程度高，相当于“很、相当”"
                            },
                            {
                                "target_lang_word": "很",
                                "target_lang_sense_clarification": "口语里表示“非常、挺”"
                            },
                            {
                                "target_lang_word": "挺",
                                "target_lang_sense_clarification": "表示“颇为、挺”"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0915c1e7-22b2-3516-985c-f67a5e3aeca0",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Canny</w> is the new teacher at our school.",
                            "target_lang_translations": {
                                "zh": "<w>坎尼</w>先生是我们学校的新老师。"
                            }
                        },
                        {
                            "text": "The <w>Cannys</w> are hosting a neighborhood party this weekend.",
                            "target_lang_translations": {
                                "zh": "<w>坎尼一家</w>这个周末要举办社区聚会。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "坎尼",
                                "target_lang_sense_clarification": "作为姓氏使用的音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}