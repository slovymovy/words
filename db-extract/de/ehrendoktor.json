                "senses": [
                    {
                        "sense_id": "eb1dcc92-7c0e-3cd9-be5d-a523a09fc05c",
                        "entry_id": "f995f495-653a-33fc-8804-0196b05b5460",
                        "glosses": [
                            "akademischer Titel eines Doktors ehrenhalber, der für Verdienste verliehen werden kann, aber ohne die entsprechenden Prüfungen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9d242f1d-f9e3-31d6-aa74-6ebc5d938c85",
                        "entry_id": "f995f495-653a-33fc-8804-0196b05b5460",
                        "glosses": [
                            "Person, der der Titel eines Ehrendoktors verliehen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a272aabe-18ef-4cb7-8f9d-25f84cd3ad26",
                                "sense_id": "9d242f1d-f9e3-31d6-aa74-6ebc5d938c85",
                                "text": "„Als Gerhart Hauptmann 1922 in der Deutschen Universität Prag zum Ehrendoktor promoviert wurde, konnte sich der Universitätssenat nicht entschließen, zu dieser Feier den Präsidenten der Republik einzuladen.“"
                            },
                            {
                                "example_id": "340cb4e4-75c4-4aba-96a4-a68e7bb4fbd2",
                                "sense_id": "9d242f1d-f9e3-31d6-aa74-6ebc5d938c85",
                                "text": "„Die Zuhörer applaudierten, und der frischgebackene Ehrendoktor nahm auf dem Podium seinen Platz hinter dem Kanzler und dem Vizekanzler ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
