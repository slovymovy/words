                ],
                "senses": [
                    {
                        "sense_id": "6c954d50-b624-3091-983d-b373ea44cd51",
                        "entry_id": "1af84804-b65d-3712-a157-028a7424f2d4",
                        "glosses": [
                            "Bereitschaft, eine Gefahr/ein Risiko einzugehen"
                        ],
                        "tags": [
                            "Wirtschaftsjargon"
                        ],
                        "examples": [
                            {
                                "example_id": "b20d4cfe-9e63-429c-9db5-6c982ac3a3c5",
                                "sense_id": "6c954d50-b624-3091-983d-b373ea44cd51",
                                "text": "„Bevor du nun dein Risikolevel oder deine Risikoaffinität festlegen kannst, muss ich erst einmal erklären, was Risiko überhaupt ist und warum das im Zusammenhang mit deinen Finanzen stehen muss.“"
                            },
                            {
                                "example_id": "9e7f6db9-4c94-4bcd-af8c-3b8315c3e535",
                                "sense_id": "6c954d50-b624-3091-983d-b373ea44cd51",
                                "text": "„Besitzt ein Unternehmen eine besondere Risikoaffinität in Bezug auf Immaterialgüterrechtsverletzungen oder unlautere Geschäftspraktiken, so ist diese im Rahmen der Risiko-Analyse zu ermitteln.“"
                            },
                            {
                                "example_id": "c5a9b02e-2d12-4849-89f9-afd2c78f333e",
                                "sense_id": "6c954d50-b624-3091-983d-b373ea44cd51",
                                "text": "„Die Risikoneigung kann durch eine Nutzenkurve dargestellt werden, wenn die Risikoaffinität des Anlegers bekannt ist.“"
                            },
                            {
                                "example_id": "e3053bb5-5c96-4128-a144-7084e9f1c46b",
                                "sense_id": "6c954d50-b624-3091-983d-b373ea44cd51",
                                "text": "„Ob du in Sachen Anleihen dein Kapital streust oder nicht, bleibt dir überlassen und hängt von deiner Risikoaffinität ab.“"
                            },
                            {
                                "example_id": "ebd95eef-eb1f-435d-89d8-710923411d86",
                                "sense_id": "6c954d50-b624-3091-983d-b373ea44cd51",
                                "text": "„Die Matrix kann ebenfalls von Unternehmen zu Unternehmen und dessen Risikoaffinität angepasst werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
