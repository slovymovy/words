                "senses": [
                    {
                        "sense_id": "33a52781-5446-328d-9ff9-6b5359cbc5f3",
                        "entry_id": "a30cf6da-fe5e-3ace-8cd3-42cfdaa733a7",
                        "glosses": [
                            "dział matematyki obejmujący badanie związków między bokami i kątami trójkątów za pomocą funkcji zwanych trygonometrycznymi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "712ae6a6-df7b-476c-be57-0160b47dde21",
                                "sense_id": "33a52781-5446-328d-9ff9-6b5359cbc5f3",
                                "text": "Nauczyła się momentalnie kalkulować trygonometrię układu celowniczego działa jonowego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4f73982-673f-40fc-898e-281fd90deed9",
                        "source_entry_id": "a30cf6da-fe5e-3ace-8cd3-42cfdaa733a7",
                        "source_sense_id": "33a52781-5446-328d-9ff9-6b5359cbc5f3",
                        "target_lang_word": "trigonometry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trigonometry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77bb0784-bf4c-35f7-b183-fb01adfc523b",
                                        "entry_id": "6a02ba25-ce00-3152-ba34-142b06cf4d91",
                                        "glosses": [
                                            "The branch of mathematics that deals with the relationships between the sides and angles of (in particular) right-angled triangles, as represented by the trigonometric functions, and with calculations based on said relationships."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "697890a5-4329-4f95-b1aa-07586ba6f3fd",
                                                "sense_id": "77bb0784-bf4c-35f7-b183-fb01adfc523b",
                                                "text": "Trigonometry emerged in the Hellenistic world during the 3rd century BCE from applications of geometry to astronomy; the Greeks focused on the calculation of chords, while mathematicians in India created the earliest known tables of values for trigonometric functions such as sine."
                                            },
                                            {
                                                "example_id": "23a0eae5-8c56-4325-a014-3e6aa10a3e87",
                                                "sense_id": "77bb0784-bf4c-35f7-b183-fb01adfc523b",
                                                "text": "Historically, trigonometry has been applied in areas such as geodesy, surveying, celestial mechanics and navigation."
                                            },
                                            {
                                                "example_id": "d7ef3c78-235c-4075-9fad-76d4c8cd809a",
                                                "sense_id": "77bb0784-bf4c-35f7-b183-fb01adfc523b",
                                                "text": "Trigonometry was originally the science which treated only of the sides and angles of plane and spherical triangles; but it has been recently extended so as to include the analytic treatment of all theorems involving the consideration of angular magnitudes."
                                            },
                                            {
                                                "example_id": "554e51d5-ae11-4876-a5b1-b5227b0b2fc4",
                                                "sense_id": "77bb0784-bf4c-35f7-b183-fb01adfc523b",
                                                "text": "In fact, the earliest practical uses of trigonometry were in the fields of astronomy and hence navigation."
                                            },
                                            {
                                                "example_id": "8a106a54-6cf1-468e-98fb-75a476e4ad96",
                                                "sense_id": "77bb0784-bf4c-35f7-b183-fb01adfc523b",
                                                "text": "The properties of these new trigonometries and identities flowing from the definitions are then developed.\nThe trigonometries derived from these generalizations will be jointly termed \"The Fractional Trigonometry.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f005b9e3-fca7-4f45-b2f6-a2e70ec9ab56",
                        "source_entry_id": "a30cf6da-fe5e-3ace-8cd3-42cfdaa733a7",
                        "source_sense_id": "33a52781-5446-328d-9ff9-6b5359cbc5f3",
                        "target_lang_word": "trigonometrie",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
