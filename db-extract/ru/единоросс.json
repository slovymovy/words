                "senses": [
                    {
                        "sense_id": "922f732a-091c-389c-8ef3-b6dde263f412",
                        "entry_id": "de417f37-5200-3e5a-aa15-d3a6e2b64de4",
                        "glosses": [
                            "неол., полит. член партии «Единая Россия»"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8beb2ee9-32dc-4d34-a064-fff5a68fdaa5",
                                "sense_id": "922f732a-091c-389c-8ef3-b6dde263f412",
                                "text": "Но 15 января 2003 года спикером стал единоросс Вадим Тюльпанов."
                            },
                            {
                                "example_id": "bef6b660-67b1-4bc4-a43a-d14a32f0ef73",
                                "sense_id": "922f732a-091c-389c-8ef3-b6dde263f412",
                                "text": "Так, в феврале прошлого года «единороссы» предложили: если какой-то губернатор не получит 50 % голосов, то выборы признаются несостоявшимися, а глава региона назначается указом президента."
                            }
                        ]
                    }
