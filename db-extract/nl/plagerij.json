                "senses": [
                    {
                        "sense_id": "a0a73eb3-9a2c-3996-9a7e-f58412a6b32b",
                        "entry_id": "f0a95b67-8048-3a40-aed5-9aa3fa2e1dce",
                        "glosses": [
                            "de keer dat men iemand voor de grap plaagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84630531-8275-45e1-8c80-2a8e3318e7f1",
                                "sense_id": "a0a73eb3-9a2c-3996-9a7e-f58412a6b32b",
                                "text": "Barry Hay signeerde zijn boek bij Paagman. Als trouwe fan kocht ik het en vroeg de verkoper om er: 'Voor Roos'in te laten schrijven. Zelf durfde ik dit niet. De volgende dag las ik: 'Voor Roos, de mooiste bloem aller tijden', met handtekening. Deze komische boodschap vond ik erg leuk, ondanks de plagerijen van mijn kinderen. Bedankt, Barry"
                            },
                            {
                                "example_id": "8481a3df-c58a-4757-abd5-617791532191",
                                "sense_id": "a0a73eb3-9a2c-3996-9a7e-f58412a6b32b",
                                "text": "Zet hij je openlijk voor schut? Maakt hij je persoonlijkheid belachelijk? Je voelt je in zo'n situatie beschaamd en afgewezen door zijn plagerijen. Als je je partner confronteert en hij reageert dat je niet zo gevoelig moet zijn, dan is de liefde misschien niet wederzijds."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
