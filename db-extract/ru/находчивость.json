                ],
                "senses": [
                    {
                        "sense_id": "369fee35-436f-3e1e-b88d-34183b1ab5a3",
                        "entry_id": "8f0d8903-8905-3282-b3c5-be31710ab5a1",
                        "glosses": [
                            "свойство по значению прилагательного находчивый; умение быстро находить выход из затруднительного положения; сообразительность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "921e0c3c-cbec-4894-87b9-46c69421c853",
                                "sense_id": "369fee35-436f-3e1e-b88d-34183b1ab5a3",
                                "text": "Побег был совершён с необыкновенной находчивостью и незаурядною смелостью."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "521b603d-d81e-43cc-88db-a62ef3b2ffd8",
                        "source_entry_id": "8f0d8903-8905-3282-b3c5-be31710ab5a1",
                        "source_sense_id": "369fee35-436f-3e1e-b88d-34183b1ab5a3",
                        "target_lang_word": "ingéniosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingéniosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0af2b0a2-f929-3499-9139-16e49b6a6710",
                                        "entry_id": "30e14e33-ed27-39b6-8ef6-95c6890ace32",
                                        "glosses": [
                                            "Qualité qui fait qu’une personne est ingénieuse, adroite, inventive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45ad5858-aced-45c5-addb-d428997b83dc",
                                                "sense_id": "0af2b0a2-f929-3499-9139-16e49b6a6710",
                                                "text": "[…] puis il avait remonté les crêts par un des milles^([sic]) sentiers que l’ingéniosité des contrebandiers leur fait sans cesse frayer à travers ces prés-bois et ces boqueteaux de sapins."
                                            },
                                            {
                                                "example_id": "77deaf63-764d-42b4-8835-834599900f4c",
                                                "sense_id": "0af2b0a2-f929-3499-9139-16e49b6a6710",
                                                "text": "[…] la préoccupation qui, chez les hommes, semble dominer toutes les autres, c’est celle de la vitesse obtenue soit par leurs propres moyens, soit par des instruments, et des appareils de locomotion, au perfectionnement desquels ils appliquent le meilleur de leur ingéniosité et de leurs facultés inventives."
                                            },
                                            {
                                                "example_id": "01624a39-86a4-4fc1-a206-1dfc535d930d",
                                                "sense_id": "0af2b0a2-f929-3499-9139-16e49b6a6710",
                                                "text": "Rappelons seulement que la harira, soupe marocaine très spécifique est, quand elle est réussie, un chef-d’œuvre de l’ingéniosité des femmes de cette contrée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac916979-18e5-4c80-b552-36199f88c6ce",
                        "source_entry_id": "8f0d8903-8905-3282-b3c5-be31710ab5a1",
                        "source_sense_id": "369fee35-436f-3e1e-b88d-34183b1ab5a3",
                        "target_lang_word": "astuce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astuce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "633eea6c-353e-35bd-be61-44fa633736a5",
                                        "entry_id": "de9307fd-d795-355d-a3ee-c95471bca54b",
                                        "glosses": [
                                            "Finesse, ruse qui a pour objet de nuire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8d25142-4018-402f-a260-0df2f9171f40",
                                                "sense_id": "633eea6c-353e-35bd-be61-44fa633736a5",
                                                "text": "Un homme plein d’astuce."
                                            },
                                            {
                                                "example_id": "38f86425-df46-4f8d-8b26-2233ae26cdfc",
                                                "sense_id": "633eea6c-353e-35bd-be61-44fa633736a5",
                                                "text": "Il a fait cela par astuce."
                                            },
                                            {
                                                "example_id": "9927d58a-cc5d-487c-925e-c6c21f48cac2",
                                                "sense_id": "633eea6c-353e-35bd-be61-44fa633736a5",
                                                "text": "Employer de petites astuces."
                                            },
                                            {
                                                "example_id": "0d90522b-9fa2-4694-8a71-3a3ca2b0da8c",
                                                "sense_id": "633eea6c-353e-35bd-be61-44fa633736a5",
                                                "text": "Ton astuce infaillible pour ne pas perdre la face quand tu tombes sur un sujet que tu n'as absolument pas bossé?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bdb8f1d-7c5c-3c62-96a8-f6e8ce7414bf",
                                        "entry_id": "de9307fd-d795-355d-a3ee-c95471bca54b",
                                        "glosses": [
                                            "Quelque chose d’ingénieux."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efbf95d-5387-4fe5-b4ce-729732757779",
                                                "sense_id": "9bdb8f1d-7c5c-3c62-96a8-f6e8ce7414bf",
                                                "text": "Il existe néanmoins une astuce qui fonctionne réellement et qui permet aux arboretums installés en bordure de forêt de garder intact leurs végétaux : la mise en place de petits miroirs partout où cela est possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1406d21c-8279-3215-bb1b-827d3a055ba9",
                                        "entry_id": "de9307fd-d795-355d-a3ee-c95471bca54b",
                                        "glosses": [
                                            "Solution pour résoudre un problème, une question."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
