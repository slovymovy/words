                "senses": [
                    {
                        "sense_id": "6646472c-fc71-3cb7-a059-e27822914ba5",
                        "entry_id": "0dd4f8a0-c18a-3cf7-aafe-dc7bb44bbafa",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61545827-d61b-4b65-9ca3-4f962d693d21",
                                "sense_id": "6646472c-fc71-3cb7-a059-e27822914ba5",
                                "text": "Frau Hoelzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "684c036e-f237-43fa-8215-b7f20cd669f3",
                                "sense_id": "6646472c-fc71-3cb7-a059-e27822914ba5",
                                "text": "Herr Hoelzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5941a525-395d-48eb-a405-4846c8642ee4",
                                "sense_id": "6646472c-fc71-3cb7-a059-e27822914ba5",
                                "text": "Die Hoelzles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a57723e3-1b05-4d1b-8b00-3f99e20ee70d",
                                "sense_id": "6646472c-fc71-3cb7-a059-e27822914ba5",
                                "text": "Der Hoelzle trägt nie die Schals, die die Hoelzle ihm strickt."
                            },
                            {
                                "example_id": "2b2e0b7e-703b-4ce9-87dd-6b3ebccf6d99",
                                "sense_id": "6646472c-fc71-3cb7-a059-e27822914ba5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hoelzle kommt, geht der Herr Hoelzle.“"
                            },
                            {
                                "example_id": "19d243f9-51c2-49aa-a9af-8a7fbd51292c",
                                "sense_id": "6646472c-fc71-3cb7-a059-e27822914ba5",
                                "text": "Hoelzle kommt und geht."
                            },
                            {
                                "example_id": "312b5efd-c872-45bd-8178-931b8598348b",
                                "sense_id": "6646472c-fc71-3cb7-a059-e27822914ba5",
                                "text": "Hoelzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
