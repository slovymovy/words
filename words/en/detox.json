{
    "word_family": [
        "detoxification",
        "detoxify"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b0fd57e0-ec2c-37f1-afdf-2d4efb3a51a7",
                    "sense_definition": "The process of removing toxic substances from the body, particularly alcohol or drugs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "detoxification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to start a <w>detox</w> to improve his overall health after the holidays.",
                            "target_lang_translations": {
                                "ru": "Он решил начать <w>детокс</w>, чтобы улучшить общее состояние здоровья после праздников."
                            }
                        },
                        {
                            "text": "The clinic offers a supervised <w>detox</w> program for those struggling with substance abuse.",
                            "target_lang_translations": {
                                "ru": "Клиника предлагает программу <w>детоксикации</w> под наблюдением для тех, кто борется с зависимостью."
                            }
                        }
                    ],
                    "synonyms": [
                        "detoxification"
                    ],
                    "common_phrases": [
                        "undergo a detox",
                        "start a detox"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс выведения токсичных веществ из организма, особенно алкоголя или наркотиков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "детокс",
                                "target_lang_sense_clarification": "общее название процесса очищения организма"
                            },
                            {
                                "target_lang_word": "очищение организма",
                                "target_lang_sense_clarification": "более формальное описание процесса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9f10428-7a4a-31b9-8a9f-d37b2a2ec218",
                    "sense_definition": "A medical facility or unit where people undergo detoxification.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "detoxification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local hospital opened a new <w>detox</w> to help patients manage withdrawal symptoms safely.",
                            "target_lang_translations": {
                                "ru": "Местная больница открыла новое <w>наркологическое отделение</w>, чтобы помочь пациентам безопасно справиться с симптомами отмены."
                            }
                        },
                        {
                            "text": "After leaving the <w>detox</w>, he enrolled in a long-term rehabilitation program.",
                            "target_lang_translations": {
                                "ru": "После выписки из <w>центра детоксикации</w> он записался на долгосрочную программу реабилитации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "admitted to detox"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинское учреждение или отделение, где люди проходят детоксикацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наркологическое отделение",
                                "target_lang_sense_clarification": "специализированное медицинское учреждение"
                            },
                            {
                                "target_lang_word": "центр детоксикации",
                                "target_lang_sense_clarification": "учреждение, специализирующееся на выводе токсинов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ff99933f-d555-30b1-bb47-ebfa92c78129",
                    "sense_definition": "To remove toxic substances from the body or an environment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "detoxification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people try to <w>detox</w> their bodies by drinking only green juices for a week.",
                            "target_lang_translations": {
                                "ru": "Многие люди пытаются <w>очистить</w> свой организм, употребляя в течение недели только зеленые соки."
                            }
                        },
                        {
                            "text": "She felt the need to <w>detox</w> her living space by removing all unnecessary clutter.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала необходимость <w>очистить</w> свое жилое пространство, избавившись от всего лишнего хлама."
                            }
                        }
                    ],
                    "synonyms": [
                        "detoxify",
                        "cleanse"
                    ],
                    "common_phrases": [
                        "detox the body"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять токсичные вещества из организма или окружающей среды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводить детоксикацию",
                                "target_lang_sense_clarification": "медицинский или оздоровительный процесс"
                            },
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "в широком смысле, включая избавление от лишнего"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}