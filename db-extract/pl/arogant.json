                                "target_senses": [
                                    {
                                        "sense_id": "79c4cf5d-09bb-32b3-85b4-e3b31422ab90",
                                        "entry_id": "b2ca1bab-9b47-3f63-92df-2b8645dc12e5",
                                        "glosses": [
