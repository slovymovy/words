                        "translation_id": "a2aeaf05-6afe-4506-bdb7-724732496246",
                        "source_entry_id": "fdf05dd5-44e3-3bcf-8dfd-f0334cc4400b",
                        "target_lang_word": "d’ora in avanti",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ac62415f-1daa-4cc2-8a51-7f725da48202",
                        "source_entry_id": "fdf05dd5-44e3-3bcf-8dfd-f0334cc4400b",
                        "target_lang_word": "van nu af aan",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "67e1e0a3-3480-4aad-b1fa-d84c7e457e42",
                        "source_entry_id": "fdf05dd5-44e3-3bcf-8dfd-f0334cc4400b",
                        "target_lang_word": "doravante",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doravante",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "fb9fc369-8479-3dd9-ae63-3cd37a25403c",
                                        "entry_id": "5ed6db7e-2199-3b04-a68a-13d1c592f1f6",
                                        "glosses": [
                                            "de agora em diante; em direção do futuro"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fd9325f-258f-4c77-82b4-50f21251bac2",
                                                "sense_id": "fb9fc369-8479-3dd9-ae63-3cd37a25403c",
                                                "text": "Já no caso da pesquisa, o prazo vai passar de três para cinco anos, com a diferença de que doravante serão limitados os casos em que o prazo poderá ser prorrogado."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ba074a8-935e-4892-b2f5-c42df79d4c8c",
                        "source_entry_id": "fdf05dd5-44e3-3bcf-8dfd-f0334cc4400b",
                        "target_lang_word": "отныне",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "отныне",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                        "entry_id": "4034c8e5-de5c-34a7-9ece-2f2cae5a45cf",
                                        "glosses": [
                                            "с этого времени, начиная с этого момента"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93184875-a598-4f00-b28c-ed2cfcdea924",
                                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                                "text": "И сказал Симону Иисус: не бойся; отныне будешь ловить человеков."
                                            },
                                            {
                                                "example_id": "7ce1c24e-ed47-4874-9060-987567a7dff1",
                                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                                "text": "Все чувствовали, что тяжесть спала с сердец и что отныне ничего другого не остается, как благоденствовать."
                                            },
                                            {
                                                "example_id": "c4340037-8d3a-4d68-93af-2741ecc3a712",
                                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                                "text": "Между прочим, она объявила, что готова основать свой журнал и посвятить ему отныне всю свою жизнь."
                                            },
                                            {
                                                "example_id": "8a440679-455c-4530-940f-3993877bb0ea",
                                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                                "text": "Собери всех своих самых лучших людей, у которых ты знаешь самую крепкую веру, и явитесь там рано утром отныне на третий день."
                                            },
                                            {
                                                "example_id": "a4273400-65eb-404d-959f-c4f000f91d8d",
                                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                                "text": "Главная перемена состоит в том, что высшее образование отныне доступно в сущности всем и каждому, способному его вместить."
                                            },
                                            {
                                                "example_id": "3368ca81-aa49-44a5-bce5-772c1dc84d3b",
                                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                                "text": "Отныне загадочная функция гипофиза — мозгового придатка — разъяснена."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d497c8b-f5ff-4918-9f86-843a9a58f1a8",
                        "source_entry_id": "fdf05dd5-44e3-3bcf-8dfd-f0334cc4400b",
                        "target_lang_word": "впредь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "впредь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b81d0e03-3dbc-3ce8-b789-34bb3ae6d15f",
                                        "entry_id": "2cae9ed1-0580-360e-be21-6eddd6ae3c59",
                                        "glosses": [
                                            "в будущем, в дальнейшем, впоследствии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "996c85fa-d044-4cf9-b89b-bebc87bc2c45",
                                                "sense_id": "b81d0e03-3dbc-3ce8-b789-34bb3ae6d15f",
                                                "text": "Она дала ему три карты, с тем, чтобы он поставил их одну за другою, и взяла с него честное слово впредь уже никогда не играть."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
