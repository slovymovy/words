            "senses": [
                {
                    "sense_id": "ef09e0b5-d1af-3275-9440-2c0a0ba9af39",
                    "sense_definition": "Een aanraking met de lippen als teken van liefde, genegenheid of begroeting",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_gesture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij gaf haar baby een <w>kus</w> op het voorhoofd.",
                            "target_lang_translations": {
                                "en": "She gave her baby a <w>kiss</w> on the forehead.",
                                "ru": "Она <w>поцеловала</w> ребёнка в лоб.",
                                "pl": "Dała swojemu dziecku <w>buziak</w> w czoło.",
                                "de": "Sie gab ihrem Baby einen <w>Kuss</w> auf die Stirn.",
                                "fr": "Elle a donné un <w>baiser</w> sur le front à son bébé.",
                                "it": "Ha dato al suo bambino un <w>bacio</w> sulla fronte.",
                                "cs": "Dala svému miminku <w>pusu</w> na čelo.",
                                "tr": "Bebeğine alnından bir <w>öpücük</w> verdi.",
                                "es": "Ella le dio un <w>beso</w> en la frente a su bebé.",
                                "zh": "她在婴儿的额头上<w>吻</w>了一下。"
                            }
                        },
                        {
                            "text": "Ik geef je een dikke <w>kus</w> voordat je gaat slapen.",
                            "target_lang_translations": {
                                "en": "I'll give you a big <w>kiss</w> before you go to sleep.",
                                "ru": "Я крепко <w>поцелую</w> тебя перед сном.",
                                "pl": "Dam ci wielkiego <w>buziaka</w>, zanim pójdziesz spać.",
                                "de": "Ich gebe dir einen dicken <w>Kuss</w>, bevor du schlafen gehst.",
                                "fr": "Je te fais un gros <w>bisou</w> avant que tu ailles dormir.",
                                "it": "Ti do un grande <w>bacio</w> prima che tu vada a dormire.",
                                "cs": "Dám ti pořádnou <w>pusu</w>, než půjdeš spát.",
                                "tr": "Uyumadan önce sana kocaman bir <w>öpücük</w> vereceğim.",
                                "es": "Te daré un <w>beso</w> grande antes de que te duermas.",
                                "zh": "你睡觉前我会给你一个大大的<w>吻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zoen"
                    ],
                    "common_phrases": [
                        "een kus geven",
                        "dikke kus",
                        "een vluchtige kus",
                        "kusje erop"
                    ],
                    "target_lang_definitions": {
                        "en": "A touch with the lips as a sign of love, affection, or greeting",
                        "ru": "Прикосновение губами в знак любви, привязанности или приветствия",
                        "pl": "Dotknięcie ustami w geście miłości, czułości lub powitania.",
                        "de": "Eine Berührung mit den Lippen als Zeichen von Liebe, Zuneigung oder Begrüßung",
                        "fr": "Un contact des lèvres sur le visage ou le corps en signe d'affection, d'amour ou de salutation.",
                        "it": "Un contatto con le labbra come segno di amore, affetto o saluto.",
                        "cs": "Přiložení rtů k někomu nebo něčemu jako projev lásky, náklonnosti nebo pozdravu.",
                        "tr": "Sevgi, şefkat veya selamlaşma işareti olarak dudaklarla yapılan temas.",
                        "es": "Un contacto con los labios como señal de amor, afecto o saludo.",
                        "zh": "用嘴唇触碰以表示爱意、亲昵或问候"
