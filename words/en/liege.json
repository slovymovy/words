{
    "word_family": [
        "liegeman",
        "liegedom"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3fee52ee-2077-3982-9161-327a81eaaba1",
                    "sense_definition": "A lord, sovereign, or king entitled to feudal allegiance and service.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "feudal_superior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight bowed deeply before his <w>liege</w> and promised to defend the realm.",
                            "target_lang_translations": {
                                "ru": "Рыцарь низко поклонился своему <w>сюзерену</w> и пообещал защищать королевство."
                            }
                        },
                        {
                            "text": "I bring grave tidings from the northern border, my <w>liege</w>.",
                            "target_lang_translations": {
                                "ru": "Я принес тревожные вести с северной границы, мой <w>государь</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sovereign",
                        "monarch",
                        "lord"
                    ],
                    "antonyms": [
                        "vassal",
                        "subject"
                    ],
                    "common_phrases": [
                        "my liege"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "primarily used in historical or fantasy contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Феодальный владыка, государь или сюзерен, имеющий право на верность и службу своих вассалов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сюзерен",
                                "target_lang_sense_clarification": "крупный феодальный правитель по отношению к вассалам"
                            },
                            {
                                "target_lang_word": "государь",
                                "target_lang_sense_clarification": "монарх или феодальный повелитель, в т.ч. в обращениях"
                            },
                            {
                                "target_lang_word": "сеньор",
                                "target_lang_sense_clarification": "феодальный господин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eeb8d9fc-a10f-36d5-92af-2c62d759c102",
                    "sense_definition": "A free and independent person, specifically a lord paramount.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feudal_superior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under ancient law, the <w>liege</w> held land without answering to any higher noble.",
                            "target_lang_translations": {
                                "ru": "Согласно древнему праву, этот <w>сеньор</w> владел землей, не подчиняясь никакому высшему дворянину."
                            }
                        },
                        {
                            "text": "As the supreme <w>liege</w> of the territory, he settled disputes among local barons.",
                            "target_lang_translations": {
                                "ru": "Как верховный <w>владыка</w> этих земель, он разрешал споры между местными баронами."
                            }
                        }
                    ],
                    "synonyms": [
                        "overlord"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "feudal legal term"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "rarely used outside historical legal treatises"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободный и независимый правитель; верховный феодальный сеньор, не подчиняющийся другим господам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеньор",
                                "target_lang_sense_clarification": "независимый феодальный правитель"
                            },
                            {
                                "target_lang_word": "верховный сюзерен",
                                "target_lang_sense_clarification": "верховный феодальный владыка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aee11a75-8e03-3b31-a7de-7449698f721c",
                    "sense_definition": "A vassal or subject bound by feudal law to serve a sovereign or lord.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feudal_inferior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king gathered his faithful <w>lieges</w> together before setting off for the campaign.",
                            "target_lang_translations": {
                                "ru": "Король собрал своих верных <w>вассалов</w> перед отправлением в поход."
                            }
                        },
                        {
                            "text": "Every noble in the province was considered a <w>liege</w> to the crown.",
                            "target_lang_translations": {
                                "ru": "Каждый дворянин в провинции считался <w>подданным</w> короны."
                            }
                        }
                    ],
                    "synonyms": [
                        "vassal",
                        "subject",
                        "liegeman"
                    ],
                    "antonyms": [
                        "lord",
                        "sovereign"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "primarily used in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вассал или подданный, обязанный по феодальному праву служить своему государю или сеньору."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вассал",
                                "target_lang_sense_clarification": "феодально зависимый подданный"
                            },
                            {
                                "target_lang_word": "подданный",
                                "target_lang_sense_clarification": "лицо, находящееся в подданстве у монарха"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "81bcc9f2-e435-34bb-9ca2-4d9c3d7104a7",
                    "sense_definition": "Entitled to feudal allegiance and service; sovereign.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "feudal_superior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The barons swore an oath of eternal fidelity to their <w>liege</w> lord.",
                            "target_lang_translations": {
                                "ru": "Бароны принесли клятву вечной верности своему <w>сюзерену</w>."
                            }
                        },
                        {
                            "text": "She presented herself before her <w>liege</w> lady to ask for royal protection.",
                            "target_lang_translations": {
                                "ru": "Она предстала перед своей венценосной <w>госпожой</w>, чтобы просить о королевской защите."
                            }
                        }
                    ],
                    "synonyms": [
                        "sovereign",
                        "paramount"
                    ],
                    "common_phrases": [
                        "liege lord",
                        "liege lady"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "primarily historical or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий право на верность и службу по феодальному праву; сюзеренный, верховный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сюзеренный",
                                "target_lang_sense_clarification": "обладающий верховной властью над вассалом"
                            },
                            {
                                "target_lang_word": "державный",
                                "target_lang_sense_clarification": "верховный, владычествующий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a00fb2f-fb5e-3b06-90bc-dc8fb2c69308",
                    "sense_definition": "Bound by feudal tenure to be faithful and loyal to a superior lord.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feudal_inferior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every <w>liege</w> man took an oath to defend the estate against all enemies.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>верный</w> вассал принес клятву защищать поместье от всех врагов."
                            }
                        },
                        {
                            "text": "The monarch expected complete devotion from each <w>liege</w> subject across the realm.",
                            "target_lang_translations": {
                                "ru": "Монарх ожидал полной преданности от каждого <w>верноподданного</w> во всем королевстве."
                            }
                        }
                    ],
                    "synonyms": [
                        "loyal",
                        "faithful"
                    ],
                    "antonyms": [
                        "disloyal",
                        "traitorous"
                    ],
                    "common_phrases": [
                        "liege subject",
                        "liege man"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "primarily historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обязанный верностью и преданностью своему феодальному сеньору; вассальный, верный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верный",
                                "target_lang_sense_clarification": "преданный своему государю или сеньору"
                            },
                            {
                                "target_lang_word": "вассальный",
                                "target_lang_sense_clarification": "связанный вассальной зависимостью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48751a5c-ff62-367e-ba9b-3cb7f80a8dd5",
                    "sense_definition": "Complete, absolute, or perfect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval contract recognized her right during her <w>liege</w> widowhood.",
                            "target_lang_translations": {
                                "ru": "Средневековый договор признавал ее права в период ее <w>полного</w> вдовства."
                            }
                        },
                        {
                            "text": "The charter confirmed his <w>liege</w> authority over the newly acquired territories.",
                            "target_lang_translations": {
                                "ru": "Хартия подтвердила его <w>абсолютную</w> власть над новоприобретенными территориями."
                            }
                        }
                    ],
                    "synonyms": [
                        "absolute",
                        "pure",
                        "complete"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historical legal formula"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный, абсолютный, совершенный (в старинных юридических контекстах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "абсолютный, ничем не ограниченный"
                            },
                            {
                                "target_lang_word": "абсолютный",
                                "target_lang_sense_clarification": "безусловный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "78d2a4d3-bebe-305d-ab75-054fb1a435f9",
                    "sense_definition": "Alternative form of <w>Liège</w>, a city in eastern Belgium.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The train traveled quickly between Brussels and <w>Liege</w> during the morning commute.",
                            "target_lang_translations": {
                                "ru": "Во время утренней поездки поезд быстро доехал от Брюсселя до <w>Льежа</w>."
                            }
                        },
                        {
                            "text": "Many historic battles took place around the fortress of <w>Liege</w>.",
                            "target_lang_translations": {
                                "ru": "Многие исторические битвы разворачивались вокруг крепости <w>Льеж</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "unaccented spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания названия Льеж (город на востоке Бельгии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Льеж",
                                "target_lang_sense_clarification": "город в Бельгии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}