{
    "word_family": [
        "tel"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "51942da7-b10e-3a28-a3b8-99525a5f28cf",
                    "sense_definition": "À un très haut degré, au point d'atteindre une intensité remarquable ; si.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce gâteau au chocolat est <w>tellement</w> bon que tout le monde en redemande."
                        },
                        {
                            "text": "Il parlait <w>tellement</w> vite que personne ne pouvait comprendre ses explications."
                        }
                    ],
                    "synonyms": [
                        "si",
                        "tant"
                    ],
                    "antonyms": [
                        "peu",
                        "guère"
                    ],
                    "common_phrases": [
                        "tellement bon",
                        "tellement vrai",
                        "tellement vite"
                    ]
                },
                {
                    "sense_id": "20662e15-9b59-3614-b31a-1865414d0aaf",
                    "sense_definition": "En une si grande quantité ou un nombre si élevé, généralement suivi de la préposition de ; tant de.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il y avait <w>tellement</w> de monde au concert qu'il était impossible d'avancer."
                        },
                        {
                            "text": "Nous avons encore <w>tellement</w> de choses à préparer avant le départ en vacances."
                        }
                    ],
                    "synonyms": [
                        "tant"
                    ],
                    "antonyms": [
                        "peu"
                    ],
                    "common_phrases": [
                        "tellement de monde",
                        "tellement de choses",
                        "tellement de temps"
                    ]
                },
                {
                    "sense_id": "63f0ff33-4705-3b79-8cb4-ca7229e6473d",
                    "sense_definition": "Indique la cause ou la justification intense d'un fait ; d'autant plus que, parce que.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous sommes rentrés précipitamment à la maison, <w>tellement</w> la pluie tombait avec force."
                        },
                        {
                            "text": "Il n'arrivait plus à garder les yeux ouverts, <w>tellement</w> la fatigue l'accablait ce soir-là."
                        }
                    ],
                    "synonyms": [
                        "parce que",
                        "tant"
                    ],
                    "common_phrases": [
                        "tellement que"
                    ]
                }
            ]
        }
    ]
}