                                            {
                                                "example_id": "7071c371-cb10-47f8-b84d-b29fef9b5fea",
                                                "sense_id": "53e7693f-49aa-3ddc-a9e8-b5a65f3e78a7",
                                                "text": "Die Schraube muss nachgezogen werden; sie ist etwas lose."
                                            },
                                            {
                                                "example_id": "ae5d269e-b0ba-4b97-88f3-e690e2e10d82",
                                                "sense_id": "53e7693f-49aa-3ddc-a9e8-b5a65f3e78a7",
                                                "text": "Ein weiches Tuch ist lose um ihren Körper geschlungen."
