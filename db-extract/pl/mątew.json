                        "source_sense_id": "b3540a07-8bed-33ce-a6ec-c646ab2389c0",
                        "target_lang_word": "whisk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whisk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "211bfd36-af6d-30c1-9dbb-296abf40b7cf",
                                        "entry_id": "d9ff3843-75f6-3b73-8421-12c6c9a8058e",
                                        "glosses": [
                                            "A quick, light sweeping motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd31f775-a4aa-4ed4-a015-132061480f60",
                                                "sense_id": "211bfd36-af6d-30c1-9dbb-296abf40b7cf",
                                                "text": "With a quick whisk, she swept the cat from the pantry with her broom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed899e7c-347e-3bb6-b1a0-9f1cc8f6c4b5",
                                        "entry_id": "d9ff3843-75f6-3b73-8421-12c6c9a8058e",
                                        "glosses": [
                                            "A kitchen utensil, now usually made from stiff wire loops fixed to a handle (and formerly of twigs), used for whipping (or a mechanical device with the same function)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1288b4-f9a6-4151-a452-0aab8fa119c8",
                                                "sense_id": "ed899e7c-347e-3bb6-b1a0-9f1cc8f6c4b5",
                                                "text": "He used a whisk to whip up a light and airy souffle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc689d18-4ef2-391f-a1d1-335d004a1795",
                                        "entry_id": "d9ff3843-75f6-3b73-8421-12c6c9a8058e",
                                        "glosses": [
                                            "A bunch of twigs or hair etc, used as a brush."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a6c1773-5bdb-4c08-b0ca-a39b1227a991",
                                                "sense_id": "fc689d18-4ef2-391f-a1d1-335d004a1795",
                                                "text": "Peter dipped the whisk in lather and applied it to his face, so he could start shaving."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f39a92a-8b07-3842-bf78-368f851bd9bf",
                                        "entry_id": "d9ff3843-75f6-3b73-8421-12c6c9a8058e",
                                        "glosses": [
                                            "A small handheld broom with a small (or no) handle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bdacfe9-3b78-4a1c-ab24-02cbc252280f",
                                                "sense_id": "0f39a92a-8b07-3842-bf78-368f851bd9bf",
                                                "text": "I used a whisk to sweep the counter, then a push-broom for the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "963adfab-fea8-34ac-bb3d-3ee3aa8e3c24",
                                        "entry_id": "d9ff3843-75f6-3b73-8421-12c6c9a8058e",
                                        "glosses": [
                                            "A plane used by coopers for evening chines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "621b4670-109e-394f-b019-51d22a56e9aa",
                                        "entry_id": "d9ff3843-75f6-3b73-8421-12c6c9a8058e",
                                        "glosses": [
                                            "A kind of cape, forming part of a woman's dress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f71de281-f850-4909-9fd6-e6ce2dc78889",
                                                "sense_id": "621b4670-109e-394f-b019-51d22a56e9aa",
                                                "text": "My wife in her new lace whiske."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whisk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a95cbd0c-ee7d-3c21-9a19-b9877e89f591",
                                        "entry_id": "8e9a1a2c-ec7b-391c-a468-eba0b4a4e9e9",
                                        "glosses": [
                                            "To move something with quick light sweeping motions."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b568039-d95b-412f-a6f8-4dced204b2d5",
                                                "sense_id": "a95cbd0c-ee7d-3c21-9a19-b9877e89f591",
                                                "text": "Vernon whisked the sawdust from his workbench."
                                            },
                                            {
                                                "example_id": "82dcd46a-d857-44f0-a268-4cde3ef32073",
                                                "sense_id": "a95cbd0c-ee7d-3c21-9a19-b9877e89f591",
                                                "text": "He that walks in gray, whisking his riding Page."
                                            },
                                            {
                                                "example_id": "73df6eca-99f0-4b21-94e6-095cf58731f7",
                                                "sense_id": "a95cbd0c-ee7d-3c21-9a19-b9877e89f591",
                                                "text": "She held out her empty glass and it was adroitly whisked from her hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77742430-4ed2-32ed-ac41-5215c6435b2d",
                                        "entry_id": "8e9a1a2c-ec7b-391c-a468-eba0b4a4e9e9",
                                        "glosses": [
                                            "In cooking, to whip e.g. eggs or cream."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44f0d6ae-91ab-4b0f-851c-667043901d54",
                                                "sense_id": "77742430-4ed2-32ed-ac41-5215c6435b2d",
                                                "text": "The chef prepared to whisk the egg whites for the angel's food cake."
                                            },
                                            {
                                                "example_id": "32d13daa-9250-42a7-b577-d693afda8a1a",
                                                "sense_id": "77742430-4ed2-32ed-ac41-5215c6435b2d",
                                                "text": "First, marinate the tofu. In a bowl, whisk the kecap manis, chilli sauce, and sesame oil together. Cut the tofu into strips about 1cm thick, mix gently (so it doesn't break) with the marinade and leave in the fridge for half an hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9db40d5-c6a5-3386-9b65-2a84de36165c",
                                        "entry_id": "8e9a1a2c-ec7b-391c-a468-eba0b4a4e9e9",
                                        "glosses": [
                                            "To move something rapidly and with no warning."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1eadc7f-5ca2-44aa-a6d2-c615f14868cb",
                                                "sense_id": "d9db40d5-c6a5-3386-9b65-2a84de36165c",
                                                "text": "July 3, 1769, Horace Walpole, letter to the Earl of Strafford\nI beg she would not impale worms, nor whisk carp out of one element into another."
                                            },
                                            {
                                                "example_id": "a18a079f-77b8-4d36-ae21-70432eb33f09",
                                                "sense_id": "d9db40d5-c6a5-3386-9b65-2a84de36165c",
                                                "text": "The governess whisked the children from the room before they could see their presents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3158c999-885c-368a-bcf9-5668bc06596d",
                                        "entry_id": "8e9a1a2c-ec7b-391c-a468-eba0b4a4e9e9",
                                        "glosses": [
                                            "To move lightly and nimbly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec7b8510-ed29-4fea-af0b-aaad724074ee",
                                                "sense_id": "3158c999-885c-368a-bcf9-5668bc06596d",
                                                "text": "The stories did not seem to me to touch life. […] They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                                            },
                                            {
                                                "example_id": "73be7269-f5a4-4671-9bba-9abc2733e07c",
                                                "sense_id": "3158c999-885c-368a-bcf9-5668bc06596d",
                                                "text": "The children whisked down the road to the fair, laughing and chattering as they went."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cca7ce8-4fae-3622-92b2-ec1674d9fd98",
                                        "entry_id": "8e9a1a2c-ec7b-391c-a468-eba0b4a4e9e9",
                                        "glosses": [
                                            "To move whiskers."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
