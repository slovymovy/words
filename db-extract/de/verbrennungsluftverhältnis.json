                        "tags": [],
                        "examples": [
                            {
                                "example_id": "240ef318-b634-4bdb-87dc-fbe7d57aa10b",
                                "sense_id": "ad72e1d0-2c3a-313d-9e21-48fa0878c363",
                                "text": "„Das Verbrennungsluftverhältnis λ setzt die tatsächlich für eine Verbrennung zur Verfügung stehende Luftmasse mL-tats. ins Verhältnis zur mindestens notwendigen stöchiometrischen Luftmasse mL-st.,die für eine vollständige Verbrennung benötigt wird.“"
                            },
                            {
                                "example_id": "e4880bf5-3994-4ee6-9991-dfab2b0ecaf0",
                                "sense_id": "ad72e1d0-2c3a-313d-9e21-48fa0878c363",
                                "text": "„Das Verbrennungsluftverhältnis ist sehr wichtig für einen optimalen Betrieb eines Verbrennungsmotors. Bei modernen Motoren wird das Verbrennungsluftverhältnis mit Hilfe einer sogenannten Lambda-Sonde, die vor dem Katalysator montiert ist, gesteuert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
