{
    "word_family": [
        "famous",
        "famously",
        "infamous",
        "infamy",
        "defame",
        "defamation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56e3909a-1195-3098-b4c8-77a45de0ea80",
                    "sense_definition": "The state of being widely known and recognized by many people, especially for achievements or positive qualities.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young actor achieved international <w>fame</w> after starring in the blockbuster movie.",
                            "target_lang_translations": {
                                "ru": "Молодой актер добился международной <w>славы</w> после главной роли в блокбастере."
                            }
                        },
                        {
                            "text": "Many people seek <w>fame</w> and fortune, but few realize the pressure that comes with it.",
                            "target_lang_translations": {
                                "ru": "Многие стремятся к <w>славе</w> и богатству, но немногие осознают сопутствующее этому давление."
                            }
                        }
                    ],
                    "synonyms": [
                        "famousness"
                    ],
                    "antonyms": [
                        "obscurity",
                        "unknownness"
                    ],
                    "common_phrases": [
                        "fame and fortune",
                        "claim to fame",
                        "hall of fame",
                        "achieve fame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние широкой известности и признания многими людьми, особенно за достижения или положительные качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слава",
                                "target_lang_sense_clarification": "широкая известность, почет и восхищение"
                            },
                            {
                                "target_lang_word": "известность",
                                "target_lang_sense_clarification": "популярность или знаменитость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "403bf493-a876-356c-9e5f-423164fa0f30",
                    "sense_definition": "The general opinion or reputation that the public has about a person or thing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef's <w>fame</w> for excellence spread quickly throughout the entire city.",
                            "target_lang_translations": {
                                "ru": "<w>Слава</w> о мастерстве шеф-повара быстро разнеслась по всему городу."
                            }
                        },
                        {
                            "text": "He worked hard to protect his good <w>fame</w> against the false accusations.",
                            "target_lang_translations": {
                                "ru": "Он упорно трудился, чтобы защитить свою добрую <w>репутацию</w> от ложных обвинений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "good fame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее мнение или репутация, которую общественность имеет о человеке или вещи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репутация",
                                "target_lang_sense_clarification": "общественное мнение о ком-либо"
                            },
                            {
                                "target_lang_word": "слава",
                                "target_lang_sense_clarification": "в значении сложившегося мнения, например 'добрая слава'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1815acb-30b5-3bb6-a208-168ea17a794f",
                    "sense_definition": "A report, rumor, or piece of gossip that is being circulated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rumor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There went a <w>fame</w> throughout the land that the king intended to step down.",
                            "target_lang_translations": {
                                "ru": "По всей стране прошла <w>молва</w>, что король намерен отречься от престола."
                            }
                        },
                        {
                            "text": "The common <w>fame</w> was held to be true by the neighbors despite the lack of evidence.",
                            "target_lang_translations": {
                                "ru": "Соседи считали общую <w>молву</w> правдой, несмотря на отсутствие доказательств."
                            }
                        }
                    ],
                    "common_phrases": [
                        "common fame"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature or legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщение, слух или сплетня, которые распространяются в обществе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молва",
                                "target_lang_sense_clarification": "распространяющиеся слухи или общественные разговоры"
                            },
                            {
                                "target_lang_word": "слух",
                                "target_lang_sense_clarification": "известие, передаваемое от одного к другому"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4953843e-a030-328e-8405-0b0ef5399cce",
                    "sense_definition": "To make someone or something famous or well-known.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet's verses served to <w>fame</w> the brave deeds of the fallen soldiers.",
                            "target_lang_translations": {
                                "ru": "Стихи поэта служили тому, чтобы <w>прославить</w> отважные подвиги павших воинов."
                            }
                        },
                        {
                            "text": "He sought to <w>fame</w> his family name through great works of charity.",
                            "target_lang_translations": {
                                "ru": "Он стремился <w>прославить</w> свою фамилию великими делами милосердия."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать кого-либо или что-либо знаменитым или хорошо известным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прославлять",
                                "target_lang_sense_clarification": "делать известным, воспевать"
                            },
                            {
                                "target_lang_word": "славить",
                                "target_lang_sense_clarification": "распространять славу о ком-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}