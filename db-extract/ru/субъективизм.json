                                        "entry_id": "b3a8e9e9-881c-34de-88cc-0af47bf48414",
                                        "glosses": [
                                            "The doctrine that reality is created or shaped by the mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0165ad13-48f2-3b19-824e-af6f3c7b024c",
                                        "entry_id": "b3a8e9e9-881c-34de-88cc-0af47bf48414",
                                        "glosses": [
                                            "The doctrine that knowledge is based in feelings or intuition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52f6d6a4-d4b0-4598-8e53-5038f7792950",
                                                "sense_id": "0165ad13-48f2-3b19-824e-af6f3c7b024c",
                                                "text": "Subjectivism takes as its allies the emotions, intuitive insight, imagination, humaneness, art, and a “higher” truth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96b7b96f-0b06-3f7b-a8ce-37b90b79a14c",
                                        "entry_id": "b3a8e9e9-881c-34de-88cc-0af47bf48414",
                                        "glosses": [
                                            "The doctrine that values and moral principles come from attitudes, convention, whim, or preference."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
