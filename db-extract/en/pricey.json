                        ],
                        "form": "more pricey"
                    },
                    {
                        "form_id": "2284c8df-6d56-4d5a-94a1-0eeeadfab259",
                        "entry_id": "bba077cc-2751-3cab-85ad-4c01573226a1",
                        "tags": [
                            "superlative"
                        ],
                        "form": "priciest"
                    },
                    {
                        "form_id": "80a4e22b-d9c8-47b6-bb87-7ef01af25789",
                        "entry_id": "bba077cc-2751-3cab-85ad-4c01573226a1",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most pricey"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "22a6b53c-f9a1-32d6-b4ff-8b4a6c2dba74",
                        "entry_id": "bba077cc-2751-3cab-85ad-4c01573226a1",
                        "glosses": [
                            "Expensive, dear."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "a250c5ce-3b06-464e-9fc7-bc829358a5cd",
                                "sense_id": "22a6b53c-f9a1-32d6-b4ff-8b4a6c2dba74",
                                "text": "Yellowstone itself remains the biggest headache, with noncamping accommodations limited to a handful of pricey lodges or cookie-cutter cabins..."
                            },
                            {
                                "example_id": "1b06c405-ac03-4618-bbe4-a01456ffcaaf",
                                "sense_id": "22a6b53c-f9a1-32d6-b4ff-8b4a6c2dba74",
                                "text": "But suppose that Britain grasps electricity produced from sources that don't involve burning pricey gas, and thus produces it more cheaply."
                            },
                            {
                                "example_id": "4008df60-0aa1-4f52-b587-628f913e8271",
                                "sense_id": "22a6b53c-f9a1-32d6-b4ff-8b4a6c2dba74",
                                "text": "In 2022, organics accounted for 15 percent of all fruit and vegetable sales in the United States despite being far pricier than conventional produce."
                            },
                            {
                                "example_id": "30fee965-5240-455c-b215-22b29ad30bba",
                                "sense_id": "22a6b53c-f9a1-32d6-b4ff-8b4a6c2dba74",
                                "text": "The three priciest areas in the country sit along a coast or near beaches."
                            },
                            {
                                "example_id": "679145de-13ee-4ac3-95ff-3c2fb5ff054e",
                                "sense_id": "22a6b53c-f9a1-32d6-b4ff-8b4a6c2dba74",
                                "text": "For decades hypochlorous acid lingered in the background, used as a disinfectant in specific industrial and commercial contexts that could justify a pricey, on-site manufacturing process to create products on demand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34af6310-2c63-4d83-8296-dd1efea3e061",
                        "source_entry_id": "bba077cc-2751-3cab-85ad-4c01573226a1",
                        "source_sense_id": "22a6b53c-f9a1-32d6-b4ff-8b4a6c2dba74",
                        "source_sense_description": "expensive",
                        "target_lang_word": "prijzig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prijzig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d20f2a6d-7830-3bb4-94f8-88a26534d500",
                                        "entry_id": "3e09f567-6cdd-32d9-8c98-1991bbb0edf0",
                                        "glosses": [
                                            "van iets dat het (te) duur is, dat het (te) veel geld kost"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8c1032d-5fd1-44c1-bbdf-0082bde4d500",
                                                "sense_id": "d20f2a6d-7830-3bb4-94f8-88a26534d500",
                                                "text": "Dat was een heel prijzige vergissing."
                                            },
                                            {
                                                "example_id": "2489a0e8-04e5-4b43-8560-0381130ce5c4",
                                                "sense_id": "d20f2a6d-7830-3bb4-94f8-88a26534d500",
                                                "text": "De reiskosten waren in mijn geval ook best prijzig, aangezien ik vanuit Nederland naar San Diego moest vliegen (en terug vanaf Seattle), wat rond de 700 euro kostte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6243462-441d-4992-be0c-18552eb3e169",
                        "source_entry_id": "bba077cc-2751-3cab-85ad-4c01573226a1",
                        "source_sense_id": "22a6b53c-f9a1-32d6-b4ff-8b4a6c2dba74",
                        "source_sense_description": "expensive",
                        "target_lang_word": "duur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "duur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c34e6050-a9c7-3557-8b07-f7d2de226988",
                                        "entry_id": "3df54e29-a0d6-36ed-858e-36937abcab7d",
                                        "glosses": [
                                            "van iets dat je wilt kopen, dat je er veel geld voor moet betalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab276f3-2d72-4353-819f-66955e8536f9",
                                                "sense_id": "c34e6050-a9c7-3557-8b07-f7d2de226988",
                                                "text": "Hij koopt altijd dure maar kwalitatief goede spullen die lang meegaan."
                                            },
                                            {
                                                "example_id": "c3eb5b63-133d-4229-8eb9-1c8d6da6a2be",
                                                "sense_id": "c34e6050-a9c7-3557-8b07-f7d2de226988",
                                                "text": "Ze rekenden precies uit wanneer ze winst gaan maken: \"Het is echt massa is kassa. Daarom komen er binnenkort meer machines bij. Het is nog geen vetpot, maar per machine moet je denken aan 600 tot 900 euro per maand. Pas na twee jaar gaan we echt winst maken.\" Dat komt vooral vanwege de kosten: \"We hebben best wel grote machines staan en de kosten daarvan variëren tussen de 3000 en de 5000 euro. Daarnaast moet je ook btw over je producten afdragen maar de locatie is het duurste.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "duur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a613f62d-6b2d-3184-b8bb-46ca1ad8970a",
                                        "entry_id": "7039c5e4-1c95-3402-a4b7-2e4f27c3a297",
                                        "glosses": [
                                            "benodigd tijdbestek"
                                        ],
                                        "tags": [
                                            "tijdrekening"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adfde1c1-221d-4ecb-ac47-efaf191cb78b",
                                                "sense_id": "a613f62d-6b2d-3184-b8bb-46ca1ad8970a",
                                                "text": "De duur van de gecompliceerde operatie was 8 uur."
                                            },
                                            {
                                                "example_id": "b631be2d-0ca6-4e58-916b-6ffe511c800f",
                                                "sense_id": "a613f62d-6b2d-3184-b8bb-46ca1ad8970a",
                                                "text": "De beleving van tijd is ongrijpbaarder, laat zich lastiger vangen in statistieken en lijstjes dan de objectieve duur ervan."
                                            },
                                            {
                                                "example_id": "4d34d3d5-8701-4eea-9633-28d28bd021a6",
                                                "sense_id": "a613f62d-6b2d-3184-b8bb-46ca1ad8970a",
                                                "text": "Bij een 'prospectieve' beoordeling van tijd schat je de duur van een gebeurtenis in terwijl die nog aan de gang is."
                                            },
                                            {
                                                "example_id": "03be9659-fe83-4566-99be-371a5e22e20a",
                                                "sense_id": "a613f62d-6b2d-3184-b8bb-46ca1ad8970a",
                                                "text": "Toevallig of niet is twee tot drie seconden ook ongeveer hoe de meesten van ons het 'nu' ervaren - de duur van één 'moment'."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "duur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d224a16d-e815-3909-84bb-933775fe90e3",
                                        "entry_id": "6fb4be64-4b04-3f3b-9178-a0467d193cad",
                                        "glosses": [
