                    },
                    {
                        "form_id": "9d7ac7f4-ea2c-422d-80b3-4ecaf4e5acc8",
                        "entry_id": "0a5b44ee-8aa7-3e0d-a5fb-f475860e493d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Grundrechte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2cb8500-ec9f-399d-8738-70bf700090bd",
                        "entry_id": "0a5b44ee-8aa7-3e0d-a5fb-f475860e493d",
                        "glosses": [
                            "grundlegendes Recht, das dem Bürger von einem Staat garantiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a3dff2c-38be-4d68-b65d-cca1f0f603fc",
                                "sense_id": "b2cb8500-ec9f-399d-8738-70bf700090bd",
                                "text": "Die „Märzforderungen“ lauteten: Garantie der Grundrechte und der Pressefreiheit, Verfassung und sofortige Herstellung eines deutschen Parlaments."
                            },
                            {
                                "example_id": "f4bce622-b5a6-47f0-b539-689151f2b821",
                                "sense_id": "b2cb8500-ec9f-399d-8738-70bf700090bd",
                                "text": "Der Eingriff in den Schutzbereich eines Grundrechts ist nur dann rechtmäßig, wenn er auf ein Gesetz gestützt werden kann, das seinerseits verfassungsmäßig ist."
                            },
                            {
                                "example_id": "5c0578e3-0e6a-42f5-820d-2727a771d1d5",
                                "sense_id": "b2cb8500-ec9f-399d-8738-70bf700090bd",
                                "text": "Adressat von Grundrechten ist nicht nur die öffentliche Gewalt; sie binden auch Private im Wege der mittelbaren Drittwirkung."
                            },
                            {
                                "example_id": "bfd19207-c35a-4b52-a89e-f614492bbb78",
                                "sense_id": "b2cb8500-ec9f-399d-8738-70bf700090bd",
                                "text": "Die Gleichheit von Mann und Frau ist ein von der Verfassung verbürgtes Grundrecht."
                            },
                            {
                                "example_id": "b94b0a42-4267-4c66-9122-3e4bd0e72701",
                                "sense_id": "b2cb8500-ec9f-399d-8738-70bf700090bd",
                                "text": "„DIe Grundrechte des Grundgesetzes sind die die Ausübung der staatlichen Gewalt verfassungskräftig verpflichtenden subjektiven Rechte des einzelnen.“"
                            },
                            {
                                "example_id": "c969b8fe-f468-4d28-9231-5dd3c96296cf",
                                "sense_id": "b2cb8500-ec9f-399d-8738-70bf700090bd",
                                "text": "„Ohne Zweifel sind Grundrechte in erster Linie dazu bestimmt, die Freiheitssphäre des einzelnen vor Eingriffen der öffentlichen Gewalt zu sichern; sie sind Abwehrrechte des Bürgers gegen den Staat.“"
                            },
                            {
                                "example_id": "5e281490-e6cf-4325-84f5-2c848db3569b",
                                "sense_id": "b2cb8500-ec9f-399d-8738-70bf700090bd",
                                "text": "„Zu unserer Verfassungsordnung gehören das allgemeine Freiheitsrecht, das Grundrecht auf die freie Entfaltung der Persönlichkeit, der allgemeine Gleichheitsgrundsatz und die Religionsfreiheit.“"
                            },
                            {
                                "example_id": "485486cc-5ced-41eb-b406-1f03e5e9b71f",
                                "sense_id": "b2cb8500-ec9f-399d-8738-70bf700090bd",
                                "text": "„Anders als sozialistische Verfassungen kennt das Grundgesetz keine sozialen Grundrechte, wie das Recht auf Arbeit oder das Recht auf eine Wohnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
