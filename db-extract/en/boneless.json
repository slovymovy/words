                                                "sense_id": "f14306ad-9e43-34e4-b2c4-822497f4a198",
                                                "text": "Bitte geben Sie mir ein schieres Stück Fleisch ohne Knochen und Fett."
                                            },
                                            {
                                                "example_id": "c334be1a-d291-43dd-b887-8a84226c744c",
                                                "sense_id": "f14306ad-9e43-34e4-b2c4-822497f4a198",
                                                "text": "Deine Haut ist so glatt und schier!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9be0ee90-b6c2-3d23-9064-383dada236ae",
                                        "entry_id": "ad673324-087d-35fa-b0b2-016aaaf6af43",
                                        "glosses": [
                                            "sich in einem außerordentlichen, erstaunlichen Zustand oder Ausmaß befindend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c648b546-5778-4599-97eb-2aafdf5849c9",
                                                "sense_id": "9be0ee90-b6c2-3d23-9064-383dada236ae",
                                                "text": "„Doch lassen sich die Titanenkämpfe der Epoche nicht trennen von literarischem Futterneid, persönlichen Animositäten und der schieren Lust an der Invektive.“"
                                            },
                                            {
                                                "example_id": "8eaf6f7f-fc7b-4b37-bccb-e56c2db8ea51",
                                                "sense_id": "9be0ee90-b6c2-3d23-9064-383dada236ae",
                                                "text": "Das ist der schiere Wahnsinn!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "schier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02308846-c340-3061-88e1-bae5c6b46366",
                                        "entry_id": "61626166-1cfe-3d80-9072-7b9ee0634bf4",
                                        "glosses": [
                                            "fast, bald, beinahe, gar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "118cc6e7-43f3-435d-951d-2ee5469fe44f",
                                                "sense_id": "02308846-c340-3061-88e1-bae5c6b46366",
                                                "text": "Das ist schier unmöglich."
                                            },
                                            {
                                                "example_id": "995335a3-3e3a-4c29-94b6-fd45cd47610c",
                                                "sense_id": "02308846-c340-3061-88e1-bae5c6b46366",
                                                "text": "Du machst dich schier unmöglich!"
                                            },
                                            {
                                                "example_id": "1d74fe46-3091-40bd-a2ae-d6be8ac3227d",
                                                "sense_id": "02308846-c340-3061-88e1-bae5c6b46366",
                                                "text": "„Es war doch ein Unding, neben solch einem schier einzigartigen Steppenrestaurant zu leben und nie dort gewesen zu sein.“"
                                            },
                                            {
                                                "example_id": "9484193c-1389-482c-9ab0-27a96e9173d0",
                                                "sense_id": "02308846-c340-3061-88e1-bae5c6b46366",
                                                "text": "„Eine größere Verletzung der Ehre war schier nicht denkbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
