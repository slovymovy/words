{
    "word_family": [
        "первенство",
        "первичный",
        "впервые",
        "во-первых"
    ],
    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "14ab1a33-ce00-33eb-91f6-0b2d977f64cd",
                    "sense_definition": "Имеющий номер один при счёте; идущий перед вторым в ряду однородных предметов.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sequence_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой <первый> урок начинается в девять часов утра.",
                            "target_lang_translations": {
                                "en": "My <first> lesson starts at nine o'clock in the morning.",
                                "zh": "我的<w>第一</w>节课在早上九点开始。"
                            }
                        },
                        {
                            "text": "Мы купили квартиру на <первом> этаже.",
                            "target_lang_translations": {
                                "en": "We bought an apartment on the <first> floor.",
                                "zh": "我们买了一套<w>一</w>楼的公寓。"
                            }
                        }
                    ],
                    "antonyms": [
                        "последний"
                    ],
                    "common_phrases": [
                        "первый раз",
                        "первый этаж",
                        "первый класс",
                        "первое место"
                    ],
                    "target_lang_definitions": {
                        "en": "Having the number one in a count; coming before the second in a series of similar items.",
                        "zh": "在计数中排在第一位；在同类事物中排在第二位之前。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "first",
                                "target_lang_sense_clarification": "ordinal number"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第一",
                                "target_lang_sense_clarification": "序数词，表示顺序或等级"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9c13709-7227-3b12-87db-5c18456e2b53",
                    "sense_definition": "Ранний, происходящий в самом начале какого-либо периода или процесса.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sequence_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В <первые> дни весны солнце светит особенно ярко.",
                            "target_lang_translations": {
                                "en": "In the <first> days of spring, the sun shines especially brightly.",
                                "zh": "在春天的<w>最初</w>几天里，阳光格外明媚。"
                            }
                        },
                        {
                            "text": "Я никогда не забуду свою <первую> любовь.",
                            "target_lang_translations": {
                                "en": "I will never forget my <first> love.",
                                "zh": "我永远不会忘记我的<w>初</w>恋。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ранний",
                        "начальный"
                    ],
                    "antonyms": [
                        "поздний",
                        "последний"
                    ],
                    "common_phrases": [
                        "первое время",
                        "первый снег",
                        "с первых слов",
                        "первая любовь"
                    ],
                    "target_lang_definitions": {
                        "en": "Early; occurring at the very beginning of a period or process.",
                        "zh": "早期的；发生在某个时期或过程的最开始。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "first",
                                "target_lang_sense_clarification": "initial, earliest"
                            },
                            {
                                "target_lang_word": "initial",
                                "target_lang_sense_clarification": "occurring at the beginning"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最初",
                                "target_lang_sense_clarification": "事物开始的阶段"
                            },
                            {
                                "target_lang_word": "第一",
                                "target_lang_sense_clarification": "用于表示首次或开端"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be12f529-d9d8-3797-aa7d-72a063eb9096",
                    "sense_definition": "Лучший, самый хороший, превосходящий других по качеству или мастерству.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality_importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <первый> ученик в нашем классе по математике.",
                            "target_lang_translations": {
                                "en": "He is the <top> student in our math class.",
                                "zh": "他是我们班数学成绩<w>第一</w>的学生。"
                            }
                        },
                        {
                            "text": "В этом магазине продают товары только <первого> сорта.",
                            "target_lang_translations": {
                                "en": "This store sells goods of only the <first> grade.",
                                "zh": "这家店只卖<w>一</w>等品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "лучший",
                        "наилучший",
                        "несравненный",
                        "непревзойдённый"
                    ],
                    "antonyms": [
                        "худший",
                        "отстающий"
                    ],
                    "common_phrases": [
                        "первый сорт",
                        "первый ученик",
                        "быть первым"
                    ],
                    "target_lang_definitions": {
                        "en": "The best; superior to others in quality or skill.",
                        "zh": "最好的；在质量或技能上优于他人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "top",
                                "target_lang_sense_clarification": "highest in rank or ability"
                            },
                            {
                                "target_lang_word": "first",
                                "target_lang_sense_clarification": "highest quality (e.g., first rate)"
                            },
                            {
                                "target_lang_word": "best",
                                "target_lang_sense_clarification": "surpassing all others"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第一",
                                "target_lang_sense_clarification": "指等级或水平最高"
                            },
                            {
                                "target_lang_word": "顶尖",
                                "target_lang_sense_clarification": "指在领域内处于领先地位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74598320-407f-3ffd-b825-e51f84e5baa6",
                    "sense_definition": "Главный, самый важный, имеющий существенное значение.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality_importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Безопасность детей — это наша <первая> задача.",
                            "target_lang_translations": {
                                "en": "Children's safety is our <primary> task.",
                                "zh": "儿童安全是我们的<w>首要</w>任务。"
                            }
                        },
                        {
                            "text": "Для врача здоровье пациента — дело <первой> важности.",
                            "target_lang_translations": {
                                "en": "For a doctor, a patient's health is a matter of <prime> importance.",
                                "zh": "对医生来说，病人的健康是<w>第一</w>重要的事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "первая необходимость",
                        "первая задача",
                        "из первых рук"
                    ],
                    "target_lang_definitions": {
                        "en": "Main; most important; having essential significance.",
                        "zh": "主要的；最重要的；具有本质意义的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "primary",
                                "target_lang_sense_clarification": "of chief importance"
                            },
                            {
                                "target_lang_word": "first",
                                "target_lang_sense_clarification": "foremost in importance"
                            },
                            {
                                "target_lang_word": "prime",
                                "target_lang_sense_clarification": "main, principal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "首要",
                                "target_lang_sense_clarification": "最重要的，排在第一位的"
                            },
                            {
                                "target_lang_word": "第一",
                                "target_lang_sense_clarification": "强调重要性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b726feb5-a1a5-331e-bfeb-861b51a17360",
                    "sense_definition": "Исполняющий ведущую, основную партию в оркестре или ансамбле.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В школьном оркестре заболела <первая> скрипка.",
                            "target_lang_translations": {
                                "en": "The <first> violin in the school orchestra got sick.",
                                "zh": "校管弦乐队的<w>首席</w>小提琴手病了。"
                            }
                        },
                        {
                            "text": "Он мечтает стать <первой> скрипкой в известном коллективе.",
                            "target_lang_translations": {
                                "en": "He dreams of becoming the <first> violin in a famous ensemble.",
                                "zh": "他梦想成为知名乐团的<w>首席</w>小提琴手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "первая скрипка"
                    ],
                    "target_lang_definitions": {
                        "en": "Performing the leading, main part in an orchestra or ensemble.",
                        "zh": "在管弦乐队或合奏中担任主导声部。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "first",
                                "target_lang_sense_clarification": "leading musical part"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "首席",
                                "target_lang_sense_clarification": "乐团中担任领奏的成员"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}