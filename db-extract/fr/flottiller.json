                "senses": [
                    {
                        "sense_id": "80a575d6-17fa-3c81-900e-4630f75e2f0e",
                        "entry_id": "56c515b0-23ae-3bef-b5de-9c9fa7710931",
                        "glosses": [
                            "Flotter de façon légère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c65b105e-dd38-4e75-8f1a-3fbe2f3c0b35",
                                "sense_id": "80a575d6-17fa-3c81-900e-4630f75e2f0e",
                                "text": "Ses cheveux noirs, ramassés en chignon, flottillaient sur sa nuque."
                            },
                            {
                                "example_id": "c10aaa97-03ad-47f0-be87-18f6f50b4bf9",
                                "sense_id": "80a575d6-17fa-3c81-900e-4630f75e2f0e",
                                "text": "Car une montre doit se porter légèrement décollée du poignet, pour flottiller oui flottiller oui, pour affirmer l’élégance, la classe et la distinction d’un homme, un vrai."
                            },
                            {
                                "example_id": "55c5feed-2286-4820-8350-ac6320e4f8a8",
                                "sense_id": "80a575d6-17fa-3c81-900e-4630f75e2f0e",
                                "text": "Nous restons ainsi une heure à flottiller gaiement dans une eau à 30°C."
                            }
                        ]
                    }
