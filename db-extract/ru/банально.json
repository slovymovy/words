        "ru-extract.jsonl": [
            {
                "entry_id": "806e24ac-1ed4-3b75-9455-2980536a3c31",
                "word": "банально",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cf828cfb-7681-3265-88f7-b138931f4bfd",
                        "entry_id": "806e24ac-1ed4-3b75-9455-2980536a3c31",
                        "glosses": [
                            "наречие к банальный; не отличаясь своеобразием, оригинальностью, новизной"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "7cad031c-9532-4142-9b68-4c3230def5b7",
                                "sense_id": "cf828cfb-7681-3265-88f7-b138931f4bfd",
                                "text": "Они разучились думать и излагать свои мысли ярко, не банально."
                            },
                            {
                                "example_id": "6633a016-252d-49e3-82bf-9a743b03dd7e",
                                "sense_id": "cf828cfb-7681-3265-88f7-b138931f4bfd",
                                "text": "Как ни банально это звучит, но деньги сами по себе не смогут доставить вам желаемого морального удовлетворения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7b6ebe9-f47e-49ae-8aec-9f26649463cf",
                        "source_entry_id": "806e24ac-1ed4-3b75-9455-2980536a3c31",
                        "source_sense_id": "cf828cfb-7681-3265-88f7-b138931f4bfd",
                        "target_lang_word": "mustily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mustily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f01473e-7e71-3c41-b7f0-1e6d23bcbd38",
                                        "entry_id": "f863a0e4-88d5-3fa9-97d9-7173ca45f2ae",
                                        "glosses": [
                                            "In a musty manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3473489d-7171-4337-acf8-4278a7e1179f",
                                                "sense_id": "4f01473e-7e71-3c41-b7f0-1e6d23bcbd38",
                                                "text": "1603, Michel de Montaigne, Essayes, translated by John Florio, The Second Chapter, “Of Repenting,”\n[…] nor are there any spirits, or very rare ones, which in growing old taste not sowrely and mustily."
                                            },
                                            {
                                                "example_id": "f926efad-8eec-45dc-aea4-fa96a49bb8f0",
                                                "sense_id": "4f01473e-7e71-3c41-b7f0-1e6d23bcbd38",
                                                "text": "All this is but a light-headed understanding now; I mean, why so melancholy? thou lookest mustily, methinks."
                                            },
                                            {
                                                "example_id": "3c015a10-74c1-4caf-850c-f0045d87aeac",
                                                "sense_id": "4f01473e-7e71-3c41-b7f0-1e6d23bcbd38",
                                                "text": "My little guide steered me up a filthy, crooked, crazy staircase to an upper floor so lighted, and into a room that smelt of sawdust, shavings, glue, shellac, rancidly-oiled metal, and all kinds of rankly or mustily malodorous muddle."
                                            },
                                            {
                                                "example_id": "d85359c2-0167-4584-b79e-4bfab8740982",
                                                "sense_id": "4f01473e-7e71-3c41-b7f0-1e6d23bcbd38",
                                                "text": "He was no student mustily thinking in a dead language, but a gentleman in waiting to the king, knight of the Order of St. Michael, writing in fresh, poetic French, with all the captivation of charm, teaching the fundamental principles of doubt and uncertainty […]"
                                            },
                                            {
                                                "example_id": "1e6ed081-f575-48a6-b73d-7af84569a115",
                                                "sense_id": "4f01473e-7e71-3c41-b7f0-1e6d23bcbd38",
                                                "text": "1908, O. Henry, “The Shocks of Doom” in The Voice of The City: Further Stories of the Four Million, Doubleday, Page & Co., 1914, pp. 96-7,\nHe was either young or old; cheap lodging-houses had flavored him mustily; razors and combs had passed him by; in him drink had been bottled and sealed in the devil’s bond."
                                            },
                                            {
                                                "example_id": "4c1fbd81-1926-4091-b950-129d41ea2eba",
                                                "sense_id": "4f01473e-7e71-3c41-b7f0-1e6d23bcbd38",
                                                "text": "The single window, square and mustily curtained, is so small that it cannot be imagined to admit much light on the brightest of days […]"
                                            },
                                            {
                                                "example_id": "a8cd4999-be99-48fc-be53-ce030bb64b7a",
                                                "sense_id": "4f01473e-7e71-3c41-b7f0-1e6d23bcbd38",
                                                "text": "He felt he was intruding, and hurried past the door with the coloured glass panes into the Book Room, which smelled mustily of old paper and worm-eaten wood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a02d6523-ab3c-4b50-8fa9-4afa96d6adee",
                        "source_entry_id": "806e24ac-1ed4-3b75-9455-2980536a3c31",
                        "source_sense_id": "cf828cfb-7681-3265-88f7-b138931f4bfd",
                        "target_lang_word": "obviously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obviously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                        "entry_id": "08cb5ae5-c6b0-3e0d-a5cc-e246bcc8c28d",
                                        "glosses": [
                                            "In an obvious or clearly apparent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85a2cb00-0ff5-4d12-a65f-dfcc4ec7ebec",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "She was in floods of tears and obviously very upset."
                                            },
                                            {
                                                "example_id": "61370174-7462-4f05-97a9-743a3abcb477",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "She'd obviously not gone to sleep yet: her eyes were bloodshot with sleepiness."
                                            },
                                            {
                                                "example_id": "1039c7ad-6815-4a9f-b377-98f227539248",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "The plane has obviously been delayed."
                                            },
                                            {
                                                "example_id": "2dfc1c3f-39e0-4137-b412-af9e1da3a71b",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                                            },
                                            {
                                                "example_id": "27eba153-6a8e-4637-94ee-071ae04d77b6",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "“Temu is gone! What I saw today completely convinced me!” the user wrote. “Local sellers, despite obviously buying some items in advance in a bulk, don’t have all these items I was interested in.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd09882b-dad8-3cf7-9437-ea0b96bf7ba5",
                                        "entry_id": "08cb5ae5-c6b0-3e0d-a5cc-e246bcc8c28d",
                                        "glosses": [
                                            "Used as a filler word, or to introduce information even when not obvious."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38742759-5d9a-4fa9-825e-818d1b5c53f0",
                                                "sense_id": "cd09882b-dad8-3cf7-9437-ea0b96bf7ba5",
                                                "text": "You weren't to know, but I've spoken to, obviously, Jim about this, and ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ab262d5-8526-48aa-a6e8-23c087a44994",
                        "source_entry_id": "806e24ac-1ed4-3b75-9455-2980536a3c31",
                        "source_sense_id": "cf828cfb-7681-3265-88f7-b138931f4bfd",
                        "target_lang_word": "prosily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prosily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "824e8490-eea7-3f15-b028-8e60d29ea7a0",
                                        "entry_id": "f06fbd7d-4ec2-3dff-af67-d7bb2ad4fd24",
                                        "glosses": [
                                            "In a prosy manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae949567-ecf0-468f-b730-99509fe20d50",
                                                "sense_id": "824e8490-eea7-3f15-b028-8e60d29ea7a0",
                                                "text": "By what magic could the young student escape the weary old professor, who was prosily proving Time merely a form of thought; a proposition of which, to judge by the little value he appeared to set on the subject of his discourse, he must himself have been fully persuaded?"
                                            },
                                            {
                                                "example_id": "ecb72b80-83eb-4327-bd23-c8cc3f565188",
                                                "sense_id": "824e8490-eea7-3f15-b028-8e60d29ea7a0",
                                                "text": "He was earnestly but prosily orating at the audience."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
