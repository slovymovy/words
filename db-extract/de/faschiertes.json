                                "target_senses": [
                                    {
                                        "sense_id": "5e25487b-0591-368d-9de3-ed00b31c6e5d",
                                        "entry_id": "55a250b2-b10b-3d3d-ab69-511e1f7ac619",
                                        "glosses": [
                                            "Food, especially meat and potatoes, chopped and mixed together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed64d64-5bbf-439f-82ea-11891135fbc1",
                                                "sense_id": "5e25487b-0591-368d-9de3-ed00b31c6e5d",
                                                "text": "Near-synonym: scramble"
                                            },
                                            {
                                                "example_id": "cdb48f8f-f0b2-48e0-a9aa-d5626aebc87c",
                                                "sense_id": "5e25487b-0591-368d-9de3-ed00b31c6e5d",
                                                "text": "I had for them, after oysters, at first course, a hash of rabbits, a lamb, and a rare chine of beef."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2463152b-9de2-3e59-b83e-53af55aea1f2",
                                        "entry_id": "55a250b2-b10b-3d3d-ab69-511e1f7ac619",
                                        "glosses": [
                                            "A confused mess."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f643cac2-cae4-48e2-b3bd-1ef778386fa8",
                                                "sense_id": "2463152b-9de2-3e59-b83e-53af55aea1f2",
                                                "text": "Oh! no, not Naylor's--the girls have made a hash there, as they do everything else; but we will settle her before they come out again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97bf2488-03f7-3b58-ae34-3eeb8690b3f4",
                                        "entry_id": "55a250b2-b10b-3d3d-ab69-511e1f7ac619",
                                        "glosses": [
                                            "The # symbol (octothorpe, pound)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84005565-2dbd-34c6-b927-0bc07ed9b689",
                                        "entry_id": "55a250b2-b10b-3d3d-ab69-511e1f7ac619",
                                        "glosses": [
                                            "The result generated by a hash function."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12ac457e-0150-3867-98da-f07a4202a75d",
                                        "entry_id": "55a250b2-b10b-3d3d-ab69-511e1f7ac619",
                                        "glosses": [
                                            "One guess made by a mining computer in the effort of finding the correct answer which releases the next unit of cryptocurrency; see also hashrate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99b2e2ba-d0b8-3d3a-934c-4943e24345e1",
                                        "entry_id": "55a250b2-b10b-3d3d-ab69-511e1f7ac619",
                                        "glosses": [
                                            "A new mixture of old material; a second preparation or exhibition; a rehashing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55bccb33-5b42-4ecb-85ad-7fda3eb804ec",
                                                "sense_id": "99b2e2ba-d0b8-3d3a-934c-4943e24345e1",
                                                "text": "October 28, 1752, Horace Walpole, letter to Sir Horace Mann\nI cannot bear elections, and still less the hash of them over again in a first session."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee06e55f-c6c5-38e2-84f5-df649d0cf12d",
                                        "entry_id": "55a250b2-b10b-3d3d-ab69-511e1f7ac619",
                                        "glosses": [
                                            "A hash run."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8412fcd5-9214-4640-a057-2a00379cb26d",
                                                "sense_id": "ee06e55f-c6c5-38e2-84f5-df649d0cf12d",
                                                "text": "Most hashes are planned as family affairs, with a shorter \"puppy\" trail laid for the children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "482205b3-69f0-3cdd-b57d-2c10719623e8",
                                        "entry_id": "55a250b2-b10b-3d3d-ab69-511e1f7ac619",
                                        "glosses": [
                                            "A stupid fellow."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f23fdea9-5d03-330a-acf4-dc43b51cf0df",
                                        "entry_id": "cb43e175-3365-3fe4-9e7b-bfa9aa59209d",
                                        "glosses": [
                                            "To chop into small pieces, to make into a hash."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c418cdc8-eeb0-49ef-93ae-ee396cc3dcbc",
                                                "sense_id": "f23fdea9-5d03-330a-acf4-dc43b51cf0df",
                                                "text": "In like manner, we shall represent human nature at first to the keen appetite of our reader, in that more plain and simple manner in which it is found in the country, and shall hereafter hash and ragoo it with all the high French and Italian seasoning of affectation and vice which courts and cities afford."
                                            },
                                            {
                                                "example_id": "64ba3edf-5932-4357-914b-a4ada4cae309",
                                                "sense_id": "f23fdea9-5d03-330a-acf4-dc43b51cf0df",
                                                "text": "I never did care for Sunday joint that was served up cold on Monday, hashed on Tuesday, rissoled on Wednesday, and re-hashed on Thursday[.]"
                                            }
                                        ]
