                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad2bd28d-32ce-4d10-83e0-cd921483e652",
                        "source_entry_id": "74663561-800c-3ea6-87ac-7dcadc0e46b9",
                        "source_sense_id": "0cdfd8c2-d065-3cf5-a98a-13b1017f01e5",
                        "target_lang_word": "Spottdrossel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spottdrossel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7913712-215b-3d9a-ad63-d18248cf9253",
                                        "entry_id": "69663023-ec8f-3824-bffb-b3a1de1ee034",
                                        "glosses": [
                                            "Vertreter einer hauptsächlich in Nordamerika verbreiteten Vogelart, die den Gesang vieler Vögel, die Laute anderer Tiere und sogar Geräusche aus der Umwelt nachahmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db81b3dd-a565-4cba-984b-5f3db7f89c35",
                                                "sense_id": "b7913712-215b-3d9a-ad63-d18248cf9253",
                                                "text": "„Nur der Kardinal sang in der Nachbarschaft seine schwermütige Weise; es zwitscherte der fröhliche Blauvogel, es sandte die melodienreiche Spottdrossel ihr süßes Lied in den goldenen Sonnenschein hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ca8db6c-622a-35ba-9c3a-e93edfe2326b",
                                        "entry_id": "69663023-ec8f-3824-bffb-b3a1de1ee034",
                                        "glosses": [
                                            "Singvogelfamilie in der Ordnung der Sperlingsvögel"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "defb854e-4e04-45ad-89f6-34326b98ea69",
                                                "sense_id": "7ca8db6c-622a-35ba-9c3a-e93edfe2326b",
                                                "text": "„Des Rätsels Lösung lag nahe: Irgendwann waren Spottdrosseln aus Chile auf die Galapagosinseln gelangt, hatten sich auf jeder einzelnen an deren Umwelt angepasst und sich so zu eigenen Arten entwickelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
