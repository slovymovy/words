                "translations": [
                    {
                        "translation_id": "969c89ff-956d-4a9d-9e5a-6dc1149728eb",
                        "source_entry_id": "71dc15bd-ab99-364e-b0cd-d4c02f4b0792",
                        "source_sense_id": "a4190b90-d898-34ff-b7cf-b8543422794d",
                        "target_lang_word": "appareil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appareil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8547e85-f153-3009-bee1-38be46dd1443",
                                        "entry_id": "5c7b2ee1-e7e3-34c1-8be2-ad8690ff3070",
                                        "glosses": [
                                            "Objet complexe conçu par l’homme afin de faciliter un travail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af513cb-d8a5-452d-bba9-57bebba68a2d",
                                                "sense_id": "e8547e85-f153-3009-bee1-38be46dd1443",
                                                "text": "Tous les bras disponibles travaillaient à la confection d’un mât, auquel les électriciens du Vaterland accrocheraient les longues antennes de l’appareil de télégraphie sans fil qui devait enfin relier le Prince au monde extérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6381beb3-69a1-32a7-8024-2d25285dc150",
                                        "entry_id": "5c7b2ee1-e7e3-34c1-8be2-ad8690ff3070",
                                        "glosses": [
                                            "Téléphone."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58815740-43ce-4b21-b328-bb6cf340a04a",
                                                "sense_id": "6381beb3-69a1-32a7-8024-2d25285dc150",
                                                "text": "Le téléphone sonna trois fois et Max parla longuement, en fumant. Il gribouillait sur une feuille de papier près de l’appareil."
                                            },
                                            {
                                                "example_id": "fe821257-c44b-4104-9610-250646baf21b",
                                                "sense_id": "6381beb3-69a1-32a7-8024-2d25285dc150",
                                                "text": "Resté vieille France, j’administre sèchement la formule d’usage jusque dans les années 70 :\n— Qui est à l’appareil?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "192681e1-8a0e-3797-99bb-b02321c77625",
                                        "entry_id": "5c7b2ee1-e7e3-34c1-8be2-ad8690ff3070",
                                        "glosses": [
                                            "Avion."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0732c489-a5d1-4eb8-9814-f2d1f48a3145",
                                                "sense_id": "192681e1-8a0e-3797-99bb-b02321c77625",
                                                "text": "Les appareils s’élevaient assez bien et volaient pendant quelques kilomètres, mais ils reprenaient rarement terre sans qu’une partie quelconque se disloquât."
                                            },
                                            {
                                                "example_id": "8f971b38-3f8b-4770-a596-d555f106aeed",
                                                "sense_id": "192681e1-8a0e-3797-99bb-b02321c77625",
                                                "text": "Je décidai donc de passer en Angleterre, en compagnie de trois camarades, à bord d'un Den-55, un type d'appareil tout nouveau qu'aucun de nous n'avait piloté auparavant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86fdaa64-8afb-33cc-b151-cb233559cd10",
                                        "entry_id": "5c7b2ee1-e7e3-34c1-8be2-ad8690ff3070",
                                        "glosses": [
                                            "Mélange de plusieurs ingrédients servant à la préparation d’un mets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8afbd80-fef9-4ae3-b1e9-f6649a752af0",
                                                "sense_id": "86fdaa64-8afb-33cc-b151-cb233559cd10",
                                                "text": "L’élément qui donnera le parfum est mélangé à un appareil de type béchamel, crème pâtissière ou purée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8db327dd-5472-34ca-b41d-1065e5a89edf",
                                        "entry_id": "5c7b2ee1-e7e3-34c1-8be2-ad8690ff3070",
                                        "glosses": [
                                            "Ensemble d’organes ayant une fonction particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b173614-e2d1-4de6-9ae9-b1f22c5ff151",
                                                "sense_id": "8db327dd-5472-34ca-b41d-1065e5a89edf",
                                                "text": "Les lésions de la fièvre typhoïde intéressent l’appareil lymphatique, depuis le tissu lymphoïde intestinal (follicules clos et plaques de Peyer) jusqu'aux ganglions mésentériques et à la rate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "693d23dd-0de5-39bb-aac8-54129b9e7de6",
                                        "entry_id": "5c7b2ee1-e7e3-34c1-8be2-ad8690ff3070",
                                        "glosses": [
                                            "Manière dont les personnes ou les choses se montrent aux autres. → voir dans le plus simple appareil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00e68ef5-6ab3-490d-b686-fd791d845f75",
                                                "sense_id": "693d23dd-0de5-39bb-aac8-54129b9e7de6",
                                                "text": "Quéribus ne me pouvant souffrir en mon appareil gâté par le sang, me bailla un pourpoint marron clair avec des crevés jaunes, lequel, quoique fort beau, était un rien moins chatoyant que son satin jaune pâle, comme il convient au frère cadet d’un Baron ; habilla de sa livrée noir et or Fröhlich et mon Miroul, et fit si bien que son majordome — dont certes il avait, lui, l’usance, ayant hôtel à Paris, maison des champs à Saint-Cloud et châtellenie dans le Carcassonnais — prêta à Giacomi une vêture de velours bleu de nuit dont le maestro fut fort aise, n’étant pas ennemi de sa terrestre apparence, je le dis sans en faire péché, ne voulant paille-poutrer l’œil d’un ami."
                                            },
                                            {
                                                "example_id": "4f243fe9-6fd1-40d4-8564-72dcdcd4998b",
                                                "sense_id": "693d23dd-0de5-39bb-aac8-54129b9e7de6",
                                                "text": "Je ne pouvais certes me douter que l’heure n’était plus éloignée où j’allais y voir s’avancer à petits pas, dans le plus baroque appareil, ma pitoyable destinée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ad8e2c9-d475-38ee-99c7-6b27a478f5fd",
                                        "entry_id": "5c7b2ee1-e7e3-34c1-8be2-ad8690ff3070",
                                        "glosses": [
                                            "Agencement et disposition des pierres dans un ouvrage de maçonnerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb8e7ab0-04e0-4a06-bab8-aa61a19bc6ab",
                                                "sense_id": "4ad8e2c9-d475-38ee-99c7-6b27a478f5fd",
                                                "text": "La ville avait la réputation d’être imprenable ; son château s’élevait à l’est et la ceinture de murailles qui entourait la cité venait s’y attacher ; des portes, des bastions, des fossés formaient un respectable appareil de défense."
                                            },
                                            {
                                                "example_id": "98a8d981-9c0f-47d4-b1a8-fa25a1a3b8ef",
                                                "sense_id": "4ad8e2c9-d475-38ee-99c7-6b27a478f5fd",
                                                "text": "Or, cette surélévation est construite en pierres avec bossages, les créneaux sont plus espacés, l’appareil beaucoup plus soigné que dans la partie inférieure et parfaitement semblable, en tout, à l’appareil des constructions de 1280."
                                            },
                                            {
                                                "example_id": "e850f48f-b7b1-41e7-b176-b21e4bb575ce",
                                                "sense_id": "4ad8e2c9-d475-38ee-99c7-6b27a478f5fd",
                                                "text": "Les chevaux s’arrêtèrent devant le palais Albertinelli. À la sombre façade, de rustique appareil, étaient scellés ces anneaux de bronze, qui, jadis, dans les nuits de fête, portaient des torches de résine."
                                            },
                                            {
                                                "example_id": "e9432534-3e88-4291-8e00-235393c000ea",
                                                "sense_id": "4ad8e2c9-d475-38ee-99c7-6b27a478f5fd",
                                                "text": "Les Égyptiens nous ont laissé des édifices construits en grand appareil, dont les assises sont formées de blocs énormes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a4cf9a4-3014-3026-b8e5-976c050b20ec",
                                        "entry_id": "5c7b2ee1-e7e3-34c1-8be2-ad8690ff3070",
                                        "glosses": [
                                            "Installation mobile posée au sol permettant de faire des exercices spécifiques (barres parallèles, cheval d’arçons, etc.) Les éléments suspendus sont appelés agrès."
                                        ],
                                        "tags": [
                                            "Gymnastique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "235376b5-5f8f-3dc4-b64e-9f6bcfe3a349",
                                        "entry_id": "5c7b2ee1-e7e3-34c1-8be2-ad8690ff3070",
                                        "glosses": [
                                            "Apprêt, préparatif d'une manifestation empreinte de pompe, de solennité. Déploiement extérieur qui accompagne une telle manifestation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e40adc8f-65c8-4777-8b77-38a224bbeb9e",
                                                "sense_id": "235376b5-5f8f-3dc4-b64e-9f6bcfe3a349",
                                                "text": "On voyait venir de loin une longue procession dont la bannière et les piques s’élevaient au-dessus de la foule qui s’ouvrit en silence pour examiner cet appareil à moitié ridicule et à moitié sinistre."
                                            },
                                            {
                                                "example_id": "f0215913-31e9-4953-81bb-cd502fa740f0",
                                                "sense_id": "235376b5-5f8f-3dc4-b64e-9f6bcfe3a349",
                                                "text": "Cette escorte de gens armés allait contre tous mes vœux, (…). N’eût-on pas dit, en me découvrant derrière cet appareil guerrier, que j’allais livrer bataille à mon voisin M. Loubet."
                                            },
                                            {
                                                "example_id": "d9fe31b5-ec01-4042-a845-80d8dc51298e",
                                                "sense_id": "235376b5-5f8f-3dc4-b64e-9f6bcfe3a349",
                                                "text": "Le Fit-worari Birro fit son entrée à la tête de plus de 6,000 hommes, et, avec un appareil militaire qui éveilla les jalousies des grands vassaux du Ras, mais qui flatta l’orgueil de sa belle-mère […]"
                                            },
                                            {
                                                "example_id": "1443cc0e-0568-4b85-acc7-89dc05c50f83",
                                                "sense_id": "235376b5-5f8f-3dc4-b64e-9f6bcfe3a349",
                                                "text": "Ce fut en l’année 566 que la cérémonie des noces eut lieu, avec un grand appareil, dans la ville royale de Metz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14ff838b-3b67-32a2-a33f-0788dfe6ae54",
                                        "entry_id": "5c7b2ee1-e7e3-34c1-8be2-ad8690ff3070",
                                        "glosses": [
                                            "Responsables d’une organisation, d’un parti politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f110c9be-7fa9-4aef-b831-7f6b7968723a",
                                                "sense_id": "14ff838b-3b67-32a2-a33f-0788dfe6ae54",
                                                "text": "Dans la Résistance intérieure, les éléments ex-vichyssois, les champions de l’électoralisme, les réactionnaires n'avaient qu'une minime influence. Dans l’appareil « gaulliste », au contraire, les hommes de la droite, et même d’anciens cagoulards, avaient des places éminentes."
                                            },
                                            {
                                                "example_id": "a64a1022-b7a2-4e07-898a-f90d8a7b15a3",
                                                "sense_id": "14ff838b-3b67-32a2-a33f-0788dfe6ae54",
                                                "text": "Ce qu’il se passe dans la gauche française et européenne dépasse le destin des appareils : c’est la fin de la social-démocratie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21953629-96db-3056-9d7a-cb821cf4e697",
                                        "entry_id": "5c7b2ee1-e7e3-34c1-8be2-ad8690ff3070",
                                        "glosses": [
                                            "Ensemble d’annotations et de commentaires qu’un éditeur annexe au texte original pour en faciliter la compréhension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9bb0bf0-c3c4-49aa-bb3b-0711f630a7d6",
                                                "sense_id": "21953629-96db-3056-9d7a-cb821cf4e697",
                                                "text": "Les textes anciens s’éloignent, et de plus en plus vite. Nos contemporains ne peuvent les lire que si nous les équipons de tout un appareil – introductions, explications, notes et, dans les cas extrêmes, modernisation du texte ou traduction. Tout un appareil qui rapproche le texte du lecteur, mais qui en même temps élève entre eux un écran."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
