                    {
                        "form_id": "1a306986-2a13-4d8e-8994-4cda4fd02e39",
                        "entry_id": "d99e744d-5ab8-3575-ab06-ed1e50cc5818",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "фиста́шках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "790b3573-286f-3994-906b-e8b0695f91b4",
                        "entry_id": "d99e744d-5ab8-3575-ab06-ed1e50cc5818",
                        "glosses": [
                            "ботан. род орехоплодных кустарниковых и древесных растений семейства сумаховых (анакардиевых); фисташник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edcf508c-2a01-4697-b123-74613d762524",
                                "sense_id": "790b3573-286f-3994-906b-e8b0695f91b4",
                                "text": "Тропа бежит под ветвями фисташек; подъем ступенчатый, легкий."
                            },
                            {
                                "example_id": "e11679b8-2839-41ec-8b07-683730bee2a8",
                                "sense_id": "790b3573-286f-3994-906b-e8b0695f91b4",
                                "text": "В гуще олеандров и дрока, фисташки и мирта, пушистого дуба и каштана торчали небрежно заточенные карандаши кипарисов."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddaed8da-bd19-3638-bf84-1399a89cea0f",
                        "entry_id": "d99e744d-5ab8-3575-ab06-ed1e50cc5818",
                        "glosses": [
                            "кулин. плод фисташкового дерева — маленький орех с зеленым, приятным на вкус зерном"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c85191c-0bf2-416d-931a-a2d82a83c30a",
                                "sense_id": "ddaed8da-bd19-3638-bf84-1399a89cea0f",
                                "text": "Сидели, слушали и в то же время щелкали орехи, фисташки, миндаль."
                            },
                            {
                                "example_id": "7f60c8f8-b39d-4700-a432-6ec035f56b70",
                                "sense_id": "ddaed8da-bd19-3638-bf84-1399a89cea0f",
                                "text": "Перед нею стоял поднос, на котором лежали фисташки, кишмиш и другие туземные сласти."
                            },
                            {
                                "example_id": "3c79e92c-b55d-4c0e-8951-5af17ca1a437",
                                "sense_id": "ddaed8da-bd19-3638-bf84-1399a89cea0f",
                                "text": "Я куплю шампанского, сухого, какое вы любите, солёных фисташек…"
                            }
                        ]
                    }
                ],
