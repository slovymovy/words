                                            {
                                                "example_id": "68dcfdfb-9f01-4551-8ac7-db8f89691e5b",
                                                "sense_id": "4594dab2-20a7-3f69-82c9-8019f263cfb4",
                                                "text": "Mit dem Dorsum werden im Deutschen z.B. die Konsonanten [j, ç, x, g, k, ŋ] gebildet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
