                    }
                ],
                "translations": [
                    {
                        "translation_id": "39609e54-3428-4aa9-92c9-7d6650bab230",
                        "source_entry_id": "763227c1-2d37-3089-8409-d9ca23355a1c",
                        "source_sense_id": "5ad5d32a-fc45-3e79-ba6e-953da0bb1787",
                        "target_lang_word": "co-operative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "co-operative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc4a70d4-58d7-38f1-8130-2be9f3a1829b",
                                        "entry_id": "d085749a-9752-3da2-b308-1ae9ea590778",
                                        "glosses": [
                                            "Alternative spelling of cooperative."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4c20276-bdee-4b24-b97c-88ff19f88923",
                                                "sense_id": "dc4a70d4-58d7-38f1-8130-2be9f3a1829b",
                                                "text": "The \"Liberation\" Locomotive. Reprinted from The Railway Gazette, June 28, 1946. […] This detailed description of the 2-8-0 locomotives built by the Vulcan Foundry Limited for service in the war-ravaged countries of Europe is a record of one of the most remarkable examples of determined co-operative effort in the field of locomotive construction."
                                            },
                                            {
                                                "example_id": "32b4a5b6-10f8-4971-99da-b8fc7ba4421d",
                                                "sense_id": "dc4a70d4-58d7-38f1-8130-2be9f3a1829b",
                                                "text": "At Futsing, in 1915, a school for boys was established which, because of its co-operative basis, was unique."
                                            },
                                            {
                                                "example_id": "09d00ee0-2f60-4fa3-96bd-031156790904",
                                                "sense_id": "dc4a70d4-58d7-38f1-8130-2be9f3a1829b",
                                                "text": "The solution to coach riding defects, at least, seems to require much more co-operative practical experiment by all engineering departments to achieve better sympathy between the vehicle body, its undercarriage and the track on which it rides."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "co-operative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2eaab692-bf9e-35a7-ba98-7d76c2c97968",
                                        "entry_id": "342c0e43-f634-3600-a4a3-456e78473f44",
                                        "glosses": [
                                            "Alternative spelling of cooperative."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33ffa005-4695-4023-9370-1023deeaf499",
                                                "sense_id": "2eaab692-bf9e-35a7-ba98-7d76c2c97968",
                                                "text": "In Tz’u-hsi county of Chekiang Province 19.9 per cent of 640 co-operatives were reported to have committed serious waste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5e93436-c4b1-4db5-9436-2409f51d9ab2",
                        "source_entry_id": "763227c1-2d37-3089-8409-d9ca23355a1c",
                        "source_sense_id": "5ad5d32a-fc45-3e79-ba6e-953da0bb1787",
                        "target_lang_word": "cooperative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cooperative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a16e7cd-d396-3762-a31e-b7db4dbe9487",
                                        "entry_id": "c9e1a313-9e4e-35c4-acba-f3471d8481fa",
                                        "glosses": [
                                            "Ready to work with another person or in a team; ready to cooperate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce0668e0-1d19-40f9-9a1d-152f4765d056",
                                                "sense_id": "1a16e7cd-d396-3762-a31e-b7db4dbe9487",
                                                "text": "The patient was rarely cooperative, and tended to refuse treatment."
                                            },
                                            {
                                                "example_id": "34598756-3b97-437b-a927-5b060dd23953",
                                                "sense_id": "1a16e7cd-d396-3762-a31e-b7db4dbe9487",
                                                "text": "Santorum, in a comment regarding Senator John McCain's repudiation of torture, stated, \"He doesn't understand how enhanced interrogation works. I mean, you break somebody, and after they've broken they become cooperative\" (Summers 2011)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bed1f85-2a1c-383e-a4f9-869eb1078069",
                                        "entry_id": "c9e1a313-9e4e-35c4-acba-f3471d8481fa",
                                        "glosses": [
                                            "Involving cooperation between individuals or parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fd5dff7-76b5-46cf-a560-7ed6b2ac9261",
                                                "sense_id": "7bed1f85-2a1c-383e-a4f9-869eb1078069",
                                                "text": "a cooperative game"
                                            },
                                            {
                                                "example_id": "9de62527-8555-43f1-92d3-8fcdf5f46ff5",
                                                "sense_id": "7bed1f85-2a1c-383e-a4f9-869eb1078069",
                                                "text": "a cooperative business enterprise"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0d78d3d-6bf2-3e02-8c92-8dde36121b4c",
                                        "entry_id": "c9e1a313-9e4e-35c4-acba-f3471d8481fa",
                                        "glosses": [
                                            "Relating to a cooperative or cooperatives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cooperative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3588d3bd-9ccd-37fc-a6c2-844252e6cc5c",
                                        "entry_id": "8b133a17-06d2-31a6-bf65-61e1257919c2",
                                        "glosses": [
                                            "A type of company that is owned partially or wholly by its employees, customers or tenants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5a38f5d-aec1-4817-9ad4-b0be3ea764a2",
                                                "sense_id": "3588d3bd-9ccd-37fc-a6c2-844252e6cc5c",
                                                "text": "The head of an agricultural producers’ cooperative in Chien-shih county of Hupei Province lectured his peasant wife: “To gain emancipation, women must do production work just like men.”"
                                            },
                                            {
                                                "example_id": "ebf6d791-8ee3-42b2-9c75-11bef69f09f2",
                                                "sense_id": "3588d3bd-9ccd-37fc-a6c2-844252e6cc5c",
                                                "text": "Among wholesalers, voluntary and cooperatives carry a far wider range and number of items in private brands than do unaffiliateds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
