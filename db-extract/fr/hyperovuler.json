                "senses": [
                    {
                        "sense_id": "2cf3b38b-a648-3f3b-9198-3adad8a21cc8",
                        "entry_id": "86e75449-0ff8-32f2-8078-f310c8374570",
                        "glosses": [
                            "Relâcher de multiples œufs lors de l’ovulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef6340d-222a-431e-afc4-31a2dfd30349",
                                "sense_id": "2cf3b38b-a648-3f3b-9198-3adad8a21cc8",
                                "text": "En plus, la dernière année, ils lui ont donné des trucs pour hyperovuler… Non mais t’imagines ? Ils auraient pu avoir des jumeaux…"
                            },
                            {
                                "example_id": "b3d9b133-802b-4079-808e-2604bdf9ff2a",
                                "sense_id": "2cf3b38b-a648-3f3b-9198-3adad8a21cc8",
                                "text": "Par exemple, une femme peut hyperovuler, libérant plusieurs œufs au milieu de son cycle menstruel."
                            },
                            {
                                "example_id": "bea09a4d-87e4-478d-a161-24f232b40ab6",
                                "sense_id": "2cf3b38b-a648-3f3b-9198-3adad8a21cc8",
                                "text": "Les femmes plus âgées, celles qui se rapprochent de la quarantaine, sont plus à même d’hyperovuler."
                            }
                        ]
                    }
                ],
