                "senses": [
                    {
                        "sense_id": "9d079640-1916-3a8c-8277-8930f8820fd2",
                        "entry_id": "fe7fb905-1cfa-392f-933d-a2ef9ee129fa",
                        "glosses": [
                            "die fünffingerigen, freien Extremitäten (beider Extremitätenpaare) der Tetrapoden ausgebildet als Bein, Arm, Flügel oder Flosse im Unterschied zur Fischflosse, dem Ichthyopterygium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3943dab-eadb-43ee-b608-83c5380ad993",
                                "sense_id": "9d079640-1916-3a8c-8277-8930f8820fd2",
                                "text": "Das Chiropterygium gilt als Weiterentwicklung des Archipterygiums."
                            },
                            {
                                "example_id": "10752a3a-d781-4784-8c0f-aaa0b92d6328",
                                "sense_id": "9d079640-1916-3a8c-8277-8930f8820fd2",
                                "text": "Das Chiropterygium der Wale ist als Flosse ausgeprägt."
                            },
                            {
                                "example_id": "9e40f7bc-d763-4ff0-9cae-7df6cde36fda",
                                "sense_id": "9d079640-1916-3a8c-8277-8930f8820fd2",
                                "text": "„Chiropterygien lassen sich mit landtauglichen Extremitäten von Amphibien vergleichen.“"
                            }
                        ],
