                                "sense_id": "28857212-67a5-3dd1-8ec5-eeecb273253f",
                                "text": "Holzwolle wird oft als Verpackungsmaterial verwendet."
                            },
                            {
                                "example_id": "a6ebb10d-0fb9-468d-a416-3a4488a98307",
                                "sense_id": "28857212-67a5-3dd1-8ec5-eeecb273253f",
                                "text": "„Da lagen sie in Spankörben mit feuchter Holzwolle, fünf Dutzend Helgoländer Hummer.“"
                            },
                            {
                                "example_id": "d18d058d-a61d-4453-be27-86ab69b2e4e2",
                                "sense_id": "28857212-67a5-3dd1-8ec5-eeecb273253f",
                                "text": "„Es roch nach Holzwolle und Naphthalin.“"
                            }
                        ],
