        "nl-extract.jsonl": [
            {
                "entry_id": "50f1f012-b4a1-38c4-9ee2-54ea9c84e2e3",
                "word": "jongere",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "42864b7d-accc-3e00-adb1-4c6506738039",
                        "entry_id": "50f1f012-b4a1-38c4-9ee2-54ea9c84e2e3",
                        "glosses": [
                            "verbogen vorm van de vergrotende trap van jong"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e198b26b-7d43-4aed-a205-4d6a4ac3e27b",
                                "sense_id": "42864b7d-accc-3e00-adb1-4c6506738039",
                                "text": "De jongere medewerkers hadden daar niet zo'n probleem mee."
                            },
                            {
                                "example_id": "1e258284-efa2-4cdb-b0c1-c752fc0277ea",
                                "sense_id": "42864b7d-accc-3e00-adb1-4c6506738039",
                                "text": "å Een vriendin, net als ik de oudste thuis, vertelt over een oude video- opname waarin haar jongere zusje, dat net leert lopen, trots van de stenen keukenvloer overeind krabbelt en richting de camera wankelt - om vervolgens bruut door het gebalde vuistje van mijn vriendin op haar hoofd te worden gestompt."
                            },
                            {
                                "example_id": "35e95f27-65de-45c4-b8eb-a2d40bff7019",
                                "sense_id": "42864b7d-accc-3e00-adb1-4c6506738039",
                                "text": "Hoe groter het leeftijdsverschil, hoe groter de kans dat de oudere kinderen logen over het feit dat ze valsspeelden; en degenen met een jongere broer of zus hielden hun leugen ook langer vol dan degenen met een oudere broer of zus."
                            },
                            {
                                "example_id": "7caec629-8ff2-4167-baf6-6960adc857f7",
                                "sense_id": "42864b7d-accc-3e00-adb1-4c6506738039",
                                "text": "Omdat ik altijd al last heb gehad van hoogtevrees vond ik deze steile stukken verschrikkelijk. Mijn jongere zusje hielp me hier overheen door rustig tegen me te praten als ik weer eens blokkeerde bij een steil stuk."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6a1d33d1-f0c1-389f-b487-42846ebf85f2",
