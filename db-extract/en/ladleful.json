                        "target_lang_word": "louchée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "louchée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1339fbf7-ee8e-309a-af6e-b9eff994f1cd",
                                        "entry_id": "9660cde0-1584-399a-b8ae-6f3cb425bf88",
                                        "glosses": [
                                            "Ce que contient une louche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a644d3d-dbd9-4be1-8fde-f25ce7b59705",
                                                "sense_id": "1339fbf7-ee8e-309a-af6e-b9eff994f1cd",
                                                "text": "Nous descendons lentement, jetant de temps à autre une louchée de sable, et, à 5 heures 25, nous ne sommes plus qu'à 700 mètres d'altitude; nous traversons un pays d'immenses plaines où le vent fait rage. La lune s'est levée."
                                            },
                                            {
                                                "example_id": "142137ad-8575-4649-ba92-a11312acf7c8",
                                                "sense_id": "1339fbf7-ee8e-309a-af6e-b9eff994f1cd",
                                                "text": "Elle savait l’ordre des choses : une louchée pour le patron, une pour Saturnin, une pour moi, le dernier venu, une pour elle."
                                            },
                                            {
                                                "example_id": "dbef6b36-92fb-465f-b55b-8e65fc4c70c5",
                                                "sense_id": "1339fbf7-ee8e-309a-af6e-b9eff994f1cd",
                                                "text": "À midi, et le soir à dix-neuf heures, on leur offrait l’habituelle louchée de pommes de terre, de lentilles, de haricots, de pois cassés ou de pâtes molles, de viande filandreuse, sans qu’aucune recherche, dans la préparation des plats ou la diversité des menus, compensât jamais le piètre choix des aliments…"
                                            },
                                            {
                                                "example_id": "b42ddd77-6b6e-44c7-b941-380c4efa8be8",
                                                "sense_id": "1339fbf7-ee8e-309a-af6e-b9eff994f1cd",
                                                "text": "Germaine, hilare, remplit à grandes louchées une écuelle de soupe de légumes."
                                            },
                                            {
                                                "example_id": "c6958cc7-6a00-428b-a1db-d6f92fc7c646",
                                                "sense_id": "1339fbf7-ee8e-309a-af6e-b9eff994f1cd",
                                                "text": "De nombreuses personnes s'étaient regroupées autour d'un énorme pot de fer dans lequel les marmitons puisaient de grandes louchées de riz mêlé d'un ragoût de légumes et de viande, qu'ils versaient dans de larges bols."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
