                    },
                    {
                        "translation_id": "30e9fedc-dbbb-48b5-9e58-8b826f72972c",
                        "source_entry_id": "4f9d878c-3122-3f48-97d2-57d75daff9a6",
                        "source_sense_id": "a9909de6-20f4-3168-9966-e0590ba0bbb6",
                        "target_lang_word": "Kabardinisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kabardinisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72169c22-20a3-3dc6-8a82-361c1e4f2fbf",
                                        "entry_id": "8285cf92-b399-31bc-9fae-229e3b4f0561",
                                        "glosses": [
                                            "nordwestkaukasische Sprache, die vor allem im Kaukasus von den Tscherkessen gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be6bce1a-09ec-4107-ae0e-2f9638576d08",
                                                "sense_id": "72169c22-20a3-3dc6-8a82-361c1e4f2fbf",
                                                "text": "„Ob es unter jenen nordkaukasischen Sprachen, die das minimale Vokalsystem in der sprachlichen Welt enthalten, einzigartige Sprachen wie Kabardinisch und Abasa gibt, die angeblich keine Vokalgegensätze haben und sich auf ein einziges Vokalphonem beschränken, bleibt eine umstrittene Frage[…].“"
                                            },
                                            {
                                                "example_id": "ff69680a-bb58-4b63-af5c-36d396dd35d5",
                                                "sense_id": "72169c22-20a3-3dc6-8a82-361c1e4f2fbf",
                                                "text": "„Der Kuban, Abchasisch Kubin genannt, Kabardinisch Psidsche, d. h. Altwasser, entspringt am Elbrus.“"
                                            },
                                            {
                                                "example_id": "f3716734-4ad4-4ced-8143-675f65afe9f0",
                                                "sense_id": "72169c22-20a3-3dc6-8a82-361c1e4f2fbf",
                                                "text": "„Bei einem Anteil von etwa 24 % städtischer Bevölkerung kann demnach für das Kabardinische allein statistisch eine relativ günstige Prognose gestellt werden.“"
                                            },
                                            {
                                                "example_id": "54d9dc53-e68c-45df-b95b-f52359206b36",
                                                "sense_id": "72169c22-20a3-3dc6-8a82-361c1e4f2fbf",
                                                "text": "„Die Gesamtzahl der Sprecher des Kabardinischen dürfte sich auf etwa 430 000 belaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
