                {
                    "sense_id": "50ab9367-59ff-3942-a283-9d4e606d4d3f",
                    "sense_definition": "An ethnic group of people inhabiting primarily Ghana and Côte d'Ivoire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Akan</w> are known for their rich cultural heritage and gold weights.",
                            "target_lang_translations": {
                                "ru": "Народ <w>акан</w> известен своим богатым культурным наследием и гирьками для взвешивания золота.",
                                "zh": "<w>阿坎人</w>以其丰富的文化遗产和黄金砝码而闻名。"
                            }
                        },
                        {
                            "text": "Historians study the migration patterns of the <w>Akan</w> people.",
                            "target_lang_translations": {
                                "ru": "Историки изучают пути миграции народа <w>акан</w>.",
                                "zh": "历史学家研究<w>阿坎人</w>的迁徙模式。"
                            }
                        }
                    ],
                    "common_phrases": [
