                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f13491d-d5d3-427e-89cb-d5fef6fa95e5",
                        "source_entry_id": "2e7cdb45-e632-3705-b149-b57297c5ede1",
                        "source_sense_id": "9f1542cc-529c-3676-9526-e47b75597363",
                        "target_lang_word": "Schumacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schumacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08a32cdb-a9cb-368c-92af-595eec3c11f7",
                                        "entry_id": "515f3bc2-e327-35ff-991a-9677134f312c",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "368d59c6-abb6-46bf-8b60-7b36aad37801",
                                                "sense_id": "08a32cdb-a9cb-368c-92af-595eec3c11f7",
                                                "text": "„Gleichzeitig fehlen die Typen: Kein Effenberg, kein Rummenigge, kein Toni Schumacher weit und breit.“"
                                            },
                                            {
                                                "example_id": "51a90988-e306-4eec-9b70-ca79aba29c18",
                                                "sense_id": "08a32cdb-a9cb-368c-92af-595eec3c11f7",
                                                "text": "„Die Tifosi feiern weiter \"ihren\" Weltmeister Michael Schumacher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd59d1f5-6507-4f99-959e-2c33afeda3a6",
                        "source_entry_id": "2e7cdb45-e632-3705-b149-b57297c5ede1",
                        "source_sense_id": "9f1542cc-529c-3676-9526-e47b75597363",
                        "target_lang_word": "Schuhmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuhmacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94df4a40-fb3b-3800-a19f-d80dfa198515",
                                        "entry_id": "3a0e22e4-37e9-302f-a431-59211d41be8b",
                                        "glosses": [
                                            "jemand, der Schuhe herstellt oder repariert"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "864736dd-dc69-4954-86c4-69b93e04af00",
                                                "sense_id": "94df4a40-fb3b-3800-a19f-d80dfa198515",
                                                "text": "„Und da stehen ja schon die Tanzschuhe!« sagte Fritz. »Ist Herr Beauregard denn auch ein Schuhmacher?“"
                                            },
                                            {
                                                "example_id": "afcb2115-98c2-4172-9d3a-5f950fa61591",
                                                "sense_id": "94df4a40-fb3b-3800-a19f-d80dfa198515",
                                                "text": "„Er verstummte, als er die Menge und den blutbesudelten Mann sah, und nun schlossen sich alle Schuhmacher mit hastiger Neugier dem Volkshaufen an, der sich durch die Strasse wälzte.“"
                                            },
                                            {
                                                "example_id": "86ae6a5d-4f8d-4e05-87de-a80246a0e277",
                                                "sense_id": "94df4a40-fb3b-3800-a19f-d80dfa198515",
                                                "text": "„Signor Rinaldi lief sogleich hinunter, um einen Juwelier, einen Strumpfhändler, einen Schuhmacher und einen Parfümeur zu holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
