                                    {
                                        "sense_id": "74ff7a50-e782-325c-b1e7-c80d48083b0c",
                                        "entry_id": "b415f900-179a-3571-a8b9-60e0f9c31f42",
                                        "glosses": [
                                            "A gripping tool, pivoted like a pair of scissors, but with blunt jaws."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1d7b90d-1732-4501-9830-d4ca7b1b8ffd",
                                                "sense_id": "74ff7a50-e782-325c-b1e7-c80d48083b0c",
                                                "text": "Milk formed their chief diet, and this they were supposed to imbibe from the witch herself, from a third \"teat\" which had been made beneath the arm by a nip from the Devil's pincers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "813f52ce-2ddd-361e-91ac-fc7b14727f2b",
                                        "entry_id": "b415f900-179a-3571-a8b9-60e0f9c31f42",
                                        "glosses": [
                                            "The front claws of crustaceans such as lobsters."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db3acf30-a6dd-453f-973f-92239ed37687",
