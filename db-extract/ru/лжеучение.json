                        "cross_references": [
                            {
                                "target_word": "heresy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78d56f18-a394-33f3-a087-f12f5e972681",
                                        "entry_id": "925529c6-d269-3e94-b891-08481fe3d5b9",
                                        "glosses": [
                                            "A doctrine held by a member of a religion at variance or conflict with established religious beliefs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d32e8e0-6261-45a7-8ddb-8e06258c26d2",
                                                "sense_id": "78d56f18-a394-33f3-a087-f12f5e972681",
                                                "text": "Heresy meant deliberate departure from the accepted doctrines of the church. It was intellectual and spiritual dissent and concerned the beliefs of Christianity, not the morals of its adherents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08cc1a1a-1ef0-34b8-92f0-d85fee1074da",
                                        "entry_id": "925529c6-d269-3e94-b891-08481fe3d5b9",
                                        "glosses": [
                                            "A controversial or unorthodox opinion held by a member of a group, as in politics, philosophy or science."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0c8493-dce5-41ba-9ffa-15262ff96648",
                                                "sense_id": "08cc1a1a-1ef0-34b8-92f0-d85fee1074da",
                                                "text": "I'm going to declare a heresy for you. All science, if you go back into its roots, saying: 'Why do I believe this?' 'Well, I believe this because of these tests and this proof.' 'Well, why do I believe this?' 'Why did I set up this test?' 'Why did I believe that proof?' All science goes back to something that we believe because we believe it. We believe it because we believe it, and we have no proof for it. It's like a religion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
