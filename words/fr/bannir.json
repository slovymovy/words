{
    "word_family": [
        "ban",
        "bannissement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1983ec9b-a54b-3f33-b0e3-e6cba1b1d19a",
                    "sense_definition": "Écarter, interdire ou rejeter l'usage d'une chose, ou exclure l'accès d'une personne à un groupe ou un service.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour protéger l'environnement, la municipalité a décidé de <w>bannir</w> les sacs en plastique à usage unique."
                        },
                        {
                            "text": "Le modérateur a dû <w>bannir</w> cet internaute du forum à cause de ses insultes répétées."
                        }
                    ],
                    "synonyms": [
                        "exclure",
                        "interdire",
                        "proscrire",
                        "rejeter"
                    ],
                    "antonyms": [
                        "adopter",
                        "autoriser",
                        "intégrer"
                    ],
                    "common_phrases": [
                        "bannir le plastique",
                        "bannir un compte"
                    ]
                },
                {
                    "sense_id": "ff55c1d8-3f4c-3114-a745-0f56693a78d3",
                    "sense_definition": "Condamner une personne à quitter son pays ou son lieu de résidence, avec interdiction d'y revenir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la défaite militaire, le souverain déchu fut <w>banni</w> de son propre pays pour toujours."
                        },
                        {
                            "text": "Le tribunal a décidé de <w>bannir</w> le condamné de la ville pour une période de dix ans."
                        }
                    ],
                    "synonyms": [
                        "exiler",
                        "expulser"
                    ],
                    "antonyms": [
                        "accueillir",
                        "rapatrier"
                    ],
                    "common_phrases": [
                        "bannir à perpétuité",
                        "bannir du royaume"
                    ]
                },
                {
                    "sense_id": "b8a34e55-dcb7-3574-9bf7-c71f3ca0bcc9",
                    "sense_definition": "Chasser ou dissiper une émotion, une pensée ou un sentiment de son esprit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de monter sur scène, la comédienne s'efforce de <w>bannir</w> tout sentiment de panique."
                        },
                        {
                            "text": "Il faut <w>bannir</w> le doute pour pouvoir avancer avec confiance dans cette aventure."
                        }
                    ],
                    "synonyms": [
                        "chasser",
                        "dissiper",
                        "écarter"
                    ],
                    "antonyms": [
                        "cultiver",
                        "entretenir"
                    ],
                    "common_phrases": [
                        "bannir le doute",
                        "bannir toute crainte"
                    ]
                },
                {
                    "sense_id": "5b946a1b-9c8d-3386-a7f3-9738087971eb",
                    "sense_definition": "Publier ou proclamer une ordonnance, un décret ou un avis solennel au moyen d'un ban public.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "proclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prévôt fit <w>bannir</w> la nouvelle ordonnance à son de trompe sur la place du marché."
                        },
                        {
                            "text": "On entendit le crieur public <w>bannir</w> l'ordre du seigneur devant tous les habitants assemblés."
                        }
                    ],
                    "synonyms": [
                        "proclamer",
                        "publier"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme d'histoire du droit féodal"
                        }
                    ]
                }
            ]
        }
    ]
