                                    {
                                        "sense_id": "0ec33ccd-c968-3248-9a12-e860b892932c",
                                        "entry_id": "66c2dfe8-c932-35e6-8841-ee773017d14d",
                                        "glosses": [
                                            "The development and use of a system for recording and analyzing the financial transactions and financial status of an individual or a business."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a241d7e3-df36-4392-9ee2-a7547bb610c0",
                                                "sense_id": "0ec33ccd-c968-3248-9a12-e860b892932c",
                                                "text": "British Railways are beginning to reap the advantages of electronics applied to accounting. At Swindon Works, a computor, the first of its type to be used anywhere in the world, was installed recently to deal with the pay of some 10,000 employees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b8bdee2-57a2-35a2-b327-fc984c6a559f",
                                        "entry_id": "66c2dfe8-c932-35e6-8841-ee773017d14d",
                                        "glosses": [
                                            "A relaying of events; justification of actions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
