                    {
                        "sense_id": "6a927072-42e8-3456-87a1-f7cdcfe05df4",
                        "entry_id": "649e98d5-4aeb-3adf-8eb4-5eca42299000",
                        "glosses": [
                            "The quality or state of being mutable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0bf9be1e-6075-4343-ad55-43369c13f3ab",
                                "sense_id": "6a927072-42e8-3456-87a1-f7cdcfe05df4",
                                "text": "He did indeed account somewhat unfairly for this sudden change; for besides some hard and unjust surmises concerning female fickleness and mutability, he began to suspect that he owed this want of civility to his want of horses […]"
                            },
                            {
                                "example_id": "3d23c79e-34d0-42e1-982f-fba61fede8dc",
                                "sense_id": "6a927072-42e8-3456-87a1-f7cdcfe05df4",
                                "text": "There rise authors now and then, who seem proof against the mutability of language, because they have rooted themselves in the unchanging principles of human nature."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2419ae0-32fe-49a7-881a-63fc25c38655",
                        "source_entry_id": "649e98d5-4aeb-3adf-8eb4-5eca42299000",
                        "source_sense_id": "6a927072-42e8-3456-87a1-f7cdcfe05df4",
                        "source_sense_description": "quality or state of being mutable",
