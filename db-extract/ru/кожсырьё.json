                                        "sense_id": "d3f0821f-2398-336d-997d-0d98c2a0d563",
                                        "entry_id": "8f95eaf2-5bf7-3be7-9519-1ff0d9addce7",
                                        "glosses": [
                                            "An unprocessed sugar; a batch of such."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab71a9fb-1a52-4c44-8e4c-835b80e7292a",
                                                "sense_id": "d3f0821f-2398-336d-997d-0d98c2a0d563",
                                                "text": "With the recent advance in London yellow crystals, however, the disproportion of the relative value of these two kinds has been considerably reduced, and a better demand for crystallized raws should consequently occur."
                                            },
                                            {
                                                "example_id": "d242bf9b-b413-4a90-a6c5-a86399a7e7fe",
                                                "sense_id": "d3f0821f-2398-336d-997d-0d98c2a0d563",
                                                "text": "Early in the year the raws were melted to about 20 Brix in order to facilitate filtration."
                                            },
                                            {
                                                "example_id": "12b46a4f-e397-4286-ab26-84289b38939f",
                                                "sense_id": "d3f0821f-2398-336d-997d-0d98c2a0d563",
                                                "text": "The world sugar contract closed 1 to 3 points net higher, with sales of only 36 lots. London raws sold at 8s. 4½d., and futures there were unchanged to 3d. higher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0573acc-ce68-35d1-a652-355eb222a152",
                                        "entry_id": "8f95eaf2-5bf7-3be7-9519-1ff0d9addce7",
                                        "glosses": [
                                            "A galled place; an inveterate sore."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
