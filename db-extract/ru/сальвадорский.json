                "senses": [
                    {
                        "sense_id": "387dda80-e50c-3ca3-9b05-c2665ca5cf03",
                        "entry_id": "659c19ee-3767-3ea5-be67-86b1b4255322",
                        "glosses": [
                            "относящийся к Сальвадору, сальвадорцам, связанный с ними"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43129d74-6001-4b52-ab4a-844d5dd8c322",
                                "sense_id": "387dda80-e50c-3ca3-9b05-c2665ca5cf03",
                                "text": "Сальвадорские повстанцы отвергли как неприемлемое прекращение огня, объявленное режимом Дуарте в одностороннем порядке и вступившее в силу 5 ноября, т. к. оно направлено не на достижение мира в стране, а лишь на чисто формальное выполнение гватемальских договоренностей."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f4e1047-df39-36b2-abb9-33dbb590b484",
                        "entry_id": "659c19ee-3767-3ea5-be67-86b1b4255322",
                        "glosses": [
                            "свойственный сальвадорцам, характерный для них и для Сальвадора"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d34ef630-24bb-3801-9fa5-6a88809ec5f8",
                        "entry_id": "659c19ee-3767-3ea5-be67-86b1b4255322",
                        "glosses": [
                            "принадлежащий Сальвадору, сальвадорцам"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c7510c86-84d9-3897-a619-be14094928f0",
                        "entry_id": "659c19ee-3767-3ea5-be67-86b1b4255322",
                        "glosses": [
                            "созданный, выведенный и т. п. в Сальвадоре или сальвадорцами"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f9d8d95-adef-4f40-949f-1430e7cd5b02",
                        "source_entry_id": "659c19ee-3767-3ea5-be67-86b1b4255322",
                        "source_sense_description": "относящийся к Сальвадору, сальвадорцам, связанный с ними",
                        "target_lang_word": "Salvadoran",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salvadoran",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10006e01-396b-3a33-acef-31c46ee61d5c",
                                        "entry_id": "23f92e64-1f54-31bb-8bf0-94f80310fb88",
                                        "glosses": [
                                            "A person from El Salvador or of Salvadoran descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ebf800a-5c68-4e5f-b588-b870f5cdb415",
                                                "sense_id": "10006e01-396b-3a33-acef-31c46ee61d5c",
                                                "text": "Under Biden, a Trump-era decision to end TPS for Salvadorans was rescinded after a group of Latino officials pleaded with the outgoing president to continue TPS for people from those countries with “meritorious cases,” citing “horrific levels of violence that surged in recent years” in Ecuador, along with the oppression of the Ortega regime that has controlled Nicaragua for decades and “political and environmental conditions” in El Salvador."
                                            }
                                        ]
                                    }
