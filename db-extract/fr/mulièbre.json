                        ],
                        "examples": [
                            {
                                "example_id": "959e23e9-ea7c-43f5-8cba-b3b69960fca0",
                                "sense_id": "27425d1c-0e16-3888-b345-d799144ba43c",
                                "text": "A cette cause interne du monde mulièbre, se joint à l’instant une cause externe"
                            },
                            {
                                "example_id": "f7b146fd-8115-4ad5-85fe-d6a4531ba504",
                                "sense_id": "27425d1c-0e16-3888-b345-d799144ba43c",
                                "text": "Ce livre cy tant honnore et celebre,\nLa qualité de l'estat muliebre."
