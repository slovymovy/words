                "senses": [
                    {
                        "sense_id": "e39959fb-7319-30c9-b2c8-fe2b615ce859",
                        "entry_id": "54a0e8a8-491b-3b52-9d02-66aaa5000ac7",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c585aaf-2685-4b57-abc1-e4d6c0c370e5",
                                "sense_id": "e39959fb-7319-30c9-b2c8-fe2b615ce859",
                                "text": "Frau Schiffle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dba1929c-eff7-4da6-b268-9343acdf7c54",
                                "sense_id": "e39959fb-7319-30c9-b2c8-fe2b615ce859",
                                "text": "Herr Schiffle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e5f10624-5e17-4c4c-9ae3-84a81080408a",
                                "sense_id": "e39959fb-7319-30c9-b2c8-fe2b615ce859",
                                "text": "Die Schiffles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "33dc4a32-3d92-4aaa-9e13-677d5d9696d8",
                                "sense_id": "e39959fb-7319-30c9-b2c8-fe2b615ce859",
                                "text": "Der Schiffle trägt nie die Schals, die die Schiffle ihm strickt."
                            },
                            {
                                "example_id": "43d0b02b-58be-4943-9eef-33fc11704398",
                                "sense_id": "e39959fb-7319-30c9-b2c8-fe2b615ce859",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schiffle kommt, geht der Herr Schiffle.“"
                            },
                            {
                                "example_id": "12a2603a-8a20-4c79-b0a1-51f4f8d1a5c5",
                                "sense_id": "e39959fb-7319-30c9-b2c8-fe2b615ce859",
                                "text": "Schiffle kommt und geht."
                            },
                            {
                                "example_id": "2a9a3341-94c9-4307-b627-4fc0bd2cb7ba",
                                "sense_id": "e39959fb-7319-30c9-b2c8-fe2b615ce859",
                                "text": "Schiffles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
