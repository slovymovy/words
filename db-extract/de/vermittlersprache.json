                ],
                "senses": [
                    {
                        "sense_id": "9a40468d-14bd-3d5b-85b9-6334a47d1258",
                        "entry_id": "dfb16cc9-8e5a-318f-99d5-f1b6df37bfeb",
                        "glosses": [
                            "Sprache, über die eine Entlehnung in die aufnehmende Sprache kommt, die aber oft nicht die ursprüngliche Herkunft der Entlehnung ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47aa948e-3364-478a-a9fe-03bb98192681",
                                "sense_id": "9a40468d-14bd-3d5b-85b9-6334a47d1258",
                                "text": "„Für die Auswertung etymologischer Wörterbücher gibt es zwei Herangehensweisen: Entweder wird die Vermittlersprache, d.h. die Sprache, über die ein Wort ins Deutsche gelangt ist, berücksichtigt, oder aber die Herkunftssprache, d.h. die Sprache, aus der ein Wort ursprünglich stammt.“"
                            },
                            {
                                "example_id": "1991e4f1-ae13-4f38-9e48-fe9b2616cef4",
                                "sense_id": "9a40468d-14bd-3d5b-85b9-6334a47d1258",
                                "text": "„Eine weitere Ursache dafür, dass im Kroatischen ein Genuswechsel gegenüber dem Französischen zu verzeichnen ist, liegt darin, dass häufig das Deutsche als Vermittlersprache vorliegt, wobei man wissen muss, dass deutsche Neutra im Kroatischen als Maskulina auftreten…“"
                            },
                            {
                                "example_id": "95ca143e-ef54-428a-bdce-689657ba3454",
                                "sense_id": "9a40468d-14bd-3d5b-85b9-6334a47d1258",
                                "text": "„In solchen Fällen wurde bei der Datengewinnung zu Best & Altmann (1986) nur die Sprache berücksichtigt, aus der das Deutsche seine Wörter direkt erhalten hat, in diesem Fall also das Lateinische als »Vermittlersprache«;…“"
                            },
                            {
                                "example_id": "afa103cc-7a58-46e3-bb04-c3dbe7d2b07c",
                                "sense_id": "9a40468d-14bd-3d5b-85b9-6334a47d1258",
                                "text": "„Bei 46 Entlehnungen tritt die russische Sprache als Vermittlersprache auf.“"
                            },
                            {
                                "example_id": "cf9e4166-ac00-4495-8fdb-104ed7ecc50b",
                                "sense_id": "9a40468d-14bd-3d5b-85b9-6334a47d1258",
                                "text": "„Seit dem 17. Jahrhundert sind Kenntnisse des Französischen und Italienischen zunehmend belegt, […], aber die Tradition, dass alles Fremde über Deutschland nach Skandinavien kommt mit dem Deutschen als Vermittlersprache, dauerte noch bis ins 20. Jahrhundert, als das Englische diese Rolle definitiv übernimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
