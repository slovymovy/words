                                        "examples": [
                                            {
                                                "example_id": "20dc16e7-e9c7-4bfd-b715-6cccf994a640",
                                                "sense_id": "3bb77f8b-ffc8-3bd1-8ee3-88f5245c95ab",
                                                "text": "Chcesz takie bursztynowe słoniątko, będziesz miała pamiątkę z wakacji?"
                                            },
                                            {
                                                "example_id": "17c0fcd3-203d-4829-9b2a-e191efe02a35",
                                                "sense_id": "3bb77f8b-ffc8-3bd1-8ee3-88f5245c95ab",
                                                "text": "Słoniątko nie wie, co to niebezpieczeństwo, chce poznawać świat, a najlepiej robić to za pomocą trąby."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
