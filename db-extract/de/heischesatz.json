                "senses": [
                    {
                        "sense_id": "3035df20-7013-3096-9ab3-19df6d3bf140",
                        "entry_id": "912e049f-75a0-36b0-be22-15386ab1e593",
                        "glosses": [
                            "ein Satz, welcher eine Forderung enthält und unbewiesen bleibt"
                        ],
                        "tags": [
                            "ältere Mathematik"
                        ],
                        "examples": [
                            {
                                "example_id": "cd59c5cb-3092-4e85-98e1-503f2e9f87c3",
                                "sense_id": "3035df20-7013-3096-9ab3-19df6d3bf140",
                                "text": "„Der 1. Heischesatz. 14. Von jedem Punkte A kann zu jedem andern B eine gerade Linie gezogen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dd629282-577c-30ee-9a9e-70d6bb668a3a",
                        "entry_id": "912e049f-75a0-36b0-be22-15386ab1e593",
                        "glosses": [
                            "Satz, der einen Wunsch ausdrückt; diese Sätze haben im Deutschen das Verb in Erststellung im Konjunktiv oder eine entsprechende Nebensatzform mit \\\"wenn\\\" oder \\\"dass\\\" als Einleitung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e845a88-a1eb-4997-a29e-141c43e2f754",
                                "sense_id": "dd629282-577c-30ee-9a9e-70d6bb668a3a",
                                "text": "Der Satz „Käme er doch endlich!“ ist ein Heischesatz, ebenso wie „Wenn er doch endlich käme!“."
                            },
                            {
                                "example_id": "ce67dfed-34a6-431b-8fa1-818e4ac7167c",
                                "sense_id": "dd629282-577c-30ee-9a9e-70d6bb668a3a",
                                "text": "Die Aufforderung zu einer Handlung, der Heischesatz, besitzt die formale Eigenheit der Kürze, hat eine starke Tendenz, zum Schluß aufzusteigen, und liebt die Anfangs- oder Mittelstellung des Verbs."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bc73c9e-df24-40e1-ab4d-b93d171f570a",
