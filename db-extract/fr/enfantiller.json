                "senses": [
                    {
                        "sense_id": "928edc17-452f-3e8a-a4b1-1d19c66b2a88",
                        "entry_id": "b4d244a9-53cd-3925-8fa6-93f918222b67",
                        "glosses": [
                            "Faire l’enfant."
                        ],
                        "tags": [
                            "familiar",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "83062ccb-403e-46a8-a003-c08ea90f30f3",
                                "sense_id": "928edc17-452f-3e8a-a4b1-1d19c66b2a88",
                                "text": "Je vous en prie, arrêter \"d'enfantiller\". Quand grandirez-vous enfin?"
                            },
                            {
                                "example_id": "dee5052b-e80a-4ca3-8684-06ea77176d84",
                                "sense_id": "928edc17-452f-3e8a-a4b1-1d19c66b2a88",
                                "text": "Moi aussi, j'aurais bien aimé enfantiller toute ma vie, rester genre princesse gloutonne les pieds sous la table, mais avec mon grand blond qui ne sait même pas faire un oeuf sur le plat, ou alors il va mettre la cuisine sans dessus-dessous avant de trouver l'oeuf et la poêle (!):(((, alors que j'aime bien les plaisirs de la table:)))... j'ai pluka !"
                            },
                            {
                                "example_id": "6011c760-50b6-46cc-9fc2-027464816ceb",
                                "sense_id": "928edc17-452f-3e8a-a4b1-1d19c66b2a88",
                                "text": "On ne va pas enfantiller comme ça toute la soirée."
                            }
                        ]
                    }
                ],
