                "senses": [
                    {
                        "sense_id": "3d513053-0300-3f6e-baee-7530a2d689ce",
                        "entry_id": "e59ffed6-6629-3ce4-a519-8b5cb5b8f5a4",
                        "glosses": [
                            "Topf aus Eisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b45f6d1d-8d03-4dc3-9c0d-7748a62ef0e7",
                                "sense_id": "3d513053-0300-3f6e-baee-7530a2d689ce",
                                "text": "„Ich half ihr, indem ich den Ingwer und die Zwiebeln röstete, die zur Würze in dem Eisentopf mit den köchelnden Knochen landeten.“"
                            },
                            {
                                "example_id": "3f333f13-ed5b-4227-bdd5-7f18a1d64bf3",
                                "sense_id": "3d513053-0300-3f6e-baee-7530a2d689ce",
                                "text": "„Von hier gingen mehrere Zimmer ab, in denen weiße Kalebassen, Eisentöpfe, schrumpelige Ziegenblasen, Kräuter und Wurzeln, Federn, Schlangenhäute und Stachelschweinstacheln lagerten.“"
                            },
                            {
                                "example_id": "4319e8c0-1b2d-4a34-ae8d-914a34dccc6a",
                                "sense_id": "3d513053-0300-3f6e-baee-7530a2d689ce",
                                "text": "„Auf dem Bleich standen ein Eisentopf und ein Kessel, unter deren Gewicht die Platte bedenklich durchhing.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
