                                        "sense_id": "74248597-c2d1-3ba0-a0de-2cce26c03a36",
                                        "entry_id": "e745a07b-91d3-341a-966e-e5e54a17397f",
                                        "glosses": [
                                            "Bundesstaat im Nordosten der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51afec37-04da-48ba-bd3a-94090a39a46a",
                                                "sense_id": "74248597-c2d1-3ba0-a0de-2cce26c03a36",
                                                "text": "Die Hauptstadt von Maine ist Augusta."
                                            },
                                            {
                                                "example_id": "f683c14c-a083-4bb9-b5ac-7a778df26ce0",
                                                "sense_id": "74248597-c2d1-3ba0-a0de-2cce26c03a36",
                                                "text": "Mehr als neunzig Prozent der Fläche Maines sind mit Wäldern bedeckt."
                                            },
                                            {
                                                "example_id": "e408dc32-62e2-4756-b3eb-b9d8bc8e066a",
                                                "sense_id": "74248597-c2d1-3ba0-a0de-2cce26c03a36",
                                                "text": "Fahren, Schauen, Baden und Schlemmen an der Küste von Maine: ein Ausflug nach Portland und durch die abwechslungsreiche Küstenlandschaft. Maine hat ein ganz spezielles Parfüm."
                                            },
                                            {
                                                "example_id": "6db50ed6-b1f6-46f8-8a33-3d5efb9a5f74",
                                                "sense_id": "74248597-c2d1-3ba0-a0de-2cce26c03a36",
                                                "text": "„Wenn Touristen in Maine essen gehen, bestellen sie normalerweise Hummer und Muscheln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
