                        "translation_id": "6dd6f479-5bdc-42f8-b415-be9a97add54a",
                        "source_entry_id": "588b5ee5-bc97-36bc-9b5d-61b63a0fe539",
                        "source_sense_id": "3b2cfe79-896e-3fe7-9e33-78ada94f71ee",
                        "target_lang_word": "unfortunately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfortunately",
