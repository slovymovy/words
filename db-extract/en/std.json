                                                "example_id": "98f1048e-1871-4838-af7a-9f7a31e2efc9",
                                                "sense_id": "5aff4c82-0d78-3311-9df5-54927e39cf0c",
                                                "text": "Selon Jean-Michel Molina, l’augmentation des IST a plusieurs explications."
                                            },
                                            {
                                                "example_id": "2c948924-dc0c-48a4-a688-7ea85070c2c6",
                                                "sense_id": "5aff4c82-0d78-3311-9df5-54927e39cf0c",
                                                "text": "Selon la dernière étude de l’ECDC, les États membres ont fait état de 300 000 nouveaux diagnostics d’ IST par an."
                                            }
