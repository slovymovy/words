                "senses": [
                    {
                        "sense_id": "624a0a74-bef7-31f3-8b87-c8c51b736248",
                        "entry_id": "79ca7543-8231-38b0-ac34-0a3bef2d4e9a",
                        "glosses": [
                            "sytuacja wymagająca trudnego wyboru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9b5a613-bc0e-4e9d-a9aa-e279fb4365bc",
                                "sense_id": "624a0a74-bef7-31f3-8b87-c8c51b736248",
                                "text": "Dylemat polega na tym, czy Rosja może się zmodernizować bez samobójczej westernizacji?"
                            },
                            {
                                "example_id": "7ec8af6f-b09f-40e0-98b4-e290698eb053",
                                "sense_id": "624a0a74-bef7-31f3-8b87-c8c51b736248",
                                "text": "Dylemat etyczny powstaje, gdy nie istnieje jedna oczywista, właściwa decyzja, gdy równie dobrze można wybrać jedno, jak i drugie rozwiązanie."
                            },
                            {
                                "example_id": "598cff09-ae7b-47ae-b539-551ed720f90e",
                                "sense_id": "624a0a74-bef7-31f3-8b87-c8c51b736248",
                                "text": "Deficyt budżetowy rzędu 10 proc. PKB albo rozpad systemów zabezpieczenia społecznego i zdrowotnego - przed takim dylematem już za dwadzieścia lat stanie Polska za sprawą antynatalnej i depopulacyjnej polityki prowadzonej przez kolejne rządy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b6700a1b-fc4e-3c4a-9875-577c9b1177f8",
                        "entry_id": "79ca7543-8231-38b0-ac34-0a3bef2d4e9a",
                        "glosses": [
                            "wnioskowanie, gdzie oprócz dwóch zdań warunkowych trzecią przesłanką jest zdanie alternatywne"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
