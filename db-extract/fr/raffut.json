                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "8ecec124-e980-4d04-a64e-ef15d0bfd54f",
                                "sense_id": "a0a07e72-38d4-3183-90cc-f67f059d8fc0",
                                "text": "Toute petite, dès la naissance, la voix de Clara avait préservé la maison du raffut de la ville."
                            },
                            {
                                "example_id": "b617b71a-19d5-4e42-8830-71e3d8f693de",
                                "sense_id": "a0a07e72-38d4-3183-90cc-f67f059d8fc0",
                                "text": "Ils ont fait un raffut de tous les diables."
                            }
                        ]
                    },
                    {
                        "sense_id": "2708874a-62fb-36fe-a3c9-2723884b0c0e",
                        "entry_id": "b1be5794-ab65-3cf9-a374-2d9fde3c5084",
                        "glosses": [
                            "Technique utilisée par le porteur du ballon pour repousser, de sa main libre ouverte ou du bras, le haut du corps d’un adversaire cherchant à le plaquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e93598d-58f1-4393-9145-45f6d0ffa77e",
                                "sense_id": "2708874a-62fb-36fe-a3c9-2723884b0c0e",
                                "text": "Le raffut avec le poing et a fortiori le coude est interdit."
                            },
                            {
                                "example_id": "41f5d9f9-bcf7-4a40-bd25-76c08121b1de",
                                "sense_id": "2708874a-62fb-36fe-a3c9-2723884b0c0e",
                                "text": "Mettre un raffut pour écarter l'adversaire."
                            }
                        ]
                    }
