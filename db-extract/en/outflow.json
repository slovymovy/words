                "translations": [
                    {
                        "translation_id": "7d51ef1f-84a3-41ae-94be-9c60c1b91108",
                        "source_entry_id": "1939a72d-5de3-3319-a70e-2d1625e1433d",
                        "source_sense_description": "Process of flowing out",
                        "target_lang_word": "sortie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sortie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ff88ecf-1834-35b9-923e-e7884c0b5195",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Action de sortir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbf22846-449a-4d9f-8275-7ffb274cd7ee",
                                                "sense_id": "0ff88ecf-1834-35b9-923e-e7884c0b5195",
                                                "text": "Le surlendemain […] dans la soirée, la couleur bleue de l’eau, indice des grands fonds, m’apprenait ma sortie du golfe de Panama."
                                            },
                                            {
                                                "example_id": "f4f10e43-1394-428d-a121-8722822e6cd5",
                                                "sense_id": "0ff88ecf-1834-35b9-923e-e7884c0b5195",
                                                "text": "Il a toujours gardé la chambre depuis un mois, voilà sa première sortie."
                                            },
                                            {
                                                "example_id": "ea9e4ffa-dbb0-422b-8fbc-824c22448ef8",
                                                "sense_id": "0ff88ecf-1834-35b9-923e-e7884c0b5195",
                                                "text": "Dans cette pièce de théâtre, les entrées et les sorties ne sont pas assez motivées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baed6958-835f-35a0-8db7-ca659ac6ed5d",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Action de sortir.",
                                            "Fait pour un spationaute de sortir dans l’espace à partir d’un véhicule spatial."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1eebf75a-325d-3dcb-a592-1a2e4176f14e",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Issue, endroit par où l’on sort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8131d00-fe3b-45f7-9515-abe22d880470",
                                                "sense_id": "1eebf75a-325d-3dcb-a592-1a2e4176f14e",
                                                "text": "Cette maison a deux, trois sorties."
                                            },
                                            {
                                                "example_id": "6b60ae29-e3a8-40b5-9132-5c3753d8bda9",
                                                "sense_id": "1eebf75a-325d-3dcb-a592-1a2e4176f14e",
                                                "text": "Il a une sortie sur la campagne et une sur la rue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "051f8eec-f9d1-3cb7-9d57-328ac1ef3e2d",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Passage d’un lieu dans un autre, en parlant des marchandises qu’on transporte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad6ce224-1bcb-4034-a056-362e8dc9b2ce",
                                                "sense_id": "051f8eec-f9d1-3cb7-9d57-328ac1ef3e2d",
                                                "text": "L’entrée et la sortie des marchandises."
                                            },
                                            {
                                                "example_id": "905240b0-0449-49fd-83ca-b4d377f408cb",
                                                "sense_id": "051f8eec-f9d1-3cb7-9d57-328ac1ef3e2d",
                                                "text": "Droits d’entrée et de sortie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8611a76c-2e71-36bd-92c8-a326764f1913",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Endroit où l’on va lorsque l’on sort pour ses loisirs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66c90621-36e3-4a31-9c0c-0b5077fe6334",
                                                "sense_id": "8611a76c-2e71-36bd-92c8-a326764f1913",
                                                "text": "Toujours imperturbablement ouvert, le Virgin des Champs était la sortie du dimanche pour les étudiants de l’Ouest parisien autant que pour les zy-va de Gennevilliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "611bbec7-dd46-36c3-b7ec-f9bd03c47fd9",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Édition ou parution d'une œuvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c73f2e35-0c6d-45fa-ac2c-d6cc1d3006a1",
                                                "sense_id": "611bbec7-dd46-36c3-b7ec-f9bd03c47fd9",
                                                "text": "Ce film musical nous baigne dans les années soixante-dix avec tout ce qu'il y a de plus kitch ; mais comme souvent, certains films comme celui-ci, qualifiés de « nanards » par les critiques, deviennent incontournables après leur sortie."
                                            },
                                            {
                                                "example_id": "efc79f87-b2e4-4056-a6b5-f79ec32abd49",
                                                "sense_id": "611bbec7-dd46-36c3-b7ec-f9bd03c47fd9",
                                                "text": "Le nouveau « Assassin’s Creed » victime d’une fuite majeure, trois semaines avant sa sortie"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "263d58b5-25ec-367a-a82b-d89a7c077baa",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Attaque que font les assiégés, lorsqu’ils sortent pour livrer bataille aux assiégeants et tenter de dégager la place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b51d9dbc-c72e-469d-8a46-0173d02a9a29",
                                                "sense_id": "263d58b5-25ec-367a-a82b-d89a7c077baa",
                                                "text": "[…], car il était aisé à la garnison de garder les bords de l’Aude, au moyen de la grande barbacane (…) qui permettait de faire des sorties avec des forces imposantes et de culbuter les assiégeants dans le fleuve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56482cb7-68e0-3d6a-a55a-ca8af2d644d4",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Vêtement que l’on porte pour sortir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "970f8847-f816-41e4-bea4-aaa18ce9aa1c",
                                                "sense_id": "56482cb7-68e0-3d6a-a55a-ca8af2d644d4",
                                                "text": "Sortie de bal."
                                            },
                                            {
                                                "example_id": "8871972e-be25-4392-90b2-df5e3ddc42f9",
                                                "sense_id": "56482cb7-68e0-3d6a-a55a-ca8af2d644d4",
                                                "text": "Sortie de bain."
                                            },
                                            {
                                                "example_id": "f0711e1c-fc84-4ac3-8f7f-b8e2fef09494",
                                                "sense_id": "56482cb7-68e0-3d6a-a55a-ca8af2d644d4",
                                                "text": "Quand elle allait à la promenade ou à l'église, [elle mettait] une pelisse à capuchon taillée comme la mantille espagnole…, ou plutôt comme une sortie de théâtre de nos jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b34d0f9-2a82-35a0-a11c-e66e8addea49",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Rude réprimande ; mots durs dits brusquement ; emportement."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe7ef7d5-a407-4cee-942d-d456cd629e9f",
                                                "sense_id": "5b34d0f9-2a82-35a0-a11c-e66e8addea49",
                                                "text": "Faire une sortie à quelqu’un."
                                            },
                                            {
                                                "example_id": "a3249aaf-b8d3-4f9c-a266-e0e30c749641",
                                                "sense_id": "5b34d0f9-2a82-35a0-a11c-e66e8addea49",
                                                "text": "Faire une sortie contre quelqu’un."
                                            },
                                            {
                                                "example_id": "dbefd0f6-3512-4a27-ac5e-1b6483c142ca",
                                                "sense_id": "5b34d0f9-2a82-35a0-a11c-e66e8addea49",
                                                "text": "Une sortie si violente les étonna."
                                            },
                                            {
                                                "example_id": "ecf5e643-2eff-4236-b997-4d043915eda2",
                                                "sense_id": "5b34d0f9-2a82-35a0-a11c-e66e8addea49",
                                                "text": "L’ennui lui donnait de l’humeur, et il n’était pas sûr de pouvoir résister à la tentation de se distraire par une sortie plaisante ou insolente."
                                            },
                                            {
                                                "example_id": "7244a690-4929-48e7-9ea1-09c0b9bb1792",
                                                "sense_id": "5b34d0f9-2a82-35a0-a11c-e66e8addea49",
                                                "text": "Il se souvenait de la sortie que le jeune homme avait faite contre Laveuve, chez le baron."
                                            },
                                            {
                                                "example_id": "858f35c7-c40a-496f-bb77-0620615e2dfe",
                                                "sense_id": "5b34d0f9-2a82-35a0-a11c-e66e8addea49",
                                                "text": "Gabriel roule des yeux stupides et affecte de ne rien comprendre à cette « sortie » inconvenante de M. le secrétaire particulier."
                                            },
                                            {
                                                "example_id": "8970da89-0efb-4fb2-bb3b-351ca153f8ff",
                                                "sense_id": "5b34d0f9-2a82-35a0-a11c-e66e8addea49",
                                                "text": "Plus disponibles qu’à Paris, ils supportaient moins patiemment que jamais mes silences et je n’arrangeai pas les choses en me laissant aller deux ou trois fois à des sorties désordonnées."
                                            },
                                            {
                                                "example_id": "85ab82b9-bba4-4d4f-a74a-01dbc04c6efa",
                                                "sense_id": "5b34d0f9-2a82-35a0-a11c-e66e8addea49",
                                                "text": "À cette table où, depuis des mois, on évitait de parler de lui, une telle sortie équivalait à une provocation."
                                            },
                                            {
                                                "example_id": "774a2445-b949-410b-9b30-84fd16bbfed9",
                                                "sense_id": "5b34d0f9-2a82-35a0-a11c-e66e8addea49",
                                                "text": "Encore une sortie semblable, et, Seigneur ou pas, je vous fais bâillonner, dit-il à Sigomal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b063cd75-fb14-3b23-8f3b-f5a029504ecb",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Action inhabituelle voire choquante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ff89b68-23ee-4eea-9bfd-0fc273978040",
                                                "sense_id": "b063cd75-fb14-3b23-8f3b-f5a029504ecb",
                                                "text": "Il n’empêche. D’autres sorties de M. Ruffin ont jeté le trouble parmi ses camarades. Comme cette interview publiée sur YouTube le 31 mai, exhumée par des internautes."
                                            },
                                            {
                                                "example_id": "4aa031bf-2214-45c4-a6ab-0e1b15ed15a9",
                                                "sense_id": "b063cd75-fb14-3b23-8f3b-f5a029504ecb",
                                                "text": "Il est ainsi connu pour ses innombrables sorties homophobes, ses appels à faire interdire des films ou de simples représentations d’un arc-en-ciel, son déni du darwinisme, son horreur du féminisme…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5bd8d8a-19c6-32c7-a704-23bb3e144232",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Course hippique considérée du point de vue d’un cheval qui y participe, prestation, épreuve."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be67351a-061d-45a4-8abe-0fc9d8907891",
                                                "sense_id": "e5bd8d8a-19c6-32c7-a704-23bb3e144232",
                                                "text": "Ne tenez pas compte de sa dernière sortie à Nantes, où il ne s’est pas plu, malgré sa bonne fin de course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb18224c-6419-3710-b90e-223d795ad557",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Signal ou puissance qu’un appareil délivre pour agir sur un autre élément."
                                        ],
                                        "tags": [
                                            "Automatique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37ed0254-bf5e-443e-b695-263a55fe74e2",
                                                "sense_id": "fb18224c-6419-3710-b90e-223d795ad557",
                                                "text": "Un amplificateur linéaire est un circuit électronique dont la sortie est proportionnelle à son entrée, mais capable de délivrer plus de puissance dans une charge."
                                            },
                                            {
                                                "example_id": "1da9382e-fffc-441e-8e3d-50420da8aa47",
                                                "sense_id": "fb18224c-6419-3710-b90e-223d795ad557",
                                                "text": "La puissance maximale dont on peut disposer en sortie est obtenue lorsque le courant et la tension de sortie sont aux limites de ce que l’amplificateur peut fournir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ca5237f-c95f-365b-a9bb-98f6def7d43f",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Point de raccordement physique sur un appareil où il délivre un signal ou une puissance (cf. 11 ci-dessus)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f6b4808-9814-45e1-851e-5313d6e0d9b8",
                                                "sense_id": "9ca5237f-c95f-365b-a9bb-98f6def7d43f",
                                                "text": "M. Q. soutient que :\n- les conditions standards de livraison de Régaz ne font pas état de la possibilité de raccordement à la sortie d’impulsion du compteur électronique, interdisent toujours au client d’opérer une intervention quelconque sur le compteur et que la seule mention de cette possibilité dans le catalogue des prestations est insuffisante ; …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcf89eb1-dc16-3ddc-a431-5577a09593fe",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "Données renvoyées par une commande après son exécution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bb10948-019c-3287-94ae-71cbf77088cf",
                                        "entry_id": "b82a8b15-3e67-3753-bffa-cc977a60b1cf",
                                        "glosses": [
                                            "(aéronautique) Mission de combat accomplie par un appareil militaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30618366-6104-400f-9c68-9ce46c1dfcf7",
                                                "sense_id": "9bb10948-019c-3287-94ae-71cbf77088cf",
                                                "text": "L'Armée de l'air a effectué 10 000 sorties entre le 10 mai et le 25 juin 1940"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sortie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6448fa3-96f4-302a-9458-ffe8c33e8208",
                                        "entry_id": "4e902f29-a92a-3f06-b9b9-a0f94f8846a9",
                                        "glosses": [
                                            "Participe passé féminin singulier de sortir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20ec29f7-88b6-46e7-b377-d7a6b29f85ea",
                                                "sense_id": "c6448fa3-96f4-302a-9458-ffe8c33e8208",
                                                "text": "La voix du courlieu, douce et triste, semble une note sortie d’une flûte; la grande bécassine ventriloquise son chant en volant d’une façon désordonnée au-dessus de son nid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
