                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d4ff9cc-b0ba-482f-b914-747f55eca866",
                                "sense_id": "152c8c4d-e900-3e53-8de9-73d80b034f07",
                                "text": "Спасибо сенатору США Генри Джексону и конгрессмену Чарльзу Вэнику, убедившим американский Конгресс принять поправку к закону о торговле с СССР."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cca3993-71d4-4a7b-9d81-aca7e451d06d",
                        "source_entry_id": "032f983c-0e38-3bd4-b259-8dfc5683ca3e",
                        "source_sense_id": "152c8c4d-e900-3e53-8de9-73d80b034f07",
                        "target_lang_word": "Jackson",
                        "target_lang_code": "en",
