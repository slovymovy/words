                                                "example_id": "2f815247-2a80-4d3a-a163-7eb4691d83ac",
                                                "sense_id": "f225fe16-8b53-3ea2-b21a-aa15c75cf21c",
                                                "text": "saving and transitional provisions"
                                            },
                                            {
                                                "example_id": "d69ae87d-cc2e-4acd-802d-8e291ed81c36",
                                                "sense_id": "f225fe16-8b53-3ea2-b21a-aa15c75cf21c",
                                                "text": "Tis Good Advice not to Contend with Those that are too Strong for us, but still with a saving to Honesty and Justice"
                                            }
