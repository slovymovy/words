                        ]
                    },
                    {
                        "translation_id": "76d8a0f5-8f67-44f0-9a60-4e09388d8e54",
                        "source_entry_id": "86e76fa5-7ca8-3803-9b0f-a127cf7bbaa4",
                        "source_sense_id": "577a2047-557a-3199-9bee-02cff2bc32eb",
                        "target_lang_word": "kokošník",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "52c1cfb3-a95d-4e1e-9b45-23b93b7a315e",
                        "source_entry_id": "86e76fa5-7ca8-3803-9b0f-a127cf7bbaa4",
                        "source_sense_id": "577a2047-557a-3199-9bee-02cff2bc32eb",
                        "target_lang_word": "kokochnik",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kokochnik",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87d5a18b-1917-3055-9178-5022a3f79eed",
                                        "entry_id": "ac0e33be-8f39-3951-ab04-dc88d0fa6f33",
                                        "glosses": [
                                            "Coiffe traditionnelle de femme en Russie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ca2b368-b248-434c-8ae2-90a845ff367a",
                                                "sense_id": "87d5a18b-1917-3055-9178-5022a3f79eed",
                                                "text": "Voici la clé du coffre de ta mère; tu y trouveras ses habits et ses coiffes, le kokochnik brodé de perles qui la parait les jours de fête, les simples pavoinik qu’elle portait les jours de travail."
                                            },
                                            {
                                                "example_id": "74c02dc2-53ab-40ca-a650-8cfae5067a5d",
                                                "sense_id": "87d5a18b-1917-3055-9178-5022a3f79eed",
                                                "text": "La toque convient-elle bien à cette énorme chevelure qu’un kakochnyk ne ferait que mettre en valeur ?"
                                            },
                                            {
                                                "example_id": "a8b4c806-53b0-47af-a621-94c4567030cb",
                                                "sense_id": "87d5a18b-1917-3055-9178-5022a3f79eed",
                                                "text": "Une fillette âgée de cinq ans tient dans ses bras une énorme poupée prêtée pour la photo. Une poupée somptueuse : lourde tresse, joues vermeilles, volant brodé de la robe, haut kokochnik, fauteuil en rotin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e90667a-9c5e-42e3-a5c6-a6eecc7f922d",
                        "source_entry_id": "86e76fa5-7ca8-3803-9b0f-a127cf7bbaa4",
                        "source_sense_id": "577a2047-557a-3199-9bee-02cff2bc32eb",
                        "target_lang_word": "кокошник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кокошник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "05d4226c-3a2a-39db-905a-bfecf1a5a71f",
                                        "entry_id": "a49be96a-a8a8-3634-83e2-d22f7d1927e7",
                                        "glosses": [
                                            "истор. старинный русский праздничный головной убор замужних женщин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da839c36-dafb-44c7-8d1e-b5f68a083125",
                                                "sense_id": "05d4226c-3a2a-39db-905a-bfecf1a5a71f",
                                                "text": "А ежели бы её нарядить в сарафан, да косу заплести, да кокошник — лучше не надо."
                                            },
                                            {
                                                "example_id": "714316d0-1eb1-4052-867e-02cc2452958b",
                                                "sense_id": "05d4226c-3a2a-39db-905a-bfecf1a5a71f",
                                                "text": "Вот человеческий лик, намалёванный белилами и румянами, с насурмёнными дугою бровями, под огромным кокошником в виде лопаты, вышитым жемчугом, изумрудами и яхонтами."
                                            },
                                            {
                                                "example_id": "bc5898bb-5318-4710-9203-c76a88c06f21",
                                                "sense_id": "05d4226c-3a2a-39db-905a-bfecf1a5a71f",
                                                "text": "Головной прибор: кокошник, окаймляющий гладко причёсанные волосы и сзади стянутый бантом широкой ленты, висящей двумя концами как угодно низко."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7ff6522-d667-33a4-b6ea-1e3a14835bc0",
                                        "entry_id": "a49be96a-a8a8-3634-83e2-d22f7d1927e7",
                                        "glosses": [
                                            "архит. в древнерусском зодчестве — ложная закомара, имеющая только декоративное значение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d680fb-9d71-47db-8a25-25900f764921",
                                                "sense_id": "e7ff6522-d667-33a4-b6ea-1e3a14835bc0",
                                                "text": "Над углами четверика возвышаются небольшие тумбы, обработанные килевидными кокошниками."
                                            },
                                            {
                                                "example_id": "0c22af99-ffff-442a-addd-a64c2b120096",
                                                "sense_id": "e7ff6522-d667-33a4-b6ea-1e3a14835bc0",
                                                "text": "Вон, видишь, кровля кокошником изноровлена и гребни на ней прорезные?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
