                ],
                "senses": [
                    {
                        "sense_id": "a336458b-60d5-327b-a519-66bac640c8d8",
                        "entry_id": "d56deb0c-30c4-3c77-89ea-d042adcc6545",
                        "glosses": [
                            "Landmaschine, die benutzt wird um Heu in Schwaden zusammenzulegen, damit es dann mit einem weiteren Gerät (Ladewagen oder Ballenpresse) aufgenommen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71afd173-0acb-42e2-ba3a-b19d85ab2448",
                                "sense_id": "a336458b-60d5-327b-a519-66bac640c8d8",
                                "text": "Sehr bewährt hat sich auch die Entnahme von Rechgut mit Traktor und Heuschwader."
                            },
                            {
                                "example_id": "307c5872-b745-44d2-8bfa-b19b4502939b",
                                "sense_id": "a336458b-60d5-327b-a519-66bac640c8d8",
                                "text": "Der Traktor ist in sehr gutem Zustand und sein Geld wert. Im November dieses Jahres wird Alexej Safonow Geld für einen Heuschwader bekommen."
                            },
                            {
                                "example_id": "c2141fc3-d3d6-4e2b-9a40-a9fc19914da7",
                                "sense_id": "a336458b-60d5-327b-a519-66bac640c8d8",
                                "text": "Der Mann fuhr mit seinem Traktor, an dem ein Heuschwader angehängt war. Seine Schwiegertochter rechte das Heu zusammen, das vom Schwader liegen gelassen wurde."
                            },
                            {
                                "example_id": "128ca832-54e2-4bd6-817f-3cf72e14094d",
                                "sense_id": "a336458b-60d5-327b-a519-66bac640c8d8",
                                "text": "Wie die Polizeiinspektion mitteilt, führte er hinter der landwirtschaftlichen Zugmaschine einen zweiachsigen Heuschwader nach. Zwischen den Ortschaften überholte ein polnischer Lastzug das Gespann."
                            },
                            {
                                "example_id": "93ca6cbb-df79-4386-b55f-e4c73df53bbf",
                                "sense_id": "a336458b-60d5-327b-a519-66bac640c8d8",
                                "text": "Durch bisher unbekannte Täter wurde in der Zeit zwischen 17.09.09 und 18.09.09, ein landwirtschaftliches Arbeitsgerät, ein sogenannter Heuschwader, entwendet, der vom Eigentümer auf einem Feld in der Gewanne Steinberg abgestellt worden war."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
