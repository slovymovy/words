                "forms": [],
                "senses": [
                    {
                        "sense_id": "c19f8a7f-1852-391d-8910-7bb958cfd2a0",
                        "entry_id": "d74989e7-1b02-3c62-88b3-562e45407db8",
                        "glosses": [
                            "Abréviation de lanceur de balles de défense ou lanceur de balle de défense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bce4112-e461-4c14-9fb2-317c176e5769",
                                "sense_id": "c19f8a7f-1852-391d-8910-7bb958cfd2a0",
                                "text": "Très critiqué pour son manque de précision, le flash-ball peut être mortel en cas de tir très rapproché. Doté d’un viseur perfectionné de type militaire, le LBD permet un tir beaucoup plus ciblé."
                            },
                            {
                                "example_id": "e309151a-fca3-45dd-a330-d1f798dac395",
                                "sense_id": "c19f8a7f-1852-391d-8910-7bb958cfd2a0",
                                "text": "Manifestants blessés par des LBD : \"Personne ne peut se satisfaire de cette situation\", selon Florence Parly."
                            },
                            {
                                "example_id": "6565c8ea-6c1a-4e53-b06e-16fb30c1b6b1",
                                "sense_id": "c19f8a7f-1852-391d-8910-7bb958cfd2a0",
                                "text": "Le LBD provoque des fractures, des hématomes et des contusions (pulmonaires, osseuses, cérébrales). Il arrache des joues et éborgne. Il a occasionné des comas de quelques jours à un mois."
                            },
                            {
                                "example_id": "48a87709-b5b3-4877-8a1f-c77accd25c76",
                                "sense_id": "c19f8a7f-1852-391d-8910-7bb958cfd2a0",
                                "text": "Il y a dans le documentaire cette phrase clé d’un flic, qui aurait pu être le titre du film : « On va tirer dans le tas, écartez-vous ! » On se sert désormais des LBD comme d’armes de dispersion, au mépris total des règles."
                            }
                        ]
                    }
