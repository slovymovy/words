            "senses": [
                {
                    "sense_id": "e5657737-08e0-3f93-9878-44812b24076f",
                    "sense_definition": "Forma wołacza liczby pojedynczej rzeczownika <w>Bóg</w>, używana w bezpośrednim zwrocie do Boga.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religious_address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wysłuchaj mojej modlitwy, <w>Boże</w>.",
                            "target_lang_translations": {
                                "ru": "Услышь мою молитву, <w>Боже</w>.",
                                "nl": "Verhoor mijn gebed, <w>God</w>.",
                                "en": "Hear my prayer, <w>God</w>.",
                                "de": "Erhöre mein Gebet, <w>Gott</w>.",
                                "fr": "Écoute ma prière, <w>mon Dieu</w>.",
                                "it": "Ascolta la mia preghiera, <w>o Dio</w>.",
                                "cs": "Vyslyš mou modlitbu, <w>Bože</w>.",
                                "tr": "Duamı işit, <w>Tanrım</w>.",
                                "es": "Escucha mi oración, <w>Dios</w> mío.",
                                "zh": "请聆听我的祈祷，<w>上帝</w>。"
                            }
                        },
                        {
                            "text": "Dziękuję Ci, <w>Boże</w>, za wszystkie otrzymane łaski.",
                            "target_lang_translations": {
                                "ru": "Благодарю Тебя, <w>Боже</w>, за все полученные милости.",
                                "nl": "Ik dank U, <w>God</w>, voor alle ontvangen genade.",
                                "en": "I thank You, <w>God</w>, for all the graces received.",
                                "de": "Ich danke Dir, <w>Gott</w>, für alle empfangenen Gnaden.",
                                "fr": "Je Te remercie, <w>mon Dieu</w>, pour toutes les grâces reçues.",
                                "it": "Ti ringrazio, <w>o Dio</w>, per tutte le grazie ricevute.",
                                "cs": "Děkuji Ti, <w>Bože</w>, za všechna přijatá požehnání.",
                                "tr": "Sana şükürler olsun <w>Tanrım</w>, aldığım tüm lütuflar için.",
                                "es": "Te doy gracias, <w>Dios</w>, por todas las gracias recibidas.",
                                "zh": "感谢你，<w>上帝</w>，赐予我的一切恩典。"
                            }
                        }
