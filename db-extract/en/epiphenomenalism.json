                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "72a8e9ac-5329-4e80-b91f-6016e7967751",
                        "entry_id": "660880ed-52d1-38f0-86ee-456f55eea6c5",
                        "tags": [
                            "plural"
                        ],
                        "form": "epiphenomenalisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "77d5dfb8-3f2c-366d-8e3f-92e5b651a9df",
                        "entry_id": "660880ed-52d1-38f0-86ee-456f55eea6c5",
                        "glosses": [
                            "The doctrine that mental states and processes are simply incidental effects of physiological events in the brain or nervous system and cannot themselves cause any effects in the material world."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4668e168-ecbd-403b-883e-9e69f9356c5c",
                                "sense_id": "77d5dfb8-3f2c-366d-8e3f-92e5b651a9df",
                                "text": "The textbook account of epiphenomenalism goes something like this. Although our thoughts, desires, and other mental states seem to affect what happens in the world, by bringing about changes in our behavior or subsequent mental states, this is only an appearance, cast off by the real physical sequence of cause and effect that underlies our mental life."
                            }
                        ]
                    },
                    {
                        "sense_id": "91181a23-2644-31c5-89fd-d6ca5314384d",
                        "entry_id": "660880ed-52d1-38f0-86ee-456f55eea6c5",
                        "glosses": [
                            "Such a doctrine, as advanced by a particular thinker or school of thought."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "d5b4d0f9-121f-4e8d-9b84-ae25082a7963",
                                "sense_id": "91181a23-2644-31c5-89fd-d6ca5314384d",
                                "text": "The theory of emergent evolution has been largely developed as a corrective of mechanistic theories with their attendant psycho-physical dualisms and epiphenomenalisms."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d34939b7-b6ad-4f0d-9808-6b37b5672202",
                        "source_entry_id": "660880ed-52d1-38f0-86ee-456f55eea6c5",
