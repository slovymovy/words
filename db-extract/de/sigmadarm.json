                ],
                "senses": [
                    {
                        "sense_id": "d11e105a-739a-365a-9386-79cfa7332420",
                        "entry_id": "5636b9b8-d3fe-347b-a877-c0febf36e1e8",
                        "glosses": [
                            "vierter und letzter Abschnitt des Dickdarms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbab36f0-0792-491e-8a32-aad0c4bfc92b",
                                "sense_id": "d11e105a-739a-365a-9386-79cfa7332420",
                                "text": "„Wir haben den linken Ureter durch Laparotomie in den Sigmadarm eingepflanzt.“"
                            },
                            {
                                "example_id": "d1eb4ab4-5be1-47cc-9a9f-19714a1d1636",
                                "sense_id": "d11e105a-739a-365a-9386-79cfa7332420",
                                "text": "„Der nächste Abschnitt, der Sigmadarm, schlängelt sich wie ein verdrehtes S in den linken Unterbauch.“"
                            },
                            {
                                "example_id": "9c3a8750-81ca-4620-95cc-3355ecd807a9",
                                "sense_id": "d11e105a-739a-365a-9386-79cfa7332420",
                                "text": "„Divertikelerkrankte wiesen ebenso eine Anhäufung der vernetzten Kollagene im Sigmadarm auf, allerdings in einem signifikant gesteigerten Maße im Vergleich zu den über 60-Jährigen ohne Divertikelnachweis.“"
                            },
                            {
                                "example_id": "8d7de318-83bd-4be8-8123-c16813784bde",
                                "sense_id": "d11e105a-739a-365a-9386-79cfa7332420",
                                "text": "„Nach Auflösung des Dünndarmkonglomerates zeigte sich eine ca. 10 mm große Perforationsstelle im mittleren Anteil des Sigmadarmes.“"
                            },
                            {
                                "example_id": "1d3a27be-f949-4b4f-b02e-ab0c2e82e500",
                                "sense_id": "d11e105a-739a-365a-9386-79cfa7332420",
                                "text": "„Üblicherweise treten Divertikel im Sigmadarm auf. So bezeichnen Ärzte den letzten, vor dem Mastdarm liegenden Abschnitt des Dickdarms.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
