{
    "word_family": [
        "fishpond",
        "millpond"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07a67ede-768f-3454-86a3-61bbe49ae875",
                    "sense_definition": "An inland body of standing water, either natural or man-made, that is smaller than a lake.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "water_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children love to feed the ducks at the village <w>pond</w>.",
                            "target_lang_translations": {
                                "ru": "Дети любят кормить уток на деревенском <w>пруду</w>.",
                                "zh": "孩子们喜欢在村里的<w>池塘</w>边喂鸭子。",
                                "cs": "Děti rády krmí kachny na vesnickém <w>rybníce</w>."
                            }
                        },
                        {
                            "text": "We dug a small <w>pond</w> in the garden to keep some fish.",
                            "target_lang_translations": {
                                "ru": "Мы выкопали в саду маленький <w>пруд</w>, чтобы разводить рыбу.",
                                "zh": "我们在花园里挖了一个小<w>池塘</w>来养鱼。",
                                "cs": "Na zahradě jsme vykopali malý <w>rybníček</w>, abychom mohli chovat ryby."
                            }
                        }
                    ],
                    "synonyms": [
                        "pool"
                    ],
                    "common_phrases": [
                        "garden pond",
                        "fish pond",
                        "duck pond"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой естественный или искусственный пресный водоем, меньше озера.",
                        "zh": "一种内陆的静止水体，可以是天然的或人工挖掘的，规模比湖泊小。",
                        "cs": "Vnitrozemská vodní plocha, přírodní nebo umělá, menší než jezero."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пруд",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "водоём",
                                "target_lang_sense_clarification": "общее название водного объекта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "池塘",
                                "target_lang_sense_clarification": "指小型的蓄水池或水坑"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rybník",
                                "target_lang_sense_clarification": "uměle vybudovaná vodní nádrž, často pro chov ryb"
                            },
                            {
                                "target_lang_word": "tůň",
                                "target_lang_sense_clarification": "přírodní prohlubeň s vodou"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "276e3879-76d2-33e2-a1e6-a97fb038cf32",
                    "sense_definition": "The Atlantic Ocean.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My brother moved across the <w>pond</w> to New York five years ago.",
                            "target_lang_translations": {
                                "ru": "Мой брат переехал за <w>океан</w>, в Нью-Йорк, пять лет назад.",
                                "zh": "我哥哥五年前搬到了<w>大洋</w>彼岸的纽约。",
                                "cs": "Můj bratr se před pěti lety přestěhoval za <w>Velkou louži</w> do New Yorku."
                            }
                        },
                        {
                            "text": "I wonder how our colleagues on the other side of the <w>pond</w> are handling the news.",
                            "target_lang_translations": {
                                "ru": "Интересно, как наши коллеги по ту сторону <w>океана</w> восприняли эту новость.",
                                "zh": "不知道我们在<w>大洋</w>彼岸的同事们是如何处理这个消息的。",
                                "cs": "Zajímalo by mě, jak se s tou zprávou vypořádávají naši kolegové na druhé straně <w>Velké louže</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "across the pond",
                        "this side of the pond"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "humorous or informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Атлантический океан (шутливое или разговорное название).",
                        "zh": "指大西洋（常用于非正式或幽默的语境中）。",
                        "cs": "Atlantický oceán (používá se v hovorovém nebo humorném smyslu)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "океан",
                                "target_lang_sense_clarification": "в идиомах типа «за океаном»"
                            },
                            {
                                "target_lang_word": "Атлантика",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大洋",
                                "target_lang_sense_clarification": "在跨洋语境下指代大西洋"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "Velká louže",
                                "target_lang_sense_clarification": "humorné označení pro Atlantik"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ce81ec8-1dd4-3701-933d-8fb89bda6fb3",
                    "sense_definition": "To collect or accumulate in a pool, often referring to water on a surface.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "water_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the heavy storm, water began to <w>pond</w> on the flat roof.",
                            "target_lang_translations": {
                                "ru": "После сильного шторма вода начала <w>скапливаться</w> на плоской крыше.",
                                "zh": "暴风雨过后，平屋顶上开始出现<w>积水</w>。",
                                "cs": "Po silné bouřce se na ploché střeše začala <w>stát</w> voda."
                            }
                        },
                        {
                            "text": "Poor drainage caused the rain to <w>pond</w> in the middle of the driveway.",
                            "target_lang_translations": {
                                "ru": "Из-за плохого дренажа дождевая вода стала <w>застаиваться</w> посреди подъездной дорожки.",
                                "zh": "排水不畅导致雨水在车道中间<w>积水</w>。",
                                "cs": "Kvůli špatnému odvodnění se dešťová voda <w>hromadila</w> uprostřed příjezdové cesty."
                            }
                        }
                    ],
                    "synonyms": [
                        "pool",
                        "accumulate"
                    ],
                    "antonyms": [
                        "drain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скапливаться, образуя лужи или заводи (о воде на поверхности).",
                        "zh": "指水在表面聚集或停滞，形成水洼。",
                        "cs": "Hromadit se nebo zůstávat na povrchu (o vodě)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скапливаться",
                                "target_lang_sense_clarification": "о воде"
                            },
                            {
                                "target_lang_word": "застаиваться",
                                "target_lang_sense_clarification": "образовывать лужи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "积水",
                                "target_lang_sense_clarification": "指水在某处停滞聚集"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "stát",
                                "target_lang_sense_clarification": "o vodě, která neodtéká"
                            },
                            {
                                "target_lang_word": "tvořit kaluže",
                                "target_lang_sense_clarification": "hromadit se v prohlubních"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b26128f4-c620-3177-a291-cc78d0b32398",
                    "sense_definition": "To think about something carefully; to ponder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat by the fire to <w>pond</w> the mysteries of the universe.",
                            "target_lang_translations": {
                                "ru": "Он сидел у огня, чтобы <w>обдумать</w> тайны вселенной.",
                                "zh": "他坐在火堆旁，<w>沉思</w>着宇宙的奥秘。",
                                "cs": "Seděl u ohně a <w>rozjímal</w> o záhadách vesmíru."
                            }
                        },
                        {
                            "text": "Allow me some time to <w>pond</w> your request before I answer.",
                            "target_lang_translations": {
                                "ru": "Дайте мне немного времени <w>обдумать</w> вашу просьбу, прежде чем я отвечу.",
                                "zh": "请给我一点时间<w>琢磨</w>一下你的请求，然后再回答你。",
                                "cs": "Dejte mi chvíli čas, abych si vaši žádost <w>promyslel</w>, než odpovím."
                            }
                        }
                    ],
                    "synonyms": [
                        "ponder",
                        "contemplate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно обдумывать что-либо; размышлять.",
                        "zh": "仔细思考某事；深思。",
                        "cs": "Pečlivě o něčem přemýšlet; rozjímat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдумывать",
                                "target_lang_sense_clarification": "размышлять"
                            },
                            {
                                "target_lang_word": "размышлять",
                                "target_lang_sense_clarification": "думать о чем-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉思",
                                "target_lang_sense_clarification": "指深入地思考"
                            },
                            {
                                "target_lang_word": "琢磨",
                                "target_lang_sense_clarification": "指反复思考"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rozjímat",
                                "target_lang_sense_clarification": "hluboce přemýšlet"
                            },
                            {
                                "target_lang_word": "přemítat",
                                "target_lang_sense_clarification": "dlouze a hloubavě uvažovat"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b025b8b1-5802-37d3-8f41-93864d07c4fd",
                    "sense_definition": "A surname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr <w>Pond</w> will see you in his office now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Понд</w> сейчас примет вас в своем кабинете.",
                                "zh": "<w>庞德</w>先生现在要在办公室见你。",
                                "cs": "Pan <w>Pond</w> vás nyní přijme ve své kanceláři."
                            }
                        },
                        {
                            "text": "I went to school with a girl named Emily <w>Pond</w>.",
                            "target_lang_translations": {
                                "ru": "Я учился в школе с девочкой по имени Эмили <w>Понд</w>.",
                                "zh": "我上学时有个同学叫艾米丽·<w>庞德</w>。",
                                "cs": "Chodila jsem do školy s dívkou jménem Emily <w>Pond</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。",
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Понд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "庞德",
                                "target_lang_sense_clarification": "常见的姓氏音译"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "Pond",
                                "target_lang_sense_clarification": "příjmení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}