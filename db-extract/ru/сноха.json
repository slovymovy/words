                            "prepositional"
                        ],
                        "form": "сно́хах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ff9d3ca-8d1c-3192-86c1-97dab296c5a5",
                        "entry_id": "cd6f3f97-79e3-34fa-a9b3-205bae4ee385",
                        "glosses": [
                            "жена сына по отношению к его отцу (свёкру) или матери (свекрови)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c0a2c93-8e90-4835-ad9c-cc8582cab919",
                                "sense_id": "2ff9d3ca-8d1c-3192-86c1-97dab296c5a5",
                                "text": "― Это сноха моя, меньшего сына жена, ― сказал Клочьев, ― муж-то у неё все больше по делам ездит, а она в доме хозяйствовать мне помогает."
                            },
                            {
                                "example_id": "01e20d2c-4fac-4e5c-9bee-ad4fbef56385",
                                "sense_id": "2ff9d3ca-8d1c-3192-86c1-97dab296c5a5",
                                "text": "Выше я сказал, что хозяйственный мужичок играет домашние свадьбы (или, точнее, женит сына, потому что дочь выдается, когда жених найдется) преимущественно к концу рождественского мясоеда. В этом деле им тоже руководит мудрость змия и твёрдая решимость не потерпеть ущерба в жизнестроительном обиходе. Своевременно приведенная в дом сноха родит, при таком расчёте, не раньше осени; следовательно всю летнюю страду она отбудет свободно."
                            },
                            {
                                "example_id": "02394f4a-8f29-45ae-848c-7b2ce3dc848c",
                                "sense_id": "2ff9d3ca-8d1c-3192-86c1-97dab296c5a5",
                                "text": "Она постоянно давала понять Валентине Андреевне, что ей хотелось бы видеть её своей снохой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84e81e67-5842-4db2-9915-b77b5b52e2ab",
                        "source_entry_id": "cd6f3f97-79e3-34fa-a9b3-205bae4ee385",
                        "source_sense_id": "2ff9d3ca-8d1c-3192-86c1-97dab296c5a5",
                        "target_lang_word": "daughter-in-law",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daughter-in-law",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76b3efcb-1bce-3120-a6c4-d33e209b8057",
                                        "entry_id": "bacc60e8-01ed-3d77-a903-1353ee0cbc22",
                                        "glosses": [
                                            "The wife of one's child."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b91ca37b-741f-4adf-a423-888cb2cd01ad",
                                                "sense_id": "76b3efcb-1bce-3120-a6c4-d33e209b8057",
                                                "text": "For I am come to ſet a man at variance* againſt his father, ⁊ the daughter againſt her mother, and the daughter in law againſt her mother in law."
                                            },
                                            {
                                                "example_id": "6c9efc53-0cd9-4546-a529-f24dbfa892b5",
                                                "sense_id": "76b3efcb-1bce-3120-a6c4-d33e209b8057",
                                                "text": "They discovered Weller had two daughters and a daughter-in-law in the same cemetery."
                                            },
                                            {
                                                "example_id": "cb788cf9-60ae-429b-9eb8-e77200a15a2f",
                                                "sense_id": "76b3efcb-1bce-3120-a6c4-d33e209b8057",
                                                "text": "And we can watch how that plays out as Trump attempts to get his daughter-in-law, Lara, into the U.S. Senate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9829ad07-38c6-4094-afea-c419b85086a1",
                        "source_entry_id": "cd6f3f97-79e3-34fa-a9b3-205bae4ee385",
                        "source_sense_id": "2ff9d3ca-8d1c-3192-86c1-97dab296c5a5",
                        "target_lang_word": "nuera",
