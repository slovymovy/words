                        {
                            "text": "The movie was full of morons and <w>simps</w> who couldn't solve a simple problem.",
                            "target_lang_translations": {
                                "ru": "Фильм был полон идиотов и <w>дурачков</w>, которые не могли решить простейшую задачу."
                            }
                        }
                    ],
                    "synonyms": [
