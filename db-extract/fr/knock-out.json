                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e66538d-ae5e-30ce-a164-c1eab1c9ead9",
                                        "entry_id": "6e29f0bc-638c-3549-aaa9-e12bdf8ad712",
                                        "glosses": [
