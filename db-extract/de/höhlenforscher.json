                "senses": [
                    {
                        "sense_id": "03620270-6e37-30fd-a05b-8c18b37eedf6",
                        "entry_id": "cc3806c0-edaa-3a3a-985d-31c632861678",
                        "glosses": [
                            "Wissenschaftler, der Höhlen erforscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c50a531c-6ef5-4258-886c-19f14efbba68",
                                "sense_id": "03620270-6e37-30fd-a05b-8c18b37eedf6",
                                "text": "„Insgesamt waren am Dienstag sieben erfahrene Höhlenforscher zum Kartografieren in die Grotte von Romy nahe der spanischen Grenze abgestiegen.“"
                            },
                            {
                                "example_id": "823fa4f5-0dcd-4ed5-adf6-ea4c23eae0fa",
                                "sense_id": "03620270-6e37-30fd-a05b-8c18b37eedf6",
                                "text": "Am Donnerstagmittag konnten Retter die Trage mit dem schwer verletzten Höhlenforscher an den Ausgang der Riesending-Schachthöhle im Berchtesgadener Land bringen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2805ecfc-8644-4e97-9810-d44d4fb671fa",
                        "source_entry_id": "cc3806c0-edaa-3a3a-985d-31c632861678",
                        "source_sense_id": "03620270-6e37-30fd-a05b-8c18b37eedf6",
                        "source_sense_description": "Wissenschaftler, der Höhlen erforscht",
                        "target_lang_word": "speleologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speleologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aff61543-aecd-341c-8ef0-68b90c5999a1",
                                        "entry_id": "0c1de8a1-f736-3a8f-8597-637fbb0c0eb2",
                                        "glosses": [
                                            "A person who studies or explores caves or studies the science of speleology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b79da63c-5a2d-47d6-b0b6-f21c5ab9c564",
                                                "sense_id": "aff61543-aecd-341c-8ef0-68b90c5999a1",
                                                "text": "Under this heading M. E. A. Martel, the distinguished speleologist or cave-explorer of Europe, whose researches have recently added considerably to our knowledge of the Adelsberg grotto, furnishes to La Nature an interesting account of the episode in the Lueg-Loch or Lur-Loch, near the Styrian capital, which so nearly resulted fatally to the seven members of the Höhlenforscher—Fasching, Fölzmann, Zweyer, Oswald, Maier, Kurz and Haidt—who, on the 28th of April, attempted the exploration of the lost passage of the Semriach."
                                            },
                                            {
                                                "example_id": "407087f5-2908-46ba-9503-70dc2ef5193b",
                                                "sense_id": "aff61543-aecd-341c-8ef0-68b90c5999a1",
                                                "text": "The first man known to have descended Gaping Gill is well known on the Continent as an expert cave-explorer or speleologist — to use the new term which he perhaps invented."
                                            },
                                            {
                                                "example_id": "b76f49ac-5823-4d54-ab14-0d55cc20a039",
                                                "sense_id": "aff61543-aecd-341c-8ef0-68b90c5999a1",
                                                "text": "The biography of Robert de joly, a famous French speleologist who spent his life exploring caves, revealed an experience in which he stumbled into some cave areas high in carbon dioxide (CO₂) and developed a severe headache lasting twenty-four hours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
