                        "form": "dem Rochus"
                    },
                    {
                        "form_id": "98b99c6b-1458-4044-86d3-6912edae214f",
                        "entry_id": "7125e7dc-a1cc-3dcb-bb57-f889959b1145",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Rochus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82e8e94f-882e-37de-85a6-01602fc2f7f9",
                        "entry_id": "7125e7dc-a1cc-3dcb-bb57-f889959b1145",
                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214af2f9-7876-4e9e-bb4a-b4ddc8874d8a",
                                "sense_id": "82e8e94f-882e-37de-85a6-01602fc2f7f9",
                                "text": "„Rochus Mang ist ein unwichtiges Individuum, das in diesem Büchlein keine Rolle spielen soll.“"
                            },
                            {
                                "example_id": "59fedf10-aaf8-41f6-965d-f41d03e8d7cb",
                                "sense_id": "82e8e94f-882e-37de-85a6-01602fc2f7f9",
                                "text": "„In der Reliquiensammlung Friedrichs von Sachsen wiederum befanden sich Partikel des heiligen Rochus, der zwar nicht zu den traditionellen Nothelfern gehörte, aber im ausgehenden 15. Jahrhundert als Schutzheiliger gegen die Pest immer beliebter wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "996b34e6-bdd6-390d-833d-33c1454091c5",
                        "entry_id": "7125e7dc-a1cc-3dcb-bb57-f889959b1145",
                        "glosses": [
                            "Ärger, Wut, Zorn"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9303890c-2705-4f54-9445-db61871662d5",
                                "sense_id": "996b34e6-bdd6-390d-833d-33c1454091c5",
                                "text": "Sie hätte ihn umbringen können, so einen Rochus hatte sie auf ihn."
                            },
                            {
                                "example_id": "aca817f8-fc58-4159-931b-baa3c6f97f24",
                                "sense_id": "996b34e6-bdd6-390d-833d-33c1454091c5",
                                "text": "„Auch Mama sollte sich das mal ankucken, aber sie hatte einen Rochus auf die ganze Eisenbahn, weil es noch so viel im Haus und im Garten zu tun gab, daß keine Zeit war für solchen Mumpitz, und dann wurde wieder mit den Türen geknallt, und der Hobbyraum blieb tagelang zugeschlossen, damit wir nichts an der Eisenbahn kaputtmachen konnten.“"
                            },
                            {
                                "example_id": "7a440441-f703-46bc-860f-4ad541995ea0",
                                "sense_id": "996b34e6-bdd6-390d-833d-33c1454091c5",
                                "text": "„Mein Rochus trieb mich zurück ins Brecht-Theater.“"
                            },
                            {
                                "example_id": "1b2ed2a3-e756-45a1-85de-f43bdfb79beb",
                                "sense_id": "996b34e6-bdd6-390d-833d-33c1454091c5",
                                "text": "„Dieser moralische Rochus gegen Wieland ändert sich in kenntnislose Gleichgültigkeit – man liest ihn nicht mehr.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e92eaacd-d739-3bba-883a-040b4178de35",
                        "entry_id": "7125e7dc-a1cc-3dcb-bb57-f889959b1145",
                        "glosses": [
                            "Tod"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "ed9fdf08-32ce-4034-bb2a-49593166e14b",
                                "sense_id": "e92eaacd-d739-3bba-883a-040b4178de35",
                                "text": "Wenn du nicht auf dich Acht gibst, holt dich der Rochus!"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aebd64f3-99ac-47bb-9eb1-20c21b546586",
                        "source_entry_id": "7125e7dc-a1cc-3dcb-bb57-f889959b1145",
                        "source_sense_id": "82e8e94f-882e-37de-85a6-01602fc2f7f9",
