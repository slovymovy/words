                    {
                        "translation_id": "d63ebea2-0418-4c79-8d07-b1b17a1558b5",
                        "source_entry_id": "823a4b9f-8dee-3981-96e0-e40a38482b19",
                        "source_sense_id": "11f0abff-ab33-3237-8f6a-f1fcbaeab41c",
                        "target_lang_word": "高祖母",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "高祖母",
