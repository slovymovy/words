                "senses": [
                    {
                        "sense_id": "25af218c-74f4-32a5-9bcd-4cd2516d22e7",
                        "entry_id": "3d689226-e2fc-3ae0-98fd-0d503738937c",
                        "glosses": [
                            "Prämie, die für den Sieg in einem Wettbewerb in Aussicht gestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15fca740-70ca-4379-be7b-8301c28da560",
                                "sense_id": "25af218c-74f4-32a5-9bcd-4cd2516d22e7",
                                "text": "„Immer wieder sind sie mit ihren Leistungen die Nummer 1 der Generali Österreich und feiern diesen Erfolg – für den sie eine Siegesprämie erhalten hatten – gemeinsamen bei einem sogenannten Teamday.“"
                            },
                            {
                                "example_id": "81240e8b-ef1b-4898-adfc-da41541780c7",
                                "sense_id": "25af218c-74f4-32a5-9bcd-4cd2516d22e7",
                                "text": "„Er wollte die Siegesprämie haben, und er hatte nebenbei noch auf sich selbst gewettet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
