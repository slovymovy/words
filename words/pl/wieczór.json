                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spotkanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W najbliższą sobotę organizujemy <w>wieczór</w> z grami planszowymi.",
                            "target_lang_translations": {
                                "en": "This coming Saturday we are organizing a board game <w>night</w>."
                            }
                        },
                        {
                            "text": "Zapraszam wszystkich na uroczysty <w>wieczór</w> poetycki w bibliotece.",
                            "target_lang_translations": {
                                "en": "I invite everyone to a ceremonial poetry <w>evening</w> at the library."
                            }
                        }
                    ],
                    "synonyms": [
                        "wieczornica"
                    ],
                    "common_phrases": [
                        "wieczór autorski",
                        "wieczór poetycki"
                    ],
                    "target_lang_definitions": {
