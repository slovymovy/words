{
    "word_family": [
        "mortification",
        "mortifyingly",
        "mortified"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc1697a0-3f3b-317b-9dcd-a03354ad2b39",
                    "sense_definition": "To cause someone to feel very embarrassed, ashamed, or humiliated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humiliate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His mother began to <w>mortify</w> him by showing his baby pictures to all of his friends.",
                            "target_lang_translations": {
                                "zh": "他母亲开始把他的婴儿照拿给他的所有朋友看，这让他感到非常<w>难堪</w>。"
                            }
                        },
                        {
                            "text": "She was deeply <w>mortified</w> when she realized that her microphone had been on the whole time.",
                            "target_lang_translations": {
                                "zh": "当她意识到麦克风一直开着时，感到极其<w>难堪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "humiliate",
                        "shame",
                        "demean"
                    ],
                    "antonyms": [
                        "dignify",
                        "honor"
                    ],
                    "common_phrases": [
                        "mortify someone",
                        "deeply mortified"
                    ],
                    "target_lang_definitions": {
                        "zh": "使人感到极度尴尬、羞愧或受屈辱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使难堪",
                                "target_lang_sense_clarification": "使某人感到极为尴尬或出丑"
                            },
                            {
                                "target_lang_word": "使羞辱",
                                "target_lang_sense_clarification": "使蒙受羞耻或感到屈辱"
                            },
                            {
                                "target_lang_word": "羞辱",
                                "target_lang_sense_clarification": "使受屈辱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2119c27-ca2c-3f17-8fd3-d7bd5275b44a",
                    "sense_definition": "To affect someone with vexation, annoyance, or chagrin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "humiliate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rude criticism served only to <w>mortify</w> the young writer after her first public reading.",
                            "target_lang_translations": {
                                "zh": "粗鲁的批评只让这位年轻作家在首次公开朗读后倍感<w>苦恼</w>。"
                            }
                        },
                        {
                            "text": "He seemed to enjoy <w>mortifying</w> his colleagues by pointing out their small mistakes during meetings.",
                            "target_lang_translations": {
                                "zh": "他似乎很乐于在会议中指出同事的细小错误来<w>使</w>他们<w>难堪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disconcert",
                        "discompose",
                        "perturb",
                        "vex"
                    ],
                    "target_lang_definitions": {
                        "zh": "使人感到懊恼、苦恼或沮丧不安。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使苦恼",
                                "target_lang_sense_clarification": "引起烦恼或内心沮丧"
                            },
                            {
                                "target_lang_word": "使懊恼",
                                "target_lang_sense_clarification": "使心烦意乱或感到悔恼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "701d6658-3424-32b4-a540-ff15f41c9254",
                    "sense_definition": "To discipline one's body or physical appetites through self-denial, fasting, or ascetic practices.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "asceticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk sought spiritual purity by choosing to <w>mortify</w> the flesh through strict fasting.",
                            "target_lang_translations": {
                                "zh": "僧侣选择通过严格的禁食来<w>克制</w>肉体欲望，以寻求心灵的纯洁。"
                            }
                        },
                        {
                            "text": "Medieval ascetics would often <w>mortify</w> their earthly desires with rigorous physical hardships.",
                            "target_lang_translations": {
                                "zh": "中世纪的苦修者经常用严酷的肉体磨难来<w>克制</w>世俗的欲望。"
                            }
                        }
                    ],
                    "synonyms": [
                        "macerate"
                    ],
                    "common_phrases": [
                        "mortify the flesh"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in religious or ascetic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "通过自我克制、禁食或苦行等方式克制肉体或欲望。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "克制",
                                "target_lang_sense_clarification": "压制身体欲望或情欲"
                            },
                            {
                                "target_lang_word": "苦修抑制",
                                "target_lang_sense_clarification": "通过苦行压抑肉体情欲"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82b00fd2-18a1-35dd-ba89-cd11ef8f4c3a",
                    "sense_definition": "To undergo necrosis or gangrene; to rot or decay.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the wound is left untreated, the injured flesh may begin to <w>mortify</w>.",
                            "target_lang_translations": {
                                "zh": "如果不及时处理伤口，受创的肌肉可能会开始<w>坏死</w>。"
                            }
                        },
                        {
                            "text": "The surgeon feared that the infected tissue would <w>mortify</w> before antibiotics could take effect.",
                            "target_lang_translations": {
                                "zh": "外科医生担心在抗生素起效前，感染的组织就会发生<w>坏死</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decay",
                        "fester",
                        "necrotize",
                        "putrefy",
                        "rot"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "largely historical or archaic medical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（组织等）坏死、坏疽或腐烂。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "坏死",
                                "target_lang_sense_clarification": "组织失去生机而枯死"
                            },
                            {
                                "target_lang_word": "坏疽",
                                "target_lang_sense_clarification": "组织受感染或缺血发生腐烂"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}