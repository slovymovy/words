                    {
                        "translation_id": "99740a93-5e34-45f8-ac1c-ed3498d2fdfe",
                        "source_entry_id": "dbda6181-1074-3c32-ba92-7b101603d156",
                        "source_sense_id": "a174171f-a4fc-3b15-a62d-d9c5cca03490",
