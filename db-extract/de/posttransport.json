                "senses": [
                    {
                        "sense_id": "f8468a10-68a5-3aa3-bfba-8e4f9ea0bda0",
                        "entry_id": "d241e005-02f9-3448-916e-a142855e5436",
                        "glosses": [
                            "Aktion, Postgut vom Absender zum Empfänger zu verbringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9305c9b-64d7-42c3-9208-b0c5f59bd2dc",
                                "sense_id": "f8468a10-68a5-3aa3-bfba-8e4f9ea0bda0",
                                "text": "„Not macht erfinderisch - das gilt auch für den Posttransport.“"
                            },
                            {
                                "example_id": "acbf568e-09ec-428b-9379-0218ff134206",
                                "sense_id": "f8468a10-68a5-3aa3-bfba-8e4f9ea0bda0",
                                "text": "„Eine der versiertesten und innovativsten Lösungen des Posttransportes ist seit jeher die Rohrpost, die im städtischen Bereich bis in die Gegenwart als sogenannte Hausrohrpost zum Einsatz kommt.“"
                            },
                            {
                                "example_id": "8a413a86-ff3f-495a-9f04-393e422e188a",
                                "sense_id": "f8468a10-68a5-3aa3-bfba-8e4f9ea0bda0",
                                "text": "„Sie sorgten für den Höhepunkt der Veranstaltung: den ersten von der Deutschen Reichspost genehmigten und damit amtlichen Posttransport mit Flugzeugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
