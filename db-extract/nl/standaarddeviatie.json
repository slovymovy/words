                        "examples": [
                            {
                                "example_id": "75078fc3-22fd-4e81-986d-d9f4c32a76ec",
                                "sense_id": "f04bd02b-8ceb-3219-95ff-493a8f8330c5",
                                "text": "De standaarddeviatie is een maat voor de spreiding van een dataset.",
                                "translation": "The standard deviation is a measure of the dispersion of a dataset.",
                                "english": "The standard deviation is a measure of the dispersion of a dataset."
                            },
                            {
                                "example_id": "c20916c0-8055-4739-8042-68b28c46691d",
                                "sense_id": "f04bd02b-8ceb-3219-95ff-493a8f8330c5",
                                "text": "Bij het analyseren van experimentele resultaten is het belangrijk om de standaarddeviatie te berekenen.",
                                "translation": "When analyzing experimental results, it is important to calculate the standard deviation.",
                                "english": "When analyzing experimental results, it is important to calculate the standard deviation."
                            },
                            {
                                "example_id": "6ad3342c-180d-4c47-b64f-9287124a6c00",
                                "sense_id": "f04bd02b-8ceb-3219-95ff-493a8f8330c5",
                                "text": "De standaarddeviatie wordt gebruikt om de variabiliteit in een dataset te beoordelen.",
                                "translation": "The standard deviation is used to assess the variability in a dataset.",
                                "english": "The standard deviation is used to assess the variability in a dataset."
                            }
                        ]
                    }
