                                        "glosses": [
                                            "Baum mit sich aufspaltendem Stamm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "905b6f12-df85-4be2-97b3-3d165d6eac3b",
                                                "sense_id": "cfc07236-8fcf-3c90-b437-71b87e8567a5",
                                                "text": "„Bei Jungbäumen sind Konkurrenztriebe, insbesondere Zwiesel bis 4–5 cm Durchmesser zu entfernen, über 4–5 cm sind diese einzukürzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
