                    "frequency": "Low",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dentiste a dû soigner plusieurs dents <w>gâtées</w> causées par un excès de sucre."
                        },
                        {
                            "text": "Il n'osait plus sourire à cause de ses dents <w>gâtées</w> par le tabac."
