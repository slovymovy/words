                    },
                    {
                        "translation_id": "d92309fa-47bf-4c67-8b56-aebb9a17746e",
                        "source_entry_id": "93a50f5b-40ab-30d3-bc9e-3f6f107a611a",
                        "source_sense_description": "синтез дочерней молекулы дезоксирибонуклеиновой кислоты на матрице родительской молекулы",
                        "target_lang_word": "réplication",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réplication",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c36395e-ad1a-362a-b872-6993e609784f",
                                        "entry_id": "8b2db852-6493-3159-a137-2ae7ee162658",
                                        "glosses": [
                                            "Duplication de l'ADN."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cca9ddd-9481-4f24-8726-fe46eaba71ce",
                                                "sense_id": "8c36395e-ad1a-362a-b872-6993e609784f",
                                                "text": "Un grand nombre de protéines interviennent dans le mécanisme moléculaire de la réplication de l’ADN formant un complexe enzymatique appelé réplisome."
                                            },
                                            {
                                                "example_id": "306aa09f-9de9-446e-bee5-fedbf1e50328",
                                                "sense_id": "8c36395e-ad1a-362a-b872-6993e609784f",
                                                "text": "L’ADN monocaténaire du phage pénètre dans la cellule par un processus qui associe étroitement la désencapsidation et la réplication."
                                            },
                                            {
                                                "example_id": "67d20e7c-20b8-4e1f-b676-0618e555dfc7",
                                                "sense_id": "8c36395e-ad1a-362a-b872-6993e609784f",
                                                "text": "Des erreurs lors de la réplication de l’ADN (mutations) ou des transferts de gènes s'accumulent à fréquence faible mais constante au cours du temps, ce qui augmente progressivement le polymorphisme au sein de chaque écotype."
                                            },
                                            {
                                                "example_id": "101bddfe-3e0e-4c68-9213-85b05652c64b",
                                                "sense_id": "8c36395e-ad1a-362a-b872-6993e609784f",
                                                "text": "Ces dimères de pyrimidines déforment localement la double hélice d’ADN, de telle façon qu’elle ne peut plus servir de matrice adéquate à la transcription ni à la réplication."
                                            },
                                            {
                                                "example_id": "5ec69207-c069-47e0-b606-54e2dd9c39d5",
                                                "sense_id": "8c36395e-ad1a-362a-b872-6993e609784f",
                                                "text": "Ces chercheurs ont réussi à élaborer deux nouvelles bases, baptisées X et Y, mais surtout à assurer leur maintien lors de la réplication de l’ADN in vivo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e4635a0-2f82-3ffb-8bf4-67fac04f4e14",
                                        "entry_id": "8b2db852-6493-3159-a137-2ae7ee162658",
                                        "glosses": [
                                            "Reproduction de données."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "732bf3a1-afad-4e09-9f12-ec9aaa006ee4",
                                                "sense_id": "7e4635a0-2f82-3ffb-8bf4-67fac04f4e14",
                                                "text": "En informatique, on parle de réplication de données si les mêmes données sont dupliquées sur plusieurs périphériques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
