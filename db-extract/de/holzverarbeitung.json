                "senses": [
                    {
                        "sense_id": "bee25cef-bfe7-336f-b106-f5381cbc596a",
                        "entry_id": "e1230f97-4945-38bc-a2d1-5af3b66173cd",
                        "glosses": [
                            "Verarbeitung von Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d1b0f6c-b435-4f4a-946e-f3d19742f59b",
                                "sense_id": "bee25cef-bfe7-336f-b106-f5381cbc596a",
                                "text": "„Frühzeitig entwickelte sich in den Städten Plauen, Oelsnitz und Reichenbach die Holzverarbeitung (Musikinstrumente) und die Textilindustrie, später dann auch die Maschinenindustrie.“"
                            },
                            {
                                "example_id": "3ed82957-e676-4d03-ab75-648deede908f",
                                "sense_id": "bee25cef-bfe7-336f-b106-f5381cbc596a",
                                "text": "„Holzfunde aus der eisenzeitlichen Siedlung von Glastonbury und aus der Hügelfestung von Breiddin vermitteln einen anschaulichen Eindruck vom hohen Stand der Holzverarbeitung, der andernorts auch durch Funde spezialisierter Werkzeuge wie Äxte, Beile, Meißel und Hohleisen bestätigt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
