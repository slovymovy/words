                        "sense_id": "96071d0f-e51a-3ebf-84da-572230b7c49a",
                        "entry_id": "056edf38-0f32-319d-8213-4ebbc97a0452",
                        "glosses": [
                            "Ancienne mesure de grains ou de liquides, d’une capacité différente selon les espèces et les lieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f01c69e-276d-4c8a-bcf5-17832ee01221",
                                "sense_id": "96071d0f-e51a-3ebf-84da-572230b7c49a",
                                "text": "Le setier de blé à Paris était de douze boisseaux et devait peser deux cent quarante livres. - Le setier de vin était de huit pintes."
                            },
                            {
                                "example_id": "ed98daac-2fe2-4d33-909a-16534021f977",
                                "sense_id": "96071d0f-e51a-3ebf-84da-572230b7c49a",
                                "text": "Le setier valait environ 0,54 litre pendant l’antiquité romaine."
                            },
                            {
                                "example_id": "8c3d547e-1505-4666-aeb5-e23c5abd8684",
                                "sense_id": "96071d0f-e51a-3ebf-84da-572230b7c49a",
                                "text": "Nous avions tous les deux la langue bien pendue. Elle me disait des injures ; et moi, pour un boisseau, j’en rendais un setier."
                            }
                        ]
                    }
                ],
