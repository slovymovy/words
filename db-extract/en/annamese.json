                        ],
                        "examples": [
                            {
                                "example_id": "60a1ccc8-5e5b-4015-99a8-e79464930b5b",
                                "sense_id": "26bafdf4-0a3f-38aa-823c-222028f73a14",
                                "text": "[…]These are bilingual dictionaries of major civilised languages which have technical literature and technical vocabulary. For example, German, French, Dutch, Spanish, Portuguese, Italian and Russian in the West and Arabic, Persian, Chinese and Japanese in the East. We have not ignored smaller languages like Finnish in Europe and Annamese in Asia."
                            }
