                                "target_senses": [
                                    {
                                        "sense_id": "b05e35c6-d1d3-3002-81d9-bb0320014c82",
                                        "entry_id": "8fca7343-4397-3e50-929e-ae57ef7978bf",
                                        "glosses": [
                                            "Chose ridicule, niaise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90e3377b-71de-4728-b0fd-ccd7cf789a57",
                                                "sense_id": "b05e35c6-d1d3-3002-81d9-bb0320014c82",
                                                "text": "Moi qui ne connaissais que les roucoulades de Tino Rossi et quelques chansons salaces où le père Dupanloup disputait la vedette aux couilles de mon grand-père, je trouvai sublime de chanter à trois voix des chansons de boy-scouts pour colonies de vacances ou des cucuteries allemandes très viriles où il était question de Wandervogel, de petites fleurs fidèles et de faire le tour du monde à pied sans arrêter de chanter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
