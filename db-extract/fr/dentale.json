                            {
                                "example_id": "5d2ebdb7-7d3f-478f-bacb-92e03fe54965",
                                "sense_id": "103e88d9-cd7a-3d77-ac7b-6d96b93f53e7",
                                "text": "D, T, N, L sont des dentales en français."
                            },
                            {
                                "example_id": "832d59bd-30fa-4e3f-8431-ecfcbdb5804a",
                                "sense_id": "103e88d9-cd7a-3d77-ac7b-6d96b93f53e7",
                                "text": "La voix était flexible, assez grave, appuyée sur les dentales, interrompue de temps en temps par un demi-rire qui tenait à l’expérience de la vie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40e0958f-072d-4997-bba7-9e1de3bbf37a",
