                "senses": [
                    {
                        "sense_id": "bc63b7c1-2e8e-3811-9289-bd1914833816",
                        "entry_id": "31ad8378-7ab9-3401-9e01-9e61c0722649",
                        "glosses": [
                            "Dent."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1524735c-0dd1-4984-821f-5ade91020dee",
                                "sense_id": "bc63b7c1-2e8e-3811-9289-bd1914833816",
                                "text": "Plus une ratiche, pas même un chicot !"
                            },
                            {
                                "example_id": "df384688-9444-4171-ad87-5507a93f8bec",
                                "sense_id": "bc63b7c1-2e8e-3811-9289-bd1914833816",
                                "text": "Au tour de Riri ! Le pauvre chéri a le nose qui explose, l’arcade gauche qui se disloque et les dernières ratiches qui s’effeuillent."
                            },
                            {
                                "example_id": "7695b5c5-b98d-422c-adea-29ca55e7d183",
                                "sense_id": "bc63b7c1-2e8e-3811-9289-bd1914833816",
                                "text": "L’autopsie. Pourquoi faire ? Tous les poulets et pandores du Calvados ont déjà identifié le Vieux Marlou à son étalage de ratiches."
                            },
                            {
                                "example_id": "20d052e8-32dc-43a9-96d2-6203da391b40",
                                "sense_id": "bc63b7c1-2e8e-3811-9289-bd1914833816",
                                "text": "Il t’a pété les ratiches…"
                            },
                            {
                                "example_id": "cdd33b42-1395-41a0-a38a-3d18e9b3698d",
                                "sense_id": "bc63b7c1-2e8e-3811-9289-bd1914833816",
                                "text": "« Je vais t’éclater les ratiches »"
                            },
                            {
                                "example_id": "da5deede-ec62-4961-8200-ff4e3debc37c",
                                "sense_id": "bc63b7c1-2e8e-3811-9289-bd1914833816",
                                "text": "\"Hé les gars, visez-moi un peu ces jolies petites dents nacrées, des ratiches aussi droites j'en n'ai vu que chez le marchand !\" - (Bob Zemeckis, traduit par Christophe Rosson, Retour vers le Futur III, 1990)."
                            }
                        ]
                    }
                ],
