                "senses": [
                    {
                        "sense_id": "0edb656d-91b0-38d3-83d5-9cdfbc0a14fb",
                        "entry_id": "2e177277-435f-32a6-8b4c-b9cca11cd3ab",
                        "glosses": [
                            "iemand die zich verkiesbaar gesteld heeft voor een politiek ambt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ca9795a-37b8-4864-948c-1a5dfb017b18",
                                "sense_id": "0edb656d-91b0-38d3-83d5-9cdfbc0a14fb",
                                "text": "De kiescommissie ziet in haar een goede kandidaat."
                            }
                        ]
                    },
                    {
                        "sense_id": "72a1b2ca-27f9-3d93-ad71-18bd2e726f9b",
                        "entry_id": "2e177277-435f-32a6-8b4c-b9cca11cd3ab",
                        "glosses": [
                            "iemand die zich beschikbaar geteld heeft voor een baan of functie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d94fe9c2-f191-4ad1-ba46-8ffdac6d6877",
                                "sense_id": "72a1b2ca-27f9-3d93-ad71-18bd2e726f9b",
                                "text": "Er waren erg veel kandidaten voor de positie."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1555b42-34a7-319a-aa82-ce63f356ca6b",
                        "entry_id": "2e177277-435f-32a6-8b4c-b9cca11cd3ab",
                        "glosses": [
                            "een deelnemer aan een spelshow"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "649b89fb-76d6-4cad-9e97-07b747cad81a",
                                "sense_id": "d1555b42-34a7-319a-aa82-ce63f356ca6b",
                                "text": "Kandidaat nummer twee gaf als eerste het juiste antwoord."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49e45422-f8f6-4ae7-9d1b-00031ed9414d",
                        "source_entry_id": "2e177277-435f-32a6-8b4c-b9cca11cd3ab",
                        "source_sense_id": "0edb656d-91b0-38d3-83d5-9cdfbc0a14fb",
                        "source_sense_description": "iemand die zich verkiesbaar gesteld heeft voor een politiek ambt",
                        "target_lang_word": "Kandidat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kandidat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                        "entry_id": "7649a930-5b3b-34f3-80a5-ce1d3c1c725d",
                                        "glosses": [
                                            "Person (oder auch Sache oder Umstand/Ort), die für etwas zur Auswahl steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0edc9a5a-1d73-40df-8ef0-bab6ce10e65f",
                                                "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                                "text": "Herr Müller war zuvor noch nie Kandidat in einer Spielshow."
                                            },
                                            {
                                                "example_id": "62dbc712-29ac-4245-ab70-0d785d04ba72",
                                                "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                                "text": "Die beiden Kandidaten für die Aushilfsstelle haben beide ausgezeichnete Referenzen vorgelegt."
                                            },
                                            {
                                                "example_id": "c03c404b-a749-42a6-98ce-f9d83f99d5e0",
                                                "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                                "text": "„Bevor er vom Examinator aufgerufen wurde, war er, mit dem Zylinder eines anderen Kandidaten auf dem Kopfe, durch die Korridore spaziert und hatte den Pedell erschreckt.“"
                                            },
                                            {
                                                "example_id": "84149497-d47d-4933-89eb-6ee2b4c62371",
                                                "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                                "text": "„Der Nubier war ein idealer Kandidat für die Liga gegen Imperialismus.“"
                                            },
                                            {
                                                "example_id": "837e8b69-ff6d-44da-94d0-a73ecd0cf000",
                                                "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                                "text": "„Aber ich war von Anfang an ein unsicherer Kandidat.“"
                                            },
                                            {
                                                "example_id": "bc4b95b1-7165-4e6f-a12d-143a9813efa3",
                                                "sense_id": "fb1452e2-cfbe-3a89-872f-4bbfcbd0faa0",
                                                "text": "Wir haben mehrere Kandidaten, die grundsätzlich als Impfstoff gegen diesen Virus geeignet wären. Die speziefische Eignung werden wir nun in verschiedenen Testreihen überprüfen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0ebe11f-5f6c-4f9f-8a8d-da8e81b3e6dd",
                        "source_entry_id": "2e177277-435f-32a6-8b4c-b9cca11cd3ab",
