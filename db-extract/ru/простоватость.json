                                "target_senses": [
                                    {
                                        "sense_id": "38a8de42-d21a-383a-ab40-5b53396d07d3",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "The state or quality of being simple",
                                            "The quality or state of being unmixed or uncompounded"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdd8e06a-36eb-4db5-813f-131107a32821",
                                                "sense_id": "38a8de42-d21a-383a-ab40-5b53396d07d3",
                                                "text": "the simplicity of metals or of earths"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6aba2e3-d5ae-3696-ab69-96c7daaed06d",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "The state or quality of being simple",
                                            "The quality or state of being not complex, or of consisting of few parts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2231a62d-a327-4a83-a737-7b44fbc9b177",
                                                "sense_id": "c6aba2e3-d5ae-3696-ab69-96c7daaed06d",
                                                "text": "the simplicity of a machine"
                                            },
                                            {
                                                "example_id": "d40ea879-3a5f-4f08-863e-331a2ca57129",
                                                "sense_id": "c6aba2e3-d5ae-3696-ab69-96c7daaed06d",
                                                "text": "2. Simplicity, with the least number of working parts, all readily visible and accessible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a1472f-1dfd-3867-ab5d-4d148ba4c302",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "The state or quality of being simple",
                                            "Lack of sharpness of mind; lack of ability to think using complex ideas; stupidity"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b0d43ca-cabf-30ba-a2bc-b61e6178db32",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "The state or quality of being simple",
                                            "Lack of artificial ornament, pretentious style, or luxury; plainness"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70974e6c-2f8a-4f3e-8778-b7db2ebe9a4f",
                                                "sense_id": "8b0d43ca-cabf-30ba-a2bc-b61e6178db32",
                                                "text": "simplicity of dress, of style, or of language"
                                            },
                                            {
                                                "example_id": "2b62ee5c-2664-42dd-949e-a576476c9d51",
                                                "sense_id": "8b0d43ca-cabf-30ba-a2bc-b61e6178db32",
                                                "text": "simplicity of diet"
                                            },
                                            {
                                                "example_id": "982b530f-2610-4c2a-beca-af88c49696c8",
                                                "sense_id": "8b0d43ca-cabf-30ba-a2bc-b61e6178db32",
                                                "text": "simplicity of life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea433ff0-ef03-3af0-bd73-bd5a2341b306",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "The state or quality of being simple",
                                            "Lack of subtlety or abstruseness; clarity"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c56e8733-6e46-447d-b602-c9377fcb55ff",
                                                "sense_id": "ea433ff0-ef03-3af0-bd73-bd5a2341b306",
                                                "text": "the simplicity of a doctrine"
                                            },
                                            {
                                                "example_id": "e0351695-3bfb-4ec0-8d50-6ee399e018af",
                                                "sense_id": "ea433ff0-ef03-3af0-bd73-bd5a2341b306",
                                                "text": "the simplicity of an explanation or a demonstration"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3b37591-091b-3173-9fbc-7bc6b9f05906",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "The state or quality of being simple",
                                            "Lack of complication; efficiency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0984aaec-e8f6-441d-8633-30c53a351ec8",
                                                "sense_id": "c3b37591-091b-3173-9fbc-7bc6b9f05906",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1885c144-8a26-3d95-809a-553d6fe9ff27",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "An act or instance of foolishness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871e979b-89d1-48df-b001-c4776d184321",
                                                "sense_id": "1885c144-8a26-3d95-809a-553d6fe9ff27",
                                                "text": "speaking of the great simplicity we commit, in leaving yong children under the government and charge of their fathers and parents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56f86c90-8b08-4ae7-a3da-400439236c24",
                        "source_entry_id": "3b8f3dbb-cebd-3389-b04b-6ad04d44efed",
                        "source_sense_id": "d5d217fe-dd14-3137-8526-9cfa82452778",
                        "target_lang_word": "stupidity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stupidity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "072a3d7d-6ff5-3a40-8566-124fc5662f87",
                                        "entry_id": "44f4e45f-b2b2-33e4-b4e7-8b7235bccdf0",
                                        "glosses": [
                                            "The property of being stupid."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de1f608d-64aa-4ebe-a084-c4cc0a076684",
                                                "sense_id": "072a3d7d-6ff5-3a40-8566-124fc5662f87",
                                                "text": "I suppose you can put it down to gross stupidity, but that's not much of an excuse."
                                            },
                                            {
                                                "example_id": "7326125d-66d4-486b-beed-5a78d23abb45",
                                                "sense_id": "072a3d7d-6ff5-3a40-8566-124fc5662f87",
                                                "text": "And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes. He said that if you wanted to do anything for them, you must rule them, not pamper them. Soft heartedness caused more harm than good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d548616e-b335-328e-b034-e4dcdeff84f5",
                                        "entry_id": "44f4e45f-b2b2-33e4-b4e7-8b7235bccdf0",
                                        "glosses": [
                                            "An act that is stupid."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "299ef560-36cd-4e25-8d1d-8b6d21083b4b",
                                                "sense_id": "d548616e-b335-328e-b034-e4dcdeff84f5",
                                                "text": "Jimmy's stupidity cost him his car."
                                            },
                                            {
                                                "example_id": "81d94253-4d45-4c29-a849-5474c3e9b753",
                                                "sense_id": "d548616e-b335-328e-b034-e4dcdeff84f5",
                                                "text": "8. They require that crass stupidities shall not be played upon the reader as “the craft of the woodsman, the delicate art of the forest,” by either the author or the people in the tale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
