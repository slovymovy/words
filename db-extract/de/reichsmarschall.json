                "senses": [
                    {
                        "sense_id": "4e3fb1ac-3a9c-31d6-b050-9ef77ffa2f97",
                        "entry_id": "0a980ea4-8372-33e2-bb3b-7b74fc3c2e15",
                        "glosses": [
                            "Oberster Dienstgrad eines Reiches, nur einem General oder Marschall vorbehalten, im Heiligen Römischen Reich der militärische Vertreter des Kaisers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f29174e-c90f-4a61-94c9-ff4757c4719e",
                                "sense_id": "4e3fb1ac-3a9c-31d6-b050-9ef77ffa2f97",
                                "text": "Der Rang eines Reichsmarschalls existiert in der Bundesrepublik Deutschland nicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "81f37ae3-b328-3d95-8dc2-a8ebdaf2ed3e",
                        "entry_id": "0a980ea4-8372-33e2-bb3b-7b74fc3c2e15",
                        "glosses": [
                            "Oberster Soldat eines Reiches, Träger des Dienstgrades eines Reichsmarschalls"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af2903a0-fb7c-40e9-a2c5-bb01e59e080c",
                                "sense_id": "81f37ae3-b328-3d95-8dc2-a8ebdaf2ed3e",
                                "text": "Der Reichsmarschall überlegte, ob er eine neue Front eröffnen sollte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24906e37-2fdd-40c4-8982-fd6a9176c00d",
                        "source_entry_id": "0a980ea4-8372-33e2-bb3b-7b74fc3c2e15",
                        "source_sense_id": "4e3fb1ac-3a9c-31d6-b050-9ef77ffa2f97",
