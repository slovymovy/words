                                "target_senses": [
                                    {
                                        "sense_id": "6f606b8e-8a45-3214-bfd6-f525695b9c5c",
                                        "entry_id": "4960ad40-5b31-305d-a3a7-43d76660c179",
                                        "glosses": [
                                            "To pillage, take or destroy all the goods of, by force (as in war); to raid, sack."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71114749-c88e-42df-aa3f-4751caff3949",
                                                "sense_id": "6f606b8e-8a45-3214-bfd6-f525695b9c5c",
                                                "text": "The mercenaries plundered the small town."
                                            },
                                            {
                                                "example_id": "77f73550-2945-4e84-858a-e736b4c6e0c6",
                                                "sense_id": "6f606b8e-8a45-3214-bfd6-f525695b9c5c",
                                                "text": "The shopkeeper was plundered of his possessions by the burglar."
                                            },
                                            {
                                                "example_id": "1050a08c-05dd-48c8-a012-c631d8eb24bb",
                                                "sense_id": "6f606b8e-8a45-3214-bfd6-f525695b9c5c",
                                                "text": "Now Azaēlos, the king of Syria, made war on the Israelites and their king Jehu, and ravaged the eastern parts of the country across the Jordan […] spreading fire everywhere and plundering everything and inflicting violence on all who fell into his hands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2dcb1e9-c5d5-347a-8339-a9d913f8cf2a",
                                        "entry_id": "4960ad40-5b31-305d-a3a7-43d76660c179",
                                        "glosses": [
                                            "To take (goods) by pillage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e75d006-ba72-45b4-8553-4717f0680e79",
                                                "sense_id": "b2dcb1e9-c5d5-347a-8339-a9d913f8cf2a",
                                                "text": "The mercenaries plundered all the goods they found."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a80702f0-8c6b-30ba-b962-ae798806e9e1",
                                        "entry_id": "4960ad40-5b31-305d-a3a7-43d76660c179",
                                        "glosses": [
                                            "To take by force or wrongfully; to commit robbery or looting, to raid."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1f962dd-3b69-401f-af10-09b0c8b07a14",
                                                "sense_id": "a80702f0-8c6b-30ba-b962-ae798806e9e1",
                                                "text": "“Now to plunder, mateys!” screamed a buccaneer, to cries of “Arrgh!” and “Aye!” all around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86d130c9-267e-341e-90a5-14496d7ec0d5",
                                        "entry_id": "4960ad40-5b31-305d-a3a7-43d76660c179",
                                        "glosses": [
                                            "To make extensive (over)use of, as if by plundering; to use or use up wrongfully."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ebc21fc-a789-4b49-9a4a-319cf94bb54a",
                                                "sense_id": "86d130c9-267e-341e-90a5-14496d7ec0d5",
                                                "text": "The miners plundered the jungle for its diamonds till it became a muddy waste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caf42d8a-b294-37cf-8994-cfe9e5be9dc7",
                                        "entry_id": "4960ad40-5b31-305d-a3a7-43d76660c179",
                                        "glosses": [
                                            "To take unexpectedly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66d2d262-dd1a-4a7f-86f4-059dd36d969a",
                                                "sense_id": "caf42d8a-b294-37cf-8994-cfe9e5be9dc7",
                                                "text": "The Serb teed up Steve Davis, who crossed low for Graziano Pellè to plunder his fifth league goal of the campaign."
                                            }
                                        ]
                                    }
                                ]
                            },
