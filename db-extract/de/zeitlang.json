                "senses": [
                    {
                        "sense_id": "ecbb58de-acc0-3031-b8cf-7d1dc146a400",
                        "entry_id": "b61489e1-eed9-33b1-b03a-e4363b57a4f4",
                        "glosses": [
                            "starkes Verlangen nach jemandem, der entfernt von einem ist; starkes Sehnen nach etwas, das man nicht hat; im Besonderen auch: Heimweh"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "75272da1-cf22-4976-98b5-af34725b6d6d",
                                "sense_id": "ecbb58de-acc0-3031-b8cf-7d1dc146a400",
                                "text": "Giselas Freund ist nun erst zwei Tage auf Dienstreise und schon hat sie Zeitlang nach ihm."
                            },
                            {
                                "example_id": "77966a4e-2ea9-46dc-a4bb-7532df108f9e",
                                "sense_id": "ecbb58de-acc0-3031-b8cf-7d1dc146a400",
                                "text": "Wenn Opa ans Meer fährt, kriegt er gleich Zeitlang nach den heimatlichen Bergen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2b0e8ce1-1d91-38c6-87fe-3ec5f9eaa7f2",
                        "entry_id": "b61489e1-eed9-33b1-b03a-e4363b57a4f4",
                        "glosses": [
                            "unbefriedigendes Unbeschäftigtsein; Langeweile"
                        ],
                        "tags": [
                            "bayrisch"
                        ],
                        "examples": [
                            {
                                "example_id": "f9cd888e-5b40-45e1-91bf-2a8d3a969320",
                                "sense_id": "2b0e8ce1-1d91-38c6-87fe-3ec5f9eaa7f2",
                                "text": "Die Jugend sitzt jeden Abend am Dorfbrunnen rum und hat Zeitlang."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
