                            }
                        },
                        {
                            "text": "The teacher asked the students to list every <w>prime</w> number between one and twenty.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил учеников перечислить все <w>простые</w> числа от одного до двадцати.",
