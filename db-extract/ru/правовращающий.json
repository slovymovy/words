                    {
                        "translation_id": "b229491d-056b-43da-bb75-ff0b2caa6fd4",
                        "source_entry_id": "77ffed78-35c6-39f1-96da-743c90b331ee",
                        "source_sense_id": "dd6b7bfc-b5b9-3a88-af98-31fd3f09b379",
                        "target_lang_word": "rechtsdrehend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rechtsdrehend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9099a53e-2a54-392e-a82b-2a76890ae8f6",
                                        "entry_id": "7567e22b-043a-3b7c-a7d7-e24f6b026de5",
                                        "glosses": [
                                            "im Uhrzeigersinn, in mathematisch negativer Drehrichtung, positivem Drehsinn drehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92df026c-3493-479b-b9f5-370879c3a98e",
                                                "sense_id": "9099a53e-2a54-392e-a82b-2a76890ae8f6",
                                                "text": "Es gibt rechtsdrehende Ventilatoren bei denen das Laufrad rückwärtsgekrümmt ist."
                                            },
                                            {
                                                "example_id": "40cd5d8e-ed20-4ed2-92d4-7a74cbe3dd5e",
                                                "sense_id": "9099a53e-2a54-392e-a82b-2a76890ae8f6",
                                                "text": "„Das Thema lässt sich auch noch auf Motoren ausweiten, die zwar rechtsdrehend konstruiert sind, sich aber im Betrieb nicht immer daran halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35755b11-7bc1-3d14-84c8-218f5e907a23",
                                        "entry_id": "7567e22b-043a-3b7c-a7d7-e24f6b026de5",
                                        "glosses": [
                                            "die Ebene des polarisierten Lichts in optisch aktiven Substanzen nach rechts drehend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f38e4d2f-8272-4ef1-9722-301bc96d2a8d",
                                                "sense_id": "35755b11-7bc1-3d14-84c8-218f5e907a23",
                                                "text": "Wird sie in wässriger Lösung mit polarisiertem Licht bestrahlt (Licht, dessen Wellen nur in einer einzigen Ebene schwingen), dreht die rechtsdrehende Milchsäure das Licht im Uhrzeigersinn. Dies wird mit \"+\" bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d21aeb31-883d-3ebf-9902-2a592888c714",
                                        "entry_id": "7567e22b-043a-3b7c-a7d7-e24f6b026de5",
                                        "glosses": [
                                            "Eigenschaft eines Gewindes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dfe48e8-de6a-456e-a89a-0c284047add7",
                                                "sense_id": "d21aeb31-883d-3ebf-9902-2a592888c714",
                                                "text": "Ein Rechtsgewinde bedeutet, das man rechtsdrehend, also im Uhrzeigersinn, die Schraube reindreht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
