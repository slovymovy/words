                            {
                                "target_lang_word": "карамельный",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "焦糖色",
                                "target_lang_sense_clarification": "形容词用法"
                            }
                        ]
