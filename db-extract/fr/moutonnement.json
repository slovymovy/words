                ],
                "senses": [
                    {
                        "sense_id": "53868fcf-76b6-39e3-a5cb-9cd82c9c3651",
                        "entry_id": "16a0b292-b541-3aed-8654-2f3b6c1c740b",
                        "glosses": [
                            "Action de la mer qui moutonne."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bb8b1b03-2a1f-32bf-afaa-a44279170f6d",
                        "entry_id": "16a0b292-b541-3aed-8654-2f3b6c1c740b",
                        "glosses": [
                            "Formation de nuées de l'aspect de la laine des moutons."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "66ae371c-b634-4e22-9a46-ce1213012f1b",
                                "sense_id": "bb8b1b03-2a1f-32bf-afaa-a44279170f6d",
                                "text": "Des dunes incolores, accumulées, pressées, houleuses, changeant de teintes à toutes les heures, subissant toutes les modifications de la lumière, mais immobiles et comme endormies en un rêve éternel, enserraient le ksar incolore, dont les innombrables petites coupoles continuaient leur moutonnement innombrable."
                            }
                        ]
                    },
                    {
                        "sense_id": "81a00548-62d3-36d1-a705-50b71b1b4643",
                        "entry_id": "16a0b292-b541-3aed-8654-2f3b6c1c740b",
                        "glosses": [
                            "Ondulations de la végétation évoquant la toison des moutons."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "31d34c39-c45f-4355-9bee-8898328d5eba",
                                "sense_id": "81a00548-62d3-36d1-a705-50b71b1b4643",
                                "text": "La pluie cessait par moments ; alors une buée d’eau se levait des bois, dont le moutonnement ondulait dans les lointains ; puis une déchirure livide s’ouvrait au flanc des nuages ; la pluie tombait en un ruissellement de cataracte, comme si toutes les eaux du ciel s’étaient ruées par cette ouverture."
                            },
                            {
                                "example_id": "169b48f4-66d0-442b-b9d7-9282da010d65",
                                "sense_id": "81a00548-62d3-36d1-a705-50b71b1b4643",
                                "text": "De l’autre côté de la clairière, les bois reprenaient, couvrant de leur moutonnement le versant de la colline et s’enfonçant dans un vallon profond, au-delà duquel, et jusqu’à l’horizon, la forêt se déployait, baignée dans les vapeurs bleues du matin."
                            },
                            {
                                "example_id": "a5d9b4d8-2c5a-4556-ae39-c3762b60f112",
                                "sense_id": "81a00548-62d3-36d1-a705-50b71b1b4643",
                                "text": "De l'autre côté du lac, la forêt se relevait en moutonnements gigantesques."
                            },
                            {
                                "example_id": "b5c3c74c-c905-4149-b77b-5400b091f14d",
                                "sense_id": "81a00548-62d3-36d1-a705-50b71b1b4643",
                                "text": "Ceux-là ont connu le moutonnement des blés le long des routes de Hongrie."
                            },
                            {
                                "example_id": "9854b221-fa89-4361-9b2d-efabe1fb1be1",
                                "sense_id": "81a00548-62d3-36d1-a705-50b71b1b4643",
                                "text": "Je regarde au-delà de la rivière. Le vieux clocher de Bonneuil émerge d’un moutonnement mouvant de blés mûrs."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d27a8c2-0b73-3b2e-ba48-529edd85402b",
                        "entry_id": "16a0b292-b541-3aed-8654-2f3b6c1c740b",
                        "glosses": [
                            "Ondulation de terrain."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bc877939-f0a6-480c-b353-4e1b6693dc97",
                                "sense_id": "2d27a8c2-0b73-3b2e-ba48-529edd85402b",
                                "text": "Le moutonnement, si caractéristique des roches et consécutif au passage du glacier, forme, suivant l'expression de M. Meyer [107], « le cadre des paysages morainiques »."
                            }
                        ]
                    }
