                                "target_senses": [
                                    {
                                        "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                        "entry_id": "c6dff810-1820-39ba-b23c-0a46281c6c42",
                                        "glosses": [
                                            "Imprecise but close to in quantity or amount."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5341b476-6ca4-40bf-b0da-076c367f0ea0",
                                                "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                                "text": "approximately 60 beats per minute"
                                            },
                                            {
                                                "example_id": "fa575429-4024-4e94-ab8c-5afef641dc7b",
                                                "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                                "text": "In every box of matches there are approximately 40 matchsticks."
                                            },
                                            {
                                                "example_id": "6fe7bf28-6dca-48f2-8d21-ef1fa2274a35",
                                                "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                                "text": "Per 100 g of chocolate there is approximately 11.6 g of saturated fat."
                                            },
                                            {
                                                "example_id": "54a62ec8-c059-4ff7-836e-2963bdb39751",
                                                "sense_id": "2c9a95ae-19c6-321a-b88a-50a20f35d486",
                                                "text": "Returning to our own epistemic situation, we do not know the sense in which quantum mechanics and relativity will be taken to be approximately true after their descriptive infelicities are addressed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99407bde-bd5b-4f54-835f-655bbb77d0bf",
                        "source_entry_id": "1cc5f8f7-4bbe-3aa3-972d-916bc851e2d9",
                        "source_sense_id": "f50395f8-aa0d-3bfe-a38e-476f2f264e97",
                        "source_sense_description": "nur einen kleinen Unterschied habend",
                        "target_lang_word": "approximatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "approximatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef674f14-e3a9-35f3-8b71-1a66f5f2a061",
                                        "entry_id": "e320b7ca-f1a6-3639-9f12-f237c010d2d0",
                                        "glosses": [
                                            "Qui est fait par approximation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac88be4d-f580-4f60-964b-a4e6cdf78975",
                                                "sense_id": "ef674f14-e3a9-35f3-8b71-1a66f5f2a061",
                                                "text": "Ma route pour y parvenir, me faisait passer entre les atolls de Nihiru et de Taenga, distants seulement de vingt milles, et dont la position marquée sur la carte était approximative."
                                            },
                                            {
                                                "example_id": "c2812907-ad95-489f-b582-220101c90f55",
                                                "sense_id": "ef674f14-e3a9-35f3-8b71-1a66f5f2a061",
                                                "text": "Calcul approximatif. — Estimation approximative."
                                            },
                                            {
                                                "example_id": "0914cf1c-91ac-458d-83a1-527463347a7f",
                                                "sense_id": "ef674f14-e3a9-35f3-8b71-1a66f5f2a061",
                                                "text": "État approximatif des dépenses, des dettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccb42634-967f-335b-97fd-a3102ffd6fe6",
                                        "entry_id": "e320b7ca-f1a6-3639-9f12-f237c010d2d0",
                                        "glosses": [
                                            "Qui n'est pas absolu ou exact."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8dbee7d-ab9a-452c-8ec2-382d5e454a88",
                                                "sense_id": "ccb42634-967f-335b-97fd-a3102ffd6fe6",
                                                "text": "Là, sur un charpoy, était recroquevillé un vieil homme décharné, vêtu d'un costume en coton d'une blancheur approximative, et enveloppé dans des châles et des razais [couvertures] élimés."
                                            },
                                            {
                                                "example_id": "a16c9a14-5bad-4a6e-920a-6ae1f70872fa",
                                                "sense_id": "ccb42634-967f-335b-97fd-a3102ffd6fe6",
                                                "text": "[…], j'ai entendu une voix féminine qui chantait d'une justesse plus qu’approximative, deux chansons d'une ringardise affligeante, à cent mille lieues de tes goûts musicaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43a266eb-7ea7-4277-9c66-08ce75625c27",
                        "source_entry_id": "1cc5f8f7-4bbe-3aa3-972d-916bc851e2d9",
                        "source_sense_id": "f50395f8-aa0d-3bfe-a38e-476f2f264e97",
                        "source_sense_description": "nur einen kleinen Unterschied habend",
                        "target_lang_word": "bijna",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bijna",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bf1d9641-0d3f-335b-b651-19d1a0b869bb",
                                        "entry_id": "9a7d9a33-feeb-37c3-b764-800417f3dbe3",
                                        "glosses": [
                                            "op zo'n manier dat het niet veel scheelt of iets is zo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b128ad75-1434-4c9e-b19e-e23c145c952b",
                                                "sense_id": "bf1d9641-0d3f-335b-b651-19d1a0b869bb",
                                                "text": "Hij had bijna genoeg geld om die auto te kopen."
                                            },
                                            {
                                                "example_id": "704bd80a-8555-445b-80df-97f967de17df",
                                                "sense_id": "bf1d9641-0d3f-335b-b651-19d1a0b869bb",
                                                "text": "Bijna voldoende betekent meestal helemaal gezakt."
                                            },
                                            {
                                                "example_id": "8511118d-810e-411a-9cb7-db4cc08d9689",
                                                "sense_id": "bf1d9641-0d3f-335b-b651-19d1a0b869bb",
                                                "text": "Zoals gebruikelijk in een woestijn was er ook hier heel weinig water beschikbaar waardoor ik af en toe een aantal kilometers van de trail af moest om water te vinden. Dankzij de Guthook App lukte me dit bijna altijd."
                                            },
                                            {
                                                "example_id": "901b0d42-1e99-40d2-b6f6-d97fb94f2f5f",
                                                "sense_id": "bf1d9641-0d3f-335b-b651-19d1a0b869bb",
                                                "text": "Er rijden steeds meer Chinese elektrische auto's op de Europese wegen en dat zullen er in de toekomst niet minder worden. Het afgelopen kwartaal verscheepte China bijna twee keer zo veel auto's naar Europa in vergelijking met een jaar eerder. Dit terwijl de EU afgelopen zomer invoerheffingen op Chinese auto's invoerde om de eigen auto-industrie te beschermen. Hoe weten Chinese automerken toch steeds meer terrein te winnen in Europa?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4abcf474-937d-4174-b760-3fc4f97d542e",
                        "source_entry_id": "1cc5f8f7-4bbe-3aa3-972d-916bc851e2d9",
                        "source_sense_id": "f50395f8-aa0d-3bfe-a38e-476f2f264e97",
