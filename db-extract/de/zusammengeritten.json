                ],
                "senses": [
                    {
                        "sense_id": "80e91585-3cc1-385a-a9ed-f3dd7359ccba",
                        "entry_id": "7478b572-c204-3ef3-8502-5c8581712b29",
                        "glosses": [
                            "verbraucht, vom Leben (besonders von harter Arbeit) abgenutzt oder abgearbeitet, erschöpft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31a04024-e6d8-4706-8062-7019e3879902",
                                "sense_id": "80e91585-3cc1-385a-a9ed-f3dd7359ccba",
                                "text": "[…], sein Feldbett und einige halb zusammengerittene Pferde sind alles, was er mitgenommen hat und mitnehmen wollte."
                            },
                            {
                                "example_id": "36049d13-cd22-430d-8800-499e5a30714f",
                                "sense_id": "80e91585-3cc1-385a-a9ed-f3dd7359ccba",
                                "text": "Der Inhalt der »zusammengerittenen Bettziechen« ist gerade gut genug auf den Mist."
                            },
                            {
                                "example_id": "33d8d1ba-80b0-491e-8402-522fcc480dda",
                                "sense_id": "80e91585-3cc1-385a-a9ed-f3dd7359ccba",
                                "text": "Der alte, von einem tollen Leben zusammengerittene Knabe war ganz aus Schönpflästerchen und Pappendeckel zusammengeflickt — aber wenn er den Mund aufthat und sang, da war ewige Jugend und die Quellen rauschten …"
                            },
                            {
                                "example_id": "8ae048b3-0873-4519-b2b3-13d4458c34ae",
                                "sense_id": "80e91585-3cc1-385a-a9ed-f3dd7359ccba",
                                "text": "Bei achtzig schnappt er ab, wie ein zusammengerittener Gaul."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1377fd99-e989-4b5a-9fe2-1574bf943caf",
                        "source_entry_id": "7478b572-c204-3ef3-8502-5c8581712b29",
                        "source_sense_id": "80e91585-3cc1-385a-a9ed-f3dd7359ccba",
                        "source_sense_description": "verbraucht, vom Leben (besonders von harter Arbeit) abgenutzt oder abgearbeitet, erschöpft",
