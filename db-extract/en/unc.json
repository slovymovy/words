                        "examples": []
                    },
                    {
                        "sense_id": "51c8dc2f-b046-332d-a0cf-1ae6de62c074",
                        "entry_id": "2c19b616-8434-36d4-a587-a013f9df105c",
                        "glosses": [
                            "An older male relative."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "4c2106a3-8d80-43e8-9763-8229275e48eb",
                                "sense_id": "51c8dc2f-b046-332d-a0cf-1ae6de62c074",
                                "text": "Then Pangborn would find him and ask him what he thought he was doing here. He would ask if Ace had a job. He didn't, and he couldn't even claim he had come back to visit his unc, because Pop had been in his junkshop when the place burned down."
                            }
                        ]
                    },
                    {
                        "sense_id": "4eaa191f-9d68-335f-91af-8e795462f7ba",
                        "entry_id": "2c19b616-8434-36d4-a587-a013f9df105c",
                        "glosses": [
                            "An older male relative.",
                            "Any older man, especially middle-aged."
                        ],
                        "tags": [
                            "Internet",
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6cb3696d-84bf-428d-a950-1ca9b7a594ef",
                                "sense_id": "4eaa191f-9d68-335f-91af-8e795462f7ba",
                                "text": "Yo, TikTok, we need to raise money for Unc."
                            },
                            {
                                "example_id": "f97eacc4-6c96-4848-bf38-c2c6e1a642da",
                                "sense_id": "4eaa191f-9d68-335f-91af-8e795462f7ba",
                                "text": "Now he’s thirty-three—so old, in streamer years, that his fans call him “unc.”"
                            }
                        ]
                    }
