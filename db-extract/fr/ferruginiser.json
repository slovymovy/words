                        "tags": [],
                        "examples": [
                            {
                                "example_id": "154815cf-7349-4733-83ea-4e97fc264dca",
                                "sense_id": "55a42040-3c38-36f0-89ae-b520a101f7b3",
                                "text": "Les pyroxènes sont profondément transformés : les larges fissures du premier réseau se sont ferruginisées en emprisonnant des paillettes de bowlingite, tandis que le second réseau de fissures n'a fait que ferruginiser le cristal."
                            },
                            {
                                "example_id": "b7dd1528-33c1-4ab8-b92f-fba2690c55d4",
                                "sense_id": "55a42040-3c38-36f0-89ae-b520a101f7b3",
                                "text": "Ces cavités ont tendance à se ferruginiser et deviennent dans ce cas rougeâtres."
                            }
                        ]
                    }
