                        "examples": [
                            {
                                "example_id": "31ec24a7-c73e-480d-aaa0-e8dd01b25209",
                                "sense_id": "cb5b2315-4b40-334f-971f-9bb227202943",
                                "text": "We moesten eerst door een rookwolk heen voordat we het café binnen konden gaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f54ee7f1-f7d3-49ac-92e9-ab1d31768c54",
                        "source_entry_id": "48eefb8c-7221-3298-9708-17b34f6c9e39",
                        "source_sense_id": "cb5b2315-4b40-334f-971f-9bb227202943",
                        "source_sense_description": "een wolk van rook",
                        "target_lang_word": "Rauchwolke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rauchwolke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cda5e203-2b0f-39b4-a7c6-257e14f7836d",
                                        "entry_id": "93505816-6b9b-3ddf-9556-84958ffe5528",
                                        "glosses": [
                                            "große, dichte Menge aus Rauch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2ffb051-785e-4bd7-aad4-66ff794bf76d",
                                                "sense_id": "cda5e203-2b0f-39b4-a7c6-257e14f7836d",
                                                "text": "„Sie konnten den trüben Nebel sehen, der über den Dächern der Stadt hing, und die Mückenschwärme, die sich wie Rauchwolken über den See zogen.“"
                                            },
                                            {
                                                "example_id": "ba7de676-9e63-4f93-a0fb-1d5d9dea10bf",
                                                "sense_id": "cda5e203-2b0f-39b4-a7c6-257e14f7836d",
                                                "text": "„Er hatte sich hinter seinen Tisch gesetzt, sah sie an, stieß Rauchwolken aus, schüttelte nur den Kopf.“"
                                            },
                                            {
                                                "example_id": "1c91c38f-ee3a-4fa1-b95f-af6eb0b252d6",
                                                "sense_id": "cda5e203-2b0f-39b4-a7c6-257e14f7836d",
                                                "text": "„Madam zündete die Zigarette an, inhalierte, blies eine Rauchwolke aus und lächelte, wohl wegen einer Erinnerung, die sie nicht teilen wollte.“"
                                            },
                                            {
                                                "example_id": "ef8b04e1-b5a9-4204-84bb-73e345ecc18e",
                                                "sense_id": "cda5e203-2b0f-39b4-a7c6-257e14f7836d",
                                                "text": "„Er blies wieder eine Rauchwolke.“"
                                            },
                                            {
                                                "example_id": "7fddf0ab-4f85-4176-9ca9-e579b6988c71",
                                                "sense_id": "cda5e203-2b0f-39b4-a7c6-257e14f7836d",
                                                "text": "„Reginald Black blies eine Rauchwolke von sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
