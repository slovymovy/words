                ],
                "senses": [
                    {
                        "sense_id": "41440c9f-0052-3c4f-ad3b-9ce00e7155e5",
                        "entry_id": "16fd37ed-6f48-39f9-95ea-8d3577709952",
                        "glosses": [
                            "Prinzip einer Vervielfältigung flächiger Muster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "263d9088-8718-4cd4-a9b9-8fdf1c5547ee",
                                "sense_id": "41440c9f-0052-3c4f-ad3b-9ce00e7155e5",
                                "text": "„Maschinenbauer setzen auf neue Drucktechniken und digitale Systeme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ab3b3f4d-8aa9-3429-9349-d0ab07fd3145",
                        "entry_id": "16fd37ed-6f48-39f9-95ea-8d3577709952",
                        "glosses": [
                            "Fertigkeit, die sich mit der Vervielfältigung flächiger Muster befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b32a6329-1c94-4cd9-bdb6-5968a9d4fb4b",
                                "sense_id": "ab3b3f4d-8aa9-3429-9349-d0ab07fd3145",
                                "text": "„Es war im Vergleich zu vorhergehenden Messgeräten relativ preisgünstig und man musste vor allem kein Studium der Drucktechnik absolviert haben, um es anwenden zu können.“"
                            },
                            {
                                "example_id": "705e5af0-99c7-4597-bb52-a84e98496e2c",
                                "sense_id": "ab3b3f4d-8aa9-3429-9349-d0ab07fd3145",
                                "text": "„Allein das Studium der Drucktechnik weist uns Druckern den Weg zum richtigen Aufzug und zur praktischen Anwendung.“"
                            },
                            {
                                "example_id": "9c029319-343f-4032-a752-850e83862158",
                                "sense_id": "ab3b3f4d-8aa9-3429-9349-d0ab07fd3145",
                                "text": "„Nachfolgend vermitteln wir Ihnen wichtige Begriffe aus der Drucktechnik, die Ihnen beim Gestalten Ihrer Technischen Berichte und beim Kontakt mit Copy- Shop, Computerladen, Druckerei sowie Zeitschriften- und Buchverlag helfen können.“"
                            },
                            {
                                "example_id": "0c81bbd2-cc72-407c-a35a-6935e19d018f",
                                "sense_id": "ab3b3f4d-8aa9-3429-9349-d0ab07fd3145",
                                "text": "„Die Drucktechnik wurde vor diesem Hintergrund als Mittel der Wissensakkumulation und allgemeinen Volksaufklärung gesehen.“"
                            },
                            {
                                "example_id": "eea1cc9c-1e38-4fc9-939d-6b8fe14fa2e6",
                                "sense_id": "ab3b3f4d-8aa9-3429-9349-d0ab07fd3145",
                                "text": "„Eine Voraussetzung dieser Segensfülle ist natürlich die Modernisierung der Drucktechnik mit all ihren schon zur Einführung in die Erzählprosa geschilderten buchhändlerischen Konsequenzen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
