                ],
                "senses": [
                    {
                        "sense_id": "1b140492-7fd5-3009-a78c-2452f91be4bd",
                        "entry_id": "fec3923f-b1b7-3e15-a4e1-eaaeba8713fe",
                        "glosses": [
                            "Fumée de cigarette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfbca770-408a-4efd-97a3-3a8bc0ec825d",
                                "sense_id": "1b140492-7fd5-3009-a78c-2452f91be4bd",
                                "text": "Er produzierte kunstvolle Kringel mit seinem Zigarettenrauch.",
                                "translation": "Il produisait des anneaux dignes d’un artiste avec la fumée de sa cigarette."
                            },
                            {
                                "example_id": "7262cf7d-3583-468b-b8ec-5b78166e6e21",
                                "sense_id": "1b140492-7fd5-3009-a78c-2452f91be4bd",
                                "text": "Für Zigarettenrauch ist zweifelsfrei nachgewiesen, dass er zur Entstehung allergischer Erkrankungen und Asthma beiträgt.",
                                "translation": "Pour la fumée de cigarette, il a sans aucun doute été prouvé qu’elle contribue à l’apparition de maladies allergiques et d’asthme."
                            },
                            {
                                "example_id": "f37f3082-d258-4e0d-af55-395cdf6662f5",
                                "sense_id": "1b140492-7fd5-3009-a78c-2452f91be4bd",
                                "text": "Er betrat den Raum, den der Gestank von kaltem Zigarettenrauch erfüllte, und musste zunächst husten.",
                                "translation": "Il est entré dans la pièce, remplie d'une puanteur de fumée de cigarette froide, et a d'abord dû tousser."
                            }
                        ]
                    }
                ],
