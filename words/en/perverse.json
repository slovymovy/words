    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dc449b4d-5052-3a27-987c-a9573b3b70bd",
                    "sense_definition": "Stubbornly doing something that is unacceptable or contrary to what is reasonable or expected.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a <w>perverse</w> pleasure in doing the complete opposite of what his parents advised."
                        },
                        {
                            "text": "She refused to admit her error out of pure, <w>perverse</w> obstinacy."
                        }
                    ],
                    "synonyms": [
                        "contrary",
                        "stubborn",
                        "wayward",
                        "intractable"
                    ],
                    "antonyms": [
                        "amenable",
                        "tractable"
                    ],
                    "common_phrases": [
                        "perverse pleasure",
                        "perverse delight"
                    ]
                },
                {
                    "sense_id": "cdbfdf08-f67b-3e17-ac3c-926bc3d09f4d",
                    "sense_definition": "Leading to an outcome contrary to what was intended or natural; contradictory.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "contrary_outcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new safety regulations unfortunately produced the <w>perverse</w> incentive to conceal minor accidents."
                        },
                        {
                            "text": "By some <w>perverse</w> logic, cutting funding to the schools was presented as an improvement."
                        }
                    ],
                    "synonyms": [
                        "contrary"
                    ],
                    "common_phrases": [
                        "perverse incentive",
                        "perverse effect",
                        "perverse logic"
                    ]
                },
                {
                    "sense_id": "2db38417-34e3-3d35-87d4-2bbc77c5d5d2",
                    "sense_definition": "Morally unacceptable or distorted; wicked or corrupt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral_deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel experiments showed a thoroughly <w>perverse</w> disregard for human dignity."
                        },
                        {
                            "text": "He developed a <w>perverse</w> fascination with the darker aspects of human suffering."
                        }
                    ],
                    "antonyms": [
                        "innocent"
                    ],
                    "common_phrases": [
                        "perverse nature"
                    ]
                },
                {
                    "sense_id": "8f7081f6-8a10-3483-9e6c-b6610b76e9dc",
                    "sense_definition": "Delivered against the weight of the evidence or against the direction of the judge.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The appellate judge overturned the ruling because the jury had delivered a completely <w>perverse</w> verdict."
                        },
                        {
                            "text": "Counsel argued that deciding in favour of the plaintiff was a <w>perverse</w> finding on the available evidence."
                        }
                    ],
                    "common_phrases": [
                        "perverse verdict"
                    ]
                },
                {
                    "sense_id": "bd1a9698-1e1b-354a-9055-9aa4c7b1cab7",
                    "sense_definition": "Turned aside or diverted away from the proper course or natural path.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient ditch was carved to redirect the <w>perverse</w> stream away from the village."
                        },
                        {
                            "text": "They had to navigate through a <w>perverse</w> path that wound endlessly through the marsh."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare physical sense meaning diverted or crooked"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b547962d-293a-322a-b7a2-fee541744b28",
                    "sense_definition": "A chiral opposite of an object; a mirror image with reversed handedness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Because the two geometric shapes cannot be superposed, one figure is considered the <w>perverse</w> of the other."
                        },
                        {
                            "text": "When reflected across the plane, the symmetrical crystal generates a <w>perverse</w> that cannot align with the original."
                        }
                    ]
                }
            ]
        },
        {
