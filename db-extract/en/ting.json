                    {
                        "sense_id": "9bd856c9-090e-3077-9e03-46479cf24c98",
                        "entry_id": "7f03f3c7-f254-3563-9244-64e82000a527",
                        "glosses": [
                            "Representing a high-pitched sharp sound like a small bell being struck."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a760b2b-9ae7-453a-9ccc-d961ec4cd069",
                                "sense_id": "9bd856c9-090e-3077-9e03-46479cf24c98",
                                "text": "Ting, ting, ting! went the bell again. Everybody sat down; the curtain shook, rose sufficiently high to display several pair of yellow boots paddling about, and there it remained."
                            },
                            {
                                "example_id": "b73bdb8d-7558-4541-8037-fa34ddf697d1",
                                "sense_id": "9bd856c9-090e-3077-9e03-46479cf24c98",
                                "text": "Lonnie shook the Sacajaweas from his hand and let them land noisily on the glass coffee table—ting ting ting—oblivious or indifferent or likely hostile to Ig so near to nap."
                            },
                            {
                                "example_id": "28e49377-d4c0-40fb-8f70-afe2fea0127d",
                                "sense_id": "9bd856c9-090e-3077-9e03-46479cf24c98",
                                "text": "“Aah, Miss Zoe!” proclaimed Raj, as she opened the door to his shop. The bell rang as she entered. TING."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
