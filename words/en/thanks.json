{
    "word_family": [
        "thank",
        "thankful",
        "thankfully",
        "thankless",
        "thanksgiving"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "daf13ae3-14ce-31af-8cbe-dad36e258765",
                    "sense_definition": "Used to express appreciation or gratitude.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "gratitude_exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Thanks</w> for helping me with my homework.",
                            "target_lang_translations": {
                                "ru": "<w>Спасибо</w> за помощь с домашним заданием.",
                                "zh": "<w>谢谢</w>你帮我做作业。"
                            }
                        },
                        {
                            "text": "Would you like some coffee? — No, <w>thanks</w>.",
                            "target_lang_translations": {
                                "ru": "Хотите кофе? — Нет, <w>спасибо</w>.",
                                "zh": "要喝点咖啡吗？——不用了，<w>谢谢</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thank you",
                        "cheers",
                        "much obliged"
                    ],
                    "common_phrases": [
                        "thanks a lot",
                        "many thanks",
                        "no thanks",
                        "thanks anyway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения признательности или благодарности.",
                        "zh": "用于表达感激或谢意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спасибо",
                                "target_lang_sense_clarification": "общеупотребительное выражение"
                            },
                            {
                                "target_lang_word": "благодарю",
                                "target_lang_sense_clarification": "более формальный вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谢谢",
                                "target_lang_sense_clarification": "最常用的表达方式"
                            },
                            {
                                "target_lang_word": "多谢",
                                "target_lang_sense_clarification": "较口语化的表达"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25a879e5-d3b9-345d-ab29-974631d8a08e",
                    "sense_definition": "An expression of appreciation or gratitude.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gratitude_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sent a card to express her <w>thanks</w> for the gift.",
                            "target_lang_translations": {
                                "ru": "Она отправила открытку, чтобы выразить свою <w>благодарность</w> за подарок.",
                                "zh": "她寄了一张卡片来表达她对礼物的<w>感谢</w>。"
                            }
                        },
                        {
                            "text": "We give <w>thanks</w> for the food we are about to eat.",
                            "target_lang_translations": {
                                "ru": "Мы возносим <w>благодарность</w> за еду, которую собираемся вкусить.",
                                "zh": "我们为即将享用的食物表达<w>谢意</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gratitude",
                        "appreciation"
                    ],
                    "common_phrases": [
                        "give thanks",
                        "vote of thanks",
                        "special thanks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение признательности или благодарности.",
                        "zh": "对某人所做之事表示感激或谢意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благодарность",
                                "target_lang_sense_clarification": "чувство или выражение признательности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感谢",
                                "target_lang_sense_clarification": "正式的感激之情"
                            },
                            {
                                "target_lang_word": "谢意",
                                "target_lang_sense_clarification": "表示感谢的心意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "168aaf74-75e5-3a6e-87df-80f337d832e4",
                    "sense_definition": "Plural form of <w>thank</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gratitude_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He whispered his <w>thanks</w> before leaving the room.",
                            "target_lang_translations": {
                                "ru": "Он прошептал слова <w>благодарности</w> перед тем, как выйти из комнаты.",
                                "zh": "他在离开房间前低声说了几句<w>感谢的话</w>。"
                            }
                        },
                        {
                            "text": "The heartfelt <w>thanks</w> of the team went to the coach.",
                            "target_lang_translations": {
                                "ru": "Искренняя <w>благодарность</w> команды была адресована тренеру.",
                                "zh": "全队向教练表达了衷心的<w>谢意</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова \"thank\" (слова благодарности).",
                        "zh": "表示感谢的话语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благодарность",
                                "target_lang_sense_clarification": "в русском языке обычно используется в единственном числе"
                            },
                            {
                                "target_lang_word": "слова благодарности",
                                "target_lang_sense_clarification": "фраза, соответствующая множественному числу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谢意",
                                "target_lang_sense_clarification": "表达出的感谢"
                            },
                            {
                                "target_lang_word": "感谢的话",
                                "target_lang_sense_clarification": "口头或书面表达的感谢"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "53e0c2d9-e1b7-3acb-8f4a-c2e40953a947",
                    "sense_definition": "Third-person singular simple present indicative of <w>thank</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She always <w>thanks</w> the bus driver when she gets off.",
                            "target_lang_translations": {
                                "ru": "Она всегда <w>благодарит</w> водителя автобуса, когда выходит.",
                                "zh": "她下车时总是会<w>感谢</w>公交车司机。"
                            }
                        },
                        {
                            "text": "He <w>thanks</w> his lucky stars that he wasn't injured.",
                            "target_lang_translations": {
                                "ru": "Он <w>благодарит</w> судьбу за то, что не пострадал.",
                                "zh": "他<w>感谢</w>上天保佑他没有受伤。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма глагола \"благодарить\" в 3-м лице единственного числа.",
                        "zh": "向某人表达谢意（动词的第三人称单数形式）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благодарит",
                                "target_lang_sense_clarification": "форма глагола"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感谢",
                                "target_lang_sense_clarification": "动词，表示致谢"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}