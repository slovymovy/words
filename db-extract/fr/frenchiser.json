                        "glosses": [
                            "Donner un caractère frenchie, français, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb171cb1-7c72-4e24-9f89-f22f47b440c1",
                                "sense_id": "9e5c3214-c954-3e21-9cc1-3d13a2819c0d",
                                "text": "En ce samedi estival d’avril, digne d’un mois de juillet en folie, elle est contrainte et forcée de demeurer enfermée dans le salon, le nez baissé sur les doigts des coquettes, à limer, soigner, remplir, colorer, décorer, gélifier, poncer, « frenchiser » les ongles de ces dames."
                            },
                            {
                                "example_id": "44cce332-0526-4c71-8b64-18e850ab0ec8",
                                "sense_id": "9e5c3214-c954-3e21-9cc1-3d13a2819c0d",
                                "text": "\"Frenchiser\" un PC Allemand?"
                            },
                            {
                                "example_id": "7d38cf9b-bdab-4e02-9b91-1b02345d7222",
                                "sense_id": "9e5c3214-c954-3e21-9cc1-3d13a2819c0d",
                                "text": "OPI a voulu se \"frenchiser\" un petit peu avec ce nom."
                            }
                        ]
                    }
