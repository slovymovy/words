                "senses": [
                    {
                        "sense_id": "73554f16-f333-382a-b2ba-ddeb53fc71fd",
                        "entry_id": "032ce3d8-9f08-34b6-aae3-58b6d1375d74",
                        "glosses": [
                            "wit materiaal afkomstig van de slagtanden van vooral de olifant"
                        ],
                        "tags": [
                            "materiaalkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "2d8441d0-0afa-48e3-8721-bb71629410ec",
                                "sense_id": "73554f16-f333-382a-b2ba-ddeb53fc71fd",
                                "text": "Zonder Oscars vermogen, verworven met mahonie en ivoor, had Ingeborg dus nooit de vrouw kunnen worden van een eenvoudige Noorse ingenieur, zelfs niet wanneer hij opgeleid was aan de Technische Hochschule in Dresden."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bf7e3dc-0122-33ec-9e0e-4e0719179479",
                        "entry_id": "032ce3d8-9f08-34b6-aae3-58b6d1375d74",
                        "glosses": [
                            "siervoorwerp dat is vervaardigd uit de slagtanden van de olifant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e449d335-624e-448a-a88e-f83a8ad3e8bf",
                                "sense_id": "3bf7e3dc-0122-33ec-9e0e-4e0719179479",
                                "text": "De mooiste ikoon is een 10e-eeuws, Constantinopolitaans ivoor uit de Macedonische renaissance (Staatliche Museen te Berlijn), waarvoor de snijder zich enigszins liet inspireren door klassieke figuren uit de gigantomachie."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7f6611d-28dd-3d4d-869d-044c7f93844a",
                        "entry_id": "032ce3d8-9f08-34b6-aae3-58b6d1375d74",
                        "glosses": [
                            "geen meervoud (RAL-kleur) tint geel met RAL-nummer 1014 (    )"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58229228-a114-4dcd-bbca-03237bebecb4",
                                "sense_id": "b7f6611d-28dd-3d4d-869d-044c7f93844a",
                                "text": "Kunt u die panelen ook leveren in ivoor?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4d10dbe-2070-4f0c-bb0b-3f7431e626f4",
                        "source_entry_id": "032ce3d8-9f08-34b6-aae3-58b6d1375d74",
                        "target_lang_word": "Elfenbein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elfenbein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c15c515a-364a-3760-b973-02a9ad37c73a",
                                        "entry_id": "880f2abf-a80e-3ef2-98b5-f319ef120bd0",
                                        "glosses": [
                                            "Material bestimmter Tierzähne und -knochen, hauptsächlich Stoßzähne von Elefanten, aber auch Zähne von Mammuts, Nilpferden, Wildschweinen, Walrossen, Pottwalen und Narwalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e14bca-c3a5-4fb3-827e-3e6ec3651964",
                                                "sense_id": "c15c515a-364a-3760-b973-02a9ad37c73a",
                                                "text": "Das wertvollste Elfenbein stammt vom Narwal und wurde früher mit Gold aufgewogen."
                                            },
                                            {
                                                "example_id": "816f8891-2932-40b9-968e-eb2c2713262e",
                                                "sense_id": "c15c515a-364a-3760-b973-02a9ad37c73a",
                                                "text": "„Die türkische Polizei hat einen mit Edelsteinen verzierten Dolch aus Elfenbein beschlagnahmt, der dem ehemaligen libyschen Machthaber Muammar al-Gaddafi gehört haben soll.“"
                                            },
                                            {
                                                "example_id": "7c86c4a1-769d-4d3f-8cc4-7735c234993a",
                                                "sense_id": "c15c515a-364a-3760-b973-02a9ad37c73a",
                                                "text": "„In der Mitte des Hofes erhebt sich ein Altar aus Lehm mit Köpfen aus Bronze und Elfenbein darauf und einem metallenen Leoparden.“"
                                            },
                                            {
                                                "example_id": "1479a1c9-a429-41d4-80f4-a51ed5abefb6",
                                                "sense_id": "c15c515a-364a-3760-b973-02a9ad37c73a",
                                                "text": "„Doch vor allem organisieren Leopolds Männer den Handel mit Elfenbein.“"
                                            },
                                            {
                                                "example_id": "93249134-7e72-44ff-b703-87c906ad7c1a",
                                                "sense_id": "c15c515a-364a-3760-b973-02a9ad37c73a",
                                                "text": "„Er herrschte über das benachbarte Shewa, besaß angeblich riesige Mengen von Elfenbein sowie andere unermessliche Schätze und strebte die Herrschaft über ganz Abessinien an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "123019ec-54cb-489b-879b-bd5798d56e70",
