                "senses": [
                    {
                        "sense_id": "6818fb97-234a-32bc-9918-1eacd72d4b27",
                        "entry_id": "c870a95d-de15-34a5-b4a4-667494b09e3e",
                        "glosses": [
                            "abfallender Verlauf des Daches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b270955a-ff3e-4767-8c76-8c1211b31ea5",
                                "sense_id": "6818fb97-234a-32bc-9918-1eacd72d4b27",
                                "text": "„In Volkers Zimmer sollten die Decke und die Dachschräge mit Brettern verschalt werden, aber die meisten Arbeiten im Haus blieben liegen, weil Papa schon genug damit zu tun hatte, die Autos zu reparieren.“"
                            },
                            {
                                "example_id": "b635c765-4007-4746-ac43-5107632b5842",
                                "sense_id": "6818fb97-234a-32bc-9918-1eacd72d4b27",
                                "text": "„In den ersten Tagen nahm sie uns mit auf den Dachboden, den sie ausräumte, mit Lichterketten dekorierte und in dem sie, nach mühseliger Säuberungsaktion, zwei Holzbetten unter den gegenüberliegenden Dachschrägen aufbaute.“"
                            },
                            {
                                "example_id": "e4784a5d-df5f-4442-ab01-39ae104df624",
                                "sense_id": "6818fb97-234a-32bc-9918-1eacd72d4b27",
                                "text": "„Sie zerrte Decke und Kissen in den Schrank unter der Dachschräge, machte ihn von innen zu und schlief dort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cb28f3f-ef2b-4675-82d4-9782259b87c7",
                        "source_entry_id": "c870a95d-de15-34a5-b4a4-667494b09e3e",
                        "source_sense_id": "6818fb97-234a-32bc-9918-1eacd72d4b27",
