                        "form": "die Brotkrumen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f42d71f-5ddd-38a8-aa79-49e8e803af73",
                        "entry_id": "9831b1ce-41aa-3e58-b312-94fcb15b157a",
                        "glosses": [
                            "kleine Stücke, Brocken von Brot"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "9273e7ed-3a4d-4ccd-b6c5-5ca76fcbe087",
                                "sense_id": "6f42d71f-5ddd-38a8-aa79-49e8e803af73",
                                "text": "Hänsel und Gretel verstreuten Brotkrumen, um ihren Rückweg zu finden."
                            },
                            {
                                "example_id": "3c132ee7-14f8-4ca7-bf55-1f71f9b29747",
                                "sense_id": "6f42d71f-5ddd-38a8-aa79-49e8e803af73",
                                "text": "„Israel warf ein paar Brotkrumen unter den Baum.“"
                            },
                            {
                                "example_id": "c4b18393-da40-482f-87d8-4bc0b3183e98",
                                "sense_id": "6f42d71f-5ddd-38a8-aa79-49e8e803af73",
                                "text": "„Sie bohrte eine Weile nachdenklich in der Nase, strich übers Haar, suchte nach Brotkrumen auf dem Küchentich, machte kleine Kügelchen, schnippte sie spielerisch mit dem Finger, zielte absichtlich gegen die Hand von Max Schulz.“"
                            },
                            {
                                "example_id": "504aae12-eda1-4518-8020-6a83b9aa999a",
                                "sense_id": "6f42d71f-5ddd-38a8-aa79-49e8e803af73",
                                "text": "„Alle Essenszubereitungen mussten außerhalb des Wagens stattfinden und niemand durfte im Wagen ein Sandwich essen, für den Fall, dass Brotkrumen hinunterfielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc0b4c9d-3171-4155-874b-f62c27139dd5",
                        "source_entry_id": "9831b1ce-41aa-3e58-b312-94fcb15b157a",
                        "source_sense_id": "6f42d71f-5ddd-38a8-aa79-49e8e803af73",
                        "source_sense_description": "meist Plural: kleine Stücke, Brocken von Brot",
                        "target_lang_word": "breadcrumb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breadcrumb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ecafce2-9af7-30f6-8074-56447b62499c",
                                        "entry_id": "a8cd224e-a71f-39ac-9b54-01e2dad71558",
                                        "glosses": [
                                            "A tiny piece of bread, either one that falls from bread as it is cut or eaten, or one made deliberately by crumbling bread."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cca23633-b340-38a9-b50c-d9b3483ac843",
                                        "entry_id": "a8cd224e-a71f-39ac-9b54-01e2dad71558",
                                        "glosses": [
                                            "A single link in a chain indicating the hierarchical location of a directory, web page or similar, used as a navigation aid."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b9af8c6-8e90-481f-95ae-3991aa732ead",
                                                "sense_id": "cca23633-b340-38a9-b50c-d9b3483ac843",
                                                "text": "Breadcrumbs usually look something like this: \"Home > About Us > Staff\" and are positioned near the top navigation. […] The words in the breadcrumbs are links to pages at higher levels of the website."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9d1a57e-d97a-3fc4-b31e-4bfac4a03193",
                                        "entry_id": "a8cd224e-a71f-39ac-9b54-01e2dad71558",
                                        "glosses": [
                                            "A fragment of data that serves to log the actions taken by a program, used in debugging."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c11a3e25-7258-4609-931c-9c40e5315078",
                                                "sense_id": "f9d1a57e-d97a-3fc4-b31e-4bfac4a03193",
                                                "text": "If you believe the system can merrily proceed despite an assertion failure, code the exception handler to log the error, leaving debugging breadcrumbs behind, and return."
                                            },
                                            {
                                                "example_id": "6fcb9a45-5dc3-4749-a5e6-9509b1545309",
                                                "sense_id": "f9d1a57e-d97a-3fc4-b31e-4bfac4a03193",
                                                "text": "[…] track metrics used to improve performance, or log a series of breadcrumbs to track an application's progress, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d61a462a-3a77-318b-92a0-3ece7066ad74",
                                        "entry_id": "a8cd224e-a71f-39ac-9b54-01e2dad71558",
                                        "glosses": [
                                            "One in a series of clues leading to a person or place."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "940ff93c-94d9-45bc-907b-089682dcd67f",
                                                "sense_id": "d61a462a-3a77-318b-92a0-3ece7066ad74",
                                                "text": "Before he died, James Halliday (Mark Rylance), the hermit-like, socially maladjusted tech genius who created The Oasis, hid an Easter egg somewhere in the circuitry, scattering bread crumbs that lead to its location. Find the egg, and the mogul’s fortune—along with total control of his digital fiefdom—is yours. It’s the ultimate capitalist scavenger hunt!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "breadcrumb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f01f7790-b56a-3095-bd33-8a1032d6a5a3",
                                        "entry_id": "93a41203-1c02-3d90-bebd-e6dab13a3d12",
                                        "glosses": [
                                            "To sprinkle breadcrumbs on to food, normally before cooking."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a574aaa6-9d33-4cc4-91b4-bbb0a3072534",
                                                "sense_id": "f01f7790-b56a-3095-bd33-8a1032d6a5a3",
                                                "text": "All this breadcrumbing finished, you can put the meat on a grid over a baking dish and leave it until you are ready to cook it."
                                            },
                                            {
                                                "example_id": "679c3cdd-d03e-41c1-ab73-1ceb2a16f16a",
                                                "sense_id": "f01f7790-b56a-3095-bd33-8a1032d6a5a3",
                                                "text": "Said chef then proceeds to cough slimy phlegm all over the veal before it is breadcrumbed."
                                            },
                                            {
                                                "example_id": "621837fa-468a-4cd6-81fc-e23fa005803a",
                                                "sense_id": "f01f7790-b56a-3095-bd33-8a1032d6a5a3",
                                                "text": "A Swede can't imagine a more summery food than breadcrumbed Baltic herring fillets stuffed with dill or parsley and soused in an oldfashioned vinegar"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f12377f-c06f-3518-bfef-c2e2ac074815",
                                        "entry_id": "93a41203-1c02-3d90-bebd-e6dab13a3d12",
                                        "glosses": [
                                            "To add navigational breadcrumbs to (a web page or user interface)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4499ccd-e616-4e5b-8146-4ca94953ac79",
                                                "sense_id": "6f12377f-c06f-3518-bfef-c2e2ac074815",
                                                "text": "Along those same lines, creating separate folders can enable you to use \"breadcrumbing,\" which is another navigation aid (discussed in the section \"Determining How to Organize the Information,\" later in this chapter)."
                                            },
                                            {
                                                "example_id": "171b307b-7f1f-4054-868a-c7b02ddc0a54",
                                                "sense_id": "6f12377f-c06f-3518-bfef-c2e2ac074815",
                                                "text": "One navigational technique—breadcrumbing—is like having a “You Are Here” store directory in each aisle."
                                            },
                                            {
                                                "example_id": "819f4c18-ed77-4c00-95dd-6250530c23a0",
                                                "sense_id": "6f12377f-c06f-3518-bfef-c2e2ac074815",
                                                "text": "The most striking change from previous versions of Windows is that Vista displays the path using a method called breadcrumbing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c99860f-c25e-372e-b028-9f3bdefeb897",
                                        "entry_id": "93a41203-1c02-3d90-bebd-e6dab13a3d12",
                                        "glosses": [
                                            "To use clues or enticements to lead someone in the desired direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f90abbd9-5d5a-42b4-b7ce-dd32945f81ea",
                                                "sense_id": "9c99860f-c25e-372e-b028-9f3bdefeb897",
                                                "text": "The process of breadcrumbing is the means by which a game writer can lead the player forward with a trail of clues, or the level designers can lead the player via more physical symbols."
                                            },
                                            {
                                                "example_id": "cf323645-5f37-4285-8915-370cf6b7ad43",
                                                "sense_id": "9c99860f-c25e-372e-b028-9f3bdefeb897",
                                                "text": "I consider where more landmarks are needed and other changes for better flow and breadcrumbing."
                                            },
                                            {
                                                "example_id": "8f77192d-4002-4b0b-b58c-6b8662f752f6",
                                                "sense_id": "9c99860f-c25e-372e-b028-9f3bdefeb897",
                                                "text": "An alternate reality game—ARG—is an interactive narrative that uses the real world as its media platform and uses storytelling “bread-crumbed” across several media to deliver a story that is altered and impacted in real time by the participants' ideas and actions (Dena, 2008; Denward & Waern, 2008; Werner, 2008)."
                                            },
                                            {
                                                "example_id": "d68e1903-fc51-4c2a-85e8-c60ba65dacce",
                                                "sense_id": "9c99860f-c25e-372e-b028-9f3bdefeb897",
                                                "text": "It was what had attracted me to her in the first place. \"You can say something,\" I said. \"I'm easy to talk to.\" She frowned. The last time we had a private talk, in her kitchen, she admitted to playing me for a fool, making me fall in love with her, and breadcrumbing my way to discovering a deadly necromantic artifact."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ea92d44-400b-4a9e-870a-9bf9f164f964",
                        "source_entry_id": "9831b1ce-41aa-3e58-b312-94fcb15b157a",
                        "source_sense_id": "6f42d71f-5ddd-38a8-aa79-49e8e803af73",
                        "source_sense_description": "meist Plural: kleine Stücke, Brocken von Brot",
                        "target_lang_word": "mie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "081e2181-58e7-3aa9-84cf-965c63c42d44",
                                        "entry_id": "5f487eae-4d8c-3344-b3b8-8b4f440b3951",
                                        "glosses": [
                                            "Miette, habituellement de pain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e44ca48a-8d53-326c-a902-8c5c769d813e",
                                        "entry_id": "5f487eae-4d8c-3344-b3b8-8b4f440b3951",
                                        "glosses": [
                                            "Partie molle qui est à l’intérieur du pain."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16493f1f-1490-4fdd-bd6d-34261e8c0d83",
                                                "sense_id": "e44ca48a-8d53-326c-a902-8c5c769d813e",
                                                "text": "Il ricana, occupé à modeler dans la mie de pain un petit caniche."
                                            },
                                            {
                                                "example_id": "91af4802-3487-49fd-8101-530e0cdf34a7",
                                                "sense_id": "e44ca48a-8d53-326c-a902-8c5c769d813e",
                                                "text": "Mais, je n’y ai pas trouvé, comme aux jours où tu partageais mon repas, la trace courbe de tes dents, qui rendait à ma bouche la mie aussi douce qu’un baiser, et c’est le cœur serré que je reprends les sentiers parsemés de pierres violettes."
                                            },
                                            {
                                                "example_id": "36b7eb99-b3b5-4d6a-b38d-2e001f590e33",
                                                "sense_id": "e44ca48a-8d53-326c-a902-8c5c769d813e",
                                                "text": "Roulée en boulettes, la mie devient un projectile de la famille des balles. Mâchée avec de la salive, elle acquiert des vertus conglomérantes. Un pantin de papier, fixé à une boulette par un fil, peut se coller au plafond et y exécuter les mouvements du pendu."
                                            },
                                            {
                                                "example_id": "0980d10e-c7ec-4488-a5b5-ada33b7548a3",
                                                "sense_id": "e44ca48a-8d53-326c-a902-8c5c769d813e",
                                                "text": "Le pain à mie compacte et bise, à la croûte épaisse couleur de couque, sent la farine honnête."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10a80b2b-f1d2-3e8e-84be-86f8e090a3ed",
                                        "entry_id": "eb84f84f-a579-3e5a-a2ef-ae8b12635701",
                                        "glosses": [
                                            "Forme affectueuse d’amie après ma, ta ou sa, avec déglutination de la voyelle initiale."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4605f7cf-3772-4ac5-9636-c03b4ef5b775",
                                                "sense_id": "10a80b2b-f1d2-3e8e-84be-86f8e090a3ed",
                                                "text": "Les yeux de ma mie versent de morbides pâmoisons, de câlines stupeurs !"
                                            },
                                            {
                                                "example_id": "55eb0a50-f80c-43b1-afe1-378c8d3ecfc7",
                                                "sense_id": "10a80b2b-f1d2-3e8e-84be-86f8e090a3ed",
                                                "text": "Dans une minute, tu hurleras, ma mie !…"
                                            },
                                            {
                                                "example_id": "b0a74b1a-41ee-4bb1-a17e-c2fe1512e4d6",
                                                "sense_id": "10a80b2b-f1d2-3e8e-84be-86f8e090a3ed",
                                                "text": "Jolie ma mie, je vas guerroyer à la croisade. De m’estre éloigné, jolie ma mie, me tient désolé jusqu’en bastaille."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97dd2840-2016-3cd1-b3b7-662ffe6b7ca5",
                                        "entry_id": "58083f92-01b9-3038-9760-f30fae4f1628",
                                        "glosses": [
                                            "Exprime la négation avec ne. Pas."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7de6e2ef-5c75-46c0-a38b-ac9b693c1a01",
                                                "sense_id": "97dd2840-2016-3cd1-b3b7-662ffe6b7ca5",
                                                "text": "Je n’entains mie che baragoin-là."
                                            },
                                            {
                                                "example_id": "891f8198-8d19-423a-a866-5a4174a8669b",
                                                "sense_id": "97dd2840-2016-3cd1-b3b7-662ffe6b7ca5",
                                                "text": "Il y en avait un qui était si petit qu’il n’était mie plus grand que le petit doigt ; on l’appela le Petit Poucet ; […]"
                                            },
                                            {
                                                "example_id": "254964c3-c2a2-4947-aaa3-f63fd001339b",
                                                "sense_id": "97dd2840-2016-3cd1-b3b7-662ffe6b7ca5",
                                                "text": "Je ne suis mie pressé, répondit l’autre, un peu refroidi par la présence d’un étranger."
                                            },
                                            {
                                                "example_id": "3bea18c7-9596-4042-b5bb-bbd8dcad25fb",
                                                "sense_id": "97dd2840-2016-3cd1-b3b7-662ffe6b7ca5",
                                                "text": "Et messieurs de l’Académie / Ne me le pardonneraient mie"
                                            },
                                            {
                                                "example_id": "7b86cc9d-c0fb-48fb-ab67-cc5606cb6a0d",
                                                "sense_id": "97dd2840-2016-3cd1-b3b7-662ffe6b7ca5",
                                                "text": "Je ne la voit mie, et pourtant je brûle pour elle"
                                            },
                                            {
                                                "example_id": "132e1139-83ab-437c-9511-5d82edacd77a",
                                                "sense_id": "97dd2840-2016-3cd1-b3b7-662ffe6b7ca5",
                                                "text": "Théorique et nerveux, il se faisait, comme beaucoup de gens, des idées fausses sur les punaises, et, glacé de dégoût, commença par les chercher sur lui ; n’en vit mie."
                                            },
                                            {
                                                "example_id": "7f6a71f7-7b45-4c7e-b6f8-121173c7ff9a",
                                                "sense_id": "97dd2840-2016-3cd1-b3b7-662ffe6b7ca5",
                                                "text": "De tous ces potins mondains, je me préoccupe mie"
                                            },
                                            {
                                                "example_id": "556792bb-90b2-4e06-917d-f3b82d80a258",
                                                "sense_id": "97dd2840-2016-3cd1-b3b7-662ffe6b7ca5",
                                                "text": "Brigitte savait tout cela et ne s'en souciait mie"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
