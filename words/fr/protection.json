                    "frequency": "VeryLow",
                    "semantic_group_id": "patronage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pape confia la <w>protection</w> de l'ordre à un cardinal particulièrement influent de la curie."
