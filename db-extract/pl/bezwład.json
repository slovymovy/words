                                        "examples": [
                                            {
                                                "example_id": "c59ff3e2-583a-4893-ba76-e7c731694b7c",
                                                "sense_id": "01c4612c-0479-380a-9892-e967c6a94ba6",
                                                "text": "Man konnte ihn nicht aus seiner Apathie befreien."
                                            },
                                            {
                                                "example_id": "1f46f682-8a69-49a9-9165-92d8f2bddde0",
                                                "sense_id": "01c4612c-0479-380a-9892-e967c6a94ba6",
                                                "text": "„Ihr Profil war von seltener Reinheit, und das Fehlen jeder Spur von Farbe gab ihrem Kopfe, darin Apathie der vorherrschende Zug war, etwas Marmornes.“"
                                            },
                                            {
                                                "example_id": "75625768-bee1-47b4-a13b-4f94a844d48e",
                                                "sense_id": "01c4612c-0479-380a-9892-e967c6a94ba6",
                                                "text": "„Die größte Apathie und die größte Kraftäußerung bildeten hier durch ihre Ungezwungenheit nur um so größere Kontraste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53fbb61a-fbcc-4b95-acee-bedcf574bc35",
                        "source_entry_id": "11596ffc-0f12-3aba-b0b4-c329555f994e",
                        "source_sense_id": "6129c758-d118-31c7-b344-2bdcdca52fd8",
                        "source_sense_description": "Unwille oder Unvermögen zur Tätigkeit: Apathie, Gleichgültigkeit, Trägheit",
                        "target_lang_word": "Gleichgültigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gleichgültigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c15feddc-2d9e-3d55-a63f-dd724debd799",
                                        "entry_id": "40cbdca2-661b-3733-9787-5e8d2d395bb9",
                                        "glosses": [
                                            "Mangel an Interesse, Indifferenz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86d1be7a-2bc5-4515-91c6-25d4d77ed5a0",
                                                "sense_id": "c15feddc-2d9e-3d55-a63f-dd724debd799",
                                                "text": "„Auch die Gleichgültigkeit des Vaters erstaunt mich nicht.“"
                                            },
                                            {
                                                "example_id": "33fc74d5-60ff-46ec-9ffc-e75421c261e9",
                                                "sense_id": "c15feddc-2d9e-3d55-a63f-dd724debd799",
                                                "text": "„Gleichgültigkeit hingegen, so Eigils Ansicht, war eine fürchterliche Eigenschaft.“"
                                            },
                                            {
                                                "example_id": "c4833e90-888d-4b44-aa78-8e2d75198528",
                                                "sense_id": "c15feddc-2d9e-3d55-a63f-dd724debd799",
                                                "text": "„Grenfeld war bemüht, Gleichgültigkeit vorzutäuschen.“"
                                            },
                                            {
                                                "example_id": "9d119e0f-d1e7-4d67-b74f-de4216e9c238",
                                                "sense_id": "c15feddc-2d9e-3d55-a63f-dd724debd799",
                                                "text": "„Ramin hat irgendwann damit angefangen, meine Gleichgültigkeit sportlich zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8cc546a-1468-42dc-b9b3-fbfa384e989e",
                        "source_entry_id": "11596ffc-0f12-3aba-b0b4-c329555f994e",
                        "source_sense_id": "6129c758-d118-31c7-b344-2bdcdca52fd8",
                        "source_sense_description": "Unwille oder Unvermögen zur Tätigkeit: Apathie, Gleichgültigkeit, Trägheit",
                        "target_lang_word": "Trägheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trägheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff2d1bc3-20bd-3aa5-931c-fc52cbda2706",
                                        "entry_id": "a49228d7-cecc-3082-931d-174ffef2a303",
                                        "glosses": [
                                            "das Trägesein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9e961cc-04bd-42b8-add1-5715ae8b14d9",
                                                "sense_id": "ff2d1bc3-20bd-3aa5-931c-fc52cbda2706",
                                                "text": "„Dann aber kommt Tag 8, und das Blatt wendet sich: Auffallen heißt es nun – und das um jeden Preis. Blöd nur, wenn man diesen Zeitpunkt aus lauter Trägheit verschläft.“"
                                            },
                                            {
                                                "example_id": "f9b7472f-6ad8-4f38-8273-8ac4247f0909",
                                                "sense_id": "ff2d1bc3-20bd-3aa5-931c-fc52cbda2706",
                                                "text": "„Zwischen ihr und den Straussens hatte sich nach der langen gemeinsamen Zeit eine Trägheit eingestellt, ja, fast schon Überdruss.“"
                                            },
                                            {
                                                "example_id": "c37a122d-3bb3-4fc3-82a9-337f4c63641e",
                                                "sense_id": "ff2d1bc3-20bd-3aa5-931c-fc52cbda2706",
                                                "text": "„Die schwarzen Notenköpfe verbeugten sich ironisch vor ihrer Trägheit in Form einer Pavane für eine tote Infantin und lösten sich auf.“"
                                            },
                                            {
                                                "example_id": "ae950613-6c72-45e4-bd85-baff68661e37",
                                                "sense_id": "ff2d1bc3-20bd-3aa5-931c-fc52cbda2706",
                                                "text": "„Und auch die Trägheit, die zur Erbschaft des Dienerstandes gehört, ist ihm inzwischen teilweise abhanden gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "841a5edd-6414-3153-8126-dcd67f7a1863",
                                        "entry_id": "a49228d7-cecc-3082-931d-174ffef2a303",
                                        "glosses": [
                                            "Bestreben von physikalischen Körpern, in ihrem Bewegungszustand zu verharren, solange keine äußeren Kräfte oder Drehmomente auf sie einwirken"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6931fdac-e54c-4a00-8690-225c4a1c021e",
                                                "sense_id": "841a5edd-6414-3153-8126-dcd67f7a1863",
                                                "text": "„Die Gravitation eines Systems ist proportional zu seiner Masse. Zugleich bestimmt seine Masse die Trägheit, mit der der Bewegungszustand des Systems als Ganzes auf Kräfte reagiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6b3a1cf-57de-41c1-8a85-c7d53a86d830",
                        "source_entry_id": "11596ffc-0f12-3aba-b0b4-c329555f994e",
