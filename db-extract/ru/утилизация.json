                        "target_lang_word": "Verwertung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwertung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a857577b-c0eb-327c-9e8d-6d1ab3a1b91f",
                                        "entry_id": "b3fd56a6-660d-3278-9b8f-28d76b4b6a83",
                                        "glosses": [
                                            "nutzbringende Verwendung, zum Beispiel eines Patents, einer Erfindung, einer Erfahrung oder von Kenntnissen, aber auch von Dingen wie zum Beispiel Biomasse, Müll oder Altpapier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bed81e35-f0a0-4da0-84e3-959a5fcca502",
                                                "sense_id": "a857577b-c0eb-327c-9e8d-6d1ab3a1b91f",
                                                "text": "Die Verwertung von Abfällen steht vor der Verbrennung und unwiederbringlichen Vernichtung."
                                            },
                                            {
                                                "example_id": "7e793880-cf5f-4f83-a4cf-6ba29062def5",
                                                "sense_id": "a857577b-c0eb-327c-9e8d-6d1ab3a1b91f",
                                                "text": "Die Urheber- und Leistungsschutzrechte schützen die Investitionen der Kreativen und der Kreativindustrie und sichern ihnen eine angemessene Beteiligung an der wirtschaftlichen Verwertung ihrer Fernseh- und Hörfunkprogramme durch Dritte."
                                            },
                                            {
                                                "example_id": "85d93335-ef1e-46bb-a356-67f6ce45105c",
                                                "sense_id": "a857577b-c0eb-327c-9e8d-6d1ab3a1b91f",
                                                "text": "Die Verwertung des Pfandrechts erfolgt durch Pfandverkauf nach Pfandreife (§ 1228 BGB)."
                                            },
                                            {
                                                "example_id": "cbf4f54c-1128-4400-8b6c-c827e6efdb63",
                                                "sense_id": "a857577b-c0eb-327c-9e8d-6d1ab3a1b91f",
                                                "text": "Eine Verwertung der im Rahmen des Praktikums gemachten Beobachtungen ist nur mit ausdrücklicher Zustimmung gestattet."
                                            },
                                            {
                                                "example_id": "28526967-7bc6-4738-87da-00c623ce8f0f",
                                                "sense_id": "a857577b-c0eb-327c-9e8d-6d1ab3a1b91f",
                                                "text": "Die Verwertung von Abfällen ist ökonomisch und ökologisch wichtig."
                                            },
                                            {
                                                "example_id": "a70660e5-9959-49b0-91c9-4ed10ce9d503",
                                                "sense_id": "a857577b-c0eb-327c-9e8d-6d1ab3a1b91f",
                                                "text": "Die Anforderungen an Sortierung, Verwertung und Entsorgung steigen ständig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
