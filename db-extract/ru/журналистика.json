                "senses": [
                    {
                        "sense_id": "df166707-db9a-3658-80e8-320f8e3bef28",
                        "entry_id": "3b68a3ec-0b76-39ba-a337-c160f2e98c24",
                        "glosses": [
                            "деятельность по сбору, обработке и распространению информации с помощью средств массовой коммуникации"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ae0aa0dc-e3bc-39f9-9b37-40e1749ae639",
                        "entry_id": "3b68a3ec-0b76-39ba-a337-c160f2e98c24",
                        "glosses": [
                            "сотрудничество в газетах, журналах, на радио, телевидении как один из видов литературной деятельности"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "991b7127-e19d-39f5-8c59-95c0fd45fdf5",
                        "entry_id": "3b68a3ec-0b76-39ba-a337-c160f2e98c24",
                        "glosses": [
                            "литература журналов и газет, теле- и радиопрограммы как результат такой деятельности"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83be12c9-1b78-4bce-81aa-8f0b8e706a86",
                        "source_entry_id": "3b68a3ec-0b76-39ba-a337-c160f2e98c24",
                        "source_sense_description": "деятельность по сбору, обработке и распространению информации с помощью средств массовой коммуникации",
                        "target_lang_word": "journalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "journalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3129ccc-0269-356c-8116-a0f2ddb3e03b",
                                        "entry_id": "73b753c1-2ea9-3b23-86af-c89694ca165d",
                                        "glosses": [
                                            "The aggregating, writing, editing, and presenting of news or news articles for widespread distribution, typically in electronic publications, broadcast news media, or printed newspapers or periodicals, for the purpose of informing the audience, relying on a style of writing characteristic for this purpose, consisting of direct presentation of facts or events and (depending on type) either with or without analysis or interpretation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65f5dc41-fd62-4403-afa7-876a8d160a7b",
                                                "sense_id": "a3129ccc-0269-356c-8116-a0f2ddb3e03b",
                                                "text": "Meronym: reporting (little to no analysis or interpretation)"
                                            },
                                            {
                                                "example_id": "51580afa-cf96-4f95-a655-906cb825ca75",
                                                "sense_id": "a3129ccc-0269-356c-8116-a0f2ddb3e03b",
                                                "text": "Myth #1—Journalism Is Dying. Journalism is not dying; it’s evolving. We’re witnessing the shift from the legacy media dominance to the endless possibilities offered by the digital age. A journalist is responsible for gathering and organizing material and distributing the finished (and verified) pieces through various formats and mediums, which used to be limited to television, radio, and print. Traditional media gatekeepers have been strict on who qualifies to do the reporting and what can be published. Now, the playing field is wide open, and the rules are rapidly changing. What remains consistent is the purpose of journalism, which the American Press Institute claims is “to provide citizens with the information they need to make the best possible decisions about their lives, their communities, their societies, and their governments.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "545049c6-f7fa-4d20-af41-a3a882cbfefd",
                        "source_entry_id": "3b68a3ec-0b76-39ba-a337-c160f2e98c24",
                        "source_sense_description": "деятельность по сбору, обработке и распространению информации с помощью средств массовой коммуникации",
                        "target_lang_word": "journalisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "journalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0889f713-920c-31e7-aa7a-978b1db6e475",
                                        "entry_id": "f6f0dcac-4c93-3c0c-ae7a-d479b344e2b4",
                                        "glosses": [
                                            "Profession de journaliste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2d26b38-e472-4812-8c36-66c8647c2e9d",
                                                "sense_id": "0889f713-920c-31e7-aa7a-978b1db6e475",
                                                "text": "Mais le journalisme est terriblement encombré. La lutte pour la vie y est terrible, surtout à Paris ; je connais des hommes de beaucoup de talent qui n’y trouvent même pas de quoi vivre. Par contre, j’avoue que des crétins y font fortune."
                                            },
                                            {
                                                "example_id": "5f50366b-90bf-43d1-9d2b-c44bed777876",
                                                "sense_id": "0889f713-920c-31e7-aa7a-978b1db6e475",
                                                "text": "À quoi servent les faits divers ? […]. En règle générale, à faire du très mauvais journalisme, caressant le lecteur dans ses pulsions malsaines quitte à pulvériser les lignes jaunes du métier : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76d45ca3-08a5-3c95-a573-0d3932e5b3b5",
                                        "entry_id": "f6f0dcac-4c93-3c0c-ae7a-d479b344e2b4",
                                        "glosses": [
                                            "Ensemble des journaux d’une ville ou d’un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1c09abe-5198-4731-bdbc-517570dcbbad",
                                                "sense_id": "76d45ca3-08a5-3c95-a573-0d3932e5b3b5",
                                                "text": "Le journalisme, qui porte avec la promptitude du rayonnement, en quelques heures et en petit volume, d’une extrémité d’un empire à l’autre, ne pouvait pas exister. La parole était livre, jamais page […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
