                "senses": [
                    {
                        "sense_id": "7e0bf867-70c2-3eaa-8659-0aed03c5318d",
                        "entry_id": "f5ce58d3-6a7f-355f-921c-8aa88208eced",
                        "glosses": [
                            "stelselmatig, ordelijk volgens een systeem opgezet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74cf872d-611f-48f9-9a8a-341cf58d0ffe",
                                "sense_id": "7e0bf867-70c2-3eaa-8659-0aed03c5318d",
                                "text": "Elke beweging herhaalde ik systematisch; ijsbijl, stap, ijsbijl, stap."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c816dcf5-23fb-4354-aa96-d91d51b24d85",
                        "source_entry_id": "f5ce58d3-6a7f-355f-921c-8aa88208eced",
                        "source_sense_id": "7e0bf867-70c2-3eaa-8659-0aed03c5318d",
                        "source_sense_description": "stelselmatig, ordelijk volgens een systeem opgezet",
                        "target_lang_word": "systematisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "systematisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6bd9350b-c417-3317-8ea6-9f5448f295aa",
                                        "entry_id": "69b68a4f-4f04-3c64-8969-eb870cde4bb3",
                                        "glosses": [
                                            "einem System oder einer Systematik folgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c991c6-959e-40b6-96bd-f58eaf37c10d",
                                                "sense_id": "6bd9350b-c417-3317-8ea6-9f5448f295aa",
                                                "text": "Ich werde mich systematisch von A bis Z durch alle Einträge des Wiktionary arbeiten und alle Rechtschreibfehler verbessern."
                                            },
                                            {
                                                "example_id": "ccd418f2-1bc8-40b1-91d3-f3f0ff91ca03",
                                                "sense_id": "6bd9350b-c417-3317-8ea6-9f5448f295aa",
                                                "text": "„Sie gehört zu den systematischsten Datenquellen zur öffentlichen Meinung über dieses Thema.“"
                                            },
                                            {
                                                "example_id": "0fbf8187-a274-43c4-a242-a7e4e331dd37",
                                                "sense_id": "6bd9350b-c417-3317-8ea6-9f5448f295aa",
                                                "text": "„In den wissenschaftlichen Unternehmungen Alexander von Humboldts kam der Besteigung hoher Berge eine zugleich systematische wie ästhetische Schlüsselstellung zu.“"
                                            },
                                            {
                                                "example_id": "9f9f3f91-c548-4689-9a2b-c039c8ad1615",
                                                "sense_id": "6bd9350b-c417-3317-8ea6-9f5448f295aa",
                                                "text": "„Der Streit um Bilder von Fototapeten hatte in den vergangenen Jahren zahlreiche Gerichte beschäftigt, insbesondere weil ein einzelner Fotograf systematisch gegen die Käufer besonders billig angebotener Fototapeten vorging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40fbe4c9-7029-4620-94a9-62d90cacd4e3",
                        "source_entry_id": "f5ce58d3-6a7f-355f-921c-8aa88208eced",
                        "source_sense_id": "7e0bf867-70c2-3eaa-8659-0aed03c5318d",
                        "source_sense_description": "stelselmatig, ordelijk volgens een systeem opgezet",
                        "target_lang_word": "systematic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "systematic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec9f91b0-2dff-3c8b-b91f-33695c1e33bf",
                                        "entry_id": "a234fcd0-b928-3adc-9841-b7d3e85cde4b",
                                        "glosses": [
                                            "Carried out according to a planned, ordered procedure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a64c630-1a90-396a-a02b-df431baaec34",
                                        "entry_id": "a234fcd0-b928-3adc-9841-b7d3e85cde4b",
                                        "glosses": [
                                            "Methodical; regular and orderly."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "552cde52-8142-491a-af32-61c4d44ddb70",
                                                "sense_id": "5a64c630-1a90-396a-a02b-df431baaec34",
                                                "text": "Particular note, in this period, should be made of the actions of Joseph Denman, commander of the Northern Division of the Squadron, who went on an absolutely ruthless and systematic campaign along the African coast, burning so-called \"slaving factories\" to the ground and openly daring anyone who objected to try and stop him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96d403bb-0ed3-3f8f-9e4a-efd164f7dd4f",
                                        "entry_id": "a234fcd0-b928-3adc-9841-b7d3e85cde4b",
                                        "glosses": [
                                            "Treating an object as a system or coherent whole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd34500f-4688-4099-80fe-0b58eb159ac4",
                                                "sense_id": "96d403bb-0ed3-3f8f-9e4a-efd164f7dd4f",
                                                "text": "the systematic study of religious beliefs"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "944d2aca-43cb-3a9d-b163-a4e3dd20397c",
                                        "entry_id": "a234fcd0-b928-3adc-9841-b7d3e85cde4b",
                                        "glosses": [
                                            "Of or relating to taxonomic classification."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ce3c817-5277-305c-b447-d069b51cb8d4",
                                        "entry_id": "a234fcd0-b928-3adc-9841-b7d3e85cde4b",
                                        "glosses": [
                                            "Of, relating to, or in accordance with generally recognized conventions for the naming of chemicals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7870936-00ca-3e48-bfec-21d28e3871b4",
                                        "entry_id": "a234fcd0-b928-3adc-9841-b7d3e85cde4b",
                                        "glosses": [
                                            "Of, relating to, or being a system."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd81a37f-13fb-4e98-b3dd-846a33fbb516",
                                                "sense_id": "f7870936-00ca-3e48-bfec-21d28e3871b4",
                                                "text": "But the systematic judgment is altogether unprofitable. Its author has not really his eye upon the professed object of his criticism at all, but upon something else, which he wants to prove by means of that object. […] As it is, all that he tells us is that he is no genuine critic, but a man with a system, an advocate."
                                            },
                                            {
                                                "example_id": "54c58ccc-b61a-4b14-bd71-903a8323e8e1",
                                                "sense_id": "f7870936-00ca-3e48-bfec-21d28e3871b4",
                                                "text": "And Paruta’s work also suggests that Venetians in the generation following the battle of Lepanto, although without altogether abandoning systematic views, were tending increasingly to look to history for their understanding of human affairs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "systematic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9348720c-1a29-3d73-b7d3-aa709e6a0e68",
                                        "entry_id": "c37fb3b0-0fa2-3a5c-984a-c552460ad5fe",
                                        "glosses": [
                                            "systematically"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b035a08-9f3c-49d9-902e-7f49a98661bc",
                                                "sense_id": "9348720c-1a29-3d73-b7d3-aa709e6a0e68",
                                                "text": "\"So soon as they've settled all our guns and ships, and smashed our railways, and done all the things they are doing over there, they will begin catching us systematic, picking the best and storing us in cages and things.\""
                                            },
                                            {
                                                "example_id": "c4eced87-3cd7-4851-a138-6c31dff7f474",
                                                "sense_id": "9348720c-1a29-3d73-b7d3-aa709e6a0e68",
                                                "text": "And say, when them Gogs started out to put a thing through they did it systematic and thorough."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
