                        "glosses": [
                            "van een stemgeluid dat het zacht, zwak, bang en piepend klinkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b54ce83c-30c3-425f-97cb-d6d5e9ad7c0e",
                                "sense_id": "6e0a3c47-a918-36bd-80e4-0acd677e7665",
                                "text": "‘Ja maar,’ zegt Jan-Willem, ‘dat geld is niet van mij.’ Zijn stem klinkt een beetje pieperig."
                            },
                            {
                                "example_id": "972bb10f-fc16-4a31-8698-92c2508cdf9b",
                                "sense_id": "6e0a3c47-a918-36bd-80e4-0acd677e7665",
                                "text": "‘Dat geldt voor adel,’ liet zich een fijn pieperig stemmetje hooren, ‘en mijn neef, Zijne Doorluchtigheid de Kardinaal Adriaan, zeide eens....’"
                            }
                        ]
                    }
