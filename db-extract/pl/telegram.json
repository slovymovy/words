                                        "glosses": [
                                            "krátké textové sdělení předávané původně telegraficky, později s využitím dalších komunikačních kanálů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e393592-b13e-4b1a-8cb6-1903abc28d1d",
                                                "sense_id": "49f50ed1-bbd0-3bcb-9ab8-cca6f1d38ebb",
                                                "text": "Když jsem dostal telegram, že mě doma zvolili za prezidenta, (…) byla to pro mne jen starost: starost s odjezdem, kdo má jet s sebou a tak."
                                            }
