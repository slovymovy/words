                                        "entry_id": "b8058759-90c8-3eaa-8c15-71b38fe3ac59",
                                        "glosses": [
                                            "Santa Claus; a figure derived from traditions surrounding the historical Saint Nicholas who is said to bring Christmas presents to children on Christmas Day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b881ce8a-e584-4883-bee0-9aac104ec8ee",
                                                "sense_id": "a851e1a6-a36f-381e-bae4-40239a09a6bb",
                                                "text": "No more passion play / On St. Nicholas avenue / I believe in St. Nicholas / It's a different type of Santa Claus"
                                            }
                                        ]
