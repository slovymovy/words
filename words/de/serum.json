            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29003b70-9631-3a86-b6fa-84a70aa9a63a",
                    "sense_definition": "hochkonzentriertes, meist leichtes und flüssiges Pflegeprodukt für die Haut",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kosmetik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tragen Sie das <w>Serum</w> vor der täglichen Feuchtigkeitscreme auf."
                        },
                        {
                            "text": "Sie verwendet jeden Abend ein feuchtigkeitsspendendes <w>Serum</w> für das Gesicht."
                        }
                    ],
                    "common_phrases": [
                        "Serum auftragen"
                    ]
                },
                {
                    "sense_id": "0737bfd4-66e2-3913-b2ed-270663e11fce",
                    "sense_definition": "wässriger, flüssiger Bestandteil des Blutes, der nach der Gerinnung übrig bleibt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Arzt lässt das <w>Serum</w> im Labor auf bestimmte Antikörper untersuchen."
                        },
                        {
                            "text": "Die Konzentration des Wirkstoffs konnte direkt im <w>Serum</w> nachgewiesen werden."
                        }
                    ],
                    "synonyms": [
                        "Blutserum"
                    ],
                    "common_phrases": [
                        "im Serum nachweisen"
                    ]
                },
                {
                    "sense_id": "7ab28085-5e02-37d9-82c2-1d9a95354f98",
                    "sense_definition": "medizinisches Präparat mit spezifischen Antikörpern zur passiven Immunisierung",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medizin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bei der passiven Impfung wird ein <w>Serum</w> mit schützenden Antikörpern injiziert."
                        },
                        {
                            "text": "Die Forscher entwickelten schnell ein neues <w>Serum</w> gegen die gefährliche Infektion."
                        }
                    ],
                    "synonyms": [
                        "Heilserum",
                        "Immunserum"
                    ],
                    "common_phrases": [
                        "ein Serum verabreichen"
                    ]
                },
                {
                    "sense_id": "07351fe9-3ca7-343a-a741-da87453475ae",
                    "sense_definition": "flüssiges Gegengift zur Behandlung von Vergiftungen, insbesondere nach Tierbissen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medizin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Schlangenbiss rettete ein wirksames <w>Serum</w> das Leben des Wanderers."
                        },
                        {
                            "text": "In der Notaufnahme wurde der Patient sofort mit einem speziellen <w>Serum</w> behandelt."
                        }
                    ],
                    "synonyms": [
