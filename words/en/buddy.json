{
    "word_family": [
        "bud",
        "buddy-buddy",
        "disbuddy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e844ac3d-2aab-355c-b14d-1d1089285e37",
                    "sense_definition": "A close friend or casual acquaintance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "friendship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They have been <w>buddies</w> since they were in school together.",
                            "target_lang_translations": {
                                "ru": "Они были <w>приятелями</w> еще со школы.",
                                "zh": "他们从上学时起就是<w>哥们儿</w>了。"
                            }
                        },
                        {
                            "text": "I am going to the cinema with an old <w>buddy</w> from college.",
                            "target_lang_translations": {
                                "ru": "Я иду в кино со своим <w>старым другом</w> по колледжу.",
                                "zh": "我要和大学时的老<w>朋友</w>去看电影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "friend",
                        "pal",
                        "mate",
                        "chum"
                    ],
                    "antonyms": [
                        "enemy",
                        "stranger"
                    ],
                    "common_phrases": [
                        "old buddy",
                        "best buddy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Близкий друг или хороший знакомый.",
                        "zh": "亲密的朋友或熟人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приятель",
                                "target_lang_sense_clarification": "близкий знакомый"
                            },
                            {
                                "target_lang_word": "дружище",
                                "target_lang_sense_clarification": "фамильярное обращение к другу"
                            },
                            {
                                "target_lang_word": "дружок",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное к друг"
                            },
                            {
                                "target_lang_word": "кореш",
                                "target_lang_sense_clarification": "сленг, очень близкий друг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "朋友",
                                "target_lang_sense_clarification": "泛指朋友"
                            },
                            {
                                "target_lang_word": "哥们儿",
                                "target_lang_sense_clarification": "口语，指男性好友"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2447f35-7f2e-3fe8-bfb8-00bf2ff59389",
                    "sense_definition": "A partner for a particular activity or a system where people help each other.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "partnership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should always have a drinking <w>buddy</w> to make sure you get home safely.",
                            "target_lang_translations": {
                                "ru": "Всегда стоит иметь <w>собутыльника</w>, чтобы быть уверенным, что доберешься домой в сохранности.",
                                "zh": "你应该总是有个一起喝酒的<w>搭档</w>，以确保能安全到家。"
                            }
                        },
                        {
                            "text": "The gym assigned me a workout <w>buddy</w> to help me stay motivated.",
                            "target_lang_translations": {
                                "ru": "В спортзале мне назначили <w>напарника</w> по тренировкам, чтобы помочь мне сохранять мотивацию.",
                                "zh": "健身房给我安排了一位健身<w>伙伴</w>来帮我保持动力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "partner",
                        "companion"
                    ],
                    "common_phrases": [
                        "drinking buddy",
                        "workout buddy",
                        "study buddy",
                        "buddy system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напарник для определенного занятия или системы взаимопомощи.",
                        "zh": "特定活动的搭档或互助系统中的伙伴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напарник",
                                "target_lang_sense_clarification": "партнер по деятельности"
                            },
                            {
                                "target_lang_word": "товарищ",
                                "target_lang_sense_clarification": "человек, с которым вместе занимаются чем-либо"
                            },
                            {
                                "target_lang_word": "коллега",
                                "target_lang_sense_clarification": "партнер по учебе или работе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搭档",
                                "target_lang_sense_clarification": "共同完成某项任务的伙伴"
                            },
                            {
                                "target_lang_word": "伙伴",
                                "target_lang_sense_clarification": "共同参与某项活动的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aec1b12a-9ee8-31f0-b96a-d8b47336b432",
                    "sense_definition": "An informal way to address a stranger, often a man.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey, <w>buddy</w>, I think you dropped your wallet back there.",
                            "target_lang_translations": {
                                "ru": "Эй, <w>приятель</w>, кажется, ты выронил кошелек вон там.",
                                "zh": "嘿，<w>伙计</w>，我想你刚才把钱包掉在那儿了。"
                            }
                        },
                        {
                            "text": "Listen, <w>buddy</w>, you cannot park your car in this spot.",
                            "target_lang_translations": {
                                "ru": "Послушай, <w>друг</w>, здесь нельзя парковать машину.",
                                "zh": "听着，<w>伙计</w>，你不能把车停在这个位置。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mate",
                        "pal",
                        "friend"
                    ],
                    "common_phrases": [
                        "hey buddy",
                        "listen buddy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "can be friendly or slightly aggressive depending on tone"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальное обращение к незнакомцу, обычно к мужчине.",
                        "zh": "对陌生人的非正式称呼，通常指男性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приятель",
                                "target_lang_sense_clarification": "фамильярное обращение к незнакомцу"
                            },
                            {
                                "target_lang_word": "друг",
                                "target_lang_sense_clarification": "разговорное обращение"
                            },
                            {
                                "target_lang_word": "парень",
                                "target_lang_sense_clarification": "обращение к молодому человеку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伙计",
                                "target_lang_sense_clarification": "非正式的男性称呼"
                            },
                            {
                                "target_lang_word": "朋友",
                                "target_lang_sense_clarification": "口语中对陌生人的客套称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b5eb0c70-e3fd-3b16-991a-7d15b18cc351",
                    "sense_definition": "To assign a partner or mentor to someone, especially in a work or school environment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "partnership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new employees are being <w>buddied</w> up with experienced staff members.",
                            "target_lang_translations": {
                                "ru": "К новым сотрудникам <w>прикрепляют</w> опытных работников.",
                                "zh": "新员工正被<w>配对</w>给有经验的老员工。"
                            }
                        },
                        {
                            "text": "If you are being formally <w>buddied</w>, you should chat with your partner about your goals.",
                            "target_lang_translations": {
                                "ru": "Если вам официально <w>назначили напарника</w>, вам стоит обсудить с ним ваши цели.",
                                "zh": "如果你被正式<w>配对</w>了，你应该和你的搭档聊聊你们的目标。"
                            }
                        }
                    ],
                    "synonyms": [
                        "partner",
                        "pair"
                    ],
                    "common_phrases": [
                        "buddy up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in professional or educational contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Назначать напарника или наставника кому-либо, особенно на работе или в учебе.",
                        "zh": "为某人指派搭档或导师，常见于工作或学习环境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикреплять",
                                "target_lang_sense_clarification": "назначать наставника или партнера"
                            },
                            {
                                "target_lang_word": "ставить в пару",
                                "target_lang_sense_clarification": "объединять для совместной работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指派",
                                "target_lang_sense_clarification": "安排某人担任特定角色"
                            },
                            {
                                "target_lang_word": "配对",
                                "target_lang_sense_clarification": "将两人组合在一起"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "13be88a1-00b0-36ff-8cfa-84637d4f91ad",
                    "sense_definition": "A common male nickname.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Everyone in the neighborhood calls him <w>Buddy</w> instead of his real name.",
                            "target_lang_translations": {
                                "ru": "Все в округе зовут его <w>Бадди</w> вместо его настоящего имени.",
                                "zh": "邻居们都叫他<w>巴迪</w>，而不是他的真名。"
                            }
                        },
                        {
                            "text": "His grandfather was also known as <w>Buddy</w> during his youth.",
                            "target_lang_translations": {
                                "ru": "Его дедушка в молодости тоже был известен как <w>Бадди</w>.",
                                "zh": "他祖父年轻时也被人称为<w>巴迪</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенное мужское прозвище.",
                        "zh": "常见的男性昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бадди",
                                "target_lang_sense_clarification": "транслитерация имени/прозвища"
                            },
                            {
                                "target_lang_word": "Дружок",
                                "target_lang_sense_clarification": "перевод прозвища"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巴迪",
                                "target_lang_sense_clarification": "音译名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7d20f56-8fc0-3e66-9994-ab0839108dea",
                    "sense_definition": "A popular name given to male dogs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "names",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "We decided to name our new golden retriever <w>Buddy</w>.",
                            "target_lang_translations": {
                                "ru": "Мы решили назвать нашего нового золотистого ретривера <w>Бадди</w>.",
                                "zh": "我们决定给新养的金毛寻回犬取名叫<w>巴迪</w>。"
                            }
                        },
                        {
                            "text": "Come here, <w>Buddy</w>, it is time for your walk!",
                            "target_lang_translations": {
                                "ru": "Ко мне, <w>Дружок</w>, пора гулять!",
                                "zh": "过来，<w>巴迪</w>，该去散步了！"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Популярная кличка для собак-самцов.",
                        "zh": "流行的雄性犬只名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бадди",
                                "target_lang_sense_clarification": "кличка животного"
                            },
                            {
                                "target_lang_word": "Дружок",
                                "target_lang_sense_clarification": "традиционная русская кличка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巴迪",
                                "target_lang_sense_clarification": "宠物名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "20af575f-80f0-3438-b9d5-9642df523db2",
                    "sense_definition": "A person who is not present or is far removed from the current conversation.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found these keys on the floor, <w>buddy</w> must have dropped them earlier.",
                            "target_lang_translations": {
                                "ru": "Я нашел эти ключи на полу, какой-то <w>тип</w>, должно быть, выронил их раньше.",
                                "zh": "我在地板上发现了这些钥匙，那个<w>家伙</w>一定是刚才掉的。"
                            }
                        },
                        {
                            "text": "<w>Buddy</w> is loaded and owns at least three houses in the city.",
                            "target_lang_translations": {
                                "ru": "Этот <w>чувак</w> при деньгах и владеет как минимум тремя домами в городе.",
                                "zh": "那个<w>家伙</w>很有钱，在城里至少有三套房子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "guy",
                        "fellow",
                        "chap"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily Canadian English"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "informal placeholder"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который не присутствует при разговоре (канадский сленг).",
                        "zh": "指代不在场或谈话之外的某人（加拿大俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тип",
                                "target_lang_sense_clarification": "некий человек"
                            },
                            {
                                "target_lang_word": "чувак",
                                "target_lang_sense_clarification": "сленговое обозначение человека"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "家伙",
                                "target_lang_sense_clarification": "指代某人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "19e967a0-b7e6-341f-bff9-6112cdb13836",
                    "sense_definition": "Resembling or having the characteristics of a <w>bud</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plant exhibited several <w>buddy</w> growths during the early spring season.",
                            "target_lang_translations": {
                                "ru": "Ранней весной на растении появилось несколько <w>почковидных</w> наростов.",
                                "zh": "早春时节，这株植物长出了几个<w>芽状</w>的突起。"
                            }
                        },
                        {
                            "text": "These <w>buddy</w> structures must be carefully pruned to ensure healthy development.",
                            "target_lang_translations": {
                                "ru": "Эти <w>почковые</w> структуры нужно аккуратно подрезать, чтобы обеспечить здоровое развитие.",
                                "zh": "必须小心修剪这些<w>芽状</w>结构，以确保其健康生长。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "buddy growth"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "adjectival form of bud"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий почку или имеющий характеристики почки (ботаническое).",
                        "zh": "类似芽的或具有芽特征的（植物学）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почковидный",
                                "target_lang_sense_clarification": "имеющий форму почки"
                            },
                            {
                                "target_lang_word": "почковый",
                                "target_lang_sense_clarification": "относящийся к почкам растений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "芽状的",
                                "target_lang_sense_clarification": "形容形状像芽"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}