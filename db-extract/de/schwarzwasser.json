                        "glosses": [
                            "Fluss in Deutschland; Flüsse weltweit"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "d552174f-bbae-4a62-a2c2-614edb4be894",
                                "sense_id": "522983f4-913c-3e65-991d-61ba930a0161",
                                "text": "„Der Flusslauf von Schwarzwasser und Sense zählt zu den Naherholungsgebieten von Bern.“"
                            },
                            {
                                "example_id": "4cca0907-41e8-464e-9385-947b656ba0b3",
                                "sense_id": "522983f4-913c-3e65-991d-61ba930a0161",
                                "text": "Die Schwarzwasser ist ein Fluss in Deutschland, ein Nebenfluss der Katzbach und ein Nebenfluss der Mulde."
                            },
                            {
                                "example_id": "56e40d4e-059c-4c9e-9c08-04394bd9806b",
                                "sense_id": "522983f4-913c-3e65-991d-61ba930a0161",
                                "text": "„Dem ebenfalls tief eingefressenen Bach folgt man bis zu dessen Mündung ins Schwarzwasser in der Sackau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
