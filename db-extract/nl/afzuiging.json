                                    {
                                        "sense_id": "17330843-e76d-3ee8-bcd1-1c11ee3d4bc7",
                                        "entry_id": "75ca4602-3d62-3730-a002-470054901e26",
                                        "glosses": [
                                            "The replacement of stale or noxious air with fresh."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34fc7060-d4bb-485c-9d6d-82f69b3a41a0",
                                                "sense_id": "17330843-e76d-3ee8-bcd1-1c11ee3d4bc7",
                                                "text": "So you punched out a window for ventilation. Was that before or after you noticed you were standing in a lake of gasoline?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ea15b43-58d9-3339-af1c-fb488946e919",
                                        "entry_id": "75ca4602-3d62-3730-a002-470054901e26",
                                        "glosses": [
                                            "The mechanical system used to circulate and replace air."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28a2f2e7-c2dd-31b9-80bd-c6238b7b2feb",
                                        "entry_id": "75ca4602-3d62-3730-a002-470054901e26",
                                        "glosses": [
                                            "An exchange of views during a discussion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d973ef44-8d64-3636-a85c-71f500f27848",
                                        "entry_id": "75ca4602-3d62-3730-a002-470054901e26",
                                        "glosses": [
                                            "The public exposure of an issue or topic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ef2fa30-83fc-4212-a5cf-0b3c64c9ca3b",
                                                "sense_id": "d973ef44-8d64-3636-a85c-71f500f27848",
                                                "text": "\"No, Mr. Malone, I will place no restriction upon your correspondence, since the ventilation of the facts is the object of your journey; but I demand that you shall give no particulars as to your exact destination, and that nothing be actually published until your return.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1b582bb-38d0-381e-8bea-a4b8d8b33977",
                                        "entry_id": "75ca4602-3d62-3730-a002-470054901e26",
                                        "glosses": [
                                            "The bodily process of breathing; the inhalation of air to provide oxygen, and the exhalation of spent air to remove carbon dioxide."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
