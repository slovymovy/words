{
    "word_family": [
        "bore"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a83dcef2-bdef-3af0-8207-f9d9a8c285bf",
                    "sense_definition": "The state of feeling weary and restless through lack of interest.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "boredom_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She started reading a book to escape the <w>boredom</w> of a long afternoon.",
                            "target_lang_translations": {
                                "zh": "她开始看书以摆脱漫长下午的<w>无聊</w>。"
                            }
                        },
                        {
                            "text": "Many people find relief from <w>boredom</w> by picking up a new hobby.",
                            "target_lang_translations": {
                                "zh": "许多人通过培养新爱好来缓解<w>无聊</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ennui",
                        "tedium"
                    ],
                    "common_phrases": [
                        "sheer boredom",
                        "die of boredom"
                    ],
                    "target_lang_definitions": {
                        "zh": "因缺乏兴趣而感到疲倦和烦躁的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无聊",
                                "target_lang_sense_clarification": "指因无事可做或对事物失去兴趣而产生的空虚感。"
                            },
                            {
                                "target_lang_word": "厌倦",
                                "target_lang_sense_clarification": "指对某种重复或单调的事物感到厌烦。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf6a7b5f-af87-3ac5-94a8-98c0190381e5",
                    "sense_definition": "A specific instance or period of feeling bored.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "boredom_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He suffered through a <w>boredom</w> that felt impossible to shake off.",
                            "target_lang_translations": {
                                "zh": "他忍受着一种似乎无法摆脱的<w>无聊</w>感。"
                            }
                        },
                        {
                            "text": "The long meeting was a <w>boredom</w> that everyone wanted to end quickly.",
                            "target_lang_translations": {
                                "zh": "那场冗长的会议简直令人<w>枯燥</w>透顶，每个人都希望它快点结束。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一段感到无聊的具体经历或时期。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无聊时刻",
                                "target_lang_sense_clarification": "指一段特定的无聊时间。"
                            },
                            {
                                "target_lang_word": "枯燥",
                                "target_lang_sense_clarification": "形容某事或某段经历令人感到乏味。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}