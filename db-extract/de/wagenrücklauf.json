                                        "entry_id": "b7061cc9-b15a-379b-baf0-211175c96010",
                                        "glosses": [
                                            "On a typewriter or computer printer, the action that returns it to the beginning of the next line."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83592dc7-ec9d-3914-b3cb-9d128b6a9651",
                                        "entry_id": "b7061cc9-b15a-379b-baf0-211175c96010",
                                        "glosses": [
                                            "The control character (0x0D in ASCII, abbreviated as CR) that originally signaled a device to perform a carriage return, but now merely indicates the end of a line of text (newline)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dcb4a72-6598-4672-ae53-031c306c5cce",
                                                "sense_id": "83592dc7-ec9d-3914-b3cb-9d128b6a9651",
                                                "text": "[…] but it also reduces the likelihood of the \"unterminated string literal\" error message that can easily occur for seemingly trivial reasons when you're working with long strings — an accidental carriage return or a misnested quotation mark is all it takes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9dff303-795d-3b8f-875d-30b2883a91aa",
                                        "entry_id": "b7061cc9-b15a-379b-baf0-211175c96010",
                                        "glosses": [
                                            "The key or lever that initiates the carriage return action (on a typewriter) or generates the carriage return character (on a computer)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
