                ],
                "senses": [
                    {
                        "sense_id": "5c22c436-f279-3cc5-a01f-f3efa7e3e629",
                        "entry_id": "27fa3f8d-261d-3733-ba14-31e669d8b985",
                        "glosses": [
                            "Forme pronominale de assoupir."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ea9da30-8c8c-45a8-afd7-fc1f7a9b779d",
                        "source_entry_id": "27fa3f8d-261d-3733-ba14-31e669d8b985",
                        "source_sense_id": "5c22c436-f279-3cc5-a01f-f3efa7e3e629",
                        "target_lang_word": "einnicken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einnicken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2a44d73-3efa-3a6b-b62a-3a5629f32ac3",
                                        "entry_id": "c05d55f2-6bb5-3ee4-9078-cfbf79ddcc13",
                                        "glosses": [
                                            "(zumeist im Sitzen während einer Tätigkeit) übermannt von Müdigkeit (für kürzere Zeit) in Schlummer fallen (wobei der Kopf nach vorn sinkt und sich im Takt der Atmung leicht nickend bewegt)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "800354c6-ab62-48b1-9b1a-273a5087a4fc",
                                                "sense_id": "f2a44d73-3efa-3a6b-b62a-3a5629f32ac3",
                                                "text": "„Am Abend endlich, nachdem Balla nun doch erschöpft eingenickt war, auf der Bank im Büro der Ingenieure, wurde der Beton ausgeschalt.“"
                                            },
                                            {
                                                "example_id": "afa9ddfa-1e65-48e4-a900-7f326980d163",
                                                "sense_id": "f2a44d73-3efa-3a6b-b62a-3a5629f32ac3",
                                                "text": "„Sie möchte am liebsten zu Bett gehen, aber in der Glotze läuft noch ein Krimi. Edith schaut lustlos zu, Adolf nickt zwischendurch ein.“"
                                            },
                                            {
                                                "example_id": "c6f0f588-a6d2-4156-8099-039353d47463",
                                                "sense_id": "f2a44d73-3efa-3a6b-b62a-3a5629f32ac3",
                                                "text": "„Alt sein, das hieß auch, daß man an jedem Ort einnicken konnte.“"
                                            },
                                            {
                                                "example_id": "b7bc34a1-ab64-4799-83ee-d61bbf01847e",
                                                "sense_id": "f2a44d73-3efa-3a6b-b62a-3a5629f32ac3",
                                                "text": "„Er war so müde, daß er immer wieder einnickte.“"
                                            },
                                            {
                                                "example_id": "c37ba801-cd83-4ed6-bdf7-3ffb6214ce10",
                                                "sense_id": "f2a44d73-3efa-3a6b-b62a-3a5629f32ac3",
                                                "text": "„Er musste doch eingenickt sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "einnicken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b078d4a-7444-3f3f-9b54-b587f6bc08ad",
                                        "entry_id": "cd591e3f-aaeb-3be0-875d-8fb5d14f97fa",
                                        "glosses": [
                                            "(den Ball) mühelos mit einer nickenden Kopfbewegung (ins Tor) köpfen"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09d4f90c-2be2-4ded-99c5-5ba98a699eaa",
                                                "sense_id": "2b078d4a-7444-3f3f-9b54-b587f6bc08ad",
                                                "text": "„Von der Strafraumgrenze aus hob sie den Ball ins Netz, wenig später nickte sie auch noch eine präzise Flanke ein.“"
                                            },
                                            {
                                                "example_id": "12532522-914a-4a3c-9ea9-42c01e832424",
                                                "sense_id": "2b078d4a-7444-3f3f-9b54-b587f6bc08ad",
                                                "text": "„Wieder war der Libero zur richtigen Zeit vor dem richtigen Tor und konnte das Leder nach einer weiteren Ecke unhaltbar ins Netz einnicken.“"
                                            },
                                            {
                                                "example_id": "968b023b-65cb-434c-841c-704b93a2b5e0",
                                                "sense_id": "2b078d4a-7444-3f3f-9b54-b587f6bc08ad",
                                                "text": "„Als Philipp Lahm den Ball nach 79. Minuten nach Innen flankte und Miroslav Klose zum umjubelten 2:1 eingenickt hatte, watschelte Ballack zum kleinen Lahm, nahm ihn liebevoll in den Schwitzkasten und tätschelte ihm wie ein großer Bruder den Kopf.“"
                                            },
                                            {
                                                "example_id": "9e4dac97-2a6f-4f2b-a721-7dbc6a961549",
                                                "sense_id": "2b078d4a-7444-3f3f-9b54-b587f6bc08ad",
                                                "text": "„Nach einem Freistoss von Zaugg aus dem rechten Halbfeld lief Popp in den Ball und nickte zum 1:0 ein.“"
                                            },
                                            {
                                                "example_id": "9bb5e27f-8837-4751-b4d6-eaa9910dc81d",
                                                "sense_id": "2b078d4a-7444-3f3f-9b54-b587f6bc08ad",
                                                "text": "„Doch postwendend verkürzt der neue Oranje-Starstürmer Dennis Bergkamp mit schönem Dropkick ins lange Eck; und gut zehn Minuten später jubeln wieder die Fans in Orange, als Aaron Winter den Ball nach einem Corner einnickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
