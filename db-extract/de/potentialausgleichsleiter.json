                ],
                "senses": [
                    {
                        "sense_id": "2659d740-ea07-340a-a260-50f1cb0c636c",
                        "entry_id": "0f16b9cd-fb29-32fe-b920-5d3372da47b4",
                        "glosses": [
                            "elektrisch gut leitfähiges Kabel, das elektrische Potentialunterschiede bis zur Potentialausgleichsschiene weiterleitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bf19aef-985b-4927-bed2-8139a7ec0ccb",
                                "sense_id": "2659d740-ea07-340a-a260-50f1cb0c636c",
                                "text": "„Der Querschnitt der Potentialausgleichsleiter soll halb so groß sein wie der vom Hauptverteiler abgehende Schutzleiter mit dem erforderlichen größten Querschnitt.“"
                            },
                            {
                                "example_id": "ca77a25f-ab6d-4222-9750-a4ff680127a0",
                                "sense_id": "2659d740-ea07-340a-a260-50f1cb0c636c",
                                "text": "„Im Abstand der Ableitungen, wird der Ringerder mit dem innenliegenden Potentialausgleichsleiter verbunden.“"
                            },
                            {
                                "example_id": "63c5f5da-783f-48ab-99cb-96aa1dfec1d6",
                                "sense_id": "2659d740-ea07-340a-a260-50f1cb0c636c",
                                "text": "„Im TN-Netz wird der Potentialausgleichsleiter nicht zur Stromkreisverteilung, sondern zum Hausanschlusskasten geführt und dort mit dem PEN-Leiter der Hauptleitung zusammengeschlossen. Der Potentialausgleichsleiter ist ein Schutzleiter und muss wie dieser in seinem gesamten Verlauf grüngelb gekennzeichnet sein.“"
                            },
                            {
                                "example_id": "f8907629-ee13-4890-bbc5-902d06db31ef",
                                "sense_id": "2659d740-ea07-340a-a260-50f1cb0c636c",
                                "text": "„Die Kabelabschirmung übernimmt zusätzlich die Funktion eines Potentialausgleichsleiters.“"
                            },
                            {
                                "example_id": "5999972f-c9b0-4b90-baff-7eafae95ddc1",
                                "sense_id": "2659d740-ea07-340a-a260-50f1cb0c636c",
                                "text": "„Aus meiner Sicht bestehen damit keine Bedenken gegen die Verwendung des geprüften Fugenblechs einschließlich der geprüften Verbindungstechniken als Potentialausgleichsleiter in Fundamenten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
