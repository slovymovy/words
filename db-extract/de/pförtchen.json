                "senses": [
                    {
                        "sense_id": "ad6a9b2e-ea36-3ad0-bf44-01e3b5e54c38",
                        "entry_id": "4d2fd042-f2bc-363b-9c50-f9a32b19b989",
                        "glosses": [
