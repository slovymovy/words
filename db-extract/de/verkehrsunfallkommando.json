                "senses": [
                    {
                        "sense_id": "c6030bed-62c4-39ca-a977-9c76c2c83021",
                        "entry_id": "8a725fd7-e877-342f-a7aa-e68e39721f72",
                        "glosses": [
                            "Sondereinheit der Polizei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c423a37-c153-4b1c-aaa7-187c0f3b88b3",
                                "sense_id": "c6030bed-62c4-39ca-a977-9c76c2c83021",
                                "text": "„Das Verkehrsunfallkommando steht rund um die Uhr den Kollegen des täglichen Dienstes in Fragen der Unfallaufnahme unterstützend zur Seite.“"
                            },
                            {
                                "example_id": "be9a6e64-19f1-4858-91d5-86bf118777ac",
                                "sense_id": "c6030bed-62c4-39ca-a977-9c76c2c83021",
                                "text": "„Weiterhin steht ein Verkehrsunfallkommando rund um die Uhr den Kollegen des täglichen Dienstes in Fragen der Unfallaufnahme unterstützend zur Seite.“"
                            },
                            {
                                "example_id": "44cbf977-4d47-4094-81f7-ce439e8fb582",
                                "sense_id": "c6030bed-62c4-39ca-a977-9c76c2c83021",
                                "text": "„Das Verkehrsunfallkommando der Polizei bei der Spurensicherung.“"
                            },
                            {
                                "example_id": "f6f77261-d7de-4122-a5e0-ca180e879a05",
                                "sense_id": "c6030bed-62c4-39ca-a977-9c76c2c83021",
                                "text": "„Die Teams des Verkehrsunfallkommandos (VUK) der Landesverkehrsabteilung Wien sind im Prinzip für alle Arten von Verkehrsunfällen mit Personenschaden zuständig, bei denen Fremdverschulden vorliegen könnte.“"
                            },
                            {
                                "example_id": "05c9dcea-5d35-4379-a1e2-7bc6f92ce03c",
                                "sense_id": "c6030bed-62c4-39ca-a977-9c76c2c83021",
                                "text": "„Das Verkehrsunfallkommando wird in der Regel erst bei Unfällen mit vielen Beteiligten und Verletzten oder bei tödlichen Verletzungen hinzugezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
