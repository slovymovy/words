{
    "word_family": [
        "land",
        "grens",
        "grenzen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a0aa29e8-da61-3611-ab9f-1018fba80cd4",
                    "sense_definition": "De officiële grenslijn die het grondgebied van een land afbakent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>landsgrens</w> werd streng bewaakt door militairen.",
                            "target_lang_translations": {
                                "ru": "<w>Государственная граница</w> строго охранялась военными."
                            }
                        },
                        {
                            "text": "Veel vluchtelingen proberen de <w>landsgrens</w> veilig over te steken.",
                            "target_lang_translations": {
                                "ru": "Многие беженцы пытаются безопасно пересечь <w>государственную границу</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "staatsgrens",
                        "rijksgrens"
                    ],
                    "common_phrases": [
                        "over de landsgrens"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная линия границы, отделяющая территорию одного государства от другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "государственная граница",
                                "target_lang_sense_clarification": "официальный термин для обозначения границы страны"
                            },
                            {
                                "target_lang_word": "граница",
                                "target_lang_sense_clarification": "общее понятие границы между странами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e2f7b8d-0a3a-393d-bbcb-272f00bc5e1c",
                    "sense_definition": "De fysieke of administratieve scheiding tussen twee aangrenzende landen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er staan veel winkels vlak bij de <w>landsgrens</w>.",
                            "target_lang_translations": {
                                "ru": "Рядом с <w>границей</w> расположено много магазинов."
                            }
                        },
                        {
                            "text": "De <w>landsgrens</w> tussen beide landen is al jaren gesloten.",
                            "target_lang_translations": {
                                "ru": "<w>Граница</w> между обеими странами закрыта уже много лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "staatsgrens",
                        "rijksgrens"
                    ],
                    "common_phrases": [
                        "aan de landsgrens"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое или административное разделение между двумя соседними странами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "граница",
                                "target_lang_sense_clarification": "линия раздела между государствами"
                            },
                            {
                                "target_lang_word": "межгосударственная граница",
                                "target_lang_sense_clarification": "граница, разделяющая два конкретных государства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89cf2ff1-05b1-337e-9cdc-493fcf37a2f6",
                    "sense_definition": "De overgangszone waar het land ophoudt en het water begint.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>landsgrens</w> is hier erg moerassig door de vele rivieren.",
                            "target_lang_translations": {
                                "ru": "<w>Береговая линия</w> здесь очень болотистая из-за множества рек."
                            }
                        },
                        {
                            "text": "Bij eb trekt de <w>landsgrens</w> zich ver terug in de zee.",
                            "target_lang_translations": {
                                "ru": "Во время отлива <w>береговая линия</w> значительно отступает в сторону моря."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переходная зона, где заканчивается суша и начинается вода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "береговая линия",
                                "target_lang_sense_clarification": "линия соприкосновения суши и водоема"
                            },
                            {
                                "target_lang_word": "побережье",
                                "target_lang_sense_clarification": "зона суши, примыкающая к морю или океану"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}