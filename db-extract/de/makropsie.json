                "senses": [
                    {
                        "sense_id": "4c535eaf-bd52-3786-be08-df8eff18823d",
                        "entry_id": "639c04b2-36c0-3c71-9174-de4fe8d7e910",
                        "glosses": [
                            "Sehstörung, bei der die Umgebung beziehungsweise Dinge größer wahrgenommen werden als sie wirklich sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "246b1462-90ad-4240-82fc-97ef9ac0b965",
                                "sense_id": "4c535eaf-bd52-3786-be08-df8eff18823d",
                                "text": "„Die Gegenstände erscheinen dann abnorm klein (Mikropsie) oder riesengroß (Makropsie), ganz nahe oder weit weg; im Meskalinrausch tritt ein Gefühl der Raumunendlichkeit auf.“"
                            },
                            {
                                "example_id": "c97dba41-d6d9-4cbb-986e-9d38cfdf77ec",
                                "sense_id": "4c535eaf-bd52-3786-be08-df8eff18823d",
                                "text": "„Eine weitere spezielle Auravariante ist das ‚Alice-im-Wunderland-Syndrom‘ mit Mikropsie und Makropsie sowie eventuell halluzinatorisch anmutenden Verkennungen.“"
                            },
                            {
                                "example_id": "86ad3a00-7c62-4b1b-823f-446f9d5c78a2",
                                "sense_id": "4c535eaf-bd52-3786-be08-df8eff18823d",
                                "text": "„Umgekehrt werden bei der Makropsie Menschen und Dinge größer wahrgenommen, als sie es in Wirklichkeit sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
