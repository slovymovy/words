                                "sense_id": "f436fde2-843b-3f72-9460-1866543ee274",
                                "text": "Hij had tien jaar in de bak gezeten."
                            }
                        ]
                    },
                    {
                        "sense_id": "a198b69e-3e9b-38d5-9731-da4bd37400e5",
