                },
                {
                    "sense_id": "e8ad62ea-d59b-3e5b-ab6c-5b2ea5a7049c",
                    "sense_definition": "молодой, неопытный человек",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он ещё совсем <w>мальчик</w>, чтобы руководить такой большой компанией.",
                            "target_lang_translations": {
                                "en": "He is still just a <w>boy</w> to be running such a large company.",
                                "de": "Er ist noch ein viel zu junger <w>Junge</w>, um ein so großes Unternehmen zu leiten.",
                                "pl": "Jest jeszcze zbyt dużym <w>chłopcem</w>, by zarządzać tak dużą firmą.",
                                "fr": "C'est encore un <w>gamin</w> pour diriger une si grande entreprise."
                            }
                        },
                        {
                            "text": "Не слушай его, он <w>мальчик</w> и ничего не понимает в бизнесе.",
                            "target_lang_translations": {
                                "en": "Don't listen to him, he's a <w>boy</w> and doesn't understand anything about business.",
                                "de": "Hör nicht auf ihn, er ist noch ein <w>Junge</w> und versteht nichts vom Geschäft.",
                                "pl": "Nie słuchaj go, to jeszcze <w>młokos</w> i nic nie rozumie z biznesu.",
                                "fr": "Ne l'écoute pas, c'est un <w>jeunot</w> et il ne comprend rien aux affaires."
                            }
                        }
                    ],
                    "synonyms": [
                        "юнец"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
