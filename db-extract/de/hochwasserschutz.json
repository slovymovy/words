                ],
                "senses": [
                    {
                        "sense_id": "58a35457-d844-33b8-b6bb-a8f496441705",
                        "entry_id": "c3903997-a6a9-38ec-ad1a-aa0930487055",
                        "glosses": [
                            "vorbeugende Sicherheitsmaßnahme, die einen Hochwasserfall oder dessen Auswirkungen begrenzt und kontrolliert ableiten lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efaf0f41-7d82-405c-a73d-28e6e3d2289e",
                                "sense_id": "58a35457-d844-33b8-b6bb-a8f496441705",
                                "text": "„Das Bundesumweltministerium hat daraufhin gemeinsam mit den für den Hochwasserschutz zuständigen Ländern unter Hochdruck eine Liste mit prioritären, überregional wirksamen Hochwasserschutzmaßnahmen erarbeitet, die das Kernstück des Nationalen Hochwasserschutzprogramms bildet.“"
                            },
                            {
                                "example_id": "7f7cb52e-9e29-46fa-9446-b47b1a7042c5",
                                "sense_id": "58a35457-d844-33b8-b6bb-a8f496441705",
                                "text": "„Die Akademie Hochwasserschutz hat zum Ziel, Maßnahmen zum Hochwasserschutz und zur Wasserrettung einer breiten Öffentlichkeit nahe zu bringen, den Einsatz der Hilfskräfte im Hochwasserfall zu optimieren und weitere Präventionsmöglichkeiten zu erforschen.“"
                            },
                            {
                                "example_id": "603383ff-d7d4-40e2-8f18-52a4f0b7077a",
                                "sense_id": "58a35457-d844-33b8-b6bb-a8f496441705",
                                "text": "„Grundsätzlich lässt sich technischer Hochwasserschutz durch verschiedene Strategien (oder Kombinationen daraus) erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
