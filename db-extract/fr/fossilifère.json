                ],
                "senses": [
                    {
                        "sense_id": "5010be0e-5e73-30dd-be6f-20198fec9808",
                        "entry_id": "98f0a897-4912-3c52-bedb-6296090e4e53",
                        "glosses": [
                            "Qui recèle des fossiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32675012-b4ed-44ca-9dbe-86f140d87bc2",
                                "sense_id": "5010be0e-5e73-30dd-be6f-20198fec9808",
                                "text": "Superposition et succession chronologique des couches fossilifères."
                            },
                            {
                                "example_id": "8ecf7339-adf2-47a3-89bc-d41ccfdbbcf7",
                                "sense_id": "5010be0e-5e73-30dd-be6f-20198fec9808",
                                "text": "Les grès à Woltzia […] forment dans leur niveau inférieur des bancs compacts et fossilifères où « les couches gréseuses alternent avec des argiles diversement nuancées » […]"
                            },
                            {
                                "example_id": "244ded8f-18df-4e95-b274-b578352374d1",
                                "sense_id": "5010be0e-5e73-30dd-be6f-20198fec9808",
                                "text": "La plupart des gisements d’ambre ont été trouvés en Amérique du Nord et en Eurasie, et seuls quelques rares ambres non fossilifères étaient connus pour le Gondwana."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b645f309-0454-4e96-b728-c3e5566a5dc3",
                        "source_entry_id": "98f0a897-4912-3c52-bedb-6296090e4e53",
                        "source_sense_id": "5010be0e-5e73-30dd-be6f-20198fec9808",
                        "target_lang_word": "fossiliferous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fossiliferous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1efac5a7-bc10-3650-aba2-6577a6e7d020",
                                        "entry_id": "4f9d395f-2865-3066-b9af-654c8fbd9435",
                                        "glosses": [
                                            "Containing fossils."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b349dcbe-bcc8-49d7-b306-9fcbfb9f5462",
                                                "sense_id": "1efac5a7-bc10-3650-aba2-6577a6e7d020",
                                                "text": "Having already described him [the whale] in most of his present habitatory and anatomical peculiarities, it now remains to magnify him in an archæological, fossiliferous, and antediluvian point of view."
                                            },
                                            {
                                                "example_id": "4ec9362c-820a-4bba-8e57-e758c1962b25",
                                                "sense_id": "1efac5a7-bc10-3650-aba2-6577a6e7d020",
                                                "text": "The area contains a great thickness of well exposed fossiliferous, marine strata of uppermost Cretaceous and Eocene age, and it is felt that the most continuous and complete section may be found here."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
