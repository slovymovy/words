                                "target_senses": [
                                    {
                                        "sense_id": "64fb974d-a773-3a02-9da5-d817801bcd39",
                                        "entry_id": "a45ff522-f00c-38e3-9f8f-49cbc4955f76",
                                        "glosses": [
                                            "Fachärztin für Geistes- und Gemütskrankheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "611b2386-d967-4583-ac4b-a90863b7f312",
                                                "sense_id": "64fb974d-a773-3a02-9da5-d817801bcd39",
                                                "text": "„Svanhvít war Psychiaterin und, wenn man Sólmundur glauben konnte, eine der äußerst wenigen im Land, die sich mit der Psychoanalyse von Freud und Jung auseinandergesetzt hat.“"
                                            },
                                            {
                                                "example_id": "8566b3f2-2294-410b-8b06-b466f6007994",
                                                "sense_id": "64fb974d-a773-3a02-9da5-d817801bcd39",
                                                "text": "„Früher in diesem Jahr hatte Roth begonnen, mit der einunddreißigjährigen Psychiaterin Julia Golier auszugehen, die am Mount Sinai Hospital an der Upper East Side unterrichtete und im Krankenhaus der Veterans' Administration in der Bronx Vietnamveteranen mit posttraumatischer Belastungsstörung behandelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
