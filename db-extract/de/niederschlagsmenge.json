                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2c4323a-0f35-47a3-8d54-50d96c17b12b",
                                                "sense_id": "9226ae7c-5a10-3b28-99b1-b0360e19b1fe",
                                                "text": "South Korea’s Ministry of Environment said in a news release that no major precipitation was observed after the cloud seeding operation."
                                            },
                                            {
                                                "example_id": "dff32fec-9dff-43a4-ba4d-0fe3e1c9bb95",
                                                "sense_id": "9226ae7c-5a10-3b28-99b1-b0360e19b1fe",
                                                "text": "Some rain was expected to fall in Pennsylvania and South Jersey on Thursday, but no precipitation made it to the rest of New Jersey, New York City and most of New England -- all regions in desperate need of moisture following an extremely dry fall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e69d0fa-bfee-36d5-9cfc-4e58bd8e0ac1",
                                        "entry_id": "07c591da-b0c0-3ca3-b5c8-2d18e2731854",
                                        "glosses": [
                                            "The amount of water precipitated in any form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "443d68cd-84f9-333b-b7b0-6500585af8b7",
                                        "entry_id": "07c591da-b0c0-3ca3-b5c8-2d18e2731854",
                                        "glosses": [
                                            "A hurried headlong fall."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f9d5394-ccd0-359a-a4fd-6147c3d9f6c0",
                                        "entry_id": "07c591da-b0c0-3ca3-b5c8-2d18e2731854",
                                        "glosses": [
                                            "A reaction that leads to the formation of a heavier solid in a lighter liquid; the precipitate so formed at the bottom of the container."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6076958-37ce-3a67-817d-9c8cb040880f",
                                        "entry_id": "07c591da-b0c0-3ca3-b5c8-2d18e2731854",
                                        "glosses": [
                                            "Unwise or rash rapidity; sudden haste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d37ce08-2be5-4ccd-93a4-d7e2a2945274",
                                                "sense_id": "e6076958-37ce-3a67-817d-9c8cb040880f",
                                                "text": "Immediately on returning home, highly satisfied with the result of his visit to Mrs. Belmour, Melliphant found on his table a letter from Sir Howard, over which he cast his eyes with precipitation."
                                            },
                                            {
                                                "example_id": "ec15ba15-1eee-42e6-b398-4eb39b9e2e1b",
                                                "sense_id": "e6076958-37ce-3a67-817d-9c8cb040880f",
                                                "text": "The young man thanked me, and took his leave with some little precipitation, after declining a glass of liquor."
                                            },
                                            {
                                                "example_id": "73741b41-1bd2-4ae4-b87c-0d4aea722471",
                                                "sense_id": "e6076958-37ce-3a67-817d-9c8cb040880f",
                                                "text": "[…] had acted with some precipitation and had probably started out upon a wild-goose chase."
                                            }
