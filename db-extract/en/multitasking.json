                                                "sense_id": "af3d07a4-2d17-374a-be05-6d7834d8906b",
                                                "text": "Unix est un système d’exploitation multitâche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "720262dd-3c3f-3587-a707-35fdeb7bb505",
