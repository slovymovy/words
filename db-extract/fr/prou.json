                                            {
                                                "example_id": "c3354a1b-26f6-469e-8b12-e4c2d0a2c94f",
                                                "sense_id": "892eccd1-1c72-31fc-9f63-464f3f92482d",
                                                "text": "Er sieht mehr als ich."
                                            },
                                            {
                                                "example_id": "8d82a412-a341-44bb-a41e-38daed9d12e7",
                                                "sense_id": "892eccd1-1c72-31fc-9f63-464f3f92482d",
                                                "text": "Ich habe mehr Haare als du!"
                                            },
                                            {
                                                "example_id": "38ae9d1e-0d22-4d9e-9952-aa112cc6b442",
                                                "sense_id": "892eccd1-1c72-31fc-9f63-464f3f92482d",
                                                "text": "Keine Angst, du wirst satt werden, es ist noch mehr als genug da."
                                            },
                                            {
                                                "example_id": "6807a3df-120e-43ee-9be6-a66f2185d300",
                                                "sense_id": "892eccd1-1c72-31fc-9f63-464f3f92482d",
                                                "text": "Mama, gib mir mehr!"
                                            },
                                            {
                                                "example_id": "97342815-c06b-4c12-93cf-11deca3a04d4",
                                                "sense_id": "892eccd1-1c72-31fc-9f63-464f3f92482d",
                                                "text": "Die Sonne scheint, was will man mehr?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
