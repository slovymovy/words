                "forms": [
                    {
                        "form_id": "7be4c4da-30cd-4468-a1dd-721a3ab2d809",
                        "entry_id": "f499d6db-f2d3-342d-9c32-3cb6e616ed05",
                        "tags": [
                            "plural"
                        ],
                        "form": "aragonites"
                    },
                    {
                        "form_id": "419b750e-865c-460d-b5d8-9ca57949cd25",
                        "entry_id": "f499d6db-f2d3-342d-9c32-3cb6e616ed05",
                        "tags": [],
                        "form": "arragonite"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "20d32f57-6726-343e-ba74-d0ca70fccb2c",
                        "entry_id": "f499d6db-f2d3-342d-9c32-3cb6e616ed05",
                        "glosses": [
                            "Espèce minérale métastable de la famille des carbonates, de formule CaCO₃, et qui cristallise dans le système orthorhombique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e462df5-d050-40df-9a20-11ae4845eea6",
                                "sense_id": "20d32f57-6726-343e-ba74-d0ca70fccb2c",
                                "text": "D’après Sorby beaucoup de coquilles de lamellibranches seraient formées uniquement d’aragonite."
                            },
                            {
                                "example_id": "5b087fe3-b4f6-4db6-8919-398877f332b8",
                                "sense_id": "20d32f57-6726-343e-ba74-d0ca70fccb2c",
                                "text": "On étudiera successivement les divers types de néoformation découverts en grotte, en commençant par la transformation classique de l’aragonite en calcite, déjà observée de nombreuses fois dans d’autres conditions."
                            },
                            {
                                "example_id": "c89bf1e0-7d3e-4a54-a4be-b64ef8727ad3",
                                "sense_id": "20d32f57-6726-343e-ba74-d0ca70fccb2c",
                                "text": "En contrebas, l’Amou-Daria, couleur aragonite."
                            },
                            {
                                "example_id": "e0c11214-4a85-4cb3-b594-6a7ce3cfe81c",
                                "sense_id": "20d32f57-6726-343e-ba74-d0ca70fccb2c",
                                "text": "Merveilleux matériau naturel, la nacre allie la rigidité des briques d’aragonite à la souplesse d'un mortier polymère."
                            },
                            {
                                "example_id": "b467d3cc-879a-44a5-bb05-6b363f995bf9",
                                "sense_id": "20d32f57-6726-343e-ba74-d0ca70fccb2c",
                                "text": "Plus l’eau sera acide, plus cela fait chuter le taux d’aragonite, et plus les organismes auront du mal à fabriquer leur coquille. Si l’océan devient sous-saturé en aragonite, celui-ci tendra même à se dissoudre dans l’eau, comme les coquilles qui en sont constituées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1918ab51-1c37-4cd5-a4cb-7d2d1ade3334",
                        "source_entry_id": "f499d6db-f2d3-342d-9c32-3cb6e616ed05",
                        "source_sense_id": "20d32f57-6726-343e-ba74-d0ca70fccb2c",
                        "target_lang_word": "Aragonit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aragonit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7240ee05-c9ed-3665-98b0-5f0146527ba3",
                                        "entry_id": "121c688c-a6bd-3243-b178-0769dcbe04cf",
                                        "glosses": [
                                            "farbloses, weißliches oder gelbliches Mineral, Kalziumkarbonat, das ein Bestandteil von Perlen, Kalkschalen und Skeletten ist und Stalaktiten bilden kann"
                                        ],
                                        "tags": [
                                            "speziell Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "901bc6f8-1aac-42a0-a68f-6c02eabf82ac",
                                                "sense_id": "7240ee05-c9ed-3665-98b0-5f0146527ba3",
                                                "text": "„Aragonit bildet gerne säulig prismatische Kristalle aus, wobei häufig Drillinge oder auch ästige, korallenartige Aggregate vorkommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61c392cd-1541-44a2-94f7-26b0a5d8f995",
