                    },
                    {
                        "translation_id": "68aa2572-d85f-4dbc-81bb-dac5a521b8ec",
                        "source_entry_id": "fb0bf965-e7b8-3787-af3d-c9a41e5027a3",
                        "source_sense_id": "7395315c-58d0-30b7-822f-954f98119d48",
                        "source_sense_description": "hoofdstad van Polen",
                        "target_lang_word": "Warschau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Warschau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "337744c8-7756-30ca-831d-dce087399b54",
                                        "entry_id": "19861d5d-c102-38f9-b05e-92413fa57611",
                                        "glosses": [
                                            "Metropole in Europa und Hauptstadt und mit 1,7 Mio. Einwohnern größte Stadt Polens; deutsche Bezeichnung von Warszawa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a320c9-6288-4b52-b9bf-4edd89618028",
                                                "sense_id": "337744c8-7756-30ca-831d-dce087399b54",
                                                "text": "Im 30-jährigen Krieg wurde Warschau von den Schweden zerstört."
                                            },
                                            {
                                                "example_id": "c4a978d2-2ba2-42f7-b88a-b805793270a9",
                                                "sense_id": "337744c8-7756-30ca-831d-dce087399b54",
                                                "text": "„Es liegt daran, dass ich in Warschau immer erst einige Stunden brauche, ehe ich zum richtigen Polen mutiere.“"
                                            },
                                            {
                                                "example_id": "7680c6a8-ef0b-4faa-a184-4e3b2326cce7",
                                                "sense_id": "337744c8-7756-30ca-831d-dce087399b54",
                                                "text": "„Um die Gründung Warschaus rankt sich eine Legende, die auf einem Wortspiel beruht.“"
                                            },
                                            {
                                                "example_id": "a2882e35-0b74-4bc7-893a-dc1132ffb270",
                                                "sense_id": "337744c8-7756-30ca-831d-dce087399b54",
                                                "text": "„Die Zarin Katharina II. wollte in diesen Tagen die nun ihrer Herrschaft unterstehenden Länder besichtigen und sich deren Bewohnern zeigen; auf ihrem Weg nach Warschau kam sie durch Riga.“"
                                            },
                                            {
                                                "example_id": "9de79bef-d6bb-4c39-8b5b-c358f14cfe75",
                                                "sense_id": "337744c8-7756-30ca-831d-dce087399b54",
                                                "text": "„Im übrigen verbesserte sich auch rund um Warschau die Lage: Nicht länger gingen deutsche Artilleriegeschosse auf die Stadt nieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9bd8f50e-e770-3831-9a68-69e8f99ec2d5",
                                        "entry_id": "19861d5d-c102-38f9-b05e-92413fa57611",
                                        "glosses": [
                                            "die polnische Regierung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3c02a79-2ecb-4d15-8aa5-31e26ff252ed",
                                                "sense_id": "9bd8f50e-e770-3831-9a68-69e8f99ec2d5",
                                                "text": "Pöttering warnt Warschau: Wenn Polen seine Position weiter allen anderen EU-Mitgliedern aufzwingen wolle, dann müsse das Konsequenzen haben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dc8a5b67-91fd-3f7f-ba38-2ea96d7e3cb2",
                                        "entry_id": "19861d5d-c102-38f9-b05e-92413fa57611",
                                        "glosses": [
                                            "das Herzogtum Warschau"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
