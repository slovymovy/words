                                    {
                                        "sense_id": "b19cc612-0adf-3141-b432-f5625e91229d",
                                        "entry_id": "fe7979fc-ea61-393f-ace8-28201915f687",
                                        "glosses": [
                                            "Kleidung: mantelartiger Umhang ohne Ärmel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88b10208-cdb7-4886-9d38-33aa629ba504",
                                                "sense_id": "b19cc612-0adf-3141-b432-f5625e91229d",
                                                "text": "„Wiebke hatte ihren fusseligen weißen Poncho an und winkte Papa noch nach, als der Zug schon lange verschwunden war.“"
                                            },
                                            {
                                                "example_id": "7e4ba1e4-a98e-4cf6-a144-745014237d87",
                                                "sense_id": "b19cc612-0adf-3141-b432-f5625e91229d",
                                                "text": "„Um mein einziges Paar geschlossener Schuhe zu schonen, zog ich trotz Kälte die Trekkingsandalen an und kämpfte in kurzer Hose, nur mit einem wasserdichten Poncho bewaffnet, gegen den Regen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
