                                        "sense_id": "04eaa431-7ef7-345f-8029-b27508d0196f",
                                        "entry_id": "0b678443-4dce-39af-8728-03ba28496fc8",
                                        "glosses": [
                                            "jemand, der einen Sieg erringt; jemand, der einen Kampf oder Wettkampf gewinnt oder gewonnen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "540f523f-4eb2-4c7b-a719-5f4d6d58d078",
                                                "sense_id": "04eaa431-7ef7-345f-8029-b27508d0196f",
                                                "text": "Der Sieger des heutigen Spiels wird nächste Woche gegen den Weltmeister antreten."
                                            },
                                            {
                                                "example_id": "411c5004-0b95-4463-b17d-13d37ef8aa7c",
                                                "sense_id": "04eaa431-7ef7-345f-8029-b27508d0196f",
                                                "text": "Kaum hatten die Wahllokale geschlossen, rief Mahsouli seinen Chef, den Präsidenten Mahmud Ahmadinedschad, offiziell zum Sieger aus."
                                            },
                                            {
                                                "example_id": "30bf699b-b2a2-481d-9607-842dc9b884bb",
                                                "sense_id": "04eaa431-7ef7-345f-8029-b27508d0196f",
                                                "text": "„Nun wurde zum Faustkampf geschritten und dem Sieger ein Maultier, dem Besiegten ein Henkelbecher bestimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
