                ],
                "senses": [
                    {
                        "sense_id": "f7af478e-4e40-3af4-acb3-74b964753815",
                        "entry_id": "cc664a66-2837-37bc-9d19-21118715a8ae",
                        "glosses": [
                            "soil, clay, silt or gravel deposited by flowing water, as it slows, in a river bed, delta, estuary or flood plain"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbf3733b-3f49-4ca9-8895-a7f75b41d3bf",
                        "source_entry_id": "cc664a66-2837-37bc-9d19-21118715a8ae",
                        "source_sense_id": "f7af478e-4e40-3af4-acb3-74b964753815",
                        "source_sense_description": "deposited material",
                        "target_lang_word": "naplavenina",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "78993fe9-741c-4b03-b578-c732977d297d",
                        "source_entry_id": "cc664a66-2837-37bc-9d19-21118715a8ae",
                        "source_sense_id": "f7af478e-4e40-3af4-acb3-74b964753815",
                        "source_sense_description": "deposited material",
                        "target_lang_word": "alluvium",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alluvium",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "db8304ff-2a3b-33f0-9e82-c96524b0d524",
                                        "entry_id": "11833fa9-fe8c-3c18-9ac5-c743c66f7ecc",
                                        "glosses": [
                                            "sediment van los materiaal (regoliet) dat door stromend water is afgezet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e5b8ca3-7703-440e-90f8-eb77e86a9f03",
                                                "sense_id": "db8304ff-2a3b-33f0-9e82-c96524b0d524",
                                                "text": "Dit alluvium bestaat hoofdzakelijk uit kalkrijke, bruinachtige, zware klei; slechts in de grote kreken treft men zandig materiaal aan."
                                            },
                                            {
                                                "example_id": "96abafe7-af0e-45ec-8b04-fe3e3f09d070",
                                                "sense_id": "db8304ff-2a3b-33f0-9e82-c96524b0d524",
                                                "text": "Vroeger bestond het Eijerland uit de van ouds bekende Duinkom, gevormd door diluvische of oorspronkelijke gronden, (waarop het geheel op zichzelf staande Eijerlandshuis gevonden wordt) en het tusschen dit Eijerland en Texel gelegene Buitenveld, een' alluvium of aangespoelden grond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4359938c-3c09-35ed-9b4d-628368946bdd",
                                        "entry_id": "11833fa9-fe8c-3c18-9ac5-c743c66f7ecc",
                                        "glosses": [
                                            "laatste tijdvak van de periode quartair"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c783234-6189-4ca5-ada2-4a0d7b23dd7d",
                                                "sense_id": "4359938c-3c09-35ed-9b4d-628368946bdd",
                                                "text": "(…) het mesolithicum en het neolithicum moeten worden geplaatst in de tegenwoordige periode, het alluvium of holoceen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a03a1fcc-c4df-4660-b9b7-a1c8d23ff059",
                        "source_entry_id": "cc664a66-2837-37bc-9d19-21118715a8ae",
                        "source_sense_id": "f7af478e-4e40-3af4-acb3-74b964753815",
                        "source_sense_description": "deposited material",
                        "target_lang_word": "alluvion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alluvion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                        "entry_id": "e3d9341f-2f08-3ac8-8295-312bb6eac414",
                                        "glosses": [
                                            "Accroissement de terrain qui se fait insensiblement à l’un des bords d’une rivière, ou qui a lieu lorsque la rivière s’en retire, et qu’elle prend son cours d’un autre côté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e1c12f-624f-4829-a952-f789de041b3f",
                                                "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                                "text": "Les terres provenant du défrichement des prairies, les terres d’alluvion fumées et travaillées depuis long-temps, sont très-propres à la culture des betteraves."
                                            },
                                            {
                                                "example_id": "d17b8df6-9ff8-45a8-90f9-b3059e237f3f",
                                                "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                                "text": "Au fond du val, des champs de blé, des carrés de betteraves, des pâturages d’herbe drue avaient poussé avec cette opulence lourde des végétations nourries par l’humus noir des terrains d’alluvion."
                                            },
                                            {
                                                "example_id": "3f95af86-87fd-4aab-a31a-780762753da5",
                                                "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                                "text": "Les sols lourds (texture très fine) et rouges, appelés par les paysans hamri, se trouvent principalement sur les alluvions de l’Amirien et du Soltanien."
                                            },
                                            {
                                                "example_id": "516de47b-02dd-463b-b545-be21f8832810",
                                                "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                                "text": "Le caractère essentiel de lʼalluvion, cʼest de sʼêtre formé successivement et imperceptiblement."
                                            },
                                            {
                                                "example_id": "9faa3fd4-b7b4-400c-bda8-2ec9ea4a5a9d",
                                                "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                                "text": "Pour Napoléon, [la Hollande] est une alluvion de fleuves français : le Rhin, l'Escaut et la Meuse ; et sous ce prétexte, il la réunit à l'Empire."
                                            },
                                            {
                                                "example_id": "1509ffce-58d4-4088-9b6a-600df8e9727f",
                                                "sense_id": "8148f279-4761-3a63-a01a-71a96994ddf0",
                                                "text": "Les marnes bleues qui constituent le substratum des alluvions avec des faciès sensiblement identiques, d’Épineau-Ies-Voves à Appoigny, méritent de retenir l’attention au point de vue stratigraphique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9512a6e6-7c7c-4777-b234-dd9ec250db40",
