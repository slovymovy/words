                                            {
                                                "example_id": "cb51655e-145c-4bbc-8a1d-949aa0132c0b",
                                                "sense_id": "d98f64ce-9633-36b7-9188-d359f0cc4caf",
                                                "text": "L’affectation d’une somme à telle dépense, d’un monument à tel usage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6c826e0-1e6b-3ecb-9902-73c2d1dacd57",
                                        "entry_id": "5a85fe63-3339-30c0-8680-162221667bd7",
                                        "glosses": [
                                            "Action d’assigner un poste ; ce poste lui-même."
                                        ],
                                        "tags": [],
