                    {
                        "translation_id": "5f29ca96-ac4b-4e14-adfd-18a3ddf2bac6",
                        "source_entry_id": "8d31a594-e966-3c2e-9c58-91673b94b807",
                        "source_sense_id": "a698990f-8f6d-34ac-8fc7-6a4289de798f",
                        "source_sense_description": "(Ichtyologie) Poisson d’eau douce lacustre",
                        "target_lang_word": "Weißfisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weißfisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcb737dd-9be7-38bd-8f9c-2ef13eaf9759",
                                        "entry_id": "846c604d-60b5-380e-ba72-f3a65a2c957e",
                                        "glosses": [
                                            "Sammelbezeichnung für die kleineren Verwandten des Karpfens (Familie Cyprinidae), die selten als Speisefisch verwendet werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6244c70-f992-46a1-8be1-dc9b26325ee1",
                                                "sense_id": "bcb737dd-9be7-38bd-8f9c-2ef13eaf9759",
                                                "text": "„Weißfisch dient den Pelzhändlern als Hauptnahrungsmittel.“"
                                            },
                                            {
                                                "example_id": "cffba76a-f52f-44fa-877e-c29e5388f993",
                                                "sense_id": "bcb737dd-9be7-38bd-8f9c-2ef13eaf9759",
                                                "text": "„Die Strömung war vorteilhaft, und unter den Algenbänken wimmelte es von Weißfischen, Barschen und Karpfen.“"
                                            },
                                            {
                                                "example_id": "1f69ab24-30e5-46db-8336-c4f6f3329ad3",
                                                "sense_id": "bcb737dd-9be7-38bd-8f9c-2ef13eaf9759",
                                                "text": "„Wie bei vielen anderen Weißfischen auch ist der Döbel aufgrund seines grätenreichen Fleisches als Speisefisch wenig geschätzt. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f3b4e21-aa78-3673-8afd-1fbca8b96b9b",
                                        "entry_id": "846c604d-60b5-380e-ba72-f3a65a2c957e",
                                        "glosses": [
                                            "Mitglied der Weißfisch^([1])-Gattung Leuciscus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "586da52c-fd90-4fee-a34a-8c92db5094ca",
                                                "sense_id": "0f3b4e21-aa78-3673-8afd-1fbca8b96b9b",
                                                "text": "„Wie bei vielen anderen Weißfischen auch ist der Döbel aufgrund seines grätenreichen Fleisches als Speisefisch wenig geschätzt. “"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
