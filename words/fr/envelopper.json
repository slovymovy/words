    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e6ebdb7-e649-3eec-b230-c8ee774177bd",
                    "sense_definition": "Entourer complètement quelqu'un ou quelque chose d'un papier, d'un tissu ou d'une autre matière pour couvrir ou protéger.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "couvrir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>envelopper</w> le cadeau avec un joli ruban avant la fête."
                        },
                        {
                            "text": "Pour ne pas avoir froid, l'enfant s'est <w>enveloppé</w> dans une grande couverture en laine."
                        }
                    ],
                    "synonyms": [
                        "empaqueter"
                    ],
                    "common_phrases": [
                        "envelopper un cadeau",
                        "envelopper dans du papier"
                    ]
                },
                {
                    "sense_id": "6aaa1f24-c75c-318e-a3bd-d2c59d403a12",
                    "sense_definition": "Entourer ou recouvrir de tous côtés de manière à masquer, en parlant d'éléments naturels comme le brouillard ou l'obscurité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dissimuler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une brume très épaisse <w>enveloppait</w> la vallée au lever du soleil."
                        },
                        {
                            "text": "Dès que le soleil a disparu, la nuit a <w>enveloppé</w> tout le village."
                        }
                    ],
                    "common_phrases": [
                        "enveloppé de brouillard",
                        "s'envelopper de mystère"
                    ]
                },
                {
                    "sense_id": "4b0786d4-f183-3bc6-a6be-8a1d22b3ec43",
                    "sense_definition": "Présenter une pensée ou un propos de façon détournée pour la déguiser ou en atténuer la dureté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dissimuler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a habilement <w>enveloppé</w> sa critique de compliments polis."
                        },
                        {
                            "text": "Elle préfère <w>envelopper</w> ses reproches pour ne blesser personne lors de la réunion."
                        }
                    ],
                    "common_phrases": [
