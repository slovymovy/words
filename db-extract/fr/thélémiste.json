                        "glosses": [
                            "Moine de l’abbaye de Thélème, abbaye fictive imaginée par François Rabelais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9297c8b-7384-40bd-bb20-aac0fed0f2ec",
                                "sense_id": "da56a093-17e9-3477-a685-8e6f92e35af0",
                                "text": "Si les pantoufles de ce savant Thélémiste étaient de cuir grossier, une bonne peau d’agneau en formait la doublure."
                            },
                            {
                                "example_id": "8145fbf5-26ff-4688-8b06-786b8ad90855",
                                "sense_id": "da56a093-17e9-3477-a685-8e6f92e35af0",
                                "text": "Au deuxième acte, dans la cour de l’abbaye de Thélème, dont frère Jean des Entommeures est l’abbé, les Thélémistes font une partie de main-chaude à laquelle prennent part dame Ribaude et frère Jean lui-même."
                            },
                            {
                                "example_id": "b84b081d-7554-4a7c-a591-c3942a276d95",
                                "sense_id": "da56a093-17e9-3477-a685-8e6f92e35af0",
                                "text": "Morceau d’histoire recueilli par un Thélémiste."
                            }
