            {
                "entry_id": "d645263d-8616-333a-a340-d37310a87479",
                "word": "lactaire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4732fb72-4ac3-4f85-bf9f-14feb4d55a28",
                        "entry_id": "d645263d-8616-333a-a340-d37310a87479",
                        "tags": [
                            "plural"
                        ],
                        "form": "lactaires"
