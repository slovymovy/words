                "senses": [
                    {
                        "sense_id": "847d71e3-e7f1-338d-a0a7-b1759d4c6a75",
                        "entry_id": "1ce72ff8-c248-3982-a681-24103ecbb80b",
                        "glosses": [
                            "Linie, die für die Teilnehmer eines Wettbewerbs das Ziel markiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9655001d-1fc3-419b-a36e-cfe009de475e",
                                "sense_id": "847d71e3-e7f1-338d-a0a7-b1759d4c6a75",
                                "text": "„Am 15. April 2013 explodierten bei der Ziellinie des Marathons in Boston zwei Bomben.“"
                            },
                            {
                                "example_id": "160cd860-009f-42aa-b2de-9be05338cf48",
                                "sense_id": "847d71e3-e7f1-338d-a0a7-b1759d4c6a75",
                                "text": "„Der spätere Sieger (8:25,30 Minuten) zog sich bereits 50 Meter vor dem Ziel das Trikot aus und rannte feiernd mit nacktem Oberkörper als Erster über die Ziellinie.“"
                            },
                            {
                                "example_id": "17775d7d-bc5e-4db1-b05c-8ffaa5f985cd",
                                "sense_id": "847d71e3-e7f1-338d-a0a7-b1759d4c6a75",
                                "text": "„Ich machte praktisch kurz hinter der Ziellinie schlapp.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83ce58bd-ca5f-4990-8e18-36b998ae8257",
                        "source_entry_id": "1ce72ff8-c248-3982-a681-24103ecbb80b",
                        "source_sense_id": "847d71e3-e7f1-338d-a0a7-b1759d4c6a75",
                        "source_sense_description": "Sport: Linie, die für die Teilnehmer eines Wettbewerbs das Ziel markiert",
                        "target_lang_word": "finish line",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finish line",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecc6368f-95ab-373c-af74-ac59948af4c1",
                                        "entry_id": "9feec098-2b2a-33bd-9411-690e47f91be1",
                                        "glosses": [
                                            "A line marking the end of a race."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60026fdf-8b7f-4912-9577-9b0815eb451a",
                                                "sense_id": "ecc6368f-95ab-373c-af74-ac59948af4c1",
                                                "text": "The five exhausted runners crossed the finish line one after the other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61dc94cb-70bb-3cee-9546-428d3900a9c1",
                                        "entry_id": "9feec098-2b2a-33bd-9411-690e47f91be1",
                                        "glosses": [
                                            "The end of a process."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86638981-4d44-4b5c-bff1-85874d88d948",
                                                "sense_id": "61dc94cb-70bb-3cee-9546-428d3900a9c1",
                                                "text": "The race to the finish line has started already according to Jürgen Klopp and by those punishing standards Liverpool have faltered badly."
                                            },
                                            {
                                                "example_id": "5440bb0c-28b4-46fd-8624-2543122c3f37",
                                                "sense_id": "61dc94cb-70bb-3cee-9546-428d3900a9c1",
                                                "text": "“In the fight for voting rights, this vote was the starting gun, not the finish line,” said Senator Chuck Schumer, Democrat of New York and the majority leader. “We will not let it go. We will not let it die. This voter suppression cannot stand.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
