                ],
                "senses": [
                    {
                        "sense_id": "fe687355-8910-372b-b563-61067fcb2a8e",
                        "entry_id": "20b6027c-171f-374a-98ce-ef7444bc1d46",
                        "glosses": [
                            "Museum, das sich hauptsächlich/ausschließlich regionalen Themen widmet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e242b5e-8f3c-473c-8f95-20847bc2ff2b",
                                "sense_id": "fe687355-8910-372b-b563-61067fcb2a8e",
                                "text": "„Das von Grund auf rekonstruierte Fachwerkgebäude ist heute Domizil des 1931 gegründeten Eichsfelder Heimatmuseums Duderstadt.“"
                            },
                            {
                                "example_id": "45d39cdf-088e-4fe8-a2ff-1bb40ecb6d17",
                                "sense_id": "fe687355-8910-372b-b563-61067fcb2a8e",
                                "text": "„Man kann auch - beliebter Ausweg - das Heimatmuseum besuchen.“"
                            },
                            {
                                "example_id": "3929cb98-99ea-489b-b89f-e912cb080f50",
                                "sense_id": "fe687355-8910-372b-b563-61067fcb2a8e",
                                "text": "„All das erzählte mir die Frau im Heimatmuseum von Skógar, zwischen alten Decken und ausgestopften Tieren, und ich hatte einen dieser seltenen Erweckungsmomente.“"
                            },
                            {
                                "example_id": "a7dceab8-01c1-49bc-b841-9d24ad76ed45",
                                "sense_id": "fe687355-8910-372b-b563-61067fcb2a8e",
                                "text": "„Die vielen historisch wertvollen Gegenstände aus dem Alltagsleben der Dorfbewohner und Fischer, die man beim Abriss eines alten Hauses fand, bildeten den Grundstock des 1963 eröffneten Heimatmuseums.“"
                            },
                            {
                                "example_id": "52ba1a1f-7139-4c9d-a3ea-7cd69d6f2ce1",
                                "sense_id": "fe687355-8910-372b-b563-61067fcb2a8e",
                                "text": "„Die klassischen jüdischen Witze bilden eine Art Heimatmuseum der alten Zeit im jüdischen Schtetl und sind inzwischen wie Märchen aus einer verflossenen Zeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
