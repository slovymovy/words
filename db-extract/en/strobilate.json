                        "entry_id": "942d7a4e-5165-3d6e-b394-9007b1ddff4b",
                        "glosses": [
                            "To produce a strobilus or strobila (layered, conelike structure)."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c60f12db-6f4f-4365-81a5-8ea0bc61d336",
                                "sense_id": "7a7d214d-2d8d-3288-b6c2-c38c53dbd069",
                                "text": "So that’s what we try to do, make them strobilate faster."
                            },
                            {
                                "example_id": "86895b7b-9bbe-4b92-ba83-4e8e21350bed",
                                "sense_id": "7a7d214d-2d8d-3288-b6c2-c38c53dbd069",
                                "text": "These, in turn, reproduce by cloning; when conditions are right, they ‘strobilate’, elongating and splitting into a stack of discs which develop into larvae, and break away to become medusae."
                            }
                        ]
                    }
