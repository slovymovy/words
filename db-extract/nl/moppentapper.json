                        "glosses": [
                            "persoon die veel grappen voordraagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f5f452f-0019-4126-985f-74101cb8ffae",
                                "sense_id": "c3361ca9-823d-3ccd-9201-8b11e7f207b8",
                                "text": "Daar stond hij dan gisteravond: premier Rutte als stand-up-comedian en moppentapper tijdens de eerste Nederlandse Correspondents' Dinner. De uit de VS bekende elementen kwamen voorbij: zelfspot, grappen over bekenden, grappen over tegenstanders en grappen over de media. NOS op 3 maakte een selectie van de beste grappen."
                            },
                            {
                                "example_id": "1752ec72-050f-479e-891f-9a4b04d4c4de",
                                "sense_id": "c3361ca9-823d-3ccd-9201-8b11e7f207b8",
                                "text": "In het schnabbelcircuit werd hij een moppentapper van de onderste plank. Zijn laatste optreden vond plaats op de activiteitenmiddag van een bejaardenhuis. De senioren weigerden hun kaartspel te onderbreken voor de grappen van de oud-renner."
                            }
                        ]
                    }
