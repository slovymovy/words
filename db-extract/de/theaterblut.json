                "senses": [
                    {
                        "sense_id": "bd327cc3-00cb-34c9-862e-282b320e3c38",
                        "entry_id": "9d38cee2-f0b1-3b4c-9b71-586dd4cca313",
                        "glosses": [
                            "künstliche Flüssigkeit, die in Aussehen und Konsistenz Blut ähnelt, zur Verwendung in Film und Theater"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214521b0-50c1-49e7-a99d-68a635508b19",
                                "sense_id": "bd327cc3-00cb-34c9-862e-282b320e3c38",
                                "text": "Doch das Blut ist nur Theaterblut, niemand ist wirklich gestorben."
                            },
                            {
                                "example_id": "dd4bc9be-ef7e-4c5a-ac9d-b0d13d76d5a5",
                                "sense_id": "bd327cc3-00cb-34c9-862e-282b320e3c38",
                                "text": "Die Inszenierung sparte sich das Theaterblut, der Mord geschieht außerhalb der Bühne und ist dem Blick des Publikums entzogen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b079ef71-3578-3654-8f72-0a8758606a33",
                        "entry_id": "9d38cee2-f0b1-3b4c-9b71-586dd4cca313",
                        "glosses": [
                            "besonderes Talent oder besonderes Engagement für das Theater"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c2f717-e246-47d2-8351-0e524572a55c",
                                "sense_id": "b079ef71-3578-3654-8f72-0a8758606a33",
                                "text": "Auch in „Romeo und Julia“ spürt man Shakespeares Theaterblut."
                            },
                            {
                                "example_id": "9a1f9852-ebe5-48d4-985b-7df87a511665",
                                "sense_id": "b079ef71-3578-3654-8f72-0a8758606a33",
                                "text": "Die Hauptdarstellerin hat buchstäblich Theaterblut – sie spielt nicht nur großartig, sondern stammt auch aus einer Familie von Schauspielern."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
