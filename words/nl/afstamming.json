                                "target_lang_sense_clarification": "origin or ancestry"
                            },
                            {
                                "target_lang_word": "lineage",
                                "target_lang_sense_clarification": "direct descent from an ancestor"
                            },
                            {
                                "target_lang_word": "ancestry",
                                "target_lang_sense_clarification": "family background or heritage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d739ccf3-9dfa-3ac0-a2e3-5a52cd982d5c",
                    "sense_definition": "De genetische of evolutionaire voorgeschiedenis van een individu, volk of biologische soort.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "herkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>afstamming</w> van de zoogdierorden is dankzij DNA-onderzoek een stuk duidelijker geworden.",
                            "target_lang_translations": {
                                "en": "The <w>descent</w> of mammalian orders has become a lot clearer thanks to DNA research."
                            }
                        },
                        {
                            "text": "Wetenschappers onderzoeken de gemeenschappelijke <w>afstamming</w> van deze vogelsoorten.",
                            "target_lang_translations": {
                                "en": "Scientists are investigating the common <w>ancestry</w> of these bird species."
                            }
