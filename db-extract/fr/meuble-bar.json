                        "entry_id": "118b15f8-3bba-3673-ae9c-885c78675db9",
                        "glosses": [
                            "Meuble destiné à contenir des bouteilles, et éventuellement tout ce qui sert pour servir un apéritif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1be199eb-dd4b-46db-ad1a-97ce0c84feb3",
                                "sense_id": "b441fdfe-0b5a-38aa-92ef-2bf2d47af1b8",
                                "text": "Elle se dirigea vers un petit meuble-bar, tandis que Borko s’installait dans un fauteuil."
                            },
                            {
                                "example_id": "ad211daf-d071-4265-bcca-2e897ee7c85e",
                                "sense_id": "b441fdfe-0b5a-38aa-92ef-2bf2d47af1b8",
                                "text": "En chêne ton ébène, ce meuble-bar a un abattant comme un secrétaire et un support pour les verres."
                            },
                            {
                                "example_id": "d53e7255-cf3d-4ec4-b887-49cd5e992768",
                                "sense_id": "b441fdfe-0b5a-38aa-92ef-2bf2d47af1b8",
                                "text": "Fourniture et installation de meubles-bar au « foyer du soldat » et au « mess mixte » du quartier Soult, à Tarbes (Hautes-Pyrénées)."
                            },
                            {
                                "example_id": "22f361e3-751e-4870-93d3-404675a45aaa",
                                "sense_id": "b441fdfe-0b5a-38aa-92ef-2bf2d47af1b8",
                                "text": "L’habitude du cocktail s’est généralisée : il faut des meubles-bars, des guéridons volants où déposer les verres."
                            }
                        ]
                    }
