                "translations": [
                    {
                        "translation_id": "b086ea38-5ffc-448d-96b4-a23f8d8ec2ff",
                        "source_entry_id": "06b21d00-39fa-3df8-ab23-b0676d959f89",
                        "target_lang_word": "Nachkommenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachkommenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f76a90d-9091-3743-a1ec-8883f128a40f",
                                        "entry_id": "087ae43a-6345-35f1-be70-85722e86600b",
                                        "glosses": [
                                            "Gesamtheit der Nachkommen (Kinder, Enkel, Urenkel, …) einer Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24fae1f3-f479-4574-b1cd-a00999993c31",
                                                "sense_id": "0f76a90d-9091-3743-a1ec-8883f128a40f",
                                                "text": "„Nur für die halbwüchsige Nachkommenschaft ist es vielleicht nicht ohne Reiz, ihre sorgfältig etikettierten Ahnen in geistiger Frische ständig um sich zu haben und sich, statt auf den Knien derselben zu schaukeln, die Nasen an der gläsernen Schutzhülle ihres Ur-Ur-Opas platt zu drücken, um ungezogen hindurchzufeixen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8856e990-6aeb-4fd0-b7ce-dab97db671b8",
                        "source_entry_id": "06b21d00-39fa-3df8-ab23-b0676d959f89",
                        "target_lang_word": "offspring",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offspring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc889f45-8e30-37a3-a7cf-c39f12ad4086",
                                        "entry_id": "1fb906f3-deea-3022-b155-5255d3036262",
                                        "glosses": [
                                            "A person's daughter or son; a person's child."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a02266d-1427-4bc5-b51b-f13d95cfa216",
                                                "sense_id": "cc889f45-8e30-37a3-a7cf-c39f12ad4086",
                                                "text": "We are the offspring of Italian immigrants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df8ffd0-33cf-39d8-a966-d77783c10a15",
                                        "entry_id": "1fb906f3-deea-3022-b155-5255d3036262",
                                        "glosses": [
                                            "Any of a person's descendants, including of further generations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c89ea91a-4f2b-3c2a-8f0c-5b8ec56b6505",
                                        "entry_id": "1fb906f3-deea-3022-b155-5255d3036262",
                                        "glosses": [
                                            "An animal or plant's progeny or young."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63f9081-a92b-48c6-8237-9ab7114a7409",
                                                "sense_id": "c89ea91a-4f2b-3c2a-8f0c-5b8ec56b6505",
                                                "text": "In plants, the ability to recognize self from nonself plays an important role in fertilization, because self-fertilization will result in less diverse offspring than fertilization with pollen from another individual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa1b2691-91c5-32d4-a875-e25a0608751d",
                                        "entry_id": "1fb906f3-deea-3022-b155-5255d3036262",
                                        "glosses": [
                                            "Anything produced; the result of an entity's efforts."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3cabbea-c743-4ea2-b786-697d77373856",
                                                "sense_id": "aa1b2691-91c5-32d4-a875-e25a0608751d",
                                                "text": "Artists often treasure their works as their immortal offspring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39017bb5-8696-3f13-8c9c-b908cd2a0d1b",
                                        "entry_id": "1fb906f3-deea-3022-b155-5255d3036262",
                                        "glosses": [
                                            "A process launched by another process."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fd18eef-ebaf-4a35-a885-4a00018b00ac",
                        "source_entry_id": "06b21d00-39fa-3df8-ab23-b0676d959f89",
                        "target_lang_word": "posterity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "posterity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b5f3b2d-128d-3b74-a45f-a2be73ec1ae4",
                                        "entry_id": "83559fd3-80fe-3c2a-b44a-2c573648d3e9",
                                        "glosses": [
                                            "All the future generations, especially the descendants of a specific person."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1f8b883-588f-481b-b736-17305e5c296d",
                                                "sense_id": "5b5f3b2d-128d-3b74-a45f-a2be73ec1ae4",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway, so that the actual structure which had come down to posterity retained the secret magic of a promise rather than the overpowering splendour of a great architectural achievement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bc42e01-45f1-3ed8-a721-fca88f30cb58",
                                        "entry_id": "83559fd3-80fe-3c2a-b44a-2c573648d3e9",
                                        "glosses": [
                                            "Future audiences, future times, future recognition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b5a51db-0ab3-4460-a84d-314ca599e06d",
                        "source_entry_id": "06b21d00-39fa-3df8-ab23-b0676d959f89",
                        "target_lang_word": "progeny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "progeny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1ec47d2-b03c-3383-97ba-a04f8d93df6c",
                                        "entry_id": "1a32b3b6-d398-3983-b33d-a2b98539f37c",
                                        "glosses": [
                                            "Offspring or descendants considered as a group."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5d68f04-a7f2-4028-84f2-027c435616bc",
                                                "sense_id": "e1ec47d2-b03c-3383-97ba-a04f8d93df6c",
                                                "text": "I treasure this five-generation photograph of my great-great grandmother and her progeny."
                                            },
                                            {
                                                "example_id": "1020f544-7028-4c00-bc42-f9e0a0fabfd5",
                                                "sense_id": "e1ec47d2-b03c-3383-97ba-a04f8d93df6c",
                                                "text": "I should premise that I use the term Struggle for Existence in a large and metaphorical sense, including dependence of one being on another, and including (which is more important) not only the life of the individual, but success in leaving progeny."
                                            },
                                            {
                                                "example_id": "614665bd-be97-4cb2-8e3d-693395abea7d",
                                                "sense_id": "e1ec47d2-b03c-3383-97ba-a04f8d93df6c",
                                                "text": "One worm on a single plate can give rise to thousands of progeny after just a week or so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea1c6113-dbd8-3287-b143-b504d6f1a949",
                                        "entry_id": "1a32b3b6-d398-3983-b33d-a2b98539f37c",
                                        "glosses": [
                                            "Descent, lineage, ancestry."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2533a51-9772-4528-b896-d523217ad9d3",
                                                "sense_id": "ea1c6113-dbd8-3287-b143-b504d6f1a949",
                                                "text": "Beſides, all French and France exclaimes on thee, / Doubting thy Birth and lawfull Progenie. / Who ioyn’ſt thou with, but with a Lordly Nation, / That will not truſt thee, but for profits ſake ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a46009d-e5f4-343e-877d-cef73d3ac55b",
                                        "entry_id": "1a32b3b6-d398-3983-b33d-a2b98539f37c",
                                        "glosses": [
                                            "A result of a creative effort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f99eac49-498f-4bd4-87c2-c9421e43ef21",
                                                "sense_id": "8a46009d-e5f4-343e-877d-cef73d3ac55b",
                                                "text": "His dissertation is his most important intellectual progeny to date."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec4bea5a-e0bb-4f10-ab8b-490d9dcc3503",
                        "source_entry_id": "06b21d00-39fa-3df8-ab23-b0676d959f89",
                        "target_lang_word": "descendance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "descendance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad2a4ff1-6d4d-3d9f-a7c1-086cd21894f1",
                                        "entry_id": "efe90ace-4989-39c7-9735-c98b2c43b24d",
                                        "glosses": [
                                            "Progéniture, ensemble des individus issus d’une reproduction sexuée ou asexuée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f041cad1-21d8-4ecc-a5ba-dfc22238714f",
                                                "sense_id": "ad2a4ff1-6d4d-3d9f-a7c1-086cd21894f1",
                                                "text": "M. Leblond, […], a calculé la corrélation entre taux butyreux et teneur en matières azotées pour les descendances des 20 taureaux Frisons et des 21 taureaux Normands […]."
                                            },
                                            {
                                                "example_id": "8f581333-7f5f-4678-af47-6889360e2a1d",
                                                "sense_id": "ad2a4ff1-6d4d-3d9f-a7c1-086cd21894f1",
                                                "text": "Graines ailées, aigrettées, duvetées, enveloppées de gourmandise et en appelant à l'oiseau ! de quelle ingéniosité fait preuve chaque plante pour éparpiller le plus loin possible d’elle sa descendance !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53276a27-5bd0-3cbf-b047-dfc11412c5a5",
                                        "entry_id": "efe90ace-4989-39c7-9735-c98b2c43b24d",
                                        "glosses": [
                                            "Lignée généalogique, lignage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aad87aca-a926-4bf8-b246-613fd383ab3b",
                                                "sense_id": "53276a27-5bd0-3cbf-b047-dfc11412c5a5",
                                                "text": "Dans les rues se croisaient des Panamaniens bronzés de pure descendance espagnole, des nègres de la Jamaïque, […]."
                                            },
                                            {
                                                "example_id": "b6080479-615e-41e0-9ef2-4ea9b9243325",
                                                "sense_id": "53276a27-5bd0-3cbf-b047-dfc11412c5a5",
                                                "text": "Il prétend qu’il est de cette maison, mais sans établir clairement sa descendance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
