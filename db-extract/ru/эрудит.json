                ],
                "translations": [
                    {
                        "translation_id": "b183497a-f212-41e2-96c3-9d9764fd98ac",
                        "source_entry_id": "01a7537c-89c6-324b-b6e5-48ed9d6ac795",
                        "source_sense_id": "e9b54a19-e98f-3f4d-82a6-2ee6395294e6",
                        "target_lang_word": "erudite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erudite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c481eaf0-3d93-385d-aa4f-b26712a3ba6d",
                                        "entry_id": "9d44883e-4e6f-3e9d-889f-c784400d1654",
                                        "glosses": [
                                            "Learned, scholarly, with emphasis on knowledge gained from books."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "583587a7-3cb9-4147-a069-bfc9f927d071",
                                                "sense_id": "c481eaf0-3d93-385d-aa4f-b26712a3ba6d",
                                                "text": "The professor gave an erudite lecture that impressed everyone in the audience."
                                            },
                                            {
                                                "example_id": "e51c0027-5ece-4fa3-ab25-47f5425a8d07",
                                                "sense_id": "c481eaf0-3d93-385d-aa4f-b26712a3ba6d",
                                                "text": "His erudite knowledge of ancient history made him a sought-after speaker."
                                            },
                                            {
                                                "example_id": "f52e6684-9ced-4f56-8342-3b1bd63b125c",
                                                "sense_id": "c481eaf0-3d93-385d-aa4f-b26712a3ba6d",
                                                "text": "She was praised for her erudite contributions to the academic journal."
                                            },
                                            {
                                                "example_id": "6e4bd2c8-5b01-48e1-8e90-fd6d7bb93b6a",
                                                "sense_id": "c481eaf0-3d93-385d-aa4f-b26712a3ba6d",
                                                "text": "At all events, if it involved any secret information in regard to old Roger Chillingworth, it was in a tongue unknown to the erudite clergyman, and did but increase the bewilderment of his mind."
                                            },
                                            {
                                                "example_id": "d4e91df2-f233-41c9-bc4c-45a4f42aeef6",
                                                "sense_id": "c481eaf0-3d93-385d-aa4f-b26712a3ba6d",
                                                "text": "Elmer Moffatt had been magnificent, rolling out his alternating effects of humour and pathos, stirring his audience by moving references to the Blue and the Gray, convulsing them by a new version of Washington and the Cherry Tree […], dazzling them by his erudite allusions and apt quotations."
                                            },
                                            {
                                                "example_id": "34195d9d-74e1-4380-a7aa-5631d2f35a43",
                                                "sense_id": "c481eaf0-3d93-385d-aa4f-b26712a3ba6d",
                                                "text": "THE CONCISE ENCYCLOPAEDIA OF WORLD RAILWAY LOCOMOTIVES. Edited by P. Ransome-Wallis. Hutchinson. 50s. [...] The most erudite locomotive engineer could not fail to excavate new knowledge from this remarkably comprehensive volume, [...]"
                                            },
                                            {
                                                "example_id": "707941c6-6164-40a0-a1e2-fc15e04bbc7b",
                                                "sense_id": "c481eaf0-3d93-385d-aa4f-b26712a3ba6d",
                                                "text": "Perhaps his erudite mind does not quite yet grasp how to transform his beloved scholarly explorations into effective papal politics."
                                            },
                                            {
                                                "example_id": "fc8d2b4f-7ed4-4d3a-b1d9-8c34c2c68837",
                                                "sense_id": "c481eaf0-3d93-385d-aa4f-b26712a3ba6d",
                                                "text": "Cruz was obviously analogizing Bernie Sanders to the Bolsheviks and Hillary Clinton to the Mensheviks. The oleaginous Texan is an erudite slyboots, but his history is off-kilter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
