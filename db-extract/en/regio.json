                    },
                    {
                        "sense_id": "d3182e87-80d0-300f-b78e-b842a22662de",
                        "entry_id": "82d842f2-a0f6-367a-baf1-0eb54191863c",
                        "glosses": [
                            "A district of a city."
                        ],
                        "tags": [
                            "Ancient-Rome"
                        ],
                        "examples": [
                            {
                                "example_id": "f418a4e8-9dab-4986-8acd-9c2cf37cad53",
                                "sense_id": "d3182e87-80d0-300f-b78e-b842a22662de",
                                "text": "The British School has unearthed a city of continuous houses, more than 400 feet long by 350 broad, whose many blocks or \"insul[ae]\" might seem almost to need the more elaborate grouping of the \"regiones\" of Pompeii."
                            }
                        ]
                    }
                ],
