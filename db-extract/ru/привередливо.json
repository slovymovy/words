        "ru-extract.jsonl": [
            {
                "entry_id": "19487029-3ed3-35d8-b0cd-c2856dd2ef12",
                "word": "привередливо",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6390aad8-3bbe-3894-91da-f71eab2943b0",
                        "entry_id": "19487029-3ed3-35d8-b0cd-c2856dd2ef12",
                        "glosses": [
                            "разг. наречие к привередливый; проявляя излишнюю разборчивость, требовательность"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "a3525d08-b870-41cb-b63b-352708ab3f0d",
                                "sense_id": "6390aad8-3bbe-3894-91da-f71eab2943b0",
                                "text": "На улице остались только вертоголовые курицы и горделивые петухи, привередливо оберегавшие свои границы от вторжения одноплеменных неприятелей, да посреди дороги стоял в недоумкнии телёнок, да ещё красная девка проплыла мимо с вёдрами на плечах."
                            },
                            {
                                "example_id": "f07a4242-abb6-4140-b910-ed2b66af401b",
                                "sense_id": "6390aad8-3bbe-3894-91da-f71eab2943b0",
                                "text": "Придирчиво и привередливо отбирались даже не слова ― знаки препинания…"
                            }
                        ]
                    }
                ],
