                "senses": [
                    {
                        "sense_id": "ceb1ec71-1926-301e-9839-37bfe9773221",
                        "entry_id": "0dedd5b1-f08a-37bb-b66a-a60aa1314da8",
                        "glosses": [
                            "die Wahrscheinlichkeit, dass an einem bestimmen Ort in einem bestimmten Vorhersagezeitraum regnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "950a9938-2a14-4c5e-8a24-da38b60d97eb",
                                "sense_id": "ceb1ec71-1926-301e-9839-37bfe9773221",
                                "text": "Morgen haben wir eine Regenwahrscheinlichkeit von 80% – wir sollten einen Schirm mitnehmen!"
                            },
                            {
                                "example_id": "3c247fa2-ad43-4843-a913-44bb0bd622cf",
                                "sense_id": "ceb1ec71-1926-301e-9839-37bfe9773221",
                                "text": "Eine achzigprozentige Regenwahrscheinlichkeit für den morgigen Tag bedeutet, dass es an 80% der Tage regnet, die durch die gleiche Wetterlage charakterisiert sind wie der morgige Tag."
                            },
                            {
                                "example_id": "cf413774-c333-4882-9169-7d1e2b8fe385",
                                "sense_id": "ceb1ec71-1926-301e-9839-37bfe9773221",
                                "text": "„Eine Berlinerin meinte, dass bei dieser Regenwahrscheinlichkeit dreißig von hundert Wolken schwarz sein müssten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
