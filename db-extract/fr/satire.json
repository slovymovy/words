        "fr-extract.jsonl": [
            {
                "entry_id": "d801f4ed-21b5-36b4-be41-16b009f286f2",
                "word": "satire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "129f23a4-ba36-4af1-a4e2-9095eed7dc37",
                        "entry_id": "d801f4ed-21b5-36b4-be41-16b009f286f2",
                        "tags": [
                            "plural"
                        ],
                        "form": "satires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c342128-3a5d-393c-9de6-7e78bd39fe7b",
                        "entry_id": "d801f4ed-21b5-36b4-be41-16b009f286f2",
                        "glosses": [
                            "À Rome, forme de pièce de théâtre en partie chantée."
                        ],
                        "tags": [
                            "Primitivement"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "efc0cd80-b774-349f-b3ce-36743ffbba91",
                        "entry_id": "d801f4ed-21b5-36b4-be41-16b009f286f2",
                        "glosses": [
                            "Ouvrage en vers, fait pour reprendre, pour tourner en ridicule, pour châtier les vices et les sottises des hommes."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "36e5c113-ee65-4279-87aa-cd1bf4c67b96",
                                "sense_id": "efc0cd80-b774-349f-b3ce-36743ffbba91",
                                "text": "L’ardeur de se montrer, et non pas de médire,\nArma la Vérité du vers de la satire."
                            }
                        ]
                    },
                    {
                        "sense_id": "57f0d9f2-a300-3cf1-bebf-1e3a09c9e688",
                        "entry_id": "d801f4ed-21b5-36b4-be41-16b009f286f2",
                        "glosses": [
                            "Certains ouvrages de longue haleine, ordinairement mêlés de prose et de vers, qui sont faits dans la même intention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5caacb51-a689-46ea-9b76-2bed003e1126",
                                "sense_id": "57f0d9f2-a300-3cf1-bebf-1e3a09c9e688",
                                "text": "Satire d’Horace, de Juvénal, de Boileau."
                            },
                            {
                                "example_id": "8049fb53-49f1-4ded-8946-0614190a53f8",
                                "sense_id": "57f0d9f2-a300-3cf1-bebf-1e3a09c9e688",
                                "text": "Satire contre l’avarice, contre l’ambition."
                            },
                            {
                                "example_id": "9c7c10fc-4704-42c1-abb1-e83f074369ba",
                                "sense_id": "57f0d9f2-a300-3cf1-bebf-1e3a09c9e688",
                                "text": "On a fait contre lui une satire qui le couvre de ridicule."
                            },
                            {
                                "example_id": "5d6adb69-0cc8-4e02-be1d-a71ba07031dc",
                                "sense_id": "57f0d9f2-a300-3cf1-bebf-1e3a09c9e688",
                                "text": "La troisième est une ère prosaïque et pédantesque; à elle la dernière partie du Roman de la Rose, recueil de science aride, dans lequel il n’y a de remarquable que la satire, la satire toujours puissante contre une époque qui approche de sa fin."
                            }
                        ]
                    },
                    {
                        "sense_id": "43be8a99-3f12-31cf-9527-fa9329fcde20",
                        "entry_id": "d801f4ed-21b5-36b4-be41-16b009f286f2",
                        "glosses": [
                            "Tout écrit ou discours piquant, mordant contre quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3fef4c3-7e88-43e6-a328-fb90689754a6",
                                "sense_id": "43be8a99-3f12-31cf-9527-fa9329fcde20",
                                "text": "Cela n’est rien. Un philosophe sait recevoir comme il faut les choses, et je vais composer contre eux une satire du style de Juvénal, qui les déchirera de la belle façon."
                            },
                            {
                                "example_id": "3298f186-1cf2-40cf-9ba4-13923bab6565",
                                "sense_id": "43be8a99-3f12-31cf-9527-fa9329fcde20",
                                "text": "Ainsi, dans le cadre de la satire des financiers, nous trouvons des allusions nombreuses à l'origine petite-bourgeoise des grands du jour: avoir exercé jadis le métier de cordonnier, de fripier ou d'usurier constitue ipso facto une tare aux yeux de l'opinion."
                            }
                        ]
                    },
                    {
                        "sense_id": "9323cf3b-bcec-3e15-8138-4a47b7ef868c",
                        "entry_id": "d801f4ed-21b5-36b4-be41-16b009f286f2",
                        "glosses": [
                            "Le genre satirique."
                        ],
                        "tags": [
                            "Absolument"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "922cdeaa-4499-3c18-ac65-36928167d915",
                        "entry_id": "d801f4ed-21b5-36b4-be41-16b009f286f2",
                        "glosses": [
                            "Imitation railleuse ou accusatrice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc95370-86bf-4197-8b68-7d7e210f9c01",
                                "sense_id": "922cdeaa-4499-3c18-ac65-36928167d915",
                                "text": "Sa conduite est la satire de la vôtre, L’honnêteté, la régularité de sa conduite fait remarquer davantage les torts de la vôtre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3ad40bf-144a-449f-9178-c958a56c1846",
                        "source_entry_id": "d801f4ed-21b5-36b4-be41-16b009f286f2",
                        "source_sense_id": "9323cf3b-bcec-3e15-8138-4a47b7ef868c",
                        "source_sense_description": "genre satirique",
                        "target_lang_word": "satire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffdff484-c0b7-30ca-9ac5-91b775036d3b",
                                        "entry_id": "62ef30b7-9a47-312b-b220-bd7f2100d4f9",
                                        "glosses": [
                                            "A literary device of writing or art which principally ridicules its subject often as an intended means of provoking or preventing change or highlighting a shortcoming in the work of another. Imitation, humor, irony, and exaggeration are often used to aid this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f259d0d0-2379-49ba-9e4c-7007e7721d13",
                                                "sense_id": "ffdff484-c0b7-30ca-9ac5-91b775036d3b",
                                                "text": "Satire deflates and debases. It is an art which topples greatness, undermines pretension and punishes pride by revealing the low in the pretendedly high, the filth in the pure, the folly in reason. This belittling trick deploys telescopic lenses which picture the human as lesser and lower, or as a machine or beast, driven by depraved desires. Satire reduces what purports to be subtly superior to a repertoire of stigmatizing symbols and cardboard cut-outs, turning character into caricature, signalled by exaggerated physiognomical distortions - the huge nose, gaping mouth and bloated belly, or comparable animalistic traits. In this humbling of the complex into the simplistic, satire finally reduces the mind, soul or spirit to that flesh which always bespeaks inferiority on the Chain of Being."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7a20306-b953-3e43-b3d6-8f7d35c7b5dd",
                                        "entry_id": "62ef30b7-9a47-312b-b220-bd7f2100d4f9",
                                        "glosses": [
                                            "A satirical work."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4571c644-7679-4012-8bb0-7f92e455d292",
                                                "sense_id": "d7a20306-b953-3e43-b3d6-8f7d35c7b5dd",
                                                "text": "a stinging satire of American politics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47d5b9c2-5ede-362a-9ccf-dec470e4de96",
                                        "entry_id": "62ef30b7-9a47-312b-b220-bd7f2100d4f9",
                                        "glosses": [
                                            "Severity of remark."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a5cedbb-b688-4959-8e6d-dae68c8a6f6d",
                                                "sense_id": "47d5b9c2-5ede-362a-9ccf-dec470e4de96",
                                                "text": "CAESAR. No, by the gods! would that it had been! Vengeance at least is human. No, I say: those severed right hands, and the brave Vercingetorix basely strangled in a vault beneath the Capitol, were (with shuddering satire) a wise severity, a necessary protection to the commonwealth, a duty of statesmanship—follies and fictions ten times bloodier than honest vengeance!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39a2e419-0277-4f93-9def-a20f18376d0a",
                        "source_entry_id": "d801f4ed-21b5-36b4-be41-16b009f286f2",
                        "source_sense_id": "9323cf3b-bcec-3e15-8138-4a47b7ef868c",
                        "source_sense_description": "genre satirique",
                        "target_lang_word": "satira",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satira",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "68bcb66e-6cec-34f0-a825-a570186dd4fa",
                                        "entry_id": "80b87260-75e2-3b61-bac9-9d9c6133992d",
                                        "glosses": [
                                            "genere letterario, inerente alla poesia, che “prende in giro” con irrisione il modo di fare di una o più persone specifiche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67f1e1bd-5543-4b4b-a2cc-a885d8429899",
                                                "sense_id": "68bcb66e-6cec-34f0-a825-a570186dd4fa",
                                                "text": "l’inzuccazione è tra le prime opere di satira politica… e si studia nei programmi scolastici della letteratura latina"
                                            },
                                            {
                                                "example_id": "b2407d0c-1b66-477d-a19d-5c330a00b239",
                                                "sense_id": "68bcb66e-6cec-34f0-a825-a570186dd4fa",
                                                "text": "storicamente la letteratura inglese è forse la più spietata per una satira che colpì persino le corti dei loro tribunali per ipocrisia e lo sfoggio plateale di una vana formalità inutile appunto ed a dir poco patetica"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d2b1f49-e3a4-3692-9d15-74333b7984a5",
                                        "entry_id": "80b87260-75e2-3b61-bac9-9d9c6133992d",
                                        "glosses": [
                                            "monologo che si prefigge di “mettere qualcuno in ridicolo”"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c224acfc-4619-3e70-b79a-44a4c4ad1181",
                                        "entry_id": "80b87260-75e2-3b61-bac9-9d9c6133992d",
                                        "glosses": [
                                            "quasi un genere artistico, è la semi-derisione o anche l’autoironia di persone cosiddette famose e/o celebri, di loro “categorie” o di qualcosa solitamente “troppo serio o affrontato in modo esageratamente serioso”, talvolta con lo scopo di evidenziare verità a loro “scomode” appunto; avviene con “vignette o disegni vari e caricature”, a teatro ed in televisione o nel cinema, anche nella musica e nell’arte in genere, come già detto in “brani, racconti o brevi scritti”, ecc"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d818d67-f711-49d2-b41e-5e104fbca76d",
                                                "sense_id": "c224acfc-4619-3e70-b79a-44a4c4ad1181",
                                                "text": "la satira contro Berlusconi ha raggiunto il massimo su Youtube con la canzone “C’Hai Rotto Il Cazzo”"
                                            },
                                            {
                                                "example_id": "332cbc29-47e4-474a-accc-7a6dd9b56378",
                                                "sense_id": "c224acfc-4619-3e70-b79a-44a4c4ad1181",
                                                "text": "dopo le mitiche canzoni mixate di Leone Di Lernia, anche l’attore comico Enzo Salvi ha fatto satira con “Va Va Va”, per il malcontento generale ma in modo allegro, simpatico e scherzoso"
                                            },
                                            {
                                                "example_id": "7e654174-4434-47c1-aac8-d9abf123bb43",
                                                "sense_id": "c224acfc-4619-3e70-b79a-44a4c4ad1181",
                                                "text": "con elaborazioni e montaggi o fotomontaggi, anche persone molto note come, per esempio, il senatore Matteo Renzi “con la loro pressoché parziale collaborazione nella satira”… possono essere un soggetto artisticamente interessante oltre ogni aspettativa e con la meraviglia di tutti"
                                            },
                                            {
                                                "example_id": "8a90bcde-1b43-46fb-9bbb-4f2db71eaaf7",
                                                "sense_id": "c224acfc-4619-3e70-b79a-44a4c4ad1181",
                                                "text": "ridicolizzazione solenne e glaciale di abitudini di alcuni molto benestanti tour estivi, la satira della canzone con la presidente del consiglio Giorgia Meloni “CAVIALE” gioca sulla contrapposizione con la questione dei migranti"
                                            },
                                            {
                                                "example_id": "da4ce098-fba8-472d-911e-53e642f8f295",
                                                "sense_id": "c224acfc-4619-3e70-b79a-44a4c4ad1181",
                                                "text": "con migliaia e migliaia di opere, Forattini è stato tra i più grandi vignettisti della satira politica"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
