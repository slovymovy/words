                        "entry_id": "5e73f5b2-ec3e-3cfa-a87b-c995a8939b5b",
                        "glosses": [
                            "grobe Säge für Baumfäller und Zimmerleute, die von zwei Personen bedient wird, zum Sägen schwerer Balken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e75717cc-43bf-43cb-95cf-7d1151b915c6",
                                "sense_id": "56a7624b-b2cb-326c-95e8-1e0049ad6462",
                                "text": "„Horst Baumann stellte die Trummsäge seines Großvaters zum Verbleib beim Heimatverein bereit.“"
                            },
                            {
                                "example_id": "01ed7f5b-7247-4fdc-afa2-6ce4af303ee5",
                                "sense_id": "56a7624b-b2cb-326c-95e8-1e0049ad6462",
                                "text": "„Die Trummsäge ist heute durch den Einsatz von Motorsägen fast vollständig verdrängt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
