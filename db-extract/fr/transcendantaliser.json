                "senses": [
                    {
                        "sense_id": "54995195-91c9-3d14-863d-a34170d7b275",
                        "entry_id": "1354a9dd-449e-37d2-8426-616a9a6f4b33",
                        "glosses": [
                            "Donner un caractère transcendantal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e1da34d-9f9d-4764-844c-ec4e83daaf30",
                                "sense_id": "54995195-91c9-3d14-863d-a34170d7b275",
                                "text": "La pensée qui transcendantalise l'être ou qui, à l'inverse, le matérialise et l'atomise, vide la réalité de sa substance et cela à deux niveaux."
                            },
                            {
                                "example_id": "eb283963-f785-4823-a71b-21e0e8ecb04e",
                                "sense_id": "54995195-91c9-3d14-863d-a34170d7b275",
                                "text": "Est-ce à dire que cette démarche théorique transcendantalise la motilité sémiotique, qu'elle la constitue en un Signifiant transcendantal ?"
                            }
                        ]
                    }
                ],
