                                "target_senses": [
                                    {
                                        "sense_id": "76811112-8a41-3786-b431-7b79d5ecabd1",
                                        "entry_id": "74f40535-c58a-34b7-bdcf-aa1821066588",
                                        "glosses": [
                                            "Surnom populaire de l’équipe de hockey sur glace des Canadiens de Montréal."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06b57fd4-19d0-4349-9c46-1c1ba7e012f6",
                                                "sense_id": "76811112-8a41-3786-b431-7b79d5ecabd1",
                                                "text": "Par ailleurs, le Tricolore a cédé l'attaquant Ryan Poehling et le défenseur Cale Fleury à son club-école de la Ligue américaine de hockey, le Rocket de Laval."
                                            },
                                            {
                                                "example_id": "308e54e0-1126-4e8a-9d0d-aa414c522617",
                                                "sense_id": "76811112-8a41-3786-b431-7b79d5ecabd1",
                                                "text": "Dans le cas de Suzuki, l’entraîneur du Tricolore a cessé de l’utiliser contre les meilleurs trios adverses, redonnant cette mission à Philip Danault qui est toujours en quête d’un premier but cette saison."
                                            },
                                            {
                                                "example_id": "a0c2ec59-85d3-4aa2-8bb2-c40cec309133",
                                                "sense_id": "76811112-8a41-3786-b431-7b79d5ecabd1",
                                                "text": "C’est en fouillant récemment dans des archives que Carl Lavigne, historien du Canadien, a découvert qu’une autre tempête avait déjà obligé les autorités du circuit a repousser un match du Tricolore."
                                            },
                                            {
                                                "example_id": "61da5aa9-3f1f-4fe8-9a8c-a16d5d11c713",
                                                "sense_id": "76811112-8a41-3786-b431-7b79d5ecabd1",
                                                "text": "Lors du dernier match du Tricolore, mardi soir, Price avait pourtant réussi un jeu blanc contre les Oilers d’Edmonton. Or, on devine que le numéro 31 sera de retour à son poste, samedi à Montréal, lors d’un autre duel entre le Canadien et les Sénateurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
