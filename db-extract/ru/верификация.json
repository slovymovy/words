                                        "entry_id": "7837342a-525a-3357-9e5b-3d2c9ab02030",
                                        "glosses": [
                                            "A checking account."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77478c3e-fa16-4c41-bb86-2fe52fac921c",
                                                "sense_id": "a2d4b462-fc16-306f-b881-60e27d0da473",
                                                "text": "Withdraw $5000 from checking and put it into savings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "563d4119-c3c8-39f0-9fed-a03f7ea06620",
                                        "entry_id": "7837342a-525a-3357-9e5b-3d2c9ab02030",
                                        "glosses": [
                                            "An act whereby one checks something or someone (in any sense)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21dbb53e-5a68-45ca-9cb2-e245f86b82c4",
                                                "sense_id": "563d4119-c3c8-39f0-9fed-a03f7ea06620",
                                                "text": "The gin had a delayed reaction. Its effect didn't become felt until Valerie had, after a wearisome walk and numerous checkings of her map, reached the flat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3162b173-f262-359f-b9e4-5329151ab8b3",
                                        "entry_id": "7837342a-525a-3357-9e5b-3d2c9ab02030",
                                        "glosses": [
                                            "The crossing of solutions in a grid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0443f9fa-811a-42b2-86ac-dfe9609b3066",
                                                "sense_id": "3162b173-f262-359f-b9e4-5329151ab8b3",
                                                "text": "One must reckon to solve at least three of the Playfair clues independently before cracking the code and getting checking to help with solving the fourth."
                                            },
                                            {
                                                "example_id": "f9f8bd18-aa35-4db4-89a6-a4ffffca753d",
                                                "sense_id": "3162b173-f262-359f-b9e4-5329151ab8b3",
                                                "text": "What about the corpus of Ximenes - Azed specials? In 'Printer's Devilry' checking is normal but the clues are special."
                                            },
                                            {
                                                "example_id": "0a1d341b-166a-417d-8521-de4e79a31699",
                                                "sense_id": "3162b173-f262-359f-b9e4-5329151ab8b3",
                                                "text": "An added complication is that double definition answers are often very short, typically between four and six letters long, so there are lots of possibilities even when you have checking letters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
