                "senses": [
                    {
                        "sense_id": "78e2f328-2953-37ab-b080-16675aef88a3",
                        "entry_id": "51e70102-23b1-3ddb-8660-729f22c960b2",
                        "glosses": [
                            "Rendre gaillard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78cef1cb-783a-4495-92be-767df152c009",
                                "sense_id": "78e2f328-2953-37ab-b080-16675aef88a3",
                                "text": "Et si c’était un vieux, des petits drôles, arrivant tandis qu’on mangeait la soupe, on leur en donnait avec un chabrol après, pour les gaillardir."
                            },
                            {
                                "example_id": "7996b0da-4222-46b4-98c3-f4e74a2a4c63",
                                "sense_id": "78e2f328-2953-37ab-b080-16675aef88a3",
                                "text": "Sous les évolutions des mouettes, j’avais arpenté la digue, résolument gaillardi. Eh oui! jouissant d’un mental et d’un physique à toute épreuve, je n’avais nul besoin de l’être à nouveau, j’étais gaillard, c’est tout."
                            }
                        ]
                    }
                ],
