                "senses": [
                    {
                        "sense_id": "844b75d3-19ab-3b0b-ae42-4d7762e646bc",
                        "entry_id": "6b31aa72-f0cd-38f9-a32b-895ffcf1f88c",
                        "glosses": [
                            "Relatif au Silurien, système de terrains appartenant à l’époque primaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb47a6f2-210c-4ee2-b4b1-6cabd09cf926",
                                "sense_id": "844b75d3-19ab-3b0b-ae42-4d7762e646bc",
                                "text": "Les terrains siluriens sont riches en fossiles."
                            },
                            {
                                "example_id": "6205ee16-05e7-4a43-bece-a0195a826172",
                                "sense_id": "844b75d3-19ab-3b0b-ae42-4d7762e646bc",
                                "text": "Des fougères gigantesques croissaient sur leurs bords, et dans des conditions analogues à celles de la végétation silurienne."
                            },
                            {
                                "example_id": "9c00b9ab-5f18-41f5-8baa-d89c0aba4146",
                                "sense_id": "844b75d3-19ab-3b0b-ae42-4d7762e646bc",
                                "text": "Sous ce ciel ténébreux, on eût dit une scène reconstituée de la paléontologie, — une de ces bandes de bêtes rudimentaires et monstrueuses comme il en passait jadis sur la mer sans rivage de l’époque silurienne…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ab1f13e-d6ed-43fd-b24e-fec6a26df41b",
                        "source_entry_id": "6b31aa72-f0cd-38f9-a32b-895ffcf1f88c",
                        "source_sense_id": "844b75d3-19ab-3b0b-ae42-4d7762e646bc",
