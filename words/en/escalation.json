                    "frequency": "Middle",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>escalation</w> of demands from the union made reaching an agreement very difficult."
                        },
                        {
                            "text": "We must avoid the <w>escalation</w> of this minor disagreement into a full-blown argument."
