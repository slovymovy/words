                            },
                            {
                                "target_lang_word": "saçma",
                                "target_lang_sense_clarification": "eğlendirici veya komik bir şekilde anlamsız"
                            },
                            {
                                "target_lang_word": "komik",
                                "target_lang_sense_clarification": "güldürücü ve oyuncu"
                            }
                        ],
                        "de": [
