                                "target_senses": [
                                    {
                                        "sense_id": "c2acb690-07d3-3d0e-8c1f-3f30c6f82875",
                                        "entry_id": "31d75ca3-187c-3636-bf7c-a2831938bd66",
                                        "glosses": [
                                            "zwolennik abolicjonizmu, ruchu społecznego domagającego się zniesienia jakiegoś prawa"
                                        ],
                                        "tags": [],
