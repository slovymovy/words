                "senses": [
                    {
                        "sense_id": "f5e1d0fc-8aa1-3c01-bed8-6b8a561900a3",
                        "entry_id": "055dfa21-ff34-3bbc-bbd5-2213b1edaf52",
                        "glosses": [
                            "Maßnahmen, die der Erhaltung der Sauberkeit der Nase / des Naseninnenraumes dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddfa020f-90ae-4384-8b0a-8956b8597bc5",
                                "sense_id": "f5e1d0fc-8aa1-3c01-bed8-6b8a561900a3",
                                "text": "„So bildet denn jetzt eine gründliche Zahnpflege einen wichtigen Teil auch der Nasenhygiene und der Verhütung von Nasenkrankheiten.“"
                            },
                            {
                                "example_id": "b301b114-a7bf-499d-a475-9407b83b1512",
                                "sense_id": "f5e1d0fc-8aa1-3c01-bed8-6b8a561900a3",
                                "text": "„Er hat makellose Fingernägel und – weit sich das noch erkennen lässt – eine tadellose Mund- und Nasenhygiene sowie unversehrte Arme.“"
                            },
                            {
                                "example_id": "fbfeda31-a8fc-4f62-8183-5a82dc4197c2",
                                "sense_id": "f5e1d0fc-8aa1-3c01-bed8-6b8a561900a3",
                                "text": "„Sie legen großen Wert auf Nasenhygiene, da wir tagtäglich mehrere Tausend Liter Luft durch Nase und Mund ein- und ausatmen.“"
                            },
                            {
                                "example_id": "15e75092-4589-49ac-b9df-37f60ac0d429",
                                "sense_id": "f5e1d0fc-8aa1-3c01-bed8-6b8a561900a3",
                                "text": "„Für die Nachbehandlung speziell dieser Fälle ist eine sorgfältige Nasenhygiene und Prophylaxe durch abschwellende Medikamente, milde Nasenemulsionen sowie Inhalationen erforderlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
