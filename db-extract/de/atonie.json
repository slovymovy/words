                "senses": [
                    {
                        "sense_id": "ac351a60-047b-3cb8-8562-75393af4669d",
                        "entry_id": "fc6fbae8-8921-3cdd-b82b-615975463df5",
                        "glosses": [
                            "Schlaffheit, Erschlaffung der Muskulatur wegen fehlender Muskelspannung (Tonus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "127a7cb5-8cc7-4229-8c7b-5025c183ac17",
                                "sense_id": "ac351a60-047b-3cb8-8562-75393af4669d",
                                "text": "Hier begann die Geschichte des Badens im Meer. Anfangs hieß es, es helfe gegen \"Entnervung, Rheumatismen und Atonie der Eingeweide\"."
                            },
                            {
                                "example_id": "d09a06d8-eca3-40fb-863c-c1bc0336e2d9",
                                "sense_id": "ac351a60-047b-3cb8-8562-75393af4669d",
                                "text": "Die neue Theorie könnte auch erklären, warum die Patienten, bei denen die Atonie streikt, in der Nacht aufwachen und sich in Berserker verwandeln."
                            },
                            {
                                "example_id": "cb8d7a90-58be-4422-ad82-e09fdff89b6f",
                                "sense_id": "ac351a60-047b-3cb8-8562-75393af4669d",
                                "text": "Das ist insbesondere nach Geburten möglich, wenn sich die Gebärmutter nicht zusammenzieht (sogenannte \"Atonie\") oder wenn es zu einem Riss der Gebärmutterwand gekommen ist (sogenannte \"Uterusruptur\")."
                            },
                            {
                                "example_id": "dd82315c-b1cb-494b-909f-60ca043c8a31",
                                "sense_id": "ac351a60-047b-3cb8-8562-75393af4669d",
                                "text": "Bei einer Analyse der Ursachen für die postpartale Blutung zeigt sich vor allem ein Anstieg der Atonien."
                            },
                            {
                                "example_id": "7ef12348-1fd6-4ab9-843d-54a6f0b2a154",
                                "sense_id": "ac351a60-047b-3cb8-8562-75393af4669d",
                                "text": "Die Labmagenverlagerung ist eine sogenannte Leistungskrankheit, der ein multifaktorieller Ursachenkomplex zugrunde liegt. Die primäre Ursachenfolge ist eine Atonie (Muskelwandschwäche) des Labmagens."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
