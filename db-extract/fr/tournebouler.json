                ],
                "senses": [
                    {
                        "sense_id": "2892842b-bd78-3d43-9531-8059d5b71c5f",
                        "entry_id": "c2e5e024-873f-3c7b-9d82-ab5542d4f5cf",
                        "glosses": [
                            "Mettre dans tous ses états, bouleverser, tourner et retourner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b46ace8-57ff-4c2d-82e4-3b057e10f4cf",
                                "sense_id": "2892842b-bd78-3d43-9531-8059d5b71c5f",
                                "text": "Qu’est-ce que tu voulais que j’en foute de tes pages d’écriture ? Tu n’espérais pas m’en tournebouler, non ?"
                            },
                            {
                                "example_id": "cd4323fe-1e5d-4c8a-ad68-757bfdc06454",
                                "sense_id": "2892842b-bd78-3d43-9531-8059d5b71c5f",
                                "text": "J’ai la boule au plafond\nqui tourne, qui riboule, tourneboule"
                            },
                            {
                                "example_id": "d8fe6b00-6d63-4126-91a8-37ab3ee09633",
                                "sense_id": "2892842b-bd78-3d43-9531-8059d5b71c5f",
                                "text": "Il y avait là de quoi vous tournebouler, le fils qui sauve son père."
                            },
                            {
                                "example_id": "3dd8e413-8e2b-4501-9c73-0df87c5f4511",
                                "sense_id": "2892842b-bd78-3d43-9531-8059d5b71c5f",
                                "text": "les doigts de sa main passaient et repassaient sur son front brûlé par le soleil, comme si ses gros doigts avaient le pouvoir de calmer les idées noires qui, comme à moi, comme à ma sœur, comme à mon beau-frère, nous tourneboulaient la tête"
                            }
                        ]
                    }
