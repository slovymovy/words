{
    "word_family": [
        "sonneteer",
        "sonneting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc12c160-f030-33e9-a3c5-162301237392",
                    "sense_definition": "A poem of fourteen lines that follows a specific rhyme scheme and rhythm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "poetry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet wrote a beautiful <w>sonnet</w> about the changing seasons.",
                            "target_lang_translations": {
                                "zh": "诗人写了一首关于四季更迭的优美<w>十四行诗</w>。"
                            }
                        },
                        {
                            "text": "Students analyzed the <w>sonnet</w> structure during the literature class.",
                            "target_lang_translations": {
                                "zh": "学生们在文学课上分析了<w>十四行诗</w>的结构。"
                            }
                        }
                    ],
                    "synonyms": [
                        "poem"
                    ],
                    "common_phrases": [
                        "write a sonnet",
                        "read a sonnet"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种由十四行组成的诗歌，通常遵循特定的押韵格式和节奏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "十四行诗",
                                "target_lang_sense_clarification": "指西方文学中特定的十四行诗体。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38f260ff-ceca-3b21-9df8-aeb9fe406f71",
                    "sense_definition": "To write or compose poems of fourteen lines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "poetry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire afternoon trying to <w>sonnet</w> his feelings for her.",
                            "target_lang_translations": {
                                "zh": "他花了一整个下午试图<w>写十四行诗</w>来表达对她的感情。"
                            }
                        },
                        {
                            "text": "She loves to <w>sonnet</w> when she feels inspired by nature.",
                            "target_lang_translations": {
                                "zh": "当她从大自然中获得灵感时，她喜欢<w>写十四行诗</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "创作十四行诗。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "写十四行诗",
                                "target_lang_sense_clarification": "指创作这种特定形式的诗歌。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93e818ef-2434-33df-acaf-5f6c70d5d761",
                    "sense_definition": "To praise or honor someone or something by writing a poem about them.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "poetry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author decided to <w>sonnet</w> the beauty of the ancient city.",
                            "target_lang_translations": {
                                "zh": "作者决定<w>作诗赞美</w>这座古城的美丽。"
                            }
                        },
                        {
                            "text": "Many poets would <w>sonnet</w> their muses in the Renaissance era.",
                            "target_lang_translations": {
                                "zh": "在文艺复兴时期，许多诗人会<w>作诗赞美</w>他们的缪斯。"
                            }
                        }
                    ],
                    "synonyms": [
                        "praise",
                        "celebrate"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过写诗来赞美或歌颂某人或某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "作诗赞美",
                                "target_lang_sense_clarification": "指通过诗歌形式表达赞颂之情。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}