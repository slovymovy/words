                                        "examples": [
                                            {
                                                "example_id": "e6468111-6150-492b-80df-56e9bb488ea5",
                                                "sense_id": "872622f3-b22f-3642-9059-9badd603ae8e",
                                                "text": "En France, c’est en général au mois de juillet que la température est la plus chaude."
                                            },
                                            {
                                                "example_id": "79d4d15b-299e-4038-862e-cb1b29c6bed7",
                                                "sense_id": "872622f3-b22f-3642-9059-9badd603ae8e",
                                                "text": "Les autres infections bactériennes se développent en général à partir d’une infection du bas appareil urinaire ou à la suite de manœuvres chirurgicales instrumentales."
                                            }
