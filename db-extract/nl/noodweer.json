                "senses": [
                    {
                        "sense_id": "900f280b-5974-36bd-942d-80853081a490",
                        "entry_id": "097d0caf-589c-3de5-978b-8e693f409cb3",
                        "glosses": [
                            "zeer slecht weer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b342fbf5-4ed3-474f-95e1-16effa663c2f",
                                "sense_id": "900f280b-5974-36bd-942d-80853081a490",
                                "text": "Delen van Nederland hadden woensdag te kampen met noodweer."
                            },
                            {
                                "example_id": "f7c634e6-f9a8-4b4d-aa06-1f25fe58cf14",
                                "sense_id": "900f280b-5974-36bd-942d-80853081a490",
                                "text": "Drie dagen na het verlaten van Kennedy Meadows was ik Mount Whitney op geklommen waar ik een nacht in het noodweer op de top moest doorbrengen."
                            },
                            {
                                "example_id": "5a13a890-b754-4beb-94b2-3dcd3bee0a1b",
                                "sense_id": "900f280b-5974-36bd-942d-80853081a490",
                                "text": "Voor de overige provincies geldt code geel. Er wordt in korte tijd ook heel veel regen verwacht. Het noodweer is naar verwachting van korte duur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a600527-a15d-4311-973c-1c7e43566445",
                        "source_entry_id": "097d0caf-589c-3de5-978b-8e693f409cb3",
                        "source_sense_id": "900f280b-5974-36bd-942d-80853081a490",
