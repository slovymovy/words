                                                "example_id": "09430052-f841-4beb-9fe4-e88d5e528be3",
                                                "sense_id": "9888b972-8768-3041-955a-7e7c249933ee",
                                                "text": "Another misfortune which befel poor Sophia, was the company of Lord Fellamar, whom she met at the opera, and who attended her to the drum."
                                            },
                                            {
                                                "example_id": "bbf2d5c4-1a96-4fdf-a3f6-49bc71088eaf",
                                                "sense_id": "9888b972-8768-3041-955a-7e7c249933ee",
                                                "text": "[H]e was engaged in a partie of cards, at a drum in the house of a certain lady of quality […]."
                                            },
                                            {
                                                "example_id": "41707039-b25a-470d-af2d-34545a05bf6a",
                                                "sense_id": "9888b972-8768-3041-955a-7e7c249933ee",
