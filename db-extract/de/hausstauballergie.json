                        "sense_id": "6600895a-c207-30e3-b9b3-f23b25f5fb29",
                        "entry_id": "d68bd5ee-bab6-301e-80d8-ca8e80dbfaa0",
                        "glosses": [
                            "durch den Kontakt mit dem Kot von Hausstaubmilben hervorgerufene Allergie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35e24e08-16a1-4bae-83dd-2cd8ea3cc3ef",
                                "sense_id": "6600895a-c207-30e3-b9b3-f23b25f5fb29",
                                "text": "„Sobald er aber ein Buch aufschlug, meldete sich fast automatisch seine Hausstauballergie.“"
                            },
                            {
                                "example_id": "48f87671-56a4-4fad-8a6f-03fff1d359ee",
                                "sense_id": "6600895a-c207-30e3-b9b3-f23b25f5fb29",
                                "text": "„Philip und ich blieben über den Großteil unserer Studienjahre zusammen, eine Zeit, in der ich Amalia immer seltener besuchte, denn sie konnte wenig mit Philip anfangen, und er hatte ja die Hausstauballergie.“"
                            }
                        ],
