                "senses": [
                    {
                        "sense_id": "949ed35a-e6c7-312c-9a80-ce5a014c77a5",
                        "entry_id": "3e945665-3414-3285-8643-87b41a854c0e",
                        "glosses": [
                            "mit Erz ausgefüllter Gang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70d260a2-8228-46ad-8544-23fd39f924e1",
                                "sense_id": "949ed35a-e6c7-312c-9a80-ce5a014c77a5",
                                "text": "„Die Arbeit ähnelt der Grubenarbeit, doch ist hier die Erzader eine Wasserader.“"
                            },
                            {
                                "example_id": "7a52852f-18f5-4a8b-986d-6007b176b195",
                                "sense_id": "949ed35a-e6c7-312c-9a80-ce5a014c77a5",
                                "text": "„Bei Tage im Dunkel der tropfenden Grotten, der steinernen Därme, auf denen die Stadt gebaut worden war, in der Hand seine Lampe, ein gebückter, murmelnder, blutroter Troglodyt in jauchigen Schächten, die Richtung versuchte er anhand eines gestohlenen Pfadfinderkompasses zu peilen, aber dessen Nadel trudele in dieser unteren Region voller Erzadern und Flöze nur sinnlos hin und her.“"
                            },
                            {
                                "example_id": "1ff747e5-c0e3-4c21-915b-e16642f8f584",
                                "sense_id": "949ed35a-e6c7-312c-9a80-ce5a014c77a5",
                                "text": "„Ihr Zugang gähnte inmitten einer niedrigen, von Erzadern durchzogenen Felswand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
