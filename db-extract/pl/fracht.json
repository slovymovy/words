                        "entry_id": "fe8d600c-68ce-3990-b33b-8da979c76081",
                        "glosses": [
                            "przewóz towarów w określone miejsce jakimś środkiem transportu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe182b69-b2db-48d7-9b0c-fa588d9075a4",
                                "sense_id": "6611cbd6-5c10-3830-82c3-84547118a155",
                                "text": "Kiedyś lecąc do USA nadałem kilka kilogramów książek frachtem lotniczym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0c69c01b-9f6c-3084-9e81-e4cffc020472",
                        "entry_id": "fe8d600c-68ce-3990-b33b-8da979c76081",
                        "glosses": [
                            "ładunek, który transportowany jest podczas frachtu (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86080413-240b-465a-9912-54e9ae86f9cc",
                                "sense_id": "0c69c01b-9f6c-3084-9e81-e4cffc020472",
                                "text": "Chińczycy wynajmują część nabrzeża portowego i magazyny w Neapolu, większość frachtu chińskiego do Europy idzie bowiem tą drogą."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "b482b7c8-8e54-37f3-846b-79ffa95776bd",
                        "entry_id": "fe8d600c-68ce-3990-b33b-8da979c76081",
                        "glosses": [
