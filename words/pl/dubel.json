    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ddbe60bd-ebee-3c27-8512-bb3f961ad0ab",
                    "sense_definition": "powtórne nagranie ujęcia w filmie lub telewizji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "film",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aktor pomylił kwestię i reżyser musiał zarządzić kolejny <w>dubel</w> sceny.",
                            "target_lang_translations": {
                                "ru": "Актёр перепутал реплику, и режиссёру пришлось назначить ещё один <w>дубль</w> сцены."
                            }
                        },
                        {
                            "text": "Filmowcy zabezpieczają się, robiąc kilka <w>dubli</w> każdego ujęcia na planie.",
                            "target_lang_translations": {
                                "ru": "Кинематографисты перестраховываются, делая по несколько <w>дублей</w> каждого кадра на площадке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kolejny dubel",
                        "robić dubel"
                    ],
                    "target_lang_definitions": {
                        "ru": "повторная съёмка кадра или сцены в кино либо на телевидении"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубль",
                                "target_lang_sense_clarification": "в кинематографе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ee60997-f71a-3ff9-a1eb-12a93f686885",
                    "sense_definition": "drugi, identyczny egzemplarz jakiegoś przedmiotu",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kopia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kolekcjoner znaczków pocztowych chętnie wymienił swój <w>dubel</w> na rzadki okaz.",
                            "target_lang_translations": {
                                "ru": "Коллекционер почтовых марок с удовольствием обменял свой <w>дублет</w> на редкий экземпляр."
                            }
                        },
                        {
                            "text": "Znalazłem w biblioteczce <w>dubel</w> tej samej książki, więc oddałem go bratu.",
                            "target_lang_translations": {
                                "ru": "Я нашёл в домашней библиотеке <w>второй экземпляр</w> той же книги и отдал его брату."
                            }
                        }
                    ],
                    "synonyms": [
                        "dublet",
                        "duplikat"
                    ],
                    "target_lang_definitions": {
                        "ru": "второй, идентичный экземпляр какого-либо предмета (например, в коллекции)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубликат",
                                "target_lang_sense_clarification": "копия, второй экземпляр"
                            },
                            {
                                "target_lang_word": "дублет",
                                "target_lang_sense_clarification": "второй экземпляр в коллекции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2be3e7d-5ac8-3b86-8ef5-2d87ab784d9e",
                    "sense_definition": "w grze w darta: trafienie w wąskie pole tarczy liczone podwójnie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zawodnik zakończył partię, trafiając decydujący <w>dubel</w> w ostatniej rundzie.",
                            "target_lang_translations": {
                                "ru": "Игрок завершил партию, попав в решающий <w>дабл</w> в последнем раунде."
                            }
                        },
                        {
                            "text": "Aby wygrać ten mecz, potrzebował trafić czysty <w>dubel</w> dwudziestki.",
                            "target_lang_translations": {
                                "ru": "Чтобы выиграть этот матч, ему нужно было чётко попасть в <w>удвоение</w> двадцатки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
