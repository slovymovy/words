                "senses": [
                    {
                        "sense_id": "dcd4aa6f-bde4-3898-aa2d-9ec40b8476c5",
                        "entry_id": "992f2bea-2b12-36c5-ae60-064126d51fb1",
                        "glosses": [
                            "Ausdrucksweise/Sprache, die von einem Paar verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2257956b-e2bb-4d6c-ba20-4783990721a0",
                                "sense_id": "dcd4aa6f-bde4-3898-aa2d-9ec40b8476c5",
                                "text": "„Darüber hinaus ist durchaus auch vorstellbar, daß das Kochum hier die Funktion sonst erst zu findender Lexeme für eine Paarsprache erfüllt.“"
                            },
                            {
                                "example_id": "47d17154-a961-40f3-ba04-5910f4a13b53",
                                "sense_id": "dcd4aa6f-bde4-3898-aa2d-9ec40b8476c5",
                                "text": "„Alle diese Elemente finden sich mehr oder weniger auch bei der Paarsprache.“"
                            },
                            {
                                "example_id": "2c0e90b0-ed30-4dc9-a5c1-d42d9fcf7269",
                                "sense_id": "dcd4aa6f-bde4-3898-aa2d-9ec40b8476c5",
                                "text": "„Es gibt eine gemeinsame Paarsprache, die Sprachwahl der Partner ist also konvergierend.“"
                            },
                            {
                                "example_id": "abad5c7a-6118-4f55-beb0-455472f46253",
                                "sense_id": "dcd4aa6f-bde4-3898-aa2d-9ec40b8476c5",
                                "text": "„Wenn die Paarsprache für beide eine Fremdsprache ist, kann von vergleichbaren Voraussetzungen ausgegangen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
