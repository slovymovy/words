                    {
                        "sense_id": "fb9b875e-40da-3872-ad0f-30ed21ee0a21",
                        "entry_id": "64b63798-0664-3129-9d05-9aae8180a29e",
                        "glosses": [
                            "das Strömen/Fließen (in Richtung auf etwas zu)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4646a3a2-63a4-42cd-a744-5bfb563e2237",
                                "sense_id": "fb9b875e-40da-3872-ad0f-30ed21ee0a21",
                                "text": "„In ähnlicher Weise wird beim Hinfließen eines Stromes längs A und beim Zurückfließen längs B ein Magnetfeld erregt, dessen Kraftlinien durch CD hindurchgehen und zu einer elektromagnetischen Störung Anlaß geben.“"
                            },
                            {
                                "example_id": "673864ed-a378-4d3d-915d-ffdfb464e552",
                                "sense_id": "fb9b875e-40da-3872-ad0f-30ed21ee0a21",
                                "text": "übertragen: „In den Beziehungen der Personen gibt es ein wechselseitiges Erkennen und Lieben, ein Hinfließen und Zurückfließen zwischen dem Vater und dem Sohn mittels des Heiligen Geistes, der die Liebe beider ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
