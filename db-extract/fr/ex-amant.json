                        "glosses": [
                            "Ancien amant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c664082a-bb53-4ff8-a8c3-e49db3b0638b",
                                "sense_id": "1d242536-2986-3c3e-a2ae-fbfa1b0a9e2e",
                                "text": "Mon ex-amant veut me faire chanter et meurt en compagnie du fils du concierge de mon ministère qui, l’imbécile, jette son corps dans un fourré du bois de Boulogne !"
                            },
                            {
                                "example_id": "fc0beb1a-172f-443a-8e3e-bb8a5009366a",
                                "sense_id": "1d242536-2986-3c3e-a2ae-fbfa1b0a9e2e",
                                "text": "Construit en quatre grandes parties, le roman épistolaire tourne autour du couple d’ex-amants formé par la Marquise et le Vicomte."
                            },
                            {
                                "example_id": "f77621f1-f7da-432c-88e1-ae95ad0d255b",
                                "sense_id": "1d242536-2986-3c3e-a2ae-fbfa1b0a9e2e",
                                "text": "Alors que Christos, menottes aux poignets, est emmené par les gendarmes, les ex-amants se lancent un dernier regard et chacun repart de son côté."
                            }
                        ]
                    }
