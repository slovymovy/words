                        "glosses": [
                            "fietser die voor het peloton uit rijdt tijdens een wegwedstrijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41260fc9-ae67-4e6e-9d02-af9dd57acfe7",
                                "sense_id": "9baacaf5-e463-348c-87fa-6bfdaf68026f",
                                "text": "De drie waren 10 kilometer voor de finish weggereden. Ze gingen er vandoor toen het peloton net de vijf vroege vluchters had bijgehaald. Dat waren de Nederlander Brian van Goethem, de Belgen Lawrence Naesen en Michiel Goolaerts en de Fransmannen Stéphane Poulhies en Romain Combaud."
                            }
                        ]
