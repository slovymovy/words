                "senses": [
                    {
                        "sense_id": "c1cfbd0f-b674-33d1-9b71-78bd2ff89add",
                        "entry_id": "1dd292b2-9ee8-3009-91e1-af649e7a1732",
                        "glosses": [
                            "Stoff aus Baumwolle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "343de22e-41a0-4dc8-aa78-c7423d273856",
                                "sense_id": "c1cfbd0f-b674-33d1-9b71-78bd2ff89add",
                                "text": "Der Vorhang ist aus weichem Baumwollstoff."
                            },
                            {
                                "example_id": "dba82676-ebc3-4a65-9944-f28ef7dc3fd1",
                                "sense_id": "c1cfbd0f-b674-33d1-9b71-78bd2ff89add",
                                "text": "„Seit einiger Zeit sind ‚smarte‘ japanische Kaufleute hier und sondieren in ihrer bekannten fast unbemerkbaren Weise die Aussichten des Handels, indem sie sich im Zollhofe sehr eingehend umsehen und unterrichten. Bei ihnen gilt es zunächst dem Abugedid, dem Baumwollstoffe.“"
                            },
                            {
                                "example_id": "29f44752-3768-4026-bf5e-e8516e243e45",
                                "sense_id": "c1cfbd0f-b674-33d1-9b71-78bd2ff89add",
                                "text": "„Bekleidet war er mit einem feuersicher gestärkten Gewand aus weißem Baumwollstoffe, dessen Umsäumung abgeschabt und dessen Kragen zerschlissen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4d4f91c-536b-4c4c-9e58-ed750aff79fa",
                        "source_entry_id": "1dd292b2-9ee8-3009-91e1-af649e7a1732",
                        "source_sense_id": "c1cfbd0f-b674-33d1-9b71-78bd2ff89add",
