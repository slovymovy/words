{
    "word_family": [
        "odsłona",
        "odsłonięcie",
        "odsłonięty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "465966e8-b9cd-3d55-b80c-e037e8734be2",
                    "sense_definition": "usunąć coś, co zakrywa inny obiekt, czyniąc go widocznym",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "odkrywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Artysta <w>odsłonił</w> nowy pomnik przed tłumem ludzi.",
                            "target_lang_translations": {
                                "ru": "Художник <w>открыл</w> новый памятник перед толпой людей."
                            }
                        },
                        {
                            "text": "Właściciel <w>odsłonił</w> <w>zasłony</w>, aby wpuścić światło do pokoju.",
                            "target_lang_translations": {
                                "ru": "Владелец <w>открыл</w> шторы, чтобы впустить свет в комнату."
                            }
                        }
                    ],
                    "synonyms": [
                        "odkryć",
                        "obnażyć",
                        "ukazać"
                    ],
                    "antonyms": [
                        "zasłonić",
                        "zakryć"
                    ],
                    "common_phrases": [
                        "odsłonić zasłony",
                        "odsłonić prawdę",
                        "odsłonić twarz"
                    ],
                    "target_lang_definitions": {
                        "ru": "убрать то, что закрывает объект, делая его видимым"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открыть",
                                "target_lang_sense_clarification": "сделать видимым, убрать преграду"
                            },
                            {
                                "target_lang_word": "обнажить",
                                "target_lang_sense_clarification": "сделать открытым, часто о частях тела или скрытых предметах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be8ab94c-821e-35d0-b425-7ecd0f92ed26",
                    "sense_definition": "stać się widocznym lub przestać być zakrytym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "odkrywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gdy mgła opadła, <w>odsłonił</w> się piękny widok na góry.",
                            "target_lang_translations": {
                                "ru": "Когда туман рассеялся, <w>открылся</w> прекрасный вид на горы."
                            }
                        },
                        {
                            "text": "Pod wpływem wiatru <w>odsłonił</w> się fragment starego muru.",
                            "target_lang_translations": {
                                "ru": "Под воздействием ветра <w>обнажился</w> фрагмент старой стены."
                            }
                        }
                    ],
                    "synonyms": [
                        "ukazać się",
                        "wyłonić się"
                    ],
                    "antonyms": [
                        "zasłonić się"
                    ],
                    "common_phrases": [
                        "odsłonił się widok"
                    ],
                    "target_lang_definitions": {
                        "ru": "стать видимым или перестать быть закрытым"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открыться",
                                "target_lang_sense_clarification": "стать видимым, показаться"
                            },
                            {
                                "target_lang_word": "обнажиться",
                                "target_lang_sense_clarification": "стать открытым, показаться из-под чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "182212ec-74f6-315c-8a60-67ea4e31db1b",
                    "sense_definition": "aspekt dokonany od czasownika <w>odsłaniać</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "odkrywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podszedł do okna, <w>odsłonił</w> <w>zasłony</w>, a potem oparł się o parapet.",
                            "target_lang_translations": {
                                "ru": "Он подошел к окну, <w>открыл</w> шторы, а затем оперся о подоконник."
                            }
                        },
                        {
                            "text": "Wiatr nagle <w>odsłonił</w> ukryte pod liśćmi znalezisko.",
                            "target_lang_translations": {
                                "ru": "Ветер внезапно <w>открыл</w> спрятанную под листьями находку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odsłonić zasłony"
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид глагола odsłaniać"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открыть",
                                "target_lang_sense_clarification": "совершенный вид, действие завершено"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbdea740-105c-318c-a59c-8d193662b094",
                    "sense_definition": "aspekt dokonany od czasownika <w>odsłaniać</w> się",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "odkrywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po burzy <w>odsłonił</w> się przed nami piękny krajobraz.",
                            "target_lang_translations": {
                                "ru": "После бури перед нами <w>открылся</w> прекрасный пейзаж."
                            }
                        },
                        {
                            "text": "W trakcie rozmowy <w>odsłonił</w> się jego prawdziwy charakter.",
                            "target_lang_translations": {
                                "ru": "В ходе разговора <w>открылся</w> его истинный характер."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "совершенный вид глагола odsłaniać się"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открыться",
                                "target_lang_sense_clarification": "совершенный вид, действие завершено"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}