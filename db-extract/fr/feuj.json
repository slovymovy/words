        "de-extract.jsonl": [
            {
                "entry_id": "f35aa03c-8e56-3927-8c1e-69dda87a36fb",
                "word": "feuj",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6d24523f-c956-3c32-8054-851d497c1459",
                        "entry_id": "f35aa03c-8e56-3927-8c1e-69dda87a36fb",
                        "glosses": [
                            "Jude"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75f7306d-beba-4716-a772-18637d2b65a2",
                        "source_entry_id": "f35aa03c-8e56-3927-8c1e-69dda87a36fb",
                        "source_sense_id": "6d24523f-c956-3c32-8054-851d497c1459",
                        "source_sense_description": "umgangssprachlich, Religion: Jude",
                        "target_lang_word": "Jude",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jude",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8eda79f0-930c-3682-b8dd-bce4f54d1c10",
                                        "entry_id": "383815ed-3a83-3c25-8f52-9a453c8efb9f",
                                        "glosses": [
                                            "Mensch, welcher der Religion des Judentums angehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50ba7da1-4e1f-4e06-8f70-0a29995e724c",
                                                "sense_id": "8eda79f0-930c-3682-b8dd-bce4f54d1c10",
                                                "text": "„Man sprach die Juden schuldig, ein Pogrom begann, und lange genug war die Kapelle ein Wallfahrtsort der Verfolger.“"
                                            },
                                            {
                                                "example_id": "dc9fbaf5-9e5c-41f3-a03b-ac0c2d920d9a",
                                                "sense_id": "8eda79f0-930c-3682-b8dd-bce4f54d1c10",
                                                "text": "„Eine Welt, in der ein junger Mann wie Somekh die Chance hätte, sich als Jude und Araber zu betrachten. […] Die irakischen Juden, die in ihrem Heimatland eine Elite gewesen waren, sah man jetzt als ‚primitive‘ Menschen an; die Nachkommen der einst verachteten Ostjuden waren fest entschlossen, in dem neuen Staat jede Spur von Orient auszulöschen.“"
                                            },
                                            {
                                                "example_id": "c96e111a-e40e-416b-b65f-8d348c24942f",
                                                "sense_id": "8eda79f0-930c-3682-b8dd-bce4f54d1c10",
                                                "text": "„Der Turban der Juden oder Christen ist dunkel und von grobwollenem Stoff zum Zeichen ihrer Knechtschaft; in Persien ist es diesen Parias überhaupt verboten, den Turban zu tragen.“"
                                            },
                                            {
                                                "example_id": "176a3161-27ad-4a49-8b0b-3eaf8537bd8b",
                                                "sense_id": "8eda79f0-930c-3682-b8dd-bce4f54d1c10",
                                                "text": "„Immer wenn es um die Juden ging, verließ die christlichen Leute Verstand und Anstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                        "entry_id": "383815ed-3a83-3c25-8f52-9a453c8efb9f",
                                        "glosses": [
                                            "Mensch, welcher der jüdischen Ethnie oder Kulturgemeinschaft angehört"
                                        ],
                                        "tags": [
                                            "Völkerkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2f761fa-b9c7-4999-85b2-fd203c5dd373",
                                                "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                                "text": "Albert Einstein war Jude."
                                            },
                                            {
                                                "example_id": "192ca227-4446-441d-9497-56526e58f745",
                                                "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                                "text": "„Die Behauptung, ein Jude könne kein Faschist sein, ist reiner Antisemitismus! Oder Philosemitismus. Philosemitismus und Antisemitismus sind ja nicht so weit voneinander entfernt. Man sieht nicht mehr das Individuum, man sieht nur noch: Er ist Jude und darum so und so. Das hat mich fasziniert, wie schwierig es noch immer ist – so viele Jahre nach dem Krieg – unbefangen über Juden zu reden.“"
                                            },
                                            {
                                                "example_id": "ea57800c-7bcb-4c96-a684-af4abdfc2709",
                                                "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                                "text": "„Juden, Halbjuden, Vierteljuden - man lernte wieder, die Prozente zu schmecken, so dass die Zunge am kalten Eisen anfror.“"
                                            },
                                            {
                                                "example_id": "5fc455b3-862e-417e-b487-1baf67f9f744",
                                                "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                                "text": "„Der rote Jude trat wieder in das Haus, entdeckte den andern am Geländer zuerst nicht.“"
                                            },
                                            {
                                                "example_id": "4f06feae-4cea-4a9f-8073-e9ca862334b3",
                                                "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                                "text": "„Netanjahu schützt die israelischen Juden schlechter vor den Raketen der Hamas, als Europas Regierende die europäischen Juden vor antisemitischem Terror schützen.“"
                                            },
                                            {
                                                "example_id": "b416d528-20d2-46f0-9e37-d2c95aeb067e",
                                                "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                                "text": "„In einem kleinen Winkel der Welt lebten Menschen, die sich selbst zunächst Hebräer, später nach ihrem Stammvater Israeliten oder Juden nannten und die sich zu einer neuartigen Schöpfungsgeschichte bekannten.“"
                                            },
                                            {
                                                "example_id": "6b438cf8-adb7-41ef-8259-1c3fc292d337",
                                                "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                                "text": "[Jüdisches Leben in der Weimarer Republik:] „Wohlhabende Juden engagierten sich häufig sozial und förderten kulturelle Einrichtungen wie Theater und Museen.“"
                                            },
                                            {
                                                "example_id": "51e47272-921b-4db8-a42b-f6fe8a983c3e",
                                                "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                                "text": "[Jüdisches Leben in der Weimarer Republik:] „In der Forschung leisteten deutsche Juden Besonderes: Zwischen 1921 und 1931 waren fünf der 15 deutschen Nobelpreisträger jüdische Wissenschaftler, z. B. Albert Einstein.“"
                                            },
                                            {
                                                "example_id": "b2533747-ce6d-4b17-9200-24e526ed9bea",
                                                "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                                "text": "„Ab August 1938 mussten deutsche Juden stigmatisierende Vornamen annehmen: Männer mussten „Israel“ als zweiten Namen führen, Frauen „Sara“.“"
                                            },
                                            {
                                                "example_id": "c582d930-3cdf-426e-b095-d83476213e29",
                                                "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                                "text": "„Kirschbaum hat nie einen Gedanken daran verschwendet, daß er Jude ist, schon sein Vater war Chirurg, was ist das schon, jüdische Herkunft, sie zwingen einen, Jude zu sein, und man selbst hat gar keine Vorstellung, was das überhaupt ist. Jetzt sind um ihn herum lauter Juden, zum erstenmal in seinem Leben nichts als Juden, er hat sich den Kopf über sie zerbrochen, er wollte herausfinden, was es ist, wodurch sie sich alle gleichen, vergeblich, sie haben untereinander nichts Erkennbares gemein, und er mit ihnen schon gar nicht.“"
                                            },
                                            {
                                                "example_id": "f6b80cdc-0c1c-4c7b-8964-d13cb885a684",
                                                "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                                "text": "„Tausende Juden lebten noch versteckt in Berlin, viele irrten ohne festes Obdach umher, schliefen im Freien, unter Brückenbögen oder in den Wäldern, manche fuhren bis Betriebsschluss in der S-Bahn herum und suchten dann die Wartesäle oder Toilettenräume der Bahnhöfe auf, um zu schlafen.“"
                                            },
                                            {
                                                "example_id": "96d7eaa9-a211-48ad-9518-4de0620e5075",
                                                "sense_id": "7f6fd949-1963-370f-919c-caa462b529b3",
                                                "text": "„Jeder kennt das Stereotyp vom reichen Juden, von einem, der gerne Geschäfte macht. […] Mit der Realität hat es nichts zu tun, besonders in Deutschland nicht. Hier sind die meisten Jüdinnen und Juden arm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
