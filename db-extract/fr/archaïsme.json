        "fr-extract.jsonl": [
            {
                "entry_id": "da74931d-c2c4-3e8c-b8ae-8b93cf38eb92",
                "word": "archaïsme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1fc7438c-5869-4207-a22c-7b0b603e2f5b",
                        "entry_id": "da74931d-c2c4-3e8c-b8ae-8b93cf38eb92",
                        "tags": [
                            "plural"
                        ],
                        "form": "archaïsmes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54a3b8fc-8727-34d5-92b8-93fac34ca1bb",
                        "entry_id": "da74931d-c2c4-3e8c-b8ae-8b93cf38eb92",
                        "glosses": [
                            "Usage tombé en désuétude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db9ecf5b-e4d9-4422-b39f-63ede29b057f",
                                "sense_id": "54a3b8fc-8727-34d5-92b8-93fac34ca1bb",
                                "text": "Les consonnes subissent dans les langues celtiques divers traitements linguistiques dont la lénition interne. Ainsi les noms Péron, Pédron, Pezdron et Pezron sont tous des variantes d’un nom latin initial Petronem. Hormis le premier nom, les autres sont des archaïsmes."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7e13d6e-0508-388a-90cc-d930647e18e5",
                        "entry_id": "da74931d-c2c4-3e8c-b8ae-8b93cf38eb92",
                        "glosses": [
                            "Mot ou tournure ressenti comme appartenant à un usage ancien ou révolu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "782243af-2979-4128-90be-291d4eafd6db",
                                "sense_id": "b7e13d6e-0508-388a-90cc-d930647e18e5",
                                "text": "Il s’agit des archaïsmes dont on use avec une certaine gourmandise, en sachant parfaitement qu’ils ont cette saveur d'autrefois et que notre interlocuteur en a conscience. En fait, à sa manière, l’archaïsme représente une sorte de clin d’œil historique de la langue. « Nous tuons le temps en buvant moult et en fumant prou », s’exclame plaisamment Verlaine dans Quinze jours en Hollande, en 1893. On pourrait tout aussi bien citer Anatole France dans Le Petit Pierre en 1918, évoquant la chair d’un oiseau et précisant malicieusement qu’il n’a pas « ouï dire qu’elle fût comestible » !"
                            }
                        ]
                    },
                    {
                        "sense_id": "ec9a188b-f798-338f-8bf2-b359040e041d",
                        "entry_id": "da74931d-c2c4-3e8c-b8ae-8b93cf38eb92",
                        "glosses": [
                            "Mot ou tournure ayant toujours cours dans certaines régions (p. ex. au Canada) mais qui a disparu ou est considéré comme vieilli en France globalement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76dfed6e-1fde-4b92-af42-1af7ab5a6387",
                                "sense_id": "ec9a188b-f798-338f-8bf2-b359040e041d",
                                "text": "Et M. Dagenais condamne vertement les archaïsmes de vocabulaire, de grammaire et de structure. Décisément, les archaïsmes n’ont pas la cote d’amour parmi les lexicologues. Pourtant, il y a eu de grands écrivains français qui ne boudaient pas les termes désuets et les tournures vieillottes."
                            }
                        ]
                    },
                    {
                        "sense_id": "042269d0-d8da-38b9-b5f3-01c51e238ff9",
                        "entry_id": "da74931d-c2c4-3e8c-b8ae-8b93cf38eb92",
                        "glosses": [
                            "Pratique scientifique, sociale ou politique subsistant aujourd’hui mais considérée comme appartenant au passé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19bf6463-3cf9-42a7-bab0-9a8e98b9a0eb",
                                "sense_id": "042269d0-d8da-38b9-b5f3-01c51e238ff9",
                                "text": "Elle doit remplacer les religions qui sont des archaïsmes effroyables, pour les femmes bien évidemment, mais aussi pour tous les hommes qui veulent la liberté et non celle de brimer celle des autres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2967e59-3226-412a-899b-411826991d32",
                        "source_entry_id": "da74931d-c2c4-3e8c-b8ae-8b93cf38eb92",
                        "target_lang_word": "Archaismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Archaismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67acd9db-e2db-3dda-817e-7acd0fe68a95",
                                        "entry_id": "1f1cfa51-4ba4-38d0-ab24-4e6fb1a99be8",
                                        "glosses": [
                                            "ein sprachlicher Ausdruck, der allmählich außer Gebrauch gerät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "368cadda-576c-4168-ac38-fd115f42af21",
                                                "sense_id": "67acd9db-e2db-3dda-817e-7acd0fe68a95",
                                                "text": "„In der Gefahr, dieser Regel zu widerstreben, stehen vor allem zwei Wortgruppen: die ‚Neologismen‘ (Neuwörter) und die Archaismen (veraltete Wörter).“"
                                            },
                                            {
                                                "example_id": "3e141f42-7034-4af9-9db3-4fcc103330bc",
                                                "sense_id": "67acd9db-e2db-3dda-817e-7acd0fe68a95",
                                                "text": "„Wörter aus vergangenen Zeiten, Archaismen, können in der Gegenwartssprache stilistische Funktionen erfüllen - sie können der Charakteristik der Sprecher oder der ironischen Darstellung dienen.“"
                                            },
                                            {
                                                "example_id": "57a84342-f8da-44ed-b82c-81eec33f05c4",
                                                "sense_id": "67acd9db-e2db-3dda-817e-7acd0fe68a95",
                                                "text": "„Das Verhältnis von Sprachzustand und Sprachwandel zeigt sich zu jedem Zeitpunkt unter anderem in dem Zusammenwirken von allgemeingültigen Mitteln, Neuerungen und Archaismen.“"
                                            },
                                            {
                                                "example_id": "569d07f9-d122-4a8a-b231-069a170cc601",
                                                "sense_id": "67acd9db-e2db-3dda-817e-7acd0fe68a95",
                                                "text": "„Bedauerlicherweise fehlt eine umfassende Bestandsaufnahme des färöischen Verbalsystems und seiner morphologischen Formen, einschließlich der Varietäten in den Dialekten und der Archaismen, wie sie bei traditionellen färöischen Texten bisweilen in Erscheinung treten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5816c4d6-dfac-3e2a-95e9-e2facb63398d",
                                        "entry_id": "1f1cfa51-4ba4-38d0-ab24-4e6fb1a99be8",
                                        "glosses": [
                                            "eine auf die Entwicklung bezogene Sichtweise, die seelische Phänomene als möglicher Ausdruck eines bestimmten Entwicklungs- oder Reifungsstadiums ansieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfade3c2-5c79-45af-bbfa-294c55fa8110",
                                                "sense_id": "5816c4d6-dfac-3e2a-95e9-e2facb63398d",
                                                "text": "„Mit Archaismus bezeichne ich den altertümlichen Charakter psychischer Inhalte und Funktionen.“"
                                            },
                                            {
                                                "example_id": "64de205d-b7b3-4838-9b22-adeb3b201d1d",
                                                "sense_id": "5816c4d6-dfac-3e2a-95e9-e2facb63398d",
                                                "text": "„Das ist aber vermutlich nur für uns Heutige so, die Kelten werden sich über diese Archaismen keine Gedanken gemacht haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa1a2d14-b9c6-4f3b-b8b1-4f20fd8b9cbb",
                        "source_entry_id": "da74931d-c2c4-3e8c-b8ae-8b93cf38eb92",
