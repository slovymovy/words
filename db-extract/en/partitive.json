                                            {
                                                "example_id": "f5538a4f-51b3-4d1c-a6e7-07362815c697",
                                                "sense_id": "ad085b3b-581d-398a-9101-cd8063802158",
                                                "text": "Probeert u eens de volgende twee zinnen hardop uit te spreken: ik hou van opera's en ik hou van twee van opera's. U zult een ernstige weerzin voelen tegen de tweede zin. (…) Het is niet zo moeilijk om dit verschijnsel te beschrijven: in een partitieve constructie als twee van de opera's, waarin een aantal uit een grotere groep wordt aangeduid, mag het lidwoord niet weggelaten worden, zoals in vrijwel alle andere constructies in het meervoud wel kan."
                                            },
                                            {
                                                "example_id": "abc2956e-7cf2-4894-8738-7528a30b7b00",
                                                "sense_id": "ad085b3b-581d-398a-9101-cd8063802158",
                                                "text": "Het kenmerk van partitieve kleurmenging is dat de lichtheid van de ontstane mengkleur precies ligt tussen de lichtheid van de beide uitgangskleuren."
                                            }
                                        ]
                                    }
                                ]
                            },
