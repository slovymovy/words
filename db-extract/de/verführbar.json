                            {
                                "example_id": "14ccbb54-7761-4045-b0c5-32a9a44d0082",
                                "sense_id": "82e445d4-521d-3a0d-9db1-c47661de82b8",
                                "text": "„Sie weiß, wie leicht verführbar, leitbar Antonius ist. Ihre Schenkel sind schwach vor Furcht und Not. Doch keiner merkt es. Hoch aufgerichtet, ohne Schwanken geht sie zur Tür.“"
                            },
                            {
                                "example_id": "63d47d1d-eb5b-4a1c-935d-1f85f5812eb1",
                                "sense_id": "82e445d4-521d-3a0d-9db1-c47661de82b8",
                                "text": "„Trunk, Spiel, jähe Hitze Nationalfehler; auch durch fremdes Gold leicht verführbar, aber dem Truge, dem Verrat, zugleich der Verderbnis überbildeter Völker in tiefster Seele widerstrebend ….“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
