                "senses": [
                    {
                        "sense_id": "d7f1ddd7-f101-351d-afad-fcec6235f1bd",
                        "entry_id": "4b4a20f2-a385-384c-a5fe-1753bf0f3577",
                        "glosses": [
                            "Déchéance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78ba3851-3a12-4bbf-a576-9b051ef43ddf",
                                "sense_id": "d7f1ddd7-f101-351d-afad-fcec6235f1bd",
                                "text": "Bénéfice vacant par dévolu, revenu donné au pape par suite de l’incapacité ecclésiastique de celui qui en était en possession."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bd9705c-8b5a-3273-9155-d6b7a0c4e0be",
                        "entry_id": "4b4a20f2-a385-384c-a5fe-1753bf0f3577",
                        "glosses": [
                            "Prétention juridique pour obtenir quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d577b2dc-f71d-4f13-9b41-c3c39e474f10",
                                "sense_id": "4bd9705c-8b5a-3273-9155-d6b7a0c4e0be",
                                "text": "Jeter un dévolu sur un bénéfice, y former une prétention juridique, en vertu de quelque faute commise par celui qui le possède."
                            },
                            {
                                "example_id": "81570c5a-8e88-41a3-abfb-f41fad1ce424",
                                "sense_id": "4bd9705c-8b5a-3273-9155-d6b7a0c4e0be",
                                "text": "Jeter son dévolu, avoir des vues arrêtées sur une chose et prétendre l’obtenir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12a251e8-907f-4ff1-a592-066b52f70746",
