                ],
                "senses": [
                    {
                        "sense_id": "d84e16a0-a22e-3149-841b-c924decf754e",
                        "entry_id": "e0d57964-b495-3687-9d01-b85c12ed0b9d",
                        "glosses": [
                            "Action d’abreuver les animaux domestiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "247c7125-5b44-4d6f-8a10-42bba7504484",
                                "sense_id": "d84e16a0-a22e-3149-841b-c924decf754e",
                                "text": "On donne l’avoine plutôt après l’abreuvement qu’avant."
                            },
                            {
                                "example_id": "6f9bb4db-503b-4eb0-b06e-92a8833d7a04",
                                "sense_id": "d84e16a0-a22e-3149-841b-c924decf754e",
                                "text": "On risque de causer des ruptures ou la pousse, si l’on fait courir l’animal aussitôt après l’abreuvement."
                            },
                            {
                                "example_id": "11f38476-6572-479b-9001-8b377b8fad51",
                                "sense_id": "d84e16a0-a22e-3149-841b-c924decf754e",
                                "text": "L’abreuvement exige certaines précautions, par exemple couper l’eau avec du son ou de la farine, ou la faire tiédir, si l’animal est en sueur."
                            },
                            {
                                "example_id": "086902aa-7c28-482a-bf94-b2409bee5dd2",
                                "sense_id": "d84e16a0-a22e-3149-841b-c924decf754e",
                                "text": "La disponibilité d’eau de surface dont l’exploitation requiert une main-d’œuvre moins nombreuse que l’abreuvement au puits constitue une possibilité particulièrement intéressante pour les propriétaires de grands troupeaux."
                            }
                        ]
                    }
                ],
