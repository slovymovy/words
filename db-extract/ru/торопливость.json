                "senses": [
                    {
                        "sense_id": "f2b8c5c3-7ff2-3a54-9a10-c8ba2db85c8c",
                        "entry_id": "27a34eb4-7117-30af-9c1a-2ce09dc3a098",
                        "glosses": [
                            "свойство по значению прилагательного торопливый"
                        ],
                        "tags": [],
