                "senses": [
                    {
                        "sense_id": "86501089-f056-3636-85c8-010c50fd0b1b",
                        "entry_id": "a2ea307a-1572-3369-8ace-9cee08571b86",
                        "glosses": [
                            "Abandon."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ea75e999-d580-4aae-8dc2-3ab6063c3930",
                                "sense_id": "86501089-f056-3636-85c8-010c50fd0b1b",
                                "text": "Elle se sentait prise d’un renoncement de pensées, d’une quiétude de ses membres, d’un abandonnement d’elle-même, comme envahie par une ivresse multiple."
                            },
                            {
                                "example_id": "34570a0c-ee36-46a7-8eb0-bc214c76ad6b",
                                "sense_id": "86501089-f056-3636-85c8-010c50fd0b1b",
                                "text": "Au bord des eaux, les saules laissent retomber lourdement leurs branches, dans un abandonnement."
                            },
                            {
                                "example_id": "6563e153-6070-4a63-a7fe-cb59b057177f",
                                "sense_id": "86501089-f056-3636-85c8-010c50fd0b1b",
                                "text": "Cet abandonnement ne signifie pas que Dieu a abandonné l’âme, l’a privée de sa grâce ; au contraire c’est un amour surabondant qui purifie l’âme."
                            }
                        ]
                    },
                    {
                        "sense_id": "e12df891-3de1-37e6-a5ec-01e0f532e466",
                        "entry_id": "a2ea307a-1572-3369-8ace-9cee08571b86",
                        "glosses": [
                            "Désigne la cession de biens faite par un débiteur à ses créanciers."
                        ],
