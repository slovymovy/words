                "senses": [
                    {
                        "sense_id": "5bedb4e8-8282-38d7-9f36-4bd71a78f348",
                        "entry_id": "78fd697d-c472-3fde-a639-b6fe872a676a",
                        "glosses": [
                            "Donner un caractère prévisible à."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "4d20145d-4c25-4986-9e19-187516c09ef8",
                                "sense_id": "5bedb4e8-8282-38d7-9f36-4bd71a78f348",
                                "text": "Ce prix s’enlise, se ridiculise, se prévisibilise."
                            },
                            {
                                "example_id": "6c8d363d-781f-4a67-96fe-fb80bf7c1601",
                                "sense_id": "5bedb4e8-8282-38d7-9f36-4bd71a78f348",
                                "text": "La division se trouve donc créatrice, dans un premier temps(T), de l’illusion de notre Monde, afin de \"prévisibiliser\", si vous me permettez ce terme, les conséquences liées à la recherche d’une* (* errance flagrante de l’Esprit) Connaissance, absolument inutile…puisque Être = Connaissance."
                            },
                            {
                                "example_id": "536f4415-608f-4977-a30f-20b092e97e39",
                                "sense_id": "5bedb4e8-8282-38d7-9f36-4bd71a78f348",
                                "text": "J’vais vous prévisibiliser."
                            }
                        ]
                    }
