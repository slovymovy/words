                ],
                "senses": [
                    {
                        "sense_id": "4a950d8e-d8ca-3a7a-8635-23aec18ece09",
                        "entry_id": "64198ece-8599-368e-a382-cfc3a00b8f4f",
                        "glosses": [
                            "männliches oder weibliches Kind des eigenen Sohnes oder der eigenen Tochter (Enkelkind)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "175c7aa0-020e-4e85-8c37-4e567c376482",
                                "sense_id": "4a950d8e-d8ca-3a7a-8635-23aec18ece09",
                                "text": "„Auf legalem Wege können die Kinder und Kindeskinder der ehemaligen deutschen Schlesier nur durch die Wahl des Priesterberufes die deutsche Sprache erlernen.“"
                            },
                            {
                                "example_id": "e9b3c98c-1b26-4920-89d5-93972f95c81b",
                                "sense_id": "4a950d8e-d8ca-3a7a-8635-23aec18ece09",
                                "text": "„Vielleicht hat er dort nach Ablieferung der Särge ab und zu noch eine kleine Dschungelexpedition mitgemacht, um später staunenden Kindern und Kindeskindern davon erzählen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62ee8fd7-8719-4d4a-9769-1fecbd50ddb7",
                        "source_entry_id": "64198ece-8599-368e-a382-cfc3a00b8f4f",
                        "source_sense_id": "4a950d8e-d8ca-3a7a-8635-23aec18ece09",
                        "source_sense_description": "männliches oder weibliches Kind des eigenen Sohnes oder der eigenen Tochter (Enkelkind)",
                        "target_lang_word": "grandchild",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grandchild",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a2afd59-8aaf-36aa-b669-069d4e1915de",
                                        "entry_id": "16308a96-50f4-309e-8d52-1b6c77a05c28",
                                        "glosses": [
                                            "A child of someone's child."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36dbdbf8-b604-44b8-bbff-7850b6fbae50",
                                                "sense_id": "5a2afd59-8aaf-36aa-b669-069d4e1915de",
                                                "text": "...he fell into amazement when he thought of the Herculean labours those fifteen pairs of hands had performed: of the cows they had milked, the butter they had made, the gardens they had planted, the children and grandchildren they had tended, the brooms they had worn out, the mountains of food they had cooked. It made him dizzy."
                                            },
                                            {
                                                "example_id": "f4a15363-3896-451c-9753-2485056e8c7b",
                                                "sense_id": "5a2afd59-8aaf-36aa-b669-069d4e1915de",
                                                "text": "Legendary NFL quarterback Joe Montana and his wife confronted a woman suspected of trying to kidnap their grandchild Saturday, according to the Los Angeles County Sheriff’s Department."
                                            },
                                            {
                                                "example_id": "2881831b-39e6-4347-bd81-b50724a4ea5b",
                                                "sense_id": "5a2afd59-8aaf-36aa-b669-069d4e1915de",
                                                "text": "A couple in India are suing their son and daughter-in-law – for not giving them grandchildren after six years of marriage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "141200d9-212f-4bd2-a7f7-dee3fc92bf8e",
                        "source_entry_id": "64198ece-8599-368e-a382-cfc3a00b8f4f",
                        "source_sense_id": "4a950d8e-d8ca-3a7a-8635-23aec18ece09",
                        "source_sense_description": "männliches oder weibliches Kind des eigenen Sohnes oder der eigenen Tochter (Enkelkind)",
                        "target_lang_word": "petit-enfant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petit-enfant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27b71bf6-ea4c-3abe-9688-0450e2576539",
                                        "entry_id": "0d5543db-a6be-36ed-8a32-2aa362aa52bd",
                                        "glosses": [
                                            "Enfant de son fils ou de sa fille. Note d’usage : Ce mot est peu usité au singulier, car on précise généralement petit-fils ou petite-fille. Il est en revanche utilisé au pluriel comme forme neutre de petits-fils et petites-filles."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24aabfed-4f74-450d-8caa-32d9ac700d66",
                                                "sense_id": "27b71bf6-ea4c-3abe-9688-0450e2576539",
                                                "text": "Petit-enfant . Tante . Cousin."
                                            },
                                            {
                                                "example_id": "deaa950e-adb1-4fa1-bfc6-c7a51189411e",
                                                "sense_id": "27b71bf6-ea4c-3abe-9688-0450e2576539",
                                                "text": "Pauline, ma vieille camarade de l'école maternelle, s'étonnait, devenue grand-mère, des façons de ses petits-enfants. «Ils sont drôles, ces mignons, disait-elle. Il leur faut leur scouteur rien que pour aller faire pipi.»"
                                            },
                                            {
                                                "example_id": "c2f634cc-7980-4d4f-b02a-43296f156895",
                                                "sense_id": "27b71bf6-ea4c-3abe-9688-0450e2576539",
                                                "text": "De nos jours il y a malheureusement aussi de moins en moins de grands-mères et de grands-pères auxquels les conditions de vie familiale et sociale permettent de raconter des histoires à leurs petits-enfants."
                                            },
                                            {
                                                "example_id": "d1db577b-d156-4734-9812-6132ff3dd061",
                                                "sense_id": "27b71bf6-ea4c-3abe-9688-0450e2576539",
                                                "text": "« Les enfants, c’est le capital. Et les petits-enfants, les intérêts du capital. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
