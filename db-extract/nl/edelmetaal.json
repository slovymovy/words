                                "target_senses": [
                                    {
                                        "sense_id": "b3ffda06-09b2-3934-8a28-bb4c6f07b796",
                                        "entry_id": "fa430d8d-e771-31b2-9108-c5b575610f33",
                                        "glosses": [
                                            "schwer in Reaktion zu bringendes Metall, das in der Spannungsreihe hinter dem Wasserstoff steht und ein positives Normalpotential besitzt"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b24b03f-d66c-40cb-82d8-f748a11b47d0",
                                                "sense_id": "b3ffda06-09b2-3934-8a28-bb4c6f07b796",
                                                "text": "Gegenstände aus Edelmetall sind oft wertvoll."
                                            },
                                            {
                                                "example_id": "952cc367-3cea-4c50-b258-e3c826db4445",
                                                "sense_id": "b3ffda06-09b2-3934-8a28-bb4c6f07b796",
                                                "text": "„Das Edelmetall hat für die Skandinavier eine besondere Bedeutung.“"
                                            },
                                            {
                                                "example_id": "02721e2b-b1a4-49b3-957a-5c959b79bd4b",
                                                "sense_id": "b3ffda06-09b2-3934-8a28-bb4c6f07b796",
                                                "text": "„Aber bald blieb den Europäern dann doch wieder nur, wie schon zu römischen Zeiten, Gewürze, kostbare Hölzer oder Porzellan gegen Edelmetall einzutauschen.“"
                                            },
                                            {
                                                "example_id": "962d264a-acea-4326-a8d9-6f3117c815e8",
                                                "sense_id": "b3ffda06-09b2-3934-8a28-bb4c6f07b796",
                                                "text": "„Wohl deshalb fehlten die Schätze aus Edelmetall, die man sonst in solchen Gräbern antrifft.“"
                                            },
                                            {
                                                "example_id": "439e893e-cb81-47ee-899b-bbc67756eec5",
                                                "sense_id": "b3ffda06-09b2-3934-8a28-bb4c6f07b796",
                                                "text": "„Um 1560 sollte die Einfuhr an Edelmetallen nach Spanien und Portugal die europäische Produktion um das Vier- bis Fünffache übertreffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
