                "translations": [
                    {
                        "translation_id": "7cbd3bf9-3750-474a-9e8d-f823a7605cfd",
                        "source_entry_id": "7c2e5844-27fe-3238-98e9-9e5408d1326d",
                        "target_lang_word": "stifle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stifle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c15f62f5-82f6-3e07-8db6-708dcd9d0f39",
                                        "entry_id": "0a4695a1-08c2-359a-8b80-777062401594",
                                        "glosses": [
                                            "To make (an animal or person) unconscious or cause (an animal or person) death by preventing breathing; to smother, to suffocate."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ad10a0-32f8-4932-a286-83b1eee1791d",
                                                "sense_id": "c15f62f5-82f6-3e07-8db6-708dcd9d0f39",
                                                "text": "I took my leave, being half stifled with the closeness of the room."
                                            },
                                            {
                                                "example_id": "a9a3e78b-59e9-4783-8dea-4b971d417cd7",
                                                "sense_id": "c15f62f5-82f6-3e07-8db6-708dcd9d0f39",
                                                "text": "And while her Hand the ſtreaming Blood oppos'd; / Join'd Face to Face, his Lips with hers ſhe clos'd. / Stifled with Kiſſes, a ſweet Death he dies; / She fills the Fields with undiſtinguiſh'd Cries: [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9132102b-8002-371f-85bf-e99a6698c468",
                                        "entry_id": "0a4695a1-08c2-359a-8b80-777062401594",
                                        "glosses": [
                                            "To cause (someone) difficulty in breathing, or a choking or gagging feeling."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba6be472-af7d-4c33-ac71-eddca20d238d",
                                                "sense_id": "9132102b-8002-371f-85bf-e99a6698c468",
                                                "text": "The heat was stifling the children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02453b68-6815-39fb-9625-671d5b35c132",
                                        "entry_id": "0a4695a1-08c2-359a-8b80-777062401594",
                                        "glosses": [
                                            "To prevent (a breath, cough, or cry, or the voice, etc.) from being released from the throat."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa1bde15-78e7-3508-ba75-dbe670fa1b9c",
                                        "entry_id": "0a4695a1-08c2-359a-8b80-777062401594",
                                        "glosses": [
                                            "To make (something) unable to be heard by blocking it with some medium."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98416678-7ca9-39ae-8545-1422bde56047",
                                        "entry_id": "0a4695a1-08c2-359a-8b80-777062401594",
                                        "glosses": [
                                            "To keep in, hold back, or repress (something)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "388f5247-b198-4068-a8d7-abbe57782202",
                                                "sense_id": "98416678-7ca9-39ae-8545-1422bde56047",
                                                "text": "The army stifled the rebellion."
                                            },
                                            {
                                                "example_id": "edab351f-c26e-4ad8-a35a-f2f0a894980f",
                                                "sense_id": "98416678-7ca9-39ae-8545-1422bde56047",
                                                "text": "I desire only to have things fairly represented as they really are; no evidence smothered or stifled."
                                            },
                                            {
                                                "example_id": "5adbe1c8-033f-49d0-bf83-3619e01102e4",
                                                "sense_id": "98416678-7ca9-39ae-8545-1422bde56047",
                                                "text": "Edward Churchill still attended to his work in a hopeless mechanical manner like a sleep-walker who walks safely on a well-known round. But his Roman collar galled him, his cossack stifled him, his biretta was as uncomfortable as a merry-andrew's cap and bells."
                                            },
                                            {
                                                "example_id": "78f4d5bc-9b40-4a4b-a1c8-2cc3fe880b29",
                                                "sense_id": "98416678-7ca9-39ae-8545-1422bde56047",
                                                "text": "In fact, there was no suggestion of that, although Wolves deployed men behind the ball to stifle the league leaders in a first-half that proved very frustrating for City."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22ad0670-2036-32c1-b1cf-02b8879249d9",
                                        "entry_id": "0a4695a1-08c2-359a-8b80-777062401594",
                                        "glosses": [
                                            "To prevent (something) from being revealed; to conceal, to hide, to suppress."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3b38bf6-a33a-3b92-aefe-a11803f4209f",
                                        "entry_id": "0a4695a1-08c2-359a-8b80-777062401594",
                                        "glosses": [
                                            "To treat (a silkworm cocoon) with steam as part of the process of silk production."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16c327a6-d2a0-3bdd-9ff6-5390b4e9ca2e",
                                        "entry_id": "0a4695a1-08c2-359a-8b80-777062401594",
                                        "glosses": [
                                            "To die of suffocation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d3af0e8-4428-488b-9c3d-ed9aac0502d5",
                                                "sense_id": "16c327a6-d2a0-3bdd-9ff6-5390b4e9ca2e",
                                                "text": "Two firemen tragically stifled in yesterday’s fire when trying to rescue an old lady from her bedroom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8d68395-ae64-3efd-9430-9a97c03efbc3",
                                        "entry_id": "0a4695a1-08c2-359a-8b80-777062401594",
                                        "glosses": [
                                            "To smother; to make breathing difficult."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dd39962-95dd-4adb-a9b9-bee5af26aa69",
                                                "sense_id": "a8d68395-ae64-3efd-9430-9a97c03efbc3",
                                                "text": "This heat is stifling."
                                            },
                                            {
                                                "example_id": "eb2f644b-e355-452b-9d26-0f6536860dd8",
                                                "sense_id": "a8d68395-ae64-3efd-9430-9a97c03efbc3",
                                                "text": "Nobody has shaved or changed clothes for a week, the heat stifles and the flies are everywhere. There is little water but we do not expect to be here long. This is not much of a letter, Jess. The mailbag goes down our trench once a day. I must finish because it stops for no one."
                                            }
                                        ]
                                    }
                                ]
                            },
