                    },
                    {
                        "form_id": "3f05e930-009f-44e0-8392-f1c527d79fa1",
                        "entry_id": "b310059d-afcd-319a-a4e5-ccca98fe4920",
                        "tags": [
                            "superlative"
                        ],
                        "form": "weakliest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "be2a79fd-5578-356c-8803-417735f139d5",
                        "entry_id": "b310059d-afcd-319a-a4e5-ccca98fe4920",
                        "glosses": [
                            "Frail, sickly or of a delicate constitution; weak."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc4816bc-6668-4341-8e09-60d65607fca6",
                                "sense_id": "be2a79fd-5578-356c-8803-417735f139d5",
                                "text": "I lay in weakly case and confined to my bed for four months before I was able to rise and health returned to me."
                            },
                            {
                                "example_id": "859801d0-080c-4b90-afb0-dbd6d84e6959",
                                "sense_id": "be2a79fd-5578-356c-8803-417735f139d5",
                                "text": "I'd always been but weakly, / And my baby was just born; / A neighbour minded her by day, / I minded her till morn."
                            },
                            {
                                "example_id": "31bdec34-8c92-4ce1-92d5-70b57dc85cb0",
                                "sense_id": "be2a79fd-5578-356c-8803-417735f139d5",
                                "text": "\"Oh, a huge crab,\" Jacob murmured—and begins his journey on weakly legs on the sandy bottom."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a99cf6e7-f5b8-3464-adb2-b0947b83fff9",
