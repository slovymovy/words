                                "sense_id": "58352675-4a27-323f-a5f4-eaea0bac28af",
                                "text": "„.In einem Pfandautomat werden Flaschen geprüft.“"
                            },
                            {
                                "example_id": "a022b951-0679-4c5e-a540-d3d551504934",
                                "sense_id": "58352675-4a27-323f-a5f4-eaea0bac28af",
                                "text": "„Discounter und Großbrauereien sollen bewusst Einwegflaschen im Mehrweg-Look kreiert haben, um Verbraucher am Pfandautomaten übers Ohr zu hauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
