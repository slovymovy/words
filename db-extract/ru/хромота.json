                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17857b5a-41dd-4e3b-b425-038e5a74f7cf",
                                "sense_id": "17ce25f0-75f5-364f-bd48-147a64e70051",
                                "text": "Хаджи́-Мура́т шёл, бы́стро ступа́я по парке́ту приёмной, пока́чиваясь всем то́нким ста́ном от лёгкой хромоты́ на одну́, бо́лее коро́ткую, чем друга́я, но́гу.",
                                "translation": "He stepped briskly across the parquet floor of the waiting room, his whole slender figure swaying slightly in consequence of his lameness in one leg which was shorter than the other.",
                                "english": "He stepped briskly across the parquet floor of the waiting room, his whole slender figure swaying slightly in consequence of his lameness in one leg which was shorter than the other."
                            }
                        ]
