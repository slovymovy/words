                "senses": [
                    {
                        "sense_id": "a3103014-cab4-3e0b-8e1f-cec06ca68176",
                        "entry_id": "b86ab389-8be2-3770-8cbc-9bd7c983b14f",
                        "glosses": [
                            "Zone de froissement, zone de déformation programmée, intentionnelle, destinée à absorber l'énergie du choc lors d'une collision."
                        ],
                        "tags": [
                            "Sécurité"
                        ],
                        "examples": [
                            {
                                "example_id": "b3f22eb9-1607-480a-a8f4-2b85c7e9e11c",
                                "sense_id": "a3103014-cab4-3e0b-8e1f-cec06ca68176",
                                "text": "Die Knautschzone ist so konstruiert, dass sie sich beim Aufprall des Fahrzeuges auf ein Hindernis verformt und dadurch die kinetische Energie des Fahrzeuges aufnimmt.",
                                "translation": "La zone de déformation est conçue de façon qu’elle se déforme lors l'impact contre un obstacle et absorbe l'énergie cinétique du véhicule."
                            }
                        ]
                    }
