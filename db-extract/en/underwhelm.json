                                                "example_id": "928cc901-bbff-46f3-8d7a-6a105d89c0d8",
                                                "sense_id": "caf0332b-5971-37d4-9248-4bda2c69db41",
                                                "text": "Die deutschen Hoffungen auf einen Oscar sind mal wieder enttäuscht worden."
                                            }
