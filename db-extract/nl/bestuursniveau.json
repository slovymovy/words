                        "sense_id": "6ff1a1da-4058-38bc-9e4b-474861d5fb30",
                        "entry_id": "7a860ee4-dfcb-33ee-816e-b648c6ce595f",
                        "glosses": [
                            "een laag van het bestuur met bepaalde bevoegdheden en afhankelijkheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef73307a-1e84-488b-b5f4-eeeb33bdffa9",
                                "sense_id": "6ff1a1da-4058-38bc-9e4b-474861d5fb30",
                                "text": "Volgens het adviesorgaan moet een hoger bestuursniveau, zoals de provincie of het Rijk, de regie nemen. Die partijen moeten gaan besluiten waar in Nederland nog logistiek vastgoed mag worden gebouwd."
                            },
                            {
                                "example_id": "b8a1611a-69ce-4ad8-a45b-84e47a3945e5",
                                "sense_id": "6ff1a1da-4058-38bc-9e4b-474861d5fb30",
                                "text": "De partijen Forum voor Democratie en Denk mogen bij de verkiezingen voor de Provinciale Staten in alle provincies meedoen. De Kiesraad heeft bekendgemaakt dat de twee nieuwkomers op het provinciale bestuursniveau overal voldoende ondersteuningsverklaringen hebben gekregen."
                            },
                            {
                                "example_id": "c9425cca-f1b9-4346-a748-96b5bc74c20b",
                                "sense_id": "6ff1a1da-4058-38bc-9e4b-474861d5fb30",
                                "text": "Er is uitgebreid onderzoek gedaan naar de verantwoordelijkheden en betrokkenheden van personen binnen de bank, van hoog tot laag. \"Op bestuursniveau is het de heer Timmermans geweest die verantwoordelijkheid heeft gedragen, dus lag het voor de hand dat hij de consequentie draagt.\" Het aftreden van bestuursvoorzitter Ralph Hamers was niet aan de orde."
                            }
                        ]
                    }
