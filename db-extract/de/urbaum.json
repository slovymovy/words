                "senses": [
                    {
                        "sense_id": "449b3248-96e3-33d0-8102-e7a3563e4843",
                        "entry_id": "2a06a318-2e06-35fd-9230-d1b652d75d93",
                        "glosses": [
                            "Urbild eines Baums, erster Baum überhaupt, erster Baum einer bestimmten Sorte"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "fc9c1731-6eea-4bac-af84-ae2d81d35248",
                                "sense_id": "449b3248-96e3-33d0-8102-e7a3563e4843",
                                "text": "Eine Horde Urbäume auf Madeira zwischen Wind, Nebelschwaden und treibendem Regen."
                            },
                            {
                                "example_id": "127bbf21-ea45-4941-8628-4d26d99d1978",
                                "sense_id": "449b3248-96e3-33d0-8102-e7a3563e4843",
                                "text": "Wenn man so will, ist die Rotbuche der deutsche Urbaum."
                            },
                            {
                                "example_id": "d7d04fdf-3350-42ee-9600-c848e38b3af6",
                                "sense_id": "449b3248-96e3-33d0-8102-e7a3563e4843",
                                "text": "Er nannte die Sorte dann Golden Delicious. Den Urbaum ließ er auf der Farm mit einem hölzernen Verschlag und einer Alarmanlage sichern."
                            },
                            {
                                "example_id": "42b110b4-413a-4bab-8cbf-19c1d2ec2d5a",
                                "sense_id": "449b3248-96e3-33d0-8102-e7a3563e4843",
                                "text": "Den „Urbaum“ entdeckten die Gärtner an der Rhedaer Straße."
                            },
                            {
                                "example_id": "d824c942-0f9a-4da7-abf2-366dc0f94d6d",
                                "sense_id": "449b3248-96e3-33d0-8102-e7a3563e4843",
                                "text": "Im Schlosspark ist zwar ein beeindruckender Nachfahre des Urbaums noch zu besichtigen, aber im großen Stil angebaut wurden die Äpfel auf einer Plantage bei Sonderburg."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
