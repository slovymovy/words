                                "target_senses": [
                                    {
                                        "sense_id": "410411f2-239b-3c42-b90d-fe756e3ca9a1",
                                        "entry_id": "cb541504-4105-38c8-963d-bfbeb0c25011",
                                        "glosses": [
                                            "A large cushion or pillow, usually cylindrical in shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8438959-60ed-4c1b-8d56-30de942cda24",
                                                "sense_id": "410411f2-239b-3c42-b90d-fe756e3ca9a1",
                                                "text": "And here I'll fling the pillow, there the bolster, / This way the coverlet, another way the sheets."
                                            },
                                            {
                                                "example_id": "d52ea646-26ff-44fd-a7e4-15cc175a46ce",
                                                "sense_id": "410411f2-239b-3c42-b90d-fe756e3ca9a1",
                                                "text": "[\"]Don't you know how [Joseph Mallord William] Turner spoils his pictures by introducing a man like a bolster in the foreground? Well, in actual life every landscape is spoilt by men of worse shapes still.\" / \"You sound like a bolster with the stuffing out.\" They laughed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ea5aeb1-3c94-385e-860d-a76e7abee603",
                                        "entry_id": "cb541504-4105-38c8-963d-bfbeb0c25011",
                                        "glosses": [
                                            "A pad, quilt, or anything used to hinder pressure, support part of the body, or make a bandage sit easy upon a wounded part; a compress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad5b3a2-f269-4a86-bf2e-c4c510f760f0",
                                                "sense_id": "7ea5aeb1-3c94-385e-860d-a76e7abee603",
                                                "text": "This Arm ſhall be a Bolſter for thy Head, / I'll fetch clean Straw to make my Soldier's Bed; / There, while thou ſleep'ſt, my Apron o'er thee hold, / Or with it patch thy Tent againſt the Cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2956a092-0e05-3148-8cad-1616823314c5",
                                        "entry_id": "cb541504-4105-38c8-963d-bfbeb0c25011",
                                        "glosses": [
                                            "A small spacer located on top of the axle of horse-drawn wagons that gives the front wheels enough clearance to turn."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6c63573-120c-32fa-838f-a8e22a0e9fc0",
                                        "entry_id": "cb541504-4105-38c8-963d-bfbeb0c25011",
                                        "glosses": [
                                            "A short, horizontal structural timber between a post and a beam for enlarging the bearing area of the post and/or reducing the span of the beam."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ca41c4a-e1fc-3a00-ba3c-bc8feb87a742",
                                        "entry_id": "cb541504-4105-38c8-963d-bfbeb0c25011",
                                        "glosses": [
                                            "A beam in the middle of a railway truck, supporting the body of the car."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22fa8523-d3a1-37de-900e-444f2ad24fa6",
                                        "entry_id": "cb541504-4105-38c8-963d-bfbeb0c25011",
                                        "glosses": [
                                            "The perforated plate in a punching machine on which anything rests when being punched."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96be398f-afc6-3144-8f1b-1af3f7afbe31",
                                        "entry_id": "cb541504-4105-38c8-963d-bfbeb0c25011",
                                        "glosses": [
                                            "The part of a knife blade that abuts upon the end of the handle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59e6a2bb-fa35-3366-8b6a-ea9174c511bb",
                                        "entry_id": "cb541504-4105-38c8-963d-bfbeb0c25011",
                                        "glosses": [
                                            "The metallic end of a pocketknife handle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db14bdcc-9a84-3ea1-88be-fe3858ca1816",
                                        "entry_id": "cb541504-4105-38c8-963d-bfbeb0c25011",
                                        "glosses": [
                                            "The rolls forming the ends or sides of the Ionic capital."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf7815c-7915-4389-9f80-d5b3b9e236cd",
                                                "sense_id": "db14bdcc-9a84-3ea1-88be-fe3858ca1816",
                                                "text": "Its [the Ionic's column's] ancient capital is generally formed of two parallel bolsters"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b00a6e48-d805-3ea2-a466-b165b8d78e91",
                                        "entry_id": "cb541504-4105-38c8-963d-bfbeb0c25011",
                                        "glosses": [
                                            "A block of wood on the carriage of a siege gun, upon which the breech of the gun rests when arranged for transportation."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb3675b0-9f08-3531-9383-a232dab22538",
                                        "entry_id": "cb541504-4105-38c8-963d-bfbeb0c25011",
                                        "glosses": [
                                            "That which supports or promotes; a catalyst."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebd5042d-5829-426e-b0b0-08c31a750d75",
                                                "sense_id": "bb3675b0-9f08-3531-9383-a232dab22538",
                                                "text": "My health too has been better since you took away that Montero cap. I have left off cayenned eggs and such bolsters to discomfort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "734b4f14-740b-3b5d-9340-3eba76862c21",
                                        "entry_id": "cb541504-4105-38c8-963d-bfbeb0c25011",
                                        "glosses": [
                                            "A wide-bladed cold chisel designed to split and shape bricks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bolster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee9f627a-6b29-3e32-8896-790561071bc4",
                                        "entry_id": "a8db12c0-6499-3105-ae29-1a1e130320f6",
                                        "glosses": [
                                            "To brace, reinforce, secure, or support."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a3580d0-656d-4b61-9612-cebf127cad9b",
                                                "sense_id": "ee9f627a-6b29-3e32-8896-790561071bc4",
                                                "text": "Puget also teamed up with Matt Hyde (Deftones, Slayer) to co-produce the record, which was another smart move: Together, the pair ensures that AFI (The Blood Album)'s arrangements are streamlined, but bolstered by just the right amount of atmospheric texture."
                                            },
                                            {
                                                "example_id": "012d3504-8eef-489d-bfde-6c317bdd6695",
                                                "sense_id": "ee9f627a-6b29-3e32-8896-790561071bc4",
                                                "text": "However, once the bi-modes come on stream this [the power supply] will need to be bolstered by a feed at Braybrooke, just south of Market Harborough, for which reason the Department for Transport has supported the extension of overhead electrification from Kettering to Market Harborough."
                                            },
                                            {
                                                "example_id": "270a1267-13af-4c2f-adc2-06bd5bcfe121",
                                                "sense_id": "ee9f627a-6b29-3e32-8896-790561071bc4",
                                                "text": "At the outbreak of the Second World War, the number of locomotives at the depot was bolstered by the loan of several tank engines from the GWR, usually fitted with the distinctive \"balloon\" spark arrestors."
                                            },
                                            {
                                                "example_id": "0c92c020-7ebc-49cf-9e50-fdf8fc8e0951",
                                                "sense_id": "ee9f627a-6b29-3e32-8896-790561071bc4",
                                                "text": "On a trip aimed at bolstering often-frayed ties with Riyadh, Sullivan also held joint talks with the crown prince, UAE national security adviser Sheikh Tahnoon bin Zayed al-Nahyan and India national security adviser Ajit Doval \"to advance their shared vision of a more secure and prosperous Middle East region interconnected with India and the world,\" the White House said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
