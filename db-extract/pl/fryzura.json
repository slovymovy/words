                                            {
                                                "example_id": "94d6a294-29e9-4953-b0c9-145c239e680b",
                                                "sense_id": "5f509d86-c9ca-3068-8dd3-84d1a7049c63",
                                                "text": "„Sie hatte eine Frisur, die so aussah, als hätte ihr ein Windstoß von rückwärts ins Haar geblasen.“"
                                            },
                                            {
                                                "example_id": "60329c34-421f-448d-b223-5ed38eb0aa5e",
                                                "sense_id": "5f509d86-c9ca-3068-8dd3-84d1a7049c63",
                                                "text": "„Sie liess den Wunsch ihrer Schwägerin unerfüllt, die nahm keine Aenderung an ihrer Frisur vor, ja sie sah nicht einmal mehr in den Spiegel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b06e83b8-95f7-4835-ace7-c1d64e0e10f3",
                        "source_entry_id": "d91ee732-b1be-328d-8fe5-7109e886999b",
                        "source_sense_id": "660084cb-4c21-3a50-9187-9661450b59fc",
                        "target_lang_word": "причёска",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "причёска",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1969b885-ddb8-39a9-8cf0-2fbd7bd62ee5",
                                        "entry_id": "11ed0ff4-1774-33ce-af99-0c75c645c75c",
                                        "glosses": [
                                            "действие по значению гл. причесать; причёсывать, причесаться, причёсываться; причёсывание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2b166d3-b5d5-45c0-a40d-2a6c6b8085d8",
                                                "sense_id": "1969b885-ddb8-39a9-8cf0-2fbd7bd62ee5",
                                                "text": "Она целое утро занималась причёской."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2740d233-bca1-31ef-b9a2-9616dfdcbee9",
                                        "entry_id": "11ed0ff4-1774-33ce-af99-0c75c645c75c",
                                        "glosses": [
                                            "расположение волос на голове, достигаемое расчёсыванием, стрижкой, завивкой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7f4d522-1a03-4ec2-96ea-9d136bd43b5c",
                                                "sense_id": "2740d233-bca1-31ef-b9a2-9616dfdcbee9",
                                                "text": "Мужские причёски того времени несомненно подверглись влиянию армейских стрижек различных стран и, конечно же, голливудского всемогущего целлулоида."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46f80323-8138-3663-a3a9-421154b687a5",
                                        "entry_id": "11ed0ff4-1774-33ce-af99-0c75c645c75c",
                                        "glosses": [
                                            "волосы, причёсанные и уложенные определённым образом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a38dd1bb-022c-4c8d-8c82-7241d6f7a5f0",
                                                "sense_id": "46f80323-8138-3663-a3a9-421154b687a5",
                                                "text": "Только что успела она войти в свою уборную, обсыпать своё длинное бледное лицо пудрой, стереть её, оправить причёску и приказать чай в большой гостиной, как уж одна за другою стали подъезжать кареты к её огромному дому на Большой Морской."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
