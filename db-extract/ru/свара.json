                        ]
                    },
                    {
                        "translation_id": "7a25e117-2263-420b-8bfa-8b1e5fd3a224",
                        "source_entry_id": "cd114fc2-966e-3d53-a3cc-60abc50e00c2",
                        "target_lang_word": "dispute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dispute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "811f8788-7982-3026-8fbb-ad568ccd6ba2",
                                        "entry_id": "d4eafd88-b4a6-346d-a7a5-3561d7b34535",
                                        "glosses": [
                                            "Discussion plus ou moins vive à propos d’opinions, d’intérêts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f517163-5002-409c-b5c7-24d855b79824",
                                                "sense_id": "811f8788-7982-3026-8fbb-ad568ccd6ba2",
                                                "text": "Dispute de mots : Débat qui tient à un malentendu sur les définitions des choses."
                                            },
                                            {
                                                "example_id": "aa664e20-0ce1-4223-8437-247ca05b6127",
                                                "sense_id": "811f8788-7982-3026-8fbb-ad568ccd6ba2",
                                                "text": "Avoir dispute ensemble, contre quelqu’un."
                                            },
                                            {
                                                "example_id": "c572dca0-2228-49b5-b121-19a97aa0962c",
                                                "sense_id": "811f8788-7982-3026-8fbb-ad568ccd6ba2",
                                                "text": "Hervé connaissait, pour y avoir passé comme les autres, l'ordre et la marche de ces disputes, et n'étant pas tenté de mettre le doigt entre l'arbre et l'écorce, il avait eu soin de se tenir à distance."
                                            },
                                            {
                                                "example_id": "b26d968d-3ecb-4004-b47c-75d1f7488f17",
                                                "sense_id": "811f8788-7982-3026-8fbb-ad568ccd6ba2",
                                                "text": "C’était un ivrogne qui, battant le trottoir et se heurtant aux arbres, menait une longue dispute avec les êtres de son rêve auxquels il donnait généreusement la parole, et qu’il accablait ensuite sous de grands gestes et des mots impérieux."
                                            },
                                            {
                                                "example_id": "5a25ee40-4ddf-452f-975e-cf39d88ecd4a",
                                                "sense_id": "811f8788-7982-3026-8fbb-ad568ccd6ba2",
                                                "text": "Une longue et subtile dispute."
                                            },
                                            {
                                                "example_id": "0a2a9c2a-8e6c-4f10-9509-8d73f31317d2",
                                                "sense_id": "811f8788-7982-3026-8fbb-ad568ccd6ba2",
                                                "text": "– La dispute est d’un grand secours, sans elle on dormirait toujours, dit la Sage, histoire de reprendre la conversation.\n– La Fontaine, « Le Chat et le Renard », livre IX, fable 14, vers 9 et 10, dit Kangourou, qui a sorti la bonne fiche de sa sacoche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "269e6506-8487-34dc-bd88-d29ff27b1fe3",
                                        "entry_id": "d4eafd88-b4a6-346d-a7a5-3561d7b34535",
                                        "glosses": [
                                            "Altercation violente, querelle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe963ec6-4e59-4781-b4d8-effac15549ca",
                                                "sense_id": "269e6506-8487-34dc-bd88-d29ff27b1fe3",
                                                "text": "Il m’était impossible de rester cinq minutes avec elle, qu’une dispute —qui se terminait invariablement par des violences de sa part— n’éclatât aussitôt."
                                            },
                                            {
                                                "example_id": "cc58e176-32d2-4ce3-8ee0-12b38f6d5529",
                                                "sense_id": "269e6506-8487-34dc-bd88-d29ff27b1fe3",
                                                "text": "Une dispute éclata dans la rue. — Il cherche dispute à ses voisins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0cda9ef-cda4-33a2-9fcb-954610cf93c2",
                                        "entry_id": "d4eafd88-b4a6-346d-a7a5-3561d7b34535",
                                        "glosses": [
                                            "Discussion, débat publics qui se faisaient dans les écoles, pour trancher les questions de théologie, de philosophie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12b6173-ae10-465e-806a-7e93daf37591",
                                                "sense_id": "b0cda9ef-cda4-33a2-9fcb-954610cf93c2",
                                                "text": "Je crois que les disputes théologiques sont à la fois la farce la plus ridicule et le fléau le plus affreux de la terre, immédiatement après la guerre, la peste, la famine et la vérole."
                                            },
                                            {
                                                "example_id": "4d90cbc0-5a36-4e8d-a9ea-83b59aaf76bd",
                                                "sense_id": "b0cda9ef-cda4-33a2-9fcb-954610cf93c2",
                                                "text": "J’ai admiré son esprit de dispute, capable de le faire se retirer de son propre avis, aussitôt qu’il voyait son contradicteur prêt à s’y ranger."
                                            },
                                            {
                                                "example_id": "753d058b-2b62-42e6-8f01-222d8873030d",
                                                "sense_id": "b0cda9ef-cda4-33a2-9fcb-954610cf93c2",
                                                "text": "Disputes publiques."
                                            },
                                            {
                                                "example_id": "639e810a-2063-4696-92f7-ccb300688ca6",
                                                "sense_id": "b0cda9ef-cda4-33a2-9fcb-954610cf93c2",
                                                "text": "Ouvrir la dispute."
                                            },
                                            {
                                                "example_id": "2bec3322-5912-46bc-b89d-70ffddb36e91",
                                                "sense_id": "b0cda9ef-cda4-33a2-9fcb-954610cf93c2",
                                                "text": "Assister aux disputes."
                                            },
                                            {
                                                "example_id": "c6428921-569a-4a15-bab5-98923448df99",
                                                "sense_id": "b0cda9ef-cda4-33a2-9fcb-954610cf93c2",
                                                "text": "Les disputes de l’école."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dispute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ca329eb-b153-326c-be66-5e377b1886cf",
