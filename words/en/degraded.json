{
    "word_family": [
        "degrade",
        "degradation",
        "degradable",
        "biodegradable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "920c8a44-a82c-3523-97c5-55d8d3653273",
                    "sense_definition": "Feeling or having undergone degradation; deprived of dignity or self-respect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humiliated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt deeply <w>degraded</w> after being forced to apologize publicly for something he did not do.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя глубоко <w>униженным</w> после того, как его заставили публично извиняться за то, чего он не совершал."
                            }
                        },
                        {
                            "text": "Living in such poor conditions made the refugees feel <w>degraded</w> and forgotten by the world.",
                            "target_lang_translations": {
                                "ru": "Жизнь в таких ужасных условиях заставляла беженцев чувствовать себя <w>униженными</w> и забытыми всем миром."
                            }
                        }
                    ],
                    "synonyms": [
                        "humiliated"
                    ],
                    "common_phrases": [
                        "feel degraded",
                        "deeply degraded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий или подвергшийся унижению; лишенный достоинства или самоуважения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "униженный",
                                "target_lang_sense_clarification": "лишенный достоинства"
                            },
                            {
                                "target_lang_word": "оскорбленный",
                                "target_lang_sense_clarification": "в своем достоинстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ae47fd1-7e89-3ab1-b430-dc0ec3419165",
                    "sense_definition": "Having a loss of capability or function; having undergone deterioration or degradation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deteriorated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The satellite sent back a <w>degraded</w> signal due to the severe solar storm.",
                            "target_lang_translations": {
                                "ru": "Спутник передал <w>искаженный</w> сигнал из-за сильной солнечной бури."
                            }
                        },
                        {
                            "text": "Years of intensive farming have left the soil in a highly <w>degraded</w> state.",
                            "target_lang_translations": {
                                "ru": "Годы интенсивного земледелия оставили почву в крайне <w>истощенном</w> состоянии."
                            }
                        }
                    ],
                    "synonyms": [
                        "degd"
                    ],
                    "common_phrases": [
                        "degraded signal",
                        "degraded state"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потерявший первоначальные свойства, качество или функциональность; ухудшившийся или разрушенный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деградировавший",
                                "target_lang_sense_clarification": "о состоянии почвы, среды"
                            },
                            {
                                "target_lang_word": "искаженный",
                                "target_lang_sense_clarification": "о сигнале или данных"
                            },
                            {
                                "target_lang_word": "ухудшившийся",
                                "target_lang_sense_clarification": "о качестве или состоянии"
                            },
                            {
                                "target_lang_word": "истощенный",
                                "target_lang_sense_clarification": "о почве или ресурсах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b756faf4-e2ee-3160-8e25-97e5af4ea9b1",
                    "sense_definition": "Having the typical characters or organs in a partially developed condition, or lacking certain parts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biological_reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flightless beetles possess <w>degraded</w> wings that are no longer functional.",
                            "target_lang_translations": {
                                "ru": "Нелетающие жуки обладают <w>редуцированными</w> крыльями, которые больше не функционируют."
                            }
                        },
                        {
                            "text": "Some cave-dwelling species have <w>degraded</w> eyes because they live in complete darkness.",
                            "target_lang_translations": {
                                "ru": "Некоторые виды, обитающие в пещерах, имеют <w>атрофированные</w> глаза, потому что живут в полной темноте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "degraded organs",
                        "degraded form"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий типичные признаки или органы в недоразвитом состоянии или лишенный некоторых частей (в биологии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "редуцированный",
                                "target_lang_sense_clarification": "об органах в биологии"
                            },
                            {
                                "target_lang_word": "атрофированный",
                                "target_lang_sense_clarification": "утративший функцию"
                            },
                            {
                                "target_lang_word": "недоразвитый",
                                "target_lang_sense_clarification": "о биологических структурах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2afc4845-579b-3db3-919d-0d0568368999",
                    "sense_definition": "Having steps; said of a cross whose extremities end in steps growing larger as they leave the centre.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family crest features a cross <w>degraded</w> on a field of silver.",
                            "target_lang_translations": {
                                "ru": "На семейном гербе изображен <w>ступенчатый</w> крест на серебряном поле."
                            }
                        },
                        {
                            "text": "In heraldry, a <w>degraded</w> cross is depicted as standing on several steps.",
                            "target_lang_translations": {
                                "ru": "В геральдике <w>ступенчатый</w> крест изображается стоящим на нескольких ступенях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cross degraded"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "heraldic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий ступени; о геральдическом кресте, концы которого заканчиваются ступенями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ступенчатый",
                                "target_lang_sense_clarification": "о геральдическом кресте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9909613e-f1c2-3324-aeaf-bd559e4086b3",
                    "sense_definition": "Simple past and past participle of <w>degrade</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh weather quickly <w>degraded</w> the quality of the outdoor wooden furniture.",
                            "target_lang_translations": {
                                "ru": "Суровая погода быстро <w>ухудшила</w> качество деревянной садовой мебели."
                            }
                        },
                        {
                            "text": "He was <w>degraded</w> from his rank after the scandal was revealed.",
                            "target_lang_translations": {
                                "ru": "Он был <w>разжалован</w> после того, как разразился скандал."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола degrade (разрушать, ухудшать, понижать в должности)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрушил",
                                "target_lang_sense_clarification": "прошедшее время от разрушать"
                            },
                            {
                                "target_lang_word": "понизил",
                                "target_lang_sense_clarification": "прошедшее время от понижать в звании"
                            },
                            {
                                "target_lang_word": "ухудшил",
                                "target_lang_sense_clarification": "прошедшее время от ухудшать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}