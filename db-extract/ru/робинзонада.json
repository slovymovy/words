                                "target_senses": [
                                    {
                                        "sense_id": "73c5d17b-6c5d-33b5-b5e3-56e779b49698",
                                        "entry_id": "c736ad2d-8f47-320f-9859-908579188ae3",
                                        "glosses": [
                                            "A genre of adventure fiction where a hero is stranded alone on a desert island and has to survive with their own wits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c087122-6d1e-46e0-be9d-d61066d34010",
                                                "sense_id": "73c5d17b-6c5d-33b5-b5e3-56e779b49698",
                                                "text": "Much, perhaps most, Minecraft fiction follows the robinsonade template, emphasizing the day-to-day life of a character, including nonhuman characters, striving to survive and thrive in a recognizably Minecraftian world by utilizing its resources."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d856bf0-0f33-4157-99d5-107acf8a2c32",
                        "source_entry_id": "be245dd6-5960-36f5-9294-89939c41e1bb",
                        "target_lang_word": "Robinsonade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Robinsonade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea5aca0c-074e-3c6f-ab07-ab9dfb3ff4c9",
                                        "entry_id": "cab18320-28a9-33a0-8d06-63f28f5a6c2f",
                                        "glosses": [
                                            "Schilderung eines Abenteuers (eines Protagonisten, der auf einer einsamen Insel landet)"
                                        ],
                                        "tags": [
                                            "Erzähltyp",
                                            "Literaturgattung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e57443df-5d5f-46e6-be8c-4a8ced206ab7",
                                                "sense_id": "ea5aca0c-074e-3c6f-ab07-ab9dfb3ff4c9",
                                                "text": "„Diese Arbeit wird sich mit der Frage beschäftigen, ob Arno Schmidts Erzählung Schwarze Spiegel als Robinsonade bezeichnet werden kann und falls ja, wie sich diese Typisierung rechtfertigen lässt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0ad1bc25-21e2-3bb2-804b-2d1fe0db3474",
                                        "entry_id": "cab18320-28a9-33a0-8d06-63f28f5a6c2f",
                                        "glosses": [
                                            "ein beeindruckendes Abenteuer (wie das des schiffbrüchigen Robinson Crusoe im gleichnamigen Roman von D. Defoe)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd2d0041-49d9-44b2-bbe5-3779222be211",
                                                "sense_id": "0ad1bc25-21e2-3bb2-804b-2d1fe0db3474",
                                                "text": "„Aber die Begierde, Ostindien zu sehen, benebelte meinen Verstand so sehr, daß ich alle Schwierigkeiten, die mir aufstoßen konnten, in den Wind schlug, und an nichts als an meine Robinsonade dachte, unbekümmert um die Folgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Robinsonade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19579e1d-5309-38a3-ba42-6a160985146e",
                                        "entry_id": "5c138684-0558-3a9a-bad9-ad40b4218b08",
                                        "glosses": [
                                            "spektakulärer Hechtsprung des Torhüters, um Schüsse in die Ecken des Tores zu verhindern"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81fc305a-401b-4c92-bde7-c2016a80c25e",
                                                "sense_id": "19579e1d-5309-38a3-ba42-6a160985146e",
                                                "text": "„Eine ‚Robinsonade‘ wie sie der Mannstädter Sportplatz noch nie gesehen hat! Die Robinsonade — so heißt sie nach Robinson, einem berühmten Tormann, dessen gefürchtete und bewunderte Spezialität sie war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
