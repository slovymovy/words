                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dafe4606-52d8-49f4-a669-6d8670c8fcf7",
                                "sense_id": "d31ca7d5-821f-3c90-bb77-a729b993d4a6",
                                "text": "La calcification est le dépôt de sels de calcium dans les tissus morts ou en cours de dégénérescence."
                            },
                            {
                                "example_id": "93ed23c5-54e9-4316-aae7-a608177c9db9",
                                "sense_id": "d31ca7d5-821f-3c90-bb77-a729b993d4a6",
                                "text": "Le coude a lui aussi été cassé, puis déformé par une calcification trop importante."
                            }
                        ]
                    }
                ],
