                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd4e9edc-752f-43f5-8bb2-3007fde9b0ae",
                                "sense_id": "eb3abc82-5c40-36ae-8e54-a6c9661cecce",
                                "text": "Het is een van de meest erotische werken uit de kunst die ik ken - net zoals Duchamp, voor wie het wil zien, een van de zinnelijkste kunstenaars is. Er is geen fractie naakt op het beeld te bespeuren, er is vooral suggestie. Dat is het opwindende eraan."
                            },
                            {
                                "example_id": "04bd3580-a1f3-4078-8d0e-3840c02eda70",
                                "sense_id": "eb3abc82-5c40-36ae-8e54-a6c9661cecce",
                                "text": "Na veel gepeins besloot ik een lange brief vol ervaringen, waarden en suggesties te schrijven aan mijn kinderen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
