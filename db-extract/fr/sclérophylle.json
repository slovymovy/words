                                        "entry_id": "92d957a2-8f60-3b99-95c0-2f0d8d7bd759",
                                        "glosses": [
                                            "Relating to sclerophylls."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18f0ce73-6dce-40e7-81b1-9ea7fc67eccb",
                                                "sense_id": "a0d4e869-db78-359f-83c5-6255a43a1e5c",
                                                "text": "The hipparionine horses arose in North America during the Middle Miocene and differed significantly from Anchitherium and other similar equids in the development of very high-crowned cheek teeth as a response to the more sclerophyllous, harder vegetation."
                                            }
                                        ]
                                    }
