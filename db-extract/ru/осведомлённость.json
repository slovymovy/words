                        "cross_references": [
                            {
                                "target_word": "awareness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae4c047-ed42-3669-b9c0-a47d228d0a5a",
                                        "entry_id": "397cf6f2-4cc4-3a76-bfdd-0626ef98716f",
                                        "glosses": [
                                            "The state or level of consciousness where sense data can be confirmed by an observer."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74bdbb59-ffb0-451f-8e93-843d46c6be66",
                                                "sense_id": "2ae4c047-ed42-3669-b9c0-a47d228d0a5a",
                                                "text": "I gradually passed from sleep to full awareness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "477e1a21-aefb-312a-b8ab-ad4a0db85719",
                                        "entry_id": "397cf6f2-4cc4-3a76-bfdd-0626ef98716f",
                                        "glosses": [
                                            "The state or quality of being aware of something."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02950beb-de7e-4a00-9dcd-3990face2564",
                                                "sense_id": "477e1a21-aefb-312a-b8ab-ad4a0db85719",
                                                "text": "raise awareness of a topic"
                                            },
                                            {
                                                "example_id": "c01958f4-1022-4093-a4bc-f9f58f1f899d",
                                                "sense_id": "477e1a21-aefb-312a-b8ab-ad4a0db85719",
                                                "text": "The awareness of one type of idea naturally fosters an awareness of another idea"
                                            },
                                            {
                                                "example_id": "99d0b9ae-47fc-46f2-bea8-760b0548e67f",
                                                "sense_id": "477e1a21-aefb-312a-b8ab-ad4a0db85719",
                                                "text": "Like a mind moving on a Möbius strip of events, one's consciousness goes over the same territory again and again without ever becoming aware of the nature of awareness."
                                            },
                                            {
                                                "example_id": "7f227801-e054-49df-a876-855fce1842fb",
                                                "sense_id": "477e1a21-aefb-312a-b8ab-ad4a0db85719",
                                                "text": "With the growing awareness of climate change, congestion, and regional inequality, rail transport has re-emerged as a solution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
