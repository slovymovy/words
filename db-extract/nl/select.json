                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d52829-c99e-445f-924d-594e71072267",
                                                "sense_id": "871e9d03-762c-3d6a-ab9d-5ac1b2cad10e",
                                                "text": "Exclusive clubs tend to serve exclusive brands of food and drinks, in the same exorbitant price range, such as the 'finest' French châteaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "449c85c9-6961-3599-b7f1-b0cfe69822cc",
                                        "entry_id": "d342f21d-59a1-33bc-8d6b-9b2099a556e8",
