                "senses": [
                    {
                        "sense_id": "93cb7d54-9e34-3f4f-9368-ce6218ff2fea",
                        "entry_id": "7914ebca-c76c-3aa0-a7f7-4ae207f61f16",
                        "glosses": [
                            "Blé complet, précuit et concassé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1feb6af2-be67-4e1e-b144-fc017cb5ba64",
                                "sense_id": "93cb7d54-9e34-3f4f-9368-ce6218ff2fea",
                                "text": "Faire chauffer une casserole d’eau salée, à ébullition, ajouter le pilpil et laisser cuire 10 minutes."
                            },
                            {
                                "example_id": "01db0ff6-f85f-415d-beeb-973944ec276d",
                                "sense_id": "93cb7d54-9e34-3f4f-9368-ce6218ff2fea",
                                "text": "Au Soudan, on cuisait du pilpil et du « couscous » de mil ou de sorgho dans des paniers tressés soumis à la vapeur de la même manière que l'on cuit aujourd'hui la semoule de blé ou d'orge dans la passoire du couscoussier."
                            },
                            {
                                "example_id": "b76f9188-2e35-4f90-b261-1ad69b10826c",
                                "sense_id": "93cb7d54-9e34-3f4f-9368-ce6218ff2fea",
                                "text": "C’est sa période zen, elle s’applique à mastiquer du pilpil et boit du thé vert."
                            }
                        ]
                    }
                ],
