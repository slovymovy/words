                "senses": [
                    {
                        "sense_id": "18773af5-505d-3b67-9223-ae5e3341f8d4",
                        "entry_id": "cfa45cb6-f23e-39a6-a6b9-1f8fcd4a633a",
                        "glosses": [
                            "Gerät zur Umwandlung einer Stromart in eine andere Stromart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15ce7f80-1dd4-4914-ba66-bcb4ce2f5b1d",
                                "sense_id": "18773af5-505d-3b67-9223-ae5e3341f8d4",
                                "text": "„Selbstgeführte Stromrichter werden für alle Arten der Umwandlung elektrischer Energie sowie für Energiefluss in einer oder in beiden Richtungen ausgeführt.“"
                            },
                            {
                                "example_id": "e5437aad-8c57-41bc-b96d-a529663f3c40",
                                "sense_id": "18773af5-505d-3b67-9223-ae5e3341f8d4",
                                "text": "„Den Schwerpunkt bildet die Behandlung aller Grundtypen von Steuerverfahren. Die Standardvarianten für ein- und dreiphasige Stromrichter mit Spannungszwischenkreis werden ausführlich beschrieben und miteinander verglichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
