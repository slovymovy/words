{
    "word_family": [
        "dispose",
        "disposable",
        "disposed",
        "disposition",
        "indisposed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04be3f87-c2ca-3a23-8805-bcf6917b4f40",
                    "sense_definition": "The act of getting rid of something that is no longer wanted or needed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city has strict rules regarding the <w>disposal</w> of hazardous household waste.",
                            "target_lang_translations": {
                                "ru": "В городе действуют строгие правила в отношении <w>утилизации</w> опасных бытовых отходов."
                            }
                        },
                        {
                            "text": "Proper waste <w>disposal</w> is essential for protecting the local environment.",
                            "target_lang_translations": {
                                "ru": "Правильное <w>удаление</w> отходов необходимо для защиты местной окружающей среды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waste disposal",
                        "sewage disposal",
                        "bomb disposal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс избавления от чего-либо, что больше не нужно или нежелательно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утилизация",
                                "target_lang_sense_clarification": "переработка или уничтожение отходов"
                            },
                            {
                                "target_lang_word": "удаление",
                                "target_lang_sense_clarification": "вывоз или устранение мусора"
                            },
                            {
                                "target_lang_word": "обезвреживание",
                                "target_lang_sense_clarification": "в контексте опасных отходов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9aef0ac-50ae-314d-9ea4-06e7d8fda102",
                    "sense_definition": "The state of being available for someone to use as they wish.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "availability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you need any help with the project, I am entirely at your <w>disposal</w>.",
                            "target_lang_translations": {
                                "ru": "Если вам понадобится помощь с проектом, я полностью в вашем <w>распоряжении</w>."
                            }
                        },
                        {
                            "text": "The company put a private car at his <w>disposal</w> during his business trip.",
                            "target_lang_translations": {
                                "ru": "Компания предоставила в его <w>распоряжение</w> личный автомобиль на время командировки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "at your disposal",
                        "at their disposal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние доступности чего-либо для использования по чьему-либо усмотрению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распоряжение",
                                "target_lang_sense_clarification": "право пользоваться чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54732509-d64a-30d9-b434-c695a1cc4a29",
                    "sense_definition": "An electrical device under a kitchen sink that shreds food waste into small pieces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't put large bones down the garbage <w>disposal</w> or it might jam.",
                            "target_lang_translations": {
                                "ru": "Не бросайте крупные кости в <w>измельчитель</w> отходов, иначе его может заклинить."
                            }
                        },
                        {
                            "text": "The kitchen is equipped with a dishwasher and a new <w>disposal</w> unit.",
                            "target_lang_translations": {
                                "ru": "Кухня оборудована посудомоечной машиной и новым <w>измельчителем</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "garbage disposal",
                        "sink disposal"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрическое устройство под кухонной раковиной для измельчения пищевых отходов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "измельчитель",
                                "target_lang_sense_clarification": "кухонный прибор для отходов"
                            },
                            {
                                "target_lang_word": "диспоузер",
                                "target_lang_sense_clarification": "технический термин для измельчителя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbf97a2c-e451-391c-9f60-78f96d098bf2",
                    "sense_definition": "The way in which something is arranged or distributed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general carefully planned the <w>disposal</w> of his troops across the valley.",
                            "target_lang_translations": {
                                "ru": "Генерал тщательно спланировал <w>расстановку</w> своих войск по всей долине."
                            }
                        },
                        {
                            "text": "The effective <w>disposal</w> of assets was key to the company's restructuring plan.",
                            "target_lang_translations": {
                                "ru": "Эффективная <w>реализация</w> активов стала ключом к плану реструктуризации компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "consignment"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, которым что-либо расположено, распределено или организовано."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расположение",
                                "target_lang_sense_clarification": "размещение объектов или сил"
                            },
                            {
                                "target_lang_word": "расстановка",
                                "target_lang_sense_clarification": "порядок размещения (например, войск)"
                            },
                            {
                                "target_lang_word": "реализация",
                                "target_lang_sense_clarification": "в контексте продажи активов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b06a367-4084-31d6-aed9-0a9ef1e80f3c",
                    "sense_definition": "In Australian Rules Football, a legal kick or handball of the ball.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The midfielder finished the game with thirty <w>disposals</w> and two goals.",
                            "target_lang_translations": {
                                "ru": "Полузащитник закончил игру с тридцатью <w>передачами</w> и двумя голами."
                            }
                        },
                        {
                            "text": "His efficient <w>disposal</w> of the ball helped his team maintain possession.",
                            "target_lang_translations": {
                                "ru": "Его эффективное <w>распоряжение</w> мячом помогло команде сохранить владение."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В австралийском футболе: разрешенный правилами удар ногой или передача мяча рукой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распоряжение мячом",
                                "target_lang_sense_clarification": "техническое действие игрока"
                            },
                            {
                                "target_lang_word": "передача",
                                "target_lang_sense_clarification": "пас или удар в игре"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}