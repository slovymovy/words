                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "af2f541d-bfdb-429e-944f-17adaeb7df66",
                                "sense_id": "71a84f65-0a4d-3465-a0a7-dcfc419cdebb",
                                "text": "Dat Couperus een fabelachtig talent had, zal wel niemand ontkennen; evenmin, dat zijn talent zeer persoonlijk en voor Holland ‘einmalig’ was; maar dat alles is nog geen verklaring voor zijn wereldnaam, en Van Booven geeft nergens die verklaring, omdat hij, ‘aan de voeten van de meester’ zittend, geen problemen kent en slechts voortdurend polemiseert met Netscher en andere verouderde knibbelaars, die een bestrijding al lang niet meer verdienen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5e43964-13ac-3704-a6be-d98003b5d466",
                        "entry_id": "e23798fd-289d-394d-a554-39f55aa9e617",
                        "glosses": [
                            "iemand die conflicten aangaat over kleinigheden"
                        ],
                        "tags": [
                            "pejorative",
                            "person"
                        ],
                        "examples": [
                            {
