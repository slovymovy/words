                    "target_lang_definitions": {
                        "zh": "（儿童游戏中喊停时用语）暂停！停！不玩了！"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "暂停",
                                "target_lang_sense_clarification": "游戏中要求停手喊话"
