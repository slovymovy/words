                "senses": [
                    {
                        "sense_id": "81569c89-7992-3628-86e9-89403c985da7",
                        "entry_id": "b0b590b3-5c62-359a-9501-bcf8767d308f",
                        "glosses": [
                            "Gesamtheit aller Arbeiten, die zum Einbringen von Mais notwendig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8ee4c1b-3149-4d53-89f2-59a032a04182",
                                "sense_id": "81569c89-7992-3628-86e9-89403c985da7",
                                "text": "„Als die Zeit der Maisernte schließlich da war, hatte es Walker geschafft, seine Frau mit den eigenen Befürchtungen ganz verrückt zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b6680496-eb74-3e0a-895b-d9aa5c65b5a0",
                        "entry_id": "b0b590b3-5c62-359a-9501-bcf8767d308f",
                        "glosses": [
                            "Ertrag des Einbringens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c54d2db3-d766-4208-b223-bd3c6481b557",
                                "sense_id": "b6680496-eb74-3e0a-895b-d9aa5c65b5a0",
                                "text": "„Während der Fahrt erzählt ein alter Mann, wie seine Farm vom Hochwasser während der Regenzeit zerstört wurde. Er hat die gesamte Hirse- und Maisernte verloren.“"
                            },
                            {
                                "example_id": "d779f11f-0aa9-4683-a212-d6836cc1581a",
                                "sense_id": "b6680496-eb74-3e0a-895b-d9aa5c65b5a0",
                                "text": "„Nur 10 Prozent des Hasarajat sind bebaubar, und die Weizen- und Maisernte war in dem Jahr schlecht ausgefallen.“"
                            },
                            {
                                "example_id": "488b3816-7f55-4238-8eca-3c4a1e6a0ba2",
                                "sense_id": "b6680496-eb74-3e0a-895b-d9aa5c65b5a0",
                                "text": "„Um 1450 setzte eine Heuschreckenplage dem Land zu, und im Jahr 1454 und in den folgenden vier Jahren blieb die Maisernte aus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
