                                    {
                                        "sense_id": "615166eb-27ba-3158-81c8-a6918c3874ef",
                                        "entry_id": "d610ddd9-1128-34ad-b8ec-ebe60776d799",
                                        "glosses": [
                                            "ungewollte Veränderung zurück in Richtung des schlechteren Status quo ante"
