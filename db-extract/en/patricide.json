                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "512da06b-4e09-4fd9-a387-26fc870d4cde",
                                                "sense_id": "efc5bb19-a03c-366f-95df-45a8aaf67806",
                                                "text": "Ödipus wurde, ohne es zu wissen, zum Vatermörder."
                                            },
                                            {
                                                "example_id": "432fc01d-42be-45d8-8756-db890b143a14",
                                                "sense_id": "efc5bb19-a03c-366f-95df-45a8aaf67806",
                                                "text": "„Er wusste, dass Sunkan die Tochter seines Vorgängers Pastor Krogh war, und genau wie andere auf der Insel Suduroy hatte er die Gerüchte über den Vatermörder von Sumba gehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
