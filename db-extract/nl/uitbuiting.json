        "nl-extract.jsonl": [
            {
                "entry_id": "cf43a346-368d-31d6-8f39-cca58406bb8c",
                "word": "uitbuiting",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "840336f4-087e-4c13-a0d3-82d77e7b10b5",
                        "entry_id": "cf43a346-368d-31d6-8f39-cca58406bb8c",
                        "tags": [
                            "plural"
                        ],
                        "form": "uitbuitingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b320ea2d-f53b-3066-a93a-b3832c1a7f53",
                        "entry_id": "cf43a346-368d-31d6-8f39-cca58406bb8c",
                        "glosses": [
                            "het op nietsontziende wijze zijn voordeel doen van de omstandigheden van iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d0429e5-6e3e-4546-b329-142992a3c0c8",
                                "sense_id": "b320ea2d-f53b-3066-a93a-b3832c1a7f53",
                                "text": "Honderden jaren van uitbuiting en vernietiging hebben ons naar de afgrond gebracht. Over de hele planeet verliezen mensen hun leefwijze, leefomgeving en levens. We hebben nog maar een paar jaar om de ergste gevolgen van de klimaatcrisis af te wenden, als we niet al te laat zijn. De zesde massale uitstervingsgolf is begonnen. Wat we de komende paar jaar doen bepaalt de toekomst van het leven op Aarde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e6ff6b3-4f4b-4cb3-a9d1-634cf8e11f69",
                        "source_entry_id": "cf43a346-368d-31d6-8f39-cca58406bb8c",
                        "source_sense_id": "b320ea2d-f53b-3066-a93a-b3832c1a7f53",
                        "source_sense_description": "het gebruik van iemand maken zonder daar naar waarde voor te belonen",
                        "target_lang_word": "Ausbeutung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausbeutung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd577914-0bb0-34d0-9d83-9fea2f40526c",
                                        "entry_id": "623e71e6-ad03-3034-8652-e4f4441c1a91",
                                        "glosses": [
                                            "Gewinnung, Nutzbarmachung (vor allem von Rohstoffen, materiellen Ressourcen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7c137ad-c33d-48f6-91e8-148fb70fea6b",
                                                "sense_id": "cd577914-0bb0-34d0-9d83-9fea2f40526c",
                                                "text": "In der Wirtschaftskrise wird die Ausbeutung der Rohstoffe zurückgehen."
                                            },
                                            {
                                                "example_id": "e1f9b0c1-264f-43eb-bf1f-6089d03ea73a",
                                                "sense_id": "cd577914-0bb0-34d0-9d83-9fea2f40526c",
                                                "text": "Der Grönländer Aqqualuk Lynge ist Vorsitzender der Inuitorganisation Circumpolar Council, die zur Vorsicht und Nachhaltigkeit bei der Ausbeutung der Naturschätze der Arktis mahnt."
                                            },
                                            {
                                                "example_id": "eb89e4aa-d026-46ce-8266-f198497a0af1",
                                                "sense_id": "cd577914-0bb0-34d0-9d83-9fea2f40526c",
                                                "text": "Was bisher aber fehlt, so Tom Gleeson, ist eine Abschätzung wie gravierend die Ausbeutung des Grundwassers global und regional betrachtet tatsächlich ist."
                                            },
                                            {
                                                "example_id": "2c9ced27-a07d-4845-942d-6bacceddb7fb",
                                                "sense_id": "cd577914-0bb0-34d0-9d83-9fea2f40526c",
                                                "text": "„Die Handelsfamilie spekulierte auf einen wirtschaftlichen Vorteil durch die Ausbeutung von Bodenschätzen und Arbeitskräften in einem unterworfenen Land.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ecaa9eb7-5730-3418-ae36-616b3afbeb99",
                                        "entry_id": "623e71e6-ad03-3034-8652-e4f4441c1a91",
                                        "glosses": [
                                            "gewissenlose, überzogene, unangemessene Nutzung (besonders von Arbeitskräften, Ressourcen)"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c21fac7-845a-478d-a9ac-97d4833b35e6",
                                                "sense_id": "ecaa9eb7-5730-3418-ae36-616b3afbeb99",
                                                "text": "„Die Handelsfamilie spekulierte auf einen wirtschaftlichen Vorteil durch die Ausbeutung von Bodenschätzen und Arbeitskräften in einem unterworfenen Land.“"
                                            },
                                            {
                                                "example_id": "fe536f2f-10f3-4dbe-97da-e43f7aec8eb9",
                                                "sense_id": "ecaa9eb7-5730-3418-ae36-616b3afbeb99",
                                                "text": "Die Gewerkschaften sind vor allem dazu da, der Ausbeutung von Arbeitnehmern entgegenzuwirken."
                                            },
                                            {
                                                "example_id": "6c294e15-0ca7-4aac-8d59-575c95a36c3d",
                                                "sense_id": "ecaa9eb7-5730-3418-ae36-616b3afbeb99",
                                                "text": "Bei sexueller Ausbeutung nutzt ein Freier die Not einer armen Frau in der Dritten Welt oder bei uns aus Osteuropa aus."
                                            },
                                            {
                                                "example_id": "f16b70a9-2bad-436d-a8e8-74574acaca07",
                                                "sense_id": "ecaa9eb7-5730-3418-ae36-616b3afbeb99",
                                                "text": "„Es ist der bis dahin größte Aufstand der schwarzen Mehrheit Südafrikas gegen die Unterdrückung und Ausbeutung durch die Weißen.“"
                                            },
                                            {
                                                "example_id": "e56e8b39-83e9-4925-8d21-7ce6e2a9b24c",
                                                "sense_id": "ecaa9eb7-5730-3418-ae36-616b3afbeb99",
                                                "text": "„Die Ausbeutung ist kaum weniger brutal als zu Zeiten von Leopolds Freistaat.“"
                                            },
                                            {
                                                "example_id": "28b5ffe4-13fb-4eb6-bd15-2e09692a3f9d",
                                                "sense_id": "ecaa9eb7-5730-3418-ae36-616b3afbeb99",
                                                "text": "Odebrecht muss wegen der Ausbeutung seiner brasilianischen Landarbeiter auf angolanischen Baustellen eine Strafe von umgerechnet neun Millionen Euro zahlen."
                                            },
                                            {
                                                "example_id": "a07aaf27-572b-438f-bab4-a849cf23d0cc",
                                                "sense_id": "ecaa9eb7-5730-3418-ae36-616b3afbeb99",
                                                "text": "Ob in der Landwirtschaft oder im Pflegebereich: Viele Menschen arbeiten sehr viel - für sehr wenig Geld. Die Ausbeutung der Arbeitskraft fällt seit 2005 unter den Straftatbestand des Menschenhandels."
                                            },
                                            {
                                                "example_id": "ab95bc50-75a3-4cb6-8202-de1cd1d6c701",
                                                "sense_id": "ecaa9eb7-5730-3418-ae36-616b3afbeb99",
                                                "text": "[Der Autor Egon] Flaig definiert Sklaverei als \"sozialen Tod\"; es ist nicht nur die ökonomische Ausbeutung, in vielen Fällen bis zum Exitus, sondern auch das Herausfallen aus allen tradierten, familialen und normativen Bezügen, die die Sklaverei kennzeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48957cb5-5ef5-4730-be27-27a5e53b39ce",
                        "source_entry_id": "cf43a346-368d-31d6-8f39-cca58406bb8c",
                        "source_sense_id": "b320ea2d-f53b-3066-a93a-b3832c1a7f53",
