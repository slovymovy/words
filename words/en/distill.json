                            },
                            {
                                "target_lang_word": "перегонять",
                                "target_lang_sense_clarification": "в контексте процесса перегонки жидкостей"
                            },
                            {
                                "target_lang_word": "извлекать суть",
                                "target_lang_sense_clarification": "в переносном смысле, выделять главное"
                            },
                            {
                                "target_lang_word": "концентрировать",
