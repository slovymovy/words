                ],
                "senses": [
                    {
                        "sense_id": "8f9dc077-d2c5-3516-b31e-64baf5edbde4",
                        "entry_id": "d69f21b8-ab29-342c-87f6-ea91f0fae216",
                        "glosses": [
                            "Caractère de ce qui est thermostable, qui ne se dégrade pas malgré une certaine augmentation de la température."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b739eecb-a935-4b34-b24e-a39fa7f8122e",
                                "sense_id": "8f9dc077-d2c5-3516-b31e-64baf5edbde4",
                                "text": "L’ajout de graphène dans un polymère permet d’augmenter la dureté et la thermostabilité du polymère."
                            },
                            {
                                "example_id": "c95c4569-67ea-4f9d-b17c-f28ecd636c20",
                                "sense_id": "8f9dc077-d2c5-3516-b31e-64baf5edbde4",
                                "text": "La mise en évidence des composés organiques réagissant avec les phosphates au cours de la stérilisation constitue certainement une étape indispensable pour définir le rôle du phosphate sur la thermostabilité des laits."
                            },
                            {
                                "example_id": "1d41dbfc-aae5-4dab-ae05-2c24173c2497",
                                "sense_id": "8f9dc077-d2c5-3516-b31e-64baf5edbde4",
                                "text": "Ainsi, l’une des approches les plus utilisées pour augmenter la thermostabilité d’une enzyme est l’introduction de ponts disulfure qui s’accompagne d’une stabilisation du repliement de la chaîne protéique."
                            }
                        ]
                    }
