                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "variant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum display featured a stuffed <w>grisly</w> from the early nineteenth century.",
                            "target_lang_translations": {
                                "ru": "В музейной экспозиции было представлено чучело <w>гризли</w> начала девятнадцатого века."
                            }
                        },
                        {
                            "text": "Early settlers often feared the <w>grisly</w> more than any other animal in the wilderness.",
                            "target_lang_translations": {
                                "ru": "Первые поселенцы часто боялись <w>гризли</w> больше, чем любого другого животного в дикой местности."
                            }
                        }
                    ],
                    "synonyms": [
                        "grizzly"
                    ],
                    "traits": [
