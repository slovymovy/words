{
    "word_family": [
        "inoubliable",
        "oubli",
        "oubliable",
        "oubliette",
        "oublieux"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1da0fb5-8725-321e-9064-44bb4c791dc6",
                    "sense_definition": "Perdre le souvenir de quelque chose ou de quelqu'un.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne pourrai jamais <w>oublier</w> cette belle journée passée avec vous à la plage."
                        },
                        {
                            "text": "Il <w>oublie</w> souvent le prénom de ses nouveaux collègues de bureau."
                        }
                    ],
                    "antonyms": [
                        "se rappeler",
                        "se remémorer",
                        "se souvenir"
                    ],
                    "common_phrases": [
                        "oublier son nom"
                    ]
                },
                {
                    "sense_id": "98a4a951-1306-3f04-9113-0dbf9ebe57e5",
                    "sense_definition": "Laisser par mégarde un objet quelque part.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inadvertance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En partant ce matin, elle a <w>oublié</w> ses clés sur la table du salon."
                        },
                        {
                            "text": "Prends ton parapluie avec toi et ne l'<w>oublie</w> pas dans le train."
                        }
                    ],
                    "synonyms": [
                        "laisser"
                    ],
                    "common_phrases": [
                        "oublier ses clés",
                        "oublier son sac"
                    ]
                },
                {
                    "sense_id": "3e425498-dab5-39bc-a627-adf49c1734ee",
                    "sense_definition": "Omettre de faire une action par manque d'attention ou négligence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "omission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'<w>oubliez</w> pas de fermer la porte à clé avant de quitter l'appartement."
                        },
                        {
                            "text": "Il a complètement <w>oublié</w> d'envoyer le rapport financier au directeur ce matin."
                        }
                    ],
                    "synonyms": [
                        "omettre"
                    ],
                    "common_phrases": [
                        "oublier de faire"
                    ]
                },
                {
                    "sense_id": "11e7f3b3-fff1-3c97-974c-43c3d6da31f1",
                    "sense_definition": "Ne plus garder de rancune ou de ressentiment pour une faute commise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pardon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après leur longue dispute, ils ont décidé d'<w>oublier</w> le passé et d'avancer."
                        },
                        {
                            "text": "Elle lui a pardonné son erreur et a vite <w>oublié</w> cette maladresse."
                        }
                    ],
                    "common_phrases": [
                        "oublier le passé",
                        "oublier une offense"
                    ]
                },
                {
                    "sense_id": "9ec8f6a8-dd45-3c14-af98-3f2accad89fb",
                    "sense_definition": "Négliger quelqu'un ou cesser de donner de ses nouvelles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il a déménagé à l'étranger, il <w>oublie</w> un peu ses vieux camarades."
                        },
                        {
                            "text": "Tu ne viens plus nous voir le week-end, tu nous <w>oublies</w>."
                        }
                    ],
                    "common_phrases": [
                        "oublier ses amis",
                        "oublier les siens"
                    ]
                },
                {
                    "sense_id": "6aece2a0-011c-3d4a-b878-06434aafa673",
                    "sense_definition": "Ne plus prêter attention à sa propre personne par altruisme.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "devouement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle passe tout son temps libre à aider les malades sans jamais penser à elle, elle s'<w>oublie</w> totalement."
                        },
                        {
                            "text": "Il est généreux mais il ne faut pas s'<w>oublier</w> pour faire plaisir aux autres."
                        }
                    ],
                    "common_phrases": [
                        "s'oublier pour autrui"
                    ]
                }
            ]
        }
    ]
}