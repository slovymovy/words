                "senses": [
                    {
                        "sense_id": "86677fd4-d0b4-3f55-a7d9-e4e518224bc8",
                        "entry_id": "ff16eb30-714f-3725-8821-837a46470fb6",
                        "glosses": [
                            "gute Zeit, Zeitraum, in dem Heil und Gnade herrschen, wo Erlösung noch möglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce13d20-a2dd-4857-9669-ba697aa29eb3",
                                "sense_id": "86677fd4-d0b4-3f55-a7d9-e4e518224bc8",
                                "text": "„›O Damian! wie kannst Du so sprechen!‹ rief sie klagend aus. ›Alles, was Du aufzählst, zeigt ja eben, wie arm an Gnaden man außerhalb der Kirche ist; denn jene Zeiten sind Gnadenzeiten, und wer arm an Gnaden ist, der ist wahrhaft arm.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e7bbcb4d-b4f2-3ce4-b2ef-3d357b9e5e08",
                        "entry_id": "ff16eb30-714f-3725-8821-837a46470fb6",
                        "glosses": [
                            "Zeitraum, in dem Witwe und Waisen eines Verstorbenen seinen Lohn weiterhin erhielten, der so ausbezahlte Verdienst"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f60288a6-7220-4e25-9333-14c47a43fffb",
                                "sense_id": "e7bbcb4d-b4f2-3ce4-b2ef-3d357b9e5e08",
                                "text": "„Hier interessirt die Gnadenzeit im engeren und eigentlichen Sinne, welche in der Kirche der Witwe und den Kindern verstorbener Geistlichen zusteht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
