    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df7e5866-197a-3caa-a068-9ec8c655cd23",
                    "sense_definition": "The plural form of <w>paw</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat cleaned its <w>paws</w> after eating its dinner.",
                            "target_lang_translations": {
                                "ru": "Кошка вылизала свои <w>лапы</w> после ужина."
                            }
                        },
                        {
                            "text": "The dog left muddy <w>paws</w> all over the clean kitchen floor.",
                            "target_lang_translations": {
                                "ru": "Собака оставила грязные <w>лапы</w> на чистом полу кухни."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cat paws",
                        "dog paws"
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова «лапа» (ступня животного с когтями)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапы",
                                "target_lang_sense_clarification": "анатомическая часть тела животного"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16b492e8-3e1a-307c-82b2-26e13a761d7a",
                    "sense_definition": "The third-person singular simple present indicative form of <w>paw</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog <w>paws</w> at the door when it wants to go outside.",
                            "target_lang_translations": {
                                "ru": "Собака <w>скребёт</w> дверь, когда хочет выйти на улицу."
                            }
                        },
                        {
                            "text": "He <w>paws</w> through the pile of old papers looking for his keys.",
                            "target_lang_translations": {
                                "ru": "Он <w>роется</w> в стопке старых бумаг в поисках ключей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paws at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глагол в форме 3-го лица единственного числа: скрести лапой, рыться или настойчиво требовать чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скребёт",
                                "target_lang_sense_clarification": "действие животного лапой"
                            },
                            {
                                "target_lang_word": "роется",
                                "target_lang_sense_clarification": "поиск чего-либо в вещах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94dc2eef-33c5-3f3a-90c9-ccf6e896757f",
                    "sense_definition": "An acronym for pervasive arousal withdrawal syndrome.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_acronyms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was diagnosed with <w>paws</w> after showing signs of chronic nervous system overstimulation.",
                            "target_lang_translations": {
                                "ru": "Пациенту диагностировали <w>PAWS</w> после проявления признаков хронического перевозбуждения нервной системы."
                            }
                        },
                        {
                            "text": "Researchers are studying the long-term effects of <w>paws</w> on mental health recovery.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучают долгосрочное влияние <w>PAWS</w> на восстановление психического здоровья."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура, обозначающая синдром первазивного возбуждения при отмене (медицинский термин)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "PAWS",
                                "target_lang_sense_clarification": "медицинский акроним (синдром)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1246eccd-b57d-3a52-b7c0-e2e743b9e9d1",
                    "sense_definition": "An acronym for post-acute-withdrawal syndrome.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_acronyms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people in recovery experience <w>paws</w> months after stopping substance use.",
                            "target_lang_translations": {
                                "ru": "Многие люди в процессе выздоровления сталкиваются с <w>ПАВС</w> спустя месяцы после прекращения употребления веществ."
                            }
                        },
                        {
                            "text": "Understanding <w>paws</w> is essential for supporting individuals during their long-term recovery process.",
                            "target_lang_translations": {
                                "ru": "Понимание <w>ПАВС</w> необходимо для поддержки людей в процессе их долгосрочного выздоровления."
                            }
                        }
