                    {
                        "sense_id": "b74deda9-2ab2-3135-9aaa-458e98456ca0",
                        "entry_id": "a3b42e98-f6c5-3aaa-a7f1-28e2bdc04253",
                        "glosses": [
                            "een actie waarbij men tracht een bewegend doel in te halen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "144d2752-b45c-44e8-ab42-029b90c6fe20",
                                "sense_id": "b74deda9-2ab2-3135-9aaa-458e98456ca0",
                                "text": "Er volgde een wilde achtervolging door de politie over de snelweg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46d17148-7bb7-4337-adf2-c09de293068c",
                        "source_entry_id": "a3b42e98-f6c5-3aaa-a7f1-28e2bdc04253",
                        "source_sense_id": "b74deda9-2ab2-3135-9aaa-458e98456ca0",
                        "target_lang_word": "persecution",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persecution",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49beedb0-393c-3800-bafa-d6db45e52fed",
                                        "entry_id": "fd6d8ce5-b99f-3b55-a51a-2be02e31a90e",
                                        "glosses": [
                                            "The act of persecuting, especially a specific group of people; an instance of persecution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eb4e743-c9b7-4723-a108-ddeb58448960",
                                                "sense_id": "49beedb0-393c-3800-bafa-d6db45e52fed",
                                                "text": "Many apartheid perpetrators escaped prosecution for their persecution of black Africans and political dissidents."
                                            },
                                            {
                                                "example_id": "06bcd4fe-3f6a-4236-b586-cd94a2cec306",
                                                "sense_id": "49beedb0-393c-3800-bafa-d6db45e52fed",
                                                "text": "During the early 20th century, wolves were considered undesirable. They were subject to persecution and were extirpated from large areas of their original range. With increased environmental awareness in the 1970s, attitudes toward wolves began to change."
                                            },
                                            {
                                                "example_id": "996f60e7-a802-4573-b831-b5d29fb8c2a3",
                                                "sense_id": "49beedb0-393c-3800-bafa-d6db45e52fed",
                                                "text": "[…] to support or agree with the persecutions, beatings, dehumanizings, insults, murders, genocides, and oppressions of a perpetrator's target […]"
                                            },
                                            {
                                                "example_id": "3e2928ec-edd9-497b-a08c-00f5d6d09781",
                                                "sense_id": "49beedb0-393c-3800-bafa-d6db45e52fed",
                                                "text": "Few concepts are as emotionally charged as that of race. The word conjures up a mixture of associations—culture, ethnicity, genetics, subjugation, exclusion and persecution. But is the tragic history of efforts to define groups of people by race really a matter of the misuse of science, the abuse of a valid biological concept?"
                                            },
                                            {
                                                "example_id": "3ca83369-61f8-4ca4-bd90-89b21dab1dea",
                                                "sense_id": "49beedb0-393c-3800-bafa-d6db45e52fed",
                                                "text": "I see this not as persecution, but a learning chance to grow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "051dc426-e8fd-4ed7-a417-4e3ed52ba0b1",
                        "source_entry_id": "a3b42e98-f6c5-3aaa-a7f1-28e2bdc04253",
                        "source_sense_id": "b74deda9-2ab2-3135-9aaa-458e98456ca0",
                        "target_lang_word": "pursuit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pursuit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36b528de-9149-3e5a-9e78-54288e62c886",
                                        "entry_id": "8f614532-854f-3376-a53c-a4c3522491e1",
                                        "glosses": [
                                            "The act of pursuing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1018d40-4777-4b16-911a-45ae2fa9039c",
                                                "sense_id": "36b528de-9149-3e5a-9e78-54288e62c886",
                                                "text": "Unremitting pursuit of wealth doesn't bring happiness, particularly if successful."
                                            },
                                            {
                                                "example_id": "02ddf7cf-9ced-4fe4-b580-b8fa264027ac",
                                                "sense_id": "36b528de-9149-3e5a-9e78-54288e62c886",
                                                "text": "Mother[…]considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom, from which every Kensingtonian held aloof, except on the conventional tip-and-run excursions in pursuit of shopping, tea and theatres."
                                            },
                                            {
                                                "example_id": "22244fd5-52c2-40e3-a911-7380c1c52aff",
                                                "sense_id": "36b528de-9149-3e5a-9e78-54288e62c886",
                                                "text": "Not only were Jupp Heynckes' team pacey in attack but they were relentless in their pursuit of the ball once they had lost it, and as the game wore on they merely increased their dominance as City wilted in the Allianz Arena."
                                            },
                                            {
                                                "example_id": "80545b9f-3125-4cea-a09c-491edb05d1e7",
                                                "sense_id": "36b528de-9149-3e5a-9e78-54288e62c886",
                                                "text": "The erosion of trust doesn't require intent, it only requires the blind pursuit of self-interest above all else."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e52406eb-0a4c-36ae-8100-34a668e35ce1",
                                        "entry_id": "8f614532-854f-3376-a53c-a4c3522491e1",
                                        "glosses": [
                                            "A hobby or recreational activity, done regularly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f09cb564-1f6b-31ba-953b-c4ee8e7591bd",
                                        "entry_id": "8f614532-854f-3376-a53c-a4c3522491e1",
                                        "glosses": [
                                            "A discipline in track cycling where two opposing teams start on opposite sides of the track and try to catch their opponents."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9db35c5a-f447-3838-bf0e-a7d9a2c8e471",
                                        "entry_id": "8f614532-854f-3376-a53c-a4c3522491e1",
                                        "glosses": [
                                            "prosecution"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
