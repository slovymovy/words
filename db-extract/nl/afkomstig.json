                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55a18b5d-6a5c-4ba3-83b7-aacc75f5c02c",
                                                "sense_id": "6804ac94-70a2-37be-8df1-b15f5f33facd",
                                                "text": "Er stammt aus einfachen Verhältnissen."
                                            },
                                            {
                                                "example_id": "e23b481f-1e77-4c38-82bb-4ff1bd86b998",
                                                "sense_id": "6804ac94-70a2-37be-8df1-b15f5f33facd",
                                                "text": "Kinder, die aus schwierigen sozialen Verhältnissen oder aus Familien mit Migrationshintergrund stammen, haben immer noch deutlich schlechtere Chancen im deutschen Bildungssystem als andere."
