                "senses": [
                    {
                        "sense_id": "b5a159e3-f2d6-3311-b3a5-bce8d567753b",
                        "entry_id": "ed241a01-b2b6-32f8-b7c2-0a43c7629a5d",
                        "glosses": [
                            "морск. вытянуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c32b833-3284-4e2a-be68-87f66fd6149b",
                                "sense_id": "b5a159e3-f2d6-3311-b3a5-bce8d567753b",
                                "text": "По-моему бы, выдраил в струнку, один раз, на шабаш, закрепи, да и не замай! А тут, не успел навернуть на планку либо битенг, опять сымай, трави, отдавай — а там — опять тяни!"
                            }
                        ]
                    },
                    {
                        "sense_id": "c65304d1-548e-30ed-be94-c21918c2908a",
                        "entry_id": "ed241a01-b2b6-32f8-b7c2-0a43c7629a5d",
                        "glosses": [
                            "перен., разг. тщательно вычистить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d79ebacb-0428-4334-94d7-5ea5d56f112b",
                                "sense_id": "c65304d1-548e-30ed-be94-c21918c2908a",
                                "text": "Козлов выдраил дальнюю кабинку и повернулся полоскать тряпку."
                            }
                        ]
                    }
