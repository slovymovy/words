                        "entry_id": "48c0c13d-2474-3238-ad92-b2772fa342de",
                        "glosses": [
                            "Grille de commande d'un tube cathodique, qui permet de faire varier l'intensité du faisceau d’électrons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "914b8cc2-507a-4a29-89d9-605c2bc49a14",
                                "sense_id": "ae0fe360-2652-396f-9563-18443d2a055e",
                                "text": "Le wehnelt entoure la cathode et a la forme d’un cylindre à un seul fond. Ce dernier est percé d'un trou."
                            },
                            {
                                "example_id": "6e0161c4-1a28-444b-bc53-6964df30cedf",
                                "sense_id": "ae0fe360-2652-396f-9563-18443d2a055e",
                                "text": "C’est le plus souvent sur les cathodes, et non sur les wehnelts des canons à électrons du tube cathodique que sont appliqués les signaux correspondant aux trois couleurs de base."
                            }
                        ]
                    }
