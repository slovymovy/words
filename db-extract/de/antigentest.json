                "senses": [
                    {
                        "sense_id": "e0cd73dd-4c3e-3cba-a627-6ab89eb23d85",
                        "entry_id": "1dc01e8e-717d-38f9-b994-39e6e786e7e3",
                        "glosses": [
                            "Untersuchungsverfahren zur Feststellung von Proteinen der Virushülle (und somit von Antigenen/Erregern) im Nasensekret"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35461a7e-5c5e-4b7c-821c-17c77814efa3",
                                "sense_id": "e0cd73dd-4c3e-3cba-a627-6ab89eb23d85",
                                "text": "„Antigentests können den Erreger ebenfalls direkt nachweisen, befinden sich aber noch in der Erprobungsphase.“"
                            },
                            {
                                "example_id": "1d4c9a3b-f892-4b0c-905d-65fd3dc5ae71",
                                "sense_id": "e0cd73dd-4c3e-3cba-a627-6ab89eb23d85",
                                "text": "„Die US-Arzneimittelbehörde FDA hat erstmals einem Antigentest auf das Coronavirus eine Notfallgenehmigung erteilt. Es handele sich dabei um eine neue Kategorie von Test, die innerhalb von Minuten Ergebnisse liefern könne, schreibt die FDA.“"
                            },
                            {
                                "example_id": "24e2e6c2-fc11-45f1-be80-bd441f789380",
                                "sense_id": "e0cd73dd-4c3e-3cba-a627-6ab89eb23d85",
                                "text": "„Experten, mit denen ZEIT ONLINE gesprochen hat, gehen davon aus, dass Antigentests etwa 80 oder 90 Prozent aller Infektionen erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
