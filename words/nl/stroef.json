{
    "word_family": [
        "stroefheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "17585cd5-acf0-3426-9a12-b07de9259418",
                    "sense_definition": "ruw en niet glad waardoor er veel wrijving is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oppervlaktegesteldheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij ijzel is de weg niet <w>stroef</w> meer en glijden auto's makkelijk weg.",
                            "target_lang_translations": {
                                "en": "When there is black ice, the road is no longer <w>rough</w> and cars slide away easily.",
                                "de": "Bei Glatteis ist die Straße nicht mehr <w>griffig</w> und Autos geraten leicht ins Rutschen."
                            }
                        },
                        {
                            "text": "De nieuwe vloer is nog erg <w>stroef</w> waardoor je er niet op kunt uitglijden.",
                            "target_lang_translations": {
                                "en": "The new floor is still very <w>non-slip</w>, so you cannot slip on it.",
                                "de": "Der neue Boden ist noch sehr <w>rutschfest</w>, sodass man darauf nicht ausrutschen kann."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruw"
                    ],
                    "antonyms": [
                        "glad"
                    ],
                    "common_phrases": [
                        "een stroef oppervlak",
                        "stroef wegdek"
                    ],
                    "target_lang_definitions": {
                        "en": "rough and not smooth, causing a lot of friction",
                        "de": "rau und nicht glatt, wodurch viel Reibung entsteht"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rough",
                                "target_lang_sense_clarification": "of a surface, not smooth"
                            },
                            {
                                "target_lang_word": "non-slip",
                                "target_lang_sense_clarification": "providing grip to prevent sliding"
                            },
                            {
                                "target_lang_word": "coarse",
                                "target_lang_sense_clarification": "having a rough texture"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "rau",
                                "target_lang_sense_clarification": "von einer Oberfläche, uneben oder nicht glatt"
                            },
                            {
                                "target_lang_word": "griffig",
                                "target_lang_sense_clarification": "guten Halt bietend, rutschfest"
                            },
                            {
                                "target_lang_word": "rutschfest",
                                "target_lang_sense_clarification": "vor dem Ausgleiten schützend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdae996c-c328-365c-86b8-ee401f1dcdd8",
                    "sense_definition": "moeilijk te bewegen of te verschuiven door weerstand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude houten lade gaat erg <w>stroef</w> open.",
                            "target_lang_translations": {
                                "en": "The old wooden drawer opens very <w>stiffly</w>.",
                                "de": "Die alte Holzschublade geht sehr <w>schwergängig</w> auf."
                            }
                        },
                        {
                            "text": "Door het roest loopt de ketting van de fiets een beetje <w>stroef</w>.",
                            "target_lang_translations": {
                                "en": "Because of the rust, the bicycle chain is running a bit <w>roughly</w>.",
                                "de": "Wegen des Rosts läuft die Fahrradkette etwas <w>schwergängig</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "moeizaam"
                    ],
                    "antonyms": [
                        "soepel"
                    ],
                    "common_phrases": [
                        "stroef lopen",
                        "stroef bewegen"
                    ],
                    "target_lang_definitions": {
                        "en": "difficult to move or slide due to resistance",
                        "de": "durch Widerstand schwer zu bewegen oder zu verschieben"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stiff",
                                "target_lang_sense_clarification": "difficult to move or operate"
                            },
                            {
                                "target_lang_word": "rough",
                                "target_lang_sense_clarification": "not running smoothly"
                            },
                            {
                                "target_lang_word": "sluggish",
                                "target_lang_sense_clarification": "moving slowly or with difficulty"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schwergängig",
                                "target_lang_sense_clarification": "von Mechanismen, schwer zu bewegen"
                            },
                            {
                                "target_lang_word": "steif",
                                "target_lang_sense_clarification": "unbeweglich oder schwer bewegbar"
                            },
                            {
                                "target_lang_word": "schwerfällig",
                                "target_lang_sense_clarification": "nur mit Widerstand funktionierend"
                            }
                        ]
