                    },
                    {
                        "translation_id": "c1d5621c-8019-4571-b110-0b0514085fb9",
                        "source_entry_id": "6c7d69dc-95b8-3318-b1b4-781ee51b35fa",
                        "source_sense_id": "edb85925-68f0-37cc-bf9f-c65872c635b1",
                        "source_sense_description": "Witwe, deren Mann im Krieg starb",
                        "target_lang_word": "veuve de guerre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veuve de guerre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75b2ef3f-5507-3cc6-b619-ea8a5cc9a19d",
                                        "entry_id": "764184cf-c93f-321f-9d38-2222c5b1ca4f",
                                        "glosses": [
                                            "Veuve dont le mari est mort, comme soldat, au combat ou des suites de ses blessures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58b58d6a-90f3-45bf-b3d7-ae7e87582628",
                                                "sense_id": "75b2ef3f-5507-3cc6-b619-ea8a5cc9a19d",
                                                "text": "Depuis quelque temps on faisait défiler les veuves de guerre sous nos fenêtres. Des centaines de veuves de guerre. Elles criaient de leurs voix aiguës : « Clemenceau assassin, Clemenceau assassin. »"
                                            },
                                            {
                                                "example_id": "b6cceaaf-3092-47fe-8eb0-d8f9c640bbc9",
                                                "sense_id": "75b2ef3f-5507-3cc6-b619-ea8a5cc9a19d",
                                                "text": "À Bully-les-Mines, Marie Glisseur, servante, veuve de guerre, a recueilli Germaine Prinsier dont le père est mort « au champ d'honneur » et la mère lors d'un bombardement ; […]."
                                            },
                                            {
                                                "example_id": "c8ba8c0e-bdf9-482b-8c3b-a7a946fea6d8",
                                                "sense_id": "75b2ef3f-5507-3cc6-b619-ea8a5cc9a19d",
                                                "text": "Elle pensait que les autorités lui bourraient le mou pour ne pas avoir à lui verser de pension de veuve de guerre. Selon elle, on lui cachait la vérité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84abb600-3a7f-4232-8187-f947a501420e",
                        "source_entry_id": "6c7d69dc-95b8-3318-b1b4-781ee51b35fa",
                        "source_sense_id": "edb85925-68f0-37cc-bf9f-c65872c635b1",
                        "source_sense_description": "Witwe, deren Mann im Krieg starb",
                        "target_lang_word": "vedova di guerra",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b6253349-6d07-4cea-a80f-73a228c542d2",
                        "source_entry_id": "6c7d69dc-95b8-3318-b1b4-781ee51b35fa",
                        "source_sense_id": "edb85925-68f0-37cc-bf9f-c65872c635b1",
                        "source_sense_description": "Witwe, deren Mann im Krieg starb",
                        "target_lang_word": "oorlogsweduwe",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oorlogsweduwe",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c7176c95-d9ae-369a-ac85-0f22b694e745",
                                        "entry_id": "cfe41032-5245-30d8-a9b1-02151a8f85cc",
                                        "glosses": [
                                            "vrouw waarvan de echtgenoot is gesneuveld in de oorlog door oorlogshandelingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0e2d7ce-8131-4390-af27-adcb596513ba",
                                                "sense_id": "c7176c95-d9ae-369a-ac85-0f22b694e745",
                                                "text": "Er zat een in 1945 geschreven brief in, waarin oorlogsweduwe Violet Morgan uit Swansea (Wales) de Zanderinks bedankt voor de inspanningen die ze deden voor haar overleden man en zijn maten."
                                            },
                                            {
                                                "example_id": "19daa7ef-ead1-413c-b2b8-896062bd9ef8",
                                                "sense_id": "c7176c95-d9ae-369a-ac85-0f22b694e745",
                                                "text": "Hotel El Convento in San Juan is van origine het huis van oorlogsweduwe Doña Ana, een Spaanse vrouw van adel."
                                            },
                                            {
                                                "example_id": "5d685eda-4d26-4768-a1e1-0ceda4ccc0e8",
                                                "sense_id": "c7176c95-d9ae-369a-ac85-0f22b694e745",
                                                "text": "Zo laat Thank you for your service zien dat voor veel soldaten de echte strijd pas na de oorlog begint. Comédienne Amy Schumer, die een verrassende bijrol heeft als oorlogsweduwe, schonk daarom haar volledige filmsalaris aan diverse veteranenorganisaties."
                                            },
                                            {
                                                "example_id": "ca554fb2-ec73-499c-81e6-5d40c0e2ac5e",
                                                "sense_id": "c7176c95-d9ae-369a-ac85-0f22b694e745",
                                                "text": "Ds. Van Wier en zijn collega’s, onder wie ds. L. Kievit, bezochten de Puttense weduwen en probeerden troost te brengen. Ds. Van Wier karakteriseert die weduwen als verslagen en trouw. „Ik hielp hen door te luisteren, maar ik ben zelf ook geestelijk gegroeid door het geloof van de Puttenaren. Bij mijn afscheid van Putten zei een oorlogsweduwe: „Vervloekt die er kwaad van denkt. U bent vele vrouwen tot een man en vele kinderen tot een vader geweest.””"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
