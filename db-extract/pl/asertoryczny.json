                        ]
                    },
                    {
                        "translation_id": "2c8d5d8d-03c6-483b-8783-191d6c95d04c",
                        "source_entry_id": "652bb185-54f7-3106-8e63-6f6ba6fe18d3",
                        "source_sense_id": "4daf90e2-980f-3c47-9143-475ef59162d6",
                        "target_lang_word": "assertorisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assertorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a8949e9-f98e-3ef5-8edf-9648cae9e7ac",
                                        "entry_id": "506948f3-b2e3-3ed7-afc8-14348b899623",
                                        "glosses": [
                                            "feststellend, behauptend, versichernd, ohne Beweis Gültigkeit beanspruchend"
                                        ],
                                        "tags": [
                                            "Logik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aebb6b4a-ffe0-489f-be3f-5135b643912e",
                                                "sense_id": "1a8949e9-f98e-3ef5-8edf-9648cae9e7ac",
                                                "text": "„Was reine Vernunft assertorisch urteilt, muß (wie alles, was Vernunft erkennt,) notwendig sein, oder es ist gar nichts.“"
                                            },
                                            {
                                                "example_id": "95763a51-d756-4534-a986-11c062b1252c",
                                                "sense_id": "1a8949e9-f98e-3ef5-8edf-9648cae9e7ac",
                                                "text": "„Das problematische Urtheil bestehe hiernach darin, wenn man das Bejahen oder Verneinen als beliebig oder als möglich; - das assertorische, wenn man es als wahr, d. h. wirklich, und das apodiktische, wenn man es als nothwendig annehme.“"
                                            },
                                            {
                                                "example_id": "81923d0d-d454-4f0c-af1b-d5cb102c9030",
                                                "sense_id": "1a8949e9-f98e-3ef5-8edf-9648cae9e7ac",
                                                "text": "»Assertorisch« sollen Aussagen genannt werden, die sich nicht als Alternativen darlegen lassen, denn der Wahrheitsraum entspricht nur einer Lösung. A∧B ist assertorisch."
                                            },
                                            {
                                                "example_id": "c38f96ac-8ed3-4e1d-a8f9-639ad7166774",
                                                "sense_id": "1a8949e9-f98e-3ef5-8edf-9648cae9e7ac",
                                                "text": "Ob assertorische Aussagen der Aussagenlogik Vermutungs- oder auch Beobachtungsaussagen sein können, lässt sich nicht mehr allein mit Hilfe isolierter Wahrheitswertematrizen erörtern, […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
