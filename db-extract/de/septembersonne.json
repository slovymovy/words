                            {
                                "example_id": "7c1898b2-850a-46a5-bb52-0d4a82a859ad",
                                "sense_id": "1cc1486d-ad35-35b7-8e54-75f560a91c3a",
                                "text": "„Er hatte dort gestanden und drei Innings miterlebt, während sein Vater an einem Treppenaufgang 30 Reihen weiter in die Septembersonne blinzelte und ihm zulächelte.“"
                            },
                            {
                                "example_id": "ea9c1c2c-7585-4802-ad2e-8cea551c56aa",
                                "sense_id": "1cc1486d-ad35-35b7-8e54-75f560a91c3a",
                                "text": "„Und jetzt ging sie hier unter der heißen Septembersonne das Risiko von Hautkrebs ein.“"
                            }
