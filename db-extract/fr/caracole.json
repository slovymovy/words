        "fr-extract.jsonl": [
            {
                "entry_id": "58c2dfbd-abc3-30da-b694-9d0f799a9f0f",
                "word": "caracole",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "53d9fe53-c7e7-4953-8dc4-e389481b83bb",
                        "entry_id": "58c2dfbd-abc3-30da-b694-9d0f799a9f0f",
                        "tags": [
                            "plural"
                        ],
                        "form": "caracoles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2547d318-2157-3ada-ab6a-dcfd095bba5f",
                        "entry_id": "58c2dfbd-abc3-30da-b694-9d0f799a9f0f",
                        "glosses": [
                            "Mouvement en rond, ou en demi-cercle, qu’un cavalier fait exécuter à sa monture, en changeant quelquefois de main."
                        ],
                        "tags": [
                            "Manège"
                        ],
                        "examples": [
                            {
                                "example_id": "34807d2d-0545-4ed8-9261-edb88aa51dd9",
                                "sense_id": "2547d318-2157-3ada-ab6a-dcfd095bba5f",
                                "text": "Faire une caracole."
                            },
                            {
                                "example_id": "76f279dc-c8c0-4cf5-b89c-5a0843316610",
                                "sense_id": "2547d318-2157-3ada-ab6a-dcfd095bba5f",
                                "text": "— L’avion revient vers nous, plane un moment sur nos têtes, glisse, remonte et, dans une dernière caracole, pique vers son hangar."
                            }
                        ]
                    },
                    {
                        "sense_id": "a922bc75-91e1-39a3-8f2c-614c98d994ad",
                        "entry_id": "58c2dfbd-abc3-30da-b694-9d0f799a9f0f",
                        "glosses": [
                            "Mouvement de tous les cavaliers d’un même escadron, quand il tourne en même temps sur sa droite ou sur sa gauche."
                        ],
                        "tags": [
                            "Cavalerie"
                        ],
                        "examples": [
                            {
                                "example_id": "28130f4e-57da-4370-9029-68b0e1cb7672",
                                "sense_id": "a922bc75-91e1-39a3-8f2c-614c98d994ad",
                                "text": "Vous savez ce détail ?… En effet, il advint,\nDurant que je faisais ma caracole afin\nDe rassembler mes gens pour la troisième charge,\nQu’un remous de fuyards m’entraîna sur la marge\nDes ennemis ; j’étais en danger qu’on me prît\nEt qu’on m’arquebusât, quand j’eus le bon esprit\nDe dénouer et de laisser couler à terre\nL’écharpe qui disait mon grade militaire ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "32138d54-cd4b-32d3-9d4d-a1239d65e488",
                        "entry_id": "58c2dfbd-abc3-30da-b694-9d0f799a9f0f",
                        "glosses": [
                            "Escargot."
                        ],
                        "tags": [
                            "Wallonie"
                        ],
                        "examples": [
                            {
                                "example_id": "4f932e93-21fc-49ad-8d35-e1538c850975",
                                "sense_id": "32138d54-cd4b-32d3-9d4d-a1239d65e488",
                                "text": "Quoi que les grives ont à voir avec la culture, je m’étonne bien ! Pour trois-quatre vers par ci, par là, une douzaine de caracoles et de limaces!"
                            }
                        ]
                    },
                    {
                        "sense_id": "7572be63-48b7-30d4-a3bf-82e3e2b1010d",
                        "entry_id": "58c2dfbd-abc3-30da-b694-9d0f799a9f0f",
                        "glosses": [
                            "Instrument destiné à récupérer dans un puits de forage une rallonge de tige qui se serait cassée, il s'agit d'un outil en forme de queue de cochon propre à bloquer la pièce cassée et à la remonter à la surface."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45f6aa26-2876-4e08-91b1-f09a720527ed",
                        "source_entry_id": "58c2dfbd-abc3-30da-b694-9d0f799a9f0f",
                        "source_sense_description": "mouvement qu’un cavalier fait exécuter à sa monture",
                        "target_lang_word": "caracole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caracole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff7d9ac8-6b6b-3464-abb1-1f6266740457",
                                        "entry_id": "e3033e7e-cd46-3e6c-8932-91831f2d7ec2",
                                        "glosses": [
                                            "A half-turn performed by a horse and rider in dressage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b2a1acb-e870-30c4-aa6f-5d939329598b",
                                        "entry_id": "e3033e7e-cd46-3e6c-8932-91831f2d7ec2",
                                        "glosses": [
                                            "A combat maneuver where riders of the same squadron turn simultaneously to their left or to their right."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41d9214b-99b8-49f8-a838-27ddca06a937",
                                                "sense_id": "7b2a1acb-e870-30c4-aa6f-5d939329598b",
                                                "text": "How the chargers neigh and champ, / (Their riders weary of camp,) / With curvet and with caracole!"
                                            },
                                            {
                                                "example_id": "2142d838-f14b-4e05-a5a1-06993f41c139",
                                                "sense_id": "7b2a1acb-e870-30c4-aa6f-5d939329598b",
                                                "text": "The caracole played a role well into the Thirty Years' War."
                                            },
                                            {
                                                "example_id": "71792333-a8bf-4135-92aa-8fe5b6702fef",
                                                "sense_id": "7b2a1acb-e870-30c4-aa6f-5d939329598b",
                                                "text": "The battle tactic of these cavalry was called the caracole, an attack with pistols. There were four main varieties which may be called the simple caracole, the true caracole, the limacon, and the Protestant caracole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3120f2ea-1f75-3710-93ab-1638ab46dae1",
                                        "entry_id": "e3033e7e-cd46-3e6c-8932-91831f2d7ec2",
                                        "glosses": [
                                            "A spiral staircase."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "caracole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adc96ea1-c79b-3e5e-a087-839055e289ad",
                                        "entry_id": "c5c5eae7-6099-3ba2-a09a-029f882623b3",
                                        "glosses": [
                                            "To execute a caracole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fff61187-8a99-4609-b082-a606f7982d3f",
                                                "sense_id": "adc96ea1-c79b-3e5e-a087-839055e289ad",
                                                "text": "Prince John, upon a grey and high-mettled palfrey, caracoled within the lists at the head of his jovial party, laughing loud with his train, and eyeing with all the boldness of royal criticism the beauties who adorned the lofty galleries."
                                            },
                                            {
                                                "example_id": "d18f68a0-9b28-482e-b0be-dc4b27bb4d2f",
                                                "sense_id": "adc96ea1-c79b-3e5e-a087-839055e289ad",
                                                "text": "1884, Robert Black (translator), François Guizot, Henriette Elizabeth Guizot de Witt, The History of France from the Earliest Times to 1848, Volume 1, John B. Alden, page 259,\nFinally he went out of church and caracoled about on the open, at the foot of the castle, in presence of the people eager to have their share in the spectacle."
                                            },
                                            {
                                                "example_id": "ed42c978-a738-437c-9b05-1d858a7c428c",
                                                "sense_id": "adc96ea1-c79b-3e5e-a087-839055e289ad",
                                                "text": "[…]the noble bishop caracolled in the presence, on a well-trained war-horse, which the right reverend father in God bestrode in a lay habit of purple, jack-boots, his hat cocked, and his black wig tied up behind in true military fashion."
                                            },
                                            {
                                                "example_id": "5a4991e2-64eb-477c-a796-13e8cd32d687",
                                                "sense_id": "adc96ea1-c79b-3e5e-a087-839055e289ad",
                                                "text": "Sir Charles Oman's book mentions no instance where caracoling cavalry succeeded unaided in breaking a resolute body of infantry standing firm to receive them."
                                            },
                                            {
                                                "example_id": "f9db77d8-2bb2-4785-aa29-861e775a9e2f",
                                                "sense_id": "adc96ea1-c79b-3e5e-a087-839055e289ad",
                                                "text": "2010, Peter H. Wilson (translator and editor), The Thirty Years War: A Sourcebook, Macmillan Publishers (Palgrave Macmillan), page 67,\nThe proper way, which I often explained to them, was too reject the bad habit of caracolling when facing the enemy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e330a940-a79d-4260-868e-1079bbfdf315",
                        "source_entry_id": "58c2dfbd-abc3-30da-b694-9d0f799a9f0f",
                        "source_sense_description": "mouvement qu’un cavalier fait exécuter à sa monture",
