                ],
                "senses": [
                    {
                        "sense_id": "bf00ae2a-cca3-3147-a9aa-98b6cddeb5f3",
                        "entry_id": "542fd3b0-4b91-3498-9efe-4d54d78b2846",
                        "glosses": [
                            "Donner un caractère états-unien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaac9a5c-ccab-4d74-a9cf-91c9fde14610",
                                "sense_id": "bf00ae2a-cca3-3147-a9aa-98b6cddeb5f3",
                                "text": "Il ne faut pas étatsunianiser la communauté des nations européennes en réprimant ses richesses culturelles et linguistiques, en réprimant la diversité des manières d’être et des manières d’être ensemble, au profit d’un rêve chimérique qui ne serait que matériel ((d’un « american dream » : « consommer, consommer, consommer »)."
                            },
                            {
                                "example_id": "75cafa35-5b16-4292-8488-419f8d9c9ae5",
                                "sense_id": "bf00ae2a-cca3-3147-a9aa-98b6cddeb5f3",
                                "text": "À moins que comme les Français de Paris qui eux ne sont pas menacés,nous nous fassions un honneur de s’étatsunianiser!!!"
                            },
                            {
                                "example_id": "e52987ed-afe4-403e-852c-7e0f2180938d",
                                "sense_id": "bf00ae2a-cca3-3147-a9aa-98b6cddeb5f3",
                                "text": "On voit bien que c’est un Français étatsunianisé."
                            }
                        ]
                    }
