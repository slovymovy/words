                        "examples": [
                            {
                                "example_id": "b6c7cfaf-66ab-492c-b6c0-ef0853dad56c",
                                "sense_id": "8781cd6a-47d8-3565-a1c6-6122b56a1937",
                                "text": "Пахотные земли продолжали расширяться, стали осваиваться сибирские, оренбургские, приволжские степи."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac86c003-baa0-378b-9c04-15d890d3ebf1",
                        "entry_id": "9a660605-9864-3bce-977a-e668039bc3c6",
                        "glosses": [
                            "приспосабливаться, привыкать к чему-либо новому; начинать уверенно управляться с чем-либо ранее непривычным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23d807ec-542c-44b0-9f5f-b9499c125450",
                                "sense_id": "ac86c003-baa0-378b-9c04-15d890d3ebf1",
                                "text": "Митя продолжал потихоньку осваиваться на новом месте"
                            },
                            {
                                "example_id": "1a1ddd79-5d1d-43e8-8313-f6738f0c5fda",
                                "sense_id": "ac86c003-baa0-378b-9c04-15d890d3ebf1",
                                "text": "Тем временем Санька стал постепенно осваиваться и наконец осмелился заговорить."
                            }
                        ]
                    }
