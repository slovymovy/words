                    {
                        "sense_id": "4ba418e4-05bb-3040-89d3-d1c09810bdf8",
                        "entry_id": "45db8eea-8836-32c8-a222-3c5c40c33ec2",
                        "glosses": [
                            "Mettre les vaches au champ."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "26007f09-6249-4b76-9fa7-560b5e2667dd",
                                "sense_id": "4ba418e4-05bb-3040-89d3-d1c09810bdf8",
                                "text": "Dès que les jappements de la Lionne l’avertissaient du moment où l’on largeait, elle prenait un ouvrage léger, un tricot ou un carré de broderie et venait assister au départ du troupeau."
                            },
                            {
                                "example_id": "2c4ed959-3981-42cb-b1ad-822b5ac377a2",
                                "sense_id": "4ba418e4-05bb-3040-89d3-d1c09810bdf8",
                                "text": "Le lendemain matin, il a voulu larger le premier, pour s’imposer d’emblée."
                            }
                        ]
                    }
