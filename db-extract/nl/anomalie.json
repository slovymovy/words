                        ],
                        "form": "anomalietjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a91d274-6402-3da1-9934-eaccd8755399",
                        "entry_id": "057d4410-9978-3acc-944b-4475dbe7b2fc",
                        "glosses": [
                            "afwijking, onregelmatigheid, strijdigheid met wet of regel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5fa48e5-6152-4308-8546-a619e613ecfd",
                                "sense_id": "6a91d274-6402-3da1-9934-eaccd8755399",
                                "text": "Was dat niet typisch Venetië? Was het leven niet bij uitstek zo'n anomalie? Zou zijn leven niet totaal anders zijn verlopen zonder de mensen die hen waren voorgegaan, zonder de eigenzinnige plooien en kreukels die waren achtergelaten door een tijdperk dat zich had ontplooid als een kledingstuk, geperst door tijd en omstandigheden? De gedachte benauwde hem, totdat het antwoord zich stilletjes aandiende: hij kon zich geen beter leven wensen."
                            },
                            {
                                "example_id": "118dbba1-c2fd-4c51-b750-bdd7795fcbbe",
                                "sense_id": "6a91d274-6402-3da1-9934-eaccd8755399",
                                "text": "Waar het Muurschouwersproject een niet eerder gekende anomalie in de geschiedenis van de mensheid vormde, kenden zowel de Donkere Woud-afschrikking als de Zwaardhouder hun voorgangers."
                            }
                        ]
                    },
                    {
                        "sense_id": "513b1ff0-b0d4-38a3-adb4-c43c3a015003",
                        "entry_id": "057d4410-9978-3acc-944b-4475dbe7b2fc",
                        "glosses": [
                            "hoek tussen de voerstraal van een planeet met de grote as van haar ellipsbaan"
                        ],
                        "tags": [
                            "sterrenkunde"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "00290859-bfc2-3f20-9311-84dd61192d5d",
                        "entry_id": "057d4410-9978-3acc-944b-4475dbe7b2fc",
                        "glosses": [
                            "afwijking van organen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "748be5b5-a234-4216-a61b-40447a9419f6",
                        "source_entry_id": "057d4410-9978-3acc-944b-4475dbe7b2fc",
                        "source_sense_id": "6a91d274-6402-3da1-9934-eaccd8755399",
                        "source_sense_description": "afwijking van organen",
                        "target_lang_word": "Anomalie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anomalie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                        "entry_id": "91b0cb7a-1867-39a6-8370-94af5dbc2428",
                                        "glosses": [
                                            "eine Abweichung vom Allgemeinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c68caff-b188-4f69-a89f-eee51430a114",
                                                "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                                "text": "„Auch in der nächsten Generation fand sich diese Anomalie.“"
                                            },
                                            {
                                                "example_id": "8e7aefc7-e8fe-4365-9e62-c6d00a89d016",
                                                "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                                "text": "Bei der Messung traten Anomalien auf."
                                            },
                                            {
                                                "example_id": "8a42ea27-bb18-4b61-b405-fc2780d21c55",
                                                "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                                "text": "Ohne die Anomalie des Wassers frören winters alle Flüsse bis auf den Grund, es könnten dann wohl in unseren Breiten keine Fische dauerhaft existieren."
                                            },
                                            {
                                                "example_id": "40d345e9-1a66-4f4b-93c9-39b33b2a5ba7",
                                                "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                                "text": "Es kommt oft zu Anomalien im Erdmagnetfeld."
                                            },
                                            {
                                                "example_id": "b1248063-00c9-43c8-bbd5-2c83d6b216e5",
                                                "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                                "text": "„Sie hatte signifikante Hinweise aus ihren Beobachtungen gewonnen, dass solche Anomalien immerhin auch auf dem Mond auftraten, und, so vermutete sie, auch weit über die Mondbahn hinaus denkbar seien.“"
                                            },
                                            {
                                                "example_id": "034f47a4-513f-4618-92e4-e9db2a7b1f0c",
                                                "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                                "text": "„Das gilt in erster Linie für die Geschlechtsmoral: wo nach Freud das Unbewußte die meisten Anomalien regiert, kann wissenschaftlich nicht mehr von einem bewußten Laster die Rede sein – wogegen sich allerdings die Jurisdiktion noch immer leidenschaftlich sperrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4976c16e-5132-3055-9aee-910edd1bdbc3",
                                        "entry_id": "91b0cb7a-1867-39a6-8370-94af5dbc2428",
                                        "glosses": [
                                            "in der Wissenschaftstheorie von Thomas Kuhn ein Phänomen, das von einem Wissenschaftlichen Paradigma nicht erklärt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74702987-e7d4-4d54-a201-9293b71c18fc",
                                                "sense_id": "4976c16e-5132-3055-9aee-910edd1bdbc3",
                                                "text": "Bei der Messung traten Anomalien auf."
                                            },
                                            {
                                                "example_id": "1b28b049-75cf-490f-a73b-d67c1def03d9",
                                                "sense_id": "4976c16e-5132-3055-9aee-910edd1bdbc3",
                                                "text": "Das geozentrische Weltbild kann nicht alle Bewegungen der Planeten und ihrer Monde erklären."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "20436d29-af88-30e8-9477-9fb30d7ae233",
                                        "entry_id": "91b0cb7a-1867-39a6-8370-94af5dbc2428",
                                        "glosses": [
                                            "in relationalen Datenbanken das Fehlverhalten der Datenbank"
                                        ],
                                        "tags": [
                                            "in der Informatik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eb95c6d-f7f9-4727-9879-48813c77425c",
                                                "sense_id": "20436d29-af88-30e8-9477-9fb30d7ae233",
                                                "text": "In der Datenbank trat eine Anomalie auf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "def4e65b-bd68-3603-8149-ee22e8adac88",
                                        "entry_id": "91b0cb7a-1867-39a6-8370-94af5dbc2428",
                                        "glosses": [
                                            "im Softwaretest ein Zustand, der vom Erwarteten abweicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca179870-eb15-4751-aa19-e217395c0ad4",
                                                "sense_id": "def4e65b-bd68-3603-8149-ee22e8adac88",
                                                "text": "Er meinte, beim Test traten Anomalien auf."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16ccf8bd-e085-4042-9ade-afb43c864c0f",
                        "source_entry_id": "057d4410-9978-3acc-944b-4475dbe7b2fc",
                        "source_sense_id": "6a91d274-6402-3da1-9934-eaccd8755399",
                        "source_sense_description": "afwijking van organen",
                        "target_lang_word": "anomaly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anomaly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4564c0a-afe0-3581-a699-5ddaa14f8bbd",
                                        "entry_id": "4e4524bb-efba-3d74-91b3-cf5c5085259a",
                                        "glosses": [
                                            "A deviation from a rule or from what is regarded as normal; an outlier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "254a5a76-482c-4d25-9fc2-2d04237d6980",
                                                "sense_id": "c4564c0a-afe0-3581-a699-5ddaa14f8bbd",
                                                "text": "This ardent exploration, absorbing all his energy and interest, made him forget for the moment the mystery of his heritage and the anomaly that cut him off from all his fellows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec3d3cc6-4803-3c95-85a0-41e3d4ba9319",
                                        "entry_id": "4e4524bb-efba-3d74-91b3-cf5c5085259a",
                                        "glosses": [
                                            "Something or someone that is strange or unusual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38663990-7354-457a-928b-140cc5607e51",
                                                "sense_id": "ec3d3cc6-4803-3c95-85a0-41e3d4ba9319",
                                                "text": "He is an anomaly among his friends in that he's the only one who's unmarried."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f8925d2-289b-3df9-9e97-b90fcc09959c",
                                        "entry_id": "4e4524bb-efba-3d74-91b3-cf5c5085259a",
                                        "glosses": [
                                            "Any event or measurement that is out of the ordinary regardless of whether it is exceptional or not."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abaa15b5-cfa5-4054-90b7-cb84db2f1fcc",
                                                "sense_id": "8f8925d2-289b-3df9-9e97-b90fcc09959c",
                                                "text": "She disregarded some of the anomalies in the experiment, putting them down to miscalculation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ed8484c-2c09-36d2-954c-ae2ffa4624a1",
                                        "entry_id": "4e4524bb-efba-3d74-91b3-cf5c5085259a",
                                        "glosses": [
                                            "Any of various angular distances."
                                        ],
