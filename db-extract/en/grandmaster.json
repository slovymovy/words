                                    {
                                        "sense_id": "8960e2cd-2f04-3309-90a1-b3175ac723ec",
                                        "entry_id": "d5cd81ee-0626-3c5e-93cd-32ec377499b9",
                                        "glosses": [
                                            "nejvyšší hodnostář církevního nebo světského řádu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "815bafe7-7376-4e1b-a41d-12df790e3bf3",
                                                "sense_id": "8960e2cd-2f04-3309-90a1-b3175ac723ec",
                                                "text": "Řád sv. Jiří je rytířským řádem habsbursko-lotrinské dynastie, sídlo má ve Vídni a pobočky v deseti evropských zemích. Jeho velmistrem dnes je hlava rodu, Karel Habsbursko-Lotrinský. Kořeny řádu sahají až do roku 1308 a velmistry byli i čeští králové a římští císaři, Karel IV., Zikmund Lucemburský a Václav IV., a také Karel I."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "268f456b-4d80-3a74-b105-0f7cfbefd5ef",
                                        "entry_id": "d5cd81ee-0626-3c5e-93cd-32ec377499b9",
                                        "glosses": [
                                            "titul špičkového hráče šachu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abc5eec2-7561-4498-b644-d6ba1a252c6c",
                                                "sense_id": "268f456b-4d80-3a74-b105-0f7cfbefd5ef",
                                                "text": "K nejslavnějším šachovým bitvám patřily souboje ruských velmistrů a zcela odlišných stylů Anatolije Karpova a Garriho Kasparova."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
