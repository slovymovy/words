                                        "glosses": [
                                            "Selon ce qu’on mérite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dfb8349-89e2-4197-a9cc-799918b1b5ab",
                                                "sense_id": "25e820e6-7b74-3da2-9f0c-c2dac09f6dd0",
                                                "text": "Je ne vous en saurais remercier dignement, assez dignement."
                                            },
                                            {
                                                "example_id": "38a3aaf5-e7ac-470f-942f-ca0924e92595",
                                                "sense_id": "25e820e6-7b74-3da2-9f0c-c2dac09f6dd0",
                                                "text": "Il a été dignement récompensé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b45d426-56a7-3f4f-832a-217a92815850",
                                        "entry_id": "f3de1f2b-6178-30e1-b8f8-7ef6e4ae1c44",
                                        "glosses": [
                                            "Convenablement, comme il faut."
