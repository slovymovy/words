                        "entry_id": "70c82604-88c7-38af-9ab2-235996650e92",
                        "glosses": [
                            "Débarrasser de ses pierres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9267a9f2-e28a-4667-a7b1-1f20bcf05f05",
                                "sense_id": "adfdc6ed-600d-32c6-890c-3594239e81f1",
                                "text": "Nos six ménages indigènes ont été chargés de dépierrer le terrain et d'enlever les arbustes qui y croissent à l'état sauvage."
                            },
                            {
                                "example_id": "e13bb903-e05b-45ce-a1a3-7d66239c88cb",
                                "sense_id": "adfdc6ed-600d-32c6-890c-3594239e81f1",
                                "text": "On peut améliorer la montagne aussi bien que la plaine; on peut la drainer, la dépierrer, l'arroser, la labourer."
                            }
                        ]
                    }
