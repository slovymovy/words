                "senses": [
                    {
                        "sense_id": "667a743c-b2ea-3a38-9a81-87880729dab8",
                        "entry_id": "6f5d8a6f-dd9f-3b7c-b5d3-f3541a93955b",
                        "glosses": [
                            "Staat mit einem sehr starken Militär"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59dc3319-dc67-4283-baca-d99bfbf03a9b",
                                "sense_id": "667a743c-b2ea-3a38-9a81-87880729dab8",
                                "text": "Die USA sind wohl immer noch die stärkste Militärmacht der Erde."
                            },
                            {
                                "example_id": "792457c1-0ef9-45a8-9792-e63df32f11b9",
                                "sense_id": "667a743c-b2ea-3a38-9a81-87880729dab8",
                                "text": "„Als bedeutsam für die südafrikanische Entwicklung erwies sich der Aufstieg des Zulu-Königreiches zur wichtigsten Militärmacht, der sekundäre Reichsbildungen und die Abwanderung ganzer Bevölkerungsgruppen auslöste, von denen sich einige nach Norden über den Limpopo begaben und aufgrund ihrer militärischen Organisation den Rozvi überlegen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1cc8868d-982d-334e-8304-87cfe6eaf26d",
                        "entry_id": "6f5d8a6f-dd9f-3b7c-b5d3-f3541a93955b",
                        "glosses": [
                            "Stärke, die sich auf das Militär gründet"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9358c7f2-10fc-47d2-9ab9-86d5cd33b56d",
                                "sense_id": "1cc8868d-982d-334e-8304-87cfe6eaf26d",
                                "text": "„Nirgendwo sonst ließ sich der Triumph der Alliierten über die deutsche Militärmacht besser demonstrieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
