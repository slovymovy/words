                                                "sense_id": "a33e4126-f81a-3b97-95ee-43b9c2656fbe",
                                                "text": "I shall be late because I missed the earlier train."
                                            },
                                            {
                                                "example_id": "366f15e6-c9e7-433e-82f1-1dc133ce9b18",
                                                "sense_id": "a33e4126-f81a-3b97-95ee-43b9c2656fbe",
                                                "text": "I'd seen earlier (in the day)."
                                            },
                                            {
                                                "example_id": "645ae0fb-c920-4153-8b0d-05f0840a59ab",
                                                "sense_id": "a33e4126-f81a-3b97-95ee-43b9c2656fbe",
                                                "text": "Machine learning uses computer algorithms to teach machines to make independent decisions by learning from earlier or existing behavior."
                                            }
