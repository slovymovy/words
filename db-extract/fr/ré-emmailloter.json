                ],
                "senses": [
                    {
                        "sense_id": "4a348141-5af2-3a6e-97b3-87a3299f78c6",
                        "entry_id": "1a6a58d6-6721-350d-a49b-e903d9aa1f0b",
                        "glosses": [
                            "Emmailloter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cb03145-8289-4718-9d9a-e0f3fd3e1b79",
                                "sense_id": "4a348141-5af2-3a6e-97b3-87a3299f78c6",
                                "text": "Nettoyer doucement le cou. Lentement, libérer chaque partie du corps une par une de l’emmaillotage afin de la laver, puis la ré-emmailloter aussitôt."
                            },
                            {
                                "example_id": "d06a58dc-6105-4569-aa14-a96fc6bf27d8",
                                "sense_id": "4a348141-5af2-3a6e-97b3-87a3299f78c6",
                                "text": "Et une nuit, me suis aperçue qu'il dormait plus longtemps avec donc on a commencé à le ré-emmailloter la nuit."
                            },
                            {
                                "example_id": "8b361cf3-d634-4423-b9d0-0298bbcb3f09",
                                "sense_id": "4a348141-5af2-3a6e-97b3-87a3299f78c6",
                                "text": "Alors seulement il va se ré-emmailloter et faire semblant de dormir dans son panier plat."
                            }
                        ]
                    }
                ],
