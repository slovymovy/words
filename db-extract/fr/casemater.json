                        "glosses": [
                            "Munir de casemates."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "537e6c16-b914-497d-9bf6-d630f5bc0097",
                                "sense_id": "5dd3fd8f-85ee-3b3c-91e6-708ec0691ba5",
                                "text": "Nous avions consolidé cette maison, vous le savez. Son toit était casematé, et les poutres placées verticalement entre les planchers et les plafonds ont dû résister."
                            },
                            {
                                "example_id": "18802a69-310d-4666-b3e7-67369f27b38b",
                                "sense_id": "5dd3fd8f-85ee-3b3c-91e6-708ec0691ba5",
                                "text": "Dans un coin, une maison de jardinier casematée de troncs d’arbres."
                            }
                        ]
                    }
