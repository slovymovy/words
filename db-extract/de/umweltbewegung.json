                            {
                                "example_id": "b3a577c4-52e0-46e7-b347-3bc7813f6040",
                                "sense_id": "8da8dc2c-9950-361f-90b2-02f16c9644ac",
                                "text": "„Dieses Problem, keine schlagenden Bilder außer Horrorszenarien oder arkadische Landschaften zu produzieren, sieht der Sozialpsychologe Harald Welzer noch heute als eines der größten Probleme der Umweltbewegung an.“"
                            },
                            {
                                "example_id": "8d12dc10-111f-4b9d-83f4-29c96c9da6df",
                                "sense_id": "8da8dc2c-9950-361f-90b2-02f16c9644ac",
                                "text": "„Doch anscheinend ist die Umweltbewegung mehr eine Weltanschauung als eine Bewegung zur Lösung anstehender Probleme.“"
                            }
                        ],
