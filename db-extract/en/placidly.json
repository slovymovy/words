                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed11e657-ba99-4c0e-8210-3ec2aa36643a",
                                "sense_id": "47f0a6be-b887-3208-92f2-5b074f32b83e",
                                "text": "We spent a lot of time up on the staging of the great furnaces, trying to pick up the tricks of the trade from the taciturn furnacemen who sat around placidly smoking, or chewing twist, and occasionally throwing in more pig iron to the molten white-hot metal."
                            },
                            {
                                "example_id": "58ea65cd-b5b4-425b-b328-f76f2c04a7ba",
                                "sense_id": "47f0a6be-b887-3208-92f2-5b074f32b83e",
                                "text": "He was a big chubby man, in his middle thirties, the muscle of his rugger days now settling placidly to reminiscent fat."
                            }
                        ]
                    }
                ],
