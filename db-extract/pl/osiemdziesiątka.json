                                "sense_id": "614b1eb0-1364-3e91-86a4-4fb3008ed407",
                                "text": "Gość przy stole z ruletką z niedowierzaniem patrzył, jak kula zatrzymuje się na osiemdziesiątce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
