                        "entry_id": "d4e704a5-5875-3698-8f22-2a50f160216e",
                        "glosses": [
                            "Profit, bénéfice, gain, licite ou non."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "046a4f7d-1e3b-4823-940b-fd6acf713931",
                                "sense_id": "88965a58-2210-3a7a-a14e-67ecabc0226d",
                                "text": "Eh vite ! Ma culbute, quand je vois mon affure, je suis toujours paré."
                            },
                            {
                                "example_id": "28ff8cd1-265b-40e9-83ff-764a4d4bf573",
                                "sense_id": "88965a58-2210-3a7a-a14e-67ecabc0226d",
                                "text": "- J’sais pas non plus, confesse Paulo... mais à juger par ce qu’il m’a refilé, il a dû faire une affure coquette... plusieurs centaines de sacs !"
                            }
                        ]
                    },
                    {
                        "sense_id": "daff586d-5da1-36dd-acce-3c39133dad6e",
                        "entry_id": "d4e704a5-5875-3698-8f22-2a50f160216e",
                        "glosses": [
                            "Affaire qui procure un profit."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
