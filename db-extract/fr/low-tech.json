            {
                "entry_id": "da682a51-f364-3f21-8296-2b520b2346b0",
                "word": "low-tech",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c0039ec4-6d5f-3ba5-aee2-2fda13e15778",
                        "entry_id": "da682a51-f364-3f21-8296-2b520b2346b0",
                        "glosses": [
                            "Dans une démarche technique davantage que technologique, qui privilégie une façon de fonctionner simple, basée sur la production personnelle d’objets manufacturés répondant à des besoins individuels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "780dd2d8-21ea-4fd9-a60d-1a19f28bb01c",
                                "sense_id": "c0039ec4-6d5f-3ba5-aee2-2fda13e15778",
                                "text": "Ces initiatives low-tech sont nées des mutations profondes que nous vivons à travers les enjeux environnementaux : économiser les ressources naturelles, réutiliser les matériaux, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e33425ab-fc7e-47a4-b5fc-63fd9c762a0d",
                        "source_entry_id": "da682a51-f364-3f21-8296-2b520b2346b0",
                        "source_sense_id": "c0039ec4-6d5f-3ba5-aee2-2fda13e15778",
                        "target_lang_word": "low-tech",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "low-tech",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "213bca43-55e7-3619-bcd8-80b3c297c277",
                                        "entry_id": "556fc5b1-492c-3c5d-a616-8ba3598a2436",
                                        "glosses": [
                                            "Simple, uncomplicated, primitive, not involving advanced technology."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85aa60fb-f9bb-4f6f-96f9-af371727bccc",
                                                "sense_id": "213bca43-55e7-3619-bcd8-80b3c297c277",
                                                "text": "Sometimes the low-tech ways are best: bash it with a rock, that'll loosen it."
                                            },
                                            {
                                                "example_id": "3b242b63-4321-4112-b51f-97074141f783",
                                                "sense_id": "213bca43-55e7-3619-bcd8-80b3c297c277",
                                                "text": "Many jihadist plots have been foiled and the security apparatus is getting better, overall, at pre-empting those who would do us ill. But, they say, the nature of the threat and the terrorists’ increasing use of low-tech, asymmetrical tactics such as hire vehicles and knives, make it all but impossible to stop every assault."
                                            },
                                            {
                                                "example_id": "186b659e-63de-466a-a848-5bf5e7bccf7d",
                                                "sense_id": "213bca43-55e7-3619-bcd8-80b3c297c277",
                                                "text": "The control centre of the Shinkansen, the world's first high-speed railway, is surprisingly low-tech."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "89cecbd5-a48e-3087-8c0c-5669fe95935e",
