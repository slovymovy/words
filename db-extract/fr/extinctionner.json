                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0081d7ba-8001-41ec-a13f-7673b5ca1d81",
                                "sense_id": "5e512c0e-84be-33e6-b47d-2295bb5f3de9",
                                "text": "Et ils devraient extinctionner l'espèce humaine en commençant par eux."
                            },
                            {
                                "example_id": "106e5602-98ee-4dc5-95f9-0c29e7c2003f",
                                "sense_id": "5e512c0e-84be-33e6-b47d-2295bb5f3de9",
                                "text": "Ne soyons pas de la race des dinosaures : ne nous laissons pas \"extinctionner\" !"
                            },
                            {
                                "example_id": "7cb14c5f-1e9f-4783-8f47-9acabe5b89a7",
                                "sense_id": "5e512c0e-84be-33e6-b47d-2295bb5f3de9",
                                "text": "Sur ce, j'ai beau m'emmerder à l'hôtel, l'heure est venue d'extinctionner les feux."
                            }
                        ]
                    }
