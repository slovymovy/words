                        "examples": [
                            {
                                "example_id": "9c5cb5a6-cb20-4adf-bcca-0f01c4c51a54",
                                "sense_id": "92cb2607-db46-358f-bb49-0a308ebfc639",
                                "text": "De Eibergse Monique Meijer houdt een open dag in haar bloemschikatelier Helleborus Niger."
                            },
                            {
                                "example_id": "dcf874e2-d9ca-4ab6-9915-3a393b16e433",
                                "sense_id": "92cb2607-db46-358f-bb49-0a308ebfc639",
                                "text": "De Stekkentuin in Espel houdt vandaag en morgen de laatste van een serie Open Helleborusdagen. Wies Voesten ontvangt tussen 10.00 en 17.00 uur tuinliefhebbers die haar honderden soorten kerstrozen, zoals de helleborus wordt genoemd, willen bewonderen."
                            },
                            {
                                "example_id": "2a59da78-cb23-44ed-bfe8-dcb1e02cc461",
                                "sense_id": "92cb2607-db46-358f-bb49-0a308ebfc639",
                                "text": "Het geslacht nieskruid (Helleborus) omvat 15 tot 22 soorten volgens verschillende auteurs. Tot het geslacht behoren onder meer de kerstroos (Helleborus niger), het stinkend nieskruid (Helleborus foetidus), de lenteroos (Helleborus orientalis) en de wrangwortel (Helleborus viridis)."
                            }
                        ]
