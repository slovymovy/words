                            {
                                "example_id": "ede31be3-3425-4cfc-8832-7c15f3dc68de",
                                "sense_id": "76150a86-2aaa-312d-aff0-829922246e4e",
                                "text": "Jeden z wychowanków katowickiej wszechnicy pracuje dzisiaj w NASA."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ad3f9fba-5c1c-3614-9ada-b6672bf62e48",
                        "entry_id": "fa638ddb-5373-3f28-bc27-c9693d8d6502",
                        "glosses": [
                            "osoba wzięta na wychowanie przez kogoś, będąca pod czyjąś opieką; ktoś, kto został wychowany przez osoby nie będące jego rodzicami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82b80e9a-9d95-49de-bcf9-c666fe97286f",
                                "sense_id": "ad3f9fba-5c1c-3614-9ada-b6672bf62e48",
                                "text": "Dlatego też wychowanie dobre, lub tak nazywane, polega w znacznej części na oszukiwaniu wychowanków, a to w tym celu, aby zaniedbywali wygody własnej na rzecz cudzej"
                            }
                        ],
