                "senses": [
                    {
                        "sense_id": "b24fa5f3-8d17-30df-b7f9-4b3558b82739",
                        "entry_id": "e6c46bab-587f-3d4b-b56a-2d94bb878cd6",
                        "glosses": [
                            "Kopf eines Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad977e7-7c0b-49b1-9694-b3214488b663",
                                "sense_id": "b24fa5f3-8d17-30df-b7f9-4b3558b82739",
                                "text": "„Weil ein chinesisches Ehepaar dachte, mit einer aus einem Menschenkopf zubereiteten Suppe seine psychisch kranke Tochter heilen zu können, hat es einen Mord in Auftrag gegeben.“"
                            },
                            {
                                "example_id": "cdcf55c5-ebef-4b6a-9e1e-7e2ea09bfcd3",
                                "sense_id": "b24fa5f3-8d17-30df-b7f9-4b3558b82739",
                                "text": "„Die Überwindung des Egos wird beispielsweise in der indischen Tradition u. a. dargestellt als Kette abgeschlagener Dämonen- oder Menschenköpfe, die die Göttin Kali um ihren Hals trägt, zum Zeichen, daß sie sich von ihnen befreit hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33a6bb27-2ec5-4e46-8032-a72955b6b634",
                        "source_entry_id": "e6c46bab-587f-3d4b-b56a-2d94bb878cd6",
