                                        "entry_id": "175add79-49c3-30f3-814a-6f1746d719ab",
                                        "glosses": [
                                            "Verlust kognitiver Fähigkeiten, zum Beispiel des Gedächtnisses, der Orientierung, der Handlungsfähigkeit, der Emotion, der Motivation oder der Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22849dcf-72ca-4aa3-87e2-3c1c6e4390bb",
                                                "sense_id": "191cda61-625d-3fab-89b7-a0223a22de11",
                                                "text": "„Ist das schon ein Zeichen von Demenz oder lediglich Ignoranz?“"
                                            },
                                            {
                                                "example_id": "79bbd7c9-936d-4df2-b9ad-d30a394692f1",
                                                "sense_id": "191cda61-625d-3fab-89b7-a0223a22de11",
                                                "text": "„Besonders in der zweiten Amtszeit, die er durch einen vorzeitigen, als quälend spät empfundenen Rücktritt beendete, machte sich seine fortschreitende Demenz bemerkbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ade21858-afc2-4af3-9147-533c4438fa7d",
                        "source_entry_id": "f4401dd7-09a9-3c84-a544-e7bb1b40e7b8",
