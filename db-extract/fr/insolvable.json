                        "form_id": "03069d0f-91e4-4c76-a2df-068a586e845a",
                        "entry_id": "9a1572a9-ba34-38bb-916d-b64846fedb9c",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "insolvables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d9e17f1-6e45-3a43-a63b-5bfa43f94bf5",
                        "entry_id": "9a1572a9-ba34-38bb-916d-b64846fedb9c",
                        "glosses": [
                            "Qui n’a pas de quoi payer ce qu’il doit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80863c8-d030-4bcb-b50b-617fa4a2865e",
                                "sense_id": "9d9e17f1-6e45-3a43-a63b-5bfa43f94bf5",
                                "text": "Ces gens-là savent bien qu’ils sont exposés à des dommages-intérêts et même à la prison ; mais que leur importe ? ils ont changé d’habit, donné un faux nom et une fausse adresse et par-dessus tout ils sont insolvables."
                            },
                            {
                                "example_id": "4eb400f4-e7fd-4eb2-b5c2-d87ac64678df",
                                "sense_id": "9d9e17f1-6e45-3a43-a63b-5bfa43f94bf5",
                                "text": "Les avoués ne pourront enchérir pour les personnes notoirement insolvables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03a921d3-cf20-4615-b1a2-9788443a6d11",
                        "source_entry_id": "9a1572a9-ba34-38bb-916d-b64846fedb9c",
                        "source_sense_id": "9d9e17f1-6e45-3a43-a63b-5bfa43f94bf5",
                        "target_lang_word": "zahlungsunfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zahlungsunfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d30641e6-c5f9-35c1-b4f7-0b4900e44d3e",
                                        "entry_id": "ff7b0b86-ea5a-3242-b140-1abbf5227959",
                                        "glosses": [
                                            "nicht fähig, ausstehende Forderungen zu begleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e71e017c-a7fb-4e7e-9cf7-3ee2c4245069",
                                                "sense_id": "d30641e6-c5f9-35c1-b4f7-0b4900e44d3e",
                                                "text": "Dieser Kunde ist mittlerweile vollkommen zahlungsunfähig."
                                            },
                                            {
                                                "example_id": "31384ddc-348e-4f62-a830-373ec38916ec",
                                                "sense_id": "d30641e6-c5f9-35c1-b4f7-0b4900e44d3e",
                                                "text": "„Der Reisekonzern FTI ist zahlungsunfähig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c221af12-004e-4e72-8d3a-6eaead24d2f8",
                        "source_entry_id": "9a1572a9-ba34-38bb-916d-b64846fedb9c",
                        "source_sense_id": "9d9e17f1-6e45-3a43-a63b-5bfa43f94bf5",
                        "target_lang_word": "insolvent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insolvent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01a69dc4-3331-3a1f-85d6-94fa9b247d80",
                                        "entry_id": "0b044a2f-f068-3777-bd50-a33568dad135",
                                        "glosses": [
                                            "unfähig sein, wegen fehlender Liquidität (=Geldmangel) oder Überschuldung seinen laufenden Zahlungsverpflichtungen (=Verbindlichkeiten, Schulden) gegenüber den Gläubigern nachkommen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d4aeecf-54a7-485e-bc2b-e6bbd0494756",
                                                "sense_id": "01a69dc4-3331-3a1f-85d6-94fa9b247d80",
                                                "text": "Insolvent sein zieht in Deutschland oft ein gerichtliches Vergleichs- oder Konkursverfahren nach sich, die dann entweder in einen Vergleich, eine Sanierung oder einen Konkurs münden."
                                            },
                                            {
                                                "example_id": "6fcfdf9d-88a6-4583-ad88-422394183e73",
                                                "sense_id": "01a69dc4-3331-3a1f-85d6-94fa9b247d80",
                                                "text": "Wenn wir so weitermachen in dieser Firma, sind wir bald insolvent."
                                            },
                                            {
                                                "example_id": "0bd51f4e-5070-4f65-93b7-9647dbc33de5",
                                                "sense_id": "01a69dc4-3331-3a1f-85d6-94fa9b247d80",
                                                "text": "Der Betreiber des berühmten Hotelkasinos Caesars Palace in Las Vegas hat sich für insolvent erklärt."
                                            },
                                            {
                                                "example_id": "60d0d24f-b4b9-46df-a41d-47f34a1f6949",
                                                "sense_id": "01a69dc4-3331-3a1f-85d6-94fa9b247d80",
                                                "text": "Der Industriestandort [Detroit] im Staat Michigan darf nun seine rund 18 Milliarden Dollar (13,25 Milliarden Euro) Schulden in einer geregelten Insolvenz abbauen. \"Das Gericht meint, dass Detroit insolvent war und ist\", sagte Richter Steven Rhodes. Die Stadt könne nun neu starten."
                                            },
                                            {
                                                "example_id": "51f5bef6-47f7-4ec4-94c1-f6e95aa00a90",
                                                "sense_id": "01a69dc4-3331-3a1f-85d6-94fa9b247d80",
                                                "text": "Für die insolvente Tageszeitung Frankfurter Rundschau (FR) gibt es erste Kaufinteressenten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae252ca3-35e1-4b39-b7f6-ca363f394e7a",
                        "source_entry_id": "9a1572a9-ba34-38bb-916d-b64846fedb9c",
                        "source_sense_id": "9d9e17f1-6e45-3a43-a63b-5bfa43f94bf5",
