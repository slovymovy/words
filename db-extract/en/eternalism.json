                "word": "eternalism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6f5c4c1c-b185-3c64-9407-301cfe7a2f68",
                        "entry_id": "9b565d22-740b-3457-ad7e-64a0a6c46f19",
                        "glosses": [
                            "The view that time resembles space and thus past and future events are in some sense coexistent."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6f9a1912-e9a2-32e6-b1d9-cc9fa81466b4",
                        "entry_id": "9b565d22-740b-3457-ad7e-64a0a6c46f19",
                        "glosses": [
                            "The view that matter is uncreated and has existed, and will exist, eternally."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "da0f0c36-1aeb-4ceb-9eb5-fed2b0edc0d4",
                                "sense_id": "6f9a1912-e9a2-32e6-b1d9-cc9fa81466b4",
                                "text": "[The earth’s] history stretched indefinitely or even infinitely into past and future and involved no unique and unexplained events such as the Flood; indeed, earth history was “without vestige of a beginning, without prospect of an end.” […] Most significantly, the virtual eternalism of such theories was extended, often explicitly, to the history of mankind[…]. Mankind could thus be claimed as uncreated and therefore not subject to any of the traditional moral and social constraints."
                            },
                            {
                                "example_id": "21b833f5-14d2-4c8c-8cad-fd92def0fe70",
                                "sense_id": "6f9a1912-e9a2-32e6-b1d9-cc9fa81466b4",
                                "text": "The first of these is eternalism, which holds that matter, energy, and intelligence—the components of the universe—are uncreated, indestructible, eternal, and forever fixed."
                            }
                        ]
                    }
                ],
