    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "852134be-e9ed-3735-8078-6e1e97bfcb8a",
                    "sense_definition": "The simple past tense and past participle of <w>feed</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>fed</w> the dog before I left for work this morning.",
                            "target_lang_translations": {
                                "ru": "Я <w>покормил</w> собаку перед уходом на работу сегодня утром.",
                                "tr": "Bu sabah işe gitmeden önce köpeği <w>besledim</w>.",
                                "nl": "Ik heb de hond <w>gevoed</w> voordat ik vanmorgen naar mijn werk vertrok.",
                                "fr": "J'ai <w>nourri</w> le chien avant de partir au travail ce matin."
                            }
                        },
                        {
                            "text": "The baby has already been <w>fed</w> and is sleeping now.",
                            "target_lang_translations": {
                                "ru": "Ребенок уже <w>накормлен</w> и сейчас спит.",
                                "tr": "Bebek çoktan <w>beslendi</w> ve şu an uyuyor.",
                                "nl": "De baby is al <w>gevoed</w> en slaapt nu.",
                                "fr": "Le bébé a déjà été <w>nourri</w> et dort maintenant."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fed up",
                        "well fed",
                        "force-fed",
                        "spoon-fed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола feed (кормить).",
                        "tr": "Feed (beslemek) fiilinin geçmiş zaman ve geçmiş zaman ortacı hali.",
                        "nl": "De onvoltooid verleden tijd en het voltooid deelwoord van het werkwoord 'feed' (voeden/te eten geven).",
                        "fr": "Le passé simple et le participe passé du verbe « feed » (nourrir)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кормил",
                                "target_lang_sense_clarification": "прошедшее время"
