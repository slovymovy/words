                        "sense_id": "3bda8ed3-50e0-39e6-a3a2-17ef22766fb1",
                        "entry_id": "f2009380-12f7-3184-81fe-5b3a8c2e3690",
                        "glosses": [
                            "een muzieknummer dat door heel veel mensen is gekocht; succesvol lied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe0c3a5a-58af-4b98-baf5-f7fc5b181b1f",
                                "sense_id": "3bda8ed3-50e0-39e6-a3a2-17ef22766fb1",
                                "text": "Ik wilde er zeker van zijn dat Runner bereid was om er serieus geld in te pompen. Dit album verdiende het om een knaller te worden.Vóór de eerste plaat werd geperst lobbyde ik bij Teddy voor een enorm bedrag. Ik wilde een echte hitsingle."
                            },
                            {
                                "example_id": "8b9c7483-6f62-439a-bcf5-e3e947a2c4f4",
                                "sense_id": "3bda8ed3-50e0-39e6-a3a2-17ef22766fb1",
                                "text": "DMX, de artiestennaam van Earl Simmons, brak in 1998 door met zijn debuutalbum It's Dark and Hell Is Hot. Een jaar later volgde zijn bestverkopende album, ...And Then There Was X, met de hitsingle Party Up (Up In Here)."
                            }
                        ]
                    }
