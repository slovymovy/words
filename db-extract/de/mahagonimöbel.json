                "senses": [
                    {
                        "sense_id": "ec02b155-7ee9-3be5-9cdc-5267a898a783",
                        "entry_id": "15c47418-25fe-376d-8004-e8ae027799b4",
                        "glosses": [
                            "Möbel, hergestellt aus Mahagoni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b072c89f-bebe-4e09-b8b6-1d6b8e96451c",
                                "sense_id": "ec02b155-7ee9-3be5-9cdc-5267a898a783",
                                "text": "„Und damit traten sie vom Thronsaal her in ein paar niedrige, mit kleinen Mahagonimöbeln ausgestattete Räume, deren Spießbürgerlichkeit nur noch von ihrer Langeweile übertroffen wurde.“"
                            },
                            {
                                "example_id": "55f7b575-da95-4cc0-888c-472a258e412d",
                                "sense_id": "ec02b155-7ee9-3be5-9cdc-5267a898a783",
                                "text": "„Allerdings war es nicht kostbar eingerichtet, doch die massiven Mahagonimöbel, die schneeweißen Vorhänge, die mit dunklem Damast überzogenen Sessel verkündeten deutlich genug, daß hier Wohlhabenheit herrschte.“"
                            },
                            {
                                "example_id": "fd7204c5-4939-4b8b-b4e7-565ddf5ce3df",
                                "sense_id": "ec02b155-7ee9-3be5-9cdc-5267a898a783",
                                "text": "„Das Zimmer war bürgerlich und ohne viel Geschmack eingerichtet, mit gediegenen Mahagonimöbeln, einem modernen Perserteppich, ein paar mit Rips überzogenen Sesseln und einigen Lampen mit Schirmen aus farbiger Seide, – aber Kern erschien es wie eine Vision des Friedens und eine Insel der Sicherheit.“"
                            },
                            {
                                "example_id": "7c7461d0-5e7c-4248-9bcb-1e151bc7ca52",
                                "sense_id": "ec02b155-7ee9-3be5-9cdc-5267a898a783",
                                "text": "„Bouvards Zimmer war gut gebohnert, hatte Vorhänge aus Perkal sowie Mahagonimöbel und besaß den Vorzug eines Balkons mit Blick auf den Fluß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
