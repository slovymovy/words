                "senses": [
                    {
                        "sense_id": "febe938b-a2b5-3f94-94fd-76baadf99c9d",
                        "entry_id": "d879fe3e-c9e8-3aeb-8727-5db144ef22e1",
                        "glosses": [
                            "Rendre moins tendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f746fe56-3ccb-47e5-a264-a6730145844a",
                                "sense_id": "febe938b-a2b5-3f94-94fd-76baadf99c9d",
                                "text": "Elle endurcit et désattendrit l’homme."
                            },
                            {
                                "example_id": "6ccc4c6f-a1fb-47af-b240-ed084415842c",
                                "sense_id": "febe938b-a2b5-3f94-94fd-76baadf99c9d",
                                "text": "Il serait mort de chagrin ou de quelque râclée reçue entre deux classes, mort d’un coup sourd dans les reins ou dans l’âme — à moins qu’il ne se fût banalisé, désattendri, et n’eût mis sa nature délicate et vibrante au niveau de l’insensibilité commune."
                            }
                        ]
                    }
                ],
