                ],
                "senses": [
                    {
                        "sense_id": "aa8e382d-a9b7-324b-9aba-cd96b122c877",
                        "entry_id": "f744966c-907e-3293-b7c4-a8df090f5953",
                        "glosses": [
                            "so, dass es beliehen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee45b2f-eb05-4995-9d8e-571f2d001639",
                                "sense_id": "aa8e382d-a9b7-324b-9aba-cd96b122c877",
                                "text": "Diese private Rentenversicherung ist leider nicht beleihbar, vererbbar, veräußerbar, übertragbar und kapitalisierbar."
                            },
                            {
                                "example_id": "9498d640-1e2e-481f-9712-45e5ca3fef9c",
                                "sense_id": "aa8e382d-a9b7-324b-9aba-cd96b122c877",
                                "text": "„Er schilderte ihm seine Lage, log jedoch im Vertrauen auf die Weltfremdheit des Majors, daß seine Papiere infolge der schlechten Konjunktur jetzt unverkäuflich und nicht beleihbar wären ….“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
