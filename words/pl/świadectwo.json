                {
                    "sense_id": "c2b03ac5-1099-36fd-a741-3f1825f95e24",
                    "sense_definition": "Relacja osoby będącej świadkiem zdarzenia lub dowód potwierdzający prawdziwość czegoś.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego bohaterskie czyny są najlepszym <w>świadectwem</w> jego odwagi.",
                            "target_lang_translations": {
                                "ru": "Его героические поступки служат лучшим <w>свидетельством</w> его отваги.",
                                "en": "His heroic deeds are the best <w>testament</w> to his bravery."
                            }
                        },
                        {
                            "text": "Stare fotografie stanowią cenne <w>świadectwo</w> historii tego miasta.",
                            "target_lang_translations": {
                                "ru": "Старые фотографии представляют собой ценное <w>свидетельство</w> истории этого города.",
                                "en": "Old photographs constitute valuable <w>testimony</w> to the history of this city."
                            }
                        }
                    ],
                    "synonyms": [
