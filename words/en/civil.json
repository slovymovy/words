{
    "word_family": [
        "civility",
        "civilize",
        "civilization",
        "civilian",
        "civic",
        "uncivil"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "faa37464-c403-3d26-9f65-9c86a1019227",
                    "sense_definition": "Behaving in a polite or reasonable manner, especially to avoid conflict or hostility.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even though they had a difficult breakup, they managed to remain <w>civil</w> for the sake of their children.",
                            "target_lang_translations": {
                                "ru": "Несмотря на тяжелый разрыв, им удалось остаться <w>вежливыми</w> ради детей."
                            }
                        },
                        {
                            "text": "It was very <w>civil</w> of him to stop the argument before it became a shouting match.",
                            "target_lang_translations": {
                                "ru": "С его стороны было очень <w>вежливо</w> прекратить спор до того, как он перерос в перепалку."
                            }
                        }
                    ],
                    "synonyms": [
                        "polite",
                        "courteous",
                        "well-mannered"
                    ],
                    "antonyms": [
                        "rude",
                        "impolite",
                        "inconsiderate"
                    ],
                    "common_phrases": [
                        "remain civil",
                        "civil behavior",
                        "perfectly civil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливое или разумное поведение, особенно во избежание конфликта или враждебности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вежливый",
                                "target_lang_sense_clarification": "соблюдающий правила приличия"
                            },
                            {
                                "target_lang_word": "корректный",
                                "target_lang_sense_clarification": "тактичный и сдержанный"
                            },
                            {
                                "target_lang_word": "цивилизованный",
                                "target_lang_sense_clarification": "соответствующий нормам поведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5beba960-b32e-3220-afd3-cd94d8d9a89e",
                    "sense_definition": "Relating to ordinary citizens and their government, as opposed to military or religious matters.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "governance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to pursue a career in <w>civil</w> service because she wanted to help her community.",
                            "target_lang_translations": {
                                "ru": "Она решила сделать карьеру на <w>государственной</w> службе, потому что хотела помогать обществу."
                            }
                        },
                        {
                            "text": "The country experienced a period of <w>civil</w> unrest following the controversial election results.",
                            "target_lang_translations": {
                                "ru": "В стране начался период <w>гражданских</w> беспорядков после спорных результатов выборов."
                            }
                        }
                    ],
                    "synonyms": [
                        "public",
                        "civic",
                        "state"
                    ],
                    "antonyms": [
                        "noncivil"
                    ],
                    "common_phrases": [
                        "civil service",
                        "civil rights",
                        "civil unrest",
                        "civil war"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к обычным гражданам и их правительству, в отличие от военных или религиозных дел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гражданский",
                                "target_lang_sense_clarification": "не военный и не церковный"
                            },
                            {
                                "target_lang_word": "штатский",
                                "target_lang_sense_clarification": "не состоящий на военной службе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b9c3dd6-c920-369c-beea-4cb689b8c167",
                    "sense_definition": "Relating to private legal disagreements between citizens, rather than criminal law.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dispute over the property boundaries was settled in a <w>civil</w> court rather than a criminal one.",
                            "target_lang_translations": {
                                "ru": "Спор о границах собственности был решен в <w>гражданском</w> суде, а не в уголовном."
                            }
                        },
                        {
                            "text": "The lawyer specialized in a <w>civil</w> case involving contract violations between two major companies.",
                            "target_lang_translations": {
                                "ru": "Адвокат специализировался на <w>гражданском</w> деле, связанном с нарушениями контракта между двумя крупными компаниями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "civil case",
                        "civil court",
                        "civil law",
                        "civil suit"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к частным правовым спорам между гражданами, а не к уголовному праву."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гражданский",
                                "target_lang_sense_clarification": "в юридическом смысле, не уголовный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81349a25-515e-37f0-9b9f-33abe6c525dd",
                    "sense_definition": "Relating to worldly or secular life as opposed to spiritual or religious life.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "governance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued for a <w>civil</w> marriage ceremony that did not require any religious affiliation.",
                            "target_lang_translations": {
                                "ru": "Философ выступал за <w>гражданскую</w> церемонию бракосочетания, не требующую религиозной принадлежности."
                            }
                        },
                        {
                            "text": "In many modern societies, <w>civil</w> authorities handle matters that were once the domain of the church.",
                            "target_lang_translations": {
                                "ru": "Во многих современных обществах <w>гражданские</w> власти занимаются вопросами, которые когда-то находились в ведении церкви."
                            }
                        }
                    ],
                    "synonyms": [
                        "secular",
                        "temporal",
                        "worldly"
                    ],
                    "common_phrases": [
                        "civil marriage",
                        "civil authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к мирской или светской жизни, в отличие от духовной или религиозной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гражданский",
                                "target_lang_sense_clarification": "светский, не церковный"
                            },
                            {
                                "target_lang_word": "светский",
                                "target_lang_sense_clarification": "не связанный с религией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8296dd1f-ffbc-37d6-83f0-8638ac5987f8",
                    "sense_definition": "Existing in a peaceful, organized, and well-ordered state of society.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian described the ancient kingdom as a <w>civil</w> society where laws were respected by all.",
                            "target_lang_translations": {
                                "ru": "Историк описал древнее царство как <w>гражданское</w> общество, где законы соблюдались всеми."
                            }
                        },
                        {
                            "text": "They hoped that the new treaty would lead to a more <w>civil</w> and stable region.",
                            "target_lang_translations": {
                                "ru": "Они надеялись, что новый договор приведет к созданию более <w>цивилизованного</w> и стабильного региона."
                            }
                        }
                    ],
                    "synonyms": [
                        "civilized",
                        "orderly"
                    ],
                    "antonyms": [
                        "anti-civil"
                    ],
                    "common_phrases": [
                        "civil society"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used to describe a peaceful state"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в мирном, организованном и упорядоченном состоянии общества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гражданский",
                                "target_lang_sense_clarification": "общественный и упорядоченный"
                            },
                            {
                                "target_lang_word": "цивилизованный",
                                "target_lang_sense_clarification": "развитый и правовой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bc0d5ef8-4215-3082-b827-ffcc1658ceac",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after Mr. <w>Civil</w>, who had donated his entire book collection.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь мистера <w>Сивила</w>, который пожертвовал всю свою книжную коллекцию."
                            }
                        },
                        {
                            "text": "We are meeting with the <w>Civils</w> this weekend to discuss the community project.",
                            "target_lang_translations": {
                                "ru": "Мы встречаемся с семьей <w>Сивил</w> в эти выходные, чтобы обсудить общественный проект."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "rare English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сивил",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}