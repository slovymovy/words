                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a794b865-2953-42e8-9095-92225cf01665",
                                "sense_id": "baf2e8c9-2a05-3e76-901c-8fdd03d71d6a",
                                "text": "Bij metrohalte Barrikade stapte ik uit en bestudeerde op de roltrap omhoog de sombere gezichten van de afdalende Moskovieten, die de dikke sneeuwvlokken nog op hun jas droegen."
                            },
                            {
                                "example_id": "29d3eb83-b75c-4e21-bdeb-a3615af0eb96",
                                "sense_id": "baf2e8c9-2a05-3e76-901c-8fdd03d71d6a",
                                "text": "In de oostelijke volkswijk ligt naast metrohalte Portazgo het Campo de Fútbol de Vallecas, een lust voor het oog voor de ware stadionliefhebber."
                            }
                        ]
                    }
