                "senses": [
                    {
                        "sense_id": "25bc75bb-10a8-3c68-b4e7-8f783f832394",
                        "entry_id": "a2510ee8-8c4c-33ab-8f89-0ced0c37f3f2",
                        "glosses": [
                            "Qu’on peut présenter, qui peut se présenter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0735ed-e2a3-44cf-af06-92770da18019",
                                "sense_id": "25bc75bb-10a8-3c68-b4e7-8f783f832394",
                                "text": "Cette raison n’est pas présentable."
                            },
                            {
                                "example_id": "e497dea3-9d19-445f-a544-1b9fb1528c06",
                                "sense_id": "25bc75bb-10a8-3c68-b4e7-8f783f832394",
                                "text": "Cette lettre pleine de ratures n’est pas présentable."
                            },
                            {
                                "example_id": "2b40e6fe-0887-421b-9702-9377aa92d9a9",
                                "sense_id": "25bc75bb-10a8-3c68-b4e7-8f783f832394",
                                "text": "Voilà un plat qui n’est pas présentable."
                            },
                            {
                                "example_id": "b67f0846-6414-4a51-a99f-8fa1ce84d4c2",
                                "sense_id": "25bc75bb-10a8-3c68-b4e7-8f783f832394",
                                "text": "C’est un garçon fort présentable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9400cf2-d51e-435d-96d0-24a5c31b429d",
                        "source_entry_id": "a2510ee8-8c4c-33ab-8f89-0ced0c37f3f2",
                        "source_sense_id": "25bc75bb-10a8-3c68-b4e7-8f783f832394",
                        "target_lang_word": "vorzeigbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorzeigbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8682354d-8e8d-3d75-a4fe-7d1ab5afdbaf",
                                        "entry_id": "a733853b-4139-3dba-8233-ba16246b8bf1",
                                        "glosses": [
                                            "den Anforderungen und gestellten Ansprüchen vollständig genügend und dadurch zum (stolzen) Vorzeigen geeignet"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "402a0abb-3922-4025-b874-452d8a33e356",
                                                "sense_id": "8682354d-8e8d-3d75-a4fe-7d1ab5afdbaf",
                                                "text": "„Wenn sich diese zynische Einstellung nicht verhärten soll, braucht Kenny möglichst rasch vorzeigbare Erfolge.“"
                                            },
                                            {
                                                "example_id": "75291f19-861a-443a-95f5-8afa47c95a95",
                                                "sense_id": "8682354d-8e8d-3d75-a4fe-7d1ab5afdbaf",
                                                "text": "Die Ägypter mussten solange wählen gehen, bis endlich das gewünschte Ergebnis bei einigermaßen vorzeigbarer Wahlbeteiligung zustande kam. Ein weiterer Rückschritt in die Ära Mubarak […]"
                                            },
                                            {
                                                "example_id": "31c29202-2792-4a3d-9af8-86f53c6f6827",
                                                "sense_id": "8682354d-8e8d-3d75-a4fe-7d1ab5afdbaf",
                                                "text": "[…] die Unterhändler [brauchen schnell] ein vorzeigbares Ergebnis bei diesen [Atom-]Gesprächen [mit dem Iran] in Lausanne."
                                            },
                                            {
                                                "example_id": "3b7bd753-eda8-4098-9e27-8fe4b18b1a53",
                                                "sense_id": "8682354d-8e8d-3d75-a4fe-7d1ab5afdbaf",
                                                "text": "Der Kölner Taschen-Verlag gilt als der größte Kunstbuchverlag der Welt. Er hat es geschafft, das Kunstbuch zu einem billigen Massenprodukt zu machen. Der Vorteil: Sie sind lesbar und vorzeigbar."
                                            },
                                            {
                                                "example_id": "c4d4d58b-4a8a-40b3-9fc2-f40c3b26961c",
                                                "sense_id": "8682354d-8e8d-3d75-a4fe-7d1ab5afdbaf",
                                                "text": "[Luther] sei nicht nur ein Feind der Juden, sondern auch der Türken. Mit seinen wüsten Beschimpfungen auf das Papsttum sei er ökumenisch nicht vorzeigbar."
                                            },
                                            {
                                                "example_id": "5d30516e-83b2-418f-9870-27373edad92e",
                                                "sense_id": "8682354d-8e8d-3d75-a4fe-7d1ab5afdbaf",
                                                "text": "Zu den Kriterien [zur Zulassung von Parteien zur Bundestagswahl 2009] gehörten zudem, ob sie eine vorzeigbare Mitgliederzahl, eine verfestigte Organisation haben sowie Aktivitäten entfalten, um Wahlerfolge zu erringen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e67e002-5980-40d7-8fbe-328d8af88ba6",
                        "source_entry_id": "a2510ee8-8c4c-33ab-8f89-0ced0c37f3f2",
                        "source_sense_id": "25bc75bb-10a8-3c68-b4e7-8f783f832394",
