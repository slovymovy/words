                            },
                            {
                                "example_id": "fbba97f8-75a9-4073-98f9-c76cb187b729",
                                "sense_id": "30fee1a5-f835-30ba-8488-a1c03e4281e2",
                                "text": "Het schilderij werd verkocht voor een aanzienlijke verkoopprijs.",
                                "translation": "The painting was sold for a substantial bidding price.",
                                "english": "The painting was sold for a substantial bidding price."
                            },
                            {
