                            {
                                "target_lang_word": "vermoulu",
                                "target_lang_sense_clarification": "spécifiquement pour le bois rongé par les vers ou la pourriture"
                            },
                            {
                                "target_lang_word": "pourri",
                                "target_lang_sense_clarification": "terme général pour quelque chose en état de décomposition"
                            }
                        ]
                    }
                }
            ]
        },
        {
