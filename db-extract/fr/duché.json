                        "target_lang_word": "Herzogtum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herzogtum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d90271b-51fc-3764-adf6-46036c4022fb",
                                        "entry_id": "49cae3e1-5f04-34e9-90c0-76b661cea800",
                                        "glosses": [
                                            "Herrschaftsgebiet eines Herzogs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "475da020-d4a8-45fb-be65-54a1c1d460d0",
                                                "sense_id": "9d90271b-51fc-3764-adf6-46036c4022fb",
                                                "text": "„Der Konflikt des neuen Königs mit dem Welfen Heinrich gen. der Stolze, dem das sächsische Herzogtum genommen wurde, brachte Albrecht an das von ihm und seiner Mutter höchst erwünschte Ziel, indem er nun die Belehnung mit dem Herzogtum empfing.“"
                                            },
                                            {
                                                "example_id": "a9ef907f-dd3b-468e-a81f-529c3de8cb1e",
                                                "sense_id": "9d90271b-51fc-3764-adf6-46036c4022fb",
                                                "text": "„Der Welfe wurde vor den Reichstag zitiert, unter Reichsacht gestellt und verlor die Herzogtümer Sachsen und Bayern.“"
                                            },
                                            {
                                                "example_id": "1cdbf289-927b-446f-8079-7e9a4f58bc69",
                                                "sense_id": "9d90271b-51fc-3764-adf6-46036c4022fb",
                                                "text": "„Das Herzogtum Schleswig gehörte zu Dänemark.“"
                                            },
                                            {
                                                "example_id": "7a87b276-38e1-44f7-ab3d-e333015b17e5",
                                                "sense_id": "9d90271b-51fc-3764-adf6-46036c4022fb",
                                                "text": "„In Königsberg, der Hauptstadt des Herzogtums Preußen, wurde Immanuel Kant am 22. April 1724 geboren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
