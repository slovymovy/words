                "senses": [
                    {
                        "sense_id": "88079599-2b7a-31de-ba10-22de4305bdeb",
                        "entry_id": "da308366-7331-30f3-8a61-61b23ab51559",
                        "glosses": [
                            "книжн. отступление от главной темы изложения для освещения побочного или дополнительного вопроса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d4c93eb-dd83-4252-aaf6-d7758305da4f",
                                "sense_id": "88079599-2b7a-31de-ba10-22de4305bdeb",
                                "text": "На этом мы заканчиваем наш экскурс в область истории жанров и возвращаемся к Достоевскому…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0caddd0-32cd-4863-b14b-0e9453db4a8b",
                        "source_entry_id": "da308366-7331-30f3-8a61-61b23ab51559",
                        "source_sense_id": "88079599-2b7a-31de-ba10-22de4305bdeb",
                        "target_lang_word": "excursus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excursus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a75260f1-e0c2-3166-99b4-385fd03c27ed",
                                        "entry_id": "476235cf-820e-3e07-9aed-344139920eb1",
                                        "glosses": [
                                            "A fuller treatment (in a separate section) of a particular part of the text of a book, especially a classic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8fa9ae87-9aa4-3e85-9c0f-e839ece1d7ab",
                                        "entry_id": "476235cf-820e-3e07-9aed-344139920eb1",
                                        "glosses": [
                                            "A narrative digression, especially to discuss a particular issue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c26a889a-b238-4dd4-a213-5aac0c30b18f",
                                                "sense_id": "8fa9ae87-9aa4-3e85-9c0f-e839ece1d7ab",
                                                "text": "Here is what us scholars call an excursus. If you are an honest man the following page or two can be of no possible interest to you."
                                            },
                                            {
                                                "example_id": "a3c76043-8a93-4c1f-8d5e-07c0e1029525",
                                                "sense_id": "8fa9ae87-9aa4-3e85-9c0f-e839ece1d7ab",
                                                "text": "In his excursus on the Jewish people at the opening of the fifth book of his Histories [...], Tacitus was at a loss to uncover any deep cause for the war that broke out in 66."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb650e3a-bbe9-43d8-a9a3-64b74e11a4e7",
                        "source_entry_id": "da308366-7331-30f3-8a61-61b23ab51559",
                        "source_sense_id": "88079599-2b7a-31de-ba10-22de4305bdeb",
                        "target_lang_word": "digression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37d84b26-9853-396a-a772-155a6351695f",
                                        "entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                                        "glosses": [
                                            "An aside, an act of straying from the main subject in speech or writing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eff61bb5-55aa-41a2-bc00-1c10bf27b1a5",
                                                "sense_id": "37d84b26-9853-396a-a772-155a6351695f",
                                                "text": "The lectures included lengthy digressions on topics ranging from the professor's dog to the meaning of life."
                                            },
                                            {
                                                "example_id": "27ea2196-25ca-4646-b378-86a848b41fea",
                                                "sense_id": "37d84b26-9853-396a-a772-155a6351695f",
                                                "text": "History tells us stodgy, cautious stuff, cardigan-football is the way to go here. The 1966 World Cup kicked off with 0-0 draw against Uruguay so tedious the Guardian match report contains a whimsical digression on the writer’s urge to drift off to sleep in the second half."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45659f7b-d6e1-3420-9152-3364b334c7ab",
                                        "entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                                        "glosses": [
                                            "The act of straying from the main subject in speech or writing, (rhetoric) particularly for rhetorical effect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54560b9c-240d-4ccc-8455-9f574f62f4ce",
                                                "sense_id": "45659f7b-d6e1-3420-9152-3364b334c7ab",
                                                "text": "make digression... by way of digression..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c657b313-d747-399b-b75c-e297b97ce368",
                                        "entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                                        "glosses": [
                                            "A deviancy, a sin or error, an act of straying from the path of righteousness or a general rule."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d41c0a4-0294-44d0-9e98-10180438c778",
                                                "sense_id": "c657b313-d747-399b-b75c-e297b97ce368",
                                                "text": "Nature...\nMore stronger hadde her operacyon\nThan she hath nowe in her dygressyon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "784cf8b0-e536-38db-b720-726a6bbec4c8",
                                        "entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                                        "glosses": [
                                            "A deviation, an act of straying from a path."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba31df69-a99e-4015-b351-b1f575932aff",
                                                "sense_id": "784cf8b0-e536-38db-b720-726a6bbec4c8",
                                                "text": "By this little digression into Gascony, the Duke had an opportunity... to re-inforce himself with some particular Servants of his."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3abafaa4-e474-3798-ad6d-2afec685c266",
                                        "entry_id": "d249b866-c34e-3255-bf73-b0ed2675e61c",
                                        "glosses": [
                                            "An elongation, a deflection or deviation from a mean position or expected path."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f6c4545-59f5-489e-a0c4-34dc1c7553e2",
                                                "sense_id": "3abafaa4-e474-3798-ad6d-2afec685c266",
                                                "text": "This digression [of the Sun] is not equall, but neare the Æquinoxiall intersections, it is right and greater, near the Solstices, more oblique and lesser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05d08080-c880-4ba5-ab1b-ac848345c566",
                        "source_entry_id": "da308366-7331-30f3-8a61-61b23ab51559",
                        "source_sense_id": "88079599-2b7a-31de-ba10-22de4305bdeb",
                        "target_lang_word": "digressione",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digressione",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "14d43ad6-a9b4-334f-854e-806a74fe16f4",
                                        "entry_id": "5304b010-9309-39fa-970c-b5a3e1f9781e",
                                        "glosses": [
                                            "deviazione dal percorso che si sta seguendo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c44053dc-2552-467a-ad4c-a94891e9665f",
                                                "sense_id": "14d43ad6-a9b4-334f-854e-806a74fe16f4",
                                                "text": "facemmo una digressione verso il mare per goderci il tramonto"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a9fd77a-1fa3-3796-9213-f61699491766",
                                        "entry_id": "5304b010-9309-39fa-970c-b5a3e1f9781e",
                                        "glosses": [
                                            "il deviare dall'argomento principale di un discorso"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58029b38-b301-3492-ad59-55090092b8f8",
                                        "entry_id": "5304b010-9309-39fa-970c-b5a3e1f9781e",
                                        "glosses": [
                                            "termine tecnico del linguaggio letterario, che indica una pausa narrativa, una parentesi che si apre all'interno di una narrazione, per precisare meglio, approfondire quanto detto in precedenza. L'autore blocca, per tanto, il flusso narrativo principale e, all'interno della digressione, si sofferma a darci ulteriori informazioni per esempio, su un personaggio di cui ha parlato prima. Un esempio di digressione è rappresentato da un flash-back, durante il quale lo scrittore ci illumina sul passato del personaggio in questione; e tutto questo avviene all'interno di una pausa narrativa. Un celeberrimo esempio è rappresentato dal quarto capitolo de I Promessi Sposi, che è un grande flash-back, perché in esso, Manzoni ci illustra il passato di Padre Cristoforo, quando era un mercante chiamato Lodovico."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
