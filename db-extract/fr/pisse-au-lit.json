                                "example_id": "5ffd0172-96b0-4474-984d-735eb472e478",
                                "sense_id": "8991fb11-9fec-3337-8101-e31fdc52009a",
                                "text": "C'était un pisse-au-lit que les traîtrises de ses reins tiraient fréquemment du sommeil, dans la chaude humidité de ses propres ruissellements."
                            },
                            {
                                "example_id": "8d0e9dca-5e23-4560-b74f-4b98029d644e",
                                "sense_id": "8991fb11-9fec-3337-8101-e31fdc52009a",
                                "text": "Ce garçon intelligent, dont les parents exigent trop, est un \"pisse-au-lit\". Ce lourd secret qu'il dissimule est vécu par toute la famille comme une honte."
                            }
                        ]
                    }
