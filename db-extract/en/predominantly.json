                                        "sense_id": "d043fdf5-a58a-3ebf-b08f-dbe6508ff786",
                                        "entry_id": "9f705029-d1c6-3c0a-be95-8296b9e38822",
                                        "glosses": [
                                            "in der Mehrheit, an erster Stelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1395f25b-3db7-4748-8aa9-f17c1e86a336",
                                                "sense_id": "d043fdf5-a58a-3ebf-b08f-dbe6508ff786",
                                                "text": "An dieser Küste brüten vorwiegend Lunde."
                                            },
                                            {
                                                "example_id": "1b46af35-3be6-4788-8be1-d340fb13afaf",
                                                "sense_id": "d043fdf5-a58a-3ebf-b08f-dbe6508ff786",
                                                "text": "„Ältere Emus fressen vorwiegend Früchte, Beeren, Samen, Blüten, junge Pflanzenschösslinge, frisches Gras und Kräuter.“"
                                            },
                                            {
                                                "example_id": "ec3098bf-e53e-4a47-8c82-e56654048173",
                                                "sense_id": "d043fdf5-a58a-3ebf-b08f-dbe6508ff786",
                                                "text": "„Das Rohöl werde vorwiegend in Kavernen in Norddeutschland gelagert, von wo aus es über Pipelines oder auch per Schiff zur Verarbeitung in Raffinerien transportiert werden kann.“"
                                            },
                                            {
                                                "example_id": "734fa13b-6fb4-4c81-95bb-b2ad5034e991",
                                                "sense_id": "d043fdf5-a58a-3ebf-b08f-dbe6508ff786",
                                                "text": "„Offiziell finden die Beratungen in Berlin statt, wegen der Corona-Pandemie wird aber vorwiegend virtuell beraten.“"
                                            },
                                            {
                                                "example_id": "9b2b5995-c5a1-4eb9-ac14-0f7dee14abf2",
                                                "sense_id": "d043fdf5-a58a-3ebf-b08f-dbe6508ff786",
                                                "text": "„Dafür verglich sie die Hörfähigkeiten von asiatischstämmigen Amerikanern ohne Musikbildung, die vorwiegend mit Englisch aufgewachsen waren, mit denen von Amerikanern, die weder musikalisch noch tonsprachlich geprägt waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
