                                    {
                                        "sense_id": "891f4a58-5284-3011-b40e-f3823970a863",
                                        "entry_id": "7ee906b2-c189-378b-bd35-f02e818f08db",
                                        "glosses": [
                                            "The property of being sure, certainty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14eeea13-689f-4f48-9095-75992d1151e4",
                                                "sense_id": "891f4a58-5284-3011-b40e-f3823970a863",
                                                "text": "His sureness was born of having looked it up in a reputable reference book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79098ad4-6ad4-3126-970e-aea7d27431c1",
                                        "entry_id": "7ee906b2-c189-378b-bd35-f02e818f08db",
                                        "glosses": [
                                            "The property of being sure, deft, confident of ability."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "043916e3-c2dd-4dbb-b499-579963103fa6",
                                                "sense_id": "79098ad4-6ad4-3126-970e-aea7d27431c1",
                                                "text": "The surgeon's sureness was the result of long study in school and long practice in the operating room, never did he hesitate and never was there a mis-move."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1d2464f-0984-328f-8ca2-bad95954ea2c",
                                        "entry_id": "7ee906b2-c189-378b-bd35-f02e818f08db",
                                        "glosses": [
                                            "The result or product of being sure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
