                ],
                "senses": [
                    {
                        "sense_id": "3af0c18e-f239-3dfb-be7e-61c681f71f71",
                        "entry_id": "08df7bdc-032e-323b-b3f6-a0e771e4aba5",
                        "glosses": [
                            "Allumer sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb91fcf2-fc63-415f-9d73-65d64f40be48",
                                "sense_id": "3af0c18e-f239-3dfb-be7e-61c681f71f71",
                                "text": "L’invention concerne un dispositif (10) de gonflement à deux étages destiné à autoallumer un matériau à autoallumage avant la fusion d’un générateur de gaz à basse température."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c820d22-639f-3d24-9cca-a8823f214b0c",
                        "entry_id": "08df7bdc-032e-323b-b3f6-a0e771e4aba5",
                        "glosses": [
                            "S’allumer soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "83bd7495-2d57-40a4-bd90-115b2644bb66",
                                "sense_id": "5c820d22-639f-3d24-9cca-a8823f214b0c",
                                "text": "Un ^([sic : Une]) barre n’étant pas assez concentrée en uranium pour s’autoallumer, elle finit par s’éteindre."
                            },
                            {
                                "example_id": "247b2a2e-ef66-4d29-a3eb-03855ff19dd5",
                                "sense_id": "5c820d22-639f-3d24-9cca-a8823f214b0c",
                                "text": "Si t’as full boost à régime relativement bas, le gaz aura tendance à s’autoallumer."
                            }
                        ]
                    }
