                "senses": [
                    {
                        "sense_id": "71bab687-3eab-3834-8529-84a5186f8b37",
                        "entry_id": "38b588ac-f003-30d9-b502-1637469b3471",
                        "glosses": [
                            "Unternehmen, das sich im Auftrag der Eigentümer um die Verwaltung von Häusern kümmert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6452a82e-b605-462e-9e0c-662e8703e093",
                                "sense_id": "71bab687-3eab-3834-8529-84a5186f8b37",
                                "text": "„Da lädt zum Beispiel ein Schreiben der Hausverwaltung offen zur Denunziation ein.“"
                            },
                            {
                                "example_id": "3909f3bb-fc59-40c9-b33d-58fbf3f758a2",
                                "sense_id": "71bab687-3eab-3834-8529-84a5186f8b37",
                                "text": "„Aber kurz bevor die Gerüste wieder abgebaut wurden, hatte sich mit einem Schreiben der Hausverwaltung herausgestellt, dass sie weder Laden noch Wohnung halten konnten.“"
                            }
                        ],
