                                "target_senses": [
                                    {
                                        "sense_id": "47bae874-9947-38ac-acce-1eae00d8a7ec",
                                        "entry_id": "cda18335-e68e-3688-a77d-a86bf83916c7",
                                        "glosses": [
                                            "A man who tends free-range cattle, especially in the American West."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b751b9a-0402-4445-8d14-837c5a32e859",
                                                "sense_id": "47bae874-9947-38ac-acce-1eae00d8a7ec",
                                                "text": "There was some laughter, and Roddle was left free to expand his ideas on the periodic visits of cowboys to the town. “Mason Rickets, he had ten big punkins a-sittin' in front of his store, an' them fellers from the Upside-down-F ranch shot 'em up […].”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68333827-f143-3f78-9071-7b6ef89a800b",
                                        "entry_id": "cda18335-e68e-3688-a77d-a86bf83916c7",
                                        "glosses": [
                                            "A man who identifies with cowboy culture, including wearing a cowboy hat and being a fan of country and western music."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d629a124-6816-3ef7-b17e-4b87a4934c4b",
                                        "entry_id": "cda18335-e68e-3688-a77d-a86bf83916c7",
                                        "glosses": [
                                            "A person who engages in reckless behavior, especially for the purpose of showing off."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
