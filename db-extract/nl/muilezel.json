                                ]
                            },
                            {
                                "target_word": "hinny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc22b080-15a8-397a-af2b-9dc45f067e55",
                                        "entry_id": "1bdcc141-8d59-38ff-9cc5-6cff14fe73ba",
                                        "glosses": [
                                            "A term of endearment usually for women."
                                        ],
                                        "tags": [
                                            "Geordie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1805306-f342-4f8c-950a-cc18d8884015",
                                                "sense_id": "dc22b080-15a8-397a-af2b-9dc45f067e55",
                                                "text": "`You will make a great diagnostician, nae doot, my hinny, but you need tae improve your bedside manner.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b088cfd-39a1-4fcc-8fd6-1de99628290a",
                        "source_entry_id": "e299d5fb-5ab9-333a-be9b-3585bdc47806",
                        "source_sense_id": "ee73cd9e-39af-3e7a-b114-3e11ae576139",
                        "source_sense_description": "een kruising van een paardenhengst en een ezelin",
                        "target_lang_word": "bardot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bardot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee65206a-eca4-3cd1-bc8b-7332735d6490",
                                        "entry_id": "56b7c336-8ce5-3e16-b6c7-cbe4ad713943",
                                        "glosses": [
                                            "Équidé hybride produit par l’accouplement d’un cheval et d’une ânesse. → voir mulet, cet hybride d’âne et de jument est plus fréquent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bf8c810-68b4-48ef-ab6f-916995f6dc9e",
                                                "sense_id": "ee65206a-eca4-3cd1-bc8b-7332735d6490",
                                                "text": "En général, le bardot est stérile, le mâle a cependant des érections et la femelle des chaleurs et il arrive -très rarement- que l’un des sexes soit fécond."
                                            },
                                            {
                                                "example_id": "d1b5ff66-a9b5-443c-80c5-07382fa0195d",
                                                "sense_id": "ee65206a-eca4-3cd1-bc8b-7332735d6490",
                                                "text": "Des voitures passaient, passaient toujours, lourdes charrettes, banneaux, carrioles coiffées de leurs bâches, tombereaux traînés par des bardots."
                                            },
                                            {
                                                "example_id": "3114298e-0596-42b2-a33d-114d371a3a3d",
                                                "sense_id": "ee65206a-eca4-3cd1-bc8b-7332735d6490",
                                                "text": "Vingt et un kilomètres, en 43, ça faisait un peu plus de cinq lieues et on ne se déplaçait qu’en blouse, en bottes et en bardot au pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bae60699-f7d6-3319-94a5-759f432acaea",
                                        "entry_id": "56b7c336-8ce5-3e16-b6c7-cbe4ad713943",
                                        "glosses": [
                                            "Mulet utilisé pour porter des charges (d'où son nom). L'équivalent pour un cheval se dit roncin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e17c4d76-977d-3033-9ff7-cedeaaddabde",
                                        "entry_id": "56b7c336-8ce5-3e16-b6c7-cbe4ad713943",
                                        "glosses": [
                                            "Mulet qui marche ordinairement à la tête des autres mulets et qui porte le muletier avec ses provisions et ses ustensiles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dc59b4a-1f4d-3888-b69d-8b8d07ec5708",
                                        "entry_id": "56b7c336-8ce5-3e16-b6c7-cbe4ad713943",
                                        "glosses": [
                                            "Synonyme de merlu commun (poisson)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50d427c8-93a2-301c-be52-1a6d1d1e5ae8",
                                        "entry_id": "56b7c336-8ce5-3e16-b6c7-cbe4ad713943",
                                        "glosses": [
                                            "Homme sur qui les autres se déchargent de leur tâche ou qu’ils prennent pour sujet de leurs plaisanteries."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab74f152-be0e-410f-9358-890a41162461",
                                                "sense_id": "50d427c8-93a2-301c-be52-1a6d1d1e5ae8",
                                                "text": "Ce domestique fait l’ouvrage de tous ses camarades, c’est le bardot de la maison."
                                            },
                                            {
                                                "example_id": "25bceafe-8a91-4f25-a247-84ed47a6a11f",
                                                "sense_id": "50d427c8-93a2-301c-be52-1a6d1d1e5ae8",
                                                "text": "C’est le bardot de la compagnie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef4d3815-50a2-43dc-aa5c-b11fb7ddb0a4",
                        "source_entry_id": "e299d5fb-5ab9-333a-be9b-3585bdc47806",
                        "source_sense_id": "ee73cd9e-39af-3e7a-b114-3e11ae576139",
                        "source_sense_description": "een kruising van een paardenhengst en een ezelin",
                        "target_lang_word": "лошак",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лошак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "90f9c05f-398a-31e9-b754-b9cdd9c0f856",
                                        "entry_id": "f12c3e24-90f2-3a90-b6ab-3c4569bbc7b5",
                                        "glosses": [
                                            "зоол. домашнее животное, гибрид жеребца и ослицы (Equus hinnus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811f0785-7c8e-46db-b41c-b451d3a756db",
                                                "sense_id": "90f9c05f-398a-31e9-b754-b9cdd9c0f856",
                                                "text": "Самка имеет влияние на стан: мул, который происходит от случки кобылы с ослом, бывает так же велик ростом, как и кобыла, а лошак, происходящий от жеребца и ослицы, бывает обыкновенно столь же мал, как и последняя…"
                                            },
                                            {
                                                "example_id": "be80211f-e749-44de-9fa6-0bfff9cf47a7",
                                                "sense_id": "90f9c05f-398a-31e9-b754-b9cdd9c0f856",
                                                "text": "Многовековой опыт мулопроизводства ясно доказывает, что от скрещивания жеребца с ослицей получается лошак, тогда как от скрещивания осла с лошадью получается мул."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bb95c5e-2276-3c75-ba8b-7583e3c0d651",
                                        "entry_id": "f12c3e24-90f2-3a90-b6ab-3c4569bbc7b5",
                                        "glosses": [
                                            "устар., зоол. то же, что мул; гибрид осла и кобылицы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36603b1c-7b1e-49da-aaa0-5f77e71181e9",
                                                "sense_id": "8bb95c5e-2276-3c75-ba8b-7583e3c0d651",
                                                "text": "Осёл мешается с кобылою и производит лошака; жеребец с ослихою ― меска; оба сии вновь не распложаются."
                                            },
                                            {
                                                "example_id": "163ff468-c888-473a-a753-eb62e38526ba",
                                                "sense_id": "8bb95c5e-2276-3c75-ba8b-7583e3c0d651",
                                                "text": "Лошак, растолстев от ячменю, прыгал, крича и говоря: отец мой — лошадь быстрая, и я совершенно похож на него. Однажды, когда случилась нужда бежать, он на бегу устал, и тотчас вспомнил, что отец его — осёл.",
                                                "translation": "Ημίονος, εκ κριθής παχυνθείς, ανεσκίρτησε βοών, και λέγων, πατήρ μου έστιν ίππος ο ταχυδρόμος, καγώ αυτώ όλος άφωμοιώθην. Και ποτε ανάγκης επελθούσης τρέχειν, επειδή του δρόμου επαύσατο, του πατρός όνου ευθέως υπεμνήσθη."
                                            },
                                            {
                                                "example_id": "7c43e3d9-b398-4872-93ec-dbde01d40258",
                                                "sense_id": "8bb95c5e-2276-3c75-ba8b-7583e3c0d651",
                                                "text": "А вот что я сделаю для вас: повремените немного, первый лошак от этой кобылы — ваш, решительно ваш, позвольте вас поздравить!"
                                            },
                                            {
                                                "example_id": "0b3c034d-bd4a-43f7-b5e1-7e0d81b366c7",
                                                "sense_id": "8bb95c5e-2276-3c75-ba8b-7583e3c0d651",
                                                "text": "Лоша́к м. полуконь, животное от осла и кобылы (осляк или мул — от жеребца и ослицы)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95155993-3c3b-3c8b-9339-e248bc4b8373",
                                        "entry_id": "f12c3e24-90f2-3a90-b6ab-3c4569bbc7b5",
                                        "glosses": [
                                            "рег. (смол., сев.-казахст.) то же, что лошадь"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17c9113e-0c2d-3795-9712-5966af124584",
                                        "entry_id": "f12c3e24-90f2-3a90-b6ab-3c4569bbc7b5",
                                        "glosses": [
                                            "рег. (самарск.) старый, но ещё пригодный для работы мерин"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "278dbd32-43f8-3a4b-ae1a-ddb012d8c1b4",
                                        "entry_id": "f12c3e24-90f2-3a90-b6ab-3c4569bbc7b5",
                                        "glosses": [
                                            "рег. (сиб., ю.-русск., центр.) жеребёнок возрастом от года, молодая лошадь до трёх-четырёх лет; рег. (кубанск.) молодой конь, ещё не ходивший в упряжке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd11becf-906b-412e-81cb-576ea78aa2f6",
                                                "sense_id": "278dbd32-43f8-3a4b-ae1a-ddb012d8c1b4",
                                                "text": "Каждого ж лошака обучить нужно."
                                            },
                                            {
                                                "example_id": "0e794592-8891-44f4-b66f-4c6c75b9a328",
                                                "sense_id": "278dbd32-43f8-3a4b-ae1a-ddb012d8c1b4",
                                                "text": "Лошак не работает: первый раз его запрягут, а он мудрует, сигает."
                                            },
                                            {
                                                "example_id": "98bf14c3-babc-4752-939a-6ca8a49cbf71",
                                                "sense_id": "278dbd32-43f8-3a4b-ae1a-ddb012d8c1b4",
                                                "text": "Стригун — до года, после года — лошак."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
