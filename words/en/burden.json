                            },
                            {
                                "target_lang_word": "要旨",
                                "target_lang_sense_clarification": "要点或核心内容"
                            },
                            {
                                "target_lang_word": "大意",
                                "target_lang_sense_clarification": "较概括地指主要内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "952346b8-72ac-3092-a3cd-e421fe80d82c",
                    "sense_definition": "The total amount of a specific harmful substance, organism, or disease present in a system or body.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "quantity_capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The treatment successfully reduced the viral <w>burden</w> in the patient's blood.",
                            "target_lang_translations": {
                                "ru": "Лечение успешно снизило вирусную <w>нагрузку</w> в крови пациента.",
                                "zh": "治疗成功降低了患者血液中的病毒<w>载量</w>。"
                            }
                        },
                        {
                            "text": "Researchers are studying the total body <w>burden</w> of environmental toxins.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучают общее <w>содержание</w> токсинов окружающей среды в организме.",
                                "zh": "研究人员正在研究人体内环境毒素的总体<w>负荷</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "load",
                        "count",
                        "level"
                    ],
                    "common_phrases": [
                        "tumor burden",
                        "viral burden",
                        "disease burden"
                    ],
                    "traits": [
