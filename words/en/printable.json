    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "496e45b0-9eb5-30a1-9848-a8dbcd689b68",
                    "sense_definition": "Capable of being printed or suitable for printing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "printing_capability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The website offers a <w>printable</w> version of the article for offline reading.",
                            "target_lang_translations": {
                                "ru": "Сайт предлагает версию статьи <w>для печати</w> для чтения в офлайн-режиме."
                            }
                        },
                        {
                            "text": "Please make sure the document is in a <w>printable</w> format before sending it to the office.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что документ находится в <w>печатном</w> формате, прежде чем отправлять его в офис."
                            }
                        }
                    ],
                    "synonyms": [
                        "printworthy"
                    ],
                    "antonyms": [
                        "unprintable"
                    ],
                    "common_phrases": [
                        "printable version",
                        "printable format",
                        "printable document"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный быть напечатанным или подходящий для печати."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "для печати",
                                "target_lang_sense_clarification": "предназначенный для вывода на принтер"
                            },
                            {
                                "target_lang_word": "печатный",
                                "target_lang_sense_clarification": "имеющий формат, пригодный для печати"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72c976a5-683f-3ce4-9206-04b585a12083",
                    "sense_definition": "Referring to a character that has a visual representation rather than being a control character.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_characters",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software filters out all non-standard symbols to ensure only <w>printable</w> characters remain.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение отфильтровывает все нестандартные символы, чтобы остались только <w>печатные</w> знаки."
                            }
                        },
                        {
                            "text": "A <w>printable</w> character is easily displayed on the screen or paper.",
                            "target_lang_translations": {
                                "ru": "<w>Печатный</w> символ легко отображается на экране или бумаге."
                            }
                        }
                    ],
                    "antonyms": [
                        "nonprintable"
                    ],
                    "common_phrases": [
                        "printable character",
                        "printable ASCII"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context in computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к символу, который имеет визуальное представление, а не является управляющим символом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "печатный",
                                "target_lang_sense_clarification": "о символах, отображаемых на экране или бумаге"
                            },
                            {
                                "target_lang_word": "отображаемый",
                                "target_lang_sense_clarification": "имеющий графическое представление"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed88b11b-b951-302f-93a9-10c212330b43",
                    "sense_definition": "A digital file or image designed to be downloaded and printed by the user.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digital_goods",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sells colorful <w>printables</w> for home organization on her personal blog.",
                            "target_lang_translations": {
                                "ru": "В своем личном блоге она продает красочные <w>материалы для печати</w> для организации домашнего быта."
                            }
                        },
                        {
                            "text": "This website offers a free <w>printable</w> for children to practice their handwriting.",
                            "target_lang_translations": {
                                "ru": "Этот сайт предлагает бесплатную <w>распечатку</w> для детей, чтобы они могли тренировать почерк."
                            }
                        }
                    ],
                    "common_phrases": [
                        "free printable",
                        "planner printable",
                        "digital printable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цифровой файл или изображение, предназначенное для скачивания и последующей печати пользователем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "материал для печати",
                                "target_lang_sense_clarification": "цифровой шаблон или файл"
                            },
                            {
                                "target_lang_word": "распечатка",
                                "target_lang_sense_clarification": "готовый к печати файл или форма"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}