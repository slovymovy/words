                "senses": [
                    {
                        "sense_id": "8a4e20b9-bfb7-396e-b849-756b472c626c",
                        "entry_id": "9ba112c9-ad8c-33af-b0ee-92e2f57bc319",
                        "glosses": [
                            "vielgestaltig; viele Erscheinungsformen oder Gestalten habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c65fc6b2-20af-47b8-9bae-7fdfa96ce819",
                                "sense_id": "8a4e20b9-bfb7-396e-b849-756b472c626c",
                                "text": "In his work Hawkins looks both critically and appreciatively at social, cultural and historical phenomena, mixing these with autobiographical motives to create a multiform body of work linked by countless internal references in ideas, material and style."
                            },
                            {
                                "example_id": "d98eed4c-60ff-4fc7-84f3-eb7f958bf2d7",
                                "sense_id": "8a4e20b9-bfb7-396e-b849-756b472c626c",
                                "text": "The third part describes the Guatemalan Garifuna migratory community in New York and analyses the multiform and dynamic relationships, they maintain with their sending society.",
                                "translation": "Im dritten Teil wird die garifuna Migrantengemeinde in New York vorgestellt und ihre vielförmigen und dynamischen Beziehungen, die sie zu ihrer guatemaltekischen Sendergesellschaft aufrechterhalten, analysiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "157ea654-4411-4558-8fc0-00e0881e0523",
                        "source_entry_id": "9ba112c9-ad8c-33af-b0ee-92e2f57bc319",
                        "source_sense_id": "8a4e20b9-bfb7-396e-b849-756b472c626c",
                        "source_sense_description": "vielgestaltig; viele Erscheinungsformen oder Gestalten habend",
                        "target_lang_word": "vielgestaltig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vielgestaltig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a77487a-f498-37ad-9d33-3883550eaa10",
                                        "entry_id": "c2bfbc1a-3061-3665-af94-ca87ccdeeccf",
                                        "glosses": [
                                            "von vielerlei, mehrerlei Gestalt, viele Formen annehmend oder angenommen habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84cbea12-a6cc-45d6-9c1a-cf7172de0124",
                                                "sense_id": "5a77487a-f498-37ad-9d33-3883550eaa10",
                                                "text": "Die Kirschpflaume ist recht vielgestaltig und ähnelt der Haferpflaume, auch Haferschlehe genannt."
                                            },
                                            {
                                                "example_id": "5bf21277-554a-4a67-a575-2c0428157100",
                                                "sense_id": "5a77487a-f498-37ad-9d33-3883550eaa10",
                                                "text": "„Als eines der vielgestaltigsten und artenreichsten deutschen Mittelgebirge im Dreiländereck Bayern, Hessen, Thüringen gilt die Rhön schon lange als Wanderparadies.“"
                                            },
                                            {
                                                "example_id": "578aed28-9f90-488a-8a85-9284e23a3ba2",
                                                "sense_id": "5a77487a-f498-37ad-9d33-3883550eaa10",
                                                "text": "„Musik- und Kunsttherapie sind Beispiele für die vielgestaltigen pädagogischen Initiativen, die auch in Verhaltenstherapien psychotisch Kranker zu erkennen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ae960f1-6347-4e67-b927-f34ad26e431e",
                        "source_entry_id": "9ba112c9-ad8c-33af-b0ee-92e2f57bc319",
                        "source_sense_id": "8a4e20b9-bfb7-396e-b849-756b472c626c",
                        "source_sense_description": "vielgestaltig; viele Erscheinungsformen oder Gestalten habend",
                        "target_lang_word": "multiforme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multiforme",
