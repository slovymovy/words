{
    "word_family": [
        "bewilder",
        "bewildered",
        "bewildering",
        "bewilderingly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4dc754cd-0e4c-3000-988a-c8f974bf30d3",
                    "sense_definition": "A feeling of complete confusion or perplexity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked around the unfamiliar room in utter <w>bewilderment</w>.",
                            "target_lang_translations": {
                                "de": "Sie blickte sich in völliger <w>Fassungslosigkeit</w> in dem fremden Zimmer um."
                            }
                        },
                        {
                            "text": "His sudden decision caused widespread <w>bewilderment</w> among his colleagues.",
                            "target_lang_translations": {
                                "de": "Seine plötzliche Entscheidung sorgte für weitverbreitete <w>Ratlosigkeit</w> unter seinen Kollegen."
                            }
                        }
                    ],
                    "synonyms": [
                        "confusion",
                        "perplexity",
                        "bafflement",
                        "puzzlement",
                        "mystification"
                    ],
                    "antonyms": [
                        "clarity",
                        "understanding",
                        "comprehension"
                    ],
                    "common_phrases": [
                        "in bewilderment",
                        "utter bewilderment",
                        "total bewilderment"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Zustand völliger Verwirrung, Ratlosigkeit oder Fassungslosigkeit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Fassungslosigkeit",
                                "target_lang_sense_clarification": "Zustand des Überwältigtseins von Verwirrung oder Bestürzung"
                            },
                            {
                                "target_lang_word": "Verwirrung",
                                "target_lang_sense_clarification": "Zustand fehlender Klarheit oder Orientierung"
                            },
                            {
                                "target_lang_word": "Ratlosigkeit",
                                "target_lang_sense_clarification": "Gefühl, nicht zu wissen, was man tun oder denken soll"
                            },
                            {
                                "target_lang_word": "Verblüfftheit",
                                "target_lang_sense_clarification": "Überraschtes Erstaunen und Konfusion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de21c16d-8acf-37d9-b664-f4f282da8258",
                    "sense_definition": "A confusing, complicated, or perplexing situation, tangle, or maze.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex contract presented a <w>bewilderment</w> of legal jargon that no one could untangle.",
                            "target_lang_translations": {
                                "de": "Der komplexe Vertrag bot ein <w>Dickicht</w> aus juristischem Fachjargon, das niemand entwirren konnte."
                            }
                        },
                        {
                            "text": "Visitors often found themselves lost in a <w>bewilderment</w> of narrow, winding alleys.",
                            "target_lang_translations": {
                                "de": "Besucher verirrten sich oft in einem <w>Gewirr</w> aus engen, verwinkelten Gassen."
                            }
                        }
                    ],
                    "synonyms": [
                        "labyrinth",
                        "maze",
                        "tangle"
                    ],
                    "common_phrases": [
                        "bewilderment of"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine unübersichtliche, komplizierte Lage, ein Gewirr oder ein Labyrinth."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gewirr",
                                "target_lang_sense_clarification": "Unübersichtliches Durcheinander von Dingen oder Wegen"
                            },
                            {
                                "target_lang_word": "Dickicht",
                                "target_lang_sense_clarification": "Metaphorisch für eine schwer durchdringbare Ansammlung"
                            },
                            {
                                "target_lang_word": "Wirrwarr",
                                "target_lang_sense_clarification": "Völliges Durcheinander"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}