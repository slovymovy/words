                "senses": [
                    {
                        "sense_id": "c44254f4-d8d4-314b-bb61-d5757fb70ada",
                        "entry_id": "ed164a3b-c615-354a-bed2-c6d25f74b844",
                        "glosses": [
                            "Salir de matière fécale."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0bccad22-eaec-4481-b766-28266f5c9762",
                                "sense_id": "c44254f4-d8d4-314b-bb61-d5757fb70ada",
                                "text": "Les spectateurs se sont livrés à des convulsions d’un fou rire qui les oblige à embrenner leurs culottes."
                            },
                            {
                                "example_id": "d8c7efec-4128-4dea-b8e0-9485793833bd",
                                "sense_id": "c44254f4-d8d4-314b-bb61-d5757fb70ada",
                                "text": "Et Pierre était si blanc de terreur qu’on eût cru qu’il allait embrenner de peur ses haillons d’apôtre, et que les hommes le prirent en pitié et le tinrent pour fou."
                            },
                            {
                                "example_id": "3d882ceb-6f37-49b5-b974-539baf6eb9df",
                                "sense_id": "c44254f4-d8d4-314b-bb61-d5757fb70ada",
                                "text": "Vous allez être embrenné jusqu’à la racine des cheveux, Castellano !"
                            }
                        ]
                    }
