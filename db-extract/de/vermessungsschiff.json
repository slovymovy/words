                "senses": [
                    {
                        "sense_id": "71e1e0b2-927d-3cdf-ad64-851bf04d575e",
                        "entry_id": "5609828a-f517-3ae4-bdd9-60359e5d7f4e",
                        "glosses": [
                            "Schiff, das für Vermessungen (von Gewässern) genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97699323-3107-4b16-913b-bade8a75a2a6",
                                "sense_id": "71e1e0b2-927d-3cdf-ad64-851bf04d575e",
                                "text": "„Das russische Vermessungsschiff „Witjas“ lotete als tiefste Stellen im Kermadecgraben –10 047 m und im Tongagraben –10 882 m (Witjastiefen).“"
                            },
                            {
                                "example_id": "d7405d8e-768c-4425-b36b-4c51dfaa8419",
                                "sense_id": "71e1e0b2-927d-3cdf-ad64-851bf04d575e",
                                "text": "„1831–36 unternahm er als naturwissenschaftlicher Begleiter auf dem Vermessungsschiff „Beagle“ eine Weltreise, auf der ihm vor allem seine Beobachtungen der Vogelwelt auf den Galápagosinseln zu seinen Einsichten über den Ursprung der Arten verhalfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
