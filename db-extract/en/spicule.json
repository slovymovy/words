                "translations": [
                    {
                        "translation_id": "ab5be590-5132-4b29-af03-4b5ad5ade224",
                        "source_entry_id": "bb9632bf-2ac9-3e68-aa78-0fbe29f95671",
                        "source_sense_description": "sharp, needle-like piece",
                        "target_lang_word": "Nadel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nadel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6770208e-482c-3eaa-b9ef-1757890c10fa",
                                        "entry_id": "5e7f607f-dafe-314a-b198-0242660037fb",
                                        "glosses": [
                                            "längliches, dünnes Werkzeug mit Spitze, je nach Verwendungszweck unterschiedlich geformt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4cba7f-c0bf-4700-8002-3c2a4a9df7fd",
                                                "sense_id": "6770208e-482c-3eaa-b9ef-1757890c10fa",
                                                "text": "Der Schneider führt eine flinke Nadel."
                                            },
                                            {
                                                "example_id": "2ce7e36e-731d-4400-bc03-fe031704f767",
                                                "sense_id": "6770208e-482c-3eaa-b9ef-1757890c10fa",
                                                "text": "„Mr. Mullins und Josey und Doktor Smoaks mußten sich alle drei auf sie setzen und sie festhalten, während er mit der Nadel zustach und ihr das Betäubungsmittel einspritzte.“"
                                            },
                                            {
                                                "example_id": "8e4f4b28-6fde-43a8-93ea-358dca2226d8",
                                                "sense_id": "6770208e-482c-3eaa-b9ef-1757890c10fa",
                                                "text": "„Andere hockten auf dem Boden, man sah, wie sie Zwirn in die Nadeln zu fädeln meinten und Stich um Stich an einem Wäschestück nähten, das nicht vorhanden war.“"
                                            },
                                            {
                                                "example_id": "1eaa0bc0-f04d-4e35-9add-95f80978d63c",
                                                "sense_id": "6770208e-482c-3eaa-b9ef-1757890c10fa",
                                                "text": "„Der erste Moment, wenn man die Nadel aufsetzt, ist wie das Luftholen der Sängerin vor dem ersten Ton, wie das Ansetzen der Trompter, bevor sie die Lippen um ihr Mundstück schließen, wie die Ruhe vor dem Sturm.“"
                                            },
                                            {
                                                "example_id": "679c156c-676f-46bc-8dd2-51be366a61b9",
                                                "sense_id": "6770208e-482c-3eaa-b9ef-1757890c10fa",
                                                "text": "„Dann holte sie ein kleines Nadelkissen hervor und begann, an allerlei Stellen in der Hose Nadeln anzubringen, sie arbeitete zielstrebig und konzentriert, deshalb musste ich still stehen, wenn ich nicht gestochen werden wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9781a717-cd4c-3c4b-bb45-85a4aeb6e635",
                                        "entry_id": "5e7f607f-dafe-314a-b198-0242660037fb",
                                        "glosses": [
                                            "das nadelförmig umgebildete Blatt des Nadelbaums"
                                        ],
                                        "tags": [
                                            "plural",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6feab9c-a5c4-4838-aea8-3bf82da65bf7",
                                                "sense_id": "9781a717-cd4c-3c4b-bb45-85a4aeb6e635",
                                                "text": "Unser Tannenbaum hatte an Neujahr schon alle Nadeln verloren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "529622a7-bae0-3a18-aa4c-ba2ec2d29132",
                                        "entry_id": "5e7f607f-dafe-314a-b198-0242660037fb",
                                        "glosses": [
                                            "dünner Draht mit einem Diamanten an der Spitze, der die Rille einer Schallplatte mit Hilfe von Verstärkern in Schall wandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ffcf9fd-2c08-47df-a091-2d9b787bf135",
                                                "sense_id": "529622a7-bae0-3a18-aa4c-ba2ec2d29132",
                                                "text": "Die Nadel des Tonabnehmers tastet die Platte ab."
                                            },
                                            {
                                                "example_id": "62b2247c-b009-4f27-8b2f-2556c033ea50",
                                                "sense_id": "529622a7-bae0-3a18-aa4c-ba2ec2d29132",
                                                "text": "\"Du darfst die Nadel nur vorsichtig auf die Platte aufsetzen, sie ist empfindlich!\""
                                            },
                                            {
                                                "example_id": "3d15c818-0cb3-49b0-9fe5-44a638b41d2d",
                                                "sense_id": "529622a7-bae0-3a18-aa4c-ba2ec2d29132",
                                                "text": "Beim Plattenspieler tastet eine […] Nadel oder seit den 1990er Jahren auch ein Laser (Laserplattenspieler) die Rille der Schallplatte ab."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
