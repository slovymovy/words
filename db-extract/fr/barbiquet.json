                                        "sense_id": "6bb86089-43aa-3c51-b5b6-63d973a91816",
                                        "entry_id": "d0e15767-254b-322b-8b6f-bed983bfbe57",
                                        "glosses": [
                                            "Clipping of knight banneret, a knight entitled to subinfeudate his estate and to lead men in battle under his own banner."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b396838c-f6ba-3306-9ae0-72334456bc9b",
                                        "entry_id": "d0e15767-254b-322b-8b6f-bed983bfbe57",
                                        "glosses": [
                                            "A small banner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc6c39eb-f518-493c-bca2-55dd97d3ba4e",
                                                "sense_id": "b396838c-f6ba-3306-9ae0-72334456bc9b",
                                                "text": "[…] yet the scarfs and the bannerets about thee did manifoldly dissuade me from believing thee a vessel of too great a burthen."
                                            },
                                            {
                                                "example_id": "31da9573-3db7-4210-963a-1ab3b7c56561",
                                                "sense_id": "b396838c-f6ba-3306-9ae0-72334456bc9b",
                                                "text": "His armor and his horse were black; there was no device on his shield and no banneret on his spear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b0ab1ff-aa91-374a-931c-96c7e44dc085",
                                        "entry_id": "d0e15767-254b-322b-8b6f-bed983bfbe57",
                                        "glosses": [
                                            "A proposed but unadopted senior commissioned rank of the Royal Air Force equivalent to group captain."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c0a33bc-1cda-4c42-a44d-dd9bda21a7b8",
                                                "sense_id": "8b0ab1ff-aa91-374a-931c-96c7e44dc085",
                                                "text": "A list of new titles was manufactured as follows: Ensign, Lieutenant, Flight-Leader, Squadron-Leader, Reeve, Banneret, Fourth-Ardian, Third-Ardian, Second-Ardian, Ardian, Air Marshal. […O]ne may regret “Banneret”, which has a flavour and associations, more especially as the leader of a formation in the air went into battle flying a streamer which formed a rallying mark as did the banner of the knight for his vassals."
                                            }
                                        ]
                                    },
