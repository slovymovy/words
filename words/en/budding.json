{
    "word_family": [
        "bud",
        "budlet"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2888d795-8bc7-3c98-88d1-4b3034df3f2c",
                    "sense_definition": "Beginning to develop or show promise in a particular field or role.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local community center offers music classes for every <w>budding</w> artist in the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Местный общественный центр предлагает уроки музыки для каждого <w>начинающего</w> художника или музыканта в округе."
                            }
                        },
                        {
                            "text": "The experienced engineer spent hours patiently mentoring the <w>budding</w> apprentice.",
                            "target_lang_translations": {
                                "ru": "Опытный инженер часами терпеливо обучал <w>подающего надежды</w> стажера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "budding artist",
                        "budding writer",
                        "budding romance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинающий развиваться или подающий надежды в определенной сфере или роли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подающий надежды",
                                "target_lang_sense_clarification": "о человеке, проявляющем потенциал"
                            },
                            {
                                "target_lang_word": "начинающий",
                                "target_lang_sense_clarification": "делающий первые шаги в профессии или искусстве"
                            },
                            {
                                "target_lang_word": "зарождающийся",
                                "target_lang_sense_clarification": "находящийся в начальной стадии развития (о чувствах, отношениях)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31446122-c948-33e5-a600-448dc9cfa4f7",
                    "sense_definition": "Present participle of <w>bud</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "botany_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rose bushes are finally <w>budding</w> after the long and cold winter.",
                            "target_lang_translations": {
                                "ru": "Кусты роз наконец-то <w>пускают почки</w> после долгой и холодной зимы."
                            }
                        },
                        {
                            "text": "New green leaves were <w>budding</w> along the branches in early spring.",
                            "target_lang_translations": {
                                "ru": "Ранней весной вдоль ветвей <w>распускались</w> новые зеленые листочки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола «bud»; пускающий почки, распускающийся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пускающий почки",
                                "target_lang_sense_clarification": "о растении, формирующем почки"
                            },
                            {
                                "target_lang_word": "распускающийся",
                                "target_lang_sense_clarification": "начинающий раскрывать почки или бутоны"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3bf2afff-faca-3ee2-88f9-ed8f0b81e984",
                    "sense_definition": "The natural development or appearance of buds on a plant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gardeners eagerly watch for the early <w>budding</w> of fruit trees in April.",
                            "target_lang_translations": {
                                "ru": "Садоводы с нетерпением ждут раннего <w>распускания почек</w> на плодовых деревьях в апреле."
                            }
                        },
                        {
                            "text": "Warm temperatures caused the premature <w>budding</w> of several delicate shrubs.",
                            "target_lang_translations": {
                                "ru": "Теплая температура вызвала преждевременное <w>почкование</w> нескольких чувствительных кустарников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "early budding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественный процесс появления или развития почек у растений; распускание почек или бутонизация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почкование",
                                "target_lang_sense_clarification": "появление и развитие почек"
                            },
                            {
                                "target_lang_word": "распускание почек",
                                "target_lang_sense_clarification": "процесс раскрытия почек"
                            },
                            {
                                "target_lang_word": "бутонизация",
                                "target_lang_sense_clarification": "образование бутонов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b789336-47c0-39a6-bdd9-d4b8f75578a1",
                    "sense_definition": "A horticultural grafting technique where a single bud from a scion is united with rootstock.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "horticulture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Commercial fruit growers often propagate apple varieties through skillful <w>budding</w>.",
                            "target_lang_translations": {
                                "ru": "Промышленные садоводы часто размножают сорта яблонь с помощью умелой <w>окулировки</w>."
                            }
                        },
                        {
                            "text": "The orchard manager explained how <w>budding</w> allows trees to withstand harsher soil conditions.",
                            "target_lang_translations": {
                                "ru": "Управляющий садом объяснил, как <w>прививка глазком</w> позволяет деревьям переносить более суровые почвенные условия."
                            }
                        }
                    ],
                    "synonyms": [
                        "bud grafting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ прививки растений одиночной почкой (глазком); окулировка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окулировка",
                                "target_lang_sense_clarification": "прививка растений глазком (почкой)"
                            },
                            {
                                "target_lang_word": "прививка глазком",
                                "target_lang_sense_clarification": "агротехнический способ прививки почкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e31f87bc-502b-35e5-ad88-32c2fb235e57",
                    "sense_definition": "A plant or stem produced through the practice of bud grafting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "horticulture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These young <w>buddings</w> need careful protection from strong winds and pests.",
                            "target_lang_translations": {
                                "ru": "Эти молодые <w>окулянты</w> нуждаются в тщательной защите от сильных ветров и вредителей."
                            }
                        },
                        {
                            "text": "The researcher monitored several distinct <w>buddings</w> to assess their growth rate.",
                            "target_lang_translations": {
                                "ru": "Исследователь наблюдал за несколькими различными <w>привитыми саженцами</w>, чтобы оценить скорость их роста."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Растение или побег, полученный в результате окулировки (прививки почкой)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окулянт",
                                "target_lang_sense_clarification": "растение или побег, развившийся из привитой почки"
                            },
                            {
                                "target_lang_word": "привитой побег",
                                "target_lang_sense_clarification": "побег, выросший из привитой почки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}