                                "target_senses": [
                                    {
                                        "sense_id": "dd00d7ba-e12b-378c-abcd-e0563664d659",
                                        "entry_id": "6be40896-09ca-3c59-901a-aae43a308ab7",
                                        "glosses": [
                                            "A country in West Africa, situated to the north of Nigeria. Official name: Republic of the Niger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72acc25e-1bc4-4742-bbd8-e0ae4771410e",
                                                "sense_id": "dd00d7ba-e12b-378c-abcd-e0563664d659",
                                                "text": "An American aid worker who was kidnapped in Niger more than six years ago and held hostage by terrorists has been released, President Joe Biden’s national security adviser Jake Sullivan tweeted on Monday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49becc4d-3d40-3ba0-b84f-c6619902e167",
                                        "entry_id": "6be40896-09ca-3c59-901a-aae43a308ab7",
                                        "glosses": [
                                            "A major river in West Africa that flows into the Gulf of Guinea in Nigeria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688f77a3-ef36-408c-a020-f9abb2679c63",
                                                "sense_id": "49becc4d-3d40-3ba0-b84f-c6619902e167",
                                                "text": "From here we can see the River Niger in the distance running across town, a long gleaming diamond in the horizon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f022e02-e195-3149-bb55-fcb20056ea9d",
                                        "entry_id": "6be40896-09ca-3c59-901a-aae43a308ab7",
                                        "glosses": [
                                            "A state of Nigeria in the North Central geopolitical zone. Capital and largest city: Minna."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dfc1fc4-8aef-44cc-995a-a37a1826eda5",
                                                "sense_id": "1f022e02-e195-3149-bb55-fcb20056ea9d",
                                                "text": "Gunshots rang out in the capital Abuja and also in the neighboring Niger state as police lobbed tear gas to disperse defiant protesters. In Niger, at least six people are now feared dead, local media reported."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
