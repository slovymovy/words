                                    {
                                        "sense_id": "fd1030d1-21d1-3436-a6a8-bd8b3b9d9875",
                                        "entry_id": "442a2669-3efd-3d0d-a859-a355b8208c3b",
                                        "glosses": [
                                            "Handlung, jemanden oder mehrere Personen vertretungsweise zu einer bestimmten Veranstaltung zu schicken"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c21aa421-b316-3b0b-a16c-03bb3aeaad6b",
                                        "entry_id": "442a2669-3efd-3d0d-a859-a355b8208c3b",
                                        "glosses": [
                                            "Gruppe von Personen, die von [1] betroffen sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48d802d4-6f84-4802-b583-115aaf570007",
                                                "sense_id": "c21aa421-b316-3b0b-a16c-03bb3aeaad6b",
                                                "text": "„Doch die Fahrzeuge der Delegation, immerhin zwei Kleinbusse und mehrere Geländewagen, blieben nicht alle trocken.“"
                                            },
                                            {
                                                "example_id": "f4118219-6825-4a2f-96d4-638a24c8f912",
                                                "sense_id": "c21aa421-b316-3b0b-a16c-03bb3aeaad6b",
                                                "text": "„Früh startete die Delegation aus Wirtschaftsbossen, Journalisten und Kulturgästen in Anoraks die Wanderung.“"
                                            },
                                            {
                                                "example_id": "6b9d9ffd-0e14-4ca7-b3ed-66e7a08def8e",
                                                "sense_id": "c21aa421-b316-3b0b-a16c-03bb3aeaad6b",
                                                "text": "„Es gibt auch Berichte von Delegationen aus der Provinz, die in Paris ihren Senator besucht haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4d2f11db-4b2e-3444-b3db-837ab17f3588",
                                        "entry_id": "442a2669-3efd-3d0d-a859-a355b8208c3b",
                                        "glosses": [
                                            "Übertragung von etwas (Leistung, Rechte, …)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
