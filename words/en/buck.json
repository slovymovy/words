{
    "word_family": [
        "buckshot",
        "buckskin",
        "sawbuck",
        "bucktooth"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16bc55ff-9909-3ce2-b1c6-63d2645e6056",
                    "sense_definition": "A dollar or a sum of money.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "money_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you lend me a few <w>bucks</w> until I get paid?",
                            "target_lang_translations": {
                                "ru": "Ты можешь одолжить мне пару <w>баксов</w>, пока я не получу зарплату?",
                                "zh": "你能借我几<w>美元</w>等我发工资吗？"
                            }
                        },
                        {
                            "text": "He managed to make a quick <w>buck</w> by selling his old comics.",
                            "target_lang_translations": {
                                "ru": "Ему удалось быстро срубить <w>бабла</w>, продав свои старые комиксы.",
                                "zh": "他通过卖掉旧漫画书赚了点快<w>钱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dollar",
                        "greenback"
                    ],
                    "common_phrases": [
                        "make a buck",
                        "big bucks",
                        "fast buck"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common in US English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Доллар или сумма денег (разговорное).",
                        "zh": "美元或一笔钱（口语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бакс",
                                "target_lang_sense_clarification": "разг. доллар"
                            },
                            {
                                "target_lang_word": "зелёный",
                                "target_lang_sense_clarification": "разг. доллар"
                            },
                            {
                                "target_lang_word": "капуста",
                                "target_lang_sense_clarification": "жарг. деньги"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美元",
                                "target_lang_sense_clarification": "口语中指代美元"
                            },
                            {
                                "target_lang_word": "钱",
                                "target_lang_sense_clarification": "口语中指代钱财"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc5682dd-c7ac-32f3-b6db-f544e04e9621",
                    "sense_definition": "A male animal, especially a deer, antelope, rabbit, or hare.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "animal_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter spotted a large <w>buck</w> standing at the edge of the forest.",
                            "target_lang_translations": {
                                "ru": "Охотник заметил крупного <w>самца</w>, стоящего на опушке леса.",
                                "zh": "猎人发现森林边缘站着一只大<w>雄鹿</w>。"
                            }
                        },
                        {
                            "text": "A male rabbit is commonly referred to as a <w>buck</w>.",
                            "target_lang_translations": {
                                "ru": "Самца кролика обычно называют <w>самцом</w>.",
                                "zh": "雄性兔子通常被称为<w>公兔</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stag"
                    ],
                    "antonyms": [
                        "doe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самец животного, особенно оленя, антилопы, кролика или зайца.",
                        "zh": "雄性动物，尤指雄鹿、羚羊、兔或野兔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самец",
                                "target_lang_sense_clarification": "животного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雄性",
                                "target_lang_sense_clarification": "指雄性动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7a2bac5-d0e3-334a-9cf1-ebaad8606942",
                    "sense_definition": "Responsibility or blame for a situation, often used in the context of avoiding it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "responsibility_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager tried to pass the <w>buck</w> when the project failed.",
                            "target_lang_translations": {
                                "ru": "Менеджер попытался свалить <w>ответственность</w> на других, когда проект провалился.",
                                "zh": "项目失败时，经理试图推卸<w>责任</w>。"
                            }
                        },
                        {
                            "text": "As the leader of this team, the <w>buck</w> stops here with me.",
                            "target_lang_translations": {
                                "ru": "Как на лидере этой команды, вся <w>ответственность</w> лежит на мне.",
                                "zh": "作为团队领导，最终的<w>责任</w>由我承担。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pass the buck",
                        "the buck stops here"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ответственность или вина за ситуацию, часто используется в контексте избегания её.",
                        "zh": "对某种情况的责任或过失，常用于推卸责任的语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ответственность",
                                "target_lang_sense_clarification": "вина/ответственность; pass the buck — переложить ответственность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "责任",
                                "target_lang_sense_clarification": "指承担的责任或过失"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4b74bdc-e135-302d-b10a-d0ce1a6297d0",
                    "sense_definition": "A fashionable, dashing, or high-spirited young man.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his youth, he was known as quite a dashing young <w>buck</w>.",
                            "target_lang_translations": {
                                "ru": "В юности он слыл довольно лихим молодым <w>щёголем</w>.",
                                "zh": "年轻时，他是个相当潇洒的<w>小伙子</w>。"
                            }
                        },
                        {
                            "text": "The old man told stories of when he was a wild <w>buck</w> in the city.",
                            "target_lang_translations": {
                                "ru": "Старик рассказывал истории о том, каким он был диким <w>гулякой</w> в городе.",
                                "zh": "老人讲述了他年轻时在城里当<w>浪子</w>的故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dandy",
                        "fop"
                    ],
                    "common_phrases": [
                        "young buck"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Модный, щеголеватый или энергичный молодой человек (устаревшее).",
                        "zh": "时髦、潇洒或精力充沛的年轻人（旧用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щёголь",
                                "target_lang_sense_clarification": "франт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "花花公子",
                                "target_lang_sense_clarification": "指时髦的年轻人"
                            },
                            {
                                "target_lang_word": "浪子",
                                "target_lang_sense_clarification": "指放荡不羁的年轻人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d0130b3d-a0bb-3d35-aacf-f857ee1a6032",
                    "sense_definition": "To oppose or resist something, such as a trend, system, or authority.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "resist_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company managed to <w>buck</w> the trend of falling sales this quarter.",
                            "target_lang_translations": {
                                "ru": "Компании удалось <w>переломить</w> тенденцию падения продаж в этом квартале.",
                                "zh": "公司本季度成功<w>抵制</w>了销售额下滑的趋势。"
                            }
                        },
                        {
                            "text": "He decided to <w>buck</w> the system and run as an independent candidate.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>пойти против</w> системы и баллотироваться как независимый кандидат.",
                                "zh": "他决定<w>反抗</w>体制，以独立候选人身份参选。"
                            }
                        }
                    ],
                    "synonyms": [
                        "resist",
                        "oppose"
                    ],
                    "common_phrases": [
                        "buck the trend",
                        "buck the system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Противиться или сопротивляться чему-либо, например, тенденции, системе или власти.",
                        "zh": "反对或抵制某事，如趋势、制度或权威。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопротивляться",
                                "target_lang_sense_clarification": "противодействовать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抵制",
                                "target_lang_sense_clarification": "指反抗或不服从"
                            },
                            {
                                "target_lang_word": "违背",
                                "target_lang_sense_clarification": "指不顺应趋势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81bdaced-e40c-3a5a-9bd8-06163bbccb6e",
                    "sense_definition": "To jump vertically with an arched back and stiff legs, typically to throw a rider (used of horses and other animals).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wild horse began to <w>buck</w> as soon as the saddle was put on.",
                            "target_lang_translations": {
                                "ru": "Дикая лошадь начала <w>брыкаться</w>, как только на нее надели седло.",
                                "zh": "野马一被套上马鞍就开始<w>尥蹶子</w>。"
                            }
                        },
                        {
                            "text": "Hold on tight if the mule starts to <w>buck</w>.",
                            "target_lang_translations": {
                                "ru": "Держись крепче, если мул начнет <w>брыкаться</w>.",
                                "zh": "如果骡子开始<w>尥蹶子</w>，抓紧了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "buck off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подпрыгивать, выгнув спину и выпрямив ноги (о лошадях и других животных).",
                        "zh": "（马等动物）拱起背部并伸直腿垂直跳起，通常是为了把骑手摔下来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брыкаться",
                                "target_lang_sense_clarification": "о лошади: вскидывать круп, чтобы сбросить седока"
                            },
                            {
                                "target_lang_word": "взбрыкивать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尥蹶子",
                                "target_lang_sense_clarification": "指马等动物后腿向后踢或跳跃"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59979968-c469-33ea-95af-5daa0dcd5590",
                    "sense_definition": "To saw a felled tree into shorter logs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "forestry_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>buck</w> these fallen trees for firewood before winter.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>распилить</w> эти поваленные деревья на дрова до зимы.",
                                "zh": "冬天前我们需要把这些倒下的树<w>锯断</w>当柴烧。"
                            }
                        },
                        {
                            "text": "The loggers spent the day <w>bucking</w> the timber into manageable lengths.",
                            "target_lang_translations": {
                                "ru": "Лесорубы провели день, <w>распиливая</w> бревна на удобные отрезки.",
                                "zh": "伐木工花了一整天把木材<w>锯成</w>便于搬运的长度。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context (forestry)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распиливать поваленное дерево на более короткие бревна.",
                        "zh": "将倒下的树锯成较短的圆木。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распиливать на брёвна",
                                "target_lang_sense_clarification": "пилить поваленное дерево на короткие брёвна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锯断",
                                "target_lang_sense_clarification": "指将树木锯成段"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2e51ce42-9380-3df4-ab39-447ee85408e1",
                    "sense_definition": "An English or German surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Buck</w> voted against the new proposal.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бак</w> проголосовал против нового предложения.",
                                "zh": "<w>巴克</w>先生投票反对这项新提案。"
                            }
                        },
                        {
                            "text": "The famous author Pearl S. <w>Buck</w> wrote about life in China.",
                            "target_lang_translations": {
                                "ru": "Знаменитая писательница Перл С. <w>Бак</w> писала о жизни в Китае.",
                                "zh": "著名作家赛珍珠（珀尔·<w>巴克</w>）描写了中国的生活。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская или немецкая фамилия.",
                        "zh": "英语或德语姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бак",
                                "target_lang_sense_clarification": "английская или немецкая фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巴克",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d0e4807-dfc9-358f-8981-658d2689ef30",
                    "sense_definition": "A male given name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My uncle <w>Buck</w> is coming to visit us this weekend.",
                            "target_lang_translations": {
                                "ru": "Мой дядя <w>Бак</w> приедет навестить нас в эти выходные.",
                                "zh": "我叔叔<w>巴克</w>这个周末要来看我们。"
                            }
                        },
                        {
                            "text": "<w>Buck</w> Owens was a famous country music singer.",
                            "target_lang_translations": {
                                "ru": "<w>Бак</w> Оуэнс был известным певцом кантри.",
                                "zh": "<w>巴克</w>·欧文斯是一位著名的乡村音乐歌手。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя.",
                        "zh": "男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бак",
                                "target_lang_sense_clarification": "мужское имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巴克",
                                "target_lang_sense_clarification": "名字音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f584f6a-5079-34eb-ab98-b81781d2d6fc",
                    "sense_definition": "A place name for various townships and communities in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_group",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They live in a small community called <w>Buck</w> in Pennsylvania.",
                            "target_lang_translations": {
                                "ru": "Они живут в небольшом поселке под названием <w>Бак</w> в Пенсильвании.",
                                "zh": "他们住在宾夕法尼亚州一个叫<w>巴克</w>的小社区里。"
                            }
                        },
                        {
                            "text": "The road leads directly to <w>Buck</w> Township.",
                            "target_lang_translations": {
                                "ru": "Дорога ведет прямо к тауншипу <w>Бак</w>.",
                                "zh": "这条路直通<w>巴克</w>镇。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название различных поселков и общин в США.",
                        "zh": "美国各种乡镇和社区的地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бак",
                                "target_lang_sense_clarification": "топоним в США"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巴克",
                                "target_lang_sense_clarification": "地名音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}