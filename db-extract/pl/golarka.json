                ],
                "senses": [
                    {
                        "sense_id": "abd3a4de-d0f5-3825-9134-59a26e1a191e",
                        "entry_id": "9fb913af-9359-3717-acd0-2cea40b7bb2e",
                        "glosses": [
                            "urządzenie elektryczne służące do golenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1690b316-0c67-445c-a4a4-767e24c21391",
                                "sense_id": "abd3a4de-d0f5-3825-9134-59a26e1a191e",
                                "text": "Zbyt długie włoski przy kontakcie z golarką zostaną przez nią wciągnięte, co skończy się bolesnym doświadczeniem i podrażnioną skórą po wyrwaniu włosków."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a4d7391e-d955-3853-a49e-3afc8eaf9f1e",
                        "entry_id": "9fb913af-9359-3717-acd0-2cea40b7bb2e",
                        "glosses": [
                            "urządzenie elektryczne służące do oczyszczania ubrań ze zmechaceń"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12e46d51-699b-4d9d-ab43-13deb3feb3c7",
                                "sense_id": "a4d7391e-d955-3853-a49e-3afc8eaf9f1e",
                                "text": "Użyłam golarki do odzieży, by oczyścić obicie fotela."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4eee3ca-643a-47a3-abef-45274638fec7",
                        "source_entry_id": "9fb913af-9359-3717-acd0-2cea40b7bb2e",
                        "source_sense_id": "abd3a4de-d0f5-3825-9134-59a26e1a191e",
                        "target_lang_word": "shaver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shaver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "254a451a-8de1-3614-b27e-812f6dd6a197",
                                        "entry_id": "17eeef03-c696-326f-b4ff-0abcf814ce79",
                                        "glosses": [
                                            "One who shaves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b104c09-fb64-3128-a444-27888bedf844",
                                        "entry_id": "17eeef03-c696-326f-b4ff-0abcf814ce79",
                                        "glosses": [
                                            "A barber, one whose occupation is to shave."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25dd0a4c-abd4-3d36-b144-c3e78ec5c899",
                                        "entry_id": "17eeef03-c696-326f-b4ff-0abcf814ce79",
                                        "glosses": [
                                            "A tool or machine for shaving; an electric razor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d257f7d-8f22-374a-bb2c-19761fd7763e",
                                        "entry_id": "17eeef03-c696-326f-b4ff-0abcf814ce79",
                                        "glosses": [
                                            "An extortionate bargainer; a sharper."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4885be-49f0-4064-8278-435e0440eb69",
                                                "sense_id": "9d257f7d-8f22-374a-bb2c-19761fd7763e",
                                                "text": "The shaver is an honest friendly man as before: he has a good deal to do to smother his Welsh fire, which, you know, he has in a greater degree than some would imagine. He posts himself a good part of the year in some warm house, wins the ladies money at ombre, and convinces them, that they are highly obliged to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3628186c-3fd7-3cf4-83e0-0b15474d441d",
                                        "entry_id": "17eeef03-c696-326f-b4ff-0abcf814ce79",
                                        "glosses": [
                                            "One who fleeces; a pillager; a plunderer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03930768-2155-4f97-a00f-9888064c3c98",
                                                "sense_id": "3628186c-3fd7-3cf4-83e0-0b15474d441d",
                                                "text": "By these shavers the Turks were stripped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "976cd411-46a1-33d4-8c0e-70b287235992",
                                        "entry_id": "17eeef03-c696-326f-b4ff-0abcf814ce79",
                                        "glosses": [
                                            "A boy; a lad; a little fellow."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b61d0ebe-7e97-45f5-8409-6087aa64f623",
                                                "sense_id": "976cd411-46a1-33d4-8c0e-70b287235992",
                                                "text": "\"Excuse me, ladies and gentlemen,\" said the sergeant, \"but as I have mentioned at the door to this young shaver\" (which he hadn't), \"I am on a chase in the name of the King, and I want the blacksmith.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eea426ce-b0df-4348-9434-4d4331fc38dc",
                        "source_entry_id": "9fb913af-9359-3717-acd0-2cea40b7bb2e",
                        "source_sense_id": "abd3a4de-d0f5-3825-9134-59a26e1a191e",
                        "target_lang_word": "holicí strojek",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3ebc98ec-b3c9-4e7c-831a-96cc4d4cbfa0",
                        "source_entry_id": "9fb913af-9359-3717-acd0-2cea40b7bb2e",
                        "source_sense_id": "abd3a4de-d0f5-3825-9134-59a26e1a191e",
                        "target_lang_word": "rasoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rasoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4cdf86-a0d4-3343-b223-332f3f359395",
                                        "entry_id": "e89d4958-a7ea-3e2c-8788-7611ed4599f9",
                                        "glosses": [
                                            "Instrument d’acier qui a le tranchant très fin et dont on se sert pour raser la barbe, on le nomme familièrement coupe-choux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57cf5aa1-1fc6-4b21-837c-3036b13fe2b2",
                                                "sense_id": "bc4cdf86-a0d4-3343-b223-332f3f359395",
                                                "text": "Ce sont les plaies faites maladroitement, par les barbiers d’occasion, à l'aide de mauvais rasoirs, voire même de couteaux, plus ou moins bien affilés, qui créent des portes d'entrée à la contamination."
                                            },
                                            {
                                                "example_id": "0e593a61-6198-4e37-bade-e61bdf266960",
                                                "sense_id": "bc4cdf86-a0d4-3343-b223-332f3f359395",
                                                "text": "D’un coup de rasoir, je lui coupai la tête, et le tronc, d’où un flot de sang s’échappait, gigota quelques secondes sur le parquet."
                                            },
                                            {
                                                "example_id": "6b45f16b-7bd7-4372-be61-b630e8d79be5",
                                                "sense_id": "bc4cdf86-a0d4-3343-b223-332f3f359395",
                                                "text": "Toilette du bataillon. Le barbier passe pour particulièrement francophile. Tout le monde va se raser chez lui. Chacun emporte son savon, son blaireau, son rasoir, et lui n’a guère qu’à regarder, mais enfin on se rase chez un coiffeur."
                                            },
                                            {
                                                "example_id": "10c7f159-02ac-4c66-9871-25c1d57112c6",
                                                "sense_id": "bc4cdf86-a0d4-3343-b223-332f3f359395",
                                                "text": "Ses rasoirs, à manche d’agate, coupaient bien […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ac57309-4f6a-35e3-b1fe-f8141b47510b",
                                        "entry_id": "e89d4958-a7ea-3e2c-8788-7611ed4599f9",
                                        "glosses": [
                                            "Appareil électrique servant à raser la barbe, rasoir électrique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4bc8461-bb7a-365b-9463-6b136bd82495",
                                        "entry_id": "e89d4958-a7ea-3e2c-8788-7611ed4599f9",
                                        "glosses": [
                                            "Principe ou règle générale qui permet d'éliminer (de « raser ») des explications improbables d'un phénomène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a852219-3286-433d-a1db-48d08eed625a",
                                                "sense_id": "e4bc8461-bb7a-365b-9463-6b136bd82495",
                                                "text": "Le rasoir d'Ockham est « la maxime méthodologique suprême lorsqu'on philosophe »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0c22951-ad4f-345d-b353-eb672bea8aed",
                                        "entry_id": "e89d4958-a7ea-3e2c-8788-7611ed4599f9",
                                        "glosses": [
                                            "Se dit d'une personne ou d’une chose ennuyeuse."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03fcd603-5f00-47c0-86a5-0521b258505c",
                                                "sense_id": "e0c22951-ad4f-345d-b353-eb672bea8aed",
                                                "text": "Quel rasoir ce mec !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rasoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "364754cf-f2c8-3957-bc6c-92240453c0b8",
                                        "entry_id": "9263e63d-713c-3164-bcc3-28817b84fc35",
                                        "glosses": [
                                            "Espèce de poisson osseux d’eau douce, de la famille des carpes, d’Eurasie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d44a67a2-adfb-3921-8816-8aa6db626376",
                                        "entry_id": "9263e63d-713c-3164-bcc3-28817b84fc35",
                                        "glosses": [
                                            "Variante de rason (poisson)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rasoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef5d7817-986c-33d3-94ad-3429df6525e9",
                                        "entry_id": "0654728d-8be1-3af0-aac5-5800d80a36fc",
                                        "glosses": [
                                            "Ennuyeux, rasant."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99c05ae4-d6eb-4f63-a8dd-9309d893b0be",
                                                "sense_id": "ef5d7817-986c-33d3-94ad-3429df6525e9",
                                                "text": "C’est toujours très rasoir ces études et analyses sur une Œuvre, composations^([sic]) où l’on prête le plus souvent des idées, des tendances et des intuitions à l’auteur disséqué que celui-ci n’a presque jamais eues."
                                            },
                                            {
                                                "example_id": "3f1905bc-91a3-4aa7-9ff3-92f039ea4bd3",
                                                "sense_id": "ef5d7817-986c-33d3-94ad-3429df6525e9",
                                                "text": "— Mais vous n’avez donc pas lu son dernier roman : Une femme ?\n— Ma foi, non : il me l’a envoyé ; mais comme je ne pouvais pas le supposer moins rasoir que les précédents, je n’en ai même pas coupé les pages."
                                            },
                                            {
                                                "example_id": "1e61a6c1-89b0-48f5-b0b5-98b8ee543f73",
                                                "sense_id": "ef5d7817-986c-33d3-94ad-3429df6525e9",
                                                "text": "Malgré ce manque de couleur et de plasticité il y a une forte émotion dans ses romans, mais combien il faut avaler de pages rasoir avant d'y parvenir."
                                            },
                                            {
                                                "example_id": "c29da978-8bc9-4c36-8dab-4624a9f3e612",
                                                "sense_id": "ef5d7817-986c-33d3-94ad-3429df6525e9",
                                                "text": "Ah non, je ne regarde jamais les vœux du président à la télé y’a pas plus rasoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
