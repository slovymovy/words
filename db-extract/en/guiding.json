                                "sense_id": "c991c80b-087e-36f1-97f6-57bdb6459f86",
                                "text": "Butler was ready to consider any proposition which would save her; but it must be a sound one—one not open to her whimsical moods or the guidings or leadings of romance."
                            }
                        ]
                    },
                    {
                        "sense_id": "7551b371-7134-3c13-8e0c-0172da493209",
                        "entry_id": "35177826-c831-3fc7-9e72-78737d97824f",
                        "glosses": [
                            "Girl Guiding."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bcc5d1f4-6892-4ba4-8856-91f790022ba7",
                                "sense_id": "7551b371-7134-3c13-8e0c-0172da493209",
                                "text": "Daisy Gordon Low then established two Girl Guide troops in poor sections of central London. Her belief was growing that guiding could serve many beneficial ends."
                            }
                        ]
                    }
