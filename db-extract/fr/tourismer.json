                "senses": [
                    {
                        "sense_id": "09f5919f-9c54-3993-9a0c-2ee0da5feac8",
                        "entry_id": "854fdaf0-6163-3905-aa3e-ce212bd769f3",
                        "glosses": [
                            "Voyager pour le plaisir."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2211db39-ccd7-4b70-b69c-1684d8b8f55a",
                                "sense_id": "09f5919f-9c54-3993-9a0c-2ee0da5feac8",
                                "text": "Par ici, on ne marche pas longtemps, sur les départementales, les sentiers balisés – chemins de halage, routes étroites d’un clocher à l’autre, d’une vallée à l’autre, sans tomber sur une injonction à tourismer avec méthode et bonne humeur."
                            },
                            {
                                "example_id": "e1b74e7d-8fe8-4c0c-aef7-540613bd270e",
                                "sense_id": "09f5919f-9c54-3993-9a0c-2ee0da5feac8",
                                "text": "Tiens, y’a même quelque 100 millions de chinoas^([sic]) qui ont tourismé durant l’année 2014."
                            },
                            {
                                "example_id": "df756341-1656-4647-b10d-b5eb06a4a987",
                                "sense_id": "09f5919f-9c54-3993-9a0c-2ee0da5feac8",
                                "text": "Nous partons donc tous les 4 pour passer un samedi merveilleux à tourismer sur cette île située juste en face de la ville de Québec."
                            },
                            {
                                "example_id": "ef60c275-43f1-44ef-9762-95bee41824a0",
                                "sense_id": "09f5919f-9c54-3993-9a0c-2ee0da5feac8",
                                "text": "Puis en attendant le départ, nous avons continué à tourismer comme deux provinciaux !"
                            },
                            {
                                "example_id": "1fbd5e09-a747-4aac-8792-05a9fcd96d69",
                                "sense_id": "09f5919f-9c54-3993-9a0c-2ee0da5feac8",
                                "text": "Entre le farniente et la culture, le voyage solidaire ou aventurier en vtt ou à dos de mulet, nous ne « tourismons » pas comme hier !"
                            }
                        ]
                    }
                ],
