                        "examples": [
                            {
                                "example_id": "2af7ee05-a46b-4f5e-9e8e-d499e28ccc9d",
                                "sense_id": "24c2579b-e3e5-37ad-baa9-e57b23b27937",
                                "text": "Hennis sprak maanden geleden met de Amerikaanse minister van Defensie Chuck Hagel over de kostenraming van Nederland voor de aanschaf van de JSF. Die is bij benadering 4,5 miljard euro voor 37 toestellen."
                            },
                            {
                                "example_id": "9c21b772-b73a-48b5-bdad-a32a65d8df5a",
                                "sense_id": "24c2579b-e3e5-37ad-baa9-e57b23b27937",
                                "text": "Met drie bedrijven gaat het Rijk vervolgens onderhandelen, bijvoorbeeld over de kostenraming. Het gebouw gaat zo'n 250 tot 300 miljoen euro kosten, vermoeden economen van ING op basis van eigen onderzoek."
                            },
                            {
                                "example_id": "521aacd4-7ad9-4ec3-b77f-bf889fa409b4",
                                "sense_id": "24c2579b-e3e5-37ad-baa9-e57b23b27937",
                                "text": "Afgelopen oktober bleek er enorme stijging van de kostenraming te zijn. De stijging is deels toe te schrijven aan de hogere grondstofprijzen op dit moment, maar ook door de koerswijziging van BAM."
                            }
                        ]
                    }
