        "fr-extract.jsonl": [
            {
                "entry_id": "eb6f8ab2-80a3-32ce-a6ea-0026f09f3f7f",
                "word": "aquafortiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6a4f11c5-c96b-4b7d-b2cb-933c21f16881",
                        "entry_id": "eb6f8ab2-80a3-32ce-a6ea-0026f09f3f7f",
                        "tags": [
                            "plural"
                        ],
                        "form": "aquafortistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12ec462d-f3d2-36bd-8c08-0c45b8c75093",
                        "entry_id": "eb6f8ab2-80a3-32ce-a6ea-0026f09f3f7f",
                        "glosses": [
                            "Graveur·euse sur cuivre à l’eau-forte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c76a8db-e29b-4a85-bdf9-38d02f1d3d84",
                                "sense_id": "12ec462d-f3d2-36bd-8c08-0c45b8c75093",
                                "text": "Félicien Rops, l’aquafortiste hanté que l’on sait, avait une belle mine, haute et fière, de reître du XVIe siècle. Il lui manquait seulement le pourpoint de velours et l’épée."
                            }
                        ]
                    },
                    {
                        "sense_id": "407ed5e5-c131-33e9-8f10-1e5186c422a1",
                        "entry_id": "eb6f8ab2-80a3-32ce-a6ea-0026f09f3f7f",
                        "glosses": [
                            "Artiste qui édite des gravures à l'eau-forte"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70da597c-adbb-4ac7-839f-563e7c3ce9c1",
                        "source_entry_id": "eb6f8ab2-80a3-32ce-a6ea-0026f09f3f7f",
                        "target_lang_word": "Radierer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radierer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11876ac1-bfbf-3da6-8f46-797297d6d4a5",
                                        "entry_id": "aeac1242-e220-392a-af97-9e26242b17ad",
                                        "glosses": [
                                            "elastischer Gegenstand zum Entfernen von Bleistiftspuren oder Verschmutzungen vornehmlich auf Papier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "142862b4-78b0-4000-9ab2-3821fbd5dc1f",
                                                "sense_id": "11876ac1-bfbf-3da6-8f46-797297d6d4a5",
                                                "text": "„Um den Radierer noch persönlicher zu machen, ist er in Form von Buchstaben erhältlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dcf384bc-9cde-3b2b-9b2b-2119f30188a7",
                                        "entry_id": "aeac1242-e220-392a-af97-9e26242b17ad",
                                        "glosses": [
                                            "Person, die Radierungen anfertigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82962077-fe20-401e-a2d8-7b9c98bec121",
                                                "sense_id": "dcf384bc-9cde-3b2b-9b2b-2119f30188a7",
                                                "text": "„‚Wer den Radierer und Zeichner Rembrandt sehen will, muss hierher kommen‘, sagte Direktorin Stephanie Buck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e03db55b-f272-4d5d-9f1a-5645afc84654",
                        "source_entry_id": "eb6f8ab2-80a3-32ce-a6ea-0026f09f3f7f",
                        "target_lang_word": "Kupferstecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kupferstecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1763c505-8757-33f6-a4ff-3124f41fe7f5",
                                        "entry_id": "6ccf3b3f-2c91-330d-bed3-e4aacccae052",
                                        "glosses": [
                                            "Handwerker oder Künstler, der Kupferstiche anfertigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "403b64f4-fb7d-49d6-b3cf-270c1b982b0e",
                                                "sense_id": "1763c505-8757-33f6-a4ff-3124f41fe7f5",
                                                "text": "Der Beruf des Kupferstechers ist heute nur noch wenig verbreitet."
                                            },
                                            {
                                                "example_id": "0fef788b-8511-44ff-93a9-b23df56c0bb6",
                                                "sense_id": "1763c505-8757-33f6-a4ff-3124f41fe7f5",
                                                "text": "„Der Bucklige, um den es sich hier handelt, hieß Dubois-Châteleraux. Er war ein geschickter Kupferstecher und zugleich Münzdirektor des Infanten-Herzogs von Parma, obgleich dieser kleine Fürst eine eigene Münze nicht besaß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae81271d-f4e5-367f-8a7f-5e3cc16bb1a9",
                                        "entry_id": "6ccf3b3f-2c91-330d-bed3-e4aacccae052",
                                        "glosses": [
                                            "Käfer aus der Familie der Borkenkäfer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4657b7a3-c2fc-4a13-a3f7-fbd663b91403",
                                                "sense_id": "ae81271d-f4e5-367f-8a7f-5e3cc16bb1a9",
                                                "text": "Neben dem Buchdrucker ist der Kupferstecher einer der gefürchtetsten Forstschädlinge."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "003e1698-5f7c-4ea1-a672-9fba45c4432f",
                        "source_entry_id": "eb6f8ab2-80a3-32ce-a6ea-0026f09f3f7f",
                        "target_lang_word": "acquafortista",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acquafortista",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "849d93dd-c1b1-38cb-a37c-0d0f9f72dd6f",
                                        "entry_id": "5fc9c1e8-5cea-35bd-8898-4bdc687ea610",
                                        "glosses": [
                                            "esperto di acquaforte"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe7daa9b-38c0-4185-a64e-329b6cfcd7f8",
                        "source_entry_id": "eb6f8ab2-80a3-32ce-a6ea-0026f09f3f7f",
                        "target_lang_word": "etser",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "etser",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "82c941f7-c7e1-3f79-95c2-d3cd2b9643c8",
                                        "entry_id": "6d2b84fa-ec9a-342a-8035-28977ec0f843",
                                        "glosses": [
                                            "kunstenaar die etsen maakt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f8d9464-fcf0-4f92-bf96-30232900d638",
                                                "sense_id": "82c941f7-c7e1-3f79-95c2-d3cd2b9643c8",
                                                "text": "De Holtense tekenaar, etser en schilder Kees Stoop treedt niet graag op de voorgrond. De fervente kunstenaar is groot geworden, maar toch altijd klein gebleven."
                                            },
                                            {
                                                "example_id": "087c5a5e-5c2e-4c79-94bd-d04d4d211782",
                                                "sense_id": "82c941f7-c7e1-3f79-95c2-d3cd2b9643c8",
                                                "text": "Op het schilderij staat etser Leopold Löwenstam, destijds een goede vriend van Alma-Tadema. Het is voor het laatst in 1913 geëxposeerd. De BBC maakte het nieuws zelf bekend. In de uitzending van zondag 25 september is de ontdekking te zien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
