                "entry_id": "ee5a8ee6-4ee2-34b8-9c45-22a0105e56fe",
                "word": "phishing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "76eb6100-06d1-3697-a303-2745907b6379",
                        "entry_id": "ee5a8ee6-4ee2-34b8-9c45-22a0105e56fe",
                        "glosses": [
                            "The malicious act of keeping a false website or sending a false e-mail with the intent of masquerading as a trustworthy entity in order to acquire sensitive information, such as usernames, passwords, and credit card details."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "669a2346-e02a-41a4-b368-23407a9ed8f1",
                                "sense_id": "76eb6100-06d1-3697-a303-2745907b6379",
                                "text": "Holonym: social engineering"
                            },
                            {
                                "example_id": "a42700cb-0bc1-4874-bcc0-b3e35dd41f35",
                                "sense_id": "76eb6100-06d1-3697-a303-2745907b6379",
                                "text": "A growing number of U.S. cities are alerting residents to a widespread phishing scam involving fraudulent text messages about unpaid parking violations."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfc5d973-2a7f-3d5c-9984-385aab0e173d",
                        "entry_id": "ee5a8ee6-4ee2-34b8-9c45-22a0105e56fe",
                        "glosses": [
                            "The act of circumventing security with an alias."
                        ],
