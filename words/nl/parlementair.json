{
    "word_family": [
        "parlement",
        "parlementariër",
        "parlementarisme"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "22887375-3edf-3a51-9421-d0dbe1007931",
                    "sense_definition": "met betrekking tot een parlement",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "politiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning hield een toespraak tijdens de opening van het <w>parlementaire</w> jaar.",
                            "target_lang_translations": {
                                "en": "The king gave a speech during the opening of the <w>parliamentary</w> year."
                            }
                        },
                        {
                            "text": "Er wordt een <w>parlementair</w> onderzoek ingesteld naar de privatisering van de spoorwegen.",
                            "target_lang_translations": {
                                "en": "A <w>parliamentary</w> inquiry is being launched into the privatization of the railways."
                            }
                        }
                    ],
                    "common_phrases": [
                        "parlementair onderzoek",
                        "parlementaire democratie",
                        "parlementair jaar"
                    ],
                    "target_lang_definitions": {
                        "en": "relating to a parliament"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "parliamentary",
                                "target_lang_sense_clarification": "relating to a parliament"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13047877-84e1-3ca5-b5e1-efc10217b933",
                    "sense_definition": "beleefd en omzichtig in het taalgebruik zoals dat in de volksvertegenwoordiging gebruikelijk is",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus probeerde zijn kritiek op een <w>parlementaire</w> wijze te verwoorden.",
                            "target_lang_translations": {
                                "en": "The politician tried to phrase his criticism in a <w>parliamentary</w> manner."
                            }
                        },
                        {
                            "text": "Zijn taalgebruik was niet erg <w>parlementair</w> tijdens het verhitte debat.",
                            "target_lang_translations": {
                                "en": "His language was not very <w>parliamentary</w> during the heated debate."
                            }
                        }
                    ],
                    "synonyms": [
                        "beleefd",
                        "omzichtig"
                    ],
                    "antonyms": [
                        "onparlementair"
                    ],
                    "common_phrases": [
                        "parlementair taalgebruik"
                    ],
                    "target_lang_definitions": {
                        "en": "polite and cautious in language, as is customary in a representative assembly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "parliamentary",
                                "target_lang_sense_clarification": "polite and formal language"
                            },
                            {
                                "target_lang_word": "civil",
                                "target_lang_sense_clarification": "polite and formal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47fcc94d-5ff1-3722-aeb5-6ccf0538fdcd",
                    "sense_definition": "betrekking hebbend op een onderhandelaar die onder bescherming van een witte vlag met de vijand spreekt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "oorlog",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De officier trad op in zijn <w>parlementaire</w> rol om over een wapenstilstand te praten.",
                            "target_lang_translations": {
                                "en": "The officer acted in his <w>parliamentary</w> role to discuss a truce."
                            }
                        },
                        {
                            "text": "Zij genoten <w>parlementaire</w> onschendbaarheid tijdens de onderhandelingen in het oorlogsgebied.",
                            "target_lang_translations": {
                                "en": "They enjoyed <w>parliamentary</w> immunity during the negotiations in the war zone."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "relating to a negotiator who speaks with the enemy under the protection of a white flag"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "parliamentary",
                                "target_lang_sense_clarification": "relating to a parley or truce negotiator"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d65e16b-33e4-3e47-a9e8-b681ba25d202",
                    "sense_definition": "iemand die zitting heeft in het parlement",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Verschillende <w>parlementairen</w> stemden tegen het nieuwe wetsvoorstel.",
                            "target_lang_translations": {
                                "en": "Several <w>parliamentarians</w> voted against the new bill."
                            }
                        },
                        {
                            "text": "De jonge <w>parlementair</w> hield zijn eerste toespraak in de Kamer.",
                            "target_lang_translations": {
                                "en": "The young <w>parliamentarian</w> gave his first speech in the House."
                            }
                        }
                    ],
                    "synonyms": [
                        "parlementslid",
                        "volksvertegenwoordiger"
                    ],
                    "target_lang_definitions": {
                        "en": "someone who has a seat in parliament"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "parliamentarian",
                                "target_lang_sense_clarification": "a member of a parliament"
                            },
                            {
                                "target_lang_word": "MP",
                                "target_lang_sense_clarification": "Member of Parliament"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6e1ea00-555c-3653-aad1-094402a8bddc",
                    "sense_definition": "een afgezant die met de vijand onderhandelt tijdens een gewapend conflict",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "oorlog",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>parlementair</w> naderde de vijandelijke linies met een witte vlag.",
                            "target_lang_translations": {
                                "en": "The <w>parlementaire</w> approached the enemy lines with a white flag."
                            }
                        },
                        {
                            "text": "De generaals weigerden de <w>parlementair</w> van de tegenpartij te ontvangen.",
                            "target_lang_translations": {
                                "en": "The generals refused to receive the opposing party's <w>negotiator</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderhandelaar"
                    ],
                    "target_lang_definitions": {
                        "en": "an envoy who negotiates with the enemy during an armed conflict"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "parlementaire",
                                "target_lang_sense_clarification": "an agent sent to an enemy to negotiate"
                            },
                            {
                                "target_lang_word": "negotiator",
                                "target_lang_sense_clarification": "person who conducts negotiations"
                            }
                        ]
                    }
                }
            ]
        }
    ]
