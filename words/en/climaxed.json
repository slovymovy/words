{
    "word_family": [
        "anticlimax",
        "anticlimactic",
        "climax",
        "climactic"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d92166ea-3dab-3810-a3da-24bfe940323f",
                    "sense_definition": "Simple past and past participle of <w>climax</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exciting concert <w>climaxed</w> with an amazing fireworks display.",
                            "target_lang_translations": {
                                "it": "L'entusiasmante concerto <w>è culminato</w> con uno straordinario spettacolo pirotecnico."
                            }
                        },
                        {
                            "text": "Their thrilling journey across Europe <w>climaxed</w> in Paris.",
                            "target_lang_translations": {
                                "it": "Il loro emozionante viaggio attraverso l'Europa <w>ha raggiunto il culmine</w> a Parigi."
                            }
                        }
                    ],
                    "synonyms": [
                        "culminated",
                        "peaked"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Passato semplice e participio passato di 'climax': raggiungere il punto culminante, culminare."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "culminato",
                                "target_lang_sense_clarification": "participio passato, aver raggiunto l'apice"
                            },
                            {
                                "target_lang_word": "è culminato",
                                "target_lang_sense_clarification": "passato prossimo di culminare"
                            },
                            {
                                "target_lang_word": "ha raggiunto il culmine",
                                "target_lang_sense_clarification": "arrivare al punto più alto"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4c7ade4c-27b3-3f82-9b71-21900ce24a45",
                    "sense_definition": "Having reached or attained a climax.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience sat in stunned silence during the <w>climaxed</w> conclusion of the performance.",
                            "target_lang_translations": {
                                "it": "Il pubblico è rimasto in un silenzio attonito durante la conclusione <w>culminante</w> dello spettacolo."
                            }
                        },
                        {
                            "text": "After hours of negotiation, the diplomats finally reached a <w>climaxed</w> state of agreement.",
                            "target_lang_translations": {
                                "it": "Dopo ore di trattative, i diplomatici hanno infine raggiunto uno stato di accordo <w>al culmine</w> del processo."
                            }
                        }
                    ],
                    "synonyms": [
                        "culminated"
                    ],
                    "target_lang_definitions": {
                        "it": "Che ha raggiunto il culmine o il punto di massimo sviluppo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "culminante",
                                "target_lang_sense_clarification": "che rappresenta l'apice"
                            },
                            {
                                "target_lang_word": "al culmine",
                                "target_lang_sense_clarification": "nel punto più alto"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}