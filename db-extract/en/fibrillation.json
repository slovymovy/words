                                "target_senses": [
                                    {
                                        "sense_id": "366e17b6-5a98-3f31-83be-3054494680d6",
                                        "entry_id": "c4848911-1dde-35ec-9238-0f305d782357",
                                        "glosses": [
                                            "мед. быстрое хаотическое сокращение многих отдельных мышечных волокон сердца, в результате которого сердце теряет способность к эффективным и синхронным сокращениям"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bae4ad6-dd92-4924-ab85-858ede1b42eb",
                                                "sense_id": "366e17b6-5a98-3f31-83be-3054494680d6",
                                                "text": "При такой быстроте отключения электрический ток, проходящий через организм человека, не успевает вызвать фибрилляцию сердца ― основную причину смерти при электрических поражениях."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
