                        "examples": [
                            {
                                "example_id": "8eb58ea0-86f6-4b09-8f32-8a79102a7d8b",
                                "sense_id": "89d3818e-f8c4-3dc1-945e-a79830666fe7",
                                "text": "Il décrit maniaquement la fête foraine et ses fakirs, la machine inventée par M. Chaussier, le café le Progrès. Maniaquement, pas scrupuleusement."
                            },
                            {
                                "example_id": "4f16951b-a006-4b23-a982-4d484634f8f2",
                                "sense_id": "89d3818e-f8c4-3dc1-945e-a79830666fe7",
                                "text": "Prenons par exemple Hannah Gadsby, vétérane humoriste tasmanienne dont le plus récent tour de piste, Nanette, déborde des frontières maniaquement balisées du stand-up devant toujours générer des rires, tel qu’on le pratique traditionnellement en Amérique du Nord."
                            },
                            {
                                "example_id": "a49d455d-3884-492e-a88c-a7523f13610b",
                                "sense_id": "89d3818e-f8c4-3dc1-945e-a79830666fe7",
                                "text": "Car c’est ce protocole maniaquement hiérar­chique, c’est cette folie de la classification et du cloisonnement des êtres qu’elle jugeait détestables."
                            }
                        ]
                    }
