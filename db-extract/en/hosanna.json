                                    {
                                        "sense_id": "a9e8d205-d6f3-393b-b539-0112c12f1bfd",
                                        "entry_id": "b48d5d86-f8d7-309e-8b8a-c744018a031d",
                                        "glosses": [
                                            "liturgischer Ausruf der Freude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee45d906-311f-43d6-a2c8-63ecbc704ce7",
                                                "sense_id": "a9e8d205-d6f3-393b-b539-0112c12f1bfd",
                                                "text": "Hosianna! Ehre sei Gott in der Höhe."
                                            },
                                            {
                                                "example_id": "7e9a6963-0376-4ab8-aa28-7e42cfd321ff",
                                                "sense_id": "a9e8d205-d6f3-393b-b539-0112c12f1bfd",
                                                "text": "„Freunde der »null-nuklearen Welt« werden nur verhalten hosianna rufen angesichts des Abbaus der je 2200 Sprengköpfe auf 1550 und der Halbierung ihrer Träger auf 800.“"
                                            },
                                            {
                                                "example_id": "4a5ebe5d-ffd3-4c5f-9ac0-462b7d585e0d",
                                                "sense_id": "a9e8d205-d6f3-393b-b539-0112c12f1bfd",
                                                "text": "Das Volk aber, das vorging und nachfolgte, schrie und sprach: Hosianna dem Sohn Davids! Gelobt sei, der da kommt in dem Namen des HERRN! Hosianna in der Höhe!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
