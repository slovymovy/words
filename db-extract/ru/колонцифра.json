                                    {
                                        "sense_id": "31ef137c-3623-3e92-89a1-50bbe87ca891",
                                        "entry_id": "45fe95c2-79ca-31a2-a7c4-bbb762d9d457",
                                        "glosses": [
                                            "Feuillet, en parlant de registres, de manuscrits, etc., numérotés par feuillets, et non par pages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05c904c8-8439-4153-9b11-8fc555c91ae2",
                                                "sense_id": "31ef137c-3623-3e92-89a1-50bbe87ca891",
                                                "text": "Folio recto, ou simplement recto, première page du feuillet ;"
                                            },
                                            {
                                                "example_id": "29af4355-8651-4943-91e7-1610785362db",
                                                "sense_id": "31ef137c-3623-3e92-89a1-50bbe87ca891",
                                                "text": "folio verso, ou simplement verso, son revers."
                                            },
                                            {
                                                "example_id": "5234a661-2b4f-4675-a516-1cedd0bca043",
                                                "sense_id": "31ef137c-3623-3e92-89a1-50bbe87ca891",
                                                "text": "Voyez au folio premier, au folio six."
                                            },
                                            {
                                                "example_id": "51bbb0d7-07af-4c0f-82cb-7b6b80bd3671",
                                                "sense_id": "31ef137c-3623-3e92-89a1-50bbe87ca891",
                                                "text": "Au début du codex, un binion dont le premier folio est collé sur le contre-plat ; puis un binion central, prévu pour un texte qui n’y fut jamais ajouté ; enfin, d’abord un binion dont le second folio a été coupé, puis un quaternion dont les deux premiers folios manquent. Les talons des trois folios coupés se trouvent entre les ff. 37 et 38."
                                            }
                                        ]
