                        "cross_references": [
                            {
                                "target_word": "кулебяка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a14d1995-a6f0-3c8f-9402-462a81ebfaff",
                                        "entry_id": "111804b1-64a0-3e0b-a4b3-7097fbbce81e",
                                        "glosses": [
                                            "кулин. большой продолговатый закрытый пирог с начинкой из рыбы, мяса, капусты, грибов, каши и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79bb8561-a599-4079-970b-327a0936bea5",
                                                "sense_id": "a14d1995-a6f0-3c8f-9402-462a81ebfaff",
                                                "text": "Но господа средней руки, что на одной станции потребуют ветчины, на другой поросёнка, на третьей ломоть осетра или какую-нибудь запеканную колбасу с луком и потом как ни в чём не бывало садятся за стол в какое хочешь время, и стерляжья уха с налимами и молоками шипит и ворчит у них меж зубами, заедаемая расстегаем или кулебякой с сомовьим плесом, так что вчуже пронимает аппетит."
                                            },
                                            {
                                                "example_id": "e1734f35-1340-4579-86a0-86e023216132",
                                                "sense_id": "a14d1995-a6f0-3c8f-9402-462a81ebfaff",
                                                "text": "Кулебяка — вид закрытого мясного, рыбного или грибного пирога, наиболее почитаемого в русской кухне. Термин происходит от глагола кулебячить, т. е. валять что-либо руками, мять, гнуть, сгибать, складывать, лепить тесто."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
