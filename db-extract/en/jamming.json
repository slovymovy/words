                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e2cb39de-8431-4d98-a6d7-6442646a01ff",
                                "sense_id": "0002cf1a-74ca-395b-bf53-f52ef01f0c3d",
                                "text": "Jamming with the band is her favorite way to find compositional inspiration."
