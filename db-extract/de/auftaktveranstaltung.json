                "senses": [
                    {
                        "sense_id": "4bce54d7-aade-3356-ba7c-7d3e739a693d",
                        "entry_id": "3ec6ce85-a689-3de2-be63-5c42befac2db",
                        "glosses": [
                            "erstes einer Reihe von thematisch zusammengehörigen geplanten (gesellschaftlichen) Ereignissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9268d1aa-562b-476c-aac8-33452cd67a5b",
                                "sense_id": "4bce54d7-aade-3356-ba7c-7d3e739a693d",
                                "text": "„Es war die Auftaktveranstaltung für zahlreiche Vorträge, Diskussionen, Ausstellungen und Konzerten [sic!]: […]“"
                            },
                            {
                                "example_id": "55c04c71-6723-46ab-a416-c56ee0ead1fd",
                                "sense_id": "4bce54d7-aade-3356-ba7c-7d3e739a693d",
                                "text": "„Insgesamt war die Auftaktveranstaltung noch ein Trockenschwimmen.“"
                            },
                            {
                                "example_id": "f2331989-0ab5-4a1c-9f8d-26e9d59ad8b3",
                                "sense_id": "4bce54d7-aade-3356-ba7c-7d3e739a693d",
                                "text": "„Allein die Auftaktveranstaltung dauert drei Stunden, und das umfangreiche Programm bietet ihnen Gelegenheit, rund um die Uhr zu beten, Workshops zu besuchen und zu «worshippen».“"
                            },
                            {
                                "example_id": "a138781d-9192-43cd-aca6-c2f16e46c93a",
                                "sense_id": "4bce54d7-aade-3356-ba7c-7d3e739a693d",
                                "text": "„Diese Problemstellung war der Auftaktveranstaltung zur Ringvorlesung des Forschungsinstituts fur Philosophie Hannover im Sommersemester 2005 vorgegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
