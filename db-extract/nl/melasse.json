                                "target_senses": [
                                    {
                                        "sense_id": "0b82fc74-2b75-334d-bd5b-cb66a094fe9b",
                                        "entry_id": "0003aa66-6f87-3dec-9d1b-a5d3389698fa",
                                        "glosses": [
                                            "honigartiger, dunkelbrauner Zuckersirup, der als Nebenprodukt der Zuckerherstellung abfällt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36148e3e-155e-41d2-af21-1582159e21b8",
                                                "sense_id": "0b82fc74-2b75-334d-bd5b-cb66a094fe9b",
                                                "text": "Die Melasse von Runkelrübenzucker hat einen akzeptablen Nährwert und kann als Viehfutter verwendet werden."
                                            },
                                            {
                                                "example_id": "85655d76-3acd-4cbb-a3f8-fb436e2a03c9",
                                                "sense_id": "0b82fc74-2b75-334d-bd5b-cb66a094fe9b",
                                                "text": "Im Reformhaus gibt es Melasse zu kaufen. Sie eignet sich zum Beispiel zum Backen brauner Muffins."
                                            },
                                            {
                                                "example_id": "e3aac18e-7f0c-4481-a7f0-e7d389a936cc",
                                                "sense_id": "0b82fc74-2b75-334d-bd5b-cb66a094fe9b",
                                                "text": "„Am Nachmittag zeigte mir Hallows die Fabrik, wohin das Zuckerrohr von den Feldern gebracht und wo es zu Melasse verarbeitet wurde.“"
                                            },
                                            {
                                                "example_id": "ba58eb22-34e8-40bb-8cc0-23ba479c0f3f",
                                                "sense_id": "0b82fc74-2b75-334d-bd5b-cb66a094fe9b",
                                                "text": "„Der Saft erbrachte braunen Rohzucker, nach den portugiesischen Pionieren Muscovado genannt, vermischt mit Melasse, die man mehrere Wochen ablaufen ließ.“"
                                            },
                                            {
                                                "example_id": "e83a1700-993c-4ae9-b646-87d8b1d00471",
                                                "sense_id": "0b82fc74-2b75-334d-bd5b-cb66a094fe9b",
                                                "text": "„Während ich Melasse schleckte, erzählte ich den Jungs von meiner Lage, und sie zeigten sich voller Mitgefühl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5d2e340-8e73-4666-9bc8-8814e9ac63e2",
                        "source_entry_id": "91f007dc-9621-37f5-a8ec-ac84b2150a83",
