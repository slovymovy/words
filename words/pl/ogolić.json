    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7178237-9b64-3b40-b7e6-eb83c4e869b3",
                    "sense_definition": "usunąć własny zarost lub włosy za pomocą ostrza",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "golenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <w>się</w> <w>ogolić</w> przed ważnym spotkaniem.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>побриться</w> перед важной встречей."
                            }
                        },
                        {
                            "text": "Miałem rano mało czasu, żeby <w>się</w> <w>ogolić</w>.",
                            "target_lang_translations": {
                                "ru": "У меня утром было мало времени, чтобы <w>побриться</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ogolić się rano"
                    ],
                    "target_lang_definitions": {
                        "ru": "удалить собственные волосы или бороду с помощью бритвы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побриться",
                                "target_lang_sense_clarification": "возвратный глагол, означающий процесс бритья самого себя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a63773d4-d773-3c3e-8ba7-0bda4e7cf61a",
                    "sense_definition": "usunąć komuś zarost lub włosy za pomocą ostrza",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "golenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed operacją pielęgniarka musiała <w>ogolić</w> pacjentowi głowę.",
                            "target_lang_translations": {
                                "ru": "Перед операцией медсестре пришлось <w>побрить</w> пациенту голову."
                            }
                        },
                        {
                            "text": "W więzieniu kazali mu <w>ogolić</w> głowę na łyso.",
                            "target_lang_translations": {
                                "ru": "В тюрьме ему приказали <w>побрить</w> голову налысо."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "удалить кому-либо волосы или бороду с помощью бритвы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побрить",
                                "target_lang_sense_clarification": "переходный глагол, означающий бритье другого человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "987d2597-fe3a-368e-bf02-dae731c006b5",
                    "sense_definition": "usunąć zarost lub włosy",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "golenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed rozmową kwalifikacyjną postanowił <w>ogolić</w> brodę.",
                            "target_lang_translations": {
                                "ru": "Перед собеседованием он решил <w>сбрить</w> бороду."
                            }
                        },
                        {
                            "text": "Musisz <w>ogolić</w> nogi przed wyjściem na plażę.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>побрить</w> ноги перед походом на пляж."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "удалить волосы или бороду (в общем смысле)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побрить",
                                "target_lang_sense_clarification": "удаление волос с какой-либо части тела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4cd037b-75dc-3208-b178-2afa480ec893",
                    "sense_definition": "okraść kogoś całkowicie ze wszystkiego co posiadał",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kradzież",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złodzieje włamali się do domu i <w>ogolili</w> go do czysta.",
                            "target_lang_translations": {
                                "ru": "Воры вломились в дом и <w>обобрали</w> его до нитки."
                            }
                        },
                        {
                            "text": "Oszuści na giełdzie <w>ogolili</w> inwestorów ze wszystkich oszczędności.",
                            "target_lang_translations": {
                                "ru": "Мошенники на бирже <w>обобрали</w> инвесторов до последней копейки."
                            }
                        }
                    ],
                    "synonyms": [
                        "okraść",
                        "obrobić"
                    ],
                    "common_phrases": [
                        "ogolić do czysta"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w kontekście przestępczym lub finansowym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "полностью обокрасть кого-либо, лишить всех средств"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обобрать",
                                "target_lang_sense_clarification": "разговорный термин, означающий лишить кого-то всего имущества или денег"
                            },
                            {
                                "target_lang_word": "обчистить",
                                "target_lang_sense_clarification": "разговорный термин, означающий кражу всего ценного"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}