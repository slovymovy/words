                "forms": [
                    {
                        "form_id": "9cb6beff-b475-4c74-98f0-0bf64ba0c925",
                        "entry_id": "79be2629-3306-3198-87e2-c08d23736635",
                        "tags": [
                            "plural"
                        ],
                        "form": "sagettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a6d26d4-3175-34c9-910b-bf9b0ff419a1",
                        "entry_id": "79be2629-3306-3198-87e2-c08d23736635",
                        "glosses": [
                            "Flèche."
                        ],
                        "tags": [
                            "dated",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "b6c2b763-ee24-4eb1-a8b0-d6b687547279",
                                "sense_id": "3a6d26d4-3175-34c9-910b-bf9b0ff419a1",
                                "text": "Il porta la main à la sagette, l’arracha de son bras et la brisa tranquillement sur son gros genou."
                            },
                            {
                                "example_id": "fcdad93f-1fe3-4637-b902-db93d0354239",
                                "sense_id": "3a6d26d4-3175-34c9-910b-bf9b0ff419a1",
                                "text": "Au lieu de ce tube tonnant [le fusil]\nL'homme n'avait-il pas un arc et des sagettes !"
                            },
                            {
                                "example_id": "352f50c1-85ab-44e8-8920-3e4ff85a5369",
                                "sense_id": "3a6d26d4-3175-34c9-910b-bf9b0ff419a1",
                                "text": "Entrez. Le soleil inhumain\nDe ses sagettes verticales\nCrible les arbres du chemin\nPoudeux et vibrants de cigales."
                            }
                        ]
                    },
                    {
                        "sense_id": "273b68e1-ef5b-34cc-bd04-4da0281129cd",
                        "entry_id": "79be2629-3306-3198-87e2-c08d23736635",
                        "glosses": [
                            "Sagittaire à feuilles en flèche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61b8cb39-fb6a-4c62-ac83-fbb8a0f3ae8e",
                                "sense_id": "273b68e1-ef5b-34cc-bd04-4da0281129cd",
                                "text": "Les presles, les laiches, les sagettes et les ményanthes y foisonnaient plus que le ray-grass."
                            }
                        ]
                    }
                ],
