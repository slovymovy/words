{
    "word_family": [
        "retrofitting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "53500b9b-5ec2-3f8f-a8ff-010ac66670f2",
                    "sense_definition": "To modernize a device or structure by adding new components or parts that were not originally installed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "modernization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city decided to <w>retrofit</w> all old streetlights with energy-efficient LED bulbs.",
                            "target_lang_translations": {
                                "zh": "市政府决定为所有旧路灯<w>加装</w>节能LED灯泡。"
                            }
                        },
                        {
                            "text": "Engineers will <w>retrofit</w> the building to meet modern safety standards.",
                            "target_lang_translations": {
                                "zh": "工程师将对该建筑进行<w>改造</w>，以符合现代安全标准。"
                            }
                        }
                    ],
                    "synonyms": [
                        "backfit"
                    ],
                    "common_phrases": [
                        "retrofit buildings",
                        "retrofit equipment"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过添加原先未安装的新组件或部件来使设备或结构现代化。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "改造",
                                "target_lang_sense_clarification": "指对旧有设施或设备进行结构性更新或升级。"
                            },
                            {
                                "target_lang_word": "加装",
                                "target_lang_sense_clarification": "侧重于在原有基础上额外安装新部件。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54b7bada-b603-3214-a664-d7cc5086fd97",
                    "sense_definition": "To apply a software fix or feature to an older version of a program.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "software_update",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developers had to <w>retrofit</w> the security patch to the older software version.",
                            "target_lang_translations": {
                                "zh": "开发人员必须将安全补丁<w>移植</w>到旧版软件中。"
                            }
                        },
                        {
                            "text": "It is often difficult to <w>retrofit</w> new features into legacy codebases.",
                            "target_lang_translations": {
                                "zh": "将新功能<w>移植</w>到遗留代码库中通常很困难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "backport"
                    ],
                    "target_lang_definitions": {
                        "zh": "将软件修复程序或功能应用于旧版本的程序。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "移植",
                                "target_lang_sense_clarification": "指将新功能或补丁应用到旧版本软件中。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "412fce1d-46cd-34dc-8c07-1fac0eb4fdbb",
                    "sense_definition": "The process of updating a device or structure with new parts or technology.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "modernization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>retrofit</w> of the factory machinery improved overall production efficiency.",
                            "target_lang_translations": {
                                "zh": "工厂机器的<w>升级改造</w>提高了整体生产效率。"
                            }
                        },
                        {
                            "text": "A major <w>retrofit</w> was required to make the bridge earthquake-resistant.",
                            "target_lang_translations": {
                                "zh": "为了使桥梁具备抗震能力，需要进行大规模的<w>改造工程</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "complete a retrofit",
                        "undergo a retrofit"
                    ],
                    "target_lang_definitions": {
                        "zh": "用新部件或新技术更新设备或结构的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "改造工程",
                                "target_lang_sense_clarification": "指进行现代化更新的整个过程或项目。"
                            },
                            {
                                "target_lang_word": "升级改造",
                                "target_lang_sense_clarification": "指通过更新技术来提升性能的过程。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}