                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dffba1b4-9b78-47d8-a5ef-45c92fcacd25",
                                                "sense_id": "7bbe4714-9eeb-3682-b4ad-0add360d6719",
                                                "text": "Les projets de « chèque vert » restent vagues. Et ses modalités abstruses. Pour l'heure, et c'est dommage, la taxe carbone reste une usine à gaz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd90d0e3-d481-3012-a882-edb2878ce756",
                                        "entry_id": "1a603ba2-e5b1-36f5-a797-b6b22cff2277",
                                        "glosses": [
                                            "Caractère d’une phrase musicale, suivant le mode auquel elle appartient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f19cf070-eac6-4c39-aa2e-10aa24e295d9",
                                                "sense_id": "cd90d0e3-d481-3012-a882-edb2878ce756",
                                                "text": "Déterminer la modalité d’un morceau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e1b407-fabe-329e-8e71-21faaf86a39b",
                                        "entry_id": "1a603ba2-e5b1-36f5-a797-b6b22cff2277",
                                        "glosses": [
                                            "Fait énoncé par une proposition en le présentant comme nécessaire, possible ou vrai de fait."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20958a1a-e2f5-32af-bc16-fc24542a0f4d",
                                        "entry_id": "1a603ba2-e5b1-36f5-a797-b6b22cff2277",
                                        "glosses": [
                                            "Mode de perception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d86c867e-03ea-4f1e-a982-300d22d6925f",
                                                "sense_id": "20958a1a-e2f5-32af-bc16-fc24542a0f4d",
                                                "text": "La négligence ne se limite pas à une modalité sensorielle, mais elle peut affecter l’ensemble de nos sens et toucher notre capacité à agir. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 85)"
                                            },
                                            {
                                                "example_id": "558c31a4-a7f3-48a0-9b65-67395d1154c8",
                                                "sense_id": "20958a1a-e2f5-32af-bc16-fc24542a0f4d",
                                                "text": "La vue est la modalité, l'œil est l'organe sensoriel. (Physiologie générale des systèmes sensoriels)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93c3992a-40e4-3309-a20a-19020727a2a1",
                                        "entry_id": "1a603ba2-e5b1-36f5-a797-b6b22cff2277",
                                        "glosses": [
                                            "Se dit d’une technique d’imagerie médicale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a940559e-af5c-4aec-b68f-906ed18af905",
                                                "sense_id": "93c3992a-40e4-3309-a20a-19020727a2a1",
                                                "text": "L’échographie est une modalité d’imagerie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
