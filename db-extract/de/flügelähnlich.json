                        "glosses": [
                            "einem Flügel ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b664d65-34a4-4e30-bbf3-485350f0c998",
                                "sense_id": "0fd0aadc-195a-3173-9399-6ca14ed89af0",
                                "text": "„Kurze, flügelähnliche Stummel ragen aus dem Körper heraus: ein großer aus jeder Schulter, eine Reihe kleinerer aus der Wirbelsäule – wie bei einem Stegosaurus.“"
                            },
                            {
                                "example_id": "049b1209-f953-420b-a2a9-1b1ed17339b1",
                                "sense_id": "0fd0aadc-195a-3173-9399-6ca14ed89af0",
                                "text": "„Der höhere Beamte trug einen dunklen Kimono und einen Überwurf mit gestärkten, flügelähnlichen Schultern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
