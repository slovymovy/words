                                    {
                                        "sense_id": "8253f752-ffe0-3b22-8bd5-0242d31361c7",
                                        "entry_id": "8b5f7de8-9286-3215-91ee-8d1deb69d0c5",
                                        "glosses": [
                                            "Alternative spelling of extrovert."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f922d77-fab7-421e-90fb-64a5bdc998d7",
                                                "sense_id": "8253f752-ffe0-3b22-8bd5-0242d31361c7",
                                                "text": "An Extravert can hardly conceive the necessity which compels the Introvert to conquer the world by means of a system."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "extravert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4c61659-f4b1-36b9-8acc-7b382d200d46",
                                        "entry_id": "4ddca08f-3f86-3c24-8bd9-f6620f316fe3",
                                        "glosses": [
                                            "Alternative spelling of extrovert."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94887e57-4c33-420a-aa76-3090628a6a01",
                                                "sense_id": "e4c61659-f4b1-36b9-8acc-7b382d200d46",
                                                "text": "The personality which thus combines introvert and extravert reactions... can be... called an ‘altrovert’..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "extravert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a385139-0b52-3f1c-9131-da99b69ef7a3",
                                        "entry_id": "967e8751-30d8-3d26-afa8-f149503a1e40",
                                        "glosses": [
                                            "Alternative spelling of extrovert, especially (early chemistry, obsolete) so as to be visible."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54c11e24-b5a7-4e13-a666-afdc41063cdc",
                                                "sense_id": "0a385139-0b52-3f1c-9131-da99b69ef7a3",
                                                "text": "It is not the moist air that extraverts any preexistent nitrous parts from the body of the minerals."
                                            },
                                            {
                                                "example_id": "b405142d-fd0f-4bcc-995c-1934a8c377f5",
                                                "sense_id": "0a385139-0b52-3f1c-9131-da99b69ef7a3",
                                                "text": "An extraverted individual can hardly understand the necessity that forces the introverted to accomplish his adaptation by first formulating a general conception."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
