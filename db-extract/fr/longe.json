        "fr-extract.jsonl": [
            {
                "entry_id": "4267d19e-748c-30c5-a344-7e633bc623b0",
                "word": "longe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2923f7f9-7de4-4eaa-90c4-2f153c76f8df",
                        "entry_id": "4267d19e-748c-30c5-a344-7e633bc623b0",
                        "tags": [
                            "plural"
                        ],
                        "form": "longes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0fbb6e00-b942-3532-b86e-84c21aba4eb2",
                        "entry_id": "4267d19e-748c-30c5-a344-7e633bc623b0",
                        "glosses": [
                            "Longue corde pour le dressage des chevaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6133896c-70a9-4055-82e2-b7748842a0f3",
                                "sense_id": "0fbb6e00-b942-3532-b86e-84c21aba4eb2",
                                "text": "Murph attacha la longe du licou du cheval à un anneau de fer scellé dans le mur."
                            },
                            {
                                "example_id": "4d2fb606-dca0-4977-aa5e-aee4d755b0b5",
                                "sense_id": "0fbb6e00-b942-3532-b86e-84c21aba4eb2",
                                "text": "Pour aider à contenir le cheval droit pendant les premières leçons, on lui mettra le caveçon, dont la longe sera tenue et maniée par un homme placé devant et près la tête de l'animal."
                            },
                            {
                                "example_id": "db5449e1-4135-4d3f-a8f0-6c9037d5e0cc",
                                "sense_id": "0fbb6e00-b942-3532-b86e-84c21aba4eb2",
                                "text": "— Tu vas l’entraver à cette même place avec assez de longe pour arriver jusqu’à l’eau, dit Ouroz."
                            }
                        ]
                    },
                    {
                        "sense_id": "d78b6297-e210-303e-9d79-2f5cb2a8d585",
                        "entry_id": "4267d19e-748c-30c5-a344-7e633bc623b0",
                        "glosses": [
                            "Corde utilisée pour mener les animaux de ferme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf830f9-8e9e-4700-a668-c46969cf39b5",
                                "sense_id": "d78b6297-e210-303e-9d79-2f5cb2a8d585",
                                "text": "C’était là qu’il avait conduit les chevreaux, chacun ayant une longe de grosse ficelle nouée au cou."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1305213-f5cc-3034-93ed-726a8a4a5dbd",
                        "entry_id": "4267d19e-748c-30c5-a344-7e633bc623b0",
                        "glosses": [
                            "Petite corde ou lanière de cuir qu'on noue au pied de l'oiseau pour l'empêcher de s'envoler quand il n'est pas assuré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e08425c-def2-4dfb-a611-0f6fd1890e59",
                                "sense_id": "d1305213-f5cc-3034-93ed-726a8a4a5dbd",
                                "text": "Julien, dénouant ses longes, le lâchait tout à coup ; la bête hardie montait droit dans l’air comme une flèche."
                            },
                            {
                                "example_id": "238b0ef0-332f-458e-a350-7a39c35edd31",
                                "sense_id": "d1305213-f5cc-3034-93ed-726a8a4a5dbd",
                                "text": "Les oiseaux habitent ordinairement une vaste chambre, sorte de volière dans laquelle sont placés des blocs où le faucon est retenu au moyen d'une longe."
                            }
                        ]
                    },
                    {
                        "sense_id": "28ec32b7-46de-32f2-beb5-cb4e88f949cb",
                        "entry_id": "4267d19e-748c-30c5-a344-7e633bc623b0",
                        "glosses": [
                            "Courte corde utilisée en alpinisme, spéléologie, et dans des travaux en hauteur, servant à relier le baudrier à un point d’ancrage sécurisé."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0242b0e7-d114-37b6-a095-74934334eab5",
                        "entry_id": "4267d19e-748c-30c5-a344-7e633bc623b0",
                        "glosses": [
                            "Partie d’un fouet fait en général de cuir tressé, qui prolonge le manche et auquel s’attache la mèche."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "19b37fc6-4eeb-31ec-a59f-1ed8036b10d6",
                        "entry_id": "4267d19e-748c-30c5-a344-7e633bc623b0",
                        "glosses": [
                            "Petite embarcation de bord."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
