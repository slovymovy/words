                "senses": [
                    {
                        "sense_id": "ab047e4e-e4c3-39f5-8091-280ba716e4de",
                        "entry_id": "6602551f-ff3b-31f1-aa55-a002c22c642c",
                        "glosses": [
                            "fachlich durchgeführte Untersuchung und Auswertung des Bewegungsablaufs beim Laufen, meist zur Erkennung von Fehlbelastungen, zur Verbesserung der Lauftechnik oder zur Empfehlung geeigneter Laufschuhe"
                        ],
                        "tags": [
                            "Laufsport",
                            "Orthopädie"
                        ],
                        "examples": [
                            {
                                "example_id": "9bda815a-c3a4-41cf-b43a-02d8825b4cb3",
                                "sense_id": "ab047e4e-e4c3-39f5-8091-280ba716e4de",
                                "text": "„Mit einer Laufstilanalyse haben sie die Möglichkeit, Ihren persönlichen Laufstil ganz individuell anzupassen.“"
                            },
                            {
                                "example_id": "4957f639-49fc-4887-b26d-c7aefd40c4b7",
                                "sense_id": "ab047e4e-e4c3-39f5-8091-280ba716e4de",
                                "text": "„Mit Hilfe einer Laufstilanalyse kann festgestellt werden, ob bei dir eine Schrittverkürzung Sinn machen würde.“"
                            },
                            {
                                "example_id": "8d3be982-5343-4b59-b36e-604c0c3b6d5e",
                                "sense_id": "ab047e4e-e4c3-39f5-8091-280ba716e4de",
                                "text": "„Viel Abwechslung mit einem Langen Lauf, einem Waldlauf mit Lauf-ABC und einer Laufstilanalyse steht auf dem Programm.“"
                            },
                            {
                                "example_id": "ef52b344-b583-40ac-9da3-a8c967e7ad42",
                                "sense_id": "ab047e4e-e4c3-39f5-8091-280ba716e4de",
                                "text": "„Besonders für noch unerfahrene Läufer:innen [sic] ist eine Laufstilanalyse samt Befragung im Fachgeschäft eine gute Idee.“"
                            },
                            {
                                "example_id": "c04ed018-f3a9-49ff-a269-606119a4cbf5",
                                "sense_id": "ab047e4e-e4c3-39f5-8091-280ba716e4de",
                                "text": "„Eine professionelle Laufstilanalyse musste her, sagte der Orthopäde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
