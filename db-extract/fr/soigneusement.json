        "fr-extract.jsonl": [
            {
                "entry_id": "23b251ae-d8d2-35b5-8375-08c52d3018f8",
                "word": "soigneusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "65338fdf-16d1-3701-9778-0d14916b3558",
                        "entry_id": "23b251ae-d8d2-35b5-8375-08c52d3018f8",
                        "glosses": [
                            "D’une manière soigneuse ; avec soin ; avec attention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae4db443-7803-42f2-aba8-9c0e6497b16e",
                                "sense_id": "65338fdf-16d1-3701-9778-0d14916b3558",
                                "text": "Un capitaine réglait le feu : « A vous, Judin! » Le petit lignard visait soigneusement, lâchait la détente."
                            },
                            {
                                "example_id": "9483e2e8-ff22-44c4-9aef-002b54542dee",
                                "sense_id": "65338fdf-16d1-3701-9778-0d14916b3558",
                                "text": "Puis, avec un gros soupir, il replia les originaux, les serra dans la poche de côté de son veston et, très soigneusement, les remplaça dans le portefeuille par les copies qu’il avait faites."
                            },
                            {
                                "example_id": "263e8a18-cadb-420e-bef0-e078fbc46f65",
                                "sense_id": "65338fdf-16d1-3701-9778-0d14916b3558",
                                "text": "Si, avec un télescope d’une profonde puissance, nous examinons soigneusement le firmament, nous découvrirons une ceinture de groupes faite de ce que nous avons jusqu’à présent nommé des nébuleuses, […]."
                            },
                            {
                                "example_id": "fbc2d2e3-2350-494b-9f34-9af4c1da8e7c",
                                "sense_id": "65338fdf-16d1-3701-9778-0d14916b3558",
                                "text": "Quelques fumigations opportunément et soigneusement faites, et tout vibrion est anéanti."
                            },
                            {
                                "example_id": "b75443bc-ad09-4aab-9630-f16ceb1f2e7b",
                                "sense_id": "65338fdf-16d1-3701-9778-0d14916b3558",
                                "text": "Quand je considère quatre-vingt-dix ans si soigneusement ménagés ; quand je regarde ces années si pleines et si bien marquées par les bonnes œuvres,"
                            },
                            {
                                "example_id": "db186f56-2bf2-4bf7-8981-a77167defef8",
                                "sense_id": "65338fdf-16d1-3701-9778-0d14916b3558",
                                "text": "La pièce a été soigneusement nettoyée à grands coups de balai, de serpillière et de détergent afin de rendre l'endroit vivable."
                            },
                            {
                                "example_id": "e0fa83c4-5e89-4eff-aa73-4ecde8560eab",
                                "sense_id": "65338fdf-16d1-3701-9778-0d14916b3558",
                                "text": "Et les lettres passent ensuite à la censure qui raye soigneusement tout ce qui peut de près ou de loin ressembler à une indication d'ordre militaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e053e342-5bd3-4b9f-9296-b135586747d9",
                        "source_entry_id": "23b251ae-d8d2-35b5-8375-08c52d3018f8",
                        "source_sense_id": "65338fdf-16d1-3701-9778-0d14916b3558",
                        "target_lang_word": "sorgfältig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorgfältig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7d7120d-3aee-3012-a248-d0037cd06e41",
                                        "entry_id": "3a6ec86f-f6f6-37f7-b675-5338302b751c",
                                        "glosses": [
                                            "mit großer Achtsamkeit und Sorgfalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd398f6c-42fa-478e-863d-e03d6d1d7a53",
                                                "sense_id": "e7d7120d-3aee-3012-a248-d0037cd06e41",
                                                "text": "Die Nachrichten sind neue, wahrheitsmäßig und sorgfältig wiedergegebene Informationen."
                                            },
                                            {
                                                "example_id": "58ac83fc-5282-4860-af65-5c7217d89dd5",
                                                "sense_id": "e7d7120d-3aee-3012-a248-d0037cd06e41",
                                                "text": "„Das Licht im Patio war sorgfältig arrangiert, damit es den Damen schmeichelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf84083d-91a9-41cb-9845-fe2847267c04",
                        "source_entry_id": "23b251ae-d8d2-35b5-8375-08c52d3018f8",
                        "source_sense_id": "65338fdf-16d1-3701-9778-0d14916b3558",
                        "target_lang_word": "carefully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carefully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "Sorrowfully."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d576e34d-ceea-469a-92fe-9644ec612b52",
                                                "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                                                "text": "[…] there was she faine / To call them all in order to her ayde, / And them conjure, upon eternall paine, / To counsell her, so carefully dismayd, / How she might heale her sonne […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "With care; attentively, circumspectly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12f86b6-398b-4efc-8ec2-a7c8fde00a7b",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "As he was a politician, he discussed all subjects carefully, not offending anyone."
                                            },
                                            {
                                                "example_id": "44d6896b-126b-4311-8dd1-6153bab77d62",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "He carefully studied the papers, while planning his next move."
                                            },
                                            {
                                                "example_id": "e910d059-3f2c-4dd6-9a4a-871e8e7a1de1",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "He carefully avoided the subject all evening."
                                            },
                                            {
                                                "example_id": "6a2cba9f-d721-4c60-9a4e-db2d04a144f6",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "Then his sallow face brightened, for the hall had been carefully furnished, and was very clean. ¶ There was a neat hat-and-umbrella stand, and the stranger's weary feet fell soft on a good, serviceable dark-red drugget, which matched in colour the flock-paper on the walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae99e69-97d0-3703-bec2-85db2d0e75a0",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "Conscientiously, painstakingly, fastidiously, meticulously"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2eff25d5-b70c-416e-8c62-be41194fffa2",
                        "source_entry_id": "23b251ae-d8d2-35b5-8375-08c52d3018f8",
                        "source_sense_id": "65338fdf-16d1-3701-9778-0d14916b3558",
                        "target_lang_word": "meticulously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meticulously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92061a75-0202-3c92-9f43-c6e01331f9be",
                                        "entry_id": "37b3d378-ac3c-333c-bac6-c2278238178c",
                                        "glosses": [
                                            "In a meticulous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66af1d3b-3698-48e2-8ec6-f1da176d0165",
                                                "sense_id": "92061a75-0202-3c92-9f43-c6e01331f9be",
                                                "text": "Near-synonyms: carefully, methodically, precisely, rigorously, scrupulously, thoroughly"
                                            },
                                            {
                                                "example_id": "9db544c8-4e24-4cdf-abba-13b4783e4d68",
                                                "sense_id": "92061a75-0202-3c92-9f43-c6e01331f9be",
                                                "text": "In fact, they ran that forty-three minutes’ meeting so meticulously, they even took input from the public with predictable results."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e231cd52-da2b-48e6-99e0-81ab03faee89",
                        "source_entry_id": "23b251ae-d8d2-35b5-8375-08c52d3018f8",
                        "source_sense_id": "65338fdf-16d1-3701-9778-0d14916b3558",
                        "target_lang_word": "neatly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neatly",
