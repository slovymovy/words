                ],
                "senses": [
                    {
                        "sense_id": "ac9147a4-723c-3d1c-b82e-5ab818609923",
                        "entry_id": "2acf1b12-8b5d-3738-afa4-db6556c47469",
                        "glosses": [
                            "To treat (water) with kerosene in order to exterminate mosquitoes."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fccf70a9-4905-411a-bede-1e00a8048a76",
                                "sense_id": "ac9147a4-723c-3d1c-b82e-5ab818609923",
                                "text": "Over a four-year period the RF led a large-scale assault on yellow fever's Aedes aegypti mosquito vector, organizing a small army of Mexican and American doctors and local assistants and spending hundreds of thousands of dollars to spray, petrolize, drain, fill, and deposit larvicidal fishes in virtually every home, breeding site, and stagnant water source in the region of Veracruz."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7a5ed1a-4ec3-32cf-9370-ff3a5b185fc2",
                        "entry_id": "2acf1b12-8b5d-3738-afa4-db6556c47469",
                        "glosses": [
                            "To convert into a petroleum-based economy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c3faa95-0913-4f66-9a9c-1952b614a33b",
                                "sense_id": "f7a5ed1a-4ec3-32cf-9370-ff3a5b185fc2",
                                "text": "Once oil accounts for 30 percent of a nation's exports, the money petrolizes the place, the same way human slavery changed Rome, Brazil, and the U.S. South."
                            },
                            {
                                "example_id": "e2d17dfc-928d-4e5b-95d6-44229f251e8e",
                                "sense_id": "f7a5ed1a-4ec3-32cf-9370-ff3a5b185fc2",
                                "text": "Despite the efforts taken to forestall them, Mexico found itself with all the symptoms of a “petrolized” economy."
                            },
                            {
                                "example_id": "b6091f81-2a35-4357-ab84-6a20b15f2b03",
                                "sense_id": "f7a5ed1a-4ec3-32cf-9370-ff3a5b185fc2",
                                "text": "The Mexican economy did not 'petrolize', as happened in Venezuela, since oil production represented only between 10 per cent and 14 per cent of GDP in this period."
                            }
                        ]
                    }
                ],
