                                        "entry_id": "cfbd18d2-56c7-3573-a1d8-70df04cf6e2d",
                                        "glosses": [
                                            "w systemie miar typograficznych Didota stopień pisma odpowiadający sześciu punktom (2,2554 mm)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c25f477-700d-4f61-bf37-cde4d289dc64",
                                                "sense_id": "db4e611b-ae69-36e5-9a08-e0ddbeb89c00",
                                                "text": "Gazeta zamieściła sprostowanie na przedostatniej stronie, napisane nonparelem, wśród ogłoszeń, których i tak nikt nie czyta."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
