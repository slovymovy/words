                "senses": [
                    {
                        "sense_id": "375c948a-49fb-362a-a9a9-d2990cabbb6d",
                        "entry_id": "a3749425-79dc-3cd5-8ca7-68c7411ad0fa",
                        "glosses": [
                            "воен. сокр. от морской пехотинец; военнослужащий морской пехоты"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "00ab180d-6ff4-42a6-98bc-f4b9a9d84894",
                                "sense_id": "375c948a-49fb-362a-a9a9-d2990cabbb6d",
                                "text": "Можно ещё позавидовать мобильности армии США ― через тысячи километров перебрасывались вместе со своими тыловыми подразделениями не только парашютисты и морпехи, но и бронетанковые части."
                            },
                            {
                                "example_id": "20157ef6-56d5-43c0-b2fb-d656a1d004cd",
                                "sense_id": "375c948a-49fb-362a-a9a9-d2990cabbb6d",
                                "text": "Морпехи, десантники представали в моих глазах настоящими героями, сызмальства хотелось им подражать."
                            }
                        ]
                    }
