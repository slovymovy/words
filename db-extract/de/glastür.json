                        "form": "die Glastür"
                    },
                    {
                        "form_id": "a04eb4d1-a498-4f2c-b124-8d5ce067df90",
                        "entry_id": "6b07a643-12b1-3e10-861e-ace9337bface",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Glastüren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d423f54-ab0b-38da-a27d-a44c3893d5dc",
                        "entry_id": "6b07a643-12b1-3e10-861e-ace9337bface",
                        "glosses": [
                            "Tür, hergestellt aus Glas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44197fd0-f598-4d20-b989-bc2df73d7326",
                                "sense_id": "4d423f54-ab0b-38da-a27d-a44c3893d5dc",
                                "text": "„Er gab mir die Hand und ging rasch mit der Schwester durch die Glastür in den kalkweiß erleuchteten Saal.“"
                            },
                            {
                                "example_id": "b87e0ee2-40d1-4fe5-b487-35ae32b4ba45",
                                "sense_id": "4d423f54-ab0b-38da-a27d-a44c3893d5dc",
                                "text": "„Als sie Arm in Arm auf schwankenden Beinen durch die Glastür torkelten, hätte man sie für ein lebendes Symbol interdisziplinärer Verständigung halten können.“"
                            },
                            {
                                "example_id": "9a1c406e-05ed-4734-a309-2bf3bd0e3f13",
                                "sense_id": "4d423f54-ab0b-38da-a27d-a44c3893d5dc",
                                "text": "„An dem Tag, als er mit den Pferden ankam, hatte sie ihn am Arm gefaßt und, als sie den Salon betraten, wie selbstverständlich geküßt, flüchtig, denn sie wußte, daß der alte Velisar sie durch die Glastür hindurch beobachtete.“"
                            },
                            {
                                "example_id": "f7ff9f08-9f20-4ee6-9b2c-5884d1e8f094",
                                "sense_id": "4d423f54-ab0b-38da-a27d-a44c3893d5dc",
                                "text": "„Zur Straße hin besteht die Wand aus Glastüren.“"
                            },
                            {
                                "example_id": "7ffd545e-c0af-40e7-ae92-973cab765fde",
                                "sense_id": "4d423f54-ab0b-38da-a27d-a44c3893d5dc",
                                "text": "„Er seinerseits hatte zugesehen, wie Frans verprügelt wurde. Der Vater merkte nie, wenn jeemand hinter der Glastür stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
