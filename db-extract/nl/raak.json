                                "sense_id": "d7e01848-fef4-3c53-91ec-79b2ba6aec1e",
                                "text": "Dat was een rake opmerking.",
                                "translation": "“That remark was right on the mark.”",
                                "english": "“That remark was right on the mark.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "21d39eec-0675-376f-8c02-2e5020e5c1f4",
                        "entry_id": "3dc35e53-8788-3e19-990a-90acb859642a",
                        "glosses": [
