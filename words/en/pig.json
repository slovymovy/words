    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8807f888-b3f1-32d0-b9eb-eacf8fd768a4",
                    "sense_definition": "A farm animal with pink, black, or brown skin, short legs, a curved tail, and a flat nose, kept for its meat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer went to the barn to feed the <w>pigs</w>.",
                            "target_lang_translations": {
                                "ru": "Фермер пошел в сарай, чтобы покормить <w>свиней</w>.",
                                "zh": "农夫去谷仓喂<w>猪</w>。"
                            }
                        },
                        {
                            "text": "Wild <w>pigs</w> can be found in the forest foraging for food.",
                            "target_lang_translations": {
                                "ru": "Диких <w>свиней</w> можно встретить в лесу в поисках пищи.",
                                "zh": "在森林里可以找到正在觅食的野<w>猪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hog",
                        "swine",
                        "porker"
                    ],
                    "common_phrases": [
                        "when pigs fly",
                        "guinea pig",
                        "pig in a poke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сельскохозяйственное животное с розовой, черной или коричневой кожей, короткими ногами и пятачком, которое разводят ради мяса.",
                        "zh": "一种农场动物，皮肤呈粉色、黑色或棕色，腿短，尾巴弯曲，鼻子扁平，因其肉而被饲养。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свинья",
                                "target_lang_sense_clarification": "животное"
                            },
                            {
                                "target_lang_word": "хрюшка",
                                "target_lang_sense_clarification": "разговорное/детское"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猪",
                                "target_lang_sense_clarification": "动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2fe161d-d7c7-3eaf-9763-39e14d74fd6a",
                    "sense_definition": "A person who eats too much or eats very messily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_derogatory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>pig</w> and leave some cake for the rest of us.",
                            "target_lang_translations": {
                                "ru": "Не будь такой <w>свиньёй</w> и оставь нам немного торта.",
                                "zh": "别像个<w>猪猡</w>一样，给我们剩下点蛋糕。"
                            }
                        },
                        {
                            "text": "He made a <w>pig</w> of himself at the buffet dinner.",
                            "target_lang_translations": {
                                "ru": "Он вел себя как <w>свинья</w> на фуршете.",
                                "zh": "他在自助餐上吃得像头<w>猪</w>一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "glutton",
                        "gorger",
                        "hog"
                    ],
                    "common_phrases": [
                        "make a pig of oneself",
                        "eat like a pig"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to criticize behavior"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ест слишком много или очень неаккуратно.",
                        "zh": "吃得太多或吃相非常难看的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свинья",
                                "target_lang_sense_clarification": "обжора"
                            },
                            {
                                "target_lang_word": "обжора",
                                "target_lang_sense_clarification": "человек, который много ест"
                            },
                            {
                                "target_lang_word": "свинтус",
                                "target_lang_sense_clarification": "шутливое/разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猪猡",
                                "target_lang_sense_clarification": "贬义，指贪吃的人"
                            },
                            {
                                "target_lang_word": "大胃王",
                                "target_lang_sense_clarification": "指吃得很多的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74e42148-6c9b-3a7b-8312-124a7120d471",
                    "sense_definition": "A dirty, messy, or untidy person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_derogatory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His apartment is a mess because he lives like a <w>pig</w>.",
                            "target_lang_translations": {
                                "ru": "В его квартире бардак, потому что он живет как <w>свинья</w>.",
                                "zh": "他的公寓乱七八糟，因为他住得像个<w>邋遢鬼</w>。"
                            }
                        },
                        {
                            "text": "She called her brother a <w>pig</w> when she saw his filthy room.",
                            "target_lang_translations": {
                                "ru": "Она назвала брата <w>свиньёй</w>, когда увидела его грязную комнату.",
                                "zh": "当她看到弟弟那间肮脏的房间时，骂他是只<w>猪猡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slob",
                        "sloven"
                    ],
                    "common_phrases": [
                        "live like a pig"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грязный, неопрятный человек; неряха.",
                        "zh": "肮脏、邋遢或不整洁的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свинья",
                                "target_lang_sense_clarification": "неряха"
                            },
                            {
                                "target_lang_word": "грязнуля",
                                "target_lang_sense_clarification": "неопрятный человек"
                            },
                            {
                                "target_lang_word": "свинтус",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "邋遢鬼",
                                "target_lang_sense_clarification": "指不讲卫生的人"
                            },
                            {
                                "target_lang_word": "猪猡",
                                "target_lang_sense_clarification": "贬义，指肮脏的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e25762b8-86ab-32b9-aedb-e2bbc9bbf46e",
                    "sense_definition": "An unpleasant or offensive person, especially a man who is sexist.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_derogatory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She refused to talk to the <w>pig</w> who made rude comments about her appearance.",
                            "target_lang_translations": {
                                "ru": "Она отказалась разговаривать с этой <w>свиньёй</w>, который отпускал грубые комментарии о её внешности.",
                                "zh": "她拒绝与那个对她的外貌发表粗鲁评论的<w>沙文猪</w>交谈。"
                            }
                        },
                        {
                            "text": "He was acting like a chauvinist <w>pig</w> during the meeting.",
                            "target_lang_translations": {
                                "ru": "Он вел себя как шовинистская <w>свинья</w> во время собрания.",
                                "zh": "他在会议期间表现得像个大男子主义的<w>猪</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chauvinist pig",
                        "male chauvinist pig"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприятный или оскорбительный человек, особенно сексист.",
                        "zh": "令人不快或冒犯他人的人，尤指有性别歧视的男性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свинья",
                                "target_lang_sense_clarification": "грубое оскорбление"
                            },
                            {
                                "target_lang_word": "шовинист",
                                "target_lang_sense_clarification": "сексист"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沙文猪",
                                "target_lang_sense_clarification": "指大男子主义者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38b55fd4-aeca-363f-8acf-3f16fa5729d1",
                    "sense_definition": "A police officer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_derogatory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters shouted insults at the <w>pigs</w> standing in line.",
                            "target_lang_translations": {
                                "ru": "Протестующие выкрикивали оскорбления в адрес <w>ментов</w>, стоящих в оцеплении.",
                                "zh": "抗议者向排成一队的<w>条子</w>大声辱骂。"
                            }
                        },
                        {
                            "text": "He warned his friends that the <w>pigs</w> were patrolling the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Он предупредил друзей, что <w>мусора</w> патрулируют район.",
                                "zh": "他警告朋友们<w>条子</w>正在附近巡逻。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cop",
                        "copper",
                        "fuzz",
                        "flatfoot"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "highly offensive and derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полицейский (грубое сленговое выражение).",
                        "zh": "警察（粗俗的俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мент",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "мусор",
                                "target_lang_sense_clarification": "грубый сленг"
                            },
                            {
                                "target_lang_word": "легавый",
                                "target_lang_sense_clarification": "устаревший сленг"
                            }
