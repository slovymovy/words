    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b43a970d-3a59-38d2-87c5-adf568cb9142",
                    "sense_definition": "een constructie of gebouw oprichten door verschillende onderdelen of materialen samen te voegen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "constructie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De aannemer gaat volgend jaar een nieuw <w>huis</w> <w>bouwen</w> in deze straat.",
                            "target_lang_translations": {
                                "en": "The contractor is going to <w>build</w> a new <w>house</w> in this street next year."
                            }
                        },
                        {
                            "text": "Zij willen een <w>huis</w> <w>bouwen</w> dat volledig op zonne-energie werkt.",
                            "target_lang_translations": {
                                "en": "They want to <w>build</w> a <w>house</w> that runs entirely on solar energy."
                            }
                        }
                    ],
                    "antonyms": [
                        "afbreken"
                    ],
                    "common_phrases": [
                        "een huis bouwen",
                        "een muur bouwen",
                        "een nest bouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "To erect a construction or building by joining different parts or materials together."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "build",
                                "target_lang_sense_clarification": "general term for creating structures"
                            },
                            {
                                "target_lang_word": "construct",
                                "target_lang_sense_clarification": "more formal term for building or assembling"
                            },
                            {
                                "target_lang_word": "erect",
                                "target_lang_sense_clarification": "specifically for vertical structures like walls or buildings"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75940d22-bbc3-3b19-a1bc-3550978bc041",
                    "sense_definition": "volledig vertrouwen op iemand of iets; rekenen op de steun van een ander",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vertrouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In moeilijke tijden kun je altijd op je beste <w>vrienden</w> <w>bouwen</w>.",
                            "target_lang_translations": {
                                "en": "In difficult times, you can always <w>rely</w> on your best <w>friends</w>."
                            }
                        },
                        {
                            "text": "Het is fijn om op <w>iemand</w> te <w>bouwen</w> die altijd zijn afspraken nakomt.",
                            "target_lang_translations": {
                                "en": "It is nice to <w>count</w> on <w>someone</w> who always keeps their appointments."
                            }
                        }
                    ],
                    "common_phrases": [
                        "op iemand bouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "To fully trust someone or something; to count on the support of another."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rely on",
                                "target_lang_sense_clarification": "to depend on someone with confidence"
                            },
                            {
                                "target_lang_word": "count on",
                                "target_lang_sense_clarification": "to expect someone to be there for you"
                            },
                            {
                                "target_lang_word": "build on",
                                "target_lang_sense_clarification": "to use someone's support as a foundation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83d6dce2-a522-3e95-a08c-35dc9a340b74",
                    "sense_definition": "het bewerken van land om gewassen te laten groeien",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boeren <w>bouwen</w> dit jaar graan op de vruchtbare akkers.",
                            "target_lang_translations": {
                                "en": "The farmers are <w>growing</w> grain on the fertile fields this year."
                            }
                        },
                        {
                            "text": "Het is zwaar werk om op deze droge grond <w>gewassen</w> te <w>bouwen</w>.",
                            "target_lang_translations": {
                                "en": "It is hard work to <w>cultivate</w> <w>crops</w> on this dry soil."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbouwen"
                    ],
                    "common_phrases": [
                        "gewassen bouwen",
                        "op het land bouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "To work the land in order to grow crops."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grow",
                                "target_lang_sense_clarification": "to cultivate plants or crops"
                            },
                            {
                                "target_lang_word": "cultivate",
                                "target_lang_sense_clarification": "to prepare and use land for crops"
                            },
                            {
                                "target_lang_word": "farm",
                                "target_lang_sense_clarification": "to manage land for agricultural production"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}