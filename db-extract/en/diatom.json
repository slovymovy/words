                                        "entry_id": "809edd17-3ddd-33ea-8a9a-745df2c73d48",
                                        "glosses": [
                                            "benaming voor een eencellige alg met een pantser van silica uit de stam Bacillariophyta, die ongeveer 10.000 soorten kent"
                                        ],
                                        "tags": [
                                            "protisten"
                                        ],
