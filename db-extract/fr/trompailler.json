                        "glosses": [
                            "Tromper (au sens de être infidèle à son conjoint)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d447cd54-fa4c-4493-b78e-546df5f695b5",
                                "sense_id": "daf2de63-ee4b-39d9-9f8e-32926ec797e8",
                                "text": "Et tout cela parce qu’il a plu à Basin pendant un an de me trompailler avec elle."
                            },
                            {
                                "example_id": "d1ce428e-a658-4573-9a38-87addada3fe8",
                                "sense_id": "daf2de63-ee4b-39d9-9f8e-32926ec797e8",
                                "text": "Ou épongeait-elle de la sorte un vague remords d'avoir trompaillé le type dont elle partageait alors la vie?"
