                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vaporisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>purger</w> le flacon de laque avant de l'utiliser sur vos cheveux."
