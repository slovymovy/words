    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de3ca7e0-061b-3c00-9f2b-fe72c631d389",
                    "sense_definition": "Publication quotidienne imprimée rendant compte de l'actualité politique, économique, sociale et culturelle.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "presse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, mon père achète le <w>journal</w> pour lire les actualités du jour."
                        },
                        {
                            "text": "Elle a trouvé une offre d'emploi intéressante en lisant les petites annonces dans le <w>journal</w>."
                        }
                    ],
                    "synonyms": [
                        "canard",
                        "feuille"
                    ],
                    "common_phrases": [
                        "article de journal",
                        "kiosque à journaux",
                        "lire le journal",
                        "marchand de journaux"
                    ]
                },
                {
                    "sense_id": "60f626ff-0168-350f-bbe2-19c2c2a143fa",
                    "sense_definition": "Émission d'information diffusée à la télévision ou à la radio présentant la synthèse des événements récents.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "presse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille regarde le <w>journal</w> de vingt heures pour connaître les dernières nouvelles."
                        },
                        {
                            "text": "J'écoute toujours le <w>journal</w> à la radio avant de partir au travail le matin."
                        }
                    ],
                    "common_phrases": [
                        "journal du soir",
                        "journal télévisé"
                    ]
                },
                {
                    "sense_id": "10c90ae0-dc7e-3953-baf3-9c76f5100705",
                    "sense_definition": "Écrit personnel et intime où une personne consigne ses pensées et le récit de son quotidien.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "ecrit_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son adolescence, elle écrit chaque soir quelques lignes dans son <w>journal</w>."
                        },
                        {
                            "text": "Il a commencé à tenir un <w>journal</w> pour raconter son voyage à travers le pays."
                        }
                    ],
                    "synonyms": [
                        "journal intime"
                    ],
                    "common_phrases": [
                        "tenir un journal"
                    ]
                },
                {
                    "sense_id": "4640ab4a-d65c-3614-9238-cddab4167b85",
                    "sense_definition": "Registre où sont notés chronologiquement, au jour le jour, des faits marquants ou des opérations professionnelles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "registre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capitaine du navire note scrupuleusement la trajectoire et le temps dans le <w>journal</w> de bord."
                        },
                        {
                            "text": "Le comptable vérifie chaque écriture enregistrée dans le <w>journal</w> financier de l'entreprise."
                        }
                    ],
                    "common_phrases": [
                        "journal de bord"
                    ]
                },
                {
                    "sense_id": "8b0d8862-b38b-37d7-a826-a784e525a9ec",
                    "sense_definition": "Ancienne unité de superficie correspondant à l'étendue de terre qu'un travailleur ou un attelage pouvait labourer en une journée.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mesure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux fermier possédait autrefois une vigne de trois <w>journaux</w> près de la rivière."
                        },
                        {
                            "text": "Cet acte notarié mentionne une parcelle agricole évaluée à un <w>journal</w> de terre labourable."
                        }
                    ],
                    "synonyms": [
                        "hommée"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Ancienne mesure agraire"
                        }
                    ]
                }
            ]
        },
