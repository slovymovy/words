    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "44433380-6ddb-38d8-9f19-8f930a0a469e",
                    "sense_definition": "przyimek komunikujący, że dana czynność lub stan ma miejsce wbrew niesprzyjającym okolicznościom lub przeszkodom",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poszliśmy na długi spacer <w>mimo</w> deszczu i silnego wiatru.",
                            "target_lang_translations": {
                                "ru": "Мы пошли на долгую прогулку <w>несмотря на</w> дождь и сильный ветер."
                            }
                        },
                        {
                            "text": "Zdecydował się kontynuować pracę <w>mimo</w> zmęczenia po nieprzespanej nocy.",
                            "target_lang_translations": {
                                "ru": "Он решил продолжить работу <w>вопреки</w> усталости после бессонной ночи."
                            }
                        }
                    ],
                    "synonyms": [
                        "pomimo",
                        "wbrew"
                    ],
                    "common_phrases": [
                        "mimo wszystko",
                        "mimo to"
                    ],
                    "target_lang_definitions": {
                        "ru": "предлог, указывающий на то, что действие или состояние происходит вопреки неблагоприятным обстоятельствам или препятствиям"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несмотря на",
                                "target_lang_sense_clarification": "вопреки обстоятельствам"
                            },
                            {
                                "target_lang_word": "вопреки",
                                "target_lang_sense_clarification": "наперекор чему-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a76184d5-4ec0-3bb1-88f9-afcdcd6b587f",
                    "sense_definition": "przyimek oznaczający ruch obok kogoś lub czegoś, mijając dany obiekt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szybki pociąg przemknął <w>mimo</w> stacji bez zatrzymywania się.",
                            "target_lang_translations": {
                                "ru": "Скоростной поезд промчался <w>мимо</w> станции без остановки."
                            }
                        },
                        {
                            "text": "Przeszła obojętnie <w>mimo</w> nas, jakby nas w ogóle nie znała.",
                            "target_lang_translations": {
                                "ru": "Она равнодушно прошла <w>мимо</w> нас, словно вообще не знала нас."
                            }
