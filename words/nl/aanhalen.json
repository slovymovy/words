{
    "word_family": [
        "aanhaling",
        "aanhalingsteken",
        "aanhalig"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "53f247ab-3131-393a-92fd-636b67e52dfa",
                    "sense_definition": "letterlijk overnemen wat iemand anders over een onderwerp gezegd of geschreven heeft",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "citeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij het <w>aanhalen</w> van andermans woorden in een tekst gebruiken we aanhalingstekens.",
                            "target_lang_translations": {
                                "en": "When <w>quoting</w> someone else's words in a text, we use quotation marks."
                            }
                        },
                        {
                            "text": "De student besloot een beroemde filosoof <w>aan</w> te <w>halen</w> in zijn scriptie.",
                            "target_lang_translations": {
                                "en": "The student decided to <w>cite</w> a famous philosopher in his thesis."
                            }
                        }
                    ],
                    "synonyms": [
                        "citeren"
                    ],
                    "common_phrases": [
                        "een bron aanhalen",
                        "iemand letterlijk aanhalen"
                    ],
                    "target_lang_definitions": {
                        "en": "To literally repeat or take over what someone else has said or written about a subject."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quote",
                                "target_lang_sense_clarification": "to repeat exact words"
                            },
                            {
                                "target_lang_word": "cite",
                                "target_lang_sense_clarification": "to refer to a source"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae9685f8-ac41-362c-b73e-deb275552f0b",
                    "sense_definition": "een emotionele of sociale band hechter en sterker maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "versterken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "India wil de banden met Iran <w>aanhalen</w>.",
                            "target_lang_translations": {
                                "en": "India wants to <w>strengthen</w> ties with Iran."
                            }
                        },
                        {
                            "text": "Na jaren van stilte probeerden de broers hun contact weer <w>aan</w> te <w>halen</w>.",
                            "target_lang_translations": {
                                "en": "After years of silence, the brothers tried to <w>renew</w> their contact."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de banden aanhalen",
                        "het contact aanhalen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make an emotional or social bond closer and stronger."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strengthen",
                                "target_lang_sense_clarification": "to make ties or bonds firmer"
                            },
                            {
                                "target_lang_word": "tighten",
                                "target_lang_sense_clarification": "to make a relationship closer"
                            },
                            {
                                "target_lang_word": "foster",
                                "target_lang_sense_clarification": "to encourage the development of a bond"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0237067-429c-3af3-8039-42b65c6be548",
                    "sense_definition": "iets fysiek strakker trekken of aanspannen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strakker maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zeiler moest de touwen stevig <w>aanhalen</w> vanwege de harde wind.",
                            "target_lang_translations": {
                                "en": "The sailor had to <w>tighten</w> the ropes firmly because of the strong wind."
                            }
                        },
                        {
                            "text": "De Vlaamse commerciële zender moet de buikriem fors <w>aanhalen</w>.",
                            "target_lang_translations": {
                                "en": "The Flemish commercial broadcaster has to <w>tighten</w> its belt significantly."
                            }
                        }
                    ],
                    "synonyms": [
                        "aansnoeren"
                    ],
                    "common_phrases": [
                        "de buikriem aanhalen",
                        "een knoop aanhalen"
                    ],
                    "target_lang_definitions": {
                        "en": "To physically pull something tighter or to tension it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tighten",
                                "target_lang_sense_clarification": "to make something more taut"
                            },
                            {
                                "target_lang_word": "pull tight",
                                "target_lang_sense_clarification": "to apply tension to a rope or belt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a04cca1-52ee-3362-aa24-581ee5c141bd",
                    "sense_definition": "door middel van vleierij, liefkozing of vriendelijkheid nader tot zich doen komen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liefkozen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "'s Avonds kunnen we onze kat wel <w>aanhalen</w> en komt hij zelfs bij ons op de bank liggen.",
                            "target_lang_translations": {
                                "en": "In the evening we can <w>pet</w> our cat and he even comes to lie with us on the couch."
                            }
                        },
                        {
                            "text": "Het kind probeerde de hond <w>aan</w> te <w>halen</w> met een zachte stem.",
                            "target_lang_translations": {
                                "en": "The child tried to <w>coax</w> the dog with a soft voice."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een dier aanhalen"
                    ],
                    "target_lang_definitions": {
                        "en": "To draw someone or an animal closer through flattery, caressing, or kindness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pet",
                                "target_lang_sense_clarification": "to stroke or caress an animal"
                            },
                            {
                                "target_lang_word": "cuddle",
                                "target_lang_sense_clarification": "to show affection through touch"
                            },
                            {
                                "target_lang_word": "coax",
                                "target_lang_sense_clarification": "to draw closer with kindness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32e06447-690f-3351-9e33-9ba3a3e6597c",
                    "sense_definition": "een argument of bewijs naar voren brengen om een standpunt te ondersteunen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "argumenteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De advocaat <w>haalde</w> verschillende bewijzen <w>aan</w> om de onschuld van zijn cliënt aan te tonen.",
                            "target_lang_translations": {
                                "en": "The lawyer <w>adduced</w> various pieces of evidence to demonstrate his client's innocence."
                            }
                        },
                        {
                            "text": "Tijdens de discussie <w>haalde</w> zij een belangrijk argument <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "During the discussion, she <w>brought up</w> an important argument."
                            }
                        }
                    ],
                    "synonyms": [
                        "inroepen"
                    ],
                    "common_phrases": [
                        "een argument aanhalen",
                        "bewijzen aanhalen"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring forward an argument or evidence to support a point of view."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cite",
                                "target_lang_sense_clarification": "to mention as an example or proof"
                            },
                            {
                                "target_lang_word": "adduce",
                                "target_lang_sense_clarification": "to offer as evidence in an argument"
                            },
                            {
                                "target_lang_word": "bring up",
                                "target_lang_sense_clarification": "to mention a point or argument"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "377bd2ff-fb24-3587-8e48-d3f9462f82e9",
                    "sense_definition": "iets tijdelijk in beslag nemen of vasthouden door een autoriteit",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "inbeslagname",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De douane besloot de verdachte goederen direct <w>aan</w> te <w>halen</w> voor onderzoek.",
                            "target_lang_translations": {
                                "en": "Customs decided to <w>seize</w> the suspicious goods immediately for investigation."
                            }
                        },
                        {
                            "text": "De politie <w>haalde</w> het voertuig <w>aan</w> omdat de papieren niet in orde waren.",
                            "target_lang_translations": {
                                "en": "The police <w>impounded</w> the vehicle because the papers were not in order."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanslaan",
                        "aanhouden",
                        "confisqueren"
                    ],
                    "common_phrases": [
                        "goederen aanhalen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "juridisch of formeel gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To temporarily seize or hold something by an authority."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seize",
                                "target_lang_sense_clarification": "to take legal possession of"
                            },
                            {
                                "target_lang_word": "impound",
                                "target_lang_sense_clarification": "to take into legal custody, like a vehicle"
                            },
                            {
                                "target_lang_word": "confiscate",
                                "target_lang_sense_clarification": "to take away by authority"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}