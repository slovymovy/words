                "senses": [
                    {
                        "sense_id": "507bb2c0-4ec4-329d-83fc-19897d959753",
                        "entry_id": "66f232dc-2b78-3de0-b323-ede80bd9908d",
                        "glosses": [
                            "äußerst sehenswertes und gelungenes Zuspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c15aabae-18da-4bcb-86b9-f93017abc7c2",
                                "sense_id": "507bb2c0-4ec4-329d-83fc-19897d959753",
                                "text": "„Andres Iniesta spielte einen Traumpass in den Strafraum.“"
                            },
                            {
                                "example_id": "394f8aac-e187-43d4-ad0d-c2a0abf9a728",
                                "sense_id": "507bb2c0-4ec4-329d-83fc-19897d959753",
                                "text": "„Die Führung leitete er mit einem Traumpass auf Rafael van der Vaart ein, der Paolo Guerrero bediente.“"
                            },
                            {
                                "example_id": "dd5c5825-c3e1-4a7e-8093-1217858e191c",
                                "sense_id": "507bb2c0-4ec4-329d-83fc-19897d959753",
                                "text": "„Unten auf dem Spielfeld wirft ein Manning einen Traumpass, oben in einer VIP-Loge reckt ein Manning die Faust in die Höhe. Die Mannings sind zwar nicht ganz so zahlreich, dass sie eine Franchise stellen könnten, aber als Familie sind sie durchaus eine Dynastie: Vater Archie und seine drei Söhne waren oder sind allesamt Footballspieler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
