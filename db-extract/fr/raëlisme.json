        "fr-extract.jsonl": [
            {
                "entry_id": "9fa45c0d-8c01-349a-94d3-1efff786bd65",
                "word": "raëlisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "81a49bde-334d-3193-8ff3-7575677ef9b2",
                        "entry_id": "9fa45c0d-8c01-349a-94d3-1efff786bd65",
                        "glosses": [
                            "Secte fondée par Raël prônant liberté sexuelle et contact avec les extraterrestres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e050a9fa-ddef-4abf-aa40-025ca3e52131",
                                "sense_id": "81a49bde-334d-3193-8ff3-7575677ef9b2",
                                "text": "Est-ce qu'on lui interdira de pratiquer pleinement sa croyance et sa liberté de conscience parce que le naturisme et le raëlisme ne sont pas \"de vraies religions\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0af3370-9429-4ddf-890e-51b863bea0d1",
                        "source_entry_id": "9fa45c0d-8c01-349a-94d3-1efff786bd65",
                        "source_sense_id": "81a49bde-334d-3193-8ff3-7575677ef9b2",
                        "target_lang_word": "Raëlism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raëlism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dfb5e93-b147-3ed5-8313-8b2eb69aaecb",
                                        "entry_id": "d97a9454-1d17-3fd2-be23-967c3d490707",
                                        "glosses": [
                                            "A UFO religion with liberal sexual views, holding that all life on Earth was created in scientific laboratories by extraterrestrials."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "579c0769-8558-47aa-80ca-e42ddc79286a",
                                                "sense_id": "4dfb5e93-b147-3ed5-8313-8b2eb69aaecb",
                                                "text": "Raëlism differs from Deistic Christianity."
                                            },
                                            {
                                                "example_id": "be6e11a1-824d-4dcf-aedf-089a2e110887",
                                                "sense_id": "4dfb5e93-b147-3ed5-8313-8b2eb69aaecb",
                                                "text": "In fact, it is only size itself that separates Raëlism from Christianity or any other accepted religion. Absurdity of beliefs clearly doesn't distinguish a cult."
                                            },
                                            {
                                                "example_id": "fa253540-ce00-4ee9-9c68-ad9b6d40a94c",
                                                "sense_id": "4dfb5e93-b147-3ed5-8313-8b2eb69aaecb",
                                                "text": "In December 2002, Clonaid, the medical arm of a religion called Raëlism, who believe that aliens introduced human life on Earth, claimed to have successfully cloned a human being."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "081a6601-2af4-4d59-976c-fa57629c0df8",
                        "source_entry_id": "9fa45c0d-8c01-349a-94d3-1efff786bd65",
                        "source_sense_id": "81a49bde-334d-3193-8ff3-7575677ef9b2",
                        "target_lang_word": "Raelianism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raelianism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd22793b-70e4-37e6-a73d-fa60da738866",
                                        "entry_id": "bdf4add8-c58c-3b01-803e-55c762f5118e",
                                        "glosses": [
                                            "Synonym of Raëlism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f60980-c5ab-479b-9709-e9cf838eca43",
                                                "sense_id": "fd22793b-70e4-37e6-a73d-fa60da738866",
                                                "text": "Raelianism seemed to offer such a faith, and with its appeal to an ancient past filled with alien beings, it offered a historical richness that UFO cults like Unarias could not quite match."
                                            },
                                            {
                                                "example_id": "68934562-21a7-42cb-a9e7-2cc1118e3c84",
                                                "sense_id": "fd22793b-70e4-37e6-a73d-fa60da738866",
                                                "text": "This was understandable, for a basic teaching of Raelianism is that human life on Earth was created by scientists from another planet who want to return to Earth to meet their creations."
                                            },
                                            {
                                                "example_id": "e9ceefb6-c1b4-43ec-905e-6bc24e5b8f5c",
                                                "sense_id": "fd22793b-70e4-37e6-a73d-fa60da738866",
                                                "text": "Of course, this would only apply if other religious approaches – such as Scientology or Raelianism – are being taught as science."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1ead8bf-08ee-432f-9808-e906e5ed4a5b",
                        "source_entry_id": "9fa45c0d-8c01-349a-94d3-1efff786bd65",
