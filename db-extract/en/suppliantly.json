                        "glosses": [
                            "In a suppliant manner; in a humble or earnestly pleading manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "374e2c0c-f73d-40ee-9194-2c3978829db2",
                                "sense_id": "18689c90-fa1d-3997-97a8-a7657b1479aa",
                                "text": "Come hither, boy, and standing suppliantly,\nLay hand upon the father that begat thee,\nAnd sitting in the guise of one who prays,\nHold in thy hands my locks, and hers, and thine,\nA treasure of entreaty."
                            },
                            {
                                "example_id": "bb6f9f74-4116-455d-bac0-c161120f6247",
                                "sense_id": "18689c90-fa1d-3997-97a8-a7657b1479aa",
                                "text": "Suppliantly he begs, both for himself and for two miserable persons: make this one young, O Cytherean goddess, and this one make virile."
                            }
                        ]
                    }
                ],
