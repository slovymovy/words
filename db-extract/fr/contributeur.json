                        "sense_id": "a864377f-caea-3ecf-81e9-e2c0304dfd1a",
                        "entry_id": "d6fec2c9-4cfe-3deb-8052-1832af906f39",
                        "glosses": [
                            "Personne physique ou morale qui participe financièrement au fonctionnement d’un organisme ou d’une institution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "504849dd-8a36-4c5a-942f-24f40517c6de",
                                "sense_id": "a864377f-caea-3ecf-81e9-e2c0304dfd1a",
                                "text": "Pour 2006, les plus gros contributeurs au budget de l’UE sont l’Allemagne, dont la contribution doit s’élever à 20,56 % du budget 2006, la France avec 16,43 %, l’Italie avec 13,70 % et le Royaume-Uni avec 12,36 %."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6f3db97-0fa7-3b4a-9e49-0154a79dfb85",
                        "entry_id": "d6fec2c9-4cfe-3deb-8052-1832af906f39",
                        "glosses": [
                            "Personne qui collabore à l’écriture d’une œuvre commune, à la réalisation d’un projet collectif, notamment sur le réseau mondial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24c06496-5724-49b6-b8cd-16b64c40d3f6",
                                "sense_id": "b6f3db97-0fa7-3b4a-9e49-0154a79dfb85",
                                "text": "« Cent mille contributeurs uniques », espère Emmanuel Grégoire, premier adjoint d’Anne Hidalgo."
                            }
                        ]
                    }
                ],
