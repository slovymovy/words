                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49285a06-2f69-49d9-93a7-0016297fff89",
                        "source_entry_id": "fdc35d4d-e1fb-37c2-a1c0-e4c81f8d085f",
                        "source_sense_id": "138bfc9a-bd86-3b4b-8e4d-a5dfbea313b5",
