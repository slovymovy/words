                        ],
                        "examples": [
                            {
                                "example_id": "cd8a3db1-d8e4-4908-8cad-49849ede16eb",
                                "sense_id": "9bb40cc6-032b-3e4b-a6d7-c2f5c3d6acfc",
                                "text": "Бурлаки потянули бечеву — и всё ни с места.",
                                "translation": "Les haleurs ont tiré sur la corde - et tout avec."
                            }
                        ]
