                                    {
                                        "sense_id": "14d89830-b62f-318a-88d3-834e4a1ac116",
                                        "entry_id": "2d960415-32b7-3df1-9569-0e9580aacb48",
                                        "glosses": [
                                            "Kraftlossein; kraftloser Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a2c766-84d9-40ee-b9c8-32d36ad397b0",
                                                "sense_id": "14d89830-b62f-318a-88d3-834e4a1ac116",
                                                "text": "„Schmerzen und Kraftlosigkeit im Arm sind nur ein Symptom, wenn die permanente Überlastung zum so genannten.“"
