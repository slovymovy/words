                "senses": [
                    {
                        "sense_id": "72588bf0-0fb6-31da-9a57-859cefb57a23",
                        "entry_id": "bf232ed9-c6c0-3a23-aa21-10a86d05fa86",
                        "glosses": [
                            "zähflüssige, klebrige Masse aus gekochtem Hafer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfe06ed8-5fae-4dee-b426-71a8365adc8b",
                                "sense_id": "72588bf0-0fb6-31da-9a57-859cefb57a23",
                                "text": "Aufgekocht ergeben die Haferflocken den Haferschleim."
                            },
                            {
                                "example_id": "8e7ab4ce-6fe3-4876-995d-64bb8ab90455",
                                "sense_id": "72588bf0-0fb6-31da-9a57-859cefb57a23",
                                "text": "„‚[…] In Charles Dickens‘ Roman Oliver Twist werden die Armen mit Haferschleim abgespeist und dabei, wie der Schriftsteller meint, nur ihrem Hunger überlassen.“"
                            },
                            {
                                "example_id": "94fdbd24-7735-4447-b1bf-39fa6b8cdee5",
                                "sense_id": "72588bf0-0fb6-31da-9a57-859cefb57a23",
                                "text": "„Die Reiswasserstühle haben nach der verschiedenen Proportion des darin enthaltenen Schleimes auch eine verschiedene Dichtigkeit: sie sehen dem Haferschleime, den Molken, dem Reiswasser ähnlich oder sind dicklich, von gallertartigem froschlaichartigem Aussehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
