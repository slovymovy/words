{
    "word_family": [
        "lieutenancy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e3b3831-d772-397f-905f-35358d52156b",
                    "sense_definition": "A junior commissioned officer in the armed forces, typically ranking below a captain in the army or below a lieutenant commander in the navy.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "military_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lieutenant</w> ordered the platoon to secure the perimeter.",
                            "target_lang_translations": {
                                "ru": "<w>Лейтенант</w> приказал взводу обеспечить безопасность периметра.",
                                "zh": "<w>中尉</w>命令排队确保周边安全。"
                            }
                        },
                        {
                            "text": "After completing officer training, she was commissioned as a second <w>lieutenant</w>.",
                            "target_lang_translations": {
                                "ru": "После завершения офицерской подготовки ей было присвоено звание младшего <w>лейтенанта</w>.",
                                "zh": "完成军官培训后，她被任命为<w>少尉</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Lt.",
                        "Lieut."
                    ],
                    "common_phrases": [
                        "first lieutenant",
                        "second lieutenant",
                        "flight lieutenant",
                        "police lieutenant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Младшее офицерское звание в вооруженных силах, обычно ниже капитана в армии или капитан-лейтенанта во флоте.",
                        "zh": "军队中的初级军官，通常军衔低于陆军上尉或海军少校。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лейтенант",
                                "target_lang_sense_clarification": "современное воинское звание"
                            },
                            {
                                "target_lang_word": "поручик",
                                "target_lang_sense_clarification": "историческое звание (до 1917 г.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中尉",
                                "target_lang_sense_clarification": "现代军队中的军衔"
                            },
                            {
                                "target_lang_word": "少尉",
                                "target_lang_sense_clarification": "军队中的初级军官"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e557c99e-a483-3cd7-ba69-0a7876d63c54",
                    "sense_definition": "A person who acts as a deputy, substitute, or trusted assistant to a superior.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deputy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The CEO called a meeting with his top <w>lieutenants</w> to discuss the new strategy.",
                            "target_lang_translations": {
                                "ru": "Генеральный директор созвал совещание со своими главными <w>помощниками</w>, чтобы обсудить новую стратегию.",
                                "zh": "首席执行官召集了他的核心<w>副手</w>开会，讨论新战略。"
                            }
                        },
                        {
                            "text": "He served as a loyal <w>lieutenant</w> to the party leader for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Он служил верным <w>помощником</w> лидеру партии более двадцати лет.",
                                "zh": "他作为党魁忠诚的<w>心腹</w>服务了二十多年。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "trusted lieutenant",
                        "top lieutenant",
                        "loyal lieutenant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, действующий как заместитель или доверенный помощник руководителя.",
                        "zh": "担任副手、代理人或上级心腹助手的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помощник",
                                "target_lang_sense_clarification": "доверенное лицо"
                            },
                            {
                                "target_lang_word": "заместитель",
                                "target_lang_sense_clarification": "официальная должность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "副手",
                                "target_lang_sense_clarification": "协助主要领导的人"
                            },
                            {
                                "target_lang_word": "心腹",
                                "target_lang_sense_clarification": "受信任的助手"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "134ffead-2ffd-349f-9bab-aa10b396e54d",
                    "sense_definition": "Designating an officer or official who holds a rank immediately below the one named in the title.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "modifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>lieutenant</w> colonel is a senior field officer in the army.",
                            "target_lang_translations": {
                                "ru": "<w>Под</w>полковник — это старший офицер в армии.",
                                "zh": "<w>中</w>校是陆军中的高级野战军官。"
                            }
                        },
                        {
                            "text": "The <w>lieutenant</w> governor assumes the duties of the governor when necessary.",
                            "target_lang_translations": {
                                "ru": "<w>Вице</w>-губернатор берет на себя обязанности губернатора при необходимости.",
                                "zh": "<w>副</w>州长在必要时承担州长的职责。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lieutenant colonel",
                        "lieutenant general",
                        "lieutenant commander",
                        "lieutenant governor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обозначает офицера или чиновника, занимающего ранг непосредственно ниже названного в титуле.",
                        "zh": "指代军衔或职位仅次于头衔中所述级别的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вице-",
                                "target_lang_sense_clarification": "приставка в гражданских должностях (напр. вице-губернатор)"
                            },
                            {
                                "target_lang_word": "под-",
                                "target_lang_sense_clarification": "приставка в воинских званиях (напр. подполковник)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "副",
                                "target_lang_sense_clarification": "用于职位名称前表示次一级"
                            },
                            {
                                "target_lang_word": "中",
                                "target_lang_sense_clarification": "用于军衔前表示次一级"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}