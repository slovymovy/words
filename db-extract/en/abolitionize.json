                "senses": [
                    {
                        "sense_id": "e77b614e-e947-3883-ae57-5d4b6f6c0ddb",
                        "entry_id": "85f2e219-3341-3b3d-baf2-509c1cc74996",
                        "glosses": [
                            "To imbue with the principles of abolitionism."
                        ],
                        "tags": [
                            "obsolete",
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b542c24c-a1b1-44d1-a6cb-2247371fa9ff",
                                "sense_id": "e77b614e-e947-3883-ae57-5d4b6f6c0ddb",
                                "text": "It will abolitionize the world. It will remove all objections but such as spring from negro prejudice."
                            },
                            {
                                "example_id": "650c2426-8aef-4a61-8bdd-b3bcbdf7486b",
                                "sense_id": "e77b614e-e947-3883-ae57-5d4b6f6c0ddb",
                                "text": "The public mind has been naturally excited on the position of the American Tract Society, threatened as it has been for months past by a party of revolutionists, determined to expel its Executive Committee, and abolitionize the institution."
                            },
                            {
                                "example_id": "a39aac83-8cde-4933-a657-3a5f7a75d88b",
                                "sense_id": "e77b614e-e947-3883-ae57-5d4b6f6c0ddb",
                                "text": "The question is, will the people, by a constitutional provision, abolitionize the State and thereby legalize the unconstitutional acts of the Administration for the abolition of slavery?"
                            }
                        ]
                    }
