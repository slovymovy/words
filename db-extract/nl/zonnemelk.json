                "senses": [
                    {
                        "sense_id": "f1f02e46-ded0-3fdd-becf-3884182091c9",
                        "entry_id": "61e05053-b876-3e70-95c4-58cf10d01bbf",
                        "glosses": [
                            "een crème die op de huid aangebracht kan worden ter bescherming tegen zonlicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e944d2f4-e2d9-4ca8-a026-8219a0fa7f4b",
                                "sense_id": "f1f02e46-ded0-3fdd-becf-3884182091c9",
                                "text": "Ik smeer ze ook in met zonnemelk, want die varkenshuid is heel dun."
                            },
                            {
                                "example_id": "042f0a52-038f-46bd-9b0b-303de1bbfe24",
                                "sense_id": "f1f02e46-ded0-3fdd-becf-3884182091c9",
                                "text": "Goede recensies en mond-tot-mond-reclame maakten deze zonnemelk hét zonnebeschermingsproduct van het jaar."
                            },
                            {
                                "example_id": "2616a7f0-3ec0-44ca-a558-7bade565303c",
                                "sense_id": "f1f02e46-ded0-3fdd-becf-3884182091c9",
                                "text": "Kan die aangebroken fles zonnemelk nog een jaartje mee?: Met de zomer in aantocht ontdekken we achterin de kast nog een aangebroken fles zonnebrandcrème. Kan die nog een vakantie mee? En als we een nieuwe fles kopen, is een dure crème dan altijd beter? En voor straks op het strand: hoe vaak moeten we smeren?"
                            }
                        ]
                    }
