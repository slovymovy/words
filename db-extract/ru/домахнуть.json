                        "examples": [
                            {
                                "example_id": "471bea39-b8c5-4bad-a7b6-a7f8d123d151",
                                "sense_id": "f184a9d5-2fc2-3f49-9863-55d217af23b1",
                                "text": "Зверь же навстречу той боли прёт, лапой с когтями домахнуть до охотника жаждет, пена из пасти течёт."
                            }
                        ]
                    },
                    {
