                {
                    "sense_id": "15b9bad2-707a-38db-8874-3d52dcbcf84f",
                    "sense_definition": "Être contraint ou légalement obligé de faire quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque citoyen est <w>tenu</w> de respecter les lois établies par le pays."
                        },
                        {
                            "text": "L'employeur est strictement <w>tenu</w> d'assurer la sécurité de tout son personnel."
