        "nl-extract.jsonl": [
            {
                "entry_id": "6c88b00b-5f04-338f-be9f-6232f4abd7b8",
                "word": "mitose",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b2ee60b6-3adf-3a62-a7ce-a89a9687623d",
                        "entry_id": "6c88b00b-5f04-338f-be9f-6232f4abd7b8",
                        "glosses": [
                            "gewone celdeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4520f5d7-c3c4-43d9-b8ff-5dfeece38a87",
                                "sense_id": "b2ee60b6-3adf-3a62-a7ce-a89a9687623d",
                                "text": "Bij mitose ontstaan twee identieke dochtercellen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff329ce6-f0da-4858-ba75-fe59e3294c7c",
                        "source_entry_id": "6c88b00b-5f04-338f-be9f-6232f4abd7b8",
                        "source_sense_id": "b2ee60b6-3adf-3a62-a7ce-a89a9687623d",
                        "source_sense_description": "(biologie) gewone celdeling",
                        "target_lang_word": "Mitose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99b06ab1-02e9-3cae-8e74-4644932c9a77",
                                        "entry_id": "34d898ad-b96d-3cc3-ab00-cb5d14c55f3a",
                                        "glosses": [
                                            "Teilung des Zellkerns, die vor der Teilung des Zellplasmas (Cytoplasmas) stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e64e97bd-3b72-48a3-a724-1e174e093ee6",
                                                "sense_id": "99b06ab1-02e9-3cae-8e74-4644932c9a77",
                                                "text": "Die Mitose ermöglicht, dass beide Tochterzellen die gleiche Anzahl an Chromosomen und damit die gleiche Erbinformation erhalten."
                                            },
                                            {
                                                "example_id": "cfdbcbb3-fd5e-4260-8db5-e4fec13048ce",
                                                "sense_id": "99b06ab1-02e9-3cae-8e74-4644932c9a77",
                                                "text": "Während der Mitose werden die Chromosomen mit ihren Kinetochoren am mitotischen Spindelapparat angeheftet und auf die beiden Tochterzellen verteilt."
                                            },
                                            {
                                                "example_id": "c841dc8f-adc5-4d82-b48a-f8c08c49f0e3",
                                                "sense_id": "99b06ab1-02e9-3cae-8e74-4644932c9a77",
                                                "text": "Nach ihrer Qualitätskontrolle (G2) trennen sich im vierten Schritt erst die Chromosomen, dann die ganzen Zellen (Mitose), und der Reigen kann neu beginnen."
                                            },
                                            {
                                                "example_id": "ee15343e-07eb-45e0-8567-a442b2d74f78",
                                                "sense_id": "99b06ab1-02e9-3cae-8e74-4644932c9a77",
                                                "text": "Hier kommen die Checkpoint-Proteine ins Spiel: Sie kontrollieren, ob die Erbgutverdoppelung ordentlich gelungen ist. Wenn nicht, stirbt die Zelle, falls doch, darf es mit der G2-Phase weitergehen, die in die M-Phase (M für Mitose, Zellteilung) mündet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "587f7424-0bf6-470b-bbd1-30715ec2c123",
                        "source_entry_id": "6c88b00b-5f04-338f-be9f-6232f4abd7b8",
                        "source_sense_id": "b2ee60b6-3adf-3a62-a7ce-a89a9687623d",
                        "source_sense_description": "(biologie) gewone celdeling",
                        "target_lang_word": "mitosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fca3c2c7-3cb1-36a3-b419-605543caf2be",
                                        "entry_id": "f8b4d33c-cf56-39a0-bcc3-33ae2c8843c7",
                                        "glosses": [
                                            "The division of a cell nucleus in which the genome is copied and separated into two identical halves. It is normally followed by cell division."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4fc6d9e-dde9-42c7-b132-ffe3b96007e1",
                                                "sense_id": "fca3c2c7-3cb1-36a3-b419-605543caf2be",
                                                "text": "Meronyms: prophase, metaphase, anaphase, telophase"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ceaf935-b001-4841-9981-0a8abcd9d328",
                        "source_entry_id": "6c88b00b-5f04-338f-be9f-6232f4abd7b8",
                        "source_sense_id": "b2ee60b6-3adf-3a62-a7ce-a89a9687623d",
                        "source_sense_description": "(biologie) gewone celdeling",
                        "target_lang_word": "mitose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd0cfca3-848d-3dcf-b892-c4009d05f624",
                                        "entry_id": "ef675ed0-30a3-3c58-a98d-870d2895f2d4",
                                        "glosses": [
                                            "Division cellulaire asexuée, contrairement à la méiose."
                                        ],
                                        "tags": [
                                            "Biologie cellulaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df63a1a3-5c8c-4bf0-8669-dc7cd92e6ed2",
                                                "sense_id": "bd0cfca3-848d-3dcf-b892-c4009d05f624",
                                                "text": "Lorsque le zygote se divise, chaque cellule fille reçoit une copie exacte et complète de son équipement chromosomique. Ce type de division est appelé mitose."
                                            },
                                            {
                                                "example_id": "f8b46f05-2609-4fba-b70e-a9c0f71df1c3",
                                                "sense_id": "bd0cfca3-848d-3dcf-b892-c4009d05f624",
                                                "text": "L’augmentation du pontage des collagènes chez le sujet âgé, la fragmentation de l’élastine au cours des mitoses font progressivement perdre aux tissus leur fermeté et leur souplesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "488009d7-393e-4fb6-9ad2-324b47049623",
                        "source_entry_id": "6c88b00b-5f04-338f-be9f-6232f4abd7b8",
