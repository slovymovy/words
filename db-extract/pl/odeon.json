                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d4c14df4-a10b-39f4-aeb8-eda39ca17fcd",
                        "entry_id": "010e81b2-6349-3562-9454-21b67e4d9099",
                        "glosses": [
                            "typ orkiestry grającej muzykę rozrywkową, popularnej na przełomie XIX i XX w., złożonej z muzyków grających na instrumentach dętych z towarzyszeniem kwintetu smyczkowego i perkusji"
                        ],
