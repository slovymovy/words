                                    {
                                        "sense_id": "efdbf278-0751-359b-8341-bdbbebdbf043",
                                        "entry_id": "78111720-7949-3e78-9327-fd2a6b991e26",
                                        "glosses": [
                                            "To carefully or appraisingly observe (someone or something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "723b652e-515b-4353-840e-3843e2841277",
                                                "sense_id": "efdbf278-0751-359b-8341-bdbbebdbf043",
                                                "text": "After eyeing the document for half an hour, she decided not to sign it."
                                            },
                                            {
                                                "example_id": "5dbec0e1-c0f1-4e2f-80b8-7d0ed586ab63",
                                                "sense_id": "efdbf278-0751-359b-8341-bdbbebdbf043",
                                                "text": "They went out and eyed the new car one last time before deciding."
                                            },
                                            {
                                                "example_id": "9811f358-ac28-4daf-98d2-dc4058129738",
                                                "sense_id": "efdbf278-0751-359b-8341-bdbbebdbf043",
                                                "text": "Each downcast monk in silence takes / His place a newmade grave around, / Each one his brother sadly eying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6d9b511-9e59-3d2b-8cd0-806ba582c055",
                                        "entry_id": "78111720-7949-3e78-9327-fd2a6b991e26",
                                        "glosses": [
                                            "To appear; to look."
                                        ],
