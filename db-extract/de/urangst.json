                        "tags": [],
                        "examples": [
                            {
                                "example_id": "694078f2-2d0d-45d8-ad93-006c9f36743a",
                                "sense_id": "26938ef8-1835-3336-84d6-bb9d5da6cbb0",
                                "text": "„Der melancholische Zug in seinen Augen verriet zuweilen etwas von jener Urangst, die aus dem Blick einer gehetzten Tierkreatur schreit.“"
                            },
                            {
                                "example_id": "43f5db0d-c4b5-4082-9cc6-55e8bbeb8dc4",
                                "sense_id": "26938ef8-1835-3336-84d6-bb9d5da6cbb0",
                                "text": "„Der Künstler ist traumatisch besetzt von der immer wiederkehrenden Urangst seiner Existenz: dem Verlöschen seiner Kreativität.“"
                            }
                        ],
