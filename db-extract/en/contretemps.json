    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b14acbb1-07d4-3cf7-9e4c-3d5358d4fbdf",
                "word": "contretemps",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "799ad16f-5bb5-42f5-b914-2c0281af789a",
                        "entry_id": "b14acbb1-07d4-3cf7-9e4c-3d5358d4fbdf",
                        "tags": [
                            "plural"
                        ],
                        "form": "contretemps"
