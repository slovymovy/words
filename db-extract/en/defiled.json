                "translations": [
                    {
                        "translation_id": "d7db6301-edfe-4c2a-a57d-aeac2cae42d4",
                        "source_entry_id": "0c861225-9d6b-3413-9698-e78f52a71742",
                        "source_sense_id": "679addfc-de80-3c3d-8e47-6925fa95fedf",
                        "source_sense_description": "impure; dirty",
                        "target_lang_word": "загрязнённый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "загрязнённый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "27b4aba9-82dc-33fe-86e8-17d805181462",
                                        "entry_id": "38b09a7e-b038-3063-8eda-afff38531eb7",
                                        "glosses": [
                                            "страд. прич. прош. вр. от загрязнить; покрытый грязью; грязный"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "188f8a81-5676-477d-a2ae-7109c6a33793",
                                                "sense_id": "27b4aba9-82dc-33fe-86e8-17d805181462",
                                                "text": "На диване, на полу валялась второпях сброшенная загрязнённая одежда…"
                                            },
                                            {
                                                "example_id": "ddcc3a9d-3b7e-4e47-bc38-06b3d069d58c",
                                                "sense_id": "27b4aba9-82dc-33fe-86e8-17d805181462",
                                                "text": "Стирать следует в обильной пене, сильно загрязнённые места смочить моющим раствором и оставить изделие полежать некоторое время (15-20 мин)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fb9195f-e459-3f43-925e-d44de5f41e03",
                                        "entry_id": "38b09a7e-b038-3063-8eda-afff38531eb7",
                                        "glosses": [
                                            "подвергшийся загрязнению"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be397b78-52ec-4c16-a344-9d584ce82342",
                                                "sense_id": "4fb9195f-e459-3f43-925e-d44de5f41e03",
                                                "text": "Комнаты находились в сильно загрязнённом состоянии, в них были разбросаны вещи, на столах остатки выпивки и закуски."
                                            },
                                            {
                                                "example_id": "3bc298f3-84f3-4c08-bc3a-f740e7f91454",
                                                "sense_id": "4fb9195f-e459-3f43-925e-d44de5f41e03",
                                                "text": "На 19 московских рынках было изъято 818,75 кг черники, клюквы и грибов, загрязнённых радионуклидами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
