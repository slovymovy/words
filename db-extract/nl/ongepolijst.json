                    },
                    {
                        "sense_id": "9727e81d-a345-3201-a133-631cc3f44683",
                        "entry_id": "658bbf3a-4513-3e5c-841e-cf1b48f684f2",
                        "glosses": [
                            "van mensen: ruw en onopgevoed"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "28afd1e5-3f4c-4edf-b4fe-adce41fae48f",
                                "sense_id": "9727e81d-a345-3201-a133-631cc3f44683",
                                "text": "Hij was in bepaalde opzichten een jongere versie van mezelf. Zijn grote mond, iets te harde stem, irritante enthousiasme en overdreven positiviteit waren herkenbaar maar ook zijn ongepolijste bravoure, idealisme en romantische dromen om de wereld te verbeteren."
                            },
                            {
                                "example_id": "8fac1c49-e7dd-4730-8d3b-ba52c6c7a16e",
                                "sense_id": "9727e81d-a345-3201-a133-631cc3f44683",
                                "text": "Quagliata is in Almelo de opvolger van Lennart Czyborra, die vorige week voor een recordbedrag werd verkocht aan Atalanta Bergamo. De hoop is dat de Italiaanse speler dezelfde weg bewandelt als zijn talentvolle voorganger. Jong en ongepolijst binnenkomen en voor veel geld verkocht worden."
                            }
                        ]
                    }
