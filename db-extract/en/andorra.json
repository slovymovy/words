                    {
                        "translation_id": "a5477696-7a44-48bf-ba4f-1442b7631169",
                        "source_entry_id": "269cfc96-c3ac-35f4-9d64-91e7341fd7cf",
                        "source_sense_id": "eee97af7-d0c4-34f0-b89d-6bb30ce3db88",
