                ],
                "senses": [
                    {
                        "sense_id": "c9082c47-15b3-3bc7-9312-bfa725059706",
                        "entry_id": "2bd63f40-d1b0-33b2-bf60-ffc1f206bdba",
                        "glosses": [
                            "Plier les reins en élevant plusieurs fois la croupe sans ruer, en parlant d’un cheval faible ou gêné du derrière."
                        ],
                        "tags": [
                            "Hippologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e87d01be-a1ab-4069-9681-ba4187ad8661",
                                "sense_id": "c9082c47-15b3-3bc7-9312-bfa725059706",
                                "text": "Malgré, ou plutôt à cause de cet état de bouffissure, l’acheteur, le plus souvent, est séduit par le poil lustré, onctueux et cette ardeur factice qui fait cabrioler, se cabrer, ou croupionner les chevaux, comme s’ils étaient doués d’une vigueur hors ligne […]."
                            },
                            {
                                "example_id": "396074a5-da9a-4edf-941e-b73f5e96208b",
                                "sense_id": "c9082c47-15b3-3bc7-9312-bfa725059706",
                                "text": "Le bateau, tout d’un coup, fut transporté en l’air et, en croupionnant, il s’immobilisa à cheval sur une montagne."
                            },
                            {
                                "example_id": "5b0fe98a-ccc7-4576-b98c-2a1906246b54",
                                "sense_id": "c9082c47-15b3-3bc7-9312-bfa725059706",
                                "text": "Le Camaret recommença à croupionner et à s’immobiliser."
                            }
                        ]
                    }
                ],
