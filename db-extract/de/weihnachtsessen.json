                        "glosses": [
                            "gemeinsames Essen zu Weihnachten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0dc8cda-ff3e-4af8-8eda-3337d5fefa13",
                                "sense_id": "f5ba4780-1c2b-3403-ba9e-98e24361b6c5",
                                "text": "Zum jährlichen Weihnachtsessen musste unser Betrieb wegen der Umbauarbeiten in ein anderes Lokal ausweichen."
                            }
