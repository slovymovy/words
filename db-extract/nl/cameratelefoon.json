                "senses": [
                    {
                        "sense_id": "f9749d1f-1658-341d-affc-ca07e94690ab",
                        "entry_id": "e4e60059-28d4-3150-8001-60c7b3087c1f",
                        "glosses": [
                            "draagbare telefoon waarmee men ook foto's en video's kan maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f259f386-9490-4d77-8243-e0010a9ae391",
                                "sense_id": "f9749d1f-1658-341d-affc-ca07e94690ab",
                                "text": "De teleburn is een cameratelefoon die dankzij speciale software in staat is een rechtstreekse beeldverbinding te maken met het Brandwondencentrum in Beverwijk. Zo kan al in een heel vroeg stadium door brandwondenartsen worden vastgesteld of het slachtoffer behandeld kan worden in zijn eigen ziekenhuis of dat transport naar een van de gespecialiseerde brandwondencentra nodig is."
                            },
                            {
                                "example_id": "eccc5cea-5d5e-43f0-8e5d-25c664c38592",
                                "sense_id": "f9749d1f-1658-341d-affc-ca07e94690ab",
                                "text": "Pas eind jaren negentig werden ook de eerste telefoons met camera op de wereld losgelaten. Volgens de meeste bronnen gaat de titel van allereerste commercieel beschikbare cameratelefoon naar de Kyocera VP-201, een toestel dat in 1999 uitkwam in Japan. Aan de voorkant van de telefoon prijkte een enorme 0,11 MP-camera die vooral moest dienen voor videogesprekken, maar ook in staat was om foto’s te nemen."
                            }
                        ]
                    }
