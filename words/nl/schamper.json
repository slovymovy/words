                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "schamperen_verboeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Schamper</w> maar niet te vroeg, want je weet niet wat er gaat gebeuren.",
                            "target_lang_translations": {
                                "de": "<w>Spotte</w> nur nicht zu früh, denn du weißt nicht, was passieren wird."
                            }
                        },
                        {
                            "text": "<w>Schamper</w> toch niet altijd over andermans harde werk!",
                            "target_lang_translations": {
                                "de": "<w>Höhne</w> doch nicht immer über die harte Arbeit anderer!"
                            }
                        }
                    ],
                    "traits": [
