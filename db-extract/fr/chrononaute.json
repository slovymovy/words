                                "target_senses": [
                                    {
                                        "sense_id": "74db996c-7f6d-332c-a957-eb7763e988cf",
                                        "entry_id": "0491dbf3-18c7-3d9d-afbc-dd642d16315b",
                                        "glosses": [
                                            "A time-traveller."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b7fe086-d95c-4358-aba9-e64b0708bff9",
                                                "sense_id": "74db996c-7f6d-332c-a957-eb7763e988cf",
                                                "text": "The honour of the final great mistake will go to David Powers, Scientist Chrononaut."
                                            },
                                            {
                                                "example_id": "44471558-3233-4b61-8182-5c04c1e44b58",
                                                "sense_id": "74db996c-7f6d-332c-a957-eb7763e988cf",
                                                "text": "The conventional view of time travel, however, has the ‘chrononauts’ travelling backwards and forwards in time. But in a more restricted sense we are all chrononauts, on a one-way fixed-speed journey into the future."
                                            },
                                            {
                                                "example_id": "786d009a-a26a-4db0-8a5c-079acbc7d959",
                                                "sense_id": "74db996c-7f6d-332c-a957-eb7763e988cf",
                                                "text": "This tiny accident, because of the multiplicative effect of unforeseeable circumstances, results in an important alteration in the present time when the chrononauts return — the language is spoken differently and a different President of the United States has been elected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
