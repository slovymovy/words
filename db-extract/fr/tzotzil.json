                "senses": [
                    {
                        "sense_id": "cea8b35f-4985-3e86-a792-9f77e8f76a53",
                        "entry_id": "f7dde585-2628-3259-b982-a41c53eded8b",
                        "glosses": [
                            "Relatif aux Tzotzils, peuple descendant des Mayas habitant au Mexique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "532e5d18-41fc-4ef1-b944-329debdcb337",
                                "sense_id": "cea8b35f-4985-3e86-a792-9f77e8f76a53",
                                "text": "«Salam alaikoum!», lance un vieillard en descendant d’une colline. Turban sur la tête, pardessus en laine de mouton et sandales, l’homme porte l’habit traditionnel tzotzil (une ethnie maya)."
                            },
                            {
                                "example_id": "491aab97-191e-4fa2-beef-e6feb91ccaaa",
                                "sense_id": "cea8b35f-4985-3e86-a792-9f77e8f76a53",
                                "text": "Aussi, je vais à San Juan Chamula, où je rends visite à la communauté tzotzil, un autre peuple qui descend des Mayas."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
