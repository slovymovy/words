                                                "example_id": "70a928fe-858f-40c8-b4ee-83acd1835456",
                                                "sense_id": "6dc03031-e363-34de-956c-e016980053b6",
                                                "text": "Due to a communications error, according to gaming officials, the slot machine malfunctioned and didn’t notify Taylor or casino personnel that he was a winner."
                                            },
                                            {
                                                "example_id": "79939fed-614e-4a90-86f7-e472db19fb76",
                                                "sense_id": "6dc03031-e363-34de-956c-e016980053b6",
                                                "text": "The group has started collecting reports of malfunctioning, crashing, or dangerous self-driving cars on its website."
                                            },
                                            {
                                                "example_id": "61a42c24-af95-4c86-8b19-c27652fa3a3c",
                                                "sense_id": "6dc03031-e363-34de-956c-e016980053b6",
                                                "text": "A 39-year-old British woman was killed when a malfunctioning ottoman bed fell on her neck and asphyxiated her, a coroner’s report said."
