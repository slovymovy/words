                ],
                "senses": [
                    {
                        "sense_id": "680aadf7-5653-3ae4-9f3e-d062f83b78ad",
                        "entry_id": "48185aa3-7cec-3546-8eec-d6f953cb1e3f",
                        "glosses": [
                            "een sneeuwverschuiving op een berghelling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d673b30c-4abd-4f04-99c6-8c8dba3fee2c",
                                "sense_id": "680aadf7-5653-3ae4-9f3e-d062f83b78ad",
                                "text": "De lawine bedolf een deel van het dorp en eiste een groot aantal slachtoffers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fab7947-cb23-4c16-ba78-60a4d2a0704b",
                        "source_entry_id": "48185aa3-7cec-3546-8eec-d6f953cb1e3f",
                        "source_sense_id": "680aadf7-5653-3ae4-9f3e-d062f83b78ad",
                        "source_sense_description": "een sneeuwverschuiving op een berghelling",
                        "target_lang_word": "Lawine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lawine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12f0d5d4-a3b2-3114-880d-f9c0f67f7989",
                                        "entry_id": "3866a186-23fc-3bae-9453-db1cf587fde1",
                                        "glosses": [
                                            "von Bergen ins Tal gleitende oder stürzende große Massen von Eis oder Schnee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11c0f755-1ac2-45ff-b592-6d88f9319885",
                                                "sense_id": "12f0d5d4-a3b2-3114-880d-f9c0f67f7989",
                                                "text": "Beinahe jedes Jahr fallen Skitouristen einer Lawine zum Opfer."
                                            },
                                            {
                                                "example_id": "adc30027-6578-4fc3-9c0d-ffa178b62f2d",
                                                "sense_id": "12f0d5d4-a3b2-3114-880d-f9c0f67f7989",
                                                "text": "Am Écrins-Massiv hat eine Lawine sieben Menschen in den Tod gerissen."
                                            },
                                            {
                                                "example_id": "374fab63-48e2-4dfd-8831-0ffc68b39689",
                                                "sense_id": "12f0d5d4-a3b2-3114-880d-f9c0f67f7989",
                                                "text": "„1772 zerstörte eine Lawine einen Teil der Kathedrale und ein Treppenhaus, das sich möglicherweise in einem Turm befand.“"
                                            },
                                            {
                                                "example_id": "a0bd0279-9310-433b-becf-783a4124a9b6",
                                                "sense_id": "12f0d5d4-a3b2-3114-880d-f9c0f67f7989",
                                                "text": "„Die Flucht vor der Qual der Sinnlosigkeit des täglichen Lebens führt in die menschenfeindlichsten Landschaften der Erde, in das vegetationslose Hochgebirge mit seinem ewigen Eis und Schnee, seinen unsichtbaren Gletscherspalten, seinen abweisenden Wänden und Graten, seinen gefährlichen Steinschlägen und Lawinen, seiner mörderischen Kälte und Hitze, seinen Stürmen und Wetterschlägen.“"
                                            },
                                            {
                                                "example_id": "eccfa0b2-574f-40a5-8ade-73dde5aca972",
                                                "sense_id": "12f0d5d4-a3b2-3114-880d-f9c0f67f7989",
                                                "text": "„Immer hatte ich mich in Tsunamis, Lawinen oder Waldbränden als Überlebender imaginiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14d050ec-6e2d-3fd1-b5c7-20de29b2c4f8",
                                        "entry_id": "3866a186-23fc-3bae-9453-db1cf587fde1",
                                        "glosses": [
                                            "an Hängen abrutschende Materialien wie Schlamm oder Geröll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caa8daeb-c9cd-4d9e-866a-087510d0e0aa",
                                                "sense_id": "14d050ec-6e2d-3fd1-b5c7-20de29b2c4f8",
                                                "text": "Eine Lawine aus Schlamm rollte zu Tal."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b675681d-8e47-33ff-8fad-c3466f42cb7f",
                                        "entry_id": "3866a186-23fc-3bae-9453-db1cf587fde1",
                                        "glosses": [
                                            "eine große Menge"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cb7e7cf-92ad-45bf-945b-7048b0650249",
                                                "sense_id": "b675681d-8e47-33ff-8fad-c3466f42cb7f",
                                                "text": "Die Heiratsanzeige führte zu einer Lawine von Zuschriften."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bf38fc4-7a2b-4dea-9c67-8b57d495bd17",
                        "source_entry_id": "48185aa3-7cec-3546-8eec-d6f953cb1e3f",
                        "source_sense_id": "680aadf7-5653-3ae4-9f3e-d062f83b78ad",
                        "source_sense_description": "een sneeuwverschuiving op een berghelling",
                        "target_lang_word": "avalanche",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avalanche",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ad4170f-042b-3aaa-b26c-c29618176ef3",
                                        "entry_id": "bf29d74c-324a-3dbf-9a59-3776e7457faf",
                                        "glosses": [
                                            "A large mass or body of snow and ice sliding swiftly down a mountain side, or falling down a precipice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be6e852a-0db1-41c6-87bd-b6731d53c835",
                                                "sense_id": "1ad4170f-042b-3aaa-b26c-c29618176ef3",
                                                "text": "They were drinking from a fountain / That was pouring like an avalanche / Coming down the mountain"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "870d4560-cd0d-358c-9594-c0cedae5070a",
                                        "entry_id": "bf29d74c-324a-3dbf-9a59-3776e7457faf",
                                        "glosses": [
                                            "A fall of earth, rocks, etc., similar to that of an avalanche of snow or ice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb9c1446-da84-3607-889b-fab10b17d3ba",
                                        "entry_id": "bf29d74c-324a-3dbf-9a59-3776e7457faf",
                                        "glosses": [
                                            "A sudden, great, or irresistible descent or influx; anything like an avalanche in suddenness and overwhelming quantity."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2907118-54b7-4af4-8d49-26491a04a99b",
                                                "sense_id": "cb9c1446-da84-3607-889b-fab10b17d3ba",
                                                "text": "Yes, but she talked it away. She uses a whole language to herself. Her discourse is an avalanche of words, beneath which the hearers are overwhelmed."
                                            },
                                            {
                                                "example_id": "9b6ab0dd-4a03-4b39-8886-213d19126111",
                                                "sense_id": "cb9c1446-da84-3607-889b-fab10b17d3ba",
                                                "text": "I stepped into an avalanche, it covered up my soul"
                                            },
                                            {
                                                "example_id": "6148bdad-89ca-4acf-9dab-56826cd3ade7",
                                                "sense_id": "cb9c1446-da84-3607-889b-fab10b17d3ba",
                                                "text": "The apparent success of the City and South London triggered an avalanche of bills for Tube railways, and in 1892 a Joint Select Committee of Parliament set out some ground rules."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "avalanche",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42e4a542-9954-3e67-91fe-dde167e12555",
                                        "entry_id": "27f095e4-f99f-3061-bd84-a1a4f0c6e155",
                                        "glosses": [
                                            "To descend like an avalanche."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ad65cfc-dcfe-4424-9e95-74f43f3eebe3",
                                                "sense_id": "42e4a542-9954-3e67-91fe-dde167e12555",
                                                "text": "Whenever the stage stopped to change horses, we would wake up, and try to recollect where we were—[…] We began to get into country, now, threaded here and there with little streams. These had high, steep banks on each side, and every time we flew down one bank and scrambled up the other, our party inside got mixed somewhat. First we would all be down in a pile at the forward end of the stage, nearly in a sitting posture, and in a second we would shoot to the other end, and stand on our heads. […] ¶ Every time we avalanched from one end of the stage to the other, the Unabridged Dictionary would come too; and every time it came it damaged somebody."
                                            },
                                            {
                                                "example_id": "f04dc04f-16d3-4892-b6af-4262bc67d250",
                                                "sense_id": "42e4a542-9954-3e67-91fe-dde167e12555",
                                                "text": "Soon the sun’s warmth makes them shed crystal shells\nShattering and avalanching on the snow-crust—"
                                            },
                                            {
                                                "example_id": "e0a2bcb0-aa09-49d2-b37a-453e8e0943cd",
                                                "sense_id": "42e4a542-9954-3e67-91fe-dde167e12555",
                                                "text": "As it happened, I had progressed only some few feet out onto the snow when a clean-cut section stripped off the surface and avalanched."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "429952e2-3b64-3282-bab0-1b63ec4021ee",
                                        "entry_id": "27f095e4-f99f-3061-bd84-a1a4f0c6e155",
                                        "glosses": [
                                            "To come down upon; to overwhelm."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "992fd2df-952d-4bdd-b13f-c46313fb9a40",
                                                "sense_id": "429952e2-3b64-3282-bab0-1b63ec4021ee",
                                                "text": "The shelf broke and the boxes avalanched the workers."
                                            },
                                            {
                                                "example_id": "f106f7b9-5964-42c0-b5a2-72d73259d38b",
                                                "sense_id": "429952e2-3b64-3282-bab0-1b63ec4021ee",
                                                "text": "The applications were doubtless snowed under in the maze of official correspondence which avalanched the new government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e859fd15-6e0d-3ee2-8ad3-ffeb627b4589",
                                        "entry_id": "27f095e4-f99f-3061-bd84-a1a4f0c6e155",
                                        "glosses": [
                                            "To propel downward like an avalanche."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24d0e86b-ec5d-4552-997c-4367a98bc6e0",
                                                "sense_id": "e859fd15-6e0d-3ee2-8ad3-ffeb627b4589",
                                                "text": "When our artist and I were dropped down our first coal-mine, we felt a leetle bit anxious. It was something new. But we have been avalanched down the incline from Peak Forest, and boomeranged round the sudden curve at Rowsley, and have run the gauntlet at Penistone and King’s Cross without ever taking the precaution to say “God help us.”"
                                            },
                                            {
                                                "example_id": "c9d82562-ba5a-4060-85cc-8c612cf92985",
                                                "sense_id": "e859fd15-6e0d-3ee2-8ad3-ffeb627b4589",
                                                "text": "The scuppers could not carry off the burden of water on the schooner’s deck. She rolled it out and took it in over one rail and the other; and at times, nose thrown skyward, sitting down on her heel, she avalanched it aft."
                                            },
                                            {
                                                "example_id": "2c7ac444-3678-4886-9f5f-6d2c45bd8d50",
                                                "sense_id": "e859fd15-6e0d-3ee2-8ad3-ffeb627b4589",
                                                "text": "Then another misfortune avalanched itself upon me, before even I had fully taken in the extent of the first."
                                            },
                                            {
                                                "example_id": "da590265-844a-4baa-ba94-9c6e089cbe36",
                                                "sense_id": "e859fd15-6e0d-3ee2-8ad3-ffeb627b4589",
                                                "text": "Swelter, following at high speed, had caught his toe at the raised lip of the opening, and unable to check his momentum, had avalanched himself into warm water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a282685-d809-4899-89e1-428d08ff1cd5",
                        "source_entry_id": "48185aa3-7cec-3546-8eec-d6f953cb1e3f",
                        "source_sense_id": "680aadf7-5653-3ae4-9f3e-d062f83b78ad",
                        "source_sense_description": "een sneeuwverschuiving op een berghelling",
                        "target_lang_word": "avalanche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avalanche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "294eece5-5178-3b2e-83db-d7524db80dec",
                                        "entry_id": "e09ed924-6af1-3025-9369-283eae9b3451",
                                        "glosses": [
                                            "Masse considérable de neige qui se détache du sommet des hautes montagnes et s’écoule parfois jusque dans les vallées. Ce peut être aussi le mouvement de cette masse de neige."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13bf7a03-d6f2-44e0-99db-67748439839c",
                                                "sense_id": "294eece5-5178-3b2e-83db-d7524db80dec",
                                                "text": "La chute d’une avalanche."
                                            },
                                            {
                                                "example_id": "132e5bb5-6ee5-4bfa-af8e-3d1161fcbc78",
                                                "sense_id": "294eece5-5178-3b2e-83db-d7524db80dec",
                                                "text": "Ce village a été détruit par une avalanche."
                                            },
                                            {
                                                "example_id": "c7c76085-9dc0-43a6-9bfd-f0bd20c3611f",
                                                "sense_id": "294eece5-5178-3b2e-83db-d7524db80dec",
                                                "text": "Pierre.– Ainsi donc les avalanches se font quelquefois au moyen d’un caillou gros comme le bout du doigt."
                                            },
                                            {
                                                "example_id": "72607ede-8e5b-4acb-b8a3-03b1d55c5257",
                                                "sense_id": "294eece5-5178-3b2e-83db-d7524db80dec",
                                                "text": "Le spectacle d'une avalanche dévalant un couloir sur plusieurs kilomètres nous transporte par sa canonnade furieuse, son effet de souffle, à condition de ne pas en être atteint."
                                            },
                                            {
                                                "example_id": "93f3ee4e-e626-4db2-8554-df9588afe3ce",
                                                "sense_id": "294eece5-5178-3b2e-83db-d7524db80dec",
                                                "text": "Un alpiniste tousse, et il déclenche l’avalanche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3348d081-aa2c-3a11-ae3e-e2782d045882",
                                        "entry_id": "e09ed924-6af1-3025-9369-283eae9b3451",
                                        "glosses": [
                                            "Masse importante d’une chose qui tombe sur quelque chose ou quelqu’un."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a855f9f6-7ee4-4680-9a7e-112afd5447bf",
                                                "sense_id": "3348d081-aa2c-3a11-ae3e-e2782d045882",
                                                "text": "Des avalanches liquides heurtaient le cap Bathurst, et si violemment que l’on pouvait craindre pour sa solidité, désormais fort problématique, […]."
                                            },
                                            {
                                                "example_id": "40e19a5d-2a80-47ef-ab6f-7f29d7fa2758",
                                                "sense_id": "3348d081-aa2c-3a11-ae3e-e2782d045882",
                                                "text": "L’avalanche de nos obus et de nos torpilles dura quatre longues heures. Nous fîmes « exploser » jusqu’à quinze fourneaux de mines, dont certains chargés de 3.000 kilos de lydite. La terre, dit un témoin était toute secouée d’un immense frisson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc26ca94-7657-36e6-aaeb-3a9ac1135bd7",
                                        "entry_id": "e09ed924-6af1-3025-9369-283eae9b3451",
                                        "glosses": [
                                            "Masse importante d’une chose qui tombe sur quelque chose ou quelqu’un.",
                                            "avalanche sous-marine"
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71351e57-3aac-4911-8364-baa7bd5e7034",
                                                "sense_id": "bc26ca94-7657-36e6-aaeb-3a9ac1135bd7",
                                                "text": "En 2006, le tremblement de terre de Pingtung, à Taïwan, a déclenché des avalanches sous-marines qui ont sectionné de nombreux de ces câbles, reliant l'Asie du Sud-Est au reste du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb73ddde-b782-3de5-bcc1-12895acc7374",
                                        "entry_id": "e09ed924-6af1-3025-9369-283eae9b3451",
                                        "glosses": [
                                            "Flux important de choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "866a0604-2a03-42b4-9836-01b8dd246db9",
                                                "sense_id": "bb73ddde-b782-3de5-bcc1-12895acc7374",
                                                "text": "Depuis l’aube, les troupes passaient la Moselle. C’était, sur le tremblement des ponts de bois, l’avalanche interminable des régiments."
                                            },
                                            {
                                                "example_id": "e7472c57-6e37-4ad0-815e-a8107c22df4b",
                                                "sense_id": "bb73ddde-b782-3de5-bcc1-12895acc7374",
                                                "text": "Dans toutes les Bourses de la terre, ce fut une avalanche de titres que les porteurs voulaient vendre ; les banques suspendirent leurs paiements, les affaires furent paralysées et cessèrent ; […]."
                                            },
                                            {
                                                "example_id": "51535923-5614-4411-9751-0dd3409a6397",
                                                "sense_id": "bb73ddde-b782-3de5-bcc1-12895acc7374",
                                                "text": "Leur sourire béat exprima une tranquille indifférence en même temps qu’une satisfaction replète à la pensée de l’avalanche de titres russes, norvégiens, suédois qu’ils se préparaient à déverser sur leur clientèle."
                                            },
                                            {
                                                "example_id": "994f7bba-ad8a-4b14-8443-cc197be5cce6",
                                                "sense_id": "bb73ddde-b782-3de5-bcc1-12895acc7374",
                                                "text": "Lorsqu'on veut se figurer la cosmogenèse, c'est une aventure étrange, assez récente, pareille en somme à ce que serait une explosion hiroshimesque aperçue au ralenti : à partir d'un moment improbable, une avalanche de nébuleuses ignées, qui fuient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49037024-4142-3347-9348-60d88fa0f3ec",
                                        "entry_id": "e09ed924-6af1-3025-9369-283eae9b3451",
                                        "glosses": [
                                            "Série de choses, d’évènements indésirables qui arrive tout à coup."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5461676b-c2b2-467e-ba5e-c152a9fa68c1",
                                                "sense_id": "49037024-4142-3347-9348-60d88fa0f3ec",
                                                "text": "D'un coup, une avalanche de calendriers, d’horloges biologiques, de dates de naissance et d’avis de caisse de retraite lui tombèrent sur le râble. Mais qui intéresserait-il encore ?"
                                            },
                                            {
                                                "example_id": "bcef7509-20e6-4514-8e55-1686bc5d1ef3",
                                                "sense_id": "49037024-4142-3347-9348-60d88fa0f3ec",
                                                "text": "Une avalanche de reproches, d’injures, de coups."
                                            }
                                        ]
                                    }
                                ]
                            },
