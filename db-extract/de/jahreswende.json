                "senses": [
                    {
                        "sense_id": "31738878-6181-3718-9793-ef4a45a6a79c",
                        "entry_id": "345c45b6-d632-3100-ab88-51122866fb5c",
                        "glosses": [
                            "der Übergang, die Wende von einem Jahr zum nächsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "972caf3e-66b8-4f41-87d2-095a4e57a95b",
                                "sense_id": "31738878-6181-3718-9793-ef4a45a6a79c",
                                "text": "„In ganz Preußen kam es um die Jahreswende zu einem Wahlkampf, eine für die Bürger noch ganz ungewohnte Erfahrung.“"
                            },
                            {
                                "example_id": "80fb98fc-828e-44c1-96de-513dd2de611c",
                                "sense_id": "31738878-6181-3718-9793-ef4a45a6a79c",
                                "text": "„Sein Selbstvertrauen verließ ihn jedoch in den folgenden Wochen und Monaten, und zur Jahreswende 1948/49 bequemte er sich zu Geständnissen, die den Polizeipräsidenten Katting hinter schwedische Gardinen brachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
