{
    "word_family": [
        "pealing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "effc9630-6ec2-3ec9-8010-0788b6433620",
                    "sense_definition": "A loud sound or a series of loud sounds, such as bells, thunder, or laughter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distant thunder rolled in a <w>peal</w> that shook the windows.",
                            "target_lang_translations": {
                                "ru": "Далекий гром прокатился <w>раскатом</w>, от которого задрожали окна."
                            }
                        },
                        {
                            "text": "She burst into a <w>peal</w> of laughter after hearing the funny story.",
                            "target_lang_translations": {
                                "ru": "Она разразилась <w>хохотом</w>, услышав смешную историю."
                            }
                        }
                    ],
                    "synonyms": [
                        "clangor",
                        "din",
                        "roar"
                    ],
                    "common_phrases": [
                        "peal of laughter",
                        "peal of thunder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий звук или серия громких звуков, например, колокольный звон, раскаты грома или громкий смех."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звон",
                                "target_lang_sense_clarification": "чистый, протяжный звук (колоколов, стекла)"
                            },
                            {
                                "target_lang_word": "грохот",
                                "target_lang_sense_clarification": "сильный, раскатистый звук (грома)"
                            },
                            {
                                "target_lang_word": "хохот",
                                "target_lang_sense_clarification": "громкий, раскатистый смех"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "220bebee-abd1-332d-ab8c-7f33d09ae0e0",
                    "sense_definition": "A set of bells tuned to each other according to a musical scale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church tower houses a beautiful <w>peal</w> of bells.",
                            "target_lang_translations": {
                                "ru": "На церковной башне находится прекрасный <w>набор</w> колоколов."
                            }
                        },
                        {
                            "text": "The ringers practiced their <w>peal</w> for the upcoming festival.",
                            "target_lang_translations": {
                                "ru": "Звонари репетировали свой <w>перезвон</w> к предстоящему празднику."
                            }
                        }
                    ],
                    "synonyms": [
                        "carillon",
                        "chime"
                    ],
                    "common_phrases": [
                        "peal of bells"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор колоколов, настроенных друг относительно друга по музыкальной шкале."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колокольный звон",
                                "target_lang_sense_clarification": "совокупность звуков колоколов"
                            },
                            {
                                "target_lang_word": "карильон",
                                "target_lang_sense_clarification": "музыкальный инструмент из набора колоколов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "026227c9-7329-36ff-a05b-b0237d320012",
                    "sense_definition": "The specific sequence of changes rung on a set of bells.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bell ringers completed a full <w>peal</w> that lasted several hours.",
                            "target_lang_translations": {
                                "ru": "Звонари завершили полный <w>цикл</w> звона, который длился несколько часов."
                            }
                        },
                        {
                            "text": "Mastering a complex <w>peal</w> requires years of dedicated practice.",
                            "target_lang_translations": {
                                "ru": "Освоение сложного <w>колокольного</w> звона требует многих лет упорной практики."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная последовательность изменений в звоне набора колоколов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колокольный перезвон",
                                "target_lang_sense_clarification": "последовательность ударов в колокола"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1efff1ec-f2a3-3cf7-8cae-53d10ed35d53",
                    "sense_definition": "A young salmon or a similar type of fish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman caught a small <w>peal</w> in the river.",
                            "target_lang_translations": {
                                "ru": "Рыбак поймал в реке небольшого <w>лосося</w>."
                            }
                        },
                        {
                            "text": "Local anglers often refer to the young salmon as a <w>peal</w>.",
                            "target_lang_translations": {
                                "ru": "Местные рыболовы часто называют молодого лосося <w>пелем</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "grilse",
                        "sewin"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in parts of England and Wales."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодой лосось или похожий вид рыбы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молодой лосось",
                                "target_lang_sense_clarification": "рыба в стадии развития"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9df21182-4f24-3bbb-b715-868267e4f44e",
                    "sense_definition": "To ring loudly, especially referring to bells.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wedding bells began to <w>peal</w> as the couple left the church.",
                            "target_lang_translations": {
                                "ru": "Свадебные колокола начали <w>звонить</w>, когда пара вышла из церкви."
                            }
                        },
                        {
                            "text": "We heard the bells <w>peal</w> across the valley at noon.",
                            "target_lang_translations": {
                                "ru": "В полдень мы слышали, как колокола <w>звонили</w> по всей долине."
                            }
                        }
                    ],
                    "synonyms": [
                        "ring",
                        "chime",
                        "toll"
                    ],
                    "common_phrases": [
                        "bells peal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко звонить, особенно о колоколах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звонить",
                                "target_lang_sense_clarification": "издавать звуки (о колоколах)"
                            },
                            {
                                "target_lang_word": "бить в колокола",
                                "target_lang_sense_clarification": "процесс звона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "245b8ef5-e33b-3e43-8332-c4cd0ec6274f",
                    "sense_definition": "To resound or echo loudly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stadium began to <w>peal</w> with the cheers of the crowd.",
                            "target_lang_translations": {
                                "ru": "Стадион начал <w>греметь</w> от приветственных криков толпы."
                            }
                        },
                        {
                            "text": "Laughter seemed to <w>peal</w> through the empty hallways.",
                            "target_lang_translations": {
                                "ru": "Смех, казалось, <w>раздавался</w> эхом по пустым коридорам."
                            }
                        }
                    ],
                    "synonyms": [
                        "resound",
                        "echo",
                        "reverberate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко звучать или отдаваться эхом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "греметь",
                                "target_lang_sense_clarification": "издавать громкие звуки"
                            },
                            {
                                "target_lang_word": "отдаваться эхом",
                                "target_lang_sense_clarification": "звучать в пространстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2392e873-8ca1-3a30-bd48-5095d22b272f",
                    "sense_definition": "To utter or proclaim something loudly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The announcer continued to <w>peal</w> the winner's name to the audience.",
                            "target_lang_translations": {
                                "ru": "Диктор продолжал <w>громко</w> объявлять имя победителя аудитории."
                            }
                        },
                        {
                            "text": "They <w>peal</w> their message of hope to everyone in the city.",
                            "target_lang_translations": {
                                "ru": "Они <w>громко</w> провозглашают свое послание надежды всем в городе."
                            }
                        }
                    ],
                    "synonyms": [
                        "proclaim",
                        "shout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громко провозглашать или выкрикивать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провозглашать",
                                "target_lang_sense_clarification": "громко объявлять"
                            },
                            {
                                "target_lang_word": "выкрикивать",
                                "target_lang_sense_clarification": "громко произносить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98cfecd8-41a7-38a9-a86e-418f16761e19",
                    "sense_definition": "To assail or overwhelm someone with loud noise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant construction noise <w>pealed</w> his ears all day long.",
                            "target_lang_translations": {
                                "ru": "Постоянный строительный шум <w>оглушал</w> его весь день."
                            }
                        },
                        {
                            "text": "He felt <w>pealed</w> by the deafening roar of the engines.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>оглушенным</w> оглушительным ревом двигателей."
                            }
                        }
                    ],
                    "synonyms": [
                        "deafen",
                        "assail"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оглушать кого-либо громким шумом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оглушать",
                                "target_lang_sense_clarification": "лишать слуха громким звуком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42e734c5-e06e-3d19-8b15-26927bc5c704",
                    "sense_definition": "To <w>appeal</w> or make a formal request.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner sought to <w>peal</w> against the harsh court decision.",
                            "target_lang_translations": {
                                "ru": "Заключенный пытался <w>подать</w> апелляцию на суровое решение суда."
                            }
                        },
                        {
                            "text": "He decided to <w>peal</w> to the higher authorities for justice.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>обратиться</w> к высшим властям за справедливостью."
                            }
                        }
                    ],
                    "synonyms": [
                        "appeal"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer used in this sense."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавать апелляцию или делать официальный запрос."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавать апелляцию",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "01e53f94-d6e9-38de-8947-fb198723e1f0",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Peal</w> is the new manager of the local library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Пил</w> — новый заведующий местной библиотекой."
                            }
                        },
                        {
                            "text": "The research was conducted by a scientist named <w>Peal</w>.",
                            "target_lang_translations": {
                                "ru": "Исследование было проведено ученым по фамилии <w>Пил</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пил",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}