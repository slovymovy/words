                                    {
                                        "sense_id": "01e0c036-d346-3184-9519-d7a11c1504a8",
                                        "entry_id": "05f214e9-819a-3b2c-aa26-66b994789248",
                                        "glosses": [
                                            "Titre, dignité de quelques anciens princes d’Allemagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57877b01-a3af-4f78-854b-4735ed31fefb",
                                                "sense_id": "01e0c036-d346-3184-9519-d7a11c1504a8",
                                                "text": "[…] et, parmi ces jeunes gens et ces nobles dames, le plus beau jeune homme était Othon, et la plus belle châtelaine madame Emma, l’un le fils, et l’autre la femme du landgrave Ludwig de Godesberg, seigneur du château et frère d’armes du bon chevalier qui venait d’arriver."
                                            },
                                            {
                                                "example_id": "579979e0-be82-48d0-ba51-f072ea40750e",
                                                "sense_id": "01e0c036-d346-3184-9519-d7a11c1504a8",
                                                "text": "Elle marmotte de grands mots étranges… elle parle des anciens temps… des margraves et des landgraves…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed91a5f1-895b-4fc1-9073-a7a75e46cf55",
                        "source_entry_id": "07d9c256-461e-3938-9844-8c0386f10d9e",
                        "source_sense_description": "renderings of Landgraf",
                        "target_lang_word": "Landgraf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landgraf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d45bb40c-9437-322c-89a7-cbdda3dc493c",
                                        "entry_id": "89f73bc9-bb9d-38b5-a072-ebaae8200457",
                                        "glosses": [
                                            "Adelstitel, der im Rang höher als der eines Grafen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63a6b201-018c-4c40-8647-63c2fb52c3a1",
                                                "sense_id": "d45bb40c-9437-322c-89a7-cbdda3dc493c",
                                                "text": "„Dem entsprechend nannte sich H. [Heinrich I.] in seinen Urkunden nicht mehr von Thüringen, behielt jedoch den Titel Landgraf von seiner mütterlichen Abkunft her bei und verband damit den eines Herrn des Landes Hessen.“"
                                            },
                                            {
                                                "example_id": "9513d95d-cd28-4647-aa0d-565b824acd8c",
                                                "sense_id": "d45bb40c-9437-322c-89a7-cbdda3dc493c",
                                                "text": "„Schon in jungen Jahren musste der Sohn des Landgrafen Philipp I. von Hessen die Regierungsgeschäfte mit übernehmen, als sein Vater plötzlich in Gefangenschaft geriet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fea96bcb-c9b6-3a11-9fa2-a8df743e9365",
                                        "entry_id": "89f73bc9-bb9d-38b5-a072-ebaae8200457",
                                        "glosses": [
                                            "Träger des Adelstitels [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fa93c70-36bf-48c6-9a42-7b692ecf600e",
                                                "sense_id": "fea96bcb-c9b6-3a11-9fa2-a8df743e9365",
                                                "text": "„Kassel, bereits im 10. Jahrhundert erwähnt, wurde im 13. Jahrhundert durch die Landgrafen von Thüringen zur Stadt erklärt und 1277 Residenzstadt der Landgrafen von Hessen (seit 1567 von Hessen-Kassel).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
