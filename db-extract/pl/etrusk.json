                "senses": [
                    {
                        "sense_id": "56569014-52e5-3f5e-a862-680dde06c3f0",
                        "entry_id": "e0386515-c79b-32f0-8283-fc577ffa95e9",
                        "glosses": [
                            "przedstawiciel starożytnego ludu zamieszkującego Etrurię w środkowej Italii, wykształconego między XI a IX wiekiem p.n.e."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "287b11dd-0b65-4dd5-954d-f27f69f55c65",
                                "sense_id": "56569014-52e5-3f5e-a862-680dde06c3f0",
                                "text": "Wśród Etrusków kobiety cieszyły się większą swobodą od Greczynek czy Rzymianek, czego przykładem może być to, że mogły brać udział w ucztach u boku mężów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
