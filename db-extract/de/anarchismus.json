                "senses": [
                    {
                        "sense_id": "9ffbbbfa-0b13-3517-9c61-9d3fdbc41621",
                        "entry_id": "4da4cfd4-81d0-37d0-8867-d9725897862d",
                        "glosses": [
                            "无政府主义"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fb910cb-467a-4f85-97ba-852451f92c46",
                                "sense_id": "9ffbbbfa-0b13-3517-9c61-9d3fdbc41621",
                                "text": "Der Anarchismus ist die rechtsphilosophische Verneinung des Staates, das heisst diejenige Art der rechtsphilotopbischen Staatslehren, welche den Staat verneint.",
                                "translation": "无政府主义是法律哲学中对国家的否定：也就是说，它是否定国家的那种法理学理论。"
                            },
                            {
                                "example_id": "e08376c0-19da-4342-b4ed-681ea0aa1668",
                                "sense_id": "9ffbbbfa-0b13-3517-9c61-9d3fdbc41621",
                                "text": "Immer wieder hören wir die Frage von Personen, denen die Gedankenwelt des Anarchismus nicht vertraut ist: Was wollt ihr eigentlich? Wie stellt ihr euch eine Gesellschaft ohne Staat und Obrigkeit vor?",
                                "translation": "我们经常听到那些不了解无政府主义思想的人问：你们到底想要什么？你们如何想象一个没有国家和权威的社会？"
                            }
                        ]
                    }
                ],
