            {
                "entry_id": "af559378-c3a1-3672-8db4-4b1fd89af179",
                "word": "nono",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ce06f49c-f49f-4f3b-8f94-81b3e678fa6a",
                        "entry_id": "af559378-c3a1-3672-8db4-4b1fd89af179",
                        "tags": [
