                "senses": [
                    {
                        "sense_id": "56f4077b-7841-332c-8894-a0044ebf2ede",
                        "entry_id": "c6892cf9-563b-341c-a7ba-ce912b5b9d94",
                        "glosses": [
                            "Wort oder kurzer Spruch, das/der auf die Ideologie der Hamas Bezug nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b366bb17-78c9-4133-b4c1-d5e57e3890b7",
                                "sense_id": "56f4077b-7841-332c-8894-a0044ebf2ede",
                                "text": "„Die Sicherstellung des T-Shirts mit der Hamas-Parole bezieht sich nach Angaben des Polizeisprechers auf einen Vorfall im Juni, bei dem der Verdächtige das Shirt getragen haben soll.“"
                            },
                            {
                                "example_id": "47280036-aa39-4b0a-8015-9c9e5495a4bd",
                                "sense_id": "56f4077b-7841-332c-8894-a0044ebf2ede",
                                "text": "„Formulierungen, die nicht ins Bild passen, werden untersagt – bei Hamas-Parolen mit gutem Grund, bei anderen Parolen manchmal mit weniger guten Gründen.“"
                            },
                            {
                                "example_id": "e757b08d-5ba2-42d7-9728-3580f897af1d",
                                "sense_id": "56f4077b-7841-332c-8894-a0044ebf2ede",
                                "text": "„Nachdem die Polizei eine Besetzung des Sozialwissenschaftlichen Instituts durch pro-palästinensische Studenten und Aktivisten am Donnerstagabend aufgelöst hatte, entdeckte die Unileitung dort mehrere Graffiti und Beschmierungen mit Hamas-Parolen – darunter auch das rote Dreieck.“"
                            },
                            {
                                "example_id": "d784976c-2ab7-40c6-abc2-ca9808c0cfae",
                                "sense_id": "56f4077b-7841-332c-8894-a0044ebf2ede",
                                "text": "„Eine Hamas-Parole, die als Aufruf zur Auslöschung Israels gelesen werden kann, war offenbar seit Monaten auf einem Bungalow des Studierendenwerks im Olympischen Dorf in München zu lesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
