                "senses": [
                    {
                        "sense_id": "d7a36dd4-d704-3d5b-85aa-24ed46b2c7ef",
                        "entry_id": "f06747f0-a335-3647-a102-61a50f49f5e8",
                        "glosses": [
                            "zonder humor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "291795ff-f1a7-429b-a02d-486e3a0b001e",
                                "sense_id": "d7a36dd4-d704-3d5b-85aa-24ed46b2c7ef",
                                "text": "De chagrijnige, oude, humorloze man kon om geen enkel grapje lachen."
                            },
                            {
                                "example_id": "5d5d69a7-0f8b-4d72-bb18-61d01b5da66b",
                                "sense_id": "d7a36dd4-d704-3d5b-85aa-24ed46b2c7ef",
                                "text": "Zijn vrienden weten dat er nu een schoffering op handen is van alle humorloze betweters. ‘Twintig jaar geleden adviseerde de dokter me om te stoppen met drinken. ‘Oké’, zei ik. ‘Daar stem ik mee in. Maar dan blijf ik wel roken.’"
                            }
                        ]
                    }
                ],
