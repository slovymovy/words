                                "target_senses": [
                                    {
                                        "sense_id": "ec99c928-2d61-3917-b316-2662adbc53fc",
                                        "entry_id": "38ee6139-63d4-3bff-8487-504e4712d16f",
                                        "glosses": [
                                            "die Wissenschaft und die Lehre von den Bakterien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443613f5-9e45-4ab4-ac90-85b040c8bce2",
                                                "sense_id": "ec99c928-2d61-3917-b316-2662adbc53fc",
                                                "text": "„In der allgemeinen Bakteriologie werden hauptsächlich Morphologie, Physiologie, Biochemie, Vermehrung, Verbreitung und Systematik erforscht, während in der angewandten Bakteriologie vorwiegend Bekämpfung und Nutzung der Bakterien untersucht werden.“"
                                            },
                                            {
                                                "example_id": "b16ec782-6f0f-4946-9684-5cc887dd43c5",
                                                "sense_id": "ec99c928-2d61-3917-b316-2662adbc53fc",
                                                "text": "„Denn zu ebenjener Zeit, als die Deutschen ihre kolonialen Ambitionen entdeckten, war die Bakteriologie zur neuen Leitwissenschaft der Medizin aufgestiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
