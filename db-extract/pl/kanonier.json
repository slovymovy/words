                "translations": [
                    {
                        "translation_id": "6f837ef9-a05d-4a7e-87f6-81580700366d",
                        "source_entry_id": "220d680a-64e1-3491-8908-d52b69f8a896",
                        "source_sense_id": "aada8eed-670a-3052-88b3-3318747ef5f7",
                        "target_lang_word": "Kanonier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanonier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                                        "entry_id": "fbbc5e04-00a5-3a9a-b2a4-3b2db8eaed2a",
                                        "glosses": [
                                            "Soldat, der eine Kanone bedient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27071741-a3aa-463e-864e-4cc54f07face",
                                                "sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                                                "text": "„Sigismund Ludwig Borkheim - Vom königlich-preußischen Kanonier zum Russland-Experten an der Seiten von Marx und Engels.“"
                                            },
                                            {
                                                "example_id": "7becb0ad-d8b9-4bf4-8d35-d5607624304a",
                                                "sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                                                "text": "„Eine ovale Photographie erklärte, daß es einmal einen jungen Kanonier Jepsen gegeben hatte, der neben einer leichten Haubitze kniete wie vor einem Altar, derselbe Kanonier trug in Galizien einen Mantel und sang mit anderen Kanonieren einen Weihnachtsbaum an.“"
                                            },
                                            {
                                                "example_id": "254ae1c2-5399-42d2-a334-d8953e768edc",
                                                "sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                                                "text": "„Draußen auf dem See hatten wir uns eine Zielscheibe errichtet, an der wir regelmäßig übten, sodass wir ziemlich professionelle Kanoniere wurden.“"
                                            },
                                            {
                                                "example_id": "b307398c-2e4e-4f8f-9fb4-bf058fa03b41",
                                                "sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                                                "text": "„Den Alkohol tranken die Kanoniere auf der Stelle aus, was sie in heitere Stimmung versetzte.“"
                                            },
                                            {
                                                "example_id": "62c59f46-6239-4bd9-bf67-0d65f4432f67",
                                                "sense_id": "44c00847-d1cb-3f49-aacc-c42331454b4f",
                                                "text": "„Als er so glanzvoll an einem abgelegenen Feldgeschütz vorüberkam, überraschte er einen schnauzbärtigen Kanonier, der zwischen Bierflaschen und Schweinshaxen umsichtig Brotzeit machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd4edc22-3f69-364e-a801-b86634352849",
                                        "entry_id": "fbbc5e04-00a5-3a9a-b2a4-3b2db8eaed2a",
                                        "glosses": [
                                            "unterster Dienstgrad in der Artillerietruppe"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
