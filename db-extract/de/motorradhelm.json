                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26faa7a6-608b-4456-a16e-5fef7b97eea8",
                                "sense_id": "f4cbdf76-1b27-3f16-b0b5-f3336a948e27",
                                "text": "In vielen Ländern ist für Motorradfahrer das Tragen eines Motorradhelms gesetzlich vorgeschrieben."
                            },
                            {
                                "example_id": "b61fc6e2-5c3b-4549-b74e-bb07da4210fa",
                                "sense_id": "f4cbdf76-1b27-3f16-b0b5-f3336a948e27",
                                "text": "„Schon wenige Jahre später brachte Schuberth auch den ersten eigenen Motorradhelm, Modell Aero, auf den Markt - und konzentrierte sich dann bald ganz auf das Geschäft mit Helmen.“"
                            }
                        ],
