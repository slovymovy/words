                    },
                    {
                        "translation_id": "af6afdab-fba2-4124-90ed-cf0b7d79fea7",
                        "source_entry_id": "ba00e376-f10b-3c26-bbf0-2c28b091859b",
                        "target_lang_word": "de mica",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "51b910a1-7693-49fa-b2b5-772436f365dd",
                        "source_entry_id": "ba00e376-f10b-3c26-bbf0-2c28b091859b",
                        "target_lang_word": "micacé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "micacé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4dbe5ad6-76fe-3f20-bb64-bc7c60351fc4",
                                        "entry_id": "bfec138c-8844-30af-b515-5216e266d445",
                                        "glosses": [
                                            "Qui est de la nature du mica, qui contient du mica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3df477cb-785e-4361-a4e6-abfbd44af261",
                                                "sense_id": "4dbe5ad6-76fe-3f20-bb64-bc7c60351fc4",
                                                "text": "D’énormes pilastres gris de souris, d’un granit à gros grains micacés comme du sel de cuisine, montent jusqu’aux voûtes peintes à fresque, dont les tons azurés et vaporeux se lient mal avec la couleur froide et pauvre de l’architecture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ec5c34e-85eb-33bd-8038-c1a9e6ea5919",
                                        "entry_id": "bfec138c-8844-30af-b515-5216e266d445",
                                        "glosses": [
                                            "Qui a l’aspect brillant ou pailleté du mica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65acc6eb-7194-4d33-82c5-c7346f39d2b7",
                                                "sense_id": "6ec5c34e-85eb-33bd-8038-c1a9e6ea5919",
                                                "text": "Le coprin micacé croît sous feuillus et sous conifères, en troupes parfois très denses à proximité des souches en voie de pourrissement […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b324b96c-cd2d-3645-8cf0-c95578c18457",
                                        "entry_id": "bfec138c-8844-30af-b515-5216e266d445",
                                        "glosses": [
                                            "Qui a l’aspect brillant ou pailleté du mica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848b4ae8-7395-46b9-9737-eacb38c9b2cd",
                                                "sense_id": "b324b96c-cd2d-3645-8cf0-c95578c18457",
                                                "text": "« … Une longue galerie ouverte et ensoleillée, des lits de repos, ton vieux mari couché, emmailloté de couvertures, une atmosphère micacée et brillante, d’une sonorité qui blesse d’abord et qui charme ensuite… un soleil dépouillé et trompeur, froid et doré comme un vin de montagne… »"
                                            },
                                            {
                                                "example_id": "6b335891-8479-44ee-9d58-f565f371e7d1",
                                                "sense_id": "b324b96c-cd2d-3645-8cf0-c95578c18457",
                                                "text": "« Sido » n’avait point sa pareille pour feuilleter, en les comptant, les pelures micacées des oignons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
