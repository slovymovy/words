                                    {
                                        "sense_id": "f5bd8a40-be84-3b59-b758-84ec9e0491b7",
                                        "entry_id": "a1f258b0-0b3d-31a4-81a0-39a5aa43b789",
                                        "glosses": [
                                            "Person, die überdurchschnittliche Kenntnisse auf einem bestimmten Sach- oder Wissensgebiet besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15e25852-8b2a-4127-b29a-40ad2e9b5aef",
                                                "sense_id": "f5bd8a40-be84-3b59-b758-84ec9e0491b7",
                                                "text": "Er ist ein großer Kenner besonders der deutschen Weine."
                                            },
                                            {
                                                "example_id": "140e988f-d153-4ef2-bd3c-825688b85743",
                                                "sense_id": "f5bd8a40-be84-3b59-b758-84ec9e0491b7",
                                                "text": "Unser Universitätsprofessor ist ein gründlicher und hervorragender Kenner der Antike."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
