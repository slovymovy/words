                                "target_senses": [
                                    {
                                        "sense_id": "95a93dc5-963d-3f58-9d38-7b09d32d8707",
                                        "entry_id": "032e340d-4083-3ac5-92c1-318c34a839b5",
                                        "glosses": [
                                            "лёгкое дрожание, колебание или мерцание чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d83ff115-8f3f-42ed-9444-cab84bcfb5cc",
                                                "sense_id": "95a93dc5-963d-3f58-9d38-7b09d32d8707",
                                                "text": "Гринёв помолчал секунду, следя за трепетом её ресниц."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2e9fe49-367b-30ba-8508-c2c5f64bf7a8",
                                        "entry_id": "032e340d-4083-3ac5-92c1-318c34a839b5",
                                        "glosses": [
                                            "перен. сильное волнение от чего-либо, страх чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebd92146-d659-420f-ad47-8f5cbf864a9c",
                                                "sense_id": "b2e9fe49-367b-30ba-8508-c2c5f64bf7a8",
                                                "text": "И вот ещё от чего мне стало хорошо: трепета у меня не было перед великим Ильёй; у друга, наверно, был, а я был не обязан."
                                            }
                                        ]
                                    }
                                ]
                            },
