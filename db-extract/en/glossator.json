                "senses": [
                    {
                        "sense_id": "57510bf5-cd61-3d92-ac55-26bdd4a69d6d",
                        "entry_id": "c5644b5c-804d-3746-bf3a-ba9e73c59bf3",
                        "glosses": [
                            "One who writes glosses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0808cabf-e3f5-4c04-b85a-c2bf12c3ad65",
                                "sense_id": "57510bf5-cd61-3d92-ac55-26bdd4a69d6d",
                                "text": "One to two generations after its copying, an extensive but intermittent interlinear Latin gloss [...] was added[.] [...] The glossator also added a single [Old English] gloss"
                            }
                        ]
                    },
                    {
                        "sense_id": "6878a113-f946-3f0a-8232-df6a5f969537",
                        "entry_id": "c5644b5c-804d-3746-bf3a-ba9e73c59bf3",
                        "glosses": [
                            "A legal scholar of the Middle Ages, (specifically) one who authored glosses on legal texts (especially the Corpus Juris of Justinian), typically distinguished from the later commentators who wrote in extended prose and adopted a more pragmatic form of jurisprudence."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67a1242d-06cb-48d9-8fd4-a63479d3f65d",
                        "source_entry_id": "c5644b5c-804d-3746-bf3a-ba9e73c59bf3",
                        "source_sense_description": "one who writes glosses",
                        "target_lang_word": "glossateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glossateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "500b949a-42f4-3f8a-a0df-6b62fda52f02",
                                        "entry_id": "2ebaa056-e2f0-3a19-a47a-83b39d503fc2",
                                        "glosses": [
                                            "Qui recueille et reformule les propos d’un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "952ee28e-67f5-4168-ba1e-ef9cf23b37d2",
                                                "sense_id": "500b949a-42f4-3f8a-a0df-6b62fda52f02",
                                                "text": "La phrase de M. Pauphilet sur « l’histoire-actualité de M. André Rousseaux » est vraiment un chef-d’œuvre d’audace glossatrice : elle ne tue pas le texte, elle l’invente."
                                            },
                                            {
                                                "example_id": "52207f40-3154-4262-b094-97698192c3c0",
                                                "sense_id": "500b949a-42f4-3f8a-a0df-6b62fda52f02",
                                                "text": "— Oui : il devra bien mâcher, disait un esprit glossateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glossateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d09ec413-cc6b-3760-b805-c392f81fcef0",
                                        "entry_id": "e1ae3be3-0134-314a-9eba-084cf340efe3",
                                        "glosses": [
                                            "Celui qui fait ou recueille des gloses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a219d70-584e-4a55-a957-79ed335122c8",
                                                "sense_id": "d09ec413-cc6b-3760-b805-c392f81fcef0",
                                                "text": "L’enseignement des glossateurs vint animer en France les universités naissantes."
                                            }
