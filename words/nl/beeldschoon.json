                            }
                        },
                        {
                            "text": "Het uitzicht vanaf de top van de berg was werkelijk <w>beeldschoon</w>.",
                            "target_lang_translations": {
                                "en": "The view from the top of the mountain was truly <w>stunning</w>.",
                                "fr": "La vue depuis le sommet de la montagne était véritablement <w>magnifique</w>."
                            }
