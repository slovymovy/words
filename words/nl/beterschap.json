    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "4d7758f1-c9a0-30aa-aadf-2abb00876a84",
                    "sense_definition": "uitroep waarmee men iemand een voorspoedig herstel van een ziekte toewenst",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "herstel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hoorde dat je griep hebt, van harte <w>beterschap</w> gewenst!",
                            "target_lang_translations": {
                                "en": "I heard you have the flu, wishing you a heartfelt <w>get well soon</w>!"
                            }
                        },
                        {
                            "text": "Doe maar rustig aan vandaag en veel <w>beterschap</w>!",
                            "target_lang_translations": {
                                "en": "Take it easy today and <w>get well soon</w>!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "van harte beterschap"
                    ],
                    "target_lang_definitions": {
                        "en": "exclamation used to wish someone a speedy recovery from illness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get well soon",
                                "target_lang_sense_clarification": "used to wish someone a speedy recovery"
                            },
                            {
                                "target_lang_word": "speedy recovery",
                                "target_lang_sense_clarification": "wishing someone a quick return to health"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69d4bc60-c1e3-3cda-8660-0ab8b7edc3b3",
                    "sense_definition": "het proces of de toestand van herstellen van een ziekte of aandoening",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "herstel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wens je spoedige <w>beterschap</w> na de zware operatie.",
                            "target_lang_translations": {
                                "en": "I wish you a speedy <w>recovery</w> after the major surgery."
                            }
                        },
                        {
                            "text": "De arts ziet gelukkig al duidelijke tekenen van <w>beterschap</w>.",
                            "target_lang_translations": {
                                "en": "Fortunately, the doctor already sees clear signs of <w>improvement</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "herstel",
                        "genezing"
                    ],
                    "antonyms": [
                        "verslechtering"
                    ],
                    "common_phrases": [
                        "spoedige beterschap",
                        "tekenen van beterschap"
                    ],
                    "target_lang_definitions": {
                        "en": "the process or state of recovering from an illness or medical condition"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "recovery",
                                "target_lang_sense_clarification": "return to health after illness or injury"
                            },
                            {
                                "target_lang_word": "improvement",
                                "target_lang_sense_clarification": "favourable change in health condition"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "847a0e44-3a8b-38d0-8261-f639c2c3655f",
                    "sense_definition": "verandering ten goede in iemands gedrag of houding",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbetering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na zijn foute gedrag beloofde de leerling beterschap aan de leraar.",
                            "target_lang_translations": {
                                "en": "After his bad behavior, the student promised <w>to mend his ways</w> to the teacher."
                            }
                        },
                        {
                            "text": "We hopen allemaal op <w>beterschap</w> in deze moeilijke situatie.",
                            "target_lang_translations": {
                                "en": "We all hope for an <w>improvement</w> in this difficult situation."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbetering"
                    ],
                    "common_phrases": [
                        "beterschap beloven"
                    ],
                    "target_lang_definitions": {
                        "en": "a change for the better in one's behavior, attitude, or a difficult situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "improvement",
                                "target_lang_sense_clarification": "mending of ways or bettering of a situation"
                            },
                            {
                                "target_lang_word": "amendment",
                                "target_lang_sense_clarification": "reformation of behavior"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}