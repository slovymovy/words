                                    },
                                    {
                                        "sense_id": "d1f3dec9-108f-35d9-949e-e46b9ae42f91",
                                        "entry_id": "947161ed-e310-3f16-b27d-75c51c54fa9c",
                                        "glosses": [
                                            "Pondering, especially thinking back on the past."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de2e222a-df38-41f1-a33c-2fc25adb17cf",
                                                "sense_id": "d1f3dec9-108f-35d9-949e-e46b9ae42f91",
                                                "text": "He always becomes reflective in preparation for the new year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c076db7-3bed-3455-ac8d-145c1bc5d0aa",
                                        "entry_id": "947161ed-e310-3f16-b27d-75c51c54fa9c",
                                        "glosses": [
                                            "That reveals or shows; revealing; indicative of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64be880a-f786-48bf-b653-280db239ca47",
                                                "sense_id": "2c076db7-3bed-3455-ac8d-145c1bc5d0aa",
                                                "text": "In any event, the incident, and the media attention it attracted, highlights the sensitivity of language politics in Singapore and is reflective of the fact that this sensitivity extends to campus life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "467e8ac1-f82b-3935-9d11-17b3790e7fce",
                                        "entry_id": "947161ed-e310-3f16-b27d-75c51c54fa9c",
                                        "glosses": [
                                            "Involving reflection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5bfb3c0-950a-34df-bc88-3ccb3e78a36d",
                                        "entry_id": "947161ed-e310-3f16-b27d-75c51c54fa9c",
                                        "glosses": [
                                            "By means of reflection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67ff67a3-b0eb-4c1f-b421-4f4ba4cfc445",
                                                "sense_id": "b5bfb3c0-950a-34df-bc88-3ccb3e78a36d",
                                                "text": "In JIT compilation, the running program is reflectively modified by an embedded compiler, which only uses two reflective operations […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cedb54c-d1c6-3d1b-8210-c5514383294d",
