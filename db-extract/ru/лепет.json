                "senses": [
                    {
                        "sense_id": "9325338f-9585-3113-a307-a19702d38d74",
                        "entry_id": "a74a5879-98b9-3984-a788-d0d63fe83a07",
                        "glosses": [
                            "неясная, несвязная речь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "220c5609-122d-4f92-8fa6-f117c5827616",
                                "sense_id": "9325338f-9585-3113-a307-a19702d38d74",
                                "text": "Это был какой-то бред, какой-то лепет, — точно ей хотелось что-то поскорей мне рассказать, — бред, прерываемый иногда самым весёлым смехом, который начинал пугать меня."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d18c5e0-31e0-3208-80ca-2a3a85ca3cc7",
                        "entry_id": "a74a5879-98b9-3984-a788-d0d63fe83a07",
                        "glosses": [
                            "нежная болтовня"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c3e21fd8-a58d-3bd6-93c9-f9ad51f69137",
                        "entry_id": "a74a5879-98b9-3984-a788-d0d63fe83a07",
                        "glosses": [
                            "перен. невнятный, лёгкий шум, шелест, звучание чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0eaf63b-667e-4432-95d5-8e47780c7fa5",
                                "sense_id": "c3e21fd8-a58d-3bd6-93c9-f9ad51f69137",
                                "text": "Мы запили прозрачный тёплый мёд ключевой водой и заснули под однообразное жужжанье пчёл и болтливый лепет листьев."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a355c01-151a-366b-ae11-ee87cb60889e",
                        "entry_id": "a74a5879-98b9-3984-a788-d0d63fe83a07",
                        "glosses": [
                            "перен. неубедительные рассуждения, объяснения"
                        ],
                        "tags": [],
                        "examples": []
