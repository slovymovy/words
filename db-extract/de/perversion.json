                        "sense_id": "0657db4e-695e-3c7b-9afc-4cfc8ab1cedf",
                        "entry_id": "d5218097-6f12-3ada-8bac-0a03662ff468",
                        "glosses": [
                            "Verkehrung ins Krankhafte oder Abnorme beziehungsweise ein solches Empfinden und Verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5886cb99-f349-40a6-a336-cd80f8d4f6af",
                                "sense_id": "0657db4e-695e-3c7b-9afc-4cfc8ab1cedf",
                                "text": "Wie allerdings das Morden im Namen Gottes aus christlicher Sicht eine Perversion des Gottesnamens darstellt, so ist es irreführend und pervers, Selbstmordattentäter mit dem Ehrentitel von Märtyrern zu schmücken."
                            },
                            {
                                "example_id": "897e32f6-fa7c-459f-b29e-8a29dd4b9d6d",
                                "sense_id": "0657db4e-695e-3c7b-9afc-4cfc8ab1cedf",
                                "text": "„Es ist ein ungeheuerlicher, fast monströser Trieb, aber wir werden sehn, daß Sade ihm den Anspruch verdankt, der erste Systematologe der Perversionen gewesen zu sein, hundert Jahre vor Krafft Ebing.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
