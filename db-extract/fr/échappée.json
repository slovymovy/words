        "fr-extract.jsonl": [
            {
                "entry_id": "94f75402-6f5b-37a1-ae0e-832bd72890ac",
                "word": "échappée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c56fa23c-7092-4a0f-86f9-672eaf74ee6c",
                        "entry_id": "94f75402-6f5b-37a1-ae0e-832bd72890ac",
                        "tags": [
                            "plural"
                        ],
                        "form": "échappées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42e092c7-bec5-32b5-9efc-42077c01d67b",
                        "entry_id": "94f75402-6f5b-37a1-ae0e-832bd72890ac",
                        "glosses": [
                            "Action imprudente par laquelle on s’écarte de son devoir, de sa position."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "413b60d2-05bc-46a8-bf1f-24ee7a1d860b",
                                "sense_id": "42e092c7-bec5-32b5-9efc-42077c01d67b",
                                "text": "Le directeur de la Congrégation ; comme une glousse que la première échappée de ses poussins jette dans les plus cruelles angoisses, confie sa plainte au cœur de son ami toujours prêt à le consoler : […]."
                            },
                            {
                                "example_id": "42617256-14f7-4aac-b06a-50c5a96d5cb3",
                                "sense_id": "42e092c7-bec5-32b5-9efc-42077c01d67b",
                                "text": "Lorsqu’il lui arrivait, à propos de ce fameux Journal, de se voir reprocher une échappée de plume, il en était affligé pendant des semaines."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a8ec269-4036-3dc3-a921-55ca89fa85df",
                        "entry_id": "94f75402-6f5b-37a1-ae0e-832bd72890ac",
                        "glosses": [
                            "Espace ménagé pour le tournant des voitures à leur entrée dans une cour, dans une remise ou dans un garage."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "74f2d564-71f0-3441-8f3b-e10676118362",
                        "entry_id": "94f75402-6f5b-37a1-ae0e-832bd72890ac",
                        "glosses": [
                            "Espace qu’on laisse entre un escalier et la voûte ou le plafond."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "367568a1-c016-35e0-a879-fe47b7345502",
                        "entry_id": "94f75402-6f5b-37a1-ae0e-832bd72890ac",
                        "glosses": [
                            "Hauteur comprise entre une volée d'escalier et son couvrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edd5f2f8-9dfa-46f2-b997-a416cd5a32b2",
                                "sense_id": "367568a1-c016-35e0-a879-fe47b7345502",
                                "text": "Si on ne veut pas se cogner la tête, il faut une échappée d'au moins 1,90 m."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7737f5d-fc52-3373-9d41-f40092312de5",
                        "entry_id": "94f75402-6f5b-37a1-ae0e-832bd72890ac",
                        "glosses": [
                            "Échappée de lumière ; échappée de vue."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "936c646a-8272-4bf7-8c06-a6f06320c065",
                                "sense_id": "a7737f5d-fc52-3373-9d41-f40092312de5",
                                "text": "Cette échappée d’un luxe vu à travers la douleur lui rendit Charles encore plus intéressant, par contraste peut-être.."
                            },
                            {
                                "example_id": "3ccf0b70-dff7-4bb1-9eba-cb92454307e0",
                                "sense_id": "a7737f5d-fc52-3373-9d41-f40092312de5",
                                "text": "Malheureusement le brouillard et la fumée s’épaississent encore ; on ne voit plus autour de soi que par échappées ; et plus on avance, moins on voit clair."
                            },
                            {
                                "example_id": "e599c335-7123-4b27-bb08-bb13f976132e",
                                "sense_id": "a7737f5d-fc52-3373-9d41-f40092312de5",
                                "text": "Encore des échappées sur la nappe bleue de Marmara, les îles ou les montagnes d’Asie, mais les passants rares et les cases tristes."
                            },
                            {
                                "example_id": "9f3de189-582b-4213-9f6f-6c87f4b072b8",
                                "sense_id": "a7737f5d-fc52-3373-9d41-f40092312de5",
                                "text": "La brume nous enveloppa de nouveau, bien que le soleil brillât dans une échappée de ciel au dessus de nos têtes."
                            },
                            {
                                "example_id": "9c95df96-566d-4e0d-89de-f67d90726e73",
                                "sense_id": "a7737f5d-fc52-3373-9d41-f40092312de5",
                                "text": "À cet endroit de la route, il y a une magnifique échappée sur la vallée."
                            },
                            {
                                "example_id": "f41d867c-6cae-4f8c-9d15-4de9be50fb72",
                                "sense_id": "a7737f5d-fc52-3373-9d41-f40092312de5",
                                "text": "— Il y a dans cette étude historique des échappées sur d’autres sujets."
                            },
                            {
                                "example_id": "e5ce9fa1-7edd-47de-a397-3e69584b0818",
                                "sense_id": "a7737f5d-fc52-3373-9d41-f40092312de5",
                                "text": "Pierre apprit que le Code rognait la part des bâtards au profit des enfants légitimes. Cela ne le consola nullement. Il voulait tout. Il n’aurait pas partagé dix sous entre Ursule et Antoine. Cette échappée sur les complications du Code lui ouvrit de nouveaux horizons, qu’il sonda d’un air singulièrement songeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "6cf3d930-b882-369a-a5e1-4a22b5ea9681",
                        "entry_id": "94f75402-6f5b-37a1-ae0e-832bd72890ac",
                        "glosses": [
                            "Action de distancer les autres coureurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b24f8bb-524a-43be-b71f-2e4134206f42",
                                "sense_id": "6cf3d930-b882-369a-a5e1-4a22b5ea9681",
                                "text": "L’échappée des deux jeunes gens ne préoccupait évidemment pas les leaders qui se réservaient pour l’attaque des treize lacets."
                            },
                            {
                                "example_id": "a77e3165-95b8-4dc7-bce0-fd412f5680a0",
                                "sense_id": "6cf3d930-b882-369a-a5e1-4a22b5ea9681",
                                "text": "Peut-être l’immense majorité du peloton a-t-elle intégré qu’il n’y avait plus rien à tirer de telles échappées, et qu’il valait mieux garder ses forces pour aider son leader en montagne ou dans la préparation des sprints."
                            },
                            {
                                "example_id": "c1f9b9f7-dd41-4e23-8719-6b5bac05c27b",
                                "sense_id": "6cf3d930-b882-369a-a5e1-4a22b5ea9681",
                                "text": "Après la belle échappée de Coralie Delay la veille, les six coureuses régionales encore en lice n’ont pas eu l’occasion de se signaler à l’avant de la course, jeudi."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ba4f1bb-f7b4-31fa-9b71-5d6487db6a62",
                        "entry_id": "94f75402-6f5b-37a1-ae0e-832bd72890ac",
                        "glosses": [
                            "Développement extérieur au sujet principal."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3d974f6c-ef74-4fbb-986d-1ecd471eab3c",
                                "sense_id": "0ba4f1bb-f7b4-31fa-9b71-5d6487db6a62",
                                "text": "Je lisais ardemment Platon, aidée certes d’une traduction juxtalinéaire : les archétypes, les mythes, les grands débats sur l’immortalité passaient devant moi un peu comme des nuées, mais je ne me lassais pas des échappées, soigneusement choisies, je le sais aujourd’hui, sur la vie athénienne, Socrate et Phèdre au bord du Céphise, la palestre que fréquentaient Charmide et le rougissant Lysis."
                            }
                        ]
                    }
                ],
