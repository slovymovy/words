                                        "sense_id": "5ecda077-b957-354e-8258-eecc82eb9d34",
                                        "entry_id": "ab670ce9-542d-32ab-bd67-89d028ccef30",
                                        "glosses": [
                                            "nachhaltige, planmäßige Übungen im Sport oder anderen Bereichen, um die Leistungen zu verbessern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f82ca5e3-0861-4916-9947-5b67335fbb07",
                                                "sense_id": "5ecda077-b957-354e-8258-eecc82eb9d34",
                                                "text": "Leistungssportler benötigen viel Training."
                                            },
                                            {
                                                "example_id": "ff9fd3e0-37bc-495b-b5da-cf6c6c688c6a",
                                                "sense_id": "5ecda077-b957-354e-8258-eecc82eb9d34",
                                                "text": "„Jack begann sein Training auf Danny Hogans Gesundheitsfarm drüben in Jersey.“"
                                            },
                                            {
                                                "example_id": "ed80345b-36ac-47c7-9113-aafee8c5f7b1",
                                                "sense_id": "5ecda077-b957-354e-8258-eecc82eb9d34",
                                                "text": "„Das ist die erste Richtzeit im Otodrom im asiatischen Teil Istanbuls, nämlich die Beste der zwei freien Trainings am Freitag.“"
                                            },
                                            {
                                                "example_id": "3cf6c8b4-54ec-48c4-92ca-237fc9cfe989",
                                                "sense_id": "5ecda077-b957-354e-8258-eecc82eb9d34",
                                                "text": "„Drachenfliegen ist eine anspruchsvolle, dynamische Flugsportart. Sie erfordert überdurchschnittlich gute körperliche Fitness und regelmäßiges Training.“"
                                            },
                                            {
                                                "example_id": "1e6d2ab1-a176-40ea-a15c-c48e1c90a424",
                                                "sense_id": "5ecda077-b957-354e-8258-eecc82eb9d34",
                                                "text": "„Clerfayt hatte Lillian verboten, beim Training dabei zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
