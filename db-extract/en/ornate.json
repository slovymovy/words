                    {
                        "translation_id": "a89aa6e5-9c96-47d4-86a6-bce70f968649",
                        "source_entry_id": "662d02e8-d31d-3784-a7e5-209bad8547fa",
                        "source_sense_description": "flashy, flowery or showy",
                        "target_lang_word": "bloemrijk",
