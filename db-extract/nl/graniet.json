        "nl-extract.jsonl": [
            {
                "entry_id": "205d0a43-9e55-3ed0-815d-f21d69d8760c",
                "word": "graniet",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2682d2ec-2021-3b07-91a8-c96d47402586",
                        "entry_id": "205d0a43-9e55-3ed0-815d-f21d69d8760c",
                        "glosses": [
                            "hard stollingsgesteente bestaande uit lichtgekleurde, met het blote oog onderscheidbare mineralen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e67346fa-4e9c-4bcb-886c-36159b6046fe",
                                "sense_id": "2682d2ec-2021-3b07-91a8-c96d47402586",
                                "text": "Graniet is afkomstig uit gestold magma."
                            },
                            {
                                "example_id": "8240467c-ea14-4c72-8d90-1b1325e90eb4",
                                "sense_id": "2682d2ec-2021-3b07-91a8-c96d47402586",
                                "text": "In etappe 2 komen ze door een streek met 2 miljard jaar oud graniet. Dat gesteente bestond al vér voor er complex leven op aarde was!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1e0b813-cd28-4f70-a347-b076799aeca4",
                        "source_entry_id": "205d0a43-9e55-3ed0-815d-f21d69d8760c",
                        "source_sense_id": "2682d2ec-2021-3b07-91a8-c96d47402586",
                        "source_sense_description": "stollingsgesteente bestaande uit lichtgekleurde, met het blote oog onderscheidbare mineralen.",
                        "target_lang_word": "Granit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Granit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd346eea-d9bf-389d-a7f6-61651d034b86",
                                        "entry_id": "90218846-3473-338f-abc7-312dc72d6485",
                                        "glosses": [
                                            "Gestein aus Feldspat, Quarz und Glimmer, das besonders hart ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f2f7e1-b269-418e-a252-86ad43acc4c7",
                                                "sense_id": "cd346eea-d9bf-389d-a7f6-61651d034b86",
                                                "text": "Im Harz gibt es auch Granit."
                                            },
                                            {
                                                "example_id": "68d7f8e1-4172-4c88-ad6b-663631683ff6",
                                                "sense_id": "cd346eea-d9bf-389d-a7f6-61651d034b86",
                                                "text": "Granit ist ein besonders hartes Gestein."
                                            },
                                            {
                                                "example_id": "96219317-b7a5-41a2-9d59-aa05a0b3330e",
                                                "sense_id": "cd346eea-d9bf-389d-a7f6-61651d034b86",
                                                "text": "„Da steht es wie mit Keilschrift in Granit gehauen.“"
                                            },
                                            {
                                                "example_id": "e490bc40-75eb-4a29-9bf5-fd59e810d387",
                                                "sense_id": "cd346eea-d9bf-389d-a7f6-61651d034b86",
                                                "text": "„Zwei 3,50 Meter hohe Monolithe aus Granit erheben sich vor dem Eingang.“"
                                            },
                                            {
                                                "example_id": "db09815e-c493-4259-8c75-2e5ec46b42ad",
                                                "sense_id": "cd346eea-d9bf-389d-a7f6-61651d034b86",
                                                "text": "„Vor dem Mauerbau hatte man noch ein Stück unter dem Seespiegel ein Loch in den Granit geschlagen, durch das etwas Wasser den Gang hinunterrann und das Granithaus mit 150 l Wasser pro Tag versorgte.“"
                                            },
                                            {
                                                "example_id": "cb47ee1e-8f99-4eb5-bb9d-ca72bc3c9069",
                                                "sense_id": "cd346eea-d9bf-389d-a7f6-61651d034b86",
                                                "text": "„Jenseits des Kanals, zwischen den von Speichern unterbrochenen Häuserzeilen, stand der weite, klare Himmel in Flächen von tiefem Blau, und im Rückprall der Sonnenstrahlen blendeten die weißen Fassaden, die Schieferdächer und die Kais aus Granit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3acbee5a-bab1-4418-8cbe-56a9581be5f1",
                        "source_entry_id": "205d0a43-9e55-3ed0-815d-f21d69d8760c",
                        "source_sense_id": "2682d2ec-2021-3b07-91a8-c96d47402586",
                        "source_sense_description": "stollingsgesteente bestaande uit lichtgekleurde, met het blote oog onderscheidbare mineralen.",
                        "target_lang_word": "granite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "granite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28ad3c49-3f10-316d-9fec-e2c5dc1aaabd",
                                        "entry_id": "258082d4-8147-3c72-97ef-8971f5214ae9",
                                        "glosses": [
                                            "A group of igneous and plutonic rocks composed primarily of feldspar and quartz. Usually contains one or more dark minerals, which may be mica, pyroxene, or amphibole. Granite is quarried for building stone, road gravel, decorative stone, and tombstones. Common colors are gray, white, pink, and yellow-brown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7035389b-7e8a-4068-b800-010e86f1c985",
                                                "sense_id": "28ad3c49-3f10-316d-9fec-e2c5dc1aaabd",
                                                "text": "Many monuments sold in the US are crafted from granite produced in China, India and elsewhere overseas, while a lot of stone-working equipment comes from Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "641200a7-51aa-36e1-8a87-5f2017d3bab2",
                                        "entry_id": "258082d4-8147-3c72-97ef-8971f5214ae9",
                                        "glosses": [
                                            "Toughness; the quality of having a thick skin or being rough."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3d2b7eb-721a-4a6c-b087-931a77cb68ce",
                                                "sense_id": "641200a7-51aa-36e1-8a87-5f2017d3bab2",
                                                "text": "‘Then the father has a great fight with his terrible conscience,’ said Munday with granite seriousness. ‘Should he make a row with the police […]? Or should he say nothing about it and condone brutality for fear of appearing in the newspapers?"
                                            },
                                            {
                                                "example_id": "c44dcdc8-1a6a-4a0b-9b2e-30e223eefa72",
                                                "sense_id": "641200a7-51aa-36e1-8a87-5f2017d3bab2",
                                                "text": "The neighbor is eventually able to sell her home despite Homer’s pants-less affronts to propriety and decency and Bart falls deeply and instantly for one of its new inhabitants, a tough but charming and funny tomboy girl named Laura (voiced by Sara Gilbert) with just the right combination of toughness and sweetness, granite and honey."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc4620a2-5e23-45b6-80fb-04b911d8e12e",
                        "source_entry_id": "205d0a43-9e55-3ed0-815d-f21d69d8760c",
                        "source_sense_id": "2682d2ec-2021-3b07-91a8-c96d47402586",
                        "source_sense_description": "stollingsgesteente bestaande uit lichtgekleurde, met het blote oog onderscheidbare mineralen.",
                        "target_lang_word": "granite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "granite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18d3a068-9305-37e5-964d-0415982b5472",
                                        "entry_id": "d552cb78-ae4e-3c45-99b2-9df393af924f",
                                        "glosses": [
                                            "Roche plutonique essentiellement de feldspaths et de quartz dans des proportions bien définies, ainsi qu'éventuellement de mica ou d'amphibole ayant une structure grenue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebb892a4-229c-485a-b57d-73de4c49e068",
                                                "sense_id": "18d3a068-9305-37e5-964d-0415982b5472",
                                                "text": "Il existe encore une classe de roches feldspathiques dont nous n'avons pas encore parlé, parce qu'elle est indépendante des granites: ce sont les eurites ou pétrosilex, tantôt purs, tantôt mélangés de cristaux de quartz, […]."
                                            },
                                            {
                                                "example_id": "cf5c7bfc-3132-4b61-8267-4fe39bf77829",
                                                "sense_id": "18d3a068-9305-37e5-964d-0415982b5472",
                                                "text": "Dans les environs de Zermo, dans la région comprise entre les deux massifs de quartzite qui se dressent au nord-est et au sud-est de Zinder, et dont nous avons déjà parlé, le granite émerge encore en plusieurs points au milieu des sables."
                                            },
                                            {
                                                "example_id": "6b1ddc13-3215-4b1e-84e3-0d73c1d4cf80",
                                                "sense_id": "18d3a068-9305-37e5-964d-0415982b5472",
                                                "text": "Les éléments sont très hétérométriques et composés à 70 % de granite dans une matrice graveleuse à sableuse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "granite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31379c2e-899f-3c06-ac2b-ef90c5c06abf",
