                ],
                "senses": [
                    {
                        "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                        "entry_id": "6d7060cf-c27f-30d7-bd30-7caa6c3c91f3",
                        "glosses": [
                            "Übertragung von Krankheitserregern durch Berührung (im Gegensatz zur berührungslosen Übertragung bei der Tröpfcheninfektion)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70f7c4d0-039b-4ac2-a35c-def9880b9bae",
                                "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                                "text": "'Schmierinfektion' ist ein Begriff, den Epidemiologen nicht mehr gerne verwenden. Sie sagen lieber 'Kontaktinfektion'."
                            },
                            {
                                "example_id": "dd9d0ca5-1a44-404e-ae88-d00b1943582c",
                                "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                                "text": "Nach derzeitigem Stand spielt die Schmierinfektion beim Coronavirus eine untergeordnete Rolle."
                            },
                            {
                                "example_id": "4a2bfda6-e209-4c31-bfbf-d44b84be3391",
                                "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                                "text": "[Feigwarzen] „sitzen vor allem an den Genitalien und werden durch Schmierinfektion beim Geschlechtsverkehr übertragen.“"
                            },
                            {
                                "example_id": "136e0bb4-1e55-4a9a-b792-904fd10ae653",
                                "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                                "text": "„»Es geht ja darum, dass sich die Menschen nicht über eine sogenannte Schmierinfektion anstecken.«“"
                            },
                            {
                                "example_id": "df3b5dd5-7afe-4218-85e0-d009378814fc",
                                "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                                "text": "„Übertragen wird das Virus in aller Regel über Schmierinfektionen.“"
                            },
                            {
                                "example_id": "f194bfc0-f0e5-4eb7-ae64-51daef02f4ef",
                                "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                                "text": "„Ein grippaler Infekt verbreitet sich über eine Tröpfchen- oder Schmierinfektion. […] Die Schmierinfektion wird auch Kontaktinfektion genannt - hier werden Viren durch eine Kette von Berührungen weitergegeben, beispielsweise beim Händeschütteln oder Benutzen von Türgriffen.“"
                            },
                            {
                                "example_id": "ef2d92da-199e-4751-a388-c9383415f49e",
                                "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                                "text": "„Kann der Paketbote mich infizieren? […] Auf Papier, Pappe oder Plastik können die Erreger mehrere Stunden bis Tage überleben. Wer sich dann noch ins Gesicht fasst, handelt sich womöglich eine Schmierinfektion ein.“"
                            },
                            {
                                "example_id": "7daf1baa-1dc3-4079-b0f6-e861793c1337",
                                "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                                "text": "„Der EHEC-Erreger wird durch Schmierinfektion übertragen, eine Ansteckung kann zum Beispiel durch verunreinigte Lebensmittel erfolgen.“"
                            },
                            {
                                "example_id": "a9cc2c7c-0817-496a-9b38-f0403c0181bf",
                                "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                                "text": "„Die RNA-Viren werden hauptsächlich durch Schmierinfektionen (Kot) übertragen: Über Mund und Nase gelangen sie in Magen und Darm, wo sie sich vermehren und über den Blutkreislauf bis ins Rückenmark transportiert werden können.“"
                            },
                            {
                                "example_id": "55c154ca-eb82-47f6-8b19-cb6efe4ddac7",
                                "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                                "text": "[Kinderlähmung/Polio:] „Auslöser sind zwei verschiedene Virustypen aus der Gruppe der RNA-Viren. Sie werden vor allem per Schmierinfektion über Kot übertragen.“"
                            },
                            {
                                "example_id": "e48c7f4d-5278-4eee-9e7e-c4dda4996336",
                                "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                                "text": "[Hepatitis A:] „Hervorgerufen wird sie vor allem durch verschmutztes Wasser, verunreinigte Lebensmittel oder auch fäkal-oral durch Kontakt- oder Schmierinfektion zwischen Personen.“"
                            },
                            {
                                "example_id": "521240a8-0adf-4f4d-b039-7b1cb6b007e2",
                                "sense_id": "477d7000-f32f-3ff5-8e9b-c6bdb312e11f",
                                "text": "[Lassafieber:] „Vor allem Garten- oder Feldfrüchte, die durch Kot, Urin oder Blut der Nagetiere verunreinigt sind, können für den Menschen gefährlich werden. Eine Erkrankung durch die verunreinigten Nahrungsmittel nennt sich Kontakt- oder Schmierinfektion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
