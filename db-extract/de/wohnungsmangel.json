                "senses": [
                    {
                        "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                        "entry_id": "e880a44a-4597-3b53-9351-3de1e5139192",
                        "glosses": [
                            "Zustand, bei dem zu wenig Wohnraum/zu wenige Wohnungen verfügbar sind"
                        ],
                        "tags": [
                            "nur im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "36d3f389-ba77-4476-8264-21cf9155d383",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„In den 1970er Jahren war der Wohnungsmangel der Nachkriegszeit weitgehend beseitigt.“"
                            },
                            {
                                "example_id": "922e81f2-9a21-45b6-9492-1c05fc1423ef",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Studierende protestieren immer wieder gegen den Wohnungsmangel in Großstädten.“"
                            },
                            {
                                "example_id": "c06ff246-1ab1-40d7-92c4-e4570164d42f",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Trotz Wohnungsmangel gibt es in Deutschland auch leerstehende Gebäude.“"
                            },
                            {
                                "example_id": "657f193b-8380-43cb-9d10-4e2d8bb6abac",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Der Wohnungsmangel ist aktuell in Deutschland so groß wie seit 20 Jahren nicht mehr.“"
                            },
                            {
                                "example_id": "42417053-7cb2-453f-85fa-0edf7a06239c",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Der Wohnungsmangel greift nach Angaben des Deutschen Mieterbundes auch in Mecklenburg-Vorpommern immer weiter um sich.“"
                            },
                            {
                                "example_id": "49203658-48e8-4cd4-abb4-a4219c7c83f3",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "[…] „Der Wohnungsmangel hat auch ländliche Regionen erreicht.“"
                            },
                            {
                                "example_id": "c57c80cc-d89a-4de6-81b7-6ecacc5b8429",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "[Schlagzeile:] „Kampf ums Wohnen: Wie verschärfen Airbnb und Co. den Wohnungsmangel in Thüringer Städten?“"
                            },
                            {
                                "example_id": "71bbe990-3cb0-493e-b3d0-d33a812e5fac",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "[Schlagzeile:] „Werkswohnungen gegen Wohnungsmangel“"
                            },
                            {
                                "example_id": "ee913bed-7545-4afc-9e01-e43323e616e4",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Im Kampf gegen den Wohnungsmangel hat die Stadt München die letzten Jahre auf Baugenossenschaften gesetzt.“"
                            },
                            {
                                "example_id": "6b63abee-ce6a-44a2-9d6b-bebd45909588",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Ohnehin ist Bayern massiv von der Entwicklung betroffen. Bereits Mitte Mai teilte die Landesbausparkasse Süd mit, dass für die kommenden Jahre im Freistaat ein anhaltender Wohnungsmangel zu erwarten sei.“"
                            },
                            {
                                "example_id": "2d71a92c-f334-4ad3-a7a2-85d6bf88a576",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Die Bevölkerung in Deutschland ist weiter gewachsen und befindet sich auf einem Allzeithoch von 84,3 Millionen Menschen. Der gleichzeitige Rückgang der Bautätigkeit hat zu einem rekordverdächtigen Wohnungsmangel geführt.“"
                            },
                            {
                                "example_id": "0d50239b-b9fe-4864-a9c8-5c76a6a5eb6f",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Nach dem Zweiten Weltkrieg war in Deutschland durch das 1. Wohnungsbaugesetz der Einbau von Einliegerwohnungen in neue Einfamilienhäuser vorgeschrieben, um den Wohnungsmangel zu beheben.“"
                            },
                            {
                                "example_id": "8bffcf65-93d9-4673-bb6e-545c3fb8fc0d",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Ein verheerendes Hochwasser verschärfte 1954 den gravierenden Wohnungsmangel, der in Linz seit dem 2. Weltkrieg herrschte.“"
                            },
                            {
                                "example_id": "4ab02208-5f26-48e1-b519-ced17a1ba83d",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„In Polen konnte mittels Plattenbauten der nach dem Zweiten Weltkrieg massive Wohnungsmangel beseitigt werden.“"
                            },
                            {
                                "example_id": "9f49cfa6-ec2d-4bcd-9cc5-6ae7d149c3e1",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Das heutige Wohnungsproblem in den boomenden Städten der ostdeutschen Bundesländer ist eine Folge der Wohnungsbaupolitik in der DDR, in der chronischer Wohnungsmangel herrschte, die Mietpreise aber bis zum Schluss spottbillig waren.“"
                            },
                            {
                                "example_id": "46a21152-21d8-4917-807b-890dc304ba07",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Die Bewältigung des Wohnungsmangels in Großstädten erfordert innovative Ansätze wie modulare Wohnungen und die Umwandlung ungenutzter Gebäude.“"
                            },
                            {
                                "example_id": "24334c10-1e57-4a3c-b0f5-2f8a73c83e98",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Um gegen den Wohnungsmangel vorzugehen, könnten Genossenschaften eigentlich helfen. Aber sie werden nicht anders behandelt als freie Bauträger. Ein Beispiel aus Augsburg zeigt: Ohne besondere Förderung stehen viele Bauvorhaben auf der Kippe.“"
                            },
                            {
                                "example_id": "efd26a11-34a0-4ee3-a7d5-5418c9c7d9c4",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "„Der Schweizer Wohnungsmarkt kippe derzeit von einem Überangebot in einen Wohnungsmangel, sagt die Studie.“"
                            },
                            {
                                "example_id": "950a7124-c633-4f80-903a-71669ce7037a",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "[Schweizer Zentren:] „Hier, wo Millionen von Menschen leben, liegt die Leerwohnungsziffer oft unter 1.5 Prozent. Damit herrscht laut dem Bundesamt für Wohnungswesen Wohnungsmangel. In den Grossstädten wie Zürich, Genf, Basel und Bern liegt die Quote gar unter einem Prozent. In diesen Städten spricht man von Wohnungsnot.“"
                            },
                            {
                                "example_id": "9b03ea79-e569-4947-b0bf-6c4463d5870e",
                                "sense_id": "c82cc09e-e578-3d3c-a9ee-7162ee6af648",
                                "text": "[Was geschah am 19. April 1949?] „Bei einer Umfrage des Bielefelder Instituts für Marktforschung EMNID in den Westzonen bezeichnen 35% der Befragten den Mangel an Kleidung als ihr größtes Problem. 31,6% bereitet der Wohnungsmangel, 16,1% die unzureichende Ernährung die größten Sorgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                        "entry_id": "e880a44a-4597-3b53-9351-3de1e5139192",
                        "glosses": [
                            "Fehler, Makel oder Defekt(e) an/in einer Wohnung (beispielsweise Feuchtigkeit, Schimmelbildung, fehlendes Wasser)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dca473c-cbc0-452d-bb15-dac1df78038f",
                                "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                                "text": "Wer wegen Wohnungsmängeln die Miete kürzt, ist kein Mietschuldner."
                            },
                            {
                                "example_id": "b1fbaa7d-d94a-4cba-a073-ae2c5ed7727e",
                                "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                                "text": "„Laut DMB lag die Beratungsstatistik wegen Wohnungsmängeln 2018 bei 19,1 Prozent - ein Großteil davon wegen Schimmelbefalls.“"
                            },
                            {
                                "example_id": "33037569-3745-4bb3-ae2c-40786e77c114",
                                "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                                "text": "„Ein Wohnungsmangel liegt vor, wenn die Wohnung bei der Überlassung an den Mieter bereits einen Fehler hatte oder wenn während der Mietzeit ein Fehler auftritt, der die „Tauglichkeit zum vertragsgemäßen Gebrauch aufhebt oder mindert“.“"
                            },
                            {
                                "example_id": "dba237f8-dfe4-4633-803d-6a7891293938",
                                "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                                "text": "„Die Frage, ob ein Wohnungsmangel vorliegt und wer den Mangel zu beheben hat, führt in der Praxis oft zu Problemen.“"
                            },
                            {
                                "example_id": "9cee40f0-1ab8-4721-9592-ca1a0da444e4",
                                "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                                "text": "„Wohnungsmängel müssen grundsätzlich vom Vermieter beseitigt werden.“"
                            },
                            {
                                "example_id": "23bae7fc-2be5-41b7-9048-fe163e6b2af8",
                                "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                                "text": "„Weigert sich der Vermieter, einen Wohnungsmangel zu beseitigen, kann der Mieter auf Mängelbeseitigung klagen.“"
                            },
                            {
                                "example_id": "a1ee37bc-0ce0-4a23-ad60-03a68e0a4af5",
                                "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                                "text": "„Der Mieter muss beweisen, dass ein Wohnungsmangel vorliegt. Hilfreich sind Fotos, Zeugen, Protokolle und gegebenenfalls amtliche Nachweise über festgestellte Mängel.“"
                            },
                            {
                                "example_id": "dcbe8454-edb4-41e5-aa95-cb4094b92255",
                                "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                                "text": "„Hein erinnert sich, dass Mitglieder des Vereins vor ein paar Jahren wegen gravierender Wohnungsmängel die Miete gemindert hätten.“"
                            },
                            {
                                "example_id": "33283ac6-c49f-4b23-8af1-621edefbcacc",
                                "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                                "text": "„»Steht die Wohnung beispielsweise vollständig unter Wasser oder ist das Dach komplett abgedeckt und bietet keinen Schutz mehr, ist die Wohnung unbewohnbar. Dann kann die Miete um 100 Prozent gekürzt werden«, so der DMB. Der Mieter muss den Vermieter in dem Fall über die Wohnungsmängel informieren.“"
                            },
                            {
                                "example_id": "1aa1f306-371c-44da-9e2e-ab1241b63374",
                                "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                                "text": "„In der Beratung geht es laut Mieterbund in gut jedem dritten Fall um die Betriebskostenabrechnung, etwa halb so oft um Wohnungsmängel.“"
                            },
                            {
                                "example_id": "f93ee6f5-101b-4aff-b998-7d62fa8af052",
                                "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                                "text": "„Die Juristen des Mietervereins prüften bei knapp 40 Prozent der Beratungen Nebenkostenabrechnungen. Mit rund 20 Prozent waren Wohnungsmängel und daraus folgende Mietminderungen das zweitwichtigste Thema.“"
                            },
                            {
                                "example_id": "794cff77-5ec4-4853-a9a6-fd553054a473",
                                "sense_id": "b1010812-0874-3191-ad06-134f5cc3a4a0",
                                "text": "„Ein Sprecher des Deutschen Mieterbunds geht davon aus, dass sich von 270 000 Mietrechtsprozessen nur knapp zehn Prozent um Wohnungsmängel und Mietminderungen drehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
