            {
                "entry_id": "b933108d-0c92-3e59-82a3-bb386f2f3a38",
                "word": "frosted",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8aa67aa4-c057-4ca3-9b27-5262b6c19060",
