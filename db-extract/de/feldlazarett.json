                "senses": [
                    {
                        "sense_id": "4e5f4fbb-85d0-3886-8980-841045030bfa",
                        "entry_id": "1f19d2f3-3f02-3640-84c0-c04c44c5e3c9",
                        "glosses": [
                            "bewegliche Sanitätseinrichtung, die der Versorgung von Verwundeten in einem militärischen Konflikt dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98a68d86-4759-4df5-9b0d-cb2162125c37",
                                "sense_id": "4e5f4fbb-85d0-3886-8980-841045030bfa",
                                "text": "„Im Feldlazarett ist großer Betrieb; es riecht wie immer nach Karbol, Eiter und Schweiß.“"
                            },
                            {
                                "example_id": "fe5e96fb-4170-4ae9-9a8d-5c8c45737c20",
                                "sense_id": "4e5f4fbb-85d0-3886-8980-841045030bfa",
                                "text": "„Die Deutschen bauten neben dem Bahnhof ein Feldlazarett für leicht verwundete Wehrmachtsoldaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3ea73e6-b062-4d02-87df-2fc310ee100d",
                        "source_entry_id": "1f19d2f3-3f02-3640-84c0-c04c44c5e3c9",
                        "source_sense_id": "4e5f4fbb-85d0-3886-8980-841045030bfa",
                        "target_lang_word": "field hospital",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "field hospital",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a1fca76-2b34-350d-a8f4-bf4f3df50111",
                                        "entry_id": "9f22eee5-f54b-3c19-8c97-8853b208ba44",
                                        "glosses": [
                                            "A large mobile medical unit that temporarily takes care of casualties before they can be safely transported to more permanent hospital facilities."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "606965a3-3287-4e26-a748-b6391e25e6a2",
                        "source_entry_id": "1f19d2f3-3f02-3640-84c0-c04c44c5e3c9",
                        "source_sense_id": "4e5f4fbb-85d0-3886-8980-841045030bfa",
                        "target_lang_word": "hôpital de campagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hôpital de campagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "453bf947-fd8f-3839-b5f2-e1c23dc1df0f",
                                        "entry_id": "181841df-61bc-3639-89e2-992670892258",
                                        "glosses": [
                                            "Établissement de soins provisoire, mis en place en cas de catastrophe, à proximité d’une zone de combat ou encore lors d’importantes manifestations populaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49d3a5aa-ca84-4090-b6a1-6a4653283bd0",
                                                "sense_id": "453bf947-fd8f-3839-b5f2-e1c23dc1df0f",
                                                "text": "Les sauveteurs de la sécurité civile ont déployé à Nîmes la nouvelle mouture de leur hôpital de campagne, fleuron de l’Intérieur en matière de médecine de catastrophe."
                                            },
                                            {
                                                "example_id": "e0738d28-641d-4ce5-995b-65ea15c7614d",
                                                "sense_id": "453bf947-fd8f-3839-b5f2-e1c23dc1df0f",
                                                "text": "La voix narrative commence à « décaler » l’événement en établissant une classification des réactions des accidentés (certains gémissent, d’autres hurlent, d’autres encore sanglotent ; quant aux morts, ils se tiennent cois), puis le comique absurde atteint son apogée avec la description apocalyptique de l’hôpital de campagne où les blessés sont amenés, et où l’interne de garde les reçoit en parlant comme une parodie de circulaire administrative, à grand renfort de « desdits », « susdits », et en invitant les blessés à « bien vouloir confirmer ou déconfirmer » leur souhait « d’être admis ou désadmis de cet endroit afin que le traitement puisse être appliqué ou désappliqué » (SLC 336)."
                                            },
                                            {
                                                "example_id": "dcd40b8e-e6a8-4c58-82f5-5ba1093b9867",
                                                "sense_id": "453bf947-fd8f-3839-b5f2-e1c23dc1df0f",
                                                "text": "Il n’a aucune information supplémentaire sur le type d’aide qui sera offert à la communauté, mais il souhaite que l’armée installe un hôpital de campagne, ainsi que des logements temporaires pour les personnes infectées, qui doivent, pour le moment, s’isoler avec leurs familles dans des maisons bondées."
                                            },
                                            {
                                                "example_id": "c552e922-d9a7-4a9b-b249-30d7bb9bd136",
                                                "sense_id": "453bf947-fd8f-3839-b5f2-e1c23dc1df0f",
                                                "text": "En outre, un \"hôpital de campagne\" sera également déployé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
