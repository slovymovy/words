                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'to answer'",
                        "ru": "повелительное наклонение глагола 'отвечать'"
                    },
                    "translations": {
                        "en": [
