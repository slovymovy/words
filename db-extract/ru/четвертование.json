                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "015eecff-157b-384f-84b8-3b9d00568cac",
                                        "entry_id": "4c9e486b-87c7-3428-b320-03e424dd10c7",
                                        "glosses": [
                                            "The practice of docking 15 minutes' pay from a worker who arrived late (even by less than 15 minutes)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
