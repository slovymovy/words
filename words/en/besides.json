    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "ccb3d4bd-f13b-32c2-9fd2-cc72c1126d75",
                    "sense_definition": "In addition to someone or something; as well as.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sem_addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have plenty of food <w>besides</w> the bread and cheese.",
                            "target_lang_translations": {
                                "ru": "У нас полно еды <w>кроме</w> хлеба и сыра.",
                                "zh": "<w>除了</w>面包和奶酪，我们还有很多食物。",
                                "pl": "Mamy mnóstwo jedzenia <w>oprócz</w> chleba i sera.",
                                "fr": "Nous avons beaucoup de nourriture <w>en plus du</w> pain et du fromage."
                            }
                        },
                        {
                            "text": "<w>Besides</w> this, there are several other reasons to stay home.",
                            "target_lang_translations": {
                                "ru": "<w>Кроме</w> того, есть несколько других причин остаться дома.",
                                "zh": "<w>除了</w>这一点，还有几个待在家里的理由。",
                                "pl": "<w>Poza tym</w>, istnieje kilka innych powodów, by zostać w domu.",
                                "fr": "<w>En outre</w>, il y a plusieurs autres raisons de rester à la maison."
                            }
                        }
                    ],
                    "synonyms": [
                        "in addition to",
                        "on top of",
                        "beyond",
                        "as well as",
                        "apart from"
                    ],
                    "common_phrases": [
                        "besides this",
                        "besides that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вдобавок к кому-либо или чему-либо; наряду с.",
                        "zh": "在……之外；除……之外还有。",
                        "pl": "W dodatku do kogoś lub czegoś; oprócz.",
                        "fr": "En plus de quelqu'un ou de quelque chose ; outre."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроме",
                                "target_lang_sense_clarification": "в значении «вдобавок к»"
                            },
                            {
                                "target_lang_word": "помимо",
                                "target_lang_sense_clarification": "наряду с чем-либо"
                            },
                            {
                                "target_lang_word": "сверх",
                                "target_lang_sense_clarification": "в дополнение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "除了",
                                "target_lang_sense_clarification": "表示在某事物之外还有其他事物"
                            },
                            {
                                "target_lang_word": "此外",
                                "target_lang_sense_clarification": "表示另外"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "oprócz",
                                "target_lang_sense_clarification": "w znaczeniu w dodatku do"
                            },
                            {
                                "target_lang_word": "poza",
                                "target_lang_sense_clarification": "w znaczeniu oprócz czegoś"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "en plus de",
                                "target_lang_sense_clarification": "indique une addition"
                            },
                            {
                                "target_lang_word": "outre",
                                "target_lang_sense_clarification": "plus formel, signifie en plus de"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "931a6e8b-08f9-3150-b199-0755bc339844",
                    "sense_definition": "Other than; except for.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sem_exception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I did not tell anyone <w>besides</w> my brother.",
                            "target_lang_translations": {
                                "ru": "Я не сказал никому, <w>кроме</w> моего брата.",
                                "zh": "<w>除了</w>我哥哥，我没告诉任何人。",
                                "pl": "Nikomu nie powiedziałem, <w>oprócz</w> mojego brata.",
                                "fr": "Je n'ai rien dit à personne <w>sauf</w> à mon frère."
                            }
                        },
                        {
                            "text": "There is nothing in the box <w>besides</w> old papers.",
                            "target_lang_translations": {
                                "ru": "В коробке нет ничего, <w>кроме</w> старых бумаг.",
                                "zh": "盒子里<w>除了</w>旧纸张，什么都没有。",
                                "pl": "W pudełku nie ma nic <w>oprócz</w> starych papierów.",
                                "fr": "Il n'y a rien dans la boîte <w>hormis</w> de vieux papiers."
                            }
                        }
                    ],
                    "synonyms": [
                        "except",
                        "save for",
                        "barring",
                        "other than",
                        "excluding"
                    ],
                    "common_phrases": [
                        "anyone besides",
                        "anything besides",
                        "nothing besides"
                    ],
                    "target_lang_definitions": {
                        "ru": "За исключением; не считая.",
                        "zh": "除……之外（没有其他）。",
                        "pl": "Z wyjątkiem; nie licząc.",
                        "fr": "À l'exception de ; hormis."
                    },
                    "translations": {
