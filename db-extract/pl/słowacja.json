                                        "entry_id": "632513bd-6233-30e0-84a1-3351d268ea9b",
                                        "glosses": [
                                            "een land in Midden-Europa, grenzend aan Oostenrijk en Tsjechië in het westen, aan Polen in het noorden, aan Oekraïne in het oosten en aan Hongarije in het zuiden; het oostelijke deel van het voormalige Tsjecho-Slowakije"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95ac56ec-bd2b-4b52-83ca-354c7854f648",
                                                "sense_id": "baf73d9e-8b95-3853-a8f8-724ddbf3620c",
                                                "text": "Vrij onverwacht stemden negentig Slowaakse parlementariërs voor de grondwetswijziging waarmee het land nog slechts twee genders erkent. „Dit is een zwarte dag voor Slowakije.”"
                                            }
                                        ]
                                    }
                                ]
