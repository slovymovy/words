                {
                    "sense_id": "e914fcee-f580-3caf-883c-829f7c236eda",
                    "sense_definition": "Qui manque d'aisance et de naturel, excessivement pudibond, rigide ou timide.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il paraît toujours un peu <w>coincé</w> quand il rencontre de nouvelles personnes.",
                            "target_lang_translations": {
                                "en": "He always seems a bit <w>uptight</w> when he meets new people.",
                                "ru": "Он всегда выглядит немного <w>зажатым</w>, когда знакомится с новыми людьми.",
                                "de": "Er wirkt immer ein bisschen <w>gehemmt</w>, wenn er neue Leute kennenlernt.",
                                "es": "Siempre parece un poco <w>cohibido</w> cuando conoce a gente nueva.",
                                "zh": "他遇到新朋友时总显得有点<w>拘谨</w>。"
                            }
                        },
                        {
                            "text": "Ne sois pas si <w>coincée</w> et viens danser avec nous ce soir.",
                            "target_lang_translations": {
                                "en": "Don't be so <w>uptight</w> and come and dance with us tonight.",
                                "ru": "Не будь такой <w>зажатой</w> и приходи сегодня вечером потанцевать с нами.",
                                "de": "Sei nicht so <w>verklemmt</w> und komm heute Abend mit uns tanzen.",
                                "es": "No seas tan <w>envarada</w> y ven a bailar con nosotros esta noche.",
                                "zh": "别这么<w>古板</w>，今晚来和我们一起跳舞吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cul cousu"
                    ],
                    "common_phrases": [
                        "avoir l'air coincé",
                        "coincé du cul"
                    ],
                    "traits": [
