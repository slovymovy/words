                    {
                        "sense_id": "f12bdcfb-3a77-3823-b6ba-0c36075f14fb",
                        "entry_id": "6c1789c9-735c-3d81-892d-de9090793c0d",
                        "glosses": [
                            "Prostituée, femme facile."
                        ],
                        "tags": [
                            "colloquial",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d951da26-8e3e-4ef5-b950-190db10d1ecd",
                                "sense_id": "f12bdcfb-3a77-3823-b6ba-0c36075f14fb",
                                "text": "Un homme, ce n’est pas le mec qui a les plus belles gisquettes ou le plus de frick en poche. Un vrai homme, un vrai, c’est un homme régulier et c’est un homme auquel nul ne fera baisser les yeux."
                            },
                            {
                                "example_id": "a2803eac-9915-4450-b75a-3c58452a0950",
                                "sense_id": "f12bdcfb-3a77-3823-b6ba-0c36075f14fb",
                                "text": "« Victorine, une…, comment a-t-il dit, une gisquette, c’est ça, gisquette. Elle, c’est une fille sérieuse. Les patrons ne sont pas chics. »"
                            },
                            {
                                "example_id": "df62fbab-0a9e-4559-b5f7-b837a1aa211b",
                                "sense_id": "f12bdcfb-3a77-3823-b6ba-0c36075f14fb",
                                "text": "[…] la cabane périodiquement envahie d’une armée de jeunes voyous et de petites gisquettes, qui investissaient la place, déglinguaient l’installation sanitaire, chouravaient les trésors de la bibliothèque pour se faire un peu de fraîche et ne décarraient, insolents, qu’une fois la cave asséchée."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3c88d68-11eb-38e5-a60c-31997483026b",
                        "entry_id": "6c1789c9-735c-3d81-892d-de9090793c0d",
                        "glosses": [
                            "Jeune fille, jeune femme."
                        ],
                        "tags": [
                            "broadly",
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "fb4ad58c-e490-4ca4-accb-ca041c4774c0",
                                "sense_id": "f3c88d68-11eb-38e5-a60c-31997483026b",
                                "text": "Oui, je l’ai vue, ta gisquette, Chabrol !"
                            },
                            {
                                "example_id": "5eedc82d-5d49-441b-9a95-eb2de977fbc6",
                                "sense_id": "f3c88d68-11eb-38e5-a60c-31997483026b",
                                "text": "Chez moi, au Sénégal, une disquette ce n’est pas votre carré de plastique. Une disquette c’est ce que vous appelez une gisquette, une minette… Une petite femme attirante et facile…"
                            }
                        ]
                    }
