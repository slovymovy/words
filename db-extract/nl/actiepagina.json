                        "examples": [
                            {
                                "example_id": "adce4c34-4563-4805-9f4b-d83283dbfe8f",
                                "sense_id": "d7647435-9717-3042-95e7-75d215088382",
                                "text": "De familie van Ibbotson schrijft op de actiepagina niet met de gedachte te kunnen leven dat hun man, vader en zoon nu helemaal alleen is. Ze willen dat zijn lichaam naar huis wordt gebracht. De familie hoopt zo'n 350.000 euro in te zamelen."
                            },
                            {
                                "example_id": "89ae85a5-d08c-459d-b0d6-ac51c54c5b02",
                                "sense_id": "d7647435-9717-3042-95e7-75d215088382",
                                "text": "De pianoactie van de 12-jarige Bas Schipper om geld in te zamelen voor de bestrijding van diabetes heeft meer dan 50.000 euro opgeleverd. Om 14.00 uur stond de teller op Bas' actiepagina op 50.594 euro. Dat is tien keer zo veel als hij had gehoopt en daar blijft het niet bij. Ook na 14.00 uur bleef er geld binnenkomen."
                            }
                        ]
                    }
