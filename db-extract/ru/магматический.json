                                    {
                                        "sense_id": "09458f59-3def-3868-ba0c-10a6a57ee4b8",
                                        "entry_id": "4a0e1904-c267-31b4-a9f8-7a0607629366",
                                        "glosses": [
                                            "The molten matter within the earth, the source of the material of lava flows, dikes of eruptive rocks, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5ce05b2-2052-412f-b8aa-7fe6145d1e08",
                                                "sense_id": "09458f59-3def-3868-ba0c-10a6a57ee4b8",
                                                "text": "By the pathside, there are occasional large boulders that shown black crystals the size of a fingernail; these are pyroxene minerals that had time to crystallise out deep within the chamber of liquid rock – or magma – beneath the volcano."
                                            }
                                        ]
                                    },
