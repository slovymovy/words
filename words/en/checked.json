                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>checked</w> his watch for the third time while waiting for the bus.",
                            "target_lang_translations": {
                                "ru": "Он в третий раз <w>посмотрел</w> на часы, ожидая автобуса."
                            }
