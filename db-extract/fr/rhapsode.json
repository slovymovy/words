                                        "entry_id": "9033635b-d381-3a59-9098-5e41f6b0716d",
                                        "glosses": [
                                            "One who reads or interprets poetry aloud; one who rhapsodizes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f872574f-9d2e-41bf-b6da-fb3ba86743e9",
                                                "sense_id": "d9b726e6-5725-384f-a5a8-cff4bdedd19b",
                                                "text": "But we find on examination that these are no unconscious lapses of a rhapsodist whose tongue outruns his thought."
                                            }
                                        ]
                                    }
                                ]
