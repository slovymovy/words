                "senses": [
                    {
                        "sense_id": "e08769f0-3ffa-3a14-b31b-a41cd22e5ad5",
                        "entry_id": "52a9635b-a019-3d8a-8e5c-11ea19375efd",
                        "glosses": [
                            "A rich, dense cake, typically made with many eggs and relatively little flour (as opposed to a sponge cake or gâteau)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b05f658c-3db3-4347-bdc2-b29b948032f2",
                                "sense_id": "e08769f0-3ffa-3a14-b31b-a41cd22e5ad5",
                                "text": "The football discussion had cut off as soon as Lacey entered the room. Now they just sat silently eating torte and sipping tea."
                            },
                            {
                                "example_id": "3d945b84-559f-4beb-bee2-5fb540d1f505",
                                "sense_id": "e08769f0-3ffa-3a14-b31b-a41cd22e5ad5",
                                "text": "Call Natalie at Glorious Foods and tell her no for the 40th time. No! I don't want dacquoise. I want tortes filled with warm rhubarb compote."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cb3a107-7177-409b-8ea7-9c9e0500e989",
                        "source_entry_id": "52a9635b-a019-3d8a-8e5c-11ea19375efd",
                        "source_sense_id": "e08769f0-3ffa-3a14-b31b-a41cd22e5ad5",
                        "source_sense_description": "a rich, dense cake",
