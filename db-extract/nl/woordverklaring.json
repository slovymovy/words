                        "glosses": [
                            "beschrijving van de betekenis van een woord"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4798316-0f62-47bf-8b0f-949aeb1ab92b",
                                "sense_id": "d0f4dd12-9aa2-3d55-9809-55117ae1611b",
                                "text": "De samensteller beoefent een beproefd stramien: mooi portret van de dichter, liefst in kleur, met een korte typering van leven en werk, daarna het gedicht met toelichting en eventueel woordverklaring."
                            },
                            {
                                "example_id": "56e67356-9ab0-4950-ad65-fadff65c1048",
                                "sense_id": "d0f4dd12-9aa2-3d55-9809-55117ae1611b",
                                "text": "Het bijzondere aan dit dagboek is echter dat onder de behandelde tekst steeds de bijbehorende uitleg van de Statenvertalers is afgedrukt. De kanttekeningen variëren van zeer korte woordverklaringen, zoals bij Handelingen 9:19 („Spijze. Grieks: voedsel”) tot uitvoerige toelichtingen, zoals bij de meeste teksten uit het Hooglied. In de laatste gevallen moesten de meditaties sterk worden bekort."
                            }
                        ]
                    }
