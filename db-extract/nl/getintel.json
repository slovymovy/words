        "nl-extract.jsonl": [
            {
                "entry_id": "4c04a43f-0e36-30bd-8c8d-bbf85bc31f38",
                "word": "getintel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fb368451-8ade-3276-a28a-dac0f161ed17",
                        "entry_id": "4c04a43f-0e36-30bd-8c8d-bbf85bc31f38",
                        "glosses": [
                            "een aanhoudend prikkelend gevoel gevend vaak door kou veroorzaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70c317b8-1286-4609-9864-0cd004226996",
                                "sense_id": "fb368451-8ade-3276-a28a-dac0f161ed17",
                                "text": "Als u lange tijd in dezelfde houding zit op een niet al te beste stoel, of lange tijd hurkt, kan er een zenuw afgekneld geraken. U heeft dan geen gevoel meer in uw voet. Normaal herstelt zich dat na een tijdje, met het nodige getintel. Als er echte letsels van een zenuw in het been mee gemoeid zijn, kan het 'slapen'permanent zijn. Letsels in ruggenmerg of hersenen kunnen trouwens ook voor gevoelsuitval zorgen."
                            },
                            {
                                "example_id": "235a1fdf-12be-42b2-b0ed-2dc2eb5cbad6",
                                "sense_id": "fb368451-8ade-3276-a28a-dac0f161ed17",
                                "text": "Als je hoogtevrees hebt, moet je niet naar beneden kijken, zeggen ze. Ik juist wel. Ik moet veel naar beneden kijken, elke twee meter dat ik hoger klim, moet ik er even bij gaan zitten. Rustig om me heen kijkend verdwijnt het getintel in mijn knieholtes."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7e3853b-e8c3-3fd8-a171-cdad83963080",
                        "entry_id": "4c04a43f-0e36-30bd-8c8d-bbf85bc31f38",
                        "glosses": [
                            "een aanhoudend flonkeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da94bb50-e9c9-4731-995a-faca9c45f08d",
                                "sense_id": "f7e3853b-e8c3-3fd8-a171-cdad83963080",
                                "text": "Ik keek naar het getintel van de vele sterren in de heldere, donkere lucht."
                            }
                        ]
                    }
                ],
