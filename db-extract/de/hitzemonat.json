                        "glosses": [
                            "истор. термидор (одиннадцатый месяц революционного календаря первой Французской республики)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "258fe2b5-76ab-418b-befc-93df7a1ad6a0",
                                "sense_id": "f2ac3567-f8a4-33fa-8a46-85a3810fe132",
                                "text": "Der elfte Monat war der Hitzemonat, was auf französisch den poetischen Namen Thermidor bekam."
                            }
                        ]
                    },
                    {
                        "sense_id": "536f63af-4412-3f04-96d6-d2c98a8992a7",
                        "entry_id": "69658c4f-980f-3689-a99f-2f09a321296c",
                        "glosses": [
                            "перен. жаркий, засушливый месяц (обычно июль или август)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9595ec3-cc40-4b50-aa50-5f03e85ab519",
                                "sense_id": "536f63af-4412-3f04-96d6-d2c98a8992a7",
                                "text": "Der Hitzemonat Juli 2006 war für Forstmitarbeiter und Feuerwehren in Brandenburg eine äußerst einsatzintensive Zeit."
                            }
                        ]
                    }
                ],
