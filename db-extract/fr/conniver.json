                ],
                "senses": [
                    {
                        "sense_id": "f8ece2bf-bdba-3b98-8704-972008a7bdd1",
                        "entry_id": "3c6304c1-f421-33a0-bf2a-9bc9f4060835",
                        "glosses": [
                            "Fermer les yeux sur ce qu'on n’ose pas ou ne veut pas apercevoir et, par suite, dissimuler en justice les faits à la charge d’un accusé, et prendre ainsi part à une mauvaise action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b33b1c9c-64cb-41fe-b0fb-acd3683b6d95",
                                "sense_id": "f8ece2bf-bdba-3b98-8704-972008a7bdd1",
                                "text": "Mais conniver en lâche à ce nom qu’on me vole, quand un père à mes yeux au lieu de moi l’immole !"
                            },
                            {
                                "example_id": "fb43fb3e-44f2-4333-90dc-14a9b3ce3530",
                                "sense_id": "f8ece2bf-bdba-3b98-8704-972008a7bdd1",
                                "text": "On l’accuse d’y avoir du moins connivé […]"
                            },
                            {
                                "example_id": "2fa681b0-94ed-4769-94b4-590f967ec630",
                                "sense_id": "f8ece2bf-bdba-3b98-8704-972008a7bdd1",
                                "text": "[…] puisqu’ils connivaient à de tels crimes […]"
                            },
                            {
                                "example_id": "bfb276d9-c39e-4656-a578-02f3904eea13",
                                "sense_id": "f8ece2bf-bdba-3b98-8704-972008a7bdd1",
                                "text": "Je ne pouvais trahir ma dignité en connivant à un abus si préjudiciable."
                            },
                            {
                                "example_id": "8a7c0bdd-f37b-4bd6-b785-2429d158a9e8",
                                "sense_id": "f8ece2bf-bdba-3b98-8704-972008a7bdd1",
                                "text": "Peut-être alors serai-je forcé moi-même d’écarter le soupçon d’avoir connivé à cet indigne procédé"
                            },
                            {
                                "example_id": "a8cd79cc-e5b7-4eda-9632-5efa0c2ea1d2",
                                "sense_id": "f8ece2bf-bdba-3b98-8704-972008a7bdd1",
                                "text": "Le clergé s’en plaignit [de l’appel comme d’abus], et le roi [Philippe de Valois] se contenta de conniver à cet usage"
                            },
                            {
                                "example_id": "c4943a5e-ebd4-438f-9947-a7cc27349bd3",
                                "sense_id": "f8ece2bf-bdba-3b98-8704-972008a7bdd1",
                                "text": "Nous craignons qu’on ne nous soupçonne de conniver à ses blasphèmes."
                            }
                        ]
                    }
                ],
