                            },
                            {
                                "target_word": "handstand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4f8a3ef-9058-3244-bfd8-c570a124bafa",
                                        "entry_id": "0a4248b0-3dc2-319e-b01d-63feb0b1d373",
                                        "glosses": [
                                            "To perform a handstand."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a835ba83-9e48-4d97-8511-472a7f133738",
                                                "sense_id": "f4f8a3ef-9058-3244-bfd8-c570a124bafa",
                                                "text": "My student Jon for example is a juggler, wanting to add another string to his circus bow, he decided to learn to handstand; not wanting to ruin his wrists, he sought out some professional help in learning to handstand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40b79848-f399-4f4e-9fb0-0606deeb031b",
                        "source_entry_id": "28deacfd-19ec-3cf6-8b5f-cfa2af7423bd",
                        "source_sense_id": "6edd0997-f455-32c1-90d0-c084edf8791e",
                        "source_sense_description": "Sport: Gleichgewichtsübung beim Turnen, bei der man kopfüber gestreckt auf seinen Händen steht",
                        "target_lang_word": "poirier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poirier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e728fb75-46fd-36fb-9b4b-4bdfd94d9ee0",
                                        "entry_id": "4c609ca7-dce6-308b-99af-981dba772d84",
                                        "glosses": [
                                            "Arbre fruitier qui produit les poires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c60b4294-2726-4d50-a0fa-cc86053a92ba",
                                                "sense_id": "e728fb75-46fd-36fb-9b4b-4bdfd94d9ee0",
                                                "text": "La plupart des montagnes de Walachie sont garnies de bois composés de poiriers, de cerisiers, d’abricotiers et autres arbres fruitiers qui donnent aux forêts l’aspect d’immenses vergers."
                                            },
                                            {
                                                "example_id": "ce3db743-a1b8-46ff-9e19-ed9fe4a3b8b8",
                                                "sense_id": "e728fb75-46fd-36fb-9b4b-4bdfd94d9ee0",
                                                "text": "Les poiriers déjà étaient en fleur, et le bonhomme Rouault, debout maintenant, allait et venait, ce qui rendait la ferme plus animée."
                                            },
                                            {
                                                "example_id": "7b5d5f4e-eb4e-483c-836b-4b2395349501",
                                                "sense_id": "e728fb75-46fd-36fb-9b4b-4bdfd94d9ee0",
                                                "text": "Le poirier, abandonné à lui même, est un arbre assez élevé, et dont le tronc peut acquérir des dimensions considérables."
                                            },
                                            {
                                                "example_id": "cfb7ed48-d1fa-4cb2-abe0-a33ae416d48f",
                                                "sense_id": "e728fb75-46fd-36fb-9b4b-4bdfd94d9ee0",
                                                "text": "Dans les vergers ou les terrains vagues, où l’on ne compte pas sur la récolte du sol, on plante en général 200 pommiers ou poiriers par hectare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27039dfa-0652-3fe7-b500-a0cffb0b33d4",
                                        "entry_id": "4c609ca7-dce6-308b-99af-981dba772d84",
                                        "glosses": [
                                            "Bois du poirier."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "484bf701-9856-44dc-ab73-cbd385bd1720",
                                                "sense_id": "27039dfa-0652-3fe7-b500-a0cffb0b33d4",
                                                "text": "L'ancienne taille en fil, qui champlevait péniblement ses blancs dans le poirier, a cédé la place au travail plus net qui creuse dans le bout de buis des lignes où le burin n'a plus à craindre les éclats des fibres lamelleuses."
                                            },
                                            {
                                                "example_id": "3b9d0ee5-ece6-4b09-acd6-e264dd3d6bca",
                                                "sense_id": "27039dfa-0652-3fe7-b500-a0cffb0b33d4",
                                                "text": "Je m’asseyais dans le fauteuil de cuir, à côté de la bibliothèque en poirier noirci, je faisais craquer entre mes mains les livres neufs, je respirais leur odeur, je regardais les images, les cartes, je parcourais une page d’histoire : […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d8d4957-4e21-3c51-8b01-2e968d0634c0",
                                        "entry_id": "4c609ca7-dce6-308b-99af-981dba772d84",
                                        "glosses": [
                                            "Figure consistant à rester en équilibre sur la tête."
                                        ],
                                        "tags": [
                                            "Gymnastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3097a750-d7a2-44e2-989b-a214d8d2eafb",
                                                "sense_id": "6d8d4957-4e21-3c51-8b01-2e968d0634c0",
                                                "text": "Faire le poirier."
                                            },
                                            {
                                                "example_id": "b1e43c55-6a66-4361-ab69-616eb8084014",
                                                "sense_id": "6d8d4957-4e21-3c51-8b01-2e968d0634c0",
                                                "text": "Trois gamins qui sortaient de l’eau faisaient le poirier fourchu sur l’herbe."
                                            },
                                            {
                                                "example_id": "7523913f-0a78-4e53-80aa-0ef293fcd9eb",
                                                "sense_id": "6d8d4957-4e21-3c51-8b01-2e968d0634c0",
                                                "text": "Elle n’avait jamais su faire la roue, ni les sauts de biche, ni le poirier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd751366-61db-4d95-9306-6f1ac91df712",
