        "fr-extract.jsonl": [
            {
                "entry_id": "dcacfd88-8136-30e0-8513-524d85f38cbf",
                "word": "trigonométrique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "84f2815f-b992-49e7-8cee-67cf3e267baa",
                        "entry_id": "dcacfd88-8136-30e0-8513-524d85f38cbf",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "trigonométriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0f8cb2a-3b7a-3902-8220-1065377acd65",
                        "entry_id": "dcacfd88-8136-30e0-8513-524d85f38cbf",
                        "glosses": [
                            "Qui appartient à la trigonométrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0074dee3-8bf7-4a62-9b9a-c813494b6219",
                                "sense_id": "c0f8cb2a-3b7a-3902-8220-1065377acd65",
                                "text": "Ce qu’ils cherchaient avant de commencer leurs opérations trigonométriques, c’était une vaste plaine, régulièrement aplanie, afin d’y établir la base du premier de ces triangles, dont le réseau devait couvrir la région australe de l’Afrique sur une étendue de plusieurs degrés."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d1e8d1f-abb9-371d-9eca-eb896c0a2577",
                        "entry_id": "dcacfd88-8136-30e0-8513-524d85f38cbf",
                        "glosses": [
                            "Se dit du sens inverse des aiguilles d’une montre."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "0404fa9b-f8a9-4f75-be99-9d74945d5d16",
                                "sense_id": "1d1e8d1f-abb9-371d-9eca-eb896c0a2577",
                                "text": "Puis il change d’avis, s’arrête d’osciller, et se met à tourner dans le sens trigonométrique (…), opposé à son sens de départ !"
                            },
                            {
                                "example_id": "7b1e414d-7192-4032-8e48-310cb1ae8ed4",
                                "sense_id": "1d1e8d1f-abb9-371d-9eca-eb896c0a2577",
                                "text": "[La spirale d’Ulam] consiste à écrire les nombres entiers en suivant une spirale tournant dans le sens trigonométrique, et à signaler les nombres premiers par un point de couleur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1c65920-8678-41b3-b6fa-b47cc3bc711f",
                        "source_entry_id": "dcacfd88-8136-30e0-8513-524d85f38cbf",
                        "source_sense_id": "c0f8cb2a-3b7a-3902-8220-1065377acd65",
                        "source_sense_description": "Qui appartient à la trigonométrie",
                        "target_lang_word": "trigonometrisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trigonometrisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7db31f48-62ba-37ac-aa81-c869c8c147cd",
                                        "entry_id": "e6006332-471b-3392-bb68-0d7cefcb9647",
                                        "glosses": [
                                            "die Trigonometrie betreffend, auf Trigonometrie beruhend"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5378c4b-f2fd-4e3d-ace0-6f7774d6450b",
                                                "sense_id": "7db31f48-62ba-37ac-aa81-c869c8c147cd",
                                                "text": "Sinus und Cosinus sind die beiden wichtigsten trigonometrischen Funktionen."
                                            },
                                            {
                                                "example_id": "0b3c5bb5-b8c6-405e-9b13-2303ef218ee5",
                                                "sense_id": "7db31f48-62ba-37ac-aa81-c869c8c147cd",
                                                "text": "Man unterscheidet trigonometrische Höhenmessungen über kurze Distanzen (> 250 m) und über größere Distanzen (> 10 km)."
                                            },
                                            {
                                                "example_id": "4f8c77a5-f79b-437e-bfc7-af3f27d8e2f3",
                                                "sense_id": "7db31f48-62ba-37ac-aa81-c869c8c147cd",
                                                "text": "Mithilfe der trigonometrischen Höhenmessung lassen sich auch Höhenunterschiede entlang einer Linie in Form eines Zuges analog zum Nivellement übertragen (Abb. 3)."
                                            },
                                            {
                                                "example_id": "7618c68f-d2fb-40a3-9202-ac633f616a70",
                                                "sense_id": "7db31f48-62ba-37ac-aa81-c869c8c147cd",
                                                "text": "Die Periodiziät hat zur Folge, dass trigonometrische Gleichungen oft unendlich viele Lösungen besitzen."
                                            },
                                            {
                                                "example_id": "32cb5614-047f-4fe1-b806-b965e88e4f3b",
                                                "sense_id": "7db31f48-62ba-37ac-aa81-c869c8c147cd",
                                                "text": "Dieselbe wurde nicht nur vom Observatorium aus trigonometrisch berechnet, sondern auch durch das Registrierbarometer, das sich an dem Drachen befand, angezeigt; sie ist die höchste, die bis jetzt ein Drache jemals erreicht hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
