                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0651748a-6d70-47fa-ba31-39587720557e",
                                "sense_id": "49baaac3-ce95-3d02-a230-1418ce71b66f",
                                "text": "Voor de achtste keer in een maand tijd is vandaag een zandstorm over Irak getrokken. Opnieuw kwam daardoor een deel van het dagelijks leven stil te liggen. In een groot deel van het land sloten luchthavens, universiteiten en overheidsdiensten noodgedwongen hun deuren. Ook schoolexamens zijn met een dag uitgesteld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4bd186e-cb03-44bf-b90d-2a50b1caf3bf",
                        "source_entry_id": "2143d3f3-6f6e-3183-939a-091a44d8503f",
                        "source_sense_id": "49baaac3-ce95-3d02-a230-1418ce71b66f",
                        "source_sense_description": "(onderwijs) examen dat door een school wordt afgenomen",
                        "target_lang_word": "Abitur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abitur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9431aa80-8066-3791-ab32-9422d0a7ffb2",
                                        "entry_id": "238d35ea-7eff-3167-b4f0-d5bf35739366",
                                        "glosses": [
                                            "Abschlussprüfung an einer höheren Schule"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8d58aed-3577-48cc-ad55-bcf7c2f0b342",
                                                "sense_id": "9431aa80-8066-3791-ab32-9422d0a7ffb2",
                                                "text": "Klaus hat sein Abitur gerade so geschafft."
                                            },
                                            {
                                                "example_id": "f5d23bd4-a603-4f81-bdfe-1973b2c5cc0d",
                                                "sense_id": "9431aa80-8066-3791-ab32-9422d0a7ffb2",
                                                "text": "„Mario wollte Abitur oder mindestens eine Lehrstelle als Kfz-Mechaniker, aber plötzlich blühte ihm eine Karriere als Betonbauer, Zerspaner oder Facharbeiter für Umformtechnik.“"
                                            },
                                            {
                                                "example_id": "54055dae-b013-4ebd-aa14-a4a11b0fa188",
                                                "sense_id": "9431aa80-8066-3791-ab32-9422d0a7ffb2",
                                                "text": "„Eines Tages 1951, also ein Jahr vor dem Abitur meiner Klasse, wurden wir in die Aula zusammengetrommelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51835366-e1f0-37e1-9948-9518cbe2027a",
                                        "entry_id": "238d35ea-7eff-3167-b4f0-d5bf35739366",
                                        "glosses": [
                                            "höchster allgemeinbildender Schulabschluss, der zum Hochschulstudium berechtigt"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62d77cd1-53f8-4717-bd91-f35c52c4225b",
                                                "sense_id": "51835366-e1f0-37e1-9948-9518cbe2027a",
                                                "text": "Ihre Schwester hat kein Abitur."
                                            },
                                            {
                                                "example_id": "0dde034e-dc7f-4073-a308-5250f62134b2",
                                                "sense_id": "51835366-e1f0-37e1-9948-9518cbe2027a",
                                                "text": "Ohne Abitur kann man hier nicht studieren."
                                            },
                                            {
                                                "example_id": "9db884f7-9b8d-4faf-8189-f01675756afe",
                                                "sense_id": "51835366-e1f0-37e1-9948-9518cbe2027a",
                                                "text": "„Nach dem Abitur zog Andreas nach Worms, um in einem Krankenhaus seinen Zivildienst anzutreten.“"
                                            },
                                            {
                                                "example_id": "55dff175-dd81-435c-bb7a-b194cee502c3",
                                                "sense_id": "51835366-e1f0-37e1-9948-9518cbe2027a",
                                                "text": "„Nach dem Abitur ging ich auf eine Theaterschule.“"
                                            },
                                            {
                                                "example_id": "38bf8f98-7546-4fa4-b6da-89e707236bd5",
                                                "sense_id": "51835366-e1f0-37e1-9948-9518cbe2027a",
                                                "text": "„So streunte ich ein Jahr lang nach dem Abitur durchs Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
