                    },
                    {
                        "form_id": "ffded2b3-0f67-4f4a-8be7-75ba8d2e4d4e",
                        "entry_id": "5c447f21-9bed-31b3-9387-b654f50fba37",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind wehrtechnisch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                        "entry_id": "5c447f21-9bed-31b3-9387-b654f50fba37",
                        "glosses": [
                            "durch die Entwicklung und Produktion von Waffen (= Wehrtechnik); die Entwicklung und Produktion von Waffen betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e32a741-4e5e-41ba-8159-234e57641494",
                                "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                                "text": "„Ausgebrochen ist der Brand bereits am 3. September bei einer Raketenschießübung der Bundeswehr auf dem Gelände der Wehrtechnischen Dienststelle (WTD) 91.“"
                            },
                            {
                                "example_id": "891b137e-b8d1-48e5-aa1c-025436bf386e",
                                "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                                "text": "[Es werden] „nicht alle Ausfuhranträge wehrtechnischer Betriebe zustimmungsfähig sein.“"
                            },
                            {
                                "example_id": "7186079d-8506-42cc-9a33-5fa430881549",
                                "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                                "text": "„Haben wir eine schlechte wehrtechnische Industrie in Deutschland?“"
                            },
                            {
                                "example_id": "18f378a0-4ae0-41df-99fd-488011c637ae",
                                "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                                "text": "„Manchmal klingen die Vertreter der deutschen wehrtechnischen Industrie richtig gequält in diesen Tagen. Weil die Bundeswehr zu wenig bestellt und die Exporte ins Ausland so restriktiv gehandhabt werden,“ […]."
                            },
                            {
                                "example_id": "9a74d4df-9e8c-4b12-af82-4a9b7b82a709",
                                "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                                "text": "„»Ich denke, ob die deutsche wehrtechnische Industrie eine Zukunft hat oder nicht, das ist eine Entscheidung, die letztlich in Berlin getroffen wird.«“"
                            },
                            {
                                "example_id": "2eb69c40-a64c-4cb2-8889-280602931ff4",
                                "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                                "text": "[Rheinmetall:] „Bereits mit Aufstellung der Bundeswehr 1956 wurde wieder ein wehrtechnisches Produktionsprogramm aufgelegt.“"
                            },
                            {
                                "example_id": "6af1dde4-bcd2-4c68-af55-d3dc1e7718a1",
                                "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                                "text": "„Die Entwicklung und Beschaffung wehrtechnischer Ausrüstung kann Jahre bis Jahrzehnte in Anspruch nehmen.“"
                            },
                            {
                                "example_id": "5754bc7f-a7d9-4c25-a2f1-460fcb810da2",
                                "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                                "text": "„Braunbehrens: »Also wir haben in Deutschland ja generelle Probleme das diese ganzen wehrtechnischen Fragen und verteidigungspolitischen Fragen ungern diskutiert werden, was man verstehen kann aus unserer Geschichte.«“"
                            },
                            {
                                "example_id": "678d2415-c57f-4c55-b525-ecc337c497e5",
                                "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                                "text": "„Mit dem Machtantritt Hitlers erfuhr die wehrtechnische Lehre und Forschung unmittelbar eine großzügige Förderung.“"
                            },
                            {
                                "example_id": "1c87b05d-0635-4976-8bf8-53cae024a6ad",
                                "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                                "text": "[1527:] „Zur Entschädigung mussten die Belagerer die drei runden Ecktürme zur wehrtechnischen Verbesserung bauen.“"
                            },
                            {
                                "example_id": "5b494fb9-3ada-4f89-80aa-c1ed229e8c8d",
                                "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                                "text": "„Viele Burgen lagen inmitten der Städte oder an ihrem Rand und waren wehrtechnisch mit der Stadtbefestigung verbunden.“"
                            },
                            {
                                "example_id": "d3652df4-061e-4ee2-895a-0e3bf84f257e",
                                "sense_id": "088d0993-8d17-3fdd-9a9f-b52d0538ca77",
                                "text": "„Wehrtechnisch gesehen ist Verdun ein Stellungskrieg in einem nach neuestem Stand der Technik befestigtem Gelände, in dem der Einsatz modernster Artillerie die Entscheidung bringen soll - schwere Mörser, Flammenwerfer. Maschinengewehre, Spreng- und Giftgasgranaten.“"
                            }
                        ],
