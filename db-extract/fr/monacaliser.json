                        "glosses": [
                            "Donner un caractère monacal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d9d93b-99b5-4e9d-88c3-a4ba6c186fa5",
                                "sense_id": "d02873e7-4841-37bc-addd-6e4d6f938fbb",
                                "text": "Bref, leur prosélytisme l’amène à croire que les disciples de François « veulent faire un monde nouveau, franciscain et non plus chrétien ». Monacaliser l’univers, plus que le christianiser."
                            },
                            {
                                "example_id": "4be8c521-c78d-47b6-ac10-183effd6e8e9",
                                "sense_id": "d02873e7-4841-37bc-addd-6e4d6f938fbb",
                                "text": "Nous vous croyions encore à conventualiser, à monacaliser, par monts et par vauds."
                            }
                        ]
                    }
