                "senses": [
                    {
                        "sense_id": "2503e620-62a1-3072-a5ee-fc97ca8805db",
                        "entry_id": "9890f7bf-3056-3d4e-8700-cdc318f378bc",
                        "glosses": [
                            "Eisenbahngleis, auf dem Güterwagen für die Be- und Entladung bereitgestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3e44c3a-e82c-42e9-8f50-2c1b6aa26ae3",
                                "sense_id": "2503e620-62a1-3072-a5ee-fc97ca8805db",
                                "text": "„Mittels Kran wurden Straßenbahnschienen von einem auf dem Ladegleis stehenden Eisenbahnwaggon auf einen LKW verladen.“"
                            },
                            {
                                "example_id": "c4822ecb-3e84-40aa-9a3d-5d5611086564",
                                "sense_id": "2503e620-62a1-3072-a5ee-fc97ca8805db",
                                "text": "„Hier wo sich noch vor ca. zwei Jahrzehnten ein Bahnhof mit einem Ladegleis und einem Ausweichgleis befand, soll in naher Zukunft wieder ein Ausweichgleis mit Rückfallweichen zur besseren Bewältigung des Güterverkehrs errichtet werden.“"
                            }
                        ],
