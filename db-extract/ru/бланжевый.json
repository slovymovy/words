                "senses": [
                    {
                        "sense_id": "b56734ae-8dbb-3b29-846c-4e1edbfb0659",
                        "entry_id": "148be871-0b15-3e51-9b94-a93907a9a447",
                        "glosses": [
                            "устар. телесного цвета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "770e5b94-e663-4a19-ae69-2831481b2ca4",
                                "sense_id": "b56734ae-8dbb-3b29-846c-4e1edbfb0659",
                                "text": "На них были летние куртки с панталонами из бланжевой фуфайки, полусапожки."
                            },
                            {
                                "example_id": "2874d688-e23f-49f6-8187-635ff765cf3b",
                                "sense_id": "b56734ae-8dbb-3b29-846c-4e1edbfb0659",
                                "text": "Помню, как я медленно выплыл из обморока шахматной мысли, и вот, на громадной английской сафьяновой доске в бланжевую и красную клетку, безупречное положение было сбалансировано, как созвездие."
                            }
                        ]
                    }
                ],
