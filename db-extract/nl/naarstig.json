                "translations": [
                    {
                        "translation_id": "829d4d0a-f6e0-4dbc-9f6b-5c18615f8d53",
                        "source_entry_id": "d797985e-b6e3-36a5-8d9f-a64044badb87",
                        "source_sense_id": "2dacd648-87a5-36a1-af5c-17d0e8f386e7",
                        "source_sense_description": "ijverig en vlug",
                        "target_lang_word": "eifrig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eifrig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9c693a6-80b9-3807-8289-32793df7fc1a",
                                        "entry_id": "12ec2d71-8880-37ec-b001-a3ba14c61557",
                                        "glosses": [
                                            "großen persönlichen Einsatz bei der Arbeit an einer Sache aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90d1f51-5382-40c6-b0dc-88fde4334b23",
                                                "sense_id": "d9c693a6-80b9-3807-8289-32793df7fc1a",
                                                "text": "Er war schon immer ein eifriger Schüler mit guten Erfolgen."
                                            },
                                            {
                                                "example_id": "cc797c59-c295-4aef-a22e-04e83f3db33c",
                                                "sense_id": "d9c693a6-80b9-3807-8289-32793df7fc1a",
                                                "text": "„Während die Munitionsfabriken längst eifrig produzieren und auch ein Mangel an Nahrung vorerst nicht zu befürchten steht, schenkt man im Kriegsministerium den essenziellen ökonomischen Fragen keinerlei Beachtung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf985671-21af-460a-9abe-98fa61b78303",
                        "source_entry_id": "d797985e-b6e3-36a5-8d9f-a64044badb87",
                        "source_sense_id": "2dacd648-87a5-36a1-af5c-17d0e8f386e7",
                        "source_sense_description": "ijverig en vlug",
                        "target_lang_word": "emsig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emsig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6b57a60-ab0f-3f33-b662-8e7425c61376",
                                        "entry_id": "9f1022d1-90a3-3f8e-a1eb-cdac83b89212",
                                        "glosses": [
                                            "fleißig, eifrig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef44f9e-2161-4189-91fe-0acfbe9bc9bb",
                                                "sense_id": "f6b57a60-ab0f-3f33-b662-8e7425c61376",
                                                "text": "Die Gärtnerin ist emsig wie eine Biene."
                                            },
                                            {
                                                "example_id": "18746210-bbbc-4861-bf07-752c0660b73a",
                                                "sense_id": "f6b57a60-ab0f-3f33-b662-8e7425c61376",
                                                "text": "Emsig sammeln die Kinder den Müll vom Schulhof auf und bringen ihn zum Hausmeister."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a193fbd3-068e-41fb-a97f-8f6cca6af297",
                        "source_entry_id": "d797985e-b6e3-36a5-8d9f-a64044badb87",
                        "source_sense_id": "2dacd648-87a5-36a1-af5c-17d0e8f386e7",
                        "source_sense_description": "ijverig en vlug",
                        "target_lang_word": "fleißig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fleißig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1dfdd23-f30f-381d-aeff-051f1363a52c",
                                        "entry_id": "d5e9a70b-9b8d-3e14-a29d-25fde097731d",
                                        "glosses": [
                                            "unermüdlich, arbeitsam, strebsam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8737322b-007c-4254-bbae-ae4aca6eb490",
                                                "sense_id": "a1dfdd23-f30f-381d-aeff-051f1363a52c",
                                                "text": "Ein fleißiger Mitarbeiter wird auch bald befördert."
                                            },
                                            {
                                                "example_id": "8a2b612c-e462-4e11-ab74-69f063fd6df6",
                                                "sense_id": "a1dfdd23-f30f-381d-aeff-051f1363a52c",
                                                "text": "Er war ein fleißiger Besucher der Veranstaltung."
                                            },
                                            {
                                                "example_id": "8898b7b0-e327-42cc-a040-aea13f7d072d",
                                                "sense_id": "a1dfdd23-f30f-381d-aeff-051f1363a52c",
                                                "text": "„Sie ist jetzt 40 Jahre alt und lebt in einer Pflegeeinrichtung auf dem Land, wo sie einmal am Tag fleißig den Ziegenstall ausmistet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a04a74c9-5802-4519-b699-bc58a0e19e53",
                        "source_entry_id": "d797985e-b6e3-36a5-8d9f-a64044badb87",
                        "source_sense_id": "2dacd648-87a5-36a1-af5c-17d0e8f386e7",
