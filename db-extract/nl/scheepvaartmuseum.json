                        "glosses": [
                            "plaats waar de werking en de geschiedenis van vaartuigen wordt getoond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05ca1263-1e7a-418b-b5d3-4a3c063e4000",
                                "sense_id": "2eb43e99-cd6b-34c1-9b4f-7575d8788eac",
                                "text": "De route leidt ook langs een chemiepark, een elektriciteitscentrale, een bierbrouwerij, een scheepvaartmuseum, een watertoren en een spoorwegmuseum."
                            }
