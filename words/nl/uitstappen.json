                    "frequency": "VeryLow",
                    "semantic_group_id": "sterven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is vorig jaar stilletjes uit het leven <w>gestapt</w>.",
                            "target_lang_translations": {
                                "en": "He quietly <w>ended his life</w> last year."
                            }
                        },
                        {
                            "text": "Sommige mensen kiezen er zelf voor om uit het leven te <w>stappen</w>.",
                            "target_lang_translations": {
                                "en": "Some people choose to <w>end their own lives</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sterven",
                        "overlijden",
                        "inslapen"
                    ],
                    "common_phrases": [
                        "uit het leven stappen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the expression 'uit het leven stappen' (to commit suicide)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A euphemistic expression meaning to end one's own life or pass away."
                    },
                    "translations": {
