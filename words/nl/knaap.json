                            },
                            {
                                "target_lang_word": "jeune homme",
                                "target_lang_sense_clarification": "plus formel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db7d361d-5bba-3908-91ca-17a5aeb51131",
                    "sense_definition": "Iets dat of iemand die erg groot is in zijn soort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "big_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn buurman heeft gisteren een <knaap> van een auto gekocht.",
                            "target_lang_translations": {
                                "en": "My neighbor bought a <w>beast</w> of a car yesterday.",
                                "ru": "Мой сосед вчера купил настоящую <w>махину</w>, а не машину.",
                                "fr": "Mon voisin a acheté un <w>monstre</w> de voiture hier."
                            }
                        },
                        {
                            "text": "Tijdens het vissen ving hij een <knaap> van een snoek.",
                            "target_lang_translations": {
                                "en": "While fishing, he caught a <w>whopper</w> of a pike.",
                                "ru": "Во время рыбалки он поймал щуку-<w>громадину</w>.",
                                "fr": "En pêchant, il a attrapé un <w>sacré morceau</w> de brochet."
                            }
                        }
                    ],
                    "synonyms": [
                        "kanjer",
                        "joekel"
                    ],
                    "common_phrases": [
                        "een knaap van een"
                    ],
                    "target_lang_definitions": {
                        "en": "Something or someone very large of its kind.",
                        "ru": "Что-то или кто-то очень крупный в своем роде.",
                        "fr": "Quelque chose ou quelqu'un de très grand ou imposant dans son genre."
                    },
                    "translations": {
