                "word_linkages": []
            },
            {
                "entry_id": "54bccb69-16a3-35f0-a11b-eff5982245f8",
                "word": "sotte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7ed420bb-9140-42b9-8b01-6faae48e523f",
                        "entry_id": "54bccb69-16a3-35f0-a11b-eff5982245f8",
