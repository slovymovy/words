                {
                    "sense_id": "e3a3e66e-d175-31b5-a5ed-567dbaf5b9fc",
                    "sense_definition": "A gun.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gangster was arrested for carrying a concealed <w>tone</w>.",
                            "target_lang_translations": {
                                "ru": "Гангстер был арестован за ношение скрытого <w>ствола</w>.",
                                "zh": "那名歹徒因携带隐蔽的<w>枪</w>而被捕。"
                            }
                        },
                        {
                            "text": "He warned them that he had a <w>tone</w> in his pocket.",
                            "target_lang_translations": {
                                "ru": "Он предупредил их, что у него в кармане <w>пушка</w>.",
                                "zh": "他警告他们说他口袋里有把<w>枪</w>。"
                            }
                        }
