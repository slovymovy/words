                                                "sense_id": "e66042aa-de67-3560-95b4-d62421c7c4ed",
                                                "text": "Das Mädchen eilte zur Schule."
                                            },
                                            {
                                                "example_id": "ce3b48a5-0a3e-46fe-95aa-6c287ef6e875",
                                                "sense_id": "e66042aa-de67-3560-95b4-d62421c7c4ed",
                                                "text": "„Die Waräger eilen zu dem bewusstlosen General.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "22b7c8c8-e5d4-338d-b7c2-e17973862207",
                                        "entry_id": "376ff083-5fca-3607-ae95-cb33f13f2bc6",
                                        "glosses": [
                                            "etwas ist dringlich, schnell von Nöten"
                                        ],
