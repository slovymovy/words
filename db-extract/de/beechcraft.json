                "senses": [
                    {
                        "sense_id": "1cce1623-063d-3faf-9fdf-40dd66717a60",
                        "entry_id": "ba0ae577-ec06-3465-a717-6ce6324bb9ac",
                        "glosses": [
                            "Luftfahrzeug, das vom US-amerikanischem Hersteller Beech Aircraft Corporation produziert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "041c91ee-0c13-4ba0-9eca-601328228cfb",
                                "sense_id": "1cce1623-063d-3faf-9fdf-40dd66717a60",
                                "text": "„Die abgefangenen Gespräche wurden in den Beechcrafts von den Centra Spike-Technikern aufgezeichnet, und die Bänder wurden der Botschaft zugeleitet, wo Jacoby und seine Leute sie prüften.“"
                            },
                            {
                                "example_id": "8c17e1ee-ccc0-4d48-ab00-02c165f7d45a",
                                "sense_id": "1cce1623-063d-3faf-9fdf-40dd66717a60",
                                "text": "„Auf dem Behelfsflugplatz von Quantico stand eine ehrwürdige zweimotorige Beechcraft mit sich drehenden Funkbaken und offener Tür auf der Rollbahn.“"
                            },
                            {
                                "example_id": "25b01726-45ed-4943-9746-e283d01fac68",
                                "sense_id": "1cce1623-063d-3faf-9fdf-40dd66717a60",
                                "text": "„›Jeff, der Pilot der Beechcraft, mit der Dead Eye fliegen sollte, hat sich gerade gemeldet: Unser Agent ist nicht aufgetaucht. Er hätte schon vor zwei Stunden am Flugplatz sein sollen. Der Pilot fragt, wie lange er noch auf ihn warten soll.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
