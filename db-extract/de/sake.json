                                "target_senses": [
                                    {
                                        "sense_id": "cfde29d2-a857-384a-a4ea-b5b812b2c3c4",
                                        "entry_id": "6c855d0a-76b2-3e8c-9ade-10d2f73cac37",
                                        "glosses": [
                                            "cause, interest or account"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37e2befd-51aa-40b5-adc2-2fd7ac31f460",
                                                "sense_id": "cfde29d2-a857-384a-a4ea-b5b812b2c3c4",
                                                "text": "For the sake of argument"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf069b47-867a-3286-a619-17e3b6f59b7d",
                                        "entry_id": "6c855d0a-76b2-3e8c-9ade-10d2f73cac37",
                                        "glosses": [
                                            "purpose or end; reason"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c5cfa4-44d1-4d3c-8d05-9176fe696dab",
                                                "sense_id": "cf069b47-867a-3286-a619-17e3b6f59b7d",
                                                "text": "For old times' sake"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4003d656-53a7-3194-8690-ababb6181cb4",
                                        "entry_id": "6c855d0a-76b2-3e8c-9ade-10d2f73cac37",
                                        "glosses": [
                                            "the benefit or regard of someone or something"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db5e7161-48d4-4ae5-b48c-8b3d04c1bf12",
                                                "sense_id": "4003d656-53a7-3194-8690-ababb6181cb4",
                                                "text": "Ne ãd except thoſe dayes ſhulde be ſhoꝛtened / ſhulde no fleſſe be faved: Butt foꝛ the choſens ſake thoſe dayes ſhalbe ſhoꝛtened."
                                            },
                                            {
                                                "example_id": "81c5c27b-a643-4151-9320-6fa2329743df",
                                                "sense_id": "4003d656-53a7-3194-8690-ababb6181cb4",
                                                "text": "When I gave a dinner there was generally a cover laid for him. I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me."
                                            },
                                            {
                                                "example_id": "247187ff-39a2-4a5f-8919-489b0dfb9c82",
                                                "sense_id": "4003d656-53a7-3194-8690-ababb6181cb4",
                                                "text": "2005, Plato, Sophist. Translation by Lesley Brown. 242a-b.\nBut it will be for your sake that we'll undertake to refute this thesis, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9532b104-f046-3e6d-ad98-acc8e48776d4",
                                        "entry_id": "6c855d0a-76b2-3e8c-9ade-10d2f73cac37",
                                        "glosses": [
                                            "contention, strife; guilt, sin, accusation or charge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc03eebb-7f15-4c01-ac61-03d1f032d7bf",
                                                "sense_id": "9532b104-f046-3e6d-ad98-acc8e48776d4",
                                                "text": "And unto Adam He said, Because thou hast hearkened unto the voice of thy wife, and hast eaten of the tree, of which I commanded thee, saying, Thou shalt not eat of it: cursed is the ground for thy sake; in sorrow shalt thou eat of it all the days of thy life."
                                            }
                                        ]
                                    }
                                ]
                            },
