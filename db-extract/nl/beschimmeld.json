                        "target_lang_word": "moisi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moisi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d0166cb-1a27-377b-9fe1-95e01ec26acd",
                                        "entry_id": "23b5bbf9-6fe7-3b25-b53f-0a0de9df4468",
                                        "glosses": [
                                            "Attaqué par la moisissure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70d1bd5f-653b-4d6c-95d0-028583302a73",
                                                "sense_id": "7d0166cb-1a27-377b-9fe1-95e01ec26acd",
                                                "text": "Ce pain est moisi."
                                            },
                                            {
                                                "example_id": "5323e150-9ef6-4936-a343-15d43d02fe11",
                                                "sense_id": "7d0166cb-1a27-377b-9fe1-95e01ec26acd",
                                                "text": "L’activité autour de moi, les chants des haleurs, le vacarme des cabestans, le cliquetis ininterrompu des attelages de wagons convenaient si peu à l’air épais et moisi du Moyen Age qui devait envelopper mon drame comme d’une brume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "708220a2-c3ca-390f-83f6-99912eb97ef7",
                                        "entry_id": "23b5bbf9-6fe7-3b25-b53f-0a0de9df4468",
                                        "glosses": [
                                            "Qui est impropre à l’utilisation."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7eb7e0d-f039-4328-b1de-7238c4ed758e",
                                                "sense_id": "708220a2-c3ca-390f-83f6-99912eb97ef7",
                                                "text": "Une traduction moisie."
                                            },
                                            {
                                                "example_id": "bf28842d-3ab2-40ea-b4d1-dfc41a37c20d",
                                                "sense_id": "708220a2-c3ca-390f-83f6-99912eb97ef7",
                                                "text": "Ce dessin animé est moisi !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba8fc485-5cef-3b53-877c-ebc934c978e1",
                                        "entry_id": "23b5bbf9-6fe7-3b25-b53f-0a0de9df4468",
                                        "glosses": [
                                            "Se dit d’une personne dont la vieillesse est évidente, exacerbée"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d97b1146-50c3-4fb3-b10c-87a4365e0cb7",
                                                "sense_id": "ba8fc485-5cef-3b53-877c-ebc934c978e1",
                                                "text": "C’est pas parce qu’un vieux moisi vient nous baver dans les étagères que ça vaut forcément que’que chose."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moisi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7531e8c-fc0e-321c-a313-9aeec9df0c04",
                                        "entry_id": "0b2449d8-408c-37be-afbd-d39e91829f70",
                                        "glosses": [
                                            "Ce qui est moisi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cef92542-31f7-4d09-a7c9-cc0a92ffcf73",
                                                "sense_id": "d7531e8c-fc0e-321c-a313-9aeec9df0c04",
                                                "text": "Cela est à demi gâté, il en faut ôter le moisi."
                                            },
                                            {
                                                "example_id": "7280232b-9f91-4057-aba9-44cf1c968d3e",
                                                "sense_id": "d7531e8c-fc0e-321c-a313-9aeec9df0c04",
                                                "text": "Tout l’appartement sentait un peu le moisi, car le plancher était plus bas que le jardin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e357fc99-6f4e-3d6e-bc03-6dd8ecc74728",
                                        "entry_id": "0b2449d8-408c-37be-afbd-d39e91829f70",
                                        "glosses": [
                                            "Moisissure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84ef4194-0d2c-4c94-94eb-e74cdc7a352c",
                                                "sense_id": "e357fc99-6f4e-3d6e-bc03-6dd8ecc74728",
                                                "text": "Les oignons de l’Église, ça devait être, sans doute, pour le général, les sacristies sentant le moisi, les nonciatures, les pastorales d'ensemble, et tout notre bazar extérieur."
                                            }
                                        ]
                                    }
                                ]
                            },
