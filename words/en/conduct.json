                                "target_lang_word": "chování",
                                "target_lang_sense_clarification": "jednání člověka"
                            },
                            {
                                "target_lang_word": "vystupování",
                                "target_lang_sense_clarification": "prezentace na veřejnosti"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行为",
                                "target_lang_sense_clarification": "个人的举动或表现"
                            },
                            {
                                "target_lang_word": "品行",
                                "target_lang_sense_clarification": "道德层面的行为表现"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zachowanie",
                                "target_lang_sense_clarification": "sposób bycia i postępowania"
                            }
                        ]
                    }
                },
                {
