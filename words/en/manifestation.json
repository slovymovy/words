{
    "word_family": [
        "manifest",
        "manifesto",
        "manifestly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b91f7e95-94ff-3bff-a5d4-971eace901c3",
                    "sense_definition": "An event, action, or object that clearly shows or embodies something theoretical, abstract, or hidden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression_and_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest artwork is a clear <w>manifestation</w> of the painter's inner turmoil.",
                            "target_lang_translations": {
                                "ru": "Последняя картина является ярким <w>проявлением</w> душевного смятения художника."
                            }
                        },
                        {
                            "text": "Scientists observed a physical <w>manifestation</w> of the phenomenon during the experiment.",
                            "target_lang_translations": {
                                "ru": "Ученые наблюдали физическое <w>проявление</w> этого феномена во время эксперимента."
                            }
                        }
                    ],
                    "synonyms": [
                        "expression",
                        "indication",
                        "demonstration",
                        "display"
                    ],
                    "antonyms": [
                        "concealment",
                        "hiding"
                    ],
                    "common_phrases": [
                        "physical manifestation",
                        "clear manifestation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие, действие или объект, четко показывающий или воплощающий что-то теоретическое, абстрактное или скрытое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проявление",
                                "target_lang_sense_clarification": "действия, чувства или качества"
                            },
                            {
                                "target_lang_word": "выражение",
                                "target_lang_sense_clarification": "абстрактного состояния или мысли"
                            },
                            {
                                "target_lang_word": "воплощение",
                                "target_lang_sense_clarification": "идеи или принципа в материальной форме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c70f52a5-5f70-332f-8df5-f57271b1ab05",
                    "sense_definition": "A perceptible form or embodiment of an spirit, entity, or intangible quality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "expression_and_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This particular ghost <w>manifestation</w> resembled a young child standing in the hallway.",
                            "target_lang_translations": {
                                "ru": "Это конкретное <w>явление</w> призрака напоминало маленького ребенка, стоящего в коридоре."
                            }
                        },
                        {
                            "text": "They believed the unusual light in the sky was a divine <w>manifestation</w>.",
                            "target_lang_translations": {
                                "ru": "Они верили, что необычный свет в небе был божественным <w>явлением</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "embodiment",
                        "incarnation",
                        "personification",
                        "presence"
                    ],
                    "common_phrases": [
                        "divine manifestation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заметная форма или воплощение духа, сущности или нематериального качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "явление",
                                "target_lang_sense_clarification": "духа, божества или феномена"
                            },
                            {
                                "target_lang_word": "воплощение",
                                "target_lang_sense_clarification": "духовной сущности или качества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74afcb9b-9957-319b-89e7-fd0185941f26",
                    "sense_definition": "An observable symptom or condition caused by a disease or medical disorder.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A skin rash is often a common clinical <w>manifestation</w> of an allergic reaction.",
                            "target_lang_translations": {
                                "ru": "Кожная сыпь часто является распространенным клиническим <w>проявлением</w> аллергической реакции."
                            }
                        },
                        {
                            "text": "The doctor examined every medical <w>manifestation</w> to confirm the rare diagnosis.",
                            "target_lang_translations": {
                                "ru": "Врач изучил каждое медицинское <w>проявление</w>, чтобы подтвердить редкий диагноз."
                            }
                        }
                    ],
                    "synonyms": [
                        "symptom",
                        "sign",
                        "indication"
                    ],
                    "common_phrases": [
                        "clinical manifestation",
                        "medical manifestation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наблюдаемый симптом или состояние, вызванное заболеванием или медицинским расстройством."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проявление",
                                "target_lang_sense_clarification": "болезни или симптома"
                            },
                            {
                                "target_lang_word": "симптом",
                                "target_lang_sense_clarification": "признак заболевания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b57508bd-b1e2-3476-851f-69c034841367",
                    "sense_definition": "The practice or act of focusing thoughts and intentions to bring desired outcomes into reality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She practices daily <w>manifestation</w> to help focus on her career goals.",
                            "target_lang_translations": {
                                "ru": "Она ежедневно практикует <w>манифестацию</w>, чтобы сосредоточиться на своих карьерных целях."
                            }
                        },
                        {
                            "text": "Many self-help books now promote the power of mental <w>manifestation</w>.",
                            "target_lang_translations": {
                                "ru": "Многие книги по саморазвитию сейчас пропагандируют силу ментальной <w>манифестации</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "daily manifestation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практика или действие по сфокусированию мыслей и намерений для воплощения желаемых результатов в реальность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манифестация",
                                "target_lang_sense_clarification": "эзотерическая практика воплощения желаемого мыслями"
                            },
                            {
                                "target_lang_word": "воплощение",
                                "target_lang_sense_clarification": "материализация намерений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4aabdbfb-e93f-3abf-8f18-ffddf0a620a5",
                    "sense_definition": "A public demonstration or protest gathering.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The union organized a large peaceful <w>manifestation</w> in the central square.",
                            "target_lang_translations": {
                                "ru": "Профсоюз организовал крупную мирную <w>манифестацию</w> на центральной площади."
                            }
                        },
                        {
                            "text": "Several political parties called for a public <w>manifestation</w> against the new tax laws.",
                            "target_lang_translations": {
                                "ru": "Несколько политических партий призвали к публичной <w>демонстрации</w> против новых налоговых законов."
                            }
                        }
                    ],
                    "synonyms": [
                        "demonstration",
                        "protest",
                        "rally"
                    ],
                    "common_phrases": [
                        "peaceful manifestation",
                        "public manifestation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичная демонстрация или акция протеста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манифестация",
                                "target_lang_sense_clarification": "массовое уличное шествие или демонстрация"
                            },
                            {
                                "target_lang_word": "демонстрация",
                                "target_lang_sense_clarification": "публичное протестное мероприятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd09471c-860d-348c-bd9a-d99f7a3e8de8",
                    "sense_definition": "A decorative or protective visual pattern applied to glass surfaces to prevent collisions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The glass safety <w>manifestation</w> was applied to the large office doors to make them visible.",
                            "target_lang_translations": {
                                "ru": "На большие офисные двери нанесли защитную стеклянную <w>маркировку</w>, чтобы сделать их заметными."
                            }
                        },
                        {
                            "text": "Building regulations require a visible frosted <w>manifestation</w> on floor-to-ceiling windows.",
                            "target_lang_translations": {
                                "ru": "Строительные нормы требуют наличия видимой матовой <w>маркировки</w> на окнах от пола до потолка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glass manifestation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративный или защитный визуальный узор, наносимый на стеклянные поверхности для предотвращения столкновений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маркировка",
                                "target_lang_sense_clarification": "защитный визуальный элемент на стекле"
                            },
                            {
                                "target_lang_word": "наклейка",
                                "target_lang_sense_clarification": "визуальный стикер на стеклянных дверях для безопасности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}