                    {
                        "sense_id": "ee993286-2f6b-35aa-88b5-c3e05ab270f0",
                        "entry_id": "595df9c8-a0cc-30dd-9872-a2cbe6646317",
                        "glosses": [
                            "Construction, renovation ou réhabilitation d’un bâtiment faite en respectant l’environnement et au standard permettant une utilisation écologique de celui-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "484ffe9b-69cd-4ba3-946e-11293aac036c",
                                "sense_id": "ee993286-2f6b-35aa-88b5-c3e05ab270f0",
                                "text": "Ce livre dresse un panorama complet des matériaux d’écoconstruction et de leurs systèmes constructifs associés à des exemples de mise en œuvre."
                            },
                            {
                                "example_id": "8dd9d796-8d0f-4f12-b5ae-ca9e320eca65",
                                "sense_id": "ee993286-2f6b-35aa-88b5-c3e05ab270f0",
                                "text": "Parmi les facteurs de l’envolée des coûts, Xerfi note les « pressions tarifaires » sur les équipements et matériaux, ainsi que « le déficit de formation aux techniques de l’écoconstruction », susceptibles d’entraîner une hausse des salaires dans le secteur."
                            },
                            {
                                "example_id": "d947e399-ea30-4f1e-bb04-51ca8a29c544",
                                "sense_id": "ee993286-2f6b-35aa-88b5-c3e05ab270f0",
                                "text": "De nombreux promoteurs se mettent à l’écoconstruction."
                            }
                        ]
                    }
