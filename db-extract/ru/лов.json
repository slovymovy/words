                    }
                ],
                "senses": [
                    {
                        "sense_id": "42635f6c-1554-3364-8071-e2b40bbca97c",
                        "entry_id": "00efcc33-110b-3b47-8a3b-091580b21ff2",
                        "glosses": [
                            "то же, что ловля; охота или поиск кого-либо, чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18c935ec-c13d-49f1-8add-b50860e5cc1c",
                                "sense_id": "42635f6c-1554-3364-8071-e2b40bbca97c",
                                "text": "Рядом с ловом капусты производится и ловля трепангов (Holoturia), но только в размерах, несравненно меньших."
                            },
                            {
                                "example_id": "44dcda23-11fb-4800-a2ca-93ff0baa7575",
                                "sense_id": "42635f6c-1554-3364-8071-e2b40bbca97c",
                                "text": "В период, когда плотность грызунов достигает величины, при которой условия местообитания зверьков создают для хищников большие затруднения при их лове, число поедаемых животных падает."
                            },
                            {
                                "example_id": "a2033760-9301-42d0-a7bf-d3dd9d0436c5",
                                "sense_id": "42635f6c-1554-3364-8071-e2b40bbca97c",
                                "text": "Мужчина собрался на ночную рыбалку. В это время хороший лов налима и сома."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7f5c373-8870-3acd-a7a0-3e9ee18c61f6",
                        "entry_id": "00efcc33-110b-3b47-8a3b-091580b21ff2",
                        "glosses": [
                            "разг. то же, что улов; то, что добыто ловлей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88980272-c74b-44dd-a7bc-5ce7ff1a5793",
                                "sense_id": "e7f5c373-8870-3acd-a7a0-3e9ee18c61f6",
                                "text": "Малая облачность к вечеру разрослась в сплошную, и мы надеялись на богатый лов ночных бабочек."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0b0b4a3-0cf0-4b14-b465-4979ba4e5b0c",
                        "source_entry_id": "00efcc33-110b-3b47-8a3b-091580b21ff2",
                        "source_sense_description": "ловля; охота или поиск кого-либо, чего-либо",
                        "target_lang_word": "jacht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jacht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c4880903-3ce3-3cce-a562-3c0665f36084",
                                        "entry_id": "8bbb9cbe-2bbb-39c1-b560-98048bd91e53",
                                        "glosses": [
                                            "/ het achtervolgen van wilde dieren met als doel ze te doden en op te eten"
                                        ],
                                        "tags": [
                                            "feminine",
                                            "masculine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72e15614-b65f-4cbf-a840-172ec578cf24",
                                                "sense_id": "c4880903-3ce3-3cce-a562-3c0665f36084",
                                                "text": "Liefhebbers van de jacht op groot wild hadden vaak als eersten oog voor het belang van natuurbescherming."
                                            },
                                            {
                                                "example_id": "153da246-d9e2-4258-810e-72fb546c74ef",
                                                "sense_id": "c4880903-3ce3-3cce-a562-3c0665f36084",
                                                "text": "' Teresa bloosde weer, want zo dacht ze inderdaad, pragmatisch, als een jakhals op jacht naar vlees."
                                            },
                                            {
                                                "example_id": "f9d93b06-204d-4f97-9f64-168452be9186",
                                                "sense_id": "c4880903-3ce3-3cce-a562-3c0665f36084",
                                                "text": "Zwaluwen doken om mijn oren en voor me uit. Soms vlogen ze zo laag tijdens hun jacht op insecten dat ik ze bijna kon aanraken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6499eaee-7f36-3f5d-850c-fb93ef3dfcc6",
                                        "entry_id": "8bbb9cbe-2bbb-39c1-b560-98048bd91e53",
                                        "glosses": [
                                            "/ het achtervolgen van (vermeende) misdadigers door o.a. de politie"
                                        ],
                                        "tags": [
                                            "feminine",
                                            "figuratively",
                                            "masculine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fdc2760-649d-4997-88f8-0f527bea9780",
                                                "sense_id": "6499eaee-7f36-3f5d-850c-fb93ef3dfcc6",
                                                "text": "En aan de linkerzijde had je een zootje ongeregeld dat - ondanks de plakkaten die Harold in Malaga had zien hangen, waarop hun werd gesmeekt om hun politieke beweging en vakbonden niet langer te schande te maken en te stoppen met hun wreedheden - op jacht ging naar gepensioneerde politieagenten, sympathisanten van de katholieke kerk, mensen van wie ze wisten dat ze rijk waren en mensen van wie ze dachten dat ze rijk waren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e4dc030-731b-3b95-a9ec-deb2c4f1db14",
                                        "entry_id": "8bbb9cbe-2bbb-39c1-b560-98048bd91e53",
                                        "glosses": [
                                            "een snel vaartuig"
                                        ],
                                        "tags": [
                                            "neuter"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5587e33a-5d05-330a-a7b1-b8be4afcc7d6",
                                        "entry_id": "8bbb9cbe-2bbb-39c1-b560-98048bd91e53",
                                        "glosses": [
                                            "een snel vaartuig",
                                            "een snel bewapend vaartuig voor verkenning"
                                        ],
                                        "tags": [
