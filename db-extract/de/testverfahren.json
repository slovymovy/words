                "senses": [
                    {
                        "sense_id": "c402a3fb-c6d3-3194-a352-1f891b059221",
                        "entry_id": "720cc71b-ca77-37ef-a8df-8c46497692dd",
                        "glosses": [
                            "eine von verschiedenen Möglichkeiten, einen Test durchzuführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0232beda-2238-435d-aca3-31754054a726",
                                "sense_id": "c402a3fb-c6d3-3194-a352-1f891b059221",
                                "text": "„Das Testverfahren bietet viele völlig legale Möglichkeiten der Manipulation.“"
                            },
                            {
                                "example_id": "326610f0-83d8-4606-85d7-be01f0bc8afb",
                                "sense_id": "c402a3fb-c6d3-3194-a352-1f891b059221",
                                "text": "„Als Ergebnis verschiedener Testverfahren erhalten die Schüler individuelle Kompetenzprofile.“"
                            },
                            {
                                "example_id": "d4bad351-9d2d-4ad1-bf80-ccff4fd32658",
                                "sense_id": "c402a3fb-c6d3-3194-a352-1f891b059221",
                                "text": "„Bei der Einschätzung der Rechenleistungen der Schüler der Versuchsschule ist zu berücksichtigen, dass das Testverfahren ausschließlich Textaufgaben umfasst und folglich nicht ausschließlich Rechenfähigkeiten prüft, sondern auch Kompetenzen im Leseverständnis zur Lösung der Textaufgaben erfordert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
