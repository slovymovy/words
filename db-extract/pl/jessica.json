                                    {
                                        "sense_id": "572b560a-0b82-3ea3-bfd6-a910a93cc29d",
                                        "entry_id": "881b1cd2-975b-3943-9637-9af6d380b52f",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
