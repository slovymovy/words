                    {
                        "sense_id": "82e499fe-fde4-3a68-a792-1b8e3b9b4dfa",
                        "entry_id": "e26a2542-3d04-333d-bbbb-5402b724d8f7",
                        "glosses": [
                            "Cordonnier qui fait des bottes et aussi d’autres sortes de chaussures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db23a7de-a5fa-4497-be6e-6996c23f1a95",
                                "sense_id": "82e499fe-fde4-3a68-a792-1b8e3b9b4dfa",
                                "text": "Elle chausse ses souliers de sport — les seuls permis à la Roquette puisque les talons bottier peuvent servir de cache."
                            },
                            {
                                "example_id": "e09f9bc7-53ca-4088-bf99-4dbcf07803f5",
                                "sense_id": "82e499fe-fde4-3a68-a792-1b8e3b9b4dfa",
                                "text": "Le CFC de bottier, bottière orthopédiste permet d’accéder à la formation de la maturité professionnelle santé-social (MP-S2) d’une durée de 1 an."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11075ac8-2314-4597-856b-292339a41a7b",
                        "source_entry_id": "e26a2542-3d04-333d-bbbb-5402b724d8f7",
                        "source_sense_id": "82e499fe-fde4-3a68-a792-1b8e3b9b4dfa",
                        "source_sense_description": "cordonnier qui fabrique des bottes",
                        "target_lang_word": "Schuhmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuhmacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94df4a40-fb3b-3800-a19f-d80dfa198515",
                                        "entry_id": "3a0e22e4-37e9-302f-a431-59211d41be8b",
                                        "glosses": [
                                            "jemand, der Schuhe herstellt oder repariert"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "864736dd-dc69-4954-86c4-69b93e04af00",
                                                "sense_id": "94df4a40-fb3b-3800-a19f-d80dfa198515",
                                                "text": "„Und da stehen ja schon die Tanzschuhe!« sagte Fritz. »Ist Herr Beauregard denn auch ein Schuhmacher?“"
                                            },
                                            {
                                                "example_id": "afcb2115-98c2-4172-9d3a-5f950fa61591",
                                                "sense_id": "94df4a40-fb3b-3800-a19f-d80dfa198515",
                                                "text": "„Er verstummte, als er die Menge und den blutbesudelten Mann sah, und nun schlossen sich alle Schuhmacher mit hastiger Neugier dem Volkshaufen an, der sich durch die Strasse wälzte.“"
                                            },
                                            {
                                                "example_id": "86ae6a5d-4f8d-4e05-87de-a80246a0e277",
                                                "sense_id": "94df4a40-fb3b-3800-a19f-d80dfa198515",
                                                "text": "„Signor Rinaldi lief sogleich hinunter, um einen Juwelier, einen Strumpfhändler, einen Schuhmacher und einen Parfümeur zu holen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
