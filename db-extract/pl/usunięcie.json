                                "target_senses": [
                                    {
                                        "sense_id": "dccd5c3e-4e26-345d-9cf1-2d9ce98d8669",
                                        "entry_id": "e3720bd4-561f-3e5a-9731-8a2c569384f2",
                                        "glosses": [
                                            "The process of removing or the fact of being removed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c2a79cb-88b6-4713-9f98-14fe2c1485d0",
                                                "sense_id": "dccd5c3e-4e26-345d-9cf1-2d9ce98d8669",
                                                "text": "At the same time, there have been significant grubbings of these pears, especially in Tasmania where removals have been assisted by the Fruit Growing Reconstruction Scheme."
                                            },
                                            {
                                                "example_id": "44dfbb53-5791-4d0d-9ea4-396fa3d4de8d",
                                                "sense_id": "dccd5c3e-4e26-345d-9cf1-2d9ce98d8669",
                                                "text": "Mr. Homan has been the agency’s executive associate director of enforcement and removal operations, the division that carries out the removals."
                                            },
                                            {
                                                "example_id": "7461e6b4-3707-4cfe-af59-9206a67ae2e5",
                                                "sense_id": "dccd5c3e-4e26-345d-9cf1-2d9ce98d8669",
                                                "text": "The removal of unsightly graffiti on the sides of railway bridges spanning major roads in the North West is to be handed over to National Highways, to speed up the job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ac933c3-34ad-35b6-80b3-68588d0c6918",
                                        "entry_id": "e3720bd4-561f-3e5a-9731-8a2c569384f2",
                                        "glosses": [
                                            "The relocation of a business etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c85d34c-b839-3660-bcc4-7cbfa19e25f2",
                                        "entry_id": "e3720bd4-561f-3e5a-9731-8a2c569384f2",
                                        "glosses": [
                                            "The dismissal of someone from office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "786095a3-a913-4809-8798-fbd57492e9cf",
                                                "sense_id": "5c85d34c-b839-3660-bcc4-7cbfa19e25f2",
                                                "text": "The board decided the removal of the branch manager was the best option after his misbehaviour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ef3f921-45c0-382c-bb37-f30a708549a2",
                                        "entry_id": "e3720bd4-561f-3e5a-9731-8a2c569384f2",
                                        "glosses": [
                                            "An evening funeral ritual in which the coffin holding the deceased is brought, usually from a funeral home, to the church where the funeral mass will be celebrated the following day. Prayers are said before and after the journey, after which mourners are typically received at the home of the deceased."
                                        ],
                                        "tags": [
