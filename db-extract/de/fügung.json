                        "entry_id": "0fc7bba6-5d37-3202-b4c0-db22895e4f0d",
                        "glosses": [
                            "Umstand, der mit dem Eingreifen göttlicher Mächte erklärt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "474f9a66-b443-4fe6-8456-c9a82c7e0fa2",
                                "sense_id": "6c1936cc-00af-37bb-934e-67d39cbddc79",
                                "text": "Welch eine glückliche Fügung, dass Sie gerade heute Abend hier auftauchen!"
                            },
                            {
                                "example_id": "668e4c1b-e1f9-4819-84e2-ff4a2dc30518",
                                "sense_id": "6c1936cc-00af-37bb-934e-67d39cbddc79",
                                "text": "Durch eine Fügung des Schicksals trafen die beiden sich zwei Jahre später an Bord eines Flugzeuges nach München wieder."
                            }
                        ],
                        "sense_index_json": "\"1\""
