                                        "examples": [
                                            {
                                                "example_id": "40392a69-e3df-40c9-bb75-25b032cc6556",
                                                "sense_id": "ab76ee5f-f231-3f76-b549-0cb848163a56",
                                                "text": "Frau Glockengießer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "4868c38a-c9f3-4878-b455-6ec758029851",
                                                "sense_id": "ab76ee5f-f231-3f76-b549-0cb848163a56",
                                                "text": "Herr Glockengießer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "fb6dcddf-b3ba-46dd-bd11-a2dae0b79c01",
                                                "sense_id": "ab76ee5f-f231-3f76-b549-0cb848163a56",
                                                "text": "Die Glockengießers fahren heute nach Erfurt."
                                            },
                                            {
                                                "example_id": "84309546-d9f5-4741-a0f5-11cec5be5862",
                                                "sense_id": "ab76ee5f-f231-3f76-b549-0cb848163a56",
                                                "text": "Der Glockengießer trägt nie die Pullover, die die Glockengießer ihm strickt."
                                            },
                                            {
                                                "example_id": "82a35ae1-b2cf-4ad6-9167-7ee7467a473f",
                                                "sense_id": "ab76ee5f-f231-3f76-b549-0cb848163a56",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Glockengießer kommt, geht der Herr Glockengießer.“"
                                            },
                                            {
                                                "example_id": "6465d07e-0423-4f34-95d6-b59059d495b9",
                                                "sense_id": "ab76ee5f-f231-3f76-b549-0cb848163a56",
                                                "text": "Glockengießer kommt und geht."
                                            },
                                            {
                                                "example_id": "b982f56b-b0db-4a49-bd31-949a70b7e5a5",
                                                "sense_id": "ab76ee5f-f231-3f76-b549-0cb848163a56",
                                                "text": "Glockengießers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
