                ],
                "senses": [
                    {
                        "sense_id": "17ba8e91-d431-3509-84e3-3fad80af73ae",
                        "entry_id": "cf022163-5d4d-3a9b-b5b0-d20a9b6b784f",
                        "glosses": [
                            "устар. догнать, настигнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f6659a3-37cf-4af7-beb0-7f78e0a9658c",
                                "sense_id": "17ba8e91-d431-3509-84e3-3fad80af73ae",
                                "text": "– Да кто туда в здравом уме поедет? – встрял Родди, который успел нас нагнать со своей метлой."
                            }
                        ]
                    },
                    {
                        "sense_id": "781af123-3362-3302-924a-83aed5debb05",
                        "entry_id": "cf022163-5d4d-3a9b-b5b0-d20a9b6b784f",
                        "glosses": [
                            "достичь чего-нибудь, выполнить то, что не выполнено"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9a1f06ce-c170-3a4a-90ab-6acea908ac1d",
                        "entry_id": "cf022163-5d4d-3a9b-b5b0-d20a9b6b784f",
                        "glosses": [
                            "перен. внушить кому-нибудь какое-нибудь чувство"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e3bbb105-50c9-3bc7-8c52-530c642631b0",
                        "entry_id": "cf022163-5d4d-3a9b-b5b0-d20a9b6b784f",
