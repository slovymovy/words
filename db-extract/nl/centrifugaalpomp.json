                                "target_senses": [
                                    {
                                        "sense_id": "17eb0e4e-7d6e-32e5-98fe-213584d7e8aa",
                                        "entry_id": "5ece7d0f-74b3-3708-967b-354069a0b063",
                                        "glosses": [
                                            "Pompe dans laquelle un liquide, aspiré axialement, est éjecté tangentiellement grâce à la force centrifuge créée par un impulseur tournant rapidement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3aae576-0aa3-4daf-b0a5-e4f3a355d7dc",
                                                "sense_id": "17eb0e4e-7d6e-32e5-98fe-213584d7e8aa",
                                                "text": "L’on voit par ces résultats que cette pompe centrifuge à ailes planes dirigées dans le sens du rayon, est, par suite de cette disposition et de quelques autres défauts qui lui sont particuliers, bien inférieure à la pompe centrifuge à aubes courbes de M. Appold, dont le rendement s’est élevé à 0,65 du travail moteur."
                                            },
                                            {
                                                "example_id": "bd56fadc-05db-46ad-83fc-a02fffe397ad",
                                                "sense_id": "17eb0e4e-7d6e-32e5-98fe-213584d7e8aa",
                                                "text": "Une pompe centrifuge est composée d’un rotor (roue à aubes) qui tourne à l’intérieur d’une partie fixe appelée volute ou bâche spirale."
                                            },
                                            {
                                                "example_id": "cb7cf026-3892-4736-b255-458446d6d0f0",
                                                "sense_id": "17eb0e4e-7d6e-32e5-98fe-213584d7e8aa",
                                                "text": "Le taux de défaillance des pompes centrifuges est différent selon l’industrie concernée. Il est élevé dans le cas des étanchéités sur l’arbre d’entraînement compte tenu de la nature des fluides transportés."
                                            }
                                        ]
                                    }
                                ]
                            }
