                        "entry_id": "851f71e2-84d2-37b4-8361-f4e25fbad157",
                        "glosses": [
                            "Ecclésiastique qui dirigeait l’école attachée à la cathédrale, et qui plus tard fut chargé d’exercer une surveillance sur les maîtres d’école du diocèse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc391239-d3e4-4a01-b9dd-e3df9b62cfc7",
                                "sense_id": "8526b5dd-b314-3abc-a83f-5ad5216f418f",
                                "text": "Les professeurs portaient le nom de scolastiques ou d’écolâtres, dénomination qui devait servir à caractériser les méthodes et les doctrines qu’ils professaient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26da6481-06c1-4bca-b86f-8cc9cd82912d",
                        "source_entry_id": "851f71e2-84d2-37b4-8361-f4e25fbad157",
                        "source_sense_id": "8526b5dd-b314-3abc-a83f-5ad5216f418f",
                        "target_lang_word": "scholastisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
