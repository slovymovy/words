                ],
                "senses": [
                    {
                        "sense_id": "009e5b2a-f553-3bfd-b48c-6d9800f95767",
                        "entry_id": "f3b8e3a8-6fb8-3a62-9b3c-4594185b3586",
                        "glosses": [
                            "grafisches Element zur Auswahl von genau einer Option aus vielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df5fecb1-91ee-4be6-aa5a-9f7805bb2145",
                                "sense_id": "009e5b2a-f553-3bfd-b48c-6d9800f95767",
                                "text": "Mit dem Auswahlknopf kann man festlegen, ob die Zahl im vorangegangenen Feld in Gramm ist oder die Stückzahl angibt."
                            },
                            {
                                "example_id": "99239714-313b-4cc7-865b-ee45fef9685e",
                                "sense_id": "009e5b2a-f553-3bfd-b48c-6d9800f95767",
                                "text": "„Ein Auswahlknopf hat zwei Zustände: ausgewählt und nicht ausgewählt.“"
                            },
                            {
                                "example_id": "5334268e-84f6-4a8b-9fdd-9cf3b1f486ff",
                                "sense_id": "009e5b2a-f553-3bfd-b48c-6d9800f95767",
                                "text": "„Sie können einen Auswahlknopf wie ein Ankreuzfeld markieren und entmarkieren.“"
                            },
                            {
                                "example_id": "0f7f1924-b80a-45e6-8e4d-9e7176f95a10",
                                "sense_id": "009e5b2a-f553-3bfd-b48c-6d9800f95767",
                                "text": "„Mit einem Auswahlknopf im Frontdisplay können die Schweißparameter des Gerätes auf einfache Weise an die unterschiedlichen Elektrodentypen angepasst werden.“"
                            },
                            {
                                "example_id": "fc3ea414-4eaa-424b-a06e-da33640e4902",
                                "sense_id": "009e5b2a-f553-3bfd-b48c-6d9800f95767",
                                "text": "„Die Auswahl einzelner Menüpunkte für den Hauptbildschirm erfolgt über den Auswahlknopf. Ein schwarzer Rahmen markiert dabei die aktuelle Auswahl. Durch Drehen des Auswahlknopfes kann der Rahmen auf einen anderen Eintrag bewegt werden. Ist der richtige Eintrag markiert, wird dieser durch Drücken des Auswahlknopfes aktiviert.“"
                            },
                            {
                                "example_id": "0eaa61dc-f784-4418-92df-1849a7f92a68",
                                "sense_id": "009e5b2a-f553-3bfd-b48c-6d9800f95767",
                                "text": "„Um die Auswahl einzuschränken, wählen Sie bitte eine Kategorie oder geben Sie einen Suchbegriff ein. Zum Bestätigen den Auswahlknopf \"Suchen\" anklicken.“"
                            },
                            {
                                "example_id": "5872f28e-222b-418e-bcee-d82e62d89355",
                                "sense_id": "009e5b2a-f553-3bfd-b48c-6d9800f95767",
                                "text": "„Der verbesserte Auswahlknopf liegt unter Ihrem rechten Daumen und bietet sofortigen Zugriff auf manuelle und halbmanuelle Einstellungen.“"
                            },
                            {
                                "example_id": "d7b53f5f-65d2-4c1d-9e97-7ba2436b13c3",
                                "sense_id": "009e5b2a-f553-3bfd-b48c-6d9800f95767",
                                "text": "„Wählen Sie die erste Uhr mit dem Auswahlrad an - die aktuell selektierte Uhr ist blau hinterlegt - und bestätigen Sie Ihre Auswahl mit dem Auswahlknopf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
