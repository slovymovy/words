{
    "word_family": [
        "appreciation",
        "appreciative",
        "appreciable",
        "appreciably"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5cd0f92e-1ccc-3652-b3e5-bdeb767ac4e8",
                    "sense_definition": "To be grateful or thankful for something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really <w>appreciate</w> your help with the preparations for the party.",
                            "target_lang_translations": {
                                "ru": "Я очень <w>ценю</w> твою помощь в подготовке к вечеринке.",
                                "tr": "Parti hazırlıklarındaki yardımını gerçekten <w>takdir ediyorum</w>."
                            }
                        },
                        {
                            "text": "We would <w>appreciate</w> it if you could reply as soon as possible.",
                            "target_lang_translations": {
                                "ru": "Мы были бы <w>признательны</w>, если бы вы ответили как можно скорее.",
                                "tr": "Mümkün olan en kısa sürede yanıt verebilirseniz <w>minnettar oluruz</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "appreciate your help",
                        "greatly appreciate",
                        "really appreciate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть благодарным за что-либо или высоко ценить чьи-то усилия.",
                        "tr": "Bir şey için minnettar veya müteşekkir olmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цени́ть",
                                "target_lang_sense_clarification": "проявлять благодарность за помощь или усилия"
                            },
                            {
                                "target_lang_word": "быть благода́рным",
                                "target_lang_sense_clarification": "испытывать чувство благодарности"
                            },
                            {
                                "target_lang_word": "быть призна́тельным",
                                "target_lang_sense_clarification": "выражать признательность (часто в официальном контексте)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "müteşekkir olmak",
                                "target_lang_sense_clarification": "birine minnet duymak"
                            },
                            {
                                "target_lang_word": "takdir etmek",
                                "target_lang_sense_clarification": "yapılan bir iyiliğin değerini bilmek"
                            },
                            {
                                "target_lang_word": "minnettar olmak",
                                "target_lang_sense_clarification": "teşekkür borçlu hissetmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8615c08d-6d81-31c4-b3c9-b12a6d709ca2",
                    "sense_definition": "To recognize the good qualities of someone or something and value them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has learned to <w>appreciate</w> the beauty of the quiet countryside.",
                            "target_lang_translations": {
                                "ru": "Она научилась <w>ценить</w> красоту тихой сельской местности.",
                                "tr": "Sessiz kırsalın güzelliğinin <w>değerini bilmeyi</w> öğrendi."
                            }
                        },
                        {
                            "text": "You never fully <w>appreciate</w> good health until you get sick.",
                            "target_lang_translations": {
                                "ru": "Никогда в полной мере не <w>ценишь</w> хорошее здоровье, пока не заболеешь.",
                                "tr": "Hasta olana kadar sağlığın <w>kıymetini</w> asla tam olarak <w>anlamazsın</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "esteem"
                    ],
                    "common_phrases": [
                        "appreciate art",
                        "appreciate nature",
                        "appreciate the beauty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Признавать хорошие качества кого-либо или чего-либо и дорожить ими.",
                        "tr": "Birinin veya bir şeyin iyi niteliklerini fark etmek ve onlara değer vermek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цени́ть",
                                "target_lang_sense_clarification": "дорожить, придавать большое значение"
                            },
                            {
                                "target_lang_word": "оце́нивать",
                                "target_lang_sense_clarification": "судить о достоинствах, признавать ценность (обычно: оценить по достоинству)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değerini bilmek",
                                "target_lang_sense_clarification": "bir şeyin kıymetini anlamak"
                            },
                            {
                                "target_lang_word": "takdir etmek",
                                "target_lang_sense_clarification": "beğenmek ve değerini teslim etmek"
                            },
                            {
                                "target_lang_word": "kıymet vermek",
                                "target_lang_sense_clarification": "önemsemek ve değerli bulmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9304f404-49cd-3fa6-9440-32687be8a536",
                    "sense_definition": "To understand a situation fully or be aware of the significance of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>appreciate</w> the difficulty of your position, but we must act now.",
                            "target_lang_translations": {
                                "ru": "Я <w>понимаю</w> сложность вашего положения, но мы должны действовать сейчас.",
                                "tr": "Durumunuzun zorluğunu <w>anlıyorum</w> ancak şimdi harekete geçmeliyiz."
                            }
                        },
                        {
                            "text": "They failed to <w>appreciate</w> the seriousness of the incoming storm.",
                            "target_lang_translations": {
                                "ru": "Они не смогли <w>оценить</w> всю серьезность надвигающейся бури.",
                                "tr": "Yaklaşan fırtınanın ciddiyetini <w>kavrayamadılar</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "acknowledge"
                    ],
                    "common_phrases": [
                        "appreciate the difficulty",
                        "fully appreciate",
                        "appreciate the importance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью понимать ситуацию или осознавать важность чего-либо.",
                        "tr": "Bir durumu tam olarak anlamak veya bir şeyin öneminin farkında olmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понима́ть",
                                "target_lang_sense_clarification": "постигать смысл или сложность ситуации"
                            },
                            {
                                "target_lang_word": "осознава́ть",
                                "target_lang_sense_clarification": "отдавать себе полный отчет в чем-либо"
                            },
                            {
                                "target_lang_word": "учи́тывать",
                                "target_lang_sense_clarification": "принимать во внимание при суждении"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "anlamak",
                                "target_lang_sense_clarification": "bir durumun ciddiyetini veya önemini kavramak"
                            },
                            {
                                "target_lang_word": "farkında olmak",
                                "target_lang_sense_clarification": "bir durumun önemini idrak etmek"
                            },
                            {
                                "target_lang_word": "idrak etmek",
                                "target_lang_sense_clarification": "tam olarak kavramak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a31e3f1-6086-396e-b7aa-985925b36a7f",
                    "sense_definition": "To increase in value or price over a period of time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Real estate in this area has <w>appreciated</w> significantly over the last decade.",
                            "target_lang_translations": {
                                "ru": "Недвижимость в этом районе значительно <w>подорожала</w> за последнее десятилетие.",
                                "tr": "Bu bölgedeki gayrimenkuller son on yılda önemli ölçüde <w>değerlendi</w>."
                            }
                        },
                        {
                            "text": "We hope that our investment will <w>appreciate</w> in the coming years.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся, что наши инвестиции <w>вырастут в цене</w> в ближайшие годы.",
                                "tr": "Yatırımımızın önümüzdeki yıllarda <w>değer kazanacağını</w> umuyoruz."
                            }
                        }
                    ],
                    "antonyms": [
                        "depreciate"
                    ],
                    "common_phrases": [
                        "value appreciates",
                        "currency appreciates",
                        "capital appreciates"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличиваться в стоимости или цене с течением времени.",
                        "tr": "Bir zaman dilimi içinde değerinin veya fiyatının artması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорожа́ть",
                                "target_lang_sense_clarification": "становиться дороже"
                            },
                            {
                                "target_lang_word": "повыша́ться в цене",
                                "target_lang_sense_clarification": "расти в стоимости (об активах, валюте)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değeri artmak",
                                "target_lang_sense_clarification": "maddi değer kazanmak"
                            },
                            {
                                "target_lang_word": "değerlenmek",
                                "target_lang_sense_clarification": "fiyatı veya kıymeti yükselmek"
                            },
                            {
                                "target_lang_word": "prim yapmak",
                                "target_lang_sense_clarification": "yatırımın değer kazanması"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}