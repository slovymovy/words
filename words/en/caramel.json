                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "691548fd-7149-3ee8-873f-9db5e3002328",
                    "sense_definition": "To cook sugar or food until it turns brown and develops a nutty flavor; to caramelize.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>caramel</w> the onions slowly in the pan for the best flavor.",
                            "target_lang_translations": {
                                "ru": "Вам следует медленно <w>карамелизовать</w> лук на сковороде для лучшего вкуса.",
                                "zh": "你应该在锅里慢慢地将洋葱<w>焦糖化</w>，以获得最佳风味。"
                            }
                        },
                        {
                            "text": "The recipe says to <w>caramel</w> the top of the dessert with a kitchen torch.",
                            "target_lang_translations": {
                                "ru": "В рецепте сказано <w>карамелизовать</w> верхушку десерта кулинарной горелкой.",
                                "zh": "食谱上说要用厨房喷枪将甜点顶部<w>焦糖化</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "caramelize"
                    ],
                    "common_phrases": [
                        "caramel the sugar",
                        "caramel the onions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовить сахар или еду до коричневого цвета и появления орехового вкуса; карамелизовать.",
                        "zh": "将糖或食物烹饪至变成棕色并产生坚果风味；即焦糖化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карамелизовать",
                                "target_lang_sense_clarification": "кулинария"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "焦糖化",
                                "target_lang_sense_clarification": "烹饪动词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "476ca652-ce0d-33d3-a696-e24ad0d17302",
                    "sense_definition": "A surname of Occitan origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Caramel</w> is listed in the local telephone directory.",
                            "target_lang_translations": {
