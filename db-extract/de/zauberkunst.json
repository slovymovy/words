                ],
                "senses": [
                    {
                        "sense_id": "0dc994dd-f996-395d-8951-8d5ed3f1a03c",
                        "entry_id": "b93fc02b-e0ef-3cd4-9ac1-b8e13e562651",
                        "glosses": [
                            "Fähigkeit, mit magischen Mitteln zu handeln, zu zaubern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed8531df-3620-40ef-9628-23a27dcf0713",
                                "sense_id": "0dc994dd-f996-395d-8951-8d5ed3f1a03c",
                                "text": "„Es bedurfte wohl einer ›Disposition‹, um den Teufel zum Vorführen seiner Zauberkünste zu bewegen, und es bedurfte eines Vertrags.“"
                            },
                            {
                                "example_id": "a81f400f-485c-4072-a98c-6678c12272ef",
                                "sense_id": "0dc994dd-f996-395d-8951-8d5ed3f1a03c",
                                "text": "„Den Griechen vermittelten sie die Kenntnis der Metaphysik, den Persern die Zauberkünste, den Etruskern die Opferschau – und den Römern das Verzinnen des Kupfers und den Schinkenhandel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d1d32de5-7d6b-38ee-a999-99f3cdce3494",
                        "entry_id": "b93fc02b-e0ef-3cd4-9ac1-b8e13e562651",
                        "glosses": [
                            "Fähigkeit zu/Vollzug von Zauberkunststücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33f2a082-9c83-4987-91eb-5b46e5cb16e9",
                                "sense_id": "d1d32de5-7d6b-38ee-a999-99f3cdce3494",
                                "text": "„So vertrieb ich mir durch höchst angenehme Zauberkünste in diesem Wartesaal die Zeit, die wie im Fluge verfloß.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
