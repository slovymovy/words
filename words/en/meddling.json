{
    "word_family": [
        "meddle",
        "meddler",
        "meddlesome"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "64c9eadc-886d-3f86-bb26-08afd0a4c16c",
                    "sense_definition": "present participle and gerund of <w>meddle</w>",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "meddling_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was accused of <w>meddling</w> in the internal affairs of the neighboring country.",
                            "target_lang_translations": {
                                "ru": "Его обвинили во <w>вмешательстве</w> во внутренние дела соседней страны.",
                                "tr": "Komşu ülkenin iç işlerine <w>karışmakla</w> suçlandı."
                            }
                        },
                        {
                            "text": "Stop <w>meddling</w> with my personal belongings when I am not in the room.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>трогать</w> мои личные вещи, когда меня нет в комнате.",
                                "tr": "Ben odada yokken kişisel eşyalarımı <w>karıştırmayı</w> bırak."
                            }
                        }
                    ],
                    "common_phrases": [
                        "meddling in affairs",
                        "stop meddling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «вмешиваться»",
                        "tr": "\"meddle\" (burnunu sokmak, karışmak) fiilinin şimdiki zaman ortacı ve ulaç biçimi"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмешиваться",
                                "target_lang_sense_clarification": "в чужие дела или процессы"
                            },
                            {
                                "target_lang_word": "лезть",
                                "target_lang_sense_clarification": "не в своё дело (разговорное)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karışmak",
                                "target_lang_sense_clarification": "başkalarının işine veya meselelerine dâhil olmak"
                            },
                            {
                                "target_lang_word": "burnunu sokmak",
                                "target_lang_sense_clarification": "hakkı olmadan bir konuya müdahil olmak"
                            },
                            {
                                "target_lang_word": "karıştırmak",
                                "target_lang_sense_clarification": "eşyaları kurcalamak, izinsiz dokunmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88d9d1f6-51d2-3e7a-a342-a9141f74527a",
                    "sense_definition": "The act of interfering in something without right or invitation",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee resigned because they were tired of constant political <w>meddling</w> in their work.",
                            "target_lang_translations": {
                                "ru": "Комитет ушел в отставку, потому что они устали от постоянного политического <w>вмешательства</w> в их работу.",
                                "tr": "Komite, çalışmalarına sürekli yapılan siyasi <w>müdahalelerden</w> bıktığı için istifa etti."
                            }
                        },
                        {
                            "text": "His constant <w>meddling</w> in our family affairs eventually ruined the relationship.",
                            "target_lang_translations": {
                                "ru": "Его постоянное <w>вмешательство</w> в наши семейные дела в итоге разрушило отношения.",
                                "tr": "Ailevi meselelerimize sürekli <w>burnunu sokması</w> en sonunda ilişkiyi mahvetti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "political meddling",
                        "unwanted meddling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт вмешательства во что-либо без права или приглашения",
                        "tr": "Hakkı olmadığı veya davet edilmediği halde bir şeye müdahale etme eylemi"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмешательство",
                                "target_lang_sense_clarification": "непрошеное или назойливое"
                            },
                            {
                                "target_lang_word": "вмешивание",
                                "target_lang_sense_clarification": "процесс вмешательства"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "müdahale",
                                "target_lang_sense_clarification": "istenmeyen şekilde araya girme"
                            },
                            {
                                "target_lang_word": "karışma",
                                "target_lang_sense_clarification": "başkasının işine dâhil olma"
                            },
                            {
                                "target_lang_word": "burnunu sokma",
                                "target_lang_sense_clarification": "yersiz ve davetsizce karışma eylemi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "72826a07-34c2-3064-8bdb-677b1506dba3",
                    "sense_definition": "Inclined to interfere in other people's business in an annoying way",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "character_trait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>meddling</w> neighbors were always asking questions about her private life.",
                            "target_lang_translations": {
                                "ru": "<w>Вмешивающиеся</w> не в своё дело соседи всегда задавали вопросы о её личной жизни.",
                                "tr": "<w>Her şeye burnunu sokan</w> komşular, sürekli onun özel hayatı hakkında sorular soruyordu."
                            }
                        },
                        {
                            "text": "I cannot stand that <w>meddling</w> relative who tries to control every family event.",
                            "target_lang_translations": {
                                "ru": "Я терпеть не могу этого <w>назойливого</w> родственника, который пытается контролировать каждое семейное событие.",
                                "tr": "Her aile etkinliğini kontrol etmeye çalışan o <w>işgüzar</w> akrabaya tahammül edemiyorum."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoying"
                    ],
                    "common_phrases": [
                        "meddling neighbors",
                        "meddling busybody"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный раздражающим образом вмешиваться в чужие дела",
                        "tr": "Başkalarının işine rahatsız edici biçimde karışma eğiliminde olan"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмешивающийся",
                                "target_lang_sense_clarification": "о человеке, лезущем не в свои дела"
                            },
                            {
                                "target_lang_word": "назойливый",
                                "target_lang_sense_clarification": "слишком любопытный и бесцеремонный"
                            },
                            {
                                "target_lang_word": "бесцеремонный",
                                "target_lang_sense_clarification": "нарушающий границы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "her şeye burnunu sokan",
                                "target_lang_sense_clarification": "haddini aşarak her işe karışan kimse"
                            },
                            {
                                "target_lang_word": "müdahaleci",
                                "target_lang_sense_clarification": "sürekli başkalarının işine karışan"
                            },
                            {
                                "target_lang_word": "işgüzar",
                                "target_lang_sense_clarification": "gerekmediği halde başkasının işine karışan"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}