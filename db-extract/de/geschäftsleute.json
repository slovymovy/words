                        "entry_id": "0d22d016-ac91-32a2-be57-d97fd3f7525b",
                        "glosses": [
                            "kaufmännisch tätige Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cecd49b-856a-4de4-b04d-c89db9f2da8b",
                                "sense_id": "203b9832-06b3-33ff-85e7-ec98b5796495",
                                "text": "Auf dem Flughafen warteten viele Geschäftsleute auf ihre Anschlussflüge."
                            },
                            {
                                "example_id": "d542b73e-e200-4508-9691-a7b729c6491f",
                                "sense_id": "203b9832-06b3-33ff-85e7-ec98b5796495",
                                "text": "„Die Papierfabriken am Flüsschen Wipper verpachtete Bismarck an Geschäftsleute aus einer nahe gelegenen Stadt.“"
                            },
                            {
                                "example_id": "b64f6487-eb54-4ba5-8121-29e7b6421f4e",
                                "sense_id": "203b9832-06b3-33ff-85e7-ec98b5796495",
                                "text": "„Hinter den beschlagenen Fensterscheiben des Café du Commerce unterhalten sich Geschäftsleute.“"
                            },
                            {
                                "example_id": "bbcb871d-e3d8-423a-9da6-5cb4f0e9316d",
                                "sense_id": "203b9832-06b3-33ff-85e7-ec98b5796495",
                                "text": "„Somit brauchten deutsche Geschäftsleute nur noch drei Wochen für die Reise nach Kiautschou.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
