                "senses": [
                    {
                        "sense_id": "470daba7-7423-3756-a06a-3c0a57d44e9d",
                        "entry_id": "03cd9e6d-fc7b-3ba1-80fd-6e2ca0601a27",
                        "glosses": [
                            "A sheepdog that worries (chases or attacks) sheep."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ae501293-b226-40b6-9d43-f35cca17e59f",
                                "sense_id": "470daba7-7423-3756-a06a-3c0a57d44e9d",
                                "text": "What curre will not bawle, & be ready to flye on a mans face, when he is set on by his master, who, if hee bee not by to encourage him, he casts his taile betwixt his legges, & steales away like a sheepe byter."
                            }
                        ]
                    },
                    {
                        "sense_id": "76d821e6-9813-3bb7-b88f-6e68d4242aaa",
                        "entry_id": "03cd9e6d-fc7b-3ba1-80fd-6e2ca0601a27",
                        "glosses": [
                            "A contemptible person, especially one who practices petty thefts."
                        ],
                        "tags": [
                            "derogatory",
                            "figuratively",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "613ea856-3370-41d4-825c-598e03e66ba8",
                                "sense_id": "76d821e6-9813-3bb7-b88f-6e68d4242aaa",
                                "text": "His gait, like a sheep-biter, fleering aside"
                            },
                            {
                                "example_id": "85ad0960-6163-4d30-913c-5975a58a8d07",
                                "sense_id": "76d821e6-9813-3bb7-b88f-6e68d4242aaa",
                                "text": "A poor man has but one ewe, and this grandee sheep-biter leaves whole flocks of fat wethers, whom he may knock down, to deuour this."
                            },
                            {
                                "example_id": "33ad08ca-1591-40c4-8c29-e925fb8533ed",
                                "sense_id": "76d821e6-9813-3bb7-b88f-6e68d4242aaa",
                                "text": "Wouldst thou not be glad to have the niggardly, / rascally sheep-biter come by some notable / shame?"
                            },
                            {
                                "example_id": "1a7ece3d-f442-4a3b-8e0d-cb54941701b1",
                                "sense_id": "76d821e6-9813-3bb7-b88f-6e68d4242aaa",
                                "text": "There are Political Sheep-biters as well as Pastoral; Betrayers of Publick Trusts as well as of Private; And Humane Curs that are as Wolvish as the Other."
                            }
                        ]
                    }
                ],
