                    {
                        "translation_id": "acc5dff5-093c-4f4c-a4ba-88b351bbbaf1",
                        "source_entry_id": "a9ce17a0-7ced-3964-b564-52e7c9c24520",
                        "source_sense_description": "To instruct or improve morally or intellectually",
                        "target_lang_word": "édifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "édifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a2723de-1110-3e35-993f-7baac58e647b",
                                        "entry_id": "daf73840-ffe5-340f-aac7-90f677f8310b",
                                        "glosses": [
                                            "Construire, en parlant des églises, des palais et de très grands bâtiments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fbc83ef-8e25-4c03-b5b2-beaebb005d2b",
                                                "sense_id": "4a2723de-1110-3e35-993f-7baac58e647b",
                                                "text": "Édifier un temple, un palais."
                                            },
                                            {
                                                "example_id": "afc8ca99-c976-4721-b877-8662419462ee",
                                                "sense_id": "4a2723de-1110-3e35-993f-7baac58e647b",
                                                "text": "Bâtiment solidement édifié."
                                            },
                                            {
                                                "example_id": "569a0d69-18ec-4815-8977-43e3714744be",
                                                "sense_id": "4a2723de-1110-3e35-993f-7baac58e647b",
                                                "text": "Car voilà qu’il errait dans un paysage familier, un paysage qu’il avait en quelque sorte édifié lui-même, et qu’il s’y sentait étranger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcdac0aa-ddcd-3dde-8940-e387284c98fd",
                                        "entry_id": "daf73840-ffe5-340f-aac7-90f677f8310b",
                                        "glosses": [
                                            "User de son autorité pour créer, organiser des institutions utiles."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7182c772-9ed3-493f-86a7-78543833bdbb",
                                                "sense_id": "bcdac0aa-ddcd-3dde-8940-e387284c98fd",
                                                "text": "Le mouvement pacifiste, au XXᵉ siècle, a été très largement porté par les femmes, plus sensibles que les hommes à l'absurdité d'une puissance qui s'édifie en semant la mort, et qui appelle « champs d'honneur » les lieux des pires massacres."
                                            },
                                            {
                                                "example_id": "5795efaa-f9d7-4512-bc6b-9d341cc9b913",
                                                "sense_id": "bcdac0aa-ddcd-3dde-8940-e387284c98fd",
                                                "text": "Vous êtes envoyé pour édifier, et non pas pour détruire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98a8d8dd-5194-30f1-937c-edbaea154681",
                                        "entry_id": "daf73840-ffe5-340f-aac7-90f677f8310b",
                                        "glosses": [
                                            "Porter à la piété, à la vertu, par l’exemple ou par le discours."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14c9b530-890d-47e4-b71b-4e3b7885e2a4",
                                                "sense_id": "98a8d8dd-5194-30f1-937c-edbaea154681",
                                                "text": "De tous les moyens d’édifier à peu de frais, vous n’en négligerez aucun."
                                            },
                                            {
                                                "example_id": "159b0077-2610-494c-8ee9-64faada9665a",
                                                "sense_id": "98a8d8dd-5194-30f1-937c-edbaea154681",
                                                "text": "Édifier le prochain."
                                            },
                                            {
                                                "example_id": "5a715a87-7f5a-4630-a2b5-b80713352dfc",
                                                "sense_id": "98a8d8dd-5194-30f1-937c-edbaea154681",
                                                "text": "Édifier tout le monde par son exemple."
                                            },
                                            {
                                                "example_id": "5a249abd-7516-4f2c-af9e-48dcca47eb0a",
                                                "sense_id": "98a8d8dd-5194-30f1-937c-edbaea154681",
                                                "text": "Il s’en retourna très édifié par cette prédication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a8fc091-f2a9-319f-85ff-12b6322fddad",
                                        "entry_id": "daf73840-ffe5-340f-aac7-90f677f8310b",
                                        "glosses": [
                                            "Satisfaire par un bon procédé, donner bonne opinion de soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a9e060-f30e-4d7c-8ed9-ef4da20fbdf2",
                                                "sense_id": "9a8fc091-f2a9-319f-85ff-12b6322fddad",
                                                "text": "La conduite qu’il a tenue dans cette affaire m’édifie extrêmement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27aa13ae-1510-3eff-ac67-6e4bb8bdb110",
                                        "entry_id": "daf73840-ffe5-340f-aac7-90f677f8310b",
                                        "glosses": [
                                            "Mettre quelqu’un à même d’apprécier une personne ou une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31001edb-07a6-4aa6-b847-cf8248af2381",
                                                "sense_id": "27aa13ae-1510-3eff-ac67-6e4bb8bdb110",
                                                "text": "Je veux vous édifier sur le compte de cet individu."
                                            },
                                            {
                                                "example_id": "7cd8110f-b70c-4371-83cf-00fe8eeca1d5",
                                                "sense_id": "27aa13ae-1510-3eff-ac67-6e4bb8bdb110",
                                                "text": "Je suis suffisamment édifié par votre écrit."
                                            },
                                            {
                                                "example_id": "df464e95-8e88-40df-ae33-aae2ac6c264b",
                                                "sense_id": "27aa13ae-1510-3eff-ac67-6e4bb8bdb110",
                                                "text": "N’êtes-vous pas édifié de cette conduite ?"
                                            },
                                            {
                                                "example_id": "fc358110-f563-4e15-bda7-1c9de8d3c8ac",
                                                "sense_id": "27aa13ae-1510-3eff-ac67-6e4bb8bdb110",
                                                "text": "Il sortit peu édifié des propos qu’il avait entendus."
                                            },
                                            {
                                                "example_id": "f8438398-e473-4696-838e-a826dca9ab8b",
                                                "sense_id": "27aa13ae-1510-3eff-ac67-6e4bb8bdb110",
                                                "text": "Il est assez mal édifié par ce qu’il a vu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01844f79-d8d2-46df-ba6a-2a32fd476054",
                        "source_entry_id": "a9ce17a0-7ced-3964-b564-52e7c9c24520",
