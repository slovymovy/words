                            "text": "Hij leeft in een <w>droom</w> en ziet de feiten niet.",
                            "target_lang_translations": {
                                "en": "He lives in a <w>dream</w> and does not see the facts.",
                                "ru": "Он живет в <w>мире грез</w> и не видит фактов.",
                                "pl": "Żyje w <w>iluzji</w> i nie dostrzega faktów.",
                                "de": "Er lebt in einer <w>Traumwelt</w> und sieht die Fakten nicht.",
                                "fr": "Il vit dans un <w>rêve</w> et ne voit pas les faits.",
                                "it": "Vive in un <w>sogno</w> e non vede i fatti.",
                                "cs": "Žije ve <w>sně</w> a nevidí fakta.",
                                "tr": "O bir <w>hayal</w> dünyasında yaşıyor ve gerçekleri görmüyor.",
                                "es": "Él vive en un <w>sueño</w> y no ve los hechos.",
                                "zh": "他生活在<w>幻想</w>中，看不清事实。"
                            }
