    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c89942d9-56e3-36aa-9e1c-9eed771863a9",
                    "sense_definition": "Conversation suivie ou échange formel entre plusieurs personnes, notamment pour évaluer un candidat ou recueillir des informations.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dialogue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a préparé toutes ses réponses avant de passer son premier <w>entretien</w> d'embauche ce matin."
                        },
                        {
                            "text": "Le directeur a accordé un bref <w>entretien</w> au journaliste pour clarifier la situation."
                        }
                    ],
                    "synonyms": [
                        "conversation",
                        "dialogue",
                        "discussion",
                        "entrevue",
                        "interview"
                    ],
                    "common_phrases": [
                        "entretien d'embauche",
                        "passer un entretien",
                        "avoir un entretien"
                    ]
                },
                {
                    "sense_id": "5230f2f8-af04-3c0f-bc92-f7b835431a07",
                    "sense_definition": "Action de maintenir des objets, des appareils ou des bâtiments en bon état de fonctionnement ou de propreté.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "maintenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un <w>entretien</w> régulier de la chaudière permet d'éviter des pannes coûteuses en plein hiver."
                        },
                        {
                            "text": "La municipalité consacre chaque année une part importante de son budget à l'<w>entretien</w> des routes."
                        }
                    ],
                    "synonyms": [
                        "maintenance",
                        "nettoyage",
                        "soin"
                    ],
                    "common_phrases": [
                        "frais d'entretien",
                        "contrat d'entretien",
                        "entretien régulier"
                    ]
                },
                {
                    "sense_id": "cda30a4a-8353-3ac9-a514-aea958837acf",
                    "sense_definition": "Maintien de la forme physique, de la santé ou des capacités intellectuelles par des exercices appropriés.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "maintenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il pratique une demi-heure de gymnastique d'<w>entretien</w> chaque matin pour rester en forme."
                        },
                        {
                            "text": "La lecture quotidienne contribue activement à l'<w>entretien</w> de la mémoire chez les personnes âgées."
                        }
                    ],
                    "synonyms": [
                        "conservation",
                        "soin"
                    ],
                    "common_phrases": [
                        "gymnastique d'entretien"
                    ]
                },
                {
                    "sense_id": "e241d86b-3822-3c28-8086-909eb61e94c8",
                    "sense_definition": "Ce qui est nécessaire pour subvenir aux besoins matériels et à la vie quotidienne d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "subsistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a fixé une pension mensuelle pour assurer l'<w>entretien</w> et l'éducation des enfants."
                        },
                        {
                            "text": "Il travaille sans relâche pour pourvoir décemment à l'<w>entretien</w> de toute sa famille."
                        }
                    ],
                    "synonyms": [
                        "besoins"
                    ],
                    "common_phrases": [
