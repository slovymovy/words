                        ]
                    },
                    {
                        "translation_id": "6db86748-c7cb-400d-9d00-d64a3d89e1bb",
                        "source_entry_id": "1b22eaae-e70c-3c5b-9b1a-efd3819895af",
                        "source_sense_id": "e18886b2-8026-3236-833d-dc8542a8a5c0",
                        "target_lang_word": "Ren",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "08358a95-f1a8-48a7-8406-bc5be906e1c6",
                        "source_entry_id": "1b22eaae-e70c-3c5b-9b1a-efd3819895af",
                        "source_sense_id": "e18886b2-8026-3236-833d-dc8542a8a5c0",
                        "target_lang_word": "Rhin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rhin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "550a0fd2-750d-3367-a17b-84a9fcc0eea8",
                                        "entry_id": "77820b09-4632-3cdd-b869-f55154b888e7",
                                        "glosses": [
                                            "Fleuve prenant sa source dans les Alpes, et se jetant dans la mer du Nord."
                                        ],
                                        "tags": [
                                            "Toponymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e6ff9a5-d79b-4d94-b647-f94633024e14",
                                                "sense_id": "550a0fd2-750d-3367-a17b-84a9fcc0eea8",
                                                "text": "Othon s’était élancé dans le fleuve, non pas pour y chercher la mort, mais la liberté. Élevé sur ses rives, le vieux Rhin était un ami contre lequel il avait trop souvent essayé ses jeunes forces pour le craindre."
                                            },
                                            {
                                                "example_id": "64d64654-9e14-4a39-a64f-ce573ec2ec6e",
                                                "sense_id": "550a0fd2-750d-3367-a17b-84a9fcc0eea8",
                                                "text": "C’est ainsi qu’elle lui apprit que leur chaland avait fait séjour en Alsace, en septembre de l’année précédente, amarré le long d’une des îles verdoyantes, dont la rive du Rhin est toute obstruée."
                                            },
                                            {
                                                "example_id": "6991ceae-d696-44db-a3d8-265bba1354ed",
                                                "sense_id": "550a0fd2-750d-3367-a17b-84a9fcc0eea8",
                                                "text": "Les reflets du couchant, le vent de la mer nous viennent aussi ce soir de chez nos ennemis, de l'Est, du Rhin."
                                            },
                                            {
                                                "example_id": "0172d9c2-f5eb-4e8d-b64f-9945ce0561a8",
                                                "sense_id": "550a0fd2-750d-3367-a17b-84a9fcc0eea8",
                                                "text": "Il s’agit d’un système d’information transnational de crues mis en place dans les bassins de la Moselle, de la Nahe et, pour partie, de celui du Rhin (environ 55 000 km²)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26c991df-6ee9-3a8b-afc6-78f0fae57262",
                                        "entry_id": "77820b09-4632-3cdd-b869-f55154b888e7",
                                        "glosses": [
                                            "Dieu-fleuve associé à ce fleuve, dans la mythologie gréco-romaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e604804-f285-4eeb-bc84-a58acc5a5d4d",
                                                "sense_id": "26c991df-6ee9-3a8b-afc6-78f0fae57262",
                                                "text": "Le fait que le dieu-fleuve Rhin avait laissé s’édifier un tel pont, dont la destruction avait été à l’initiative du seul César, montrait bien que les divinités, contrairement à ce que disait Caton, étaient favorables à celui qu’elles continuaient à reconnaître comme le pontifex maximus du populus Romanus : pontifex maximus parce que constructeur d’un très grand pont, et parce que premier prêtre de Rome."
                                            }
                                        ]
                                    }
                                ]
                            }
