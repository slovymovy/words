    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1b28cea8-1a60-309f-a082-1afa40f8f1d0",
                "word": "misgiving",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0b14e790-205a-4dc2-a862-87f56ed81238",
                        "entry_id": "1b28cea8-1a60-309f-a082-1afa40f8f1d0",
                        "tags": [
