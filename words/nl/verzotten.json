                    "frequency": "Low",
                    "semantic_group_id": "waanzin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de extreme eenzaamheid begon de oude man langzaam te <w>verzotten</w>.",
                            "target_lang_translations": {
                                "en": "Due to extreme loneliness, the old man slowly began <w>to lose his mind</w>."
                            }
                        },
                        {
                            "text": "Men vreesde dat hij door die vreemde ideeën volledig zou <w>verzotten</w>.",
                            "target_lang_translations": {
