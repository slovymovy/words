                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau voisin est vraiment très <w>sympa</w> avec tout le monde.",
                            "target_lang_translations": {
                                "en": "The new neighbour is really very <w>nice</w> to everyone.",
                                "ru": "Новый сосед и правда очень <w>приятный</w> со всеми.",
                                "nl": "De nieuwe buurman is echt heel <w>aardig</w> voor iedereen.",
                                "de": "Der neue Nachbar ist mit allen wirklich sehr <w>nett</w>.",
                                "pl": "Nowy sąsiad jest naprawdę bardzo <w>miły</w> dla wszystkich.",
                                "it": "Il nuovo vicino è davvero molto <w>simpatico</w> con tutti.",
                                "cs": "Nový soused je se všemi opravdu moc <w>milý</w>.",
                                "tr": "Yeni komşumuz herkese karşı gerçekten çok <w>nazik</w>.",
                                "es": "El nuevo vecino es muy <w>simpático</w> con todo el mundo.",
                                "zh": "新搬来的邻居对大家都非常<w>友好</w>。"
                            }
                        },
                        {
                            "text": "C'est vraiment <w>sympa</w> de ta part d'être venu m'aider ce matin.",
                            "target_lang_translations": {
                                "en": "It's really <w>nice</w> of you to come and help me this morning.",
                                "ru": "Это очень <w>мило</w> с твоей стороны — прийти и помочь мне сегодня утром.",
                                "nl": "Het is echt <w>aardig</w> van je dat je vanmorgen bent komen helpen.",
                                "de": "Es ist wirklich <w>nett</w> von dir, dass du heute Morgen gekommen bist, um mir zu helfen.",
                                "pl": "To naprawdę <w>miło</w> z twojej strony, że przyszedłeś mi dziś rano pomóc.",
                                "it": "È davvero <w>gentile</w> da parte tua essere venuto a darmi una mano stamattina.",
                                "cs": "Je od tebe opravdu <w>milé</w>, že jsi dnes ráno přišel pomoct.",
                                "tr": "Bu sabah bana yardıma gelmen gerçekten çok <w>nazikti</w>.",
                                "es": "Es muy <w>amable</w> de tu parte haber venido a ayudarme esta mañana.",
                                "zh": "你今天早上特地来帮我，真是太<w>亲切</w>了。"
                            }
                        }
