                        "examples": [
                            {
                                "example_id": "f284e74c-a47e-4e1e-9295-dca894eb0f7e",
                                "sense_id": "35ff40ae-4eea-3e32-a1a9-9f14039f36ff",
                                "text": "„Nachdem sie die gelbe Plastikschüssel mitten auf den Tisch gestellt hatte, verschwand sie ebenso geräuschlos, wie sie gekommen war.“"
                            },
                            {
                                "example_id": "4e2bb918-da11-44c6-ac9a-7c6a5339e6d3",
                                "sense_id": "35ff40ae-4eea-3e32-a1a9-9f14039f36ff",
                                "text": "„Eine Gruppe Weltraumaffen bereitet den ganzen Tag über Mahlzeiten zu, und den ganzen Tag essen Gruppen von Weltraumaffen aus den Plastikschüsseln, die sie mitgebracht haben.“"
                            }
                        ],
