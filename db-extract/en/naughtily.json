                    {
                        "translation_id": "543250ec-5603-4bcb-a5e5-6c06cfeafb9d",
                        "source_entry_id": "1b042154-f989-3e32-8912-5a43f0d8dc24",
                        "source_sense_id": "4bdca9e3-a4fc-3c7a-8550-a2a604a02895",
                        "source_sense_description": "unartig, ungezogen, ungehörig, frech",
                        "target_lang_word": "frech",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frech",
