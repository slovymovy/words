{
    "word_family": [
        "recreate",
        "recreational",
        "recreative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1dc24478-f9fd-36cd-95dc-f9c979259081",
                    "sense_definition": "An activity done for enjoyment or relaxation when one is not working.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "leisure_activities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The park provides many opportunities for outdoor <w>recreation</w> such as hiking and cycling.",
                            "target_lang_translations": {
                                "ru": "Парк предоставляет множество возможностей для <w>отдыха</w> на свежем воздухе, таких как пешие прогулки и езда на велосипеде."
                            }
                        },
                        {
                            "text": "Many people find that physical <w>recreation</w> is a great way to relieve stress after work.",
                            "target_lang_translations": {
                                "ru": "Многие люди считают, что активный <w>отдых</w> — это отличный способ снять стресс после работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "leisure"
                    ],
                    "antonyms": [
                        "work",
                        "labor"
                    ],
                    "common_phrases": [
                        "outdoor recreation",
                        "physical recreation",
                        "recreation center"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность для удовольствия или отдыха в свободное от работы время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдых",
                                "target_lang_sense_clarification": "восстановление сил и свободное время"
                            },
                            {
                                "target_lang_word": "развлечение",
                                "target_lang_sense_clarification": "занятие, доставляющее удовольствие"
                            },
                            {
                                "target_lang_word": "досуг",
                                "target_lang_sense_clarification": "свободное от дел время и занятия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef1a3246-e049-3e45-bff7-0be615102d7c",
                    "sense_definition": "The act or process of making or creating something again.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical society is planning a faithful <w>recreation</w> of the original village.",
                            "target_lang_translations": {
                                "ru": "Историческое общество планирует точное <w>воссоздание</w> первоначальной деревни."
                            }
                        },
                        {
                            "text": "The digital <w>recreation</w> of the lost city was based on ancient maps and descriptions.",
                            "target_lang_translations": {
                                "ru": "Цифровая <w>реконструкция</w> затерянного города была основана на древних картах и описаниях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "faithful recreation",
                        "digital recreation",
                        "historical recreation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс повторного создания или воссоздания чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воссоздание",
                                "target_lang_sense_clarification": "процесс восстановления или повторного создания"
                            },
                            {
                                "target_lang_word": "реконструкция",
                                "target_lang_sense_clarification": "восстановление первоначального облика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b998814-13ab-3446-aa96-5e62581ac02f",
                    "sense_definition": "Something that has been created again, such as a model or a reenactment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum features a life-size <w>recreation</w> of a Victorian street.",
                            "target_lang_translations": {
                                "ru": "В музее представлена полноразмерная <w>реконструкция</w> викторианской улицы."
                            }
                        },
                        {
                            "text": "This film is a stunning <w>recreation</w> of the events that took place in 1920.",
                            "target_lang_translations": {
                                "ru": "Этот фильм — потрясающее <w>воссоздание</w> событий, происходивших в 1920 году."
                            }
                        }
                    ],
                    "common_phrases": [
                        "life-size recreation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, созданное заново, например, модель или инсценировка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реконструкция",
                                "target_lang_sense_clarification": "воспроизведенная модель или копия"
                            },
                            {
                                "target_lang_word": "инсценировка",
                                "target_lang_sense_clarification": "воссоздание исторических событий"
                            },
                            {
                                "target_lang_word": "копия",
                                "target_lang_sense_clarification": "точное воспроизведение оригинала"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}