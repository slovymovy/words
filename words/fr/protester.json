    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98c3aac2-5794-38ea-a9b8-402a25103906",
                    "sense_definition": "Exprimer avec force son désaccord, son opposition ou son mécontentement face à une situation ou une décision.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux citoyens sont descendus dans la rue pour <w>protester</w> contre une décision injuste."
                        },
                        {
                            "text": "Les délégués syndicaux ont décidé de <w>protester</w> vigoureusement lors de la réunion de ce matin."
                        }
                    ],
                    "synonyms": [
                        "s'opposer",
                        "contester",
                        "réclamer"
                    ],
                    "antonyms": [
                        "acquiescer",
                        "accepter",
                        "consentir"
                    ],
                    "common_phrases": [
                        "protester contre une décision",
                        "protester vigoureusement"
                    ]
                },
                {
                    "sense_id": "82398ae1-8813-3d97-a738-8e1db411e053",
                    "sense_definition": "Affirmer ou assurer solennellement et avec insistance la vérité de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Devant les enquêteurs, le suspect n'a cessé de <w>protester</w> de son innocence malgré les accusations."
                        },
                        {
                            "text": "Le ministre a pris la parole afin de <w>protester</w> de sa fidélité aux principes de la République."
                        }
                    ],
                    "synonyms": [
                        "assurer",
                        "certifier",
                        "jurer"
                    ],
                    "antonyms": [
                        "nier"
                    ],
                    "common_phrases": [
                        "protester de son innocence",
                        "protester de sa fidélité"
                    ]
                },
                {
                    "sense_id": "a741173c-90bd-33b4-ad40-51ef713e99a3",
                    "sense_definition": "Faire constater officiellement par un officier ministériel le non-paiement ou le refus d'acceptation d'un effet de commerce.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit_commercial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le créancier a demandé à son banquier de faire <w>protester</w> une traite restée sans règlement."
                        },
                        {
                            "text": "Si l'entreprise refuse de payer cette lettre de change, il faudra la <w>protester</w> sans tarder."
                        }
                    ],
                    "common_phrases": [
                        "faire protester une traite"
                    ]
                }
            ]
        }
    ]
