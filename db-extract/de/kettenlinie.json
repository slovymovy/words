                "senses": [
                    {
                        "sense_id": "eea45837-b04b-3383-ac3e-8151727fe717",
                        "entry_id": "8055303b-3c13-325f-9281-aa04337de347",
                        "glosses": [
                            "parabelähnliche Kurve, die von einer völlig biegsamen, aber nicht ausdehnbaren, an den zwei Endpunkten aufgehängten Kette unter Einfluss der Schwerkraft gebildet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73682279-0d08-4266-8d2f-c05f54fa9450",
                                "sense_id": "eea45837-b04b-3383-ac3e-8151727fe717",
                                "text": "„Die Fahrbahnträger Kragen danach aus, während die verbleibenden Seile trotzdem noch eine perfekte Kettenlinie bilden – nur halt ohne Mittelstück.“"
                            },
                            {
                                "example_id": "00112dad-e113-4f06-a13e-4f36db379cf5",
                                "sense_id": "eea45837-b04b-3383-ac3e-8151727fe717",
                                "text": "„Ein einzelnes Seil über einem Abgrund oder genauer gesagt eine Kettenlinie, die frei zwischen zwei Ankerpunkten hängt, ist die einfachste Form der Hängebrücke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
