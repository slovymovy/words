            {
                "entry_id": "856420b0-a4c5-3c72-b3a6-684d62779ac4",
                "word": "yang",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a4c82f39-4bb3-3896-8578-dce411521345",
                        "entry_id": "856420b0-a4c5-3c72-b3a6-684d62779ac4",
                        "glosses": [
                            "A principle in Chinese and related East Asian philosophies associated with bright, hot, masculine, etc. elements of the natural world."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3c7c7864-a186-4ec9-955a-d21da1fb46be",
                                "sense_id": "a4c82f39-4bb3-3896-8578-dce411521345",
                                "text": "\"Steamed fish and chicken and vegetable soup and even mushrooms are considered cooling foods, edible materializations of the yang, the pure primal air. The yin, or earth element, inheres in fried dishes and especially in shark's fin soup. Am I right, Mr Lee?\""
                            },
                            {
                                "example_id": "0bbe89f0-b2ad-44b6-96c8-3bdb622f4ed7",
                                "sense_id": "a4c82f39-4bb3-3896-8578-dce411521345",
                                "text": "The performance was unmistakably male and gay. The rousing lion dance that capped their performance provided the right touch of \"yang\" without destroying the distinct feel of something gay, Asian and new."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d053e51-2eaf-4d58-8ccd-c1638553f6ec",
                        "source_entry_id": "856420b0-a4c5-3c72-b3a6-684d62779ac4",
                        "source_sense_id": "a4c82f39-4bb3-3896-8578-dce411521345",
                        "source_sense_description": "essential male principle",
                        "target_lang_word": "Yang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1c36bfa-d0fc-357c-90b2-7c32cd3e74a5",
                                        "entry_id": "3166c812-ea43-365e-82fa-311132a48582",
                                        "glosses": [
                                            "das männliche Prinzip in der chinesischen Naturphilosophie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ffe7934-6623-44b6-889b-70d31c2c0ca7",
                                                "sense_id": "d1c36bfa-d0fc-357c-90b2-7c32cd3e74a5",
                                                "text": "Soviel weiß ich allerdings: das Yin-Yang Symbol genießt in Ostasien die höchste Verehrung."
                                            },
                                            {
                                                "example_id": "5fa92e3c-a5aa-48b2-b360-ecc619346e66",
                                                "sense_id": "d1c36bfa-d0fc-357c-90b2-7c32cd3e74a5",
                                                "text": "„Ich glaube daran, dass wir Yin und Yang unserer Partei zusammenbringen müssen“, erläutert der Rechtsanwalt Mark Aronchick, einer der Gründer von VoteBoth."
                                            },
                                            {
                                                "example_id": "5db39031-9cb5-4454-8e68-4948343ed887",
                                                "sense_id": "d1c36bfa-d0fc-357c-90b2-7c32cd3e74a5",
                                                "text": "Dieser Gott war ein Vegetations-, beileibe aber kein Schöpfergott, die Schöpfung wurde vielmehr durch das bipolare Spiel zwischen zwei Urkräften, dem männlichen Yang und dem weiblichen Yin bestimmt. In diesem Bild repräsentiert der Himmel das Prinzip Yang, die Erde folglich Yin, wobei sich alle Momente des Kosmos in Bewegung befinden und ein gewaltiges Durcheinander entstehen kann, welches die Dinge »unter dem Himmel« in ihrem Fortbestand bedroht."
                                            },
                                            {
                                                "example_id": "302eed06-8ce0-4648-beff-52c004faf330",
                                                "sense_id": "d1c36bfa-d0fc-357c-90b2-7c32cd3e74a5",
                                                "text": "Bei Dusch-Gel und Bade-Öl erleben wir überhaupt Harmonie, Yin und Yang."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
