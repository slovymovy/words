                    "frequency": "High",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight had to <w>kneel</w> before the king to receive his honor."
                        },
                        {
                            "text": "She was <w>kneeling</w> on the floor to look for her lost earring."
                        }
                    ],
                    "common_phrases": [
