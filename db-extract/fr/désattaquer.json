                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "901e939c-e621-4086-b5ac-aa8ec5817a1a",
                                "sense_id": "c6bb1556-a0e6-3a8c-a5ec-ad91af1736ce",
                                "text": "Comme le dit joliment un membre de son parti (Nouvelle Démocratie, ND), le député européen Kostas Hatzidakis, elle entend surtout \"désattaquer les terroristes\" en se battant sur le terrain politique."
                            },
                            {
                                "example_id": "cb987656-dacb-4c60-8c70-b77875663550",
                                "sense_id": "c6bb1556-a0e6-3a8c-a5ec-ad91af1736ce",
                                "text": "Désattaquer le document."
                            },
                            {
                                "example_id": "3ab6a4d2-e7fe-452f-8f15-e7c8cc54ece9",
                                "sense_id": "c6bb1556-a0e6-3a8c-a5ec-ad91af1736ce",
                                "text": "N'importe qui avec deux doigts de devant peut monter et désattaquer."
                            }
                        ]
