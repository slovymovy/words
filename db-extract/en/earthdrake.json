                        "examples": [
                            {
                                "example_id": "8f6a2041-1c2a-4668-9679-da13299b118d",
                                "sense_id": "2a2c6b8e-95f0-3ad2-a6ea-5e811dfa8fbe",
                                "text": "[…] he sacrifices his own life in destroying a frightful earthdrake, […]"
                            },
                            {
                                "example_id": "2a2ea7ec-f1ae-4747-a2a3-ceff41d67f74",
                                "sense_id": "2a2c6b8e-95f0-3ad2-a6ea-5e811dfa8fbe",
                                "text": "The slayer also lay,\nThe terrible earth-drake deprived of life,\nOppressed by bale: the ring-hoard longer\nThe twisted worm, might not control."
                            },
                            {
                                "example_id": "10166d16-d632-40bc-9f8a-717318ba61c0",
                                "sense_id": "2a2c6b8e-95f0-3ad2-a6ea-5e811dfa8fbe",
                                "text": "While attempting to remain as true to history as possible, I created a world of witches and wizards, earthdrakes and talking ravens, according to my imagination."
                            },
                            {
                                "example_id": "22678456-b9c9-44ad-867c-7dd650ed4fa1",
                                "sense_id": "2a2c6b8e-95f0-3ad2-a6ea-5e811dfa8fbe",
                                "text": "Aric had heard improbable tales of earth drakes eating entire mekillots. Seeing this one, however, he no longer had reason to doubt."
                            }
                        ]
                    }
                ],
