{
    "word_family": [
        "видение",
        "видимость",
        "невидимка",
        "вид"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed38229e-2709-3d02-ab57-f5cdbae2d3d1",
                    "sense_definition": "Воспринимать что-либо с помощью зрения",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она <w>видит</w> их каждый день в парке.",
                            "target_lang_translations": {
                                "en": "She <w>sees</w> them every day in the park."
                            }
                        },
                        {
                            "text": "Мы <w>видим</w> красивый закат над морем.",
                            "target_lang_translations": {
                                "en": "We <w>see</w> a beautiful sunset over the sea."
                            }
                        }
                    ],
                    "synonyms": [
                        "замечать"
                    ],
                    "common_phrases": [
                        "видеть сон",
                        "видеть свет"
                    ],
                    "target_lang_definitions": {
                        "en": "To perceive or detect someone or something with the eyes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "see",
                                "target_lang_sense_clarification": "to perceive with the eyes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22da3881-f3d3-314f-b52e-4a3d8ed2c6cd",
                    "sense_definition": "Встречаться с кем-либо, проводить время вместе",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я не <w>видел</w> вас целую неделю.",
                            "target_lang_translations": {
                                "en": "I haven't <w>seen</w> you for a whole week."
                            }
                        },
                        {
                            "text": "Мы часто <w>видимся</w> с друзьями по выходным.",
                            "target_lang_translations": {
                                "en": "We often <w>meet</w> with friends on weekends."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To meet with someone or spend time together."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "see",
                                "target_lang_sense_clarification": "to meet or visit someone"
                            },
                            {
                                "target_lang_word": "meet",
                                "target_lang_sense_clarification": "to come face to face with someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27b3a55f-32ba-31a7-8a88-9b75e41707d7",
                    "sense_definition": "Обладать способностью видеть",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы плохо <w>видим</w> в темноте.",
                            "target_lang_translations": {
                                "en": "We <w>see</w> poorly in the dark."
                            }
                        },
                        {
                            "text": "Кот отлично <w>видит</w> ночью.",
                            "target_lang_translations": {
                                "en": "The cat <w>sees</w> perfectly at night."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To possess the ability to see."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "see",
                                "target_lang_sense_clarification": "to have the faculty of sight"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00bfe404-c804-3f75-9376-1184f5a60e9d",
                    "sense_definition": "Понимать, осознавать что-либо",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он ясно <w>видел</w>, что совершил большую ошибку.",
                            "target_lang_translations": {
                                "en": "He clearly <w>saw</w> that he had made a big mistake."
                            }
                        },
                        {
                            "text": "Я <w>вижу</w> в этом решении много проблем.",
                            "target_lang_translations": {
                                "en": "I <w>see</w> many problems in this decision."
                            }
                        }
                    ],
                    "synonyms": [
                        "полагать",
                        "усматривать"
                    ],
                    "target_lang_definitions": {
                        "en": "To understand or realize something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "understand",
                                "target_lang_sense_clarification": "to comprehend a fact or principle"
                            },
                            {
                                "target_lang_word": "see",
                                "target_lang_sense_clarification": "to grasp the meaning of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93807243-a091-3001-8892-769f3d39d440",
                    "sense_definition": "Автоматически определять наличие компонента в системе",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После обновления драйверов компьютер снова стал <w>видеть</w> видеокарту.",
                            "target_lang_translations": {
                                "en": "After updating the drivers, the computer started to <w>detect</w> the graphics card again."
                            }
                        },
                        {
                            "text": "Система не <w>видит</w> подключенный внешний жесткий диск.",
                            "target_lang_translations": {
                                "en": "The system does not <w>recognize</w> the connected external hard drive."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Используется в компьютерном жаргоне"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To automatically detect the presence of a component in a system."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "detect",
                                "target_lang_sense_clarification": "to discover or identify the presence of something"
                            },
                            {
                                "target_lang_word": "recognize",
                                "target_lang_sense_clarification": "to identify a device or component"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}