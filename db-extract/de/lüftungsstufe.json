                "senses": [
                    {
                        "sense_id": "f90e244e-36cb-36a1-8159-a3fda1eacbc0",
                        "entry_id": "e0cf7b3c-ce26-3275-80fe-f3344bff5889",
                        "glosses": [
                            "Anlage die Luft in einem Gebäude bewegt und stufig geschaltet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2da91354-dc52-45f9-baec-26d867e6d148",
                                "sense_id": "f90e244e-36cb-36a1-8159-a3fda1eacbc0",
                                "text": "„Auch für die nachfolgenden Lüftungsstufen muss der Planer festlegen, wie er den notwendigen Luftaustausch erzielen will.“"
                            },
                            {
                                "example_id": "86da5f3f-6448-47c1-af2a-14fe44319248",
                                "sense_id": "f90e244e-36cb-36a1-8159-a3fda1eacbc0",
                                "text": "„Das Lüftungsgerät läuft wieder in der selben Lüftungsstufe wie vor der Sperrung“"
                            },
                            {
                                "example_id": "ea90f66e-8203-42cb-8d38-013a6457a020",
                                "sense_id": "f90e244e-36cb-36a1-8159-a3fda1eacbc0",
                                "text": "„Die Norm fordert den Nachweis für vier Lüftungsstufen, die bei unterschiedlichen Nutzungsbedingungen einen ausreichenden Luftwechsel sicher stellen.“"
                            },
                            {
                                "example_id": "82110e90-171a-4d37-ae15-7084ebd12962",
                                "sense_id": "f90e244e-36cb-36a1-8159-a3fda1eacbc0",
                                "text": "„Die neue Lüftungsstufe: „Lüftung zum Feuchteschutz“ (FL) wurde als zusätzliche Lüftungsstufe aufgenommen, so dass jetzt vier Lüftungsstufen unterschiedlicher Intensität in der Norm enthalten sind.“"
                            },
                            {
                                "example_id": "bbf4e0c0-6cec-414c-b966-7b712f2cd449",
                                "sense_id": "f90e244e-36cb-36a1-8159-a3fda1eacbc0",
                                "text": "„Bei den freiwillig wählbaren höheren Lüftungsstufen wird dies in Verbindung mit Abluftventilatoren oder Schächten realisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
