{
    "word_family": [
        "horten"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "52d4f2c5-bed8-3727-b309-9d0136adf199",
                    "sense_definition": "Een plotselinge, schokkerige beweging.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude auto maakte een vervelende <w>hort</w> tijdens het optrekken.",
                            "target_lang_translations": {
                                "en": "The old car gave a nasty <w>jerk</w> while accelerating."
                            }
                        },
                        {
                            "text": "Met een plotselinge <w>hort</w> kwam de trein eindelijk tot stilstand.",
                            "target_lang_translations": {
                                "en": "With a sudden <w>jolt</w>, the train finally came to a stop."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruk",
                        "stoot"
                    ],
                    "common_phrases": [
                        "met horten en stoten"
                    ],
                    "target_lang_definitions": {
                        "en": "A sudden, jerky movement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jerk",
                                "target_lang_sense_clarification": "a quick, sharp, sudden movement"
                            },
                            {
                                "target_lang_word": "lurch",
                                "target_lang_sense_clarification": "an unsteady, jerky movement or roll"
                            },
                            {
                                "target_lang_word": "jolt",
                                "target_lang_sense_clarification": "a sudden, rough, or violent movement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4b869c7-eca3-3acd-8b88-f258bf3819dd",
                    "sense_definition": "Een weg of pad.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "locatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zocht naar de juiste <w>hort</w> door het dichte bos.",
                            "target_lang_translations": {
                                "en": "He looked for the right <w>path</w> through the dense forest."
                            }
                        },
                        {
                            "text": "Deze oude <w>hort</w> wordt al jaren niet meer gebruikt door wandelaars.",
                            "target_lang_translations": {
                                "en": "This old <w>track</w> has not been used by hikers for years."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Dit woord wordt in deze betekenis nauwelijks meer gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A road or path."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "path",
                                "target_lang_sense_clarification": "a way or track laid down for walking or made by continual treading"
                            },
                            {
                                "target_lang_word": "track",
                                "target_lang_sense_clarification": "a rough path or road, typically one beaten by use"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9e5a1b8-757c-3f62-aef4-ace78a5860fc",
                    "sense_definition": "Enkelvoud tegenwoordige tijd van <w>horten</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De motor <w>hort</w> telkens als de temperatuur te laag is.",
                            "target_lang_translations": {
                                "en": "The engine <w>stutters</w> every time the temperature is too low."
                            }
                        },
                        {
                            "text": "Het proces <w>hort</w> door een gebrek aan goede communicatie.",
                            "target_lang_translations": {
                                "en": "The process <w>jerks</w> along due to a lack of good communication."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm van het werkwoord."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Third-person singular present tense of 'horten' (to jerk or stutter)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jerks",
                                "target_lang_sense_clarification": "moves with a sudden, sharp motion"
                            },
                            {
                                "target_lang_word": "stutters",
                                "target_lang_sense_clarification": "moves or functions in an uneven, jerky way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f98aa7be-92f5-3561-a74c-9453b5999817",
                    "sense_definition": "Gebiedende wijs van <w>horten</w>.",
                    "learner_level": "B1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hort</w> niet zo met die wagen, rijd rustig door.",
                            "target_lang_translations": {
                                "en": "<w>Don't jerk</w> the car like that, drive smoothly."
                            }
                        },
                        {
                            "text": "<w>Hort</w> maar door met die machine als hij vastloopt.",
                            "target_lang_translations": {
                                "en": "Just keep <w>jerking</w> the machine if it gets stuck."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoegde vorm van het werkwoord."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'horten' (to jerk or stutter)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jerk",
                                "target_lang_sense_clarification": "command to move with a sudden, sharp motion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}