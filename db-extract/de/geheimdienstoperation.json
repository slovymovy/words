                "senses": [
                    {
                        "sense_id": "7639f4af-d151-3f3a-946f-de27868482c1",
                        "entry_id": "0ae2c751-ead0-37b7-8026-5f895263fbf3",
                        "glosses": [
                            "von einem Geheimdienst geplante und durchgeführte Operation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7e4dec2-0a7b-4811-8a19-72f42f76b072",
                                "sense_id": "7639f4af-d151-3f3a-946f-de27868482c1",
                                "text": "„Wirklich erfolgreiche Geheimdienstoperationen bleiben auf ewig geheim.“"
                            },
                            {
                                "example_id": "c1b4619f-d3fd-45ca-a693-6f2d086258e7",
                                "sense_id": "7639f4af-d151-3f3a-946f-de27868482c1",
                                "text": "„Ich weiß doch, dass sie schon Geheimdienstoperationen durchgeführt haben.“"
                            },
                            {
                                "example_id": "f857f45c-df12-448a-b243-b0e21fe034d6",
                                "sense_id": "7639f4af-d151-3f3a-946f-de27868482c1",
                                "text": "„Vor ihrer Begegnung mit Doktor Marcus war Anna nie auf den Gedanken gekommen, was für eine große Rolle Psychologie bei Geheimdienstoperationen spielte.“"
                            },
                            {
                                "example_id": "aa4da945-8c2e-43c5-aa47-08955393a23f",
                                "sense_id": "7639f4af-d151-3f3a-946f-de27868482c1",
                                "text": "„Sophie hatte nie verstanden, wie viele der Geschäfte wirklich echt waren und wie viele nur als Deckmantel für Geheimdienstoperationen dienten.“"
                            },
                            {
                                "example_id": "7cb1127a-c2c5-47db-aedc-5c1f2fb85b7e",
                                "sense_id": "7639f4af-d151-3f3a-946f-de27868482c1",
                                "text": "„Du und ich, Freunde fürs Leben, in einer Geheimdienstoperation gegen den ewigen Feind, den Kommunismus!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
