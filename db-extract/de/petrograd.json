                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10200aae-090c-4155-8267-d52e82147c24",
                                "sense_id": "f9ee9b5c-8ccd-3278-8fa7-94160ed956fd",
                                "text": "„Der Petrograder Sowjet misstraute der Regierung, und von der Front kamen Hunderte von Delegierten der breiten Soldatenmassen, die erklärten: ›Es ist wahr, wir brauchen Verstärkung; wichtiger aber ist uns, Petrograd und die Revolution in guten Händen zu wissen …‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
