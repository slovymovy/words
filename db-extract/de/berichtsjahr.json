                        "tags": [],
                        "examples": [
                            {
                                "example_id": "676d97fa-6264-4031-bb72-2cc570e064f1",
                                "sense_id": "bc2c5760-8f9a-3c60-b74e-49d4566aa53c",
                                "text": "„Der Sondereffekt im Berichtsjahr resultierte aus der Bereinigung von Erlösschmälerungen.“"
                            },
                            {
                                "example_id": "7462c6ec-dae2-42ee-815c-df1b8dbf77d6",
                                "sense_id": "bc2c5760-8f9a-3c60-b74e-49d4566aa53c",
                                "text": "„Die im Dienstleistungsbereich tätigen 253.169 Unternehmen erzielten im Berichtsjahr 2012 mit 1.839.527 Beschäftigten Umsatzerlöse von 445,0 Mrd. Euro, wobei ein Produktionswert von 201,3 Mrd. Euro und eine Bruttowertschöpfung zu Faktorkosten von 111,1 Mrd. Euro erwirtschaftet wurden.“"
                            }
                        ],
