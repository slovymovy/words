                    {
                        "translation_id": "44b72f73-8387-4c02-9a82-0319cc558248",
                        "source_entry_id": "57cd4018-ce8d-33f1-93e4-2c52dd567ef6",
                        "source_sense_id": "0c97ed70-b998-360f-a68d-897ea2d2a8a8",
                        "source_sense_description": "verschieden, verschiedenartig",
                        "target_lang_word": "verschieden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
