                    {
                        "sense_id": "bbd0e32e-1bc1-35c3-83d6-01994c1a9a23",
                        "entry_id": "3af60fca-e60f-3688-91bb-faffd0da7d3f",
                        "glosses": [
                            "van of als een vrouw waarvan de huwelijkspartner is overleden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10867f1d-3d63-49c5-a99f-f77326f53fa5",
                                "sense_id": "bbd0e32e-1bc1-35c3-83d6-01994c1a9a23",
                                "text": "Het huwelijk verloopt kalm, koel en schier weduwlijk voor deze trouwe, ernstige en plichtbewuste vrouw. Haar man is meestal ver van huis; wanneer hij van de reis komt, werpt geen hartstocht haar in zijn armen."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd4a172a-a55c-3203-a3ce-192b95510271",
                        "entry_id": "3af60fca-e60f-3688-91bb-faffd0da7d3f",
                        "glosses": [
                            "van of vergelijkbaar met iemand wiens partner is overleden"
                        ],
                        "tags": [
                            "ruimere betekenis"
                        ],
                        "examples": [
                            {
                                "example_id": "d4f159a7-39fc-46ed-ac44-7c62db386f4d",
                                "sense_id": "bd4a172a-a55c-3203-a3ce-192b95510271",
                                "text": "(…) de kinderen Israëls zouden vele dagen (…) blijven zitten, eenzaam, weduwlijk, als dengenen die naar Joodsch-Oostersche wijze op den grond zittende hunnen rouw bedrijven."
                            }
                        ]
                    }
