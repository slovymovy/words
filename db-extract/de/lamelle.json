                "senses": [
                    {
                        "sense_id": "7d710994-654a-362c-a8c9-14ffa9d8f1fd",
                        "entry_id": "e7930196-aa98-3366-9538-63b0febb3ff2",
                        "glosses": [
                            "einzelnes, schmales Teil eines fächerförmig aufgebauten Gebildes (besonders bei Jalousie und Heizkörper)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b418de-472b-439b-a991-0eb7eb44c36f",
                                "sense_id": "7d710994-654a-362c-a8c9-14ffa9d8f1fd",
                                "text": "Wie macht man am einfachsten alle Lamellen des Heizkörpers sauber?"
                            },
                            {
                                "example_id": "24cfe2ba-2489-4b45-9c94-f0e2a657dcfd",
                                "sense_id": "7d710994-654a-362c-a8c9-14ffa9d8f1fd",
                                "text": "Eine der Lamellen am Rollo ist verbogen und hakt."
                            },
                            {
                                "example_id": "9db1742b-17a5-43f5-b698-4faea835536b",
                                "sense_id": "7d710994-654a-362c-a8c9-14ffa9d8f1fd",
                                "text": "„Die Lamellen bestanden aus 3 mm SM-Blech mit einer Festigkeit von 37-44 kp/mm2 und einer Dehnung von 20 %.“"
                            },
                            {
                                "example_id": "554f2c91-c20d-4d5d-9326-c24c57dac665",
                                "sense_id": "7d710994-654a-362c-a8c9-14ffa9d8f1fd",
                                "text": "„Nur zwischen zwei schadhaften Lamellen drang ein lärmender Ton der Erinnerung an die Welt da draußen in die innere Klause.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7d1cec8c-cb16-3bb3-a522-e11154d8c34a",
                        "entry_id": "e7930196-aa98-3366-9538-63b0febb3ff2",
                        "glosses": [
                            "einzelnes, schmales Teil des fächerförmigen Gebildes auf der Kappenunterseite von Blätterpilzen"
                        ],
                        "tags": [
                            "Mykologie"
                        ],
                        "examples": [
                            {
                                "example_id": "568bb149-13d3-402a-963c-b29d60f53935",
                                "sense_id": "7d1cec8c-cb16-3bb3-a522-e11154d8c34a",
                                "text": "Die Lamellen sollten durchgehend eine hellbeige Farbe haben und noch elastisch sein."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1eeaa7bc-6ece-4237-b11d-61bd0dd32015",
                        "source_entry_id": "e7930196-aa98-3366-9538-63b0febb3ff2",
