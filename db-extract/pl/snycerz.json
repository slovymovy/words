                "senses": [
                    {
                        "sense_id": "c019ec8c-8f74-3fd1-be59-a95e72e00995",
                        "entry_id": "029ed4a6-6959-3805-8e97-d43379844ab9",
                        "glosses": [
                            "rzemieślnik lub artysta zajmujący się rzeźbieniem w drewnie, snycerstwem"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "3b6fdcb0-f2d0-44f9-8df0-d7f98fa425a5",
                                "sense_id": "c019ec8c-8f74-3fd1-be59-a95e72e00995",
                                "text": "(…) w formach profesjonalnych widać posługiwanie się przez snycerza dłutem z łyżeczkowatym ostrzem"
                            },
                            {
                                "example_id": "a8407593-ed2f-41a6-bcb3-8468379b0070",
                                "sense_id": "c019ec8c-8f74-3fd1-be59-a95e72e00995",
                                "text": "Ipsarskie miasto, jak dłutem snycerza / Ze skał ciemnego łona wydobyte, / Barwy ma szare od tła nie odbite, / I lasem masztów na poły schowane"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09c70e19-7769-4639-9322-6b1381236310",
                        "source_entry_id": "029ed4a6-6959-3805-8e97-d43379844ab9",
