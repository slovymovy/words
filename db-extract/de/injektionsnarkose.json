                "senses": [
                    {
                        "sense_id": "7705fcf1-30d7-31f6-9d6c-528e734863c5",
                        "entry_id": "b92f6d02-2664-35ea-bebf-a06e2f16d3f4",
                        "glosses": [
                            "Narkose, die mittels einer Injektion eingeleitet und aufrecht erhalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6f5734c-4ddd-4fd8-bb3f-5424d7d8e59d",
                                "sense_id": "7705fcf1-30d7-31f6-9d6c-528e734863c5",
                                "text": "„In der Tiermedizin werden häufig Injektionsnarkosen durchgeführt.“"
                            },
                            {
                                "example_id": "3bfc67bd-70c5-4aff-a8db-fb9f93abfd16",
                                "sense_id": "7705fcf1-30d7-31f6-9d6c-528e734863c5",
                                "text": "„Ein weiterer Nachteil der Injektionsnarkose zur Inhalationsnarkose besteht darin, dass das Narkosegas nahezu keinerlei Belastung für Leber oder Nieren darstellt, sondern einfach über die Lungen wieder abgeatmet wird, während intravenöse Narkotika von Leber und Nieren verstoffwechselt, also abgebaut werden müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
