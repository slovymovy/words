                                        "examples": [
                                            {
                                                "example_id": "ea3a31b1-be46-482b-9515-909dda7b1431",
                                                "sense_id": "fc2b30b2-c4f7-358e-9da7-cde2b300b174",
                                                "text": "Už je toho zrovna dost, těch ženských: kvůli té couře Heleně se válka začala a teď zase tohle – Slyšeli jste, že Helena poslední dobou drží s Hektorem?"
                                            },
                                            {
                                                "example_id": "b0a74f7e-13c9-438a-bb6d-dc3b161c0d60",
                                                "sense_id": "fc2b30b2-c4f7-358e-9da7-cde2b300b174",
                                                "text": "V Praze II byly před léty dvě vopuštěný paničky, rozvedený, poněvadž to byly coury, nějaká Mourková a Šousková, a ty jednou, když kvetly třešně v aleji u Roztok, chytly tam večer starýho impotentního stoletýho flašinetáře a vodtáhly si ho do roztockýho háje a tam ho znásilnily."
                                            }
