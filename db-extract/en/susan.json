                    },
                    {
                        "translation_id": "eddc596b-ffcc-4f77-bff0-63ddc30a954f",
                        "source_entry_id": "c2114f97-315f-3934-ac3e-e4c83e905ef3",
                        "source_sense_id": "75939413-0d57-3b3d-af18-8cd995b535b2",
