    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "abcc3ed9-a054-3756-84d1-3afc2903773c",
                    "sense_definition": "A flat-bottomed vessel (usually metal) used for cooking food, possibly excluding saucepans.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vessels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She filled the large <w>pot</w> with water to boil the pasta for dinner.",
                            "target_lang_translations": {
                                "ru": "Она наполнила большую <w>кастрюлю</w> водой, чтобы сварить пасту на ужин."
                            }
                        },
                        {
                            "text": "Make sure to use a cooking <w>pot</w> that is big enough for the whole chicken.",
                            "target_lang_translations": {
                                "ru": "Обязательно используйте <w>кастрюлю</w>, которая достаточно велика для целой курицы."
                            }
                        }
                    ],
                    "synonyms": [
                        "cookpot",
                        "cooking pot"
                    ],
                    "common_phrases": [
                        "boiling pot",
                        "stock pot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд с плоским дном (обычно металлический), используемый для приготовления пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кастрюля",
                                "target_lang_sense_clarification": "металлическая емкость для варки"
                            },
                            {
                                "target_lang_word": "горшок",
                                "target_lang_sense_clarification": "округлый сосуд для приготовления пищи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e40d0da-eb84-3844-9f6a-455d8d94030f",
                    "sense_definition": "A vessel used to hold soil for growing plants, particularly flowers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vessels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a beautiful ceramic <w>pot</w> for his new indoor palm tree.",
                            "target_lang_translations": {
                                "ru": "Он купил красивый керамический <w>горшок</w> для своей новой комнатной пальмы."
                            }
                        },
                        {
                            "text": "The balcony was decorated with a colorful flower <w>pot</w> in every corner.",
                            "target_lang_translations": {
                                "ru": "Балкон был украшен разноцветными цветочными <w>горшками</w> в каждом углу."
                            }
                        }
                    ],
                    "synonyms": [
                        "flowerpot",
                        "planter"
                    ],
                    "common_phrases": [
                        "flower pot",
                        "clay pot",
                        "terracotta pot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд, используемый для наполнения землей и выращивания растений, особенно цветов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горшок",
                                "target_lang_sense_clarification": "цветочный горшок"
                            },
                            {
                                "target_lang_word": "вазон",
                                "target_lang_sense_clarification": "декоративный сосуд для растений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1df10871-8400-31f6-8f65-b667cd936fec",
                    "sense_definition": "A vessel used for brewing or serving drinks, such as a coffeepot or teapot.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vessels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Would you like me to make a fresh <w>pot</w> of tea for our guests?",
                            "target_lang_translations": {
                                "ru": "Хотите, я заварю свежий <w>чайник</w> чая для наших гостей?"
                            }
                        },
                        {
                            "text": "He drank a whole <w>pot</w> of coffee while studying for his final exams.",
                            "target_lang_translations": {
                                "ru": "Он выпил целый <w>кофейник</w> кофе, пока готовился к выпускным экзаменам."
                            }
                        }
                    ],
                    "synonyms": [
                        "teapot",
                        "coffeepot"
                    ],
                    "common_phrases": [
                        "pot of tea",
                        "pot of coffee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд, используемый для заваривания или подачи напитков, таких как чай или кофе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чайник",
                                "target_lang_sense_clarification": "для заваривания чая"
                            },
                            {
                                "target_lang_word": "кофейник",
                                "target_lang_sense_clarification": "для подачи кофе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a14807fb-eced-364f-bb6f-ca45762533c0",
                    "sense_definition": "A common slang term for marijuana.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the teenagers for smoking <w>pot</w> behind the school building.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала подростков за курение <w>травки</w> за зданием школы."
                            }
                        },
                        {
                            "text": "He decided to smoke <w>pot</w> to relax after a very stressful day at work.",
                            "target_lang_translations": {
                                "ru": "Он решил покурить <w>травку</w>, чтобы расслабиться после очень напряженного рабочего дня."
                            }
                        }
                    ],
                    "synonyms": [
                        "marijuana",
                        "weed",
                        "grass",
                        "cannabis",
                        "dope"
                    ],
                    "common_phrases": [
                        "smoke pot"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "very common informal term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенное сленговое название марихуаны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травка",
                                "target_lang_sense_clarification": "сленговое название марихуаны"
                            },
                            {
                                "target_lang_word": "марихуана",
                                "target_lang_sense_clarification": "общее название наркотика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc61be2e-eb84-3797-99ab-e8c0cf758aaa",
                    "sense_definition": "The total amount of money available to be won in a game of chance, like poker.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After several rounds of betting, the <w>pot</w> grew to over five hundred dollars.",
                            "target_lang_translations": {
                                "ru": "После нескольких раундов ставок <w>банк</w> вырос до более чем пятисот долларов."
                            }
                        },
                        {
                            "text": "The dealer told the players they needed to sweeten the <w>pot</w> to keep the game interesting.",
                            "target_lang_translations": {
                                "ru": "Дилер сказал игрокам, что им нужно увеличить <w>банк</w>, чтобы игра оставалась интересной."
                            }
                        }
                    ],
                    "synonyms": [
                        "kitty",
                        "pool",
                        "jackpot",
                        "stakes"
                    ],
                    "common_phrases": [
                        "sweeten the pot",
                        "win the pot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общая сумма денег, доступная для выигрыша в азартной игре, например, в покере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банк",
                                "target_lang_sense_clarification": "в азартных играх"
                            },
                            {
                                "target_lang_word": "кон",
                                "target_lang_sense_clarification": "сумма на кону"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "989d9cbd-8f8e-354a-bfdb-e651d3e4d3d0",
                    "sense_definition": "An allocation or sum of money reserved for a particular purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government has set aside a large <w>pot</w> of money for local infrastructure projects.",
                            "target_lang_translations": {
                                "ru": "Правительство выделило крупный <w>фонд</w> денежных средств на местные инфраструктурные проекты."
                            }
                        },
                        {
                            "text": "She has been contributing to her pension <w>pot</w> since she started her first job.",
                            "target_lang_translations": {
                                "ru": "Она делает взносы в свой пенсионный <w>фонд</w> с тех пор, как устроилась на свою первую работу."
                            }
                        }
                    ],
                    "synonyms": [
                        "fund",
                        "reserve",
                        "budget"
                    ],
                    "common_phrases": [
                        "pension pot",
                        "savings pot",
                        "pot of money"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распределение или сумма денег, зарезервированная для определенной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фонд",
                                "target_lang_sense_clarification": "денежный резерв"
                            },
                            {
                                "target_lang_word": "кубышка",
                                "target_lang_sense_clarification": "разг. запас денег"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "784c484e-4e2a-3277-922b-63a87cdc3591",
                    "sense_definition": "A state of ruin, deterioration, or failure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old neighborhood has really gone to <w>pot</w> since the factory closed down.",
                            "target_lang_translations": {
                                "ru": "Старый район совсем <w>пришел в упадок</w> с тех пор, как закрылся завод."
                            }
                        },
                        {
                            "text": "Without proper maintenance, the beautiful garden will quickly go to <w>pot</w>.",
                            "target_lang_translations": {
                                "ru": "Без надлежащего ухода прекрасный сад быстро <w>запустится</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruin",
                        "deterioration"
                    ],
                    "common_phrases": [
                        "go to pot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in the phrase 'go to pot'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние упадка, разрушения или неудачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прах",
                                "target_lang_sense_clarification": "в выражении 'пойти прахом'"
                            },
                            {
                                "target_lang_word": "упадок",
                                "target_lang_sense_clarification": "состояние разрушения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8214d68-a4ee-32dc-ad10-ae8da6863430",
                    "sense_definition": "A vessel used for urination and defecation, such as a chamber pot; also a slang term for a toilet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vessels",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the days before indoor plumbing, every bedroom had a ceramic <w>pot</w> under the bed.",
                            "target_lang_translations": {
                                "ru": "В те времена, когда еще не было водопровода, в каждой спальне под кроватью стоял керамический <w>горшок</w>."
                            }
                        },
                        {
                            "text": "He was told to shit or get off the <w>pot</w> regarding his decision to quit.",
                            "target_lang_translations": {
                                "ru": "Ему сказали: либо делай, либо <w>освобождай место</w> (не тяни кота за хвост) по поводу его решения уволиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "chamber pot",
                        "potty",
                        "toilet"
                    ],
                    "common_phrases": [
                        "shit or get off the pot"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "when referring to a toilet"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд для мочеиспускания и дефекации (ночной горшок); также сленговое название туалета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горшок",
                                "target_lang_sense_clarification": "ночной или детский горшок"
                            },
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "сленг. туалет"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d24f35ee-8471-3339-b64d-8fba488b6c76",
                    "sense_definition": "To put something, especially a plant, into a <w>pot</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "gardening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is time to <w>pot</w> the seedlings now that they have grown their first leaves.",
                            "target_lang_translations": {
                                "ru": "Пришло время <w>рассадить</w> саженцы по горшкам теперь, когда у них выросли первые листочки."
                            }
                        },
                        {
                            "text": "She spent the afternoon <w>potting</w> up the herbs she bought at the market.",
                            "target_lang_translations": {
                                "ru": "Она провела вторую половину дня, <w>высаживая</w> в горшки зелень, которую купила на рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "repot",
                        "plant"
                    ],
                    "common_phrases": [
                        "pot up",
                        "pot a plant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поместить что-либо, особенно растение, в горшок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сажать",
                                "target_lang_sense_clarification": "помещать растение в горшок"
                            },
                            {
                                "target_lang_word": "пересаживать",
                                "target_lang_sense_clarification": "в горшок побольше"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2d21c0f-956d-331a-935d-343ac972126c",
                    "sense_definition": "In games like snooker or billiards, to hit a ball so that it falls into a pocket.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>pot</w> the black ball and win the entire match.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>забить</w> черный шар и выиграть весь матч."
                            }
                        },
                        {
                            "text": "The player struggled to <w>pot</w> the red ball because it was at a difficult angle.",
                            "target_lang_translations": {
                                "ru": "Игроку было трудно <w>забить</w> красный шар, потому что он находился под сложным углом."
                            }
                        }
                    ],
                    "synonyms": [
                        "pocket",
                        "sink"
                    ],
                    "common_phrases": [
                        "pot the ball",
                        "pot the black"
                    ],
                    "target_lang_definitions": {
                        "ru": "В таких играх, как снукер или бильярд, ударить по шару так, чтобы он попал в лузу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забивать",
                                "target_lang_sense_clarification": "шар в лузу"
                            },
                            {
                                "target_lang_word": "класть",
                                "target_lang_sense_clarification": "шар в лузу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3f8c0ef-9d5d-325b-bb3f-cb9930e5e3c1",
                    "sense_definition": "To place a young child on a potty or toilet, usually during toilet training.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "parenting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book suggests you should <w>pot</w> your child at regular intervals throughout the day.",
                            "target_lang_translations": {
                                "ru": "В книге советуют <w>высаживать</w> ребенка на горшок через регулярные промежутки времени в течение дня."
                            }
                        },
                        {
                            "text": "She tried to <w>pot</w> the baby before they left the house for their walk.",
                            "target_lang_translations": {
                                "ru": "Она попыталась <w>высадить</w> малыша на горшок перед тем, как они вышли из дома на прогулку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pot a child"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высаживать маленького ребенка на горшок или в туалет, обычно во время приучения к туалету."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высаживать",
                                "target_lang_sense_clarification": "ребенка на горшок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}