                        "examples": [
                            {
                                "example_id": "cae8d4fb-6d45-4e6e-b4c9-1d828a1a794e",
                                "sense_id": "bb7bd5cc-a6d2-3905-bfed-dd7ce0e829e1",
                                "text": "So far, I have argued that attempts in the 20th century to scientize the humanities wound up putting them at risk."
                            },
                            {
                                "example_id": "aa990371-13de-4010-a393-58e3a23e5117",
                                "sense_id": "bb7bd5cc-a6d2-3905-bfed-dd7ce0e829e1",
                                "text": "Eugenics is an early chapter in a long history of scientized prejudice in the United States, a story in which scientific evidence for racial, class, and gender hierarchies became popular and entered public discourse on a broad scale."
                            },
                            {
                                "example_id": "9e74a182-23bf-44aa-b6d3-813009ed1931",
                                "sense_id": "bb7bd5cc-a6d2-3905-bfed-dd7ce0e829e1",
                                "text": "Husserl tried to scientize psychology."
                            }
                        ]
                    }
