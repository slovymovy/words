    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "92fa72ab-9116-35c6-a3dd-39a660196a33",
                    "sense_definition": "An expression of gratitude, respect, or admiration, often in the form of a gift, speech, or performance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The concert was a moving <w>tribute</w> to the legendary singer who passed away last year.",
                            "target_lang_translations": {
                                "ru": "Концерт стал трогательной <w>данью памяти</w> легендарному певцу, ушедшему из жизни в прошлом году.",
                                "tr": "Konser, geçen yıl hayatını kaybeden efsanevi şarkıcıya duygusal bir <w>saygı duruşuydu</w>.",
                                "zh": "这场音乐会是对去年去世的传奇歌手一场感人的<w>致敬</w>。"
                            }
                        },
                        {
                            "text": "Please accept this small gift as a fitting <w>tribute</w> to your years of hard work.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, примите этот небольшой подарок как достойное <w>признание</w> ваших лет упорного труда.",
                                "tr": "Lütfen bu küçük hediyeyi, yıllar süren sıkı çalışmanıza yakışır bir <w>şükran ifadesi</w> olarak kabul edin.",
                                "zh": "请收下这份小礼物，作为对您多年辛勤工作的一份<w>敬意</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "encomium"
                    ],
                    "antonyms": [
                        "insult",
                        "criticism"
                    ],
                    "common_phrases": [
                        "fitting tribute",
                        "pay tribute",
                        "moving tribute",
                        "tribute to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение благодарности, уважения или восхищения, часто в форме подарка, речи или выступления.",
                        "tr": "Genellikle bir hediye, konuşma veya performans şeklinde minnettarlık, saygı veya hayranlık ifadesi.",
                        "zh": "表达感激、尊重或钦佩，通常以礼物、演讲或表演的形式呈现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дань",
                                "target_lang_sense_clarification": "уважения или признательности"
                            },
                            {
                                "target_lang_word": "должное",
                                "target_lang_sense_clarification": "признание заслуг"
                            },
                            {
                                "target_lang_word": "подношение",
                                "target_lang_sense_clarification": "в знак почтения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "saygı duruşu",
                                "target_lang_sense_clarification": "anma etkinliği veya ifadesi"
                            },
                            {
                                "target_lang_word": "övgü",
                                "target_lang_sense_clarification": "takdir ve hayranlık ifadesi"
                            },
                            {
                                "target_lang_word": "şükran ifadesi",
                                "target_lang_sense_clarification": "minnettarlık gösterme"
                            },
                            {
                                "target_lang_word": "armağan",
                                "target_lang_sense_clarification": "saygı nişanesi olarak verilen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致敬",
                                "target_lang_sense_clarification": "表达敬意"
                            },
                            {
                                "target_lang_word": "敬意",
                                "target_lang_sense_clarification": "表示尊重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b552c77-e82c-3109-abfb-a92690c85c3d",
                    "sense_definition": "A reference or homage in an artistic work to another creator or piece of work.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director included a subtle <w>tribute</w> to classic horror films in the opening scene.",
                            "target_lang_translations": {
                                "ru": "Режиссер включил в начальную сцену тонкую <w>отсылку</w> к классическим фильмам ужасов.",
                                "tr": "Yönetmen, açılış sahnesine klasik korku filmlerine ince bir <w>gönderme</w> ekledi.",
                                "zh": "导演在开场戏中加入了一个对经典恐怖电影微妙的<w>致敬</w>。"
                            }
                        },
                        {
                            "text": "The song serves as a <w>tribute</w> to the jazz musicians of the 1920s.",
                            "target_lang_translations": {
                                "ru": "Эта песня служит <w>данью уважения</w> джазовым музыкантам 1920-х годов.",
                                "tr": "Şarkı, 1920'lerin caz müzisyenlerine bir <w>saygı duruşu</w> niteliğindedir.",
                                "zh": "这首歌旨在向20世纪20年代的爵士乐手们<w>致敬</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "encomium"
                    ],
                    "common_phrases": [
                        "tribute to",
                        "artistic tribute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсылка или дань уважения в художественном произведении другому автору или произведению.",
                        "tr": "Sanatsal bir eserde başka bir yaratıcıya veya esere yapılan gönderme veya saygı duruşu.",
                        "zh": "艺术作品中对另一位创作者或作品的致敬或引用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дань уважения",
                                "target_lang_sense_clarification": "в искусстве"
                            },
                            {
                                "target_lang_word": "оммаж",
                                "target_lang_sense_clarification": "творческое подражание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "saygı duruşu",
                                "target_lang_sense_clarification": "sanatta anma veya hürmet"
                            },
                            {
                                "target_lang_word": "ithaf",
                                "target_lang_sense_clarification": "sanatsal adama"
                            },
                            {
                                "target_lang_word": "gönderme",
                                "target_lang_sense_clarification": "başka bir esere yapılan atıf"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致敬",
                                "target_lang_sense_clarification": "艺术创作中的 homage"
                            },
                            {
                                "target_lang_word": "致意",
                                "target_lang_sense_clarification": "表达敬意或引用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5942a17a-7575-3424-8a81-accc25a39ea2",
                    "sense_definition": "A payment made by one state or ruler to another as a sign of dependence or submission.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conquered tribes were forced to pay <w>tribute</w> to the emperor every year.",
                            "target_lang_translations": {
                                "ru": "Покоренные племена были вынуждены ежегодно платить <w>дань</w> императору.",
                                "tr": "Fasledilen kabileler her yıl imparatora <w>haraç</w> ödemek zorunda bırakıldı.",
                                "zh": "被征服的部落被迫每年向皇帝<w>纳贡</w>。"
                            }
                        },
                        {
                            "text": "Historical records show that the city-state sent a <w>tribute</w> of gold and silk to avoid invasion.",
                            "target_lang_translations": {
                                "ru": "Исторические записи показывают, что город-государство отправил <w>подношение</w> из золота и шелка, чтобы избежать вторжения.",
                                "tr": "Tarihi kayıtlar, şehir devletinin işgalden kaçınmak için altın ve ipekten oluşan bir <w>vergi</w> gönderdiğini gösteriyor.",
                                "zh": "历史记录显示，该城邦为了避免入侵，送去了金银丝绸作为<w>贡品</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pay tribute",
                        "annual tribute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Платеж, производимый одним государством или правителем другому в знак зависимости или подчинения.",
                        "tr": "Bir devlet veya hükümdar tarafından bağımlılık veya boyun eğme işareti olarak başka bir devlete ödenen vergi veya haraç.",
                        "zh": "一个国家或统治者为表示从属或顺从，向另一个国家或统治者支付的款项。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дань",
                                "target_lang_sense_clarification": "межгосударственная"
                            },
                            {
                                "target_lang_word": "подать",
                                "target_lang_sense_clarification": "исторический налог"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "haraç",
                                "target_lang_sense_clarification": "devletler arası vergi"
                            },
                            {
                                "target_lang_word": "vergi",
                                "target_lang_sense_clarification": "tabi olunan devlete ödenen"
                            },
                            {
                                "target_lang_word": "biat ödentisi",
                                "target_lang_sense_clarification": "boyun eğme nişanesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贡品",
                                "target_lang_sense_clarification": "进贡的物品"
                            },
                            {
                                "target_lang_word": "纳贡",
                                "target_lang_sense_clarification": "进贡的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a018152-5fe4-399c-a93d-d524d77411f0",
                    "sense_definition": "A payment made by a feudal vassal to their lord.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vassal offered a <w>tribute</w> of grain to his lord during the harvest festival.",
                            "target_lang_translations": {
                                "ru": "Вассал поднес <w>оброк</w> зерном своему господину во время праздника урожая.",
                                "tr": "Vasal, hasat festivali sırasında derebeyine tahıl şeklinde bir <w>haraç</w> sundu.",
                                "zh": "在丰收节期间，附庸向他的领主进献了<w>贡赋</w>谷物。"
                            }
                        },
                        {
                            "text": "Failure to deliver the required <w>tribute</w> could result in the loss of the vassal's land.",
                            "target_lang_translations": {
                                "ru": "Неспособность доставить требуемую <w>дань</w> могла привести к потере вассалом своей земли.",
                                "tr": "Gerekli <w>haracın</w> teslim edilmemesi, vasalın toprağını kaybetmesine neden olabilirdi.",
                                "zh": "未能按时缴纳规定的<w>贡赋</w>可能会导致附庸失去土地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "heriot"
                    ],
                    "common_phrases": [
                        "feudal tribute"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Платеж, производимый феодальным вассалом своему господину.",
                        "tr": "Feodal bir vasal tarafından derebeyine ödenen vergi veya pay.",
                        "zh": "封建附庸向其领主支付的款项或实物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дань",
                                "target_lang_sense_clarification": "феодальная"
                            },
                            {
                                "target_lang_word": "оброк",
                                "target_lang_sense_clarification": "натуральный или денежный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "haraç",
                                "target_lang_sense_clarification": "feodal vergi"
                            },
                            {
                                "target_lang_word": "feodal vergi",
                                "target_lang_sense_clarification": "derebeyine ödenen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贡赋",
                                "target_lang_sense_clarification": "封建时代的赋税"
                            },
                            {
                                "target_lang_word": "租税",
                                "target_lang_sense_clarification": "封建地租"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81766413-a530-3397-89a0-3249f245e4c8",
                    "sense_definition": "Money paid to someone, such as a criminal, to ensure protection or to prevent harm.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local shopkeepers were forced to pay a weekly <w>tribute</w> to the gang for protection.",
                            "target_lang_translations": {
                                "ru": "Местные лавочники были вынуждены еженедельно платить <w>дань</w> банде за защиту.",
                                "tr": "Yerel esnaf, koruma karşılığında çeteye haftalık <w>haraç</w> ödemeye zorlandı.",
                                "zh": "当地店主被迫每周向帮派缴纳<w>保护费</w>以求平安。"
                            }
                        },
                        {
                            "text": "The illegal <w>tribute</w> was collected by enforcers every Friday night.",
                            "target_lang_translations": {
                                "ru": "Незаконные <w>поборы</w> собирались боевиками каждую пятницу вечером.",
                                "tr": "Yasa dışı <w>koruma parası</w> her cuma gecesi fedailer tarafından toplanıyordu.",
                                "zh": "非法<w>保护费</w>由打手们在每周五晚上收取。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pay tribute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги, выплачиваемые кому-либо, например преступнику, для обеспечения защиты или предотвращения вреда.",
                        "tr": "Koruma sağlamak veya zarar görmeyi önlemek amacıyla bir suçluya veya çeteye ödenen para.",
                        "zh": "支付给某人（如罪犯）以确保安全或防止伤害的钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дань",
                                "target_lang_sense_clarification": "вымогательство"
                            },
                            {
                                "target_lang_word": "плата за защиту",
                                "target_lang_sense_clarification": "рэкет"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "haraç",
                                "target_lang_sense_clarification": "çeteye ödenen koruma parası"
                            },
                            {
                                "target_lang_word": "koruma parası",
                                "target_lang_sense_clarification": "şantaj veya tehdit karşılığı ödenen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保护费",
                                "target_lang_sense_clarification": "非法勒索的钱财"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04bc4e74-3c73-31f1-90cb-1d64b51ea254",
                    "sense_definition": "A system of payment in mining where workers receive a proportion of the value of the ore they extract.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners preferred working on <w>tribute</w> because it allowed them to earn more from rich veins.",
                            "target_lang_translations": {
                                "ru": "Шахтеры предпочитали работать на <w>трибьюте</w>, так как это позволяло им больше зарабатывать на богатых жилах.",
                                "tr": "Madenciler <w>pay usulü</w> çalışmayı tercih ettiler çünkü bu, zengin damarlardan daha fazla kazanmalarını sağlıyordu.",
                                "zh": "矿工们更喜欢<w>分成制</w>工作，因为这让他们能从富矿脉中赚取更多收入。"
                            }
                        },
                        {
                            "text": "Under the <w>tribute</w> system, the workers took on the financial risk of the excavation.",
                            "target_lang_translations": {
                                "ru": "При <w>сдельной</w> системе оплаты рабочие брали на себя финансовый риск раскопок.",
                                "tr": "<w>Yüzde usulü ödeme</w> sistemi altında, kazının finansal riskini işçiler üstleniyordu.",
                                "zh": "在<w>分成制</w>下，工人们承担了挖掘工作的财务风险。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tribute system"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Система оплаты в горнодобывающей промышленности, при которой рабочие получают долю от стоимости добытой руды.",
                        "tr": "Madencilikte, işçilerin çıkardıkları cevherin değerinin bir oranını aldığı ödeme sistemi.",
                        "zh": "采矿业中的一种支付制度，工人根据其开采矿石的价值获得一定比例的报酬。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трибьют",
                                "target_lang_sense_clarification": "система оплаты в горном деле"
                            },
                            {
                                "target_lang_word": "долевая оплата",
                                "target_lang_sense_clarification": "процент от добычи"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yüzde usulü ödeme",
                                "target_lang_sense_clarification": "madencilikte çıkarılan cevhere göre ücret"
                            },
                            {
                                "target_lang_word": "pay usulü",
                                "target_lang_sense_clarification": "üretime dayalı prim sistemi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分成制",
                                "target_lang_sense_clarification": "按比例分配收益的制度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67736023-a6cc-357f-98a9-9a256fa498a8",
                    "sense_definition": "To give or pay something as a sign of respect or submission.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet <w>tributed</w> his most precious hours to the pursuit of beauty.",
                            "target_lang_translations": {
                                "ru": "Поэт <w>посвятил</w> свои самые драгоценные часы стремлению к красоте.",
                                "tr": "Şair, en değerli saatlerini güzellik arayışına <w>adadı</w>.",
                                "zh": "诗人将他最宝贵的时光<w>奉献</w>给了对美的追求。"
                            }
                        },
                        {
                            "text": "They <w>tributed</w> their success to the guidance of their mentors.",
                            "target_lang_translations": {
                                "ru": "Они <w>приписали</w> свой успех руководству своих наставников.",
                                "tr": "Başarılarını akıl hocalarının rehberliğine <w>atfettiler</w>.",
                                "zh": "他们向导师的指导<w>致敬</w>。"
                            }
                        }
                    ],
                    "traits": [
