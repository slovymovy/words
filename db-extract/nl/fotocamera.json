                "senses": [
                    {
                        "sense_id": "e0c05c3f-1348-386f-940f-b0b2d691eff5",
                        "entry_id": "293aa8d7-7302-39fa-b8c0-23cb2a95246a",
                        "glosses": [
                            "een toestel om mee te fotograferen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c60c9d7-f83c-4b10-b3c7-5f862b03e40a",
                                "sense_id": "e0c05c3f-1348-386f-940f-b0b2d691eff5",
                                "text": "In de snelheid vergaten zij hun fotocamera mee te nemen naar dat prachtige natuurgebied."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18980e83-2fe8-470e-94ec-92080468f794",
                        "source_entry_id": "293aa8d7-7302-39fa-b8c0-23cb2a95246a",
                        "source_sense_id": "e0c05c3f-1348-386f-940f-b0b2d691eff5",
                        "source_sense_description": "een toestel om mee te fotograferen",
                        "target_lang_word": "Fotoapparat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fotoapparat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e39b5593-13cc-30b8-87d2-a6d7a309d9e1",
                                        "entry_id": "fbc189f7-74b2-3f11-9598-3e4e0ef7442a",
                                        "glosses": [
                                            "Gerät, das zum Aufnehmen von Fotos dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da80e7a3-0754-482b-abc7-f517e6697e6b",
                                                "sense_id": "e39b5593-13cc-30b8-87d2-a6d7a309d9e1",
                                                "text": "Ich habe mir einen neuen Fotoapparat gekauft."
                                            },
                                            {
                                                "example_id": "10829693-5a94-47c6-aef1-58d3e4094e03",
                                                "sense_id": "e39b5593-13cc-30b8-87d2-a6d7a309d9e1",
                                                "text": "Auf einer Safari darf ein Fotoapparat nicht fehlen."
                                            },
                                            {
                                                "example_id": "d255978d-3d2d-4222-a344-3ae300c946ea",
                                                "sense_id": "e39b5593-13cc-30b8-87d2-a6d7a309d9e1",
                                                "text": "Hast du deinen Fotoapparat eingepackt?"
                                            },
                                            {
                                                "example_id": "8f136f98-0585-405a-bf5e-b5d690b3aa7c",
                                                "sense_id": "e39b5593-13cc-30b8-87d2-a6d7a309d9e1",
                                                "text": "„Im Schrank erwarteten mich, gut verpackt, ein Tonbandgerät und ein Fotoapparat.“"
                                            },
                                            {
                                                "example_id": "cd0c45bd-abd2-4ed4-b82b-5eb806d3eb0a",
                                                "sense_id": "e39b5593-13cc-30b8-87d2-a6d7a309d9e1",
                                                "text": "„Von dem Papa gibt es keine Urlaubsfotos, weil die Mama nicht mit dem Fotoapparat umgehen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0cea2dd-7351-4c79-bc49-a78378013882",
                        "source_entry_id": "293aa8d7-7302-39fa-b8c0-23cb2a95246a",
                        "source_sense_id": "e0c05c3f-1348-386f-940f-b0b2d691eff5",
                        "source_sense_description": "een toestel om mee te fotograferen",
                        "target_lang_word": "Kamera",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kamera",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                        "entry_id": "46176da7-3677-3e08-b3a9-b6ea023f56bf",
                                        "glosses": [
                                            "Gerät zum Erstellen von Fotos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22688301-9449-4aa1-9649-f37326dc5b7f",
                                                "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                                "text": "Ich habe mir eine neue Kamera gekauft."
                                            },
                                            {
                                                "example_id": "13325692-b7b3-4b23-85da-0caefc4110c0",
                                                "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                                "text": "Heute hat fast jedes Smartphone eine integrierte Kamera."
                                            },
                                            {
                                                "example_id": "6bc6565b-8eba-4346-aeb3-13e0fb87bbde",
                                                "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                                "text": "„Auf diese Weise neu ist für den abgebrühten und mit Kameras versehenen Traveller von heute nichts mehr.“"
                                            },
                                            {
                                                "example_id": "301a302b-5a12-4fb9-9a44-f35f28246bc3",
                                                "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                                "text": "„Jan kniete sich hin, schob das Stativ zusammen und verstaute es zusammen mit der Kamera in der schwarzen Tasche, die er halb offen ließ.“"
                                            },
                                            {
                                                "example_id": "94ee9668-1738-4949-8d25-bca0a7a359bc",
                                                "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                                "text": "„Gisèle war mit ihrer Kamera da, wie mittlerweile fast immer bei künstlerischen Veranstaltungen – sie fotogrfierte berühmte Schriftsteller, Maler und dergleichen, genau wie Adrienne und Sylvia es ihr prophezeit hatten.“"
                                            },
                                            {
                                                "example_id": "3253df89-e069-4c58-bc2b-08d3e5805f14",
                                                "sense_id": "442da751-575d-36e0-bc3e-fb95cbcc473b",
                                                "text": "„Am Ausgang des Friedhofs standen die Presseleute mit Kameras und Notizblöcken, machten sich ab und zu kurze Notizen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8ab5fbde-0dbc-3fb6-a0c2-7ce0dcd02b2c",
                                        "entry_id": "46176da7-3677-3e08-b3a9-b6ea023f56bf",
                                        "glosses": [
                                            "Gerät zum Aufnehmen von Filmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96ada94d-619f-460c-85a1-4d0b621facb0",
                                                "sense_id": "8ab5fbde-0dbc-3fb6-a0c2-7ce0dcd02b2c",
                                                "text": "Das Team war mit der Kamera unterwegs, um die Tiere zu filmen."
                                            },
                                            {
                                                "example_id": "01ba6ddd-5736-46a8-965a-9a7993f00775",
                                                "sense_id": "8ab5fbde-0dbc-3fb6-a0c2-7ce0dcd02b2c",
                                                "text": "„Ich hob die kaputte Kamera auf.“"
                                            },
                                            {
                                                "example_id": "4d8821f3-6c02-4700-bd28-957b8f9fa40d",
                                                "sense_id": "8ab5fbde-0dbc-3fb6-a0c2-7ce0dcd02b2c",
                                                "text": "„Die Kamera zog auf, und die Moderatorin machte eine kurze Pause.“"
                                            },
                                            {
                                                "example_id": "e836d6fd-d803-4f9f-b694-0e008f7d7e91",
                                                "sense_id": "8ab5fbde-0dbc-3fb6-a0c2-7ce0dcd02b2c",
                                                "text": "„Die Kamera schwenkte über die Menge und kippte dann himmelwärts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "170fc6e3-d154-4dd6-a8a9-71ff08c29572",
                        "source_entry_id": "293aa8d7-7302-39fa-b8c0-23cb2a95246a",
                        "source_sense_id": "e0c05c3f-1348-386f-940f-b0b2d691eff5",
                        "source_sense_description": "een toestel om mee te fotograferen",
                        "target_lang_word": "camera",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camera",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43bb3a97-dd2a-38a3-a1c3-8c7e1b7e5923",
                                        "entry_id": "2a72c291-ba2a-38d5-b996-6d025a85a1c3",
                                        "glosses": [
                                            "A device for taking still or moving pictures or photographs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6274b0bf-941b-465e-b6f6-9e9c2e0b4b37",
                                                "sense_id": "43bb3a97-dd2a-38a3-a1c3-8c7e1b7e5923",
                                                "text": "The single-imaging optic of the mammalian eye offers some distinct visual advantages. Such lenses can take in photons from a wide range of angles, increasing light sensitivity. They also have high spatial resolution, resolving incoming images in minute detail. It’s therefore not surprising that most cameras mimic this arrangement."
                                            },
                                            {
                                                "example_id": "990e525e-3067-4cae-8401-70c573e52e4e",
                                                "sense_id": "43bb3a97-dd2a-38a3-a1c3-8c7e1b7e5923",
                                                "text": "Glance up while strolling through parts of downtown Hong Kong and, chances are, you’ll notice the glassy black lens of a surveillance camera trained on the city’s crowded streets.\nAnd that sight will become more common in the coming years, as the city’s police pursue an ambitious campaign to install thousands of cameras to elevate their surveillance capabilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89c62c8f-8df8-3bb8-9aca-168f74f2bee5",
                                        "entry_id": "2a72c291-ba2a-38d5-b996-6d025a85a1c3",
                                        "glosses": [
                                            "The viewpoint in a three-dimensional game or simulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "629b52a9-1aa6-4e4e-a445-53e9d9197ee7",
                                                "sense_id": "89c62c8f-8df8-3bb8-9aca-168f74f2bee5",
                                                "text": "If you're building a third-person game with enclosed or tight spaces, try to figure out up front what camera problems you will likely encounter. Use this identification process to influence the early building process."
                                            },
                                            {
                                                "example_id": "ec28b242-d2c5-49a7-a989-44d9dd530f87",
                                                "sense_id": "89c62c8f-8df8-3bb8-9aca-168f74f2bee5",
                                                "text": "I'm talking about the way the camera flies up above the skater when you leap into the air. No one had done it before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f872c09-e152-359b-80a6-41d91b5e5c1b",
                                        "entry_id": "2a72c291-ba2a-38d5-b996-6d025a85a1c3",
                                        "glosses": [
                                            "A vaulted room."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f7d9f24-09f2-3bc9-9a44-0cfd81f15a77",
                                        "entry_id": "2a72c291-ba2a-38d5-b996-6d025a85a1c3",
                                        "glosses": [
                                            "A judge's private chamber, where cases may be heard in camera."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "113bcc83-19ea-4add-961f-e709b4023ecd",
                        "source_entry_id": "293aa8d7-7302-39fa-b8c0-23cb2a95246a",
                        "source_sense_id": "e0c05c3f-1348-386f-940f-b0b2d691eff5",
                        "source_sense_description": "een toestel om mee te fotograferen",
                        "target_lang_word": "appareil photo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appareil photo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ce483ad-d6b7-3dcf-ba33-b211ef5ea289",
                                        "entry_id": "903f755a-eca1-3e73-8857-f16e2be76ef2",
                                        "glosses": [
                                            "Instrument permettant de prendre des photographies grâce à l’impression de la lumière sur une pellicule à base de nitrate d’argent ou par numérisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05be7331-fe73-4863-9188-94ef7c7f24a3",
                                                "sense_id": "8ce483ad-d6b7-3dcf-ba33-b211ef5ea289",
                                                "text": "Il ne faut pas confondre l’appareil photo et la caméra, cette dernière étant plutôt destinée à l'enregistrement vidéo."
                                            },
                                            {
                                                "example_id": "aeb28096-1ba6-4aad-a7e4-515450d0a991",
                                                "sense_id": "8ce483ad-d6b7-3dcf-ba33-b211ef5ea289",
                                                "text": "Voici le récit complet : En rentrant tard du travail la veille, Quinz a attrapé l’appareil photo Zenit pendu par la bandoulière à un clou derrière la porte d'entrée, l'a ouvert, a marmonné quelque chose et l'a refermé d'un coup sec avant de le raccrocher."
                                            },
                                            {
                                                "example_id": "6668922e-1b60-4937-8779-a91aae3c2a54",
                                                "sense_id": "8ce483ad-d6b7-3dcf-ba33-b211ef5ea289",
                                                "text": "Anna portait aussi un appareil photo Instamatic suspendu à son cou, tandis qu'un grand sac de toile pendait à l'épaule de Nadine."
                                            },
                                            {
                                                "example_id": "20e6e49f-79dc-4e36-b807-5aab2b6662b1",
                                                "sense_id": "8ce483ad-d6b7-3dcf-ba33-b211ef5ea289",
                                                "text": "La plupart des appareils photo numériques disposent d'un grand écran d'une bonne résolution, grâce auquel il est plus facile de rechercher le motif et de contrôler l'image ; un tel écran est une invitation à faire des essais et expériences."
                                            },
                                            {
                                                "example_id": "596d4e77-f938-4e6c-8b13-e4744fa902c6",
                                                "sense_id": "8ce483ad-d6b7-3dcf-ba33-b211ef5ea289",
                                                "text": "Un jour, à l'atelier, nous n'avions pas assez d’appareils photos. Quand le besoin s'est vraiment fait sentir, j'ai prévenu les jeunes que j'allais acheter des appareils très prochainement, dès que j'irai à Paris. Ça les a fait rire : “Tu vas monter à Paris pour acheter des appareils photos ? Mais tu es fada !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
