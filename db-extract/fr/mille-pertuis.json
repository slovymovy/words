        "fr-extract.jsonl": [
            {
                "entry_id": "53d47721-cd43-37e7-943c-e320db3a34fc",
                "word": "mille-pertuis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "06d1eaa7-cdbc-3474-89f3-d79437cc6d3f",
                        "entry_id": "53d47721-cd43-37e7-943c-e320db3a34fc",
                        "glosses": [
                            "Variante orthographique de millepertuis."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "27b11417-ad9b-4ac1-8a8d-7e85f8999f2a",
                                "sense_id": "06d1eaa7-cdbc-3474-89f3-d79437cc6d3f",
                                "text": "elles sont un peu acerbes au goût, d’un verd gai & un peu foncé ; luisantes & percées d’une infinité de petits trous comme le mille-pertuis, ou plûtôt transparentes, quand on les regarde à la lumiere."
                            },
                            {
                                "example_id": "25aa1662-830c-404f-b6cd-f2f8c7c5af63",
                                "sense_id": "06d1eaa7-cdbc-3474-89f3-d79437cc6d3f",
                                "text": "on en fait un liniment avec l’huile de mille-pertuis, contre les rhûmatismes & la goutte."
                            },
                            {
                                "example_id": "e5f04664-73aa-472f-ae59-d5560e9d0036",
                                "sense_id": "06d1eaa7-cdbc-3474-89f3-d79437cc6d3f",
                                "text": "ces herbes sont les feuilles de pervenche, de sanicle, de véronique, de bugle, de pié-de-lion, de mille-pertuis, de langue de cerf, de capillaire, de pulmonaire, d’armoise, de bétoine, de verveine, de scrophulaire, d’aigre-moine, de petite centaurée, de piloselle, &c."
                            },
                            {
                                "example_id": "a4eea557-c48a-497c-94b5-a02352b01f44",
                                "sense_id": "06d1eaa7-cdbc-3474-89f3-d79437cc6d3f",
                                "text": "les feuilles sont ou minces ou deliées, comme celles du mille-pertuis ; ou épaisses, comme celles du pourpier ; ou charnues, comme celles de plusieurs sortes de joubarbe ; ou drapées, comme celles du bouillon-blanc."
                            },
                            {
                                "example_id": "35b54b27-811b-4c0f-904e-e5cef309d959",
                                "sense_id": "06d1eaa7-cdbc-3474-89f3-d79437cc6d3f",
                                "text": "On la fait infuser au soleil dans de l’huile d’olive, & on passe ensuite le tout par un linge avec une forte expression ; cette huile peut suppléer à celle de mille-pertuis."
                            },
                            {
                                "example_id": "59f9c66b-1a4d-4d78-a52b-4b04690fda76",
                                "sense_id": "06d1eaa7-cdbc-3474-89f3-d79437cc6d3f",
                                "text": "Ses fleurs sont jaunes ; elles ressemblent à celles de mille-pertuis ; mais elles sont plus petites."
                            },
                            {
                                "example_id": "97ad04d4-3f57-4fd9-9cf2-324cc72bb087",
                                "sense_id": "06d1eaa7-cdbc-3474-89f3-d79437cc6d3f",
                                "text": "Quant à l’huile dans laquelle on a mis, pendant plusieurs jours, digérer les feuilles, les fleurs & les semences de mille-pertuis, elle a les mêmes propriétés que l’huile d’olive."
                            }
                        ]
                    }
                ],
