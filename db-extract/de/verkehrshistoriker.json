                "senses": [
                    {
                        "sense_id": "5fe0fd5e-761d-307e-a1b8-e199a3e9201b",
                        "entry_id": "56688d39-1de3-3736-a151-701f2fb9f34c",
                        "glosses": [
                            "Historiker mit dem Fachgebiet Verkehrsgeschichte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "440ea80f-dab8-42fb-99ed-19537d656e88",
                                "sense_id": "5fe0fd5e-761d-307e-a1b8-e199a3e9201b",
                                "text": "„Die verkehrspolitischen Akteure, die übrigen Zeitgenossen und selbst die späteren Generationen der Verkehrshistoriker nahmen die Veränderung der Nachfragestrukturen des Verkehrs nur mit Verzögerung wahr.“"
                            },
                            {
                                "example_id": "8bd829bb-fb09-4a3f-a697-4128a777d7dd",
                                "sense_id": "5fe0fd5e-761d-307e-a1b8-e199a3e9201b",
                                "text": "„Während der Verkehrshistoriker in derRegel die Verbesserung der Flußsysteme (Schiffbarkeit) sowie die Anlage von Kanälen als die Lösungen des neuzeitlichen Transportsystems (Beschleunigung und Verbilligung des Transports) ansieht, waren Flüsse und Kanäle für den Großteil der (ländlichen) Bevölkerung in erster Linie Bestandteil der Landbe- und entwässerung sowie eine Energiequelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
