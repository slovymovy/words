                        {
                            "text": "Le journaliste a rapporté fidèlement les <w>propos</w> du ministre lors de la conférence.",
                            "target_lang_translations": {
                                "en": "The journalist faithfully reported the minister's <w>remarks</w> at the conference.",
                                "ru": "Журналист точно передал <w>высказывания</w> министра на конференции.",
                                "nl": "De journalist heeft de <w>uitlatingen</w> van de minister tijdens de conferentie getrouw weergegeven.",
                                "de": "Der Journalist hat die <w>Äußerungen</w> des Ministers auf der Konferenz getreu wiedergegeben.",
                                "pl": "Dziennikarz wiernie zrelacjonował <w>wypowiedzi</w> ministra podczas konferencji.",
                                "it": "Il giornalista ha riportato fedelmente le <w>dichiarazioni</w> del ministro durante la conferenza.",
                                "cs": "Novinář věrně zopakoval <w>výroky</w> ministra na konferenci.",
                                "tr": "Gazeteci, konferansta bakanın <w>sözlerini</w> sadakatle aktardı.",
                                "es": "El periodista relató fielmente las <w>declaraciones</w> del ministro durante la conferencia.",
                                "zh": "记者如实转述了部长在会议上的<w>言论</w>。"
                            }
                        },
                        {
                            "text": "Tous les collègues ont été surpris par les <w>propos</w> tenus lors de la réunion.",
                            "target_lang_translations": {
                                "en": "All the colleagues were surprised by the <w>remarks</w> made at the meeting.",
                                "ru": "Все коллеги были удивлены <w>высказываниями</w>, прозвучавшими на совещании.",
                                "nl": "Alle collega's waren verrast door de <w>opmerkingen</w> die tijdens de vergadering werden gemaakt.",
                                "de": "Alle Kollegen waren von den <w>Äußerungen</w> überrascht, die bei der Besprechung gefallen waren.",
                                "pl": "Wszyscy koledzy byli zaskoczeni <w>wypowiedziami</w>, które padły podczas spotkania.",
                                "it": "Tutti i colleghi sono rimasti sorpresi dalle <w>affermazioni</w> fatte durante la riunione.",
                                "cs": "Všichni kolegové byli překvapeni <w>poznámkami</w>, které padly na schůzi.",
                                "tr": "Tüm meslektaşlar toplantıda söylenen <w>sözlerden</w> şaşırmıştı.",
                                "es": "Todos los colegas quedaron sorprendidos por los <w>comentarios</w> hechos durante la reunión.",
                                "zh": "所有同事都对会议上的<w>发言</w>感到惊讶。"
                            }
                        }
