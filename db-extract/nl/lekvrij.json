                "senses": [
                    {
                        "sense_id": "771b69ba-8cf5-3ae6-809f-573b55de58bc",
                        "entry_id": "aec9a4e3-2b84-3efa-8a6e-f63def32f489",
                        "glosses": [
                            "zonder dat er water of andere vloeistof uit kan gaan; helemaal afgesloten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06a4444d-4cb6-4e00-a4e0-998371c01cc9",
                                "sense_id": "771b69ba-8cf5-3ae6-809f-573b55de58bc",
                                "text": "Sinds 1993 is het verboden om asbesthoudende producten en materialen te gebruiken. Ook zijn er strenge regels en voorschriften verbonden aan het verwijderen van asbest. Deze moeten volgens de provincie Utrecht strikt worden nageleefd, anders is een lekvrije asbestverwijdering niet haalbaar."
                            },
                            {
                                "example_id": "229874c5-b6f9-4c94-9ff7-fffa35a73153",
                                "sense_id": "771b69ba-8cf5-3ae6-809f-573b55de58bc",
                                "text": "5 kilometer van de in totaal 30 kilometer nieuwe transportleiding van AkzoNobel kan nog niet gebruikt worden. Tijdens testen in december, om aan te tonen dat de leidingen voldoende sterk en lekdicht zijn, kwamen diverse defecten aan het licht. In eerste instantie werd geconstateerd dat op circa 15 plaatsen de aansluitingen tussen de buiselementen lekte. Uit onderzoek bleek vervolgens dat de rubber afdichtingsringen, die de buiselementen lekvrij met elkaar moeten verbinden, waren verschoven."
                            }
                        ]
                    }
