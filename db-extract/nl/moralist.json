                "senses": [
                    {
                        "sense_id": "86aa2d4a-8d69-3006-8b00-f8fff8ceee65",
                        "entry_id": "a0d95971-aac7-35db-98bf-996914ea07b2",
                        "glosses": [
                            "iemand die vanuit een morele overtuiging kritiek levert op andere mensen"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "ef8f65b8-4d40-4351-b0c6-a6cf9f8bdd54",
                                "sense_id": "86aa2d4a-8d69-3006-8b00-f8fff8ceee65",
                                "text": "De geest van die wet was dat euthanasie toepassen niet meer strafbaar was mits een voorgeschreven procedure gevolgd werd. Maar heel wat mensen hebben dit vertaald naar ‘het recht om euthanasie te vragen’. Het verwondert mij dat ook een erudiet moralist als Ignaas Devisch deze uitschuiver maakt."
                            },
                            {
                                "example_id": "49eb39d8-9e2b-47ca-bce4-8004d9e04dba",
                                "sense_id": "86aa2d4a-8d69-3006-8b00-f8fff8ceee65",
                                "text": "Seks met dieren is verwerpelijk. Voor die stelling hoeft men geen moralist te zijn. Er zijn gelukkig nog steeds normen en waarden die door een grote meerderheid van de mensheid worden gedeeld. En daarbij hoort het veroordelen van seks met dieren."
                            }
                        ]
                    },
