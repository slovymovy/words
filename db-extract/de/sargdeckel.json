                "senses": [
                    {
                        "sense_id": "8fa3729b-abe2-3737-bd70-29a60ae78738",
                        "entry_id": "e473ae1d-2203-3b1b-b001-cc90da4a23ee",
                        "glosses": [
                            "Vorrichtung, mit der ein Sarg verschlossen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1026b35b-04cc-4943-9409-b9259b69bf06",
                                "sense_id": "8fa3729b-abe2-3737-bd70-29a60ae78738",
                                "text": "Auf dem Sargdeckel ist das Wappen der Familie abgebildet."
                            },
                            {
                                "example_id": "c3312661-c57a-404e-b97a-94f9d4b5f0a5",
                                "sense_id": "8fa3729b-abe2-3737-bd70-29a60ae78738",
                                "text": "„Eigil hörte, wie die Sargdeckel knarrten, die der Magister aufbrach, und wenn er in einen nationalistisch klaffenden Färöer-Schädel blickte, dröhnten Schimpfworte durch die Hallen unter der Pissluke.“"
                            },
                            {
                                "example_id": "9b0e4eb4-cc54-41be-81f2-77bfe8f6dac3",
                                "sense_id": "8fa3729b-abe2-3737-bd70-29a60ae78738",
                                "text": "„Henni hatte die ganze Zeremonie tränenlos überstanden, aber als sie die Schüppe nahm und die Erde mit diesem hohlen Klopfen auf den Sargdeckel aufschlug, weinte sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a56eea90-839e-376d-9779-1e008cd563a8",
                        "entry_id": "e473ae1d-2203-3b1b-b001-cc90da4a23ee",
                        "glosses": [
                            "sich plötzlich lösender Gesteinskörper"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "3f1cdd1c-7852-4bfe-b000-2deff1b3de6f",
                                "sense_id": "a56eea90-839e-376d-9779-1e008cd563a8",
                                "text": "Sargdeckel sind bei Bergleuten gefürchtet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
