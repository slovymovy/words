                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cd3d406-a533-4e1e-8e32-03487c795450",
                        "source_entry_id": "68741535-3e68-35c8-b9f1-d90657c39538",
                        "source_sense_id": "7cfd62d2-a2b5-3cb1-a45b-769db111135c",
                        "source_sense_description": "regelmatige, meestal maandelijkse beloning voor werk verricht in een werkverband",
                        "target_lang_word": "salaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c44b3f1-997c-36f7-a325-afc96e58965d",
                                        "entry_id": "aa2a7c0c-43de-3eb9-868a-81387e2bb9a1",
                                        "glosses": [
                                            "Rémunération pour un travail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54373969-27e1-47d7-be86-5f6978479349",
                                                "sense_id": "7c44b3f1-997c-36f7-a325-afc96e58965d",
                                                "text": "L'emploi de ces salaires bien ou mal distribués, contribue beaucoup à la prospérité ou à la dégradation d'un Royaume, à la régularité ou au dérèglement des mœurs d'une Nation, & à l'accroissement ou à la diminution de la population."
                                            },
                                            {
                                                "example_id": "6d1b2138-0b29-4da2-802f-c3b3ddbac0a5",
                                                "sense_id": "7c44b3f1-997c-36f7-a325-afc96e58965d",
                                                "text": "Je découvre ainsi que ce métier, jadis excellent, a beaucoup perdu, la machine fait une concurrence acharnée, les salaires sont bien réduits."
                                            },
                                            {
                                                "example_id": "05eb2fe6-e0e9-4035-acf9-819216bd839c",
                                                "sense_id": "7c44b3f1-997c-36f7-a325-afc96e58965d",
                                                "text": "Il sourit en apprenant que nous venons de Roanne. Roanne est justement la ville concurrente de Thann pour les tissages et les impressions d'étoffe. Roanne a fait baisser ici les salaires ; mais il ne nous en veut pas."
                                            },
                                            {
                                                "example_id": "38aeb11e-004d-4c95-8716-8781874ae701",
                                                "sense_id": "7c44b3f1-997c-36f7-a325-afc96e58965d",
                                                "text": "Démentirez-vous ce fait désolant que, dans certaines fermes, l'ouvrier agricole touche une partie de son pauvre salaire sous la forme de bouteilles de blanche, c'est à dire d'eau-de-vie ?"
                                            },
                                            {
                                                "example_id": "4cc2cce7-4d5a-4c30-b4ed-d24d2c5c68e4",
                                                "sense_id": "7c44b3f1-997c-36f7-a325-afc96e58965d",
                                                "text": "Par exemple il soutenait, et toujours colérique­ment, que tout est guerre, que la lutte pour le salaire est guerre, que toute rivalité est guerre, et qu'ainsi la guerre sera toujours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "676f1eeb-aef8-3e02-b4de-b8b271a97f97",
                                        "entry_id": "aa2a7c0c-43de-3eb9-868a-81387e2bb9a1",
                                        "glosses": [
                                            "Récompense d’un service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "527fad8e-f9ab-4148-b3e0-6377bafffac3",
                                                "sense_id": "676f1eeb-aef8-3e02-b4de-b8b271a97f97",
                                                "text": "Toute peine mérite salaire."
                                            },
                                            {
                                                "example_id": "c447afa5-f5fc-4ab3-81b1-d38ceeeaccf0",
                                                "sense_id": "676f1eeb-aef8-3e02-b4de-b8b271a97f97",
                                                "text": "Est-ce là le salaire des services que je lui ai rendus ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41458485-6675-35a4-8d04-bbf249a99f7b",
                                        "entry_id": "aa2a7c0c-43de-3eb9-868a-81387e2bb9a1",
                                        "glosses": [
                                            "Châtiment, punition que mérite une mauvaise action."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54f5dd47-a5e9-415d-aaf1-2cc7b2a81355",
                                                "sense_id": "41458485-6675-35a4-8d04-bbf249a99f7b",
                                                "text": "Il avait fait une méchante action, il en a reçu le salaire."
                                            },
                                            {
                                                "example_id": "04a31447-320c-41dc-a1ba-16214f353a68",
                                                "sense_id": "41458485-6675-35a4-8d04-bbf249a99f7b",
                                                "text": "Il a eu le salaire de ses crimes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3793c418-ed91-4cbc-867f-4302d314eb9a",
                        "source_entry_id": "68741535-3e68-35c8-b9f1-d90657c39538",
                        "source_sense_id": "7cfd62d2-a2b5-3cb1-a45b-769db111135c",
