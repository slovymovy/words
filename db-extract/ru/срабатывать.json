                "senses": [
                    {
                        "sense_id": "1df2d7e0-4ec8-3603-8a4a-48b8318cede6",
                        "entry_id": "072871bc-ddc6-3d51-8973-7c6e3be6ac2a",
                        "glosses": [
                            "производить нужное действие, движение; действовать в соответствующей ситуации определённым образом, так, как было задумано"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e793fc4e-978f-4f1e-b61f-4ed48f09a7ba",
                                "sense_id": "1df2d7e0-4ec8-3603-8a4a-48b8318cede6",
                                "text": "Известно, что тут срабатывает рефлекс ― рука отдергивается."
                            },
                            {
                                "example_id": "489134e0-2c66-468a-a969-76c23cde5a80",
                                "sense_id": "1df2d7e0-4ec8-3603-8a4a-48b8318cede6",
                                "text": "Все канатно-ленточное хозяйство работает, как заводное, и автоматика срабатывает."
                            }
                        ]
                    }
                ],
