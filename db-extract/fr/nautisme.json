                    {
                        "sense_id": "e57d3d26-fc74-3655-a91d-aea9bf4218dc",
                        "entry_id": "ddf39715-d5e9-3a02-bc22-d4220e3af7df",
                        "glosses": [
                            "Ensemble des sports nautiques et en particulier la navigation de plaisance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59e60655-2a59-40bd-a1f1-7bfbd3d5ae20",
                                "sense_id": "e57d3d26-fc74-3655-a91d-aea9bf4218dc",
                                "text": "On peut y pratiquer le nautisme et le kayak, mais aussi le golf."
                            },
                            {
                                "example_id": "94506c82-eef7-43a6-8619-88e598aa15c3",
                                "sense_id": "e57d3d26-fc74-3655-a91d-aea9bf4218dc",
                                "text": "Le nautisme génère de nombreux effets économiques induits : construction, location, vente et entretien de bateaux, traiteur pour les bateaux a passagers, restauration, stages (voile, plongée, ski nautique), haltes (commerces et services de proximité), ports de plaisance, fêtes nautiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1d46b5e-74ed-4b61-ad32-5c1b0f868438",
                        "source_entry_id": "ddf39715-d5e9-3a02-bc22-d4220e3af7df",
                        "source_sense_id": "e57d3d26-fc74-3655-a91d-aea9bf4218dc",
                        "target_lang_word": "Wassersport",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
