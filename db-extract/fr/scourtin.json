                "senses": [
                    {
                        "sense_id": "1ba23338-01b4-3e54-9efa-c165b9d515c8",
                        "entry_id": "cdeb7bed-c53d-3b01-b445-f21e61c7fa4b",
                        "glosses": [
                            "Un des filtres circulaires, en fibres végétales ou artificielles, d’un moulin à huile servant à extraire l’huile d'olive par pression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a321613d-6d43-4b25-bcdc-934db25c467d",
                                "sense_id": "1ba23338-01b4-3e54-9efa-c165b9d515c8",
                                "text": "Le dernier artisan, tisserand manuel de scourtins, ces sacs plats utilisés dans les vieux moulins de pierre et de bois pour presser la pâte d’olive, se trouverait à Ighil-Ali."
                            },
                            {
                                "example_id": "920b1071-1cec-4914-9490-b29c7f63b450",
                                "sense_id": "1ba23338-01b4-3e54-9efa-c165b9d515c8",
                                "text": "Alors qu’il écoute la note continue que lui joue le combiné du téléphone, Ali croit sentir l’odeur de la pulpe d’olive qui dégorge les dernières gouttes de son huile dans le ventre arrondi des scourtins en alfa."
                            },
                            {
                                "example_id": "d99b6d00-7c27-46c7-9757-f03adeb63d89",
                                "sense_id": "1ba23338-01b4-3e54-9efa-c165b9d515c8",
                                "text": "Le scourtin (du provençal « escourtin », qui signifie cabas, panier plat) était en effet déjà utilisé par les Grecs, sept siècles avant Jésus-Christ, comme filtre pour extraire l'huile des olives après le broyage de ces dernières."
                            }
                        ]
                    }
