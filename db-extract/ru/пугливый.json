                    },
                    {
                        "sense_id": "75223a0f-dc3a-3cf9-8ea0-e27b1e7ac1fd",
                        "entry_id": "15b68d58-0bb7-3ca7-93cb-158b78f40bdc",
                        "glosses": [
                            "свойственный робкому, боязливому человеку или животному"
                        ],
                        "tags": [],
