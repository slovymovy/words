                        "glosses": [
                            "Chant funèbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec4e36c4-938b-488f-8ad1-828e9c7e5166",
                                "sense_id": "62202044-63b4-3bee-b4c1-428a624874e2",
                                "text": "Ce fut une lamentation, une myriologie, un concert de psaumes lugubres, un Super flumina Babylonis, un Stabat mater dolorosa, une grande symphonie en ut, avec chœurs, exécutée par tout cet orchestre d’orateurs qui garnit les premiers bancs de la Chambre, et rend de si beaux sons dans les grands jours."
                            },
                            {
                                "example_id": "87827c70-0d1c-4944-905f-da3a7279feb7",
                                "sense_id": "62202044-63b4-3bee-b4c1-428a624874e2",
                                "text": "Le cinquième, représentant Florizel de Bordeaux, n’obtint pas de myriologie d’Agostin, mais un simple regret mêlé d’espérance."
                            }
                        ]
                    }
