                        "entry_id": "4d2a8ebd-8790-326e-9e12-5988603f703a",
                        "glosses": [
                            "A location referred to when issuing watches, warnings, or advisories for specific areas."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "29409fd5-e867-378c-9903-cb7ef54428f9",
                        "entry_id": "4d2a8ebd-8790-326e-9e12-5988603f703a",
                        "glosses": [
                            "The point where surface water waves are breaking in, e.g., oceans or lakes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "72435001-7c9d-3ca6-8257-c0195499b473",
                        "entry_id": "4d2a8ebd-8790-326e-9e12-5988603f703a",
                        "glosses": [
                            "A viewport width at which a web page is programmed to adjust the properties (such as position, size, or visibility) of certain elements within the page."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9896d8b-5f0b-41f1-a4a9-28f3a72ef5b3",
                                "sense_id": "72435001-7c9d-3ca6-8257-c0195499b473",
                                "text": "If a device's screen width is equal to, or less than, the screen width defined at the breakpoint, it will have the related CSS applied to it. You sometimes want to set breakpoints to match particular device screen widths, but I have found that what is most important is simply that the layout remains usable as it gets smaller."
                            }
                        ]
                    }
