                        "examples": [
                            {
                                "example_id": "3c2613e0-26ea-47b1-9956-eff35b432b42",
                                "sense_id": "5e32dc77-d2bd-32fb-a188-ce780872aa0b",
                                "text": "Ik schat haar begin dertig en ik vraag me af wat zo iemand op een gezamenlijk wandelreis te zoeken heeft. Moet dat meisje niet gewoon naar een Lowlands? 'Ik heet Bibi,' zegt ze tegen niemand in het bijzonder."
                            },
                            {
                                "example_id": "0dc81a08-fbe7-44ff-9e08-be1e98ccb932",
                                "sense_id": "5e32dc77-d2bd-32fb-a188-ce780872aa0b",
                                "text": "Wanneer ik de ontbijtzaal binnenkom, zie ik Bibi met een kop heet citroenwater in haar handen staan terwijl ze uit het raam kijkt."
                            }
                        ]
                    }
