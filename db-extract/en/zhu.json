                        "sense_id": "69db8561-ae60-39f1-b3ad-2dfe0a7fff2d",
                        "entry_id": "4d829c4c-38a6-38f1-b880-2494b6cd77d7",
                        "glosses": [
                            "An ancient Chinese unit of weight, notionally equivalent to 100 millet seeds or 1/24 of the liang/tael/Chinese ounce, chiefly used in denominating small coins in ancient and early imperial China."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e855f929-5a9f-474c-8d1c-2b636a6a474d",
                                "sense_id": "69db8561-ae60-39f1-b3ad-2dfe0a7fff2d",
                                "text": "Modern research showed the correct number of millet seeds greatly exceeded surviving examples of the zhu in weight, until one tried growing older millet strains for several generations without modern agrochemicals. By the third year, his seeds produced a zhu within about 5% of its known historical value."
                            }
                        ]
                    }
                ],
