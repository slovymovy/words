                "translations": [
                    {
                        "translation_id": "8806e4cd-45c3-4d92-81c0-4bcaa2af7ef7",
                        "source_entry_id": "47b03967-4732-3513-9ad3-83cbb5637810",
                        "target_lang_word": "rétrograder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétrograder",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37646921-4f35-35e8-a1fe-61035e96f9ba",
                                        "entry_id": "f24ea0a5-1632-3182-93af-93e05ab7c854",
                                        "glosses": [
                                            "Retourner en arrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f9cb48d-63af-4e5a-bcec-4fa52430cbfe",
                                                "sense_id": "37646921-4f35-35e8-a1fe-61035e96f9ba",
                                                "text": "Il faut que notre histoire rétrograde de quelques pages, afin d’instruire le lecteur de certains faits importants."
                                            },
                                            {
                                                "example_id": "c4b66249-2a37-4a43-aa3a-20894a63d465",
                                                "sense_id": "37646921-4f35-35e8-a1fe-61035e96f9ba",
                                                "text": "Cette marche avait pour but de s'assurer si l'ennemi, signalé à Vouziers et à Grandpré, ne rétrogradait pas vers Stenay ou s'il continuait sa marche sur Paris."
                                            },
                                            {
                                                "example_id": "34f61c86-c9ec-4915-970a-40b572db9489",
                                                "sense_id": "37646921-4f35-35e8-a1fe-61035e96f9ba",
                                                "text": "Je rétrograde par la pensée au moment où je pris la première cuillerée de thé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cee5a16-16d1-33ed-9068-e866be11423b",
                                        "entry_id": "f24ea0a5-1632-3182-93af-93e05ab7c854",
                                        "glosses": [
                                            "Paraître aller en sens inverse des signes du zodiaque, en parlant des corps célestes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed246398-3daa-4e4e-a18d-4f2edac8df1f",
                                                "sense_id": "1cee5a16-16d1-33ed-9068-e866be11423b",
                                                "text": "Mercure commençait à rétrograder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dde0d23-f1c6-3772-b89c-a7c076375b77",
                                        "entry_id": "f24ea0a5-1632-3182-93af-93e05ab7c854",
                                        "glosses": [
                                            "Passer à une vitesse inférieure."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "235ab90a-b6b6-36d6-8e18-de671ca2dc95",
                                        "entry_id": "f24ea0a5-1632-3182-93af-93e05ab7c854",
                                        "glosses": [
                                            "Perdre la progression antérieure, diminuer d'intensité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ec13eee-1d72-468f-9910-8587351d7600",
                                                "sense_id": "235ab90a-b6b6-36d6-8e18-de671ca2dc95",
                                                "text": "Il avait fait quelques progrès, maintenant il rétrograde."
                                            },
                                            {
                                                "example_id": "edf578d7-d19a-4af8-8dde-bc2d07926fe9",
                                                "sense_id": "235ab90a-b6b6-36d6-8e18-de671ca2dc95",
                                                "text": "Marie Silvert, se voyant reconnue par le maître de la maison, essaya de rétrograder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e631efe1-93c1-361c-97e1-c39f3d707232",
                                        "entry_id": "f24ea0a5-1632-3182-93af-93e05ab7c854",
                                        "glosses": [
                                            "Affecter à un poste ou à un grade inférieur."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29e59cfa-c0df-499d-bce3-a2c6c92aa2c7",
                                                "sense_id": "e631efe1-93c1-361c-97e1-c39f3d707232",
                                                "text": "Signe Krach est devenue Première ministre, plus jeune que Birgitte Nyborg, rétrogradée, elle, ministre des Affaires Étrangères."
                                            }
                                        ]
                                    }
