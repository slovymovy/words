                        "sense_id": "397745c1-4df3-394b-a02c-5c3a6d4280ae",
                        "entry_id": "5b8cf9b3-0a84-3d78-a46d-00cc5172bc9a",
                        "glosses": [
                            "urządzenie do treningu, na którym nogi imitują chód, jazdę na nartach lub jazdę na rowerze, a ręce poruszają naprzemiennie uchwytami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66da7907-159e-49d7-9906-31c755fa2f05",
                                "sense_id": "397745c1-4df3-394b-a02c-5c3a6d4280ae",
                                "text": "Dzięki płynności i eliptycznemu przebiegowi ruchów trening na orbitreku nie jest szkodliwy dla stawów"
                            },
                            {
                                "example_id": "9c5e8063-406f-49ab-a30b-563494ffeef2",
                                "sense_id": "397745c1-4df3-394b-a02c-5c3a6d4280ae",
                                "text": "Ćwiczenia na orbitreku angażują dolne i górne partie ciała."
                            }
                        ],
