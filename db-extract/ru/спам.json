                ],
                "senses": [
                    {
                        "sense_id": "35d17a7b-63fe-363e-ac51-c1ea731a237b",
                        "entry_id": "5471cdc1-2453-3e6a-8db2-4f086a8a8cff",
                        "glosses": [
                            "собир., комп. электронные сообщения (обычно реклама), массово рассылаемые людям, не дававшим согласие на их получение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03903dd1-752b-4824-8f0c-6a2c7e9b6939",
                                "sense_id": "35d17a7b-63fe-363e-ac51-c1ea731a237b",
                                "text": "Первоначально я принял его за спам и хотел стереть."
                            },
                            {
                                "example_id": "311563ef-3933-471c-8804-5ee3bdfa22a9",
                                "sense_id": "35d17a7b-63fe-363e-ac51-c1ea731a237b",
                                "text": "Учитывая, что спам рассылается по миллионам адресов в Интернете и при этом желание адресата не спрашивается, такие действия можно расценить как вторжение в частную жизнь владельцев e-mail."
                            }
                        ]
                    },
                    {
                        "sense_id": "972ad550-0b8c-3ea4-a900-0b56edef039f",
                        "entry_id": "5471cdc1-2453-3e6a-8db2-4f086a8a8cff",
                        "glosses": [
                            "собир. жарг. аналогичная рекламная бумажная корреспонденция, обзвон по телефону, засорение результатов интернет-поиска и т.д."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a887e3b3-cc20-4e9c-b39a-55aebd727ab7",
                                "sense_id": "972ad550-0b8c-3ea4-a900-0b56edef039f",
                                "text": "Вскоре она подходит и к нам, протягивает несколько бумажек, а мы, улыбаясь, говорим: «Нам спам не нужен»."
                            },
                            {
                                "example_id": "5c57f725-e80d-4c6f-abb4-e552f0e218b1",
                                "sense_id": "972ad550-0b8c-3ea4-a900-0b56edef039f",
                                "text": "Разумеется, от навязчивого телефонного спама страдают не только отдельные граждане, но и целые фирмы."
                            }
                        ]
                    },
                    {
                        "sense_id": "cad7c469-70f9-3e3b-9e3d-659cb3ddbec5",
                        "entry_id": "5471cdc1-2453-3e6a-8db2-4f086a8a8cff",
                        "glosses": [
                            "собир. жарг. в некоторых случаях (чаще всего в разговорной речи) может обозначать любые многократно повторяющиеся сообщения, не несущие смысловой нагрузки, либо теряющие её в результате многократного повторения (в т. ч. не рекламного характера)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c637c36-20b4-45d6-9fb8-dc464acd625d",
                                "sense_id": "cad7c469-70f9-3e3b-9e3d-659cb3ddbec5",
                                "text": "Он спамил мне с самого утра просьбами пойти на речку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c56aa65a-4885-465c-a804-d4258fc833a8",
                        "source_entry_id": "5471cdc1-2453-3e6a-8db2-4f086a8a8cff",
                        "target_lang_word": "spam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba4cd701-ad64-3a06-b5d1-68406e953f0d",
                                        "entry_id": "2d5a2016-e2ef-3881-9641-382a82ee447a",
                                        "glosses": [
                                            "Unsolicited bulk electronic messages."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e627c358-e744-4fc3-95f5-3db2d06b2e42",
                                                "sense_id": "ba4cd701-ad64-3a06-b5d1-68406e953f0d",
                                                "text": "I get far too much spam."
                                            },
                                            {
                                                "example_id": "b2537ecd-32c1-4f62-9f59-5489dd71b882",
                                                "sense_id": "ba4cd701-ad64-3a06-b5d1-68406e953f0d",
                                                "text": "I received 58 spams yesterday."
                                            },
                                            {
                                                "example_id": "9b7038df-8319-450e-afb6-e87b5eb6abcb",
                                                "sense_id": "ba4cd701-ad64-3a06-b5d1-68406e953f0d",
                                                "text": "In America alone, people spent $170 billion on “direct marketing”—junk mail of both the physical and electronic varieties—last year. Yet of those who received unsolicited adverts through the post, only 3% bought anything as a result. If the bumf arrived electronically, the take-up rate was 0.1%. And for online adverts the “conversion” into sales was a minuscule 0.01%. That means about $165 billion was spent not on drumming up business, but on annoying people, creating landfill and cluttering spam filters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cd3bbdd-405d-39de-bbfb-ed64b1a417dd",
                                        "entry_id": "2d5a2016-e2ef-3881-9641-382a82ee447a",
                                        "glosses": [
                                            "Any undesired electronic content automatically generated for commercial purposes."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd09c25e-bdcf-4c53-80eb-86ff3e36cca3",
                                                "sense_id": "1cd3bbdd-405d-39de-bbfb-ed64b1a417dd",
                                                "text": "An Act to provide for the control of spam, which is unsolicited commercial communications sent in bulk by electronic mail or by text or multi-media messaging to mobile telephone numbers, and to provide for matters connected therewith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50ba5345-35c2-323a-916a-d24d9c3f6759",
                                        "entry_id": "2d5a2016-e2ef-3881-9641-382a82ee447a",
                                        "glosses": [
                                            "Excessive, often unwanted and repeated online messages."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c730bef-7e49-382a-9364-2bceb88912e5",
                                        "entry_id": "2d5a2016-e2ef-3881-9641-382a82ee447a",
                                        "glosses": [
                                            "Ellipsis of spam account."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1011e067-f3da-3911-b6a2-5576c92e8b24",
                                        "entry_id": "2d5a2016-e2ef-3881-9641-382a82ee447a",
                                        "glosses": [
                                            "A large quantity or multitude of anything done repetitively or considered unusually or indiscriminately repetitive."
                                        ],
                                        "tags": [
                                            "broadly",
