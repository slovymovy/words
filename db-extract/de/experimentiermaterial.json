                        "glosses": [
                            "Gesamtheit der Mittel, die zur Durchführung eines Versuches beziehungsweise zur Erforschung von etwas benötigt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df60c029-015d-4d20-b198-6133eb4effac",
                                "sense_id": "4ac5a3ae-f73d-3aab-a0e4-fd8facea19df",
                                "text": "„In einer Schachtel im Buchdeckel ist das Spiel- und Experimentiermaterial verpackt: Jetzt kann man das mit dem Kopf Gelernte mit den Händen ausprobieren.“"
                            },
                            {
                                "example_id": "d1860cd5-6afa-4af1-93b5-c3348f0ba73d",
                                "sense_id": "4ac5a3ae-f73d-3aab-a0e4-fd8facea19df",
                                "text": "„Die unterrichtende Lehrkraft dieser Klasse wurde vorab im Umgang mit den Experimentiermaterialien und -bauteilen geschult und erhielt zudem eine Einführung in die fachlichen Grundlagen der NDIR-CO₂-Gassensorik.“"
                            }
