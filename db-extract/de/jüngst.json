                                    {
                                        "sense_id": "eebecc6b-8cb5-368a-9aab-d10a9479e44b",
                                        "entry_id": "88b21465-3c92-3bc4-9e8a-ce18abb584b9",
                                        "glosses": [
                                            "Il y a peu de temps, récemment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0ed5b91-78a5-45b0-8ae2-025bd0b94387",
                                                "sense_id": "eebecc6b-8cb5-368a-9aab-d10a9479e44b",
                                                "text": "Dernièrement, j'avais eu la maladresse de m'enrhumer en pleine chaleur."
                                            },
                                            {
                                                "example_id": "df356d05-7a62-4cee-be79-627388d03ae1",
                                                "sense_id": "eebecc6b-8cb5-368a-9aab-d10a9479e44b",
                                                "text": "Tout dernièrement encore, un trois-mâts français, […], avait rebroussé chemin vers le Costa Rica, où il avait dû être condamné car sa coque était entièrement mangée par les tarets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11175634-a863-4ac4-b93e-070ffacf921f",
                        "source_entry_id": "ea200cc7-2805-34f9-b27b-e47ff809d480",
                        "source_sense_id": "3dfb780f-b110-3a8e-85b2-ac9aa1fb5cea",
                        "source_sense_description": "vor kurzem",
                        "target_lang_word": "onlangs",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onlangs",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a5f2eeff-0941-366c-a1ce-d07c9661fb67",
                                        "entry_id": "3accd675-51fb-340b-a55e-bba99270de00",
                                        "glosses": [
                                            "recentelijk, niet lang geleden; pas geleden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f56a3d2-cc1b-41fa-ac4f-30b89914828f",
                                                "sense_id": "a5f2eeff-0941-366c-a1ce-d07c9661fb67",
                                                "text": "Ik ben daar onlangs nog geweest."
                                            },
                                            {
                                                "example_id": "70675c0e-51c7-460c-bdc0-6356916d8a9e",
                                                "sense_id": "a5f2eeff-0941-366c-a1ce-d07c9661fb67",
                                                "text": "`Heeft het hotel een nieuwe eigenaar?' vroeg ik.\n `Onlangs is Grand Hotel Europa overgegaan in Chinese handen,' zei hij. 'De nieuwe eigenaar heet meneer Wang. Het gaat om een recente ontwikkeling die we op dit moment onmogelijk kunnen beoordelen."
                                            },
                                            {
                                                "example_id": "492844c7-d315-442f-8186-1785b54e488a",
                                                "sense_id": "a5f2eeff-0941-366c-a1ce-d07c9661fb67",
                                                "text": "Onlangs reed hij nog in de Alpen, naar Val Thorens, finishplaats in de laatste Tourweek. ‘Dit is zwaarder. Die steile stukken hier knijpen je de keel dicht.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
