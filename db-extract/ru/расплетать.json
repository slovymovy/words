                        "source_entry_id": "20aca76d-02b0-3f2f-9c17-5a163bfc4391",
                        "target_lang_word": "uncurl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uncurl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fca9407-d4cf-34db-81a9-2c664f2cf5f9",
                                        "entry_id": "5121b4be-5020-33d2-be7c-77143e7b3050",
                                        "glosses": [
                                            "To straighten out from being curled up."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbcb8a46-dbff-411b-a8fe-1ced94fb7ebc",
                                                "sense_id": "4fca9407-d4cf-34db-81a9-2c664f2cf5f9",
                                                "text": "The hedgehog uncurled when its predators had left."
                                            },
                                            {
                                                "example_id": "977a0300-eb4d-49c1-b044-50f49b433e40",
                                                "sense_id": "4fca9407-d4cf-34db-81a9-2c664f2cf5f9",
                                                "text": "But when his foe lyes prostrate on the plain,\nHe sheaths his paws, uncurls his angry mane;\nAnd, pleas'd with bloudless honours of the day,\nWalks over, and disdains th' inglorious Prey."
                                            },
                                            {
                                                "example_id": "217321be-73c2-4a75-9021-767553bd2697",
                                                "sense_id": "4fca9407-d4cf-34db-81a9-2c664f2cf5f9",
                                                "text": "Then he uncurled his trunk and knocked two of his dear brothers head over heels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
