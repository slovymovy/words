                "senses": [
                    {
                        "sense_id": "39b99d49-6d58-3540-81f7-a4b55c299a28",
                        "entry_id": "baba74c9-f72d-3e93-8eb4-929dfa01df13",
                        "glosses": [
                            "Krankheit mit verschiedenen Symptomen (meist einhergehend mit geistiger Behinderung und körperlichen Anomalien), deren Ursache eine Chromosomenanomalie (dreifaches Vorliegen des Chromosoms 21) ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c704cda9-70ea-4dec-adec-bd3334fb135d",
                                "sense_id": "39b99d49-6d58-3540-81f7-a4b55c299a28",
                                "text": "Die verschiedenen Formen der Trisomie 21 entstehen entweder spontan oder können vererbt werden, wenn die Mutter bereits selbst das Downsyndrom hat."
                            },
                            {
                                "example_id": "5b2c44cb-3848-4f08-a80a-f964fc9d760a",
                                "sense_id": "39b99d49-6d58-3540-81f7-a4b55c299a28",
                                "text": "In der nationalsozialistischen Diktatur wurden im Deutschen Reich viele Menschen mit Downsyndrom im Rahmen der Aktion T4 ermordet."
                            },
                            {
                                "example_id": "d968cbe8-ebfc-4183-97d4-97897bae79be",
                                "sense_id": "39b99d49-6d58-3540-81f7-a4b55c299a28",
                                "text": "1965 richtete die Mongolei an die WHO einen Antrag mit der Bitte, den Begriff Mongolian Idiocy (Mongolismus) und seine Ableitungen aufgrund der negativen sowie rassistischen Besetzung nicht mehr zu verwenden. Die WHO nahm diesen Antrag einstimmig an. Bereits 1961 hatte die renommierte britische Wissenschaftszeitschrift The Lancet auf die Bitte einer internationalen Gruppe von neunzehn anerkannten Genetikern die Bezeichnung in Down’s Syndrome (deutsch: Downsyndrom) abgeändert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
