        "zh-extract.jsonl": [
            {
                "entry_id": "24befba2-edb4-3d6e-8962-547024db2416",
                "word": "toon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "61568fc5-d729-454d-8c5b-5ac624ca2b23",
                        "entry_id": "24befba2-edb4-3d6e-8962-547024db2416",
                        "tags": [
                            "plural"
                        ],
                        "form": "toons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "848f9d39-1514-39e4-9d2e-a78cee4c85a7",
                        "entry_id": "24befba2-edb4-3d6e-8962-547024db2416",
                        "glosses": [
                            "卡通，特別指動畫電視節目。"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "cf33e3a4-6ab9-4b49-a8ac-fbdbd027e932",
                                "sense_id": "848f9d39-1514-39e4-9d2e-a78cee4c85a7",
                                "text": "Did you know Nash had a complete break with reality, that he was loonier than a toon for almost four months?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7c66522b-daf7-3fc8-8e47-b38535666b15",
                        "entry_id": "24befba2-edb4-3d6e-8962-547024db2416",
                        "glosses": [
                            "玩家化身或大型多人線上角色扮演遊戲顯示的角色。"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "c86167fb-21a6-4e09-b1fc-502ff922ba52",
                                "sense_id": "7c66522b-daf7-3fc8-8e47-b38535666b15",
                                "text": "Proxemics are very important, however, as the positioning of an agent's toon in anon-combat grouping or in the environment can show place within a social group."
                            }
                        ]
                    },
                    {
                        "sense_id": "55969da1-51a7-3602-9211-bc7a09c43fcf",
                        "entry_id": "24befba2-edb4-3d6e-8962-547024db2416",
                        "glosses": [
                            "僅用於loony toon 或 looney toon，替代寫法 loony tune。"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "481a41d2-bffd-4116-9508-b0b4469d849c",
                                "sense_id": "55969da1-51a7-3602-9211-bc7a09c43fcf",
                                "text": "I look at him as if he's a loony toon."
                            },
                            {
                                "example_id": "19d7b2ed-5eb3-4b00-afc9-8e34b974d517",
                                "sense_id": "55969da1-51a7-3602-9211-bc7a09c43fcf",
                                "text": "We are both kind of strange and one day we were driving in the car and Steve said to me, You know Karin, you are a real loony toon'."
                            },
                            {
                                "example_id": "90a6500a-ea28-43b8-99be-1fb2e8cf92fd",
                                "sense_id": "55969da1-51a7-3602-9211-bc7a09c43fcf",
                                "text": "Wilson, quite early on, points out: “Many messiahs have undoubtedly been mental cases, suffering from psychotic delusions” These looney-toon 'messiahs' seem to this reviewer to be running very fast away from any profound development in human consciousness!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "51071967-8a20-3600-8045-6cb5c1e0b10c",
                "word": "toon",
