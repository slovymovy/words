                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a37ea19e-ed76-4114-ac5d-95e4210c3bf7",
                                "sense_id": "28a9e3e1-6161-377d-80b0-e468a0ec5fd7",
                                "text": "Вода между тем в судне умножалася, и труд наш, возрастая в отливании оной, утомлял силы наши приметно."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e2fa88f-6328-324d-9fa0-309de09767a8",
                        "entry_id": "5fa3206b-021d-39ca-8858-af5edeeefc4a",
                        "glosses": [
                            "страд. к гл. умножать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dfc668c-fc4e-4dab-9bef-99b807624d29",
                                "sense_id": "4e2fa88f-6328-324d-9fa0-309de09767a8",
                                "text": "И красиво, и вроде как действительно же всё здесь умножалось на ноль."
                            }
                        ]
                    }
