                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À cette époque lointaine, la <w>demoiselle</w> du téléphone reliait manuellement chaque appel."
                        },
                        {
                            "text": "La <w>demoiselle</w> de magasin a renseigné les clients avec beaucoup d'attention."
