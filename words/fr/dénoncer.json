    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "59596be4-cb92-3f92-a81c-417edfdc7952",
                    "sense_definition": "Signaler une personne coupable à une autorité judiciaire ou policière.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "accusation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin a décidé de <w>dénoncer</w> le voleur à la police pour aider l'enquête."
                        },
                        {
                            "text": "Il a refusé de <w>dénoncer</w> ses complices malgré les questions répétées des inspecteurs."
                        }
                    ],
                    "synonyms": [
                        "balancer",
                        "cafarder",
                        "cafter",
                        "moucharder"
                    ],
                    "common_phrases": [
                        "dénoncer un complice",
                        "dénoncer le coupable"
                    ]
                },
                {
                    "sense_id": "18dbb3d9-4c50-364c-a750-a8a3ed90d7e8",
                    "sense_definition": "Signaler publiquement des actes graves, répréhensibles ou injustes pour les condamner moralement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "condamnation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les journalistes n'hésitent pas à <w>dénoncer</w> les scandales financiers du gouvernement."
                        },
                        {
                            "text": "Cette organisation cherche à <w>dénoncer</w> une injustice flagrante devant les tribunaux internationaux."
                        }
                    ],
                    "common_phrases": [
                        "dénoncer une injustice",
                        "dénoncer des abus",
                        "dénoncer la corruption"
                    ]
                },
                {
                    "sense_id": "22a962ff-49c7-3dbf-bfac-0fc288c89ff3",
                    "sense_definition": "Déclarer légalement la rupture ou la fin de validité d'un contrat ou d'un traité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pays a choisi de <w>dénoncer</w> le traité commercial après plusieurs mois de tensions diplomatiques."
                        },
                        {
                            "text": "Le syndicat a prévu de <w>dénoncer</w> un accord d'entreprise jugé défavorable pour les salariés."
                        }
                    ],
                    "common_phrases": [
                        "dénoncer un accord",
                        "dénoncer un contrat",
                        "dénoncer un traité"
                    ]
                },
                {
                    "sense_id": "14273d40-afa5-3b19-b754-bb412f244245",
                    "sense_definition": "Révéler ou laisser paraître quelque chose au moyen d'indices visibles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "revelation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son regard fuyant <w>dénonçait</w> une grande inquiétude avant le début de l'entretien."
                        },
                        {
                            "text": "Les traces d'humidité sur le plafond <w>dénoncent</w> une fuite d'eau ancienne."
                        }
                    ]
                },
                {
                    "sense_id": "a10e9ae3-8746-32cd-9dc8-9d150a7accd5",
                    "sense_definition": "Notifier formellement et solennellement par voie légale ou officielle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le héraut s'avança pour <w>dénoncer</w> la guerre au prince ennemi devant toute la cour."
                        },
                        {
                            "text": "L'huissier est tenu de <w>dénoncer</w> la saisie au débiteur dans un délai de huit jours."
                        }
                    ],
                    "common_phrases": [
                        "dénoncer la guerre"
                    ]
                }
            ]
        }
    ]
