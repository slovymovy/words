                        "entry_id": "63b591d6-6744-38ec-8558-8f23c50893ce",
                        "glosses": [
                            "immunoglobulinen producerende cellen die ontstaan zijn uit B-lymfocyten en vooral gekenmerkt worden door een grote hoeveelheid cytoplasma, een excentrisch gelegen kern die een radstructuur vertoont en een perinucleair optisch leeg hofje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca196333-83c1-4338-8d99-6df61bfd8449",
                                "sense_id": "d19651a2-634a-3b14-abda-9087dcb07d30",
                                "text": "De 'thuischemo' richt zich vooralsnog op patiënten met Multipel Myeloom, zij hebben een kwaadaardige woekering van plasmacellen, meestal in het beenmerg."
                            },
                            {
                                "example_id": "f2b72272-4d6a-4c2c-aeef-5e7cf3df8dfc",
                                "sense_id": "d19651a2-634a-3b14-abda-9087dcb07d30",
                                "text": "Uit één donatie haalt de bloedbank twee soorten bloedproducten: bloedplaatjes en rode bloedcellen en plasmacellen. “Die worden aan meerdere patiënten toegediend,” vertelt Heckert."
                            }
                        ]
                    }
