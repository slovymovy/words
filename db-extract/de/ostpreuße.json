                        "examples": [
                            {
                                "example_id": "333c3414-d8e2-436b-ad45-90f64a1da59b",
                                "sense_id": "dfc45272-ca04-34c5-8a95-3829e2fc199a",
                                "text": "„Zwei Millionen Ostpreußen verließen fluchtartig ihre Häuser, Dörfer und Städte.“"
                            },
                            {
                                "example_id": "bdb61fcd-6607-4315-97aa-6b30a32222ea",
                                "sense_id": "dfc45272-ca04-34c5-8a95-3829e2fc199a",
                                "text": "„An diesen Vormittag mußte ich denken, als die Ostpreußen von Taormina sprachen und von Mohrungen abrieten.“"
                            }
