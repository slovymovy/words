                "senses": [
                    {
                        "sense_id": "2813586d-310d-381a-8cf6-81a54efac656",
                        "entry_id": "66f7aac0-6607-3f85-8983-7441d864bdc2",
                        "glosses": [
                            "Ruf zur Bekundung von Freude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e91856b1-8997-4219-9696-ba0f57526444",
                                "sense_id": "2813586d-310d-381a-8cf6-81a54efac656",
                                "text": "Die Jubelschreie der Fußballfans waren nicht zu überhören."
                            },
                            {
                                "example_id": "4d394d7b-e090-461d-b9f9-3e982e255c9a",
                                "sense_id": "2813586d-310d-381a-8cf6-81a54efac656",
                                "text": "„Mit einem Jubelschrei flog die blonde Schönheit Thomas an den Hals und warf ihn fast über den Haufen.“"
                            },
                            {
                                "example_id": "702e0b2e-fc9a-4587-becf-2fcf749d29a7",
                                "sense_id": "2813586d-310d-381a-8cf6-81a54efac656",
                                "text": "„Giorgio stieß einen Jubelschrei aus, und Lucia, die den Kopf aus ihrem Zimmer gestreckt hatte, schnappte nach Luft.“"
                            },
                            {
                                "example_id": "7db4e538-7e02-4261-abd6-e22b544be8fd",
                                "sense_id": "2813586d-310d-381a-8cf6-81a54efac656",
                                "text": "„Aus dem Wohnzimmer erklangen Jubelschreie, die sich sofort in Fluchen wandelten, gefolgt von lautstarken Erklärungen, dass es doch bestimmt kein verdammtes Abseits war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
