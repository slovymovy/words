                },
                {
                    "sense_id": "f9743e4d-b46f-37f2-8c72-a602c34e2392",
                    "sense_definition": "Een samenstel van riemen om een persoon of dier vast te houden of te leiden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_harness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met dit <w>tuigje</w> kunnen we verhinderen dat onze peuter uit zijn kinderstoel valt.",
                            "target_lang_translations": {
                                "en": "With this <w>harness</w>, we can prevent our toddler from falling out of his high chair.",
                                "ru": "С помощью этих <w>ремней</w> мы можем предотвратить падение нашего малыша из детского стульчика.",
                                "fr": "Avec ce <w>harnais</w>, nous pouvons empêcher notre tout-petit de tomber de sa chaise haute."
                            }
                        },
                        {
                            "text": "De boer deed het paard een nieuw <w>tuig</w> om voor het werk.",
                            "target_lang_translations": {
                                "en": "The farmer put a new <w>harness</w> on the horse for the work.",
                                "ru": "Фермер надел на лошадь новую <w>упряжь</w> для работы.",
                                "fr": "Le fermier a mis un nouveau <w>harnais</w> au cheval pour le travail."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A set of straps to hold or lead a person or animal.",
                        "ru": "Система ремней для удержания или ведения человека или животного.",
                        "fr": "Ensemble de sangles ou de courroies servant à maintenir ou à diriger une personne ou un animal."
