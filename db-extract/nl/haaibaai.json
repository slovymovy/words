                                "target_senses": [
                                    {
                                        "sense_id": "9fee2cc2-2965-349d-9d96-64ad95c3bcd6",
                                        "entry_id": "a682dd2f-47cb-3640-aeed-1f30494a0435",
                                        "glosses": [
                                            "A female fox."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b479b5cf-d553-3dae-b312-02785bf61f8f",
                                        "entry_id": "a682dd2f-47cb-3640-aeed-1f30494a0435",
                                        "glosses": [
                                            "A malicious, quarrelsome or temperamental woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c5c5d87-9824-4fe6-ae5e-cb6c642257a0",
                                                "sense_id": "b479b5cf-d553-3dae-b312-02785bf61f8f",
                                                "text": "He was prudent and industrious, and so good a husbandman, that he might have led a very easy and comfortable life, had not an arrant vixen of a wife soured his domestic quiet."
                                            },
                                            {
                                                "example_id": "7d109475-9060-4a7e-b713-d810dd57f022",
                                                "sense_id": "b479b5cf-d553-3dae-b312-02785bf61f8f",
                                                "text": "[…] and if Solomon was as wise as he is reputed to be, I feel sure that when he compared a contentious woman to a continual dripping on a very rainy day, he had not a vixen in his eye–a fury with long nails, acrid and selfish."
                                            },
                                            {
                                                "example_id": "f4f3c0fa-8063-4fcd-9c0e-f0f80d857554",
                                                "sense_id": "b479b5cf-d553-3dae-b312-02785bf61f8f",
                                                "text": "(Mimic): 'I used the plans to build a Steam Engine of my own. I was almost done when that vixen swiped it!'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ddf5ed6-2ba9-3dd0-a251-da40622c0ef9",
                                        "entry_id": "a682dd2f-47cb-3640-aeed-1f30494a0435",
                                        "glosses": [
                                            "A racy or salacious woman who is sexually attractive; any attractive woman."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16106850-8c5e-3e89-ab7c-3933d3069a88",
                                        "entry_id": "a682dd2f-47cb-3640-aeed-1f30494a0435",
                                        "glosses": [
                                            "A wife who has sex with other men with her husband's consent."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3be7d537-dba2-4e2d-b5d3-cc1ef22cc0c3",
                                                "sense_id": "16106850-8c5e-3e89-ab7c-3933d3069a88",
                                                "text": "2018, ‘Stag’ men love watching other guys have sex with their wives… but it’s not cuckolding\nThe stag gets a thrill from watching his vixen have sex with another man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
