        "fr-extract.jsonl": [
            {
                "entry_id": "600c17fd-d413-394e-95c0-ad8a334fe7c9",
                "word": "comiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ecbef2e5-eaae-3e75-8716-a3f7e0871018",
                        "entry_id": "600c17fd-d413-394e-95c0-ad8a334fe7c9",
                        "glosses": [
                            "D’une manière comique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aed9543-ee57-49a1-8158-a4c07e6eb3d3",
                                "sense_id": "ecbef2e5-eaae-3e75-8716-a3f7e0871018",
                                "text": "La petite dame du type « conoïde » tristement inexpressif, que l’absence de menton fait comiquement grimacer alors qu’elle s’imagine gracieusement sourire, se proclame volontiers reine de beauté, […]."
                            },
                            {
                                "example_id": "48fc325c-bb94-4c37-aeeb-847450ad114e",
                                "sense_id": "ecbef2e5-eaae-3e75-8716-a3f7e0871018",
                                "text": "On représente comiquement ce qui se passe de ridicule en divers lieux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2b1983c-cea3-4aca-bfb9-5a121ca50cdc",
                        "source_entry_id": "600c17fd-d413-394e-95c0-ad8a334fe7c9",
                        "source_sense_id": "ecbef2e5-eaae-3e75-8716-a3f7e0871018",
