                "senses": [
                    {
                        "sense_id": "40b34755-a8a4-3d80-9c3f-eb79dd81c111",
                        "entry_id": "159dfdac-f12f-3683-b89f-836d8840bd5a",
                        "glosses": [
                            "Wasser, das durch Schmelzen von Schnee oder Eis entstanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb28338-d9a2-48f8-af06-9bb3e3bb1101",
                                "sense_id": "40b34755-a8a4-3d80-9c3f-eb79dd81c111",
                                "text": "Schmelzwasser führt im Frühjahr oft zu Hochwasser in den Flüssen."
                            },
                            {
                                "example_id": "1f4378a7-7818-42cc-aabf-1980fec86a88",
                                "sense_id": "40b34755-a8a4-3d80-9c3f-eb79dd81c111",
                                "text": "„Der Schnee, der in den Wintermonaten aufs flache Land gefallen war, suchte sich im Sommer als Schmelzwasser seinen Weg, bis im Herbst neuer Schnee fiel und sich das Spiel wiederholte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
