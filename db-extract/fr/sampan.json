                                "target_senses": [
                                    {
                                        "sense_id": "15e7e9a1-c609-3584-adc9-bb4cf3148af3",
                                        "entry_id": "2b763a3d-8ce5-3a02-bd1a-6b7c9dc33610",
                                        "glosses": [
                                            "A Chinese flat-bottomed wooden boat propelled by two oars."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3ac4cb9-2fea-4deb-9701-e717109d2bec",
                                                "sense_id": "15e7e9a1-c609-3584-adc9-bb4cf3148af3",
                                                "text": "We traveled down the Min River from Nanping in a small sampan, flying the American flag for protection against bandits and soldiers. Those were the days when the Stars and Stripes still afforded some protection."
                                            },
                                            {
                                                "example_id": "ccfb937c-2c97-44b3-925c-8df542563b98",
                                                "sense_id": "15e7e9a1-c609-3584-adc9-bb4cf3148af3",
                                                "text": "Freedom-fighter Lin Chun-hwei reports his escape from the mainland at the Free China Relief Association. Lin escaped by sampan from Putien in Fukien province to one of the islets near Kinmen Oct. 27."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sampan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25b0c180-3ba2-3e63-888c-3dc4002e8096",
                                        "entry_id": "6a0f9599-c5fa-32d1-bfe0-cbd0280ce5c5",
                                        "glosses": [
                                            "Alternative form of jampan."
                                        ],
