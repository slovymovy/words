                        "translation_id": "2b642b49-c76e-4609-9c39-e392468ed476",
                        "source_entry_id": "501ae5d3-1d3e-37db-9984-f4ffd71c33dd",
                        "source_sense_id": "d0964d9e-8a5d-3766-bc98-d6fdfa6a88d6",
