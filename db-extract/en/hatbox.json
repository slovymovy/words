                                                "sense_id": "dbf41ebc-a4b1-3fa9-ac9a-6bc111db7144",
                                                "text": "„Robert Grenfeld beobachtete den dicken Mann mit der Hutschachtel, der unablässig zu ihm hinaufstarrte.“"
                                            },
                                            {
                                                "example_id": "d62a72c8-3b0e-41a1-acee-2b465433a955",
                                                "sense_id": "dbf41ebc-a4b1-3fa9-ac9a-6bc111db7144",
                                                "text": "„Im Fond, zwischen Hutschachteln und Koffern, saß Oberst Jules Siméon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
