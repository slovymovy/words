                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a836e314-c62d-3909-9d4e-b6b336ec6867",
                                        "entry_id": "b88c469e-dbd6-38d8-b726-f5558b0c0074",
                                        "glosses": [
                                            "süße Soße auf Milchbasis mit Vanillegeschmack"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d5c47f1-4e2f-4e95-b5b7-a4f5dfaa997b",
                                                "sense_id": "a836e314-c62d-3909-9d4e-b6b336ec6867",
                                                "text": "Zur Nachspeise gibt es Apfelstrudel mit Vanillesoße."
                                            },
                                            {
                                                "example_id": "f6133401-2006-4cbf-9717-1df81fcf7fc2",
                                                "sense_id": "a836e314-c62d-3909-9d4e-b6b336ec6867",
                                                "text": "„Zu Mittag gab es Gänseklein und Schokoladenpudding mit Vanillesoße.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fda9213-02dd-42dd-9d54-f073471d36b5",
                        "source_entry_id": "ba7051dd-a3c8-39b2-b05d-910d6e6ac372",
                        "source_sense_description": "sauce",
