                                "example_id": "2dfc60aa-aed2-43a4-995d-5e9396712539",
                                "sense_id": "fd8412d7-be61-3763-8ca4-e0909a415baf",
                                "text": "„Die Türkei ist ein enger Verbündeter Katars und unterhält in dem Golfemirat einen Militärstützpunkt.“"
                            },
