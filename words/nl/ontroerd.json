{
    "word_family": [
        "ontroeren",
        "ontroering",
        "ontroerend"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "af654b2b-ba98-3664-b211-5f0c93390e11",
                    "sense_definition": "een staat waarin een persoon verkeert als iets hem of haar emotioneel geraakt heeft",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotionele toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man was zichtbaar <w>ontroerd</w> toen hij zijn kleinkind voor het eerst zag.",
                            "target_lang_translations": {
                                "en": "The old man was visibly <w>moved</w> when he saw his grandchild for the first time."
                            }
                        },
                        {
                            "text": "Zij was diep <w>ontroerd</w> door de prachtige muziek die tijdens de ceremonie werd gespeeld.",
                            "target_lang_translations": {
                                "en": "She was deeply <w>touched</w> by the beautiful music played during the ceremony."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewogen",
                        "aangedaan",
                        "geraakt"
                    ],
                    "common_phrases": [
                        "diep ontroerd",
                        "zichtbaar ontroerd"
                    ],
                    "target_lang_definitions": {
                        "en": "a state a person is in when something has touched them emotionally"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moved",
                                "target_lang_sense_clarification": "emotionally touched"
                            },
                            {
                                "target_lang_word": "touched",
                                "target_lang_sense_clarification": "feeling a soft emotion"
                            },
                            {
                                "target_lang_word": "affected",
                                "target_lang_sense_clarification": "emotionally impacted"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd5eadcb-e73f-3d79-82f8-4f7e5e1071d8",
                    "sense_definition": "voltooid deelwoord van <w>ontroeren</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leerling was <w>ontroerd</w> en aangeslagen door wat er vanmiddag in de klas was gebeurd.",
                            "target_lang_translations": {
                                "en": "The student was <w>moved</w> and shaken by what had happened in class this afternoon."
                            }
                        },
                        {
                            "text": "Ik was erg <w>ontroerd</w> door haar bezorgdheid, maar ook door haar praktische advies.",
                            "target_lang_translations": {
                                "en": "I was very <w>touched</w> by her concern, but also by her practical advice."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'ontroeren' (to move/touch emotionally)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moved",
                                "target_lang_sense_clarification": "past participle form"
                            },
                            {
                                "target_lang_word": "touched",
                                "target_lang_sense_clarification": "past participle form"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}