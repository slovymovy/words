                            {
                                "example_id": "5a08f0d3-7f4a-4c47-90eb-1c464d5d6540",
                                "sense_id": "658fb30c-5b22-30d9-84f0-72087c7bf8ae",
                                "text": "BACILLIFORME, adj., bacilliformis, baculosus (bacillus, baguette, forma, forme) ; qui a la forme d’une baguette. Cette épithète est donnée aux épines des oursins, quand elles ont une certaine longueur. Ex. Cidarites baculosa."
                            },
                            {
                                "example_id": "37c607bb-e074-47af-a0e8-0c15b36e4ea3",
                                "sense_id": "658fb30c-5b22-30d9-84f0-72087c7bf8ae",
                                "text": "Ces éléments bacilliformes ne semblent pas être des bactéries."
                            }
                        ]
