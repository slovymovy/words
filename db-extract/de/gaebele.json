                "senses": [
                    {
                        "sense_id": "9e801272-1bef-377f-8641-2eb481e39548",
                        "entry_id": "acb38581-bf6f-33f4-b339-6bb8c5e34143",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b05257b8-81fe-4a51-a74a-0c10a71a4de8",
                                "sense_id": "9e801272-1bef-377f-8641-2eb481e39548",
                                "text": "Frau Gaebele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "47ab19e3-3e83-4cda-9dd3-83ef73ab73df",
                                "sense_id": "9e801272-1bef-377f-8641-2eb481e39548",
                                "text": "Herr Gaebele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "919f2075-5adc-4914-ad70-f02026df99f0",
                                "sense_id": "9e801272-1bef-377f-8641-2eb481e39548",
                                "text": "Die Gaebeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "61182516-5f27-41cd-bf03-428f38011b12",
                                "sense_id": "9e801272-1bef-377f-8641-2eb481e39548",
                                "text": "Der Gaebele trägt nie die Schals, die die Gaebele ihm strickt."
                            },
                            {
                                "example_id": "45511bf3-ee80-427d-b3f9-ea1dca33a5e7",
                                "sense_id": "9e801272-1bef-377f-8641-2eb481e39548",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gaebele kommt, geht der Herr Gaebele.“"
                            },
                            {
                                "example_id": "4e84234b-b9b3-4908-a31f-b349239075aa",
                                "sense_id": "9e801272-1bef-377f-8641-2eb481e39548",
                                "text": "Gaebele kommt und geht."
                            },
                            {
                                "example_id": "f293a242-07b3-4fed-8a9d-263b5d7f7743",
                                "sense_id": "9e801272-1bef-377f-8641-2eb481e39548",
                                "text": "Gaebeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
