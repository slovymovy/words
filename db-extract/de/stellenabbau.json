                                "sense_id": "3b897100-8a33-38bf-a1ac-f509f0e95c89",
                                "text": "Sie bekam Angst um ihren Arbeitsplatz wegen des massiven Stellenabbaus in ihrem Betrieb."
                            },
                            {
                                "example_id": "6ec0454d-1994-4b88-ae31-60172d370278",
                                "sense_id": "3b897100-8a33-38bf-a1ac-f509f0e95c89",
                                "text": "„Siemens-Vorstandschef Joe Kaeser hält den geplanten Stellenabbau im Konzern für unvermeidlich.“"
                            },
                            {
                                "example_id": "54ba4745-c148-4a39-84d5-4638b3f4c68c",
                                "sense_id": "3b897100-8a33-38bf-a1ac-f509f0e95c89",
                                "text": "„Es ist bereits der zweite größere Stellenabbau bei Tesla binnen weniger Monate.“"
                            }
                        ],
