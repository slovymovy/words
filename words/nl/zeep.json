                                "ru": "Я всегда мою руки водой с <w>мылом</w>.",
                                "pl": "Zawsze myję ręce wodą i <w>mydłem</w>.",
                                "de": "Ich wasche meine Hände immer mit Wasser und <w>Seife</w>.",
                                "fr": "Je me lave toujours les mains avec de l'eau et du <w>savon</w>.",
                                "it": "Mi lavo sempre le mani con acqua e <w>sapone</w>.",
                                "cs": "Vždycky si myji ruce vodou a <w>mýdlem</w>.",
                                "tr": "Ellerimi her zaman su ve <w>sabunla</w> yıkarım.",
                                "es": "Siempre me lavo las manos con agua y <w>jabón</w>."
                            }
                        },
                        {
                            "text": "Deze vloeibare <w>zeep</w> ruikt heerlijk naar lavendel.",
                            "target_lang_translations": {
                                "en": "This liquid <w>soap</w> smells wonderfully of lavender.",
                                "ru": "Это жидкое <w>мыло</w> чудесно пахнет лавандой.",
                                "pl": "To <w>mydło</w> w płynie pachnie cudownie lawendą.",
                                "de": "Diese flüssige <w>Seife</w> riecht herrlich nach Lavendel.",
                                "fr": "Ce <w>savon</w> liquide sent divinement bon la lavande.",
                                "it": "Questo <w>sapone</w> liquido ha un profumo meraviglioso di lavanda.",
                                "cs": "Toto tekuté <w>mýdlo</w> nádherně voní po levanduli.",
                                "tr": "Bu sıvı <w>sabun</w> harika lavanta kokuyor.",
                                "es": "Este <w>jabón</w> líquido huele de maravilla a lavanda."
                            }
