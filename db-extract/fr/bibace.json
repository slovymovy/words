                    {
                        "sense_id": "3d62eff6-0d12-342c-9702-d7fb744519af",
                        "entry_id": "643fd87d-a5a4-327c-aa71-f157dc72e3d0",
                        "glosses": [
                            "Fruit comestible du bibacier ou néflier du Japon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47dca212-81a3-462b-8544-89539590cf10",
                                "sense_id": "3d62eff6-0d12-342c-9702-d7fb744519af",
                                "text": "Le néflier du Japon. Sous nos latitudes, les fruits ovoïdes, les bibaces ou bibasses, encore appelés loquats, parviennent à maturité en avril ou en mai. Gros comme des prunes, ils ont une peau plus ou moins duveteuse variant du jaune pâle à l’orangé. Leur chair, très juteuse, est sucrée et légèrement acidulée […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "329074b4-2d92-4ad9-a739-43d7996d4dd2",
                        "source_entry_id": "643fd87d-a5a4-327c-aa71-f157dc72e3d0",
                        "source_sense_id": "3d62eff6-0d12-342c-9702-d7fb744519af",
