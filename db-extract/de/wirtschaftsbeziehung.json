                ],
                "senses": [
                    {
                        "sense_id": "8d30fa87-2ef8-37d4-9a2d-f8767013fd5d",
                        "entry_id": "80c152a7-357c-3566-8c85-3a01f3549cf0",
                        "glosses": [
                            "wechselseitiges Verhältnis auf dem Gebiet des Handels mit Waren oder Dienstleistungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75394cca-f7bf-4e54-a6a9-1b346921347d",
                                "sense_id": "8d30fa87-2ef8-37d4-9a2d-f8767013fd5d",
                                "text": "„Durch die enge Wirtschaftsbeziehung beider Nationen werden Arbeitsplätze geschaffen.“"
                            },
                            {
                                "example_id": "9fc94ead-3363-422a-aa3c-85374f006f49",
                                "sense_id": "8d30fa87-2ef8-37d4-9a2d-f8767013fd5d",
                                "text": "„In diesem Sinne waren auch Umsätze, die zur Wiederherstellung einer solchen Wirtschaftsbeziehung eingesetzt wurden, von der Umsatzsteuer befreit (§ 6).“"
                            },
                            {
                                "example_id": "b6181d8d-ac92-4da7-a838-1d89de00d2dc",
                                "sense_id": "8d30fa87-2ef8-37d4-9a2d-f8767013fd5d",
                                "text": "„Sie ermöglicht auf dem Gebiet der Ökonomie die Entwicklung einer nationalen Wirtschaft im Inneren und die Ausgestaltung der internationalen Wirtschaftsbeziehung im Äußeren nach dem nationalen Interesse.“"
                            },
                            {
                                "example_id": "768c5ac7-4f31-48fe-94c3-3fd268c95a9d",
                                "sense_id": "8d30fa87-2ef8-37d4-9a2d-f8767013fd5d",
                                "text": "„Lombardi hatte es aufgegeben, Zhang davon zu überzeugen, dass das europäische Beharren auf Freiheit und Souveränität eine Wirtschaftsbeziehung zwischen China und der Konföderation ganz und gar nicht ausschließe.“"
                            },
                            {
                                "example_id": "0b05aa5a-9091-47bc-96dd-33d866965e2b",
                                "sense_id": "8d30fa87-2ef8-37d4-9a2d-f8767013fd5d",
                                "text": "„Das allein garantierte eine wesentlich intensivere Wirtschaftsbeziehung zwischen Stadt und Land, sowie eine Produktionsankurbelung für beide Seiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
