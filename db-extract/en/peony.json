                                        "sense_id": "72995e70-5c65-3f21-aca2-9b1eb9d92fc2",
                                        "entry_id": "a60aeba7-741c-317a-9db6-8f62983dfc92",
                                        "glosses": [
                                            "sommergrüne Pflanze mit großen, duftenden Blüten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72556dd8-7f17-4c00-8f83-a2523556bc6b",
                                                "sense_id": "72995e70-5c65-3f21-aca2-9b1eb9d92fc2",
                                                "text": "Im Park sahen sie viele Pfingstrosen."
                                            },
                                            {
                                                "example_id": "ec345834-845c-4af3-bdaa-6098b6af674c",
                                                "sense_id": "72995e70-5c65-3f21-aca2-9b1eb9d92fc2",
                                                "text": "„[…] Neben ihrem Schreibtisch steht ein Strauß mit blassrosa Pfingstrosen. Eine Dame im Bleistiftrock bringt ein Schälchen Obstsalat, akkurat gestapelt.“"
                                            },
                                            {
                                                "example_id": "6d8204ba-91b0-48ba-ab94-0c0899c26b96",
                                                "sense_id": "72995e70-5c65-3f21-aca2-9b1eb9d92fc2",
                                                "text": "„Eleanors Lieblingsblumen waren rosa Pfingstrosen gewesen, die es normalerweise nur im späten Frühling gab, nicht mitten im Sommer, aber wie durch ein Wunder hatte Louise an diesem Abend einen Strauß davon da.“"
                                            },
                                            {
                                                "example_id": "f97d869b-8b0e-4872-a90c-395e731c2ada",
                                                "sense_id": "72995e70-5c65-3f21-aca2-9b1eb9d92fc2",
                                                "text": "„Bouvard pflanzte mitten auf dem Rasen eine Pfingstrose und unter den Bogen des Laubenganges Tomaten, die wie Kronleuchter herabhängen sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
