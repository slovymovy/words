    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "37333dd6-8056-3c64-8882-0d8688d56da3",
                    "sense_definition": "Indique la possession, l'appartenance ou une relation étroite entre deux êtres ou deux choses.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La maison <w>de</w> mon grand-père se trouve au bout du village."
                        },
                        {
                            "text": "Elle a emprunté le stylo <w>de</w> son voisin pour écrire une note rapide."
                        }
                    ],
                    "common_phrases": [
                        "la voiture de mon ami",
                        "le livre de Marie",
                        "la porte de la maison"
                    ]
                },
                {
                    "sense_id": "3252e0c3-4503-32d4-9053-dc1176362e10",
                    "sense_definition": "Indique le point de départ spatial, l'origine géographique ou la provenance.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "provenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train en provenance <w>de</w> Lyon entrera bientôt en gare."
                        },
                        {
                            "text": "Elle arrive tout juste <w>d'</w>Espagne après trois semaines de vacances au soleil."
                        }
                    ],
                    "common_phrases": [
                        "venir de loin",
                        "partir de Paris",
                        "arriver de voyage"
                    ]
                },
                {
                    "sense_id": "5835259e-c5c9-3683-a02a-4fc801e11cc6",
                    "sense_definition": "S'emploie après une expression de quantité, de mesure ou un contenant pour désigner ce qui est compté ou contenu.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pourriez-vous me servir un verre <w>d'</w>eau fraîche s'il vous plaît ?"
                        },
                        {
                            "text": "Nous avons acheté deux kilos <w>de</w> pommes fraîches au marché ce matin."
                        }
                    ],
                    "common_phrases": [
                        "un verre de vin",
                        "beaucoup de temps",
                        "un peu de sucre",
                        "un kilo de fruits"
                    ]
                },
                {
                    "sense_id": "47d1077b-de52-30e5-84c6-309f4af94341",
                    "sense_definition": "Marque le point initial d'une durée, d'un horaire ou d'un intervalle temporel.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre bureau reste ouvert au public <w>de</w> neuf heures à dix-sept heures."
                        },
                        {
                            "text": "Il a plu sans arrêt <w>de</w> lundi matin jusqu'à vendredi soir."
                        }
                    ],
                    "common_phrases": [
                        "du matin au soir",
                        "de neuf heures à midi"
                    ]
                },
                {
                    "sense_id": "0cc93909-35d8-3d39-9822-256129e6e6e0",
                    "sense_definition": "Relie un verbe ou un adjectif régisseur à un infinitif complément.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "infinitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon médecin m'a fermement conseillé <w>d'</w>arrêter <w>de</w> fumer le plus vite possible."
                        },
                        {
                            "text": "Nous avons enfin décidé <w>de</w> rénover complètement notre cuisine cet été."
                        }
                    ],
                    "common_phrases": [
                        "décider de faire",
                        "essayer de comprendre",
                        "refuser de partir",
                        "oublier de fermer"
                    ]
                },
                {
                    "sense_id": "c0e93297-6ebc-3be2-8aea-eff0f2f2b7b5",
                    "sense_definition": "Indique la matière dont un objet est constitué, ou caractérise sa fonction et sa nature.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a choisi une magnifique table <w>de</w> bois massif pour son salon."
                        },
                        {
                            "text": "Le jeune homme rêve d'acheter une voiture <w>de</w> sport très puissante."
