    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5fbb980d-42ac-3bb5-8cd5-32acf659bad3",
                    "sense_definition": "An association of businesses, financial institutions, or investors for the purpose of engaging in a joint venture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The international <w>consortium</w> won the contract to build the new airport.",
                            "target_lang_translations": {
                                "ru": "Международный <w>консорциум</w> выиграл контракт на строительство нового аэропорта."
                            }
                        },
                        {
                            "text": "Several banks formed a <w>consortium</w> to provide the necessary funding for the project.",
                            "target_lang_translations": {
                                "ru": "Несколько банков сформировали <w>консорциум</w> для обеспечения необходимого финансирования проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "syndicate",
                        "alliance",
                        "coalition",
                        "partnership"
                    ],
                    "common_phrases": [
                        "international consortium",
                        "banking consortium",
                        "business consortium"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединение предприятий, финансовых институтов или инвесторов для осуществления совместного проекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консорциум",
                                "target_lang_sense_clarification": "временное объединение предприятий"
                            },
                            {
                                "target_lang_word": "синдикат",
                                "target_lang_sense_clarification": "группа для совместных финансовых операций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3ca0fc3-a91b-34e7-9a9f-5caf1fb2bc1b",
                    "sense_definition": "A cooperative arrangement among non-commercial institutions, such as universities or libraries.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university <w>consortium</w> allows students to access resources from all member campuses.",
                            "target_lang_translations": {
                                "ru": "Университетский <w>консорциум</w> позволяет студентам пользоваться ресурсами всех кампусов-участников."
                            }
                        },
                        {
                            "text": "A library <w>consortium</w> was established to share the costs of expensive digital subscriptions.",
                            "target_lang_translations": {
                                "ru": "Библиотечный <w>консорциум</w> был создан для совместной оплаты дорогостоящих цифровых подписок."
                            }
                        }
                    ],
                    "synonyms": [
                        "association",
                        "federation",
                        "union"
                    ],
                    "common_phrases": [
                        "university consortium",
                        "library consortium",
                        "research consortium"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соглашение о сотрудничестве между некоммерческими организациями, такими как университеты или библиотеки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консорциум",
                                "target_lang_sense_clarification": "объединение учебных или научных заведений"
                            },
                            {
                                "target_lang_word": "ассоциация",
                                "target_lang_sense_clarification": "союз организаций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f404a4ab-1b86-30a1-814e-094488443758",
                    "sense_definition": "The legal right of a spouse to the company, affection, and assistance of their partner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_rights",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plaintiff filed a lawsuit for loss of <w>consortium</w> after her husband's serious accident.",
                            "target_lang_translations": {
                                "ru": "Истица подала иск о потере <w>супружеского общения</w> после серьезной аварии, в которую попал ее муж."
                            }
                        },
                        {
                            "text": "Loss of <w>consortium</w> is a common claim in personal injury cases involving married couples.",
                            "target_lang_translations": {
                                "ru": "Утрата <w>консорциума</w> является распространенным требованием в делах о причинении вреда здоровью, касающихся супружеских пар."
                            }
