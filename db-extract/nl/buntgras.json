                                "example_id": "bb853f37-74a5-4d94-a920-c916b7c24d99",
                                "sense_id": "7a52e634-d067-33a2-b3b9-fbf04e976403",
                                "text": "Omdat heide, dat bestaat uit buntgras, de eigenschap heeft vuur snel te verspreiden, heeft de brandweer besloten groot alarm te slaan."
                            },
                            {
                                "example_id": "4050b999-d391-4c41-8ffc-14f2bb0746be",
                                "sense_id": "7a52e634-d067-33a2-b3b9-fbf04e976403",
                                "text": "Het veengebied is zeer drassig en nat. Hoe de brand heeft kunnen ontstaan wordt nog onderzocht. De ondergrond is weliswaar zeer nat, maar het buntgras erboven erg droog."
                            }
                        ]
