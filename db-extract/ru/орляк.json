                                        "examples": [
                                            {
                                                "example_id": "f7135724-dc91-4dc5-95d9-426bf1bb3693",
                                                "sense_id": "43dcd136-dc6e-3627-a940-d2c678e87ec8",
                                                "text": "Adlerfarne sind weltweit verbreitet."
                                            },
                                            {
                                                "example_id": "e3d4a7d1-f542-44b5-a744-abc7711d34f5",
                                                "sense_id": "43dcd136-dc6e-3627-a940-d2c678e87ec8",
                                                "text": "Die noch eingerollten Wedel des Adlerfarns können wie Spargel zubereitet werden."
                                            },
                                            {
                                                "example_id": "c2932fea-a923-48d7-b017-9d8fec61f597",
                                                "sense_id": "43dcd136-dc6e-3627-a940-d2c678e87ec8",
                                                "text": "„Bedeutung könnte dieses krebserzeugende Prinzip im Adlerfarn für den Menschen haben, da junger Adlerfarn z. B. in Japan als Gemüse oder Gewürz benutzt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b008905-fff7-3a00-8792-35058968547b",
                                        "entry_id": "fdc20cc3-8f16-3125-bd7d-b13756499ff6",
                                        "glosses": [
                                            "speziell der weltweit verbreitete Farn Pteridium aquilinum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "596eb985-1e77-475c-a86c-67c0564405dd",
                                                "sense_id": "6b008905-fff7-3a00-8792-35058968547b",
                                                "text": "Der Adlerfarn bildet oft dichte Bestände und kann so die Naturverjüngung im Wald hemmen."
                                            }
                                        ],
