{
    "word_family": [
        "transfixion"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b8e0156-b625-320c-9a68-5634ade2b850",
                    "sense_definition": "To render motionless with terror, amazement, or awe.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud explosion caused the audience to stand <w>transfixed</w> with fear.",
                            "target_lang_translations": {
                                "tr": "Yüksek sesli patlama seyircilerin korkudan <w>dona kalmasına</w> neden oldu."
                            }
                        },
                        {
                            "text": "The incredible magician seemed to <w>transfix</w> the crowd with his amazing tricks.",
                            "target_lang_translations": {
                                "tr": "İnanılmaz sihirbaz, harika numaralarıyla kalabalığı <w>büyülüyor</w> gibiydi."
                            }
                        }
                    ],
                    "synonyms": [
                        "fascinate",
                        "hypnotize",
                        "mesmerize",
                        "paralyze",
                        "petrify"
                    ],
                    "common_phrases": [
                        "transfix the crowd",
                        "transfix with fear"
                    ],
                    "target_lang_definitions": {
                        "tr": "Korku, şaşkınlık veya hayranlıktan hareketsiz bırakmak, dona kaldırtmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dondurmak",
                                "target_lang_sense_clarification": "korku veya şaşkınlıkla"
                            },
                            {
                                "target_lang_word": "dona kalmak",
                                "target_lang_sense_clarification": "hayret veya korkudan hareketsiz kalmak"
                            },
                            {
                                "target_lang_word": "büyülemek",
                                "target_lang_sense_clarification": "hayranlıkla odaklamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac169ab5-29d7-3c91-8871-ac51e6777520",
                    "sense_definition": "To pierce or impale through with a sharp object.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter managed to <w>transfix</w> the fish with a sharp wooden spear.",
                            "target_lang_translations": {
                                "tr": "Avcı, keskin ahşap bir mızrakla balığı <w>saplamayı</w> başardı."
                            }
                        },
                        {
                            "text": "An arrow threatened to <w>transfix</w> his arm as he raised it in defense.",
                            "target_lang_translations": {
                                "tr": "Savunmak için kolunu kaldırdığında bir ok kolunu <w>delip geçmekle</w> tehdit etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "impale",
                        "pierce",
                        "run through",
                        "spear"
                    ],
                    "common_phrases": [
                        "transfix with a spear"
                    ],
                    "target_lang_definitions": {
                        "tr": "Keskin bir nesneyle delip geçmek veya saplamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "saplamak",
                                "target_lang_sense_clarification": "keskin bir cisimle delip geçmek"
                            },
                            {
                                "target_lang_word": "delip geçmek",
                                "target_lang_sense_clarification": "mızrak veya ok gibi bir nesneyle"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f7a197a2-0af7-37f5-8ee4-a3bbb21b2709",
                    "sense_definition": "A discontinuous affix that attaches at more than one position within a root word.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Semitic linguistics, a <w>transfix</w> is inserted into a root to form new words.",
                            "target_lang_translations": {
                                "tr": "Sami dilbiliminde, yeni kelimeler türetmek için bir kökün içine <w>iç ek</w> yerleştirilir."
                            }
                        },
                        {
                            "text": "The professor explained how a <w>transfix</w> functions differently from a prefix or suffix.",
                            "target_lang_translations": {
                                "tr": "Profesör, bir <w>iç ekin</w> ön ek veya son ekten nasıl farklı işlediğini açıkladı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "linguistics terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kök bir sözcüğün içine birden fazla noktadan eklenen kesintili ek (iç ek)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "iç ek",
                                "target_lang_sense_clarification": "dilbilimde kök içine yerleşen ek"
                            },
                            {
                                "target_lang_word": "çapraz ek",
                                "target_lang_sense_clarification": "dilbilim terimi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}