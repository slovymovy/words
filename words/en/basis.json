{
    "word_family": [
        "basic",
        "basically",
        "baseless",
        "base"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c4051c9-65a0-3aef-bdc0-0d4d6e2edab4",
                    "sense_definition": "The frequency with which an event or activity happens.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "arrangement_or_frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should brush your teeth on a daily <w>basis</w>.",
                            "target_lang_translations": {
                                "ru": "Вам следует чистить зубы на ежедневной <w>основе</w>.",
                                "tr": "Dişlerinizi <w>günlük olarak</w> fırçalamalısınız."
                            }
                        },
                        {
                            "text": "The team meets on a weekly <w>basis</w> to discuss progress.",
                            "target_lang_translations": {
                                "ru": "Команда встречается на еженедельной <w>основе</w> для обсуждения прогресса.",
                                "tr": "Takım, ilerlemeyi tartışmak için <w>haftalık olarak</w> toplanıyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on a daily basis",
                        "on a regular basis",
                        "on a weekly basis",
                        "on a yearly basis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Частота или регулярность, с которой происходит событие или деятельность.",
                        "tr": "Bir olayın veya faaliyetin gerçekleşme sıklığı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осно́ва",
                                "target_lang_sense_clarification": "в выражениях частотности (на ... основе)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "esas",
                                "target_lang_sense_clarification": "sıklık ifadelerinde (... esasında/olarak)"
                            },
                            {
                                "target_lang_word": "temel",
                                "target_lang_sense_clarification": "düzenli aralıklarla yapılan işlerde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8abca3e7-71ab-3c16-8301-53cccb5bf9e8",
                    "sense_definition": "The system, arrangement, or principles used to organize an activity or process.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "arrangement_or_frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All our staff work on a voluntary <w>basis</w>.",
                            "target_lang_translations": {
                                "ru": "Все наши сотрудники работают на добровольной <w>основе</w>.",
                                "tr": "Tüm personelimiz gönüllülük <w>esasına göre</w> çalışmaktadır."
                            }
                        },
                        {
                            "text": "We review applications on a case-by-case <w>basis</w>.",
                            "target_lang_translations": {
                                "ru": "Мы рассматриваем заявки в индивидуальном порядке (на индивидуальной <w>основе</w>).",
                                "tr": "Başvuruları durum <w>bazında</w> değerlendiriyoruz."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on a voluntary basis",
                        "on a temporary basis",
                        "on a case-by-case basis",
                        "on a first-come-first-served basis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система, принцип или порядок, используемые для организации деятельности.",
                        "tr": "Bir faaliyeti veya süreci organize etmek için kullanılan sistem, düzenleme veya ilkeler."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осно́ва",
                                "target_lang_sense_clarification": "принцип организации (на ... основе)"
                            },
                            {
                                "target_lang_word": "нача́ло",
                                "target_lang_sense_clarification": "принцип (на общественных началах)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "esas",
                                "target_lang_sense_clarification": "çalışma veya uygulama düzeni (... esasına göre)"
                            },
                            {
                                "target_lang_word": "temel",
                                "target_lang_sense_clarification": "düzenleme veya çalışma prensibi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf7cff90-41a7-353d-9c32-9d0ca2df78b7",
                    "sense_definition": "The facts, ideas, or principles that support an argument, belief, or process; a justification.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "foundation_or_justification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no legal <w>basis</w> for the court's decision.",
                            "target_lang_translations": {
                                "ru": "У решения суда нет никаких правовых <w>оснований</w>.",
                                "tr": "Mahkemenin kararının hiçbir hukuki <w>dayanağı</w> yoktur."
                            }
                        },
                        {
                            "text": "Mutual respect should form the <w>basis</w> of any friendship.",
                            "target_lang_translations": {
                                "ru": "Взаимное уважение должно лечь в <w>основу</w> любой дружбы.",
                                "tr": "Karşılıklı saygı, her türlü dostluğun <w>temelini</w> oluşturmalıdır."
                            }
                        }
                    ],
                    "synonyms": [
                        "base"
                    ],
                    "common_phrases": [
                        "form the basis of",
                        "have no basis in",
                        "basis for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Факты, идеи или принципы, служащие обоснованием или поддержкой аргумента.",
                        "tr": "Bir iddiayı, inancı veya süreci destekleyen gerçekler, fikirler veya ilkeler; gerekçe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основа́ние",
                                "target_lang_sense_clarification": "обоснование, причина"
                            },
                            {
                                "target_lang_word": "осно́ва",
                                "target_lang_sense_clarification": "фундамент, суть"
                            },
                            {
                                "target_lang_word": "ба́за",
                                "target_lang_sense_clarification": "исходные данные, опора"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "temel",
                                "target_lang_sense_clarification": "dayanak, ana fikir"
                            },
                            {
                                "target_lang_word": "dayanak",
                                "target_lang_sense_clarification": "gerekçe, hukuki veya mantıksal taban"
                            },
                            {
                                "target_lang_word": "esas",
                                "target_lang_sense_clarification": "bir şeyin özü veya dayandığı ilke"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c554f7ec-9130-31ef-97e6-7d03dfb2c97a",
                    "sense_definition": "A physical base or foundation on which something rests.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "foundation_or_justification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy machine requires a solid concrete <w>basis</w>.",
                            "target_lang_translations": {
                                "ru": "Тяжелой машине требуется прочное бетонное <w>основание</w>.",
                                "tr": "Ağır makine sağlam bir beton <w>taban</w> gerektirir."
                            }
                        },
                        {
                            "text": "Ancient ruins provided the <w>basis</w> for the new structure.",
                            "target_lang_translations": {
                                "ru": "Древние руины послужили <w>основанием</w> для нового сооружения.",
                                "tr": "Antik kalıntılar yeni yapının <w>temelini</w> oluşturdu."
                            }
                        }
                    ],
                    "synonyms": [
                        "base"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая опора или фундамент, на котором держится объект.",
                        "tr": "Bir şeyin üzerine oturduğu fiziksel taban veya kaide."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основа́ние",
                                "target_lang_sense_clarification": "опорная часть"
                            },
                            {
                                "target_lang_word": "фунда́мент",
                                "target_lang_sense_clarification": "несущая конструкция"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "temel",
                                "target_lang_sense_clarification": "yapı veya nesnenin oturduğu alt kısım"
                            },
                            {
                                "target_lang_word": "taban",
                                "target_lang_sense_clarification": "fiziksel zemin, kaide"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74fb533b-e56b-3234-95a0-fad12fe25fd1",
                    "sense_definition": "The original cost of an asset, used to calculate capital gains or losses for tax purposes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to know your cost <w>basis</w> to report the profit correctly.",
                            "target_lang_translations": {
                                "ru": "Вам нужно знать свою базовую стоимость (<w>базу</w>), чтобы правильно отчитаться о прибыли.",
                                "tr": "Kârı doğru bildirmek için maliyet <w>esasınızı</w> bilmeniz gerekir."
                            }
                        },
                        {
                            "text": "Inherited property often receives a stepped-up <w>basis</w>.",
                            "target_lang_translations": {
                                "ru": "Унаследованное имущество часто получает повышенную налоговую <w>базу</w>.",
                                "tr": "Miras kalan mülk genellikle yükseltilmiş bir vergi <w>matrahı</w> alır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cost basis",
                        "adjusted basis"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Первоначальная стоимость актива, используемая для расчета налогов на прирост капитала.",
                        "tr": "Vergi amaçlarıyla sermaye kazançlarını veya kayıplarını hesaplamak için kullanılan bir varlığın ilk maliyeti."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ба́за",
                                "target_lang_sense_clarification": "налоговая база"
                            },
                            {
                                "target_lang_word": "сто́имость",
                                "target_lang_sense_clarification": "базовая стоимость"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "maliyet esası",
                                "target_lang_sense_clarification": "finans (vergiye esas değer)"
                            },
                            {
                                "target_lang_word": "matrah",
                                "target_lang_sense_clarification": "vergilendirmeye esas tutar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7256e745-470e-3428-85d0-ae2f0cbc71c3",
                    "sense_definition": "A set of linearly independent vectors that can represent every vector in a given vector space.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The standard <w>basis</w> for the plane consists of two unit vectors.",
                            "target_lang_translations": {
                                "ru": "Стандартный <w>базис</w> плоскости состоит из двух единичных векторов.",
                                "tr": "Düzlem için standart <w>taban</w> iki birim vektörden oluşur."
                            }
                        },
                        {
                            "text": "We must find a <w>basis</w> for the null space of the matrix.",
                            "target_lang_translations": {
                                "ru": "Мы должны найти <w>базис</w> для нуль-пространства матрицы.",
                                "tr": "Matrisin sıfır uzayı için bir <w>taban</w> bulmalıyız."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор линейно независимых векторов, через которые можно выразить любой вектор данного пространства.",
                        "tr": "Verilen bir vektör uzayındaki her vektörü temsil edebilen doğrusal bağımsız vektörler kümesi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ба́зис",
                                "target_lang_sense_clarification": "математика (линейная алгебра)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "taban",
                                "target_lang_sense_clarification": "lineer cebir"
                            },
                            {
                                "target_lang_word": "baz",
                                "target_lang_sense_clarification": "matematik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7fe6fe5-0726-3e1b-82e2-c1902c27eb2a",
                    "sense_definition": "The difference between the local cash price of a commodity and its futures price.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers track the <w>basis</w> to decide the best time to sell their grain.",
                            "target_lang_translations": {
                                "ru": "Фермеры отслеживают <w>базис</w>, чтобы выбрать лучшее время для продажи зерна.",
                                "tr": "Çiftçiler tahıllarını satmak için en iyi zamana karar vermek amacıyla fiyat <w>farkını</w> takip eder."
                            }
                        },
                        {
                            "text": "A strengthening <w>basis</w> suggests that local demand is increasing.",
                            "target_lang_translations": {
                                "ru": "Укрепляющийся <w>базис</w> говорит о росте локального спроса.",
                                "tr": "Güçlenen bir <w>baz farkı</w>, yerel talebin arttığını gösterir."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разница между ценой наличного товара (спот) и ценой фьючерса на него.",
                        "tr": "Bir malın yerel spot fiyatı ile vadeli işlem fiyatı arasındaki fark."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ба́зис",
                                "target_lang_sense_clarification": "финансы (разница цен)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "baz",
                                "target_lang_sense_clarification": "finans (spot ve vadeli fiyat farkı)"
                            },
                            {
                                "target_lang_word": "baz farkı",
                                "target_lang_sense_clarification": "finans"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21c707bb-a3c7-3f20-a37f-caf92277d70c",
                    "sense_definition": "A collection of subsets that generates a specific topology.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Open intervals form a <w>basis</w> for the standard topology on the real line.",
                            "target_lang_translations": {
                                "ru": "Открытые интервалы образуют <w>базу</w> стандартной топологии на вещественной прямой.",
                                "tr": "Açık aralıklar, gerçek doğru üzerindeki standart topoloji için bir <w>taban</w> oluşturur."
                            }
                        },
                        {
                            "text": "The student proved that the collection was a valid <w>basis</w>.",
                            "target_lang_translations": {
                                "ru": "Студент доказал, что эта совокупность является допустимой <w>базой</w>.",
                                "tr": "Öğrenci, bu koleksiyonun geçerli bir <w>taban</w> olduğunu kanıtladı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность подмножеств, порождающая определенную топологию.",
                        "tr": "Belirli bir topoloji oluşturan alt kümeler koleksiyonu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ба́за",
                                "target_lang_sense_clarification": "математика (топология)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "taban",
                                "target_lang_sense_clarification": "topoloji"
                            },
                            {
                                "target_lang_word": "baz",
                                "target_lang_sense_clarification": "matematik"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}