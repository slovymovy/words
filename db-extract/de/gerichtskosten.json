                                        "sense_id": "3eea3f39-4fb4-36b6-960f-a8ce1d4e383e",
                                        "entry_id": "e99cd3c5-410e-364b-a31b-8f9793a09360",
                                        "glosses": [
                                            "geld dat men moet betalen om een rechtszaak te kunnen voeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b997c33-48db-42aa-a15d-81940659713c",
                                                "sense_id": "3eea3f39-4fb4-36b6-960f-a8ce1d4e383e",
                                                "text": "Het hof heeft geen inhoudelijk oordeel over het onderzoeksrapport geveld. Jehovah's Getuigen moeten de proceskosten van de tegenpartijen van ruim 4700 euro betalen."
                                            },
                                            {
                                                "example_id": "40b4c866-438e-4116-8ad7-25cb5d893465",
                                                "sense_id": "3eea3f39-4fb4-36b6-960f-a8ce1d4e383e",
                                                "text": "In de rechtszaak die volgde oordeelde een rechter dat Anthony een boete van 100 dollar en de proceskosten moest betalen. \"Ik zal nooit een dollar betalen van deze onrechtvaardige straf\", reageerde de suffragette. Daar hield Anthony zich aan. De autoriteiten namen vervolgens nooit de moeite de boete te innen."
                                            }
                                        ]
                                    }
