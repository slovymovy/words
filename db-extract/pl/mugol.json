                        ]
                    },
                    {
                        "translation_id": "f1c76d1d-abe4-4235-b50f-16363443c645",
                        "source_entry_id": "5e34bd92-e4bd-3dcc-84ab-79fc58f2d748",
                        "source_sense_id": "b3e5448c-999e-3829-a20c-c9893b5aa4a8",
                        "target_lang_word": "babbano",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babbano",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "3c3a35ec-d603-313e-9556-ccaea8a8e6ef",
                                        "entry_id": "903598e6-16ab-3289-b7be-2f5aabd79bea",
