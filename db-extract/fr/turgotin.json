                        "entry_id": "c4465562-76f3-32cf-9823-4a22617e2cb8",
                        "glosses": [
                            "Élève du lycée Turgot de Paris."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a85e73ae-ba19-4841-9e84-6aaa9358b182",
                                "sense_id": "3689ccad-1379-37e9-ac25-ea5ea2479844",
                                "text": "Face d’âne ! C’est pas la peine de faire le malin avec ta casquette dorée de Turgotin. Qu’est-ce qu’on t’apprend. dans ta boîte ?"
                            }
                        ]
