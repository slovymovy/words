                "senses": [
                    {
                        "sense_id": "a577babb-3852-3d58-984c-6553945de5cb",
                        "entry_id": "cded8b9a-fc26-3e74-92be-a617ded898ea",
                        "glosses": [
                            "Se décontaminer tout seul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c24649fa-cfdc-4d8b-8c0b-31fb39e507b5",
                                "sense_id": "a577babb-3852-3d58-984c-6553945de5cb",
                                "text": "La grande spécificité de ce purificateur est que le filtre s’autodécontamine et n’a besoin d'être remplacé (58 €) que tous les 4 000 heures."
                            },
                            {
                                "example_id": "b10b3d59-c2ca-4cf7-8210-39b34effd42c",
                                "sense_id": "a577babb-3852-3d58-984c-6553945de5cb",
                                "text": "Elle est en train de mettre au point une tenue qui s’autodécontamine sous l’effet des rayons du soleil."
                            },
                            {
                                "example_id": "89461dfe-86e7-48fb-9749-50fada18f54a",
                                "sense_id": "a577babb-3852-3d58-984c-6553945de5cb",
                                "text": "Consacrant plus de 10 % de son chiffre d’affaires à la recherche, Ouvry a mis au point des textiles qui « s’autodécontaminent », y compris lorsque confrontés aux gaz les plus toxiques comme le Vx."
                            }
                        ]
                    }
