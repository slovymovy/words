    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d5c1dbf3-c011-3385-9951-6a2082d56252",
                    "sense_definition": "present participle and gerund of <w>moan</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moan_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was quietly <w>moaning</w> in pain until the medication took effect.",
                            "target_lang_translations": {
                                "de": "Der Patient <w>stöhnte</w> leise vor Schmerzen, bis das Medikament Wirkung zeigte."
                            }
                        },
                        {
                            "text": "Stop <w>moaning</w> about the bad weather and help me carry these boxes inside.",
                            "target_lang_translations": {
                                "de": "Hör auf, dich über das schlechte Wetter zu <w>beklagen</w>, und hilf mir, diese Kisten hineinzutragen."
                            }
                        }
                    ],
                    "synonyms": [
                        "groaning",
                        "whining",
                        "complaining"
                    ],
                    "common_phrases": [
                        "stop moaning",
                        "keep moaning",
                        "moaning and groaning"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von „moan“ (stöhnen, klagen, nörgeln)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "stöhnend",
                                "target_lang_sense_clarification": "vor Schmerz oder Vergnügen"
                            },
                            {
                                "target_lang_word": "jammernd",
                                "target_lang_sense_clarification": "beklagend, nörgelnd"
                            },
                            {
                                "target_lang_word": "Meckern",
                                "target_lang_sense_clarification": "als Gerundium: das sich Beklagen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98932318-99ff-3442-82e4-507fbd7d3bac",
                    "sense_definition": "The act of uttering a moan, or a prolonged low sound of pain, grief, or lamentation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "moan_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>moaning</w> of the wind kept everyone awake throughout the stormy night.",
                            "target_lang_translations": {
                                "de": "Das ständige <w>Heulen</w> des Windes hielt die ganze stürmische Nacht über alle wach."
                            }
                        },
                        {
                            "text": "We could hear the faint <w>moaning</w> of the injured animal behind the bushes.",
                            "target_lang_translations": {
                                "de": "Wir konnten das schwache <w>Wimmern</w> des verletzten Tieres hinter den Büschen hören."
                            }
                        }
                    ],
                    "synonyms": [
                        "groaning",
                        "wailing",
                        "lamentation"
                    ],
                    "common_phrases": [
                        "constant moaning"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Ausstoßen eines Stöhnens oder ein langanhaltender, tiefer Laut des Schmerzes, der Trauer oder Klage; auch das Heulen des Windes"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stöhnen",
                                "target_lang_sense_clarification": "Laut vor Schmerz oder Erschöpfung"
                            },
                            {
                                "target_lang_word": "Jammern",
                                "target_lang_sense_clarification": "Klagen oder Wehklage"
                            },
                            {
                                "target_lang_word": "Heulen",
                                "target_lang_sense_clarification": "des Windes"
                            }
                        ]
                    }
                }
            ]
        }
    ]
