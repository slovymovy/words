{
    "word_family": [
        "gnawer",
        "gnawing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4fac8dc2-1c3f-3fa8-aeb3-42660e402ecc",
                    "sense_definition": "To bite or chew on something persistently, especially something tough or hard.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry dog began to <w>gnaw</w> a bone until it finally broke in two.",
                            "target_lang_translations": {
                                "ru": "Голодная собака принялась <w>грызть</w> кость, пока та наконец не разломилась надвое."
                            }
                        },
                        {
                            "text": "Rats will often <w>gnaw</w> through wood to find a way into a building.",
                            "target_lang_translations": {
                                "ru": "Крысы часто <w>прогрызают</w> дерево, чтобы найти путь в здание."
                            }
                        }
                    ],
                    "synonyms": [
                        "chew",
                        "nibble",
                        "masticate"
                    ],
                    "common_phrases": [
                        "gnaw a bone",
                        "gnaw through wood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно кусать или жевать что-либо, особенно что-то твердое или жесткое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грызть",
                                "target_lang_sense_clarification": "зубами"
                            },
                            {
                                "target_lang_word": "глодать",
                                "target_lang_sense_clarification": "обгладывать кость или кору"
                            },
                            {
                                "target_lang_word": "прогрызать",
                                "target_lang_sense_clarification": "делать отверстие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d46e5f4b-ee57-3603-bbdc-37aff0d37f6a",
                    "sense_definition": "To cause persistent and excessive anxiety, worry, or emotional pain over time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her critical comment started to <w>gnaw</w> at me all day until I couldn't focus.",
                            "target_lang_translations": {
                                "ru": "Её критическое замечание начало <w>изводить</w> меня весь день, пока я не потерял способность сосредоточиться."
                            }
                        },
                        {
                            "text": "The guilt of his mistake continued to <w>gnaw</w> at his conscience for years.",
                            "target_lang_translations": {
                                "ru": "Вина за совершенную ошибку продолжала <w>грызть</w> его совесть долгие годы."
                            }
                        }
                    ],
                    "synonyms": [
                        "plague",
                        "trouble",
                        "torment",
                        "erode"
                    ],
                    "antonyms": [
                        "soothe",
                        "comfort"
                    ],
                    "common_phrases": [
                        "gnaw at me",
                        "gnaw at the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать постоянное и чрезмерное беспокойство, тревогу или эмоциональную боль в течение долгого времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глодать",
                                "target_lang_sense_clarification": "о чувствах, например, тоска гложет"
                            },
                            {
                                "target_lang_word": "грызть",
                                "target_lang_sense_clarification": "о совести или беспокойстве"
                            },
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "мучить"
                            },
                            {
                                "target_lang_word": "изводить",
                                "target_lang_sense_clarification": "досаждать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1aff463-5d11-3c06-a47c-dd17ce107e00",
                    "sense_definition": "To gradually wear away, corrode, or waste something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salt air will slowly <w>gnaw</w> away the metal railings on the pier.",
                            "target_lang_translations": {
                                "ru": "Соленый воздух будет медленно <w>разъедать</w> металлические перила на пирсе."
                            }
                        },
                        {
                            "text": "Years of neglect had allowed rust to <w>gnaw</w> away at the old engine.",
                            "target_lang_translations": {
                                "ru": "Годы небрежного отношения позволили ржавчине <w>подточить</w> старый двигатель."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrode",
                        "erode",
                        "consume"
                    ],
                    "common_phrases": [
                        "gnaw away at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно разрушать, разъедать или истощать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъедать",
                                "target_lang_sense_clarification": "о коррозии или соли"
                            },
                            {
                                "target_lang_word": "подтачивать",
                                "target_lang_sense_clarification": "постепенно разрушать"
                            },
                            {
                                "target_lang_word": "разрушать",
                                "target_lang_sense_clarification": "постепенно"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37892519-6d20-3c64-8bce-ec6673aeb53f",
                    "sense_definition": "The act or instance of biting or chewing on something persistently.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy gave the toy a quick <w>gnaw</w> before running into the other room.",
                            "target_lang_translations": {
                                "ru": "Щенок быстро <w>погрыз</w> игрушку, прежде чем убежать в другую комнату."
                            }
                        },
                        {
                            "text": "He let the dog have a <w>gnaw</w> of a bone to keep it occupied.",
                            "target_lang_translations": {
                                "ru": "Он дал собаке <w>поглодать</w> кость, чтобы чем-то её занять."
                            }
                        }
                    ],
                    "synonyms": [
                        "chew",
                        "bite"
                    ],
                    "common_phrases": [
                        "gnaw of a bone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или случай постоянного кусания или жевания чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грызение",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "обгладывание",
                                "target_lang_sense_clarification": "действие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}