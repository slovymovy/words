                ],
                "senses": [
                    {
                        "sense_id": "9d016daa-0330-3784-a7da-63977f107c30",
                        "entry_id": "1e5a3daa-7328-39ef-9277-1fadc22c2b01",
                        "glosses": [
                            "regularne, najczęściej nadmierne, udostępnianie zdjęć, filmów czy opisów życia własnego dziecka (zazwyczaj na tyle młodego, by nie było w stanie wyrazić na to zgody) w mediach społecznościowych"
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "17eb28cd-2219-4ca5-9237-6360ca84d7ce",
                                "sense_id": "9d016daa-0330-3784-a7da-63977f107c30",
                                "text": "A później dzieci będą pozywać rodziców za sharenting, który może być bezlitośnie wykorzystywany przez rówieśników w późniejszych latach, a wiadomo - w sieci nic nie ginie"
                            },
                            {
                                "example_id": "4421d24a-efb9-4e0d-8954-251d13a69514",
                                "sense_id": "9d016daa-0330-3784-a7da-63977f107c30",
                                "text": "Czytaj: monetyzuję moje dziecko w internecie, więc zakładam fundację, żeby promować sharenting jako coś korzystnego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1833e52-1521-42be-b4de-e9619754384f",
                        "source_entry_id": "1e5a3daa-7328-39ef-9277-1fadc22c2b01",
                        "source_sense_id": "9d016daa-0330-3784-a7da-63977f107c30",
                        "target_lang_word": "sharenting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sharenting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1071174b-139a-3c0f-8fc3-e900fd5951fd",
                                        "entry_id": "87eb8d08-c21f-36c0-8e4f-406e90b6053a",
                                        "glosses": [
                                            "The practice of parents documenting their child's upbringing on social media, typically by posting photographs, anecdotes, etc."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c49d7435-f731-4e1a-8565-bfdbf0e01720",
                                                "sense_id": "1071174b-139a-3c0f-8fc3-e900fd5951fd",
                                                "text": "Others feel that the advantages of sharenting far outweigh any negatives. In an increasingly fragmented society, social media allows us to stay connected to friends and family, and get support that for many is not easily accessible."
                                            },
                                            {
                                                "example_id": "95ced612-8af8-471b-992c-8e3137c44b4a",
                                                "sense_id": "1071174b-139a-3c0f-8fc3-e900fd5951fd",
                                                "text": "Then there’s “sharenting.” Today, many children’s social media presence starts with a sonogram, posted, obviously, without consent."
                                            },
                                            {
                                                "example_id": "f903248c-8ab7-4cda-b645-6e7ca4a6dcfc",
                                                "sense_id": "1071174b-139a-3c0f-8fc3-e900fd5951fd",
                                                "text": "On a philosophical level, sharenting exposes children to the larger digital world without their consent, robbing them of a kind of agency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
