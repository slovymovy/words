                    "sense_definition": "Iets als aangenaam of prettig ervaren; in de smaak vallen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pleasing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het nieuwe werk <w>bevalt</w> hem erg goed.",
                            "target_lang_translations": {
                                "en": "The new job <w>suits</w> him very well.",
                                "ru": "Новая работа ему очень <w>нравится</w>.",
                                "fr": "Le nouveau travail lui <w>plaît</w> beaucoup.",
                                "pl": "Nowa praca bardzo mu <w>odpowiada</w>.",
                                "de": "Die neue Arbeit <w>gefällt</w> ihm sehr gut.",
                                "it": "Il nuovo lavoro gli <w>piace</w> molto.",
                                "cs": "Nová práce se mu velmi <w>líbí</w>.",
                                "tr": "Yeni işi ona çok <w>iyi geliyor</w>.",
                                "es": "El nuevo trabajo le <w>gusta</w> mucho.",
                                "zh": "他非常<w>喜欢</w>这份新工作。"
                            }
                        },
                        {
                            "text": "Die arrogante houding <w>beviel</w> mij helemaal niet.",
                            "target_lang_translations": {
                                "en": "That arrogant attitude did not <w>please</w> me at all.",
                                "ru": "Это высокомерное отношение мне совсем не <w>понравилось</w>.",
                                "fr": "Cette attitude arrogante ne m'a pas du tout <w>plu</w>.",
                                "pl": "To aroganckie zachowanie w ogóle mi się nie <w>podobało</w>.",
                                "de": "Diese arrogante Haltung hat mir überhaupt nicht <w>gefallen</w>.",
                                "it": "Quell'atteggiamento arrogante non mi è <w>piaciuto</w> affatto.",
                                "cs": "To arogantní chování se mi vůbec <w>nelíbilo</w>.",
                                "tr": "O kibirli tavır hiç <w>hoşuma gitmedi</w>.",
                                "es": "Esa actitud arrogante no me <w>agradó</w> en absoluto.",
                                "zh": "那种傲慢的态度我一点也不<w>喜欢</w>。"
                            }
                        }
                    ],
                    "synonyms": [
