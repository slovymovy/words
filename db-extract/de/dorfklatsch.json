                "senses": [
                    {
                        "sense_id": "b54c3e2d-6965-325d-b34b-2db714f0ee47",
                        "entry_id": "9194459c-2abd-321b-b9c5-5066afe3a51d",
                        "glosses": [
                            "Klatsch, der in einem Dorf herrscht"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "a96f3bf1-be3f-4624-93f5-054c6536d1e3",
                                "sense_id": "b54c3e2d-6965-325d-b34b-2db714f0ee47",
                                "text": "„Nirgends sonst wurde ihre Lust an der Katastrophe so zuverlässig bedient, Desaster weltweit, täglich frisch, da kam kein Dorfklatsch mit.“"
                            },
                            {
                                "example_id": "6d9a2f7e-fadc-4014-8b3e-d7464fc968d8",
                                "sense_id": "b54c3e2d-6965-325d-b34b-2db714f0ee47",
                                "text": "„Jahrhunderte lebten von tolldreisten Liebschafts- und Skandalgeschichten, die es mit jedem lüsternen Dorfklatsch aufnehmen.“"
                            },
                            {
                                "example_id": "e4822a08-d238-40c6-ad8c-630a19725c6c",
                                "sense_id": "b54c3e2d-6965-325d-b34b-2db714f0ee47",
                                "text": "„Doch dieser müßige Dorfklatsch interessierte den Schrecklichen Alten Mann überhaupt nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
