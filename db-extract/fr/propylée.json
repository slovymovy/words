                        "entry_id": "f7971eca-417c-3460-9aae-1edab29c434f",
                        "glosses": [
                            "Vestibule conduisant à un temple grécoromain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c941c7d9-5086-41a7-9fc7-16bd740f383b",
                                "sense_id": "7d782597-4c47-3bb0-a7c9-1171dc2dab09",
                                "text": "Le propylée occidental de l’agora romaine a été construit entre 19 et 11 av. J.-C., et possédait une rangée de quatre colonnes ioniques."
                            }
                        ]
                    },
                    {
                        "sense_id": "9eb05241-4a51-3293-bab5-808989ca589d",
                        "entry_id": "f7971eca-417c-3460-9aae-1edab29c434f",
                        "glosses": [
                            "Entrée monumentale, porche ou vestibule situé à l’entrée d’un temple ou d’un lieu public."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c9ad9afb-9710-3f87-ab5f-76d0a790ee44",
                        "entry_id": "f7971eca-417c-3460-9aae-1edab29c434f",
                        "glosses": [
                            "(Surtout au pluriel) Édifice formé de plusieurs portes et orné de colonnes, constituant l’entrée monumentale d’un sanctuaire ou d’une citadelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69506296-878f-43aa-b9d6-7b32cc0b9aa8",
                                "sense_id": "c9ad9afb-9710-3f87-ab5f-76d0a790ee44",
                                "text": "Les propylées de Sounion, d’Éleusis."
                            },
                            {
                                "example_id": "2ca54c38-8aa7-40ce-a0e5-3cac29b70c22",
                                "sense_id": "c9ad9afb-9710-3f87-ab5f-76d0a790ee44",
                                "text": "Les propylées d’Athènes bâtis à l’entrée de l’Acropole de 437 à 432 av. J.-C. par l’architecte Mnésiclès."
                            }
                        ]
                    },
                    {
                        "sense_id": "d360282a-bf5c-3eb1-aba7-677b11a545e5",
                        "entry_id": "f7971eca-417c-3460-9aae-1edab29c434f",
                        "glosses": [
                            "Édifices érigés de 1783 à 1789 par Claude Nicolas Ledoux aux portes d’entrée du nouveau mur d’octroi dit de la Ferme générale (1786)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ce0a7c3-e63c-45e3-8f4e-9f9e5456170d",
                                "sense_id": "d360282a-bf5c-3eb1-aba7-677b11a545e5",
                                "text": "Les propylées de Paris 1785-1788."
                            }
                        ]
