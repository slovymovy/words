                "senses": [
                    {
                        "sense_id": "d92c6b4e-10df-3020-a2df-97edf0f721df",
                        "entry_id": "22374caf-ec04-3b8f-b627-3902d55e90f2",
                        "glosses": [
                            "Qui est de couleur à peu près semblable à celle du tan, qui est d’une sorte de brun roux. #A75502"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c0f1193-bbed-445c-a6cc-d1cafe4c3ca0",
                                "sense_id": "d92c6b4e-10df-3020-a2df-97edf0f721df",
                                "text": "Une peau tannée."
                            },
                            {
                                "example_id": "e10980cd-d047-484e-9e60-7220aaa05e24",
                                "sense_id": "d92c6b4e-10df-3020-a2df-97edf0f721df",
                                "text": "Un visage tanné."
                            },
                            {
                                "example_id": "93607e8b-3b86-4085-ab0c-0d3075a95736",
                                "sense_id": "d92c6b4e-10df-3020-a2df-97edf0f721df",
                                "text": "Un collet en point de Venise se rabattait sur sa veste de brocart d’or, et son linge d’une blancheur éblouissante soulevé par un abdomen assez proéminent débordait et couvrait la ceinture d’un haut-de-chausses en velours tanné ; un manteau de même couleur, galonné d’or, jeté négligemment, se drapait au dos du siège."
                            }
                        ]
                    },
                    {
                        "sense_id": "c490fec6-69f3-3c33-9185-f0e94b3ac451",
                        "entry_id": "22374caf-ec04-3b8f-b627-3902d55e90f2",
                        "glosses": [
                            "Épuisé de fatigue physique."
                        ],
                        "tags": [
                            "Nord de la France",
                            "Champagne"
                        ],
                        "examples": [
                            {
                                "example_id": "b2ad365f-2c2a-4ea5-a891-9e27a9464c7d",
                                "sense_id": "c490fec6-69f3-3c33-9185-f0e94b3ac451",
                                "text": "La journée a été dure, je suis tanné."
                            }
                        ]
                    },
                    {
                        "sense_id": "1443731d-e405-3d01-b225-2c4f83b3144f",
                        "entry_id": "22374caf-ec04-3b8f-b627-3902d55e90f2",
                        "glosses": [
                            "Ennuyé, exaspéré."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "48bd52ae-d519-4e9e-847f-ea2b48ffcef2",
                                "sense_id": "1443731d-e405-3d01-b225-2c4f83b3144f",
                                "text": "On chiale parce qu’on est tannés de regarder Netflix, tannés de pitonner sur nos cellulaires, tannés de lire, d’écouter de la musique, tannés des jeux de société, tannés de travailler de la maison."
                            },
                            {
                                "example_id": "cf6f10b2-b0b4-43b4-a69a-c0e4153c2bfd",
                                "sense_id": "1443731d-e405-3d01-b225-2c4f83b3144f",
                                "text": "« C’est un lien important pour le quartier. Les gens ici sont tannés de toutes ces fermetures », affirme M. Germain."
                            },
                            {
                                "example_id": "7cce52ec-4e93-447b-b471-92782b43d4f2",
                                "sense_id": "1443731d-e405-3d01-b225-2c4f83b3144f",
                                "text": "Être tanné, c’est en avoir assez."
                            }
                        ]
                    },
                    {
                        "sense_id": "85707b4b-f7d0-34f8-976d-ff8ad1485791",
                        "entry_id": "22374caf-ec04-3b8f-b627-3902d55e90f2",
                        "glosses": [
                            "Voir de tanné."
                        ],
                        "tags": [],
                        "examples": []
                    }
