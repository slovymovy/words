                "senses": [
                    {
                        "sense_id": "e086e1f1-9c8b-3786-9ad3-97f0012680b0",
                        "entry_id": "9071d83e-fa0b-3b24-a1f9-0dfb67f804ca",
                        "glosses": [
                            "Personne qui s’occupe des bagages dans un aéroport ou dans un hôtel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d8c3ab2-03ce-4b0a-afbb-fdc38b3182c2",
                                "sense_id": "e086e1f1-9c8b-3786-9ad3-97f0012680b0",
                                "text": "Une fois les chariots chargés, un bagagiste tractoriste les amène à l’avion en conduisant un engin spécial à la conduite sur piste et galeries."
                            },
                            {
                                "example_id": "227d27ff-9717-4b06-a13c-9ee1e4d8e839",
                                "sense_id": "e086e1f1-9c8b-3786-9ad3-97f0012680b0",
                                "text": "Le bagagiste sort les bagages du véhicule, et les transporte jusqu’à la chambre, qu’il fait visiter aux clients."
                            }
                        ]
                    },
                    {
                        "sense_id": "94560410-a68a-3a64-83a1-e9137e4b4db3",
                        "entry_id": "9071d83e-fa0b-3b24-a1f9-0dfb67f804ca",
                        "glosses": [
                            "Personne chargée de transporter les denrées, les sacs ou les bagagistes, dans les marchés."
                        ],
                        "tags": [
                            "Côte d’Ivoire"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "56f42e57-5ce4-35f8-85da-0a1f38c8b4cc",
                        "entry_id": "9071d83e-fa0b-3b24-a1f9-0dfb67f804ca",
                        "glosses": [
                            "Fabricant de bagages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d35e46d7-0808-4db3-9050-2e3c57c79391",
                                "sense_id": "56f42e57-5ce4-35f8-85da-0a1f38c8b4cc",
                                "text": "François-Louis Vuitton, héritier du célèbre bagagiste, le couturier Cerruti, de nombreux banquiers et chefs d’entreprise, des artistes connus y déjeunent régulièrement."
                            }
                        ]
                    }
