                        ],
                        "examples": [
                            {
                                "example_id": "78671d5a-e63c-4d40-9e0e-080232bce22a",
                                "sense_id": "6bc688f5-fc69-3cf9-a99a-a695c0d091c4",
                                "text": "„Pompfinebrer (Pompfünebrer; von französisch pompe funebre, Begräbnisprunk), volkstümliche Bezeichnung für die schwarz, früher prunkvoll livrierten Bediensteten von Wiener Leichenbestattungsunternehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
