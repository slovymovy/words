                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7e471be-28d0-42dd-b004-0974c8bae181",
                        "source_entry_id": "b2215b89-f799-3600-916f-28c483f63a12",
                        "source_sense_id": "05627130-cd6f-356e-9fdd-1b9350528d56",
                        "source_sense_description": "одинаково",
                        "target_lang_word": "equal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1d2777f-ac6d-38ac-8c36-7eec37593f74",
                                        "entry_id": "b015ab16-8b83-3578-a906-3f1407aaa433",
                                        "glosses": [
                                            "The same in one or more respects."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b91cb3e-b754-4c2b-a85d-c3bfe5293d39",
                                                "sense_id": "e1d2777f-ac6d-38ac-8c36-7eec37593f74",
                                                "text": "Near-synonyms: equivalent; see also Thesaurus:equal"
                                            },
                                            {
                                                "example_id": "cbac93c2-2500-42ed-a65e-349716a8bd3e",
                                                "sense_id": "e1d2777f-ac6d-38ac-8c36-7eec37593f74",
                                                "text": "Dr. [Eugenia] Cheng's latest book, Unequal: The Math of When Things Do and Don’t Add Up, is all about equations and will be released in the United States on Tuesday. But it is more than a regurgitation of the many formulas you may recall learning in high school. In the book, Dr. Cheng argues that an equation — in its barest sense, a declaration that two things are equal — can be a profound statement on the choices we make about what is or is not the same. For example, 2 × 3 may equal 3 × 2. But two packs of three cookies each is distinct from three packs of two cookies each. A cube drawn face-on versus from one edge looks different, though we understand the two shapes to be the same. \"Almost everything can be considered equal and unequal at the same time,\" Dr. Cheng wrote. \"And it's up to us what we do about it.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40be55b2-2c5f-3381-bf52-1ae7f0e3e1aa",
                                        "entry_id": "b015ab16-8b83-3578-a906-3f1407aaa433",
                                        "glosses": [
                                            "The same in one or more respects.",
                                            "The same in value (status, merit, etc): having or deserving the same rights or treatment."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9efe53f-c6a0-472b-97b5-7fd7e1e3ef4d",
                                                "sense_id": "40be55b2-2c5f-3381-bf52-1ae7f0e3e1aa",
                                                "text": "We hold that all men are created equal and are thus equal under the law."
                                            },
                                            {
                                                "example_id": "8ecac59e-7c1a-4859-85c9-e148ae5e0e90",
                                                "sense_id": "40be55b2-2c5f-3381-bf52-1ae7f0e3e1aa",
                                                "text": "[Under] the combat exclusion [preventing women from serving in combat...] Women are not equal citizens; women are a certain kind of citizen, a separate class with distinctly lower status."
                                            },
                                            {
                                                "example_id": "6d6c8858-2c99-4c77-ab42-550b57ef0ee4",
                                                "sense_id": "40be55b2-2c5f-3381-bf52-1ae7f0e3e1aa",
                                                "text": "[…] women and men should be equal regarding civil rights / the right to occupational work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3585ae84-ba0e-379c-9d2c-e40e11867a66",
                                        "entry_id": "b015ab16-8b83-3578-a906-3f1407aaa433",
                                        "glosses": [
                                            "The same in one or more respects.",
                                            "The same in all respects that matter practically; interchangeable, fungible, or (even sometimes) identical for practical purposes."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fbd157c-f674-4165-94d1-b3b7966afa9f",
                                                "sense_id": "3585ae84-ba0e-379c-9d2c-e40e11867a66",
                                                "text": "Equal conditions should produce equal results."
                                            },
                                            {
                                                "example_id": "073308ce-0977-4d21-9a36-1a9ba79fc390",
                                                "sense_id": "3585ae84-ba0e-379c-9d2c-e40e11867a66",
                                                "text": "All else being equal, we can expect this factor to have no discernible effect by itself."
                                            },
                                            {
                                                "example_id": "f93549ff-cb9b-420b-9c37-a36f11b63433",
                                                "sense_id": "3585ae84-ba0e-379c-9d2c-e40e11867a66",
                                                "text": "They who are not disposed to receive them may let them alone or reject them; it is equal to me."
                                            },
                                            {
                                                "example_id": "fe6c922d-66da-43aa-b52e-d091c2c32b93",
                                                "sense_id": "3585ae84-ba0e-379c-9d2c-e40e11867a66",
                                                "text": "I now believe that evolution, or deevolution, never ends short of death, that no society has ever achieved an absolute pinnacle, that all humans are not created equal. In fact, I believe attempts to create some abstract equalization create a morass of injustices that rebound on the equalizers. Equal justice and equal opportunity are ideals we should seek, but we should recognize that humans administer the ideals and that humans do not have equal ability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df4c2e4-b6f8-3d41-af1d-8e450fc6d0e8",
                                        "entry_id": "b015ab16-8b83-3578-a906-3f1407aaa433",
                                        "glosses": [
                                            "The same in one or more respects.",
                                            "Exactly identical, having the same value."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e028874-079d-4653-9564-605f68dfb66f",
                                                "sense_id": "8df4c2e4-b6f8-3d41-af1d-8e450fc6d0e8",
                                                "text": "All right angles are equal."
                                            },
                                            {
                                                "example_id": "c502e1a7-b81e-47f3-a182-ef606fbd3d9a",
                                                "sense_id": "8df4c2e4-b6f8-3d41-af1d-8e450fc6d0e8",
                                                "text": "The skipper Mr. Cooke had hired at Far Harbor was a God-fearing man with a luke warm interest in his new billet and employer, and had only been prevailed upon to take charge of the yacht after the offer of an emolument equal to half a year's sea pay of an ensign in the navy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "579220a5-1168-3a87-b32c-1e7c09de6f61",
                                        "entry_id": "b015ab16-8b83-3578-a906-3f1407aaa433",
                                        "glosses": [
                                            "Fair, impartial."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b338cfca-6437-431f-b0d6-e81453db434f",
                                                "sense_id": "579220a5-1168-3a87-b32c-1e7c09de6f61",
                                                "text": "it could not but much redound to the lustre of your milde and equall Government, when as private persons are hereby animated to thinke ye better pleas'd with publick advice, then other statists have been delighted heretofore with publicke flattery."
                                            },
                                            {
                                                "example_id": "c922b176-492d-4cac-ae29-2dadc3746c68",
                                                "sense_id": "579220a5-1168-3a87-b32c-1e7c09de6f61",
                                                "text": "Are not my ways equal?"
                                            },
                                            {
                                                "example_id": "db625fea-3a39-49ae-9c1c-5657284dfdf3",
                                                "sense_id": "579220a5-1168-3a87-b32c-1e7c09de6f61",
                                                "text": "Thee, O Jove, no equall judge I deem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a6c4ec4-6c06-38d8-b25a-0c022c0d6870",
                                        "entry_id": "b015ab16-8b83-3578-a906-3f1407aaa433",
                                        "glosses": [
                                            "Adequate; sufficiently capable or qualified."
                                        ],
                                        "tags": [
                                            "comparable",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f110ab91-af5f-427c-89e6-f082aa974db8",
                                                "sense_id": "4a6c4ec4-6c06-38d8-b25a-0c022c0d6870",
                                                "text": "This test is pretty tough, but I think I'm equal to it."
                                            },
                                            {
                                                "example_id": "423b8301-b51e-487c-9eb4-1e45010c5a1b",
                                                "sense_id": "4a6c4ec4-6c06-38d8-b25a-0c022c0d6870",
                                                "text": "Here was a man some twenty thousand miles from home, by the way of Cape Horn, that is—which was the only way he could get there—thrown among people as strange to him as though he were in the planet Jupiter; and yet he seemed entirely at his ease; preserving the utmost serenity; content with his own companionship; always equal to himself."
                                            },
                                            {
                                                "example_id": "43189627-acc4-4742-bff8-3cc87b2c1082",
                                                "sense_id": "4a6c4ec4-6c06-38d8-b25a-0c022c0d6870",
                                                "text": "her comprehension was certainly more equal to the covert meaning, the superior intelligence, of those five letters so arranged."
                                            },
                                            {
                                                "example_id": "9f728db7-da3e-4531-a141-136df5d53c3a",
                                                "sense_id": "4a6c4ec4-6c06-38d8-b25a-0c022c0d6870",
                                                "text": "The Scots trusted not their own numbers as equal to fight with the English."
                                            },
                                            {
                                                "example_id": "a30dc274-87d8-495d-8940-7229f5c46032",
                                                "sense_id": "4a6c4ec4-6c06-38d8-b25a-0c022c0d6870",
                                                "text": "much less is it in my power to make my commendations equal to your merits."
                                            },
                                            {
                                                "example_id": "f7d5ef57-68ee-4a23-98a4-f08d8c4d023d",
                                                "sense_id": "4a6c4ec4-6c06-38d8-b25a-0c022c0d6870",
                                                "text": "[…]whose voice an equal messenger / Conveyed thy meaning mild."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23a692a9-acf3-35bf-a0ba-5f70426aff6a",
                                        "entry_id": "b015ab16-8b83-3578-a906-3f1407aaa433",
                                        "glosses": [
                                            "Not variable; equable; uniform; even."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a76c927-0f59-4731-8e74-f96e2601824a",
                                                "sense_id": "23a692a9-acf3-35bf-a0ba-5f70426aff6a",
                                                "text": "an equal movement"
                                            },
                                            {
                                                "example_id": "9ba119f5-adce-4748-a21f-cb502c466aa7",
                                                "sense_id": "23a692a9-acf3-35bf-a0ba-5f70426aff6a",
                                                "text": "an equal temper"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "224a2549-095b-3b6e-8ea1-4a9a4f88d498",
                                        "entry_id": "b015ab16-8b83-3578-a906-3f1407aaa433",
                                        "glosses": [
                                            "Intended for voices of one kind only, either all male or all female; not mixed."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "equal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3f2302f-4d6e-3cf3-ac0b-ac456ede5b45",
                                        "entry_id": "6a9cd9e2-7471-3b58-9338-9d41ba532eee",
                                        "glosses": [
                                            "To be equal to, to have the same value as; to correspond to."
                                        ],
                                        "tags": [
                                            "copulative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25cc3459-b42f-45d8-af40-508cbe2473f2",
                                                "sense_id": "b3f2302f-4d6e-3cf3-ac0b-ac456ede5b45",
                                                "text": "Two plus two equals four."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52e750e3-a4dd-3a2f-8d0f-1ec80d845333",
                                        "entry_id": "6a9cd9e2-7471-3b58-9338-9d41ba532eee",
                                        "glosses": [
                                            "To make equivalent to; to cause to match."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "447f8a40-1cbb-420e-bd84-a585921307a2",
                                                "sense_id": "52e750e3-a4dd-3a2f-8d0f-1ec80d845333",
                                                "text": "David equaled the water levels of the bottles, so they now both contain exactly 1 liter."
                                            },
                                            {
                                                "example_id": "428daa1a-fa6c-40a0-8cfd-cd7ada8097dd",
                                                "sense_id": "52e750e3-a4dd-3a2f-8d0f-1ec80d845333",
                                                "text": "There was an even more remarkable attendance figure that underscores the devotion exhibited by our fans, because it was in 1991 that they set a single season in-stadium attendance record that has never been equaled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91d75f18-bd4e-3be0-ad15-109541e9eae4",
                                        "entry_id": "6a9cd9e2-7471-3b58-9338-9d41ba532eee",
                                        "glosses": [
                                            "To match in degree or some other quality, to match up to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1209c46-8901-4ffc-ba33-c5dd67ae812f",
                                                "sense_id": "91d75f18-bd4e-3be0-ad15-109541e9eae4",
                                                "text": "And what delights can equal those\n⁠That stir the spirit’s inner deeps,\n⁠When one that loves but knows not, reaps\nA truth from one that loves and knows?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f1d6aa-b168-32f3-8388-2822518c4fe0",
                                        "entry_id": "6a9cd9e2-7471-3b58-9338-9d41ba532eee",
                                        "glosses": [
                                            "To have as consequence, to amount to, to mean."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29ab7a1a-9b78-4092-a11a-60447697a4c0",
                                                "sense_id": "f9f1d6aa-b168-32f3-8388-2822518c4fe0",
                                                "text": "Losing this deal equals losing your job."
                                            },
                                            {
                                                "example_id": "c68b8ce3-3fa5-4807-ae7b-f2d14a3535cb",
                                                "sense_id": "f9f1d6aa-b168-32f3-8388-2822518c4fe0",
                                                "text": "Might does not equal right."
                                            },
                                            {
                                                "example_id": "2061dfde-dbc2-46eb-877c-d4cf59822ab5",
                                                "sense_id": "f9f1d6aa-b168-32f3-8388-2822518c4fe0",
                                                "text": "Eclectic and sophisticated are hence coded as negative traits–so cool equaling not so cool–putting Swift in seemed lockstep with the anti-intellectual sentiment that's led to the astonishing 21st-Century Bubbafication of the Republican Party."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "equal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "384001c5-58f2-3427-b0b4-c82613418beb",
                                        "entry_id": "9577a2d7-6c70-36c2-a8a8-6053025555ea",
                                        "glosses": [
                                            "A person or thing of equal status to others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bb25173-d537-4200-8b80-2b62979fc719",
                                                "sense_id": "384001c5-58f2-3427-b0b4-c82613418beb",
                                                "text": "We're all equals here."
                                            },
                                            {
                                                "example_id": "94dbf0b0-e986-42f4-9ad9-b4131b187f78",
                                                "sense_id": "384001c5-58f2-3427-b0b4-c82613418beb",
                                                "text": "This beer has no equal."
                                            },
                                            {
                                                "example_id": "3dc390c0-066c-4800-be0d-d131086f7848",
                                                "sense_id": "384001c5-58f2-3427-b0b4-c82613418beb",
                                                "text": "Those who were once his equals envy and defame him."
                                            },
                                            {
                                                "example_id": "1f228413-4485-4b77-8808-40b44fbbb02a",
                                                "sense_id": "384001c5-58f2-3427-b0b4-c82613418beb",
                                                "text": "The two who have no equals become friends without equal."
                                            },
                                            {
                                                "example_id": "8930257a-1644-45e6-b4cd-df61a1946434",
                                                "sense_id": "384001c5-58f2-3427-b0b4-c82613418beb",
                                                "text": "They had hoped their son, a stockbroker, would marry a financial equal, but Suzette, a teacher, did not come from money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b230d02-984a-3932-b951-076b1e3291d9",
                                        "entry_id": "9577a2d7-6c70-36c2-a8a8-6053025555ea",
                                        "glosses": [
                                            "State of being equal; equality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4c1ef49-6aad-483d-8b73-b5b190f28733",
                                                "sense_id": "9b230d02-984a-3932-b951-076b1e3291d9",
                                                "text": "Thou that presum'st to weigh the world anew,\nAnd all things to an equall to restore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
