                "senses": [
                    {
                        "sense_id": "d334717a-18d5-34d8-aae1-5018e7f89d5f",
                        "entry_id": "bbd26dfd-2dea-34b2-b49a-508f83a1c492",
                        "glosses": [
                            "Fruit du sapotier ou sapotillier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ba493b-5201-458c-a121-78e83834f7be",
                                "sense_id": "d334717a-18d5-34d8-aae1-5018e7f89d5f",
                                "text": "La souris profitait de leur inattention pour puiser largement dans une grosse boîte de chocolats à la sapote qui se trouvait au chevet du lit."
                            },
                            {
                                "example_id": "3b005509-cbbe-4afa-9715-d4bcf64a7032",
                                "sense_id": "d334717a-18d5-34d8-aae1-5018e7f89d5f",
                                "text": "Peu connu hors d'Amérique centrale, le sapote blanc dévoile une chair crémeuse, délicatement parfumée."
                            },
                            {
                                "example_id": "dfd031d5-9972-4834-97d6-9d576aef68fc",
                                "sense_id": "d334717a-18d5-34d8-aae1-5018e7f89d5f",
                                "text": "Les produits du sol sont : le maïs, le blé, la banane, … l’ananas, le sapote, le goyave, l'orange, le citron et à peu près tous les arbres fruitiers, plantes potagères et céréales de l'Europe."
                            },
                            {
                                "example_id": "0feb2790-27e0-4f43-94b5-be4a5f665d45",
                                "sense_id": "d334717a-18d5-34d8-aae1-5018e7f89d5f",
                                "text": "La famille des Sapotées habite dans l'Amérique : on y remarque le sapotillier, arbre assez semblable à un grand poirier, et qui porte un fruit délicieux, la sapote ou sapotille, dont la chair est d'un rouge foncé ; on y trouve aussi l'arbre de la vache, qui croît dans les Andes, et qui donne un excellent suc laiteux, analogue au lait de vache."
                            }
                        ]
                    }
                ],
