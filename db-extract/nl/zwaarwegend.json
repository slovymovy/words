                                            {
                                                "example_id": "b582a9df-dd88-4986-bb0c-91a2459b8551",
                                                "sense_id": "4a613379-4d36-374c-8434-584aded9b442",
                                                "text": "Die Verletzungen waren schwerwiegend gewesen."
                                            },
                                            {
                                                "example_id": "4ad39092-72b6-4527-9d9d-8689918e9980",
                                                "sense_id": "4a613379-4d36-374c-8434-584aded9b442",
                                                "text": "„Hacker haben eine schwerwiegende Sicherheitslücke im Mobilfunknetz entdeckt.“"
                                            },
                                            {
                                                "example_id": "31356514-c282-4206-8723-7bc09b8e03f9",
                                                "sense_id": "4a613379-4d36-374c-8434-584aded9b442",
                                                "text": "„Wegen schwerwiegender Datenschutzverstöße soll der US-Konzern Meta ein Bußgeld in Höhe von 1,2 Milliarden Euro zahlen.“",
                                                "translation": "mit anderer Komparativbildung"
                                            },
                                            {
                                                "example_id": "c6b69d6d-bbb1-4cd5-943f-c7712dfd37b2",
                                                "sense_id": "4a613379-4d36-374c-8434-584aded9b442",
                                                "text": "„Die Gefangenen berichten von häufigerer und schwererwiegender Delinquenz als die Studienanfänger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
