                "senses": [
                    {
                        "sense_id": "ad82fef5-2fd6-31cb-b667-b19ba0e69c53",
                        "entry_id": "3b0af621-e73b-3fc5-99c9-4f1befaadeaa",
                        "glosses": [
                            "dyer (one whose occupation is to dye)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de56cd10-21af-4dca-83d5-abef4763186a",
                                "sense_id": "ad82fef5-2fd6-31cb-b667-b19ba0e69c53",
                                "text": "— Да ты что же! — кри́кнул вдруг Разуми́хин, как бы опо́мнившись и сообрази́в, — да ведь краси́льщики ма́зали в са́мый день уби́йства, а ведь он за три дня там был? Ты что спра́шиваешь-то?",
                                "translation": "\"What do you mean?\" Razumihin shouted suddenly, as though he had reflected and realised. \"Why, it was on the day of the murder the painters were at work, and he was there three days before? What are you asking?\"",
                                "english": "\"What do you mean?\" Razumihin shouted suddenly, as though he had reflected and realised. \"Why, it was on the day of the murder the painters were at work, and he was there three days before? What are you asking?\""
                            }
                        ]
                    }
