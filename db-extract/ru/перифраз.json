                                        "entry_id": "99579a39-e7f7-37fd-a1bd-a42c7d82f3f4",
                                        "glosses": [
                                            "The circular (or, more precisely, conical) movement of a body part, such as a ball-and-socket joint or the eye. It consists of a combination of flexion, extension, adduction, and abduction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23014357-e6ec-4fe1-a409-ff44ab33421d",
                                                "sense_id": "6a149fcb-3498-322c-b53a-9b235f083966",
                                                "text": "Windmilling the arms and rotating the hand from the wrist are examples of circumduction."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "circumduction",
                                "target_lang_code": "en",
