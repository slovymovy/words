                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b815d3-178d-483c-9105-1b18b817fa74",
                                                "sense_id": "f46dbf99-0e9c-3178-ad84-5b8074ad8a53",
                                                "text": "Een a is de sext van een toonladder in c."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9d08c43-336b-32d3-b315-000841d4cde0",
                                        "entry_id": "01730ea6-5841-3e9d-8152-7b579e6740d8",
                                        "glosses": [
                                            "een interval tussen een toon en de zesde toon erboven of beneden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcfaf5d9-c69a-405a-8c8c-109b9ef22916",
                                                "sense_id": "d9d08c43-336b-32d3-b315-000841d4cde0",
                                                "text": "Een dalende kleine sext is bij het zingen niet altijd eenvoudig te treffen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b76e8fb8-05f1-3e2d-92cf-6a15dde45b82",
                                        "entry_id": "01730ea6-5841-3e9d-8152-7b579e6740d8",
                                        "glosses": [
                                            "een van de kleine kerkelijke getijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0310333-4489-42a3-9250-2a84c8369e23",
                                                "sense_id": "b76e8fb8-05f1-3e2d-92cf-6a15dde45b82",
                                                "text": "Rond het middaguur wordt het officie van de sext met name in kloosters gebeden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
