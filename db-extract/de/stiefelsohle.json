                        "examples": [
                            {
                                "example_id": "24076829-1a11-4468-885f-1a2feab9b874",
                                "sense_id": "62b59ced-2acc-3367-b8a9-c99593d14b8f",
                                "text": "„Nach wenigen Schritten ließ ein Knirschen unter den Stiefelsohlen Robert stehenbleiben.“"
                            },
                            {
                                "example_id": "0e890255-48aa-41f5-a7b9-b634754c5283",
                                "sense_id": "62b59ced-2acc-3367-b8a9-c99593d14b8f",
                                "text": "„Er wischte mit den Füßen auf dem Teppichboden hin und her, um das Blut von seinen Stiefelsohlen zu entfernen, dann ging sein Blick durch das Zimmer und fiel schließlich auf die Belüftung.“"
                            }
                        ],
