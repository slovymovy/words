                        ],
                        "examples": [
                            {
                                "example_id": "a3d5fcc3-8c66-48b7-a451-e550f5489693",
                                "sense_id": "5f108a6b-aafe-3fa3-add6-ffb90fdd6d5e",
                                "text": "Mein Regal hat acht Tablare."
                            },
                            {
                                "example_id": "2edc9fbc-55ff-44cc-86d7-6b24d8e2ac9e",
                                "sense_id": "5f108a6b-aafe-3fa3-add6-ffb90fdd6d5e",
                                "text": "„Er entnimmt dem Wandschrank aus einem obern Tablar ein Tuch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4a9a97ad-535c-301f-9338-06ad1c8f32fd",
                        "entry_id": "2fd05749-b6e7-37a5-8285-bedcb18b8fe3",
                        "glosses": [
                            "Tablett, auf dem in automatischen Lagern das Transportgut befördert wird"
                        ],
                        "tags": [
                            "Logistik"
                        ],
                        "examples": [
                            {
                                "example_id": "bd564b7f-f51a-4467-9af1-f2801b0889da",
                                "sense_id": "4a9a97ad-535c-301f-9338-06ad1c8f32fd",
                                "text": "Optimale Umschlagsleistung im Tablar-Lager mit zusätzlicher Zeitersparnis durch eine Greif- und Ziehvorrichtung für Trays."
                            },
                            {
                                "example_id": "e29754dd-b2db-4300-88be-0e0250dee45e",
                                "sense_id": "4a9a97ad-535c-301f-9338-06ad1c8f32fd",
                                "text": "„Das RBG arbeitet vollautomatisch und dient der Ein- und Auslagerung der Tablare sowie deren Bereitstellung in der Vorlagerzone.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
