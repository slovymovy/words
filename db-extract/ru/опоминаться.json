                    },
                    {
                        "translation_id": "94835243-e06d-4d73-9a35-79cd8514ea42",
                        "source_entry_id": "92293b49-4c93-3665-9c29-0a6836554bf6",
                        "target_lang_word": "revenir à soi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revenir à soi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a7f4fe8-8d49-335e-ba16-165a8ca4c399",
                                        "entry_id": "1c05b473-1c8a-3726-a5a6-d405125fce5a",
                                        "glosses": [
                                            "Reprendre ses esprits après un évanouissement, une faiblesse, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c3471b4-04ce-4a31-a2a2-d05f0ce93b53",
                                                "sense_id": "5a7f4fe8-8d49-335e-ba16-165a8ca4c399",
                                                "text": "Quand il revint à lui, plusieurs heures s’étaient écoulées. L’effet du haricot sacré s’estompait peu à peu. Sicheii était à ses côtés, souriant."
                                            },
                                            {
                                                "example_id": "98f2ce9f-377e-4697-af43-7e3d182c6dfe",
                                                "sense_id": "5a7f4fe8-8d49-335e-ba16-165a8ca4c399",
                                                "text": "Mon pere m'aide à installer les bouteilles dans mon dos. Lui, les a déja sur les épaules. Il sait les gestes, c'est un plongeur. Il a même failli mourir en mer, trop d'eau dans les poumons, un ami lui a fait un massage cardiaque et il est revenu à lui. Mon père n'est pas mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f45e8b9c-9add-338e-b67e-a623365e1258",
                                        "entry_id": "1c05b473-1c8a-3726-a5a6-d405125fce5a",
                                        "glosses": [
                                            "Se calmer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0922c486-e4f7-42e5-b62c-8c0ea1f5edb7",
                                                "sense_id": "f45e8b9c-9add-338e-b67e-a623365e1258",
                                                "text": "La colère l’emporta, mais il revint à soi presque aussitôt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d468727e-67d3-3092-b766-18cec5027810",
                                        "entry_id": "1c05b473-1c8a-3726-a5a6-d405125fce5a",
                                        "glosses": [
                                            "Prendre de meilleurs sentiments."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61635fd2-cd81-4584-bef8-c937a26ff743",
                                                "sense_id": "d468727e-67d3-3092-b766-18cec5027810",
                                                "text": "Revenir à soi après de longs égarements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
