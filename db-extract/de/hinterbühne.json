                "senses": [
                    {
                        "sense_id": "aafb4b8d-4c3d-3978-96e7-a80695f8a04c",
                        "entry_id": "a0c2ff47-dfb8-3fc6-87f9-5b8d8412ff20",
                        "glosses": [
                            "im Bühnenhaus rückwärtig hinter dem Bühnenbild gelegener, für den Zuschauer nicht sichtbarer Teil der Bühne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b641180-7c8a-4d8e-a0c7-772ee5d599a9",
                                "sense_id": "aafb4b8d-4c3d-3978-96e7-a80695f8a04c",
                                "text": "„Bei großen Bühnenanlagen mit Seiten- und/oder Hinterbühnen wird eventuell auch der Bühnenbereich in mehrere Brandabschnitte unterteilt, indem Seiten- bzw. Hinterbühnen-Schutzvorhänge eingebaut werden.“"
                            },
                            {
                                "example_id": "40b0f1e3-8f76-4f92-bdee-b5f663226e66",
                                "sense_id": "aafb4b8d-4c3d-3978-96e7-a80695f8a04c",
                                "text": "Die Schwarzen warten schon auf der Hinterbühne, um von den Schauspielern für den Applaus abgeholt zu werden."
                            },
                            {
                                "example_id": "6701e418-117c-49f9-9c94-50594ea44855",
                                "sense_id": "aafb4b8d-4c3d-3978-96e7-a80695f8a04c",
                                "text": "„Ida verfolgte das Geschehen auf der Hinterbühne beinah noch lieber als die Handlung draußen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
