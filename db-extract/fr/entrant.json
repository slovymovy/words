                "senses": [
                    {
                        "sense_id": "bdadc720-04ca-369f-bb1a-13986291e883",
                        "entry_id": "e497ffdc-d496-3042-8942-0975bd3c6569",
                        "glosses": [
                            "Qui entre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27d44e77-8aa3-4e47-b1b9-2b5bb2c2c968",
                                "sense_id": "bdadc720-04ca-369f-bb1a-13986291e883",
                                "text": "Le nombre des élèves entrants est inférieur à celui de l’an dernier."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6d6e80f-b658-32d4-ac70-93854dc841b2",
                        "entry_id": "e497ffdc-d496-3042-8942-0975bd3c6569",
                        "glosses": [
                            "Qui entre dans une charge, dans une fonction élective."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d6bd34-6ce6-4a2f-9d63-8e8e56bdf544",
                                "sense_id": "f6d6e80f-b658-32d4-ac70-93854dc841b2",
                                "text": "Conseillers entrants, par opposition à Conseillers sortants."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a32e73d-1b01-3d2b-bb57-5ce9f6b9c134",
                        "entry_id": "e497ffdc-d496-3042-8942-0975bd3c6569",
                        "glosses": [
                            "Qui est insinuant, qui se familiarise trop."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "cee923a2-4269-48bc-89e6-516deea6dc76",
                                "sense_id": "9a32e73d-1b01-3d2b-bb57-5ce9f6b9c134",
                                "text": "C’est un homme dont le caractère a je ne sais quoi d’entrant."
                            },
                            {
                                "example_id": "46d3c1a1-ef50-4102-846e-77bcc4f68c46",
                                "sense_id": "9a32e73d-1b01-3d2b-bb57-5ce9f6b9c134",
                                "text": "Mais le gros M. Bonard n’était qu’horriblement intéressé en matière d’argent ; du reste, communicatif, obligeant, entrant, dès qu’il ne s’agissait plus de gagner quatre sous sur une mesure de blé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de123465-444b-4384-83d1-21e170b4ea41",
                        "source_entry_id": "e497ffdc-d496-3042-8942-0975bd3c6569",
                        "target_lang_word": "incoming",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incoming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44300725-1038-3538-b9f5-2b4333d3252d",
                                        "entry_id": "0ca87972-4260-361f-9e86-453311afcb42",
                                        "glosses": [
                                            "Coming (or about to come) in; arriving."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25174c41-023d-4139-94f8-80e58d98ccd3",
                                                "sense_id": "44300725-1038-3538-b9f5-2b4333d3252d",
                                                "text": "Incoming tides cause a tidal bore in many rivers."
                                            },
                                            {
                                                "example_id": "2feace70-6a54-41ea-90ce-b910fdc40257",
                                                "sense_id": "44300725-1038-3538-b9f5-2b4333d3252d",
                                                "text": "Underneath a black cliff where the incoming tide smashed on the shingle, they stumbled upon the mail hood of Hrothgar's murdered vassal."
                                            },
                                            {
                                                "example_id": "e4642212-2e8f-4038-900e-5421fb938062",
                                                "sense_id": "44300725-1038-3538-b9f5-2b4333d3252d",
                                                "text": "In dense fog at about 10.25 p.m. on the night of October 25, two tank barges carrying petroleum [...] missed the entrance to the docks at Sharpness and were carried up the River Severn by the incoming tide. They collided with one of the piers of the Severn Bridge, carrying the Berkeley Road-Lydney branch of the Western Region, and as a result of the collision both tankers blew up."
                                            },
                                            {
                                                "example_id": "3930ad15-a645-4a5c-82c3-34dd7c9e726f",
                                                "sense_id": "44300725-1038-3538-b9f5-2b4333d3252d",
                                                "text": "The single-imaging optic of the mammalian eye offers some distinct visual advantages. Such lenses can take in photons from a wide range of angles, increasing light sensitivity. They also have high spatial resolution, resolving incoming images in minute detail."
                                            },
                                            {
                                                "example_id": "c34a4891-37a6-4d81-89a0-297a829b119e",
                                                "sense_id": "44300725-1038-3538-b9f5-2b4333d3252d",
                                                "text": "\"We landed in their killbox?\" \"We did. I am sor... No, belay that. Heads down! Cavalry incoming!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3c4e71a-f72e-3882-82d1-291ccc587369",
                                        "entry_id": "0ca87972-4260-361f-9e86-453311afcb42",
                                        "glosses": [
                                            "Succeeding to an office or other position."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcdd598f-25b5-4342-bc8b-ce99587a08c6",
                                                "sense_id": "c3c4e71a-f72e-3882-82d1-291ccc587369",
                                                "text": "The incoming prime minister gave a press conference."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incoming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb648e93-2eab-372e-b702-375420f54e9e",
                                        "entry_id": "d737ef3a-8fa4-3578-9bbf-7637ab969c90",
                                        "glosses": [
                                            "A warning that something is coming towards the addressee, especially enemy artillery fire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "incoming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "636ac51b-0e3a-3bbb-af23-13e46e3ab3f4",
                                        "entry_id": "00122fca-7f09-3a4d-82c1-35ae38e85773",
                                        "glosses": [
                                            "The act of coming in; arrival."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "adb50f92-c04b-3559-80c3-f942d07c11e0",
                                        "entry_id": "00122fca-7f09-3a4d-82c1-35ae38e85773",
                                        "glosses": [
                                            "Enemy fire directed at oneself."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b425c652-37c8-41e3-a0c7-de1e49907f06",
                                                "sense_id": "adb50f92-c04b-3559-80c3-f942d07c11e0",
                                                "text": "Volume, however, was only part of the story because the incoming was almost always the heavier stuff. The hill received little 60mm or 82mm mortar fire but a deluge of 120mm mortar and 100mm artillery rounds."
                                            },
                                            {
                                                "example_id": "a7e674c7-c3a1-46a4-ac1c-ba03d1c964af",
                                                "sense_id": "adb50f92-c04b-3559-80c3-f942d07c11e0",
                                                "text": "I'll never forget the sight of those cannoneers standing at their guns firing back while the incoming was hitting all over. That was artillery's mission."
                                            },
                                            {
                                                "example_id": "27798699-7d1c-4f55-a6ac-0f15386270ff",
                                                "sense_id": "adb50f92-c04b-3559-80c3-f942d07c11e0",
                                                "text": "Things had improved a little bit compared to the Eastern Solomons, and three dozen F4F Wildcats on combat air patrol were vectored onto the oncoming hostiles, but once that initial task was accomplished, things began to collapse back into the cacophony and chaos that was all too familiar to those aboard the Enterprise, meaning that the end result was round about the same, the Japanese aircraft screaming into their attack runs on Hornet about the same time as most of the Wildcats managed to sort themselves out to begin their own attacks on the incoming."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "85c2f0fa-7782-3f2c-a987-c21b0181625a",
                "word": "entrant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "85bcd0da-72d0-4699-91fe-426a386e659c",
                        "entry_id": "85c2f0fa-7782-3f2c-a987-c21b0181625a",
                        "tags": [
                            "plural"
                        ],
                        "form": "entrants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b08163c5-1cb8-3cc6-99c4-841848c61849",
                        "entry_id": "85c2f0fa-7782-3f2c-a987-c21b0181625a",
                        "glosses": [
                            "Personne qui entre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "234b807f-b18f-4e91-a892-ea2e07f24e9d",
                                "sense_id": "b08163c5-1cb8-3cc6-99c4-841848c61849",
                                "text": "« Cher Monsieur, soyez le bienvenu. » Il s'est retourné dans son plumard la tête enfouie... fort heureux encore qu'il se pogne pas... L'impression que ça fait à l’entrant tout neuf, le voisinage immédiat d'un palucheur forcené."
                            },
                            {
                                "example_id": "473cd665-4266-460a-943c-0fcbf42f2f5a",
                                "sense_id": "b08163c5-1cb8-3cc6-99c4-841848c61849",
                                "text": "L’analyse des évolutions salariales nécessite également de distinguer personnes en emploi et entrants sur le marché du travail."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae021725-c4e7-49d7-b098-6e6658f4405b",
                        "source_entry_id": "85c2f0fa-7782-3f2c-a987-c21b0181625a",
                        "source_sense_id": "b08163c5-1cb8-3cc6-99c4-841848c61849",
                        "target_lang_word": "entering",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cf3e96f-13f3-333c-9303-5f67badbc1d2",
                                        "entry_id": "66b5616b-7a64-34f3-99c4-37c114e409f8",
                                        "glosses": [
                                            "present participle and gerund of enter"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a5c42ff-1017-4f0c-8cfe-1109c2d58097",
                                                "sense_id": "5cf3e96f-13f3-333c-9303-5f67badbc1d2",
                                                "text": "From the ground, Colombo’s port does not look like much. Those entering it are greeted by wire fences, walls dating back to colonial times and security posts. For mariners leaving the port after lonely nights on the high seas, the delights of the B52 Night Club and Stallion Pub lie a stumble away."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "entering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c09f2bd8-7208-3b13-beeb-e7f8b5d181e1",
                                        "entry_id": "dd7d64a5-2336-3434-9ff5-6e6d35df1ea6",
                                        "glosses": [
                                            "action of the verb to enter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3befafa-5b0a-445d-bd4a-cc6a7e9b8840",
                                                "sense_id": "c09f2bd8-7208-3b13-beeb-e7f8b5d181e1",
                                                "text": "The term “sale” does not include grants or purchases of options, exercises of call options, or enterings into contracts that require delivery of personal property or an interest therein."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
