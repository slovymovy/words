                                "target_senses": [
                                    {
                                        "sense_id": "dfbcdba3-29b3-3de2-a58d-73281f2f11e9",
                                        "entry_id": "79e8804d-2956-3d84-b4e4-e5761a5f8091",
                                        "glosses": [
                                            "A large open box or basket, used especially to transport fragile goods."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a9cc0bf-8bd6-3cda-ac3a-60715728bdfd",
                                        "entry_id": "79e8804d-2956-3d84-b4e4-e5761a5f8091",
                                        "glosses": [
                                            "A vehicle (car, aircraft, spacecraft, etc.) seen as unreliable."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "mildly",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f97108e5-6f08-4005-b94f-1106f05a526d",
                                                "sense_id": "8a9cc0bf-8bd6-3cda-ac3a-60715728bdfd",
                                                "text": "They shook the head of the unconscious pilot and when the latter opened his eyes, blinking wildly, the other members of the family lifted up the tail of the overturned crate sufficiently high enough to enable the dazed pilot, after releasing his belt, to fall out of the cockpit head first and disengage himself from the crack-up."
                                            },
                                            {
                                                "example_id": "a1c5ce5a-f407-4d38-b11d-1aed6620ef8a",
                                                "sense_id": "8a9cc0bf-8bd6-3cda-ac3a-60715728bdfd",
                                                "text": "I will make this box of electronics and computer chips fly like no other spaceship has ever flown. Mission Control wanted to see what this crate could do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ff140f5-8c8f-312e-b386-2e210ef91764",
                                        "entry_id": "79e8804d-2956-3d84-b4e4-e5761a5f8091",
                                        "glosses": [
                                            "In the Rust programming language, a binary or library."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76776c27-cfbf-4342-b742-098a2fa72388",
                                                "sense_id": "3ff140f5-8c8f-312e-b386-2e210ef91764",
                                                "text": "And Rust never compiles modules separately, even if they're in separate files: when you build a Rust crate, you're recompiling all of its modules."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0102198-b9c0-3394-99ab-3d38e3e2ff19",
                                        "entry_id": "ee6b8fa4-34db-314b-a441-3b609cca1f43",
                                        "glosses": [
                                            "To put into a crate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee45150-a5a4-45f9-b39c-542c60e4410c",
                                                "sense_id": "f0102198-b9c0-3394-99ab-3d38e3e2ff19",
                                                "text": "Then, in 1941, decision was reached between the Chungking and American authorities to transport these fossils to the United States for safekeeping, and they were crated and moved to a warehouse in Ch’in-huang-tao, a small port city northeast of Peking, into the custody of the U.S. Marines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e39c421-ba85-3c6c-8006-3c334629e91f",
                                        "entry_id": "ee6b8fa4-34db-314b-a441-3b609cca1f43",
                                        "glosses": [
                                            "To keep in a crate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdb9a9f3-4c0d-4e53-a2d9-a786c080193e",
                        "source_entry_id": "f0df2ed7-ce2a-3cb1-be84-80ee1db7ee03",
                        "source_sense_id": "ac4ea9d5-fa31-3de6-9525-5eb813bf4ea8",
                        "source_sense_description": "houten of plastic doos met openingen in de zijkanten in een standaardformaat, vaak gebruikt voor opslag en het vervoer van flessen, fruit of andere waren",
                        "target_lang_word": "cagette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cagette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fd686ad-f851-3439-b2a0-f26fc3c48c7b",
                                        "entry_id": "96404660-bc6e-3d0c-8f4a-a0123999e7ef",
                                        "glosses": [
                                            "Caisse en bois déroulé permettant le transport de fruits et légumes principalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0bb5f41-089c-4e93-bc46-1bc5b6b0f0c0",
                                                "sense_id": "9fd686ad-f851-3439-b2a0-f26fc3c48c7b",
                                                "text": "Dans la remise, le père monta au grenier et cacha le squelette derrière une pile de cagettes vides qu’il tenait en réserve pour en faire du bois d’allumage."
                                            },
                                            {
                                                "example_id": "bc5c62bb-a85b-41d5-8c26-cf1c463c2238",
                                                "sense_id": "9fd686ad-f851-3439-b2a0-f26fc3c48c7b",
                                                "text": "Dans la première série d'opérations, la réception se fait directement dans la cagette qui est adaptée à la largeur de la machine. Une seule personne s'en saisit facilement, ajuste le poids à 15 kg d'huîtres et la pose sur la palette."
                                            },
                                            {
                                                "example_id": "f20bd473-466b-40d6-b4f9-fd8b7c39277f",
                                                "sense_id": "9fd686ad-f851-3439-b2a0-f26fc3c48c7b",
                                                "text": "C’était le métier de mon grand-père. Il avait des plantations près de la Garonne, et une petite menuiserie pour faire des cagettes. Toutes ces planchettes, ces clous, pour un gosse, c’était le paradis !"
                                            },
                                            {
                                                "example_id": "54fa8340-1bf1-4bc5-b9b6-30e39f436263",
                                                "sense_id": "9fd686ad-f851-3439-b2a0-f26fc3c48c7b",
                                                "text": "Il s'agit des cagettes à l'ancienne, à pommes ou à pommes de terre, en bois dur, avec quatre pieds, que l'on appelle aussi « clayettes » et que l'on peut empiler à l'infini."
                                            },
                                            {
                                                "example_id": "fb47c450-da8d-46f9-8e33-799adeaa2772",
                                                "sense_id": "9fd686ad-f851-3439-b2a0-f26fc3c48c7b",
                                                "text": "La première unité de transport par ordre de taille est le seau à vendange dans lequel le vendangeur recueille le raisin avant de le verser dans une cagette ajourée de 10 à 20 kg ou une comporte de 40 à 60 kg selon les régions, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8c63d44-0fac-3893-a743-8b40026b1a5d",
                                        "entry_id": "96404660-bc6e-3d0c-8f4a-a0123999e7ef",
                                        "glosses": [
                                            "Cette caisse et son contenu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acd890a2-fd07-472f-ba21-f9a593a549ad",
                                                "sense_id": "e8c63d44-0fac-3893-a743-8b40026b1a5d",
                                                "text": "On les voyait rentrer à midi une cagette de poireaux ou de carottes sous le bras, un peu d'argent en poche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef796a1-6285-38c4-a1ba-d166dbcc75d0",
                                        "entry_id": "96404660-bc6e-3d0c-8f4a-a0123999e7ef",
                                        "glosses": [
                                            "Petite forme en osier pour égoutter les fromages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce781c01-6057-433f-aa8c-021a9cd4baf1",
                                                "sense_id": "6ef796a1-6285-38c4-a1ba-d166dbcc75d0",
                                                "text": "Les fromages sont ressuyés de deux ou trois jours et affinés une dizaine de jours avant la mise en marché, en cagette de bois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f0fde88-738c-4006-b995-eb7743ef73ce",
                        "source_entry_id": "f0df2ed7-ce2a-3cb1-be84-80ee1db7ee03",
                        "source_sense_id": "ac4ea9d5-fa31-3de6-9525-5eb813bf4ea8",
                        "source_sense_description": "houten of plastic doos met openingen in de zijkanten in een standaardformaat, vaak gebruikt voor opslag en het vervoer van flessen, fruit of andere waren",
                        "target_lang_word": "cageot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cageot",
