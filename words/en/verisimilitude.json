{
    "word_family": [
        "verisimilar",
        "verisimilitudinous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f855b6c-44b7-39a3-92c9-37d89ba9d261",
                    "sense_definition": "The quality of appearing to be true or real.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The details in the historical novel add a remarkable sense of <w>verisimilitude</w> to the narrative.",
                            "target_lang_translations": {
                                "pl": "Szczegóły w powieści historycznej nadają narracji niezwykłe poczucie <w>autentyzmu</w>."
                            }
                        },
                        {
                            "text": "The director aimed for maximum <w>verisimilitude</w> by using authentic period costumes.",
                            "target_lang_translations": {
                                "pl": "Reżyser dążył do maksymalnego <w>autentyzmu</w>, używając autentycznych kostiumów z epoki."
                            }
                        }
                    ],
                    "synonyms": [
                        "truthiness"
                    ],
                    "common_phrases": [
                        "maximum verisimilitude",
                        "sense of verisimilitude"
                    ],
                    "target_lang_definitions": {
                        "pl": "Cecha tego, co wydaje się prawdziwe, realne lub prawdopodobne."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "prawdopodobieństwo",
                                "target_lang_sense_clarification": "pozór prawdy, cecha bycia wiarygodnym"
                            },
                            {
                                "target_lang_word": "autentyzm",
                                "target_lang_sense_clarification": "wierność rzeczywistości, poczucie autentyczności"
                            },
                            {
                                "target_lang_word": "wiarygodność",
                                "target_lang_sense_clarification": "sprawianie wrażenia prawdy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fe23c2d-9749-3361-9525-70b976781da5",
                    "sense_definition": "A statement or assertion that merely appears to be true.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His speech was full of persuasive <w>verisimilitudes</w> that masked the lack of real facts.",
                            "target_lang_translations": {
                                "pl": "Jego przemówienie było pełne przekonujących <w>pozorów prawdy</w>, które maskowały brak rzeczywistych faktów."
                            }
                        },
                        {
                            "text": "She presented several <w>verisimilitudes</w> to convince the jury of her innocence.",
                            "target_lang_translations": {
                                "pl": "Przedstawiła kilka <w>pozorów prawdy</w>, aby przekonać ławę przysięgłych o swojej niewinności."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Stwierdzenie lub twierdzenie, które jedynie wydaje się prawdziwe."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pozór prawdy",
                                "target_lang_sense_clarification": "twierdzenie sprawiające jedynie wrażenie prawdziwego"
                            },
                            {
                                "target_lang_word": "pozorność",
                                "target_lang_sense_clarification": "rzecz pozorna, ułuda prawdy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28d06968-5a78-3bb5-b776-5d5bf43a9e86",
                    "sense_definition": "Faithfulness to internal logic or rules within a work of art or narrative.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fantasy worlds require internal <w>verisimilitude</w> so that readers can suspend their disbelief.",
                            "target_lang_translations": {
                                "pl": "Światy fantasy wymagają wewnętrznej <w>spójności</w>, aby czytelnicy mogli zawiesić niewiarę."
                            }
                        },
                        {
                            "text": "The author included minor details in the interest of <w>verisimilitude</w>.",
                            "target_lang_translations": {
                                "pl": "Autor zamieścił drobne szczegóły w trosce o <w>wiarygodność</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the interest of verisimilitude",
                        "internal verisimilitude"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wierność wewnętrznej logice lub regułom świata przedstawionego w dziele sztuki."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "prawdopodobieństwo życiowe",
                                "target_lang_sense_clarification": "w teorii literatury: zgodność z wewnętrzną logiką świata"
                            },
                            {
                                "target_lang_word": "spójność",
                                "target_lang_sense_clarification": "wewnętrzna logika i wiarygodność fabuły"
                            },
                            {
                                "target_lang_word": "wiarygodność",
                                "target_lang_sense_clarification": "przekonująca konstrukcja świata przedstawionego"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}