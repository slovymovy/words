                            {
                                "target_lang_word": "направляться",
                                "target_lang_sense_clarification": "идти или двигаться в какую-либо сторону"
                            },
                            {
                                "target_lang_word": "держать путь",
                                "target_lang_sense_clarification": "двигаться в определенном направлении"
