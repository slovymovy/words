{
    "word_family": [
        "appel",
        "appelable",
        "appelant",
        "appelé",
        "rappel",
        "rappeler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9403096c-fc00-3dff-a65f-f291e592093d",
                    "sense_definition": "Désigner par un nom ou, sous la forme pronominale, porter un prénom ou un patronyme.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "nomination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur <w>appelle</w> chaque nouvel élève par son prénom."
                        },
                        {
                            "text": "Je m'<w>appelle</w> Thomas et j'habite dans le centre de Paris."
                        }
                    ],
                    "synonyms": [
                        "nommer",
                        "dénommer"
                    ],
                    "common_phrases": [
                        "appeler par son prénom",
                        "appeler par son nom",
                        "s'appeler"
                    ]
                },
                {
                    "sense_id": "693df674-264d-31be-8e68-029c1cbb61be",
                    "sense_definition": "Prendre contact avec une personne par téléphone.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il promet d'<w>appeler</w> ses parents dès qu'il arrive à la gare."
                        },
                        {
                            "text": "Je dois t'<w>appeler</w> sur ton portable pour te donner les détails."
                        }
                    ],
                    "synonyms": [
                        "téléphoner"
                    ],
                    "common_phrases": [
                        "appeler au téléphone",
                        "appeler sur le portable"
                    ]
                },
                {
                    "sense_id": "50d9312b-3d26-3c67-8bf5-8cc1d63c2d3b",
                    "sense_definition": "Faire venir quelqu'un ou attirer son attention en élevant la voix.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vocal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La mère <w>appelle</w> ses enfants pour le dîner depuis la cuisine."
                        },
                        {
                            "text": "Le randonneur égaré a commencé à <w>appeler</w> à l'aide dans la forêt."
                        }
                    ],
                    "synonyms": [
                        "héler",
                        "interpeller"
                    ],
                    "common_phrases": [
                        "appeler à l'aide",
                        "appeler au secours",
                        "appeler à grands cris"
                    ]
                },
                {
                    "sense_id": "2e0e286e-1c57-3478-bed2-7d944dfd6019",
                    "sense_definition": "Solliciter la présence ou l'intervention de professionnels ou d'une aide extérieure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "demande_aide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En cas d'urgence, il faut immédiatement <w>appeler</w> les secours."
                        },
                        {
                            "text": "L'infirmière a décidé d'<w>appeler</w> un médecin face aux symptômes du malade."
                        }
                    ],
                    "synonyms": [
                        "faire venir"
                    ],
                    "common_phrases": [
                        "appeler les secours",
                        "appeler la police",
                        "appeler un médecin"
                    ]
                },
                {
                    "sense_id": "fa58593d-1344-35e1-85da-56230eb62110",
                    "sense_definition": "Lire une liste de noms à haute voix pour vérifier la présence des personnes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enseignant <w>appelle</w> les élèves un par un au début du cours."
                        },
                        {
                            "text": "Chaque candidat doit répondre présent dès que le surveillant l'<w>appelle</w>."
                        }
                    ],
                    "common_phrases": [
                        "appeler la liste",
                        "appeler les élèves",
                        "appeler les témoins"
                    ]
                },
                {
                    "sense_id": "1724b432-0be8-3ef9-b71b-dd898621d797",
                    "sense_definition": "Rendre nécessaire ou susciter naturellement une réponse, une action ou une réforme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "necessite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette proposition complexe <w>appelle</w> une réflexion approfondie de notre part."
                        },
                        {
                            "text": "La gravité des faits <w>appelle</w> une réaction ferme de la direction."
                        }
                    ],
                    "synonyms": [
                        "exiger",
                        "nécessiter",
                        "requérir"
                    ],
                    "common_phrases": [
                        "appeler une réponse",
                        "appeler des réformes",
                        "appeler des commentaires"
                    ]
                },
                {
                    "sense_id": "a9b683fd-aa3b-3220-8833-90172c55eaa5",
                    "sense_definition": "Invoquer quelqu'un ou quelque chose comme témoin, garant ou autorité morale.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "recours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux fausses accusations, j'en <w>appelle</w> à votre bon sens et à votre honnêteté."
                        },
                        {
                            "text": "L'avocat en <w>appelle</w> au témoignage des voisins pour innocenter son client."
                        }
                    ],
                    "synonyms": [
                        "invoquer",
                        "solliciter"
                    ],
                    "common_phrases": [
                        "en appeler à",
                        "en appeler au bon sens",
                        "en appeler à la justice"
                    ]
                },
                {
                    "sense_id": "1134e351-4619-39ad-94f3-bb478606165b",
                    "sense_definition": "Recourir à une juridiction supérieure pour contester et faire réformer un jugement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le condamné a formellement déclaré qu'il allait <w>appeler</w> de ce jugement."
                        },
                        {
                            "text": "L'entreprise a décidé d'<w>appeler</w> de la décision prise par le premier tribunal."
                        }
                    ],
                    "common_phrases": [
                        "appeler d'un jugement",
                        "appeler de la décision"
                    ]
                }
            ]
        }
    ]
}