                "senses": [
                    {
                        "sense_id": "3b45a387-9bbb-3b80-a3f5-c6a35d55e16c",
                        "entry_id": "15572ccb-b143-3d04-9bd2-1b85c7da1c0f",
                        "glosses": [
                            "Feuer am Biwak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef21cdc2-ae03-4387-9bf6-7d99b8b76f3a",
                                "sense_id": "3b45a387-9bbb-3b80-a3f5-c6a35d55e16c",
                                "text": "„Ein Biwakfeuer brannte nicht, weil die Sommernacht Wärme genug gab.“"
                            },
                            {
                                "example_id": "3ddb4088-d51f-41dc-9cd9-3285cb0550df",
                                "sense_id": "3b45a387-9bbb-3b80-a3f5-c6a35d55e16c",
                                "text": "„Pierre war es am niedergebrannten nächtlichen Biwakfeuer zu kalt geworden, und so war er aufgestanden und zum nächsten, noch in voller Flamme stehenden Feuer gegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a181b8c-465c-43a8-a476-0d038ab22857",
                        "source_entry_id": "15572ccb-b143-3d04-9bd2-1b85c7da1c0f",
                        "source_sense_id": "3b45a387-9bbb-3b80-a3f5-c6a35d55e16c",
                        "source_sense_description": "Feuer am Biwak",
                        "target_lang_word": "feu de bivouac",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "62435c26-5b09-4e1c-a3d4-1a831d48d49b",
                        "source_entry_id": "15572ccb-b143-3d04-9bd2-1b85c7da1c0f",
                        "source_sense_id": "3b45a387-9bbb-3b80-a3f5-c6a35d55e16c",
                        "source_sense_description": "Feuer am Biwak",
                        "target_lang_word": "feu de camp",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feu de camp",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82b80384-06f7-3755-a2f8-e67df06e417e",
                                        "entry_id": "4f8be43d-2225-3ad5-bd4f-7bf3e0de15e5",
                                        "glosses": [
                                            "Foyer aménagé non pérenne d’un feu en pleine nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95eb98f5-bd47-4929-ae69-faae7ac591e9",
                                                "sense_id": "82b80384-06f7-3755-a2f8-e67df06e417e",
                                                "text": "L’usage de se réunir la nuit autour d’un feu de camp pour chanter et s’exprimer en commun se généralise avec le camping."
                                            },
                                            {
                                                "example_id": "710d65c8-b1d7-4a99-b200-736a05a598be",
                                                "sense_id": "82b80384-06f7-3755-a2f8-e67df06e417e",
                                                "text": "Entreprendre une méharée au Mali, c'est s'immerger complètement dans le monde du désert, des espaces sans fin, des bivouacs étoilés, des feux de camp et des théières fumantes."
                                            },
                                            {
                                                "example_id": "f925984d-6880-45fc-b096-76595ad98f52",
                                                "sense_id": "82b80384-06f7-3755-a2f8-e67df06e417e",
                                                "text": "Avant d’allumer un feu de cuisson ou un feu de camp, les gens sont invités à s’informer sur le danger d’incendie pour leur région."
                                            },
                                            {
                                                "example_id": "0f602e90-674e-4b7b-8655-e01020d88996",
                                                "sense_id": "82b80384-06f7-3755-a2f8-e67df06e417e",
                                                "text": "Se retrouver un soir d’été autour d'un feu de camp, quel bon moment ! Et pourquoi ne pas en profiter pour griller des marshmallows, comme au bon vieux temps ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "874c29d7-404e-35d1-b906-47c6ad70335f",
                                        "entry_id": "4f8be43d-2225-3ad5-bd4f-7bf3e0de15e5",
                                        "glosses": [
                                            "Petite éruption solaire à la surface de l’astre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ec0770d-78fe-4fb6-b244-cf3268b4e8dd",
                                                "sense_id": "874c29d7-404e-35d1-b906-47c6ad70335f",
                                                "text": "Prises à environ 77 millions de kilomètres du Soleil, à mi-distance entre la Terre et son astre, elles ont montré un phénomène nouveau : de mini-éruptions solaires, omniprésentes à la surface, baptisées \"feux de camp\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
