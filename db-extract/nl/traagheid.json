                    {
                        "sense_id": "a1aa84c0-79ea-3ef4-bc92-793d2dbea3dd",
                        "entry_id": "d3a72ab5-f41b-393d-8003-0c8bbbad39ca",
                        "glosses": [
                            "het langzaam zijn"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "31c00b90-f194-3348-8091-df4be524554c",
                        "entry_id": "d3a72ab5-f41b-393d-8003-0c8bbbad39ca",
                        "glosses": [
                            "ook inertie genoemd, de naam voor het verschijnsel dat er een kracht nodig is om een voorwerp een andere snelheid of richting te geven"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "572c7f1c-797d-4682-9f24-2cadeae20047",
                        "source_entry_id": "d3a72ab5-f41b-393d-8003-0c8bbbad39ca",
                        "source_sense_id": "a1aa84c0-79ea-3ef4-bc92-793d2dbea3dd",
                        "source_sense_description": "het langzaam zijn",
                        "target_lang_word": "Trägheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trägheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff2d1bc3-20bd-3aa5-931c-fc52cbda2706",
                                        "entry_id": "a49228d7-cecc-3082-931d-174ffef2a303",
                                        "glosses": [
                                            "das Trägesein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9e961cc-04bd-42b8-add1-5715ae8b14d9",
                                                "sense_id": "ff2d1bc3-20bd-3aa5-931c-fc52cbda2706",
                                                "text": "„Dann aber kommt Tag 8, und das Blatt wendet sich: Auffallen heißt es nun – und das um jeden Preis. Blöd nur, wenn man diesen Zeitpunkt aus lauter Trägheit verschläft.“"
                                            },
                                            {
                                                "example_id": "f9b7472f-6ad8-4f38-8273-8ac4247f0909",
                                                "sense_id": "ff2d1bc3-20bd-3aa5-931c-fc52cbda2706",
                                                "text": "„Zwischen ihr und den Straussens hatte sich nach der langen gemeinsamen Zeit eine Trägheit eingestellt, ja, fast schon Überdruss.“"
                                            },
                                            {
                                                "example_id": "c37a122d-3bb3-4fc3-82a9-337f4c63641e",
                                                "sense_id": "ff2d1bc3-20bd-3aa5-931c-fc52cbda2706",
                                                "text": "„Die schwarzen Notenköpfe verbeugten sich ironisch vor ihrer Trägheit in Form einer Pavane für eine tote Infantin und lösten sich auf.“"
                                            },
                                            {
                                                "example_id": "ae950613-6c72-45e4-bd85-baff68661e37",
                                                "sense_id": "ff2d1bc3-20bd-3aa5-931c-fc52cbda2706",
                                                "text": "„Und auch die Trägheit, die zur Erbschaft des Dienerstandes gehört, ist ihm inzwischen teilweise abhanden gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "841a5edd-6414-3153-8126-dcd67f7a1863",
                                        "entry_id": "a49228d7-cecc-3082-931d-174ffef2a303",
                                        "glosses": [
                                            "Bestreben von physikalischen Körpern, in ihrem Bewegungszustand zu verharren, solange keine äußeren Kräfte oder Drehmomente auf sie einwirken"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6931fdac-e54c-4a00-8690-225c4a1c021e",
                                                "sense_id": "841a5edd-6414-3153-8126-dcd67f7a1863",
                                                "text": "„Die Gravitation eines Systems ist proportional zu seiner Masse. Zugleich bestimmt seine Masse die Trägheit, mit der der Bewegungszustand des Systems als Ganzes auf Kräfte reagiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d7f497d-dacc-4db8-9f48-f79ff800f78f",
                        "source_entry_id": "d3a72ab5-f41b-393d-8003-0c8bbbad39ca",
                        "source_sense_id": "a1aa84c0-79ea-3ef4-bc92-793d2dbea3dd",
                        "source_sense_description": "het langzaam zijn",
                        "target_lang_word": "slowness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slowness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eeaf54f5-8f19-3e55-851c-8e8f7438de9e",
                                        "entry_id": "bbceb62f-5ec9-35c6-92f3-4e573580d5d2",
                                        "glosses": [
                                            "The quality or state of being slow."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c90a03c3-d4dd-4ed0-84a4-5895c4ab0600",
                                                "sense_id": "eeaf54f5-8f19-3e55-851c-8e8f7438de9e",
                                                "text": "Impatience with the intellectual slowness of others, narcissism and passion for one's mission in life might combine to make such individuals isolative and difficult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cbef6e1-8a55-31a0-a0c9-d39af57515b3",
                                        "entry_id": "bbceb62f-5ec9-35c6-92f3-4e573580d5d2",
                                        "glosses": [
                                            "A unit, the reciprocal of velocity, that delineates the amount of time required for an object to travel a given distance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50db9481-867c-4ecc-be75-446abc4a015b",
                        "source_entry_id": "d3a72ab5-f41b-393d-8003-0c8bbbad39ca",
                        "source_sense_id": "a1aa84c0-79ea-3ef4-bc92-793d2dbea3dd",
                        "source_sense_description": "het langzaam zijn",
                        "target_lang_word": "lenteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lenteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0db8e420-c85b-3fce-8aa0-83c610d6ce6b",
                                        "entry_id": "f13021fb-626c-3a45-bcc3-3bf152738a43",
                                        "glosses": [
                                            "Manque de rapidité dans le mouvement et dans l’action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504d0991-e3a6-45b8-abe5-f719bedcaf5c",
                                                "sense_id": "0db8e420-c85b-3fce-8aa0-83c610d6ce6b",
                                                "text": "Leur procession par les rues se déroule avec la lenteur habituelle, sa psalmodie sourde, […]."
                                            },
                                            {
                                                "example_id": "73d4b9c7-f562-47c4-8cbe-568df80d81d1",
                                                "sense_id": "0db8e420-c85b-3fce-8aa0-83c610d6ce6b",
                                                "text": "Libre à d'autres de rire d'une lenteur apparente, d'une hésitation qui est scrupule, d'une méthode qu'on croit inhabile."
                                            },
                                            {
                                                "example_id": "8f7b46ed-4355-4ed5-928e-cca6a02a0141",
                                                "sense_id": "0db8e420-c85b-3fce-8aa0-83c610d6ce6b",
                                                "text": "Pendant ce temps, la mère, surprise de la lenteur de sa fille à se décider, étonnée de trouver ce jeune marchand si peu pratique, si peu désireux de vendre, s'impatientait."
                                            },
                                            {
                                                "example_id": "86c6b5ca-9153-4d1c-90e1-fe0009bd9075",
                                                "sense_id": "0db8e420-c85b-3fce-8aa0-83c610d6ce6b",
                                                "text": "Les trente dernières secondes avant onze heures lui parurent durer une éternité. La trotteuse du chronographe sautillait sur les points phosphorescents avec une horripilante lenteur. Elle finit tout de même par s'immobiliser au-dessus du chiffre douze , […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d968fed9-b71f-398d-a3ad-25d24017b310",
                                        "entry_id": "f13021fb-626c-3a45-bcc3-3bf152738a43",
                                        "glosses": [
                                            "Difficulté, peine, à imaginer, à concevoir."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76dcd4dc-dc58-4d6f-8a58-f0201bb686ea",
                                                "sense_id": "d968fed9-b71f-398d-a3ad-25d24017b310",
                                                "text": "Avoir une grande lenteur d’imagination, une grande lenteur d’esprit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "437ad6b1-fe38-3de0-a202-a482d87b10f0",
                                        "entry_id": "f13021fb-626c-3a45-bcc3-3bf152738a43",
                                        "glosses": [
                                            "Manque de tonus, d'action dans une pièce de théâtre, un roman, un film."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc2f8bf1-644e-4ace-a148-3dc610c860f2",
                                                "sense_id": "437ad6b1-fe38-3de0-a202-a482d87b10f0",
                                                "text": "On a blâmé, dans cette pièce, dans ce roman la lenteur de l’action."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
