                    {
                        "translation_id": "0f946077-a3ea-4b1c-a8d9-479e33254022",
                        "source_entry_id": "af0b43dc-8668-3951-bc4c-7e4aae253507",
                        "source_sense_id": "2ea23f5c-bb34-33e1-ac5b-b77bb4c8ad1c",
                        "target_lang_word": "retaliate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retaliate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5dc53846-58f2-310d-9e2d-8043bff1cb06",
                                        "entry_id": "69ee21e1-fc99-3957-96f8-657cb0b8841e",
                                        "glosses": [
                                            "To do something harmful or negative to get revenge for some harm; to fight back or respond in kind to an injury or affront."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00726a0a-b6e2-465b-9fbb-24f21a451e31",
                                                "sense_id": "5dc53846-58f2-310d-9e2d-8043bff1cb06",
                                                "text": "John insulted Peter to retaliate for Peter's acid remark earlier."
                                            },
                                            {
                                                "example_id": "620f6bdf-40fd-4357-b7c1-af2c5ebbda5e",
                                                "sense_id": "5dc53846-58f2-310d-9e2d-8043bff1cb06",
                                                "text": "Many companies have policies in place to prevent bosses from retaliating against allegations of harassment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9705ac6-263d-3c34-90fc-3689e8c84314",
                                        "entry_id": "69ee21e1-fc99-3957-96f8-657cb0b8841e",
                                        "glosses": [
                                            "To repay or requite by an act of the same kind."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "854df5e2-905e-491f-9dab-2803d840ac41",
                                                "sense_id": "d9705ac6-263d-3c34-90fc-3689e8c84314",
                                                "text": "One ambassador sent word to the duke's son that his visit should be retaliated."
                                            },
                                            {
