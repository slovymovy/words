            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "46bf5f87-ee11-3687-aea7-55b1f66626a6",
                    "sense_definition": "pytanie o powód lub przyczynę czegoś; dlaczego, czemu",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Powiedz mi wreszcie, o <w>przecz</w> tak bardzo smucisz się od samego rana?",
                            "target_lang_translations": {
                                "en": "Tell me at last, oh <w>why</w> are you so sorrowful since early morning?"
                            }
                        },
                        {
                            "text": "Starzec spojrzał na wędrowca i zapytał cicho, <w>przecz</w> ten zakłóca spokój tej cichej doliny.",
                            "target_lang_translations": {
                                "en": "The old man looked at the wanderer and asked quietly <w>wherefore</w> he disturbed the peace of this quiet valley."
                            }
                        }
                    ],
                    "synonyms": [
                        "dlaczego",
                        "czemu"
                    ],
                    "common_phrases": [
                        "o przecz"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "wyraz przestarzały"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "asking about the reason or cause of something; why, wherefore (archaic)"
                    },
                    "translations": {
                        "en": [
