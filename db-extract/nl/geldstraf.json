                                    },
                                    {
                                        "sense_id": "fb500c15-4226-3ace-af90-cad1c35be868",
                                        "entry_id": "8d948c81-728a-3565-a234-9942c6a0ec15",
                                        "glosses": [
                                            "rechtliche Sanktion gegenüber einer Übertretungen; schweizerisch auch amtlich für Geldbuße"
                                        ],
                                        "tags": [
                                            "law"
                                        ],
                                        "examples": [
