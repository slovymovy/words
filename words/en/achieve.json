{
    "word_family": [
        "achievement",
        "achiever",
        "achievable",
        "unachievable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "24815c03-3c9f-3741-b05b-9b3bd2ba48e3",
                    "sense_definition": "To successfully complete a task or reach a specific goal, usually by working hard.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "success_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>achieve</w> anything if you put your mind to it.",
                            "target_lang_translations": {
                                "ru": "Ты можешь <w>добиться</w> чего угодно, если действительно захочешь.",
                                "tr": "Aklına koyarsan her şeyi <w>başarabilirsin</w>.",
                                "zh": "只要你下定决心，什么都能<w>实现</w>。"
                            }
                        },
                        {
                            "text": "Hannah <w>achieved</w> her lifelong dream of winning a medal at the Olympics.",
                            "target_lang_translations": {
                                "ru": "Ханна <w>осуществила</w> свою давнюю мечту — выиграть медаль на Олимпийских играх.",
                                "tr": "Hannah, Olimpiyatlar'da madalya kazanma konusundaki ömür boyu süren hayalini <w>gerçekleştirdi</w>.",
                                "zh": "汉娜<w>实现</w>了她终身的梦想，在奥运会上赢得了一枚奖牌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "accomplish",
                        "fulfill",
                        "realize",
                        "reach",
                        "finish"
                    ],
                    "antonyms": [
                        "miss"
                    ],
                    "common_phrases": [
                        "achieve a goal",
                        "achieve an objective",
                        "achieve a dream",
                        "achieve a target"
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешно выполнить задачу или достичь определенной цели, обычно благодаря упорному труду.",
                        "tr": "Genellikle çok çalışarak bir görevi başarıyla tamamlamak veya belirli bir hedefe ulaşmak.",
                        "zh": "通过努力工作，成功完成某项任务或达到特定目标。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достигать",
                                "target_lang_sense_clarification": "цели, вершины"
                            },
                            {
                                "target_lang_word": "осуществлять",
                                "target_lang_sense_clarification": "мечту, план"
                            },
                            {
                                "target_lang_word": "выполнять",
                                "target_lang_sense_clarification": "задачу"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ulaşmak",
                                "target_lang_sense_clarification": "hedefe, amaca"
                            },
                            {
                                "target_lang_word": "gerçekleştirmek",
                                "target_lang_sense_clarification": "hayali, planı"
                            },
                            {
                                "target_lang_word": "başarmak",
                                "target_lang_sense_clarification": "bir işi, görevi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实现",
                                "target_lang_sense_clarification": "用于梦想、目标或计划"
                            },
                            {
                                "target_lang_word": "达到",
                                "target_lang_sense_clarification": "用于目标、标准或水平"
                            },
                            {
                                "target_lang_word": "完成",
                                "target_lang_sense_clarification": "用于任务或工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a947f029-3668-307a-a81f-93220f7c8393",
                    "sense_definition": "To gain or obtain a desired result, status, or standard through effort or skill.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "success_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He worked very hard to <w>achieve</w> fame in his profession.",
                            "target_lang_translations": {
                                "ru": "Он очень много работал, чтобы <w>добиться</w> известности в своей профессии.",
                                "tr": "Mesleğinde ün <w>kazanmak</w> için çok çabaladı.",
                                "zh": "他非常努力，才在自己的行业中<w>获得</w>了名声。"
                            }
                        },
                        {
                            "text": "The team <w>achieved</w> a great victory against their rivals.",
                            "target_lang_translations": {
                                "ru": "Команда <w>добилась</w> великой победы над своими соперниками.",
                                "tr": "Takım, rakiplerine karşı büyük bir zafer <w>elde etti</w>.",
                                "zh": "该团队在与对手的较量中<w>取得</w>了伟大的胜利。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attain",
                        "obtain",
                        "gain",
                        "earn",
                        "win",
                        "reach",
                        "acquire"
                    ],
                    "antonyms": [
                        "lose"
                    ],
                    "common_phrases": [
                        "achieve success",
                        "achieve fame",
                        "achieve greatness",
                        "achieve a result"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получить желаемый результат, статус или уровень благодаря усилиям или мастерству.",
                        "tr": "Çaba veya beceri sayesinde istenen bir sonucu, statüyü veya standardı elde etmek.",
                        "zh": "通过努力或技能获得期望的结果、地位或标准。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добиваться",
                                "target_lang_sense_clarification": "успеха, победы, признания"
                            },
                            {
                                "target_lang_word": "достигать",
                                "target_lang_sense_clarification": "уровня, результата"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "elde etmek",
                                "target_lang_sense_clarification": "başarıyı, sonucu"
                            },
                            {
                                "target_lang_word": "kazanmak",
                                "target_lang_sense_clarification": "ün, unvan"
                            },
                            {
                                "target_lang_word": "yakalamak",
                                "target_lang_sense_clarification": "belirli bir seviyeyi, başarıyı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "获得",
                                "target_lang_sense_clarification": "用于成功、名声或结果"
                            },
                            {
                                "target_lang_word": "取得",
                                "target_lang_sense_clarification": "用于胜利、进步或成就"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "248d34e6-645a-35cd-a740-4febe9dedff5",
                    "sense_definition": "To perform successfully, especially in an academic or educational setting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "success_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school encourages every student to <w>achieve</w> at the highest level.",
                            "target_lang_translations": {
                                "ru": "Школа поощряет каждого ученика <w>добиваться</w> самых высоких результатов.",
                                "tr": "Okul, her öğrenciyi en üst düzeyde <w>başarılı olmaya</w> teşvik ediyor.",
                                "zh": "学校鼓励每一位学生都在最高水平上<w>取得成就</w>。"
                            }
                        },
                        {
                            "text": "Children often <w>achieve</w> better results when they are supported by their parents.",
                            "target_lang_translations": {
                                "ru": "Дети часто <w>добиваются</w> лучших результатов, когда их поддерживают родители.",
                                "tr": "Çocuklar, ebeveynleri tarafından desteklendiklerinde genellikle daha iyi sonuçlar <w>elde ederler</w>.",
                                "zh": "有父母支持的孩子往往更容易<w>取得成就</w>，成绩也更好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "succeed"
                    ],
                    "common_phrases": [
                        "achieve highly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добиваться успехов, показывать высокие результаты (особенно в учебе).",
                        "tr": "Özellikle akademik veya eğitimsel bir ortamda başarılı olmak, yüksek performans göstermek.",
                        "zh": "表现出色，尤指在学术或教育环境中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добиваться",
                                "target_lang_sense_clarification": "хороших результатов"
                            },
                            {
                                "target_lang_word": "преуспевать",
                                "target_lang_sense_clarification": "быть успешным"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "başarılı olmak",
                                "target_lang_sense_clarification": "okulda veya derslerde"
                            },
                            {
                                "target_lang_word": "yüksek performans göstermek",
                                "target_lang_sense_clarification": "akademik alanda"
                            }
                        ],
                        "zh": [
