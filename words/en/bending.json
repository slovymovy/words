                                "target_lang_word": "гибкий",
                                "target_lang_sense_clarification": "синоним"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "buigzaam",
                                "target_lang_sense_clarification": "eigenschap van materiaal"
                            },
                            {
                                "target_lang_word": "flexibel",
                                "target_lang_sense_clarification": "synoniem"
                            }
                        ]
                    }
                }
            ]
        },
