                        "translation_id": "93b1bdea-21fc-4d1b-84b1-10cc883ed016",
                        "source_entry_id": "f8f8a88f-4a69-37e6-8bca-17d0b61f076e",
                        "source_sense_id": "3652a779-ae57-3094-8d05-5cb50a213308",
