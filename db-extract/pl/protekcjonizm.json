                                "target_senses": [
                                    {
                                        "sense_id": "97a4ed40-dd16-3ce0-8d4c-43be4a404b45",
                                        "entry_id": "c75e5a41-35d8-30ca-9abd-7bf64cf47fa5",
                                        "glosses": [
                                            "Abschirmung der Wirtschaft eines Staates vor der Konkurrenz aus dem Ausland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b344a19-3206-461c-b286-c1b56eceea7f",
                                                "sense_id": "97a4ed40-dd16-3ce0-8d4c-43be4a404b45",
                                                "text": "Die europäischen Staaten werfen der US-amerikanischen Regierung Protektionismus vor."
                                            },
                                            {
                                                "example_id": "3ab09cbd-9725-4603-b66b-b1de728c001e",
                                                "sense_id": "97a4ed40-dd16-3ce0-8d4c-43be4a404b45",
                                                "text": "Eine weitere Form des Protektionismus ist der so genannte Kulturprotektionismus."
                                            },
                                            {
                                                "example_id": "76b1b1dd-87c8-4d98-b0dd-3bcc3f7c474c",
                                                "sense_id": "97a4ed40-dd16-3ce0-8d4c-43be4a404b45",
                                                "text": "„Gleichzeitig litt der Außenhandel weiterhin unter dem internationalen Protektionismus, der sich im Verlauf der Krise verstärkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f22bd719-a480-45bf-b000-bebee709812f",
                        "source_entry_id": "a4445bce-4fe6-3268-b233-7a8ff808196d",
                        "source_sense_id": "133081b4-6a61-3e4e-b30c-4651ac4c8548",
                        "target_lang_word": "протекционизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "протекционизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d576dea9-629c-3bff-8875-28edf5c31ca5",
                                        "entry_id": "c5c60bb7-b247-37df-a139-6f49f0a82a4d",
                                        "glosses": [
                                            "корыстное покровительство, оказываемое кому-либо лицом или группой лиц, обладающих властью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "269441c5-4c02-4642-98b7-2f220e26df00",
                                                "sense_id": "d576dea9-629c-3bff-8875-28edf5c31ca5",
                                                "text": "Канкану покровительствовали, а по системе протекционизма надо было заботиться о его развитии, и потому канкан-танцклассы открывались уже не на окраинах, а в самом центре Санкт-Петербурга."
                                            },
                                            {
                                                "example_id": "fbfd14b0-a4bb-40d3-be26-ab076d6c1fef",
                                                "sense_id": "d576dea9-629c-3bff-8875-28edf5c31ca5",
                                                "text": "Однако протекционизм, свивший себе гнездо во всех отраслях русской жизни, по-прежнему сплошь и рядом выдвигал на командные посты лиц далеко не достойных."
                                            },
                                            {
                                                "example_id": "721881df-e00b-423c-ba6f-1fbfa73199a8",
                                                "sense_id": "d576dea9-629c-3bff-8875-28edf5c31ca5",
                                                "text": "Он попытался начать борьбу с привилегиями номенклатуры, с семейственностью, протекционизмом и другими язвами режима."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16b4b1b9-8dd5-3680-801d-7a390c65eaee",
                                        "entry_id": "c5c60bb7-b247-37df-a139-6f49f0a82a4d",
                                        "glosses": [
                                            "экон. экономическая политика государства, заключающаяся в целенаправленном ограждении внутреннего рынка от поступления товаров иностранного производства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e359bf5-25ed-46ea-b257-cbb85d4f1879",
                                                "sense_id": "16b4b1b9-8dd5-3680-801d-7a390c65eaee",
                                                "text": "У дикарей нет таможенных пошлин, нет ничего подобного протекционизму; каждый торгует с иностранцем на тех же самых правах, как с одноплеменником, сбывает товары за границу и покупает иноземные товары точно с тою же степенью свободы, с какою идёт торговля в пределах самого племени туземными произведениями."
                                            },
                                            {
                                                "example_id": "738ba9e7-cd9e-4793-94b5-76d837383c11",
                                                "sense_id": "16b4b1b9-8dd5-3680-801d-7a390c65eaee",
                                                "text": "Помню также приезд на Кавказ Тенгоборгского, известного экономиста 50-х годов, который много способствовал привитию в России теории фритредерства и благодаря которому мы никак не могли отделаться от этой теории, и только при Императоре Александре III вступили на путь прямого и открытого протекционизма."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
