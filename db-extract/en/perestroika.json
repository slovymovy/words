                    {
                        "translation_id": "c6a670e0-fd26-402c-8d65-1b46324ba7bc",
                        "source_entry_id": "c0784fdc-34c7-384f-894e-68c84973e32b",
                        "source_sense_description": "reform in the Soviet Union in 1980s",
