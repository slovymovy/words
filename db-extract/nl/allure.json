                    },
                    {
                        "translation_id": "fc40d854-ca76-4562-a0c8-078645205ac9",
                        "source_entry_id": "9d876c6f-c83c-353f-ae95-828df88b8b06",
                        "source_sense_id": "fe3c079e-563c-3588-9af8-75461c96187c",
