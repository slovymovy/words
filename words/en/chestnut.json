        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16ce52c3-f82c-3bb3-bfed-8f354c3ae700",
                    "sense_definition": "A smooth, reddish-brown nut found inside a prickly casing, often eaten roasted.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "botany_nut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We gathered fresh <w>chestnuts</w> from the forest floor in autumn.",
                            "target_lang_translations": {
                                "ru": "Осенью мы собирали в лесу свежие <w>каштаны</w>.",
                                "zh": "秋天，我们从森林地面上收集了新鲜的<w>栗子</w>。"
                            }
                        },
                        {
                            "text": "The street vendor was selling hot roasted <w>chestnuts</w> to tourists.",
                            "target_lang_translations": {
                                "ru": "Уличный торговец продавал туристам горячие жареные <w>каштаны</w>.",
                                "zh": "街头小贩正在向游客兜售热腾腾的炒<w>栗子</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "roast chestnuts",
                        "sweet chestnut",
                        "water chestnut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гладкий красновато-коричневый орех в колючей оболочке, который часто едят жареным.",
                        "zh": "一种生长在带刺外壳内、光滑的红褐色坚果，常被烤着吃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кашта́н",
                                "target_lang_sense_clarification": "плод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "栗子",
                                "target_lang_sense_clarification": "果实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2de95ac-6625-3ac0-a438-b3756e38cf35",
                    "sense_definition": "A large tree that produces chestnuts.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "botany_tree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>chestnut</w> in the park provides excellent shade in the summer.",
                            "target_lang_translations": {
                                "ru": "Старый <w>каштан</w> в парке дает отличную тень летом.",
                                "zh": "公园里那棵老<w>栗树</w>在夏天提供了极好的树荫。"
                            }
                        },
                        {
                            "text": "Leaves from the <w>chestnut</w> turned a beautiful gold in October.",
                            "target_lang_translations": {
                                "ru": "В октябре листья <w>каштана</w> стали красиво-золотистыми.",
                                "zh": "十月，<w>栗树</w>的叶子变成了美丽的金色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chestnut tree"
                    ],
                    "common_phrases": [
                        "horse chestnut",
                        "American chestnut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое дерево, на котором растут каштаны.",
                        "zh": "结栗子的大树。"
                    },
                    "translations": {
