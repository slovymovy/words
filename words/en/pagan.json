                {
                    "sense_id": "285e8214-c0dc-3256-9a4b-12061affc74e",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The family name <w>Pagan</w> has roots in several European countries.",
                            "target_lang_translations": {
                                "nl": "De achternaam <w>Pagan</w> heeft wortels in verschillende Europese landen."
                            }
                        },
                        {
                            "text": "Mr. <w>Pagan</w> was the lead researcher on the project.",
                            "target_lang_translations": {
                                "nl": "Meneer <w>Pagan</w> was de hoofdonderzoeker van het project."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name."
                        }
