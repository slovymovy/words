                ],
                "senses": [
                    {
                        "sense_id": "15d1e67a-1728-3574-adee-77d8e52a8612",
                        "entry_id": "62557baa-ace5-32c9-9e27-278a8f4b9c26",
                        "glosses": [
                            "roślina o długich pędach, wijąca się ku górze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35e5ee4c-9594-4efe-8913-8d58a98bfa20",
                                "sense_id": "15d1e67a-1728-3574-adee-77d8e52a8612",
                                "text": "Sadzonki róży mają rozmiary od zwartych, miniaturowych róż, do pnącz osiągających 7 metrów wysokości."
                            },
                            {
                                "example_id": "0da046a2-660b-4dd3-860b-4f25f97f0557",
                                "sense_id": "15d1e67a-1728-3574-adee-77d8e52a8612",
                                "text": "Kraina nie była pustynna: jak okiem sięgnąć, widniały w niej doliny i wzgórza, porosłe ślicznymi kępami drzew, wokół których wiły się pnącze, zwoje bluszczu i winogradu zwieszały się ze skał."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7ddbb75-49d6-4c41-9793-6b5ebc44654c",
                        "source_entry_id": "62557baa-ace5-32c9-9e27-278a8f4b9c26",
                        "source_sense_id": "15d1e67a-1728-3574-adee-77d8e52a8612",
                        "target_lang_word": "plante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b3cde21-fb43-33f0-81f2-ed1511ec274b",
                                        "entry_id": "4829a9f8-567f-311f-acf8-4c3c9029f606",
                                        "glosses": [
                                            "Végétal."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c7bb202-730c-4572-a615-c0744cab9fb5",
                                                "sense_id": "3b3cde21-fb43-33f0-81f2-ed1511ec274b",
                                                "text": "Bolet (d’un mot grec qui veut dire boule). Ce nom a été appliqué à ces plantes parce que leur chapeau est souvent globuleux."
                                            },
                                            {
                                                "example_id": "bb1fe563-33ea-4389-852a-10c3cada4c9f",
                                                "sense_id": "3b3cde21-fb43-33f0-81f2-ed1511ec274b",
                                                "text": "Toutes ces plantes appartiennent à la classe des cultures dites industrielles, parce qu’elles fournissent des produits qui servent de matières premières à l’industrie."
                                            },
                                            {
                                                "example_id": "950718b5-12ed-4262-8675-50ad6210cbee",
                                                "sense_id": "3b3cde21-fb43-33f0-81f2-ed1511ec274b",
                                                "text": "Elle consistait à boire l’urine de ceux qui les premiers avaient consommé cette plante. L’ingrédient actif de l’amanite, la muscimole, est en effet le seul hallucinogène naturel qui, une fois excrété par l’organisme, en ressort inchangé."
                                            },
                                            {
                                                "example_id": "375b64a4-114f-4b41-9db4-6b482fd61c3d",
                                                "sense_id": "3b3cde21-fb43-33f0-81f2-ed1511ec274b",
                                                "text": "Ils changent d’activité au rythme des saisons, fabriquent des charpagnes ou cherchent dans les bois les plantes médicinales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92203c83-7404-34c1-8cd6-78a8f6d0b1c5",
                                        "entry_id": "4829a9f8-567f-311f-acf8-4c3c9029f606",
                                        "glosses": [
                                            "Nom général sous lequel on comprend tous les végétaux, organismes vivants du royaume Plantae, c’est-à-dire les eucaryotes qui possèdent du chloroplaste dans ses cellules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b076c9-01d4-4fce-b668-e1a264cb2bce",
                                                "sense_id": "92203c83-7404-34c1-8cd6-78a8f6d0b1c5",
                                                "text": "Les traités de phytogéographie étudient en général l’action du milieu sur la répartition des plantes."
                                            },
                                            {
                                                "example_id": "3c0783cc-2743-4cb9-92dd-049bde0ddaef",
                                                "sense_id": "92203c83-7404-34c1-8cd6-78a8f6d0b1c5",
                                                "text": "Vue de loin, la nature semble harmonieuse. Vue de près, on y observe que les plantes cherchent à s’étouffer les unes les autres et que les animaux utilisent la prédation et le parasitisme."
                                            },
                                            {
                                                "example_id": "319b9178-4dac-4446-b026-5d8b107e36c1",
                                                "sense_id": "92203c83-7404-34c1-8cd6-78a8f6d0b1c5",
                                                "text": "Les arbres, les fougères, et les fleurs sont des plantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "730efe64-b760-3326-9f22-ae536168c532",
                                        "entry_id": "4829a9f8-567f-311f-acf8-4c3c9029f606",
                                        "glosses": [
                                            "Végétal non ligneux ; herbe."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0126a52e-0c3e-4a89-a56e-613f660c32a9",
                                                "sense_id": "730efe64-b760-3326-9f22-ae536168c532",
                                                "text": "Plantes sarmenteuses, grimpantes."
                                            },
                                            {
                                                "example_id": "6b4434e1-5eb6-4ee7-91fe-afa82f136e0b",
                                                "sense_id": "730efe64-b760-3326-9f22-ae536168c532",
                                                "text": "Plantes potagères."
                                            },
                                            {
                                                "example_id": "466751ab-75d6-45dd-98aa-d8b0809d2f18",
                                                "sense_id": "730efe64-b760-3326-9f22-ae536168c532",
                                                "text": "Plantes vénéneuses."
                                            },
                                            {
                                                "example_id": "6c6565b1-6d59-443d-ae7a-8f2f033a6f11",
                                                "sense_id": "730efe64-b760-3326-9f22-ae536168c532",
                                                "text": "Parmi les plantes oléagineuses, on cultive le colza et la navette, et, parmi les plantes textiles, le chanvre et le lin ; […]."
                                            },
                                            {
                                                "example_id": "b82a7a68-28b9-4cb4-bb98-c5184cdef3ba",
                                                "sense_id": "730efe64-b760-3326-9f22-ae536168c532",
                                                "text": "Les champs d’avoine sont, certaines années, envahis par des plantes nuisibles telles que les chardons, les sanves, moutardes sauvages, ravenelles ; […]."
                                            },
                                            {
                                                "example_id": "55d0145d-8a07-449e-9173-12d9b02de163",
                                                "sense_id": "730efe64-b760-3326-9f22-ae536168c532",
                                                "text": "Ainsi, lorsqu'un sol argileux, compacte, se trouve, par négligence, envahi par des plantes nuisibles, à racines vivaces et traçantes, et par conséquent très difficiles à détruire, telles que celles du pas-d’âne, du chiendent et d'autres, les cultures étouffantes deviennent insuffisantes pour la destruction de ces plantes, car elles n'agissent avec efficacité que sur les espèces annuelles."
                                            },
                                            {
                                                "example_id": "11bef595-5d01-4aa4-81d6-0f55d8f4f5f3",
                                                "sense_id": "730efe64-b760-3326-9f22-ae536168c532",
                                                "text": "Plantes grasses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a49529f-b368-3e2b-a627-11ae1c8c19c7",
                                        "entry_id": "4829a9f8-567f-311f-acf8-4c3c9029f606",
                                        "glosses": [
                                            "Plante médicinale."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18dae8aa-2af1-4535-8e78-01b73487241c",
                                                "sense_id": "0a49529f-b368-3e2b-a627-11ae1c8c19c7",
                                                "text": "La sanicle est une de ces plantes autrefois célèbres, comme vulnéraires ; […]. Elle est utile pour déterger les ulcères."
                                            },
                                            {
                                                "example_id": "913096e0-b237-4787-97cc-92fe84465b6f",
                                                "sense_id": "0a49529f-b368-3e2b-a627-11ae1c8c19c7",
                                                "text": "La connaissance des plantes est nécessaire à un médecin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26129e52-63e4-32b0-a599-ae84f2c8ff0d",
                                        "entry_id": "4829a9f8-567f-311f-acf8-4c3c9029f606",
                                        "glosses": [
                                            "Jeune vigne ; vigne nouvelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79c5496d-58a4-4f55-9609-62fb3a4a192a",
                                                "sense_id": "26129e52-63e4-32b0-a599-ae84f2c8ff0d",
                                                "text": "Du vin d’une nouvelle plante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a38c35e9-9bc9-3b2d-939e-730152daac87",
                                        "entry_id": "4829a9f8-567f-311f-acf8-4c3c9029f606",
                                        "glosses": [
                                            "Partie inférieure du pied sur laquelle le corps prend appui lorsqu’un individu est debout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cd6ecab-86b3-45a6-865c-357b5f246a52",
                                                "sense_id": "a38c35e9-9bc9-3b2d-939e-730152daac87",
                                                "text": "Les talons battaient de fièvre, la plante s’était couverte d’ampoules, dont la peau arrachée se collait à ses bas."
                                            },
                                            {
                                                "example_id": "5a25d8b6-f948-4b43-bab4-8bda54f3b698",
                                                "sense_id": "a38c35e9-9bc9-3b2d-939e-730152daac87",
                                                "text": "Soutenu de chaque côté, je sentais la plante de mes pieds enflée au point de me donner l’impression que chacun de mes pas s’enfonçait dans un nuage."
                                            },
                                            {
                                                "example_id": "8af7b585-e00e-4770-bd71-ba4f48e574f0",
                                                "sense_id": "a38c35e9-9bc9-3b2d-939e-730152daac87",
                                                "text": "Ses petits-enfants soufflottaient sur le divan ; elle grattait doucement la plante de leurs pieds roses pour améliorer les ris de leurs rêves enfantins."
                                            }
                                        ]
                                    }
                                ]
                            },
