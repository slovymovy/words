                    "sense_id": "2f8a4cc8-e02a-34a8-a030-326d0eef7cfd",
                    "sense_definition": "Pendant une durée prolongée, durant un long espace de temps.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "durée",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai attendu <w>longtemps</w> sous la pluie avant l'arrivée du bus.",
                            "target_lang_translations": {
                                "en": "I waited <w>a long time</w> in the rain before the bus arrived.",
                                "ru": "Под дождём пришлось <w>долго</w> ждать, прежде чем подошёл автобус.",
                                "nl": "Ik heb <w>lang</w> in de regen gewacht voordat de bus kwam.",
                                "de": "Ich habe <w>lange</w> im Regen gewartet, bevor der Bus kam.",
                                "pl": "Czekałem <w>długo</w> w deszczu, zanim przyjechał autobus.",
                                "it": "Ho aspettato <w>a lungo</w> sotto la pioggia prima che arrivasse l'autobus.",
                                "cs": "Čekal jsem <w>dlouho</w> v dešti, než přijel autobus.",
                                "tr": "Otobüs gelene kadar yağmurun altında <w>uzun süre</w> bekledim.",
                                "es": "Esperé <w>mucho tiempo</w> bajo la lluvia antes de que llegara el autobús.",
                                "zh": "我在雨里等了<w>很久</w>，公交车才来。"
                            }
                        },
                        {
                            "text": "<w>Longtemps</w>, elle a cru que son rêve d'enfant deviendrait réalité.",
                            "target_lang_translations": {
                                "en": "<w>For a long time</w>, she believed her childhood dream would become reality.",
                                "ru": "<w>Долгое время</w> она верила, что её детская мечта сбудется.",
                                "nl": "<w>Lange tijd</w> geloofde ze dat haar kinderdroom werkelijkheid zou worden.",
                                "de": "<w>Lange Zeit</w> glaubte sie, dass ihr Kindheitstraum Wirklichkeit werden würde.",
                                "pl": "<w>Przez długi czas</w> wierzyła, że jej dziecięce marzenie się spełni.",
                                "it": "<w>Per molto tempo</w> ha creduto che il suo sogno d'infanzia sarebbe diventato realtà.",
                                "cs": "<w>Dlouho</w> věřila, že se její dětský sen jednou splní.",
                                "tr": "<w>Uzun süre</w>, çocukluk hayalinin gerçekleşeceğine inandı.",
                                "es": "<w>Durante mucho tiempo</w>, creyó que su sueño de infancia se haría realidad.",
                                "zh": "<w>很长一段时间</w>里，她都相信自己童年的梦想终会成真。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rester longtemps",
                        "attendre longtemps",
                        "dormir longtemps"
                    ],
                    "target_lang_definitions": {
