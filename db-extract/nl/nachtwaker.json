                        "entry_id": "362980ca-d25e-35fe-a33a-1f12a91561b9",
                        "glosses": [
                            "a nightguard (person), a night watchman (usually male)"
                        ],
                        "tags": [
                            "masculine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "67248dc6-71ac-4641-8df9-d3bb065b25f5",
                                "sense_id": "9ea582ab-6f12-3c54-8634-260655c6b238",
                                "text": "De nachtwaker patrouilleerde door het gebouw om te zorgen dat alles veilig was.",
                                "translation": "The nightguard patrolled the building to ensure everything was safe.",
                                "english": "The nightguard patrolled the building to ensure everything was safe."
                            },
                            {
                                "example_id": "c0e87669-a0c1-4f1b-a034-f3f1db714424",
                                "sense_id": "9ea582ab-6f12-3c54-8634-260655c6b238",
                                "text": "De nachtwaker hoorde een vreemd geluid vanuit de kelder.",
                                "translation": "The night watchman heard a strange noise coming from the basement.",
                                "english": "The night watchman heard a strange noise coming from the basement."
                            },
                            {
                                "example_id": "781e9b8c-19e0-4f6b-8547-12f4e802544d",
                                "sense_id": "9ea582ab-6f12-3c54-8634-260655c6b238",
                                "text": "Elke avond om 22.00 uur begint de nachtwaker met zijn ronde.",
                                "translation": "Every evening at 10:00 pm, the nightguard starts his round.",
                                "english": "Every evening at 10:00 pm, the nightguard starts his round."
                            },
                            {
                                "example_id": "9204de52-0dab-4abb-b0e6-4ee3bb05371a",
                                "sense_id": "9ea582ab-6f12-3c54-8634-260655c6b238",
                                "text": "1517, Cornelius Aurelius, Die cronycke van Hollandt, Zeelandt ende Vrieslant, met die cronike der biscoppen van Uutrecht, Aarnoud de Hamer (ed.), 2011 critical edition, page 280 recto.\nDie nachtwakers, siende den groten brant, sloegen die clocke, verwreckende die poorters omme den brant te lesschen, want daer meer huysen van den brande ontstaken.",
                                "translation": "The night watchmen, seeing the large fire, sounded the bell, alarming the burghers to extinguish the fire, because more houses were being ignited by the fire.",
                                "english": "The night watchmen, seeing the large fire, sounded the bell, alarming the burghers to extinguish the fire, because more houses were being ignited by the fire."
                            }
                        ]
                    }
