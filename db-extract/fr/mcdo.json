                    {
                        "translation_id": "ac8701ff-bb52-4c9b-92e9-135b4dc01af4",
                        "source_entry_id": "46d04478-c992-353c-9f2a-d72cf38201b8",
                        "source_sense_description": "McDonald’s (contraction)",
                        "target_lang_word": "Golden Arches",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Golden Arches",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f94b2aaa-d045-3ad2-9a60-73fa1f4a235c",
                                        "entry_id": "bd59a8f2-58e3-36cd-9614-d0f463d7e1ab",
                                        "glosses": [
                                            "A McDonald's restaurant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2873f21-76fe-4577-a29e-6cb9556707d2",
                                                "sense_id": "f94b2aaa-d045-3ad2-9a60-73fa1f4a235c",
                                                "text": "Suzan-Lori Parks is drawn to archways. Early on in her New York life, long before she became one of the nation’s most acclaimed playwrights, she lived above a McDonald’s on Sixth Avenue — the Golden Arches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b761c9-a6ef-3484-92f4-02590d611298",
                                        "entry_id": "bd59a8f2-58e3-36cd-9614-d0f463d7e1ab",
                                        "glosses": [
                                            "The McDonald's company, or the fast food industry in general."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f091011-1808-4779-ada5-17b35ddfd004",
                        "source_entry_id": "46d04478-c992-353c-9f2a-d72cf38201b8",
                        "source_sense_description": "McDonald’s (contraction)",
                        "target_lang_word": "Mickey D's",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mickey D's",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a9b2a15-3370-316e-b731-2d034d069385",
                                        "entry_id": "47a924a5-dec4-3031-ac8e-ec43ecb057ef",
                                        "glosses": [
                                            "McDonald's (the chain of fast food restaurants)."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d1d5a1b-1391-4be8-a2ec-a9c294f712ea",
                                                "sense_id": "7a9b2a15-3370-316e-b731-2d034d069385",
                                                "text": "What would I tell him, “Sorry, darling, I was at Mickey D's”?"
                                            },
                                            {
                                                "example_id": "38e515a5-689a-4504-8789-26d6f62ec347",
                                                "sense_id": "7a9b2a15-3370-316e-b731-2d034d069385",
                                                "text": "For those five days each month when we've been hormonally hijacked, there are women's health clinics to be defended, underpaid amigas at Mickey D's to be organized, and redwood trees to be protected."
                                            },
                                            {
                                                "example_id": "f5c9cc9f-8af8-494b-8ad0-1ffa0dc5b259",
                                                "sense_id": "7a9b2a15-3370-316e-b731-2d034d069385",
                                                "text": "He looked around. This place wasn't exactly Mickey D's, but it was sure a lot better than some of the places he'd been eating in lately."
                                            },
                                            {
                                                "example_id": "590f48d3-0922-477d-8991-029aa48521fb",
                                                "sense_id": "7a9b2a15-3370-316e-b731-2d034d069385",
                                                "text": "\"Hey, listen here, ya'll,\" Serena said, \"I don't know if big is beautiful, but Mickey D's fries and Dunkin' Donuts are damn masterpieces. They're straight-up works of art. O-kayyyy?\""
                                            },
                                            {
                                                "example_id": "ac6d84e5-3cf9-47ec-a42c-b80d5ac7a6c0",
                                                "sense_id": "7a9b2a15-3370-316e-b731-2d034d069385",
                                                "text": "\"This like Mickey D's. It's all about the dollar.\" \"I can pay you,\" said the old woman. She raised a pathetic handful of ragged bills."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59441ee3-3142-4d32-91a9-b5ae1ce85b06",
                        "source_entry_id": "46d04478-c992-353c-9f2a-d72cf38201b8",
