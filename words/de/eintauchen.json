                {
                    "sense_id": "72db27a7-1f5e-3729-bb4f-db852c2407a0",
                    "sense_definition": "einen Gegenstand oder ein Lebensmittel ganz oder teilweise in eine Flüssigkeit stecken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fluessigkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>tauchte</w> ein Stück Brot vorsichtig in die warme Suppe <w>ein</w>."
                        },
                        {
                            "text": "Vor dem Malen muss die Künstlerin den Pinsel gründlich in die Farbe <w>eintauchen</w>."
                        }
                    ],
                    "synonyms": [
                        "dippen",
                        "eintunken",
                        "tunken"
                    ],
                    "common_phrases": [
