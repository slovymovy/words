                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ae25831c-8059-45de-9a34-f4718185b273",
                        "source_entry_id": "22d6a5d9-1791-3f25-9b35-955209c1a2f5",
                        "source_sense_id": "e5773498-c300-320b-86d1-4ec7aff5a360",
                        "target_lang_word": "ventriloquía",
