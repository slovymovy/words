            "senses": [
                {
                    "sense_id": "84423adb-0888-3c28-a315-9e17cefefdee",
                    "sense_definition": "ein Fest, ein Konzert, einen Wettbewerb oder ein anderes öffentliches Ereignis planen und durchführen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ereignis_planen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unsere Schule <w>veranstaltet</w> jedes Jahr im Sommer ein großes Sportfest für alle Klassen."
                        },
                        {
                            "text": "Der Verein möchte nächste Woche ein Konzert <w>veranstalten</w>, um Geld für den Spielplatz zu sammeln."
                        }
                    ],
                    "synonyms": [
                        "organisieren",
                        "ausrichten",
                        "durchführen"
                    ],
                    "antonyms": [
                        "unterlassen"
                    ],
                    "common_phrases": [
                        "ein Fest veranstalten",
                        "ein Konzert veranstalten",
                        "einen Wettbewerb veranstalten"
                    ]
                },
