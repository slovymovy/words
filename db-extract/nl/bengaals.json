                        "source_entry_id": "94d2dd96-50e1-314a-9181-abe62b54622b",
                        "source_sense_id": "7c89cef0-e50d-33fa-affc-e2631952bdf2",
                        "source_sense_description": "een taal die in Bangladesh en West-Bengalen gesproken wordt",
                        "target_lang_word": "Bangla",
