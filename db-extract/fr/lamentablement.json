        "fr-extract.jsonl": [
            {
                "entry_id": "a5fbd116-543a-3d94-9d96-0a5895b6b037",
                "word": "lamentablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d71a2447-0d7d-3eec-bb2b-cdde2435e6b1",
                        "entry_id": "a5fbd116-543a-3d94-9d96-0a5895b6b037",
                        "glosses": [
                            "D’un ton lamentable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f76e55c4-06a0-43d4-9c22-4f75323fba90",
                                "sense_id": "d71a2447-0d7d-3eec-bb2b-cdde2435e6b1",
                                "text": "Un petit terrier écossais soufflait lamentablement, la langue dehors."
                            }
                        ]
                    },
                    {
                        "sense_id": "2465b901-f9ee-33ea-b094-87a57bc789d9",
                        "entry_id": "a5fbd116-543a-3d94-9d96-0a5895b6b037",
                        "glosses": [
                            "De façon à se lamenter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01cb0e95-e1f5-4980-8a6c-40836f864f97",
                                "sense_id": "2465b901-f9ee-33ea-b094-87a57bc789d9",
                                "text": "Et il s'était trouvé seul, lamentablement, dans l'angoisse de ce pays qui, maintenant, l'effrayait."
                            },
                            {
                                "example_id": "7fc032ef-ad16-4a38-946e-a99559d7129c",
                                "sense_id": "2465b901-f9ee-33ea-b094-87a57bc789d9",
                                "text": "Parfois y oscillait un squelette blanchi, et le vent, secouant lamentablement les os desséchés, chassait la sombre nuée de corbeaux venue pour les festins lugubres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8020be7d-efb4-4861-b459-d10832d9628a",
                        "source_entry_id": "a5fbd116-543a-3d94-9d96-0a5895b6b037",
                        "target_lang_word": "jämmerlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jämmerlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01cbcea3-d6e8-3a6a-bd4a-6bd2c9d05269",
                                        "entry_id": "80d73f81-1b05-35c2-9b09-ea48113d2d99",
                                        "glosses": [
                                            "sehr schlecht, negativ (unter variablen Gesichtspunkten) bis hin zu Mitleid erzeugend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f721dd2-516b-4bbc-a2c3-031315c420d4",
                                                "sense_id": "01cbcea3-d6e8-3a6a-bd4a-6bd2c9d05269",
                                                "text": "Sein jämmerliches Aussehen schreckte alle ab."
                                            },
                                            {
                                                "example_id": "d7682b7f-ee56-4ee0-a62e-cfbb748dea2d",
                                                "sense_id": "01cbcea3-d6e8-3a6a-bd4a-6bd2c9d05269",
                                                "text": "Er legte eine jämmerliche Darbietung hin."
                                            },
                                            {
                                                "example_id": "ebaabe58-fe17-47f1-93ca-fe95d0213111",
                                                "sense_id": "01cbcea3-d6e8-3a6a-bd4a-6bd2c9d05269",
                                                "text": "\"Die Altstadt [von Görlitz] sah jämmerlich aus, schwarze Patina, zerfallene Häuser, der größte Teil stand leer\", erinnert sich der Dresdner Fotograf Jörg Schöner."
                                            },
                                            {
                                                "example_id": "5c7144c6-31f2-4b0a-88e3-bc51b9848f59",
                                                "sense_id": "01cbcea3-d6e8-3a6a-bd4a-6bd2c9d05269",
                                                "text": "Der russische Rückzug ins Landesinnere – der Napoleon zur Verzweiflung trieb – war zum Beispiel keineswegs eine strategische Raffinesse, um die feindlichen Nachschubwege zu überlasten und die Franzosen fern von zuhause jämmerlich zugrunde gehen zu lassen. Russlands Armee profitierte dabei vielmehr von der Inkompetenz ihrer Befehlshaber."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b07771e3-0572-4fd9-9b5d-a20d478565d9",
                        "source_entry_id": "a5fbd116-543a-3d94-9d96-0a5895b6b037",
                        "target_lang_word": "lamentably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamentably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03c5bec4-9b7f-3c16-b01d-3da3b145b2f3",
                                        "entry_id": "56c72e7e-54c1-32e4-9a40-0cfa7e2cd40b",
                                        "glosses": [
                                            "Regrettably. In a manner deserving or inspiring lamentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a28dec13-f744-4449-a2c9-09a1d357be82",
                                                "sense_id": "03c5bec4-9b7f-3c16-b01d-3da3b145b2f3",
                                                "text": "Lamentably the good too die; we will all mourn his passing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bf78941-add1-4fe7-a970-4860a4b28a38",
                        "source_entry_id": "a5fbd116-543a-3d94-9d96-0a5895b6b037",
                        "target_lang_word": "miserably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miserably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                                        "entry_id": "eee3e5b1-0d1f-3dd8-ad3e-5eab4ea76327",
                                        "glosses": [
                                            "In a miserable manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c0a4d5-5731-4cd9-8027-52e2498a36b7",
                                                "sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                                                "text": "I just need you miserably\nBroken man come to me\nI just need you desperately\nJust want to change your mind"
                                            },
                                            {
                                                "example_id": "b49379d3-59a2-4fef-8a75-8aa08a6a245c",
                                                "sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                                                "text": "fail miserably"
                                            },
                                            {
                                                "example_id": "7f798d89-2367-4db0-8866-08eac1c92f85",
                                                "sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                                                "text": "\"Well, sorcerer?\" growled the Norman. \"Nay, not well,\" replied Catweazle shivering miserably, \"I have the bone-ache.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
