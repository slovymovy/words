    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a7b2d38-9d46-3008-b60b-3bdf3ef8fc2f",
                    "sense_definition": "bijzonder hard regenen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "regen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hele dag <w>plensde</w> het, maar tegen de avond klaarde het op.",
                            "target_lang_translations": {
                                "en": "It <w>poured</w> all day, but towards the evening it cleared up.",
                                "ru": "Весь день <w>лило как из ведра</w>, но к вечеру прояснилось."
                            }
                        },
                        {
                            "text": "Het begon plotseling te <w>plenzen</w> van de regen toen we naar huis fietsten.",
                            "target_lang_translations": {
                                "en": "It suddenly started <w>pelting down</w> with rain as we cycled home.",
                                "ru": "Внезапно начал <w>хлестать</w> дождь, когда мы ехали домой на велосипедах."
                            }
                        }
                    ],
                    "synonyms": [
                        "gieten"
                    ],
                    "common_phrases": [
                        "plenzen van de regen"
                    ],
                    "target_lang_definitions": {
                        "en": "To rain very heavily or intensely.",
                        "ru": "очень сильно идти (о дожде)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pour",
                                "target_lang_sense_clarification": "referring to heavy rain"
                            },
                            {
                                "target_lang_word": "to pelt down",
                                "target_lang_sense_clarification": "referring to heavy rain"
                            },
                            {
                                "target_lang_word": "to bucket down",
                                "target_lang_sense_clarification": "informal expression for heavy rain"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лить как из ведра",
                                "target_lang_sense_clarification": "о сильном дожде"
                            },
                            {
                                "target_lang_word": "хлестать",
                                "target_lang_sense_clarification": "о проливном дожде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "615ef885-3fa6-3999-b36f-dd85c408343d",
                    "sense_definition": "veel vloeistof ineens uitstorten",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vloeistof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>plenst</w> de melk in de beslagkom.",
                            "target_lang_translations": {
                                "en": "He <w>splashes</w> the milk into the mixing bowl.",
                                "ru": "Он <w>плещет</w> молоко в миску для теста."
                            }
                        },
                        {
                            "text": "Zonder te kijken <w>plensde</w> zij een emmer water over de stoep.",
                            "target_lang_translations": {
                                "en": "Without looking, she <w>sloshed</w> a bucket of water over the pavement.",
                                "ru": "Не глядя, она <w>выплеснула</w> ведро воды на тротуар."
                            }
                        }
                    ],
                    "common_phrases": [
                        "water plenzen"
                    ],
                    "target_lang_definitions": {
                        "en": "To pour out a large amount of liquid all at once.",
                        "ru": "выливать большое количество жидкости за один раз"
                    },
                    "translations": {
