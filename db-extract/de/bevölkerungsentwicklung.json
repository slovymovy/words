                "senses": [
                    {
                        "sense_id": "9b3aca60-387b-3408-ba43-83b6522e093e",
                        "entry_id": "838697e5-cb08-3257-b1de-d127c2255e8f",
                        "glosses": [
                            "Veränderung der Personenzahl in einem bestimmten Bereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33cd2ecc-6ba0-4113-80c1-fb2039b1b377",
                                "sense_id": "9b3aca60-387b-3408-ba43-83b6522e093e",
                                "text": "„Was die Bevölkerungsentwicklung der Stadt betrifft, so war diese seit dem Zweiten Weltkrieg - im Vergleich zu anderen städtischen Räumen der Bundesrepublik - durch eine eher geringe Dynamik geprägt.“"
                            },
                            {
                                "example_id": "0f9ee109-c4fb-4e83-bb61-23e3f3bd6789",
                                "sense_id": "9b3aca60-387b-3408-ba43-83b6522e093e",
                                "text": "„Sollten sich diese Angaben bestätigen, entspräche dies einem Zuwachs von ca. 47 Prozent seit dem letzten Zensus von 1998 (131 Millionen) und 20 Millionen Einwohnern mehr, als die Vereinten Nationen für die Bevölkerungsentwicklung des Landes prognostiziert hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
