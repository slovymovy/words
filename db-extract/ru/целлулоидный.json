                        "entry_id": "6d52331e-9941-3e7e-ab1e-b105bdf84901",
                        "glosses": [
                            "изгтовленный, сделанный из целлулоида"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec2bc403-1a74-4bc3-8c55-70faedcaf5ea",
                                "sense_id": "01c41684-4011-34cb-8202-6333949a9db9",
                                "text": "Утром вылезли уже расписанные в районном загсе из украшенной цветными лентами шарами целлулоидным пупсом на радиаторе машины, теперь принимают поздравления…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "404618a4-4da0-4dc2-9a52-f7a384008fe8",
                        "source_entry_id": "6d52331e-9941-3e7e-ab1e-b105bdf84901",
                        "target_lang_word": "celluloid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "celluloid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00a6f9d7-6cf3-3027-806f-2ecd138d56e5",
                                        "entry_id": "57ee7cea-ffc0-3dab-bc4b-099b370d2bf2",
                                        "glosses": [
                                            "Any of a variety of thermoplastics created from nitrocellulose and camphor, once used as photographic film."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "584d65b2-7567-4176-b6eb-d590a40fd367",
                                                "sense_id": "00a6f9d7-6cf3-3027-806f-2ecd138d56e5",
                                                "text": "1894 June, Antonia Dickson, W. K. L. Dickson, Edison's Invention of the Kineto-Phonograph: Account of the Invention, article in Century Magazine, Volume 48, Issue 2,\nThen followed some experiments with drums, over which sheets of sensitized celluloid film were drawn, the edges being pressed into a narrow slot in the surface, similar in construction to the old tin-foil phonograph."
                                            },
                                            {
                                                "example_id": "2ae29710-2bad-4bc9-968f-f37285d3c7c2",
                                                "sense_id": "00a6f9d7-6cf3-3027-806f-2ecd138d56e5",
                                                "text": "\"And will you now, sir, take off your celluloid collar and permit me to burn it in the candle? Thank you, sir. And will you allow me to smash your spectacles for you with my hammer? Thank you.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e093a0a-0983-3430-9542-26173a924d6c",
                                        "entry_id": "57ee7cea-ffc0-3dab-bc4b-099b370d2bf2",
                                        "glosses": [
                                            "The genre of cinema; film."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "figuratively",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b1c3a9-7b33-4127-9ee4-027859e96c25",
                                                "sense_id": "6e093a0a-0983-3430-9542-26173a924d6c",
                                                "text": "Celluloid railway comedy was hardly to appear again until the mid-thirties and, later, in Britain."
                                            },
                                            {
                                                "example_id": "3ddec937-0e34-4c3c-8fba-c624c6240b2d",
                                                "sense_id": "6e093a0a-0983-3430-9542-26173a924d6c",
                                                "text": "In particular, they set Kerouac and Ginsberg to the specifications of an emergent superficial form—celluloid antiheroes—attractive to those in want of adventure and who would soon be reading On the Road (1957)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8c3c802-b7b8-367e-a80c-2bd7786e2ff8",
                                        "entry_id": "57ee7cea-ffc0-3dab-bc4b-099b370d2bf2",
                                        "glosses": [
                                            "An item, such as a jacket, made from celluloid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b2b346f-d803-47c6-95f0-c3546ca8de85",
                                                "sense_id": "e8c3c802-b7b8-367e-a80c-2bd7786e2ff8",
                                                "text": "'What with that bearded Assyrian bull in London, and this Thug down here, who has ruined my clean celluloid, you seem to be keeping queer company, Ted Malone.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
