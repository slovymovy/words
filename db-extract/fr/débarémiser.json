                                "example_id": "f1456bd7-c145-42c5-9f2a-2e793305e3a5",
                                "sense_id": "a5391c23-3a06-3669-838f-d647dc6cf3b3",
                                "text": "Par contre depuis que c’est \"débarémisé\", c’est la misère pour les architectes…"
                            }
                        ]
