                {
                    "sense_id": "2c1dd0da-9783-31d7-b694-517bbb5c8787",
                    "sense_definition": "Слово, выражающее согласие и полное одобрение в диалоге.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quality_good",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Мы встретимся завтра в парке? — <w>Отлично</w>!",
                            "target_lang_translations": {
                                "en": "— Shall we meet in the park tomorrow? — <w>Great</w>!",
                                "zh": "— 我们明天在公园见面好吗？— <w>太好了</w>！",
                                "nl": "— Zullen we morgen in het park afspreken? — <w>Geweldig</w>!",
                                "pl": "— Spotkamy się jutro w parku? — <w>Świetnie</w>!",
                                "de": "— Treffen wir uns morgen im Park? — <w>Abgemacht</w>!",
                                "fr": "— On se retrouve au parc demain ? — <w>Parfait</w> !",
                                "it": "— Ci vediamo domani al parco? — <w>Ottimo</w>!",
                                "cs": "— Sejdeme se zítra v parku? — <w>Skvělé</w>!",
                                "tr": "— Yarın parkta buluşalım mı? — <w>Harika</w>!",
                                "es": "— ¿Nos vemos mañana en el parque? — ¡<w>Genial</w>!"
                            }
                        },
                        {
                            "text": "Ты всё сделал правильно, <w>отлично</w>!",
                            "target_lang_translations": {
                                "en": "You did everything right, <w>excellent</w>!",
                                "zh": "你做得完全正确，<w>好极了</w>！",
                                "nl": "Je hebt alles goed gedaan, <w>uitstekend</w>!",
                                "pl": "Zrobiłeś wszystko poprawnie, <w>doskonale</w>!",
                                "de": "Du hast alles richtig gemacht, <w>großartig</w>!",
                                "fr": "Tu as tout fait correctement, <w>excellent</w> !",
                                "it": "Hai fatto tutto correttamente, <w>ottimo</w>!",
                                "cs": "Udělal jsi všechno správně, <w>výborně</w>!",
                                "tr": "Her şeyi doğru yaptın, <w>mükemmel</w>!",
                                "es": "Hiciste todo bien, ¡<w>excelente</w>!"
                            }
                        }
