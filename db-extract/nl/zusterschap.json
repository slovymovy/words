                                        "sense_id": "0e4ebb60-da62-3f9d-851e-65b5d9799505",
                                        "entry_id": "2e84ec50-7789-32b6-b92e-902f3269b0d8",
                                        "glosses": [
                                            "The quality of being sisterly; sisterly companionship; especially, the sense that women have of being in solidarity with one another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f065aff-0deb-3022-ba46-da3ac15033e6",
                                        "entry_id": "2e84ec50-7789-32b6-b92e-902f3269b0d8",
                                        "glosses": [
                                            "A religious society of women."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30961389-4ead-4cc5-a64c-9f72c8cdf700",
                                                "sense_id": "3f065aff-0deb-3022-ba46-da3ac15033e6",
                                                "text": "In contrast, she said, women join sisterhoods and do volunteer work for Jewish fundraising organizations that are run and dominated by men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "797fde9f-c86f-3bee-b09a-e8eaa37174cb",
                                        "entry_id": "2e84ec50-7789-32b6-b92e-902f3269b0d8",
                                        "glosses": [
                                            "The idea of universal experience amongst women, regardless of other traits or factors. (Considered obsolete in third-wave feminism.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2932092-55e0-4af2-8ec5-ebc626cb4e88",
                                                "sense_id": "797fde9f-c86f-3bee-b09a-e8eaa37174cb",
                                                "text": "What does the rallying cry of sisterhood and the concept of feminism mean when last year, the majority of white, female voters chose whiteness as a political identity over womanhood?"
                                            },
                                            {
                                                "example_id": "efff4d75-aaa8-4b89-aa05-883a728adf08",
                                                "sense_id": "797fde9f-c86f-3bee-b09a-e8eaa37174cb",
                                                "text": "In a terrible way, I’ve never felt more part of a sisterhood or more certain that pain is shared within that family."
                                            }
                                        ]
                                    }
                                ]
                            }
