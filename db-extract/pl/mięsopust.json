                        "examples": [
                            {
                                "example_id": "b5e1bb01-d34e-410b-9802-be22d778a57b",
                                "sense_id": "4a3dedc7-b4e3-34fd-b923-57251e520e8b",
                                "text": "Iſch Valenthego Bratha ſzwego kthori wpyathek przed myąſſopuſthi thutha yeſth vchoſtan […] kraſzcz nauczil"
                            },
                            {
                                "example_id": "e0c183f5-da4e-4643-b556-534b958ff852",
                                "sense_id": "4a3dedc7-b4e3-34fd-b923-57251e520e8b",
                                "text": "Item powyada yſch paſz ſrebrni zwawrzynczem Gaczkyem vkradli v kowalky wſzyerakowye mynall rok przed myąſzopuſti"
                            },
                            {
                                "example_id": "7b555955-c6b1-449d-84a1-0c2c7f2473f5",
                                "sense_id": "4a3dedc7-b4e3-34fd-b923-57251e520e8b",
                                "text": "stalo ſzyę yako Dwyę nyedzely przet myeſzopuſty"
                            }
                        ]
                    }
