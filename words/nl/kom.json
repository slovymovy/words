                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "миска",
                                "target_lang_sense_clarification": "глубокая посуда для еды"
                            },
                            {
                                "target_lang_word": "чаша",
                                "target_lang_sense_clarification": "крупный сосуд округлой формы"
                            },
                            {
                                "target_lang_word": "пиала",
                                "target_lang_sense_clarification": "небольшая глубокая посуда без ручек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ce8c75b-2932-3204-8849-525a25956833",
                    "sense_definition": "het centrale deel van een dorp of stad waar veel huizen dicht bij elkaar staan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "locatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Binnen de <w>kom</w> van het dorp mag je niet harder dan dertig kilometer per uur rijden.",
                            "target_lang_translations": {
                                "en": "Within the <w>built-up area</w> of the village, you are not allowed to drive faster than thirty kilometers per hour.",
                                "ru": "В <w>черте</w> деревни нельзя ехать быстрее тридцати километров в час."
                            }
                        },
                        {
                            "text": "In de bebouwde <w>kom</w> staan veel historische gebouwen en winkels.",
                            "target_lang_translations": {
                                "en": "In the <w>built-up area</w>, there are many historic buildings and shops.",
                                "ru": "В <w>населенном пункте</w> много исторических зданий и магазинов."
                            }
