                                                "example_id": "1608ae84-1bbe-4cfb-8f79-ceffc25f68a6",
                                                "sense_id": "fa2cf5bf-0383-37f9-a040-53f2eb90e921",
                                                "text": "I pick up my hairbrush, my eyelash curler, my mascara: my arsenal of weapons, my quiver."
