                                "target_senses": [
                                    {
                                        "sense_id": "f01d4c0a-91cb-34f9-a9cb-5baaa765e3c1",
                                        "entry_id": "a1f80364-a416-3a79-82a1-e87c45fb8bb5",
                                        "glosses": [
                                            "An odometer graduated in miles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fb5ca0e-ca08-4375-a7b1-1813e9346d3f",
                        "source_entry_id": "f579fc3a-4f88-32c9-a2d0-3ed5291ce96e",
                        "source_sense_id": "29142b90-b10f-3e67-88e8-64818230c20c",
                        "source_sense_description": "Technik: Gerät zur Zählung der zurückgelegten Kilometer",
                        "target_lang_word": "odometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a23245f-32ae-3faa-ab47-0dc422296328",
                                        "entry_id": "ee0ab496-d021-366f-8db2-f1f1ee4333f8",
                                        "glosses": [
                                            "An instrument, usually embedded within the speedometer of a vehicle, that measures the distance the vehicle has traveled since production."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "405d3b2d-3335-4fdc-9c99-fcebc93f3062",
                                                "sense_id": "6a23245f-32ae-3faa-ab47-0dc422296328",
                                                "text": "When the car was delivered about eight weeks later, it was not the model that had been displayed on the show and it had more miles on the odometer than the car she had been promised."
                                            },
                                            {
                                                "example_id": "4fc2239b-f970-4be2-bc1a-183637bbfc4f",
                                                "sense_id": "6a23245f-32ae-3faa-ab47-0dc422296328",
                                                "text": "On Sunday, the robot rover advanced another 157 feet (48 meters) as it continued along the rim of a Martian crater, putting Opportunity's total odometer at 25.01 miles (40.25 km), according to NASA's Jet Propulsion Laboratory near Pasadena, California."
                                            },
                                            {
                                                "example_id": "b638e913-8790-4a2f-be5e-104f78099519",
                                                "sense_id": "6a23245f-32ae-3faa-ab47-0dc422296328",
                                                "text": "Tesla (TSLA.O) faces a proposed class action claiming it speeds up odometers on its electric vehicles so they fall out of warranty faster, saving Elon Musk's company from having to pay for repairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebeb26fd-0fb3-3d0c-be2e-01aad65a9295",
                                        "entry_id": "ee0ab496-d021-366f-8db2-f1f1ee4333f8",
                                        "glosses": [
                                            "A wheel used by surveyors, which registers distance traveled."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61eb1641-45d0-4960-ab1b-2d5389d69845",
                        "source_entry_id": "f579fc3a-4f88-32c9-a2d0-3ed5291ce96e",
                        "source_sense_id": "29142b90-b10f-3e67-88e8-64818230c20c",
                        "source_sense_description": "Technik: Gerät zur Zählung der zurückgelegten Kilometer",
                        "target_lang_word": "compteur kilométrique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compteur kilométrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9eca5e9-aff3-3e1b-abae-40c0ed276bb2",
                                        "entry_id": "bcc9a029-de31-376f-a3ca-f05902af4bda",
                                        "glosses": [
                                            "Odomètre servant à indiquer en kilomètres la distance parcourue par un véhicule : son kilométrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00fcb4f1-0cea-476f-b464-0413db07f4da",
                                                "sense_id": "d9eca5e9-aff3-3e1b-abae-40c0ed276bb2",
                                                "text": "Depuis quelque temps, une certaine agitation s’est produite dans l’esprit des cochers, du public et de la presse sur la question du loyer des voitures de place. Modification de tarif, tarif au quart d’heure, à la minute, à la distance, compteur horaire, compteur kilométrique, compteur horokilométrique, tout a été agité."
                                            },
                                            {
                                                "example_id": "57bda4f0-b6d8-49d9-a179-20bfb9bae26f",
                                                "sense_id": "d9eca5e9-aff3-3e1b-abae-40c0ed276bb2",
                                                "text": "Ceux qui auraient besoin d’une représentation physique d’une telle machine peuvent se représenter un compteur à incrément et décrément dont une implémentation pratique se trouve dans chaque automobile : le compteur kilométrique. Un tel compteur incrémente (respectivement décrémente) d’un dixième de tour la roue d’indice k + 1 à chaque tour de la roue d’indice k."
                                            },
                                            {
                                                "example_id": "47f0a760-33b0-48d9-9c1e-38caa7ecba92",
                                                "sense_id": "d9eca5e9-aff3-3e1b-abae-40c0ed276bb2",
                                                "text": "En effet, il arrive fréquemment que les compteurs kilométriques soient trafiqués, et ce d’autant plus facilement qu’une proportion de plus en plus grande de transactions a lieu hors des réseaux de professionnels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "794e4375-0783-4073-a114-f7fabe5d60aa",
                        "source_entry_id": "f579fc3a-4f88-32c9-a2d0-3ed5291ce96e",
                        "source_sense_id": "29142b90-b10f-3e67-88e8-64818230c20c",
                        "source_sense_description": "Technik: Gerät zur Zählung der zurückgelegten Kilometer",
                        "target_lang_word": "odomètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odomètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33938314-59ba-378d-8f2e-a56e20d13dd0",
                                        "entry_id": "f479faf9-d505-3a39-9b71-10d215459ec7",
                                        "glosses": [
                                            "Appareil mécanique ou électronique mesurant les distances parcourues. On dit plus fréquemment podomètre quand il s’agit de marche à pied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c43c36e9-3cfa-4fdb-a91b-38206ae71d92",
                                                "sense_id": "33938314-59ba-378d-8f2e-a56e20d13dd0",
                                                "text": "Ératosthène se tourne vers les bématistes, ces inlassables arpenteurs réputés mesurer les distances en comptant leurs pas — ou ceux de leurs chameaux, allez savoir. A moins qu’ils ne disposent déjà d’un odomètre, ce qui reste à démontrer pour un appareil supposément inventé à Rome vers l’an 15 av. J.-C."
                                            },
                                            {
                                                "example_id": "70b25c9c-835e-4678-a66b-7f2104520d75",
                                                "sense_id": "33938314-59ba-378d-8f2e-a56e20d13dd0",
                                                "text": "La position connue des eurobalises permet d’étalonner l’odomètre et de connaître son inexactitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
