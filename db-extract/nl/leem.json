                "senses": [
                    {
                        "sense_id": "d99ff550-0646-363e-aae5-740bf17116cc",
                        "entry_id": "5845d778-431e-3e24-bb37-f931f6231653",
                        "glosses": [
                            "kleiachtige, in vochtige toestand plastische grond met een zandgehalte groter dan 20%"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "976eb48e-fd2e-4ea3-91a7-b623798c4368",
                                "sense_id": "d99ff550-0646-363e-aae5-740bf17116cc",
                                "text": "Dat huis was op een grond van leem gebouwd."
                            },
                            {
                                "example_id": "e762fe03-18d2-4f23-a874-8c5744048b3b",
                                "sense_id": "d99ff550-0646-363e-aae5-740bf17116cc",
                                "text": "Hij zucht en steunt en dan brult hij. Paniek maakt zich van hem meester. Hij voelt tranen opwellen, slaat met zijn vuist tegen de muur van leem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d61895c-cd45-4024-9d3c-e6d52e0dc78c",
                        "source_entry_id": "5845d778-431e-3e24-bb37-f931f6231653",
                        "source_sense_id": "d99ff550-0646-363e-aae5-740bf17116cc",
                        "source_sense_description": "kleihoudende grondsoort",
                        "target_lang_word": "Lehm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lehm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6852589-5b83-34c0-a4cf-6eb3dd7a0480",
                                        "entry_id": "76f17ab4-fec5-3937-aac5-0ba6b90ed684",
                                        "glosses": [
                                            "quarzhaltiger, kalkfreier Ton, der reich an Eisenverbindungen ist; gutes Ausgangsmaterial für Keramik und Ziegel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "794b509c-6833-475e-af39-8658ac595320",
                                                "sense_id": "c6852589-5b83-34c0-a4cf-6eb3dd7a0480",
                                                "text": "Zur Herstellung von Mauerziegeln wurde Lehm oder Ton in rechteckige Holzformen gedrückt."
                                            },
                                            {
                                                "example_id": "4bc2d2ac-9cb7-408e-9cac-1c7e1bedd113",
                                                "sense_id": "c6852589-5b83-34c0-a4cf-6eb3dd7a0480",
                                                "text": "„In der Mitte des Hofes erhebt sich ein Altar aus Lehm mit Köpfen aus Bronze und Elfenbein darauf und einem metallenen Leoparden.“"
                                            },
                                            {
                                                "example_id": "8ea249c8-fbe0-4fc8-8ef3-2bc006d6526e",
                                                "sense_id": "c6852589-5b83-34c0-a4cf-6eb3dd7a0480",
                                                "text": "„Die Wände der Stube zeigten die rohen und unbehauenen Baumstämme, deren einzige Ornamente breite Streifen von Lehm waren, welche die Zwischenräume ausfüllten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fc47012-1d88-4f05-9eac-20804f2568a4",
                        "source_entry_id": "5845d778-431e-3e24-bb37-f931f6231653",
                        "source_sense_id": "d99ff550-0646-363e-aae5-740bf17116cc",
