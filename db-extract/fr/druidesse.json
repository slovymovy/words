                        ],
                        "form": "druidesses"
                    },
                    {
                        "form_id": "62271524-52d6-4873-95be-37f8db7f1d6e",
                        "entry_id": "230832a8-106e-3e60-a8a2-ec58060c9b4e",
                        "tags": [
                            "masculine"
                        ],
                        "form": "druide"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "10df29f8-2eea-3b27-88d6-74eecd8ae8ff",
                        "entry_id": "230832a8-106e-3e60-a8a2-ec58060c9b4e",
                        "glosses": [
                            "Nom des membres féminins de la classe sacerdotale des Celtes de l’Antiquité."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "d06c9be7-9330-4887-b1da-e48d15f312b2",
                                "sense_id": "10df29f8-2eea-3b27-88d6-74eecd8ae8ff",
                                "text": "Les chênes prophétiques ont à jamais disparu de cette contrée, et les druidesses n’y trouveraient plus un rameau de gui sacré pour parer l’autel d’Hésus."
                            },
                            {
                                "example_id": "1eebfa3a-357d-4cd8-bdec-7ce8cc4bf671",
                                "sense_id": "10df29f8-2eea-3b27-88d6-74eecd8ae8ff",
                                "text": "Au ivᵉ s., l’historien Lampride raconte qu’une druidesse avait prédit en gaulois la fin prochaine d’Alexandre Sévère."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dd9e7fd-d4d7-38d9-9b54-88700d84170c",
                        "entry_id": "230832a8-106e-3e60-a8a2-ec58060c9b4e",
                        "glosses": [
                            "Magicienne capable de contrôler les plantes et les animaux."
                        ],
                        "tags": [
                            "Fantastique",
                            "Jeux de rôle",
                            "Jeux de rôle d’action-aventure"
                        ],
                        "examples": [
                            {
                                "example_id": "260f4f7e-949b-409b-8fec-24ff3ba9686a",
                                "sense_id": "2dd9e7fd-d4d7-38d9-9b54-88700d84170c",
                                "text": "Parmi ces éléments cachés on retrouve notamment l’histoire de Kagha la Druidesse ainsi que celle des Druides de l’Ombre."
                            }
                        ]
                    }
                ],
                "translations": [
