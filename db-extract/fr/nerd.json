                        ]
                    },
                    {
                        "translation_id": "1382948a-d03d-408f-943e-47e92d248fe4",
                        "source_entry_id": "f10ff1cf-3a91-33a0-a263-38c6998d1cfc",
                        "source_sense_id": "4c0b1439-5b2d-31e3-a9b0-e2f22e6aa3e5",
                        "source_sense_description": "(Anglicisme) Personne passionnée par les sujets scientifiques et techniques",
                        "target_lang_word": "Nerdin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nerdin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3b99c2b-acc0-366f-934c-168aa8a7bb5e",
                                        "entry_id": "4ac079b2-0816-3d14-a24b-57680a712d8a",
                                        "glosses": [
                                            "weibliche Person, die sich besonders mit Computern oder anderen Bereichen aus Wissenschaft und Technik beschäftigt, deren soziale Kompetenzen aber schwach ausgeprägt sind oder die diesen Eindruck zumindest erweckt"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2105662-ac7e-434a-b697-e3fe2479d9e8",
                                                "sense_id": "c3b99c2b-acc0-366f-934c-168aa8a7bb5e",
                                                "text": "„Egal ob Mädchen, Junge, Technikferner, Nerdin, Autist, Störenfriedin, Anfänger, Fortgeschrittene – auf dem Camp arbeiten alle zusammen und präsentieren am letzten Tag ein Produkt, das sie selbst entwickelt haben und auf das sie stolz sind.“"
                                            },
                                            {
                                                "example_id": "11e42262-8355-46df-a47a-525653653614",
                                                "sense_id": "c3b99c2b-acc0-366f-934c-168aa8a7bb5e",
                                                "text": "„Wenn er nicht gerade in einem Arbeitszimmer über einem Roman brütet, versucht er auf Cons, in Tavernen sowie Buchhandlungen, seine Geschichte mithilfe von Hörbuch-live-Lesungen an geneigte Nerds und Nerdinnen zu bringen.“"
                                            },
                                            {
                                                "example_id": "b37f6f29-fde2-4a3f-97ad-e3c088ee7df3",
                                                "sense_id": "c3b99c2b-acc0-366f-934c-168aa8a7bb5e",
                                                "text": "„Netzaktivist_innen [sic], feministische Medienmacher_innen [sic], kurz: auch Nerdinnen formulieren kritische Forderungen an die Piraten.“"
                                            },
                                            {
                                                "example_id": "b3c7265b-3db8-450e-8b7d-b6b6dc2dcec3",
                                                "sense_id": "c3b99c2b-acc0-366f-934c-168aa8a7bb5e",
                                                "text": "„Wir als Nerdinnen und Nerds haben uns gefragt: Ist das nicht etwas, was wir automatisieren können?“"
                                            },
                                            {
                                                "example_id": "e3913b7d-cebd-4e4a-bc23-d45716a7dc69",
                                                "sense_id": "c3b99c2b-acc0-366f-934c-168aa8a7bb5e",
                                                "text": "„Das war auch die enttäuschende Realpolitik Barack Obamas, das waren Krisen- und Stresssymptome der europäischen Demokratie, und das war nicht zuletzt die Skepsis, ob diese Nerds (kaum Nerdinnen) der Piratenpartei tatsächlich diskursfähig sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "de191a08-17a2-3e5c-857b-d70c48af0d4d",
                                        "entry_id": "4ac079b2-0816-3d14-a24b-57680a712d8a",
                                        "glosses": [
                                            "als Bezeichnung von Außenstehenden meist abwertend"
