                    {
                        "sense_id": "19f4fce0-fc57-3076-a34c-55c2797c0cfe",
                        "entry_id": "81a04528-9077-33f1-94e9-52985fab395a",
                        "glosses": [
                            "Masochiste."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ba0ddd75-8f8b-4bfd-a7a5-430dd7efb6f5",
                                "sense_id": "19f4fce0-fc57-3076-a34c-55c2797c0cfe",
                                "text": "Il est maso, ce mec."
                            },
                            {
                                "example_id": "4d1cce2b-c792-45c1-868b-91c417105a60",
                                "sense_id": "19f4fce0-fc57-3076-a34c-55c2797c0cfe",
                                "text": "« Tu faisais les choses avec naturel, ni réticente ni vicelarde, juste de temps en temps un tout petit peu maso… »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "83a892d5-98e1-364d-ac59-2f0c99afc621",
