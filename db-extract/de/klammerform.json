                "senses": [
                    {
                        "sense_id": "2b08b5ed-9350-3eeb-8c4c-b52a34438e4e",
                        "entry_id": "986d4fc5-a30a-3484-9027-d34cd8b22c2a",
                        "glosses": [
                            "Kurzwort, das durch Tilgung des Mittelteils eines längeren Wortes entstanden ist und bei dem Anfang und Ende des gekürzten Wortes erhalten blieben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "865a10fb-1fc1-4158-a196-6bc0417ecce9",
                                "sense_id": "2b08b5ed-9350-3eeb-8c4c-b52a34438e4e",
                                "text": "„Füllhalter“ (für „Füllfederhalter“) ist eine Klammerform im Deutschen."
                            },
                            {
                                "example_id": "b87fbe0d-7fea-495d-a746-eae9ab82492a",
                                "sense_id": "2b08b5ed-9350-3eeb-8c4c-b52a34438e4e",
                                "text": "„Werden in einem mehrteiligen Kompositum die Mittelglieder ausgelassen (…), so spricht man von einer Klammerform.“"
                            },
                            {
                                "example_id": "49941945-4377-4d81-a9fd-9fb467bf9f69",
                                "sense_id": "2b08b5ed-9350-3eeb-8c4c-b52a34438e4e",
                                "text": "„Bei den morphologischen Typen ist noch die Klammerform zu erwähnen, bei der wie bei Salzburg < Salz(ach)burg (…) die beiden »äußeren Teile« den ON bilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
