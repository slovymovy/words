{
    "word_family": [
        "kiek"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ccc28be-3eee-3241-8e16-7fc6939bbd32",
                    "sense_definition": "jong van een kip",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "dier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kleine <w>kieken</w> liep achter zijn moeder aan door het gras.",
                            "target_lang_translations": {
                                "fr": "Le petit <w>poussin</w> suivait sa mère à travers l'herbe."
                            }
                        },
                        {
                            "text": "Op de boerderij zagen we een pasgeboren <w>kieken</w> in het stro.",
                            "target_lang_translations": {
                                "fr": "À la ferme, nous avons vu un <w>poussin</w> nouveau-né dans la paille."
                            }
                        }
                    ],
                    "synonyms": [
                        "kuiken"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in Vlaanderen en Zuid-Nederland"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Petit d'une poule."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "poussin",
                                "target_lang_sense_clarification": "terme standard pour le petit de la poule"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cbd009d-8c20-3222-b031-3d47275c52b5",
                    "sense_definition": "iemand die dom of onnozel overkomt",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "scheldwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doe niet zo'n <w>kieken</w> en luister gewoon naar wat ik zeg.",
                            "target_lang_translations": {
                                "fr": "Ne fais pas l'<w>idiot</w> et écoute simplement ce que je dis."
                            }
                        },
                        {
                            "text": "Wat een <w>kieken</w> ben je toch om dat zomaar te geloven.",
                            "target_lang_translations": {
                                "fr": "Quel <w>nigaud</w> tu fais de croire ça sans réfléchir."
                            }
                        }
                    ],
                    "synonyms": [
                        "uilskuiken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel en licht beledigend"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne qui paraît stupide ou naïve."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "idiot",
                                "target_lang_sense_clarification": "terme courant pour désigner quelqu'un de peu intelligent"
                            },
                            {
                                "target_lang_word": "nigaud",
                                "target_lang_sense_clarification": "terme familier pour quelqu'un de naïf ou maladroit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a2f8941-c2d8-331c-97fc-a384d2418293",
                    "sense_definition": "een foto maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fotografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zullen we even een foto <w>kieken</w> van dit mooie uitzicht?",
                            "target_lang_translations": {
                                "fr": "On va <w>prendre une photo</w> de cette belle vue ?"
                            }
                        },
                        {
                            "text": "Hij stond de hele middag op het plein mensen te <w>kieken</w>.",
                            "target_lang_translations": {
                                "fr": "Il a passé tout l'après-midi sur la place à <w>photographier</w> les gens."
                            }
                        }
                    ],
                    "synonyms": [
                        "fotograferen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Prendre une photographie."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "photographier",
                                "target_lang_sense_clarification": "terme standard pour prendre une photo"
                            },
                            {
                                "target_lang_word": "prendre une photo",
                                "target_lang_sense_clarification": "expression courante pour l'action de photographier"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}