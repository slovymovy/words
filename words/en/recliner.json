{
    "word_family": [
        "recline",
        "reclinable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6cb0a73-060f-3c51-9a68-81604834e952",
                    "sense_definition": "A chair with a back that can be tilted backward for comfort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fell asleep in his comfortable <w>recliner</w> while watching the evening news.",
                            "target_lang_translations": {
                                "zh": "他在看晚间新闻时，在舒适的<w>躺椅</w>上睡着了。"
                            }
                        },
                        {
                            "text": "The living room features a large leather <w>recliner</w> facing the television.",
                            "target_lang_translations": {
                                "zh": "客厅里摆放着一把对着电视的大皮质<w>躺椅</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "armchair"
                    ],
                    "common_phrases": [
                        "leather recliner"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种靠背可以向后倾斜以增加舒适度的椅子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "躺椅",
                                "target_lang_sense_clarification": "指可以调节靠背角度的舒适椅子。"
                            },
                            {
                                "target_lang_word": "可调节靠背椅",
                                "target_lang_sense_clarification": "描述性称呼，指具有倾斜功能的椅子。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51e9d440-6602-3cce-8647-cb637d0e65fc",
                    "sense_definition": "A person or thing that leans or lies back.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>recliner</w> on the beach looked very relaxed under the warm sun.",
                            "target_lang_translations": {
                                "zh": "沙滩上那个<w>斜倚着的人</w>在温暖的阳光下看起来非常放松。"
                            }
                        },
                        {
                            "text": "As a <w>recliner</w>, he preferred to spend his afternoons resting on the sofa.",
                            "target_lang_translations": {
                                "zh": "作为一个喜欢<w>斜倚</w>的人，他更喜欢下午在沙发上休息。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指身体向后倾斜或躺着的人或物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斜倚者",
                                "target_lang_sense_clarification": "指处于斜倚姿势的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}