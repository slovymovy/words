                "senses": [
                    {
                        "sense_id": "8485b9c0-e093-3208-8096-c7af327edc44",
                        "entry_id": "3fa519f6-fb93-320d-b8a6-f993b268613b",
                        "glosses": [
                            "Seite mit Aufgabenstellungen für den Schulunterricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7baf6611-1347-42ea-8d25-89e9ef651c9a",
                                "sense_id": "8485b9c0-e093-3208-8096-c7af327edc44",
                                "text": "„Nun erhalten die Schüler das Arbeitsblatt und werden aufgefordert, die erste Aufgabe zu lösen, die dann im Plenum besprochen wird, bevor jeder die Bildgeschichte in eine Erlebniserzählung umschreibt.“"
                            },
                            {
                                "example_id": "f86af2e0-bc94-4164-88c6-7cdeb2e33494",
                                "sense_id": "8485b9c0-e093-3208-8096-c7af327edc44",
                                "text": "„Die Klasse 3 b hat Sachunterricht, die Kinder füllen ein Arbeitsblatt aus.“"
                            },
                            {
                                "example_id": "47334b97-0bcf-4659-b552-75dabf9c7086",
                                "sense_id": "8485b9c0-e093-3208-8096-c7af327edc44",
                                "text": "„Luises Klassenkameraden benutzen für die gleiche Aufgabe den Taschenrechner und tragen die Ergebnisse mit dem Kugelschreiber auf dem Arbeitsblatt ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c09dec6-ac8c-414f-a42a-1b7b6d59a43c",
                        "source_entry_id": "3fa519f6-fb93-320d-b8a6-f993b268613b",
                        "source_sense_id": "8485b9c0-e093-3208-8096-c7af327edc44",
                        "source_sense_description": "Seite mit Aufgabenstellungen für den Schulunterricht",
                        "target_lang_word": "worksheet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worksheet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad7fc0e2-d5bb-333e-9046-933f8a252e1b",
                                        "entry_id": "34de7a37-4a44-314a-9d10-b9683cc3d06a",
                                        "glosses": [
                                            "A sheet of paper or computerized document on which problems are worked out or solved and the answers are recorded."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd81a6fe-5a71-3105-ac72-cb9fe66ac71f",
                                        "entry_id": "34de7a37-4a44-314a-9d10-b9683cc3d06a",
                                        "glosses": [
                                            "A sheet of paper listing work that is completed, to be completed or in progress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "474fff01-c378-4cfc-9c17-b3cbeaf41bec",
                                                "sense_id": "bd81a6fe-5a71-3105-ac72-cb9fe66ac71f",
                                                "text": "The final outshopping was 55002, which had arrived on October 14 [1980] for a two-month repair, with the usual worksheet taped to its bodyside stating \"to be repainted in two-tone green\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "worksheet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef618e7c-db57-3e0b-a660-5f88f6d426da",
                                        "entry_id": "29de9e4a-a932-3d11-ab85-39f8d949bfcd",
                                        "glosses": [
                                            "To teach or assess by means of worksheets."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47489f75-da37-4ab3-82eb-1646c2e7ed0c",
                                                "sense_id": "ef618e7c-db57-3e0b-a660-5f88f6d426da",
                                                "text": "Both reading and writing were viewed as a series of discreet and essentially uninteresting skills to be described, worksheeted, and tested. Students' own intentions or ability as speakers, listeners, readers, or writers were never a consideration."
                                            },
                                            {
                                                "example_id": "d84f3be9-e8e0-49af-8730-1c3fc0b80eaf",
                                                "sense_id": "ef618e7c-db57-3e0b-a660-5f88f6d426da",
                                                "text": "Lesson after lesson of worksheeting will quickly leave the children bored and disaffected. The class will also suss out pretty quickly that you're being lazy."
                                            },
                                            {
                                                "example_id": "2586db9f-33f6-4bc9-8808-5610c4dfd41a",
                                                "sense_id": "ef618e7c-db57-3e0b-a660-5f88f6d426da",
                                                "text": "Students cannot be textbooked and worksheeted into mastery, proficiency, brilliance, and commitment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2055e65-8b2c-4cb4-8948-b87da9efc185",
