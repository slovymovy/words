                                "target_lang_word": "«бернер»",
                                "target_lang_sense_clarification": "сленг, временный телефон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b4c9b4f-d697-35e3-91b8-236d1ff9c972",
                    "sense_definition": "An anonymous social media account created for temporary use or to hide one's identity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temporary_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete was caught using a <w>burner</w> account to argue with fans online.",
                            "target_lang_translations": {
                                "ru": "Спортсмена поймали на использовании <w>фейкового аккаунта</w> для споров с фанатами в сети."
                            }
                        },
                        {
                            "text": "He posted the leak from a <w>burner</w> to ensure his main profile wouldn't get banned.",
                            "target_lang_translations": {
                                "ru": "Он опубликовал утечку с <w>левого аккаунта</w>, чтобы его основной профиль не забанили."
                            }
