                "senses": [
                    {
                        "sense_id": "42200b67-08f8-3d59-b901-055bc752d3c4",
                        "entry_id": "94966de5-16e8-311c-8aef-7276991d64dd",
                        "glosses": [
                            "Person, die als Darsteller in Fernsehsendungen bekannt und berühmt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "639db2e5-88fd-4265-8bfe-b3280ec56513",
                                "sense_id": "42200b67-08f8-3d59-b901-055bc752d3c4",
                                "text": "„Kein Wunder – das schauspielerische Talent hatte sie von ihrem Vater, Helmut Grevenbroich, geerbt, der ein bekannter Fernsehdarsteller war.“"
                            },
                            {
                                "example_id": "9e98bdbe-4c04-4fa5-9069-c4d1e531a600",
                                "sense_id": "42200b67-08f8-3d59-b901-055bc752d3c4",
                                "text": "„Mit dem zunehmenden Erfolg der Serie tauchen weitere bekannte Fernsehdarsteller wie Christine Urspruch, CarmenMaja Antoni oder Johann von Bülow in Hengasch auf.“"
                            },
                            {
                                "example_id": "f9309fb6-0773-4b24-9123-54a0a3f1decc",
                                "sense_id": "42200b67-08f8-3d59-b901-055bc752d3c4",
                                "text": "„Der Film war mit bekannten Fernsehdarstellern, wie Herbert Fleischmann als van Gogh, Til Ervig als der Bruder Theo, und Gisela Hahn als Jacky, besetzt.“"
                            },
                            {
                                "example_id": "13624dcf-007f-437f-8e59-13ba3eab4967",
                                "sense_id": "42200b67-08f8-3d59-b901-055bc752d3c4",
                                "text": "„Nach der Schule hatte er eine Schauspielausbildung gemacht, und nun, mit Mitte zwanzig, war er ein gefragter Fernsehdarsteller, der vor allem jugendliche Liebhaber spielte.“"
                            },
                            {
                                "example_id": "1f3d4a21-fd73-4a76-b819-96f2f3b86f11",
                                "sense_id": "42200b67-08f8-3d59-b901-055bc752d3c4",
                                "text": "„In den 90ern etablierte sich mit Talk-Shows das Format des Durchschnittsbürgers als Fernsehdarsteller dann vollends.“"
                            },
                            {
                                "example_id": "67f91ce6-7931-4eaf-a579-ea6903cced9b",
                                "sense_id": "42200b67-08f8-3d59-b901-055bc752d3c4",
                                "text": "„Außerdem sei so ein Engagement wenig prestigeträchtig, während zweitklassige Fernsehdarsteller oft wie Popstars gefeiert wurden und gut verdienten.“"
                            },
                            {
                                "example_id": "c484cf55-3c76-4eae-91d5-7b363208daa2",
                                "sense_id": "42200b67-08f8-3d59-b901-055bc752d3c4",
                                "text": "„Beide Titel sind mittlerweile auch als Hörbücher (je 5 CDs) im Handel greifbar, gelesen von dem vielbeschäftigten Fernsehdarsteller Heikko Deutschmann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
