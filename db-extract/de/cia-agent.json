                "senses": [
                    {
                        "sense_id": "5ce43f9d-2e6b-3721-9958-3096a859cc83",
                        "entry_id": "2a2cbc35-1e7e-3d65-b459-7c4b0f2de27e",
                        "glosses": [
                            "Person, die für den US-amerikanischen Auslandsnachrichtendienst CIA im Geheimen tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6941a0e-0299-47df-90c9-ece9db61a062",
                                "sense_id": "5ce43f9d-2e6b-3721-9958-3096a859cc83",
                                "text": "„Die fünf CIA-Agenten, die auf Sumatra dabei gewesen waren, machten sich Hals über Kopf mit einem Jeep Richtung Süden aus dem Staub.“"
                            },
                            {
                                "example_id": "935d487b-3cd8-456c-b026-81d3b3efffbd",
                                "sense_id": "5ce43f9d-2e6b-3721-9958-3096a859cc83",
                                "text": "„Ihr gefiel die Vorstellung, mit einem CIA-Agenten verheiratet zu sein, der an vorderster Front im Einsatz gegen das Böse kämpfte.“"
                            },
                            {
                                "example_id": "b10e74cf-c3e2-4fa7-ad7d-f4ec10669c72",
                                "sense_id": "5ce43f9d-2e6b-3721-9958-3096a859cc83",
                                "text": "„Für einen CIA-Agenten brachte das Jahr 1979 die zwangsläufige Erkenntnis mit sich, dass der amerikanische Einfluss in aller Welt zu bröckeln begann.“"
                            },
                            {
                                "example_id": "be3c3291-ca37-408f-9c6d-5763b544cfbd",
                                "sense_id": "5ce43f9d-2e6b-3721-9958-3096a859cc83",
                                "text": "„Der farbige CIA-Agent schüttelte den Kopf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
