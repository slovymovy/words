                        "target_lang_word": "overwinnelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1851a469-82fc-45c4-87a8-b7ac774b3f79",
                        "source_entry_id": "c7e43318-de8b-37b5-a806-951de739dc25",
                        "source_sense_id": "a914f795-d087-3b8b-ad4d-1b006269cb87",
                        "source_sense_description": "capable of being defeated",
                        "target_lang_word": "vincible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vincible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80b5b91e-71b7-3352-98e8-96cfb3274664",
                                        "entry_id": "8d4bed66-6637-34d2-8de8-a6afd613a6e0",
                                        "glosses": [
                                            "Que l’on peut vaincre."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dd66c87-7647-4f55-8667-f9e1203533b5",
                                                "sense_id": "80b5b91e-71b7-3352-98e8-96cfb3274664",
                                                "text": "Leur ignorance était donc vincible."
                                            },
                                            {
                                                "example_id": "adf11110-63dc-489a-ba20-424f69a99f7d",
                                                "sense_id": "80b5b91e-71b7-3352-98e8-96cfb3274664",
                                                "text": "L’ignorance vincible est le manque de connaissance dans celui qui peut la faire disparaître."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bebd024c-fe64-4945-bbdd-8fa6ce3032d6",
                        "source_entry_id": "c7e43318-de8b-37b5-a806-951de739dc25",
                        "source_sense_id": "a914f795-d087-3b8b-ad4d-1b006269cb87",
                        "source_sense_description": "capable of being defeated",
                        "target_lang_word": "besiegbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "besiegbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0926a28e-ecc6-3e7f-8097-6f83cb5556a1",
                                        "entry_id": "6e68853c-0ffb-3f94-84db-120ba7019162",
                                        "glosses": [
                                            "so, dass es besiegt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28d90af7-ea22-410b-a785-dad50a79240c",
                                                "sense_id": "0926a28e-ecc6-3e7f-8097-6f83cb5556a1",
                                                "text": "„Gesundheitsminister Jens Spahn hält Krebs leiden in absehbarer Zeit für besiegbar – Fachverbände äußern Zweifel.“"
                                            },
                                            {
                                                "example_id": "64bf010e-6a7a-4a6e-aa52-5197fc4c8237",
                                                "sense_id": "0926a28e-ecc6-3e7f-8097-6f83cb5556a1",
                                                "text": "„Die Heilungschancen haben sich zwar deutlich verbessert, betont [die Expertin], aber der Krebs wird ihrer Einschätzung nach nicht so schnell besiegbar sein…“"
                                            },
                                            {
                                                "example_id": "97717b82-287a-4ad0-bdc5-e8945de225bb",
                                                "sense_id": "0926a28e-ecc6-3e7f-8097-6f83cb5556a1",
                                                "text": "„Der erstmalige Einzug ins Endspiel wäre ein neuer Meilenstein in der Vereinshistorie, gleichzeitig kann man zeigen, dass in diesem Bewerb auch Salzburg besiegbar ist.“"
                                            },
                                            {
                                                "example_id": "a3f3d86a-13db-4e04-97da-5e12889741bd",
                                                "sense_id": "0926a28e-ecc6-3e7f-8097-6f83cb5556a1",
                                                "text": "„»Man darf nicht vergessen, dass der 2. Mai auch ein Signal für das ganze damalige Europa war, das Signal: Napoleon ist besiegbar!«“"
                                            },
                                            {
                                                "example_id": "c522def4-c187-437a-b3af-d083c05ea483",
                                                "sense_id": "0926a28e-ecc6-3e7f-8097-6f83cb5556a1",
                                                "text": "„Denn militärisch sind die Taliban in einem Land wie Afghanistan nicht besiegbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
