                        "entry_id": "ae1551c9-80e4-3588-8176-16bb33c3e1a6",
                        "glosses": [
                            "Celui qui est entré en révolte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f876e0d-31b2-4559-ac59-4e7ff791906a",
                                "sense_id": "fc27caf6-0be8-3dae-b879-c351fc536ae8",
                                "text": "Le révolutionnaire était devenu un révolté."
                            },
                            {
                                "example_id": "ab99d29a-d99b-416f-8907-313b725820f8",
                                "sense_id": "fc27caf6-0be8-3dae-b879-c351fc536ae8",
                                "text": "Les révoltés du Moyen-Âge\nL’ont arboré sur maints beffrois.\nEmblème éclatant du courage,\nToujours il fit pâlir les rois."
                            },
                            {
                                "example_id": "0942f6c2-806b-4ba8-aac6-180ad4f0e747",
                                "sense_id": "fc27caf6-0be8-3dae-b879-c351fc536ae8",
                                "text": "Les révoltés se sont rendus maîtres de cette place. — On envoya des troupes pour réduire les révoltés."
                            }
                        ]
                    }
                ],
