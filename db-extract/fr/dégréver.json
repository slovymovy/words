                ],
                "senses": [
                    {
                        "sense_id": "8e1d202f-2a8e-3428-bd93-570a75af62c5",
                        "entry_id": "7b67a070-d474-3078-8616-9ba9e8d6ee79",
                        "glosses": [
                            "Variante plus rare de dégrever."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a9a903f-e90a-4277-a4db-025b845b518a",
                                "sense_id": "8e1d202f-2a8e-3428-bd93-570a75af62c5",
                                "text": "Il me semble qu’avant de dégréver, il faudrait commencer par payer ses dettes."
                            },
                            {
                                "example_id": "a896db0a-6ae1-4ef6-b0d7-403e30c6edad",
                                "sense_id": "8e1d202f-2a8e-3428-bd93-570a75af62c5",
                                "text": "En face de nos deux milliards et plus de budget normal, le mot d’ordre pour tous les hommes de bon sens doit être celui-ci : dégréver, dégréver et encore dégréver !"
                            },
                            {
                                "example_id": "77ebaa44-5c36-4bea-8a31-21ce3835d636",
                                "sense_id": "8e1d202f-2a8e-3428-bd93-570a75af62c5",
                                "text": "Déjà, dans une discussion préliminaire, M. Casimir Périer avait rappelé que M. de Villèle, en présentant l’année précédente le projet de loi sur la dette publique et l’amortissement, avait affirmé que la conversion rapporterait au trésor 30 millions, ce qui permettrait de dégréver les contributions directes d’une somme égale."
                            }
                        ]
                    }
