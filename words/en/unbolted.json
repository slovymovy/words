{
    "word_family": [
        "bolt",
        "unbolt"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "201f74af-beef-36bc-8551-f3213229315c",
                    "sense_definition": "Simple past and past participle of <w>unbolt</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She quietly <w>unbolted</w> the heavy door and slipped outside into the night.",
                            "target_lang_translations": {
                                "nl": "Ze <w>ontgrendelde</w> stilletjes de zware deur en glipte naar buiten de nacht in."
                            }
                        },
                        {
                            "text": "The guard <w>unbolted</w> the gate to allow the morning delivery trucks inside.",
                            "target_lang_translations": {
                                "nl": "De bewaker <w>haalde</w> het hek <w>van de grendel</w> om de ochtendleveringen binnen te laten."
                            }
                        }
                    ],
                    "synonyms": [
                        "unlatched",
                        "unlocked"
                    ],
                    "antonyms": [
                        "bolted",
                        "locked"
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van ontgrendelen of van de grendel halen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ontgrendelde",
                                "target_lang_sense_clarification": "enkelvoud verleden tijd van een grendel halen"
                            },
                            {
                                "target_lang_word": "van de grendel haalde",
                                "target_lang_sense_clarification": "verleden tijd"
                            },
                            {
                                "target_lang_word": "ontgrendeld",
                                "target_lang_sense_clarification": "voltooid deelwoord"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97b02403-27b3-3cf7-9ed8-1aca803a403d",
                    "sense_definition": "Not fastened or secured with a bolt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pushed the <w>unbolted</w> door open and stepped cautiously into the dark room.",
                            "target_lang_translations": {
                                "nl": "Hij duwde de <w>niet-vergrendelde</w> deur open en stapte voorzichtig de donkere kamer binnen."
                            }
                        },
                        {
                            "text": "The thieves found an <w>unbolted</w> back window and climbed inside undetected.",
                            "target_lang_translations": {
                                "nl": "De dieven vonden een <w>ongrendeld</w> achterraam en klommen onopgemerkt naar binnen."
                            }
                        }
                    ],
                    "synonyms": [
                        "unlocked",
                        "unfastened"
                    ],
                    "antonyms": [
                        "bolted",
                        "latched"
                    ],
                    "common_phrases": [
                        "unbolted door",
                        "unbolted gate"
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet afgesloten of vastgezet met een grendel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ongrendeld",
                                "target_lang_sense_clarification": "niet vergrendeld"
                            },
                            {
                                "target_lang_word": "niet-vergrendeld",
                                "target_lang_sense_clarification": "zonder grendel of slot"
                            },
                            {
                                "target_lang_word": "ontgrendeld",
                                "target_lang_sense_clarification": "van de grendel gehaald"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12140bb9-fac5-3e0b-84ff-6019260a1fe8",
                    "sense_definition": "Not sifted or refined through a sieve or cloth, especially said of grain or flour.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traditional rustic bread was made using coarse, <w>unbolted</w> meal from the local mill.",
                            "target_lang_translations": {
                                "nl": "Traditioneel rustiek brood werd gemaakt met grof, <w>ongebuild</w> meel van de plaatselijke molen."
                            }
                        },
                        {
                            "text": "The recipe called for <w>unbolted</w> flour to give the loaf a heavier texture.",
                            "target_lang_translations": {
                                "nl": "Het recept vroeg om <w>ongezeefd</w> meel om het brood een stevigere textuur te geven."
                            }
                        }
                    ],
                    "synonyms": [
                        "unsifted"
                    ],
                    "antonyms": [
                        "bolted",
                        "sifted"
                    ],
                    "common_phrases": [
                        "unbolted flour",
                        "unbolted meal"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in milling and historical baking contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet gezeefd of gebuild, met name gezegd van meel of graan."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ongebuild",
                                "target_lang_sense_clarification": "van meel, niet gezeefd"
                            },
                            {
                                "target_lang_word": "ongezeefd",
                                "target_lang_sense_clarification": "zonder te zeven"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e47edb6-ff46-3ea9-9cea-68cd125aa674",
                    "sense_definition": "Coarse, uncultured, or vulgar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nobleman refused to tolerate the insults of an <w>unbolted</w> scoundrel.",
                            "target_lang_translations": {
                                "nl": "De edelman weigerde de beledigingen van een <w>ongemanierde</w> schurk te tolereren."
                            }
                        },
                        {
                            "text": "He was dismissed as an <w>unbolted</w> ruffian unfit for polite society.",
                            "target_lang_translations": {
                                "nl": "Hij werd afgedaan als een <w>onbeschaafde</w> vlegel die niet paste in fatsoenlijke kringen."
                            }
                        }
                    ],
                    "synonyms": [
                        "coarse",
                        "uncultured",
                        "vulgar"
                    ],
                    "antonyms": [
                        "refined",
                        "cultured"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Figurative extension of unsifted flour meaning coarse"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Grof, onbeschaafd of ordinair."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ongemanierd",
                                "target_lang_sense_clarification": "onbeschaafd"
                            },
                            {
                                "target_lang_word": "grof",
                                "target_lang_sense_clarification": "vulgair, lomp"
                            },
                            {
                                "target_lang_word": "onbeschaafd",
                                "target_lang_sense_clarification": "zonder manieren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}