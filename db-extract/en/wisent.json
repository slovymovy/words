                    },
                    {
                        "translation_id": "9f1cd02d-b155-46a0-a73d-1b84b0b28f1f",
                        "source_entry_id": "f8a6bf38-fe2a-340e-a763-e055a71937bb",
                        "source_sense_id": "e59c2b43-e6ed-3524-937f-c07e2d609b5e",
                        "source_sense_description": "European bison, Bison bonasus or Bos bonasus",
                        "target_lang_word": "зубр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "зубр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ddca1150-6f4f-355c-a2fd-306a404ae865",
                                        "entry_id": "20675e1f-01d6-36bc-8c5b-dc89ee37e5f4",
                                        "glosses": [
                                            "зоол. крупное травоядное животное, европейский вид из рода бизонов семейства полорогих отряда парнокопытных (Bison bonasus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eeabb7d-9c0f-491f-9cca-492df9b0a631",
                                                "sense_id": "ddca1150-6f4f-355c-a2fd-306a404ae865",
                                                "text": "В Беловеже Заповедный заказник, занимающий огромное пространство в Гродненской губернии, известен под именем Беловежской пущи. Этот бесконечный лес с незапамятных пор служил любимым и лучшим местом королевских охот; в нём водится .. зубр .."
                                            },
                                            {
                                                "example_id": "d759173d-d217-48ce-be27-62e1cd8edd6b",
                                                "sense_id": "ddca1150-6f4f-355c-a2fd-306a404ae865",
                                                "text": "Другой вид европейского дикого быка — зубр, не имевший прямого отношения к образованию домашних пород рогатого скота, сохранился дольше. В количестве нескольких сот экземпляров до последней войны он жил в известной Беловежской пуще и на Кавказе. Во время войны эти стада в обеих местностях были уничтожены, и теперь сохранилось лишь несколько экземпляров на Кавказе .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96cd1bb9-37f4-318c-83bc-5b9926985e6d",
                                        "entry_id": "20675e1f-01d6-36bc-8c5b-dc89ee37e5f4",
                                        "glosses": [
                                            "перен., разг. многоопытный, мудрый человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba3589b-d17f-40c2-b8f1-f234ce14392e",
                                                "sense_id": "96cd1bb9-37f4-318c-83bc-5b9926985e6d",
                                                "text": "Мы были учениками у пользовавшихся заслуженной славой зубров армянской журналистики."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
