                        "cross_references": [
                            {
                                "target_word": "firkin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c17c14ed-e26f-3ad7-b785-0fb6d8641d03",
                                        "entry_id": "6437635f-7b14-3332-935c-468a1ec2c9ea",
                                        "glosses": [
                                            "A varying measure of capacity, usually being a quarter of a barrel; specifically, a measure equal to nine imperial gallons."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2587801d-6d96-4c23-a4da-53f02e7c9fe6",
                                                "sense_id": "c17c14ed-e26f-3ad7-b785-0fb6d8641d03",
                                                "text": "23 Hen. VIII, cap. 4... The barrel of beer is to hold 36 gallons, the kilderkin 18 gallons the firkin 9. But the barrel, kilderkin, and firkin of ale are to contain 32, 16, and 8 gallons."
                                            },
                                            {
                                                "example_id": "a253281b-e2bf-4f9d-92b4-de4ee46ceb55",
                                                "sense_id": "c17c14ed-e26f-3ad7-b785-0fb6d8641d03",
                                                "text": "But for his other guests he let bear in the massy cups of silver, and the great eared wine jars holding two firkins apiece, and he let pour forth to the Witches and the Foliots, and they drank the cup of memory unto King Gorice XI., slain that day by the hand of Goldry Bluszco."
                                            },
                                            {
                                                "example_id": "6bd46563-aaf2-4fa3-a3da-8cdc049029ff",
                                                "sense_id": "c17c14ed-e26f-3ad7-b785-0fb6d8641d03",
                                                "text": "Barrels came in firkins, nine gallons; kilderkins, eighteen gallons; halves, twenty-seven gallons; barrels, thirty-six gallons and hogsheads, fifty-four."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa17bf98-3aac-349e-bda5-89cd6b4a6ac1",
                                        "entry_id": "6437635f-7b14-3332-935c-468a1ec2c9ea",
                                        "glosses": [
                                            "A small wooden vessel or cask of indeterminate size, used for butter, lard, etc."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
