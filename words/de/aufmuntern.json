            "senses": [
                {
                    "sense_id": "6fb376cf-74e4-3439-87ca-810fe6728d74",
                    "sense_definition": "jemandes traurige Stimmung verbessern und ihm wieder Freude bringen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stimmung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn meine Freundin traurig ist, versuche ich immer, sie mit Schokolade <w>aufzumuntern</w>."
                        },
                        {
                            "text": "Seine lustigen Witze <w>munterten</w> uns nach dem anstrengenden Tag wieder <w>auf</w>."
                        }
                    ],
                    "synonyms": [
                        "aufheitern"
                    ],
                    "common_phrases": [
                        "jemanden aufmuntern",
                        "ein wenig aufmuntern"
                    ]
                },
                {
                    "sense_id": "de63bb6e-444e-3fa6-9d67-d00174011ad3",
                    "sense_definition": "jemandem Mut zusprechen und dazu bewegen, etwas zu wagen oder nicht aufzugeben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "motivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Trainerin <w>munterte</w> das junge Team <w>auf</w>, trotz des Rückstands weiterzukämpfen."
                        },
                        {
                            "text": "Vor der schwierigen Prüfung <w>munterte</w> der Lehrer alle Schüler noch einmal <w>auf</w>."
                        }
                    ],
                    "synonyms": [
                        "ermutigen"
                    ],
                    "antonyms": [
