                                                "sense_id": "d0100ba3-7216-3e3d-9b49-d3b80681580f",
                                                "text": "„Für folgende Bedienstetengruppen ist die Leistung von Überstunden unzulässig: …“"
                                            },
                                            {
                                                "example_id": "070def9c-6393-4f3b-a548-72399a03fbad",
                                                "sense_id": "d0100ba3-7216-3e3d-9b49-d3b80681580f",
