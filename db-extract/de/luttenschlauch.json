                ],
                "senses": [
                    {
                        "sense_id": "7c92714b-91b1-3dcc-9d29-89ef822192d3",
                        "entry_id": "aeab421d-440f-3d9d-8036-f84030252116",
                        "glosses": [
                            "bis zu 3,5 Meter dicker Schlauch aus PVC-beschichtetem Polyester zur Be- und Entlüftung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34ad9ab2-e01d-4cd6-8056-2e377dda063a",
                                "sense_id": "7c92714b-91b1-3dcc-9d29-89ef822192d3",
                                "text": "„Die sogenannten Luttenschläuche stammen aus dem Bergbau, dienen zur Belüftung und hätten einen Eintrag im Guinness Buch der Rekorde verdient.“"
                            },
                            {
                                "example_id": "8cb9cfa7-806f-4aec-80d4-454072c91eb1",
                                "sense_id": "7c92714b-91b1-3dcc-9d29-89ef822192d3",
                                "text": "„Erstmalig wird aufgezeigt, wie die Wirtschaftlichkeit und Weiterreißfestigkeit von faltbaren Luttenschläuchen erheblich verbessert werden kann.“"
                            },
                            {
                                "example_id": "5f75f07f-77ea-4267-9ad2-ec0d03b6c6b6",
                                "sense_id": "7c92714b-91b1-3dcc-9d29-89ef822192d3",
                                "text": "PLT/Z-Luttenschläuche werden zur Förderung von Gasen im unterirdischen Bergbau und in Räumen, wo Methanexplosionsgefahr „a“, „b“ oder „c“ besteht, angewendet."
                            },
                            {
                                "example_id": "72c0b3b0-51e6-4c2a-91ea-325de5a185ce",
                                "sense_id": "7c92714b-91b1-3dcc-9d29-89ef822192d3",
                                "text": "Des weiteren betrifft die Erfindung ein Verfahren zum Herstellen solcher Luttenschläuche und eine geeignete Einrichtung (Vorrichtung) zum Durchführen des Verfahrens."
                            },
                            {
                                "example_id": "1b56d6c3-7295-4962-bf8b-24bf4025f962",
                                "sense_id": "7c92714b-91b1-3dcc-9d29-89ef822192d3",
                                "text": "Klassischer Bau-Abluftschlauch (auch Luttenschlauch genannt) geeignet als Abluft- und Heizschlauch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
