                "senses": [
                    {
                        "sense_id": "6f0ed4b3-5df7-3b37-a316-4171317dc0b6",
                        "entry_id": "22b537dd-0d27-30d8-b84c-dfc6044ce414",
                        "glosses": [
                            "weiche, wie Brei beschaffene Masse, die aus zerkleinerten Fasern sowie Leim, Füllstoffen und Harzen hergestellt wurde, aus der Papier angefertigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ac6e3d9-746e-4ebe-be42-1e4ccf90bdd7",
                                "sense_id": "6f0ed4b3-5df7-3b37-a316-4171317dc0b6",
                                "text": "„Füll die Rührschüssel der Küchenmaschine bis zur Hälfte mit Wasser und gib dann portionsweise den Papierbrei hinzu.“"
                            },
                            {
                                "example_id": "4e52c9cd-12be-48ad-aedd-7f77c122497e",
                                "sense_id": "6f0ed4b3-5df7-3b37-a316-4171317dc0b6",
                                "text": "„Aber er war viel zu neugierig und wollte unbedingt wissen, was aus dem Papierbrei hergestellt wurde.“"
                            },
                            {
                                "example_id": "65e03a7e-f7fa-44b3-a06f-106907114c8f",
                                "sense_id": "6f0ed4b3-5df7-3b37-a316-4171317dc0b6",
                                "text": "„Fülle die Wanne etwa zur Hälfte mit Wasser und gib den Papierbrei Tüchern zum Trocknen aufhängen.“"
                            },
                            {
                                "example_id": "333480c7-351b-4230-adbd-5065ce70ac2e",
                                "sense_id": "6f0ed4b3-5df7-3b37-a316-4171317dc0b6",
                                "text": "„Diese gallertartige Masse wird mit dem Papierbrei gemischt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
