                "senses": [
                    {
                        "sense_id": "0c2cf891-6183-31cf-a2a7-681037f07ccb",
                        "entry_id": "9eb69964-a5d9-30e1-b635-edeb351a12c3",
                        "glosses": [
                            "геогр. столица Финляндии на берегу Финского залива Балтийского моря, административный центр ляни (губернии) Усима"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49829c0d-e37f-4c54-b0df-cea28b49da4b",
                                "sense_id": "0c2cf891-6183-31cf-a2a7-681037f07ccb",
                                "text": "Хельсинки ― индустриальный город, здесь множество предприятий и кипучая деловая жизнь."
                            }
                        ]
                    },
                    {
                        "sense_id": "15ad1059-317f-3c4c-87bf-d6b7c1a0cecf",
                        "entry_id": "9eb69964-a5d9-30e1-b635-edeb351a12c3",
                        "glosses": [
                            "метоним., полит. правительство Финляндии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55cf2c93-1b07-42cc-baec-d5d2f0a55757",
                                "sense_id": "15ad1059-317f-3c4c-87bf-d6b7c1a0cecf",
                                "text": "Документом подтверждается, что Хельсинки намерен активно взаимодействовать с другими странами в вопросах предотвращения распространения оружия массового поражения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a749760f-520e-405f-bb59-daf9011b81a6",
                        "source_entry_id": "9eb69964-a5d9-30e1-b635-edeb351a12c3",
                        "target_lang_word": "Helsinki",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Helsinki",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5985b3d2-42f6-3a09-8344-8ba36338d678",
                                        "entry_id": "1ade4dda-7400-3c8f-bcd0-56a8fb3ce2b2",
                                        "glosses": [
                                            "The capital city of Finland; a municipality, the capital of the region of Uusimaa, Finland."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "790d6caa-3191-4e97-bab9-41c1309900cd",
                                                "sense_id": "5985b3d2-42f6-3a09-8344-8ba36338d678",
                                                "text": "My doctors didn't want me to go to Helsinki, but staying home wasn't an option. Yeltsin had been reelected and NATO was about to vote to admit Poland, Hungary, and the Czech Republic; we had to have an agreement on how to proceed."
                                            },
                                            {
                                                "example_id": "66109863-dded-4cdf-85c6-e428686e9549",
                                                "sense_id": "5985b3d2-42f6-3a09-8344-8ba36338d678",
                                                "text": "There’s a YIMBY group in Somerville, Massachusetts, and one in Los Angeles; there’s a San Francisco YIMBY party and a YIMBY group in Portland. YIMBYtown, a national conference, will take place in Oakland this month; Helsinki is hosting Yimbycon in August."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
