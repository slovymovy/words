                        ],
                        "form": "expressos"
                    },
                    {
                        "form_id": "b889e974-823e-4543-a23a-e38da7a51932",
                        "entry_id": "3aade14e-99d9-37a8-8c94-4528f1ffc4fe",
                        "tags": [],
                        "form": "espresso"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6a6d3c2-0432-3a5b-8d4d-c8e4ad577fe2",
                        "entry_id": "3aade14e-99d9-37a8-8c94-4528f1ffc4fe",
                        "glosses": [
                            "Café très corsé avec un fort arôme, obtenu en faisant passer rapidement de l’eau bouillante sous pression à travers du café finement moulu et torréfié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c59d8abb-5162-4740-b468-9cf41fa84cd7",
                                "sense_id": "d6a6d3c2-0432-3a5b-8d4d-c8e4ad577fe2",
                                "text": "Il avait épuisé ses fiches bristol, écarté deux ou trois hypothèses de travail, avait avalé cinq expresso et raté le dernier service de la cantine."
                            },
                            {
                                "example_id": "452490b8-70c0-4840-9442-7cbcbd877d55",
                                "sense_id": "d6a6d3c2-0432-3a5b-8d4d-c8e4ad577fe2",
                                "text": "Je trouve une place à la terrasse qui donne sur la salle des pas perdus. Je commande un double-expresso, un croissant et un pain au chocolat."
                            },
                            {
                                "example_id": "17db4cc9-280a-4fa8-b4ab-adc007cfe00b",
                                "sense_id": "d6a6d3c2-0432-3a5b-8d4d-c8e4ad577fe2",
                                "text": "Plutôt slow coffee qu’expresso ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca2ccb03-0e58-47e5-a318-44d4a18938b8",
                        "source_entry_id": "3aade14e-99d9-37a8-8c94-4528f1ffc4fe",
                        "source_sense_id": "d6a6d3c2-0432-3a5b-8d4d-c8e4ad577fe2",
                        "target_lang_word": "Espresso",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Espresso",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                        "entry_id": "9f94edc2-c707-3f18-90ea-2de96cd75f71",
                                        "glosses": [
                                            "starker Kaffee, der mit hohem Wasserdruck und fein gemahlenen, dunkel gerösteten Kaffeebohnen gebraut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89d7e851-5090-49f5-b94b-1ea7bf18b878",
                                                "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                                "text": "Ich liebe es, nach der Arbeit mit meiner besten Freundin einen guten Espresso zu trinken und zu quatschen."
                                            },
                                            {
                                                "example_id": "10a71842-2fbb-4886-8938-f90f184bf729",
                                                "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                                "text": "Espresso wird meist in kleinen Tassen serviert."
                                            },
                                            {
                                                "example_id": "365a8887-c7aa-4fef-90de-4d4d3c25c045",
                                                "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                                "text": "„Ich ziehe die Schuhe erst gar nicht aus, mache mir einen Espresso und fahre den Computer hoch.“"
                                            },
                                            {
                                                "example_id": "5dd3f6f5-39b2-4006-a706-297641939145",
                                                "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                                "text": "„Wir sind schwer beeindruckt und bestellen zwei Espressi, setzen uns vor den Laden und sehen einzelne Touristen, Pärchen und Familien vorüberziehen.“"
                                            },
                                            {
                                                "example_id": "abeeccfc-ae66-407a-99e5-73b1881f401f",
                                                "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                                "text": "„Beinah jeden Tag hatten wir in dem Café beim Pantheon unseren Espresso getrunken und dort einen Händler mit seinem Bauchladen kennengelernt.“"
                                            },
                                            {
                                                "example_id": "5422eaaf-e4bd-4ad8-ba05-65740cd9e9a0",
                                                "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                                "text": "„Der Ober brachte den Espresso mit einem großen Glas Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Espresso",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a0a3cee-7c62-344c-a218-89e8a5261669",
                                        "entry_id": "e84d0c34-a563-3c95-8bb6-b9383260442b",
                                        "glosses": [
                                            "kleine Gaststätte, in der Espresso serviert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fcfd6a9-9edb-4133-aa78-63898ef4a822",
                                                "sense_id": "4a0a3cee-7c62-344c-a218-89e8a5261669",
                                                "text": "Im kleinen Espresso von Giorgio bekommt man auch andere Kaffeespezialitäten als Espresso."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
