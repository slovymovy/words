                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70dcc28-3b35-45d2-9006-db0e594ac4ed",
                                                "sense_id": "88694694-053c-3e00-960c-09fe6f22e3dd",
                                                "text": "Żadne słowa współczucia z pewnością nie pomogą ci pogodzić się z tą ciężką stratą."
                                            },
                                            {
                                                "example_id": "3707d533-7977-4dc9-8be2-36f04ceb30e3",
                                                "sense_id": "88694694-053c-3e00-960c-09fe6f22e3dd",
                                                "text": "Ale mówi płynnie w jidysz i ma naturalny talent do wywoływania współczucia u słuchaczy."
                                            },
                                            {
                                                "example_id": "0de4b83b-c197-4c46-b9f8-e4e1743348ce",
                                                "sense_id": "88694694-053c-3e00-960c-09fe6f22e3dd",
                                                "text": "— Może pani pożyczyć agrafki do zapięcia sukni pod kolanami? — zapytał Cezary ze współczuciem i gotowością do usług."
                                            },
                                            {
                                                "example_id": "ba356867-eacf-4938-bffc-da319b6c299a",
                                                "sense_id": "88694694-053c-3e00-960c-09fe6f22e3dd",
                                                "text": "Powoli pozytywny biegun muzyki zaczął coraz bardziej przyciągać współczucie i tak rozluźniła się ostatnia więź z rodziną."
                                            }
                                        ],
