                                    {
                                        "sense_id": "7f026128-0b8c-3124-adbf-7d7ac1f0be58",
                                        "entry_id": "82ba13fe-722e-39a8-84ef-35830ce150a2",
                                        "glosses": [
                                            "herzhafter Kuchen mit einer würzigen Füllung, die meist Eier und Sahne enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df42510-45b0-40b8-92ab-ba5cf9a33339",
                                                "sense_id": "7f026128-0b8c-3124-adbf-7d7ac1f0be58",
                                                "text": "Die Quiche ist eine Spezialität der französischen Küche."
                                            },
                                            {
                                                "example_id": "4faba7cb-1fef-471b-b2b3-60df0dbcb8d1",
                                                "sense_id": "7f026128-0b8c-3124-adbf-7d7ac1f0be58",
                                                "text": "Der Boden der Quiche wird zuerst vorgebacken, danach wird die Füllung auf den Boden gegeben und im Ofen gebacken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7a123d8-4720-4c97-9528-510cb88986e3",
                        "source_entry_id": "0b0a4edb-adf3-341c-b019-f7c29062d9f7",
                        "source_sense_id": "1e0407a8-82f9-38b5-8a88-1ecbb3120779",
                        "target_lang_word": "quiche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quiche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0aa6d8af-8ae7-3dfd-8a32-82cffc7bc03e",
                                        "entry_id": "b6ad961d-4a20-38b2-8112-d7a86f211376",
                                        "glosses": [
                                            "Tarte."
                                        ],
                                        "tags": [
                                            "Lorraine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d50575e-a06d-44c0-8a59-98c131e194c3",
                                                "sense_id": "0aa6d8af-8ae7-3dfd-8a32-82cffc7bc03e",
                                                "text": "Une servante étalait le dessert sur la table, les quiches aux « quetsches » dont le jus coulait parfumé, les gâteaux à la croûte dorée et craquante, les tartes aux pommes, larges comme des fonds de tonneau et dont la pâte avait un goût fin de cannelle."
                                            },
                                            {
                                                "example_id": "87869aa0-9dd3-4f3e-8ccb-23b2e5999467",
                                                "sense_id": "0aa6d8af-8ae7-3dfd-8a32-82cffc7bc03e",
                                                "text": "Les mirabelliers rongés de lichens jaunâtres, lui rappelèrent des jours d'été, où sa mère chauffait le four pour cuire les « quiches », les tartes juteuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6408f0ad-c760-35b0-8a4d-07c858293d40",
                                        "entry_id": "b6ad961d-4a20-38b2-8112-d7a86f211376",
                                        "glosses": [
                                            "Tarte salée remplie d’un mélange de lait ou de crème, d’œufs, et d’autres ingrédients (selon les cas lardons, jambon, poisson, légumes, fromage…)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e168b52d-01d3-45a6-b8f9-da528b1d1316",
                                                "sense_id": "6408f0ad-c760-35b0-8a4d-07c858293d40",
                                                "text": "Les « chons » permettent de faire de bonnes quiches et les pots de saindoux de conserver des saucisses, des morceaux de volailles pour tout l'été."
                                            },
                                            {
                                                "example_id": "fff69502-adb4-4fe0-aa87-2fc14864e814",
                                                "sense_id": "6408f0ad-c760-35b0-8a4d-07c858293d40",
                                                "text": "Ce café-bar rétro au style décalé mitonne salades, sandwichs, quiches, houmous, assiettes de fromage et de charcuterie et nombreux plats végétariens pour une clientèle tendance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a31477c0-38c7-3505-9e76-ac3a1d00baed",
                                        "entry_id": "b6ad961d-4a20-38b2-8112-d7a86f211376",
                                        "glosses": [
                                            "Personne tarte, peu douée, maladroite, qui n'a pas la réflexion vive."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "866316ce-90c9-495c-b378-087c384e3271",
                                                "sense_id": "a31477c0-38c7-3505-9e76-ac3a1d00baed",
                                                "text": "Cela dit, si vous êtes vraiment une quiche, vous avez plusieurs façons de vous faire aider."
                                            },
                                            {
                                                "example_id": "5a6f964b-a842-4fc1-8403-7978413c797b",
                                                "sense_id": "a31477c0-38c7-3505-9e76-ac3a1d00baed",
                                                "text": "Quelle quiche celui là !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad167d01-8446-342e-b9f0-7d2fe51d483d",
                                        "entry_id": "b6ad961d-4a20-38b2-8112-d7a86f211376",
                                        "glosses": [
                                            "Coup, giffle."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "819b8b79-e4a1-4ebb-b775-abc3ffc28ca1",
                                                "sense_id": "ad167d01-8446-342e-b9f0-7d2fe51d483d",
                                                "text": "Continue comme ça et tu vas te prendre une quiche !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbedb2ef-6dd4-3047-b48e-b00e17588611",
                                        "entry_id": "b6ad961d-4a20-38b2-8112-d7a86f211376",
                                        "glosses": [
                                            "(Isérois) Personne incompétente, nulle."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
