            "senses": [
                {
                    "sense_id": "4294dfe9-263a-304f-9b7e-c4297ba8e749",
                    "sense_definition": "Médicament sous forme solide que l'on avale avec de l'eau.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai pris un <w>cachet</w> avec un verre d'eau pour calmer mon mal de tête."
                        },
                        {
                            "text": "Le médecin lui a conseillé d'avaler ce <w>cachet</w> tous les soirs avant de dormir."
                        }
                    ],
                    "synonyms": [
                        "comprimé",
                        "capsule",
                        "gélule"
                    ],
                    "common_phrases": [
                        "prendre un cachet",
                        "cachet d'aspirine"
                    ]
                },
                {
                    "sense_id": "05cdce6d-1eca-3ac2-a8c1-b971202a6097",
                    "sense_definition": "Empreinte à l'encre apposée par l'administration des postes sur une lettre ou un colis.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "courrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>cachet</w> de la poste sur l'enveloppe indique la date exacte de l'envoi."
                        },
                        {
                            "text": "Pour que votre inscription soit acceptée, ce <w>cachet</w> doit être parfaitement lisible."
                        }
                    ],
                    "synonyms": [
                        "estampille"
                    ],
                    "common_phrases": [
