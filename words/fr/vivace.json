{
    "word_family": [
        "vivacité"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49809e17-057f-32aa-a543-774bb08db3ac",
                    "sense_definition": "En botanique, qualifie une plante qui vit plusieurs années et repousse à chaque saison.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La tulipe est une plante <w>vivace</w> facile à cultiver dans un jardin ensoleillé."
                        },
                        {
                            "text": "Plusieurs espèces <w>vivaces</w> résistent parfaitement aux gelées de l'hiver."
                        }
                    ],
                    "synonyms": [
                        "pérenne"
                    ],
                    "antonyms": [
                        "annuel",
                        "bisannuel"
                    ],
                    "common_phrases": [
                        "plante vivace"
                    ]
                },
                {
                    "sense_id": "d1a2b92b-d4f3-39e4-a705-004b2db5d235",
                    "sense_definition": "Qui dure longtemps ou persiste avec force, en parlant d'une idée, d'un souvenir ou d'un sentiment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce souvenir d'enfance est resté particulièrement <w>vivace</w> dans sa mémoire malgré le temps passé."
                        },
                        {
                            "text": "Une vieille querelle de famille demeurait encore <w>vivace</w> entre les deux villages voisins."
                        }
                    ],
                    "common_phrases": [
                        "souvenir vivace",
                        "tradition vivace"
                    ]
                },
                {
                    "sense_id": "755ae700-1f26-3a82-a2c7-f987c3408918",
                    "sense_definition": "Qui montre une vitalité remarquable, plein de vigueur, d'ardeur ou d'entrain.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vitalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme conservait un esprit <w>vivace</w> et participait activement à toutes les discussions."
                        },
                        {
                            "text": "Cette petite fille a une imagination incroyablement <w>vivace</w> qui surprend ses professeurs."
                        }
                    ],
                    "common_phrases": [
                        "esprit vivace",
                        "imagination vivace"
                    ]
                },
                {
                    "sense_id": "a6bb6a12-cbcf-30d0-b6f5-6b85d36e1d3d",
                    "sense_definition": "En musique, qualifie un morceau ou un tempo joué avec vivacité et rapidité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orchestre a interprété un allegro <w>vivace</w> qui a enthousiasmé toute la salle de concert."
                        },
                        {
                            "text": "Le dernier mouvement du concerto s'achève sur un rythme particulièrement <w>vivace</w> et éclatant."
                        }
                    ],
                    "common_phrases": [
                        "allegro vivace"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e815589d-7882-34da-94b5-5fd7021aed8c",
                    "sense_definition": "Plante herbacée ou ligneuse qui subsiste plusieurs années.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jardinier conseille d'associer des <w>vivaces</w> avec des arbustes pour garnir les bordures."
                        },
                        {
                            "text": "Elle a planté une magnifique <w>vivace</w> au pied du vieux mur en pierre."
                        }
                    ],
                    "common_phrases": [
                        "massif de vivaces"
                    ]
                }
            ]
        }
    ]
}