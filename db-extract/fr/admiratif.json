                        "glosses": [
                            "Qui exprime l’admiration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "849822bf-b1fd-4b6e-bbb5-410e92389073",
                                "sense_id": "2c537784-7452-35ff-8321-efe7b5b02358",
                                "text": "Ah ! est quelquefois particule admirative."
                            },
                            {
                                "example_id": "2dab43c2-d369-4288-8cb4-3422487ec91b",
                                "sense_id": "2c537784-7452-35ff-8321-efe7b5b02358",
                                "text": "Joseph marchait dans ce cloître admiratif et surpris par la grandeur des lieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6add0a8-ccd2-326c-9a9d-ec78a2084e48",
                        "entry_id": "5b18d3a7-2a41-3413-9132-18c03a2cd55e",
                        "glosses": [
                            "Se dit du ton, des gestes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d2da139-2233-4d4c-995f-96738b32b0b0",
                                "sense_id": "d6add0a8-ccd2-326c-9a9d-ec78a2084e48",
                                "text": "Il prend toujours le ton admiratif."
                            },
                            {
                                "example_id": "ce5490c8-f79e-4673-abfb-a9cd6489cb39",
                                "sense_id": "d6add0a8-ccd2-326c-9a9d-ec78a2084e48",
                                "text": "Ils témoignèrent leur satisfaction par des gestes admiratifs."
                            }
                        ]
