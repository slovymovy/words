                                        "entry_id": "3d4ef548-73b2-3943-981e-55a65b7bd762",
                                        "glosses": [
                                            "síndrome dolorosa não-inflamatória, caracterizada por dores musculares difusas, fadiga, distúrbios de sono, parestesias, edema subjetivo, distúrbios cognitivos e dor em pontos específicos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f7d136-6ade-489d-ac8f-9189b2258ec2",
                                                "sense_id": "fa76892f-5bcc-3557-811f-0ee4b07f5336",
                                                "text": "Ele e seus colegas avaliaram 90 estudos que incluíram mais de 10 mil pessoas com problemas de saúde como câncer, doenças cardiovasculares, doença pulmonar obstrutiva crônica, fibromialgia, dor crônica e obesidade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
