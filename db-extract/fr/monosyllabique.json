        "fr-extract.jsonl": [
            {
                "entry_id": "4298244f-a4de-30e5-a772-10ce54b89fff",
                "word": "monosyllabique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fe226442-d38b-4ba9-a758-4fed88d1c2de",
                        "entry_id": "4298244f-a4de-30e5-a772-10ce54b89fff",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "monosyllabiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "00d99d89-985d-3a89-b3f4-a852fbfd45ce",
                        "entry_id": "4298244f-a4de-30e5-a772-10ce54b89fff",
                        "glosses": [
                            "Qui a une seule syllabe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c918d3-7f60-4a1d-b1ac-ab4fa3a5233a",
                                "sense_id": "00d99d89-985d-3a89-b3f4-a852fbfd45ce",
                                "text": "« Bon » est adjectif monosyllabique."
                            },
                            {
                                "example_id": "14752c3e-0453-4b22-bd46-27c19e497fe7",
                                "sense_id": "00d99d89-985d-3a89-b3f4-a852fbfd45ce",
                                "text": "[…] c’est à peine si quelques-uns parviennent à répéter deux ou trois sons monosyllabiques, ce que font certains chimpanzés de chez nous."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f41c5e3-725c-3c4b-aa15-b6c62108d15c",
                        "entry_id": "4298244f-a4de-30e5-a772-10ce54b89fff",
                        "glosses": [
                            "Qui est composé de monosyllabes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd2fa26d-b504-413b-b7ab-10062b687384",
                                "sense_id": "1f41c5e3-725c-3c4b-aa15-b6c62108d15c",
                                "text": "Le sumérien étant majoritairement monosyllabique, il en aurait résulté des homophones nombreux (des mots différents se prononçant de la même façon, comme en français vers, verre, vert, ver) si la langue n’avait pas utilisé un autre moyen de distinguer entre les différents sens de ces « homophones »."
                            },
                            {
                                "example_id": "9702f2d1-91ea-4338-8f44-d3a43454ee82",
                                "sense_id": "1f41c5e3-725c-3c4b-aa15-b6c62108d15c",
                                "text": "Vers monosyllabiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "eecfe2a1-4e4a-35e2-acb2-0babea6156e5",
                        "entry_id": "4298244f-a4de-30e5-a772-10ce54b89fff",
                        "glosses": [
                            "Qui parle par monosyllabes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35943d8f-a05c-4ab9-bd5a-9398e40f364a",
                                "sense_id": "eecfe2a1-4e4a-35e2-acb2-0babea6156e5",
                                "text": "Au téléphone, Lawrence était plus monosyllabique que jamais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be583c41-dd69-440b-b7ee-c98e0d3e7297",
                        "source_entry_id": "4298244f-a4de-30e5-a772-10ce54b89fff",
                        "target_lang_word": "einsilbig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einsilbig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74d9ad13-8b06-31e1-a2b9-c5d378bd3d99",
                                        "entry_id": "3ae4df16-893f-3b9e-8b51-fefddb5a1a5b",
                                        "glosses": [
                                            "Eigenschaft einer Person, nicht gern zu sprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "264f968e-802f-438c-931a-452ce166ce78",
                                                "sense_id": "74d9ad13-8b06-31e1-a2b9-c5d378bd3d99",
                                                "text": "Er ist ein sehr einsilbiger Mensch."
                                            },
                                            {
                                                "example_id": "469b9ec1-15c1-4a0e-bf77-fc4d6149fce6",
                                                "sense_id": "74d9ad13-8b06-31e1-a2b9-c5d378bd3d99",
                                                "text": "„Während wir ihr durch mehrere dunkle Straßen folgten, blieb Ambly recht einsilbig, …“"
                                            },
                                            {
                                                "example_id": "a07ccaa2-df54-44e8-930a-9f328cf15381",
                                                "sense_id": "74d9ad13-8b06-31e1-a2b9-c5d378bd3d99",
                                                "text": "„Den übrigen Weg gab er sich einsilbig und fragte mich überhaupt nicht mehr nach meinem Buch.“"
                                            },
                                            {
                                                "example_id": "00a63833-1f1f-4aac-9f16-e9da847dcd36",
                                                "sense_id": "74d9ad13-8b06-31e1-a2b9-c5d378bd3d99",
                                                "text": "„Er wundert sich, daß Franz einsilbig ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "25724d6c-149a-3eda-bdd2-1b67faf1561c",
                                        "entry_id": "3ae4df16-893f-3b9e-8b51-fefddb5a1a5b",
                                        "glosses": [
                                            "nur aus einer Silbe bestehend"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4565b50f-4755-4f1a-ac74-368845d2c39c",
                                                "sense_id": "25724d6c-149a-3eda-bdd2-1b67faf1561c",
                                                "text": "„Diese Schreibkonvention stammt aus der Zeit, als die Mehrzahl der chinesischen Wörter einsilbig waren und mit je einem Zeichen geschrieben wurden, als also keine Veranlassung bestand, Wortgrenzen graphisch zu markieren (…).“"
                                            },
                                            {
                                                "example_id": "283b96c5-2d5a-4d17-bdb1-4745264f1e99",
                                                "sense_id": "25724d6c-149a-3eda-bdd2-1b67faf1561c",
                                                "text": "„Hat sich Englisch als Weltsprache möglicherweise auch deshalb durchgesetzt, weil es die meisten einsilbigen Wörter aufweist?“"
                                            },
                                            {
                                                "example_id": "64d986a6-b063-4752-a823-7da01be6a668",
                                                "sense_id": "25724d6c-149a-3eda-bdd2-1b67faf1561c",
                                                "text": "„Der wie seine Figuren, die gern einsilbige Namen wie Zürn, Halm oder Horn tragen, schwer unter Abhängigkeiten leidet, die der Einzelne nicht selbst beeinflussen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
