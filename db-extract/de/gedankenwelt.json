                    {
                        "form_id": "8c4241d2-b34d-4611-8544-eac51f8c7c03",
                        "entry_id": "b28c0ae8-fd7e-3772-a4c6-7d78d3e9fcf6",
                        "tags": [
                            "accusative",
                            "plural"
