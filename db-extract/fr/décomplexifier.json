                "senses": [
                    {
                        "sense_id": "3c84b866-a20c-37e2-8ff9-611f5cdf9054",
                        "entry_id": "d76a64d6-0576-3f5c-954d-d3ba0ba687e8",
                        "glosses": [
                            "Rendre moins complexe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "169a6d80-4d92-4370-b69b-5e304e7ea94d",
                                "sense_id": "3c84b866-a20c-37e2-8ff9-611f5cdf9054",
                                "text": "Colombani veut « décomplexifier » l’adoption"
                            },
                            {
                                "example_id": "d478e9af-79f6-4987-bbfd-d4e5b9138d82",
                                "sense_id": "3c84b866-a20c-37e2-8ff9-611f5cdf9054",
                                "text": "Les mathématiques sont un langage utilisé pour décomplexifier la réalité — ce qui peut sembler étonnant à quelqu'un qui n'a pas fait de mathématiques, et qui trouve cela extrêmement complexe."
                            }
                        ]
                    }
