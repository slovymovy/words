                    {
                        "sense_id": "adccac00-0457-3f49-9f68-7e715704ac73",
                        "entry_id": "9bdb5598-f100-3cbf-bd59-ee272e91dd4c",
                        "glosses": [
                            "To speak or tell about; declare; narrate; describe."
                        ],
                        "tags": [
