                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e76b2249-e3f3-42e8-a5bd-2b073722b889",
                                "sense_id": "fe5294d4-dfbf-3bd1-a3af-bfd6092a1967",
                                "text": "Przed zażyciem każdego leku, warto spytać się lekarza lub farmaceuty."
