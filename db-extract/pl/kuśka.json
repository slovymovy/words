                        ],
                        "examples": [
                            {
                                "example_id": "2dd4ee35-e631-47fb-93bf-688f76b5e320",
                                "sense_id": "583d1c51-0b62-3835-bc09-569bfdff6012",
                                "text": "W obcisłych kąpielówkach jego kuśka wyglądała bardzo imponująco, wywołując rumieniec na kraśnych licach miejscowych dziewcząt."
                            },
                            {
                                "example_id": "8a25f272-4460-4c0c-9c56-9305be07b1fb",
                                "sense_id": "583d1c51-0b62-3835-bc09-569bfdff6012",
                                "text": "Wiem tylko, że jak uchwycę dziewczynę, / Której dupina i cycka odrasta, / Kuśka mi staje – obłapiam i basta!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
