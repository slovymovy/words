                ],
                "senses": [
                    {
                        "sense_id": "b466806f-1d0a-3ff7-ba4f-986207b7fdb1",
                        "entry_id": "31aa135d-3f9b-32d1-b493-ff7146e92488",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6f096d6-2a23-4f9b-b51e-d7bf1d3bca3e",
                                "sense_id": "b466806f-1d0a-3ff7-ba4f-986207b7fdb1",
                                "text": "Frau Weinmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "52232b8b-c6c1-4606-aac8-807820315d98",
                                "sense_id": "b466806f-1d0a-3ff7-ba4f-986207b7fdb1",
                                "text": "Herr Weinmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7dbf6cfa-5bc6-45aa-8b86-226fde8053f4",
                                "sense_id": "b466806f-1d0a-3ff7-ba4f-986207b7fdb1",
                                "text": "Die Weinmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "def8166d-d0de-4269-842c-f52c35917fe5",
                                "sense_id": "b466806f-1d0a-3ff7-ba4f-986207b7fdb1",
                                "text": "Der Weinmann trägt nie die Schals, die die Weinmann ihm strickt."
                            },
                            {
                                "example_id": "96e9d977-f9ad-4dc6-8413-5c38cd3169a9",
                                "sense_id": "b466806f-1d0a-3ff7-ba4f-986207b7fdb1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Weinmann kommt, geht der Herr Weinmann.“"
                            },
                            {
                                "example_id": "86e3eafa-f8ad-4095-bb6c-18ce565d51dc",
                                "sense_id": "b466806f-1d0a-3ff7-ba4f-986207b7fdb1",
                                "text": "Weinmann kommt und geht."
                            },
                            {
                                "example_id": "b12df403-3544-420e-a6bb-a497dbd78211",
                                "sense_id": "b466806f-1d0a-3ff7-ba4f-986207b7fdb1",
                                "text": "Weinmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
