                {
                    "sense_id": "ee484057-68bc-35fb-9b42-1aa51977569a",
                    "sense_definition": "Met een verzorgd kapsel, waarvan het haar netjes in model is gebracht.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "verzorgd_haar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij zag er keurig uit met haar netjes <w>gekamde</w> haren.",
                            "target_lang_translations": {
                                "en": "She looked neat with her neatly <w>combed</w> hair."
                            }
                        },
                        {
                            "text": "Zorg dat je goed <w>gekamd</w> naar het sollicitatiegesprek gaat.",
                            "target_lang_translations": {
                                "en": "Make sure you go to the job interview with your hair well <w>combed</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "geborsteld",
                        "verzorgd"
                    ],
                    "antonyms": [
                        "ongekamd"
                    ],
                    "common_phrases": [
                        "goed gekamd haar"
                    ],
                    "target_lang_definitions": {
                        "en": "Having neat, well-groomed hair that has been styled with a comb."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "combed",
                                "target_lang_sense_clarification": "referring to hair"
                            },
                            {
                                "target_lang_word": "neatly combed",
                                "target_lang_sense_clarification": "referring to well-groomed hair"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "814dac7b-2f17-3f8c-bd46-959d8076becb",
                    "sense_definition": "Als met een kam gladgestreken of in model gebracht.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "verzorgd_haar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het grasveld lag erbij als een strak <w>gekamd</w> tapijt.",
                            "target_lang_translations": {
                                "en": "The lawn lay there like a tightly <w>combed</w> carpet."
                            }
                        },
                        {
                            "text": "De wind maakte patronen in het zand die eruitzagen als een <w>gekamde</w> structuur.",
                            "target_lang_translations": {
                                "en": "The wind made patterns in the sand that looked like a <w>combed</w> texture."
                            }
                        }
                    ],
                    "synonyms": [
                        "gladgestreken"
                    ],
                    "target_lang_definitions": {
                        "en": "Smoothed out or patterned as if with a comb."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "combed",
                                "target_lang_sense_clarification": "referring to surfaces like grass or sand"
                            },
                            {
                                "target_lang_word": "ridged",
                                "target_lang_sense_clarification": "having a combed or lined texture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f90880c-4b04-39c1-8429-6711b7d2e21e",
                    "sense_definition": "Voorzien van een kam (zoals bij een vogel of een helm).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een <w>gekamde</w> haan op een veld van or staat afgebeeld op het wapenschild.",
                            "target_lang_translations": {
                                "en": "A <w>crested</w> rooster on a field of gold is depicted on the coat of arms."
                            }
                        },
                        {
                            "text": "De ridder droeg een prachtig <w>gekamde</w> helm tijdens het toernooi.",
                            "target_lang_translations": {
                                "en": "The knight wore a beautifully <w>crested</w> helmet during the tournament."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Equipped with a comb or crest (such as a bird or a helmet)."
                    },
                    "translations": {
                        "en": [
                            {
