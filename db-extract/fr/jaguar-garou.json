                                            {
                                                "example_id": "083d2275-e8e2-48d4-9671-7d0f00fef2c7",
                                                "sense_id": "ea07445b-8fca-3b38-8538-f6c429b962b5",
                                                "text": "The rain god appears as a werejaguar, part human, part snarling beast."
                                            },
                                            {
                                                "example_id": "66bc1c9b-c9f9-4972-bbdc-52867ea80d91",
                                                "sense_id": "ea07445b-8fca-3b38-8538-f6c429b962b5",
                                                "text": "A pottery figure of a Mexican god who was thought to assume the shapes of many animals. Here he is shown as a werejaguar."
                                            },
                                            {
                                                "example_id": "ecf35d1e-a9a0-428b-8e43-776d4c2f241b",
                                                "sense_id": "ea07445b-8fca-3b38-8538-f6c429b962b5",
                                                "text": "Before your eyes, the shaman has transformed himself into a werejaguar!"
                                            }
