                ],
                "senses": [
                    {
                        "sense_id": "13d7c975-8288-3abb-94c9-7b5fc9b6eb72",
                        "entry_id": "396f3774-209d-36eb-ac41-06fb33c1840a",
                        "glosses": [
                            "den Planeten Erde (Terra) oder seine Bewohner betreffend"
                        ],
                        "tags": [
                            "Science-Fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "b3b13a06-3ed6-46a9-9fee-b56e8f74e9bd",
                                "sense_id": "13d7c975-8288-3abb-94c9-7b5fc9b6eb72",
                                "text": "„Zu jener Zeit war der terranische Kontinent Atlantis von arkonidischen Kolonisten besiedelt; es gab Kontakte zur terranischen Urbevölkerung und auch Ehen zwischen arkonidischen Kolonisten und terranischen Frauen.“"
                            },
                            {
                                "example_id": "608181ec-1e6e-425b-b2a2-29a85ed95ed6",
                                "sense_id": "13d7c975-8288-3abb-94c9-7b5fc9b6eb72",
                                "text": "„Natürlich besaß auch keine terranische Hauskatze Hände mit drei Fingern und opponierbaren Daumen.“"
                            },
                            {
                                "example_id": "6251804f-bd7b-49e9-b1aa-9b8da76f57f3",
                                "sense_id": "13d7c975-8288-3abb-94c9-7b5fc9b6eb72",
                                "text": "„Es hatte ein paar Heiraten zwischen ihnen gegeben, ein wenig Handel, geringe, sehr geringe Importe von terranischen Maschinen und Technologie.“"
                            },
                            {
                                "example_id": "bf17d55e-f579-46c0-bee0-a1c875b37316",
                                "sense_id": "13d7c975-8288-3abb-94c9-7b5fc9b6eb72",
                                "text": "„Ihr Name klingt terranisch. Ihr Ansinnen ist terranisch. Ihre ganze Ausdrucksweise ist terranisch. Junger Mann, Sie stinken nach Terra.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53898d68-6990-4807-8c58-ca9733136c4e",
