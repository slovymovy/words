{
    "word_family": [
        "завтрашний",
        "послезавтра"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9453d7ac-36ed-39de-b177-5f5698fbad00",
                    "sense_definition": "На следующий день после сегодняшнего.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_rel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он обещал прийти <w>завтра</w> вечером.",
                            "target_lang_translations": {
                                "en": "He promised to come <w>tomorrow</w> evening.",
                                "zh": "他答应<w>明天</w>晚上过来。",
                                "de": "Er hat versprochen, <w>morgen</w> Abend zu kommen."
                            }
                        },
                        {
                            "text": "Мы обязательно встретимся <w>завтра</w>.",
                            "target_lang_translations": {
                                "en": "We will definitely meet <w>tomorrow</w>.",
                                "zh": "我们<w>明天</w>一定会见面。",
                                "de": "Wir werden uns bestimmt <w>morgen</w> treffen."
                            }
                        }
                    ],
                    "antonyms": [
                        "вчера"
                    ],
                    "common_phrases": [
                        "до завтра",
                        "завтра утром",
                        "завтра днём",
                        "завтра вечером"
                    ],
                    "target_lang_definitions": {
                        "en": "The day following today.",
                        "zh": "今天之后的第二天。",
                        "de": "Der Tag nach dem heutigen Tag."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tomorrow",
                                "target_lang_sense_clarification": "adverb"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "明天",
                                "target_lang_sense_clarification": "副词，指今天之后的日期"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "morgen",
                                "target_lang_sense_clarification": "Adverb, bezeichnet den Tag nach heute"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6601c5ac-27ec-3073-abfd-90423a4aec7f",
                    "sense_definition": "День, который наступит сразу после сегодняшнего.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не откладывай на <w>завтра</w> то, что можно сделать сегодня.",
                            "target_lang_translations": {
                                "en": "Don't put off until <w>tomorrow</w> what can be done today.",
                                "zh": "今日事今日毕，不要拖到<w>明天</w>。",
                                "de": "Was du heute kannst besorgen, das verschiebe nicht auf <w>morgen</w>."
                            }
                        },
                        {
                            "text": "Наше <w>завтра</w> будет лучше, чем вчера.",
                            "target_lang_translations": {
                                "en": "Our <w>tomorrow</w> will be better than yesterday.",
                                "zh": "我们的<w>明天</w>会比昨天更好。",
                                "de": "Unser <w>Morgen</w> wird besser sein als das Gestern."
                            }
                        }
                    ],
                    "antonyms": [
                        "вчера",
                        "сегодня"
                    ],
                    "common_phrases": [
                        "на завтра",
                        "отложить на завтра"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "несклоняемое"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The day that will come immediately after today.",
                        "zh": "紧接在今天之后的那一天。",
                        "de": "Der Tag, der unmittelbar auf den heutigen folgt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tomorrow",
                                "target_lang_sense_clarification": "noun"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "明天",
                                "target_lang_sense_clarification": "名词，指代紧接今天的一天"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "morgen",
                                "target_lang_sense_clarification": "Substantiv, der kommende Tag"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33d4fa1f-6496-33c9-9afc-452e0f539b2f",
                    "sense_definition": "Недалёкое будущее.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы все надеемся на светлое <w>завтра</w>.",
                            "target_lang_translations": {
                                "en": "We all hope for a bright <w>tomorrow</w>.",
                                "zh": "我们都期待着光明的<w>未来</w>。",
                                "de": "Wir alle hoffen auf ein helles <w>Morgen</w>."
                            }
                        },
                        {
                            "text": "Нужно думать про своё <w>завтра</w> уже сейчас.",
                            "target_lang_translations": {
                                "en": "One needs to think about one's <w>future</w> right now.",
                                "zh": "现在就得为自己的<w>未来</w>做打算。",
                                "de": "Man muss schon jetzt an sein <w>Morgen</w> denken."
                            }
                        }
                    ],
                    "antonyms": [
                        "вчера"
                    ],
                    "common_phrases": [
                        "светлое завтра",
                        "прекрасное завтра"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "несклоняемое"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The near future.",
                        "zh": "指代不久的将来。",
                        "de": "Die nahe Zukunft."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tomorrow",
                                "target_lang_sense_clarification": "metaphorical"
                            },
                            {
                                "target_lang_word": "future",
                                "target_lang_sense_clarification": "meaning"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "未来",
                                "target_lang_sense_clarification": "名词，指代将来的时间"
                            },
                            {
                                "target_lang_word": "明天",
                                "target_lang_sense_clarification": "名词，比喻义，指代未来"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zukunft",
                                "target_lang_sense_clarification": "Substantiv, die kommende Zeit"
                            },
                            {
                                "target_lang_word": "morgen",
                                "target_lang_sense_clarification": "Substantiv, metaphorisch für die Zukunft"
                            }
                        ]
                    }
                }
            ]
        }
    ]
