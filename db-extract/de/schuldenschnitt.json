                ],
                "senses": [
                    {
                        "sense_id": "40ec3711-2393-39d2-b402-82fd4d41332c",
                        "entry_id": "e7b11dac-e278-3583-bcc5-21023cdde02f",
                        "glosses": [
                            "gänzlicher oder teilweiser Erlass von bestehenden Schulden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07d2b91c-ea1d-410c-ba31-3e670de7ea11",
                                "sense_id": "40ec3711-2393-39d2-b402-82fd4d41332c",
                                "text": "„Die Euro-Staaten bereiten offenbar einen Schuldenschnitt Griechenlands vor.“"
                            },
                            {
                                "example_id": "a4526d14-0061-4b0c-8e96-f37db780cd34",
                                "sense_id": "40ec3711-2393-39d2-b402-82fd4d41332c",
                                "text": "„Das in Brüssel ausgehandelte Sparpaket hat einen Umfang von 130 Milliarden Euro und beinhaltet einen Schuldenschnitt von 50 Prozent für Griechenland.“"
                            },
                            {
                                "example_id": "e726cdb2-2cce-46b7-9ff7-a95e337d1167",
                                "sense_id": "40ec3711-2393-39d2-b402-82fd4d41332c",
                                "text": "„Kaum haben sich die Banken in zähen Verhandlungen bereit erklärt, sich an einem freiwilligen Schuldenschnitt in der Höhe von 50 Prozent zu beteiligen, könnte die ganze Mühe schon wieder umsonst sein: Die Ankündigung des griechischen Ministerpräsidenten Giorgos Papandreou, ein Referendum über das Sparpaket durchführen zu wollen, könnte zu einem Scheitern der Gläubigerbeteiligung führen.“"
                            },
                            {
                                "example_id": "57785b73-41cc-45bf-b729-ac2d9162fddf",
                                "sense_id": "40ec3711-2393-39d2-b402-82fd4d41332c",
                                "text": "„Die Streckung von Tilgungen, das Aussetzen von Zinszahlungen oder gar ein Schuldenschnitt (Haircut) würden nur wirksam, wenn eine große Mehrheit der Gläubiger zustimmt, Sapir spricht von zwei Dritteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "802b9cff-29d4-474e-9ad4-3b8d0f7ba092",
                        "source_entry_id": "e7b11dac-e278-3583-bcc5-21023cdde02f",
                        "source_sense_id": "40ec3711-2393-39d2-b402-82fd4d41332c",
                        "source_sense_description": "Wirtschaft: gänzlicher oder teilweiser Erlass von bestehenden Schulden",
                        "target_lang_word": "debt cut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f7490f93-abc5-420b-bb9f-ed9f7bb81750",
                        "source_entry_id": "e7b11dac-e278-3583-bcc5-21023cdde02f",
                        "source_sense_id": "40ec3711-2393-39d2-b402-82fd4d41332c",
                        "source_sense_description": "Wirtschaft: gänzlicher oder teilweiser Erlass von bestehenden Schulden",
                        "target_lang_word": "haircut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haircut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "581afd6b-6891-313f-aa1a-96ec030140fb",
                                        "entry_id": "26c78ed0-c40a-3d11-9be7-26d47c2126d8",
                                        "glosses": [
                                            "The act of cutting of the hair, often done professionally by a barber, hair stylist, or beautician."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3582c1a2-3e2a-3307-8e05-c90d2320ea55",
                                        "entry_id": "26c78ed0-c40a-3d11-9be7-26d47c2126d8",
                                        "glosses": [
                                            "The style into which the hair is cut."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f0b41f1-008c-3f7d-9650-6e66e29631ab",
                                        "entry_id": "26c78ed0-c40a-3d11-9be7-26d47c2126d8",
                                        "glosses": [
                                            "A partial loss, financially: thus, in a bankruptcy proceeding, the proportional reduction in the debt that will be paid to each creditor (based on an evaluation of the total debt owed and the total assets of the debtor); among investors, the negative return on investment from a losing proposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d95423-c639-4701-96f0-3eb926e53781",
                                                "sense_id": "0f0b41f1-008c-3f7d-9650-6e66e29631ab",
                                                "text": "to take a haircut"
                                            },
                                            {
                                                "example_id": "c1404de4-91c7-4ba4-8a5b-9247ea935d1d",
                                                "sense_id": "0f0b41f1-008c-3f7d-9650-6e66e29631ab",
                                                "text": "And he needs to make sure that any American bank that was involved in loans to Asia, and now wants to share in the I.M.F. bailout, takes a haircut. And I'm not just talking about a trim."
                                            },
                                            {
                                                "example_id": "7bf2565d-4e07-4e14-9ec5-6a2215bb0ac9",
                                                "sense_id": "0f0b41f1-008c-3f7d-9650-6e66e29631ab",
                                                "text": "Its president, Nestor Kirchner, was expected to confirm overnight that about 75% of the country's bondholders had agreed to swap their old debt for new at a loss of up to 70 cents in the dollar—also a record and one that Mr Kirchner has called “the biggest haircut in history” for investors."
                                            },
                                            {
                                                "example_id": "ad1cbe65-1816-45f1-8da3-4f7553d062e3",
                                                "sense_id": "0f0b41f1-008c-3f7d-9650-6e66e29631ab",
                                                "text": "Something similar was happening at the same time in Greece. In the spring of 2012 Greece's public debt did, eventually, take a haircut, confirming that an unpayable debt will receive a haircut whatever the dogmas of European officials."
                                            },
                                            {
                                                "example_id": "b7550100-55b4-4408-9fed-e2a75cc35507",
                                                "sense_id": "0f0b41f1-008c-3f7d-9650-6e66e29631ab",
                                                "text": "And there is a growing consensus that it is finally time for founders to swallow their pride, accept a huge haircut to valuation and help establish a new floor for their stock to start growing again, helping to encourage all the companies coming up behind them to do the same."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94b04c5a-dbbf-3487-973c-81a607f15d07",
                                        "entry_id": "26c78ed0-c40a-3d11-9be7-26d47c2126d8",
                                        "glosses": [
                                            "The difference between the value of a loan and the value of its collateral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b296ab5-cd2d-4b7f-867f-3d67e2b31eec",
                                                "sense_id": "94b04c5a-dbbf-3487-973c-81a607f15d07",
                                                "text": "Government securities having high credit rating such as Treasury bonds and Treasury bills are usually subjected to 1% to 10% haircut, while for more risky, volatile or illiquid securities, such as a stock option, the haircut might be as high as 30%."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haircut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8b987c3-3bc0-3512-a71b-98dbeaae1a00",
                                        "entry_id": "58bd7326-5c95-3cd0-9a1c-56acd609dad3",
                                        "glosses": [
                                            "To reduce the value assigned to an asset."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97357428-8a83-483d-abd8-ea8e20b9b395",
                                                "sense_id": "a8b987c3-3bc0-3512-a71b-98dbeaae1a00",
                                                "text": "But whereas in the past it has been possible for a brokerage house to credit a customer’s account for 100 percent of the value of a commodity, we have required that that value be haircutted significantly."
                                            },
                                            {
                                                "example_id": "043cd885-f858-48fb-b879-997d5225790f",
                                                "sense_id": "a8b987c3-3bc0-3512-a71b-98dbeaae1a00",
                                                "text": "That is because the future stream of income is discounted to present value at perhaps as much as two to three percentage points above the prime rate and then haircutted by as high as 33½%."
                                            },
                                            {
                                                "example_id": "ccee58ba-0dcd-4380-9fec-f6197ebfc70d",
                                                "sense_id": "a8b987c3-3bc0-3512-a71b-98dbeaae1a00",
                                                "text": "The CFTC also permits FCMs to accept non-cash, non-security assets, but these must be \"haircutted\"--to 80 percent of their value."
                                            },
                                            {
                                                "example_id": "206def2d-cb21-4bb1-9584-5b221e4fb132",
                                                "sense_id": "a8b987c3-3bc0-3512-a71b-98dbeaae1a00",
                                                "text": "The ratio of these two numbers represents the ratio by which column one, the gross profits, needs to be \"haircutted,\" to amortize an asset initially established at 17%, with 6% interest starting out at the same place and ending at the same place over the same period of time."
                                            },
                                            {
                                                "example_id": "d78108e4-ef64-4285-97a5-4ffdfb80200d",
                                                "sense_id": "a8b987c3-3bc0-3512-a71b-98dbeaae1a00",
                                                "text": "DCC Credit Rating of First Priority CE Provider or Counterparty; or Cash/Cash Equivalent (which is not Haircutted)"
                                            },
                                            {
                                                "example_id": "e20d0476-2ad5-47e5-8ead-9240021351fa",
                                                "sense_id": "a8b987c3-3bc0-3512-a71b-98dbeaae1a00",
                                                "text": "The collateral value would then be haircutted by 140 percent, 40 EUR/140 percent= 28.6 EUR."
                                            },
                                            {
                                                "example_id": "a66167fc-5fed-46f6-9319-4554382736ae",
                                                "sense_id": "a8b987c3-3bc0-3512-a71b-98dbeaae1a00",
                                                "text": "And we do take a lot of care in our discount window lending and our other lending to make sure that the collateral that we give is appropriately haircutted and the Federal Reserve is well-protected."
                                            },
                                            {
                                                "example_id": "036b1850-99e6-4408-99ae-738e4267cd3f",
                                                "sense_id": "a8b987c3-3bc0-3512-a71b-98dbeaae1a00",
                                                "text": "Effectively a statement was made that ‘you are going to have to find the money for the banks yourselves. That meant a decision was taken that a deposit would be haircutted.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
