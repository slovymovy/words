                                        "examples": [
                                            {
                                                "example_id": "d5b55de4-1960-4c02-8684-4409ce7d14d1",
                                                "sense_id": "849bacf8-161e-3ddb-837d-e5bb6c6681ec",
                                                "text": "Fondée, du temps de César, à quelque distance de l’ancien Gadès, et déjà célèbre au moyen-âge, Cadiz atteignit le plus haut degré de splendeur, et mérita le beau titre de reine des mers."
                                            }
                                        ]
                                    }
                                ]
                            }
