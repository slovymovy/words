                "senses": [
                    {
                        "sense_id": "2c1446ae-43d9-3f3b-a59c-c71b1d243cb1",
                        "entry_id": "f910c9d5-9a3d-3410-beb1-90fd7182fe7f",
                        "glosses": [
                            "Relatif à l’œuvre du marquis de Sade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "235e2901-dcbf-4ba3-b0d6-4f2e0cd2ab9c",
                                "sense_id": "2c1446ae-43d9-3f3b-a59c-c71b1d243cb1",
                                "text": "Un art sadien d’aujourd’hui serait, ou plutôt est, celui qui, avec âpreté, questionne la duplicité intrinsèque de ce processus de « civilisation » consistant à dé-violentiser la société en saturant l’horizon de ses sujets d’images hyperviolentes."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca35a2fe-49d0-32ee-9b27-ca160e12097f",
                        "entry_id": "f910c9d5-9a3d-3410-beb1-90fd7182fe7f",
                        "glosses": [
                            "Sadique."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f16b181c-c041-4b79-bfed-b11beff66d08",
                                "sense_id": "ca35a2fe-49d0-32ee-9b27-ca160e12097f",
                                "text": "Anthropophagie, orgies sadiennes, manipulations, meurtres et inceste. Lorsque Bill découvre ce que toute sa vie sa famille adoptive lui a caché, c’est l’horreur."
                            }
                        ]
                    }
