{
    "word_family": [
        "negering",
        "negeerbaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cdfc1e52-4831-3edc-a2fe-fd2fdaa75264",
                    "sense_definition": "Geen aandacht schenken aan iemand of iets; doen alsof iets niet bestaat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ignore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>negeert</w> haar al een aantal dagen.",
                            "target_lang_translations": {
                                "ru": "Он <w>игнорирует</w> её уже несколько дней.",
                                "en": "He has been <w>ignoring</w> her for a few days.",
                                "de": "Er <w>ignoriert</w> sie schon seit ein paar Tagen.",
                                "pl": "On <w>ignoruje</w> ją już od kilku dni."
                            }
                        },
                        {
                            "text": "Je moet de waarschuwingsborden niet zomaar <w>negeren</w>.",
                            "target_lang_translations": {
                                "ru": "Нельзя просто так <w>игнорировать</w> предупреждающие знаки.",
                                "en": "You shouldn't just <w>ignore</w> the warning signs.",
                                "de": "Man sollte die Warnschilder nicht einfach <w>ignorieren</w>.",
                                "pl": "Nie powinno się po prostu <w>ignorować</w> znaków ostrzegawczych."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een bevel negeren",
                        "iemand volkomen negeren",
                        "de regels negeren"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не обращать внимания на кого-либо или что-либо; делать вид, что чего-то не существует.",
                        "en": "To pay no attention to someone or something; to pretend that something does not exist.",
                        "de": "Jemanden oder etwas nicht beachten; so tun, als ob etwas nicht existiert.",
                        "pl": "Nie zwracać uwagi na kogoś lub na coś; udawać, że coś nie istnieje."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игнорировать",
                                "target_lang_sense_clarification": "намеренно не замечать"
                            },
                            {
                                "target_lang_word": "пренебрегать",
                                "target_lang_sense_clarification": "относиться без должного внимания"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "ignore",
                                "target_lang_sense_clarification": "to intentionally not listen or pay attention to"
                            },
                            {
                                "target_lang_word": "disregard",
                                "target_lang_sense_clarification": "to pay no attention to; treat as unworthy of regard"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ignorieren",
                                "target_lang_sense_clarification": "absichtlich nicht beachten oder übersehen"
                            },
                            {
                                "target_lang_word": "missachten",
                                "target_lang_sense_clarification": "keine Rücksicht nehmen auf, z. B. Regeln oder Zeichen"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ignorować",
                                "target_lang_sense_clarification": "świadomie nie zwracać na kogoś lub coś uwagi"
                            },
                            {
                                "target_lang_word": "lekceważyć",
                                "target_lang_sense_clarification": "nie brać pod uwagę ostrzeżeń, zasad lub osób"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1033b278-9525-32d1-81ca-abcad2209491",
                    "sense_definition": "Ontkennen; beweren dat iets niet waar is.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verdachte <w>negeerde</w> zijn betrokkenheid bij de misdaad.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый <w>отрицал</w> свою причастность к преступлению.",
                                "en": "The suspect <w>denied</w> his involvement in the crime.",
                                "de": "Der Verdächtige <w>leugnete</w> seine Beteiligung an dem Verbrechen.",
                                "pl": "Podejrzany <w>zaprzeczał</w> swojemu udziałowi w przestępstwie."
                            }
                        },
                        {
                            "text": "Hij <w>negeert</w> het feit dat hij fout zat.",
                            "target_lang_translations": {
                                "ru": "Он <w>отрицает</w> тот факт, что был неправ.",
                                "en": "He <w>denies</w> the fact that he was wrong.",
                                "de": "Er <w>bestreitet</w> die Tatsache, dass er unrecht hatte.",
                                "pl": "On <w>neguje</w> fakt, że był w błędzie."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontkennen",
                        "loochenen"
                    ],
                    "antonyms": [
                        "bekennen",
                        "toegeven"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отрицать; утверждать, что что-то не является правдой.",
                        "en": "To deny; to claim that something is not true.",
                        "de": "Leugnen; behaupten, dass etwas nicht wahr ist.",
                        "pl": "Zaprzeczać; twierdzić, że coś nie jest prawdą."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрицать",
                                "target_lang_sense_clarification": "не признавать истинность"
                            },
                            {
                                "target_lang_word": "отвергать",
                                "target_lang_sense_clarification": "не принимать, отказываться признавать"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "deny",
                                "target_lang_sense_clarification": "to state that something is not true"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "negieren",
                                "target_lang_sense_clarification": "abstreiten oder verneinen"
                            },
                            {
                                "target_lang_word": "leugnen",
                                "target_lang_sense_clarification": "die Existenz oder Wahrheit von etwas bestreiten"
                            },
                            {
                                "target_lang_word": "abstreiten",
                                "target_lang_sense_clarification": "etwas in Abrede stellen"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zaprzeczać",
                                "target_lang_sense_clarification": "twierdzić, że coś nie miało miejsca lub nie jest prawdą"
                            },
                            {
                                "target_lang_word": "negować",
                                "target_lang_sense_clarification": "podważać prawdziwość lub istnienie czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf46956c-6e02-35c5-97e5-fef300cd03bf",
                    "sense_definition": "Opzettelijk slecht behandelen, pesten of treiteren.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bully",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten <w>negerden</w> de gevangenen zonder genade.",
                            "target_lang_translations": {
                                "ru": "Солдаты безжалостно <w>издевались</w> над заключенными.",
                                "en": "The soldiers mercilessly <w>bullied</w> the prisoners.",
                                "de": "Die Soldaten <w>schikanierten</w> die Gefangenen gnadenlos.",
                                "pl": "Żołnierze bezlitośnie <w>szykanowali</w> więźniów."
                            }
                        },
                        {
                            "text": "Hij werd op school vaak <w>genegerd</w> door de oudere jongens.",
                            "target_lang_translations": {
                                "ru": "В школе его часто <w>травили</w> старшие мальчики.",
                                "en": "He was often <w>bullied</w> at school by the older boys.",
                                "de": "Er wurde in der Schule oft von den älteren Jungen <w>gemobbt</w>.",
                                "pl": "W szkole był często <w>dręczony</w> przez starszych chłopców."
                            }
                        }
                    ],
                    "synonyms": [
                        "pesten",
                        "treiteren"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Dit gebruik is verouderd."
                        },
                        {
                            "trait_type": "form",
                            "comment": "Klemtoon op de eerste lettergreep (négeren); vervoeging: negerde, genegerd."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно плохо обращаться, издеваться или дразнить.",
                        "en": "To deliberately treat badly, bully, or harass.",
                        "de": "Absichtlich schlecht behandeln, quälen oder schikanieren.",
                        "pl": "Rozmyślnie źle traktować, dręczyć lub szykanować (znaczenie przestarzałe)."
                    },
                    "translations": {
