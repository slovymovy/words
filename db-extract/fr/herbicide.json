                                "target_senses": [
                                    {
                                        "sense_id": "450a317e-ff89-33b7-8f44-e0f4dce6470b",
                                        "entry_id": "8b4018b9-f3f0-3f28-b4f3-8c435730dcc2",
                                        "glosses": [
                                            "Pflanzen abtötende Substanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dbb4455-79e2-4061-a7a3-39100c1acc93",
                                                "sense_id": "450a317e-ff89-33b7-8f44-e0f4dce6470b",
                                                "text": "„Das Aufbringen der organischen Herbizide auf den Acker erfolgt üblicherweise in Form von verdünnten Suspensionen in Wasser, die u.a. Emulgatoren zur Stabilisierung enthalten.“"
                                            }
