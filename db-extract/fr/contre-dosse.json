                        "glosses": [
                            "Dans le sciage de long d’une grume, planche obtenue juste sous la dosse, et qui comporte encore beaucoup d’aubier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2b523ef-979f-4a57-a224-dbbe8a5003c5",
                                "sense_id": "b8ac877a-0988-369f-b125-6e13cef65a5e",
                                "text": "Lorsque le diamètre de l’arbre est trop considérable, & qu’on craint que les dosses ne deviennent trop épaisses, on y fait une double levée, laquelle se nomme contre-dosse, c’est-à-dire, qu’elle est entre la dosse & le vif du bois …."
                            },
                            {
                                "example_id": "232a315e-c88e-40f9-b8c8-91c0b146cd71",
                                "sense_id": "b8ac877a-0988-369f-b125-6e13cef65a5e",
                                "text": "Les lames débitées sur dosse et contre-dosse ont tendance à se déformer et à se fissurer."
                            }
                        ]
                    }
