                "senses": [
                    {
                        "sense_id": "4860fcaa-8b4f-3c11-8d1f-fc5090f337cc",
                        "entry_id": "ffdf4107-9061-3f00-acfe-deaf8daa852b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ccdcf56-a14e-4d52-9e05-9dce15c314d3",
                                "sense_id": "4860fcaa-8b4f-3c11-8d1f-fc5090f337cc",
                                "text": "Frau Bluhme ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "164a8e73-6385-4946-bf95-ee1d0392430d",
                                "sense_id": "4860fcaa-8b4f-3c11-8d1f-fc5090f337cc",
                                "text": "Herr Bluhme wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "39267252-bdc5-4242-a25f-506c7276dc11",
                                "sense_id": "4860fcaa-8b4f-3c11-8d1f-fc5090f337cc",
                                "text": "Die Bluhmes fahren heute nach Linz."
                            },
                            {
                                "example_id": "09d1c24a-0756-48d0-b30d-344e8e9112a2",
                                "sense_id": "4860fcaa-8b4f-3c11-8d1f-fc5090f337cc",
                                "text": "Der Bluhme trägt nie die Pullover, die die Bluhme ihm strickt."
                            },
                            {
                                "example_id": "4612cf86-3eff-495a-9120-497f52824880",
                                "sense_id": "4860fcaa-8b4f-3c11-8d1f-fc5090f337cc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bluhme kommt, geht der Herr Bluhme.“"
                            },
                            {
                                "example_id": "a96e27da-0259-487c-83aa-49eba507a48e",
                                "sense_id": "4860fcaa-8b4f-3c11-8d1f-fc5090f337cc",
                                "text": "Bluhme kommt und geht."
                            },
                            {
                                "example_id": "b853145f-14cb-4ddc-98cd-98a2b4f76cad",
                                "sense_id": "4860fcaa-8b4f-3c11-8d1f-fc5090f337cc",
                                "text": "Bluhmes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
