                ],
                "senses": [
                    {
                        "sense_id": "9b0fe889-5ad1-3488-96e2-b61f2866164c",
                        "entry_id": "599c865a-4cf6-3d54-88eb-dc4fb476e49b",
                        "glosses": [
                            "Faire baisser la température d'un liquide en-dessous de sa température de solidification tout en le gardant à l'état liquide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53ba7ac5-28de-44e9-82b0-39f6ac2e9ff9",
                                "sense_id": "9b0fe889-5ad1-3488-96e2-b61f2866164c",
                                "text": "Les tubes à chute libre sont des instruments permettant de surfondre puis de solidifier rapidement des matériaux sous forme de gouttes."
                            },
                            {
                                "example_id": "5b6a63ed-887e-4120-aa16-0382e3b63e3a",
                                "sense_id": "9b0fe889-5ad1-3488-96e2-b61f2866164c",
                                "text": "Il est donc possible de surfondre l’eau et entrer dans un domaine de température considéré comme un « no-man’s land » pour l’eau en volume, entre 235 K et 150 K."
                            },
                            {
                                "example_id": "3fffa755-6781-431a-b65c-46f6749465ef",
                                "sense_id": "9b0fe889-5ad1-3488-96e2-b61f2866164c",
                                "text": "La substance peut se surfondre sans cristallisation."
                            }
                        ]
                    }
