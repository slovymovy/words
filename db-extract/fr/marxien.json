                                        "entry_id": "30335c67-2e97-35e7-a1ad-555dc9d16fee",
                                        "glosses": [
                                            "Of, pertaining to, or influenced by the 19th-century philosopher Karl Marx and his political and economic theories; now often distinguished from Marxist by the nuance that one does not necessarily adhere to Marxism itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d24f1397-c438-45be-a025-ea552de84f0f",
                                                "sense_id": "e5938147-d1f8-3042-9c30-f75b89a75fc9",
                                                "text": "But to use game theory in a Marxian setting requires more that simply adopting the tools and methods of non-cooperative game theory, root and branch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "847b4286-b0b2-313b-9896-537ceee66821",
                                        "entry_id": "30335c67-2e97-35e7-a1ad-555dc9d16fee",
                                        "glosses": [
                                            "Of, relating to, or characteristic of the Marx Brothers or their films."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
