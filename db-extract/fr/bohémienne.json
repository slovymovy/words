                    },
                    {
                        "sense_id": "efa20780-7045-3f73-9c31-22ea78743d32",
                        "entry_id": "1c44ec96-715b-3d75-8887-72381517c5e6",
                        "glosses": [
                            "Tsigane, Rom."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ac613c52-955f-4596-af8b-ce39336614f7",
                                "sense_id": "efa20780-7045-3f73-9c31-22ea78743d32",
                                "text": "Ses cheveux noirs et brillants retombaient en boucles épaisses sur ses épaules. Son teint était mat, comme celui d’une Bohémienne, et son regard sombre crachait des flammes. Gabriel était hypnotisé par la manière qu’elle avait de tournoyer sur elle-même en se tenant les hanches, et de se rapprocher au plus près de son partenaire, lui frôlant le visage avec un air aguicheur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
