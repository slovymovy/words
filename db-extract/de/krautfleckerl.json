                "senses": [
                    {
                        "sense_id": "d18953cb-cc84-34f8-86af-f8cba2b7acd3",
                        "entry_id": "70132be1-fae5-3478-8548-b8a96abfdda5",
                        "glosses": [
                            "hauptsächlich aus gekochten Fleckerln und Weißkraut zubereitete Speise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef3bec51-a486-43f9-9cd1-f6ce3d1e88b1",
                                "sense_id": "d18953cb-cc84-34f8-86af-f8cba2b7acd3",
                                "text": "Die Krautfleckerl stammen ursprünglich – wie so vieles in der Wiener Küche – aus dem Böhmischen."
                            },
                            {
                                "example_id": "fe4686b2-bf05-4317-8569-a388c7d4bb1c",
                                "sense_id": "d18953cb-cc84-34f8-86af-f8cba2b7acd3",
                                "text": "Isst du Krautfleckerl gesüßt zum Mittagessen?"
                            },
                            {
                                "example_id": "b170a345-478a-4692-a444-a0fca4439df0",
                                "sense_id": "d18953cb-cc84-34f8-86af-f8cba2b7acd3",
                                "text": "Das Krautfleckerl könne jedoch zu einer Lungenentzündung führen, „das kommt gar nicht so selten vor, besonders bei älteren Menschen“, sagte der Mediziner."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
