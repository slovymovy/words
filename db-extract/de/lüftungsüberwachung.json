                "senses": [
                    {
                        "sense_id": "2492f3c4-b7bf-3c7e-ba86-20c7ecd3fecd",
                        "entry_id": "a5975306-9e03-315c-86ea-0cd2a0000bcf",
                        "glosses": [
                            "permanente Kontrolle des Luftstroms in einer Lüftungsanlage; auch die Apparatur, die die sicherstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf107469-4fd9-47dd-91f6-9db8c88b6e1b",
                                "sense_id": "2492f3c4-b7bf-3c7e-ba86-20c7ecd3fecd",
                                "text": "Die Kontrolle der Lüftungsfunktion erfolgt zum Beispiel über dynamische Messeinrichtung (Volumenstromregler) oder statische Messelemente (Differenzdruckwächter) und stellen so eine Lüftungsüberwachung dar."
                            },
                            {
                                "example_id": "67f1ee76-ef2f-463b-b65d-4c2100e4ac0b",
                                "sense_id": "2492f3c4-b7bf-3c7e-ba86-20c7ecd3fecd",
                                "text": "„Um die Gefährdung durch die entstehenden Ex-Zonen, einen sicheren Betrieb zu gewährleisten muss mindestens eine ATEX-konforme Lüftungsüberwachung angeschlossen sein.“"
                            },
                            {
                                "example_id": "21a78c3e-ca53-4825-8731-e2753b281da4",
                                "sense_id": "2492f3c4-b7bf-3c7e-ba86-20c7ecd3fecd",
                                "text": "„Mit dem Magnetkontakt-Sender EFS-ET2-Reed zur Lüftungsüberwachung bei raumluftabhängiger Feuerstätte geeignet.“"
                            },
                            {
                                "example_id": "bf233e14-b60f-4faa-9cf5-ae8cb6c5ae64",
                                "sense_id": "2492f3c4-b7bf-3c7e-ba86-20c7ecd3fecd",
                                "text": "„Bei Verwendung einer Belüftung muss dieser Eingang von der Lüftungsüberwachung aktiviert werden, wenn die Belüftung ordnungsgemäß läuft.“"
                            },
                            {
                                "example_id": "37fdcdb2-f33e-49d2-acbe-c8ad5a22e6b8",
                                "sense_id": "2492f3c4-b7bf-3c7e-ba86-20c7ecd3fecd",
                                "text": "„Analog dürfen also Druckgasflaschen in technisch belüfteten Schränken mit Lüftungsüberwachung unter Erdgleiche gelagert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
