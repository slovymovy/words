                        "sense_id": "9dac3331-6447-3b15-86d3-65ac0eae4c7d",
                        "entry_id": "806771ed-ed3d-3911-835b-ba0d222d4c12",
                        "glosses": [
                            "biszkopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "592602ca-4d42-4d52-b2e6-77623b1e235f",
                                "sense_id": "9dac3331-6447-3b15-86d3-65ac0eae4c7d",
                                "text": "Моя́ ма́ма испечёт са́мый вку́сный бискви́т! Вот уви́дишь!",
                                "translation": "Moja mama upiecze najsmaczniejszy biszkopt! Otóż zobaczysz!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a2168a60-8e3e-3206-abc1-ad3d11b62737",
                        "entry_id": "806771ed-ed3d-3911-835b-ba0d222d4c12",
                        "glosses": [
                            "biskwit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8898ec2d-e784-4712-8e3c-5263dcb5d060",
                                "sense_id": "a2168a60-8e3e-3206-abc1-ad3d11b62737",
                                "text": "Я был вче́ра на вы́ставке, пока́зывали там ра́зные бискви́ты времён XIX ве́ка.",
                                "translation": "Wczoraj byłem na wystawie, pokazywali tam różne biskwity czasów XIX wieku."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
