                "senses": [
                    {
                        "sense_id": "6bed945e-3cb4-373d-a853-864b38c867c8",
                        "entry_id": "82122d76-05f8-32e3-8deb-026dd6a03d4f",
                        "glosses": [
                            "dünne Bekleidung für den Oberkörper mit kurzen Ärmeln ohne Knöpfe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8923f3e-5a20-415a-9f7e-ff77de7c97be",
                                "sense_id": "6bed945e-3cb4-373d-a853-864b38c867c8",
                                "text": "Er trug Boxershorts und ein T-Shirt."
                            },
                            {
                                "example_id": "9461a382-5240-45ef-b0f4-4044b42ce3a1",
                                "sense_id": "6bed945e-3cb4-373d-a853-864b38c867c8",
                                "text": "„In seinem T-Shirt sieht er aus wie ein Student, die nächste Hochschule ist nicht weit.“"
                            },
                            {
                                "example_id": "ba50fe85-a970-4477-b8c1-8361cb0c2541",
                                "sense_id": "6bed945e-3cb4-373d-a853-864b38c867c8",
                                "text": "„In den 1950er Jahren trug man zur Nietenhose ein Hemdchen, das wegen seiner an den Buchstaben T erinnernden Form T-Shirt genannt wurde.“"
                            },
                            {
                                "example_id": "a585bd7c-5c0a-41b7-b3a1-88e0793288e1",
                                "sense_id": "6bed945e-3cb4-373d-a853-864b38c867c8",
                                "text": "„Als sie auf den Beifahrersitz klettert, kleben drei Augenpaare an ihrem T-Shirt.“"
                            },
                            {
                                "example_id": "cf621761-e4b7-4e82-85cd-16c9298e2e4c",
                                "sense_id": "6bed945e-3cb4-373d-a853-864b38c867c8",
                                "text": "„Über ihren rundlichen Bäuchen spannen sich verwaschene T-Shirts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
