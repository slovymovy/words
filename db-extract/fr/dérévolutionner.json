                        "glosses": [
                            "Faire perdre le caractère révolutionnaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74508578-c022-4816-81ff-41a69218add5",
                                "sense_id": "cc36e313-e1af-3f15-9ba3-7b8cf7e5b44d",
                                "text": "Châles, conventionnel qui tend vers les idées du Club électoral, et qui se signalera par son opposition à la réaction, regrette, deux mois après la chute de Robespierre, cette concentration de « l’action révolutionnaire », qui avait entraîné le gouvernement à « dérévolutionner » individus et sociétés."
                            },
                            {
                                "example_id": "34583547-b619-4620-9e8e-95846c196c46",
                                "sense_id": "cc36e313-e1af-3f15-9ba3-7b8cf7e5b44d",
                                "text": "C’est pour ainsi dire une révolution dérévolutionnée et surtout déguillotinée."
                            },
                            {
                                "example_id": "82e1e340-797a-491d-a0b9-fa43a31bc65a",
                                "sense_id": "cc36e313-e1af-3f15-9ba3-7b8cf7e5b44d",
                                "text": "Cela lui semblera singulier, il faut qu’il achève de se dérévolutionner lui-même."
                            }
                        ]
                    }
