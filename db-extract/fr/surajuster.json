                ],
                "senses": [
                    {
                        "sense_id": "33dc4fca-48dd-3485-a059-93c0cc05d4ee",
                        "entry_id": "e0619ae5-c13e-3ba8-9c1c-9346f78a7b5a",
                        "glosses": [
                            "Utiliser un modèle statistique qui a trop de paramètres par rapport à la taille de l’échantillon ce qui conduit à un très bon ajustement sur les données de l’échantillon mais à un mauvais ajustement avec de nouvelles données."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bbe45d1-8efd-405d-99df-63b1b18004e7",
                                "sense_id": "33dc4fca-48dd-3485-a059-93c0cc05d4ee",
                                "text": "Comme nous l’avons vu aux chapitres 1 et 2, un bon moyen de réduire le surajustement consiste à régulariser le modèle (c’est-à-dire lui imposer des contraintes) : moins il a de degrés de liberté, plus il lui est difficile de surajuster les données."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6627638-0d23-4365-a64c-4688bd78951b",
                        "source_entry_id": "e0619ae5-c13e-3ba8-9c1c-9346f78a7b5a",
                        "source_sense_id": "33dc4fca-48dd-3485-a059-93c0cc05d4ee",
                        "target_lang_word": "overfit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overfit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c61d4c21-583b-3fc7-bb61-76542ac6088f",
                                        "entry_id": "13121fb4-c013-3594-8da6-ada0b2630522",
                                        "glosses": [
                                            "To use a statistical model that has too many parameters relative to the size of the sample, leading to a good fit with the sample data but a poor fit with new data."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c6676f-9ae0-41cb-8303-0fea9576d052",
                                                "sense_id": "c61d4c21-583b-3fc7-bb61-76542ac6088f",
                                                "text": "In all modeling techniques, and neural networks in particular, care must be taken not to overtrain or overfit the model. If possible, models should be interpreted in terms of their mechanistic meaning."
                                            },
                                            {
                                                "example_id": "fe0bf75c-866e-44ce-8052-2010e2901829",
                                                "sense_id": "c61d4c21-583b-3fc7-bb61-76542ac6088f",
                                                "text": "If your strategy is to always fit and use the global model, you will probably overfit the model (i.e., include unnecessary variables)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
