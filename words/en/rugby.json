        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "503a1dd2-b850-354e-a823-bed0a14a9b37",
                    "sense_definition": "A form of football played with an oval ball which players can kick, carry, and pass from hand to hand, but not throw forwards.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started playing <w>rugby</w> when he was in high school.",
                            "target_lang_translations": {
                                "ru": "Он начал играть в <w>регби</w>, когда учился в старшей школе.",
                                "zh": "他上高中的时候就开始打<w>橄榄球</w>了。"
                            }
                        },
                        {
                            "text": "We are going to watch the <w>rugby</w> match on Saturday.",
                            "target_lang_translations": {
                                "ru": "Мы собираемся посмотреть матч по <w>регби</w> в субботу.",
                                "zh": "我们周六要去观看一场<w>橄榄球</w>比赛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rugger"
                    ],
                    "common_phrases": [
                        "play rugby",
                        "rugby match",
                        "rugby team",
                        "rugby ball",
                        "rugby union"
                    ],
                    "target_lang_definitions": {
                        "ru": "Командная игра с овальным мячом, в которой игроки могут пинать мяч, нести его и передавать из рук в руки, но не бросать вперед.",
                        "zh": "一种使用椭圆形球进行的足球运动，球员可以用脚踢、手持或手递手传球，但不能向前投掷。"
                    },
                    "translations": {
                        "ru": [
                            {
