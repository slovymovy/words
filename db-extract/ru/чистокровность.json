                        "cross_references": [
                            {
                                "target_word": "thoroughbredness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3b90757-d60b-326b-a3e3-19118a2737c2",
                                        "entry_id": "27816fb7-2665-3e42-8b64-c67a8ab2ccd4",
                                        "glosses": [
                                            "The quality of being thoroughbred."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85974184-cf0a-4983-a2c0-2be4a619d99b",
                                                "sense_id": "d3b90757-d60b-326b-a3e3-19118a2737c2",
                                                "text": "It is a call to put on power, to live constructively, to measure up to our inherent thoroughbredness."
                                            },
                                            {
                                                "example_id": "d864d8db-c3fc-4314-997e-0272e840b51c",
                                                "sense_id": "d3b90757-d60b-326b-a3e3-19118a2737c2",
                                                "text": "In the second place, a standard of quality is necessary, because we all enjoy at times music which lacks thoroughbredness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
