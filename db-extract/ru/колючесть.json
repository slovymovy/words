                ],
                "senses": [
                    {
                        "sense_id": "87206e0e-577c-3b52-b05d-2576bae302c6",
                        "entry_id": "3c673f5f-714f-36c3-9039-ca94e4789d51",
                        "glosses": [
                            "наличие колючек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2b79eb7-1526-4a26-8f94-328697847dfd",
                                "sense_id": "87206e0e-577c-3b52-b05d-2576bae302c6",
                                "text": "Коэффициент относительной колючести характеризует степень колючести растения."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbb0361f-3680-3dbc-8d1e-fa3713a77d87",
                        "entry_id": "3c673f5f-714f-36c3-9039-ca94e4789d51",
                        "glosses": [
                            "способность укалывать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c02f7f5c-8dfe-4874-805c-65763a922014",
                                "sense_id": "fbb0361f-3680-3dbc-8d1e-fa3713a77d87",
                                "text": "Посаженное на шёлковую подкладку, твидовое изделие убережёт неженок, которые жалуются на колючесть шерстяных тканей."
                            }
                        ]
                    },
                    {
                        "sense_id": "20964a52-3c8c-3aa3-851e-4f9ed138af8e",
                        "entry_id": "3c673f5f-714f-36c3-9039-ca94e4789d51",
                        "glosses": [
                            "перен. язвительность, саркастичность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "968be700-04d9-490f-96a6-7af3182b3f97",
                                "sense_id": "20964a52-3c8c-3aa3-851e-4f9ed138af8e",
                                "text": "Актер не затушёвывал колючесть характера своего героя: его Суворов озорничал со вкусом, дурачился, разыгрывая придворных, был насмешлив и обидчив."
                            }
                        ]
                    }
                ],
