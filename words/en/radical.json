                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The linguist analyzed the <w>radical</w> elements shared by different Indo-European languages.",
                            "target_lang_translations": {
