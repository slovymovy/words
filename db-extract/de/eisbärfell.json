                "senses": [
                    {
                        "sense_id": "7f1d06cc-abe0-3d82-8a78-121bed64c46e",
                        "entry_id": "76f49b0d-ec9a-3348-93f4-028ba48c0462",
                        "glosses": [
                            "(abgezogenes) Fell eines Eisbären"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9976aa9-f415-4c2e-b6cc-5b38df1c718f",
                                "sense_id": "7f1d06cc-abe0-3d82-8a78-121bed64c46e",
                                "text": "„Theodor liegt auf dem warmen, weichen Eisbärfell, und neben ihm atmet schwer und laut der Prinz Heinrich. Der Prinz beißt in Theodors Fleisch.“"
                            },
                            {
                                "example_id": "b7c22d2b-c080-4988-a746-540921d7b64f",
                                "sense_id": "7f1d06cc-abe0-3d82-8a78-121bed64c46e",
                                "text": "„›Seht nur, wie er Madame anschmachtet, unser Blümchen-rühr-mich-nicht-an‹, brüllte Hildebrand, der sich von der Loreley die Haare des Eisbärfells von der Uniformjacke zupfen ließ.“"
                            },
                            {
                                "example_id": "2ee851c3-e4a3-477d-9d3a-21bb5f6f6f91",
                                "sense_id": "7f1d06cc-abe0-3d82-8a78-121bed64c46e",
                                "text": "„Oben am Pol wohnten Eskimos, sie trügen Eisbärfelle und wohnten in Schneehäusern, und in Afrika liefen die Neger beinah nackt herum.“"
                            },
                            {
                                "example_id": "2f8d4d26-bd63-46ba-8513-cad29ef03c66",
                                "sense_id": "7f1d06cc-abe0-3d82-8a78-121bed64c46e",
                                "text": "„Ihre Behausung glich einem Fell-Lager; bis zum Hüttendach hinauf lagen die Felle aufgestapelt. Neben zahllosen aufgehängten Polar- und Blaufuchspelzen sahen wir Ballen von Eisbärfellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
