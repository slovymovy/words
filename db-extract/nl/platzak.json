                                                "sense_id": "6e0ede8a-4f1d-35fb-b0e2-a5a0bb5375dc",
                                                "text": "Agents broking with various other carriers can offer additional options."
                                            },
                                            {
                                                "example_id": "1f7ce87b-7bcf-4f65-87eb-e1235691681b",
                                                "sense_id": "6e0ede8a-4f1d-35fb-b0e2-a5a0bb5375dc",
