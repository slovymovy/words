                                "target_senses": [
                                    {
                                        "sense_id": "8b9c9cc2-0568-3111-b711-6de3cd68c3dc",
                                        "entry_id": "e6342679-6863-34fe-82cf-c45450e1808b",
                                        "glosses": [
                                            "An instrument used for viewing pairs of stereoscopic photographs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5828f36-d35b-4c94-8801-911d21e4d83b",
                                                "sense_id": "8b9c9cc2-0568-3111-b711-6de3cd68c3dc",
                                                "text": "The idea has been repeated under different aspects; sometimes, possibly, it has been repeated too often; but different aspects in such a case do help, as in a stereoscope, to give solidity to the thing seen."
                                            }
                                        ]
