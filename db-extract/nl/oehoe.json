                                            {
                                                "example_id": "7b7fd0e9-7895-4a36-a727-5a35d6f9f320",
                                                "sense_id": "8744c524-178c-324b-977b-c634fa62d689",
                                                "text": "The diet of the Eurasian Eagle-Owl (Bubo bubo) was assessed by collecting pellets and prey remains near the nesting cliffs of 21 pairs in the central-eastern Italian Alps between 1993-97"
                                            }
                                        ]
