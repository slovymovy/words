                                    {
                                        "sense_id": "106f9b5c-ee5d-340e-be09-18c4e944ea57",
                                        "entry_id": "b44c281b-28fe-3186-968d-46183a02c522",
                                        "glosses": [
                                            "A brilliant red colour sometimes tinged with orange."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aef1ac6d-cbf1-4c7d-863d-cfc1b3e6882c",
                                                "sense_id": "106f9b5c-ee5d-340e-be09-18c4e944ea57",
                                                "text": "Biblical criteria of sexual seductiveness include a white skin, black hair, or henna-dyed, scarlet lips, a prominent nose, rosy temples, long straight neck, firm breasts, round thighs, an erect posture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e64e14c-60b8-31e9-8763-2a76547aa1de",
                                        "entry_id": "b44c281b-28fe-3186-968d-46183a02c522",
                                        "glosses": [
                                            "Cloth of a scarlet color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e2b5e00-1586-4453-874f-87516e5a86d5",
                                                "sense_id": "0e64e14c-60b8-31e9-8763-2a76547aa1de",
                                                "text": "All her household are clothed with scarlet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scarlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6783eac1-a006-3b7b-8c96-9851e53f0249",
                                        "entry_id": "a0ce2903-6a90-3d35-8ca8-e55553f3ba12",
                                        "glosses": [
                                            "Of a bright red colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dc4d354-ab2a-4d8b-84a8-e34a3e3cf1e4",
                                                "sense_id": "6783eac1-a006-3b7b-8c96-9851e53f0249",
                                                "text": "Breezes blowing from beds of iris quickened her breath with their perfume; she saw the tufted lilacs sway in the wind, and the streamers of mauve-tinted wistaria swinging, all a-glisten with golden bees; she saw a crimson cardinal winging through the foliage, and amorous tanagers flashing like scarlet flames athwart the pines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02ce1dcb-5968-3a74-9d8e-1a864848627d",
                                        "entry_id": "a0ce2903-6a90-3d35-8ca8-e55553f3ba12",
                                        "glosses": [
                                            "Sinful or whorish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b92c0eb-ce01-4012-917d-8aa413f2f18a",
                                                "sense_id": "02ce1dcb-5968-3a74-9d8e-1a864848627d",
                                                "text": "a scarlet woman"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6652866-5661-319e-a8b6-1ceb604508b1",
                                        "entry_id": "a0ce2903-6a90-3d35-8ca8-e55553f3ba12",
                                        "glosses": [
                                            "Blushing; embarrassed or mortified."
                                        ],
                                        "tags": [
                                            "Ireland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3f38a2f-f4c4-43e9-8ee9-abc7db1ccdee",
                                                "sense_id": "f6652866-5661-319e-a8b6-1ceb604508b1",
                                                "text": "He signed off our correspondence, “Well thank God for facemasks, cos I’m scarlet”."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scarlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af373bc2-a8ec-3ed2-a118-ae55bdae0e0b",
                                        "entry_id": "a34cfd53-3455-3903-a500-c3e991ee00df",
                                        "glosses": [
                                            "To dye or tinge (something) with scarlet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "857cb07a-8da3-45e0-b333-02931f49c180",
                                                "sense_id": "af373bc2-a8ec-3ed2-a118-ae55bdae0e0b",
                                                "text": "Forbeare; the aſhy paleneſſe of my cheeke / Is ſcarletted in ruddy flakes of vvrath: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c4470d9-74ae-47e9-82ea-e27e8f06a739",
                        "source_entry_id": "7ab28a8a-c5f7-3e0b-a017-df25ce31bed8",
                        "source_sense_id": "a85517db-c69a-3e94-a6fc-a56b330d7495",
                        "target_lang_word": "écarlate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écarlate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0736f98-831a-3073-be1c-b85601cbdcb9",
                                        "entry_id": "5d99d6c7-b6a2-3a92-b6be-316ae8cd0069",
                                        "glosses": [
                                            "Colorant de couleur rouge vif, tiré du kermès, l'insecte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eff2887-4145-4faf-8edc-19d03ee2ff3e",
                                                "sense_id": "b0736f98-831a-3073-be1c-b85601cbdcb9",
                                                "text": "Je vis un jour plusieurs magistrats nommés lexiarques, qui marchoient dans les rues, tenant une corde teinte d’écarlate, tendue d’une maison à l’autre. Ils poussaient le peuple devant eux, pour l’obliger de se rendre à l’assemblée. Si la corde marquoit de rouge quelque traîneur, il étoit condamné à l’amende."
                                            },
                                            {
                                                "example_id": "31dcd7eb-558b-418c-afd2-ecbf7af9c41e",
                                                "sense_id": "b0736f98-831a-3073-be1c-b85601cbdcb9",
                                                "text": "À Arles, l’archevêque, qui avait le monopole de l’exploitation de la graine d’écarlate, avec laquelle on fabriquait la teinture rouge, ne traitait, pour la vente de ses récoltes, qu’avec les juifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0268494b-3822-3c45-96bd-f86ba0d1e317",
                                        "entry_id": "5d99d6c7-b6a2-3a92-b6be-316ae8cd0069",
                                        "glosses": [
                                            "Étoffe de cette couleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f16ca79c-530a-426d-8d9c-61aabe22b9f8",
                                                "sense_id": "0268494b-3822-3c45-96bd-f86ba0d1e317",
                                                "text": "Manteau d’écarlate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f27f311b-a23f-3023-81f6-8ada2cf6fe67",
                                        "entry_id": "5d99d6c7-b6a2-3a92-b6be-316ae8cd0069",
                                        "glosses": [
                                            "Couleur correspondante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de0bf6e7-78fd-489d-844a-a969ea4b90ae",
                                                "sense_id": "f27f311b-a23f-3023-81f6-8ada2cf6fe67",
                                                "text": "Le rousset doré. Ch. D’abord d’un beau jonquille mêlé de pourpre; ensuite brouillé d’un rouge indécis entre le pourpre et l’écarlate et d’un jaune jonquille plus ou moins foncé; […]."
                                            },
                                            {
                                                "example_id": "e17d5fba-947b-4db2-a31d-24eb6e1b2720",
                                                "sense_id": "f27f311b-a23f-3023-81f6-8ada2cf6fe67",
                                                "text": "Écarlate ! Quel beau mot ! Il éclabousse les lèvres et les dents."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "écarlate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23507b86-ad6f-3f81-a690-688014264a35",
                                        "entry_id": "6a9b5244-b114-3799-800d-df32edd333a8",
                                        "glosses": [
                                            "De la couleur du colorant du même nom, rouge vif. #ED0000"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd5cbdf1-7e75-4418-bd73-40f568ebc4ea",
                                                "sense_id": "23507b86-ad6f-3f81-a690-688014264a35",
                                                "text": "Quatorze colonnes de bois, hautes de vingt-trois pieds, tendaient au-dessus de la salle un ciel d’étoffe écarlate."
                                            },
                                            {
                                                "example_id": "47827383-6389-4ce3-a99b-48903e39368b",
                                                "sense_id": "23507b86-ad6f-3f81-a690-688014264a35",
                                                "text": "On patinait autour de lui. Des enfants, le col entouré de cache-nez écarlates, blancs, verts, bleus, glissaient et tournoyaient."
                                            },
                                            {
                                                "example_id": "8d36cb6e-38cf-4e3f-b072-cf80c46668e2",
                                                "sense_id": "23507b86-ad6f-3f81-a690-688014264a35",
                                                "text": "Un soir, à l’insu du brigadier, sa fille est entrée chez l’instituteur, le sourire aux yeux, les lèvres plus rouges que ces tablettes de sucre écarlate — des coquelicots — qu’on suce contre les enrouements; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "328fea89-4ae4-3e28-aaf7-f97ac952f339",
                                        "entry_id": "6a9b5244-b114-3799-800d-df32edd333a8",
                                        "glosses": [
                                            "Qui rougit par timidité ou par honte."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb802e18-b521-4a79-ba32-9d93c78ad5c1",
                                                "sense_id": "328fea89-4ae4-3e28-aaf7-f97ac952f339",
                                                "text": "Elle en devint tout écarlate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
