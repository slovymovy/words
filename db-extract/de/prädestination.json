                                    {
                                        "sense_id": "92e1d0a0-3fb1-3d63-8e83-5d40d0b4e403",
                                        "entry_id": "be9112d0-6364-31ae-81b8-0f44ed114223",
                                        "glosses": [
                                            "ato ou efeito de predestinar, de determinar o destino (de alguém)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
