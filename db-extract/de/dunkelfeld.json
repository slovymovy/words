                ],
                "senses": [
                    {
                        "sense_id": "dbf4f4fc-4c21-36e3-902c-59b989f337f5",
                        "entry_id": "bc45641e-3091-35cf-9f0e-e0b3e9c4f6f6",
                        "glosses": [
                            "Teil der begangenen strafbaren Handlungen, die nicht offiziell erfasst werden"
                        ],
                        "tags": [
                            "Statistik",
                            "Kriminologie",
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f0dd720e-82ac-4440-9bb7-2cb50fa689d1",
                                "sense_id": "dbf4f4fc-4c21-36e3-902c-59b989f337f5",
                                "text": "„Die Polizeiliche Kriminalstatistik (PKS) zählt alle bundesweit von der Polizei bearbeiteten Straftaten, deckt also nicht das Dunkelfeld ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c0f184a2-a3f1-383a-992d-5d0b1fc7cfa6",
                        "entry_id": "bc45641e-3091-35cf-9f0e-e0b3e9c4f6f6",
                        "glosses": [
                            "Betrachtung von Präparaten lediglich im gestreuten und gebeugten Licht"
                        ],
                        "tags": [
                            "Mikroskopie"
                        ],
                        "examples": [
                            {
                                "example_id": "477aee9a-8d57-474a-9b86-b271e78f1b2d",
                                "sense_id": "c0f184a2-a3f1-383a-992d-5d0b1fc7cfa6",
                                "text": "„Ohne Präparat oder andere lichtstreuende Strukturen im Strahlengang bleibt bei korrekt eingestelltem Dunkelfeld das Okularbild vollständig dunkel, da das direkte Licht durch eine zentrale Abblendung im Kondensor geblockt wird.“"
                            },
                            {
                                "example_id": "c8c57b6f-78b0-42a1-b4c5-9c9b858a34e4",
                                "sense_id": "c0f184a2-a3f1-383a-992d-5d0b1fc7cfa6",
                                "text": "„Zur Beobachtung im Dunkelfeld braucht man einen Paraboloidkondensor (oder den Wechselkondensor für Hell- und Dunkelfeld) sowie eine starke künstliche Lichtquelle, am besten eine kleine Bogenlampe, die aus etwa 15 cm Entfernung das Licht durch eine Sammellinse auf die Planseite des Spiegels wirft.“"
                            },
                            {
                                "example_id": "da1b1f7a-eb28-44bb-a939-fa8b89070831",
                                "sense_id": "c0f184a2-a3f1-383a-992d-5d0b1fc7cfa6",
                                "text": "„Dieses Phänomen muß auch im Dunkelfeld zur Erscheinung kommen; dabei erscheint aber nicht eine diffuse Trübung, sondern durch die Vergrößerung kann jedes Beugungsscheibchen für sich wahrgenommen werden.“"
                            },
                            {
                                "example_id": "eca3d206-577d-41b2-a286-ebe937440725",
                                "sense_id": "c0f184a2-a3f1-383a-992d-5d0b1fc7cfa6",
                                "text": "„Auch mit Hilfe des einfach auffallenden Lichtes können wir eine Art Dunkelfeld erzeugen, das zwar nicht streng, aber doch angenähert den dafür aufgestellten Postulaten entspricht.“"
                            },
                            {
                                "example_id": "32515dd9-28dc-4312-8c56-3b48851b8d63",
                                "sense_id": "c0f184a2-a3f1-383a-992d-5d0b1fc7cfa6",
                                "text": "„Die schon bei Hellfeldbeleuchtung erkennbaren Verunreinigungen (Partikel und Kratzer) zeigen im Dunkelfeld jedoch einen so starken Kontrast, dass sie im Bild nur noch als helle, überstrahlte Flecken abgebildet werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
