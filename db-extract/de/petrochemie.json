                ],
                "senses": [
                    {
                        "sense_id": "3e6d35ed-60d0-3682-8684-efa510b079dd",
                        "entry_id": "07eb5be0-2ee4-3fe8-a547-e33b828bbd74",
                        "glosses": [
                            "der sich mit der Verarbeitung von Erdöl und Erdgas befassende Zweig der Chemie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa60ad2-5391-4288-8933-53cf74eda682",
                                "sense_id": "3e6d35ed-60d0-3682-8684-efa510b079dd",
                                "text": "Da petrochemische Produkte den Endverbraucher jedoch nicht erreichen, sondern zuerst an andere Industrien verkauft werden und erst nach unzähligen Veränderungen und Umwandlungen in Produkten verarbeitet werden, die keinerlei Beziehung mehr zu den Ausgangsstoffen zu haben scheinen, ist die Bedeutung der Petrochemie dem Mann auf der Straße kaum bekannt."
                            },
                            {
                                "example_id": "e5049122-fe88-4c2a-b18c-23407fd8c3b6",
                                "sense_id": "3e6d35ed-60d0-3682-8684-efa510b079dd",
                                "text": "„Überdies setzte Bhutto die Verstaatlichung von Großbetrieben in den wichtigsten Industriesektoren (Stahl, Petrochemie, Elektromaterial) um.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "554d46d0-ca8a-3434-a566-e313227dcf57",
                        "entry_id": "07eb5be0-2ee4-3fe8-a547-e33b828bbd74",
                        "glosses": [
                            "die Wissenschaft rund um die chemische Zusammensetzung von Gestein"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "20648d80-fc82-4b51-80f0-665ac9e55eb4",
                                "sense_id": "554d46d0-ca8a-3434-a566-e313227dcf57",
                                "text": "Heute gibt es in Hamburg keinen Lehrstuhl für Petrochemie mehr."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
