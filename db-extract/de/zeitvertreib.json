                        "form": "dem Zeitvertreibe"
                    },
                    {
                        "form_id": "a922ea5b-100b-41d8-a775-acd8d5578c01",
                        "entry_id": "be2330b3-3529-3dd5-a73f-05dd07e3331b",
                        "tags": [
                            "dative",
