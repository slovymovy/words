                },
                {
                    "sense_id": "fb2fbb1c-5dce-3238-90c2-0ac9a20f6979",
                    "sense_definition": "A minor river in Berkshire, England, which flows into the Thames.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rivers",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The River <w>Pang</w> is known for its clear chalk stream waters and diverse local wildlife.",
                            "target_lang_translations": {
                                "ru": "Река <w>Панг</w> известна своими чистыми меловыми водами и разнообразной местной фауной.",
                                "cs": "Řeka <w>Pang</w> je známá svou čistou křídovou vodou a rozmanitou místní faunou."
                            }
                        },
                        {
                            "text": "We spent the afternoon walking along the banks of the <w>Pang</w> near the village of Pangbourne.",
                            "target_lang_translations": {
                                "ru": "Мы провели вторую половину дня, гуляя по берегам <w>Панга</w> недалеко от деревни Пангборн.",
                                "cs": "Odpoledne jsme strávili procházkou podél břehů řeky <w>Pang</w> poblíž vesnice Pangbourne."
                            }
                        }
