                        "examples": [
                            {
                                "example_id": "3a3620da-d473-43c1-8b30-e3435bcddae9",
                                "sense_id": "cc46d861-045a-3aba-8ecd-b50ffdf73e1c",
                                "text": "Na een lange juridische strijd is hij aan de VS uitgeleverd. Rusland verzette zich tegen de uitlevering van Bout. Volgens Moskou is de voormalige luchtmachtofficier een onschuldige zakenman. Ook de 44-jarige Bout zelf houdt vol nooit wapens te hebben verkocht. Hij beweert slechts een verhuurder van de vliegtuigen te zijn."
                            },
                            {
                                "example_id": "ed48d142-c3f5-41b6-abc7-084f98b9234b",
                                "sense_id": "cc46d861-045a-3aba-8ecd-b50ffdf73e1c",
                                "text": "Bout is een voormalige luchtmachtofficier van het Rode Leger. In maart 2008 werd hij gearresteerd in Thailand. Daar had hij een wapendeal gesloten met Amerikaanse agenten die zich uitgaven voor strijders van de FARC in Colombia. Bout zou hebben gezegd dat hij honderden raketten, duizenden machinegeweren en miljoenen kogels kon leveren."
                            }
                        ]
                    }
