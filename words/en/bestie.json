{
    "word_family": [
        "best"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c2f7b56e-cb50-39f9-89fa-2a24f481f002",
                    "sense_definition": "A person's best friend.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went to the movies with her <w>bestie</w> to celebrate her birthday.",
                            "target_lang_translations": {
                                "zh": "她和她的<w>闺蜜</w>去看电影庆祝生日。"
                            }
                        },
                        {
                            "text": "I called my <w>bestie</w> as soon as I heard the exciting news about the job offer.",
                            "target_lang_translations": {
                                "zh": "我一听到关于工作录用的好消息，就立刻给我的<w>死党</w>打了电话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "best friend",
                        "BFF"
                    ],
                    "antonyms": [
                        "enemy"
                    ],
                    "common_phrases": [
                        "my bestie",
                        "forever bestie"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal and trendy"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一个人最好的朋友。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "闺蜜",
                                "target_lang_sense_clarification": "指女性之间非常亲密的女性朋友。"
                            },
                            {
                                "target_lang_word": "死党",
                                "target_lang_sense_clarification": "指关系极好、可以生死与共的朋友，多用于男性或中性语境。"
                            },
                            {
                                "target_lang_word": "最好的朋友",
                                "target_lang_sense_clarification": "最标准、最通用的表达方式。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "202ee6fe-d856-310b-b804-947a3fdd2c5e",
                    "sense_definition": "A close friend in general.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went out for dinner with a few of his old <w>besties</w> from high school.",
                            "target_lang_translations": {
                                "zh": "他和几个高中时期的老<w>好友</w>出去吃了晚饭。"
                            }
                        },
                        {
                            "text": "She is my <w>bestie</w> from work and we always eat lunch together.",
                            "target_lang_translations": {
                                "zh": "她是我的职场<w>好友</w>，我们总是坐在一起吃午饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "friend",
                        "pal",
                        "buddy"
                    ],
                    "antonyms": [
                        "stranger"
                    ],
                    "common_phrases": [
                        "work bestie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "泛指关系亲密的朋友。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "好友",
                                "target_lang_sense_clarification": "指关系较好的朋友。"
                            },
                            {
                                "target_lang_word": "铁哥们",
                                "target_lang_sense_clarification": "指关系非常铁的男性朋友。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bb334fb-368a-381b-a067-9b434fab8957",
                    "sense_definition": "A term of direct address used to get someone's attention or emphasize a point, often affectionately or ironically.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Listen <w>bestie</w>, you really need to take a break and get some sleep.",
                            "target_lang_translations": {
                                "zh": "听着，<w>亲</w>，你真的需要休息一下，去睡会儿觉。"
                            }
                        },
                        {
                            "text": "Sorry to break it to you, <w>bestie</w>, but the store is already closed for the night.",
                            "target_lang_translations": {
                                "zh": "抱歉要告诉你这个消息，<w>亲</w>，商店今晚已经关门了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "friend",
                        "dude"
                    ],
                    "common_phrases": [
                        "listen bestie"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal, modern colloquial address"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种非正式的称呼，用于引起对方注意或强调某事，常带有亲昵或调侃的语气。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "亲",
                                "target_lang_sense_clarification": "网络用语，用于称呼对方，表示亲切。"
                            },
                            {
                                "target_lang_word": "朋友",
                                "target_lang_sense_clarification": "在口语中直接称呼对方。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}