                            {
                                "target_lang_word": "первоклассный",
                                "target_lang_sense_clarification": "высшего качества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卓越的",
                                "target_lang_sense_clarification": "形容品质"
                            },
                            {
                                "target_lang_word": "一流的",
                                "target_lang_sense_clarification": "形容质量"
                            }
                        ]
                    }
                }
