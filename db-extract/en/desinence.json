                                "target_senses": [
                                    {
                                        "sense_id": "88e2643b-9a06-3741-af79-3d8027ec83b4",
                                        "entry_id": "cd88b9a9-b12c-3fb3-917f-43c73120e8ff",
                                        "glosses": [
                                            "een opening waar iets doorheen kan of waardoor men een ruimte verlaten kan; vaak is dit tevens een ingang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4c574d1-e2bf-4288-a241-e03a0081a8da",
                                                "sense_id": "88e2643b-9a06-3741-af79-3d8027ec83b4",
                                                "text": "De uitgang werd bewaakt door een bewaker."
                                            },
                                            {
                                                "example_id": "8d8074d9-ec0b-42a8-a7e5-57d20941d07a",
                                                "sense_id": "88e2643b-9a06-3741-af79-3d8027ec83b4",
                                                "text": "Een van onze gedistingeerde gasten heeft mij ooit gezegd dat de monsters volgens hem niet waren bedoeld om vreemden buiten te houden, maar om de gasten te beletten de uitgang te bereiken. Het was jaren geleden dat hij dat zei, en hij is hier nog steeds. Zijn naam is Patelski. U zult hem ontmoeten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51eef4f0-6a3c-3d44-9278-0784c22befc1",
                                        "entry_id": "cd88b9a9-b12c-3fb3-917f-43c73120e8ff",
                                        "glosses": [
                                            "aantal letters achter de stam van een woord als vervoegings- of verbuigingselement"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb97617b-5f5e-33cb-a39e-044f45adb3b3",
                                        "entry_id": "cd88b9a9-b12c-3fb3-917f-43c73120e8ff",
                                        "glosses": [
                                            "aansluiting van elektrisch apparaat waar een signaal naar buiten wordt geleid"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9291ff7d-0fa0-482d-8085-03c78c1cbfaa",
                        "source_entry_id": "cca9d68f-6b58-393e-821f-d3cc5ca68a49",
                        "source_sense_id": "5ed6bcf8-39ac-36a2-a31d-2d4956ed5620",
                        "source_sense_description": "inflectional word-ending",
                        "target_lang_word": "désinence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désinence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bb3553f-ceba-3511-8b5b-813562e9de97",
                                        "entry_id": "500f2baa-3bae-3991-93e7-5951012d13d7",
                                        "glosses": [
                                            "Suffixe de flexion, terminaison grammaticale attachée au radical d’un mot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1fc23f1-22de-4e19-b1c3-f25863d1f889",
                                                "sense_id": "1bb3553f-ceba-3511-8b5b-813562e9de97",
                                                "text": "Cette désinence nous assure que le subjonctif aoriste sigmatique et le futur sigmatique n’étaient à l’origine qu’un seul et même paradigme et un même temps, un présent sigmatique dégradé en éventuel."
                                            },
                                            {
                                                "example_id": "eb60dd84-6512-4a3c-8304-ccc7884e46b6",
                                                "sense_id": "1bb3553f-ceba-3511-8b5b-813562e9de97",
                                                "text": "Si, sur la base des ouvrages de référence, nous mettons les désinences du conditionnel français en regard de celles du picard, nous nous trouvons devant la même situation que pour l’imparfait : les désinences du picard sont toutes distinctes de leurs homologues français."
                                            },
                                            {
                                                "example_id": "176244d6-75ad-415b-bb61-ee7670ef5510",
                                                "sense_id": "1bb3553f-ceba-3511-8b5b-813562e9de97",
                                                "text": "L’arabe, outre son pluriel régulier qui se forme comme dans toutes les autres langues par l’addition de certaines désinences, présente encore une formation particulière, étrangère aux autres langues sémites, et s’écartant en apparence de toute formation connue."
                                            },
                                            {
                                                "example_id": "65f45d6d-6d08-4881-b4e5-569dc1669a43",
                                                "sense_id": "1bb3553f-ceba-3511-8b5b-813562e9de97",
                                                "text": "À l’entendre, des maux sans nombre ont fondu ensemble sur mon vieux corps. Ces maux, effroi de l’homme, ont des noms, effroi du philologue. Ce sont des noms hybrides, mi-grecs, mi-latins, avec des désinences en ite indiquant l’état inflammatoire, et en algie, exprimant la douleur. Le docteur me les débite avec un nombre suffisant d’adjectifs en ique, destinés à en caractériser la détestable qualité. Bref une bonne colonne du Dictionnaire de médecine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0322d0-60a0-3457-818b-5090f672d3f0",
                                        "entry_id": "500f2baa-3bae-3991-93e7-5951012d13d7",
                                        "glosses": [
                                            "Aspect visuel de l’extrémité d’un organe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abf1f483-f848-40f8-98ff-5366e20cea60",
                                                "sense_id": "6e0322d0-60a0-3457-818b-5090f672d3f0",
                                                "text": "On entend par Désinence (Desinentia), la manière particulière dont se termine un organe ou un lobe quelconque. Dans un sens très-général, on dit d’une sommité ou extrémité quelconque, qu’elle est obtuse ou aiguë; […]."
                                            },
                                            {
                                                "example_id": "149d8364-20a6-41f7-947a-6aeed152d4fe",
                                                "sense_id": "6e0322d0-60a0-3457-818b-5090f672d3f0",
                                                "text": "Désinence des écailles inférieures, moyennes ou supérieures de la cupule, et prolongement en lanière plus ou moins longue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dcac0e5-b943-3419-adbc-95f0392c4323",
                                        "entry_id": "500f2baa-3bae-3991-93e7-5951012d13d7",
                                        "glosses": [
                                            "Partie calme qui suit une partie tonique, un climax."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ce9e53d-5a2c-3f84-8391-73949f61b504",
                                        "entry_id": "500f2baa-3bae-3991-93e7-5951012d13d7",
                                        "glosses": [
                                            "Note jouée doucement qui suit une note accentuée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66c5976a-303b-4d83-973b-2d803e48bd05",
                        "source_entry_id": "cca9d68f-6b58-393e-821f-d3cc5ca68a49",
                        "source_sense_id": "5ed6bcf8-39ac-36a2-a31d-2d4956ed5620",
                        "source_sense_description": "inflectional word-ending",
                        "target_lang_word": "Endung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Endung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "095e66b7-1c94-30f4-b794-983a732a565c",
                                        "entry_id": "6237b868-03c2-3d2f-afbd-71d884951425",
                                        "glosses": [
                                            "grammatisches Morphem (Suffix), das als Derivatem (Wortbildungsmorphem) oder Flexem (Flexionsendung) dient und an den Wortstamm angehängt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6236a20c-8e14-4fc4-982a-1c8cd654f29b",
                                                "sense_id": "095e66b7-1c94-30f4-b794-983a732a565c",
                                                "text": "„-st“ ist eine häufig verwendete Endung für die 2. Person Singular von Verben (Konjugation); „-lich“ eine häufig verwendete Endung zur Ableitung von Adjektiven."
                                            },
                                            {
                                                "example_id": "4d3ebfeb-17b8-46ce-8e38-5e33fa540d93",
                                                "sense_id": "095e66b7-1c94-30f4-b794-983a732a565c",
                                                "text": "„Es stellte sich nicht nur heraus, daß sich die Formen dieser Sprachen in ebensolche Bestandteile zerlegen ließen, sondern vor allem, daß sich die gewonnenen Endungen und Suffixe der einzelnen Sprachen ebenso vergleichen ließen wie die fertigen Wortformen.“"
                                            },
                                            {
                                                "example_id": "bd22b1fc-f094-4bea-a2df-7d737c36b9c7",
                                                "sense_id": "095e66b7-1c94-30f4-b794-983a732a565c",
                                                "text": "„Der ursprünglich als Suffix gebrauchte Themavokal ist im Germanischen fest mit der Endung verwachsen und wird mit ihr als Endung empfunden, so daß Flexionsübertragungen ihn stets mit übernehmen.“"
                                            },
                                            {
                                                "example_id": "46e3948a-c2f2-4868-9c18-8600384fa297",
                                                "sense_id": "095e66b7-1c94-30f4-b794-983a732a565c",
                                                "text": "„Das mehrsprachige Milieu kann auf korrekte Deklination und genaue Endungen durchaus verzichten, weil diese Art Grammatik nur Kodierungsenergie frisst, die woanders viel dringender gebraucht wird, beispielsweise um Defizite im Wortschatz auszugleichen.“"
                                            },
                                            {
                                                "example_id": "66064715-f732-4ac9-942f-dad5792fa3a7",
                                                "sense_id": "095e66b7-1c94-30f4-b794-983a732a565c",
                                                "text": "„‚Dúchenen‘ nennt man im Jiddischen diesen Vorgang mit einem Mischwort, in welchem eine deutsche Endung an den semitischen Stamm ‚duchan‘ gehängt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b3372a4-8167-366a-9fdc-e6ae7c9f485d",
                                        "entry_id": "6237b868-03c2-3d2f-afbd-71d884951425",
                                        "glosses": [
                                            "Dateiendung oder Top Level Domain"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5493c63-4965-448f-a620-d05e11d4f05e",
                                                "sense_id": "1b3372a4-8167-366a-9fdc-e6ae7c9f485d",
                                                "text": "Die Endung für Internetadressen aus Deutschland ist meistens .de."
                                            },
                                            {
                                                "example_id": "8aee66bd-0fb9-43ee-a690-1753c459080c",
                                                "sense_id": "1b3372a4-8167-366a-9fdc-e6ae7c9f485d",
                                                "text": "„Ein Anwendungsprogramm wie z. B. Word wird beim ersten Abspeichern einer neuen Datei als default die Endung ‚.doc‘ vorgeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
