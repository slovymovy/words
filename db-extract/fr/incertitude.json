                    {
                        "translation_id": "26fb4e23-f4d2-4e70-ba2c-1eef92bef26c",
                        "source_entry_id": "9ca8d2de-3017-3588-bf36-1c553555a8e0",
                        "target_lang_word": "onzekerheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onzekerheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f42ff378-a91d-3138-85ce-ac8fe400a005",
                                        "entry_id": "440f15dd-0a6b-3412-ba0f-a71fb01d2580",
                                        "glosses": [
                                            "het niet (helemaal) zeker zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa13d99f-828d-4b28-9c02-48ada7dc3a4b",
                                                "sense_id": "f42ff378-a91d-3138-85ce-ac8fe400a005",
                                                "text": "Hij twijfelt altijd want hij heeft last van te grote onzekerheid."
                                            },
                                            {
                                                "example_id": "f5b6f472-83c3-411e-8fd6-1be6f9dd924d",
                                                "sense_id": "f42ff378-a91d-3138-85ce-ac8fe400a005",
                                                "text": "Mijn onzekerheid werd steeds intenser en instinctief had ik nog maar één behoefte: vluchten, weg uit de bergen."
                                            },
                                            {
                                                "example_id": "969999ea-bf6c-4ec4-8d31-830861008a61",
                                                "sense_id": "f42ff378-a91d-3138-85ce-ac8fe400a005",
                                                "text": "Maar Christa vond tegelijkertijd dat er een groot en ongekend potentieel was voor zo'n populistische partij, op dit moment zwierven er misschien een miljoen mensen in totale onzekerheid rond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19a787d2-aaba-31d7-95fa-48d617efb09a",
                                        "entry_id": "440f15dd-0a6b-3412-ba0f-a71fb01d2580",
                                        "glosses": [
                                            "de mate waarin meting en het gemetene van elkaar kunnen afwijkingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77adcc96-1ef1-4af6-9aeb-78bca5da00fe",
                                                "sense_id": "19a787d2-aaba-31d7-95fa-48d617efb09a",
                                                "text": "Hij is 1.80 meter lang met een onzekerheid van 1 cm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a78af0b-ea05-402a-a682-1c7ae3a986ff",
                        "source_entry_id": "9ca8d2de-3017-3588-bf36-1c553555a8e0",
                        "target_lang_word": "ongewisheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongewisheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "193c4a3b-44f3-3ce4-84b5-847b3eb839e4",
                                        "entry_id": "d3c225f3-7508-35bf-b0f0-23c0b0a1c142",
                                        "glosses": [
                                            "de mate waarin men geen zekerheid heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae0f110b-3a28-41dc-a4ff-d30af2d2393e",
                                                "sense_id": "193c4a3b-44f3-3ce4-84b5-847b3eb839e4",
                                                "text": "Drie jaren van veranderingen, ongewisheid, marsen, oorlog, revolutie, schokken, beschietingen, ondergangstaferelen, doodstaferelen, opgeblazen bruggen, verwoestingen, branden - opeens was het allemaal veranderd in een gigantische lege plek zonder inhoud."
                                            },
                                            {
                                                "example_id": "cf921399-11bb-49ad-8e37-90e2f9bb7949",
                                                "sense_id": "193c4a3b-44f3-3ce4-84b5-847b3eb839e4",
                                                "text": "Met als gevolg dat de geloofsgemeenschap in Zuid-Berghuizen, twee dagen voordat de deur van hun Mariakerk minimaal een maand op slot gaat, in opperste verwarring verkeert. Het konijn dat het bestuur van de Plechelmusparochie deze week uit de hoge hoed te voorschijn toverde, zorgt voor veel verwarring en ongewisheid. Eucharistievieringen zijn na 1 februari nog wel toegestaan in de Mariakerk. Weliswaar niet in het weekend. Maar mogelijk wel op vrijdagavond en dat is meer dan tot nu toe was afgesproken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
