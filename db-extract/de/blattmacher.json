                "senses": [
                    {
                        "sense_id": "781db077-d0d5-322f-9536-57887c2950ca",
                        "entry_id": "7659b4c1-c261-379c-b904-b8f3ddb8b1a4",
                        "glosses": [
                            "jemand, der eine Zeitung erstellt oder herausgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10149105-b2eb-4371-b4a3-c09cfe041318",
                                "sense_id": "781db077-d0d5-322f-9536-57887c2950ca",
                                "text": "„Zweifellos haben aber auch die Entscheidungen der Blattmacher und einzelner Journalisten Konsequenzen für die publizistische Kontroverse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cdfc6413-d3b8-3ce9-a2f5-8219bc373cad",
                        "entry_id": "7659b4c1-c261-379c-b904-b8f3ddb8b1a4",
                        "glosses": [
                            "Handwerker, der Blätter für die Weberstühle fertigt"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "360734ea-b2ae-4a9e-8f12-6fdc29c79d8a",
                                "sense_id": "cdfc6413-d3b8-3ce9-a2f5-8219bc373cad",
                                "text": "„Ein Blatt der Seidenwirker hat dagegen Stifte von geglätteten Stahl, und es giebt in Berlin Blattmacher dieser leztern Art, welche eine königliche Pension bekommen.“"
                            },
                            {
                                "example_id": "5dc62228-51ff-4e55-a977-043ebb1ab646",
                                "sense_id": "cdfc6413-d3b8-3ce9-a2f5-8219bc373cad",
                                "text": "„Unter andern wurde häufig den Webern verboten, Blätter unter einer gewissen Breite in die Lade ihres Stuhles zu setzen, und sogar die Blattmacher vereidet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
