                "senses": [
                    {
                        "sense_id": "d4516ffb-f562-325a-b808-fced405ed1e7",
                        "entry_id": "b65dfc68-ba43-39c1-ab9b-a1ef64504435",
                        "glosses": [
                            "die Art und Weise, wie sich ein Lebewesen (oder Mikroorganismus/Prion) vermehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb0f4c96-7f65-424d-9610-f43e16f3a452",
                                "sense_id": "d4516ffb-f562-325a-b808-fced405ed1e7",
                                "text": "„Die „In-vitro-Fertilisation\" (IVF), die Zeugung in der Petrischale, hat sich offensichtlich als „alternative Fortpflanzungsmethode\" (Smotrich) etabliert.“"
                            },
                            {
                                "example_id": "ac9a4c0e-19a2-4bc9-a60b-25307dd12714",
                                "sense_id": "d4516ffb-f562-325a-b808-fced405ed1e7",
                                "text": "„„Viren sollte als lebende Organismen betrachtet werden, die einfach nur mit Hilfe einer atypischen Fortpflanzungsmethode überleben“, meint Caetano-Anollés. „Sie infizieren Zellen wie es auch andere obligate Parasiten tun und sie verlassen sich wie sie auf ihre Wirte, um ihren Lebenszyklus zu vollenden.““"
                            },
                            {
                                "example_id": "28f7436e-8b30-4e9b-abba-8a3d1fe02e5f",
                                "sense_id": "d4516ffb-f562-325a-b808-fced405ed1e7",
                                "text": "„Das Legen von Kartoffeln oder größeren Kartoffeltheilen ist unzweifelhaft die sicherste Fortpflanzungsmethode […].“ (1878)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
