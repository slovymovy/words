                    "sense_id": "cfebd49e-55c6-3f28-afc3-1c4fa07a71d2",
                    "sense_definition": "De partitieve vorm van <w>nieuw</w>, gebruikt na onbepaalde voornaamwoorden zoals 'iets', 'niets', 'wat' of 'veel'.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil graag iets <w>nieuws</w> proberen in de keuken.",
                            "target_lang_translations": {
                                "en": "I would like to try something <w>new</w> in the kitchen.",
                                "ru": "Я хочу попробовать что-то <w>новое</w> на кухне.",
                                "pl": "Chciałbym spróbować w kuchni czegoś <w>nowego</w>.",
                                "de": "Ich möchte gerne etwas <w>Neues</w> in der Küche ausprobieren.",
                                "fr": "J'aimerais essayer quelque chose <w>de nouveau</w> en cuisine.",
                                "it": "Vorrei provare qualcosa di <w>nuovo</w> in cucina.",
                                "cs": "Rád bych v kuchyni vyzkoušel něco <w>nového</w>.",
                                "tr": "Mutfakta <w>yeni</w> bir şeyler denemek istiyorum.",
                                "es": "Me gustaría probar algo <w>nuevo</w> en la cocina."
