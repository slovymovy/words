                ],
                "senses": [
                    {
                        "sense_id": "7c5037b0-3330-318b-8a9f-099abf80511c",
                        "entry_id": "e891f037-004b-319c-89fc-f4aa74934841",
                        "glosses": [
                            "Wörterbuch, das Ausdrücke enthält, die eine Sprache aus dem Englischen entlehnt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd310b8-c0dc-407e-91a3-7e7f0b3961a9",
                                "sense_id": "7c5037b0-3330-318b-8a9f-099abf80511c",
                                "text": "„Als Ausgangspunkt dient der Begriff, wie er der Arbeit am Anglizismenwörterbuch (Carstensen & Busse (19931996) zugrunde gelegen hat.“"
                            },
                            {
                                "example_id": "0f25dcdc-643e-4c53-b6f4-77adf81d3474",
                                "sense_id": "7c5037b0-3330-318b-8a9f-099abf80511c",
                                "text": "„Zuvor konnte man sich lediglich auf die Anglizismenwörterbücher von Probst, Schönfeld und Neske/Neske berufen, die nach Auffassung vieler Kritiker jedoch nicht ausführlich genug den Einfluss englischer Begriffe in ihren Wörterbüchern festhielten.“"
                            },
                            {
                                "example_id": "15a48312-92e9-4928-9663-11de59c0f6cc",
                                "sense_id": "7c5037b0-3330-318b-8a9f-099abf80511c",
                                "text": "„Schüler und Lehrer der HLW in St. Veit/Glan veröffentlichen jetzt ein kostenloses Anglizismenwörterbuch für Senioren, um ihnen eine Übersetzungshilfe zu bieten.“"
                            },
                            {
                                "example_id": "c6a4b794-1cca-4baf-bfc6-49f508e0e083",
                                "sense_id": "7c5037b0-3330-318b-8a9f-099abf80511c",
                                "text": "„Das Anglizismenwörterbuch von Alfaro 1970 (¹1950, ²1964) ist stark puristisch orientiert und weist darüber hinaus erhebliche materielle Lücken sowie methodische Defizite bei der Konzeption der Mikrostruktur auf (cf. dazu auch Teschner 1974, 634ss.).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
