                    {
                        "translation_id": "f24439ce-fa9c-4578-a74b-573c48235296",
                        "source_entry_id": "8bb5631d-26ee-38a7-9bca-86a85a555809",
                        "source_sense_id": "e4e5f096-1216-36d7-bf74-43678f1e4992",
                        "source_sense_description": "een rietsoort die verbouwd wordt vanwege zijn suikergehalte en waaruit rietsuiker gewonnen wordt",
                        "target_lang_word": "Zuckerrohr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuckerrohr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83a70c4e-7638-3f97-a578-428ddad2da18",
                                        "entry_id": "15deb774-431a-365c-9784-2d505048db7d",
                                        "glosses": [
                                            "eine Pflanze, die der Familie der Süßgräser angehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70e08893-8f9c-4867-8a2f-d4a9116fd82c",
                                                "sense_id": "83a70c4e-7638-3f97-a578-428ddad2da18",
                                                "text": "Rohrzucker wird unter Anderem aus Zuckerrohr gewonnen."
                                            },
                                            {
                                                "example_id": "e788346e-19c0-4758-a935-3cda4dfbe078",
                                                "sense_id": "83a70c4e-7638-3f97-a578-428ddad2da18",
                                                "text": "„Am Nachmittag zeigte mir Hallows die Fabrik, wohin das Zuckerrohr von den Feldern gebracht und wo es zu Melasse verarbeitet wurde.“"
                                            },
                                            {
                                                "example_id": "ef73d6a2-0050-448f-a30e-d9b955115d7a",
                                                "sense_id": "83a70c4e-7638-3f97-a578-428ddad2da18",
                                                "text": "„Vom Erlös kaufte er dort Erzeugnisse wie Zuckerrohr und Baumwolle, womit er in die Heimathäfen zurückkehrte.“"
                                            },
                                            {
                                                "example_id": "e033f939-3dbc-4e83-9ae8-f8ab70b1a091",
                                                "sense_id": "83a70c4e-7638-3f97-a578-428ddad2da18",
                                                "text": "„In Brasilien werden Regenwälder gerodet, um zusätzliche Anbauflächen für Zuckerrohr für die Bioethanolproduktion zu schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "476b9c2e-0b9d-4a0b-bc65-a3ca0c52ed5e",
                        "source_entry_id": "8bb5631d-26ee-38a7-9bca-86a85a555809",
                        "source_sense_id": "e4e5f096-1216-36d7-bf74-43678f1e4992",
                        "source_sense_description": "een rietsoort die verbouwd wordt vanwege zijn suikergehalte en waaruit rietsuiker gewonnen wordt",
                        "target_lang_word": "sugar cane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sugar cane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12c2fa2e-f892-3791-abfe-bec24d31ba55",
                                        "entry_id": "5dffb78d-3c65-30ad-a217-883bad9246ee",
                                        "glosses": [
                                            "A tropical grass of the genus Saccharum (especially the species Saccharum officinarum, including hybrids) having stout, fibrous, jointed stalks, the sap of which is a source of sugar."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35b3b92c-c06f-495b-a1c0-fe1630d1648b",
                                                "sense_id": "12c2fa2e-f892-3791-abfe-bec24d31ba55",
                                                "text": "Daniel was watching Sarah, Bose and Femi munch contentedly on the firm sweetness of sugar cane, plucking back the green with their fingers to reveal the creamy yellow-white that left gluey juices on their hands and clothes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cb43a5c-46c3-3ec3-bd11-a625c2ab29dc",
                                        "entry_id": "5dffb78d-3c65-30ad-a217-883bad9246ee",
                                        "glosses": [
                                            "A candy cane, an edible candy in the shape of a cane."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "334142b4-c43e-411f-ac47-7aecb25fe78e",
                        "source_entry_id": "8bb5631d-26ee-38a7-9bca-86a85a555809",
                        "source_sense_id": "e4e5f096-1216-36d7-bf74-43678f1e4992",
                        "source_sense_description": "een rietsoort die verbouwd wordt vanwege zijn suikergehalte en waaruit rietsuiker gewonnen wordt",
                        "target_lang_word": "canne à sucre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canne à sucre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e06ec00c-9dfd-3a3b-8bab-a1af16e34269",
                                        "entry_id": "b7b87c3f-4dcd-3e4e-be4d-a813e8cea069",
                                        "glosses": [
                                            "Grande plante tropicale, graminée de la famille des Poacées dont le suc sucré issu de la tige, le vesou, donne le sucre de canne. Après extraction, les tiges broyées, nommées bagasse, sont mises en fermentation alcoolique, puis distillées. Le distillat est du rhum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bb10448-b8bf-4f22-9f72-8847a2238ac0",
                                                "sense_id": "e06ec00c-9dfd-3a3b-8bab-a1af16e34269",
                                                "text": "Pendant longtemps le sucre ordinaire a été extrait exclusivement de la canne à sucre ; cette opération se pratique encore, surtout dans les Indes et en Amérique."
                                            },
                                            {
                                                "example_id": "4f6653ce-00c0-4e77-823c-1b7530abec13",
                                                "sense_id": "e06ec00c-9dfd-3a3b-8bab-a1af16e34269",
                                                "text": "À nouveau, Helmy lui essaya des bracelets. Et c’était pour lui, le prétexte à toucher, de ses doigts brûlants, des poignets blancs comme la pulpe de la canne à sucre."
                                            },
                                            {
                                                "example_id": "a4ddf3aa-851a-440c-b031-d305b1bd9b0f",
                                                "sense_id": "e06ec00c-9dfd-3a3b-8bab-a1af16e34269",
                                                "text": "En début d’année, on apportait à la raffinerie la récolte de canne à sucre des mois précédents. Une odeur très forte se dégageait des tiges écrasées puis brûlées. C’était pour le sucre que les Français avaient investi l’île ; […]."
                                            },
                                            {
                                                "example_id": "22c70e7d-d62e-4d2b-b36c-5ac4fe70356a",
                                                "sense_id": "e06ec00c-9dfd-3a3b-8bab-a1af16e34269",
                                                "text": "La compagnie brésilienne de biodiesel Biomasa, envisage de planter deux millions d'hectares de jatrophe cette année et l'on pense que le jatrophe dépassera la canne à sucre comme principale source de bioéthanol cette année au Brésil."
                                            },
                                            {
                                                "example_id": "d1634824-ccc3-46fb-8def-980ea09b6627",
                                                "sense_id": "e06ec00c-9dfd-3a3b-8bab-a1af16e34269",
                                                "text": "Deux plantes ont une richesse en saccharose beaucoup plus importante : la canne à sucre (qui contient 20 % de saccharose), connue depuis l’Antiquité, et la betterave sucrière (dont la racine en contient 18,7 %), qui sont aujourd’hui les deux sources principales de sucre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
