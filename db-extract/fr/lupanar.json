                        "examples": [
                            {
                                "example_id": "875965cd-f358-40d9-83a1-ae9be688e86f",
                                "sense_id": "9af6d526-3018-3646-aefb-799709c2708b",
                                "text": "Devenu étudiant à l'Université, je visitai un lupanar et je réussis le coït sans effort.",
                                "translation": "Having become a student at university, I visited a brothel and easily managed to have intercourse.",
                                "english": "Having become a student at university, I visited a brothel and easily managed to have intercourse."
                            },
                            {
                                "example_id": "92f0d1c4-9cf3-4fa8-b778-a5901793e4d3",
                                "sense_id": "9af6d526-3018-3646-aefb-799709c2708b",
                                "text": "Ce soir tu as décidé de retourner au Bar Biturique, ton lupanar favori. Les maisons closes sont supposées être interdites en France ; pourtant, rien qu'à Paris, on en dénombre une bonne cinquantaine.",
                                "translation": "Tonight you've decided to go back to the Bar Biturique, your favourite house of ill repute. Brothels are supposed to be banned in France, but in Paris alone there are a good fifty of them.",
                                "english": "Tonight you've decided to go back to the Bar Biturique, your favourite house of ill repute. Brothels are supposed to be banned in France, but in Paris alone there are a good fifty of them."
                            }
                        ]
                    }
