                        "glosses": [
                            "Containing thorns."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "680d4aaf-3179-428b-8c77-df87b34b6c9f",
                                "sense_id": "0a767971-3333-3029-8534-bd9b6fc7967d",
                                "text": "Near-synonym: spined"
                            },
                            {
                                "example_id": "c246c41c-63b8-43e0-9ab9-81149e02b86c",
                                "sense_id": "0a767971-3333-3029-8534-bd9b6fc7967d",
                                "text": "A prickly bindweed (the Smilax Sarsaparilla) forms a feature in the near landscape, with its creamy odoriferous blossoms, coral berries, and glossy thorned leaves."
                            },
                            {
                                "example_id": "9eb73fc3-3a90-4e97-9bde-7fbc7dd7bc96",
                                "sense_id": "0a767971-3333-3029-8534-bd9b6fc7967d",
                                "text": "In these we always find that the thorned holly is spoken of as male, and the Ivy as female."
                            },
                            {
                                "example_id": "7bf4e3e0-e2fa-4b40-a1f4-372c15a3fb65",
                                "sense_id": "0a767971-3333-3029-8534-bd9b6fc7967d",
                                "text": "In its native form the branches of the honey locust are thorned and bear seed pods up to a foot long."
                            }
                        ]
                    }
