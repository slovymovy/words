                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ad6a18-381b-4595-aed2-3dc815c45d36",
                                "sense_id": "ab4436f8-e581-3211-ae57-b65b7fac76e5",
                                "text": "Frau Ratajczak ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6a7f63b6-c5f9-4bc8-a65f-d1639f365a9f",
                                "sense_id": "ab4436f8-e581-3211-ae57-b65b7fac76e5",
                                "text": "Herr Ratajczak wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c47c2cba-e9ed-4be6-a67c-7195bea53cb9",
                                "sense_id": "ab4436f8-e581-3211-ae57-b65b7fac76e5",
                                "text": "Die Ratajczaks fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "99a7bd7f-70d5-4fda-9f37-ce07a29d8b14",
                                "sense_id": "ab4436f8-e581-3211-ae57-b65b7fac76e5",
                                "text": "Der Ratajczak trägt nie die Pullover, die die Ratajczak ihm strickt."
                            },
                            {
                                "example_id": "24881471-56e9-434c-8989-3543321b26ba",
                                "sense_id": "ab4436f8-e581-3211-ae57-b65b7fac76e5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ratajczak kommt, geht der Herr Ratajczak.“"
                            },
                            {
                                "example_id": "ba1689d0-155b-4d20-8803-26b63c07ed04",
                                "sense_id": "ab4436f8-e581-3211-ae57-b65b7fac76e5",
                                "text": "Ratajczak kommt und geht."
                            },
                            {
                                "example_id": "dd9e1920-f6cb-4b9d-a3d3-fcaae52d16ad",
                                "sense_id": "ab4436f8-e581-3211-ae57-b65b7fac76e5",
                                "text": "Ratajczaks kamen, sahen und siegten."
                            }
                        ],
