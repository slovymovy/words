                ],
                "senses": [
                    {
                        "sense_id": "a0cb2ab9-f947-3eee-a19f-bb0abfc76e71",
                        "entry_id": "8dbfcf04-3625-3c13-b18f-6a3ba3eb9bdc",
                        "glosses": [
                            "An instance of saying “good night”; a nighttime farewell."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d7290f5-cd8e-4ebe-a214-98b02f7b2d48",
                                "sense_id": "a0cb2ab9-f947-3eee-a19f-bb0abfc76e71",
                                "text": "At last the pupils had all taken their hats and said their “Goodnights,” and Adam, knowing his old master's habits, rose and said, “Shall I put the candles out, Mr. Massey?”"
                            },
                            {
                                "example_id": "bedfe602-a544-43a3-a7fd-618c0c6053d2",
                                "sense_id": "a0cb2ab9-f947-3eee-a19f-bb0abfc76e71",
                                "text": "The afternoon passed into evening, and the sparrows began to twitter their goodnights in their lodgings on the roof and crevices of the chimney; […]"
                            },
                            {
                                "example_id": "9161a87e-2fed-446a-a97c-b310e59c8933",
                                "sense_id": "a0cb2ab9-f947-3eee-a19f-bb0abfc76e71",
                                "text": "George wakes, hearing the confused goodnights of the departing guests."
                            },
                            {
                                "example_id": "d8a53768-2a6e-40ce-acd4-d9ad8c3c49c3",
                                "sense_id": "a0cb2ab9-f947-3eee-a19f-bb0abfc76e71",
                                "text": "Ray and Josh spoke their goodnights."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e1299dcc-7c5b-3035-bb93-037c3252964e",
                "word": "goodnight",
                "pos": "phrase",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0dea84e1-4912-351e-9df6-50439ee81584",
                        "entry_id": "e1299dcc-7c5b-3035-bb93-037c3252964e",
                        "glosses": [
                            "Alternative spelling of good night."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "82efab1a-7f4e-4d6d-95ae-56a0133c4314",
                                "sense_id": "0dea84e1-4912-351e-9df6-50439ee81584",
                                "text": "I pray you ſpeake not: he growes worſe & worſe / Queſtion enrages him: at once, goodnight."
                            },
                            {
                                "example_id": "cc8c96f1-4722-4c69-97e6-e3a341112425",
                                "sense_id": "0dea84e1-4912-351e-9df6-50439ee81584",
                                "text": "So goodnight to you—and goodnight, Councilor."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
