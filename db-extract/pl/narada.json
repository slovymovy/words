                                        "sense_id": "90ff39a9-9a52-3576-a386-4faab6e861ac",
                                        "entry_id": "6b71df31-b78b-34cd-9176-c0c212f3ac5d",
                                        "glosses": [
                                            "The act of consulting together formally; serious conversation or discussion; interchange of views."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a5df036-3230-4879-b794-e70f6a1e064d",
                                                "sense_id": "90ff39a9-9a52-3576-a386-4faab6e861ac",
                                                "text": "Nor with such free and friendly conference / As he hath used of old."
                                            },
                                            {
                                                "example_id": "f79113d2-b4ab-49b8-ad6e-a39f40631803",
                                                "sense_id": "90ff39a9-9a52-3576-a386-4faab6e861ac",
                                                "text": "Mr. Wiley, a lawyer of some ability, was sitting in his office one day, when an elderly gentleman came in and asked to have a few words of conference with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9d4e761-5971-3a97-8d83-9ca6d44db3ad",
                                        "entry_id": "6b71df31-b78b-34cd-9176-c0c212f3ac5d",
                                        "glosses": [
                                            "A multilateral diplomatic negotiation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9486f3a-9ae4-39ab-91c7-d7498781f6f1",
                                        "entry_id": "6b71df31-b78b-34cd-9176-c0c212f3ac5d",
                                        "glosses": [
                                            "A formal event where scientists present their research results in speeches, workshops, posters or by other means."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8cfb1322-c956-3860-9899-3a14d184900a",
                                        "entry_id": "6b71df31-b78b-34cd-9176-c0c212f3ac5d",
                                        "glosses": [
                                            "An event organized by a for-profit or non-profit organization to discuss a pressing issue, such as a new product, market trend or government regulation, with a range of speakers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46596c10-3a70-3db1-a5f0-37af70988c67",
                                        "entry_id": "6b71df31-b78b-34cd-9176-c0c212f3ac5d",
                                        "glosses": [
                                            "A group of sports teams that play each other on a regular basis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15232048-03e2-378a-aaca-df336fad68a3",
                                        "entry_id": "6b71df31-b78b-34cd-9176-c0c212f3ac5d",
