                        "sense_id": "decc75e4-e1da-3859-86a4-d6fe065a60b4",
                        "entry_id": "ae5b8a4a-7643-3d05-8aa1-14050ce6e5a6",
                        "glosses": [
                            "a centipede, animal of the class Chilopoda"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "f2d6943a-ca33-4682-b9b4-6bc69b7436df",
                                "sense_id": "decc75e4-e1da-3859-86a4-d6fe065a60b4",
                                "text": "Over het bospad kwam een lange rij duizendpoten aanstappen.",
                                "translation": "A long line of centipedes came treading closer over the forest path.",
                                "english": "A long line of centipedes came treading closer over the forest path."
                            }
                        ]
                    },
                    {
                        "sense_id": "0518b662-9da2-3be8-bfdd-b06bf886625c",
                        "entry_id": "ae5b8a4a-7643-3d05-8aa1-14050ce6e5a6",
                        "glosses": [
                            "a person of many talents, especially one good at multi-tasking; a jack of all trades"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "5d61aad2-7812-4cd3-98ad-8e4dcd83f257",
                                "sense_id": "0518b662-9da2-3be8-bfdd-b06bf886625c",
                                "text": "2014, Willem Kuiper, \"Luna en Fortuna\", in Andrea van Leerdam & Orlanda S. H. Lie & Martine Meuwese & Maria Patijn (eds.), Kennis in beeld. Denken en doen in de Middeleeuwen, Uitgeverij Verloren page 48.\nDe bedenker van dit allegorische personage was de Romein Boëthius (ca. 480-525), een intellectuele duizendpoot en een van de meest invloedrijke scharnieren tussen het laat-antieke Romeinse Rijk en de Latijnse Middeleeuwen.",
                                "translation": "The inventor of this allegorical character was the Roman Boethius (ca. 480-525), an intellectual man of many talents and one of the most influential pivots between the late-antique Roman Empire and the Latin Middle Ages.",
                                "english": "The inventor of this allegorical character was the Roman Boethius (ca. 480-525), an intellectual man of many talents and one of the most influential pivots between the late-antique Roman Empire and the Latin Middle Ages."
                            }
                        ]
                    }
