                                                "example_id": "6b27cee7-7b58-4e9b-b6b3-1b5646370305",
                                                "sense_id": "c771aa6a-325e-3f22-8249-40ecf3d14021",
                                                "text": "Stočil hrot meče k jednomu ze tří Španělů v družině, malému, podsaditému chlapíkovi se zapšklým výrazem."
                                            },
                                            {
                                                "example_id": "41f53876-655c-4ab4-b458-1bac6fffdea0",
                                                "sense_id": "c771aa6a-325e-3f22-8249-40ecf3d14021",
                                                "text": "Když mi tenkrát volali z castingové agentury, abych přijel na konkurz, byl jsem zapšklý a otrávený a řekl, že mě žádné konkurzy nezajímají."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b99fbdf8-7955-3f91-be81-9836dd18b1a7",
