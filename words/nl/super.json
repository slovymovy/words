                            }
                        },
                        {
                            "text": "Het is <w>super</w> koud buiten, dus trek een warme jas aan.",
                            "target_lang_translations": {
                                "en": "It is <w>super</w> cold outside, so put on a warm coat.",
                                "ru": "На улице <w>супер</w> холодно, так что надень теплую куртку.",
                                "pl": "Na zewnątrz jest <w>super</w> zimno, więc załóż ciepłą kurtkę.",
                                "de": "Es ist draußen <w>super</w> kalt, also zieh eine warme Jacke an.",
                                "fr": "Il fait <w>super</w> froid dehors, alors mets un manteau chaud.",
                                "it": "Fa <w>super</w> freddo fuori, quindi mettiti un cappotto caldo.",
                                "cs": "Venku je <w>super</w> zima, tak si vezmi teplý kabát.",
                                "tr": "Dışarısı <w>aşırı</w> soğuk, bu yüzden kalın bir ceket giy.",
                                "es": "Hace <w>súper</w> frío afuera, así que ponte un abrigo caliente.",
                                "zh": "外面<w>超级</w>冷，所以穿件暖和的外套吧。"
