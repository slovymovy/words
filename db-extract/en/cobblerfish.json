                        "examples": [
                            {
                                "example_id": "2b7d0c9f-c36c-40ec-8b57-9687a4b316fb",
                                "sense_id": "474a8cc0-54cf-3107-9ba2-304a43f101f1",
                                "text": "Common pompano, carolina pompano, cobblerfish, butterfish."
                            },
                            {
                                "example_id": "15b7bcc8-db08-4efe-bd1c-afdb19acde83",
                                "sense_id": "474a8cc0-54cf-3107-9ba2-304a43f101f1",
                                "text": "Florida Pompano--Trachinotus carolinus. Other names: pompano, cobblerfish, palometa"
                            },
                            {
                                "example_id": "87bc76b9-8803-4be9-baf7-09589157c7ea",
                                "sense_id": "474a8cc0-54cf-3107-9ba2-304a43f101f1",
                                "text": "Also known as cobblerfish, the Carolina or Florida pompano is so similar in body construction to the permit that an ichthyologist may be needed to distinguish 2- or 3- pounds specimens of these species."
                            }
                        ]
                    }
