                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3301bb7e-f543-48bd-9060-e49c28a08d54",
                                "sense_id": "eefcb5a7-e156-3bfe-b054-8c321d0c47d2",
                                "text": "Mariusz Łesiuk już myśli o zbudowaniu obok altany z ławeczkami, by zachęcić do piknikowania w cieniu trzystuletnich drzew"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6bbbde73-632f-32af-beab-756a1b748551",
                        "entry_id": "0972c347-c59c-3605-8f28-f0d771db4a74",
                        "glosses": [
                            "trwający trzysta lat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf97fc0c-ead0-4229-9c37-610e915d128a",
                                "sense_id": "6bbbde73-632f-32af-beab-756a1b748551",
                                "text": "Ludność ta wiele ucierpiała z powodu trzystuletniego handlu niewolnikami, chorób europejskiego pochodzenia, alkoholu i walk międzyplemiennych"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
