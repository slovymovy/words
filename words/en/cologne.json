{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f8db860f-8119-3a10-9acd-582dcb8ea97c",
                    "sense_definition": "A scented liquid, typically containing alcohol, used to impart a pleasant smell to the body.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fragrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He put on some <w>cologne</w> before going out on his date. ",
                            "target_lang_translations": {
                                "zh": "他在约会前<w>喷</w>了一些古龙水。"
                            }
                        },
                        {
                            "text": "He smells good because he bought expensive <w>cologne</w> yesterday. ",
                            "target_lang_translations": {
                                "zh": "他身上好闻是因为他昨天买了昂贵的<w>古龙水</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eau de Cologne"
                    ],
                    "common_phrases": [
                        "expensive cologne",
                        "wear cologne",
                        "smell of cologne"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种通常含有酒精的香水，用于使身体散发出宜人的气味。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "古龙水",
                                "target_lang_sense_clarification": "指代一种特定浓度的男士香水。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e72e73a4-0a11-3ca7-ad06-7ad812b75dbf",
                    "sense_definition": "To apply cologne to oneself or another person to give them a scent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scenting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully <w>cologned</w> his shirt before heading to the evening gala. ",
                            "target_lang_translations": {
                                "zh": "他在去参加晚宴前仔细地在衬衫上<w>喷</w>了古龙水。"
                            }
                        },
                        {
                            "text": "She noticed that he had heavily <w>cologned</w> himself prior to the meeting. ",
                            "target_lang_translations": {
                                "zh": "她注意到他在开会前身上<w>喷</w>了浓重的古龙水。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在自己或他人身上喷洒古龙水以使其带有香味。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "喷古龙水",
                                "target_lang_sense_clarification": "指使用古龙水的动作。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f12030a6-f149-303e-a4e7-b21d1083bc29",
                    "sense_definition": "A major city in western Germany, located on the Rhine River.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We took a high-speed train to visit <w>Cologne</w> during our summer vacation. ",
                            "target_lang_translations": {
                                "zh": "暑假期间，我们乘高铁去游览了<w>科隆</w>。"
                            }
                        },
                        {
                            "text": "The famous cathedral in <w>Cologne</w> attracts millions of tourists every year. ",
                            "target_lang_translations": {
                                "zh": "<w>科隆</w>著名的大教堂每年吸引数百万游客。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "德国西部的一座主要城市，位于莱茵河畔。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "科隆",
                                "target_lang_sense_clarification": "德国城市名。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}