                "senses": [
                    {
                        "sense_id": "ba9848c3-99ea-3af6-b5de-41500e84c52b",
                        "entry_id": "0ad9b4d8-2e79-3b56-abc5-a15e1183097c",
                        "glosses": [
                            "Acronym of original female character (“a female original character”)."
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "alt-of",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "14712596-b720-442c-bade-e39bae3fa968",
                                "sense_id": "ba9848c3-99ea-3af6-b5de-41500e84c52b",
                                "text": "I strongly dislike the idea of calling one of my OFCs \"Mary Sue\". It's too negative a connotation, and one that I try diligently to avoid."
                            },
                            {
                                "example_id": "26fa1abf-0d3d-494c-81b9-58dfd2b74f9c",
                                "sense_id": "ba9848c3-99ea-3af6-b5de-41500e84c52b",
                                "text": "OTOH, if an OFC or OMC is written to further the story, well, if you can make me believe it, congratulations."
                            },
                            {
                                "example_id": "8b678c17-8443-44e6-8a80-f77c4f8aa5aa",
                                "sense_id": "ba9848c3-99ea-3af6-b5de-41500e84c52b",
                                "text": "You try explaining that to most fanfic fans these days - the minute they see an OFC you get tarred as a \"Mary Sue\" and your stuff gets slagged all over the internet."
                            }
                        ]
                    },
