                "senses": [
                    {
                        "sense_id": "d3781806-ded8-3172-8490-7a5653d7ee1a",
                        "entry_id": "b1bbc36b-2cfa-3493-8f07-c524b77378f8",
                        "glosses": [
                            "Künstler, der plastische Figuren herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdf64805-60c5-4bfd-9226-4c351d6276ad",
                                "sense_id": "d3781806-ded8-3172-8490-7a5653d7ee1a",
                                "text": "„Es beginnt mit dem Zugeständnis, wir könnten nicht sicher sein, ob wir bei der aktuellen Wahrnehmung beispielsweise eines Zebras ungetäuscht bleiben, sei es von einem betrügenden Genius, sei es von einem Skulpteur, der uns mit einer täuschenden Plastik in die Irre führt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c7c974e-523c-40df-bab7-8f7b28dd22d0",
                        "source_entry_id": "b1bbc36b-2cfa-3493-8f07-c524b77378f8",
                        "source_sense_id": "d3781806-ded8-3172-8490-7a5653d7ee1a",
                        "source_sense_description": "Künstler, der plastische Figuren herstellt",
                        "target_lang_word": "sculptor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sculptor",
