    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "872b8916-85d4-33d5-a4e2-b0f6a49138b8",
                "word": "nuchal",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c8107d37-a2d4-3550-96c1-cc13962b3dcb",
                        "entry_id": "872b8916-85d4-33d5-a4e2-b0f6a49138b8",
                        "glosses": [
                            "Of or pertaining to the back or nape of the neck."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bb447940-eb66-47e8-8e35-179ac6c83a6b",
                                "sense_id": "c8107d37-a2d4-3550-96c1-cc13962b3dcb",
                                "text": "What is the differential diagnosis of increased nuchal thickness? Although most fetuses with increased nuchal thickness are normal, the differential diagnosis of increased nuchal thickness includes an increased risk of fetal aneuploidy, particularly trisomy 21."
                            },
                            {
                                "example_id": "45452b9a-4e44-47c2-87ad-e09403b24f8c",
                                "sense_id": "c8107d37-a2d4-3550-96c1-cc13962b3dcb",
                                "text": "Nuchal thickness was the first sonographic marker associated with an increased risk of trisomy 21 in the fetus and is now accepted as the single most sensitive and specific marker for the detection of DS in the second trimester, in high- and low-risk pregnancies."
                            },
                            {
                                "example_id": "f5edfc17-c0e5-425b-88e8-072521cc4aef",
                                "sense_id": "c8107d37-a2d4-3550-96c1-cc13962b3dcb",
                                "text": "Many particulars of the nuchal torus region and nuchal plane are preserved (see Caspari, 1991 for further details, our description replies heavily on Caspari's work)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "170fc7cd-24ac-46bf-a38c-5b4c25381d9d",
                        "source_entry_id": "872b8916-85d4-33d5-a4e2-b0f6a49138b8",
                        "source_sense_id": "c8107d37-a2d4-3550-96c1-cc13962b3dcb",
                        "source_sense_description": "of or pertaining to the back of the neck",
