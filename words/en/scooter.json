{
    "word_family": [
        "scoot",
        "scooting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "592cd199-5c1b-3b87-8036-1eb4e586b91d",
                    "sense_definition": "A human-powered land vehicle with a handlebar, deck, and wheels that is propelled by a rider pushing off the ground.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "scooter_vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young boy received a shiny red <w>scooter</w> for his birthday.",
                            "target_lang_translations": {
                                "ru": "Маленький мальчик получил на день рождения блестящий красный <w>самокат</w>."
                            }
                        },
                        {
                            "text": "She decided to <w>ride</w> a <w>scooter</w> to the park instead of walking.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>поехать</w> в парк на <w>самокате</w> вместо того, чтобы идти пешком."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ride a scooter",
                        "kick scooter",
                        "push scooter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство, приводимое в движение человеком, с рулем, декой и колесами, которое движется за счет того, что водитель отталкивается ногой от земли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самокат",
                                "target_lang_sense_clarification": "обычный безмоторный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92cab952-fa4f-3515-813c-8546928d588a",
                    "sense_definition": "A small motorcycle with a step-through frame and a platform for the rider's feet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "scooter_vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He weaves through the heavy city traffic on his Italian <w>scooter</w>.",
                            "target_lang_translations": {
                                "ru": "Он лавирует в плотном городском потоке на своем итальянском <w>скутере</w>."
                            }
                        },
                        {
                            "text": "Renting a <w>motor</w> <w>scooter</w> is a popular way for tourists to explore the island.",
                            "target_lang_translations": {
                                "ru": "Аренда <w>мотороллера</w> — популярный среди туристов способ изучить остров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "motor scooter",
                        "gas scooter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой мотоцикл с низкой рамой и платформой для ног водителя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скутер",
                                "target_lang_sense_clarification": "мотороллер"
                            },
                            {
                                "target_lang_word": "мотороллер",
                                "target_lang_sense_clarification": "разновидность мотоцикла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47fb8c30-98a0-3a57-81f9-60b12709dbf9",
                    "sense_definition": "A motorized version of a kick scooter powered by electricity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "scooter_vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many commuters now use an <w>electric</w> <w>scooter</w> to get from the train station to the office.",
                            "target_lang_translations": {
                                "ru": "Многие офисные работники теперь используют <w>электросамокат</w>, чтобы добраться от вокзала до офиса."
                            }
                        },
                        {
                            "text": "You can unlock an <w>e-scooter</w> using a mobile app on your phone.",
                            "target_lang_translations": {
                                "ru": "Вы можете разблокировать <w>электросамокат</w> с помощью мобильного приложения на телефоне."
                            }
                        }
                    ],
                    "synonyms": [
                        "e-scooter",
                        "motorized scooter"
                    ],
                    "common_phrases": [
                        "electric scooter",
                        "e-scooter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Моторизованная версия самоката, работающая на электричестве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электросамокат",
                                "target_lang_sense_clarification": "электрический самокат"
                            },
                            {
                                "target_lang_word": "электроскутер",
                                "target_lang_sense_clarification": "электрическое средство передвижения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6e2f392-09d3-35f2-aafd-3e8167c2e0aa",
                    "sense_definition": "An electric-powered vehicle specifically designed to assist people with restricted mobility.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scooter_vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The supermarket provides a <w>mobility</w> <w>scooter</w> for customers who have difficulty walking.",
                            "target_lang_translations": {
                                "ru": "Супермаркет предоставляет <w>скутер для инвалидов</w> покупателям, которым трудно ходить."
                            }
                        },
                        {
                            "text": "She uses a <w>scooter</w> to maintain her independence while running errands.",
                            "target_lang_translations": {
                                "ru": "Она использует <w>средство передвижения</w>, чтобы сохранять независимость, занимаясь делами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mobility scooter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрическое транспортное средство, специально разработанное для помощи людям с ограниченной подвижностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скутер для инвалидов",
                                "target_lang_sense_clarification": "средство передвижения для маломобильных граждан"
                            },
                            {
                                "target_lang_word": "инвалидная коляска",
                                "target_lang_sense_clarification": "с электроприводом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77b3f6f4-6eaa-39c6-b879-d86ab993c6ba",
                    "sense_definition": "A pair of shorts with a fabric panel in front to make them look like a skirt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school uniform policy requires girls to wear a navy blue <w>scooter</w>.",
                            "target_lang_translations": {
                                "ru": "Правила школьной формы требуют, чтобы девочки носили темно-синюю <w>юбку-шорты</w>."
                            }
                        },
                        {
                            "text": "This <w>scooter</w> <w>skirt</w> is perfect for playing sports while looking professional.",
                            "target_lang_translations": {
                                "ru": "Эта <w>юбка-шорты</w> идеально подходит для занятий спортом, сохраняя при этом профессиональный вид."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scooter skirt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шорты с тканевой панелью спереди, благодаря которой они выглядят как юбка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "юбка-шорты",
                                "target_lang_sense_clarification": "предмет одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "667bdd10-9e37-335b-ba63-f906c59e7c9b",
                    "sense_definition": "A motorized device used by scuba divers to move underwater more easily.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scooter_vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diver used a <w>water</w> <w>scooter</w> to reach the deep reef more quickly.",
                            "target_lang_translations": {
                                "ru": "Дайвер использовал <w>подводный скутер</w>, чтобы быстрее добраться до глубокого рифа."
                            }
                        },
                        {
                            "text": "Professional explorers often rely on a <w>diver</w> <w>propulsion</w> <w>vehicle</w> for long cave dives.",
                            "target_lang_translations": {
                                "ru": "Профессиональные исследователи часто полагаются на <w>подводный буксировщик</w> при длительных погружениях в пещеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "water scooter",
                        "DPV",
                        "diver propulsion vehicle"
                    ],
                    "common_phrases": [
                        "water scooter",
                        "underwater scooter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used within the diving community"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Моторизованное устройство, используемое дайверами для более легкого передвижения под водой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подводный скутер",
                                "target_lang_sense_clarification": "буксировщик для дайвинга"
                            },
                            {
                                "target_lang_word": "гидроцикл",
                                "target_lang_sense_clarification": "водный мотоцикл"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec90e50e-e0f3-3b30-a89c-dc128e274d9f",
                    "sense_definition": "To travel or move by using a scooter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children <w>scootered</w> down the sidewalk toward the ice cream shop.",
                            "target_lang_translations": {
                                "ru": "Дети <w>поехали на самокатах</w> по тротуару к магазину мороженого."
                            }
                        },
                        {
                            "text": "He <w>scootered</w> to work every day during the summer months.",
                            "target_lang_translations": {
                                "ru": "В летние месяцы он каждый день <w>ездил</w> на работу на <w>самокате</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scoot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ездить или передвигаться на самокате или скутере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кататься на самокате",
                                "target_lang_sense_clarification": "или на скутере"
                            },
                            {
                                "target_lang_word": "ехать на самокате",
                                "target_lang_sense_clarification": "использовать самокат как транспорт"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cc04e4be-2c4c-39d4-bf17-5748cb2b3d77",
                    "sense_definition": "A nickname given to a male person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Everyone in the neighborhood knew him as <w>Scooter</w> because of how fast he ran.",
                            "target_lang_translations": {
                                "ru": "Все в округе знали его под кличкой <w>Скутер</w> из-за того, как быстро он бегал."
                            }
                        },
                        {
                            "text": "The coach called out to <w>Scooter</w> to get ready for the next play.",
                            "target_lang_translations": {
                                "ru": "Тренер крикнул <w>Скутеру</w>, чтобы тот готовился к следующей подаче."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal nickname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозвище, даваемое мужчине или мальчику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Скутер",
                                "target_lang_sense_clarification": "имя собственное, кличка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}