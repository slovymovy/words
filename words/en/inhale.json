{
    "word_family": [
        "inhalation",
        "inhaler",
        "inhalant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4bd2000b-d7ee-3e7a-96a6-10b2fcf971b0",
                    "sense_definition": "To draw air into the lungs through the nose or mouth.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor told the patient to <w>inhale</w> deeply and then hold their breath.",
                            "target_lang_translations": {
                                "ru": "Врач сказал пациенту <w>вдохнуть</w> глубоко, а затем задержать дыхание."
                            }
                        },
                        {
                            "text": "It is important to <w>inhale</w> fresh air when you are feeling stressed.",
                            "target_lang_translations": {
                                "ru": "Важно <w>вдыхать</w> свежий воздух, когда вы чувствуете стресс."
                            }
                        }
                    ],
                    "synonyms": [
                        "breathe in"
                    ],
                    "antonyms": [
                        "exhale"
                    ],
                    "common_phrases": [
                        "inhale deeply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Втягивать воздух в легкие через нос или рот."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдыха́ть",
                                "target_lang_sense_clarification": "процесс втягивания воздуха (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "вдохну́ть",
                                "target_lang_sense_clarification": "однократное действие втягивания воздуха (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93d02529-d21c-309e-a2b0-b787e92a94dd",
                    "sense_definition": "To breathe in a gas, smoke, or scent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers had to wear masks so they would not <w>inhale</w> toxic dust.",
                            "target_lang_translations": {
                                "ru": "Рабочим приходилось носить маски, чтобы не <w>вдыхать</w> токсичную пыль."
                            }
                        },
                        {
                            "text": "She stopped to <w>inhale</w> the sweet scent of the flowers in the garden.",
                            "target_lang_translations": {
                                "ru": "Она остановилась, чтобы <w>вдохнуть</w> сладкий аромат цветов в саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "inspire"
                    ],
                    "antonyms": [
                        "exhale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Втягивать в себя газ, дым или запах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдыха́ть",
                                "target_lang_sense_clarification": "втягивать в себя что-либо вместе с воздухом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b83e36b-e28b-3679-8231-5f458813b615",
                    "sense_definition": "To eat food very quickly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry children began to <w>inhale</w> their lunch as soon as it was served.",
                            "target_lang_translations": {
                                "ru": "Голодные дети начали <w>заглатывать</w> свой обед, как только его подали."
                            }
                        },
                        {
                            "text": "He was so busy that he had to <w>inhale</w> his sandwich in under two minutes.",
                            "target_lang_translations": {
                                "ru": "Он был так занят, что ему пришлось <w>заглотить</w> свой сэндвич меньше чем за две минуты."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used informally to describe eating very fast."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Есть пищу очень быстро (разговорное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уплетать",
                                "target_lang_sense_clarification": "есть с аппетитом и быстро"
                            },
                            {
                                "target_lang_word": "заглатывать",
                                "target_lang_sense_clarification": "есть очень быстро, почти не жуя"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe175168-84f8-3476-8475-33ad4faffcd5",
                    "sense_definition": "The act of breathing air into the lungs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With every <w>inhale</w>, she felt her chest expand.",
                            "target_lang_translations": {
                                "ru": "С каждым <w>вдохом</w> она чувствовала, как расширяется её грудная клетка."
                            }
                        },
                        {
                            "text": "Focus on the rhythm of your <w>inhale</w> and exhale during meditation.",
                            "target_lang_translations": {
                                "ru": "Сосредоточьтесь на ритме своего <w>вдоха</w> и выдоха во время медитации."
                            }
                        }
                    ],
                    "antonyms": [
                        "exhale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт втягивания воздуха в легкие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдох",
                                "target_lang_sense_clarification": "существительное, обозначающее процесс втягивания воздуха"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}