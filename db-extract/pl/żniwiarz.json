                        "translation_id": "804546e1-6922-45bb-a3d2-2cbaeabbbe32",
                        "source_entry_id": "8019d89c-638d-385c-9e1a-24c43a451011",
                        "source_sense_id": "f384d79c-f240-3538-b247-a5544abf9fa7",
