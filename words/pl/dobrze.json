            "senses": [
                {
                    "sense_id": "42d5b9a3-b2f0-3b2b-8249-292c3f19fffb",
                    "sense_definition": "W sposób właściwy, poprawny, zgodny z zasadami lub oczekiwaniami.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Twój syn bardzo <dobrze> się uczy w nowej szkole.",
