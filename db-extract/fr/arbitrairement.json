                        "sense_id": "a9553f24-c50a-3138-8060-c617c2b58a7f",
                        "entry_id": "73bac7ec-91c1-3349-b1be-eedfb51880d3",
                        "glosses": [
                            "D’une façon arbitraire, avec un parti pris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19c88172-6247-481c-a96f-2f853eda30bc",
                                "sense_id": "a9553f24-c50a-3138-8060-c617c2b58a7f",
                                "text": "Gouverner arbitrairement."
                            },
                            {
                                "example_id": "8d61e521-c7a1-4101-a0df-421e4ef4a30b",
                                "sense_id": "a9553f24-c50a-3138-8060-c617c2b58a7f",
                                "text": "Mais la situation de \"Bois\" entre un substantif et un qualificatif qu’il séparait arbitrairement lui était une épine dans la chair."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bddd2f26-2a51-413f-b372-31b12dcb6d35",
                        "source_entry_id": "73bac7ec-91c1-3349-b1be-eedfb51880d3",
                        "source_sense_id": "a9553f24-c50a-3138-8060-c617c2b58a7f",
                        "target_lang_word": "arbitrarily",
