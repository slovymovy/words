                                        "sense_id": "d1479929-c6a7-33da-96ff-309ec3ed5c10",
                                        "entry_id": "c9db05cd-0bc0-31e9-8be6-6fbee7047c1d",
                                        "glosses": [
                                            "etwas sagen, Sprache von sich geben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "875af78e-cd84-4903-a19b-7ab02cecf06e",
                                                "sense_id": "d1479929-c6a7-33da-96ff-309ec3ed5c10",
                                                "text": "Sie redet gerne über Politik."
                                            },
                                            {
                                                "example_id": "c93fdca9-c3b3-4545-ab97-f73bf1eff2a7",
                                                "sense_id": "d1479929-c6a7-33da-96ff-309ec3ed5c10",
                                                "text": "Die Freunde redeten bis spät in die Nacht."
                                            },
                                            {
                                                "example_id": "33ba8da2-9387-4ba0-973c-a087d2dabc1e",
                                                "sense_id": "d1479929-c6a7-33da-96ff-309ec3ed5c10",
                                                "text": "Florian redet viel, wenn der Tag lang ist."
                                            },
                                            {
                                                "example_id": "17a69d3a-83d1-4d3b-b6d1-0b760c02d7e1",
                                                "sense_id": "d1479929-c6a7-33da-96ff-309ec3ed5c10",
                                                "text": "Rede doch nicht solchen Unsinn!"
                                            },
                                            {
                                                "example_id": "c1e2b09e-233f-494c-ae17-916bcb27d1fa",
                                                "sense_id": "d1479929-c6a7-33da-96ff-309ec3ed5c10",
                                                "text": "Jetzt rede schon!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
