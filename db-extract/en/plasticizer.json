                "senses": [
                    {
                        "sense_id": "9df989ab-ce44-3008-99ff-1f6314583810",
                        "entry_id": "ccb57836-a62b-3af0-87ba-3bc8185aae7a",
                        "glosses": [
                            "Any of various substances added to a material (such as plastic or concrete) in order to make it more pliable."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "617e4ff9-ed2f-4c21-88ba-c29023e787e6",
                        "source_entry_id": "ccb57836-a62b-3af0-87ba-3bc8185aae7a",
                        "source_sense_id": "9df989ab-ce44-3008-99ff-1f6314583810",
                        "source_sense_description": "substance added for pliability in plastics",
                        "target_lang_word": "weekmaker",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weekmaker",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4fc53da1-f348-30d2-ac3b-7b392dbc4c80",
                                        "entry_id": "7e41a5f0-42de-3096-9879-e571822f3f43",
                                        "glosses": [
                                            "een stof met een lage molecuulmassa die toegvoegd wordt aan een amorfe kunststof om het glaspunt ervan te verlagen"
                                        ],
                                        "tags": [
                                            "materiaalkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c976661d-2fac-430f-832d-7714819d316a",
                                                "sense_id": "4fc53da1-f348-30d2-ac3b-7b392dbc4c80",
                                                "text": "Zonder weekmakers zouden veel kunststoffen niet verwerken en te bros voor gebruik zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d65e9087-d3d0-47c1-8ee9-d0aac6691a2c",
                        "source_entry_id": "ccb57836-a62b-3af0-87ba-3bc8185aae7a",
                        "source_sense_id": "9df989ab-ce44-3008-99ff-1f6314583810",
                        "source_sense_description": "substance added for pliability in plastics",
                        "target_lang_word": "Weichmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weichmacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                        "entry_id": "797afb98-faba-3217-9b66-f3f4d20ff805",
                                        "glosses": [
                                            "Stoff, der Materialien (beispielsweise Kunststoffen, Kautschuk, Lacken) zugesetzt wird, um diese biegsam, weich, geschmeidig, fließfähig zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68cff95f-5802-415a-91b3-68b626eb9684",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Phthalate zählen zu den schwerflüchtigen organischen Verbindungen (SVOC) und werden als Weichmacher u.a. in PVC, Farben, Lacken und Kunststoffen eingesetzt.“"
                                            },
                                            {
                                                "example_id": "97477801-cc88-491a-b48d-d1cc71939ff9",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Laut einer US-Forscherin können Phthalate Männer zeugungsunfähig machen. Dabei handelt es sich um Weichmacher, die in Kunststoffen verwendet werden.“"
                                            },
                                            {
                                                "example_id": "1f7a3233-3a61-4be2-9a31-06a16b66fd0e",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Weichmacher gasen beispielsweise aus PVC-Bodenbelägen oder Vinylschaum-Tapeten aus.“"
                                            },
                                            {
                                                "example_id": "3b7aa2af-8ebd-4df9-a2e5-f7a2658f3ed6",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„PVC-Bodenbeläge enthalten immer Weichmacher; (Vinyl)schaumtapeten ebenso.“"
                                            },
                                            {
                                                "example_id": "6d8983cb-dcf7-4a43-ac47-cd8f2f78dda9",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Auch einige Kunststoffe, Farben, Gummi und Klebstoff enthalten teilweise Weichmacher, um sie biegsam, weich oder dehnbar zu machen.“"
                                            },
                                            {
                                                "example_id": "ad280e09-4f2a-48ce-aefc-b337a681349d",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Lassen Sie sich beim Kauf von Bauprodukten die Datenblätter zeigen oder fragen Sie den Hersteller, ob die Produkte schädliche Stoffe wie Weichmacher enthalten.“"
                                            },
                                            {
                                                "example_id": "4c63d66b-f501-4f46-8c17-8953aa03918e",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Polyvinylchlorid: PVC kann unterschiedliche Formen annehmen, weich oder hart. Damit der Kunststoff weich und elastisch ist, werden Weichmacher dazu gemischt.“"
                                            },
                                            {
                                                "example_id": "8b8456c5-b2de-4b88-bec9-e0bbb3e74e1f",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Phthalate und Bisphenole sind Substanzen, welche die Industrie als Weichmacher in einer Vielzahl von Kunststoffen verwendet: in Plastikspielzeug, Kunststoffbechern, aber auch in Laminatböden und Kleidern.“"
                                            },
                                            {
                                                "example_id": "3599c3b5-d5e3-4537-8138-bec217a53936",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "[Schlagzeile:] „Wie gefährlich ist der Weichmacher DNHP?“"
                                            },
                                            {
                                                "example_id": "a699407d-e1db-463b-a68e-6bb232affb5e",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Bei Kontrollen haben Forscher in zahlreichen Urinproben von Kindern und Erwachsenen ein Abbauprodukt des Weichmachers DNHP gefunden.“"
                                            },
                                            {
                                                "example_id": "bdffafb0-40ff-4cdd-ae56-26e1b4b7aa28",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Der fortpflanzungsschädigende Weichmacher \"DnHexP\" ist in Deutschland weitgehend verboten. Und doch taucht er bei einer aktuellen Untersuchung des Umweltbundesamtes in fast einem Drittel der Urinproben auf.“"
                                            },
                                            {
                                                "example_id": "87d4cf86-5694-4eee-9497-4cdf035e9c99",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Weichmacher entweichen im Laufe der Zeit aus dem Kunststoff. Sie gelangen in Umwelt und Nahrung und werden damit letztendlich auch vom Menschen aufgenommen.“"
                                            },
                                            {
                                                "example_id": "308d05f9-c3af-44ff-92cb-bc30a807d539",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Die Ergebnisse unserer Untersuchungen zeigen dennoch, dass die neu eingesetzten Weichmacher häufiger und in sehr viel höheren Konzentrationen im Innenraum als vor einigen Jahren vorkommen.“"
                                            },
                                            {
                                                "example_id": "2908d7b4-0c05-4b26-ab6c-66329bade3df",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Der Ersatz von DEHP durch phthalatfreie Weichmacher ist nicht unproblematisch.“"
                                            },
                                            {
                                                "example_id": "7e5346b3-ced9-44bb-ace6-9461a0571035",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Durch die Differenzierung des früher sehr überschaubaren Weichmacher-Marktes steigt die Zahl der Weichmacher, die in einem einzelnen Produkt eingesetzt werden können.“"
                                            },
                                            {
                                                "example_id": "c4dd32ad-f0be-4b2b-b6ff-cffd616c9fd0",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Auf viele Weichmacher will die Industrie aber nicht verzichten, und die EU-Behörde ist nicht über alle Anwendungen informiert: «Ja, es gibt Probleme bei der Kontrolle», gibt Bjorn Hansen unumwunden zu.“"
                                            },
                                            {
                                                "example_id": "08828894-7833-4b43-aec7-df3e90b13153",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "[Kinderspielzeug:] „Schwermetalle in Plastikautos, Weichmacher in Kuscheltieren, Formaldehyd in Holzspielzeug - versteckte Gifte können sich nicht nur addieren, sondern potenzieren - und krankmachen.“"
                                            },
                                            {
                                                "example_id": "6c12b0e0-c4a9-4326-82bd-e935db473761",
                                                "sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                                                "text": "„Trotz der Bezeichnung „Polyethylenterephthalat“ (PET) enthalten PET-Flaschen keine Weichmacher in Form von Phthalaten, die als Xenohormone fungieren können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
