                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8f2bea1-d7b5-435d-b694-7eadd11e0c1a",
                                "sense_id": "de22d49f-5020-3dfd-ac08-02392473d591",
                                "text": "„Das AG. hob die Pfändung auf, weil die Pfandgegenstände zur Fortsetzung des von der Frau Cz. betriebenen Altwarenhandels unentbehrlich seien.“"
                            },
                            {
                                "example_id": "01b89326-5f74-4f4b-bbec-40028710e8cf",
                                "sense_id": "de22d49f-5020-3dfd-ac08-02392473d591",
                                "text": "„Als Soldat aus dem Ersten Weltkrieg zurückgekehrt, verdiente Max Seligmann im Altwarenhandel den Lebensunterhalt für sich und seine Familie.“"
                            }
                        ],
