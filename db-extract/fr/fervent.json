                ],
                "senses": [
                    {
                        "sense_id": "a8380a82-be0f-3fbf-98f9-50a0828cf0c0",
                        "entry_id": "ec6ac57d-4796-3de9-b331-500be8831148",
                        "glosses": [
                            "Quelqu’un qui admire, qui a de la ferveur pour quelque chose ou quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "853c72b6-c3e8-434c-bb69-3e2f36356a71",
                                "sense_id": "a8380a82-be0f-3fbf-98f9-50a0828cf0c0",
                                "text": "Par un savant jeu d’avances et de compensations, ils laissaient successivement croire aux fervents des deux partis qu’ils étaient leurs hommes pourvu toutefois que le confident eût provoqué cet aveu par l’offre de deux ou trois bouteilles de picolo de l’année […]."
                            },
                            {
                                "example_id": "330f4686-d0c2-4e04-bad1-471a31fa6210",
                                "sense_id": "a8380a82-be0f-3fbf-98f9-50a0828cf0c0",
                                "text": "À une étape donnée, il a dû y avoir un fervent d’opéra bouffe chez les découvreurs, car nous avons un groupe d’astéroïdes nommés Turandot, Zerlina, Pamina, Senta, Kundry, Norma, Violetta, Aida et Carmen tous découverts à peu près à la même époque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cb78122-749e-41bf-be34-da68f05df171",
                        "source_entry_id": "ec6ac57d-4796-3de9-b331-500be8831148",
                        "source_sense_id": "a8380a82-be0f-3fbf-98f9-50a0828cf0c0",
                        "target_lang_word": "Verehrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verehrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d192853-3a6f-3100-94d7-340ef59e9577",
                                        "entry_id": "45f0bedd-45e1-374d-9919-3f736c21e7f6",
                                        "glosses": [
                                            "jemand, der jemanden anderen (oft heimlich) liebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc8fd43-e6b0-44f1-9030-4b34a33a14b3",
                                                "sense_id": "3d192853-3a6f-3100-94d7-340ef59e9577",
                                                "text": "Sie zur Freundin: „Ich habe einen heimlichen Verehrer - und er dichtet mir in seinen Liebesbriefen!“"
                                            },
                                            {
                                                "example_id": "b881aa30-5b3a-496c-8caf-ae1d08bb6c3a",
                                                "sense_id": "3d192853-3a6f-3100-94d7-340ef59e9577",
                                                "text": "„Der Oberarzt kannte niemanden namens Hamsun und glaubte, es wäre ein Verehrer von ihr.“"
                                            },
                                            {
                                                "example_id": "e020a4b9-5574-4680-8581-1dcee3f5fd04",
                                                "sense_id": "3d192853-3a6f-3100-94d7-340ef59e9577",
                                                "text": "übertragen: „Nun war dieser brave Lehrer / Auch dem Tobak ein Verehrer.“ -(Wilhelm Busch, „Max und Moritz“)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18f9ce44-7324-3c52-8406-acbe368d1e8d",
                                        "entry_id": "45f0bedd-45e1-374d-9919-3f736c21e7f6",
                                        "glosses": [
                                            "jemand, der jemand anderen bewundert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bb41ed7-5c6f-4f50-bac9-6fe64cf4354a",
                                                "sense_id": "18f9ce44-7324-3c52-8406-acbe368d1e8d",
                                                "text": "„Ich bin ein Verehrer dieses Autors.“"
                                            },
                                            {
                                                "example_id": "b968fcd2-59e5-46eb-93ae-a913c5a0fbab",
                                                "sense_id": "18f9ce44-7324-3c52-8406-acbe368d1e8d",
                                                "text": "übertragen: „Nun war dieser brave Lehrer / Auch dem Tobak ein Verehrer.“ -(Wilhelm Busch, „Max und Moritz“)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed00efcb-7896-4d2a-99a7-4cbfc61d0b20",
                        "source_entry_id": "ec6ac57d-4796-3de9-b331-500be8831148",
