                                                "example_id": "d0db97c1-d7b3-42f2-8a03-39b9971cfb2b",
                                                "sense_id": "dc6d4da3-de87-33ed-b219-6d6377f52d3c",
                                                "text": "Ces propositions ne tendent qu’à vous décevoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87394ba1-34be-3096-b669-397d13160133",
                                        "entry_id": "6d066701-f7f5-3627-b39d-c5083d9e355a",
                                        "glosses": [
                                            "Tromper quelqu’un dans son attente, son espérance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed9ad939-8b69-4ca8-87d7-19153681bb05",
                                                "sense_id": "87394ba1-34be-3096-b669-397d13160133",
                                                "text": "Il m’a déçu par sa manière d’agir."
                                            },
                                            {
                                                "example_id": "ac1b93c3-3d87-4591-b8d6-b9b8cfd56872",
                                                "sense_id": "87394ba1-34be-3096-b669-397d13160133",
                                                "text": "Tous ses espoirs ont été déçus."
                                            }
