    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "37e14794-1347-38a9-886e-8a79412796a4",
                    "sense_definition": "Incapable of being satisfied or appeased; constantly wanting more.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young executive had an <w>insatiable</w> appetite for success and worked late every single night.",
                            "target_lang_translations": {
                                "tr": "Genç yöneticinin başarıya karşı <w>doymak bilmez</w> bir iştahı vardı ve her gece geç saatlere kadar çalışıyordu."
                            }
                        },
                        {
                            "text": "Her <w>insatiable</w> curiosity about the universe led her to study astrophysics at university.",
                            "target_lang_translations": {
                                "tr": "Evrene dair <w>doyumsuz</w> merakı, onu üniversitede astrofizik okumaya yöneltti."
                            }
                        }
                    ],
                    "synonyms": [
                        "unquenchable",
                        "unsatisfiable",
                        "greedy"
                    ],
                    "antonyms": [
                        "satiable",
                        "satisfied"
                    ],
                    "common_phrases": [
                        "insatiable appetite",
                        "insatiable curiosity",
                        "insatiable desire"
                    ],
                    "target_lang_definitions": {
                        "tr": "Doyurulamaz, tatmin edilemez; sürekli daha fazlasını isteyen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "doyumsuz",
                                "target_lang_sense_clarification": "tatmin olmak bilmeyen"
                            },
                            {
                                "target_lang_word": "doymak bilmez",
                                "target_lang_sense_clarification": "sürekli daha fazlasını arzulayan"
                            },
                            {
                                "target_lang_word": "tatmin edilemez",
                                "target_lang_sense_clarification": "doyurulamayan"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2432029-2869-3a8d-afa3-42daf6ab7b8d",
                    "sense_definition": "A person or thing that cannot be satisfied.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When it comes to collecting rare books, he is one of the <w>insatiables</w> who will never stop buying.",
                            "target_lang_translations": {
                                "tr": "Nadir kitaplar toplamaya gelince, o asla satın almayı bırakmayacak <w>doyumsuz kişilerden</w> biridir."
                            }
                        },
                        {
                            "text": "The market proved to be an <w>insatiable</w>, consuming resources faster than we could produce them.",
                            "target_lang_translations": {
                                "tr": "Piyasa, kaynakları bizim üretebileceğimizden daha hızlı tüketen <w>doymak bilmez bir canavar</w> olduğunu gösterdi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Hiçbir şekilde tatmin veya doyurulamayan kişi veya şey."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "doyumsuz kimse",
                                "target_lang_sense_clarification": "asla yetinmeyen kişi"
                            },
                            {
                                "target_lang_word": "doymak bilmeyen şey",
                                "target_lang_sense_clarification": "tükenmeyen açlığı olan varlık"
                            }
                        ]
                    }
                }
            ]
        }
    ]
