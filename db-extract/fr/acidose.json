                ],
                "senses": [
                    {
                        "sense_id": "bfc431c9-4940-3f39-8c01-5cfa96a508c6",
                        "entry_id": "cc9f6307-550a-319b-beb9-fdd9c980dfe4",
                        "glosses": [
                            "État du sang qui présente une acidité excessive, son pH devient inférieur à 7.40."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0463d596-f170-4e82-9224-08bc0f5b9817",
                                "sense_id": "bfc431c9-4940-3f39-8c01-5cfa96a508c6",
                                "text": "Acidose métabolique, acidose respiratoire."
                            },
                            {
                                "example_id": "77e23beb-d91b-4ba0-b4b6-9ed5ba840be4",
                                "sense_id": "bfc431c9-4940-3f39-8c01-5cfa96a508c6",
                                "text": "Les formes chroniques liées à une acidose latente sont plus difficiles à reconnaître et ce sont plus les complications entraînant des pertes de productions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fa83ddd-0d06-46fb-b92a-a2ca1b3225d8",
                        "source_entry_id": "cc9f6307-550a-319b-beb9-fdd9c980dfe4",
                        "source_sense_id": "bfc431c9-4940-3f39-8c01-5cfa96a508c6",
                        "target_lang_word": "Azidose",
