                                                "sense_id": "bc6ef581-8dbd-3eef-bbd5-382774306403",
                                                "text": "Wydaje się, że Jeremiasz, trzymany samotnie w więzieniu, wykorzystał wizytę Barucha, by powierzyć mu dokumenty prawne."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "eb849eb7-4c69-3188-92c3-f16819c6c2d4",
