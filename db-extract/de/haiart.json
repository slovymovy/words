                "senses": [
                    {
                        "sense_id": "25724824-f296-3e4c-8126-4f8e88e0d08c",
                        "entry_id": "38f7c447-6447-3b62-8b8e-3511dc2a795c",
                        "glosses": [
                            "von anderen Haifischen nach bestimmten Merkmalen abgegrenzte Gruppe von Haien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3f9867d-8033-463a-855f-c4147d8c6e25",
                                "sense_id": "25724824-f296-3e4c-8126-4f8e88e0d08c",
                                "text": "„Diese Haiart hält sich bevorzugt in Bodennähe auf.“"
                            },
                            {
                                "example_id": "a53e33df-71c9-4da7-9ec7-a502bd637478",
                                "sense_id": "25724824-f296-3e4c-8126-4f8e88e0d08c",
                                "text": "„Um welche Haiart es sich bei dem angreifenden Tier gehandelt habe, sei unklar.“"
                            },
                            {
                                "example_id": "df9c8e63-fb5d-40ee-8803-7022a7db8bdc",
                                "sense_id": "25724824-f296-3e4c-8126-4f8e88e0d08c",
                                "text": "„Bis die Weibchen dieser Haiart fähig sind, sich fortzupflanzen, sind sie ungefähr 150 Jahre alt.“"
                            },
                            {
                                "example_id": "1ff956ef-9752-412e-92ea-17a3f8631250",
                                "sense_id": "25724824-f296-3e4c-8126-4f8e88e0d08c",
                                "text": "„Im Jahr 2017 hatte ein chinesisches Fischerboot eine seltene Haiart vor den Galapagosinseln gefangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
