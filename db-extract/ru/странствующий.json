                                "target_senses": [
                                    {
                                        "sense_id": "8aa22421-e9af-39cf-a14f-a929d70fab03",
                                        "entry_id": "65a1be00-7ae3-3f4e-9513-059b9bf55aba",
                                        "glosses": [
                                            "Straying from the proper course or standard, or outside established limits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28682ad2-bde5-4770-9b1c-1226835a0257",
                                                "sense_id": "8aa22421-e9af-39cf-a14f-a929d70fab03",
                                                "text": "In that there are just seven Planets or errant Stars in the lower Orbs of heaven: but it is now demonstrable unto sense, that there are many more"
                                            },
                                            {
                                                "example_id": "9872c562-68cc-460a-8d38-f53d025591fd",
                                                "sense_id": "8aa22421-e9af-39cf-a14f-a929d70fab03",
                                                "text": "They were all doomed to be disappointed, however, for the errant engine decided at Stanley junction to spend the remainder of its crowded hour of freedom on the Aberdeen line, and finally came to rest, short of breath, in the dip between Ballathie and Cargill, near the bridge over the Tay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88c2ef61-f29f-3803-8052-6f810f23c852",
                                        "entry_id": "65a1be00-7ae3-3f4e-9513-059b9bf55aba",
                                        "glosses": [
                                            "Roving around; wandering."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d859d4e-937f-3f32-b12f-6d13763c7106",
                                        "entry_id": "65a1be00-7ae3-3f4e-9513-059b9bf55aba",
                                        "glosses": [
                                            "Prone to err or making errors; misbehaving."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d6e0e2e-fd5a-4ddb-998c-7e7acac655bf",
                                                "sense_id": "8d859d4e-937f-3f32-b12f-6d13763c7106",
                                                "text": "We ran down the street in pursuit of the errant dog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "387262a7-83e1-3545-bfcf-a615a0a19a53",
                                        "entry_id": "65a1be00-7ae3-3f4e-9513-059b9bf55aba",
                                        "glosses": [
                                            "Obsolete form of arrant (“complete; downright, utter”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5640cb8f-89e6-4ee1-90c9-550928c5804a",
                                                "sense_id": "387262a7-83e1-3545-bfcf-a615a0a19a53",
                                                "text": "Thy company, if I slept not very well / A nights, would make me an errant fool […]"
                                            }
                                        ]
                                    }
