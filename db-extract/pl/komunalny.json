                                                "example_id": "ebfb5cc4-4715-45fb-8eed-d2f607721714",
                                                "sense_id": "5f265801-f6d6-38f6-b344-80b969231506",
                                                "text": "More than 100 provincial and municipal firefighters were brought in, with helicopters and aircraft used to drop water and fire retardant, while bulldozers were digging firebreaks."
                                            }
