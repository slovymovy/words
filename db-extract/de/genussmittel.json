                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8d0dba2-b908-39dc-a73a-7cdf1185c895",
                        "entry_id": "393d2027-88bc-3329-a8df-1f5b2d62c361",
                        "glosses": [
                            "Nahrungsmittel, das aufgrund seines guten Geschmacks und nicht wegen der enthaltenen Nährwerte verzehrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ec1976-88ff-47cb-ba38-ccad0ca8c421",
                                "sense_id": "d8d0dba2-b908-39dc-a73a-7cdf1185c895",
                                "text": "„Bekannt ist Ethanol als Bestandteil von Genussmitteln und alkoholischen Getränken wie Wein, Bier und Likör.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1505d4a0-e624-43bf-a2d4-470df14c4055",
                        "source_entry_id": "393d2027-88bc-3329-a8df-1f5b2d62c361",
                        "source_sense_id": "d8d0dba2-b908-39dc-a73a-7cdf1185c895",
                        "source_sense_description": "Genussmittel",
                        "target_lang_word": "stimulant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stimulant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ff41ac6-8ff1-3dc6-bb4d-d5781029861f",
                                        "entry_id": "2c489ed4-8a4d-31ec-8870-68ee03a38f64",
                                        "glosses": [
                                            "A substance that acts to increase physiological or nervous activity in the body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14f2162-9cbc-49a3-b06c-a701ca97a6fe",
                                                "sense_id": "4ff41ac6-8ff1-3dc6-bb4d-d5781029861f",
                                                "text": "Milk of chameleon was recommended as an erotic stimulant by Avicenna."
                                            },
                                            {
                                                "example_id": "cffa3fe0-dfba-4923-8ea9-d1ebba053c06",
                                                "sense_id": "4ff41ac6-8ff1-3dc6-bb4d-d5781029861f",
                                                "text": "“Uppers” are what’s known as stimulants while “downers” are what is classified as depressants. […] Uppers increased cardiovascular and respiratory functions to dangerous degrees that can overwhelm the body. If you’ve ever felt an adrenaline rush before, you likely felt shaky, weak, or dizzy once it passed. This is similar to what stimulant drug users experience once a stimulant wears off. Feelings of exhaustion and depression set in and users seek more uppers to ward off what’s known as a “crash”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58769a9c-30d7-3606-bdbc-fb424a6a6dff",
                                        "entry_id": "2c489ed4-8a4d-31ec-8870-68ee03a38f64",
                                        "glosses": [
                                            "Something that promotes activity, interest, or enthusiasm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c6ba4d0-2df4-40cd-ba7d-3b42516d5674",
                                                "sense_id": "58769a9c-30d7-3606-bdbc-fb424a6a6dff",
                                                "text": "[T]ouching the much vexed question of stimulants he relished a glass of choice old wine in season as both nourishing and bloodmaking and possessing aperient virtues (notably a good burgundy which he was a staunch believer in) […]"
                                            },
                                            {
                                                "example_id": "22da10e2-4c84-4895-9179-c7bd98c7825d",
                                                "sense_id": "58769a9c-30d7-3606-bdbc-fb424a6a6dff",
                                                "text": "I was never to feel anything comparable under the influence of orthodox religious stimulants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stimulant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58a0bd89-3b80-30a7-902e-26c3b7f4e009",
                                        "entry_id": "c9bdc6c4-51d1-31d0-91e2-0ff8cf0e1a3c",
                                        "glosses": [
                                            "Acting as a stimulant."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f952808-1336-4cbb-8a11-314a0f4e084a",
                        "source_entry_id": "393d2027-88bc-3329-a8df-1f5b2d62c361",
                        "source_sense_id": "d8d0dba2-b908-39dc-a73a-7cdf1185c895",
                        "source_sense_description": "Genussmittel",
                        "target_lang_word": "stimulant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stimulant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e579dc9-d084-3ccf-ad98-47003312d49b",
                                        "entry_id": "07d89689-366a-318a-9ad9-1b11725854cc",
                                        "glosses": [
                                            "Qui excite, qui aiguillonne l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dbc320c-04e7-49c2-9b51-8f1f917e1186",
                                                "sense_id": "1e579dc9-d084-3ccf-ad98-47003312d49b",
                                                "text": "L’émulation est un stimulant qu’il faut employer à propos et avec précaution."
                                            },
                                            {
                                                "example_id": "9f7b5da8-ae63-41e0-adc0-5ffe157df238",
                                                "sense_id": "1e579dc9-d084-3ccf-ad98-47003312d49b",
                                                "text": "Il est assez porté à agir de la sorte, il n’a pas besoin de stimulants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64af943e-8d8d-31df-8763-07c1e52c5a4d",
                                        "entry_id": "07d89689-366a-318a-9ad9-1b11725854cc",
                                        "glosses": [
                                            "Ce qui est propre à exciter les fonctions organiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db8b17f-389e-493c-99c2-618afd827221",
                                                "sense_id": "64af943e-8d8d-31df-8763-07c1e52c5a4d",
                                                "text": "Il fournit également des glucides, dont certains, spécifiques à certaines espèces (shiitake et pleurotes), sont reconnus pour leur action stimulante du système immunitaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stimulant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf096d8-0e0b-3863-b79c-92b0cd9df767",
                                        "entry_id": "5064b394-d103-3afd-bdfe-860cc583d486",
                                        "glosses": [
                                            "Produit stimulant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98b9d1d9-4ab5-4f28-aa7d-bbe61e4beccf",
                                                "sense_id": "9cf096d8-0e0b-3863-b79c-92b0cd9df767",
                                                "text": "Avant leurs matchs, les joueurs russes ont sniffé de l’ammoniaque, un stimulant de l’oxygénation du sang reconnu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "996dec57-00e3-3cdb-804f-a20a361f0a6d",
                                        "entry_id": "5064b394-d103-3afd-bdfe-860cc583d486",
                                        "glosses": [
                                            "Action stimulante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bee7299-58b3-43a4-b653-5779c2b8fa66",
                                                "sense_id": "996dec57-00e3-3cdb-804f-a20a361f0a6d",
                                                "text": "Si le cheval n’a pas de l’âme, à chaque enjambée du garçon il est aiguillonné par la houssine ou le bâton qui agit adroitement, quand toutefois ce stimulant n’est pas remplacé par le claquement du fouet, […]."
                                            }
