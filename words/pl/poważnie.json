{
    "word_family": [
        "poważny",
        "powaga",
        "poważyć",
        "niepoważnie",
        "niepoważny"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "69adfa9d-22d3-3033-964f-8238a6057e4d",
                    "sense_definition": "W sposób odpowiedzialny, rozsądny, bez żartów lub lekkomyślności.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "serio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy porozmawiać o naszej przyszłości bardzo <w>poważnie</w>.",
                            "target_lang_translations": {
                                "ru": "Мы должны поговорить о нашем будущем очень <w>серьёзно</w>."
                            }
                        },
                        {
                            "text": "Młodzież akademicka traktuje bardzo <w>poważnie</w> problemy zagrożenia środowiska naturalnego.",
                            "target_lang_translations": {
                                "ru": "Студенческая молодёжь очень <w>серьёзно</w> относится к проблемам угрозы окружающей среде."
                            }
                        }
                    ],
                    "synonyms": [
                        "na serio",
                        "na poważnie",
                        "serio"
                    ],
                    "antonyms": [
                        "niepoważnie"
                    ],
                    "common_phrases": [
                        "traktować poważnie",
                        "rozmawiać poważnie",
                        "podejść poważnie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ответственно, разумно, без шуток или легкомыслия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серьёзно",
                                "target_lang_sense_clarification": "без шуток, ответственно"
                            },
                            {
                                "target_lang_word": "всерьёз",
                                "target_lang_sense_clarification": "основательно, по-настоящему"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20664c85-7919-30fb-99bb-38c82ab99a46",
                    "sense_definition": "W stopniu znacznym, głębokim lub niebezpiecznym; bardzo mocno.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stopien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój dziadek jest <w>poważnie</w> chory i musi leżeć w szpitalu.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка <w>тяжело</w> болен и должен лежать в больнице."
                            }
                        },
                        {
                            "text": "Wypadek samochodowy <w>poważnie</w> uszkodził cały przód pojazdu.",
                            "target_lang_translations": {
                                "ru": "Автомобильная авария <w>серьёзно</w> повредила всю переднюю часть машины."
                            }
                        }
                    ],
                    "synonyms": [
                        "nie na żarty"
                    ],
                    "common_phrases": [
                        "poważnie chory",
                        "poważnie uszkodzony",
                        "poważnie zagrożony"
                    ],
                    "target_lang_definitions": {
                        "ru": "В значительной, глубокой или опасной степени; очень сильно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серьёзно",
                                "target_lang_sense_clarification": "в значительной степени, опасно"
                            },
                            {
                                "target_lang_word": "тяжело",
                                "target_lang_sense_clarification": "о болезни"
                            },
                            {
                                "target_lang_word": "сильно",
                                "target_lang_sense_clarification": "о повреждениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cda388fc-012c-355a-b66a-a76a37c26024",
                    "sense_definition": "Używane jako wtrącenie lub pytanie mające na celu potwierdzenie prawdziwości słów; naprawdę.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "potwierdzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mówię zupełnie <w>poważnie</w>, wygraliśmy główną nagrodę na loterii!",
                            "target_lang_translations": {
                                "ru": "Я говорю совершенно <w>серьёзно</w>, мы выиграли главный приз в лотерее!"
                            }
                        },
                        {
                            "text": "Czy ty <w>poważnie</w> myślisz o przeprowadzce do innego kraju?",
                            "target_lang_translations": {
                                "ru": "Ты <w>серьёзно</w> думаешь о переезде в другую страну?"
                            }
                        }
                    ],
                    "synonyms": [
                        "serio",
                        "na serio"
                    ],
                    "common_phrases": [
                        "mówić poważnie",
                        "poważnie pytam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как вводное слово или вопрос для подтверждения истинности слов; действительно, на самом деле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серьёзно",
                                "target_lang_sense_clarification": "вводное слово, вопрос"
                            },
                            {
                                "target_lang_word": "всерьёз",
                                "target_lang_sense_clarification": "на полном серьёзе"
                            },
                            {
                                "target_lang_word": "правда",
                                "target_lang_sense_clarification": "в качестве вопроса или подтверждения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}