                    "frequency": "Low",
                    "semantic_group_id": "omhulsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zachte <w>huls</w> van de kastanje is bedekt met scherpe stekels.",
                            "target_lang_translations": {
