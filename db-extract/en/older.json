                                            {
                                                "example_id": "68735f54-f1f0-48f7-bd6f-8e78f86ecac0",
                                                "sense_id": "f2df9e17-7b05-32a4-9502-4e27f869da5e",
                                                "text": "Hoelang kan een mens eigenlijk zonder eten, zonder drinken? Ik hoor de stem van mijn moeder in mijn hoofd, die me als kind al vertelde hoe haar ouders hadden moeten overleven ir1 de concentratiekampen, in de kou, met honger en gebrek aan slaap."
                                            },
                                            {
                                                "example_id": "7dc2e7b3-1838-4e28-a64d-6b223bb77d44",
                                                "sense_id": "f2df9e17-7b05-32a4-9502-4e27f869da5e",
                                                "text": "De ouders hadden de kinderen van 10 en 12 na een hoop gedoe voor een halfjaar van school kunnen uitschrijven om gezamenlijk de PCT te lopen."
                                            },
                                            {
                                                "example_id": "551bf502-99e9-479a-a953-d7c8a54a2495",
                                                "sense_id": "f2df9e17-7b05-32a4-9502-4e27f869da5e",
                                                "text": "Steevast met het voornemen niemand, en zeker haar ouders niet, teleur te stellen."
                                            }
                                        ]
                                    }
                                ]
                            },
