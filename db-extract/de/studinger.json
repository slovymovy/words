                                "example_id": "f6447dbe-7710-43a9-a46b-1cb0f28ea53c",
                                "sense_id": "b1e30f4f-2436-38fd-b14b-38b23c8897fe",
                                "text": "„Das sagt Hans Studinger aus Waldshut.“"
                            },
                            {
                                "example_id": "996ae99b-e45a-4177-ac30-e879f2dc882e",
                                "sense_id": "b1e30f4f-2436-38fd-b14b-38b23c8897fe",
                                "text": "„Zumindest das von Johann Studinger, der sich früh dem Chancenverwerten verschreibt.“"
                            },
                            {
                                "example_id": "a554fa1e-b55c-4012-816a-3d89b42c4c11",
                                "sense_id": "b1e30f4f-2436-38fd-b14b-38b23c8897fe",
                                "text": "„Hans Studinger übernahm anno 1965 den Betrieb, welchen er 1993 an Hanspeter Studinger übergab“"
                            }
