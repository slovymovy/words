                                "example_id": "a506b065-2ecc-4d82-aba8-0e3ef618a714",
                                "sense_id": "75a7827e-147f-3837-81c4-a2e82ff0ca9d",
                                "text": "„Nach einer tagelangen Sperrung auf der Bahnstrecke zwischen Hamburg und Hannover ermittelt die Bundespolizei gegen zwei Hobbygärtner.“"
                            }
                        ],
