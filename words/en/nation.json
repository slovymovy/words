    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b87cb993-d056-3d4b-959a-496c8c66cc2f",
                    "sense_definition": "A sovereign state or country with its own government.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "political_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Representatives from every <w>nation</w> attended the global summit.",
                            "target_lang_translations": {
                                "ru": "Представители каждой <w>страны</w> посетили глобальный саммит.",
                                "zh": "来自每个<w>国家</w>的代表都出席了这次全球峰会。"
                            }
                        },
                        {
                            "text": "The <w>nation</w> celebrated its independence with a grand parade.",
                            "target_lang_translations": {
                                "ru": "<w>Нация</w> отпраздновала свою независимость грандиозным парадом.",
                                "zh": "这个<w>国家</w>举行了盛大的游行来庆祝独立。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "developing nation",
                        "independent nation",
                        "host nation",
                        "united nations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суверенное государство или страна с собственным правительством.",
                        "zh": "具有自己政府的主权国家。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страна",
                                "target_lang_sense_clarification": "территория с определенными границами и населением"
                            },
                            {
                                "target_lang_word": "государство",
                                "target_lang_sense_clarification": "политическая организация общества"
                            },
                            {
                                "target_lang_word": "нация",
                                "target_lang_sense_clarification": "в контексте международных отношений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "国家",
                                "target_lang_sense_clarification": "强调政治实体、主权和政府"
                            },
                            {
                                "target_lang_word": "主权国家",
                                "target_lang_sense_clarification": "强调具有独立主权的国家"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd5efac0-baf1-34b3-8377-0109c077ce69",
                    "sense_definition": "A large body of people united by common descent, history, culture, or language, inhabiting a particular country or territory.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president addressed the <w>nation</w> on live television last night.",
                            "target_lang_translations": {
                                "ru": "Президент обратился к <w>нации</w> в прямом телеэфире вчера вечером.",
                                "zh": "总统昨晚在电视直播中向<w>全国人民</w>发表了讲话。"
                            }
                        },
                        {
                            "text": "The entire <w>nation</w> mourned the loss of their beloved leader.",
                            "target_lang_translations": {
                                "ru": "Вся <w>нация</w> скорбела о потере своего любимого лидера.",
                                "zh": "全<w>国民</w>都为他们敬爱的领袖逝世而哀悼。"
                            }
