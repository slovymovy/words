        "pl-extract.jsonl": [
            {
                "entry_id": "fb85db84-998c-3a76-9f66-dcc873fdfda5",
                "word": "wodorost",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d6f61267-0a7d-39c8-9954-4281f35123e0",
                        "entry_id": "fb85db84-998c-3a76-9f66-dcc873fdfda5",
                        "glosses": [
                            "miękka roślina rosnąca w wodzie"
                        ],
                        "tags": [],
