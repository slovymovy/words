                "senses": [
                    {
                        "sense_id": "b85e14d0-a127-39fb-84cd-1ff80f28a99c",
                        "entry_id": "764e23fd-4b8f-3773-b0d9-33aedb696e5b",
                        "glosses": [
                            "Donner un caractère majoritaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9902386f-5377-43c6-b0bd-921f3b2059b5",
                                "sense_id": "b85e14d0-a127-39fb-84cd-1ff80f28a99c",
                                "text": "Attention, ce n'est que la première étape du processus qui doit conduire Duflot à l'Elysée ! Elle va majoritariser les Verts !"
                            },
                            {
                                "example_id": "b0f07e46-428e-4bf1-a742-2f8857a95dcb",
                                "sense_id": "b85e14d0-a127-39fb-84cd-1ff80f28a99c",
                                "text": "C’est la fameuse clause des 5% qui majoritarise davantage le scrutin mixte comme indiqué dans le chapitre 1."
                            },
                            {
                                "example_id": "78826159-c438-4e08-aeb0-efe9703e1772",
                                "sense_id": "b85e14d0-a127-39fb-84cd-1ff80f28a99c",
                                "text": "Même l'Ecolo Michel Quenon ne s'est pas employé à ébranler la députation permanente: La majorité est là pour «majoritariser», l'opposition pour «s'oppositionner»: que chacun garde son rôle!"
                            },
                            {
                                "example_id": "1959d40e-0405-4def-8da9-1ac8816e8c89",
                                "sense_id": "b85e14d0-a127-39fb-84cd-1ff80f28a99c",
                                "text": "Plus le FN se crédibilise et se majoritarise, moins certains auront le désir de changer le nom"
                            }
                        ]
                    }
