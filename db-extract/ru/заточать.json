                "senses": [
                    {
                        "sense_id": "f2a64cc7-e89e-3346-b1e9-8736a0cb74f3",
                        "entry_id": "072cb8f7-685e-3783-8b24-844cee3ff5e0",
                        "glosses": [
                            "подвергать заточению, лишить свободы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "027b20bc-a431-4222-98e2-d936a04fe06c",
                                "sense_id": "f2a64cc7-e89e-3346-b1e9-8736a0cb74f3",
                                "text": "Заточать в тюрьму. Заточать в монастырь."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d2ebd93-6eae-44e3-a2b0-54bb416d2fb8",
                        "source_entry_id": "072cb8f7-685e-3783-8b24-844cee3ff5e0",
                        "source_sense_id": "f2a64cc7-e89e-3346-b1e9-8736a0cb74f3",
                        "target_lang_word": "enfermer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfermer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3a19762-e544-3b4d-86e7-ec5137437198",
                                        "entry_id": "4f591b61-1d32-31b6-adac-de62bc809e1b",
                                        "glosses": [
                                            "Mettre quelqu’un ou quelque chose dans un lieu fermé de tous côtés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2c324e5-b0ed-4d85-a5d8-ba4753724d89",
                                                "sense_id": "b3a19762-e544-3b4d-86e7-ec5137437198",
                                                "text": "De la petite chambre où j’étais enfermé avec ma bonne, le front contre la vitre, à travers les persiennes fermées, je regardais des pauvresses s’accroupir sur la pelouse, un cierge à la main, et marmotter des oraisons […]"
                                            },
                                            {
                                                "example_id": "d069f954-c4e4-4932-999b-cda441d35107",
                                                "sense_id": "b3a19762-e544-3b4d-86e7-ec5137437198",
                                                "text": "Les hydrocarbures imprègnent les sables généralement disposés en lentilles, les argiles et les marnes jouent le rôle d’isolants enfermant les masses à l'intérieur desquelles s'est effectuée la fermentation du sapropel."
                                            },
                                            {
                                                "example_id": "1739e6af-6d54-43c8-966e-a0b4944937fa",
                                                "sense_id": "b3a19762-e544-3b4d-86e7-ec5137437198",
                                                "text": "Enfermer des chevaux dans une écurie. — Enfermer entre quatre murs, dans une cage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a3bae46-84ce-3aed-8ece-0993af2fc7c4",
                                        "entry_id": "4f591b61-1d32-31b6-adac-de62bc809e1b",
                                        "glosses": [
                                            "Mettre quelqu’un dans un asile psychiatrique, dans une prison, dans un couvent, etc."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "166a6192-574e-43a5-9051-cd7067d6b09b",
                                                "sense_id": "9a3bae46-84ce-3aed-8ece-0993af2fc7c4",
                                                "text": "[…], Rinaldi expliquait si gaiement comme quoi, son père le destinant à la moinaille, on l’avait enfermé en un couvent d'où il s'était enfui, un beau jour, avec la caisse de l’économe, la nièce de l’abbé et une douzaine de mots latins dans la cervelle pour tout bagage, […]."
                                            },
                                            {
                                                "example_id": "7ba1e109-92cb-44fc-a135-35eb2dcbbf4e",
                                                "sense_id": "9a3bae46-84ce-3aed-8ece-0993af2fc7c4",
                                                "text": "Il serait donc vain de nier l'existence et les progrès des maladies mentales au XIXᵉ siècle. Les psychiatres classificateurs de l'époque n'ont pas travaillé à enfermer des innocents. À partir des années 1800, la société est massivement pathogène. Et c'est normal."
                                            },
                                            {
                                                "example_id": "c6960a68-bf6c-478f-837a-ab4f79e464db",
                                                "sense_id": "9a3bae46-84ce-3aed-8ece-0993af2fc7c4",
                                                "text": "Ce registre d’écrous nous offre la possibilité d’établir une étude fine du corps incarcéré qui se définit comme étant la partie visible et matérielle de l’individu enfermé en prison. Lors de son passage au greffe, le corps du prisonnier est en quelques instants, par quelques gestes tant symboliques que pratiques, approprié par l’administration pénitentiaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b52b605-ac38-3380-9244-7ef022655875",
                                        "entry_id": "4f591b61-1d32-31b6-adac-de62bc809e1b",
                                        "glosses": [
                                            "Serrer, mettre une chose dans un lieu, dans un meuble, que l’on ferme, pour la mieux conserver, pour la soustraire aux regards, pour la garder plus sûrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a063f0c3-a60f-4db8-8b7e-56d83fc9b535",
                                                "sense_id": "9b52b605-ac38-3380-9244-7ef022655875",
                                                "text": "Enfermer des habits dans une armoire."
                                            },
                                            {
                                                "example_id": "a00de28e-d408-41c6-8b6e-5bce93a8e448",
                                                "sense_id": "9b52b605-ac38-3380-9244-7ef022655875",
                                                "text": "Enfermer des papiers dans un secrétaire."
                                            },
                                            {
                                                "example_id": "00c4f793-9fa9-415e-b30e-f03cdafdfd3c",
                                                "sense_id": "9b52b605-ac38-3380-9244-7ef022655875",
                                                "text": "Enfermer à clef, sous clef."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31db3a74-ac2d-3709-b4eb-1fa5075f8e73",
                                        "entry_id": "4f591b61-1d32-31b6-adac-de62bc809e1b",
                                        "glosses": [
                                            "Environner de toutes parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7793e557-4136-4066-96cf-36d136c840e4",
                                                "sense_id": "31db3a74-ac2d-3709-b4eb-1fa5075f8e73",
                                                "text": "Enfermer un parc de murailles. — Enfermer de haies."
                                            },
                                            {
                                                "example_id": "f3965e26-b5d6-4dcc-b5a9-ba1f83ad23c2",
                                                "sense_id": "31db3a74-ac2d-3709-b4eb-1fa5075f8e73",
                                                "text": "Les ennemis se sont laissé enfermer entre deux rivières, entre deux montagnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb578df-be62-3627-b0a4-c773e8796e76",
                                        "entry_id": "4f591b61-1d32-31b6-adac-de62bc809e1b",
                                        "glosses": [
                                            "Contenir ; comprendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15976688-75f2-4f05-acbc-38a2a463079f",
                                                "sense_id": "7bb578df-be62-3627-b0a4-c773e8796e76",
                                                "text": "Son cœur n’enferme point une méchanceté si noire."
                                            },
                                            {
                                                "example_id": "639e491c-ddcc-411e-bf9e-226036a987ac",
                                                "sense_id": "7bb578df-be62-3627-b0a4-c773e8796e76",
                                                "text": "Ce passage enferme beaucoup de vérités."
                                            },
                                            {
                                                "example_id": "b8bc1f8a-b8ae-4600-a778-5e179acee378",
                                                "sense_id": "7bb578df-be62-3627-b0a4-c773e8796e76",
                                                "text": "Cette proposition en enferme beaucoup d’autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0d85f54-ea0b-3ee0-93c2-79fee6a43dbf",
                                        "entry_id": "4f591b61-1d32-31b6-adac-de62bc809e1b",
                                        "glosses": [
                                            "Contenir en soi-même."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43c5b63a-9d26-4a2c-8d17-124e9dec1207",
                                                "sense_id": "e0d85f54-ea0b-3ee0-93c2-79fee6a43dbf",
                                                "text": "Sauf que cette fois, les numéros pagnolesques devant les caméras ne suffisent plus à conjurer la crise. Gaudin a choqué la population en s'enfermant d'abord dans le déni, allant jusqu'à accuser la pluie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72c7e510-267d-340b-9bbb-da193a5ae68e",
                                        "entry_id": "4f591b61-1d32-31b6-adac-de62bc809e1b",
                                        "glosses": [
                                            "Se retirer dans un lieu qu’on ferme ensuite, pour que personne ne puisse s’y introduire."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aab57131-87fe-404f-b3b9-ce77adb951b9",
                                                "sense_id": "72c7e510-267d-340b-9bbb-da193a5ae68e",
                                                "text": "Il s’enferme presque toute la journée pour travailler. — S’enfermer dans son cabinet."
                                            },
                                            {
                                                "example_id": "55951523-f2f1-4022-9929-c723f905eb46",
                                                "sense_id": "72c7e510-267d-340b-9bbb-da193a5ae68e",
                                                "text": "Il s’était enfermé dans une chambre d’où il opposa une vive résistance aux gens qui étaient venus pour l’arrêter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "383b2dcd-6c08-367d-894d-46fe288e6e3d",
                                        "entry_id": "4f591b61-1d32-31b6-adac-de62bc809e1b",
                                        "glosses": [
                                            "Demeurer dans une place qui va être assiégée et qu’on veut défendre."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2d3cde2-d065-418f-bae1-679408105edf",
                                                "sense_id": "383b2dcd-6c08-367d-894d-46fe288e6e3d",
                                                "text": "S’enfermer dans une ville pour la fortifier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f03474-904b-3ade-8623-7ebdaf05d8a6",
                                        "entry_id": "4f591b61-1d32-31b6-adac-de62bc809e1b",
                                        "glosses": [
                                            "Se faire religieux ou religieuse dans un cloître."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pronominal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3c1e7af-7306-4f65-873d-f5666c9412ac",
                        "source_entry_id": "072cb8f7-685e-3783-8b24-844cee3ff5e0",
                        "source_sense_id": "f2a64cc7-e89e-3346-b1e9-8736a0cb74f3",
                        "target_lang_word": "séquestrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séquestrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e592a16-17fe-3497-a745-7c95a2c037a9",
                                        "entry_id": "0a19441b-8efd-3e0f-b6a9-db387cc44f6a",
                                        "glosses": [
                                            "Mettre quelque chose sous séquestre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17fbebd9-f8c6-47f0-9b94-25d96c5ef794",
                                                "sense_id": "5e592a16-17fe-3497-a745-7c95a2c037a9",
                                                "text": "Le séquestre est la mise sous main de justice d'objets destinés à désintéresser les créanciers (voir décision du Conseil fédéral du 18. avril 1893, recours Stutz, Archives, II, 72) ; aussi peuvent seuls être séquestrés aux termes de l'art. 275 qui vise les art. 92 et 93 L.P. des objets saisissables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1f0c9cc-7a04-3f3f-bac2-7b1bdb2d0692",
                                        "entry_id": "0a19441b-8efd-3e0f-b6a9-db387cc44f6a",
                                        "glosses": [
                                            "Tenir illégalement enfermée, en parlant d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "376955a1-6f16-4e6d-953d-adac65d633c6",
                                                "sense_id": "b1f0c9cc-7a04-3f3f-bac2-7b1bdb2d0692",
                                                "text": "La loi punit ceux qui, sans ordre ni mandat de justice, ont arrêté, détenu ou séquestré des personnes quelconques."
                                            },
                                            {
                                                "example_id": "a36cd84b-d5a7-44e0-ac93-546119f238b3",
                                                "sense_id": "b1f0c9cc-7a04-3f3f-bac2-7b1bdb2d0692",
                                                "text": "Ce grillage, c’est-il pour le séquestrer ?\n– Pour le… quoi ? demanda Loucrocq ?. Vous en avez des mots !\n– Ça veut dire : l’enfermer, expliqua Mme Gaudran. Dans les familles, même de la haute, ça arrive, vous savez qu’on séquestre des gens, sans air, sans boire ni manger, et le commissaire de police les retrouve couchés dans leur ordure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e320ae3-bcfc-3a84-9381-a2f6dc877f12",
                                        "entry_id": "0a19441b-8efd-3e0f-b6a9-db387cc44f6a",
                                        "glosses": [
                                            "Retenir un élément chimique, en parlant d’une molécule chimique ou organique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f8a71e-40f2-46e5-b5ad-6c6bcd867ff0",
                                                "sense_id": "3e320ae3-bcfc-3a84-9381-a2f6dc877f12",
                                                "text": "Au sens du présent texte, le terme « réductions d'émissions » désigne indifféremment des quantités de GES dont l'émission a été évitée ou des quantités de GES séquestrées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cbc206e-2da2-314c-82d5-658c037105fd",
                                        "entry_id": "0a19441b-8efd-3e0f-b6a9-db387cc44f6a",
                                        "glosses": [
                                            "S’isoler, vivre à l’écart du monde."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4db1ca23-c845-458a-aeb7-956a664fdfbe",
                        "source_entry_id": "072cb8f7-685e-3783-8b24-844cee3ff5e0",
                        "source_sense_id": "f2a64cc7-e89e-3346-b1e9-8736a0cb74f3",
                        "target_lang_word": "cloîtrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloîtrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe1643e8-d7c9-39f6-9e38-f01ddb57475d",
                                        "entry_id": "337dfb13-f524-31b0-98d7-1d0486eda622",
                                        "glosses": [
                                            "Faire entrer quelqu’un dans un cloître, un monastère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94cd6b01-64bd-4720-8ece-90b3e7c06e96",
                                                "sense_id": "fe1643e8-d7c9-39f6-9e38-f01ddb57475d",
                                                "text": "Les parents de cette fille résolurent de la cloîtrer."
                                            },
                                            {
                                                "example_id": "3552e2dc-b4de-4516-847f-0880c692fc75",
                                                "sense_id": "fe1643e8-d7c9-39f6-9e38-f01ddb57475d",
                                                "text": "Il voulut se cloîtrer. — Religieuse cloîtrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9778a6ec-698f-342a-899b-02cbd74ef98f",
                                        "entry_id": "337dfb13-f524-31b0-98d7-1d0486eda622",
                                        "glosses": [
                                            "Enfermer dans un lieu au mode de vie austère."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed684d8c-cfec-4d55-b46e-a83cffa37d17",
                                                "sense_id": "9778a6ec-698f-342a-899b-02cbd74ef98f",
                                                "text": "J'avais vécu enfermée jusqu'alors, cloîtrée avec les Dames de Reims et quand je rentrais chez nous pour les vacances je n'avais pas eu la plus petite amourette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35ef8ad4-2862-3b80-b188-bf859867758a",
                                        "entry_id": "337dfb13-f524-31b0-98d7-1d0486eda622",
                                        "glosses": [
                                            "S’enfermer chez soi ; se retirer."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24b6effd-1255-4209-8853-d9f6ab3f4f5b",
                                                "sense_id": "35ef8ad4-2862-3b80-b188-bf859867758a",
                                                "text": "Le peu qui restaient, confirmés par enquête généalogique, s'étaient cloîtrés en des tavernes où buvaient à tire-larigot en attendant la fin du monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
