                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a58a8a61-886b-3934-a011-4e5b129472c8",
                                        "entry_id": "8bacec97-304d-376e-8fa5-a7da4f1f7cfa",
                                        "glosses": [
                                            "Qui est à la base, au niveau le moins élevé d’un ordre hiérarchique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3cdb63b-c5fc-3d56-be36-909a752a1f5a",
                                        "entry_id": "8bacec97-304d-376e-8fa5-a7da4f1f7cfa",
                                        "glosses": [
                                            "Qui donne les rudiments de base dans le processus d’apprentissage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1192acb8-5a1f-4b3a-b6bb-8e4dcef4cc92",
                                                "sense_id": "e3cdb63b-c5fc-3d56-be36-909a752a1f5a",
                                                "text": "Mon père était donc professeur de septième, professeur élémentaire, comme on disait alors."
                                            },
                                            {
                                                "example_id": "f5d49f45-65bd-4cc3-a22f-75036bca5164",
                                                "sense_id": "e3cdb63b-c5fc-3d56-be36-909a752a1f5a",
                                                "text": "C’est dans le même esprit mélioriste que Condorcet prône un enseignement élémentaire, moral et civique qui constitue la meilleure réponse au fanatisme religieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "339d1c29-1422-3a92-acb4-bc957c31853d",
                                        "entry_id": "8bacec97-304d-376e-8fa5-a7da4f1f7cfa",
                                        "glosses": [
                                            "Simple, aisé, rudimentaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b76c14-1506-4997-be29-a6c0131b0e20",
                                                "sense_id": "339d1c29-1422-3a92-acb4-bc957c31853d",
                                                "text": "Un raisonnement élémentaire."
                                            },
                                            {
                                                "example_id": "7b6e8f10-8dc7-4a47-b19d-c0442d4f6d72",
                                                "sense_id": "339d1c29-1422-3a92-acb4-bc957c31853d",
                                                "text": "Élémentaire, mon cher Watson."
                                            }
                                        ]
                                    }
