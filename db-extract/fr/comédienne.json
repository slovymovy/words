                        ],
                        "form": "comédien·ne"
                    },
                    {
                        "form_id": "4279685e-3096-4b28-85eb-b39de85fa4c7",
                        "entry_id": "6e62ef36-b9b0-3e0f-bf84-4711737c3860",
                        "tags": [
                            "neuter"
                        ],
                        "form": "comédian"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e90b081a-653a-3db7-a20c-22e0520a0bad",
                        "entry_id": "6e62ef36-b9b0-3e0f-bf84-4711737c3860",
                        "glosses": [
                            "Femme dont la profession est d’interpréter un personnage, de jouer un rôle au théâtre, au cinéma, à la télévision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3127cff4-a4a6-4e95-a7fb-5013181dec72",
                                "sense_id": "e90b081a-653a-3db7-a20c-22e0520a0bad",
                                "text": "L’eau ne convient pas aux oiseaux non plus que l’air aux poissons. Les uns s’y noient et les autres y étouffent. Je suis comédienne de nature et le théâtre est mon atmosphère. Là, seulement, je respire à mon aise."
                            },
                            {
                                "example_id": "b1319cbd-9125-4162-94f3-904c8d4fefce",
                                "sense_id": "e90b081a-653a-3db7-a20c-22e0520a0bad",
                                "text": "Ecrivons-le ici en lettres de feu ; entre tous les supplices que le poète florentin se plaît à entasser dans les cercles de son poème infernal, il n’en est pas de comparable à celui qui consiste à aimer une comédienne. On ferait un lac à couvrir l’Europe avec les larmes et le sang que ces femmes brillantes ont fait répandre depuis l’invention des spectacles."
                            },
                            {
                                "example_id": "6f083399-046b-4961-9743-ea5067f4aaeb",
                                "sense_id": "e90b081a-653a-3db7-a20c-22e0520a0bad",
                                "text": "Je suis loyalement passionnée comme une honnête femme, et il faudrait être manégée, tricheuse et façonnière comme une comédienne de province."
                            }
                        ]
                    },
                    {
                        "sense_id": "05261691-9c62-3b70-bf53-555e7c7283ca",
                        "entry_id": "6e62ef36-b9b0-3e0f-bf84-4711737c3860",
                        "glosses": [
                            "Femme qui aime prendre des poses de comédienne, voire simule, joue la comédie."
                        ],
                        "tags": [
                            "analogy",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "a2846a53-1384-4873-a1e8-81c49cf48bfd",
                                "sense_id": "05261691-9c62-3b70-bf53-555e7c7283ca",
                                "text": "Quelle comédienne, s’est exclamée sa mère, elle se sert de sa jeunesse pour séduire les hommes et les femmes, le mal est en elle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9da597eb-2774-43eb-aa64-45d91968d333",
                        "source_entry_id": "6e62ef36-b9b0-3e0f-bf84-4711737c3860",
                        "source_sense_description": "Actrice (1)",
                        "target_lang_word": "Schauspielerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schauspielerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                        "entry_id": "fea03eae-67df-30a7-a156-70e5e2247095",
                                        "glosses": [
                                            "weibliche Person, die nach entsprechender Ausbildung Darstellerin im Film oder beim Theater oder Fernsehen ist"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e6fbf54-8684-41ef-bc5c-d4a6bb4bd97a",
                                                "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                                "text": "Sie ist als Schauspielerin sehr erfolgreich und hat sogar einmal den Oscar gewonnen."
                                            },
                                            {
                                                "example_id": "8457a5c1-730d-4ea5-92ff-c5b08d4a2407",
                                                "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                                "text": "Schauspieler/in ist eine landesrechtlich geregelte, drei- bis vierjährige, schulische Ausbildung an Berufsfachschulen."
                                            },
                                            {
                                                "example_id": "31ba2d83-6127-4023-af2a-a3453930e1f6",
                                                "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                                "text": "„Sie hatte in Berlin Schauspielerin werden wollen und war in Jerusalem die Frau eines langweiligen Juristen geworden.“"
                                            },
                                            {
                                                "example_id": "67749b55-896a-4f45-8981-cef02a832282",
                                                "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                                "text": "„Jetzt bin ich nur noch Figurantin, aber früher war ich einmal Schauspielerin.“"
                                            },
                                            {
                                                "example_id": "219b1cd0-fb5e-4039-9583-f91c719a7367",
                                                "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                                "text": "„So muss sich eine Schauspielerin vor ihrem ersten großen Auftritt fühlen.“"
                                            },
                                            {
                                                "example_id": "b982138e-d41a-4b0b-b959-092bbe460485",
                                                "sense_id": "6dec8de4-640d-3ce0-be6b-af648227286e",
                                                "text": "„Man hätte sie für eine berühmte Schauspielerin halten können, doch in Fritze Grails Kneipe gegenüber dem Schlachthof verirrten sich keine Ufa-Stars.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33096268-42ab-3989-8765-8b66df56cb30",
                                        "entry_id": "fea03eae-67df-30a7-a156-70e5e2247095",
                                        "glosses": [
                                            "weibliche Person, die im wirklichen Leben durch Schauspielerei ihr wahres Gesicht verbirgt und andere vielleicht sogar täuschen will"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375dd053-2776-4202-8389-95fb19489521",
                                                "sense_id": "33096268-42ab-3989-8765-8b66df56cb30",
                                                "text": "Schau dir diese Schauspielerin an, ich wette, da ist keine Träne echt."
                                            },
                                            {
                                                "example_id": "8d4e4573-5abc-4997-bf8c-becda95d4e4e",
                                                "sense_id": "33096268-42ab-3989-8765-8b66df56cb30",
                                                "text": "Um als Spitzel eine Überlebenschance zu haben, musste sie eine gute Schauspielerin sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8649b627-4247-48ee-a06a-4a1e9e71e6ad",
                        "source_entry_id": "6e62ef36-b9b0-3e0f-bf84-4711737c3860",
                        "source_sense_description": "Actrice (1)",
                        "target_lang_word": "actress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                        "entry_id": "00b17417-dd4d-3008-aaa8-0049e4b2270e",
                                        "glosses": [
                                            "A female who performs on the stage or in films."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a42363-81f1-4b8b-8ff9-879895a29601",
                                                "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                                "text": "A while ago somewhere I don't know when / I was watchin' a movie with a friend / I fell in love with the actress / She was playin' a part that I could understand"
                                            },
                                            {
                                                "example_id": "9236a94e-d062-4f08-96f9-69f3c7b8f0f3",
                                                "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                                "text": "\"I'm an actress -- actor, as we have to say these days.\""
                                            },
                                            {
                                                "example_id": "60c2368a-30ec-481c-a2a7-3b35351dec9c",
                                                "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                                "text": "Court documents appear to show that Ian Edmondson, a senior News of the World journalist, had authorised Mr Mulcaire to hack phones belonging to Sienna Miller, an actress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23be3a93-71a9-3dd6-ae13-2fc3af4534b9",
                                        "entry_id": "00b17417-dd4d-3008-aaa8-0049e4b2270e",
                                        "glosses": [
                                            "A female doer or \\\"actor\\\" (in a general sense)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d5f912-3c4c-474c-a16a-8248b2bdadab",
                                                "sense_id": "23be3a93-71a9-3dd6-ae13-2fc3af4534b9",
                                                "text": "My mental anguish, and the dreadful scenes in which I had been an actress, advanced the period of my labour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
