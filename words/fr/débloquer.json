                    "semantic_group_id": "liberation_mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a réussi à <w>débloquer</w> la porte d'entrée qui était coincée par le froid."
                        },
                        {
                            "text": "Une discussion sincère a permis de <w>débloquer</w> la situation entre les deux collègues."
                        }
                    ],
                    "synonyms": [
