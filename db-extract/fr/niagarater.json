                "senses": [
                    {
                        "sense_id": "7a668c1e-d147-37db-b30d-0ddf322290c2",
                        "entry_id": "b596a56a-da6b-3fad-a92a-ee3532f2f53c",
                        "glosses": [
                            "Faire couler beaucoup de liquide, de sueur ou de larmes par exemple, comme les chutes du Niagara."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "899a4fd5-cbc3-4f8b-9854-6de377b9a384",
                                "sense_id": "7a668c1e-d147-37db-b30d-0ddf322290c2",
                                "text": "Ils en gagatent, ils glaglatent, ils niagaratent, ils se déshydratent !"
                            },
                            {
                                "example_id": "bfc49725-2405-4f4e-b8f0-251d7f52c934",
                                "sense_id": "7a668c1e-d147-37db-b30d-0ddf322290c2",
                                "text": "Parce que voilà, l'autre problème, c'est que je suis une pleureuse : je mouche, je coule, je niagarate."
                            },
                            {
                                "example_id": "7788273f-e113-44b0-9c70-9bfe4bacd11f",
                                "sense_id": "7a668c1e-d147-37db-b30d-0ddf322290c2",
                                "text": "Apparemment épouvanté, il se tourne de droite et de gauche en transpirant à grasses goûtes, il ruisselle, il niagarate."
                            }
                        ]
                    }
                ],
