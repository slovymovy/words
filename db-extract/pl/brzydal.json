                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10633996-cc62-4913-8838-8a14c45e6c44",
                                "sense_id": "ff8608c5-77d5-3759-a09f-483279fbe6e5",
                                "text": "Patrz na tego brzydala pod płotem! Ależ mu uszy sterczą."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fb9ffaa3-dbdc-3a83-bfa5-2c992bbc44ca",
                        "entry_id": "96102039-6d15-3f0d-a00a-c115da2ad33e",
                        "glosses": [
                            "osoba robiąca brzydkie rzeczy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cbc24c4-dee4-4f33-9a05-75f1f6ed6685",
                                "sense_id": "fb9ffaa3-dbdc-3a83-bfa5-2c992bbc44ca",
                                "text": "Ty brzydalu! Przestań grzebać w nosie!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86f710f8-1fcf-418d-bdb3-71a79d1c1460",
                        "source_entry_id": "96102039-6d15-3f0d-a00a-c115da2ad33e",
                        "source_sense_id": "ff8608c5-77d5-3759-a09f-483279fbe6e5",
                        "target_lang_word": "ugly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ugly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7238e97d-ce4b-35c2-8d03-356b6347d9e8",
                                        "entry_id": "4bf1ffce-44fb-38f1-84fb-01d095006515",
                                        "glosses": [
                                            "Displeasing to the eye; aesthetically unpleasing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e64f4786-f98c-4153-a40c-1897e07964e0",
                                                "sense_id": "7238e97d-ce4b-35c2-8d03-356b6347d9e8",
                                                "text": "the ugly view of his deformed crimes"
                                            },
                                            {
                                                "example_id": "b1fcca30-3682-4e98-8766-753a32fac72f",
                                                "sense_id": "7238e97d-ce4b-35c2-8d03-356b6347d9e8",
                                                "text": "O, I have passed a miserable night, / So full of ugly sights, of ghastly dreams."
                                            },
                                            {
                                                "example_id": "d34af878-1b83-4574-ab0a-ff13053f30af",
                                                "sense_id": "7238e97d-ce4b-35c2-8d03-356b6347d9e8",
                                                "text": "When the poor man’s integuments, no longer nourished from within, become dead skin, mere adscititious leather and callosity, wearing thicker and thicker, uglier and uglier;[…]— yes then, you may say, his usefulness once more is quite obstructed;[…]it is time that he take to bed, and prepare for departure, which cannot now be distant!"
                                            },
                                            {
                                                "example_id": "9190ca5d-db1f-4f71-bd6f-91b4c7d2daef",
                                                "sense_id": "7238e97d-ce4b-35c2-8d03-356b6347d9e8",
                                                "text": "In Athens he looked up from his ouzo at what he called the ugliest people in the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af1d85f4-aeb6-385f-b3fc-e8a4d15c3a9b",
                                        "entry_id": "4bf1ffce-44fb-38f1-84fb-01d095006515",
                                        "glosses": [
                                            "Displeasing to the ear or some other sense."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f31eda9-1c77-33ea-9500-97aefd57e3d9",
                                        "entry_id": "4bf1ffce-44fb-38f1-84fb-01d095006515",
                                        "glosses": [
                                            "Offensive to one's sensibilities or morality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d40a961d-fe3f-4a3e-8672-0db089dd60c5",
                                                "sense_id": "2f31eda9-1c77-33ea-9500-97aefd57e3d9",
                                                "text": "He played an ugly trick on us."
                                            },
                                            {
                                                "example_id": "fa1cc995-0715-490f-b46c-9dca48047386",
                                                "sense_id": "2f31eda9-1c77-33ea-9500-97aefd57e3d9",
                                                "text": "All this was extraordinarily distasteful to Churchill. It was ugly, gross. Never before had he felt such repulsion when the vicar displayed his characteristic bluntness or coarseness of speech. In the present connexion—or rather as a transition from the subject that started their conversation—such talk had been distressingly out of place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8ee642c-4f5a-3b51-8fcd-b13f85f95025",
                                        "entry_id": "4bf1ffce-44fb-38f1-84fb-01d095006515",
                                        "glosses": [
                                            "Ill-natured; crossgrained; quarrelsome."
                                        ],
                                        "tags": [
                                            "Southern-US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "500e8c16-893f-4af2-9ccd-9dadb5d37915",
                                                "sense_id": "b8ee642c-4f5a-3b51-8fcd-b13f85f95025",
                                                "text": "an ugly temper; to feel ugly"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8094f79-9659-3dc0-b802-cb6246665474",
                                        "entry_id": "4bf1ffce-44fb-38f1-84fb-01d095006515",
                                        "glosses": [
                                            "Unpleasant; disagreeable; likely to cause trouble or loss."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e744a51-6f7e-4d0b-93bf-65a7919c919f",
                                                "sense_id": "f8094f79-9659-3dc0-b802-cb6246665474",
                                                "text": "an ugly rumour; an ugly customer; an ugly wound"
                                            },
                                            {
                                                "example_id": "4f8403db-ee69-410e-9303-a579d8bb28a8",
                                                "sense_id": "f8094f79-9659-3dc0-b802-cb6246665474",
                                                "text": "With all this competition, expect things to get ugly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ugly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97e7fa0f-a37a-3d16-abc3-927d93980436",
                                        "entry_id": "83341bc2-06d3-33cd-b56f-065224260c5e",
                                        "glosses": [
                                            "Ugliness."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05d805b9-316a-474e-ae06-4e1afe6b753b",
                                                "sense_id": "97e7fa0f-a37a-3d16-abc3-927d93980436",
                                                "text": "I want your ugly / I want your disease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f20457a-f1a7-3b00-be61-d7795eeda1bc",
                                        "entry_id": "83341bc2-06d3-33cd-b56f-065224260c5e",
                                        "glosses": [
                                            "An ugly person or thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d68b7ebe-c80a-3fd0-b351-b7fcac9b6a39",
                                        "entry_id": "83341bc2-06d3-33cd-b56f-065224260c5e",
                                        "glosses": [
                                            "Any product whose size and shape prevents it from fitting neatly on a pallet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5d3b2c5-176e-4bfe-82ea-973ff2d4c0eb",
                                                "sense_id": "d68b7ebe-c80a-3fd0-b351-b7fcac9b6a39",
                                                "text": "These are firstly for products which need a cool room; secondly for products which can be stored on a standard pallet without overhang; and thirdly for products known as \"the uglies\" which always overhang a standard pallet."
                                            },
                                            {
                                                "example_id": "20e616c6-962f-41a2-b9d2-8cdaa391d087",
                                                "sense_id": "d68b7ebe-c80a-3fd0-b351-b7fcac9b6a39",
                                                "text": "Non-standard products (abnormal or 'uglies'): many distribution operations are designed to cater for standard palletized products."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3401296-d646-35fa-8538-6f7bc9a200ae",
                                        "entry_id": "83341bc2-06d3-33cd-b56f-065224260c5e",
                                        "glosses": [
                                            "A shade for the face, projecting from a bonnet."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dated",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c635f71c-1265-4266-9756-640c301f4a8f",
                                                "sense_id": "f3401296-d646-35fa-8538-6f7bc9a200ae",
                                                "text": "[…] camp-stools, telescopes, poetry-books, blue uglies, red petticoats, and parasols of every hue."
                                            }
                                        ]
                                    }
                                ]
                            },
