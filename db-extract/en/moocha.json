                        "glosses": [
                            "A loincloth made from animals' tails or strips of skin; part of the traditional dress of Zulu males."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9465c1d2-02d7-4535-8773-a285bd11a8a5",
                                "sense_id": "5648df17-72cd-31e8-8d47-fe0a036aaf25",
                                "text": "Umbopa did so, at the same time slipping off the long military great coat which he wore, and revealing himself naked except for the moocha round his centre and a necklace of lions' claws."
                            },
