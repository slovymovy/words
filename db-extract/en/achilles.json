    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "187fc4af-e49c-36b6-a257-d12f41171962",
                "word": "Achilles",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7204d0cb-a93a-3632-bad3-9786303938e6",
                        "entry_id": "187fc4af-e49c-36b6-a257-d12f41171962",
                        "glosses": [
                            "A mythical semidivine hero, the son of Peleus by the nereid Thetis, and prince of the Myrmidons, who features in the Iliad as a central character and the foremost warrior of the Achaean (Greek) camp."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "d6a6084a-b7c1-480c-93f3-e6aedf6d3d4a",
                                "sense_id": "7204d0cb-a93a-3632-bad3-9786303938e6",
                                "text": "Achilles! a drayman, a porter, a very camel."
                            },
                            {
                                "example_id": "35441561-e4f8-4ece-93da-89a1150688e4",
                                "sense_id": "7204d0cb-a93a-3632-bad3-9786303938e6",
                                "text": "Achilles’ wrath, to Greece the direful spring\nOf woes unnumber’d, heavenly goddess, sing!"
                            },
                            {
                                "example_id": "dbb4ac5b-7792-4a66-9405-d286fe34a672",
                                "sense_id": "7204d0cb-a93a-3632-bad3-9786303938e6",
                                "text": "If once the lamentation is heard, it will ring out again, of the short-lived Achilles, of the leaf-like change and vicissitude of the human race, of the decay of the heroic age."
                            },
                            {
                                "example_id": "1e012a24-c852-4bd1-8cb0-44b2cd32fa99",
                                "sense_id": "7204d0cb-a93a-3632-bad3-9786303938e6",
                                "text": "In the last third of the Iliad, Achilles’ beloved companion, Patroklos, and his bitter enemy, Hektor, die wearing Achilles’ armor, their deaths prefiguring Achilles’ own."
                            }
                        ]
                    },
