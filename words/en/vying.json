                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>vyings</w> between the two political parties slowed down progress.",
                            "target_lang_translations": {
                                "cs": "Neustálé <w>soupeření</w> mezi oběma politickými stranami zpomalilo pokrok."
                            }
                        },
                        {
                            "text": "After years of <w>vyings</w> for power, the board finally reached a compromise.",
                            "target_lang_translations": {
