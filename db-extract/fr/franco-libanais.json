                        "entry_id": "95ec5458-c137-327c-abc4-30b35674cd4a",
                        "glosses": [
                            "Homme qui possède deux nationalités, française et libanaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "000018d0-a7e5-4358-8255-4dd331a28c7f",
                                "sense_id": "7443e130-4710-3e08-b9c5-f12f386c96c4",
                                "text": "Le Franco-Libanais, qui accusait l’ancien président de la République d’avoir fait financer sa campagne présidentielle par le régime libyen depuis 2012, avait fait volte-face en novembre 2020 dans Paris-Match et sur BFMTV, avant de revenir sur ses propos deux mois plus tard."
                            },
                            {
                                "example_id": "4facdd22-282b-40dd-948e-58fca408e1f1",
                                "sense_id": "7443e130-4710-3e08-b9c5-f12f386c96c4",
                                "text": "Un Franco-Libanais nommé secrétaire général de l'alliance Renault-Nissan."
                            }
                        ]
                    }
