                "senses": [
                    {
                        "sense_id": "10720db7-d826-30e6-99fa-8792b28e5ccc",
                        "entry_id": "aeffcaa6-19a8-3183-8ac3-9f15a295d109",
                        "glosses": [
                            "de temperatuur van de buitenlucht in de periode tussen 12.00 en 18.00 uur; de temperatuur tijdens het warmste deel van de dag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31d54344-a99b-4253-b868-5b3f7043ae53",
                                "sense_id": "10720db7-d826-30e6-99fa-8792b28e5ccc",
                                "text": "In het midden en zuiden is het bewolkt en vallen de meeste buien, verder naar het westen blijft het overwegend droog. De middagtemperatuur ligt tussen 20 en 23 graden. De komende dagen krijgt de zon meer ruimte, is het meestal droog en wordt het warmer."
                            },
                            {
                                "example_id": "ec177244-71f3-405a-a1e3-c42ac865d65a",
                                "sense_id": "10720db7-d826-30e6-99fa-8792b28e5ccc",
                                "text": "Eerst het weer: met een matige oostenwind wordt veel bewolking uit Duitsland aangevoerd, maar vooral in het zuidoosten krijgt ook de zon wel wat ruimte. De middagtemperatuur loopt op naar 11 graden, maar het voelt zeker in open gebieden een stuk frisser aan."
                            }
                        ]
                    }
                ],
