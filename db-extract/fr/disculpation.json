                        "glosses": [
                            "Action de disculper autrui ou de se disculper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a147d696-e503-4c66-b63e-c22a31e58047",
                                "sense_id": "5404d330-203f-3824-a6a2-5216026fadba",
                                "text": "Je suis ravi que ce soit à M. Puget que je doive ma disculpation."
                            },
                            {
                                "example_id": "b661b107-8329-4bf0-ad2e-c71657804c4d",
                                "sense_id": "5404d330-203f-3824-a6a2-5216026fadba",
                                "text": "Quelle qu’en soit la configuration, mythologique ou biblique, cette image fera l’objet d’une disculpation irrésistible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
