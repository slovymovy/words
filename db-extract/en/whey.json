    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1fd4f258-0900-3f9a-9ac5-caeedc6fca5d",
                "word": "whey",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6811cc1d-b4cb-353a-8141-712b21cce139",
                        "entry_id": "1fd4f258-0900-3f9a-9ac5-caeedc6fca5d",
                        "glosses": [
                            "A shout for attention"
                        ],
                        "tags": [
                            "UK",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0f12868e-a266-4cad-bbcc-93958e848335",
                                "sense_id": "6811cc1d-b4cb-353a-8141-712b21cce139",
                                "text": "He swayed over to the door, peered out, shouted \"whey!\" and came back, looking severe."
                            },
                            {
                                "example_id": "ec86b186-075b-4a1e-b240-07b9692e37a3",
                                "sense_id": "6811cc1d-b4cb-353a-8141-712b21cce139",
                                "text": "somebody who was more or less to their senses, shouted... ' Whey! ... Had on lads!' and everybody was trying to get wocken up and sorted out."
                            }
                        ]
                    },
                    {
                        "sense_id": "c068711d-4281-3844-ae26-c4bdfb7a8fa1",
                        "entry_id": "1fd4f258-0900-3f9a-9ac5-caeedc6fca5d",
                        "glosses": [
                            "A shout of enthusiasm or delight"
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "c809887f-d320-49e1-9735-561fb29041eb",
                                "sense_id": "c068711d-4281-3844-ae26-c4bdfb7a8fa1",
                                "text": "... apart from Max, who rode his pallet like a surfboard with a huge grin plastered across his face. “Wheyyyyyyy!” Max yelled with delight."
                            },
                            {
                                "example_id": "bbab0aa7-01ae-4f73-8b8e-1fdebef58246",
                                "sense_id": "c068711d-4281-3844-ae26-c4bdfb7a8fa1",
                                "text": "Several drunken men shouted from the corner. “Wheyyyy, showtime! Go on, go on!”"
                            }
                        ]
                    },
                    {
                        "sense_id": "2f221147-4ff9-3cfe-8a72-da782d1246ab",
                        "entry_id": "1fd4f258-0900-3f9a-9ac5-caeedc6fca5d",
                        "glosses": [
                            "Shouted when someone drops a glass or other crockery, especially in a pub."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "4f411c8b-5b9a-4606-8e70-179f6ec12080",
                                "sense_id": "2f221147-4ff9-3cfe-8a72-da782d1246ab",
                                "text": "12. Smashing a glass and the whole bar choruses \"WHEYYYY\"."
                            },
                            {
                                "example_id": "f65d9cd7-9e89-4f4b-9d19-84d07178a5a9",
                                "sense_id": "2f221147-4ff9-3cfe-8a72-da782d1246ab",
                                "text": "If they don't shout \"wheyyy\" when you smash a glass, did it even smash?"
                            },
                            {
                                "example_id": "eb5329c0-6654-4adc-908b-196aa5986a88",
                                "sense_id": "2f221147-4ff9-3cfe-8a72-da782d1246ab",
                                "text": "the sloshed post-work boozers all shout \"Wheyyyyyyy!' at a glass that's smashed on the floor"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
