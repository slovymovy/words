                            {
                                "target_lang_word": "Rose",
                                "target_lang_sense_clarification": "female personal name"
                            },
                            {
                                "target_lang_word": "Rosa",
                                "target_lang_sense_clarification": "female personal name"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3381b756-3bf4-3ee4-8315-126cf7d2c0bf",
                    "sense_definition": "посёлок городского типа в Челябинской области России",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "топоним",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Небольшой посёлок <w>Роза</w> расположен недалеко от глубокого угольного разреза.",
                            "target_lang_translations": {
                                "en": "The small settlement of <w>Roza</w> is located near a deep open-pit coal mine."
                            }
                        },
                        {
                            "text": "Многие жители посёлка <w>Роза</w> работают на предприятиях в соседнем крупном городе.",
                            "target_lang_translations": {
                                "en": "Many residents of the settlement of <w>Roza</w> work at enterprises in the neighboring major city."
                            }
                        }
                    ],
                    "common_phrases": [
                        "посёлок Роза"
                    ],
                    "target_lang_definitions": {
                        "en": "an urban-type settlement in Chelyabinsk Oblast, Russia"
                    },
                    "translations": {
