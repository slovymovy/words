        "fr-extract.jsonl": [
            {
                "entry_id": "f9d7c1ff-50f9-30d3-9532-86772670e18f",
                "word": "végétalisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fa981aa7-4cf9-49d2-8178-4fef22166bec",
                        "entry_id": "f9d7c1ff-50f9-30d3-9532-86772670e18f",
                        "tags": [
                            "plural"
                        ],
                        "form": "végétalismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc36a36a-8338-3528-bd69-5e1bcd2e57d5",
                        "entry_id": "f9d7c1ff-50f9-30d3-9532-86772670e18f",
                        "glosses": [
                            "Principe diététique recommandant l’usage alimentaire unique des végétaux, à l'exclusion de la viande, du poisson et de tout produit d’origine animale."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91fb2dfd-b6bd-4c63-86e7-29ac86f297fe",
                        "source_entry_id": "f9d7c1ff-50f9-30d3-9532-86772670e18f",
                        "source_sense_id": "fc36a36a-8338-3528-bd69-5e1bcd2e57d5",
                        "target_lang_word": "veganism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veganism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aaeff598-2920-3448-b151-d76350b26548",
                                        "entry_id": "578727d9-9ce8-3581-ad65-f623705cea2a",
                                        "glosses": [
                                            "A way of life which strictly avoids animal products and services involving the use of living animals."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d58383f3-5402-49fd-87ed-5b0edf4320ec",
                                                "sense_id": "aaeff598-2920-3448-b151-d76350b26548",
                                                "text": "Besides being a dietary choice, veganism is a challenging and powerful lifestyle"
                                            },
                                            {
                                                "example_id": "6fc4a203-7232-435f-b3f5-582adce7cfa9",
                                                "sense_id": "aaeff598-2920-3448-b151-d76350b26548",
                                                "text": "The purpose of veganism is to create a more just and compassionate society"
                                            },
                                            {
                                                "example_id": "d4c8e313-cc37-4765-ae17-f84cea41ff84",
                                                "sense_id": "aaeff598-2920-3448-b151-d76350b26548",
                                                "text": "A vegan lifestyle seeks to promote awareness, compassion, and peace. Veganism is an ethical system as well as a diet."
                                            },
                                            {
                                                "example_id": "a1e86211-1493-46c5-b8f4-3249cbca0418",
                                                "sense_id": "aaeff598-2920-3448-b151-d76350b26548",
                                                "text": "The absence of religious ceremonies, teachers or leaders, holidays and other conventions was further evidence that Friedman's veganism is \"a moral and secular, rather than religious, philosophy,\" Turner said."
                                            },
                                            {
                                                "example_id": "70173970-8218-4cc5-a703-ae70c454993b",
                                                "sense_id": "aaeff598-2920-3448-b151-d76350b26548",
                                                "text": "Veganism is a position according to which people ought to be vegans both now and in an ideal state."
                                            },
                                            {
                                                "example_id": "bf5f00cc-66c6-4bf3-970b-22f33637cded",
                                                "sense_id": "aaeff598-2920-3448-b151-d76350b26548",
                                                "text": "My additional desire is that ecofeminists will embrace veganism as an important means for reducing that suffering"
                                            },
                                            {
                                                "example_id": "f9bfd9ed-41b2-43c4-999c-df8900de5281",
                                                "sense_id": "aaeff598-2920-3448-b151-d76350b26548",
                                                "text": "The next step is ethical veganism. This is not veganism because it is good for your health (and it is good for your health) or because it protects the envirinment (and it does protect the environment), but from a state of compassion."
                                            },
                                            {
                                                "example_id": "bbbe09e8-2a08-40b3-a5ec-bb9e02f93733",
                                                "sense_id": "aaeff598-2920-3448-b151-d76350b26548",
                                                "text": "Like many vegans, Moore said she chose her diet because she cares deeply about animals and wanted to \"live [her] ethics.\" For her, extending veganism to her cats supports that choice and also helps reduce her environmental footprint."
                                            },
                                            {
                                                "example_id": "11ee534c-7fe4-47d8-947f-69c6d278591c",
                                                "sense_id": "aaeff598-2920-3448-b151-d76350b26548",
                                                "text": "An angry dispute between an animal welfare charity and its former employee will be the first case in Britain to decide whether ethical veganism is a “philosophical belief” that should be afforded the same protections as religion."
                                            },
                                            {
                                                "example_id": "58b69a3d-ce6d-4954-90dd-3d49c9cfea28",
                                                "sense_id": "aaeff598-2920-3448-b151-d76350b26548",
                                                "text": "Veganism has gone from fringe to fashionable in a relatively short time. According to the latest count, around 3.5 million people in the UK, 7% of the population, are vegan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67916378-f968-3648-8e23-f95d0ba13924",
                                        "entry_id": "578727d9-9ce8-3581-ad65-f623705cea2a",
                                        "glosses": [
                                            "Strict vegetarianism; the practice of eating neither meat nor other animal products, such as fish, milk and milk products, eggs, and honey."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
