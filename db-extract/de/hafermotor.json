                ],
                "senses": [
                    {
                        "sense_id": "7a8333b3-d3c9-3d3f-a9b9-02fb8a0733ff",
                        "entry_id": "753f669b-7b59-31d6-958a-2b4ef37e507f",
                        "glosses": [
                            "als Haus-, Nutz-, Reit- und Zugtier gehaltener großer Einhufer (Equus caballus)"
                        ],
                        "tags": [
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "6f017707-2514-458b-9b7b-1686e26c7f75",
                                "sense_id": "7a8333b3-d3c9-3d3f-a9b9-02fb8a0733ff",
                                "text": "„Bröſe bezahlte ſchnell und lief auf die Droſchke zu. ‚Menſch, Franz, da biſte ja! Und haſt den Hafermotor gleich mitjebracht!‘ begrüßte Schniegel-Otto den als Kutſcher verkleideten Pinzke.“"
                            },
                            {
                                "example_id": "3a1757a8-e974-4590-a38f-5c44cfb3043b",
                                "sense_id": "7a8333b3-d3c9-3d3f-a9b9-02fb8a0733ff",
                                "text": "„Manche Kolchosen scheinen den sowjetischen Traktoren überhaupt nicht zu trauen; sie halten den Hafermotor, das Pferd, auf dem Acker für zuverlässiger.“"
                            },
                            {
                                "example_id": "01100f65-ca4e-4cc5-8bc2-790d1e949cec",
                                "sense_id": "7a8333b3-d3c9-3d3f-a9b9-02fb8a0733ff",
                                "text": "„Die ein PS starke Muskel-Lok schnaubt und dampft. Die Stute schafft was weg, aber in aller Ruhe. Sie zu größerer Eile anzutreiben wäre zwecklos. Um zwölf Uhr mittags wird der Hafermotor wieder betankt. Verena frißt und furzt zufrieden.“"
                            },
                            {
                                "example_id": "d5a05d08-44d1-4c27-b18d-8806c89a7dcb",
                                "sense_id": "7a8333b3-d3c9-3d3f-a9b9-02fb8a0733ff",
                                "text": "„Daß die Arbeitsleistung der Hafermotoren nicht auf allen Gebieten mit Dieselmotoren gleichzusetzen ist, weiß auch Erich Degreif; die Pferde haben ein gemächliches Arbeitstempo und wollen gut gepflegt werden.“"
                            },
                            {
                                "example_id": "e5af3ac0-ff19-4fef-b338-548f62a59f6d",
                                "sense_id": "7a8333b3-d3c9-3d3f-a9b9-02fb8a0733ff",
                                "text": "«Als Arbeitstiere in der Landwirtschaft sind die braven Hafermotoren schon lange verdrängt, und auch die Armee hat ihren einst grossen Pferdebestand drastisch reduziert.»"
                            },
                            {
                                "example_id": "cffeff80-e92e-4b73-a0d8-cd89a9105cea",
                                "sense_id": "7a8333b3-d3c9-3d3f-a9b9-02fb8a0733ff",
                                "text": "«Das Bödeli Tram hat nur zwei Pferdestärken, die werden aber durch umweltfreundliche Hafermotore betrieben.»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1cd3b57-b963-44eb-83db-7aee69448bee",
                        "source_entry_id": "753f669b-7b59-31d6-958a-2b4ef37e507f",
                        "source_sense_id": "7a8333b3-d3c9-3d3f-a9b9-02fb8a0733ff",
