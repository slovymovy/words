                                "target_senses": [
                                    {
                                        "sense_id": "670b02a4-0804-31e7-a4f2-1abef80b5ae9",
                                        "entry_id": "071601cd-c3c0-3c65-b4cd-a5e540e2f2be",
                                        "glosses": [
                                            "A signalling device positioned at a road intersection or pedestrian crossing indicating the moment it is safe to drive, ride or walk, using a universal color code."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "503aa250-4d7c-430b-b073-a004544302b3",
                                                "sense_id": "670b02a4-0804-31e7-a4f2-1abef80b5ae9",
                                                "text": "In Sydney you'd better be riding the clutch and completely in sync with the traffic lights so that your car is already moving as they turn green."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed6042df-fecd-3c6a-9ff4-971e0057c579",
                                        "entry_id": "071601cd-c3c0-3c65-b4cd-a5e540e2f2be",
                                        "glosses": [
                                            "A signalling device positioned at a road intersection or pedestrian crossing indicating the moment it is safe to drive, ride or walk, using a universal color code.",
                                            "A road intersection controlled by one or more such devices."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ae3f4b9-d033-418a-a9be-1c0392b1da00",
                                                "sense_id": "ed6042df-fecd-3c6a-9ff4-971e0057c579",
                                                "text": "How do I get to the hospital? ~ You go straight on to the traffic lights, then turn left at the traffic lights and the hospital is on your right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4875b725-175b-3062-943b-582120b66e86",
                                        "entry_id": "071601cd-c3c0-3c65-b4cd-a5e540e2f2be",
                                        "glosses": [
                                            "A colour code using the three signals of a traffic light (green, yellow or amber, and red) as a metaphor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f95ca0d5-554e-493b-8142-2dd8092185f6",
                                                "sense_id": "4875b725-175b-3062-943b-582120b66e86",
                                                "text": "The Department of Health recommends that food packaging display the recommended daily intake with a traffic light system, for ease of understanding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e83850bb-871a-35b8-a742-2f6629da0967",
                                        "entry_id": "071601cd-c3c0-3c65-b4cd-a5e540e2f2be",
                                        "glosses": [
                                            "The colored dots on stamp sheet margins printed with offset printing or photogravure methods, used by the printers to check color accuracy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "598f6118-76f4-34f9-9808-69a24af4c7f4",
                                        "entry_id": "071601cd-c3c0-3c65-b4cd-a5e540e2f2be",
                                        "glosses": [
                                            "In Conway's Game of Life, an arrangement of four blinkers that are orthogonally equidistant from a central point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
