                        "target_lang_word": "se faire passer pour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se faire passer pour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c5cb431-fa17-3068-b6c8-6ae0aba18db3",
                                        "entry_id": "3067db85-f094-3e9e-870c-f8dc73e95c80",
                                        "glosses": [
                                            "Se faire prendre pour, prétendre être celui ou celle que l’on n’est pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f98035fc-9448-47ac-ad41-9fe40dcf635a",
                                                "sense_id": "1c5cb431-fa17-3068-b6c8-6ae0aba18db3",
                                                "text": "Sous les Ts’ing, on envoya jadis des fils de familles mandarinales, qui se firent passer en Europe pour comtes et barons, et y nocèrent à cœur joie..."
                                            },
                                            {
                                                "example_id": "d21daaad-7f94-4cf0-897d-7da968ab8940",
                                                "sense_id": "1c5cb431-fa17-3068-b6c8-6ae0aba18db3",
                                                "text": "Les policiers nous parlaient d’adultes mal intentionnés qui chattent en se faisant passer pour des ados et qui tentent de nous inviter chez eux, […]."
                                            },
                                            {
                                                "example_id": "0ac0d4d3-5789-4026-8abc-7df56f77f499",
                                                "sense_id": "1c5cb431-fa17-3068-b6c8-6ae0aba18db3",
                                                "text": "Attention à ce faux site internet, créé par un pirate se faisant passer pour EA Games, il peut être tenté de vous voler des données personnelles !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
