    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4192aff4-3b7a-3e6c-b173-9812090eda1d",
                    "sense_definition": "Free of foreign material or pollutants; not mixed with anything else.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This ring is made of <w>pure</w> gold.",
                            "target_lang_translations": {
                                "ru": "Это кольцо сделано из <w>чистого</w> золота.",
                                "nl": "Deze ring is gemaakt van <w>puur</w> goud."
                            }
                        },
                        {
                            "text": "We drank <w>pure</w> water straight from the mountain spring.",
                            "target_lang_translations": {
                                "ru": "Мы пили <w>чистую</w> воду прямо из горного источника.",
                                "nl": "We dronken <w>zuiver</w> water rechtstreeks uit de bergbron."
                            }
                        }
                    ],
                    "synonyms": [
                        "unadulterated",
                        "unpolluted",
                        "natural",
                        "pristine",
                        "uncontaminated",
                        "clean"
                    ],
                    "antonyms": [
                        "contaminated",
                        "polluted",
                        "adulterated",
                        "impure",
                        "tainted"
                    ],
                    "common_phrases": [
                        "pure gold",
                        "pure water",
                        "pure silk",
                        "pure wool"
                    ],
                    "target_lang_definitions": {
