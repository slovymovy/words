                        "examples": [
                            {
                                "example_id": "3c2189f0-b5e5-4f52-ab78-368bec8b0c6f",
                                "sense_id": "1783ed5d-abf9-3757-8e74-ea35998a6166",
                                "text": "[T]he captains were very independent and airy—pretty ‘biggity,’ as Uncle Remus would say."
                            },
                            {
                                "example_id": "198a1f09-1ea8-4800-8828-b2cd84683769",
                                "sense_id": "1783ed5d-abf9-3757-8e74-ea35998a6166",
                                "text": "\"Oh, Jeff Wain!\" returned the countryman slightingly; \"yas, I knows 'im, an' don' know no good of 'im. One er dese yer biggity, braggin' niggers—talks lack he own de whole county.\""
                            },
                            {
                                "example_id": "e8bfa8a5-c2f6-4853-bc18-c84d2ed411d7",
                                "sense_id": "1783ed5d-abf9-3757-8e74-ea35998a6166",
                                "text": "“Aint you talking biggity. I bet you better not let your grandmammy hear you talking like that.”"
                            }
                        ]
                    }
