                ],
                "senses": [
                    {
                        "sense_id": "6435a2e3-253c-3a45-a660-5f36b3a98000",
                        "entry_id": "690b2dad-2a3f-3b53-85d0-cf025e39455b",
                        "glosses": [
                            "Couvrir de feuillage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7860b227-fdd7-4f98-bd81-9b9d886e11b2",
                                "sense_id": "6435a2e3-253c-3a45-a660-5f36b3a98000",
                                "text": "Abondaient aussi les sas, ces acacias qui se dénudent lors des pluies d’été, permettant ainsi la culture du mil ; s’enfeuillageant l’hiver, en saison froide, ils donnaient ainsi aux bêtes leur ramure et leurs fruits comme nourriture quand toute la savane se dessèche."
                            },
                            {
                                "example_id": "00529999-690c-46ae-96df-7bf2f766752c",
                                "sense_id": "6435a2e3-253c-3a45-a660-5f36b3a98000",
                                "text": "Chacun l’enfeuillageait de pampre et de volubilis."
                            },
                            {
                                "example_id": "feca821f-4918-46af-9bee-50ea5b291706",
                                "sense_id": "6435a2e3-253c-3a45-a660-5f36b3a98000",
                                "text": "J’ai l’impression de rires polis de part et d’autre, puis la promesse d’un prompt retour et cette chose absolument déconcertante pour moi, inouïe, ma mère disparaissant derrière la grille enfeuillagée, au fond de la petite cour."
                            }
                        ]
                    }
                ],
