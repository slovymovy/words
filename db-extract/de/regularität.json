                    {
                        "form_id": "fe533714-f6a8-430e-9c27-0044cac18633",
                        "entry_id": "04989f00-a8b2-3fa0-8ea7-109b7d803c46",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Regularitäten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8728aea1-909b-32a7-96f9-879df17d8fb7",
                        "entry_id": "04989f00-a8b2-3fa0-8ea7-109b7d803c46",
                        "glosses": [
                            "Eigenschaft, nach Gesetzen/Vereinbarungen (regulär) abzulaufen"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "0e745aef-fb3a-4fe9-80cf-2d3b1db87af0",
                                "sense_id": "8728aea1-909b-32a7-96f9-879df17d8fb7",
                                "text": "„Regularität des Handelns bedeutet, dass Akteure in vergleichbaren Situationen aufgrund ähnlicher Wahrnehmungsweisen und geteilter Einschätzungen dazu tendieren werden, auf gleiche Weise zu handeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0d65777a-835c-357a-89a1-0334bff84bf9",
                        "entry_id": "04989f00-a8b2-3fa0-8ea7-109b7d803c46",
                        "glosses": [
                            "Eigenschaft einer sprachlichen Erscheinung, der Norm/Üblichkeit zu entsprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f584fa74-966e-48d9-bf77-0ce5ee2c1504",
                                "sense_id": "0d65777a-835c-357a-89a1-0334bff84bf9",
                                "text": "„Diese drei Merkmale, die Regularität der Verwendung, das gemeinsame Wissen der Sprecher über die Regularität und das Wissen über den normativen Charakter der Regularität machen nach gängiger Auffassung eine Konvention aus.“"
                            },
                            {
                                "example_id": "826f19a6-3260-4b34-b704-730ce33b1c3e",
                                "sense_id": "0d65777a-835c-357a-89a1-0334bff84bf9",
                                "text": "„Die Regularitäten des Schriftsystems, verstanden als grammatische Regularitäten im Sinne von Artikel 117, lassen sich übersichtlich ordnen in wortbezogene einerseits und satzbezogene andererseits.“"
                            },
                            {
                                "example_id": "d9e47d49-981d-493f-9cf4-2bdf28097099",
                                "sense_id": "0d65777a-835c-357a-89a1-0334bff84bf9",
                                "text": "„Schon beim Spracherwerb zeigen sich ja Regularitäten, und zwar gerade in den vielen Fehlern, die Kinder machen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ed41f800-c894-3996-b7dc-d3ae2b2c4d07",
                        "entry_id": "04989f00-a8b2-3fa0-8ea7-109b7d803c46",
                        "glosses": [
                            "Eigenschaft, (im jeweiligen Sinnzusammenhang) regulär zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94542cc3-a51b-4911-8d8d-fb75dda135fa",
                                "sense_id": "ed41f800-c894-3996-b7dc-d3ae2b2c4d07",
                                "text": "„In Räumen mit abzählbarer Basis fällt die vollständige Regularität mit der Regularität zusammen […]. “"
                            },
                            {
                                "example_id": "f9fcd924-294f-4486-b133-e282850d742f",
                                "sense_id": "ed41f800-c894-3996-b7dc-d3ae2b2c4d07",
                                "text": "„Somit stimmt die Singularität (bzw. Regularität) eines Operators mit der Singularität (bzw. Regularität) der ihm bei gegebener Basis entsprechenden Matrix überein.“"
                            },
                            {
                                "example_id": "b4d74d69-c3df-4e36-bb54-e9ea1a1566d7",
                                "sense_id": "ed41f800-c894-3996-b7dc-d3ae2b2c4d07",
                                "text": "„Man unterscheidet zwischen der Regularität von innen und der Regularität von außen eines Maßes.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
