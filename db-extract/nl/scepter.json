                    },
                    {
                        "translation_id": "6ded376a-949a-470c-8b65-0a6cfa3d71b2",
                        "source_entry_id": "bfc59828-1dfa-38f6-9d2c-16ee3c1ec6ba",
                        "source_sense_id": "343f07a2-421f-3c2b-ac07-a3839690247f",
                        "source_sense_description": "sierlijk bewerkte staf, symbool voor het gezag van een regerende vorst",
                        "target_lang_word": "sceptre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sceptre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f40ac55-5970-3c55-9670-5d57f16571e1",
                                        "entry_id": "dcfd78bc-fd92-32e7-ac3e-26596fac383b",
                                        "glosses": [
                                            "Bâton de commandement, qui est une des marques de la royauté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30397c12-71e2-4cfa-8835-b748cd313390",
                                                "sense_id": "8f40ac55-5970-3c55-9670-5d57f16571e1",
                                                "text": "Le roi avait la couronne en tête et le sceptre en main."
                                            },
                                            {
                                                "example_id": "0be0a6d0-49f2-423d-be55-a00a4f3c4217",
                                                "sense_id": "8f40ac55-5970-3c55-9670-5d57f16571e1",
                                                "text": "À toi qui fais du sceptre un assommoir, malheur !"
                                            },
                                            {
                                                "example_id": "938f0dee-f678-4af2-b326-092abc334d1d",
                                                "sense_id": "8f40ac55-5970-3c55-9670-5d57f16571e1",
                                                "text": "« Sur le trône, reprit Thornpipe, contemplez la Reine, — ressemblance garantie, — revêtue de ses habits de gala, le manteau royal attaché aux épaules, la couronne en tête et le sceptre à la main. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b97f762f-87c0-36f3-9e42-08acde9bd2df",
                                        "entry_id": "dcfd78bc-fd92-32e7-ac3e-26596fac383b",
                                        "glosses": [
                                            "Pouvoir souverain, la royauté même."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa526ba7-5f87-448b-bedc-a4177b1f2611",
                                                "sense_id": "b97f762f-87c0-36f3-9e42-08acde9bd2df",
                                                "text": "On s’aperçut d’abord, à la manière dont Itobad gouvernait son cheval, que ce n’était pas un homme comme lui à qui le Ciel réservait le sceptre de Babylone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea5ce72e-9ad7-3480-b4af-1076d69740cb",
                                        "entry_id": "dcfd78bc-fd92-32e7-ac3e-26596fac383b",
                                        "glosses": [
                                            "Supériorité, prééminence en quelque chose que ce soit."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ad6b1e6-ee1e-4427-a70f-0e6c5f1e1825",
                                                "sense_id": "ea5ce72e-9ad7-3480-b4af-1076d69740cb",
                                                "text": "Chez les latins le sceptre de la poésie appartient à Virgile."
                                            },
                                            {
                                                "example_id": "b194237f-71b0-4f9a-ab4a-191e4d89a0f8",
                                                "sense_id": "ea5ce72e-9ad7-3480-b4af-1076d69740cb",
                                                "text": "Aucun orateur ne dispute à Démosthène le sceptre de l’éloquence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a4bb9ba-60a0-45e3-9c3d-80f000e5436f",
