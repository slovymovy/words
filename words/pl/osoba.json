                            {
                                "target_lang_word": "персонаж",
                                "target_lang_sense_clarification": "герой произведения"
                            },
                            {
                                "target_lang_word": "герой",
                                "target_lang_sense_clarification": "главное действующее лицо"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "character",
                                "target_lang_sense_clarification": "a person in a novel, play, or movie"
                            },
                            {
                                "target_lang_word": "person",
                                "target_lang_sense_clarification": "a character or part in a play"
