                        "examples": [
                            {
                                "example_id": "08bc9b95-b8c8-4575-b084-088033425660",
                                "sense_id": "c0358f5f-34c2-32fb-b9e9-0db2504b16ec",
                                "text": "Alles Geld der Welt würde ich für dich geben.",
                                "translation": "All the money in the world I'd give for you.",
                                "english": "All the money in the world I'd give for you."
                            },
                            {
                                "example_id": "af7b1490-0ad3-41dd-966e-f080cc8a1a0a",
                                "sense_id": "c0358f5f-34c2-32fb-b9e9-0db2504b16ec",
                                "text": "Ich wünsche dir alles Gute.",
                                "translation": "I wish you all the best.",
                                "english": "I wish you all the best."
                            }
                        ]
                    }
