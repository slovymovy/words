                        "entry_id": "6305ff9d-95e9-31e8-a350-2abefe2e6e83",
                        "glosses": [
                            "Engouement massif pour la franchise Pokémon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "753a2913-0479-4b38-b6be-6ae466ebe4f0",
                                "sense_id": "b722bfb5-c22c-3546-bce7-36761fdcfc09",
                                "text": "Pour faire la promotion de ce film qui agite un pays encore bien plongé dans la Pokémania, des dizaines de Pikachu sont sortis de leurs cachettes pour sillonner les rues japonaises !"
                            }
                        ]
                    }
