    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "876f61a6-17b2-3c07-bac2-0eafaa4deb4f",
                    "sense_definition": "met enige vaart iets (vaak iets zachts of vloeibaars) ergens tegenaan of neergooien",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "werpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>kwakte</w> de natte verf met een grote spatel op het doek.",
                            "target_lang_translations": {
                                "fr": "Il a <w>balancé</w> la peinture fraîche sur la toile avec une grande spatule."
                            }
                        },
                        {
                            "text": "De kok <w>kwakt</w> een flinke schep aardappelpuree op het bord van de gast.",
                            "target_lang_translations": {
                                "fr": "Le cuisinier <w>flanque</w> une bonne louche de purée dans l'assiette du client."
                            }
                        }
                    ],
                    "synonyms": [
                        "smakken",
                        "gooien",
                        "kwakkelen",
                        "smijten"
                    ],
                    "common_phrases": [
                        "op het bord kwakken",
                        "op de grond kwakken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Jeter ou projeter brusquement quelque chose (souvent mou ou liquide) contre ou sur une surface"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "balancer",
                                "target_lang_sense_clarification": "jeter négligemment ou brutalement"
                            },
                            {
                                "target_lang_word": "flanquer",
                                "target_lang_sense_clarification": "jeter sans ménagement"
                            },
                            {
                                "target_lang_word": "plaquer",
                                "target_lang_sense_clarification": "appliquer ou jeter contre une surface"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e9311ec-be0b-3702-84d0-d8f0d90e77cf",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>kwak</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er lagen vieze <w>kwakken</w> modder op de pas geboende vloer in de hal.",
                            "target_lang_translations": {
                                "fr": "Il y avait de sales <w>pâtés</w> de boue sur le sol fraîchement ciré du hall."
                            }
                        },
                        {
                            "text": "De schilder bracht dikke <w>kwakken</w> verf aan om meer textuur te creëren.",
                            "target_lang_translations": {
                                "fr": "Le peintre a appliqué d'épais <w>paquets</w> de peinture pour donner plus de texture."
                            }
                        }
                    ],
                    "synonyms": [
                        "klodders",
                        "kwakjes"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Pluriel de « kwak » : gros pâtés, éclaboussures ou paquets d'une substance molle ou visqueuse"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pâtés",
