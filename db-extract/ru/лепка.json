                "senses": [
                    {
                        "sense_id": "b2b34e1a-2f18-337e-9228-afe64b79a716",
                        "entry_id": "22e5adb3-ead5-39d9-8e84-06eaf388e0c7",
                        "glosses": [
                            "действие по значению гл. лепить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b25ef10-2e7a-4948-869b-e87ad8a9eb1b",
                                "sense_id": "b2b34e1a-2f18-337e-9228-afe64b79a716",
                                "text": "Сам лепил и отливал сам. Интересное дело ― лепка и литьё! Думаю заняться."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca334e51-5e8b-32c0-8fd8-f91cc7ed80c3",
                        "entry_id": "22e5adb3-ead5-39d9-8e84-06eaf388e0c7",
                        "glosses": [
                            "результат такого действия; то, что вылеплено, прилеплено и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aceef094-7d5d-4b1c-b63b-19535557d71d",
                                "sense_id": "ca334e51-5e8b-32c0-8fd8-f91cc7ed80c3",
                                "text": "Пошёл, представился, начальница показала музейчик: детские работы, лепка, «осень», «зима», «лето» и т. д."
                            }
                        ]
                    }
