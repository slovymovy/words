                ],
                "senses": [
                    {
                        "sense_id": "cfa554fe-cb66-3231-8112-140e855043d2",
                        "entry_id": "65cf5f16-fac6-3ccd-ad23-57edbdbcdc4b",
                        "glosses": [
                            "een kaart van het oppervlak van de aarde in de vorm van een bol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77b6bd18-1c38-4407-80aa-831ef193484c",
                                "sense_id": "cfa554fe-cb66-3231-8112-140e855043d2",
                                "text": "Op de tafel stond een wereldbol."
                            },
                            {
                                "example_id": "05bfb2fa-ab94-459a-a5c6-978635c9f741",
                                "sense_id": "cfa554fe-cb66-3231-8112-140e855043d2",
                                "text": "Er waren objecten die aangespoeld leken te zijn in de suite - zoals oude boeken, een koperen belletje, een grote asbak in de vorm van een halve wereldbol die door Atlas op zijn schouders werd getorst, een muizenschedeltje, divers schrijfgerei, een monocle in een etui, een opgezet kerkuiltje, een sigarenknipper, een kompas, een mondharp, een wajangpop, een messing vaas met pauwenveren erin, een spuitwaterfles en een houten monnik die als notenkraker bleek te kunnen dienen - waarvan niet duidelijk was of ze bedoeld waren om deel uit te maken van een decoratief concept, dan wel van meerdere, uiteenlopende ideeën over de inrichting die in de loop van de geschiedenis halfslachtig waren toegepast zonder dat er moeite was gedaan om de resultaten van eerdere soortgelijke pogingen te verwijderen, of dat het spullen betrof die door vroegere reizigers waren vergeten, waarna de kamermeisjes, in de filosofische overtuiging dat de geschiedenis door de verstrooide afzetting van toevallige sedimenten, die niet ongedaan gemaakt kunnen worden, het heden vormgeeft, tot op de dag van vandaag hebben geweigerd de sporen uit te wissen."
                            }
                        ]
                    },
                    {
                        "sense_id": "38e0bcb0-9a5e-3d64-9544-e0365214793d",
                        "entry_id": "65cf5f16-fac6-3ccd-ad23-57edbdbcdc4b",
                        "glosses": [
                            "de wereld zelf"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ace350a4-a562-401a-905f-08852a03c68a",
                                "sense_id": "38e0bcb0-9a5e-3d64-9544-e0365214793d",
                                "text": "Er zijn maar een paar mensen op de hele wereldbol die een wereldrecord neerzetten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97229528-bb19-4991-a36b-bc219fef3c92",
                        "source_entry_id": "65cf5f16-fac6-3ccd-ad23-57edbdbcdc4b",
                        "source_sense_id": "cfa554fe-cb66-3231-8112-140e855043d2",
                        "source_sense_description": "een kaart van het oppervlak van de aarde in de vorm van een bol",
                        "target_lang_word": "globe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "globe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9889d9ff-e166-3bc9-aea7-af829b44c470",
                                        "entry_id": "014b8985-098d-3211-afd4-d3a7d97e4aa8",
                                        "glosses": [
                                            "Any spherical (or nearly spherical) object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf46314e-bcc5-483e-8e11-020e72639d08",
                                                "sense_id": "9889d9ff-e166-3bc9-aea7-af829b44c470",
                                                "text": "the globe of the eye; the globe of a lamp"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a79cc95e-5e91-31c5-8408-df1e0c47cdb2",
                                        "entry_id": "014b8985-098d-3211-afd4-d3a7d97e4aa8",
                                        "glosses": [
                                            "The planet Earth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a313eb8-c82f-4de7-be17-e9c9f90d0573",
                                                "sense_id": "a79cc95e-5e91-31c5-8408-df1e0c47cdb2",
                                                "text": "Already Cæſar\nHas ravaged more than half the Globe, and ſees\nMankind grown thin by his deſtructive Sword:\nShould he go further, Numbers would be wanting\nTo form new Battels, and ſupport his Crimes."
                                            },
                                            {
                                                "example_id": "99e4a8c2-af88-406a-acae-bc7658611894",
                                                "sense_id": "a79cc95e-5e91-31c5-8408-df1e0c47cdb2",
                                                "text": "But whatever opinion or theory may be formed by any one, all agree that at some period or other this world has been destroyed by water, and that the proofs of this assertion are found in every part of the globe"
                                            },
                                            {
                                                "example_id": "cc14c079-1681-4dd6-b410-04d52fbf2205",
                                                "sense_id": "a79cc95e-5e91-31c5-8408-df1e0c47cdb2",
                                                "text": "Hidden behind thickets of acronyms and gorse bushes of detail, a new great game is under way across the globe. Some call it geoeconomics, but it's geopolitics too. The current power play consists of an extraordinary range of countries simultaneously sitting down to negotiate big free trade and investment agreements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5e1d606-8414-3042-9cd3-7b4b4e2016e4",
                                        "entry_id": "014b8985-098d-3211-afd4-d3a7d97e4aa8",
                                        "glosses": [
                                            "A spherical model of Earth or other planet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84b6fbe8-0beb-3f3f-a866-e5b91af9f426",
                                        "entry_id": "014b8985-098d-3211-afd4-d3a7d97e4aa8",
                                        "glosses": [
                                            "A light bulb."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "South-Africa",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94a5579f-0b76-49bc-9413-89b2006e014a",
                                                "sense_id": "84b6fbe8-0beb-3f3f-a866-e5b91af9f426",
                                                "text": "Don't ask for a new globe just because the old one needs dusting. The old-style carbon lamps wasted electricity when they began to fade and it was economy to replace them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc89bdfd-cd28-3cb8-84f3-b23a439f5dcd",
                                        "entry_id": "014b8985-098d-3211-afd4-d3a7d97e4aa8",
                                        "glosses": [
                                            "A circular military formation used in Ancient Rome, corresponding to the modern infantry square."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f82eb549-f1c0-4a93-8865-9e40a57b5d88",
                                                "sense_id": "fc89bdfd-cd28-3cb8-84f3-b23a439f5dcd",
                                                "text": "Him round / A globe of fiery seraphim enclosed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d291df9-41e8-304a-ad11-b69f893a3ea7",
                                        "entry_id": "014b8985-098d-3211-afd4-d3a7d97e4aa8",
                                        "glosses": [
                                            "A woman's breast or buttock, whichever is more prominent."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5fc15b9-9163-4f0b-b5df-cfd604847710",
                                                "sense_id": "7d291df9-41e8-304a-ad11-b69f893a3ea7",
                                                "text": "Meanwhile, Jennifer Lopez went with her favorite silhouette: a robe-like dress, barely fastened solely in the areas you actually can’t reveal on the red carpet (remember that famous Versace number at the Grammys?). This year, she wore a silver and cream Zuhair Murad that showed off all of her best assets, which even caused Jeremy Renner to blurt out a comment about her “globes” on stage."
                                            },
                                            {
                                                "example_id": "1e6f0add-a39b-4aa8-9e92-e05f52d38a89",
                                                "sense_id": "7d291df9-41e8-304a-ad11-b69f893a3ea7",
                                                "text": "'I got my wig out and my globes,' she joked to E! News host Ryan Seacrest, adjusting her breasts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "188bd726-3dd7-3f84-a411-fbbd873bc635",
                                        "entry_id": "014b8985-098d-3211-afd4-d3a7d97e4aa8",
                                        "glosses": [
                                            "A group."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0fbd9c19-8eb0-3a5e-8ecf-265a93568549",
                                        "entry_id": "014b8985-098d-3211-afd4-d3a7d97e4aa8",
                                        "glosses": [
                                            "A land snail of the genus Mesodon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
