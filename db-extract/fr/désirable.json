        "fr-extract.jsonl": [
            {
                "entry_id": "a752c7d8-4cb4-3b37-aa2e-5f963d0df16d",
                "word": "désirable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c76ec040-8671-473b-92ba-513504f2fc67",
                        "entry_id": "a752c7d8-4cb4-3b37-aa2e-5f963d0df16d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "désirables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "84c9945e-0b4e-3a39-b576-99e77fce0879",
                        "entry_id": "a752c7d8-4cb4-3b37-aa2e-5f963d0df16d",
                        "glosses": [
                            "Qui mérite d’être désiré ; qui excite le désir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cce0c1e-de49-4448-93ba-8cd050e56ce4",
                                "sense_id": "84c9945e-0b4e-3a39-b576-99e77fce0879",
                                "text": "Il serait toutefois désirable que le constructeur étalonnât chaque instrument avec un pyrhéliomètre donnant des valeurs absolues."
                            },
                            {
                                "example_id": "26a90101-2a1c-4ad6-a35f-ce43fc260d06",
                                "sense_id": "84c9945e-0b4e-3a39-b576-99e77fce0879",
                                "text": "D’abord, les deux nouveaux venus parurent terribles, puis ils furent agréables et désirables comme des frères."
                            },
                            {
                                "example_id": "85c6b82c-e996-4f8c-9b14-f036613eaf39",
                                "sense_id": "84c9945e-0b4e-3a39-b576-99e77fce0879",
                                "text": "Faute de pouvoir faire toute la lumière désirable sur ce fait énigmatique, nous réunirons ici le faisceau de vraisemblances et de témoignages qui peuvent seuls nous éclairer pour le moment."
                            },
                            {
                                "example_id": "98c26f1e-6419-4846-92ed-2e572a8a47b5",
                                "sense_id": "84c9945e-0b4e-3a39-b576-99e77fce0879",
                                "text": "Il n’y a pas de dénonciation dogmatique dans le papier de Bonnafé, plutôt une confrontation entre temps long et temps court qui soulève des questions naïves mais existentielles : quelle est cette société dans laquelle le fait de boire un concentré soit-disant optimal, seul à son bureau le midi, est-il devenu désirable ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "93d95713-a9cb-3f53-99bf-8b592e39311a",
                        "entry_id": "a752c7d8-4cb4-3b37-aa2e-5f963d0df16d",
                        "glosses": [
                            "Qui provoque à la concupiscence."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "58b23c7c-583f-41af-8401-50788976da62",
                                "sense_id": "93d95713-a9cb-3f53-99bf-8b592e39311a",
                                "text": "Vêtue d’une tunique de velours bleu de roi, sous laquelle on pouvait à loisir la deviner toute, jamais encore Lady Flora ne m’était apparue plus belle que ce soir, ni – pour employer un qualificatif peu sympathique qui dit bien ce qu’il veut dire – plus désirable."
                            },
                            {
                                "example_id": "4c7414ca-353f-4cd6-b9f8-144312485f0a",
                                "sense_id": "93d95713-a9cb-3f53-99bf-8b592e39311a",
                                "text": "Philippe se félicitait de son flair et mourait d'envie de serrer contre lui les rondeurs à la fois dissimulées et révélées par la robe moulante. Elle repoussa ses avances avec une pudeur de violette, qui ne fit que la lui rendre plus désirable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "410484f8-8eec-44a0-b69e-4b3811697800",
                        "source_entry_id": "a752c7d8-4cb4-3b37-aa2e-5f963d0df16d",
                        "target_lang_word": "desirable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desirable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f0c12de-13f2-38c9-9ae2-db8225e559d9",
                                        "entry_id": "830289b1-f009-365b-bfa2-afe4885714f1",
                                        "glosses": [
                                            "Worthy to be desired; pleasing; agreeable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "385de243-cf5f-4429-887a-7dbdf9f0515a",
                                                "sense_id": "2f0c12de-13f2-38c9-9ae2-db8225e559d9",
                                                "text": "This applicant has almost all desirable properties."
                                            },
                                            {
                                                "example_id": "8e6117db-9421-4056-bfbf-ce5384961cbb",
                                                "sense_id": "2f0c12de-13f2-38c9-9ae2-db8225e559d9",
                                                "text": "It has long been recognised that complete segregation of control of the respective services provided by the two undertakings, and of the power supply, signalling, and tracks relating to each was desirable."
                                            },
                                            {
                                                "example_id": "246bdfce-00a4-45ff-ac97-79bdbda1ba30",
                                                "sense_id": "2f0c12de-13f2-38c9-9ae2-db8225e559d9",
                                                "text": "With fresh material, taxonomic conclusions are leavened by recognition that the material examined reflects the site it occupied; a herbarium packet gives one only a small fraction of the data desirable for sound conclusions. Herbarium material does not, indeed, allow one to extrapolate safely: what you see is what you get[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "desirable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dddf41bf-02fa-3834-9b4e-d6f903367861",
                                        "entry_id": "77c6221a-36cf-3650-af67-ab1fbb3cdd35",
                                        "glosses": [
                                            "A thing that people want; something that is desirable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "135ea3ff-f980-42b1-ac2f-d4f6ac7ac1df",
                                                "sense_id": "dddf41bf-02fa-3834-9b4e-d6f903367861",
                                                "text": "There are plenty of desirables on display in the window."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
