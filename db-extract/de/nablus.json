                "senses": [
                    {
                        "sense_id": "7a2f532e-009d-314c-8658-93f65968606d",
                        "entry_id": "7425aea6-8cdc-3789-adbd-51e2c64a48a8",
                        "glosses": [
                            "Stadt im Westjordanland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e81129b2-7940-4490-9677-45516df005a5",
                                "sense_id": "7a2f532e-009d-314c-8658-93f65968606d",
                                "text": "„Mit dem Bau der Eisenbahnlinien zwischen Damaskus, Haifa und Nablus rückte es später in die Nähe eines Eisenbahnknotenpunkts.“"
                            },
                            {
                                "example_id": "b03fb12a-ecbc-4fac-ac2e-4ab4181f9874",
                                "sense_id": "7a2f532e-009d-314c-8658-93f65968606d",
                                "text": "„Der Befehl lautete, eine Eroberung des Umlands von Jenin im Norden des heutigen Westjordanlands zu versuchen und, falls sie erfolgreich verlaufen sollte, weiter nach Nablus vorzurücken.“"
                            },
                            {
                                "example_id": "41b69df5-2e5f-4f2a-b5ec-a0a5f8888c66",
                                "sense_id": "7a2f532e-009d-314c-8658-93f65968606d",
                                "text": "„Während sich seine Schwester in Ramallah umschaute, erwischte er eine Mitfahrgelegenheit zum Rafidia-Krankenhaus in Nablus und ging dann weiter bis Ein Kerem.“"
                            },
                            {
                                "example_id": "1be45b28-ee27-4428-9f69-24144018e516",
                                "sense_id": "7a2f532e-009d-314c-8658-93f65968606d",
                                "text": "„Die 1946 in Nablus (im heutigen Westjordanland) geborene christliche Palästinenserin stand nicht nur im Auftreten in starkem Kontrast zu Jassir Arafat und zur PLO-Exilführung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
