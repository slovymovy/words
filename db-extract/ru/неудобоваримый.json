                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9776b189-27ba-416b-9bc7-fe5c0f72b4f4",
                                "sense_id": "6d190ca6-3d1a-3b3d-a703-6ee2a7447740",
                                "text": "Восхища́ясь неудобовари́мыми эпи́тетами, дю́жинными остро́тами, вы́ветрившимися сравне́ниями, Клешня́к ду́мал о себе́, о свое́й бога́той собы́тиями жи́зни, о том, что жаль, что он не мо́жет описа́ть свою́ герои́ческую жизнь, переда́ть свой о́пыт подраста́ющему поколе́нию.",
                                "translation": "Konstantin Vaginov",
                                "english": "Konstantin Vaginov"
                            }
                        ]
                    }
