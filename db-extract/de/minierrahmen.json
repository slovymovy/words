                "senses": [
                    {
                        "sense_id": "fcea3d40-2d85-3f73-9812-8d03ce1563eb",
                        "entry_id": "9fff449f-a54d-30fa-9fcc-1d02de6dc0e6",
                        "glosses": [
                            "Rahmenkonstruktion aus Platten, um einen Stollen oder Ähnliches abzusichern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "539cc844-abb8-4a67-9c16-f15b0c94decb",
                                "sense_id": "fcea3d40-2d85-3f73-9812-8d03ce1563eb",
                                "text": "„Wir trieben neben unserm Unterstand einen Schacht in die Kreide und steiften ihn mit Minierrahmen ab.“"
                            },
                            {
                                "example_id": "cc3477ef-73de-4089-9c1e-28c512b91582",
                                "sense_id": "fcea3d40-2d85-3f73-9812-8d03ce1563eb",
                                "text": "„Bei der Bergung von Menschen aus Untergrund wird es oft nicht anders möglich sein, an die Verschütteten heranzukommen, als einen Stollen oder Kriechgang aus Minierrahmen in die Trümmer zu treiben.“"
                            },
                            {
                                "example_id": "602b2113-57d7-4fab-b527-cc135b9e22a3",
                                "sense_id": "fcea3d40-2d85-3f73-9812-8d03ce1563eb",
                                "text": "„Der Trägertrupp schleppt die schweren Minierrahmen nach vorn.“"
                            },
                            {
                                "example_id": "939044d9-71d8-4487-a0e2-992a23205d67",
                                "sense_id": "fcea3d40-2d85-3f73-9812-8d03ce1563eb",
                                "text": "„Zur Versteifung der Schächte und der Unterstände dienen Minierrahmen aus Bohlen (s. Abb. 9).“"
                            },
                            {
                                "example_id": "ef4afa7c-b788-4a4f-b4ed-6f02f55e7fd9",
                                "sense_id": "fcea3d40-2d85-3f73-9812-8d03ce1563eb",
                                "text": "„So manche Bäume aus den großen Wäldern des besetzten Gebietes in Rußland und Frankreich verwandelten sich mit Hilfe von Sägegattern, Kreissägen und anderen Holzbearbeitungsmaschinen in Minierrahmen zum Stollenbau, in Bretter und Bohlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
