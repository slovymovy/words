                                            {
                                                "example_id": "f2646e8e-79d7-4e48-940a-76929d92b8c7",
                                                "sense_id": "52c9d287-7bd4-3678-8a49-fe71aa0aac9b",
                                                "text": "Sin embargo, el hembrismo, familiarmente promovido, conlleva a la mujer joven (aprendiz) a emprender una confrontación por el poder contra el hombre"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
