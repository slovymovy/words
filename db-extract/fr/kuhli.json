                ],
                "senses": [
                    {
                        "sense_id": "bea7b66c-388e-310b-9a7d-449268d70e28",
                        "entry_id": "8e37b3f0-4020-39f3-bf2b-1c2e97ba6b2a",
                        "glosses": [
                            "Petite loche serpentiforme d’Asie du Sud-est, fréquemment élevée dans les aquariums d’eau douce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319c3c8e-55a3-444f-a90e-8069c141ad38",
                                "sense_id": "bea7b66c-388e-310b-9a7d-449268d70e28",
                                "text": "Plusieurs paires de barbillons permettent au kuhli de trouver sa nourriture sur le sol."
                            },
                            {
                                "example_id": "a706666e-8bbf-47dd-9bc8-e3e351685b99",
                                "sense_id": "bea7b66c-388e-310b-9a7d-449268d70e28",
                                "text": "Le kuhli est un poisson complètement dépourvu d’agressivité et extrêmement timide. Il vivra la plupart du temps caché dans les recoins les plus obscurs de l’aquarium."
                            },
                            {
                                "example_id": "e9977e08-fefd-4a5d-b197-faef027a6a4e",
                                "sense_id": "bea7b66c-388e-310b-9a7d-449268d70e28",
                                "text": "Le kuhli convient comme poisson de fond dans un aquaterrarium."
                            }
                        ]
                    }
                ],
