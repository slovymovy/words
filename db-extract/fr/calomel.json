        "fr-extract.jsonl": [
            {
                "entry_id": "16bda249-d67d-30ba-b20b-56b8a90dbd87",
                "word": "calomel",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "51d934e3-efee-4732-a443-d3ab09f0c0bd",
                        "entry_id": "16bda249-d67d-30ba-b20b-56b8a90dbd87",
                        "tags": [
