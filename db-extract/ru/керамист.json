                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "09ce22ed-533d-45de-8caf-27deeaab94c3",
                        "source_entry_id": "b0f7be3a-fdd2-3c43-9b1d-800ab01bdc1b",
                        "source_sense_id": "0f4f1d87-c1a9-39a8-84a8-0254f2b4048f",
                        "target_lang_word": "maiolicaio",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7166a7a9-cea2-4f77-9ac1-3d214cf1d07b",
                        "source_entry_id": "b0f7be3a-fdd2-3c43-9b1d-800ab01bdc1b",
                        "source_sense_id": "0f4f1d87-c1a9-39a8-84a8-0254f2b4048f",
                        "target_lang_word": "Keramiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Keramiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6da28f0a-07f7-34c2-88c6-da2b68d4ffb3",
                                        "entry_id": "4d0889ef-2bcd-3ee0-92ae-1690d1753735",
                                        "glosses": [
                                            "Person, die beruflich Keramiken herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5e6cf7c-18f9-46cf-8682-ce623330c7b3",
                                                "sense_id": "6da28f0a-07f7-34c2-88c6-da2b68d4ffb3",
                                                "text": "„Inzwischen aber war er immer wieder bemüht, seine Mißerfolge als Keramiker durch Arbeiten in Elfenbein und Thon auszugleichen, wovon seine Arbeiten in den Sammlungen des Schlosses Rosenberg in Kopenhagen und im schleswig-holsteinischen Privatbesitz Zeugniß ablegen.“"
                                            },
                                            {
                                                "example_id": "d66b39b1-98e7-4e68-9145-6bb1a1647f09",
                                                "sense_id": "6da28f0a-07f7-34c2-88c6-da2b68d4ffb3",
                                                "text": "„In einem Kloster in der Eifel, weit weg von Weimar und Dessau, lebt das Bauhaus weiter. Hier werden die Entwürfe von Theodor Bogler wieder hergestellt. Er war Mönch und einer der bekanntesten Keramiker des Bauhauses.“"
                                            },
                                            {
                                                "example_id": "c8ca931a-be7a-4721-af70-f1a82290fc97",
                                                "sense_id": "6da28f0a-07f7-34c2-88c6-da2b68d4ffb3",
                                                "text": "„Ganze 18 Jahre lang arbeitete der Keramiker Hans Kuretzky für ein besonderes Hamburger Wahrzeichen: Für die Sanierung des alten Elbtunnels entwarf, brannte und glasierte er tausende von Fliesen und Kacheln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35aa3c6d-1729-42e5-8d33-68c0887645f4",
                        "source_entry_id": "b0f7be3a-fdd2-3c43-9b1d-800ab01bdc1b",
                        "source_sense_id": "0f4f1d87-c1a9-39a8-84a8-0254f2b4048f",
