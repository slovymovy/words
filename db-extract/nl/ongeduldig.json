                    {
                        "sense_id": "b573d305-f82a-336e-a586-66ba6af0c59f",
                        "entry_id": "c51666a5-bdc9-3c0a-b7d2-20541af19c3b",
                        "glosses": [
                            "onwillig nog langer te wachten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69e41b44-78a7-46f5-b86a-f4831be1aa13",
                                "sense_id": "b573d305-f82a-336e-a586-66ba6af0c59f",
                                "text": "Het was niet makkelijk een hele klas ongeduldige kinderen in toom te houden."
                            },
                            {
                                "example_id": "ec8b1fa8-6989-44a5-a3a6-be04aecf3ae8",
                                "sense_id": "b573d305-f82a-336e-a586-66ba6af0c59f",
                                "text": "Ik ben nu eenmaal erg ongeduldig, een eigenschap waar ik niet trots op ben en die moeilijk af te schudden is."
                            },
                            {
                                "example_id": "2ea30854-eba5-4d0a-b56d-b1b39442bfea",
                                "sense_id": "b573d305-f82a-336e-a586-66ba6af0c59f",
                                "text": "De ongeduldige man"
                            }
                        ]
                    }
                ],
