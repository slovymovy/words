                    {
                        "sense_id": "7d268bd6-a59c-3aa4-931c-aa1d45cb57b9",
                        "entry_id": "f358dafd-8429-3a30-b0e3-cbd1ee4311e9",
                        "glosses": [
                            "Traitement des combustibles usés pour en extraire les matières fissiles et fertiles de façon à permettre leur réutilisation, et pour conditionner les différents déchets sous forme apte au stockage."
                        ],
                        "tags": [
                            "Cycle du combustible nucléaire"
                        ],
                        "examples": [
                            {
                                "example_id": "66b7b235-bdf7-4ae3-85b2-348676d99ed9",
                                "sense_id": "7d268bd6-a59c-3aa4-931c-aa1d45cb57b9",
                                "text": "Le retraitement consiste à séparer, dans les combustibles irradiés, d’une part, l’uranium et le plutonium, réutilisables, d’autre part les produits de fission qui n’ont plus d'utilité et qui sont fortement radioactifs."
                            }
                        ]
                    }
