                    {
                        "sense_id": "bd238e3c-0352-3013-9313-7cdfba24b9b3",
                        "entry_id": "21e40d5a-8fee-3ff9-8f88-34b14466cf72",
                        "glosses": [
                            "Arbre de la forêt équatoriale d’Afrique, son appellation binomiale est Khaya senegalensis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baeb3bcb-e5f2-4dbc-8e0b-d523cd066149",
                                "sense_id": "bd238e3c-0352-3013-9313-7cdfba24b9b3",
                                "text": "De l’écorce du cail-cédra comme succédané de celle du quinquina. M. Servant lui envoya l’écorce du cail-cédra, comme étant le fébrifuge le plus estimé par la population indigène, à tel point que … 11 lui a donc donné le nom de cail-cédrin."
                            },
                            {
                                "example_id": "d4980bbd-93d4-4a52-8d49-f7d827f61472",
                                "sense_id": "bd238e3c-0352-3013-9313-7cdfba24b9b3",
                                "text": "Il y a, au nord de Mozambique, des forêts immenses de bois dur, ressemblant au teck de l’Inde et au cail cédrat de la côte occidentale."
                            }
                        ]
                    }
