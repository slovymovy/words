                        "cross_references": [
                            {
                                "target_word": "Calcium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "500773e2-8d21-3661-b29e-f3ffa2f4dce2",
                                        "entry_id": "983cb00c-7b0c-30c4-9955-9744bb958e8a",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 20, das zur Gruppe der Erdalkalimetalle gehört"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a604d679-e56b-42e8-b130-42ef006db117",
                                                "sense_id": "500773e2-8d21-3661-b29e-f3ffa2f4dce2",
                                                "text": "Calcium ist Bestandteil der Knochen."
                                            },
                                            {
                                                "example_id": "c82facd6-b144-42eb-9c35-653f5a943832",
                                                "sense_id": "500773e2-8d21-3661-b29e-f3ffa2f4dce2",
                                                "text": "„Voraussetzung dafür, dass Calcium in größeren Mengen vom Körper aufgenommen werden kann, ist eine ausreichende Versorgung mit Vitamin D₃.“"
                                            },
                                            {
                                                "example_id": "7485d11b-c4ae-40ff-9628-314500903fc2",
                                                "sense_id": "500773e2-8d21-3661-b29e-f3ffa2f4dce2",
                                                "text": "„Für den Menschen stellen Calcium und Phosphor Nährstoffe dar, deren Zufuhr lebensnotwendig ist.“"
                                            },
                                            {
                                                "example_id": "3846ca33-b4f7-4eae-99f5-c3f273b5248a",
                                                "sense_id": "500773e2-8d21-3661-b29e-f3ffa2f4dce2",
                                                "text": "„Fluorid aber wird große Bedeutung beigemessen: Der Stoff unterstützt den Körper dabei, Calcium und andere Mineralien in den Zahnschmelz einzubauen, und beugt so Karies vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
