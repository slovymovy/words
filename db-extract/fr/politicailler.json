                "senses": [
                    {
                        "sense_id": "45db8100-5f29-3642-91a4-d7c4798c746a",
                        "entry_id": "c853c0d7-e8eb-34ba-bd29-0f1f2d254e33",
                        "glosses": [
                            "Faire de la politique."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "1f7cc59e-1ed3-4eea-b8be-900c602954cb",
                                "sense_id": "45db8100-5f29-3642-91a4-d7c4798c746a",
                                "text": "Ceux qui font métier de politicailler sont souvent des ambitieux ou des farceurs."
                            },
                            {
                                "example_id": "406fd7ad-39d5-455e-be84-81ca190f3c54",
                                "sense_id": "45db8100-5f29-3642-91a4-d7c4798c746a",
                                "text": "Il politicaillait avec la bonne droite, la modérée."
                            },
                            {
                                "example_id": "ea3fd66f-7478-4b73-9c3b-20b5ed7dde28",
                                "sense_id": "45db8100-5f29-3642-91a4-d7c4798c746a",
                                "text": "Dis-le carrément, vous, les empêcheurs de politicailler en rond, étiez en désaccord avec la ligne du Parti."
                            },
                            {
                                "example_id": "00f0cd78-2266-44ba-8081-8fdc4affc8b5",
                                "sense_id": "45db8100-5f29-3642-91a4-d7c4798c746a",
                                "text": "Plaire, aimer, enfanter, éduquer mes enfants, diriger mon ménage et … politicailler !"
                            }
                        ]
                    }
                ],
