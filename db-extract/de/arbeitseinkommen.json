                ],
                "senses": [
                    {
                        "sense_id": "b5c0713c-26c8-3d8b-9a9c-c3ffe7cd01a8",
                        "entry_id": "d6d417e8-f32a-3222-a5d5-251387ea7355",
                        "glosses": [
                            "Geld (oder geldwerter Vorteil, Sachleistung), für geleistete bezahlte Tätigkeit im Auftrag (Arbeit); Gewinn aus einer selbstständigen Tätigkeit"
                        ],
                        "tags": [
                            "speziell bei Selbstständigen"
                        ],
                        "examples": [
                            {
                                "example_id": "658dff83-4d0e-4b31-81c2-fecc5d962aed",
                                "sense_id": "b5c0713c-26c8-3d8b-9a9c-c3ffe7cd01a8",
                                "text": "Der Begriff Arbeitsentgelt wird dem Arbeitnehmer zugeordnet. Arbeitseinkommen ist im Sozialrecht der Einkommensbegriff für Selbstständige."
                            },
                            {
                                "example_id": "1d646ab3-ba95-4449-9d1e-5e9305fb1228",
                                "sense_id": "b5c0713c-26c8-3d8b-9a9c-c3ffe7cd01a8",
                                "text": "Einkünfte von Versicherten, die diese aus einer selbstständigen Erwerbstätigkeit haben, werden in der Sozialversicherung als Arbeitseinkommen bezeichnet."
                            },
                            {
                                "example_id": "69bde68d-fced-4c51-ba50-8935edbb6eb7",
                                "sense_id": "b5c0713c-26c8-3d8b-9a9c-c3ffe7cd01a8",
                                "text": "„So lag das bei der Künstlersozialversicherung für das Jahr 2019 gemeldete Jahresdurchschnittseinkommen von Künstlerinnen bei 15.128 Euro und von Künstlern bei 20.367 Euro. Das geringe Arbeitseinkommen zieht eine niedrige Altersrente nach sich, was dazu führt, dass viele im Kulturbereich Tätige im Alter in Armut leben oder weit über das Rentenalter hinaus zur Sicherung ihres Lebensunterhalts berufstätig bleiben müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
