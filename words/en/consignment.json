                    "frequency": "VeryLow",
                    "semantic_group_id": "shipping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal <w>consignment</w> of the estate assets to the trustee was completed last week."
                        },
                        {
                            "text": "He signed the document authorizing the <w>consignment</w> of the rare artifacts to the museum."
