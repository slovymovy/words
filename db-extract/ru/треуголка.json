                    },
                    {
                        "translation_id": "44a3c5a8-c537-45b6-be72-2101ce03116a",
                        "source_entry_id": "d115ad36-0693-3cd2-b52c-3233dea21fa2",
                        "source_sense_id": "061611b3-126f-3dd4-b576-36109d14110e",
                        "target_lang_word": "tricorno",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b34c034b-5722-43f6-9ff2-edd455576775",
                        "source_entry_id": "d115ad36-0693-3cd2-b52c-3233dea21fa2",
                        "source_sense_id": "061611b3-126f-3dd4-b576-36109d14110e",
                        "target_lang_word": "Dreispitz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreispitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6516b3c0-0076-36f3-ae7e-3e0196a873f8",
                                        "entry_id": "5941bcfb-63d6-3045-9bc6-10aa2bcd262e",
                                        "glosses": [
                                            "Hut, der drei Ecken/Spitzen aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e8bdee8-b1b2-400b-bdf6-edaab46e6f07",
                                                "sense_id": "6516b3c0-0076-36f3-ae7e-3e0196a873f8",
                                                "text": "„Wenn ich durch die Straßen gehe, staffieren mich die Leute in Gedanken mit einer Perücke und einem Dreispitz aus.“"
                                            },
                                            {
                                                "example_id": "599b6bc5-5ad7-460e-9600-dbb0a0ae4d8a",
                                                "sense_id": "6516b3c0-0076-36f3-ae7e-3e0196a873f8",
                                                "text": "„Auf dem Heck der Schiffe waren Totenköpfe zu sehen, und auf den Decks standen Kapitäne mit Dreispitz auf dem Kopf, die ihre Pistolen und Rapiere schwangen.“"
                                            },
                                            {
                                                "example_id": "9782ca84-464e-42c5-aec8-de689723f6e3",
                                                "sense_id": "6516b3c0-0076-36f3-ae7e-3e0196a873f8",
                                                "text": "„Pierre sah für eine Sekunde ein ruhiges, gut gebildetes, wohlgenährtes und weisses Gesicht unter einem Dreispitz.“"
                                            },
                                            {
                                                "example_id": "8f5746ee-1b2b-4e40-b296-9caf0da6381c",
                                                "sense_id": "6516b3c0-0076-36f3-ae7e-3e0196a873f8",
                                                "text": "„So gekleidet und mit meinem schönen goldbetreßten spanischen Dreispitz samt weißem Federbusch auf dem Kopf, öffnete ich ein Fenster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "686f87c6-64ed-4391-88e9-17a470c56eb1",
                        "source_entry_id": "d115ad36-0693-3cd2-b52c-3233dea21fa2",
                        "source_sense_id": "061611b3-126f-3dd4-b576-36109d14110e",
                        "target_lang_word": "Dreimaster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreimaster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "836d441f-ddef-3d78-8488-b4063e456c3a",
                                        "entry_id": "1be4f9bf-c054-3b4e-8be7-e5fdd48e3a99",
                                        "glosses": [
                                            "Segelschiff mit drei Masten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054564af-2d83-43cf-9ace-0b3664e2d3f6",
                                                "sense_id": "836d441f-ddef-3d78-8488-b4063e456c3a",
                                                "text": "„Wer sie zum ersten Mal sieht, ist fasziniert, und ihre Form erklärt, warum die Isländer sich früher erzählten, dass es sich bei den vier Zinnen um einen Dreimaster handelt, der von einer Trollfrau gezogen wird.“"
                                            },
                                            {
                                                "example_id": "0912d2e3-5e81-410b-a17a-2a94687a8abe",
                                                "sense_id": "836d441f-ddef-3d78-8488-b4063e456c3a",
                                                "text": "„Er fuhr mit den Fingern über ein Buddelschiff, das in einem der Bücherregale stand, in der hellblauen Glasflasche war ein Dreimaster ausgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59430fe6-3426-3d6b-bca4-5f5a06bc2994",
                                        "entry_id": "1be4f9bf-c054-3b4e-8be7-e5fdd48e3a99",
                                        "glosses": [
                                            "Kopfbedeckung, bei der die Krempe an drei Stellen hochgeklappt ist, mit der Spitze nach vorne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85903c64-2928-455a-96d0-b9af9408c579",
                                                "sense_id": "59430fe6-3426-3d6b-bca4-5f5a06bc2994",
                                                "text": "„Vornehmlich galt diese Aufmerksamkeit aber doch dem schönen jungen Kaiser Alexander, der die Uniform der Garde zu Pferde und den Dreimaster mit aufgeschlagener Krempe trug, seinem freundlichen Gesicht und seiner klangvollen, nur mässig lauten Stimme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a5d7b59-71c9-4d03-9e98-fdc675d18ce7",
                        "source_entry_id": "d115ad36-0693-3cd2-b52c-3233dea21fa2",
                        "source_sense_id": "061611b3-126f-3dd4-b576-36109d14110e",
                        "target_lang_word": "tricorne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tricorne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bbbd0e71-45d4-33bd-897c-9d97f2fe1192",
                                        "entry_id": "89fca265-dae3-3845-acff-68686d14d0f5",
                                        "glosses": [
                                            "Qui a trois cornes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93827f45-6218-4698-9e68-7866e58666bd",
                                                "sense_id": "bbbd0e71-45d4-33bd-897c-9d97f2fe1192",
                                                "text": "Dans un autre coteau , qui est aussi une très-bonne terre à blé, j’ai fait donner après la récolte de blé, un labour le plus profond possible, car huit bons bœufs étaient attelés après la charrue tricorne et tiraient de toute leur force."
                                            },
                                            {
                                                "example_id": "75dfb564-3f42-4a1a-8913-b3430c703f64",
                                                "sense_id": "bbbd0e71-45d4-33bd-897c-9d97f2fe1192",
                                                "text": "Sous Louis XVI, où déjà le chapeau rond commençait à se montrer par suite de l’engouement pour les usages anglais, le clergé portait le chapeau tricorne, que conservent encore de nos jours les ecclésiastiques qui affectent une plus grande régularité."
                                            },
                                            {
                                                "example_id": "01578762-dc90-47d3-94e6-3b4536d44be1",
                                                "sense_id": "bbbd0e71-45d4-33bd-897c-9d97f2fe1192",
                                                "text": "Le taureau tricorne, dont sont conservés la tête ainsi que la patte antérieure droite, est sans doute le plus prestigieux exemple de la grande statuaire antique en bronze découverte sur sol suisse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tricorne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a2259fa-69e4-335e-8e4d-36be8687cf86",
                                        "entry_id": "423bef48-df8b-3157-860f-45498f6d93b3",
                                        "glosses": [
                                            "Chapeau masculin porté aux XVIIᵉ et XVIIIᵉ siècles."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f91ac762-1943-4242-bc86-70153cc4a8c0",
                                                "sense_id": "2a2259fa-69e4-335e-8e4d-36be8687cf86",
                                                "text": "Pour mieux approcher sa tête du volet de bois, il avait ôté son tricorne et le tenait à sa main droite."
                                            },
                                            {
                                                "example_id": "5a76e1c7-2637-4c90-9bf0-ae60d0377cb2",
                                                "sense_id": "2a2259fa-69e4-335e-8e4d-36be8687cf86",
                                                "text": "Un homme à cheveux blancs dormait par terre à mes pieds ; un gendarme suait sous son tricorne, deux soldats avaient ôté leurs sacs et s’étaient couchés dessus."
                                            },
                                            {
                                                "example_id": "8f63a9c2-d404-47a0-bcf7-b1770b53bfa3",
                                                "sense_id": "2a2259fa-69e4-335e-8e4d-36be8687cf86",
                                                "text": "J’ai bien vu aussi, dans la foule autour du Capitole, le 6 janvier, des «manifestants» déguisés en révolutionnaires du 18e siècle, coiffés de tricornes…"
                                            },
                                            {
                                                "example_id": "d72463fa-495b-4121-ac11-bdcb9e80f015",
                                                "sense_id": "2a2259fa-69e4-335e-8e4d-36be8687cf86",
                                                "text": "Après quoi, ayant à nouveau baisé la main de ces dames, fait mes courbettes, claqué les talons, je courais joyeusement derrière le dépôt de bois où, coiffé d'un tricorne de papier et armé d'un bâton, je défendais l'Alsace-Lorraine, marchais sur Berlin et accomplissais la conquête du monde jusqu'à l'heure du goûter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
