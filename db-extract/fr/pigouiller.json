                ],
                "senses": [
                    {
                        "sense_id": "d373afed-bba9-3f42-a53e-bcc67f9b4650",
                        "entry_id": "05025fe0-c36f-38d7-8700-df06dca3bd69",
                        "glosses": [
                            "Pratiquer la pigouille pour faire avancer un bateau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9870073-bab2-4de5-b1aa-bb5d8173332d",
                                "sense_id": "d373afed-bba9-3f42-a53e-bcc67f9b4650",
                                "text": "La pigouille se pratique autant dans le Clain ou la Vonne que dans le Marais. Il est vrai qu'aujourd'hui le canoë ou le kayac détrônent nos vieilles plates d'antan et les jeunes ne savent pour ainsi dire plus pigouiller."
                            },
                            {
                                "example_id": "147272de-4abc-4277-803d-89ed9edde8ed",
                                "sense_id": "d373afed-bba9-3f42-a53e-bcc67f9b4650",
                                "text": "Partez pigouiller dans le Marais Poitevin"
                            },
                            {
                                "example_id": "b8c83484-fe0b-43aa-8e97-6ff27cf3fa4a",
                                "sense_id": "d373afed-bba9-3f42-a53e-bcc67f9b4650",
                                "text": "Madagascar pigouilla pour détacher la yole de la rive."
                            }
                        ]
                    },
                    {
                        "sense_id": "8198a752-1aa9-3906-8e8a-a141e8852ce1",
                        "entry_id": "05025fe0-c36f-38d7-8700-df06dca3bd69",
                        "glosses": [
                            "Piquer un cheval pour le faire avancer."
                        ],
                        "tags": [
                            "Acadie"
                        ],
                        "examples": [
                            {
                                "example_id": "507cad9e-9db4-44bd-95dc-b067128734dc",
                                "sense_id": "8198a752-1aa9-3906-8e8a-a141e8852ce1",
                                "text": "Vaincre le temps, ce n'est pas lui pigouiller les reins comme à un cheval fougueux. Bien au contraire, il faut stopper son élan, l'arrêter."
                            }
                        ]
                    }
                ],
