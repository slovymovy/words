                ],
                "senses": [
                    {
                        "sense_id": "57f29337-1be5-389b-98fc-08d7609c7cae",
                        "entry_id": "dc72fbec-f000-3da9-bf71-9616a0db28bc",
                        "glosses": [
                            "weibliche Person, die sich wissenschaftlich mit der Geschichte der Literatur beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70537b8b-86de-4027-9dca-358edd96bb0c",
                                "sense_id": "57f29337-1be5-389b-98fc-08d7609c7cae",
                                "text": "„Die Aufzeichnungen sind Historikern zwar schon seit längerem bekannt, doch erst unlängst stellte die Literaturhistorikerin Sally Wolff-King fest, dass eine langjährige Freundschaft Faulkner mit Leaks Urenkel verband.“"
                            },
                            {
                                "example_id": "4ea417b7-04c2-4403-93f4-95f567b1c755",
                                "sense_id": "57f29337-1be5-389b-98fc-08d7609c7cae",
                                "text": "„Zu den Zuhörern, die Jelineks Werk schon lange schätzen, zählt die Literaturhistorikerin Ebba Witt-Brattström, die sich um die feministische Literatur in Schweden sehr verdient gemacht hat: Sie ist mit Horace Engdahl verheiratet, der offen bekannte, Jelineks Bücher erst in den letzten beiden Jahren gelesen zu haben.“"
                            },
                            {
                                "example_id": "174b6369-5376-464c-a922-ae9e5867aa5b",
                                "sense_id": "57f29337-1be5-389b-98fc-08d7609c7cae",
                                "text": "„Zeit also, ‚den Mythos Inge Müller in einer Biographie zu fassen‘, wie die Schriftstellerin und Literaturhistorikerin Ines Geipel im Nachwort zu ‚Dann fiel auf einmal der Himmel um‘ sagt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
