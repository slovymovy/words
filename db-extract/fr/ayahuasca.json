                ],
                "senses": [
                    {
                        "sense_id": "c0e13564-0991-328f-ac53-b0069f24be4e",
                        "entry_id": "96d0defd-cd1f-34e9-a417-b2ca237e2964",
                        "glosses": [
                            "Breuvage hallucinogène à base de lianes de l’espèce Banisteriopsis caapi, consommé traditionnellement par les chamanes des tribus indiennes d’Amazonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59c28b5c-4996-4b34-892a-f5eca05a146a",
                                "sense_id": "c0e13564-0991-328f-ac53-b0069f24be4e",
                                "text": "L’activité de l’esprit/cerveau chamanique est stimulée par un breuvage comme l’ayahuasca en Amazonie ou le peyotl, champignon hallucinogène au Mexique, par le tambour monotone, le chant réitératif, et elle se manifeste dans et par l’état de transe."
                            },
                            {
                                "example_id": "baabc77a-65a0-42ad-8c0e-3395aeb5fc7e",
                                "sense_id": "c0e13564-0991-328f-ac53-b0069f24be4e",
                                "text": "Des recherches menées par une équipe de scientifiques du Imperial College London permettent en effet de mieux comprendre comment la diméthyltryptamine (DMT), la substance psychédélique présente dans l’arbuste utilisé pour faire l’ayahuasca, affecte le cerveau humain."
                            },
                            {
                                "example_id": "51796e18-4512-44a0-a5df-d45996ddb7ff",
                                "sense_id": "c0e13564-0991-328f-ac53-b0069f24be4e",
                                "text": "Les « visions » occasionnées par l’ayahuasca, une plante hallucinogène d’Amazonie, sont au cœur d’une exposition consacrée aux usages de cette liane du Pérou."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04776de3-5c59-4e59-900a-1858b11f8d66",
                        "source_entry_id": "96d0defd-cd1f-34e9-a417-b2ca237e2964",
                        "source_sense_id": "c0e13564-0991-328f-ac53-b0069f24be4e",
                        "target_lang_word": "ayahuasca",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ayahuasca",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "021a504c-573c-3ae7-83de-e7244b9439cf",
                                        "entry_id": "3b3f7ac6-3369-3bb3-94fe-7cd152806fde",
                                        "glosses": [
                                            "A giant vine native to South America (especially Banisteriopsis caapi), noted for its psychotropic properties."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3e4daee-cc3b-3902-9aad-1a383f172094",
                                        "entry_id": "3b3f7ac6-3369-3bb3-94fe-7cd152806fde",
                                        "glosses": [
                                            "Any of various psychoactive infusions or decoctions prepared from this vine."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fec3f383-3306-406c-aeb3-c4596f248faa",
                                                "sense_id": "c3e4daee-cc3b-3902-9aad-1a383f172094",
                                                "text": "They make use of a narcotic drink called Ayahuasca, which produces effects similar to those of opium."
                                            },
                                            {
                                                "example_id": "3e17a871-69e4-4f50-9468-4648b729b632",
                                                "sense_id": "c3e4daee-cc3b-3902-9aad-1a383f172094",
                                                "text": "As the Amazon forest people would take ayahuasca and enter into that place of Group Mind where they would make decisions for the tribe, the psychedelic shamanic acts that McKenna was promulgating would involve the experience of ecstasy and the contemplation of wholeness."
                                            },
                                            {
                                                "example_id": "88579440-4f97-49a4-91a8-acb3eaf034be",
                                                "sense_id": "c3e4daee-cc3b-3902-9aad-1a383f172094",
                                                "text": "Like many young women in that cultural era, she was excited to explain ayahuasca, and informed me that her appointment was scheduled for next week, when she would be leaving New York to visit family in Rio."
                                            },
                                            {
                                                "example_id": "af6a06d5-ced5-4abd-bd25-cfa5fdc0fe88",
                                                "sense_id": "c3e4daee-cc3b-3902-9aad-1a383f172094",
                                                "text": "Police in eastern Spain have arrested three people and seized 11 litres of ayahuasca, 117 San Pedro cactus plants and several bottles of toad poison after raiding two rural properties that were used to host lucrative spiritual retreats promising “astral journeys”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
