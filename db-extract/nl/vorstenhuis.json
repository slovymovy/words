                ],
                "senses": [
                    {
                        "sense_id": "dda90094-a3cf-31f6-af01-8e595a9cf86d",
                        "entry_id": "ef874035-abe2-3365-bada-e81b29acdc0e",
                        "glosses": [
                            "een familie waarbinnen het koningschap wordt overgeërfd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83cf6292-2d28-469d-804b-8393a32079fd",
                                "sense_id": "dda90094-a3cf-31f6-af01-8e595a9cf86d",
                                "text": "Het vorstenhuis belooft kandidaten een „buitengewone baan in een dynamisch team.” Het werk zal zich voornamelijk binnen de muren van Buckingham Palace afspelen, maar kandidaten dienen zich soms ook op andere plaatsen dienstbaar te maken. Ook dienen gegadigden aan te tonen dat ze over perfecte taalbeheersing in woord en geschrift beschikken."
                            },
                            {
                                "example_id": "64a10f6b-671a-4aba-9d17-c3cf25f24b64",
                                "sense_id": "dda90094-a3cf-31f6-af01-8e595a9cf86d",
                                "text": "Ook kunstenaar Jeroen Bosch was in de vijftiende en zestiende eeuw lid van het gezelschap. In de zestiende eeuw werd Willem van Oranje, de ‘vader des vaderlands, lid van het broederschap. Sindsdien zijn meerdere leden van het Koninklijk Huis lid geweest. In de vorige eeuw waren Koningin Wilhelmina en prins Bernhard lid. Nu staan als leden van het vorstenhuis koningin Beatrix en sinds 25 oktober 1995 prins Willem Alexander ingeschreven."
                            },
                            {
                                "example_id": "76ecfceb-62d1-4204-84bf-b7bdb07d8287",
                                "sense_id": "dda90094-a3cf-31f6-af01-8e595a9cf86d",
                                "text": "Hoewel ze tot de koninklijke familie behoren, voeren Andrea en Tatiana geen officiële functies uit voor het vorstenhuis van Monaco. Wel zijn ze altijd aanwezig bij de officiële feestelijkheden in het ministaatje."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a17ebca-3d20-40fb-b0b8-6090d6307b60",
                        "source_entry_id": "ef874035-abe2-3365-bada-e81b29acdc0e",
                        "source_sense_id": "dda90094-a3cf-31f6-af01-8e595a9cf86d",
                        "target_lang_word": "dynasty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynasty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7cdeaed-d37f-3dba-9066-c231966c0bfc",
                                        "entry_id": "eaaf9587-0483-31a8-b1b8-4936ee6951e9",
                                        "glosses": [
                                            "A series of rulers or dynasts from one family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9747b8d8-9fed-449c-94ef-e435d4e2ba85",
                                                "sense_id": "d7cdeaed-d37f-3dba-9066-c231966c0bfc",
                                                "text": "Habsburg dynasty; Ottoman dynasty"
                                            },
                                            {
                                                "example_id": "15a536e4-478c-4f81-958d-17e18e22cbd1",
                                                "sense_id": "d7cdeaed-d37f-3dba-9066-c231966c0bfc",
                                                "text": "A dynasty is nothing but the successful orchestration of treachery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28cc97f5-125b-341f-bf02-fe83ddfb565b",
                                        "entry_id": "eaaf9587-0483-31a8-b1b8-4936ee6951e9",
                                        "glosses": [
                                            "A family considered over time, with its ancestors and descendants"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adae6f06-a8a1-48bd-9dd9-99e1676734c0",
                                                "sense_id": "28cc97f5-125b-341f-bf02-fe83ddfb565b",
                                                "text": "To the loyal and to the blood-lovers, in the good families and in the fiery dynasties, life is family and family is life. It is the same people who give advice and their vices to live well who turn out to be the ones who give resource and reason to live long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72c2249b-fcf5-39e5-a505-f60bc4c24053",
                                        "entry_id": "eaaf9587-0483-31a8-b1b8-4936ee6951e9",
                                        "glosses": [
                                            "The polity or historical era under the rule of a certain dynasty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a6b8e3-22eb-4762-97bc-6175dd1ca336",
                                                "sense_id": "72c2249b-fcf5-39e5-a505-f60bc4c24053",
                                                "text": "During the Ming dynasty, China was ruled by the Zhu family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b5587ca-c4a8-3cb3-8db7-462641b2373b",
                                        "entry_id": "eaaf9587-0483-31a8-b1b8-4936ee6951e9",
                                        "glosses": [
                                            "A team or organization which has an extended period of success or dominant performance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
