        "fr-extract.jsonl": [
            {
                "entry_id": "1a87178c-7007-3356-8b57-c3879202f522",
                "word": "cloporte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b1f09585-751d-43fb-8c7f-af95ca8a9177",
                        "entry_id": "1a87178c-7007-3356-8b57-c3879202f522",
                        "tags": [
