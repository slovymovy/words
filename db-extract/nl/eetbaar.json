                "senses": [
                    {
                        "sense_id": "4f939ad2-50b2-303c-b72f-2c1bc0b320d4",
                        "entry_id": "94a9dfef-b31f-3f06-be04-ffe241edbd6a",
                        "glosses": [
                            "geschikt om gegeten te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e634c8c7-6095-4e9c-89f5-4a9a9a9345dd",
                                "sense_id": "4f939ad2-50b2-303c-b72f-2c1bc0b320d4",
                                "text": "Bepaalde paddenstoelen zijn giftig, andere zijn eetbaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c86ed45-afef-4d6a-b5ac-bfcb1b7da55f",
                        "source_entry_id": "94a9dfef-b31f-3f06-be04-ffe241edbd6a",
                        "source_sense_id": "4f939ad2-50b2-303c-b72f-2c1bc0b320d4",
                        "source_sense_description": "geschikt om gegeten te worden",
                        "target_lang_word": "essbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                        "entry_id": "653ee65d-39ec-3549-9fce-eb9e1f9f1acd",
                                        "glosses": [
                                            "geeignet, (ohne Schaden) gegessen zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e00f152-9114-41bc-b504-95229fbaed84",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "Die Blätter des Löwenzahns sind essbar."
                                            },
                                            {
                                                "example_id": "f29b8684-222f-422a-b087-d541f03ce917",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "Die Beeren sehen eigentlich essbar aus."
                                            },
                                            {
                                                "example_id": "e9743315-7f1b-4b7b-9281-69d010e34d90",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "Bei Pilzen muss man aufpassen, welche essbar und welche giftig sind."
                                            },
                                            {
                                                "example_id": "3b0b0a27-19a6-4fce-879c-89e060356794",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "„Essbare Wildpflanzen sind seit langem ein Grundnahrungsmittel für indigene Völker in Indien“"
                                            },
                                            {
                                                "example_id": "2f7b0674-521e-468e-b208-0dc569072c29",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "[Nina entdeckt] „ein wildes Topinamburfeld. Und außerdem viele weitere essbare Blüten, wie Kornblume, Wilde Malve, Dost, Schafgarbe und Ringelblume.“"
                                            },
                                            {
                                                "example_id": "7134ee44-b11b-451a-ac55-1ce95bf52fe8",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "[Johnson organisiert unter dem Namen \"Benevolent Weeds\" Spaziergänge,] „bei denen essbare Pflanzen gesammelt werden.“"
                                            },
                                            {
                                                "example_id": "8aa734e3-7fbf-4929-9757-170de6818692",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "„Seit einigen Jahren gilt der Moringa-Baum als Wunderpflanze. Seine Blätter und Wurzeln sind essbar.“"
                                            },
                                            {
                                                "example_id": "cab1447e-f816-4f87-a7a9-a9cf79aba335",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "„Für die meisten Pilzliebhaber endet die Saison im Herbst. Doch auch im Winter lassen sich essbare Pilze finden. Man muss nur wissen, wo man suchen muss.“"
                                            },
                                            {
                                                "example_id": "a9685f51-edbb-4737-9267-456d4fa1007a",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "„Biodiversität: Wie können wir Südafrikas essbare Insekten schützen?“",
                                                "translation": "nicht schlecht, nicht verdorben:"
                                            },
                                            {
                                                "example_id": "ee15b8a2-4915-4273-9a31-5c76d1703b2c",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "Keimende Kartoffeln sind meistens noch essbar."
                                            },
                                            {
                                                "example_id": "a04730c3-8d09-4e4b-adbf-2f4fe6a2c418",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "„Jedes Jahr landen etwa 1,3 Milliarden Tonnen Lebensmittel auf dem Müll. Ein großer Teil davon wäre noch essbar.“"
                                            },
                                            {
                                                "example_id": "4f36baea-20a4-442f-a82e-756c5e9ade03",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "„Abgelaufene Lebensmittel: Wie lange sind sie wirklich essbar?“"
                                            },
                                            {
                                                "example_id": "84f728c1-f7cc-412c-acdf-7f298036b606",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "„Immer erst riechen oder probieren, ob etwas noch essbar ist. Abgelaufene Joghurts kann man fast immer noch essen, aus alten Äpfeln kann man Apfelmus machen.“"
                                            },
                                            {
                                                "example_id": "369171c9-fdb0-4343-ab02-2849c7d52c69",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "„Ausgetrocknet, strohig und farblos - wenn Fleisch im Tiefkühlfach so aussieht, hat es Gefrierbrand. Noch essbar oder für die Tonne?“"
                                            },
                                            {
                                                "example_id": "ba50b240-8814-49c4-b1b0-e597d54cbc0e",
                                                "sense_id": "67415f10-9036-348a-ad84-cce6fff7ae51",
                                                "text": "„Wenn der Schnittlauch blüht, kann man ihn nicht mehr essen. Diese Meinung ist weit verbreitet. Stimmt aber nicht. Auch wenn der Schnittlauch in voller Blüte steht, ist er noch genießbar und auch die Blüten selbst sind essbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaa6441f-9431-4e52-aaf5-8f2d69ba3ce1",
                        "source_entry_id": "94a9dfef-b31f-3f06-be04-ffe241edbd6a",
                        "source_sense_id": "4f939ad2-50b2-303c-b72f-2c1bc0b320d4",
                        "source_sense_description": "geschikt om gegeten te worden",
                        "target_lang_word": "edible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "edible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77edab93-514e-33f3-9f8b-d4d46f817542",
                                        "entry_id": "91c5daf1-f135-32f9-9035-10876c07b1fe",
                                        "glosses": [
                                            "Capable of being eaten without harm; suitable for consumption; innocuous to humans."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e839e72e-52cc-499d-b84d-7d162d4cc357",
                                                "sense_id": "77edab93-514e-33f3-9f8b-d4d46f817542",
                                                "text": "edible fruit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bee0e29-99a7-3398-83a5-1c94fe1e43df",
                                        "entry_id": "91c5daf1-f135-32f9-9035-10876c07b1fe",
                                        "glosses": [
                                            "Capable of being eaten without disgust or disrelish."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "123df4df-fcd7-4b14-9d5e-6279c00395d0",
                                                "sense_id": "5bee0e29-99a7-3398-83a5-1c94fe1e43df",
                                                "text": "Although stale, the bread was edible."
                                            },
                                            {
                                                "example_id": "a69d7280-e885-410e-98ee-a27134a112f4",
                                                "sense_id": "5bee0e29-99a7-3398-83a5-1c94fe1e43df",
                                                "text": "However, rather than try to place the Viceroy in a rigid, all-or-none category which implies more than the data show, the Viceroy is here considered more edible than its model, the Monarch, but initially less edible (except to C-2) than the non-mimetic butterflies used in these experiments."
                                            },
                                            {
                                                "example_id": "0b6e8398-83aa-4e2a-9245-7d49697e5aaa",
                                                "sense_id": "5bee0e29-99a7-3398-83a5-1c94fe1e43df",
                                                "text": "Recently germinated seeds are often even more nutritious from the point of view of humans because the stored chemicals are often transformed into more edible and palatable substances."
                                            },
                                            {
                                                "example_id": "edae1523-000c-42c4-b0ce-2ac7f46b4724",
                                                "sense_id": "5bee0e29-99a7-3398-83a5-1c94fe1e43df",
                                                "text": "This gets to the heart of the matter because, in the parthenogenic state, the fruits are more edible (though there are also apparently advantages to pollinated figs, which may be bigger and stronger) and the trees more productive from the human's point of view."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb356a43-e6f8-36b7-89a0-4851c22e32d7",
                                        "entry_id": "91c5daf1-f135-32f9-9035-10876c07b1fe",
                                        "glosses": [
                                            "In which edible plants are grown for human consumption."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c49b6637-9086-4aa6-9601-0a74010988dd",
                                                "sense_id": "cb356a43-e6f8-36b7-89a0-4851c22e32d7",
                                                "text": "Gardens do not contain flowers and ornamental plants, but edible plants. Although edible, these gardens are equally valued for their aesthetic qualities. It is women who collect from edible gardens, […]"
                                            },
                                            {
                                                "example_id": "c99c2029-d087-4d43-b2ad-3735e6f4dee7",
                                                "sense_id": "cb356a43-e6f8-36b7-89a0-4851c22e32d7",
                                                "text": "To get started, how about creating an edible window box? Sowed in the spring, salad seeds like radish, lettuce and spring onion will germinate so quickly that you'll be harvesting a crop in a month or two."
                                            }
                                        ]
                                    }
                                ]
