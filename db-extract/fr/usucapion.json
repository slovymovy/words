        "fr-extract.jsonl": [
            {
                "entry_id": "61ce77be-e101-3a78-8934-6aa69d4ed203",
                "word": "usucapion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b1795d12-6e3e-42f6-b360-30e629f91a89",
                        "entry_id": "61ce77be-e101-3a78-8934-6aa69d4ed203",
                        "tags": [
                            "plural"
                        ],
                        "form": "usucapions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f64336e8-152d-3d39-9771-1015963e3fb0",
                        "entry_id": "61ce77be-e101-3a78-8934-6aa69d4ed203",
                        "glosses": [
                            "Manière d’acquérir par la possession ou par l’usage ; prescription acquisitive."
                        ],
                        "tags": [
                            "Droit de propriété"
                        ],
                        "examples": [
                            {
                                "example_id": "8daa285e-08ab-47e1-af80-062be5e1c0d3",
                                "sense_id": "f64336e8-152d-3d39-9771-1015963e3fb0",
                                "text": "Dans la coutume de Sedan, article 325, on acquiert par la possession annale avec bonne foi, l’usucapion des meubles vendus publiquement en foires ou marchés, lors même qu’on prétend qu’ils ont été volés."
                            },
                            {
                                "example_id": "2a207554-a3d0-4b2f-858c-1d2e63a6e346",
                                "sense_id": "f64336e8-152d-3d39-9771-1015963e3fb0",
                                "text": "Des indigènes protégés, soustraits de ce fait à la juridiction des caïds, s’étaient installés à demeure sur des parcelles prises dans les terres collectives de leur fraction et, n’ayant plus à redouter la rapacité de leurs chefs, bâtissaient une maison, plantaient des arbres fruitiers et cultivaient des surfaces de plus en plus étendues dont ils finissaient par devenir propriétaires effectifs par la vivification et l’usucapion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e81335a-00c5-4f0e-a0e3-f94b15571791",
                        "source_entry_id": "61ce77be-e101-3a78-8934-6aa69d4ed203",
                        "source_sense_id": "f64336e8-152d-3d39-9771-1015963e3fb0",
                        "target_lang_word": "Ersitzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ersitzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c01051a-3955-3575-bba9-59f6c5f96750",
                                        "entry_id": "e1b81958-d693-34a7-8234-47d02d5c43c0",
                                        "glosses": [
                                            "Erwerb des Eigentums an einer Sache durch Zeitablauf"
                                        ],
                                        "tags": [
                                            "deutsches",
                                            "österreichisches und Schweizer Zivilrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c14407bf-896d-4796-9acb-cfcd29060887",
                                                "sense_id": "0c01051a-3955-3575-bba9-59f6c5f96750",
                                                "text": "„Der Zweck der Ersitzung liegt in der Befriedung, Beruhigung und Vereinfachung unklarer Rechtsbeziehungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e02e2f7-abb4-3278-b6db-d25f8a5bfb9b",
                                        "entry_id": "e1b81958-d693-34a7-8234-47d02d5c43c0",
                                        "glosses": [
                                            "der Erwerb des Eigentums an einer beweglichen Sache durch Zeitablauf (§ 937 ff. BGB)"
                                        ],
                                        "tags": [
                                            "insbesondere"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb32e104-40c4-4947-8d20-e9a1d2f55f7c",
                                                "sense_id": "1e02e2f7-abb4-3278-b6db-d25f8a5bfb9b",
                                                "text": "„Wirkung der Ersitzung ist der Erwerb des Eigentums (§ 937 Abs. 1), und zwar des lastenfreien Eigentums, sofern die Redlichkeit sich auch auf das Fehlen des beschränkten dinglichen Rechts bezog (§ 945).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
