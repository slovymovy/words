                    {
                        "sense_id": "17aacff7-8e0a-3b96-be23-e52218c0e225",
                        "entry_id": "0078ecc8-33be-35c5-9bab-926582e7c56e",
                        "glosses": [
                            "Acquiescement faible, mou, sans grand enthousiasme."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "01b66f2c-e734-445a-a862-444c95647f8a",
                                "sense_id": "17aacff7-8e0a-3b96-be23-e52218c0e225",
                                "text": "Certes il fallait que la pauvre Hammer fût bien bouleversée, pour s’animer ainsi et repousser Mme Ebsen vers la sortie, opposant à toutes ses questions son « moui… moui » dolent, désolé, où se sentaient le désespoir et la confusion que lui causait, après tant de milliers d’années, la funeste aventure d’Adam et d’Ève sous le pommier."
                            },
                            {
                                "example_id": "47318480-03d5-41e1-8f86-9d56e093acfc",
                                "sense_id": "17aacff7-8e0a-3b96-be23-e52218c0e225",
                                "text": "– Colombe ! C’est la même marchande ! Colombe !\n– Moui !"
                            }
                        ]
                    }
