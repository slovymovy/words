                "senses": [
                    {
                        "sense_id": "0ba81b70-620a-3512-981d-6fc0d6d4f5b0",
                        "entry_id": "7cf42c82-e5ff-37fe-b59c-e2606b03652a",
                        "glosses": [
                            "имеющий тонкую кожу, кожицу, кожуру"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6758cf6e-c6bc-48d1-9c09-0b0e698281be",
                                "sense_id": "0ba81b70-620a-3512-981d-6fc0d6d4f5b0",
                                "text": "В России мандаринами называют все тонкокожие оранжево-красные цитрусы (те, что меньше апельсина)."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b143793-032f-3608-88b2-5f7539760d75",
                        "entry_id": "7cf42c82-e5ff-37fe-b59c-e2606b03652a",
                        "glosses": [
                            "перен. разг. легко уязвимый, ранимый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c903890-951e-4e8f-b700-bee9bbe97d84",
                                "sense_id": "6b143793-032f-3608-88b2-5f7539760d75",
                                "text": "Гордость, самолюбие, страх пересудов… Это любому тяжело, а тебе… Ты ведь горячий, потому что тонкокожий… У тебя кровь течёт близко-близко… Просвечивает там и тут…"
                            }
                        ]
                    }
