                "senses": [
                    {
                        "sense_id": "1deb1908-f7a2-30a8-9610-613e3cc81684",
                        "entry_id": "73300d5f-b434-3ca0-ba83-b0f7e5033533",
                        "glosses": [
                            "Provinz im Nordosten von Südafrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a94e066-da3e-4905-96d0-2e67d54194a8",
                                "sense_id": "1deb1908-f7a2-30a8-9610-613e3cc81684",
                                "text": "„Das Mala-Mala-Reservat in der südafrikanischen Provinz Mpumalanga ist wesentlich beeindruckender als das Naturschutzgebiet Hulatal; und Polarvögel repräsentieren die uralte, ewige Schönheit wilder Natur wesentlich stärker als die Vögel, die auf der ehemaligen Mülldeponie in Hiria nisten.“"
                            },
                            {
                                "example_id": "b61333bd-e65f-47aa-9cd1-e1b2942ed228",
                                "sense_id": "1deb1908-f7a2-30a8-9610-613e3cc81684",
                                "text": "„Er fuhr einfach hinter den anderen her. Dachte daran, wie er mit Pakamile, eine Woche vor dem Tod des Jungen, in den Bergen Mpumalangas hinter Amersfoort gewesen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
