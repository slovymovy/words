                "senses": [
                    {
                        "sense_id": "fd11b557-ed91-366a-bd73-54154bb29e1a",
                        "entry_id": "20cc5609-942c-33c1-9198-fde320ddef0a",
                        "glosses": [
                            "Qui est à terre, abattu."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "ee01bafd-85f7-4a46-80df-4c4945348da2",
                                "sense_id": "fd11b557-ed91-366a-bd73-54154bb29e1a",
                                "text": "Abruti de fatigue, sonné par la peur et les coups, il reste atterré au sol, le cœur battant à tout rompre, mettant du temps à réaliser où il se trouve."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a25853e-edb9-3699-af36-d585251a2ed1",
                        "entry_id": "20cc5609-942c-33c1-9198-fde320ddef0a",
                        "glosses": [
                            "Qui est accablé, consterné."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "eefbbb48-0926-4a41-bbb1-ec3b97890752",
                                "sense_id": "7a25853e-edb9-3699-af36-d585251a2ed1",
                                "text": "Nous, linguistes de France, de Belgique, de Suisse, du Canada, sommes proprement atterrées par l’ampleur de la diffusion d’idées fausses sur la langue française."
                            },
                            {
                                "example_id": "8629f9f8-5f1f-402d-9e2d-1f9b9edd06b3",
                                "sense_id": "7a25853e-edb9-3699-af36-d585251a2ed1",
                                "text": "À Atlanta, ville démocrate, Brad se dit mi-soulagé mi-atterré par la volte-face de Donald Trump. « Je ne suis pas surpris, mais ça alimente le psychodrame et l'incertitude, c'est sa façon de manipuler », souligne-t-il."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6c2c543-ac93-442b-8612-3ae5c5a25e30",
                        "source_entry_id": "20cc5609-942c-33c1-9198-fde320ddef0a",
                        "source_sense_id": "7a25853e-edb9-3699-af36-d585251a2ed1",
                        "target_lang_word": "appalled",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appalled",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c62dc27-dc97-33e3-8f43-6a8bdf61d6a7",
                                        "entry_id": "3d0bb7f5-4c54-3773-b792-766a522ead32",
                                        "glosses": [
                                            "Shocked, horrified by something unpleasant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77c9b5d2-f78e-499a-b7b8-c907cd268362",
                                                "sense_id": "4c62dc27-dc97-33e3-8f43-6a8bdf61d6a7",
                                                "text": "But the purported rise in violent videos online has led some MPs to campaign for courts to have more power to remove or block material on YouTube. The Labour MP Heidi Alexander said she was appalled after a constituent was robbed at knifepoint, and the attackers could be found brandishing weapons and rapping about gang violence online."
                                            },
                                            {
                                                "example_id": "3b7c5a7f-684c-4457-81f1-b32bca95ec9b",
                                                "sense_id": "4c62dc27-dc97-33e3-8f43-6a8bdf61d6a7",
                                                "text": "West's friends were so appalled by the nature of his death that they arranged for a wooden memorial in the churchyard of St Laurence's, constructed aptly from a railway sleeper."
                                            }
                                        ]
                                    }
                                ]
                            },
