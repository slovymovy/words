            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bef3ef83-2d91-320d-9e31-7f0d140b085e",
                    "sense_definition": "Recommander avec insistance une solution, une méthode ou une pratique jugée avantageuse.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "recommandation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui <w>préconise</w> un repos complet pendant plusieurs semaines pour guérir."
                        },
                        {
                            "text": "Les spécialistes <w>préconisent</w> des mesures strictes pour limiter le gaspillage d'eau."
                        }
                    ],
                    "synonyms": [
                        "recommander",
                        "prôner"
                    ],
                    "common_phrases": [
                        "préconiser des mesures",
                        "préconiser l'usage"
                    ]
                },
                {
                    "sense_id": "523c3a00-9e37-3222-b601-df0b5269bdb5",
                    "sense_definition": "Louer publiquement les qualités ou les mérites d'une personne ou d'une œuvre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "eloge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les partisans de cette réforme <w>préconisaient</w> son auteur comme un grand visionnaire politique."
                        },
                        {
                            "text": "La critique a souvent <w>préconisé</w> les talents exceptionnels de ce jeune compositeur."
                        }
                    ],
                    "synonyms": [
                        "louer",
                        "vanter"
                    ]
                },
                {
                    "sense_id": "f34cf80b-34a7-3d1a-a3c6-e6f5ee6cdfbd",
                    "sense_definition": "Déclarer solennellement au consistoire qu'un ecclésiastique est pourvu d'un évêché.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pape a <w>préconisé</w> ce prêtre pour diriger le diocèse nouvellement créé."
                        },
                        {
                            "text": "Le cardinal <w>préconisa</w> cet illustre théologien devant l'assemblée réunie à Rome."
