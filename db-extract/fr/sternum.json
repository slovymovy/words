                                            {
                                                "example_id": "e502b3e5-9d3b-4f7e-bf7d-b0df6c78ccbc",
                                                "sense_id": "cd6addf5-bbe1-3e05-9446-c80dd98ed3df",
                                                "text": "The neckline fell into a V, showing the bone of his sternum."
                                            }
                                        ]
                                    },
                                    {
