                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cbac4dd-eaf6-4196-83e1-badc71f06f36",
                                "sense_id": "fa23c710-4f31-3e0c-be81-cc2bc3ecd987",
                                "text": "Mortifie therefore your members which are vpon the earth: fornication, vncleannesse, inordinate affection, euill concupiscence, and couetousnesse, which is idolatrie:"
