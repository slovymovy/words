                    {
                        "translation_id": "c6194580-36ce-4cea-8c2d-7a6fcb3b28a5",
                        "source_entry_id": "185de7c0-a905-38c3-8cfd-4d9f32df35f8",
                        "source_sense_id": "f14b340b-a971-3261-aab7-54b3ea2ba61e",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Helen",
