                        "entry_id": "077df1b6-052c-3f68-8ab1-41bafcb42b93",
                        "glosses": [
                            "An uncommon malignant tumour of the mesothelium, usually of the lungs after exposure to asbestos."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "30836bcf-0706-4611-965d-1310a08777fc",
                                "sense_id": "6910fb21-6247-3151-9121-767780f04442",
                                "text": "He died a few weeks later, his mesothelioma perhaps caused by the asbestos-lined ceiling he cracked open at 430 King's Road. [Malcom] McLaren had stood there regaling in the mess, while everybody else ran for safety."
                            }
                        ]
                    }
