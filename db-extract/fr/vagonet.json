                                        "sense_id": "c5c8870b-e641-34a2-925d-8be3394e6738",
                                        "entry_id": "4436b525-6dde-38af-9033-61dcdaad212f",
                                        "glosses": [
                                            "Schienenfahrzeug für den Transport von Gütern, das seitlich ausgekippt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a361d90-ac81-4782-84cd-a237b26a4d6d",
                                                "sense_id": "c5c8870b-e641-34a2-925d-8be3394e6738",
                                                "text": "„Anna und drei Männer ebnen den gelben Abraum-Sand, den eine kleine puffende Grubenlokomotive in Kipploren heranbringt.“"
                                            },
                                            {
                                                "example_id": "d8ef7ec7-63fd-4419-a757-a38297af8355",
                                                "sense_id": "c5c8870b-e641-34a2-925d-8be3394e6738",
                                                "text": "„Hin und wieder benutzten sie auch Schwarzpulver, um große Felsen zu sprengen, und zwischen dem größer werdenden Steinbruch und dem Bauplatz fuhr eine Kipplore, mit der die sorgfältig zugerichteten Steine abtransportiert wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
