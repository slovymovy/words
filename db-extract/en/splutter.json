                ],
                "senses": [
                    {
                        "sense_id": "b8e5b507-16a7-3b50-89d7-c36b881de2df",
                        "entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "glosses": [
                            "To forcefully emit (something), especially in small drops or particles; to sputter."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "103984d8-55b8-3923-8e20-24aa27ef465e",
                        "entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "glosses": [
                            "To soil or sprinkle (someone or something) with a substance, often a liquid; to bespatter, to spatter."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8f9b6873-af11-317f-b265-1f3fe46cfa1c",
                        "entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "glosses": [
                            "To direct angry words, criticism, insults, etc., at (someone or something)."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fb0786c8-27b1-3b0f-b61b-5bdd6ec12209",
                        "entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "glosses": [
                            "Sometimes followed by out: to speak (words) hurriedly, and confusedly or unclearly."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0881abde-6088-4cd1-8f7c-4674e8219f27",
                                "sense_id": "fb0786c8-27b1-3b0f-b61b-5bdd6ec12209",
                                "text": "Alas, for the expectations of man! His hopes are like the fruits of that melancholy shore, where death appears to live and life to die. He biteth, and spluttereth forth the unsavoury and abominable deception."
                            }
                        ]
                    },
                    {
                        "sense_id": "d53b12f9-2ce9-3779-a152-54313e855bc2",
                        "entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "glosses": [
                            "Of a thing: to forcefully emit something, especially in small drops or particles."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b5d16d51-4bbb-42fb-9d25-fe1e2629e207",
                                "sense_id": "d53b12f9-2ce9-3779-a152-54313e855bc2",
                                "text": "[H]e at once stepped into the stationer's shop, and requested to be served with a sheet of the best gilt-edged letter-paper, and a hard-nibbed pen which could be warranted not to splutter."
                            },
                            {
                                "example_id": "5834884e-ae01-462a-9284-1b5a8e2c264c",
                                "sense_id": "d53b12f9-2ce9-3779-a152-54313e855bc2",
                                "text": "You see if my pen doesn't splutter, Polly, the moment I address Richard Paulette."
                            },
                            {
                                "example_id": "a2bccec5-f11b-422f-9691-82cfcaab9283",
                                "sense_id": "d53b12f9-2ce9-3779-a152-54313e855bc2",
                                "text": "The log on the fire spluttered and sent a cloud of sparks up the chimney, and shadows of the bell-ringers started up on the walls and disappeared in the intricacies of the roof."
                            },
                            {
                                "example_id": "4a08512a-4709-47e4-b1a5-4fe233c822ea",
                                "sense_id": "d53b12f9-2ce9-3779-a152-54313e855bc2",
                                "text": "I grieve for lack of wit and store of words to tell the doings patly, for my pen halteth and spluttereth sadly; but I doubt if even a pen from a quill of the Raven could limn them suitably."
                            },
                            {
                                "example_id": "f5aae14f-8f75-4987-a32d-cb6ec7edbefe",
                                "sense_id": "d53b12f9-2ce9-3779-a152-54313e855bc2",
                                "text": "The old-fashioned pen spluttered and scratched as he wrote."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b071a7c-b97f-3379-896f-d47917994ee9",
                        "entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "glosses": [
                            "Of a thing: to forcefully emit something, especially in small drops or particles.",
                            "To spray droplets of saliva from the mouth while eating or speaking."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6dda31a3-2e43-319f-873b-6d24a563ea1a",
                        "entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "glosses": [
                            "Of a substance: to be emitted forcefully in small drops or particles."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e0992ad7-5334-4ee3-ac39-9e956d0026e4",
                                "sense_id": "6dda31a3-2e43-319f-873b-6d24a563ea1a",
                                "text": "Suddenly a beautiful delf blue-and-white flower-pot, which had been set on the window-sill of an upper storey, fell to the ground with a crash, and the fragments spluttered up around my father's legs."
                            }
                        ]
                    },
                    {
                        "sense_id": "32673e4a-ab5f-3d6f-9565-90396a12a9da",
                        "entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "glosses": [
                            "To make a sound or sounds of something forcefully emitting a substance in small drops or particles."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5848fc71-07eb-4c4e-8c44-a25abf216c70",
                                "sense_id": "32673e4a-ab5f-3d6f-9565-90396a12a9da",
                                "text": "So you may see Jobson on such occasions, […] puffing, strutting, and spluttering, to get the justice put in motion, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "acc45916-99ef-3f50-80b4-904af89bd57a",
                        "entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "glosses": [
                            "Followed by out: to go out (as a flame) or stop functioning (as an engine or machine) with a spluttering action or sound (senses 2.1 or 2.3)."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "71480d6c-f577-33c4-9ff6-4060fc228909",
                        "entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "glosses": [
                            "To speak hurriedly, and confusedly or unclearly."
                        ],
                        "tags": [
                            "figuratively",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c40a62c1-ce39-45da-a760-b2b7dbe1513f",
                                "sense_id": "71480d6c-f577-33c4-9ff6-4060fc228909",
                                "text": "If thou splutterest so, thou wilt drop out thy teeth; that is, if they be thine, which I for one doubt!"
                            },
                            {
                                "example_id": "61806c11-7721-4358-8696-79f1838e25e2",
                                "sense_id": "71480d6c-f577-33c4-9ff6-4060fc228909",
                                "text": "He was in such a rage that his tongue clave to the roof of his mouth. He could not even swear. He could only splutter."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9455961-543a-3bb2-bd55-e2adfe125419",
                        "entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "glosses": [
                            "To perform in an inconsistent manner to a substandard level."
                        ],
                        "tags": [
                            "figuratively",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "475297f6-2eb0-4bb5-b5ea-4edbd2fa3e7f",
                                "sense_id": "f9455961-543a-3bb2-bd55-e2adfe125419",
                                "text": "Manchester City, Liverpool, Bolton and Manchester United come next for Wolves in the Premier League but [Mick] McCarthy's men will fear no one after beating Chelsea for the first time in 18 years, while [Carlo] Ancelotti has much to ponder as his players continue to splutter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28561b7a-3f6f-4ee3-93d2-eb58f8bf887c",
                        "source_entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "source_sense_description": "to spray droplets of saliva from the mouth while eating or speaking",
                        "target_lang_word": "prskat",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c788ef30-c0eb-4482-98b4-cb65422aab81",
                        "source_entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "source_sense_description": "to spray droplets of saliva from the mouth while eating or speaking",
                        "target_lang_word": "postillonner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postillonner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b584eb0-31dc-324d-ac93-ddba105417fa",
                                        "entry_id": "05df1877-ea6b-37d6-bdbb-cd8f8ae68aef",
                                        "glosses": [
                                            "Émettre des postillons quand on parle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e063fc48-446c-48a2-9278-3474fe29e887",
                                                "sense_id": "1b584eb0-31dc-324d-ac93-ddba105417fa",
                                                "text": "Mais plus tard, je m’aperçus qu’elle croyait tenir sa vie solidement calée sous sa langue, et même le destin de l’Afrique et de ses hommes tout entier ! Qu’elle ne postillonnait pas son existence à gauche, à droite et de travers, en bouts et en fragments, du n’importe quoi, qui allait s’envoler et se perdre quelque part dans le ciel."
                                            },
                                            {
                                                "example_id": "b00f1061-7e84-44cc-80ad-1f3a2386fcf7",
                                                "sense_id": "1b584eb0-31dc-324d-ac93-ddba105417fa",
                                                "text": "Au karaoké, on chante en groupe, mais surtout, on hurle, on postillonne ! Oui, on postillonne !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "740368aa-2d3d-3115-b755-044921ac5b8e",
                                        "entry_id": "05df1877-ea6b-37d6-bdbb-cd8f8ae68aef",
                                        "glosses": [
                                            "Parler maladroitement."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6491605a-3ee0-4ae4-a651-cd4617f1d332",
                                                "sense_id": "740368aa-2d3d-3115-b755-044921ac5b8e",
                                                "text": "Maman s’est levée ce matin à dix heures, elle est descendue déjeuner, elle est restée tout l’après-midi avec nous et, en l’absence de Maurice qui postillonne pour le compte d’un sardinier mécontent de ses huiles, nous aurions pu nous croire revenues à la belle époque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1c7efb1-8fba-39f6-be08-f37c6a3923a4",
                                        "entry_id": "05df1877-ea6b-37d6-bdbb-cd8f8ae68aef",
                                        "glosses": [
                                            "Être toujours à courir la poste, employer incessamment les postillons."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ee55824-9b0b-4bdb-9591-38e9ca6daefc",
                                                "sense_id": "c1c7efb1-8fba-39f6-be08-f37c6a3923a4",
                                                "text": "Voyez donc comment feu M. de Louvois [à propos du masque de fer] aurait passé huit jours à postillonner de Versailles à l'île Sainte-Marguerite, sans qu'on se fût aperçu de rien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3685615-548a-4255-adc5-c8b32600376b",
                        "source_entry_id": "1dddca48-9be1-3d5c-8595-b4f9686a785b",
                        "source_sense_description": "to speak hurriedly, and confusedly or unclearly",
                        "target_lang_word": "stottern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stottern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66b230a9-4b65-30d7-b608-2d1b893ae7c5",
                                        "entry_id": "585c338f-5389-331e-a79a-bf32a1ec3068",
                                        "glosses": [
                                            "mit krankhaft häufigem Wiederholen von Lauten, Silben, Wörtern sprechen"
                                        ],
                                        "tags": [
                                            "Psychiatrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b220607e-4833-4ffa-ae5d-9ca1f6d83c0f",
                                                "sense_id": "66b230a9-4b65-30d7-b608-2d1b893ae7c5",
                                                "text": "Als Kind hatte er stark gestottert und war in logopädischer Behandlung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1869c29c-7886-3475-a90f-84f1722cf2d3",
                                        "entry_id": "585c338f-5389-331e-a79a-bf32a1ec3068",
                                        "glosses": [
                                            "etwas zögerlich, von Pausen unterbrochen, stockend sagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e64af26-8fa5-4e00-9af9-0f856aa3f410",
                                                "sense_id": "1869c29c-7886-3475-a90f-84f1722cf2d3",
                                                "text": "Solche Lobreden hatte der Jubilar nicht erwartet; er war so ergriffen, dass er nur noch einige Dankesworte stottern konnte."
                                            },
                                            {
                                                "example_id": "03b1a893-4fd3-4ef5-9571-e664d1aca4b9",
                                                "sense_id": "1869c29c-7886-3475-a90f-84f1722cf2d3",
                                                "text": "„Das war ein feiner Junge, bloß stotterte er mächtig, es dauerte lange, bis er was raushatte, darum machte er auch so große flehentliche Augen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9de0771e-1202-3045-816d-fc2d74f21bb9",
                                        "entry_id": "585c338f-5389-331e-a79a-bf32a1ec3068",
                                        "glosses": [
                                            "nicht gleichmäßig laufen, beim Betrieb Störungen, Aussetzer haben (bei einer Maschine)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bd07d0a-4cec-4aa7-8f2e-6e9f3d4b37bf",
                                                "sense_id": "9de0771e-1202-3045-816d-fc2d74f21bb9",
                                                "text": "Bei Minusgraden stottert der Motor meines Autos immer."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
