                    "frequency": "Middle",
                    "semantic_group_id": "certitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce spectacle était <w>positivement</w> grandiose et a captivé tous les spectateurs dès le début."
                        },
                        {
                            "text": "La situation est devenue <w>positivement</w> intenable pour tous les employés de cette usine."
                        }
                    ],
                    "synonyms": [
