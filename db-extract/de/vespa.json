                "pos": "noun",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fad03bd4-0e21-31bf-a5e4-caf6ae97eb84",
                        "entry_id": "8539e263-6994-341c-8a94-d4741535da07",
                        "glosses": [
                            "der wissenschaftliche Name der Gattung der Hornissen oder Großwespen"
                        ],
                        "tags": [
                            "biologische Nomenklatur"
                        ],
                        "examples": [
                            {
                                "example_id": "1bf81c8c-1448-4d46-b822-7f8345620858",
                                "sense_id": "fad03bd4-0e21-31bf-a5e4-caf6ae97eb84",
                                "text": "Unsere heimische Hornisse, Vespa crabro, ist der bekannteste Vertreter der Gattung Vespa."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "daab7253-e244-3f2f-bea9-ea078f8074ba",
                        "entry_id": "8539e263-6994-341c-8a94-d4741535da07",
                        "glosses": [
                            "Produktname eines Motorrollers des italienischen Unternehmens Piaggio"
                        ],
                        "tags": [
                            "mit Plural Vespas"
                        ],
                        "examples": [
                            {
                                "example_id": "acbd587b-caa8-43cd-bff5-cac2b602f72e",
                                "sense_id": "daab7253-e244-3f2f-bea9-ea078f8074ba",
                                "text": "Er hat sich von seinem ersten Gehalt eine gelbe Vespa gekauft."
                            },
                            {
                                "example_id": "74d64997-cd31-4a75-8e8f-74d2589f76dd",
                                "sense_id": "daab7253-e244-3f2f-bea9-ea078f8074ba",
                                "text": "„Willy Messerschmitt übernahm eine Konstruktion des Rosenheimers Fend und fertigte in Regensburg den dreirädrigen Messerschmitt Kabinenroller, dem später der vierrädrige Tiger folgte, Ernst Heinkel versuchte sich mit der ebenfalls dreirädrigen Heinkel Kabine, Claudius Dornier bastelte am Bodensee an einem vierrädrigen Ding, bei Piaggio in Italien war der zweirädrige Weltroller Vespa bereits entstanden - sie alle bauten einmal Bomber, Jagdflugzeuge und Flugboote und hatten seit dem Kriegsende nichts mehr zu tun gehabt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1a1279f-0cdb-4168-95de-54339c2d6211",
                        "source_entry_id": "8539e263-6994-341c-8a94-d4741535da07",
                        "source_sense_id": "fad03bd4-0e21-31bf-a5e4-caf6ae97eb84",
                        "source_sense_description": "Zoologie, biologische Nomenklatur: der wissenschaftliche Name der Gattung der Hornissen oder Großwespen",
                        "target_lang_word": "Hornisse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hornisse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                        "entry_id": "2eaf3547-e486-3af4-815e-e6ed61d4e994",
                                        "glosses": [
                                            "Art der Faltenwespen, die der Gattung der Großwespen (siehe [2]) angehört"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f963c8c-5cb3-4440-bbf2-7111958ffa1c",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "Der Stich einer Hornisse ist nicht gefährlicher als derjenige einer Biene."
                                            },
                                            {
                                                "example_id": "6650826b-a9a5-4fe0-9685-8320d6bbd210",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Zwei Hornissen stachen ihn fast zu gleicher Zeit, er brüllte vor Entsetzen und warf sein Gewehr weg.“"
                                            },
                                            {
                                                "example_id": "f4f17b4a-d17b-40e9-8c95-b1002ed5b9cb",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Dann flog eine Hummel in den Hochstand, die so groß war, daß sie auch eine Hornisse sein konnte.“"
                                            },
                                            {
                                                "example_id": "29ca2752-b58a-4424-a94f-6a6dbcd94895",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Bald schwärmten Fliegen, Wespen und Hornissen um das tote Tier; sie mussten es in den Graben werfen und dem Ungeziefer überlassen.“"
                                            },
                                            {
                                                "example_id": "77f124ae-924e-4daa-93eb-259b8e5568be",
                                                "sense_id": "2209cd24-d49b-3fbb-980f-060fb2dea193",
                                                "text": "„Drohnen, Hornissen, Schmetterlinge fliegen unsachlich herum und stossten gegen die Stockwände.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e09fd34-b963-38cf-816c-467da710ccdb",
                                        "entry_id": "2eaf3547-e486-3af4-815e-e6ed61d4e994",
                                        "glosses": [
                                            "Sammelbezeichnung für die Gattung Vespa oder Großwespen"
                                        ],
                                        "tags": [
                                            "Entomologie",
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508af155-d770-4495-b6d5-2451dba44341",
                                                "sense_id": "4e09fd34-b963-38cf-816c-467da710ccdb",
                                                "text": "Die Gattung der Hornissen zählt zu der Familie der Faltenwespen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
