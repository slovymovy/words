                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8e9cb6c-bd34-4ade-9e5a-99f9b34d40d7",
                                "sense_id": "122685ec-3858-301c-9183-922830c7ca52",
                                "text": "Disons dès à présent que cette cause est la présence […] de ces métaux , dont une quotité presque infinitésimale suffit pour rendre le fer, et à plus forte raison l'acier fondu, inforgeable et insoudable."
                            },
                            {
                                "example_id": "62a83a71-e9db-4ecf-9e00-bbbea78ac32e",
                                "sense_id": "122685ec-3858-301c-9183-922830c7ca52",
                                "text": "On considérait autrefois l’acier comme insoudable à lui-même, parce que le terme acier impliquait l’idée d'un métal assez fortement carburé."
                            }
                        ]
                    }
