                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7d87d46-ef53-3676-aef8-de980cfdbfd5",
                                        "entry_id": "322d9296-f86c-3478-83d3-3b8388033e59",
                                        "glosses": [
                                            "Vêtement pour bébé qui est porté pour dormir, et qui ne laisse découverts que la tête et parfois les bras."
                                        ],
                                        "tags": [
                                            "Puériculture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b438106-3983-4d8a-a05a-484508fc6dd2",
                                                "sense_id": "e7d87d46-ef53-3676-aef8-de980cfdbfd5",
                                                "text": "Les couettes et couvertures sont proscrites. Il faut préférer un surpyjama ou une turbulette."
                                            },
                                            {
                                                "example_id": "59c9a8b8-1598-49f7-9bcd-a5b3f03ca6b1",
                                                "sense_id": "e7d87d46-ef53-3676-aef8-de980cfdbfd5",
                                                "text": "Elle avait tellement gigoté que sa turbulette avait ripé et qu’une des bretelles lui barrait la joue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
