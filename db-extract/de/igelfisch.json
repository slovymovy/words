                        "source_entry_id": "ad14fa85-5aa4-33a2-9229-564ac01944be",
                        "source_sense_id": "af0dba0d-0666-3abc-85af-a625767b9150",
                        "source_sense_description": "Tropenfisch",
                        "target_lang_word": "egelvis",
