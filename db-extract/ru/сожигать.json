                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4927164f-809d-44ec-bcd5-51464981a6af",
                                "sense_id": "21bb59bf-9747-3497-94cc-563b2b72fcc3",
                                "text": "Над мёртвыми отправляют тризны, потом на струбе сожигают и пепел с костьми в сосудах на столпах ставят при дорогах."
                            },
                            {
                                "example_id": "35a4ff6b-2bcc-4662-8ee8-676f32da815d",
                                "sense_id": "21bb59bf-9747-3497-94cc-563b2b72fcc3",
                                "text": "По лесам и пустыням сами себя сожигают люди, страха ради антихристова."
                            }
                        ]
                    }
                ],
