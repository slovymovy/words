{
    "word_family": [
        "gemstone",
        "begem",
        "gemmy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d7206ed1-c79a-3c30-9487-57360814428e",
                    "sense_definition": "A precious stone, usually of substantial monetary value or prized for its beauty or shine.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "valuable_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displays a rare blue <w>gem</w> found in the mountains.",
                            "target_lang_translations": {
                                "ru": "В музее выставлен редкий голубой <w>драгоценный камень</w>, найденный в горах.",
                                "zh": "博物馆展出了一颗在山中发现的罕见蓝色<w>宝石</w>。"
                            }
                        },
                        {
                            "text": "He gave her a ring set with a sparkling <w>gem</w> for their anniversary.",
                            "target_lang_translations": {
                                "ru": "На годовщину он подарил ей кольцо со сверкающим <w>камнем</w>.",
                                "zh": "他在周年纪念日送给她一枚镶着闪亮<w>宝石</w>的戒指。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gemstone",
                        "jewel",
                        "precious stone"
                    ],
                    "antonyms": [
                        "coal"
                    ],
                    "common_phrases": [
                        "hidden gem",
                        "precious gem",
                        "rare gem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Драгоценный камень, обычно имеющий значительную денежную стоимость или ценящийся за свою красоту или блеск.",
                        "zh": "宝贵的石头，通常价值较高，或因美丽、光泽而受到珍视。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драгоценный камень",
                                "target_lang_sense_clarification": "минерал"
                            },
                            {
                                "target_lang_word": "самоцвет",
                                "target_lang_sense_clarification": "цветной камень"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宝石",
                                "target_lang_sense_clarification": "尤指珍贵、可作饰品的石头"
                            },
                            {
                                "target_lang_word": "宝玉",
                                "target_lang_sense_clarification": "较书面，多指有色或名贵石料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68ee92b9-9639-34a9-8d09-1a5549ed1480",
                    "sense_definition": "Any precious or highly valued thing or person.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "valuable_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This little restaurant is a hidden <w>gem</w> that few tourists know about.",
                            "target_lang_translations": {
                                "ru": "Этот маленький ресторанчик — настоящая скрытая <w>жемчужина</w>, о которой знают немногие туристы.",
                                "zh": "这家小餐馆是一处鲜为游客所知的隐藏<w>瑰宝</w>。"
                            }
                        },
                        {
                            "text": "Thank you for helping me move house; you are an absolute <w>gem</w>.",
                            "target_lang_translations": {
                                "ru": "Спасибо, что помог мне с переездом; ты настоящее <w>сокровище</w>.",
                                "zh": "谢谢你帮我搬家；你真是个<w>宝贝</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jewel"
                    ],
                    "common_phrases": [
                        "absolute gem",
                        "real gem",
                        "little gem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая драгоценная или высоко ценимая вещь или человек.",
                        "zh": "任何珍贵的、非常有价值的事物或人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жемчужина",
                                "target_lang_sense_clarification": "о предметах или местах"
                            },
                            {
                                "target_lang_word": "сокровище",
                                "target_lang_sense_clarification": "о людях"
                            },
                            {
                                "target_lang_word": "находка",
                                "target_lang_sense_clarification": "о чем-то редком и полезном"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瑰宝",
                                "target_lang_sense_clarification": "指很珍贵、很出色的事物、地方等"
                            },
                            {
                                "target_lang_word": "宝贝",
                                "target_lang_sense_clarification": "口语中可指特别好、特别贴心的人"
                            },
                            {
                                "target_lang_word": "珍品",
                                "target_lang_sense_clarification": "指难得而有价值的发现或事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "639c8f6d-62c5-348d-8261-af23c3b6294b",
                    "sense_definition": "A package containing programs or libraries for the Ruby programming language.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to install the latest <w>gem</w> to run this script successfully.",
                            "target_lang_translations": {
                                "ru": "Вам нужно установить последнюю версию <w>гема</w>, чтобы успешно запустить этот скрипт.",
                                "zh": "你需要安装最新版的<w>gem 包</w>，才能成功运行这个脚本。"
                            }
                        },
                        {
                            "text": "The developer published a new <w>gem</w> to help with data processing.",
                            "target_lang_translations": {
                                "ru": "Разработчик опубликовал новый <w>гем</w> для помощи в обработке данных.",
                                "zh": "开发者发布了一个新的<w>gem 包</w>，帮助处理数据。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пакет, содержащий программы или библиотеки для языка программирования Ruby.",
                        "zh": "包含 Ruby 编程语言程序或库的软件包。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гем",
                                "target_lang_sense_clarification": "сленг программистов"
                            },
                            {
                                "target_lang_word": "пакет",
                                "target_lang_sense_clarification": "программное обеспечение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "gem 包",
                                "target_lang_sense_clarification": "程序员常用说法，指 Ruby 的 gem 软件包"
                            },
                            {
                                "target_lang_word": "Ruby 软件包",
                                "target_lang_sense_clarification": "较说明性的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c292d2a-6901-343a-936b-20e202b2a9c7",
                    "sense_definition": "A strong, dominating pitching performance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pitcher threw a <w>gem</w> last night, allowing no runs in nine innings.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером питчер выдал <w>блестящую игру</w>, не пропустив ни одной пробежки за девять иннингов.",
                                "zh": "昨晚这位投手投出了一场<w>精彩的比赛</w>，九局没有失分。"
                            }
                        },
                        {
                            "text": "Fans cheered wildly after watching the rookie pitch a defensive <w>gem</w>.",
                            "target_lang_translations": {
                                "ru": "Болельщики неистово ликовали, увидев, как новичок сыграл <w>шедевральный матч</w> в защите.",
                                "zh": "球迷看完这位新秀投出一场<w>精彩的比赛</w>后，疯狂欢呼起来。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная, доминирующая игра питчера.",
                        "zh": "指投手压制力很强、表现极其出色的一场比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блестящая игра",
                                "target_lang_sense_clarification": "спорт"
                            },
                            {
                                "target_lang_word": "шедевр",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精彩的比赛",
                                "target_lang_sense_clarification": "棒球中指投手表现极为出色的一场比赛"
                            },
                            {
                                "target_lang_word": "精彩的投球表现",
                                "target_lang_sense_clarification": "更明确地指投手端的优异表现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c456cd4f-7297-3722-8c95-b39051d6d791",
                    "sense_definition": "A gemma or leaf bud.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist examined the small <w>gem</w> on the stem of the plant.",
                            "target_lang_translations": {
                                "ru": "Ботаник осмотрел маленькую <w>почку</w> на стебле растения.",
                                "zh": "植物学家查看了植物茎上的小<w>芽</w>。"
                            }
                        },
                        {
                            "text": "In spring, every <w>gem</w> on the branch begins to swell with new life.",
                            "target_lang_translations": {
                                "ru": "Весной каждая <w>почка</w> на ветке начинает наливаться новой жизнью.",
                                "zh": "春天，枝条上的每个<w>芽</w>都开始萌发新的生机。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "botany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Почка или листовой зачаток.",
                        "zh": "芽体，或叶片尚未展开时的幼芽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почка",
                                "target_lang_sense_clarification": "ботаника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "芽",
                                "target_lang_sense_clarification": "植物学，指枝条或茎上的芽"
                            },
                            {
                                "target_lang_word": "叶芽",
                                "target_lang_sense_clarification": "较专门，指叶的幼芽"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "89266690-8c6a-3bed-9a49-db39158dd94c",
                    "sense_definition": "To adorn with, or as if with, gems.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "adornment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bright stars <w>gemmed</w> the dark sky above the quiet ocean.",
                            "target_lang_translations": {
                                "ru": "Яркие звезды <w>усеяли</w> темное небо над тихим океаном.",
                                "zh": "明亮的星星<w>点缀</w>着寂静海洋上方的夜空。"
                            }
                        },
                        {
                            "text": "Morning dew <w>gemmed</w> the spiderwebs in the garden with tiny droplets.",
                            "target_lang_translations": {
                                "ru": "Утренняя роса <w>украсила</w> паутину в саду крошечными капельками.",
                                "zh": "晨露用细小的水珠<w>缀满</w>了花园里的蜘蛛网。"
                            }
                        }
                    ],
                    "synonyms": [
                        "begem"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать драгоценными камнями или чем-то похожим на них.",
                        "zh": "用宝石或仿佛宝石一样的东西装饰、点缀。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшать",
                                "target_lang_sense_clarification": "декорировать"
                            },
                            {
                                "target_lang_word": "усеивать",
                                "target_lang_sense_clarification": "покрывать множеством мелких объектов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点缀",
                                "target_lang_sense_clarification": "像宝石一样装点、装饰"
                            },
                            {
                                "target_lang_word": "缀满",
                                "target_lang_sense_clarification": "布满许多闪亮的小东西"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f6847f83-b707-3fa8-aec3-7d8f16adcb46",
                    "sense_definition": "A diminutive of the female given name Gemma.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Gem</w> is coming over for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Моя подруга <w>Джем</w> придет сегодня на ужин.",
                                "zh": "我的朋友<w>杰姆</w>今晚要来吃晚饭。"
                            }
                        },
                        {
                            "text": "We asked <w>Gem</w> if she wanted to join our study group.",
                            "target_lang_translations": {
                                "ru": "Мы спросили <w>Джем</w>, хочет ли она присоединиться к нашей учебной группе.",
                                "zh": "我们问<w>杰姆</w>愿不愿意加入我们的学习小组。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная форма женского имени Джемма.",
                        "zh": "女性名字 Gemma 的昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джем",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杰姆",
                                "target_lang_sense_clarification": "女性名字 Gemma 的昵称音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81e64b52-a304-3160-90ef-c266408e2985",
                    "sense_definition": "A place name used for various towns or communities in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They stopped in the small town of <w>Gem</w> during their road trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки они остановились в маленьком городке <w>Джем</w>.",
                                "zh": "他们自驾旅行时在小镇<w>杰姆</w>停了下来。"
                            }
                        },
                        {
                            "text": "The history of <w>Gem</w> dates back to the mining boom of the last century.",
                            "target_lang_translations": {
                                "ru": "История <w>Джема</w> восходит к горнодобывающему буму прошлого века.",
                                "zh": "<w>杰姆</w>的历史可以追溯到上个世纪的采矿热潮。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название различных городов или общин в США.",
                        "zh": "美国若干城镇或社区使用的地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джем",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杰姆",
                                "target_lang_sense_clarification": "美国一些城镇或社区的地名音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
