                                        "sense_id": "a72b9424-593c-3cab-8bf8-44608da85f2d",
                                        "entry_id": "a82c9c99-4dff-388d-8677-2b907ef210c4",
                                        "glosses": [
                                            "Qui n’est pas formellement exprimé, mais qui est sous-entendu, ou qui peut se sous-entendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69733e98-7d73-4b1a-906f-e5c8f06ca221",
                                                "sense_id": "a72b9424-593c-3cab-8bf8-44608da85f2d",
                                                "text": "C’était comme une reconnaissance tacite, instinctive, de la supériorité humaine, et précisément dans une circonstance où cette supériorité ne pouvait rien !"
                                            },
                                            {
                                                "example_id": "4a94af85-d438-4e9a-939a-46d9ee08837e",
                                                "sense_id": "a72b9424-593c-3cab-8bf8-44608da85f2d",
                                                "text": "Le Conseil d’État ne peut se prononcer qu’une fois rendus (de manière expresse ou tacite) les avis des organismes dont la consultation est obligatoire."
                                            }
                                        ]
                                    }
                                ]
