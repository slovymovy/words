                        "glosses": [
                            "Vertreter einer Gruppe von Sauerkirschsorten, z. B. Königliche Amarelle, Diemitzer Amarelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "985b7290-df1d-48bf-bd01-ae98bb8d8b57",
                                "sense_id": "8e0386bf-fb6c-32a6-891f-5db72b22a8e3",
                                "text": "„Amarellen sind eine in Mitteleuropa weit verbreitete Formengruppe, die zum Teil verwildert im Weinbaugebiet vorkommen; sie vermehren sich durch Ausläufer und Zufallssämlinge.“"
                            }
