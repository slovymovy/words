    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1e1245d-afaf-3511-83f3-1607adaeafb0",
                    "sense_definition": "To represent or stand for something as a symbol.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The white dove is often used to <w>symbolize</w> peace around the world."
                        },
                        {
                            "text": "In many cultures, the color green <w>symbolizes</w> renewal and hope."
                        }
                    ],
                    "synonyms": [
                        "represent"
                    ],
                    "common_phrases": [
                        "used to symbolize",
                        "symbolize peace",
                        "symbolize hope"
                    ]
                },
                {
                    "sense_id": "4e342c8a-0b48-31fb-91f3-afd1eacc9f44",
                    "sense_definition": "To portray or express ideas by means of symbols.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet chose to <w>symbolize</w> grief through the recurring image of a desolate winter landscape."
                        },
                        {
                            "text": "Ancient artists frequently sought to <w>symbolize</w> abstract concepts through animal figures."
                        }
                    ]
                },
                {
                    "sense_id": "4a6e1c22-311e-3dd1-9dd9-129a5985fc82",
                    "sense_definition": "To resemble each other in qualities or properties; to correspond or harmonize.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that the harmony of colors <w>symbolizes</w> with the natural order of musical tones."
                        },
                        {
                            "text": "Their natural temperaments seemed to <w>symbolize</w> in every way."
                        }
                    ],
                    "synonyms": [
                        "harmonize"
                    ],
                    "common_phrases": [
                        "symbolize with"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sense is obsolete or archaic in modern English"
                        }
                    ]
                },
                {
                    "sense_id": "433958b6-7c2f-3f01-86dc-d000cff87211",
                    "sense_definition": "To hold the same faith, belief, or religious opinion; to agree.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Members of the early congregation gathered to <w>symbolize</w> in one common confession of faith."
                        },
                        {
                            "text": "The reformists refused to <w>symbolize</w> with the doctrines taught by the orthodox council."
                        }
                    ],
                    "common_phrases": [
                        "symbolize with"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sense is archaic in modern English"
                        }
                    ]
                }
            ]
        }
    ]
