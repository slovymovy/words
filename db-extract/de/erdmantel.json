                "senses": [
                    {
                        "sense_id": "b59686ab-3d70-327d-8b10-3fd8ea56f965",
                        "entry_id": "74799043-2a4b-3033-abb7-f04769137455",
                        "glosses": [
                            "kugelförmige Schale des Planeten Erde, die sich unterhalb der Erdkruste und oberhalb des Erdkerns befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cead4913-6d29-4da4-b9e9-268ef0caa458",
                                "sense_id": "b59686ab-3d70-327d-8b10-3fd8ea56f965",
                                "text": "„In der Erdkruste und im oberen Erdmantel befindet sich in Tiefen von 75–250 km flüssig gewordenes Gestein.“"
                            },
                            {
                                "example_id": "440d5606-975e-4a98-b2c9-61da2aef6ab0",
                                "sense_id": "b59686ab-3d70-327d-8b10-3fd8ea56f965",
                                "text": "„Die Außenschale der Erde, also die Erdkruste, und die äußerste Schicht des Erdmantels (Lithosphäre) bestehen aus sieben großen und einem Dutzend kleinerer Platten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
