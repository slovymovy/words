                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72c0f7af-23bd-4d0c-8f8f-767064b5e1c2",
                                                "sense_id": "30158c9c-be87-3cae-bfeb-f8fdf3f1f8cd",
                                                "text": "Per pale erm. and az. a fess wavy gu."
                                            },
                                            {
                                                "example_id": "7c911980-be3e-43ca-8036-37f78d68b7a8",
                                                "sense_id": "30158c9c-be87-3cae-bfeb-f8fdf3f1f8cd",
                                                "text": "Parted per fess wavy gu. and arg.; over all a lion passant sa. pierced with a dagger ppr., hafted and pommelled of the second, the haft appearing between the shoulders and the point under the belly, tending towards the hind legs[…]"
                                            },
                                            {
                                                "example_id": "20d86eb5-5b11-41ab-85fb-f4242551c35f",
                                                "sense_id": "30158c9c-be87-3cae-bfeb-f8fdf3f1f8cd",
                                                "text": "On the fesse are two bars wavy azure for waterways."
                                            }
