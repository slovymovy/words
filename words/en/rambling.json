{
    "word_family": [
        "ramble",
        "rambler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c2de2130-fcfe-3bdd-b3c3-3c5c96834a92",
                    "sense_definition": "Of a speech or piece of writing: long, disorganized, and frequently going off-topic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disorganized communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor gave a <w>rambling</w> lecture that lasted two hours and never reached a clear conclusion.",
                            "target_lang_translations": {
                                "ru": "Профессор прочитал <w>бессвязную</w> лекцию, которая длилась два часа и так и не привела к четкому выводу."
                            }
                        },
                        {
                            "text": "I had trouble following his <w>rambling</w> explanation because he kept mentioning unrelated personal stories.",
                            "target_lang_translations": {
                                "ru": "Мне было трудно следить за его <w>сумбурным</w> объяснением, потому что он постоянно вставлял посторонние личные истории."
                            }
                        }
                    ],
                    "synonyms": [
                        "desultory"
                    ],
                    "antonyms": [
                        "concise",
                        "succinct"
                    ],
                    "common_phrases": [
                        "rambling speech",
                        "rambling explanation",
                        "rambling letter"
                    ],
                    "target_lang_definitions": {
                        "ru": "О речи или тексте: длинный, бессвязный и часто отклоняющийся от темы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бессвязный",
                                "target_lang_sense_clarification": "о речи или письме"
                            },
                            {
                                "target_lang_word": "пространный",
                                "target_lang_sense_clarification": "слишком длинный и запутанный"
                            },
                            {
                                "target_lang_word": "сумбурный",
                                "target_lang_sense_clarification": "хаотичный и неясный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d0178a3-340f-3546-a8e7-1b8bc2b49f75",
                    "sense_definition": "Spreading or winding irregularly in various directions, often used for buildings, paths, or plants.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "irregular layout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They live in a <w>rambling</w> old farmhouse with many small rooms and narrow corridors.",
                            "target_lang_translations": {
                                "ru": "Они живут в <w>беспорядочно застроенном</w> старом фермерском доме со множеством маленьких комнат и узких коридоров."
                            }
                        },
                        {
                            "text": "The garden was filled with <w>rambling</w> roses that climbed over the stone walls.",
                            "target_lang_translations": {
                                "ru": "Сад был полон <w>вьющихся</w> роз, которые карабкались по каменным стенам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rambling house",
                        "rambling garden",
                        "rambling roses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспорядочно разросшийся или извилистый, часто о зданиях, тропинках или растениях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разросшийся",
                                "target_lang_sense_clarification": "о растениях или садах"
                            },
                            {
                                "target_lang_word": "беспорядочно построенный",
                                "target_lang_sense_clarification": "о зданиях с множеством пристроек"
                            },
                            {
                                "target_lang_word": "вьющийся",
                                "target_lang_sense_clarification": "о растениях, например, розах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71fc31f5-4000-3486-9b88-92f96bec2ace",
                    "sense_definition": "Confused, irregular, or awkward in structure or arrangement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "irregular layout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The attic was an immensely large <w>rambling</w> loft where we found many forgotten treasures.",
                            "target_lang_translations": {
                                "ru": "Чердак представлял собой огромную <w>запутанную</w> мансарду, где мы нашли много забытых сокровищ."
                            }
                        },
                        {
                            "text": "The city's <w>rambling</w> layout made it very difficult for tourists to find their way without a map.",
                            "target_lang_translations": {
                                "ru": "<w>Хаотичная</w> планировка города очень мешала туристам ориентироваться без карты."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запутанный, нерегулярный или неудобный по структуре или расположению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хаотичный",
                                "target_lang_sense_clarification": "о планировке или структуре"
                            },
                            {
                                "target_lang_word": "запутанный",
                                "target_lang_sense_clarification": "о лабиринте комнат или улиц"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c50a996-4089-3a2d-a74d-2d68b087fb25",
                    "sense_definition": "The activity of going for a long, leisurely walk in the countryside for pleasure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole weekend <w>rambling</w> through the hills and enjoying the fresh air.",
                            "target_lang_translations": {
                                "ru": "Мы провели все выходные, <w>гуляя</w> по холмам и наслаждаясь свежим воздухом."
                            }
                        },
                        {
                            "text": "He joined a local <w>rambling</w> club to meet other people who enjoy hiking.",
                            "target_lang_translations": {
                                "ru": "Он вступил в местный клуб <w>пешего туризма</w>, чтобы познакомиться с другими любителями походов."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "rambling club",
                        "go rambling"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прогулки по сельской местности ради удовольствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пешие прогулки",
                                "target_lang_sense_clarification": "по пересеченной местности"
                            },
                            {
                                "target_lang_word": "туризм",
                                "target_lang_sense_clarification": "пеший туризм как хобби"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0329712b-6157-3cf2-a4ad-aafee2febe39",
                    "sense_definition": "Long, confused, or disconnected sequences of speech or writing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disorganized communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diary was full of the incoherent <w>ramblings</w> of a man who had lost his mind.",
                            "target_lang_translations": {
                                "ru": "Дневник был полон бессвязных <w>разглагольствований</w> человека, потерявшего рассудок."
                            }
                        },
                        {
                            "text": "I tried to listen to her <w>ramblings</w> about the war, but I couldn't follow the timeline.",
                            "target_lang_translations": {
                                "ru": "Я пытался слушать её <w>бредни</w> о войне, но не мог уследить за хронологией событий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "incoherent ramblings",
                        "mindless ramblings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинные, путаные или бессвязные высказывания или записи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разглагольствования",
                                "target_lang_sense_clarification": "пустая и долгая болтовня"
                            },
                            {
                                "target_lang_word": "бредни",
                                "target_lang_sense_clarification": "бессвязные мысли или речи"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae093208-2e09-3568-8423-3170f475933c",
                    "sense_definition": "Present participle and gerund of <w>ramble</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>rambling</w> on about his vacation again, and no one is really listening.",
                            "target_lang_translations": {
                                "ru": "Он снова <w>разглагольствует</w> о своем отпуске, и его никто особо не слушает."
                            }
                        },
                        {
                            "text": "They were <w>rambling</w> through the woods when they stumbled upon an old cabin.",
                            "target_lang_translations": {
                                "ru": "Они <w>бродили</w> по лесу, когда наткнулись на старую хижину."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rambling on",
                        "rambling through"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола «ramble» (бродить, разглагольствовать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтающий",
                                "target_lang_sense_clarification": "о человеке, который долго говорит"
                            },
                            {
                                "target_lang_word": "блуждающий",
                                "target_lang_sense_clarification": "о человеке, совершающем прогулку"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
