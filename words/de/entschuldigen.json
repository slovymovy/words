                {
                    "sense_id": "8ed5450d-d615-33a6-bdd8-1ae275745712",
                    "sense_definition": "reflexiv: das eigene Bedauern über einen Fehler oder ein Fehlverhalten ausdrücken und um Verzeihung bitten",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "abbitte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hat sich gestern bei ihr für das Missverständnis <w>entschuldigt</w>."
                        },
                        {
                            "text": "Ich möchte mich bei Ihnen aufrichtig für meinen unhöflichen Ton <w>entschuldigen</w>."
                        }
                    ],
                    "synonyms": [
                        "um Entschuldigung bitten",
                        "um Verzeihung bitten"
                    ],
                    "common_phrases": [
                        "sich aufrichtig entschuldigen",
                        "sich für einen Fehler entschuldigen"
                    ]
                },
                {
                    "sense_id": "3625f8b4-9d53-38e5-b566-9064a48e4fc8",
                    "sense_definition": "transitiv: Nachsicht für ein Vergehen oder eine Störung zeigen; verzeihen oder als Rechtfertigung dienen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verzeihen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Entschuldigen</w> Sie bitte die Störung, aber wir müssen kurz miteinander sprechen."
                        },
                        {
                            "text": "Sein großer Stress kann dieses unfreundliche Verhalten keinesfalls ganz <w>entschuldigen</w>."
                        }
                    ],
                    "common_phrases": [
                        "die Störung entschuldigen",
                        "eine Verspätung entschuldigen"
                    ]
                },
                {
                    "sense_id": "7abe4ec1-a938-3dc9-8695-5012249ba8cc",
                    "sense_definition": "transitiv oder reflexiv: die Abwesenheit einer Person, beispielsweise in der Schule oder am Arbeitsplatz, offiziell begründen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abwesenheit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Mutter rief am Morgen an, um ihr krankes Kind in der Schule zu <w>entschuldigen</w>."
                        },
                        {
                            "text": "Wer am Unterricht nicht teilnehmen kann, muss sich rechtzeitig im Sekretariat <w>entschuldigen</w>."
                        }
                    ],
                    "common_phrases": [
                        "einen Schüler entschuldigen",
                        "wegen Krankheit entschuldigen"
                    ]
                },
                {
                    "sense_id": "006f97a9-1f53-3609-89d4-a0d324cee4ef",
                    "sense_definition": "reflexiv: höflich ankündigen, dass man eine Gesellschaft oder einen Raum kurzzeitig oder vorzeitig verlässt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entfernen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er stand mitten in der Besprechung auf und <w>entschuldigte</w> sich für einen kurzen Augenblick."
                        },
                        {
                            "text": "Darf ich mich eben <w>entschuldigen</w>, ich muss draußen ein wichtiges Telefonat führen."
                        }
                    ],
                    "common_phrases": [
