                    {
                        "translation_id": "414fab0a-26e7-434e-843d-05534da8e9f9",
                        "source_entry_id": "39559601-3d5a-3f77-ae95-f05d1cdd32a2",
                        "source_sense_id": "abb9f41b-4ddf-3dc4-936e-087d43e31a42",
                        "target_lang_word": "Aussage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aussage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cec9bb3-041c-3763-a60d-3835fdd93950",
                                        "entry_id": "5a75847b-e3dd-3c86-8853-06cc369b4ca2",
                                        "glosses": [
                                            "Erklärung, Bekundung, Feststellung; etwas Gesagtes, das die eigene Meinung beziehungsweise das eigene Wissen widerspiegelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fbb8d05-09d8-4519-8c9e-cbd9fd88cd02",
                                                "sense_id": "4cec9bb3-041c-3763-a60d-3835fdd93950",
                                                "text": "„Sie hat einen Gesprächsstil perfektioniert, der den Interviewer sicher mit einem guten Gefühl, aber mit so gut wie keiner klaren Aussage zurücklässt.“"
                                            },
                                            {
                                                "example_id": "47841b45-82db-4080-9922-790e8e1152b6",
                                                "sense_id": "4cec9bb3-041c-3763-a60d-3835fdd93950",
                                                "text": "„Symptomatisch für diese gipfelbezogene Erlebnisweise des Höhenbergsteigens ist die Motivationskurve, die sich in zahlreichen, von mir geführten Interviews sinngleich wie in den folgenden Aussagen offenbart: Wenn ich einen Gipfel erreicht habe, sinkt meine Motivation rapide ab […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee4917c8-0e6d-3bcd-8af6-404b7757426e",
                                        "entry_id": "5a75847b-e3dd-3c86-8853-06cc369b4ca2",
                                        "glosses": [
                                            "Erklärung vor Gericht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aaecef3-6759-4c82-9beb-d84aba815128",
                                                "sense_id": "ee4917c8-0e6d-3bcd-8af6-404b7757426e",
                                                "text": "Er widerrief seine Aussage."
                                            },
                                            {
                                                "example_id": "446d28ff-7aac-4635-b349-2e9f1755f9e8",
                                                "sense_id": "ee4917c8-0e6d-3bcd-8af6-404b7757426e",
                                                "text": "„Die Aussage von dem Fried und anschließend wahrscheinlich die Schlussplädoyers von Dr. Grüner und dem Staatsanwalt – das würde sich bestimmt bis in den Nachmittag ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "86e30653-8deb-3baf-9070-d55201065984",
                                        "entry_id": "5a75847b-e3dd-3c86-8853-06cc369b4ca2",
                                        "glosses": [
                                            "inhaltliche Nachricht, zum Beispiel eines künstlerischen Werks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39e9227a-c696-4403-a6e6-af65e11b7a37",
                                                "sense_id": "86e30653-8deb-3baf-9070-d55201065984",
                                                "text": "Ich weiß nicht, welche Aussage dieses Gemälde hat."
                                            },
                                            {
                                                "example_id": "c7314116-de72-4b43-b528-7eb93378fc00",
                                                "sense_id": "86e30653-8deb-3baf-9070-d55201065984",
                                                "text": "Mit seinen Ölfässern auf dem Wasser hat Christo auch eine politische Aussage gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e5067169-278a-3b40-86b8-2daff96874db",
                                        "entry_id": "5a75847b-e3dd-3c86-8853-06cc369b4ca2",
                                        "glosses": [
                                            "Zeichenreihe, die einen Sachverhalt widerspiegelt und entweder wahr oder falsch ist"
                                        ],
                                        "tags": [
                                            "Logik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2831227-acff-4cce-8197-efbaef367a25",
                                                "sense_id": "e5067169-278a-3b40-86b8-2daff96874db",
                                                "text": "„Aussageformen werden durch bestimmte Einsetzungen für die Variablen zu wahren oder falschen Aussagen.“"
                                            },
                                            {
                                                "example_id": "5bbad9f6-93da-4dfd-a09c-7b37ecaafc3a",
                                                "sense_id": "e5067169-278a-3b40-86b8-2daff96874db",
                                                "text": "„Untersuchen wir eine Eigenschaft eines mathematischen Objektes oder einen Zusammenhang zwischen mathematischen Objekten, so betrachten wir einen mathematischen Sachverhalt, den wir gegebenenfalls als eine wahre Aussage formulieren können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15b2c303-7469-4c32-aa58-69e885e0644d",
                        "source_entry_id": "39559601-3d5a-3f77-ae95-f05d1cdd32a2",
                        "source_sense_id": "df814efb-bc35-31ed-be1a-5393c605aa14",
                        "target_lang_word": "assertion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assertion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dab2e479-1b2d-3144-915c-8e792d415f21",
                                        "entry_id": "5d881612-7c5e-3f12-a199-e8d25a60e6a9",
                                        "glosses": [
                                            "The act of asserting; positive declaration or averment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d204c109-2286-3749-bb35-452863242bf6",
                                        "entry_id": "5d881612-7c5e-3f12-a199-e8d25a60e6a9",
                                        "glosses": [
                                            "Something which is asserted; a declaration; a statement asserted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "416056ae-a017-4614-acdf-c1af0e682a47",
                                                "sense_id": "d204c109-2286-3749-bb35-452863242bf6",
                                                "text": "You're a man of strong assertions!"
                                            },
                                            {
                                                "example_id": "af66a702-bf37-464a-a903-2c57213037a5",
                                                "sense_id": "d204c109-2286-3749-bb35-452863242bf6",
                                                "text": "Suppose you are given the semifactual assertion, \"even if Nora had liked mathematics then she would have became^([sic]) a scientist\" and then you find out that Nora did in fact become a scientist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "197549a5-7c1a-3bd6-be7e-53586e8f39c4",
                                        "entry_id": "5d881612-7c5e-3f12-a199-e8d25a60e6a9",
                                        "glosses": [
                                            "A statement or declaration which lacks support or evidence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "120c76aa-6503-41da-9e74-c8f1f935728a",
                                                "sense_id": "197549a5-7c1a-3bd6-be7e-53586e8f39c4",
                                                "text": "That's just a bare assertion."
                                            },
                                            {
                                                "example_id": "4a5dfda5-691b-4aea-8306-7cefef93db49",
                                                "sense_id": "197549a5-7c1a-3bd6-be7e-53586e8f39c4",
                                                "text": "Drivers' union ASLEF bluntly rebuffed the claim of unofficial action, calling it a lie. And Avanti West Coast was unable to provide any proof for its assertion, when questioned by RAIL."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e7dd9f7-52c5-334c-a5aa-9c2b95653b5c",
                                        "entry_id": "5d881612-7c5e-3f12-a199-e8d25a60e6a9",
                                        "glosses": [
                                            "Maintenance; vindication"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01284959-b39c-4cf2-afb4-32cf40065fad",
                                                "sense_id": "1e7dd9f7-52c5-334c-a5aa-9c2b95653b5c",
                                                "text": "the assertion of one's rights or prerogatives"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16bd5c75-fa92-3f50-bbb9-9aae453c36b7",
                                        "entry_id": "5d881612-7c5e-3f12-a199-e8d25a60e6a9",
                                        "glosses": [
                                            "A statement in a program asserting a condition expected to be true at a particular point, used in debugging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c1c824-9bc5-4884-8933-f5d7d2f43cde",
                                                "sense_id": "16bd5c75-fa92-3f50-bbb9-9aae453c36b7",
                                                "text": "The user should be absolutely confident that the error issued is a real design error. In other words, a user should be confident that his assertion code is correct and that the assertion failure is not a false condition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d601b1d-76f4-340b-8275-69202374a3b1",
                                        "entry_id": "5d881612-7c5e-3f12-a199-e8d25a60e6a9",
                                        "glosses": [
                                            "the set of information that the statement preparer is providing in a financial statement audit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
