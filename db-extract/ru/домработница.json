                "senses": [
                    {
                        "sense_id": "2600695b-0b48-3c40-9cb3-01a9e83b5af0",
                        "entry_id": "9128efd6-e21f-3851-a164-f630361bc32c",
                        "glosses": [
                            "сокр. от домашняя работница; сотрудница, выполняющая хозяйственную работу в частном доме, квартире"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "2037f0f7-fdc3-4951-b2f0-543d0cf831d1",
                                "sense_id": "2600695b-0b48-3c40-9cb3-01a9e83b5af0",
                                "text": "Домработница убирала стометровку, ходила на рынок, готовила бутерброды из колбасы с трюфелями и выполняла всякие мелкие хозяйские поручения ― то есть всё то, что делает самая обыкновенная женщина."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b9405ac-bd7b-48bc-9420-c51b3057e0e4",
                        "source_entry_id": "9128efd6-e21f-3851-a164-f630361bc32c",
                        "source_sense_id": "2600695b-0b48-3c40-9cb3-01a9e83b5af0",
