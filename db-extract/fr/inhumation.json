                        "target_lang_word": "inhumacja",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhumacja",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "cd3e1c68-415d-30dd-b341-d94531dc8ee3",
                                        "entry_id": "b1b14446-4805-3abd-8e22-be559b4197e7",
                                        "glosses": [
                                            "pogrzebanie zmarłego w ziemi"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3425565-ad8f-4f82-ac44-1dcd18a37e6d",
                                                "sense_id": "cd3e1c68-415d-30dd-b341-d94531dc8ee3",
                                                "text": "Ludność praktykowała obrządek birytualny, to jest zarówno kremację, jak i inhumację, co uważane jest za cechę charakterystyczną kultury wielbarskiej"
                                            },
                                            {
                                                "example_id": "87d046e8-8d3b-4ee4-947d-f04499a2fe81",
                                                "sense_id": "cd3e1c68-415d-30dd-b341-d94531dc8ee3",
                                                "text": "Występowanie w nich inhumacji i kremacji świadczy o etnicznej niejednolitości huńskiej ordy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
