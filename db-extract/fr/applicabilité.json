                ],
                "senses": [
                    {
                        "sense_id": "3f8ceedf-c4a1-307c-bff6-00cb31ba6fd4",
                        "entry_id": "719084ba-a2a3-3e92-8621-ee46c9b54580",
                        "glosses": [
                            "Qualité de ce qui est applicable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa639e61-6be4-4bf2-8347-f9efcb141f28",
                                "sense_id": "3f8ceedf-c4a1-307c-bff6-00cb31ba6fd4",
                                "text": "Selon plusieurs auteurs, lʼapplicabilité des méthodes utilisées dans le secteur privé reste à démontrer."
                            },
                            {
                                "example_id": "d2998e65-510b-426f-be97-3e826a8f25b1",
                                "sense_id": "3f8ceedf-c4a1-307c-bff6-00cb31ba6fd4",
                                "text": "La mise en ligne des circulaires et instructions dans cette rubrique de Légifrance est la condition de leur applicabilité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c76fdeb-ba24-4223-a744-441b98006ed9",
                        "source_entry_id": "719084ba-a2a3-3e92-8621-ee46c9b54580",
                        "source_sense_id": "3f8ceedf-c4a1-307c-bff6-00cb31ba6fd4",
                        "target_lang_word": "Anwendbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anwendbarkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                        "entry_id": "d3f4a65d-d31f-39ad-82f5-8a30bef9c948",
                                        "glosses": [
                                            "Möglichkeit, zielführend verwendet zu werden/werden zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c56bd18-02dc-4326-8e0b-2899fd32b156",
                                                "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                                "text": "„Da über die Anwendbarkeit dieses Düngmittels wohl kein Zweifel mehr bestehen kann, so kommt es darauf an, zu zeigen, welche Pflanzen sich am besten hiezu eignen, welchem Boden die verschiedenen Arten am meisten zusagen, wann sie gesät und untergepflügt, und endlich wie sie behandelt werden müssen.“"
                                            },
                                            {
                                                "example_id": "fa115535-37b3-46b5-92d5-3ea0f945b5cd",
                                                "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                                "text": "„Das Verfassungsgericht hat die vorläufige Anwendbarkeit von Ceta unter Auflage gebilligt.“"
                                            },
                                            {
                                                "example_id": "89e520a7-412e-48ab-8ab4-7520c6fb0131",
                                                "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                                "text": "„In der Folge wurde die Anwendbarkeit dieser ausgewählten EProcurement-Tools für die elektronische Vergabe solcher Aufträge hinsichtlich rechtlicher, organisatorischer, technischer und ökonomischer Anforderungen untersucht.“"
                                            },
                                            {
                                                "example_id": "7ac53858-09df-4189-89df-15e5970a942b",
                                                "sense_id": "e75d1264-1ee1-3594-8cce-20721096b3b8",
                                                "text": "„Ich fand die Anwendbarkeit der Kontrastbetonung auf alle möglichen Lebensbereiche äußerst amüsant und erhellend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16800a66-6da2-4e22-b8e0-840565b094d4",
                        "source_entry_id": "719084ba-a2a3-3e92-8621-ee46c9b54580",
                        "source_sense_id": "3f8ceedf-c4a1-307c-bff6-00cb31ba6fd4",
                        "target_lang_word": "Verwendbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verwendbarkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7095052f-0eb2-310e-a06e-dfbad7dc01b5",
                                        "entry_id": "37800ea7-def7-3e8a-942b-789cb27103e0",
                                        "glosses": [
                                            "Möglichkeit, sinnvoll genutzt zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4952bea-e8c2-4e19-8d11-174695089f7d",
                                                "sense_id": "7095052f-0eb2-310e-a06e-dfbad7dc01b5",
                                                "text": "„Durch die hervorragende Verwendbarkeit seiner Musik besonders bei Tanzveranstaltungen und Partys erlangte er bald weltweite Berühmtheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a18ebdd-31d6-46cc-ba14-1ffd95c87887",
