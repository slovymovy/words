                                    {
                                        "sense_id": "fc740a1a-a19d-3e1d-9d02-ed06f417532b",
                                        "entry_id": "ab76310c-3510-3f6b-9f26-196122b3925f",
                                        "glosses": [
                                            "sich logisch und konsequent aus etwas Vorhergehendem ergebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13bf76ea-38a9-4b9f-9ea5-ed5745909c97",
                                                "sense_id": "fc740a1a-a19d-3e1d-9d02-ed06f417532b",
                                                "text": "Nach allem, was sie erlebt hatte, war es nur ein folgerichtiger Schritt, dass Suzanne ihren Mann verließ."
                                            },
                                            {
                                                "example_id": "97f79ddd-3937-46b8-b2bb-a8233b190b76",
                                                "sense_id": "fc740a1a-a19d-3e1d-9d02-ed06f417532b",
                                                "text": "Da sie von einem Affen gebissen worden war, war es folgerichtig, dass Inge fortan nur noch die Fische des Zoos betreute."
                                            },
                                            {
                                                "example_id": "a0a3d693-607e-4024-9537-0017833a1943",
                                                "sense_id": "fc740a1a-a19d-3e1d-9d02-ed06f417532b",
                                                "text": "Sie denken da wieder einmal folgerichtig, Herr Schröder."
                                            },
                                            {
                                                "example_id": "9be23579-3fc8-4144-9fbd-d27a5b75875e",
                                                "sense_id": "fc740a1a-a19d-3e1d-9d02-ed06f417532b",
                                                "text": "„Dieses ist für den jezt zu behandelnden Gegenstand die folgerichtigste Darstellung derjenigen Ansicht, welche die Erwekkung und Verbreitung der allgemeinen Menschenliebe als die eigentliche und wesentliche Furcht der Erscheinung Christi betrachtet.“"
                                            },
                                            {
                                                "example_id": "bdea9b56-b598-4c72-9506-e6705ba839fc",
                                                "sense_id": "fc740a1a-a19d-3e1d-9d02-ed06f417532b",
                                                "text": "„Deshalb stellt die Fabrik die folgerichtigste Durchbildung des Prinzips gesellschaftlicher Produktion dar, ohne doch als die höchste Form der Betriebsanordnung überhaupt gelten zu dürfen“."
                                            },
                                            {
                                                "example_id": "9bfca2de-e843-4570-8c31-8c28115e9828",
                                                "sense_id": "fc740a1a-a19d-3e1d-9d02-ed06f417532b",
                                                "text": "„Da der Kommunismus ein radikalerer und folgerichtigerer Typus der Immanentisierung ist als der Progressivismus oder der soziale Utopismus, hat er die logique du cœur [Hervorhebung im Original] auf seiner Seite.“"
                                            },
                                            {
                                                "example_id": "cbd98dc7-b3e9-4721-b054-dfeb3781f65e",
                                                "sense_id": "fc740a1a-a19d-3e1d-9d02-ed06f417532b",
                                                "text": "„In Ostdeutschland wurde die Legende vom Faschismus als folgerichtiger Ausgeburt des Kapitalismus und seiner herrschenden monopolkapitalistischen Fraktion als offizielle Doktrin verbindlich gemacht.“"
                                            },
                                            {
                                                "example_id": "6044cb95-5912-4342-a4b6-0d70de5be1d2",
                                                "sense_id": "fc740a1a-a19d-3e1d-9d02-ed06f417532b",
                                                "text": "„Die Streichung der bisher in § 23 III Nr. 5 AktG geregelten Verpflichtung, in der Satzung eine Bestimmung darüber zu treffen, ob Inhaber- oder Namensaktien ausgestellt werden, ist folgerichtig, wenn § 24 I 1 AktG dahin geändert wird, dass grundsätzlich Namensaktien ausgestellt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
