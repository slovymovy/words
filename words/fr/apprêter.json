    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b95b870b-34ee-32d8-8aea-96bdded92a36",
                    "sense_definition": "Se disposer ou se préparer à faire quelque chose dans un avenir immédiat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train arrive en gare et les passagers s'<w>apprêtent</w> à descendre sur le quai."
                        },
                        {
                            "text": "Je m'<w>apprête</w> à partir au travail quand une averse soudaine commence à tomber."
                        }
                    ],
                    "synonyms": [
                        "se préparer",
                        "se disposer"
                    ],
                    "common_phrases": [
                        "s'apprêter à partir",
                        "s'apprêter au pire"
                    ]
                },
                {
                    "sense_id": "d12a034b-5025-3782-a14d-72b83ee203c8",
                    "sense_definition": "Disposer ou préparer convenablement quelque chose, notamment de la nourriture ou une tenue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier <w>apprête</w> le poisson avec des herbes fraîches avant de le passer au four."
                        },
                        {
                            "text": "Elle a pris beaucoup de temps pour <w>apprêter</w> sa tenue avant la grande réception."
                        }
                    ],
                    "synonyms": [
                        "préparer",
                        "accommoder",
                        "arranger"
                    ],
                    "common_phrases": [
                        "apprêter un repas",
                        "apprêter un mets"
                    ]
                },
                {
                    "sense_id": "99582c4f-a39b-31b3-ae1e-d62e4c014d12",
                    "sense_definition": "Faire subir un traitement technique ou chimique à une matière pour lui donner son aspect définitif.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan <w>apprête</w> le cuir avec soin afin de lui apporter toute la souplesse voulue."
                        },
                        {
                            "text": "L'ouvrier textile <w>apprête</w> une étoffe avant sa mise en vente dans les ateliers de confection."
                        }
                    ],
                    "synonyms": [
                        "traiter",
                        "conditionner"
                    ],
                    "common_phrases": [
                        "apprêter le cuir",
                        "apprêter une étoffe"
                    ]
                }
            ]
        }
    ]
}