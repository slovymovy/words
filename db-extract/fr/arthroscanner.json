                        "entry_id": "d6b97a5c-f28a-3f3c-a41d-0b89003598d8",
                        "glosses": [
                            "Examen médical qui est à la fois un moyen de diagnostic et d’observation d’organes (articulations en général) invisibles à la radiographie classique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee66b87-83bd-4ed3-8eab-bc520b6ef601",
                                "sense_id": "a4240d94-643d-302f-b6e1-35f7001a0f29",
                                "text": "L’intérieur du Havre Maxime Zianveni, blessé au poignet droit depuis près de deux mois, a passé vendredi un arthroscanner qui a révélé une lésion ligamentaire."
                            }
                        ]
                    }
                ],
