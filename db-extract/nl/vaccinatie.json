                "senses": [
                    {
                        "sense_id": "7f66308b-5172-3811-a437-f1fe5ccd47c9",
                        "entry_id": "0d457e24-ca13-3110-8ca2-af7d7ad51d57",
                        "glosses": [
                            "inenting met onschadelijke gemaakte ziekteverwekkers, zodat de natuurlijke afweer van het lichaam hierna beter in staat is deze ziekteverwekkers te bestrijden"
                        ],
                        "tags": [],
