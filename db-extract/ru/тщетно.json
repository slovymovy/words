        "ru-extract.jsonl": [
            {
                "entry_id": "eede2dd4-0d0a-39df-b059-daa75c84f792",
                "word": "тщетно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a15f62e-ce0b-39ca-aa9f-b243a5f9932b",
                        "entry_id": "eede2dd4-0d0a-39df-b059-daa75c84f792",
                        "glosses": [
                            "наречие к тщетный; напрасно, бесполезно, безрезультатно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "7ecd7fa4-ec9e-4ac3-b2da-44f13ef6b8e7",
                                "sense_id": "5a15f62e-ce0b-39ca-aa9f-b243a5f9932b",
                                "text": "Князь употребил все свои усилия, но всё было тщетно: княгиня не изменяла намерения."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9dbc8e8-45da-3fe9-a89d-554dfb51146e",
                        "entry_id": "eede2dd4-0d0a-39df-b059-daa75c84f792",
                        "glosses": [
                            "оценка какой-либо ситуации, чьих-либо действий как бесполезных, безрезультатных"
                        ],
                        "tags": [
                            "предикатив"
                        ],
                        "examples": [
                            {
                                "example_id": "e3400456-071c-403d-810c-9de3aad5491c",
                                "sense_id": "a9dbc8e8-45da-3fe9-a89d-554dfb51146e",
                                "text": "Пандалевский тщетно старался занять соседку свою, Александру Павловну: он весь закипал сладостью, а она чуть не зевала."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96db9d92-fff2-402f-b505-6c43670dc7a8",
                        "source_entry_id": "eede2dd4-0d0a-39df-b059-daa75c84f792",
                        "target_lang_word": "in vain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in vain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b56e82c-1ef1-3877-9179-4ba1a1de4919",
                                        "entry_id": "25767d49-4bdb-3543-a32f-dd7083cbaf89",
                                        "glosses": [
                                            "Without success or a result; ending in failure."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8835c1b-e36b-4a92-bd36-91742ccb3046",
                                                "sense_id": "6b56e82c-1ef1-3877-9179-4ba1a1de4919",
                                                "text": "[…]that we here highly resolve that these dead shall not have died in vain[…]"
                                            },
                                            {
                                                "example_id": "914f9f67-dd48-425b-84f1-73b8c075fd17",
                                                "sense_id": "6b56e82c-1ef1-3877-9179-4ba1a1de4919",
                                                "text": "19th c., Friedrich Nietzsche\nOn the mountains of truth you can never climb in vain."
                                            },
                                            {
                                                "example_id": "43d9dffa-32be-419a-b238-12a6f7fae397",
                                                "sense_id": "6b56e82c-1ef1-3877-9179-4ba1a1de4919",
                                                "text": "For some time Grannie tried in vain to comfort her."
                                            },
                                            {
                                                "example_id": "8a1332eb-f9a4-4262-a10d-5a8697f48f7a",
                                                "sense_id": "6b56e82c-1ef1-3877-9179-4ba1a1de4919",
                                                "text": "All these great plans were in vain, however, for in the cold dawn following the \"Mania\" years of 1845–46 the M.B.M. & M.J.R. project was truncated to an 11+¹⁄₂-mile line from Ambergate to Rowsley."
                                            },
                                            {
                                                "example_id": "d7974aa1-62dd-4107-ad89-2f2e88396e54",
                                                "sense_id": "6b56e82c-1ef1-3877-9179-4ba1a1de4919",
                                                "text": "Knock me down, it's all in vain\nI get right back on my feet again"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                        "entry_id": "25767d49-4bdb-3543-a32f-dd7083cbaf89",
                                        "glosses": [
                                            "In a disrespectful manner, without honoring the proper meaning; insincerely or without proper respect."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57e4af38-bb01-433a-a283-01783957c510",
                                                "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                                "text": "Thou ſhalt not take the Name of the Lord thy God in vaine:[…]"
                                            },
                                            {
                                                "example_id": "ae7ef1b2-ef63-493b-9120-775ca25b376f",
                                                "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                                "text": "Methinks I see him even now in my mind's eye;— the firm and upright figure,— the step, quick and determined, — the eye, which shot so keen and so penetrating a glance,— the features on which care had already planted wrinkles, and hear his language, in which he never wasted word in vain, expressed in a voice which had sometimes an occasional harshness, far from the intention of the speaker."
                                            },
                                            {
                                                "example_id": "ddefe81b-fc3e-4971-82f4-c052bafd7ca2",
                                                "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                                "text": "A fetishist regime attempts to annul the separation of image and spectator, to reinstall an immediate relation that promises (in vain) to provide satisfaction to desire itself."
                                            },
                                            {
                                                "example_id": "75b6f7bb-b80b-412a-9520-eb380db30a61",
                                                "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                                "text": "This petition is the reverse side of the commandment against taking God's name in vain."
                                            },
                                            {
                                                "example_id": "edea780f-3f5d-4be6-8ba4-4cc562603979",
                                                "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                                "text": "McLaren's task, it seems, is to set Jesus in a more appropriate and biblical context so that we won't use his name “in vain.”"
                                            },
                                            {
                                                "example_id": "c91aec32-9ce9-4182-a1c1-452b1382de80",
                                                "sense_id": "9907614a-2305-31b8-8c2a-5696d23484d3",
                                                "text": "That's fine. I know you won't engage your word in vain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "in vain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe89158c-519c-3731-a93c-9c1abb089de6",
                                        "entry_id": "f297aee0-31fa-35ef-97ae-57bad9298d22",
                                        "glosses": [
                                            "Unsuccessful, failed."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ff305a6-9987-47e0-97ec-8855614e153d",
                                                "sense_id": "fe89158c-519c-3731-a93c-9c1abb089de6",
                                                "text": "Their efforts were in vain and he succumbed to his injuries."
                                            },
                                            {
                                                "example_id": "cef5cd3a-ff46-498b-9046-c1bf45a79c0a",
                                                "sense_id": "fe89158c-519c-3731-a93c-9c1abb089de6",
                                                "text": "The problems concerning contrast induced hyperemia and the in vain efforts to search for a contrast agent not influencing flow […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3c5c4a9-fd22-4e1c-8e5c-14a19595d39f",
                        "source_entry_id": "eede2dd4-0d0a-39df-b059-daa75c84f792",
                        "target_lang_word": "en vain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en vain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26de3253-0f8c-3cf1-91ae-f252dd879ff7",
                                        "entry_id": "385bb150-5402-3813-8cbf-8fd35a346bc4",
                                        "glosses": [
                                            "Vainement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf8d990-0fb9-461a-9d27-f0ba9c4d60fd",
                                                "sense_id": "26de3253-0f8c-3cf1-91ae-f252dd879ff7",
                                                "text": "En vain, j’avais cherché un ru, dont l’eau fraîche chante sous les feuilles, ou bien une source, comme il s’en trouve pourtant beaucoup dans le pays."
                                            },
                                            {
                                                "example_id": "e28266a1-dcbd-4aa4-9bbe-2afac93a26dd",
                                                "sense_id": "26de3253-0f8c-3cf1-91ae-f252dd879ff7",
                                                "text": "Il cracha une injure, s’élança et réempoigna la jeune femme qui, cette fois, se débattit en vain."
                                            },
                                            {
                                                "example_id": "ec7ad62e-5590-4342-93e9-26990fc2a505",
                                                "sense_id": "26de3253-0f8c-3cf1-91ae-f252dd879ff7",
                                                "text": "En vain l’ambassadeur de France tenta de fléchir les négociateurs américains. Ils se montrèrent implacables. Il fallait se soumettre ou faire banqueroute."
                                            },
                                            {
                                                "example_id": "91fe6495-77f8-49c6-969e-46f31de995bc",
                                                "sense_id": "26de3253-0f8c-3cf1-91ae-f252dd879ff7",
                                                "text": "On appelle maintenant Derbo, le grand ministre de Mamma. Celui-là fait quelques difficultés pour accepter son incarnation. C’est en vain que le chœur profère son pressant appel, en vain que les mains agitent les tambourins."
                                            },
                                            {
                                                "example_id": "99522718-6803-493c-9d65-34165b94da2c",
                                                "sense_id": "26de3253-0f8c-3cf1-91ae-f252dd879ff7",
                                                "text": "Le navire imperturbable cingle vers l’immensité polaire, se glisse parmi les icebergs fantastiques qui dérivent en tournoyant cauteleusement, évités de justesse, en vain menaçants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60727afa-9867-47e2-a4e7-2cc0f4ba2035",
                        "source_entry_id": "eede2dd4-0d0a-39df-b059-daa75c84f792",
                        "target_lang_word": "vainement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vainement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "176f3993-6db9-37d4-bade-292933b83b30",
                                        "entry_id": "9f6a8d00-ac17-3d28-9350-dccda1945934",
                                        "glosses": [
                                            "En vain ; inutilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f27e355-211f-47f4-be63-cc841b2a623f",
                                                "sense_id": "176f3993-6db9-37d4-bade-292933b83b30",
                                                "text": "Vainement avaient-ils stipulé qu'on ne pourrait les rembourser qu'en écus ; il n'en fallait pas moins qu'ils reçussent leur remboursement en assignats."
                                            },
                                            {
                                                "example_id": "c68f4e1d-5790-4f61-8a38-e1fd0cc0252b",
                                                "sense_id": "176f3993-6db9-37d4-bade-292933b83b30",
                                                "text": "Mais il se multiplia vainement, il ne pouvait se montrer partout, et les ennemis délinquaient partout à la fois."
                                            },
                                            {
                                                "example_id": "5962031b-1954-4435-ace4-4f36501f5768",
                                                "sense_id": "176f3993-6db9-37d4-bade-292933b83b30",
                                                "text": "Mais vainement avait-on fouillé les bois et dragué les rivières; vainement avait-on signalé à toutes les autorités du département les deux étrangères."
                                            },
                                            {
                                                "example_id": "94bb98e7-90a6-4915-a3e6-6cf766a9224f",
                                                "sense_id": "176f3993-6db9-37d4-bade-292933b83b30",
                                                "text": "Il vente très fort, des goélands passent, emportés par la tempête, et essaient vainement de remonter le vent."
                                            },
                                            {
                                                "example_id": "a92402f5-5be8-41ef-adf4-a8d21512df2c",
                                                "sense_id": "176f3993-6db9-37d4-bade-292933b83b30",
                                                "text": "Vainement il cherchait, à la fois, sa clé et son équilibre. Soudain il faillit choir en avant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a55f8aee-d090-484c-b889-3ba17147baf4",
                        "source_entry_id": "eede2dd4-0d0a-39df-b059-daa75c84f792",
                        "target_lang_word": "inutilement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inutilement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                        "entry_id": "eb335352-0374-3444-86de-fdf091289a9f",
                                        "glosses": [
                                            "Sans utilité, d’une manière inutile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b18a0f7-703d-4bcb-b4d1-38bc1925121c",
                                                "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                                "text": "Combien de fois pria-t-il le Sauveur des âmes, en baisant la croix, que son sang répandu pour lui ne le fût pas inutilement !"
                                            },
                                            {
                                                "example_id": "553f3fb7-6937-4ec9-8749-ac82d417aaf7",
                                                "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                                "text": "C’était le sort des Français de vaincre inutilement en Italie ; les journées d’Agnadel, de Fornoue, de Ravenne, de Marignan, de Cérisoles, en sont des témoignages immortels."
                                            },
                                            {
                                                "example_id": "a2ef0bb4-92b5-4768-9831-95da388996c5",
                                                "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                                "text": "Séparé des divisions qui avaient inutilement tenté de le joindre, le général Serrurier désespéra de recevoir du secours."
                                            },
                                            {
                                                "example_id": "1a16cc84-4cca-4ed1-802a-a7b1314a3a08",
                                                "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                                "text": "C’était inutilement que la mer était ouverte aux troupes britanniques, puisque sur toutes les côtes de l’Amérique on se préparait à les repousser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
