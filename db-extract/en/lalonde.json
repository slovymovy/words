                                "target_senses": [
                                    {
                                        "sense_id": "0886364f-f5b9-30f9-89ac-91846c171293",
                                        "entry_id": "1af0ba3d-2b85-33a6-8a52-a44579bb7a83",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "998b3a54-1cbf-46c7-bba7-baa7fa501f3f",
                                                "sense_id": "0886364f-f5b9-30f9-89ac-91846c171293",
                                                "text": "Geneviève Lalonde, revient sur l'année 2020 et sur ces Jeux olympiques qui seront bien différents."
                                            },
                                            {
                                                "example_id": "88b221cd-540d-41b8-9444-cfe6798fe34a",
                                                "sense_id": "0886364f-f5b9-30f9-89ac-91846c171293",
                                                "text": "Au début de la pièce, son personnage craint une défaillance de mémoire en apprenant par cœur le long poème de Michèle Lalonde, Speak White."
                                            },
                                            {
                                                "example_id": "50adcb42-27fc-4687-bd31-c6e2ad65b852",
                                                "sense_id": "0886364f-f5b9-30f9-89ac-91846c171293",
                                                "text": "Dans le cadre des résidences d’artistes proposées par le festival Les Émancipées, le chanteur et ses trois musiciens (Marie Lalonde aux guitares, Marielle Chatain aux claviers et cuivres, Frank M’Bouéké aux percussions) venaient de répéter deux semaines non-stop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
