                            {
                                "example_id": "92013556-576f-497e-8c29-90bf6f359e57",
                                "sense_id": "33578da8-392e-3336-875c-9947666074b0",
                                "text": "Amsterdam is beroemd om zijn amsterdammertjes op de trottoirs."
