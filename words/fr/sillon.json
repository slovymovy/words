{
    "word_family": [
        "sillonner",
        "microsillon"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b7aa7ec-3c15-369c-96c0-5d77f00c3bf2",
                    "sense_definition": "Tranchée ouverte dans la terre par le soc de la charrue pour le labour ou les semailles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tracteur creuse un profond <w>sillon</w> dans la terre humide du champ."
                        },
                        {
                            "text": "Les oiseaux suivent la charrue pour picorer les graines déposées dans chaque <w>sillon</w>."
                        }
                    ],
                    "synonyms": [
                        "raie"
                    ],
                    "common_phrases": [
                        "creuser un sillon",
                        "ouvrir un sillon"
                    ]
                },
                {
                    "sense_id": "4f01c3b7-040a-37dd-a052-3b3e85fb478f",
                    "sense_definition": "Trace visible laissée par un mobile qui se déplace, comme un navire sur l'eau ou un faisceau de lumière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le navire s'éloignait lentement en laissant un long <w>sillon</w> d'écume blanche."
                        },
                        {
                            "text": "Une étoile filante a traversé la nuit en dessinant un mince <w>sillon</w> lumineux."
                        }
                    ],
                    "synonyms": [
                        "sillage",
                        "traînée"
                    ],
                    "common_phrases": [
                        "laisser un sillon",
                        "sillon de lumière"
                    ]
                },
                {
                    "sense_id": "2c2bd772-e992-3c4b-bb2b-b90198feb9bf",
                    "sense_definition": "Fine rainure continue gravée en spirale sur un disque vinyle pour enregistrer et restituer le son.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'aiguille du tourne-disque suit délicatement le <w>sillon</w> du vinyle."
                        },
                        {
                            "text": "La poussière accumulée dans le <w>sillon</w> produit de légers craquements sonores."
                        }
                    ],
                    "synonyms": [
                        "rainure",
                        "strie"
                    ],
                    "common_phrases": [
                        "sillon du disque",
                        "sillon du vinyle"
                    ]
                },
                {
                    "sense_id": "be552408-7647-36a8-83e2-616cf51ce2c9",
                    "sense_definition": "Parcours personnel, méthode ou orientation que l'on se crée de façon assidue et autonome.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "carriere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans se soucier des critiques, ce jeune chercheur continue de tracer son <w>sillon</w>."
                        },
                        {
                            "text": "Cette artiste indépendante a tracé son propre <w>sillon</w> avec beaucoup de patience."
                        }
                    ],
                    "synonyms": [
                        "voie",
                        "chemin"
                    ],
                    "common_phrases": [
                        "tracer son sillon",
                        "creuser son sillon"
                    ]
                },
                {
                    "sense_id": "61c55e2d-e0ad-3929-86c8-bc51f60acd53",
                    "sense_definition": "Ride profonde qui marque la peau, en particulier sur le visage sous l'effet de l'âge ou de la fatigue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie_peau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les années et les soucis ont creusé de profonds <w>sillons</w> sur son front."
                        },
                        {
                            "text": "Le vieux marin souriait, découvrant les nombreux <w>sillons</w> autour de ses yeux."
                        }
                    ],
                    "synonyms": [
                        "ride",
                        "pli"
                    ],
                    "common_phrases": [
                        "creuser des sillons"
                    ]
                },
                {
                    "sense_id": "40e31db1-a089-31f0-8e5f-7a2622083673",
                    "sense_definition": "Dépression linéaire ou repli naturel à la surface d'un organe ou d'une partie du corps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin examine avec attention chaque <w>sillon</w> situé à la surface du cortex cérébral."
                        },
                        {
                            "text": "Plusieurs <w>sillons</w> naturels séparent nettement les lobes de cet organe interne."
                        }
                    ],
                    "synonyms": [
                        "scissure",
                        "fissure"
                    ],
                    "common_phrases": [
                        "sillon cérébral"
                    ]
                },
                {
                    "sense_id": "df397515-3531-3516-ac2d-5bff00bc8c76",
                    "sense_definition": "Créneau horaire attribué à une entreprise ferroviaire pour faire circuler un train sur le réseau ferré.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette compagnie ferroviaire a réservé un nouveau <w>sillon</w> pour ses convois de marchandises."
                        },
                        {
                            "text": "La saturation des voies ferrées empêche d'accorder un <w>sillon</w> supplémentaire en heure de pointe."
                        }
                    ],
                    "synonyms": [
                        "créneau"
                    ],
                    "common_phrases": [
                        "sillon horaire",
                        "attribuer un sillon"
                    ]
                }
            ]
        }
    ]
}