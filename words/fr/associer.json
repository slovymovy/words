            "senses": [
                {
                    "sense_id": "15c9298d-db24-3795-b6ee-38d0402002ca",
                    "sense_definition": "Mettre ensemble, combiner ou faire participer des personnes ou des choses.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "combinaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette recette simple <w>associe</w> des saveurs sucrées et salées avec beaucoup d'équilibre."
                        },
                        {
                            "text": "Le chercheur <w>associe</w> les étudiants à ses travaux scientifiques récents."
                        }
                    ],
                    "synonyms": [
                        "combiner",
                        "joindre",
                        "unir",
                        "lier"
                    ],
                    "antonyms": [
                        "dissocier",
                        "séparer"
                    ],
                    "common_phrases": [
