        "fr-extract.jsonl": [
            {
                "entry_id": "8d57396a-6a1c-30ef-8646-416afe2022b8",
                "word": "nuitamment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1306be77-5cf9-32ca-a341-9b089e28403c",
                        "entry_id": "8d57396a-6a1c-30ef-8646-416afe2022b8",
                        "glosses": [
                            "De nuit ; durant la nuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d33971d-fd93-49f9-add4-9f16828392c7",
                                "sense_id": "1306be77-5cf9-32ca-a341-9b089e28403c",
                                "text": "Ainsi parfois il parcourait nuitamment les rues et heurtait aux portes des maisons."
                            },
                            {
                                "example_id": "1a17849e-1e0c-422f-a337-9d6cd4a43fa5",
                                "sense_id": "1306be77-5cf9-32ca-a341-9b089e28403c",
                                "text": "Comme ils descendaient nuitamment le Rhin, Othon, qui savait dans quelle intention on l’emmenait, avait choisi le moment où tout l’équipage était occupé à diriger la barque dans un courant rapide, s’était élancé au plus profond du fleuve et avait disparu."
                            },
                            {
                                "example_id": "4f39a30d-754b-4f46-9104-5cf001451cd0",
                                "sense_id": "1306be77-5cf9-32ca-a341-9b089e28403c",
                                "text": "— La belle affaire ! En vérité, n'êtes-vous pas un couple qui tribadez sous notre toit et jouez nuitamment de la fricarelle en vous fourrant le museau dans vos parties vergogneuses ?"
                            },
                            {
                                "example_id": "8cea6c13-c26b-44fe-b293-cea72d1b045f",
                                "sense_id": "1306be77-5cf9-32ca-a341-9b089e28403c",
                                "text": "Le missionnaire John Allen Chau est parvenu, en voyageant nuitamment, à échapper à sa surveillance. Pas à celle des habitants de l’île."
                            },
                            {
                                "example_id": "f8afc9fe-d07d-49b6-9787-240a94427456",
                                "sense_id": "1306be77-5cf9-32ca-a341-9b089e28403c",
                                "text": "Le Démon se manifeste nuitamment, profitant du sommeil de notre raison pour nous souffler des comportements contre nature. L’insomnie est donc un remède souverain contre lui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b38a1d95-ef15-4030-915b-6fa4aa683d88",
                        "source_entry_id": "8d57396a-6a1c-30ef-8646-416afe2022b8",
                        "source_sense_id": "1306be77-5cf9-32ca-a341-9b089e28403c",
                        "source_sense_description": "de nuit",
                        "target_lang_word": "nachtsüber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachtsüber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d15ee75a-faf4-3ef9-9fe8-7b81f5c261ed",
                                        "entry_id": "1d45fa85-3d36-31c5-86a8-4e3a3b8d0cc8",
                                        "glosses": [
                                            "während der Nacht; im Verlauf der Nacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77573210-8159-4abb-9038-419fb81415ca",
                                                "sense_id": "d15ee75a-faf4-3ef9-9fe8-7b81f5c261ed",
                                                "text": "„Erst auf dieser Grundlage seien Aussagen über mögliche Belastungen der Wohngebiete tags- und nachtsüber möglich.“"
                                            },
                                            {
                                                "example_id": "304f4aab-4909-4f54-81eb-43659627fa80",
                                                "sense_id": "d15ee75a-faf4-3ef9-9fe8-7b81f5c261ed",
                                                "text": "„In den Wintermonaten halten auch Tagesheime nachtsüber geöffnet, die Kapazität reicht dann für etwa 1200 Personen.“"
                                            },
                                            {
                                                "example_id": "98a250dc-caa1-4d59-b58c-66272fe04f7e",
                                                "sense_id": "d15ee75a-faf4-3ef9-9fe8-7b81f5c261ed",
                                                "text": "„In der ganzen Schweiz sind Einrichtungen bewilligungspflichtig, die «mehrere Unmündige zur Erziehung, Betreuung, Ausbildung, Beobachtung oder Behandlung tags- und nachtsüber» aufnehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f30e659e-88b9-4191-ae41-6ac80c0a2195",
                        "source_entry_id": "8d57396a-6a1c-30ef-8646-416afe2022b8",
                        "source_sense_id": "1306be77-5cf9-32ca-a341-9b089e28403c",
