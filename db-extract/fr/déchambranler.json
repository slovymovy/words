                "senses": [
                    {
                        "sense_id": "ad527d97-7180-3b86-9d72-4a7c41efbcda",
                        "entry_id": "ead4b4a5-f4d3-32e8-8df6-c2abedca3c2b",
                        "glosses": [
                            "Défaire le chambranle de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edc7d451-bd8f-4f6c-9285-4f3919a03c4f",
                                "sense_id": "ad527d97-7180-3b86-9d72-4a7c41efbcda",
                                "text": "Maître Lolo Rosaire Dubois Lajoie Lapaix visionnait les différentes séquences de sa prochaine rencontre avec le grand patron des tempêtes coloniales, le roi des cyclones caraïbes, dont la présence tellurique allait devoir déchambranler l’île Mascarogne de fond en comble."
                            },
                            {
                                "example_id": "2ca087d8-096a-4d4b-8a02-417bdf516a4e",
                                "sense_id": "ad527d97-7180-3b86-9d72-4a7c41efbcda",
                                "text": "Je m’embalconne, me débalconne, me déchambranle de visions obsessives. Je m’arabesque et m’encouleuvre de fantasmagories."
                            }
                        ]
                    }
                ],
