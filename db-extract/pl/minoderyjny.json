                "senses": [
                    {
                        "sense_id": "fb86e69e-c4c1-3eaa-b359-7ad62dae0910",
                        "entry_id": "97f23fc6-e1bc-3d3a-abd8-a3e8aa6c102a",
                        "glosses": [
                            "wdzięczący się, często aby się komuś przypodobać; świadczący o takim zachowaniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fd770a3-ad8a-43e4-84e3-982e852c54ce",
                                "sense_id": "fb86e69e-c4c1-3eaa-b359-7ad62dae0910",
                                "text": "Każdy jest trochę minoderyjny. Inteligentna osoba potrafi się tym posługiwać. Przodują w tym panie. Ja minoderią gardzę i ją tępię"
                            },
                            {
                                "example_id": "5fff4445-3d22-4fee-a8fd-f56629a9aeb8",
                                "sense_id": "fb86e69e-c4c1-3eaa-b359-7ad62dae0910",
                                "text": "Wyznanie takie zakrawa na wyznanie niewiary w siebie lub może minoderyjny wstęp pokornisia, który chce sobie stworzyć alibi dla własnego lenistwa myślowego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
