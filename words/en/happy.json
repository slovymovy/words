                },
                {
                    "sense_id": "733ca463-dc85-36ab-b948-9927c473f9ce",
                    "sense_definition": "Willing or satisfied to do something; having no objections.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "willingness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>happy</w> to help you with your homework if you are confused.",
                            "target_lang_translations": {
                                "ru": "Я буду <w>рад</w> помочь тебе с домашним заданием, если ты запутался."
                            }
