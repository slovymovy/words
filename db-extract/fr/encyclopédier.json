                ],
                "senses": [
                    {
                        "sense_id": "f5e8407a-0106-3fab-8611-51348575c9e3",
                        "entry_id": "03b2ff3e-f9c5-39b8-a988-aa6c47e0e87d",
                        "glosses": [
                            "Donner une forme encyclopédique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc37c40-4dc0-430e-9310-49f2fb7683a7",
                                "sense_id": "f5e8407a-0106-3fab-8611-51348575c9e3",
                                "text": "On voyait ce pauvre M. Havet qui ne songeait qu’à bien faire toute sa vie son cours de littérature latine sans songer à encyclopédier ses idées, ni à se philosophier sur divers systèmes."
                            },
                            {
                                "example_id": "1af9120f-15ef-4c29-97f1-1b6ee60b6c8e",
                                "sense_id": "f5e8407a-0106-3fab-8611-51348575c9e3",
                                "text": "À l’un de ses aspects, bien sûr — il ne saurait être question d’analyser ici ces quarante mille vers : celui du geste encyclopédique qu’il met en scène, qui consiste à encyclopédier, pour reprendre la plaisant néologisme de Barrés, le savoir entier sous la houlette de Renart, à décrire, sous la férule renardienne, le «cercle entier des connaissances»."
                            },
                            {
                                "example_id": "439e71e9-9b74-483c-9b2a-44705a32faef",
                                "sense_id": "f5e8407a-0106-3fab-8611-51348575c9e3",
                                "text": "Est-il possible d’encyclopédier le balisage?"
                            }
                        ]
                    }
                ],
