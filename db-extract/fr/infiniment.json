                            {
                                "example_id": "691ce14b-46f6-42d9-a325-eec869081297",
                                "sense_id": "36cd65ed-3be5-3862-b482-9773d907790d",
                                "text": "Imaginons un espace infiniment grand.",
                                "translation": "Wyobraźmy sobie przestrzeń nieskończenie wielką."
                            },
                            {
                                "example_id": "d6a6016c-f1f4-42de-9296-9f600619b94e",
                                "sense_id": "36cd65ed-3be5-3862-b482-9773d907790d",
                                "text": "Je vous suis infiniment reconnaissant.",
                                "translation": "Jestem panu niezmiernie wdzięczny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3e5b742e-cbdf-358c-9f45-f9b0d02abc7d",
