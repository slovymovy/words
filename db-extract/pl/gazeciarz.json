                        "glosses": [
                            "człowiek, który sprzedaje lub dostarcza gazety"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "12e4a3fd-647f-373e-bc84-3d7d30a29b85",
                        "entry_id": "e8984cd3-dfaf-316a-ada6-f3afa821f61f",
                        "glosses": [
                            "dziennikarz, reporter"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3e35d639-80dd-4dc1-83dc-93f8f953de83",
                                "sense_id": "12e4a3fd-647f-373e-bc84-3d7d30a29b85",
                                "text": "Nieszczęsny sprawozdawca, pochwycony w Pesaro, został dostarczony do Rzymu, gdzie po ekskomunice i pozbawieniu godności duchownych odrąbano mu dłoń, wydarto język i wreszcie powieszono na Moście Anioła z przypiętym napisem „fałszywy gazeciarz”."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5140db77-1d69-438c-9123-8a8953022b53",
                        "source_entry_id": "e8984cd3-dfaf-316a-ada6-f3afa821f61f",
                        "source_sense_id": "621aca6d-9024-3c24-b949-934e1f8f5afd",
                        "target_lang_word": "Zeitungsverkäufer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeitungsverkäufer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66f1fff0-ed33-3545-be44-e9483c1b552d",
                                        "entry_id": "ec442768-fba9-3973-848a-3103347dd775",
                                        "glosses": [
                                            "Verkäufer von Zeitungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36731486-6a99-4a34-895c-a6fe0c1aea93",
                                                "sense_id": "66f1fff0-ed33-3545-be44-e9483c1b552d",
                                                "text": "„Im ganzen Land haben sie sich organisiert, die Zeitungsverkäufer und die Hausmädchen, die Minenkinder und die Autowäscher, die kleinen Schuhputzer und die minderjährigen Maurer.“"
                                            },
                                            {
                                                "example_id": "ae192b9b-0745-4d73-9064-ff76acf1cecf",
                                                "sense_id": "66f1fff0-ed33-3545-be44-e9483c1b552d",
                                                "text": "„Der Zeitungsverkäufer Kunowski, der Fifi von seinem Platz innerhalb des Kiosks nicht sehen konnte, mußte einen sechsten Sinn haben.“"
                                            },
                                            {
                                                "example_id": "ec02bb10-1f4e-4020-a4b7-c79f81fe58b6",
                                                "sense_id": "66f1fff0-ed33-3545-be44-e9483c1b552d",
                                                "text": "„Hier war nur Ruhe, was auch für Unglücksbotschaften nachher die letzten Zeitungsverkäufer krächzen mochten, sobald wir die Cannebière betraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cd4588d-b62c-42f0-9ac0-486b1c8d0914",
                        "source_entry_id": "e8984cd3-dfaf-316a-ada6-f3afa821f61f",
