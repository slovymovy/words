                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5d6a88b-9db0-4995-a527-76f196bbe340",
                                                "sense_id": "9cd85f3e-cede-3567-94d5-9e78b15995fc",
                                                "text": "Bramka w piątej minucie meczu padła z główki lewego pomocnika."
                                            }
                                        ],
                                        "sense_index_json": "\"1.7\""
                                    },
                                    {
