                        ],
                        "examples": [
                            {
                                "example_id": "e8be6209-9c2f-4035-bc27-932ea8aa1f63",
                                "sense_id": "b70766f0-386c-38d7-ae4b-897b203288a5",
                                "text": "Jest jednym z niewielu wykonawców cenionych zarówno przez hiphopowców jak i fanów reggae, i dancehallu, a przy tym jedną z najbardziej pozytywnych postaci na polskiej scenie muzycznej",
                                "translation": "He is one of the few artists appreciated by both hip-hoppers and fans of reggae and dancehall, and at the same time one of the most positive figures on the Polish music scene.",
                                "english": "He is one of the few artists appreciated by both hip-hoppers and fans of reggae and dancehall, and at the same time one of the most positive figures on the Polish music scene."
                            }
                        ]
                    },
