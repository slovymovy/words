                            {
                                "example_id": "0ba96907-248d-484b-b351-33bf2f5e356d",
                                "sense_id": "3d47b7d4-d3d8-3065-a3c4-48aa383d6d48",
                                "text": "La diversité des hadrosaures diminuait en Amérique du Nord, peut-être à cause de la formation de la mer intérieure du Crétacé et de montagnes, mais pas en Asie."
                            },
                            {
                                "example_id": "22ff8b66-f327-4e92-9dd6-2c3126420168",
                                "sense_id": "3d47b7d4-d3d8-3065-a3c4-48aa383d6d48",
                                "text": "À la suite des analyses, il est vite apparu qu’il s’agissait d’une nouvelle espèce d’hadrosaures appartenant au groupe des lambeosaurinés."
                            }
                        ]
