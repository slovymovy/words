                        "entry_id": "4acef69e-05f7-356c-abc1-9e15f4dbb244",
                        "glosses": [
                            "A member of a Pentecostal church."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a77f051a-a57b-48dc-bb2b-d36dbe0ce330",
                                "sense_id": "5c84c425-edcf-3739-b8d0-4151e83496bb",
                                "text": "The Pentecostals had drowned them with their discotheque music, frenzied dancing and ecstatic prayer."
                            }
                        ]
                    },
                    {
                        "sense_id": "0abdde37-b34c-30bd-9262-6cea59a81219",
