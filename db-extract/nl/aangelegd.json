                        ],
                        "examples": [
                            {
                                "example_id": "b435104d-3f99-49a8-bb58-2423db6297e8",
                                "sense_id": "4c0d7607-2940-3797-bed5-b5fa331a3123",
                                "text": "Mijn Jos die zichzelf bevrijdt van banden die ik heb aangelegd."
                            },
                            {
                                "example_id": "4c041821-5621-4cee-a436-ad1815e0f7c5",
                                "sense_id": "4c0d7607-2940-3797-bed5-b5fa331a3123",
                                "text": "'Waar ken je haar van?' vraagt Rachid. Zijn stem klinkt nu minder bezorgd. Slaoui hoort kastdeuren opengaan en dichtslaan, hij hoort het servies, hij ziet een openstaande glazen deur waardoorheen een tafel te zien is met daaraan: vrouw en kinderen omringd door prachtig groen, aangelegd tussen de zorgvuldig geplaatste muren die het huis, dit kleine paradijs, beschermen tegen de woestijn."
                            }
                        ]
                    }
                ],
