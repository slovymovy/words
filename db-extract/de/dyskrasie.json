                                        "entry_id": "04a05c36-b414-3637-9051-0f93acf5cb9d",
                                        "glosses": [
                                            "Mauvaise constitution ou mauvaise circulation des liquides corporels et organiques."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc3039a4-aca4-4c05-957e-11c4bdb63bc3",
                                                "sense_id": "6a5af4c1-4146-3501-90cf-ee23bc291910",
                                                "text": "Il faudrait rechercher si les globules rouges présentent cette tendance à se désempiler et à perdre leur forme, ce défaut de cohésion, qu’on a signalé dans d’autres dyscrasies, le scorbut notamment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56e27234-8bf0-334e-abf5-4754916d6d1c",
                                        "entry_id": "04a05c36-b414-3637-9051-0f93acf5cb9d",
                                        "glosses": [
                                            "Perturbation de la crase sanguine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4987e05e-5501-4017-b4a1-6407d30e4f95",
                                                "sense_id": "56e27234-8bf0-334e-abf5-4754916d6d1c",
                                                "text": "C’est le foie qui, dans l’état d’insuffisance antitoxique, provoquerait la dyscrasie sanguine par l’antithrombine qu’elle sécrète."
                                            }
                                        ]
                                    }
                                ]
