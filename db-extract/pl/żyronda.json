                "senses": [
                    {
                        "sense_id": "959be3a7-5db6-39b8-8903-1a03f043b9fe",
                        "entry_id": "e5a80443-0eb9-353f-bae2-e1805a93ac40",
                        "glosses": [
                            "ujście Dordogne i Garonny do Zatoki Biskajskiej"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d908fcc8-0e92-3535-b49f-de9a0b5f91b3",
                        "entry_id": "e5a80443-0eb9-353f-bae2-e1805a93ac40",
