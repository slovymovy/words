                        "entry_id": "2d3360fe-b51d-31f7-a95c-caf1f36fedc8",
                        "glosses": [
                            "Myristica fragrans een specerij bestaande uit het omhulsel van de muskaatnoot"
                        ],
                        "tags": [
                            "specerij"
                        ],
                        "examples": [
                            {
                                "example_id": "b6aea0b6-48d1-4c44-8d9c-aa8e537825de",
                                "sense_id": "8d84d754-5155-3857-aa67-8c54e91adeab",
                                "text": "In Zeeland doet men vaak wat foelie in de kippensoep."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d68733c-729c-3916-b7f9-bc865641d6cc",
                        "entry_id": "2d3360fe-b51d-31f7-a95c-caf1f36fedc8",
                        "glosses": [
                            "folie"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4940a9f-9005-4a2b-9966-f6f045e00589",
                        "source_entry_id": "2d3360fe-b51d-31f7-a95c-caf1f36fedc8",
                        "source_sense_id": "8d84d754-5155-3857-aa67-8c54e91adeab",
                        "source_sense_description": "Myristica fragrans",
                        "target_lang_word": "Macis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Macis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                        "entry_id": "0ea97921-67bf-3bcc-b9af-68aaf9bb55db",
                                        "glosses": [
                                            "getrockneter Samenmantel des Muskatnussbaumes (umschließt die Muskatnuss), die als Küchengewürz und Arzneidroge verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b30763-ea2c-471a-ae06-c5ec4e9cda63",
                                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                                "text": "„In erster Linie finden die Nüsse und die Macis Verwendung als Gewürz.“"
                                            },
                                            {
                                                "example_id": "e0688032-5248-46e7-8c37-0a3bd28e78ba",
                                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                                "text": "„Was den Geschmack betrifft, wurde die Macis höher eingeschätzt als die Muskatnuß, eine Tatsache, die sich auch im Preis niederschlug.“"
                                            },
                                            {
                                                "example_id": "34382d03-d4f9-4bd4-a64a-d751c5dcfa46",
                                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                                "text": "„Getrocknet ist die Macis blassgelb, man kauft sie am besten schon fertig gemahlen.“"
                                            },
                                            {
                                                "example_id": "26e6fa6a-ed74-499f-9665-fc5832976c93",
                                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                                "text": "„1778 erfolgte die erste Ernte auf Mauritius. Seitdem ist die Macis aus der Parfüm-, Seifen- und Salbenherstellung sowie der Wurstzubereitung und natürlich dem Kartoffelbrei nicht mehr wegzudenken“."
                                            },
                                            {
                                                "example_id": "caa8ad7a-554d-488e-a05e-f0f4d63c6615",
                                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                                "text": "„Wie die eigentlichen Macis oder Muskatnüsse späterhin so hoch im Preise stiegen, suchte man sie wieder hervor.“"
                                            },
                                            {
                                                "example_id": "ac448808-f65b-4df1-931c-caa49690d4d0",
                                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                                "text": "„Die Macis werden nach vorsichtigem Ablösen aus der Frucht einzeln zusammengedrückt und nach dem Trocknen in Kisten von 140 kg verpackt.“"
                                            },
                                            {
                                                "example_id": "e33b8f83-de55-4903-a4a1-d9dfda2079cc",
                                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                                "text": "„Besonders die Macis ist mancherlei Fälschungen unterworfen.“"
                                            },
                                            {
                                                "example_id": "d5736d0d-6fce-40b1-8115-b075b6facd23",
                                                "sense_id": "225ce5bf-7baa-3d2f-8424-fec88a61d2bc",
                                                "text": "„Macis ist hinsichtlich des Geschmacks die feinere Schwester der bekannten Muskatnuss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "feb326cf-42bb-4ab1-bfa6-a1e3336a94c1",
                        "source_entry_id": "2d3360fe-b51d-31f7-a95c-caf1f36fedc8",
                        "source_sense_id": "8d84d754-5155-3857-aa67-8c54e91adeab",
                        "source_sense_description": "Myristica fragrans",
                        "target_lang_word": "mace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f2abc49-1f9c-32e3-8101-7794df5b7f7a",
                                        "entry_id": "1cacb8ae-c7e3-3b25-a5f1-de6b036706b5",
                                        "glosses": [
                                            "A heavy fighting club."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db27662-9921-4e7e-83aa-f5e75679f6d1",
                                                "sense_id": "0f2abc49-1f9c-32e3-8101-7794df5b7f7a",
                                                "text": "The Mace is an ancient weapon, formerly much used by cavalry of all nations, and likewise by ecclesiastics, who in consequence of their tenures, frequently took the field, but were by a canon of the church forbidden to wield the sword."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fae49fcd-f8b7-354a-8057-b17710a8afc0",
                                        "entry_id": "1cacb8ae-c7e3-3b25-a5f1-de6b036706b5",
                                        "glosses": [
                                            "A ceremonial form of this weapon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e58bc7ab-a22a-4f93-996c-0923bdf6a43d",
                                                "sense_id": "fae49fcd-f8b7-354a-8057-b17710a8afc0",
                                                "text": "I am a king that find thee; and I know 'Tis not the balm, the sceptre, and the ball, The sword, the mace, the crown imperial, The intertissued robe of gold and pearl"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f683a241-ec30-3150-b5ec-bdcc6e62b154",
                                        "entry_id": "1cacb8ae-c7e3-3b25-a5f1-de6b036706b5",
                                        "glosses": [
                                            "A long baton used by some drum majors to keep time and lead a marching band. If this baton is referred to as a mace, by convention it has a ceremonial often decorative head, which, if of metal, usually is hollow and sometimes intricately worked."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0a86266-f369-3a2d-8dd7-0b68095ad170",
                                        "entry_id": "1cacb8ae-c7e3-3b25-a5f1-de6b036706b5",
                                        "glosses": [
                                            "An officer who carries a mace as a token of authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e84502-7dda-46bd-8e94-d1742a7f1096",
                                                "sense_id": "f0a86266-f369-3a2d-8dd7-0b68095ad170",
                                                "text": "On the left were the Commons with their Speaker, attended by the mace. The southern door opened: and the Prince and Princess of Orange, side by side, entered, and took their place under the canopy of state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8511883-b1d0-3c52-8b38-38a1fcaa4ddc",
                                        "entry_id": "1cacb8ae-c7e3-3b25-a5f1-de6b036706b5",
                                        "glosses": [
                                            "A knobbed mallet used by curriers to make leather supple when dressing it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71ee7734-5c9a-4490-8cad-c0a23eddbc63",
                                                "sense_id": "c8511883-b1d0-3c52-8b38-38a1fcaa4ddc",
                                                "text": "In the foreground one man uses the \"head knife” to work over the skin on the beam, while another softens a skin with the currier's mace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cfae0c8-342e-3242-867e-f62ab50dfa25",
                                        "entry_id": "1cacb8ae-c7e3-3b25-a5f1-de6b036706b5",
                                        "glosses": [
                                            "A billiard cue."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc7650b8-b14e-3fcd-94be-418c9c59f402",
                                        "entry_id": "fe35e368-745d-333a-9579-6b25a8fc6f2a",
                                        "glosses": [
                                            "To hit someone or something with a mace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a857a7d-b788-3528-806f-04f18c4da948",
                                        "entry_id": "44b2af8d-5466-33af-a91e-2718820fe3c6",
                                        "glosses": [
                                            "A spice obtained from the outer layer of the kernel of the fruit of the nutmeg."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca432355-d289-4eb0-a04b-c73eda66c5d2",
                                                "sense_id": "6a857a7d-b788-3528-806f-04f18c4da948",
                                                "text": "I must have saffron to color the warden pies; mace; dates, none -- that's out of my note; nutmegs, seven; a race or two of ginger, but that I may beg; four pounds of prunes, and as many of raisins o' th' sun."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f329b66-e8e6-3178-abca-05462ed4bd7d",
                                        "entry_id": "84dfd451-6e9b-33a7-b759-6b112bd1ac8a",
                                        "glosses": [
                                            "Tear gas or pepper spray, especially for personal use."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c700a10c-4277-4ec0-8e51-2ca81709289b",
                                                "sense_id": "0f329b66-e8e6-3178-abca-05462ed4bd7d",
                                                "text": "[…] was sentenced on Friday to 10 years in prison for shooting a man in the eye with a paintball gun, spraying people in the face with bear mace and aiming a loaded handgun at a crowd, prosecutors said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "071d73c7-054a-3e95-9350-275bddd36ea0",
                                        "entry_id": "35c40228-0f05-3ae5-9ff1-329df5d4b99c",
                                        "glosses": [
                                            "To spray in defense or attack with mace (pepper spray or tear gas) using a hand-held device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a95006c-456a-332c-9dd3-2452eb9a78f3",
                                        "entry_id": "35c40228-0f05-3ae5-9ff1-329df5d4b99c",
                                        "glosses": [
                                            "To spray a similar noxious chemical in defense or attack using an available hand-held device such as an aerosol spray can."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a16b64c5-135d-4301-a141-86215893aff4",
                                                "sense_id": "9a95006c-456a-332c-9dd3-2452eb9a78f3",
                                                "text": "When Reynaldo and Willie had burst into Larkey's drug store to confront him, the old man had maced Willie square in the eyes with an aerosol can of spermicidal birth-control foam."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
