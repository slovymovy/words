                ],
                "senses": [
                    {
                        "sense_id": "2d380029-2e1b-37ea-8fbc-b16a9c070391",
                        "entry_id": "1c6adb44-76bf-3c3a-9f86-a1e39e9eb17f",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "083e6dc6-e993-493a-a334-340755a42ae2",
                                "sense_id": "2d380029-2e1b-37ea-8fbc-b16a9c070391",
                                "text": "Frau Hitzl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9c4c745f-1505-4386-8c61-58c213369b34",
                                "sense_id": "2d380029-2e1b-37ea-8fbc-b16a9c070391",
                                "text": "Herr Hitzl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4e2519f7-5aca-40b3-889d-a9d60c2b21f5",
                                "sense_id": "2d380029-2e1b-37ea-8fbc-b16a9c070391",
                                "text": "Die Hitzls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bddeb7e9-da81-4e7d-a463-898a9a77fb92",
                                "sense_id": "2d380029-2e1b-37ea-8fbc-b16a9c070391",
                                "text": "Der Hitzl trägt nie die Schals, die die Hitzl ihm strickt."
                            },
                            {
                                "example_id": "933baa2c-f05b-4d1c-817a-d264c33e0569",
                                "sense_id": "2d380029-2e1b-37ea-8fbc-b16a9c070391",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hitzl kommt, geht der Herr Hitzl.“"
                            },
                            {
                                "example_id": "6e3134cc-222a-4ba4-b1eb-703504eb7bdd",
                                "sense_id": "2d380029-2e1b-37ea-8fbc-b16a9c070391",
                                "text": "Hitzl kommt und geht."
                            },
                            {
                                "example_id": "7aad7174-eb22-456d-9744-f49cc5e39e49",
                                "sense_id": "2d380029-2e1b-37ea-8fbc-b16a9c070391",
                                "text": "Hitzls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
