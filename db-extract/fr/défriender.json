                        "sense_id": "6a1c8f0b-3d77-31d6-a721-485dbbde3273",
                        "entry_id": "0fbcb04d-fcc1-301d-851c-70640bd575e3",
                        "glosses": [
                            "Retirer de la liste de ses amis, sur un réseau social."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e1e9623-4fc9-4549-a123-83fdc3e5eea8",
                                "sense_id": "6a1c8f0b-3d77-31d6-a721-485dbbde3273",
                                "text": "Vous annulez tout, de toute façon vous n’avez plus d'amies, elles vous ont toutes « défriendée » sur FB."
                            },
                            {
                                "example_id": "e3c4fc43-8a41-4d9a-a7bc-621ab889f3be",
                                "sense_id": "6a1c8f0b-3d77-31d6-a721-485dbbde3273",
                                "text": "J’ai quand même défriendé le mec."
                            },
                            {
                                "example_id": "0d24bd66-7c54-486e-a0c8-67475154e542",
                                "sense_id": "6a1c8f0b-3d77-31d6-a721-485dbbde3273",
                                "text": "Et sur ce Jack défriende son père."
                            }
                        ]
                    }
