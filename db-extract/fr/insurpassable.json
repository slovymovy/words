                ],
                "senses": [
                    {
                        "sense_id": "92f115b4-cf84-35e9-9e04-6f0c93018f70",
                        "entry_id": "12548d12-7ecf-3fba-86de-0df4d735c3ed",
                        "glosses": [
                            "Qui ne peut pas être surpassé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef14122-8621-4c8c-94d4-a86ca322554e",
                                "sense_id": "92f115b4-cf84-35e9-9e04-6f0c93018f70",
                                "text": "La Salle de marbre est garnie de grands tableaux. L’aile à la droite renferme le tresor insurpassable de l’ecole italienne."
                            },
                            {
                                "example_id": "1f6f3ea8-f296-4e60-a0e3-dd470d3afc94",
                                "sense_id": "92f115b4-cf84-35e9-9e04-6f0c93018f70",
                                "text": "Cela serait la situation la plus lointaine qu’il serait capable d’imaginer, et qui impliquerait une satisfaction insurpassable, le contentement de tous ses désirs."
                            },
                            {
                                "example_id": "643d2abf-4589-41bd-8984-f2a1e68efae0",
                                "sense_id": "92f115b4-cf84-35e9-9e04-6f0c93018f70",
                                "text": "[…] en vérité, sa grâce était aussi insurpassable que ma propre difformité."
                            },
                            {
                                "example_id": "aadadf52-1428-499d-84e5-4dc2b4e7168b",
                                "sense_id": "92f115b4-cf84-35e9-9e04-6f0c93018f70",
                                "text": "Le Christ est l’accomplissement insurpassable des Écritures."
                            },
                            {
                                "example_id": "f27b16a0-9423-4e97-8c29-2b3c919c1513",
                                "sense_id": "92f115b4-cf84-35e9-9e04-6f0c93018f70",
                                "text": "Votre serviteur, quant à lui, consacrera sa conférence à l’analyse du clivage nationalistes/mondialistes, que certains croient désormais insurpassable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cb8516d-eb63-4c32-a383-091efdbac306",
                        "source_entry_id": "12548d12-7ecf-3fba-86de-0df4d735c3ed",
                        "source_sense_id": "92f115b4-cf84-35e9-9e04-6f0c93018f70",
                        "target_lang_word": "unübertrefflich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unübertrefflich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa80ecdb-55e6-31f0-9f21-c46bbf5928a8",
                                        "entry_id": "430f4c3c-9e7b-3e35-8186-9138119f87ef",
                                        "glosses": [
                                            "so beschaffen, dass es besser nicht möglich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f8b1a1-b8c0-4062-a967-0e678f87b180",
                                                "sense_id": "fa80ecdb-55e6-31f0-9f21-c46bbf5928a8",
                                                "text": "Musikalische Abgründe gibt es an diesem Abend nicht – aber eine Intensität und Intimität, eine feierliche Melancholie, die unübertrefflich ist."
                                            },
                                            {
                                                "example_id": "d18ebe6b-b5dd-493d-8695-7335c084bc1d",
                                                "sense_id": "fa80ecdb-55e6-31f0-9f21-c46bbf5928a8",
                                                "text": "Die interne Hierarchie drückte sich mit unübertrefflicher Genauigkeit im Lohngefälle aus, und das Realeinkommen entschied wiederum über den Lebensstandard."
                                            },
                                            {
                                                "example_id": "df542163-16d7-434e-9595-754889761b99",
                                                "sense_id": "fa80ecdb-55e6-31f0-9f21-c46bbf5928a8",
                                                "text": "Der Lehrer: Wie viel ist 1 und 1? – Der Schüler: 2. – Der Lehrer: Gut. – Der Schüler: Was heißt hier gut, das ist unübertrefflich!"
                                            },
                                            {
                                                "example_id": "345ee2b4-9e92-4fd9-b89a-28d8e60839d4",
                                                "sense_id": "fa80ecdb-55e6-31f0-9f21-c46bbf5928a8",
                                                "text": "Das Eis der neuen Eisdiele ist einfach unübertrefflich!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
