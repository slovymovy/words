                        "examples": [
                            {
                                "example_id": "52406680-0294-4d25-8917-5f24ec9637a8",
                                "sense_id": "168c6365-5631-3f81-9aa1-879b7f715489",
                                "text": "Les mains mortes servent d'engrais à une respiration qui est irriguée par l’expectoriation de la pipe. Tous les jours je regarde ce thorax, poumons détruits, à côté d'un portrait d’Orson Welles jeune dessiné à l'époque d'Othello."
                            },
                            {
                                "example_id": "1c9c2db6-99ac-4900-9d47-31bfa50a1ff1",
                                "sense_id": "168c6365-5631-3f81-9aa1-879b7f715489",
                                "text": "Le résultat se traduit par une défervescence incomplète mais assez nette de la température (37,5°), mais peux d'action sur l’expectoriation qui demeure muco-purulente ."
                            }
                        ]
