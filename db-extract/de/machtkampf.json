                "senses": [
                    {
                        "sense_id": "97df33fd-ea28-3ad7-aac1-279e097cb688",
                        "entry_id": "42e2f9ae-464e-3204-a7df-5cf21f3e70d9",
                        "glosses": [
                            "Auseinandersetzung zwischen zwei oder mehreren Beteiligten zur Erlangung einer Vorherrschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b8d7c3-5c3c-41ed-8fb5-badb89b49be0",
                                "sense_id": "97df33fd-ea28-3ad7-aac1-279e097cb688",
                                "text": "Im innerpolitischen Machtkampf zeichnete sich ein Sieg für das demokratische Lager ab."
                            },
                            {
                                "example_id": "d44959dc-aae2-4223-8290-9f1a105225b7",
                                "sense_id": "97df33fd-ea28-3ad7-aac1-279e097cb688",
                                "text": "„Ist der Machtkampf zwischen der Politik und den Internetkonzernen also schon entschieden, bevor er überhaupt begonnen hat?“"
                            },
                            {
                                "example_id": "93b69272-6315-462a-a35f-d634a8b587e8",
                                "sense_id": "97df33fd-ea28-3ad7-aac1-279e097cb688",
                                "text": "„Dann, so um 1200, nach einem langen Machtkampf, zwingt eine einzige Dynastie nahezu die ganze Region unter ihre Herrschaft.“"
                            },
                            {
                                "example_id": "448e55b2-f292-414a-8b90-1fbed6d53608",
                                "sense_id": "97df33fd-ea28-3ad7-aac1-279e097cb688",
                                "text": "„Unterdessen kommt es weiterhin zu Machtkämpfen der lokalen Fürsten untereinander.“"
                            },
                            {
                                "example_id": "9b08b7e8-fe83-4b3c-bbbf-2ddc4e15505b",
                                "sense_id": "97df33fd-ea28-3ad7-aac1-279e097cb688",
                                "text": "„Sie kämpfte nicht, und genau das wurde zu einem Machtkampf.“"
                            },
                            {
                                "example_id": "08a0fdc7-7c8d-4f74-81f2-e80aae3aaefa",
                                "sense_id": "97df33fd-ea28-3ad7-aac1-279e097cb688",
                                "text": "„In Nordrhodesien kam es zu einem Machtkampf zwischen dem als gemäßigt geltenden Harry Nkumbula und seinem jüngeren Rivalen Kenneth Kaunda, der durch seine Inhaftierung politisch radikalisiert wurde und mit der Forderung nach Unabhängigkeit eine breite Anhängerschaft gewann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
