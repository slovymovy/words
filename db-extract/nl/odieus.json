                "translations": [
                    {
                        "translation_id": "338f5f95-50d7-4c00-8ed6-a3744c738836",
                        "source_entry_id": "efee579e-28a9-39fd-83d3-ee6400c2be3e",
                        "target_lang_word": "odieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b1fa1be-5d37-319b-ac8e-63440ab1b706",
                                        "entry_id": "6e66db43-70cb-309a-abe0-395f4833cec4",
                                        "glosses": [
                                            "Qui excite la haine, l’aversion, la réprobation, l’indignation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ae2f00-7dbc-4321-a188-b00b6c533bde",
                                                "sense_id": "7b1fa1be-5d37-319b-ac8e-63440ab1b706",
                                                "text": "Nous avons dit que l’impôt sera odieux, quel qu’en soit le montant, tant qu’il prendra dans la bourse du contribuable, pour ne rien y rapporter."
                                            },
                                            {
                                                "example_id": "f3a1a8a1-4bf6-4777-8feb-4239b3993d4a",
                                                "sense_id": "7b1fa1be-5d37-319b-ac8e-63440ab1b706",
                                                "text": "Harland, qui a fort bien connu Vavilov, condamne sans réserves les théories mitchouriniennes, taxe Lyssenko de charlatan et dénonce les odieuses manœuvres qui ont abouti à la révocation des principales figures de la génétique soviétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7393047b-0bab-39c4-8b2e-7d3403aa7eda",
                                        "entry_id": "6e66db43-70cb-309a-abe0-395f4833cec4",
                                        "glosses": [
                                            "Qui a un comportement très désagréable, qui irrite."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bd8b2da-179d-4f16-ac6f-e28ba89e090c",
                                                "sense_id": "7393047b-0bab-39c4-8b2e-7d3403aa7eda",
                                                "text": "Tu as été odieuse hier soir, tu coupais la parole à tous les invités."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "odieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4b67361-7395-302e-8f07-217ec88cd5e7",
                                        "entry_id": "675b7acd-507d-3bb9-89ac-4c24b6d938aa",
                                        "glosses": [
                                            "Ce qui provoque la haine, l’aversion, la réprobation, l’indignation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a855df8-77ba-4445-95b7-52ff7a1b53ef",
                                                "sense_id": "e4b67361-7395-302e-8f07-217ec88cd5e7",
                                                "text": "L’odieux de son comportement apparaissait crûment."
                                            },
                                            {
                                                "example_id": "0a6bfeb3-57f7-4da0-9725-8199360f4fe9",
                                                "sense_id": "e4b67361-7395-302e-8f07-217ec88cd5e7",
                                                "text": "Je comprenais, lui disais-je, combien tout rapport était devenu impossible entre nous, et j’ajoutais qu’à son retour elle n’aurait plus à supporter l’odieux de ma présence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
