                                                "example_id": "bc68c107-309f-4fe0-8456-77d5f912acc7",
                                                "sense_id": "44336064-94f9-3e2a-aa6d-c28eca79fe8a",
                                                "text": "[…] the beadle is punished by fine, and sometimes bambooed, if robberies are too frequent within his jurisdiction, or if he fails to secure the person of any malefactor particularly wanted by his superior officers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b52ad06-82c2-346e-b44c-de45cccc2171",
                                        "entry_id": "948123b0-10c2-3b99-87be-9219e3b94497",
                                        "glosses": [
                                            "To paint (furniture, etc.) to give it the appearance of bamboo."
                                        ],
                                        "tags": [
                                            "transitive"
