                    },
                    {
                        "translation_id": "a16f5b6d-b1b4-439f-b634-42738340b217",
                        "source_entry_id": "a10c9aca-80d7-3fbf-a387-7b216295dfc2",
                        "target_lang_word": "décoration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décoration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fac4c85a-e41d-30d7-9a27-2fa063a66b16",
                                        "entry_id": "9f087606-18e2-3e0f-9b11-6ddc86dda869",
                                        "glosses": [
                                            "Action de décorer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9e34658-3fa1-4663-a250-26ae7c9a2547",
                                                "sense_id": "fac4c85a-e41d-30d7-9a27-2fa063a66b16",
                                                "text": "Malheureusement les émailleurs se faisaient payer cher […]; une autre idée lui vint : varier le mode de décoration et substituer aux cadrans émaillés des cadrans de papier, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb34ad4b-ce7b-3946-8492-123057e39008",
                                        "entry_id": "9f087606-18e2-3e0f-9b11-6ddc86dda869",
                                        "glosses": [
                                            "Ce qui sert à décorer, comme les ornements d’architecture, de peinture et de sculpture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02f13832-8efb-4b08-b5e4-8d293ab72e5f",
                                                "sense_id": "fb34ad4b-ce7b-3946-8492-123057e39008",
                                                "text": "Une fort belle grille, agrémentée d'une décoration dix-huitième de pampre et de raisin, protégeait les carreaux."
                                            },
                                            {
                                                "example_id": "bdff3e71-32d2-4a38-95f4-710fa630ad77",
                                                "sense_id": "fb34ad4b-ce7b-3946-8492-123057e39008",
                                                "text": "La décoration d’un édifice, d’un salon, d’un appartement."
                                            },
                                            {
                                                "example_id": "3a19681e-da87-4b1d-9334-00ff39dda552",
                                                "sense_id": "fb34ad4b-ce7b-3946-8492-123057e39008",
                                                "text": "Il a laissé par testament une somme considérable pour la décoration de l’église."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c5e8686-f2f4-3cbc-8451-5c8f8529bc17",
                                        "entry_id": "9f087606-18e2-3e0f-9b11-6ddc86dda869",
                                        "glosses": [
                                            "Décor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c496c194-6516-4f0f-a3ed-fb3146c0a508",
                                                "sense_id": "3c5e8686-f2f4-3cbc-8451-5c8f8529bc17",
                                                "text": "« M’est avis, dit Blazius, qu’il serait urgent de ployer nos décorations, et d’aller nous perdre ou plutôt nous sauver en cet océan de Paris. »"
                                            },
                                            {
                                                "example_id": "122dbdb8-560c-4f94-8719-983d73955616",
                                                "sense_id": "3c5e8686-f2f4-3cbc-8451-5c8f8529bc17",
                                                "text": "La décoration du premier acte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59e8ab8a-1aee-38a3-b42e-18fedee4fefc",
                                        "entry_id": "9f087606-18e2-3e0f-9b11-6ddc86dda869",
                                        "glosses": [
                                            "Nomination dans un ordre honorifique ou insignes de cet ordre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "232a841f-9366-44f5-aa7f-b482e5e3e6ea",
                                                "sense_id": "59e8ab8a-1aee-38a3-b42e-18fedee4fefc",
                                                "text": "Recevoir, obtenir une décoration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32c0272-511f-33d6-889e-2b252132fa62",
                                        "entry_id": "9f087606-18e2-3e0f-9b11-6ddc86dda869",
                                        "glosses": [
                                            "Insignes d’un ordre honorifique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2da294a4-0e32-4cb6-a4c7-4d780c61e437",
                                                "sense_id": "a32c0272-511f-33d6-889e-2b252132fa62",
                                                "text": "Porter des décorations."
                                            },
                                            {
                                                "example_id": "43222a8a-61a9-48f8-b29e-0357d8dfbfd0",
                                                "sense_id": "a32c0272-511f-33d6-889e-2b252132fa62",
                                                "text": "La décoration de la Légion d’honneur."
                                            },
                                            {
                                                "example_id": "b8c769ae-7140-4e30-acf6-1665da8e0012",
                                                "sense_id": "a32c0272-511f-33d6-889e-2b252132fa62",
                                                "text": "Les messieurs mettaient leur pardessus, pour prouver qu’ils n’y portaient pas leurs décorations."
                                            }
                                        ]
                                    },
