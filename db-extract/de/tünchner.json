                "senses": [
                    {
                        "sense_id": "eb0008d6-dc61-32b4-9845-4f7bd078fcae",
                        "entry_id": "f7c6ad62-a621-3853-a510-ec35e33fdef5",
                        "glosses": [
                            "jemand, der berufsmäßig Wände verputzt oder bemalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e6c35ab-8a43-4234-8c78-f3da33a78cf3",
                                "sense_id": "eb0008d6-dc61-32b4-9845-4f7bd078fcae",
                                "text": "„Durch fehlerhafte Zusammenstellung dieses Gerüstes wurde einer der Tünchner beschädigt.“"
                            },
                            {
                                "example_id": "d676b35f-3cf0-4014-9f06-18425d47eb77",
                                "sense_id": "eb0008d6-dc61-32b4-9845-4f7bd078fcae",
                                "text": "„Oelmüller verkaufen an Seiler, Tünchner, Lakirer, Wirthe und überhaupt an diejenigen, welche nur einigermaßen von ihrem Fabrikate gebrauchen.“"
                            },
                            {
                                "example_id": "29e175fb-a6cb-434c-b0d7-0e554a475f54",
                                "sense_id": "eb0008d6-dc61-32b4-9845-4f7bd078fcae",
                                "text": "„Nach heutigem Stand der Technik müssten schon bald die Gerüstbauer und Tüncher anrücken und mit der energetischen Sanierung beginnen.“"
                            },
                            {
                                "example_id": "3a2ae696-b717-4dc3-9092-012ec33438df",
                                "sense_id": "eb0008d6-dc61-32b4-9845-4f7bd078fcae",
                                "text": "„Die Arbeitsgruppe hat gemeinsam nach Lösungen gesucht, die meisten Materialien sind in den klostereigenen Betrieben bearbeitet worden: Tünchner, Spengler, Goldschmied, Drucker, Schreiner, Metallverarbeiter, Mitarbeiter im Verlag und Baubüro: All diese Abteilungen haben zum Gelingen des neuen Informationszentrums beigetragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
