                "senses": [
                    {
                        "sense_id": "775c4ae2-8279-300c-b6b4-fe3a269d33e3",
                        "entry_id": "d9730275-7750-3219-856d-e8cd030a0589",
                        "glosses": [
                            "onderzoek van een lijk vaak om de doodsoorzaak te achterhalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0657ec9b-8ac6-4d62-bb09-b2e67a520e9b",
                                "sense_id": "775c4ae2-8279-300c-b6b4-fe3a269d33e3",
                                "text": "Als een onnatuurlijke dood niet uitgesloten kan worden doet de patholoog-anatoom een lijkschouwing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e967b28-7165-48d6-8286-df9e3dfb2f05",
                        "source_entry_id": "d9730275-7750-3219-856d-e8cd030a0589",
                        "source_sense_id": "775c4ae2-8279-300c-b6b4-fe3a269d33e3",
                        "target_lang_word": "autopsy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autopsy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77fe5170-aae1-36e4-b0bf-e5f22ac2334e",
                                        "entry_id": "ca4df980-055a-30ac-94e9-30bf2b3b80c5",
                                        "glosses": [
                                            "A dissection performed on a cadaver to find possible cause(s) of death."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ca4f78-6d2c-4992-9c6d-d0b352816830",
                                                "sense_id": "77fe5170-aae1-36e4-b0bf-e5f22ac2334e",
                                                "text": "The autopsy revealed he had died of multiple bullet wounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "942e9070-2594-36b1-911d-d0ae9b79e697",
                                        "entry_id": "ca4df980-055a-30ac-94e9-30bf2b3b80c5",
                                        "glosses": [
                                            "An after-the-fact examination, especially of the causes of a failure."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0e7b056-470b-49e1-9382-e2bad6aa280f",
                                                "sense_id": "942e9070-2594-36b1-911d-d0ae9b79e697",
                                                "text": "This lack of built-in clutter makes the system easy to comprehend. Debugging facilities are few but powerful: snapshots, tracing, and autopsy."
                                            },
                                            {
                                                "example_id": "0775b92b-4dce-473b-b65a-705be7214110",
                                                "sense_id": "942e9070-2594-36b1-911d-d0ae9b79e697",
                                                "text": "Understanding exactly what happened and why is an essential first step to winning back the White House. ¶ In addition to the autopsy, the DNC should abandon the penchant for secrecy and embrace the principles of transparency and accountability that helped inspire and engage millions of people to participate in the 2008 Obama campaign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bad2858c-dd05-333b-8e82-0c167ec99cec",
                                        "entry_id": "ca4df980-055a-30ac-94e9-30bf2b3b80c5",
                                        "glosses": [
                                            "An eyewitness observation, the presentation of an event as witnessed."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "autopsy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f20bf0f-c062-334c-9b12-e4715a936fb0",
                                        "entry_id": "5c1f0cf4-0d4b-3418-ae99-b3ccddb51e52",
                                        "glosses": [
                                            "To perform an autopsy on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ec50152-b495-3116-9bb3-9b57369df26d",
                                        "entry_id": "5c1f0cf4-0d4b-3418-ae99-b3ccddb51e52",
                                        "glosses": [
                                            "To perform an after-the-fact analysis of, especially of a failure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e996200b-2902-436b-be5f-d59ccfa05844",
                                                "sense_id": "9ec50152-b495-3116-9bb3-9b57369df26d",
                                                "text": "The user may define his own errors, and use DUMPAL to autopsy the system for him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16c8c85d-e4dc-4ddf-8031-8ab0022ae760",
                        "source_entry_id": "d9730275-7750-3219-856d-e8cd030a0589",
                        "source_sense_id": "775c4ae2-8279-300c-b6b4-fe3a269d33e3",
