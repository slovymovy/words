                ],
                "senses": [
                    {
                        "sense_id": "df405a2d-bc72-3424-929a-8c1c9b903d20",
                        "entry_id": "b6204a07-0c8c-3bb2-ac04-8a64020a3be9",
                        "glosses": [
                            "Tenir des propos, particulièrement en matière d’amour, qui rappellent les raffinements et la subtilité des personnages de Marivaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aac48a0-a54e-4636-b313-11af8f362e8e",
                                "sense_id": "df405a2d-bc72-3424-929a-8c1c9b903d20",
                                "text": "Je me réjouis déjà de jeudi. Mon Crébillon y sera. Je le ferai un peu marivauder. Cela est charmant!"
                            },
                            {
                                "example_id": "9ccb5302-d63f-4b37-b721-2c1dac7842ac",
                                "sense_id": "df405a2d-bc72-3424-929a-8c1c9b903d20",
                                "text": "Un ballet de nymphes qui folâtrent, butinent, marivaudent, en une chorégraphie champêtre qui me fait penser aux fêtes antiques dont me parlait mon professeur au collège, où les hétaïres et les muses dansaient à la gloire de la déesse Héra, de Zeus ou de Dionysos, quelque part dans la ville de Pyrrha."
                            },
                            {
                                "example_id": "1545c62d-bf72-45a3-9bb9-1337956d86d8",
                                "sense_id": "df405a2d-bc72-3424-929a-8c1c9b903d20",
                                "text": "C’est un idiot qui ne sait que marivauder."
                            }
                        ]
                    }
                ],
