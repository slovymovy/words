                                        "entry_id": "bfe58d5d-0e83-3561-af78-f197a78da52b",
                                        "glosses": [
                                            "mix van cement en marmergranulaat dat men in gepolijste vorm gebruikt voor vloer- , trap- en aanrechtbedekking"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4311a7e-a915-489a-860e-e7147bdd3146",
                                                "sense_id": "1494b64c-b822-329f-86be-eab968bd8e45",
                                                "text": "Terrazzo. Wie kent niet de gespikkelde aanrechtbladen in het huis van oma. De mooie vloeren met marmeren mozaïeken in sjieke villa’s. Het maken van terrazzo is een ambacht, ontstaan in Venetië, geperfectioneerd in Friuli, Noordoost-Italië."
                                            },
                                            {
                                                "example_id": "ee829700-ff39-4274-983b-f28a80918f31",
                                                "sense_id": "1494b64c-b822-329f-86be-eab968bd8e45",
                                                "text": "De vloer wordt door een oud Italiaans familiebedrijf voorzien van Terrazzo en de wanden van handgemaakte tegels met glas-in-lood objecten."
                                            }
                                        ]
                                    }
                                ]
