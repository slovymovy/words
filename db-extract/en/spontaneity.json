                        "source_entry_id": "6ff4b442-6bab-3184-9658-0fdb08bb7472",
                        "source_sense_description": "the quality of being spontaneous",
                        "target_lang_word": "spontanéité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spontanéité",
