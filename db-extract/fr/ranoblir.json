                "senses": [
                    {
                        "sense_id": "be1a0416-6f95-3302-8511-34bcc83a1449",
                        "entry_id": "738cecd8-e523-3623-9e21-a1723941da02",
                        "glosses": [
                            "Anoblir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f5c918-50ca-4645-982a-0f9287c412bf",
                                "sense_id": "be1a0416-6f95-3302-8511-34bcc83a1449",
                                "text": "Le Principicule, petit-fils de généraux, orphelin de père, fils d'une mère indigente vivant de roulottage et de souvenirs, avait choisi le métier des armes pour se ranoblir, pour redevenir lui-même."
                            },
                            {
                                "example_id": "e4f638ca-3189-4369-a4c7-704c00818dfb",
                                "sense_id": "be1a0416-6f95-3302-8511-34bcc83a1449",
                                "text": "C'est en se jugeant déshonoré par sa défection qu'il va mûrir son drame en tragédie : pour se ranoblir, il deviendra le fétiche blanc des indigènes qui le feront Lord."
                            }
                        ]
                    }
                ],
