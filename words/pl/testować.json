                {
                    "sense_id": "2b332bfe-0cee-3cbd-b6b5-dfc7785b3e2a",
                    "sense_definition": "wypełniać szczeliny między płytkami zaprawą murarską",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "budownictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po ułożeniu kafelków w łazience, glazurnik zaczął <w>testować</w> wolne przestrzenie między nimi.",
                            "target_lang_translations": {
                                "ru": "После укладки плитки в ванной плиточник начал <w>фуговать</w> свободные пространства между ними."
                            }
                        },
                        {
                            "text": "Musisz dokładnie <w>testować</w> każdą szczelinę, aby woda nie dostawała się pod płytki.",
                            "target_lang_translations": {
                                "ru": "Нужно тщательно <w>затирать</w> каждую щель, чтобы вода не попадала под плитку."
                            }
                        }
