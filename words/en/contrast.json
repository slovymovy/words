{
    "word_family": [
        "contrasting",
        "contrastive",
        "contrastively",
        "uncontrasted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "383e7ff9-9e94-3d93-bd48-ffacb2e8c74d",
                    "sense_definition": "A noticeable difference between two or more people, objects, or ideas when they are compared.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comparison_difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a sharp <w>contrast</w> between the lives of the rich and the poor in this city.",
                            "target_lang_translations": {
                                "ru": "Между жизнью богатых и бедных в этом городе существует резкий <w>контраст</w>.",
                                "zh": "这座城市里富人和穷人的生活形成了鲜明的<w>对比</w>。"
                            }
                        },
                        {
                            "text": "The snowy mountains provided a striking <w>contrast</w> against the deep blue sky.",
                            "target_lang_translations": {
                                "ru": "Заснеженные горы создавали поразительный <w>контраст</w> на фоне темно-синего неба.",
                                "zh": "雪山在深蓝色的天空映衬下形成了强烈的<w>对比</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "difference",
                        "disparity",
                        "distinction"
                    ],
                    "common_phrases": [
                        "striking contrast",
                        "sharp contrast",
                        "in contrast to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заметное различие между двумя или более людьми, объектами или идеями при их сравнении.",
                        "zh": "在比较时，人、事物或观点之间明显的不同之处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контраст",
                                "target_lang_sense_clarification": "резко выраженная противоположность"
                            },
                            {
                                "target_lang_word": "различие",
                                "target_lang_sense_clarification": "несходство между объектами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对比",
                                "target_lang_sense_clarification": "指两者之间明显的差异"
                            },
                            {
                                "target_lang_word": "差异",
                                "target_lang_sense_clarification": "指事物之间的不同点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6dbd284-0418-3778-a0bc-86dcc8998a2d",
                    "sense_definition": "The degree of difference between the lightest and darkest parts of a picture or the difference in colors.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can adjust the <w>contrast</w> on your monitor to make the text easier to read.",
                            "target_lang_translations": {
                                "ru": "Вы можете настроить <w>контрастность</w> на мониторе, чтобы текст было легче читать.",
                                "zh": "你可以调整显示器的<w>对比度</w>，让文字更容易阅读。"
                            }
                        },
                        {
                            "text": "The photographer used high <w>contrast</w> to make the black and white image look more dramatic.",
                            "target_lang_translations": {
                                "ru": "Фотограф использовал высокий <w>контраст</w>, чтобы сделать черно-белое изображение более драматичным.",
                                "zh": "摄影师使用了高<w>对比度</w>，使这张黑白照片看起来更具戏剧性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "high contrast",
                        "low contrast",
                        "adjust the contrast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень различия между самыми светлыми и самыми темными частями изображения или разница в цветах.",
                        "zh": "图像中最亮和最暗部分之间的差异程度，或色彩上的差异。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контрастность",
                                "target_lang_sense_clarification": "параметр изображения"
                            },
                            {
                                "target_lang_word": "контраст",
                                "target_lang_sense_clarification": "различие в яркости или цвете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对比度",
                                "target_lang_sense_clarification": "指显示器或图像的明暗差异程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac3bd35f-c2e9-3d8a-b4ce-1eedb6106ca8",
                    "sense_definition": "A person or thing that is very different from another.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison_difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet village was a complete <w>contrast</w> to the noisy city we had just left.",
                            "target_lang_translations": {
                                "ru": "Тихая деревня была полным <w>контрастом</w> шумному городу, который мы только что покинули.",
                                "zh": "这个安静的村庄与我们刚离开的喧闹城市形成了鲜明的<w>反差</w>。"
                            }
                        },
                        {
                            "text": "Her cheerful personality is a welcome <w>contrast</w> to her brother's gloomy mood.",
                            "target_lang_translations": {
                                "ru": "Ее жизнерадостность — приятный <w>контраст</w> мрачному настроению ее брата.",
                                "zh": "她开朗的性格与她哥哥阴郁的情绪形成了令人愉悦的<w>对比</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "opposite",
                        "antithesis"
                    ],
                    "common_phrases": [
                        "complete contrast",
                        "welcome contrast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, которые сильно отличаются от других.",
                        "zh": "与另一事物截然不同的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контраст",
                                "target_lang_sense_clarification": "о ком-то или чем-то противоположном"
                            },
                            {
                                "target_lang_word": "противоположность",
                                "target_lang_sense_clarification": "полное несходство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反差",
                                "target_lang_sense_clarification": "指事物之间强烈的对比或不协调"
                            },
                            {
                                "target_lang_word": "对照",
                                "target_lang_sense_clarification": "指作为对比的另一方"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3103475-87c5-3b90-b7e9-279f470273e2",
                    "sense_definition": "To be very different from something else when put together or compared.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "comparison_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright yellow flowers <w>contrast</w> sharply with the dark green leaves.",
                            "target_lang_translations": {
                                "ru": "Ярко-желтые цветы резко <w>контрастируют</w> с темно-зелеными листьями.",
                                "zh": "明黄色的花朵与深绿色的叶子形成了鲜明的<w>对比</w>。"
                            }
                        },
                        {
                            "text": "His modern furniture <w>contrasts</w> with the traditional style of the old house.",
                            "target_lang_translations": {
                                "ru": "Его современная мебель <w>контрастирует</w> с традиционным стилем старого дома.",
                                "zh": "他现代风格的家具与老房子的传统风格形成了<w>对比</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "differ",
                        "clash"
                    ],
                    "common_phrases": [
                        "contrast sharply",
                        "contrast with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно отличаться от чего-либо другого при сопоставлении или сравнении.",
                        "zh": "指事物放在一起比较时，表现出明显的不同。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контрастировать",
                                "target_lang_sense_clarification": "резко выделяться на фоне чего-либо"
                            },
                            {
                                "target_lang_word": "резко отличаться",
                                "target_lang_sense_clarification": "иметь явные различия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "形成对比",
                                "target_lang_sense_clarification": "指两者之间存在显著差异"
                            },
                            {
                                "target_lang_word": "迥异",
                                "target_lang_sense_clarification": "指差异非常大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69ae0b5b-cfdc-3b86-b5e7-638bb9314180",
                    "sense_definition": "To compare two things in order to show the differences between them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The essay asks students to compare and <w>contrast</w> two different political systems.",
                            "target_lang_translations": {
                                "ru": "В эссе студентам предлагается сравнить и <w>противопоставить</w> две различные политические системы.",
                                "zh": "这篇文章要求学生对两种不同的政治制度进行比较和<w>对照</w>。"
                            }
                        },
                        {
                            "text": "If you <w>contrast</w> the two reports, you will see several major discrepancies.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>сопоставите</w> эти два отчета, вы увидите несколько серьезных расхождений.",
                                "zh": "如果你将这两份报告进行<w>对比</w>，就会发现几处重大的出入。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compare",
                        "differentiate"
                    ],
                    "antonyms": [
                        "liken"
                    ],
                    "common_phrases": [
                        "compare and contrast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнивать две вещи, чтобы показать различия между ними.",
                        "zh": "通过比较两件事物来展示它们之间的差异。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противопоставлять",
                                "target_lang_sense_clarification": "указывать на несходство при сравнении"
                            },
                            {
                                "target_lang_word": "сопоставлять",
                                "target_lang_sense_clarification": "сравнивать для выявления различий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对比",
                                "target_lang_sense_clarification": "指通过比较来找出差异"
                            },
                            {
                                "target_lang_word": "对照",
                                "target_lang_sense_clarification": "指将两者放在一起进行比较"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}