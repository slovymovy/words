                "senses": [
                    {
                        "sense_id": "31eed47b-0e44-331e-8cfa-eb92facf7eca",
                        "entry_id": "0166885f-feef-359f-90ef-2598af18ffd8",
                        "glosses": [
                            "Häuslichkeit, in der ältere Personen untergebracht sind, um gepflegt zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af7fa3cf-b1ca-4abf-beed-6f7d87d92723",
                                "sense_id": "31eed47b-0e44-331e-8cfa-eb92facf7eca",
                                "text": "„Nach dem Heimgesetz gibt es in Deutschland eine dreistufige Versorgung, die vielfach in Kombination unter einem Dach angeboten wird, unterschieden nach Altenwohnheim (der Hauptaspekt ist hier das Wohnen mit eigenständiger Haushaltsführung), Altenheim (es wird kein eigener Haushalt geführt, Verpflegung und Zimmerpflege werden übernommen) und Altenpflegeheim (im Vordergrund steht die umfassende Pflege pflegebedürftiger Menschen).“"
                            },
                            {
                                "example_id": "24366e00-04c8-420a-8b6e-85d97558bbeb",
                                "sense_id": "31eed47b-0e44-331e-8cfa-eb92facf7eca",
                                "text": "„Altenpflegeheime sind Pflegeeinrichtungen für ältere Personen, die zuhause nicht gepflegt werden, nicht gepflegt werden können oder nicht gepflegt werden wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
