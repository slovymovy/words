        "fr-extract.jsonl": [
            {
                "entry_id": "744e75b6-19de-3d4b-bd1c-fe66df60074d",
                "word": "titanesque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "40082a80-e967-40ae-8fe5-cd181325af46",
                        "entry_id": "744e75b6-19de-3d4b-bd1c-fe66df60074d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "titanesques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f73659d-2250-352a-9473-14477453d63e",
                        "entry_id": "744e75b6-19de-3d4b-bd1c-fe66df60074d",
                        "glosses": [
                            "Digne des Titans ; qui a la taille ou la force d’un titan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc605d24-18a3-49bd-89cb-9629c758dd9b",
                                "sense_id": "3f73659d-2250-352a-9473-14477453d63e",
                                "text": "En ce temps-là, la Terre était peuplée d’espèces titanesques."
                            },
                            {
                                "example_id": "d8c6975a-4f69-4ca5-ba43-8602022ff8f5",
                                "sense_id": "3f73659d-2250-352a-9473-14477453d63e",
                                "text": "Dans un effort titanesque, il souleva la charrette."
                            },
                            {
                                "example_id": "baa26e4a-d4b8-490d-8733-0008127387f4",
                                "sense_id": "3f73659d-2250-352a-9473-14477453d63e",
                                "text": "Ensuite, don Elemirio la conduisit à la cuisine, titanesque et moderne."
                            }
                        ]
                    },
                    {
                        "sense_id": "d674b9ce-39a2-369d-90dc-25ee2bd8db97",
                        "entry_id": "744e75b6-19de-3d4b-bd1c-fe66df60074d",
                        "glosses": [
                            "Démesuré du point de vue intellectuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3044cafc-cc53-4939-9632-b5b1ebc7e186",
                                "sense_id": "d674b9ce-39a2-369d-90dc-25ee2bd8db97",
                                "text": "[…], nous passons sous le pont suspendu de Brooklyn et devant Manhattan et ses gratte-ciel, et ma dernière vision de New-York me laisse une impression de ville monstrueuse et titanesque."
                            },
                            {
                                "example_id": "6d774815-d3ef-4aad-9564-0a5678499f66",
                                "sense_id": "d674b9ce-39a2-369d-90dc-25ee2bd8db97",
                                "text": "L’Iliade et La Divine comédie font partie des œuvres titanesques que le génie humain a créées."
                            },
                            {
                                "example_id": "c54afbca-fe92-439c-8803-076dc190c4d8",
                                "sense_id": "d674b9ce-39a2-369d-90dc-25ee2bd8db97",
                                "text": "Elle est douée d’une intelligence titanesque."
                            }
                        ]
                    }
                ],
