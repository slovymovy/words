    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aad528a3-8ed5-355e-a8bb-4a7f5086bcc0",
                    "sense_definition": "A shortened, informal term for a restaurant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to try one of the new <w>restos</w> that opened downtown last week.",
                            "target_lang_translations": {
                                "ru": "Мы решили зайти в один из новых <w>рестиков</w>, открывшихся в центре на прошлой неделе."
                            }
                        },
                        {
                            "text": "This <w>resto</w> bar is famous for its unique cocktails and live jazz music.",
                            "target_lang_translations": {
                                "ru": "Этот <w>ресто</w>-бар знаменит своими уникальными коктейлями и живой джазовой музыкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "restaurant",
                        "eatery",
                        "bistro"
                    ],
                    "common_phrases": [
                        "local resto",
                        "resto bar",
                        "favorite resto"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal clipping of restaurant"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное разговорное название ресторана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рестик",
                                "target_lang_sense_clarification": "сленговое сокращение от слова ресторан"
                            },
                            {
                                "target_lang_word": "ресторанчик",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное, часто используется для небольших заведений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e9d67f9-b890-3b04-9981-25af8f27ff76",
                    "sense_definition": "A project involving the <w>restoration</w> of an old vehicle or building.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "restoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent three years working on a classic car <w>resto</w> in his garage.",
                            "target_lang_translations": {
                                "ru": "Он провел три года, занимаясь <w>реставрацией</w> классического автомобиля в своем гараже."
                            }
                        },
                        {
                            "text": "The full <w>resto</w> of the vintage motorcycle cost more than he originally expected.",
                            "target_lang_translations": {
                                "ru": "Полное <w>восстановление</w> винтажного мотоцикла обошлось дороже, чем он ожидал изначально."
                            }
                        }
                    ],
                    "synonyms": [
                        "restoration",
                        "refurbishment"
                    ],
                    "common_phrases": [
                        "car resto",
                        "full resto",
                        "classic resto"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used among hobbyists and enthusiasts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проект по восстановлению (реставрации) старого автомобиля или здания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реставрация",
                                "target_lang_sense_clarification": "процесс восстановления первоначального вида"
                            },
                            {
                                "target_lang_word": "восстановление",
                                "target_lang_sense_clarification": "общий термин для ремонтных работ по возвращению в строй"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f164d528-668c-380b-8a91-4f7e42d0921d",
                    "sense_definition": "A short name for Restoration Island, located off the coast of Queensland, Australia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The explorer spent several weeks living on <w>Resto</w> to study the local wildlife.",
                            "target_lang_translations": {
                                "ru": "Исследователь провел несколько недель на <w>Ресто</w>, изучая местную дикую природу."
                            }
                        },
                        {
                            "text": "Boats often pass by <w>Resto</w> when navigating the waters near Queensland.",
                            "target_lang_translations": {
                                "ru": "Лодки часто проходят мимо <w>Ресто</w>, когда плавают в водах близ Квинсленда."
                            }
                        }
                    ],
                    "synonyms": [
                        "Restoration Island"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specifically Australian context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое название острова Ресторейшн, расположенного у побережья Квинсленда, Австралия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ресто",
                                "target_lang_sense_clarification": "сокращенное географическое название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ae50ebe-5d79-313c-8b7f-06ff3cc4fda2",
                    "sense_definition": "A <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local gallery is currently hosting an exhibition by the artist Maria <w>Resto</w>.",
                            "target_lang_translations": {
                                "ru": "В местной галерее сейчас проходит выставка художницы Марии <w>Ресто</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Resto</w> has lived in this neighborhood for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Ресто</w> живет в этом районе уже более сорока лет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ресто",
