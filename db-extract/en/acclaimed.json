                        "sense_id": "da575f95-f765-3537-9c5b-c8955ef55437",
                        "entry_id": "6325fc45-91e8-3a4b-bb89-6fe87758356e",
                        "glosses": [
                            "Greatly praised or lauded, revered, highly respected."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a89af6a-304d-4f64-94b3-0649f36df6ef",
                                "sense_id": "da575f95-f765-3537-9c5b-c8955ef55437",
                                "text": "Many critically acclaimed novels are not commercially successful."
                            },
                            {
                                "example_id": "dba2a9a7-bc84-402f-a455-28cd9a4cb788",
                                "sense_id": "da575f95-f765-3537-9c5b-c8955ef55437",
                                "text": "She’s an acclaimed writer; her books are bestsellers before they are published."
                            },
                            {
                                "example_id": "43e6076c-ed42-45aa-8882-5b9388ade672",
                                "sense_id": "da575f95-f765-3537-9c5b-c8955ef55437",
                                "text": "Franklin the scientist, inventor, and exponent of thrift and hard work, the very embodiment of the native religion of upward mobility, may have been even more acclaimed than in his own time."
                            }
                        ]
                    }
                ],
