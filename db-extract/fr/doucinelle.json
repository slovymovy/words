                        "glosses": [
                            "Variété de raisin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26a81e29-7b69-4de5-aa34-c0b056a9e750",
                                "sense_id": "bee7a042-167f-36c7-bfef-76e99fc6c9d1",
                                "text": "Parmi les variétés connues, dix-sept sont de grande culture et peuplent encore nos vignobles méridionaux, ce sont : les muscats, le colombaud, la doucinelle, les pascals blancs et rouges, le rondeillat, l'uni blanc, l'areignan, le piquepoul gris, la clairette, le teaulier, le rin brun ou brun fourca, le catalan ou carignan, le bouteillan, le mourvègue ou mourvèdre, ou espar, ou mataro, l'uni noir ou aramon du Languedoc, le plant d'Arles ou cinsaut de l'Hérault."
                            },
                            {
                                "example_id": "661e1dfe-7ba1-41f9-bf7d-62d829d75b79",
                                "sense_id": "bee7a042-167f-36c7-bfef-76e99fc6c9d1",
                                "text": "La Doucette : raisin blanc assez précoce, à grain lâches et doux. Ce raisin est cultivé dans l’arrondissement d’Arles, sous le nom de doucinelle."
                            }
                        ]
                    }
