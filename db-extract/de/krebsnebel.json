                ],
                "senses": [
                    {
                        "sense_id": "2096dbb3-9836-32f5-9f57-0134e1d4b10c",
                        "entry_id": "f4799c42-fa05-33d1-b89f-bd8a68c66693",
                        "glosses": [
                            "im Sternbild Stier befindliche Überreste einer Supernova"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60a0bc6f-ded6-443b-a0d2-29d6981116b8",
                                "sense_id": "2096dbb3-9836-32f5-9f57-0134e1d4b10c",
                                "text": "„Im Zentrum des Krebsnebels befinden sich die Reste eines einst massereichen Sterns, ein rotierender Neutronenstern, der mehr oder weniger rasch pulsierende, hoch- und niedrigenergetische Strahlung aussendet und deshalb \"Pulsar\" genannt wird.“"
                            },
                            {
                                "example_id": "15fc35a2-35ab-4e70-898a-2f4f2f84da50",
                                "sense_id": "2096dbb3-9836-32f5-9f57-0134e1d4b10c",
                                "text": "„Mit dem Weltraumteleskop Hubble haben die Astronomen die zentrale Region des Krebsnebels um den rotierenden Neutronenstern - hier der rechte der beiden Sterne nahe der Bildmitte - immer wieder ins Visier genommen und in verschiedenen Wellenlängenbereichen fotografiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
