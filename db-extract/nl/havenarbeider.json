                        "glosses": [
                            "arbeider die in een haven werkt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "4995888b-3d10-4f10-a9fb-ffd65a16dfe4",
                                "sense_id": "66842ce4-12df-3177-9e6b-9d6f924f1d41",
                                "text": "De fiscaal vraagt: „waarom keerde Don Claudio uit het hol van Monjuich niet tot zijne ouders terug? Waarom berigt de haven-arbeider Tomas den vader niet, dat zijn zoon bij hem was ? Hoe kwam deze arbeider er toe, hem een pas te verschaffen?\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89778c2c-cc13-475c-9ea3-45f3c47462a9",
                        "source_entry_id": "252af271-de07-35d0-9ab0-a6156fd77e2c",
                        "source_sense_id": "66842ce4-12df-3177-9e6b-9d6f924f1d41",
                        "source_sense_description": "arbeider die in een haven werkt",
                        "target_lang_word": "Hafenarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hafenarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03870fa3-ff55-34cf-bbb2-97fd93ef46e1",
                                        "entry_id": "4b3af614-fe92-3764-96ad-23f86226170f",
                                        "glosses": [
                                            "Arbeiter, der seinen beruflichen Aufgaben in einem Binnen- oder Seehafen nachgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92f9ccd2-cad1-4e75-a39f-d6a5c140be42",
                                                "sense_id": "03870fa3-ff55-34cf-bbb2-97fd93ef46e1",
                                                "text": "„Ein Streik der Hafenarbeiter legt den Ladeverkehr in den Häfen der Westküste der Vereinigten Staaten lahm.“"
                                            },
                                            {
                                                "example_id": "8c3bb82f-4488-460d-886e-6527a91a9719",
                                                "sense_id": "03870fa3-ff55-34cf-bbb2-97fd93ef46e1",
                                                "text": "„Zu unseren Leuten gehörten Soldaten, Matrosen und Hafenarbeiter.“"
                                            },
                                            {
                                                "example_id": "0f69a8a1-1df7-4960-907e-4fc5f15f4a78",
                                                "sense_id": "03870fa3-ff55-34cf-bbb2-97fd93ef46e1",
                                                "text": "„Die anderen Hafenarbeiter riefen immer dann nach Kostas, dem Mechaniker, wenn mal wieder eine Kurbel klemmte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ae2d1ca-5264-45fc-b157-96e567be3e39",
                        "source_entry_id": "252af271-de07-35d0-9ab0-a6156fd77e2c",
                        "source_sense_id": "66842ce4-12df-3177-9e6b-9d6f924f1d41",
