                        "entry_id": "9772a8f7-9509-32f8-8581-776910427922",
                        "glosses": [
                            "To break a strike; to work for a business where the union members are on strike."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06463b19-7653-45ad-b916-09e1a8771e7f",
                                "sense_id": "67ce1840-4428-3e24-afca-0ad38b6c42e9",
                                "text": "When the first three decided to strikebreak, Baker knew he could use them as a nucleus to train other crews."
                            },
                            {
                                "example_id": "136edb2f-f0f2-4395-aae2-a9cebc3031bc",
                                "sense_id": "67ce1840-4428-3e24-afca-0ad38b6c42e9",
                                "text": "OPSEU urged its members not to strikebreak."
                            },
                            {
                                "example_id": "ae5402dd-f061-474b-832b-38fa122cfc0c",
                                "sense_id": "67ce1840-4428-3e24-afca-0ad38b6c42e9",
                                "text": "I told him we aren't about to strikebreak—there are too many spies around."
                            },
                            {
                                "example_id": "4b685220-20eb-4ac4-bc16-f9c1e550a3a8",
                                "sense_id": "67ce1840-4428-3e24-afca-0ad38b6c42e9",
                                "text": "Third, the migration of foreign-born white workers into local labor markets does not appear to have significantly increased pressures for African Americans to strikebreak."
                            }
                        ]
                    }
