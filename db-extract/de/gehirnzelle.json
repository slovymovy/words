                                "sense_id": "0a501e0f-eead-3c52-8d8d-30d7b8d13051",
                                "text": "Bei manchen Krankheiten sterben Gehirnzellen ab."
                            },
                            {
                                "example_id": "f7e47647-a756-4265-bbc2-55b70f6083d8",
                                "sense_id": "0a501e0f-eead-3c52-8d8d-30d7b8d13051",
                                "text": "„Grenfelds Gehirnzellen arbeiteten auf Hochtouren und kamen stets zum gleichen Ergebnis: Er musste ihnen das Projektil beschaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
