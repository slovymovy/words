                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e98b3e4d-e510-4e98-816d-85120fe2ea3e",
                                                "sense_id": "005ee3e7-fcd2-3c33-a5a7-c22c8a40ba1f",
                                                "text": "Eine wichtige Voraussetzung für die Mathematik ist das logische Denken."
                                            },
                                            {
                                                "example_id": "ce9360b3-0598-473d-a81d-448331c42efd",
                                                "sense_id": "005ee3e7-fcd2-3c33-a5a7-c22c8a40ba1f",
                                                "text": "„Der Glaube, dass es einen Gott gibt, bleibt jedoch trotz der Versuche des menschlichen Geistes, sich über sogenannte Gottesbeweise, über intellektuelle Erkenntnisse und logische Schlüsse, Sicherheit zu verschaffen, ein Wagnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "60bcfece-df2e-30b9-973d-d7034346f0a3",
                                        "entry_id": "a51a4d11-042b-348a-aa79-2af47907bb6a",
                                        "glosses": [
                                            "sich ganz von selbst, wie selbstverständlich ergebend"
