    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a4f2678b-1ca4-31e1-aadd-05cc7f05ae19",
                    "sense_definition": "Een constructie van enige omvang die verbonden is met de grond, zoals een gebouw of een ander object waarin men kan wonen of werken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "constructie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ondergrondse <w>bouwwerk</w> is bijna onzichtbaar in de duinen.",
                            "target_lang_translations": {
                                "en": "The underground <w>structure</w> is almost invisible in the dunes."
                            }
                        },
                        {
                            "text": "De architect ontwierp een indrukwekkend <w>bouwwerk</w> dat perfect in de omgeving past.",
                            "target_lang_translations": {
                                "en": "The architect designed an impressive <w>building</w> that fits perfectly into the surroundings."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebouw",
                        "bouwsel"
                    ],
                    "common_phrases": [
                        "indrukwekkend bouwwerk",
                        "historisch bouwwerk",
                        "ondergronds bouwwerk"
                    ],
                    "target_lang_definitions": {
                        "en": "A construction of significant size connected to the ground, such as a building or another object where people can live or work."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "building",
                                "target_lang_sense_clarification": "a structure with walls and a roof"
                            },
                            {
                                "target_lang_word": "structure",
                                "target_lang_sense_clarification": "a large constructed object"
                            },
                            {
                                "target_lang_word": "edifice",
                                "target_lang_sense_clarification": "a large, imposing building"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2399a48-8483-31e8-bbc7-5c556de54a09",
                    "sense_definition": "Iets dat door bouwen tot stand is gekomen; een algemene term voor een constructie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "constructie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rondom het <w>bouwwerk</w> waren steunen bevestigd zodat de kinderen erop konden klimmen.",
                            "target_lang_translations": {
                                "en": "Supports were attached around the <w>construction</w> so that the children could climb on it."
                            }
                        },
                        {
                            "text": "Dit nutteloos <w>bouwwerk</w> dient eigenlijk alleen als decoratie in het park.",
                            "target_lang_translations": {
                                "en": "This useless <w>structure</w> actually only serves as decoration in the park."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebouw",
                        "bouwsel",
                        "bouwgewrocht"
                    ],
                    "common_phrases": [
                        "nutteloos bouwwerk",
                        "tijdelijk bouwwerk"
                    ],
                    "target_lang_definitions": {
                        "en": "Something created through the process of building; a general term for a construction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "construction",
                                "target_lang_sense_clarification": "something that has been built"
                            },
                            {
                                "target_lang_word": "structure",
                                "target_lang_sense_clarification": "a physical arrangement of parts"
                            },
                            {
                                "target_lang_word": "erection",
                                "target_lang_sense_clarification": "a formal term for a built structure"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}