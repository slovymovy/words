                                    },
                                    {
                                        "sense_id": "fbfd3691-07fa-315d-9b79-bdc6350341ca",
                                        "entry_id": "3af4c3a1-2225-3444-9595-6573dc2e9a96",
                                        "glosses": [
                                            "To go diligently about in order to get helpers or participants in an enterprise."
                                        ],
