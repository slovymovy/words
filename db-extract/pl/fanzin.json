                "senses": [
                    {
                        "sense_id": "4602b3d3-16b7-33e2-ba04-7676178e7da1",
                        "entry_id": "ffcecfc7-7b64-394f-9442-cf07b9b323a9",
                        "glosses": [
                            "czasopismo wydawane przez członków subkultury lub kontrkultury"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "61125786-bdf7-4c1b-a72e-f85f992ddea6",
                                "sense_id": "4602b3d3-16b7-33e2-ba04-7676178e7da1",
                                "text": "Spadek popularności fanzinów nastąpił wraz z rozwojem mediów elektronicznych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a540f49-f978-442b-b835-8a5238f05a9c",
                        "source_entry_id": "ffcecfc7-7b64-394f-9442-cf07b9b323a9",
                        "source_sense_id": "4602b3d3-16b7-33e2-ba04-7676178e7da1",
                        "target_lang_word": "fanzine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fanzine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1489cc0-263a-3fa5-9cba-0813e228fbcf",
                                        "entry_id": "590d634f-b8ed-3698-a2a8-96599f1c5c49",
                                        "glosses": [
                                            "A magazine, normally produced by amateurs, intended for people who share a common interest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa2b8e66-b719-47b7-aab3-a4e548172597",
                                                "sense_id": "c1489cc0-263a-3fa5-9cba-0813e228fbcf",
                                                "text": "I don't know how many fanzines there've been, but surely no fewer than 500 different items, some running for one issue and some for several dozen."
                                            },
                                            {
                                                "example_id": "a4b2589d-790f-4196-a3b8-61f120b37ca6",
                                                "sense_id": "c1489cc0-263a-3fa5-9cba-0813e228fbcf",
                                                "text": "\"Well, long ago,\" said the Tin Woodsfan, \"a fan and I were feuding, and the fan decided to drive me out of fandom. But no one can leave Iz because of the great burning desert called Public Contempt which surrounds this fannish land, and since nobody ever gafiates while still inside the country, he had to cast a spell of immobility upon me. One day when I was chopping wood to make paper for my fanzine, he cast his spell, and there I've been until you came along.\""
                                            },
                                            {
                                                "example_id": "c17db468-3b26-459f-bb27-d5c5509e77b1",
                                                "sense_id": "c1489cc0-263a-3fa5-9cba-0813e228fbcf",
                                                "text": "Maybe a few dozen hours of collective neofans, all reading him fanzine press at once, would cure him of these paternal instincts."
                                            },
                                            {
                                                "example_id": "12999a61-8a02-4d56-826d-aa76e82a7058",
                                                "sense_id": "c1489cc0-263a-3fa5-9cba-0813e228fbcf",
                                                "text": "The US jazz magazine Coda began in 1958 as a 12-page mimeographed fanzine, put together by its editor and a team of volunteers working for beer and pizza."
                                            },
                                            {
                                                "example_id": "79055662-6d8c-4ce0-8629-43d5c0d7779e",
                                                "sense_id": "c1489cc0-263a-3fa5-9cba-0813e228fbcf",
                                                "text": "“Do you think Cal Bodian's over there? Do you think he'll sign my zine?” “♪♪ Bum, bada-dum. ♪♪ My P.I. Undercover fanzine. I've done everything myself. I just took a guess about the chest hair.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1bad669-f474-4c19-b40b-f64d2a84bd8c",
                        "source_entry_id": "ffcecfc7-7b64-394f-9442-cf07b9b323a9",
                        "source_sense_id": "4602b3d3-16b7-33e2-ba04-7676178e7da1",
                        "target_lang_word": "Fanzine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fanzine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "782855b6-691f-3912-8aeb-2e158cbfea56",
                                        "entry_id": "55e66f73-42c7-3d9a-9426-03f1ce267e49",
                                        "glosses": [
                                            "Zeitschrift für Fans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22da7e9c-60e2-466a-bfaa-ac009f6df582",
                                                "sense_id": "782855b6-691f-3912-8aeb-2e158cbfea56",
                                                "text": "Welche Fußball Fanzines lest ihr denn so?"
                                            },
                                            {
                                                "example_id": "bf88d281-4e56-4317-a344-c936847912c2",
                                                "sense_id": "782855b6-691f-3912-8aeb-2e158cbfea56",
                                                "text": "„Der deutsche Metal Hammer wurde ab Ende 1983 an Kiosken verkauft, während sich Rock Hard Anfang 1984 vom selbstgefertigen Fanzine zu einem professionellen Magazin entwickelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
