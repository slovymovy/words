                        "examples": [
                            {
                                "example_id": "83b3879f-d4a9-469f-8428-c11b17de1d09",
                                "sense_id": "d0184ad0-e70b-3cbd-85d4-520abb080bcc",
                                "text": "C’est aussi ce qu’on hait dans la psychanalyse, qu’elle essaie de ne pas consentir à ce qui se présente et se représente, qu’elle essaie de se tenir à l’écoute de l’affect « originairement » inconscient, d’en désétouffer l’écho inaudible."
                            },
                            {
                                "example_id": "6ddeedc3-a913-46f0-a9dd-10c20d34bd90",
                                "sense_id": "d0184ad0-e70b-3cbd-85d4-520abb080bcc",
                                "text": "Heureusement, il y a eu la Commune pour me désétouffer."
                            },
                            {
                                "example_id": "ea3d5c7e-add0-4dda-b5ef-8acd7efeaab5",
                                "sense_id": "d0184ad0-e70b-3cbd-85d4-520abb080bcc",
                                "text": "Poyer s’en étonnait, il s’étonnait de ce que tout le monde ne parlât pas de Carmélite, et, à chaque instant, il avait le cœur si plein de ce nom qu’il se sentait envie de le crier comme pour se désétouffer."
                            }
                        ]
                    }
