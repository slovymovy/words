                        "glosses": [
                            "Personne qui apprend sur le tard, à un âge avancé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85798354-f2d1-485d-93bd-e5bda3aa9e9b",
                                "sense_id": "7e051654-4e7a-3310-8f3d-2e2b7ddea9ec",
                                "text": "Caton l’Ancien, qui apprit, dit-on, le grec à 80 ans, était un exemple d’opsimathe."
                            },
                            {
                                "example_id": "34f12930-20d4-4afa-8df5-bdea9647e141",
                                "sense_id": "7e051654-4e7a-3310-8f3d-2e2b7ddea9ec",
                                "text": "Et puis, je m’imagine bien devenir opsimathe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45ee80ca-2ff2-4b69-9af2-f7e8deb330f6",
                        "source_entry_id": "d357432e-7c2d-3a77-afb3-12dff95910f9",
                        "source_sense_id": "7e051654-4e7a-3310-8f3d-2e2b7ddea9ec",
