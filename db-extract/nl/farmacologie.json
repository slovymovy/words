                                        "entry_id": "00d729d0-bac1-38d5-b979-3700573de017",
                                        "glosses": [
                                            "„Lehre von den Wechselwirkungen zwischen körperfremden Stoffen und Organismen“"
                                        ],
                                        "tags": [],
                                        "examples": [
