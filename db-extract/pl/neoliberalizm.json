                    {
                        "sense_id": "fb513bcf-92ce-3d21-8c31-ba22550394cc",
                        "entry_id": "982edba0-a26c-3f16-8b45-7ba7ac808a55",
                        "glosses": [
                            "nurt we współczesnej myśli ekonomicznej głoszący zasady liberalizmu gospodarczego i wolnego rynku przy ograniczonej do minimum ingerencji państwa w gospodarkę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ceac1fb-126d-47bf-a77f-ae4859f19550",
                                "sense_id": "fb513bcf-92ce-3d21-8c31-ba22550394cc",
                                "text": "Neoliberalizm w swoich założeniach głosi, iż kapitał nie ma już charakteru narodowego, ale to tylko Polska wprowadziła pełną liberalizację usług bankowych, na czym niewątpliwie zbijają dziś fortuny zagraniczne instytucje finansowe"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67d9957e-ccb0-42eb-9dc9-caf79144cbac",
                        "source_entry_id": "982edba0-a26c-3f16-8b45-7ba7ac808a55",
                        "source_sense_id": "fb513bcf-92ce-3d21-8c31-ba22550394cc",
                        "target_lang_word": "neoliberalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neoliberalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f6978b1-11e0-3bea-99d0-b789faba5d4e",
                                        "entry_id": "557d2614-faba-3c0a-9202-1e1b572aa375",
                                        "glosses": [
                                            "A political ideology or ideological trend based on neoclassical economics that espouses economic liberalism, favouring trade liberalisation, financial deregulation, a small government, privatisation and liberalisation of government businesses, passive antitrust enforcement, accepting greater economic inequality and disfavouring unionisation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f965416-e07d-40b5-8130-5fa19d346bdd",
                                                "sense_id": "3f6978b1-11e0-3bea-99d0-b789faba5d4e",
                                                "text": "The age of Obama was the last gasp of neoliberalism. Despite some progressive words and symbolic gestures, Obama chose to ignore Wall Street crimes, reject bailouts for homeowners, oversee growing inequality and facilitate war crimes like US drones killing innocent civilians abroad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ce6de85-ecfb-3cf2-8a65-c6704610a2f5",
                                        "entry_id": "557d2614-faba-3c0a-9202-1e1b572aa375",
                                        "glosses": [
                                            "The ideology associated with the New Democrats and the Democratic Leadership Council."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d15b2eda-56d8-4a08-9dae-cda13a4e0580",
                        "source_entry_id": "982edba0-a26c-3f16-8b45-7ba7ac808a55",
                        "source_sense_id": "fb513bcf-92ce-3d21-8c31-ba22550394cc",
                        "target_lang_word": "néolibéralisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néolibéralisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16adff00-2453-34f4-8d5f-649502d79910",
                                        "entry_id": "aa63b54f-9359-37ba-95a5-5e192d817f08",
                                        "glosses": [
                                            "Doctrine prônant la plus grande liberté possible des entreprises et des forces du marché et la réduction au minimum de la taille et des interventions de l’État dans l'économie."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdc03682-a1a5-4585-9ed1-18491c90bf40",
                                                "sense_id": "16adff00-2453-34f4-8d5f-649502d79910",
                                                "text": "D’où l’appel de Chavez, dont l’expérience controversée à la tête du Venezuela est considérée par ses partisans comme une alternative au néolibéralisme, une entreprise de redistribution des richesses."
                                            },
                                            {
                                                "example_id": "354e1647-db16-4abd-a334-7b1c4fab73eb",
                                                "sense_id": "16adff00-2453-34f4-8d5f-649502d79910",
                                                "text": "Souvent considérée comme l’avant-garde du néolibéralisme international, la Banque mondiale n’a pas vraiment la réputation d’être l’amie des pauvres."
                                            },
                                            {
                                                "example_id": "5dc0818d-2d69-43ec-a0b4-f9fb40fda1e2",
                                                "sense_id": "16adff00-2453-34f4-8d5f-649502d79910",
                                                "text": "Considérant que le consensus libéral n’est pas assez favorable au business, elle vise à la dérégulation totale de l’industrie et de l’agriculture en promouvant une mutation autoritaire et illibérale du néolibéralisme."
                                            },
                                            {
                                                "example_id": "24f45837-6560-46c6-889f-bac296816f28",
                                                "sense_id": "16adff00-2453-34f4-8d5f-649502d79910",
                                                "text": "En mettant le pilotage de nos sociétés dans les mains des forces économiques, le néolibéralisme a réduit à peau de chagrin la capacité de nos États à répondre à des crises comme celle du Covid."
                                            },
                                            {
                                                "example_id": "6a820dd7-650e-462d-a29b-869e75d52ac1",
                                                "sense_id": "16adff00-2453-34f4-8d5f-649502d79910",
                                                "text": "Benquet et Bourgeon, qui distinguent le libertarianisme du néo-liberalisme, avec lequel il est souvent confondu en France, expliquent comment un vaste réseau de think tanks libertariens a été mis en place depuis l’ère Thatcher et a pris son essor autour du Brexit."
                                            },
                                            {
                                                "example_id": "811f591e-2f14-4779-9d40-41e249e91949",
                                                "sense_id": "16adff00-2453-34f4-8d5f-649502d79910",
                                                "text": "Des tabous ont été brisés, l’UE a fait le deuil du néolibéralisme. Aujourd’hui, en Europe, on peut parler de politique industrielle sans se prendre des tomates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2b8b043-d947-4413-802f-d247e8e1686c",
                        "source_entry_id": "982edba0-a26c-3f16-8b45-7ba7ac808a55",
                        "source_sense_id": "fb513bcf-92ce-3d21-8c31-ba22550394cc",
                        "target_lang_word": "neoliberalismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neoliberalismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "1405d3cd-e163-371c-acdf-b90f2c72e34c",
                                        "entry_id": "f4e781be-0bbf-3053-8052-15d3de283f25",
                                        "glosses": [
                                            "Variante moderna del liberalismo, que enfatiza la necesidad de desregular la actividad económica como requisito imprescindible del progreso social y económico."
                                        ],
                                        "tags": [
                                            "Política",
                                            "con frecuencia despectivo"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab7fdf0a-1ec0-465c-9346-086dfa5b0331",
                        "source_entry_id": "982edba0-a26c-3f16-8b45-7ba7ac808a55",
                        "source_sense_id": "fb513bcf-92ce-3d21-8c31-ba22550394cc",
                        "target_lang_word": "Neoliberalismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neoliberalismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b424295a-1119-313f-9eef-eac12ac56d3a",
                                        "entry_id": "aed37adf-bba7-386b-8416-7133fb334b8e",
                                        "glosses": [
                                            "sozialphilosophisches und wirtschaftspolitisches Konzept, das auf dem klassischen Liberalismus und der neoklassischen Theorie basiert und den Einfluss des Staates auf das Wirtschaftsgeschehen minimieren will, im Unterschied zum Laissez-faire des klassischen Liberalismus allerdings ein regulierendes Eingreifen des Staates zur Sicherstellung funktionierender Märkte als notwendig ansieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e134806d-0c97-403e-b43b-4592368f4616",
                                                "sense_id": "b424295a-1119-313f-9eef-eac12ac56d3a",
                                                "text": "Der Begriff Neoliberalismus ist ursprünglich eine Selbstbezeichnung, wird aber heutzutage nahezu ausschließlich von dessen Kritikern verwendet. Die Befürworter sprechen in der Regel von liberaler Wirtschaftspolitik."
                                            },
                                            {
                                                "example_id": "e3f8d235-8984-48d8-80ba-fd7288b98162",
                                                "sense_id": "b424295a-1119-313f-9eef-eac12ac56d3a",
                                                "text": "„Die Jahrzehnte des Neoliberalismus waren geprägt vom Leitbild des Jobnomaden.“"
                                            },
                                            {
                                                "example_id": "4fbc5387-1c7f-4256-86fa-3fc6e36c97b4",
                                                "sense_id": "b424295a-1119-313f-9eef-eac12ac56d3a",
                                                "text": "„Seit meiner Geburt, mein Freund! Gunna hat oft zu mir gesagt, du bist verrückt, Ási, die Partei zu wählen, die die Bauern immer verachtet hat und nie mehr als in den letzten fünfzehn, zwanzig Jahren, in denen sie sich dem Neoliberalismus verschrieben hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13f54705-f611-4fd3-91a7-bb78d39ed782",
                        "source_entry_id": "982edba0-a26c-3f16-8b45-7ba7ac808a55",
                        "source_sense_id": "fb513bcf-92ce-3d21-8c31-ba22550394cc",
                        "target_lang_word": "неолиберализм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неолиберализм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ea6d1a8d-81b7-3bcf-879d-4b882fdb0ae4",
                                        "entry_id": "865acdd4-caa5-34f1-a1c6-ab9eb73c955d",
                                        "glosses": [
                                            "полит., экон. совокупность взглядов и действий, направленных на предоставление дальнейшей свободы в сфере общественно-политической жизни и производства, на ограничение контроля над ними со стороны государства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d3d4a3b-be9d-4c59-8fdd-86efa2c55829",
                                                "sense_id": "ea6d1a8d-81b7-3bcf-879d-4b882fdb0ae4",
                                                "text": "Политика Международного валютного фонда и Всемирной торговой организации, в соответствии с духом и буквой неолиберализма, требует от стран международного сообщества, с одной стороны, создания гибких и мобильных национальных рынков труда, сокращения социальных и государственных расходов, с другой, снятия всевозможных национальных препятствий международной циркуляции капиталов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
