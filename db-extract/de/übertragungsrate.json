                "senses": [
                    {
                        "sense_id": "5c80a1d4-f79e-3f01-8e6e-0a68ec5d9a11",
                        "entry_id": "79b4e15b-a533-352d-b286-6b26612212e9",
                        "glosses": [
                            "digitale Datenmenge, die innerhalb einer Zeiteinheit über einen Übertragungskanal erfolgreich gesendet wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec86779c-434a-4d6d-b385-cd7a8baffea7",
                                "sense_id": "5c80a1d4-f79e-3f01-8e6e-0a68ec5d9a11",
                                "text": "„Moderne Internetanschlüsse (VDSL) erreichen Übertragungsraten von bis zu 50 Megabit je Sekunde.“"
                            },
                            {
                                "example_id": "e7509751-520e-4242-8cbd-2adf2a49ab46",
                                "sense_id": "5c80a1d4-f79e-3f01-8e6e-0a68ec5d9a11",
                                "text": "„Die Technik ermöglicht theoretisch eine Übertragungsrate von 100 Megabit pro Sekunde und ist somit schneller als ein stationärer Internetanschluss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a1f2186b-c30f-335e-a06d-34b065b0584f",
                        "entry_id": "79b4e15b-a533-352d-b286-6b26612212e9",
                        "glosses": [
                            "die Rate, mit der sich eine ansteckende Krankheit verbreitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88f951c1-9d96-4918-be54-f697014440e2",
                                "sense_id": "a1f2186b-c30f-335e-a06d-34b065b0584f",
                                "text": "„Dann gibt es mehr Mücken und die Übertragungsrate nimmt zu.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
