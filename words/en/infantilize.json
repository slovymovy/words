            "senses": [
                {
                    "sense_id": "f9c0c8ed-4477-3881-a79d-64a7efcec497",
                    "sense_definition": "To treat a person like a child, often in a way that is patronizing or disrespectful.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "treating_as_child",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager tends to <w>infantilize</w> his employees by speaking to them in a condescending tone."
                        },
                        {
                            "text": "It is frustrating when adults <w>infantilize</w> the elderly by making all their decisions for them."
                        }
                    ],
                    "synonyms": [
                        "patronize",
                        "condescend"
                    ],
                    "antonyms": [
                        "adultify"
                    ],
                    "common_phrases": [
                        "infantilize employees",
                        "infantilize adults"
                    ]
                },
                {
                    "sense_id": "492c7335-76cc-3948-8b0b-549a03c9b748",
                    "sense_definition": "To reduce a person to the state or status of an infant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "treating_as_child",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strict rules of the institution served to <w>infantilize</w> the residents, stripping them of their independence."
                        },
                        {
                            "text": "Some critics argue that modern media can <w>infantilize</w> the public by oversimplifying complex political issues."
                        }
                    ],
                    "antonyms": [
                        "adultify"
                    ]
                }
            ]
        }
    ]
