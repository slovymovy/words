                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a2c7c2d-d00a-3483-81df-2f36da8d8b98",
                        "entry_id": "b62af39d-5658-3ed4-9a55-a1b9654ccc91",
                        "glosses": [
                            "слегка поколебать, шевельнуть; привести в лёгкое движение"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7eafb242-759e-4115-a38f-20454a03072c",
                        "source_entry_id": "b62af39d-5658-3ed4-9a55-a1b9654ccc91",
                        "source_sense_id": "4a2c7c2d-d00a-3483-81df-2f36da8d8b98",
                        "target_lang_word": "stir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd4a281b-3ccd-37f1-b6b4-ff7d7431fc7c",
                                        "entry_id": "45858ae9-8720-3f74-94ef-60c036076172",
                                        "glosses": [
                                            "To disturb the relative position of the particles (of a liquid or similar) by passing an object through it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b590522-9969-4472-a274-9b70bc5d4c26",
                                                "sense_id": "fd4a281b-3ccd-37f1-b6b4-ff7d7431fc7c",
                                                "text": "She stirred the pudding with a spoon."
                                            },
                                            {
                                                "example_id": "4673ad20-531d-41f1-bd6f-33d377b6afe7",
                                                "sense_id": "fd4a281b-3ccd-37f1-b6b4-ff7d7431fc7c",
                                                "text": "He stirred his coffee so the sugar wouldn't stay at the bottom."
                                            },
                                            {
                                                "example_id": "dfad5cc3-49b0-4528-9fcb-1d283953ede6",
                                                "sense_id": "fd4a281b-3ccd-37f1-b6b4-ff7d7431fc7c",
                                                "text": "My minde is troubled, like a Fountaine stir'd, / And I my selfe see not the bottome of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40236221-d324-39c8-aa65-0ce51b129f17",
                                        "entry_id": "45858ae9-8720-3f74-94ef-60c036076172",
                                        "glosses": [
                                            "To disturb the content of (a container) by passing an object through it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dba4a27-9353-4b42-a693-44586b58a679",
                                                "sense_id": "40236221-d324-39c8-aa65-0ce51b129f17",
                                                "text": "Would you please stir this pot so that the chocolate doesn't burn?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15ffc9ef-c730-3e0d-a199-60026c86142b",
                                        "entry_id": "45858ae9-8720-3f74-94ef-60c036076172",
                                        "glosses": [
                                            "To emotionally affect; to touch, to move."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3e0e36b-4d3f-4229-8ea3-87a30216baed",
                                                "sense_id": "15ffc9ef-c730-3e0d-a199-60026c86142b",
                                                "text": "And what delights can equal those\n⁠That stir the spirit’s inner deeps,\n⁠When one that loves but knows not, reaps\nA truth from one that loves and knows?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe5cc83-a4b3-35f8-9c2c-9eca76ec31f1",
                                        "entry_id": "45858ae9-8720-3f74-94ef-60c036076172",
                                        "glosses": [
                                            "To incite to action."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9aa80f8-f693-426e-a754-689b96fa5128",
                                                "sense_id": "dfe5cc83-a4b3-35f8-9c2c-9eca76ec31f1",
                                                "text": "An Ate, stirring him to bloud and strife […]"
                                            },
                                            {
                                                "example_id": "5c3b5440-5d00-4398-b50b-555b09420ce1",
                                                "sense_id": "dfe5cc83-a4b3-35f8-9c2c-9eca76ec31f1",
                                                "text": "The Soldiers love her Brother’s Memory; / And for her sake some Mutiny will stir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bae7e946-cf1b-3246-ab6e-e894cf416aba",
                                        "entry_id": "45858ae9-8720-3f74-94ef-60c036076172",
                                        "glosses": [
                                            "To bring into debate; to agitate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c2caf6f-6d5b-4dcf-9252-c5550da12a21",
                                                "sense_id": "bae7e946-cf1b-3246-ab6e-e894cf416aba",
                                                "text": "Preserue the rights of thy place, but stirre not questions of Iurisdiction : and rather assume thy right in silence, and de facto, then voice it with claimes, and challenges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9433a345-3029-37f6-b599-ab73ff35b365",
                                        "entry_id": "45858ae9-8720-3f74-94ef-60c036076172",
                                        "glosses": [
                                            "To disturb, to disrupt."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ab382e1-b058-4012-af28-6cd00bb19e30",
                                                "sense_id": "9433a345-3029-37f6-b599-ab73ff35b365",
                                                "text": "They ſay he is the King of Perſea.\nBut if he dare attempt to ſtir your ſiege,\nTwere requiſite he ſhould be ten times more,\nFor all fleſh quakes at your magnificence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edc934e4-74b2-3804-b745-8efde0df8e26",
                                        "entry_id": "45858ae9-8720-3f74-94ef-60c036076172",
                                        "glosses": [
                                            "To change the place of in any manner; to move."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ee0f1ff-05f8-4e7e-9d4a-acd5af8d2169",
                                                "sense_id": "edc934e4-74b2-3804-b745-8efde0df8e26",
                                                "text": "[…] notwithstanding the swelling of my Foot, so that I had never yet in five days been able to stir it, but as it was lifted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06be90cb-353e-3265-a5ef-f51e5ed3e69b",
                                        "entry_id": "45858ae9-8720-3f74-94ef-60c036076172",
                                        "glosses": [
                                            "To begin to move, especially gently, from a still or unmoving position."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4095dc73-0b89-4460-ae57-584bc8cf57af",
                                                "sense_id": "06be90cb-353e-3265-a5ef-f51e5ed3e69b",
                                                "text": "And especially if they happen to have any superior character or possessions in this world, they fancy they have a right to talk freely upon everything that stirs or appears[…]"
                                            },
                                            {
                                                "example_id": "49681b1a-e157-4be9-ab06-19a0b660cfbb",
                                                "sense_id": "06be90cb-353e-3265-a5ef-f51e5ed3e69b",
                                                "text": "I had not strength to stir or strive, / But felt that I was still alive— […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10d8e0af-7767-3130-80b0-8dcfcebd62bf",
                                        "entry_id": "45858ae9-8720-3f74-94ef-60c036076172",
                                        "glosses": [
                                            "Of a feeling or emotion: to rise, begin to be felt."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10ef1f72-f99d-4a19-81ec-36a05582384b",
                                                "sense_id": "10d8e0af-7767-3130-80b0-8dcfcebd62bf",
                                                "text": "That night he was almost too happy to sleep, and so much love stirred in his little sawdust heart that it almost burst."
                                            },
                                            {
                                                "example_id": "4953a439-c265-492f-9f3f-94870bd81b1e",
                                                "sense_id": "10d8e0af-7767-3130-80b0-8dcfcebd62bf",
                                                "text": "Though as I said it, glibly, reassuringly, I knew that I lied, and a little snake of guilt stirred and began to uncoil slightly, guilt and its constant companion deceit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a5ef1b9-c9e0-3023-9e01-2aa887d5deb1",
                                        "entry_id": "45858ae9-8720-3f74-94ef-60c036076172",
                                        "glosses": [
                                            "To be in motion; to be active or bustling; to exert or busy oneself."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e772c0fd-8004-480d-b548-2b4173be0937",
                                                "sense_id": "7a5ef1b9-c9e0-3023-9e01-2aa887d5deb1",
                                                "text": "All are not fit with them to stir and toil."
                                            },
                                            {
                                                "example_id": "b9962666-0c01-44ce-bf0e-a68eee63ef10",
                                                "sense_id": "7a5ef1b9-c9e0-3023-9e01-2aa887d5deb1",
                                                "text": "Meanwhile, the friends of the unfortunate exile, far from resenting his unjust suspicions, were stirring anxiously in his behalf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16895796-f95d-31e9-9856-edd6851bb773",
                                        "entry_id": "45858ae9-8720-3f74-94ef-60c036076172",
                                        "glosses": [
                                            "To rise from sleep or unconsciousness."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2be5b19e-62e2-463e-9360-d4b7983c8fb1",
                                                "sense_id": "16895796-f95d-31e9-9856-edd6851bb773",
                                                "text": "“Mid-Lent, and the Enemy grins,” remarked Selwyn as he started for church with Nina and the children. Austin, knee-deep in a dozen Sunday supplements, refused to stir; poor little Eileen was now convalescent from grippe, but still unsteady on her legs; her maid had taken the grippe, and now moaned all day: “Mon dieu! Mon dieu! Che fais mourir!”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c95d3dd-b523-39bd-a031-2b130ea5ec9f",
                                        "entry_id": "c0e8db0d-2fc3-30ec-b965-8539e90c3f2e",
                                        "glosses": [
                                            "The act or result of stirring (moving around the particles of a liquid etc.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd728970-0362-44a7-9984-2e5dce4eac36",
                                                "sense_id": "2c95d3dd-b523-39bd-a031-2b130ea5ec9f",
                                                "text": "Can you give the soup a little stir?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1906a21d-304e-3376-ab60-cc8ae97bf1ab",
                                        "entry_id": "c0e8db0d-2fc3-30ec-b965-8539e90c3f2e",
                                        "glosses": [
                                            "agitation; tumult; bustle; noise or various movements."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a5db571-e48f-4d95-b366-9bc51ff18bc5",
                                                "sense_id": "1906a21d-304e-3376-ab60-cc8ae97bf1ab",
                                                "text": "1668, John Denham, Of Prudence (poem).\nWhy all these words, this clamour, and this stir?"
                                            },
                                            {
                                                "example_id": "1342d1b9-7112-40f4-a5b9-377905fcf229",
                                                "sense_id": "1906a21d-304e-3376-ab60-cc8ae97bf1ab",
                                                "text": "Consider, after so much stir about genus and species, how few words we have yet settled definitions of."
                                            },
                                            {
                                                "example_id": "bcffb742-96e2-40cd-a8de-549899d7c8c8",
                                                "sense_id": "1906a21d-304e-3376-ab60-cc8ae97bf1ab",
                                                "text": "Meantime, the train went on to Brighton without further incident. No small stir was caused by its arrival with No. 61 at its head, resplendent with \"East London Line Special\" head boards, which at once caught the eye of William Stroudley, who was observing the traffic working from his office window."
                                            },
                                            {
                                                "example_id": "42c1bf86-dfd6-4eeb-a487-9cdfbb1bcfb5",
                                                "sense_id": "1906a21d-304e-3376-ab60-cc8ae97bf1ab",
                                                "text": "When the long, hot journey drew to its end and the train slowed down for the last time, there was a stir in Jessamy’s carriage. People began to shake crumbs from their laps and tidy themselves up a little."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "340d2f25-b2ca-31fb-b389-0cf0558f1730",
                                        "entry_id": "c0e8db0d-2fc3-30ec-b965-8539e90c3f2e",
                                        "glosses": [
                                            "Public disturbance or commotion; tumultuous disorder; seditious uproar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c387327a-697b-4871-ae6b-4f0d3796583a",
                                                "sense_id": "340d2f25-b2ca-31fb-b389-0cf0558f1730",
                                                "text": "Being advertised of some stirs raised by his unnatural sons in England."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa0e3f3e-760c-32eb-aa4f-138008084678",
                                        "entry_id": "c0e8db0d-2fc3-30ec-b965-8539e90c3f2e",
                                        "glosses": [
                                            "Agitation of thoughts; conflicting passions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "700d3078-de0d-336c-8a2d-6c67751a653f",
                                        "entry_id": "4024d75a-9f81-3bf9-b0b5-587f2e83e33f",
                                        "glosses": [
                                            "Jail; prison."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fa546e4-404c-4e4c-9b25-ee2c7c844147",
                                                "sense_id": "700d3078-de0d-336c-8a2d-6c67751a653f",
                                                "text": "He's going to be spending maybe ten years in stir."
                                            },
                                            {
                                                "example_id": "e7e6e25b-dad2-4f18-9b51-ea285f67c8a6",
                                                "sense_id": "700d3078-de0d-336c-8a2d-6c67751a653f",
                                                "text": "The Bat—they called him the Bat.[…]. He'd never been in stir, the bulls had never mugged him, he didn't run with a mob, he played a lone hand, and fenced his stuff so that even the fence couldn't swear he knew his face."
                                            },
                                            {
                                                "example_id": "33ca2d08-8a1b-4385-b40e-8b6697a15b8a",
                                                "sense_id": "700d3078-de0d-336c-8a2d-6c67751a653f",
                                                "text": "Sing Sing was a tough joint in those days, one of the five worst stirs in the United States."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
