                    }
                ],
                "senses": [
                    {
                        "sense_id": "48049d3e-ed85-3131-8b00-f8e83669effa",
                        "entry_id": "9868926c-35b5-3fce-84c3-38c2e67202c3",
                        "glosses": [
                            "A low sound associated with extended suffering, sorrow, and toil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4a7adfe-e571-48b1-94b2-a4b5d6750e0d",
                                "sense_id": "48049d3e-ed85-3131-8b00-f8e83669effa",
                                "text": "From the nearby rail yards came clangings, groanings, chuggings."
                            }
                        ]
                    },
                    {
                        "sense_id": "db704efa-035a-30ec-9afa-36ec178a1ea8",
                        "entry_id": "9868926c-35b5-3fce-84c3-38c2e67202c3",
                        "glosses": [
                            "Ellipsis of groaning time (“childbirth, labour”)."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis",
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8cd625a-a9cf-4bb6-b23f-1f51077191ad",
                        "source_entry_id": "9868926c-35b5-3fce-84c3-38c2e67202c3",
                        "source_sense_description": "sound",
                        "target_lang_word": "Ächzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ächzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4cffea07-61d5-3969-906d-5e4e3064b41e",
                                        "entry_id": "c33ac2ba-2254-34e9-9694-d7b55dfe2e66",
                                        "glosses": [
                                            "ausgestoßene Laute beim Ertragen von Schmerz, Leid, Anstrengung oder Last"
                                        ],
                                        "tags": [
                                            "von Menschen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebe2b70b-9f5c-464f-bad3-3ff9e57890c5",
                                                "sense_id": "4cffea07-61d5-3969-906d-5e4e3064b41e",
                                                "text": "Das Klavier wurde unter Ächzen und Fluchen die engen Holztreppen hochgewuchtet."
                                            },
                                            {
                                                "example_id": "45449c9e-808b-4288-87c9-7ae9e3a75a4c",
                                                "sense_id": "4cffea07-61d5-3969-906d-5e4e3064b41e",
                                                "text": "Sie schob sich unter Ächzen und Stöhnen langsam vorwärts."
                                            },
                                            {
                                                "example_id": "7eca8a75-f937-42d1-aedf-9a4d31943ec0",
                                                "sense_id": "4cffea07-61d5-3969-906d-5e4e3064b41e",
                                                "text": "\"Wie groß sind die Qualen einer Mutter, wenn sie das Ächzen ihres kleinen Kindes hört, das unter den Martern seiner Krankheit nicht auszudrücken vermag, was es fühlt…\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02870a3c-5b28-3525-b839-01023443d627",
                                        "entry_id": "c33ac2ba-2254-34e9-9694-d7b55dfe2e66",
                                        "glosses": [
                                            "Geräusch bei Belastung"
                                        ],
                                        "tags": [
                                            "von Bauten",
                                            "Gebälk",
                                            "Holz und anderen Materialien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecc5578b-419d-490f-a895-293782790804",
                                                "sense_id": "02870a3c-5b28-3525-b839-01023443d627",
                                                "text": "Die Waldeinsamkeit, das Ächzen der Kiefernäste. Ich träumte davon, eines Tages für immer im Gebirge zu bleiben."
                                            },
                                            {
                                                "example_id": "a782f43e-68a3-4455-8f59-e7cff0c58c15",
                                                "sense_id": "02870a3c-5b28-3525-b839-01023443d627",
                                                "text": "Mit einem urlauten Ächzen, gefolgt von einem markerschütternden Knall, rast auch der Nordturm des World Trade Centers in sich zusammen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af58bb8c-b6a1-4f81-9cf4-d4e179e0ba30",
                        "source_entry_id": "9868926c-35b5-3fce-84c3-38c2e67202c3",
                        "source_sense_description": "sound",
                        "target_lang_word": "Geächze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geächze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1c7c96a-7002-31a7-a8e9-f28915341a70",
                                        "entry_id": "25b21d10-a212-3e64-bd5f-424065893cfd",
                                        "glosses": [
                                            "Geräusche, die jemand (unfreiwillig) von sich gibt, wenn er sich körperlich anstrengt oder leidet"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "667fe14e-a5ea-4111-920c-53a6f85d4425",
                                                "sense_id": "d1c7c96a-7002-31a7-a8e9-f28915341a70",
                                                "text": "„Jetzt brach sie in ein hysterisches Weinen aus, verbunden mit einem jammervollen Geächze und Gewimmer, das so lange dauerte, bis das Klopfen sechsmal wiederholt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b6737c9-99e6-409a-b23e-f25c378b890d",
