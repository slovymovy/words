                    }
                ],
                "senses": [
                    {
                        "sense_id": "80ebfedb-0db6-3c2c-9ded-38f12bf448fe",
                        "entry_id": "66c20db9-3d0c-3910-b246-7a3af296034e",
                        "glosses": [
                            "Nom usuel de Acorus calamus plante de la famille des Acoraceae, originaire des marais de l’est de la Chine jusqu’à l’Inde et dont le rhizome est utilisé à des finalités alimentaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4010dc5-a208-4d0d-8fb6-4097b9f700c9",
                                "sense_id": "80ebfedb-0db6-3c2c-9ded-38f12bf448fe",
                                "text": "Le rhizome de l’acore a été utilisé surtout comme médicament presque partout ou la plante était présente."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2edf7e9-2ca5-4d53-8c44-d066250cf776",
                        "source_entry_id": "66c20db9-3d0c-3910-b246-7a3af296034e",
                        "source_sense_id": "80ebfedb-0db6-3c2c-9ded-38f12bf448fe",
                        "target_lang_word": "Kalmus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalmus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5c1f4d9-1416-3164-a38c-d21d9da546bd",
                                        "entry_id": "ded09ce8-95fb-3579-8b64-60d9d1a67d72",
                                        "glosses": [
                                            "schilfartige Sumpfpflanze, aus deren aromatisch riechendem Wurzelstock (Rhizom) ein Öl gewonnen wird (Acorus calamus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af34d29-39f0-431d-a949-0660b9b7b394",
                                                "sense_id": "e5c1f4d9-1416-3164-a38c-d21d9da546bd",
                                                "text": "„Ein Drittel des Teiches ist von Schilf, Kalmus, Schwertlilie, Rohr und Pumpkeule erfüllt, die ein undurchdringliches Dickicht bilden.“"
                                            },
                                            {
                                                "example_id": "59003463-88e7-4167-b109-940200da7ff8",
                                                "sense_id": "e5c1f4d9-1416-3164-a38c-d21d9da546bd",
                                                "text": "„Um den See herum breitet sich Ödland mit versteckten, halb zugewachsenen Tümpeln aus, Bäume und Sträucher, die niemand zurechtstutzt, Schilf, Kalmus, gelbe Schwertlilien, dichtes Brombeergestrüpp, seltene Pflanzen; im Quellwasser sprießt die Brunnenkresse.“"
                                            },
                                            {
                                                "example_id": "c755060e-b7f4-4457-93f6-cf8616e74f2d",
                                                "sense_id": "e5c1f4d9-1416-3164-a38c-d21d9da546bd",
                                                "text": "„Draußen aber fuhr Wolf einen großen Wagen mit Binsen und Kalmus heran, den er am Ufer des nahen Teiches geschnitten, um den Fußboden zu bestreuen.“"
                                            },
                                            {
                                                "example_id": "e9e300c0-c2e0-4b99-b704-1de824a4f17a",
                                                "sense_id": "e5c1f4d9-1416-3164-a38c-d21d9da546bd",
                                                "text": "„Über den Wipfeln des westliche Haines winket uns freundlich der rötliche Schein./Unter den Zweigen des östlichen Haines säuselt der Kalmus im rötlichen Schein…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcffed8a-6b85-4c5a-80fa-eb8cff1ad295",
                        "source_entry_id": "66c20db9-3d0c-3910-b246-7a3af296034e",
