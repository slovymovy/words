                "senses": [
                    {
                        "sense_id": "797a12a2-3921-3204-ba07-0d0930f0162e",
                        "entry_id": "f109c7c5-e859-3d49-acd4-9f4276e61161",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1f580d0-8ee7-4c6e-bb38-e28fd477bc3e",
                                "sense_id": "797a12a2-3921-3204-ba07-0d0930f0162e",
                                "text": "Frau Kolf ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "23cde964-01e0-4751-aa96-13ee25b4b624",
                                "sense_id": "797a12a2-3921-3204-ba07-0d0930f0162e",
                                "text": "Herr Kolf wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "76382292-bf6c-40e4-95b0-008de8ac42f9",
                                "sense_id": "797a12a2-3921-3204-ba07-0d0930f0162e",
                                "text": "Die Kolfs fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "b781bd7e-e281-4cd2-bdcd-8868c199e027",
                                "sense_id": "797a12a2-3921-3204-ba07-0d0930f0162e",
                                "text": "Der Kolf trägt nie die Pullover, die die Kolf ihm strickt."
                            },
                            {
                                "example_id": "b6726121-d6a4-4391-98e2-edcc88d5b761",
                                "sense_id": "797a12a2-3921-3204-ba07-0d0930f0162e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kolf kommt, geht der Herr Kolf.“"
                            },
                            {
                                "example_id": "ea887d0f-8205-45bf-9925-ef774f8db2f8",
                                "sense_id": "797a12a2-3921-3204-ba07-0d0930f0162e",
                                "text": "Kolf kommt und geht."
                            },
                            {
                                "example_id": "e4811998-487a-4139-8f44-0065f9dfc4d1",
                                "sense_id": "797a12a2-3921-3204-ba07-0d0930f0162e",
                                "text": "Kolfs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
