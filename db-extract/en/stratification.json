                                "target_senses": [
                                    {
                                        "sense_id": "b207b503-e2d4-3198-a86e-761940a6cd75",
                                        "entry_id": "5dfc6e65-4cc3-36db-86e9-ce151534a9aa",
                                        "glosses": [
                                            "Aufbewahrung oder Lagerhaltung von Gegenständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a0452e-06fe-4481-a120-74a982870a80",
                                                "sense_id": "b207b503-e2d4-3198-a86e-761940a6cd75",
                                                "text": "Es gibt keine besonderen Hinweise zur Lagerung von Reifen."
                                            },
                                            {
                                                "example_id": "5a1a68fc-6e6b-43f4-b423-b6f3557197cc",
                                                "sense_id": "b207b503-e2d4-3198-a86e-761940a6cd75",
                                                "text": "Die Lebensmittel nehmen bei der Lagerung bei zu hohen Temperaturen schnell Schaden."
                                            },
                                            {
                                                "example_id": "874609a8-c2d3-4160-8a98-8121b5bac45a",
                                                "sense_id": "b207b503-e2d4-3198-a86e-761940a6cd75",
                                                "text": "Eine weitere Lagerung des radioaktiven Materials im Forschungszentrum Dresden-Rossendorf hätte erhebliche kostenintensive Umrüstungen zur Bewältigung der technischen Herausforderungen einer solchen Lagerung erforderlich gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ef0df5c-9c83-39ae-a742-e03b3250b767",
                                        "entry_id": "5dfc6e65-4cc3-36db-86e9-ce151534a9aa",
                                        "glosses": [
                                            "die Anordnung von Gesteinen oder Sedimenten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7d28af2-aa79-4bcd-be0b-0d065196a82c",
                                                "sense_id": "9ef0df5c-9c83-39ae-a742-e03b3250b767",
                                                "text": "Ein Geologe oder eine Geologin interessiert sich für die Gesteine, ihr Alter, ihre Lagerung, ihre chemische Zusammensetzung und für ihre Abfolge und Verbreitung in der Landschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3627fab9-8203-38ba-8577-d3fdf46ff72a",
                                        "entry_id": "5dfc6e65-4cc3-36db-86e9-ce151534a9aa",
                                        "glosses": [
