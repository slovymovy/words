                "senses": [
                    {
                        "sense_id": "43e50be6-d785-3f02-b25e-c18fb9139e47",
                        "entry_id": "0b3752b3-00a1-33c1-b845-d5b184151d3b",
                        "glosses": [
                            "тот, кто проводит археологические раскопки, работает на раскопе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "686292e0-c091-4dad-9d66-a0946e5b8305",
                                "sense_id": "43e50be6-d785-3f02-b25e-c18fb9139e47",
                                "text": "Клад в рутинной работе раскопщиков ― событие чрезвычайное. Это праздник. Позднее находку положат в музее на бархат или закроют в тяжёлом сейфе."
                            },
                            {
                                "example_id": "a5b15a15-3934-4722-a7a2-060d8d870f1e",
                                "sense_id": "43e50be6-d785-3f02-b25e-c18fb9139e47",
                                "text": "Вскоре раскопщики открыли ряд могил с основанием возвышающейся платформы со строением."
                            },
                            {
                                "example_id": "3499a925-d284-455f-b158-0c5a4f55282a",
                                "sense_id": "43e50be6-d785-3f02-b25e-c18fb9139e47",
                                "text": "Она была прекрасным археологом-раскопщиком, хотя и не публиковала научных статей на археологические темы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd1f879d-fa63-4e41-856e-b834b4c2bdd8",
                        "source_entry_id": "0b3752b3-00a1-33c1-b845-d5b184151d3b",
                        "source_sense_id": "43e50be6-d785-3f02-b25e-c18fb9139e47",
                        "target_lang_word": "Ausgräber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausgräber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6ee8382-9be8-36db-814f-a104123bd23d",
                                        "entry_id": "271af897-484a-36c4-ba8a-48c8051f9026",
                                        "glosses": [
                                            "Archäologe, der eine Ausgrabung vornimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4983499-a194-42ce-ab18-8d421dcfc4c7",
                                                "sense_id": "a6ee8382-9be8-36db-814f-a104123bd23d",
                                                "text": "„Französische Ausgräber konnten nachweisen, dass der Kaiser innerhalb kurzer Zeit einen 160 mal 110 Meter großen Tempel auf dem Palatin errichten ließ.“"
                                            },
                                            {
                                                "example_id": "cb2c7325-02be-4312-b100-c09151e598c1",
                                                "sense_id": "a6ee8382-9be8-36db-814f-a104123bd23d",
                                                "text": "„Die undurchsichtigen Vorgänge von der Levanteküste haben bei Althistorikern, Ausgräbern und Kunstgeschichtlern Unbehagen ausgelöst.“"
                                            },
                                            {
                                                "example_id": "93db0c02-b7fa-4cae-9d38-92dfb197170f",
                                                "sense_id": "a6ee8382-9be8-36db-814f-a104123bd23d",
                                                "text": "„Die Ausgräber deckten rund 275000 Tierknochen auf, den größten Anteil bildeten Reste von Schweinen, Rindern, Schafen, Ziegen, Hunden, Pferden und Hühnern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
