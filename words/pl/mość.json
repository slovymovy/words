            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47576822-fcf9-38dd-a162-93376fe8a1d3",
                    "sense_definition": "dawny, pełen szacunku tytuł używany w odniesieniu do osób szlachetnie urodzonych lub władców",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tytuł",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wasza <w>mość</w> raczy wiedzieć, że sprawa jest już dawno rozstrzygnięta.",
                            "target_lang_translations": {
                                "ru": "Ваша <w>милость</w> изволит знать, что дело уже давно решено."
                            }
                        },
                        {
                            "text": "W dawnych czasach każdy szlachcic zwracał się do drugiego per wasza <w>mość</w>.",
                            "target_lang_translations": {
                                "ru": "В давние времена каждый шляхтич обращался к другому как ваша <w>милость</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wasza mość"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "używane w kontekście historycznym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "устаревший, почтительный титул, используемый при обращении к дворянам или правителям"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "милость",
                                "target_lang_sense_clarification": "в составе обращений типа 'ваша милость'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "425bffd5-a8f0-3d90-8856-019fc479a878",
                    "sense_definition": "element dawnych tytułów grzecznościowych",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tytuł",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W literaturze często spotyka się zwrot waszmość panie jako formę <w>mość</w> w tytule.",
                            "target_lang_translations": {
                                "ru": "В литературе часто встречается оборот 'ваша милость' как форма <w>милости</w> в титуле."
                            }
                        },
                        {
                            "text": "Tytułowanie kogoś przez wasza <w>mość</w> podkreślało wysoki status społeczny adresata.",
                            "target_lang_translations": {
                                "ru": "Обращение к кому-либо 'ваша <w>милость</w>' подчеркивало высокий социальный статус адресата."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "używane w kontekście historycznym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "компонент старинных вежливых обращений"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "милость",
                                "target_lang_sense_clarification": "как часть архаичных титулов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ff62e300-6a21-3e84-bb02-94fdf45adf53",
                    "sense_definition": "druga osoba liczby pojedynczej czasu teraźniejszego od czasownika <w>mościć</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "czynność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dlaczego ty zawsze tak starannie <w>mościsz</w> to legowisko dla swojego psa?",
                            "target_lang_translations": {
                                "ru": "Почему ты всегда так старательно <w>мостишь</w> это место для своей собаки?"
                            }
                        },
                        {
                            "text": "Kiedy <w>mościsz</w> sobie wygodne miejsce do spania, pamiętaj o ciepłym kocu.",
                            "target_lang_translations": {
                                "ru": "Когда <w>устилаешь</w> себе удобное место для сна, не забудь о теплом одеяле."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "второе лицо единственного числа настоящего времени от глагола 'mościć' (мостить, устилать)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мостишь",
                                "target_lang_sense_clarification": "от глагола 'мостить'"
                            },
                            {
                                "target_lang_word": "устилаешь",
                                "target_lang_sense_clarification": "в значении обустройства места для сна"
                            }
                        ]
                    }
                }
            ]
        }
