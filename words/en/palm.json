{
    "word_family": [
        "palmate",
        "palmist",
        "palmistry",
        "palmy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "441d66ae-aa64-379d-af0e-88c2f6b01d27",
                    "sense_definition": "The inner surface of the hand extending from the wrist to the base of the fingers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anatomy_hand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She rested her chin in the <w>palm</w> of her hand while she thought.",
                            "target_lang_translations": {
                                "ru": "Она оперлась подбородком на <w>ладонь</w>, задумавшись.",
                                "zh": "她思考时，用手的<w>掌心</w>托着下巴。"
                            }
                        },
                        {
                            "text": "The fortune teller asked to see my <w>palm</w> to read my future.",
                            "target_lang_translations": {
                                "ru": "Гадалка попросила показать мою <w>ладонь</w>, чтобы предсказать будущее.",
                                "zh": "算命先生让他看看我的<w>手掌</w>，好替我算一算未来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "palm of one's hand",
                        "read someone's palm",
                        "sweaty palms",
                        "itchy palm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренняя поверхность кисти руки от запястья до основания пальцев.",
                        "zh": "手从手腕到手指根部之间的内侧表面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ладонь",
                                "target_lang_sense_clarification": "часть руки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手掌",
                                "target_lang_sense_clarification": "手的内侧部分"
                            },
                            {
                                "target_lang_word": "掌心",
                                "target_lang_sense_clarification": "手掌中央的部位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6931d808-862c-355f-8f94-e29b47d1d013",
                    "sense_definition": "An unbranched evergreen tree with a crown of long feathered or fan-shaped leaves, typically found in tropical regions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "botany_tree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat in the shade of a tall <w>palm</w> on the sandy beach.",
                            "target_lang_translations": {
                                "ru": "Мы сидели в тени высокой <w>пальмы</w> на песчаном пляже.",
                                "zh": "我们坐在沙滩上一棵高高的<w>棕榈树</w>荫下。"
                            }
                        },
                        {
                            "text": "The island is covered in lush vegetation and coconut <w>palms</w>.",
                            "target_lang_translations": {
                                "ru": "Остров покрыт пышной растительностью и кокосовыми <w>пальмами</w>.",
                                "zh": "这座岛上覆盖着茂密的植被，还有许多椰<w>棕</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "palm tree"
                    ],
                    "common_phrases": [
                        "coconut palm",
                        "date palm",
                        "palm oil",
                        "palm frond"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неветвящееся вечнозеленое дерево с кроной из длинных перистых или веерообразных листьев, обычно растущее в тропических регионах.",
                        "zh": "一种不分枝的常绿树，树冠长有羽状或扇形长叶，通常生长在热带地区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пальма",
                                "target_lang_sense_clarification": "дерево"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "棕榈树",
                                "target_lang_sense_clarification": "热带常见的树"
                            },
                            {
                                "target_lang_word": "棕榈",
                                "target_lang_sense_clarification": "植物名称，常见简称"
                            },
                            {
                                "target_lang_word": "椰棕",
                                "target_lang_sense_clarification": "特指椰子树一类时"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88a3d98e-b4a4-34fc-9d47-97acc5ee1bde",
                    "sense_definition": "A unit of length based on the width of a hand, approximately 3 to 4 inches; historically used to measure the height of horses.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse stands fifteen <w>palms</w> high at the shoulder.",
                            "target_lang_translations": {
                                "ru": "Высота лошади в холке составляет пятнадцать <w>ладоней</w>.",
                                "zh": "这匹马肩高有十五<w>掌</w>。"
                            }
                        },
                        {
                            "text": "He estimated the width of the ledge to be about two <w>palms</w>.",
                            "target_lang_translations": {
                                "ru": "Он оценил ширину выступа примерно в две <w>ладони</w>.",
                                "zh": "他估计那块突沿的宽度大约有两<w>掌</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hand"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "modern usage typically uses 'hand' for horses"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица длины, основанная на ширине ладони, приблизительно от 7 до 10 см; исторически использовалась для измерения роста лошадей.",
                        "zh": "一种以手掌宽度为基础的长度单位，约三到四英寸，历史上常用于测量马的高度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ладонь",
                                "target_lang_sense_clarification": "мера длины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掌",
                                "target_lang_sense_clarification": "旧时以手掌宽度为基础的长度单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c620c973-484e-3f87-bb60-f123b873ef1d",
                    "sense_definition": "A branch or leaf of a palm tree, used historically as a symbol of victory, triumph, or rejoicing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "symbolism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victors were greeted with waving <w>palms</w> as they entered the city.",
                            "target_lang_translations": {
                                "ru": "Победителей приветствовали размахиванием <w>пальмовых ветвей</w>, когда они входили в город.",
                                "zh": "胜利者进城时，人们挥舞着<w>棕榈枝</w>欢迎他们。"
                            }
                        },
                        {
                            "text": "She bore the <w>palm</w> of victory after years of struggle.",
                            "target_lang_translations": {
                                "ru": "Она получила <w>пальму</w> первенства после долгих лет борьбы.",
                                "zh": "经过多年的奋斗，她终于赢得了<w>胜利的棕榈枝</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bear the palm"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly literary or historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ветвь или лист пальмового дерева, исторически используемые как символ победы, триумфа или ликования.",
                        "zh": "棕榈树的枝叶，历史上常被用作胜利、凯旋或欢庆的象征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пальмовая ветвь",
                                "target_lang_sense_clarification": "символ"
                            },
                            {
                                "target_lang_word": "пальма первенства",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "棕榈枝",
                                "target_lang_sense_clarification": "作为胜利或凯旋象征的棕榈树枝叶"
                            },
                            {
                                "target_lang_word": "胜利的棕榈枝",
                                "target_lang_sense_clarification": "文学性说法，表示胜利荣誉"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92ce9c57-29cb-3eb5-be79-5fcd7816e989",
                    "sense_definition": "To hide an object in the hand, especially when performing a magic trick or stealing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_hand_manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician managed to <w>palm</w> the coin without the audience noticing.",
                            "target_lang_translations": {
                                "ru": "Фокуснику удалось <w>спрятать в ладони</w> монету так, что зрители этого не заметили.",
                                "zh": "魔术师成功把硬币<w>藏在手心里</w>，观众却没有察觉。"
                            }
                        },
                        {
                            "text": "He tried to <w>palm</w> the note so the teacher would not see it.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>спрятать в ладони</w> записку, чтобы учитель её не увидел.",
                                "zh": "他想把纸条<w>藏在手心里</w>，不让老师看见。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "palm a card",
                        "palm a coin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спрятать предмет в ладони, особенно при выполнении фокуса или краже.",
                        "zh": "把某物藏在手里，尤指变魔术或偷窃时不让别人察觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спрятать в ладони",
                                "target_lang_sense_clarification": "незаметно удержать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "藏在手心里",
                                "target_lang_sense_clarification": "暗中把东西握在手里不让人看见"
                            },
                            {
                                "target_lang_word": "藏在掌中",
                                "target_lang_sense_clarification": "魔术或盗窃中把物件暗藏于掌中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72b16151-ab4f-3406-90c9-d318c6ac149a",
                    "sense_definition": "To hold or grip an object, such as a ball, with one hand without bending the fingers significantly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_hand_manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The basketball player has large enough hands to <w>palm</w> the ball easily.",
                            "target_lang_translations": {
                                "ru": "У баскетболиста достаточно большие руки, чтобы легко <w>удерживать ладонью</w> мяч.",
                                "zh": "这名篮球运动员手够大，能轻松地单手<w>抓住</w>球。"
                            }
                        },
                        {
                            "text": "He <w>palmed</w> the heavy stone and prepared to throw it.",
                            "target_lang_translations": {
                                "ru": "Он <w>обхватил ладонью</w> тяжелый камень и приготовился бросить его.",
                                "zh": "他单手<w>抓住</w>那块沉重的石头，准备扔出去。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Держать или схватить предмет, например мяч, одной рукой, не сгибая пальцы значительно.",
                        "zh": "用一只手握住某物，例如球，并且手指不需要明显弯曲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удерживать ладонью",
                                "target_lang_sense_clarification": "обхватить одной рукой"
                            },
                            {
                                "target_lang_word": "обхватить ладонью",
                                "target_lang_sense_clarification": "взять в руку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单手抓住",
                                "target_lang_sense_clarification": "不用明显弯曲手指而单手握住"
                            },
                            {
                                "target_lang_word": "单掌握住",
                                "target_lang_sense_clarification": "尤其指像抓篮球那样用一只手握住"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc873f6a-b601-38f1-8bb6-bae887f61d7f",
                    "sense_definition": "To touch, push, or deflect something using the open hand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_hand_manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalkeeper managed to <w>palm</w> the ball over the crossbar to save the goal.",
                            "target_lang_translations": {
                                "ru": "Вратарю удалось <w>отбить ладонью</w> мяч над перекладиной и спасти ворота.",
                                "zh": "守门员设法用手掌把球<w>托</w>过横梁，保住了球门。"
                            }
                        },
                        {
                            "text": "She raised her hand to <w>palm</w> the flying insect away from her face.",
                            "target_lang_translations": {
                                "ru": "Она подняла руку, чтобы <w>отмахнуться ладонью</w> от летящего насекомого.",
                                "zh": "她抬起手，想把那只飞虫从脸前<w>拍开</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Коснуться, толкнуть или отбить что-либо открытой ладонью.",
                        "zh": "用张开的手掌去碰、推开或挡开某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отбить ладонью",
                                "target_lang_sense_clarification": "спорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用手掌拍开",
                                "target_lang_sense_clarification": "用张开的手掌把东西挡开或击开"
                            },
                            {
                                "target_lang_word": "托开",
                                "target_lang_sense_clarification": "体育中用手掌把球托开或击开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bc29b62-95bd-3e43-8c31-fb390e7a0242",
                    "sense_definition": "To bribe someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corrupt official was <w>palmed</w> to ignore the violation.",
                            "target_lang_translations": {
                                "ru": "Коррумпированному чиновнику <w>дали на лапу</w>, чтобы он проигнорировал нарушение.",
                                "zh": "有人向那个腐败官员<w>行贿</w>，好让他对违规行为视而不见。"
                            }
                        },
                        {
                            "text": "They tried to <w>palm</w> the guard to gain entry to the building.",
                            "target_lang_translations": {
                                "ru": "Они попытались <w>дать на лапу</w> охраннику, чтобы попасть в здание.",
                                "zh": "他们试图向警卫<w>行贿</w>，好进入那栋大楼。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grease someone's palm"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дать взятку кому-либо.",
                        "zh": "向某人行贿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дать на лапу",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "подмазать",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "行贿",
                                "target_lang_sense_clarification": "正式说法"
                            },
                            {
                                "target_lang_word": "塞钱",
                                "target_lang_sense_clarification": "口语说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "24747341-1c26-3e6b-a870-f5d4bdf94a78",
                    "sense_definition": "A surname mainly of Scandinavian origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Palm</w> arrived late for the meeting.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Палм</w> опоздал на встречу.",
                                "zh": "<w>帕尔姆</w>先生开会迟到了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, в основном скандинавского происхождения.",
                        "zh": "一个主要源自斯堪的纳维亚地区的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Палм",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帕尔姆",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}