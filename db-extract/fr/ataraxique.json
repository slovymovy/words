                "senses": [
                    {
                        "sense_id": "75e13130-0519-3804-9528-23a34c75eba3",
                        "entry_id": "28bb82d5-6341-3fbf-b1cb-c0d4c9120828",
                        "glosses": [
                            "Relatif à l’ataraxie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01f3a6cd-f74b-46dc-9ec1-ef0bcf159272",
                                "sense_id": "75e13130-0519-3804-9528-23a34c75eba3",
                                "text": "Il y a des moments au cours de la journée où la vie s'éprouve sous un mode frénétique, d'autres moments se vivent sous un mode ataraxique."
                            },
                            {
                                "example_id": "249e9479-bacf-4d06-8f9d-2fd0410f1d40",
                                "sense_id": "75e13130-0519-3804-9528-23a34c75eba3",
                                "text": "La personne en deuil peut sembler ataraxique, ou dépressive, mais un cheminement intérieur se fait."
                            },
                            {
                                "example_id": "ea3100dc-855b-447d-8583-9492fafda657",
                                "sense_id": "75e13130-0519-3804-9528-23a34c75eba3",
                                "text": "Confronté à une salle un peu trop vide, il reste pourtant d’aplomb, « ataraxique » et considère que le peu de succès est « le lot des pionniers »."
                            }
                        ]
                    }
                ],
