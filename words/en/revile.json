            "senses": [
                {
                    "sense_id": "1ce32848-3a48-35c7-ab2b-6930fe09e6ac",
                    "sense_definition": "To attack someone with abusive or insulting language",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verbal_abuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician was <w>reviled</w> by the public for his controversial and dishonest actions.",
                            "target_lang_translations": {
                                "nl": "De politicus werd door het publiek <w>verguisd</w> vanwege zijn controversiële en oneerlijke daden."
                            }
                        },
                        {
                            "text": "Even when he was <w>reviled</w> by his enemies, he chose to remain silent and dignified.",
                            "target_lang_translations": {
                                "nl": "Zelfs toen hij door zijn vijanden werd <w>uitgescholden</w>, koos hij ervoor om stil en waardig te blijven."
                            }
                        }
                    ],
                    "synonyms": [
                        "defame"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand met beledigende of kwetsende taal aanvallen of bekritiseren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitschelden",
                                "target_lang_sense_clarification": "Iemand met scheldwoorden bewerken."
                            },
                            {
                                "target_lang_word": "verguizen",
                                "target_lang_sense_clarification": "Iemand publiekelijk met grote minachting behandelen of bekritiseren."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3735515c-a427-3649-ac37-ee531d45f7f8",
                    "sense_definition": "An act of reproach or abusive language",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verbal_abuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He endured every <w>revile</w> with a calm and steady expression on his face.",
                            "target_lang_translations": {
                                "nl": "Hij verdroeg elke <w>belediging</w> met een kalme en vaste uitdrukking op zijn gezicht."
                            }
                        },
                        {
                            "text": "The crowd shouted a final <w>revile</w> before the prisoner was led away from the square.",
                            "target_lang_translations": {
                                "nl": "De menigte schreeuwde een laatste <w>scheldpartij</w> voordat de gevangene van het plein werd weggeleid."
                            }
                        }
                    ],
                    "traits": [
