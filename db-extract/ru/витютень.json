                "senses": [
                    {
                        "sense_id": "1eda4b57-277b-3ce1-8742-6a5822fdfacf",
                        "entry_id": "38711212-bad2-393e-ac17-c2e5c0622844",
                        "glosses": [
                            "орнитол. птица рода голубей (Columba palumbus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa4a0077-5ffa-42c9-a50a-5631e8a9a4bd",
                                "sense_id": "1eda4b57-277b-3ce1-8742-6a5822fdfacf",
                                "text": "Из чащобы кустов, крывших дно балки, вырвались и прошли низом два витютня, с такими обтекаемыми, стремительными телами, что они казались не живыми созданиями, а крошечными реактивными самолётами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d16739c1-9a1a-4ed7-8ddb-38007226ffba",
                        "source_entry_id": "38711212-bad2-393e-ac17-c2e5c0622844",
                        "source_sense_id": "1eda4b57-277b-3ce1-8742-6a5822fdfacf",
                        "target_lang_word": "cushat",
                        "target_lang_code": "en",
