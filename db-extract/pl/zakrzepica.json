                    {
                        "translation_id": "688cb0c3-1cea-49dd-8f84-f31f5e90fe72",
                        "source_entry_id": "249c00e5-f839-35af-ad26-94528555b9c9",
                        "source_sense_id": "dcb5ae28-db1a-3ab3-8687-ae16954651f2",
