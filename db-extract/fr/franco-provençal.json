                "senses": [
                    {
                        "sense_id": "b50bc77b-a0c1-3c8b-a80b-433f4142c88e",
                        "entry_id": "d426a077-60a1-368b-9995-f4c77fc32e64",
                        "glosses": [
                            "Ensemble de dialectes gallo-romans intermédiaires entre l’occitan et les langues d’oïl (dont le français), encore parlés aujourd’hui en France (Savoie, région Rhône-Alpes, sud de la Franche-Comté), Suisse romande (à l’exception du canton du Jura et du Jura bernois), Italie (Val d’Aoste, quelques vallées du Piémont ainsi que deux communes de la région des Pouilles)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca9ebb2c-d435-462e-bee1-f9443ec76ddc",
                                "sense_id": "b50bc77b-a0c1-3c8b-a80b-433f4142c88e",
                                "text": "[…] Le franco-provençal présente des caractéristiques et du groupe d’oïl et du groupe d’oc."
                            },
                            {
                                "example_id": "f479e5e2-384f-4b1a-b642-80a68d519e59",
                                "sense_id": "b50bc77b-a0c1-3c8b-a80b-433f4142c88e",
                                "text": "Le patois utilisé, le parler gaga, relève de la zone du franco-provençal, et mêle l’occitan, dont la limite septentrionale touche aux bornes du pays stéphanois, au français. Il utilise des mots et des tournures incompréhensibles pour un étranger."
                            }
                        ]
                    }
                ],
