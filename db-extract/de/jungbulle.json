                "senses": [
                    {
                        "sense_id": "44b7e429-15fa-3e28-b404-b9d1294599fc",
                        "entry_id": "8645738c-4dfc-317b-a248-666a9a93ddd9",
                        "glosses": [
                            "junges (noch nicht geschlechtsreifes) männliches Rind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2124f675-9d9e-48dd-ba62-29a8d41a7358",
                                "sense_id": "44b7e429-15fa-3e28-b404-b9d1294599fc",
                                "text": "„Ende Juli verletzte ein Tierquäler mehrere Jungbullen einer Rinderherde in einem Ortsteil von Jena mit einem scharfen Gegenstand schwer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2821d7fb-f11a-36ce-bebe-ce37d98a4a26",
                        "entry_id": "8645738c-4dfc-317b-a248-666a9a93ddd9",
                        "glosses": [
                            "junges Männchen verschiedener Arten des Großwilds"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b13b5bf3-dda0-446a-be67-ac8ba4c88259",
                                "sense_id": "2821d7fb-f11a-36ce-bebe-ce37d98a4a26",
                                "text": "„Tatsächlich waren alle Jungbullen beige oder hellbraun – manche sogar blonder als Giraffenkühe.“"
                            },
                            {
                                "example_id": "cc52bb0e-a137-42aa-9779-0dea751e0eab",
                                "sense_id": "2821d7fb-f11a-36ce-bebe-ce37d98a4a26",
                                "text": "„In freier Wildbahn werden die Jungbullen im Alter fünf bis acht Jahren von der Herde verstoßen – bei Elefanten herrscht strenges Matriarchat.“"
                            },
                            {
                                "example_id": "0dc8bf98-a839-41b1-aaa9-471980d33fd5",
                                "sense_id": "2821d7fb-f11a-36ce-bebe-ce37d98a4a26",
                                "text": "„Im August 2004 wurde erstmals ein Pottwal in der Ostsee gesichtet, die für das Überleben des Tieftauchers jedoch viel zu flach ist und ihm kaum geeignete Nahrung bietet. Typischer sind kleine Gruppen (‚Schulen‘) von zumeist Jungbullen, die auf ihren jährlichen Rückwanderungen in wärmere Gewässer aus Richtung der Arktis irrtümlich in die Nordsee gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
