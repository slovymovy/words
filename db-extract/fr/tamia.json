                                        "entry_id": "5dbec042-72be-39aa-89ee-4194d5fe06a4",
                                        "glosses": [
                                            "ein mit Streifen aus hellem und dunklem Honigmarzipan glasiertes Mandelhörnchen"
                                        ],
                                        "tags": [
                                            "Confiserie"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
