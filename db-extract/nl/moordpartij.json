                "translations": [
                    {
                        "translation_id": "9351031e-5c22-4205-bb3c-f99cef4f63d8",
                        "source_entry_id": "ea5c6fd1-2afe-36f6-bbcc-e737b47641fc",
                        "source_sense_id": "a761f511-681e-3bdd-98ce-97f95331412b",
                        "target_lang_word": "Massaker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Massaker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                        "entry_id": "2938efed-e8fb-3644-87fa-e761059d30f7",
                                        "glosses": [
                                            "die Ermordung vieler Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28731287-d0da-48d1-82a4-dceecaa0b187",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "Frauen und Kinder waren einem Massaker zum Opfer gefallen."
                                            },
                                            {
                                                "example_id": "ae678078-1349-44fe-b865-215d0a0cc0de",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "„Kaiser hält es für möglich, dass Grimmelshausen 1636 vor Ort war, als kaiserliche Truppen das von Schweden gehaltene Magdeburg zurückeroberten; fünf Jahre zuvor hatten sie, angeführt von Tilly, schon einmal die Stadt gestürmt und rund 20000 Menschen getötet - eines der schlimmsten Massaker des Kriegs.“"
                                            },
                                            {
                                                "example_id": "b019709f-a768-4c48-b216-e26bf20c1407",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "„Bald nach dem Massaker stürmen Indianer auf die Grönländer zu, schwingen steinerne Tomahawks und schießen mit Pfeil und Bogen - steinzeitliche Waffen, die den eisernen Schwertern und Streitäxten der Wikinger aber kaum unterlegen sind.“"
                                            },
                                            {
                                                "example_id": "41cd8335-e7e8-48d1-98c5-2405744cd012",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "„Erst nach dem Ende der Volksrepublik Polen wagen die Überlebenden, an dieses Massaker zu erinnern.“"
                                            },
                                            {
                                                "example_id": "19817c0e-9afa-48fc-9b2b-45207b5e19d3",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "„Irgendwann kamen wir zum Monument, dem ersten und damals einzigen Denkmal, das 35 Jahre nach dem Massaker eingeweiht worden war, am falschen Ort und am falschen Tag.“"
                                            },
                                            {
                                                "example_id": "bdfc9994-1085-453b-be59-1acf33ba4809",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "Das Massaker von Babyn Jar vor 75 Jahren wurde nach der gleichnamigen Schlucht auf dem Stadtgebiet Kiews genannt, wo im Jahr 1941 die deutsche Wehrmacht, Sicherheitspolizei und Sicherheitsdienst mehr als 33.000 Juden ermordeten. \"Babyn Jar\" war die größte einzelne Mordaktion an jüdischen Männern, Frauen und Kindern im Zweiten Weltkrieg."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a73a0dfa-a4ac-42c7-9174-0ed001e1390c",
                        "source_entry_id": "ea5c6fd1-2afe-36f6-bbcc-e737b47641fc",
                        "source_sense_id": "a761f511-681e-3bdd-98ce-97f95331412b",
                        "target_lang_word": "massacre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "massacre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f33bbbb-c357-3a07-b63e-7e8f1bb6c52a",
                                        "entry_id": "bcd10c1b-511e-3d3a-968f-12fb6ab8ce0d",
                                        "glosses": [
                                            "The killing of a considerable number (usually limited to people) where little or no resistance can be made, with indiscriminate violence, without necessity, and/or contrary to civilized norms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ccc0302-f890-4dfc-87a0-2d920ba48493",
                                                "sense_id": "3f33bbbb-c357-3a07-b63e-7e8f1bb6c52a",
                                                "text": "St. Bartholomew's Day Massacre"
                                            },
                                            {
                                                "example_id": "6e7d3447-47a7-4984-8643-fd9329119e3a",
                                                "sense_id": "3f33bbbb-c357-3a07-b63e-7e8f1bb6c52a",
                                                "text": "St. Valentine's Day Massacre"
                                            },
                                            {
                                                "example_id": "71ee4e18-735d-40bc-bcfe-72d783232b73",
                                                "sense_id": "3f33bbbb-c357-3a07-b63e-7e8f1bb6c52a",
                                                "text": "Amritsar Massacre"
                                            },
                                            {
                                                "example_id": "15ce3c70-8431-49a2-9a27-aaf6ba2ef944",
                                                "sense_id": "3f33bbbb-c357-3a07-b63e-7e8f1bb6c52a",
                                                "text": "I'll find a day to massacre them all,\nAnd raze their faction and their family"
                                            },
                                            {
                                                "example_id": "cc6e15df-460e-4655-a46c-ae6803f0037c",
                                                "sense_id": "3f33bbbb-c357-3a07-b63e-7e8f1bb6c52a",
                                                "text": "The massacre that ripped apart 17 families in Parkland, Florida, five years ago on Valentine’s Day ignited a wave of student-led protests and bipartisan legislation to combat the plague of school shootings devastating the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b10d5bfc-a5ec-3631-bdcf-6291533596c4",
                                        "entry_id": "bcd10c1b-511e-3d3a-968f-12fb6ab8ce0d",
                                        "glosses": [
                                            "Murder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84c07aa6-1071-40ac-92ea-b5aca4aeac6c",
                                                "sense_id": "b10d5bfc-a5ec-3631-bdcf-6291533596c4",
                                                "text": "The tyrannous and bloody act is done,—\nThe most arch deed of piteous massacre\nThat ever yet this land was guilty of."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163146b2-e9af-337b-a97e-7f6e41d55760",
                                        "entry_id": "bcd10c1b-511e-3d3a-968f-12fb6ab8ce0d",
                                        "glosses": [
                                            "Any overwhelming defeat, as in a game or sport."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "massacre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7403207-878c-3900-b3a9-a89c2de0f426",
                                        "entry_id": "c12b895f-1278-318e-8113-570be31a33fe",
                                        "glosses": [
                                            "To kill in considerable numbers where little or no resistance can be made, with indiscriminate violence, without necessity, and contrary to civilized norms. (Often limited to the killing of human beings.)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f4ea70f-c66a-4639-8153-06dfecddf38a",
                                                "sense_id": "f7403207-878c-3900-b3a9-a89c2de0f426",
                                                "text": "If James should be pleased to massacre them all, as Maximilian had massacred the Theban legion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4d4226c-1590-39bb-be7a-17965bb15649",
                                        "entry_id": "c12b895f-1278-318e-8113-570be31a33fe",
                                        "glosses": [
                                            "To win against (an opponent) very decisively."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bd3a4ae-aad3-3f6a-93f7-a7326821cd56",
                                        "entry_id": "c12b895f-1278-318e-8113-570be31a33fe",
                                        "glosses": [
                                            "To perform (a work, such as a musical piece or a play) very poorly."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "078c0b72-293f-3282-a829-afb2ccff4450",
                                        "entry_id": "c12b895f-1278-318e-8113-570be31a33fe",
                                        "glosses": [
                                            "To kill with great force or brutality."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7324276-e9ca-4aba-9999-f6842ef3c757",
                                                "sense_id": "078c0b72-293f-3282-a829-afb2ccff4450",
                                                "text": "Look how they massacred my boy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da31cb41-9805-4b3e-a1cb-8045dbde3825",
                        "source_entry_id": "ea5c6fd1-2afe-36f6-bbcc-e737b47641fc",
                        "source_sense_id": "a761f511-681e-3bdd-98ce-97f95331412b",
                        "target_lang_word": "massacre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "massacre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                        "entry_id": "0390ac39-5e97-3cba-80b2-857864ba4a50",
                                        "glosses": [
                                            "Action de massacrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "441e8240-1446-4c4b-88ed-a1bd59e3a3f7",
                                                "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                                "text": "Dans les salles cinématographiques de Mars, après les massacres de Kitnicheff, les scènes de la guerre balkanique récoltaient le plus d'applaudissements. Tout le monde s'efforçait de découvrir la signification de ces charivaris effarants."
                                            },
                                            {
                                                "example_id": "08be6b5f-32a3-4740-8328-360330c58bf5",
                                                "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                                "text": "Ici, les gens parlaient d’incendies et de massacres, de cruautés et de représailles, du meurtre d’inoffensifs Asiatiques par des tourbes que déchaînait la haine de race, de villes mises à sac et complètement brûlées."
                                            },
                                            {
                                                "example_id": "b16d6424-3c44-49cb-ac41-afbb7b1adab7",
                                                "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                                "text": "S'ils se sont répandus, nombreux, à travers d'autres pays, c'est soit pour fuir des catastrophes (guerres, révolutions, massacres,) soit pour échapper aux inconvénients de la surpopulation."
                                            },
                                            {
                                                "example_id": "04c7e6bf-a04f-4fd6-8077-8eef326a46f8",
                                                "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                                "text": "J'avais des lettres de Gontier, qui n'étaient pas réconfortantes ; les batteries étaient à Verdun et les obus y faisaient des massacres."
                                            },
                                            {
                                                "example_id": "73946e8e-58f5-4bf3-bf57-e1a538435ec3",
                                                "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                                "text": "Le mouvement pacifiste, au XXᵉ siècle, a été très largement porté par les femmes, plus sensibles que les hommes à l'absurdité d'une puissance qui s'édifie en semant la mort, et qui appelle « champs d'honneur » les lieux des pires massacres."
                                            },
                                            {
                                                "example_id": "53077ca3-35c6-4f0f-83e0-44cc7924dda3",
                                                "sense_id": "bc9bade2-70fa-3acc-b77c-59ad1df4695f",
                                                "text": "Sans remonter à l’événement traumatique fondateur que furent les massacres de la Saint-Barthélemy, on rappellera que la minorité réformée fut l'objet, sous Louis XIV, d'un « mémoricide » sans précédent : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33f886b4-bda9-35b5-8597-b607915e84b1",
                                        "entry_id": "0390ac39-5e97-3cba-80b2-857864ba4a50",
                                        "glosses": [
                                            "Grande tuerie de gibier, d'animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cc9d5da-e61d-4983-824c-56540949cca2",
                                                "sense_id": "33f886b4-bda9-35b5-8597-b607915e84b1",
                                                "text": "Cet enclos est une canardière ; ces massacres ont lieu presque journellement, et les victimes en sont d'innombrables canards, attirés par ce silence absolu, garantie menteuse d'une parfaite sécurité !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6285bd58-c458-3738-9400-80df49679812",
                                        "entry_id": "0390ac39-5e97-3cba-80b2-857864ba4a50",
                                        "glosses": [
                                            "Ramure, tête du gibier tué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32104aac-4e5d-46c8-8a59-53cda6ec2310",
                                                "sense_id": "6285bd58-c458-3738-9400-80df49679812",
                                                "text": "On connaît ainsi plusieurs exemples où d’énormes massacres d’aurochs, qui ont été trouvés sur le sol des cavernes, semblent être tombés des parois."
                                            },
                                            {
                                                "example_id": "44a969fb-8349-4bc8-86ab-08543c82f55b",
                                                "sense_id": "6285bd58-c458-3738-9400-80df49679812",
                                                "text": "Les chasseurs accrochent à leurs murs des hures de sangliers et des massacres de cerfs : vous, vous devriez y épingler des pucelages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e53da72e-66e2-354c-81bc-8e033de66d6a",
                                        "entry_id": "0390ac39-5e97-3cba-80b2-857864ba4a50",
                                        "glosses": [
                                            "Discours, critique très sévère qui n’épargne rien ni personne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aee4d81f-80a9-4ea0-b00f-09e1cb25fd1f",
                                                "sense_id": "e53da72e-66e2-354c-81bc-8e033de66d6a",
                                                "text": "Cet article est un véritable massacre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac6f7d65-3fff-3cc2-b6ea-1d0404800b11",
                                        "entry_id": "0390ac39-5e97-3cba-80b2-857864ba4a50",
                                        "glosses": [
                                            "Meuble représentant une ramure de cervidé attachée à un crâne complet ou non dans les armoiries. Il est représenté de front. À rapprocher de caboché, hure, massacre crucifère, rencontre et tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edbba15c-ce3d-4274-9eca-5f6c97987c42",
                                                "sense_id": "ac6f7d65-3fff-3cc2-b6ea-1d0404800b11",
                                                "text": "De sable au massacre de cerf d’argent, qui est de Venère de Haute-Saône → voir illustration « armoiries avec un massacre »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "massacre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc320370-7aa2-3731-8319-2c976e413eef",
                                        "entry_id": "e234f45b-a233-3fda-a17d-3607a39915dc",
                                        "glosses": [
                                            "Exclamation qui exprime l’impatience, le dépit."
                                        ],
                                        "tags": [
                                            "familiar"
