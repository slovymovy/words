                "senses": [
                    {
                        "sense_id": "60de2278-209b-361f-a6f8-5535a9dd4fe3",
                        "entry_id": "d2046338-a189-3613-bd97-663f74842039",
                        "glosses": [
                            "ein essfertiges Produkt aus Kakaobestandteilen und Milch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bb2415c-8442-4d15-9719-3022909df7dc",
                                "sense_id": "60de2278-209b-361f-a6f8-5535a9dd4fe3",
                                "text": "„Dunkle Schokolade enthalte durch den hohen Kakaoanteil mehr Kakaofett als normale Vollmilchschokolade, dafür aber weniger Zucker.“"
                            },
                            {
                                "example_id": "7bd9d3cc-4ccd-4b2f-9e16-368c1f7e2cc1",
                                "sense_id": "60de2278-209b-361f-a6f8-5535a9dd4fe3",
                                "text": "„Bezüglich der Bezeichnung Vollmilchschokolade wird auf Abs. 36 hingewiesen.“"
                            },
                            {
                                "example_id": "51470991-eeb6-460f-a21f-52f915da3330",
                                "sense_id": "60de2278-209b-361f-a6f8-5535a9dd4fe3",
                                "text": "„Bevor ich wieder nach unten laufe, wo Tom die leere Pizzaschachtel entsorgt hat, breche ich ein großes Stück von meiner Vollmilchschokolade ab und reiche sie ihm.“"
                            },
                            {
                                "example_id": "7502772d-7fc4-463a-97e5-a44818a435a3",
                                "sense_id": "60de2278-209b-361f-a6f8-5535a9dd4fe3",
                                "text": "„Die Eier sind mit Williamsstengeli, Nussbruch, dunklen Pralinen oder Vollmilchschokolade gefüllt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
