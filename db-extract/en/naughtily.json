                                "target_senses": [
                                    {
                                        "sense_id": "8f380732-9af4-3b9d-bdc8-021e3ae860cd",
                                        "entry_id": "7f1b872e-7073-39f6-948c-4760518c1f9f",
                                        "glosses": [
                                            "die Normen und Höflichkeit missachtend, Respekt vermissen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "101bc4f0-f00c-4c84-b096-6faa11e27ffd",
                                                "sense_id": "8f380732-9af4-3b9d-bdc8-021e3ae860cd",
                                                "text": "Das Kind zeigte ein freches Verhalten."
                                            },
                                            {
                                                "example_id": "207ecd06-39bd-4e02-8908-33f6f7da71f0",
                                                "sense_id": "8f380732-9af4-3b9d-bdc8-021e3ae860cd",
                                                "text": "Roswitha ist eine richtig freche Göre."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "920f2e77-8890-3166-a7e7-96a6a0687ad2",
                                        "entry_id": "7f1b872e-7073-39f6-948c-4760518c1f9f",
                                        "glosses": [
                                            "positiv, auffällig aus dem Rahmen fallend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a23827d1-ef5a-4836-98d4-c998aab76474",
                                                "sense_id": "920f2e77-8890-3166-a7e7-96a6a0687ad2",
                                                "text": "Sie haben eine freche Frisur."
                                            },
                                            {
                                                "example_id": "a83159dd-555c-48e6-95a4-f9b97a4a34f6",
                                                "sense_id": "920f2e77-8890-3166-a7e7-96a6a0687ad2",
                                                "text": "Dieses Modell ist etwas frecher, nicht so langweilig und konservativ wie die ersten, die ich Ihnen gezeigt habe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "94da62e1-cad9-3fef-8c2a-a65f98cdbc03",
                                        "entry_id": "7f1b872e-7073-39f6-948c-4760518c1f9f",
                                        "glosses": [
                                            "respektlos mit dem Beigeschmack von Verruchtheit"
                                        ],
                                        "tags": [
                                            "ältere Literatursprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dda2abdd-7053-456b-ba0e-30a129550c6e",
                                                "sense_id": "94da62e1-cad9-3fef-8c2a-a65f98cdbc03",
                                                "text": "Mit frechem Mut sprach er sie an."
                                            },
                                            {
                                                "example_id": "3176ca09-81db-4e74-bf38-5b2313580fae",
                                                "sense_id": "94da62e1-cad9-3fef-8c2a-a65f98cdbc03",
                                                "text": "Mit einem frechen Hüftschwung verließ sie den Raum."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "552c690a-5ffe-40ef-b7a1-5a3e1add6b5e",
                        "source_entry_id": "1b042154-f989-3e32-8912-5a43f0d8dc24",
                        "source_sense_id": "d379ddab-dfc0-3799-b15e-8b837f7f3039",
                        "source_sense_description": "in Bezug auf Erotik: unanständig",
                        "target_lang_word": "unanständig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unanständig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4fafd1f-c524-3663-9240-653c57c49c67",
                                        "entry_id": "0933872a-93c2-3d78-93b6-f4d35d9e1154",
                                        "glosses": [
                                            "den guten Sitten widersprechend, gegen sie verstoßend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "321cbc69-a545-4833-85c0-e9f148d80675",
                                                "sense_id": "e4fafd1f-c524-3663-9240-653c57c49c67",
                                                "text": "Er darf keine unanständigen Witze erzählen, wenn Kinder anwesend sind."
                                            },
                                            {
                                                "example_id": "39e5fe2f-bc93-40fe-9a73-9e38047e23cd",
                                                "sense_id": "e4fafd1f-c524-3663-9240-653c57c49c67",
                                                "text": "„Es handelte sich um Darstellungen höchst unanständiger Szenen von Leda mit dem Schwan, von Pan und den Nymphen, von Susanna im Bade und ähnlichen Sachen, die schon längst zur Konfiskation der Bibel, der Mythologie und der gesamten Kunstgeschichte hätte führen müssen, wenn sich alles nach der Berliner Polizei richten würde.“"
                                            },
                                            {
                                                "example_id": "6d94d2d6-c9c0-41f9-be67-9cb067704ca9",
                                                "sense_id": "e4fafd1f-c524-3663-9240-653c57c49c67",
                                                "text": "„Das Feld der unanständigen Wörter ist anarchisch bunt, sodass es nicht leichtfallen würde, eine allgemeine Klassifikation dessen durchzuführen, was sich hier alles tummelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
