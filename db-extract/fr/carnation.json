        "fr-extract.jsonl": [
            {
                "entry_id": "264b438e-6a02-3115-84e1-140f9a940217",
                "word": "carnation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "82c96086-6a57-4ef0-afb8-360d5af4ffec",
                        "entry_id": "264b438e-6a02-3115-84e1-140f9a940217",
                        "tags": [
                            "plural"
                        ],
                        "form": "carnations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c13cf0c0-1d41-3871-bf9a-c87aaecc7fb4",
                        "entry_id": "264b438e-6a02-3115-84e1-140f9a940217",
                        "glosses": [
                            "Teint d’une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4d4ef9f-3557-4e52-a419-91cd276986e8",
                                "sense_id": "c13cf0c0-1d41-3871-bf9a-c87aaecc7fb4",
                                "text": "Mais la captivante rondeur des formes, […], la transparence d’une carnation délicate, […], imprimaient à cette beauté vigoureuse la suavité féminine, la modestie enchanteresse que nous demandons à ces anges de paix et d’amour."
                            },
                            {
                                "example_id": "a40fd345-aace-4470-a0c1-e3773b639e5c",
                                "sense_id": "c13cf0c0-1d41-3871-bf9a-c87aaecc7fb4",
                                "text": "— La jeune fille est charmante avec ses cheveux noirs, ses yeux profonds et sa carnation éblouissante de fraîcheur."
                            },
                            {
                                "example_id": "ff27fee9-a100-4da6-a175-d5444c680feb",
                                "sense_id": "c13cf0c0-1d41-3871-bf9a-c87aaecc7fb4",
                                "text": "Cette Molly, tout de même quelle femme ! Quelle généreuse ! Quelle carnation ! Quelle plénitude de jeunesse !"
                            },
                            {
                                "example_id": "05644b93-c104-4dbf-819b-bec234aa6591",
                                "sense_id": "c13cf0c0-1d41-3871-bf9a-c87aaecc7fb4",
                                "text": "Dans le fouillis poussiéreux de la pièce, la carnation égale et très pâle de ses bras et de sa gorge suggérait à l’œil une matière extraordinairement précieuse, radiante, comme la robe blanche d’une femme dans la nuit d’un jardin."
                            },
                            {
                                "example_id": "526d3955-7fee-440a-aec8-3b58077b5e5a",
                                "sense_id": "c13cf0c0-1d41-3871-bf9a-c87aaecc7fb4",
                                "text": "Mes yeux blonds, ma chevelure ardente, la carnation fragile de mes joues… est-ce que tout cela passerait inaperçu."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ea9c0c4-7a7d-33d9-8c06-e04bc1a8c338",
                        "entry_id": "264b438e-6a02-3115-84e1-140f9a940217",
                        "glosses": [
                            "Représentation, rendu du coloris de la chair."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "b0fd972b-14a6-4e2c-9138-050fe071d107",
                                "sense_id": "3ea9c0c4-7a7d-33d9-8c06-e04bc1a8c338",
                                "text": "Les carnations de ce tableau sont fort belles."
                            },
                            {
                                "example_id": "2cb373a6-dac3-43ad-a077-09a923696b18",
                                "sense_id": "3ea9c0c4-7a7d-33d9-8c06-e04bc1a8c338",
                                "text": "De quelque manière qu’il [Vélasquez] s’y soit pris, il a toujours réussi à rendre admirablement le coloris et la fraîcheur des carnations."
                            }
                        ]
                    },
                    {
                        "sense_id": "e84da81a-2116-3357-8287-862c89a74b5f",
                        "entry_id": "264b438e-6a02-3115-84e1-140f9a940217",
                        "glosses": [
                            "Voir de carnation."
                        ],
                        "tags": [],
                        "examples": []
                    }
