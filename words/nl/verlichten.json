            "senses": [
                {
                    "sense_id": "0298e441-2ca8-3a70-ab80-4aca1ae27d49",
                    "sense_definition": "van licht voorzien of helderder maken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De volle maan kon de donkere weg in het bos een beetje <w>verlichten</w>.",
                            "target_lang_translations": {
                                "en": "The full moon could <w>illuminate</w> the dark path in the forest a little."
                            }
                        },
                        {
                            "text": "De lantaarnpaal ernaast <w>verlichtte</w> de auto maar gedeeltelijk.",
                            "target_lang_translations": {
                                "en": "The lamppost next to it only partially <w>lit up</w> the car."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijlichten",
                        "illumineren"
                    ],
                    "antonyms": [
                        "verduisteren"
                    ],
                    "common_phrases": [
                        "de kamer verlichten",
                        "fel verlicht"
                    ],
                    "target_lang_definitions": {
                        "en": "to provide with light or make brighter"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "illuminate",
                                "target_lang_sense_clarification": "to shine light on something"
                            },
                            {
                                "target_lang_word": "light up",
                                "target_lang_sense_clarification": "to make a space bright"
                            },
                            {
                                "target_lang_word": "lighten",
                                "target_lang_sense_clarification": "to make brighter or clearer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23e080da-b381-3586-a771-a80fb92feb9d",
                    "sense_definition": "iets minder zwaar of pijnlijk maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vermindering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze nieuwe medicijnen kunnen de pijn in je rug aanzienlijk <w>verlichten</w>.",
                            "target_lang_translations": {
                                "en": "These new medicines can significantly <w>relieve</w> the pain in your back."
                            }
                        },
                        {
                            "text": "De afgeworpen ballast <w>verlichtte</w> de ballon voldoende om boven de berg uit te stijgen.",
                            "target_lang_translations": {
                                "en": "The jettisoned ballast <w>lightened</w> the balloon enough to rise above the mountain."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzachten",
                        "verlichten",
                        "vergemakkelijken"
                    ],
                    "antonyms": [
                        "verzwaren",
                        "verergeren"
                    ],
                    "common_phrases": [
                        "de pijn verlichten",
                        "de last verlichten"
                    ],
                    "target_lang_definitions": {
                        "en": "to make something less heavy or painful"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relieve",
                                "target_lang_sense_clarification": "to reduce pain or distress"
                            },
                            {
                                "target_lang_word": "alleviate",
                                "target_lang_sense_clarification": "to make suffering or a problem less severe"
                            },
                            {
                                "target_lang_word": "lighten",
                                "target_lang_sense_clarification": "to reduce a physical or emotional burden"
                            },
                            {
                                "target_lang_word": "ease",
                                "target_lang_sense_clarification": "to make something less difficult or painful"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d646d9c6-9c0a-3b30-b5eb-c0802e324e9d",
                    "sense_definition": "een taak of situatie minder moeilijk of inspannend maken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vermindering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het nieuwe gereedschap <w>verlichtte</w> de taak aanzienlijk voor de arbeiders.",
                            "target_lang_translations": {
                                "en": "The new tool <w>lightened</w> the task considerably for the workers."
                            }
                        },
                        {
                            "text": "Automatisering kan het werk van de administratie enorm <w>verlichten</w>.",
                            "target_lang_translations": {
                                "en": "Automation can <w>ease</w> the work of the administration enormously."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergemakkelijken",
                        "ontlasten"
                    ],
                    "antonyms": [
                        "bemoeilijken"
                    ],
                    "common_phrases": [
                        "het werk verlichten",
                        "de taak verlichten"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a task or situation less difficult or strenuous"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lighten",
                                "target_lang_sense_clarification": "to make a workload or task less heavy"
                            },
                            {
                                "target_lang_word": "facilitate",
                                "target_lang_sense_clarification": "to make an action or process easier"
                            },
                            {
                                "target_lang_word": "ease",
                                "target_lang_sense_clarification": "to reduce the difficulty of a situation"
                            }
                        ]
                    }
                }
