                    {
                        "sense_id": "731b6197-f207-34c2-8111-601d0c90688f",
                        "entry_id": "a5ff8c35-5882-3539-a5ef-6b2c1ebb287d",
                        "glosses": [
                            "Angehöriger des antiken, gleichnamigen Volkes, das in Mittelitalien siedelte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39c32f9b-84a5-4986-808e-730cb5e22750",
                                "sense_id": "731b6197-f207-34c2-8111-601d0c90688f",
                                "text": "„Die Kämpfe wurden seit 311 dadurch erschwert, daß sich nun auch die Etrusker und Umbrer im Norden Roms gegen die neue Vormacht wehrten — eine Bewegung, welche die Römer erst 308 in den Griff bekommen sollten.“"
                            },
                            {
                                "example_id": "e8c66404-e6b7-4da3-bcc6-795b48048584",
                                "sense_id": "731b6197-f207-34c2-8111-601d0c90688f",
                                "text": "„In der Lombardei siedelten bis zum 5. Jahrhundert v. Chr. Völker verschiedener Abstammung: Räter, den Latinern verwandte Umbrer, ferner Etrusker und Kelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
