                "senses": [
                    {
                        "sense_id": "0c716194-c00c-356c-ae19-cd93c2a84c27",
                        "entry_id": "08aab110-bfc4-333d-b6bd-388ace78a297",
                        "glosses": [
                            "Qui est relatif au principe, lorsqu’il est la cause de quelque chose."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4a770f50-edce-49c5-826c-f3e894b819ea",
                                "sense_id": "0c716194-c00c-356c-ae19-cd93c2a84c27",
                                "text": "Ce débat principiel est long et sans intérêt, j’espère juste qu’il y aura un buffet à la fin…"
                            },
                            {
                                "example_id": "70c32f61-0dca-4401-a245-bf250502e88b",
                                "sense_id": "0c716194-c00c-356c-ae19-cd93c2a84c27",
                                "text": "L’apeiron en somme\nQu’est-ce qu’en aucun cas cet infini, négativement exprimé, ne peut-être ? Ni eau ni air ni feu ni terre, ni quelque élément de la matière : donc ni principiel ni matériel."
                            },
                            {
                                "example_id": "2d9945df-555b-46bf-ba34-393fde29f155",
                                "sense_id": "0c716194-c00c-356c-ae19-cd93c2a84c27",
                                "text": "Le dieu principiel des rationalistes."
                            },
                            {
                                "example_id": "697b360f-d067-4b77-a364-5eb4f8d8ba5e",
                                "sense_id": "0c716194-c00c-356c-ae19-cd93c2a84c27",
                                "text": "Je propose de panser cette double fracture en revenant au geste principiel de la colonisation : l’acte d’habiter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af519431-c8df-4096-8bb3-615a826e76a9",
                        "source_entry_id": "08aab110-bfc4-333d-b6bd-388ace78a297",
                        "source_sense_id": "0c716194-c00c-356c-ae19-cd93c2a84c27",
                        "target_lang_word": "prinzipiell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prinzipiell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14f52254-5b58-3477-a866-bfceb1d9ddca",
                                        "entry_id": "1660c54f-b039-342a-a475-10aa92cf0d88",
                                        "glosses": [
                                            "auf der Grundlage eines Prinzips"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f08e26fa-470f-4ff8-8ced-7fdecb356c47",
                                                "sense_id": "14f52254-5b58-3477-a866-bfceb1d9ddca",
                                                "text": "Seine ablehnende Haltung zur Gentechnik ist prinzipieller Natur."
                                            },
                                            {
                                                "example_id": "45efabd4-2177-4e55-81aa-8b1c5ef48425",
                                                "sense_id": "14f52254-5b58-3477-a866-bfceb1d9ddca",
                                                "text": "Klaus ist prinzipiell gegen das Priesteramt für Frauen."
                                            },
                                            {
                                                "example_id": "57fe6a51-8efa-433b-ae4b-dc2a476cdfd1",
                                                "sense_id": "14f52254-5b58-3477-a866-bfceb1d9ddca",
                                                "text": "Eine, ja vielleicht die prinzipiellste Voraussetzung alles Psychologismus aber ist nach Moog jede, wenn auch noch so verfeinerte, Form der Abbildtheorie des Erkennens."
                                            },
                                            {
                                                "example_id": "1caa70d1-c83a-4d9a-acce-8adb5924d7a4",
                                                "sense_id": "14f52254-5b58-3477-a866-bfceb1d9ddca",
                                                "text": "Unter der Oberfläche des unmittelbaren, akklamatorischen Zeitbezuges wird somit auch eine disziplinäre Diskussion um die prinzipiellere Frage nach der Legitimität und nach dem Fortbestehen literaturwissenschaftlichen Eigensinns geführt."
                                            },
                                            {
                                                "example_id": "20754d2c-5f18-4ec2-95cd-ef6437cbd0fc",
                                                "sense_id": "14f52254-5b58-3477-a866-bfceb1d9ddca",
                                                "text": "„Vielmehr geht es um tiefer liegende Gefährdungen und prinzipiellere Strukturen des Grundrechtsschutzes.“"
                                            },
                                            {
                                                "example_id": "a5989360-20d0-4dcb-8a67-75a84f466650",
                                                "sense_id": "14f52254-5b58-3477-a866-bfceb1d9ddca",
                                                "text": "„Es schien, als ob der Abschluss der Verhandlungen Camerons zur Neugestaltung der Position Grossbritanniens innerhalb der EU auch ein Startschuss für prinzipiellere Argumente war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0bdb72f-37d6-4606-817e-adfe62f4fa22",
                        "source_entry_id": "08aab110-bfc4-333d-b6bd-388ace78a297",
                        "source_sense_id": "0c716194-c00c-356c-ae19-cd93c2a84c27",
                        "target_lang_word": "principial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "principial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bdcadff-4e60-3cdb-aca5-8adf34bd2a3d",
                                        "entry_id": "93d77a94-2887-366d-aef0-cc59eb477b66",
                                        "glosses": [
                                            "Elementary; fundamental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04b12d9c-66d9-4520-931d-e0c854e93d9b",
                                                "sense_id": "0bdcadff-4e60-3cdb-aca5-8adf34bd2a3d",
                                                "text": "On account of heat being kindled by the attrition of bodies, reject a principial nature. By principial nature I mean that which exists in the nature of things positively, and not as the effect of any antecedent nature."
                                            },
                                            {
                                                "example_id": "28387a48-9089-4cbf-8e4e-3478dfa81aa5",
                                                "sense_id": "0bdcadff-4e60-3cdb-aca5-8adf34bd2a3d",
                                                "text": "My only aim will be to trace the dislocating work of the two conditions that ensue, namely, the principial condition over which the foundation presides and the ground as the originary condition."
                                            },
                                            {
                                                "example_id": "bda11a9c-07c7-4da8-b7aa-45b74f318715",
                                                "sense_id": "0bdcadff-4e60-3cdb-aca5-8adf34bd2a3d",
                                                "text": "The latter, a principial christocentrism, may include the monergistic view of salvation, but it will also assume that Christ is the principium cognoscendi theologiae or, in Kickel's phrase the Erkenntnissgrund of theology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
