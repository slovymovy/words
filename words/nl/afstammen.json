{
    "word_family": [
        "stam",
        "afstamming",
        "stamboom",
        "stamvader"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8fcc98e-fa6f-34ae-8476-ff03efdb38b2",
                    "sense_definition": "een nakomeling zijn van een bepaalde persoon of familie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "afkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Koningin Beatrix <w>stamt af</w> van Johan Willem Friso.",
                            "target_lang_translations": {
                                "en": "Queen Beatrix <w>is descended</w> from Johan Willem Friso."
                            }
                        },
                        {
                            "text": "Veel mensen willen graag weten van welke adellijke familie zij <w>afstammen</w>.",
                            "target_lang_translations": {
                                "en": "Many people would like to know which noble family they <w>descend</w> from."
                            }
                        }
                    ],
                    "synonyms": [
                        "voortkomen"
                    ],
                    "common_phrases": [
                        "afstammen van"
                    ],
                    "target_lang_definitions": {
                        "en": "to be a descendant of a specific person or family"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be descended",
                                "target_lang_sense_clarification": "from an ancestor or family"
                            },
                            {
                                "target_lang_word": "descend",
                                "target_lang_sense_clarification": "to have a specific lineage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "072b2828-bbe5-3655-804a-e3bb0b85af58",
                    "sense_definition": "in directe lijn teruggevoerd kunnen worden tot een eerdere vorm of bron, zoals een taal of biologische soort",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oorsprong",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het Nederlands <w>stamt af</w> van het West-Germaans.",
                            "target_lang_translations": {
                                "en": "Dutch <w>is derived</w> from West Germanic."
                            }
                        },
                        {
                            "text": "De moderne mens <w>stamt af</w> van de vroege mensachtigen.",
                            "target_lang_translations": {
                                "en": "Modern humans <w>descend</w> from early hominids."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontstaan",
                        "voortvloeien"
                    ],
                    "common_phrases": [
                        "direct afstammen van"
                    ],
                    "target_lang_definitions": {
                        "en": "to be traceable in a direct line back to an earlier form or source, such as a language or biological species"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be derived",
                                "target_lang_sense_clarification": "from a source or earlier form"
                            },
                            {
                                "target_lang_word": "descend",
                                "target_lang_sense_clarification": "from an evolutionary or linguistic origin"
                            },
                            {
                                "target_lang_word": "originate",
                                "target_lang_sense_clarification": "to have a specified beginning"
                            }
                        ]
                    }
                }
            ]
        }
    ]
