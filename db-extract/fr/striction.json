                                                "sense_id": "e0583bf9-035f-37c8-9c21-7c001036324d",
                                                "text": "Necking helps young male giraffes test which one has a stronger neck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b94f0aa-6846-3a03-99b3-8667b7a843f8",
