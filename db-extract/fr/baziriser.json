                "senses": [
                    {
                        "sense_id": "ecd69340-ede7-3d41-a5d3-8372a18a34d1",
                        "entry_id": "0ef772a7-d643-3068-a0ce-414346907793",
                        "glosses": [
                            "Transformer les performances d'un cheval de course de trot sous l'effet de l'entraînement ou du pilotage de Jean-Michel Bazire."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "34fee751-4e0a-47fa-8c1b-295b01ccf13c",
                                "sense_id": "ecd69340-ede7-3d41-a5d3-8372a18a34d1",
                                "text": "Ursy du Terroir (16 – Jean-Michel Bazire), plus confirmé dans le sud-ouest, aura pour lui d’être associé au multiple Sulky d’Or, qui va tenter de le « baziriser »."
                            },
                            {
                                "example_id": "f3a1f31a-70de-4788-89db-251e5d85df81",
                                "sense_id": "ecd69340-ede7-3d41-a5d3-8372a18a34d1",
                                "text": "Dauphin de Casimir de Survie, le 09/09 à Argentan. Il est nettement moins bon que son rival, mais sera \" bazirisé \" pour l’occasion."
                            },
                            {
                                "example_id": "446c3557-c833-4d49-9dc2-ccf482d9ba20",
                                "sense_id": "ecd69340-ede7-3d41-a5d3-8372a18a34d1",
                                "text": "Comment baziriser son cheval ?"
                            }
                        ]
                    }
