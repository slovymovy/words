                        "entry_id": "006a7cda-e992-3554-8f93-d61178c06493",
                        "glosses": [
                            "An official group of three people, especially a ruling council of three men and particularly (historical) two such councils in Roman history."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d13da470-4dae-45ac-aebb-71b5585cb730",
                        "source_entry_id": "006a7cda-e992-3554-8f93-d61178c06493",
                        "source_sense_id": "4575e270-7b6f-3917-8931-7ec4915be98f",
                        "source_sense_description": "a ruling group of three",
                        "target_lang_word": "triumviraat",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "triumviraat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7e08b1eb-d5f2-3b1d-b9f7-56aeb8e60567",
                                        "entry_id": "a003e42c-c62f-3d60-b862-19c2911df6df",
                                        "glosses": [
                                            "politiek leiderschap dat uit drie gelijkwaardige personen bestaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64d079db-fb1f-42af-99bc-04602218e450",
                                                "sense_id": "7e08b1eb-d5f2-3b1d-b9f7-56aeb8e60567",
                                                "text": "Het eerste triumviraat van de Romeinse Republiek bestond uit Julius Caesar, Pompeius en Crassus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54aab295-6290-4bb4-8c55-3ba67607a65a",
                        "source_entry_id": "006a7cda-e992-3554-8f93-d61178c06493",
                        "source_sense_id": "4575e270-7b6f-3917-8931-7ec4915be98f",
                        "source_sense_description": "a ruling group of three",
                        "target_lang_word": "driemanschap",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "driemanschap",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4ad078a1-a90a-3476-b307-f195d628d08b",
                                        "entry_id": "6a5705f2-5ae2-36ce-a2a0-31c86e96c5da",
                                        "glosses": [
                                            "politiek leiderschap dat uit drie gelijkwaardige personen bestaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17687add-7257-4e42-91cf-147f946cd213",
                                                "sense_id": "4ad078a1-a90a-3476-b307-f195d628d08b",
                                                "text": "Gijsbert Karel van Hoogendorp, Leopold graaf van Limburg Sti­rum en Adam Frans Julius Armand baron van der Duyn van Maasdam vormden in de jaren 1810-1815 een driemanschap dat een belangrijke rol gespeeld heeft bij de vorming van het Koninkrijk der Nederlanden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1473efaf-10bc-4251-b30b-0869c486354c",
                        "source_entry_id": "006a7cda-e992-3554-8f93-d61178c06493",
                        "source_sense_id": "4575e270-7b6f-3917-8931-7ec4915be98f",
                        "source_sense_description": "a ruling group of three",
                        "target_lang_word": "triumvirat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "triumvirat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f0fbddb-cf7d-3d9e-9465-94d5f51a6f8d",
                                        "entry_id": "ef0601ca-e2dd-30f3-9b91-ebe2c8638272",
                                        "glosses": [
                                            "Fonction de triumvir."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6ade0b3-bc40-389f-af83-c823d71222af",
                                        "entry_id": "ef0601ca-e2dd-30f3-9b91-ebe2c8638272",
                                        "glosses": [
                                            "Association de trois citoyens puissants pour exercer l’autorité suprême."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b036eed-203e-498f-a1d7-cb4ae5b55109",
                                                "sense_id": "b6ade0b3-bc40-389f-af83-c823d71222af",
                                                "text": "Un autre triumvirat, formé de Duport, un avocat, de Barnave, un conseiller, et de Lameth, un colonel, s'appuyait sur l'extrême gauche, […]."
                                            },
                                            {
                                                "example_id": "bf89971e-752b-4546-a6f5-7e337a8b0cf8",
                                                "sense_id": "b6ade0b3-bc40-389f-af83-c823d71222af",
                                                "text": "Le triumvirat déclenche contre lui de nouvelles polémiques, bientôt frénétiques, dans lesquelles l'argumentation fait place à une scolastique forgée pour les besoins de la cause et oppose sans fin le léninisme au trotskisme, comme la vérité révélée à l'hérésie, le mal au bien, le salut à la perdition."
                                            },
                                            {
                                                "example_id": "a97778e1-f5f9-407a-88b9-52f94a5fe4cd",
                                                "sense_id": "b6ade0b3-bc40-389f-af83-c823d71222af",
                                                "text": "Sa tactique fut de dépopulariser Barère, l'ancien feuillant. Il s'acharna sur le triumvirat auquel il était lié, l’accablant, chaque jour, des mêmes malédictions."
                                            },
                                            {
                                                "example_id": "41f7c837-8837-4c93-87b3-e43a70ece65a",
                                                "sense_id": "b6ade0b3-bc40-389f-af83-c823d71222af",
                                                "text": "En 1921, un triumvirat dirigé par le général José Maria Orellana (1921-1926) renversa Herrera. Orellana entreprit de renégocier avec l'entreprise d'électricité Bond & Share ; il créa le quetzal comme monnaie en parité avec le dollar, ce qui était une dévaluation de fait, au bénéfice des producteurs de café."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac656bf8-2c45-3754-acc7-8889fedbde64",
                                        "entry_id": "ef0601ca-e2dd-30f3-9b91-ebe2c8638272",
                                        "glosses": [
                                            "Exercice, de la durée de leur pouvoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3854257d-45fb-4202-8b31-6bd83ecde8d8",
                                                "sense_id": "ac656bf8-2c45-3754-acc7-8889fedbde64",
                                                "text": "Sous le triumvirat d’Octave, d’Antoine et de Lépide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1251e0fa-56d7-3bc6-904a-4688a7c4c445",
                                        "entry_id": "ef0601ca-e2dd-30f3-9b91-ebe2c8638272",
                                        "glosses": [
                                            "Trois personnages qui exercent en commun une grande influence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ba7bdba-2c28-4afe-ab1a-262296749fb7",
                                                "sense_id": "1251e0fa-56d7-3bc6-904a-4688a7c4c445",
                                                "text": "Ces messieurs formaient avec M. Masun un triumvirat qui, depuis quelques années, tyrannisait la ville."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b30ceaca-946c-429f-8370-406becf25552",
                        "source_entry_id": "006a7cda-e992-3554-8f93-d61178c06493",
                        "source_sense_id": "4575e270-7b6f-3917-8931-7ec4915be98f",
