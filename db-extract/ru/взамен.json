        "ru-extract.jsonl": [
            {
                "entry_id": "198bc827-911e-3956-aafc-3fd0ff7e41dc",
                "word": "взамен",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3c2746aa-f50e-3e59-843c-0d7e302326d2",
                        "entry_id": "198bc827-911e-3956-aafc-3fd0ff7e41dc",
                        "glosses": [
                            "вместо, в обмен на что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34009c26-81fd-48c8-b5dc-b461081c63b5",
                                "sense_id": "3c2746aa-f50e-3e59-843c-0d7e302326d2",
                                "text": "Я отдал перстень в Кабинет и получил взамен, за обыкновенными вычетами, 800 рублей."
                            },
                            {
                                "example_id": "579e7c10-ded3-4d32-9a52-bd242add6064",
                                "sense_id": "3c2746aa-f50e-3e59-843c-0d7e302326d2",
                                "text": "Одна смерть и сто жизней взамен ― да ведь тут арифметика!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ae4377d-38f8-4e51-993a-44463b7ac3c4",
                        "source_entry_id": "198bc827-911e-3956-aafc-3fd0ff7e41dc",
                        "source_sense_id": "3c2746aa-f50e-3e59-843c-0d7e302326d2",
                        "target_lang_word": "instead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f88936e-d61f-3f5f-aa5c-322d320c2acd",
                                        "entry_id": "8579a745-566b-3566-bc21-4f1a0f218b0f",
                                        "glosses": [
                                            "In the place of something (usually mentioned earlier); as a substitute or alternative."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cd72ed9-4a88-45a8-a2ca-bb62dbc766da",
                                                "sense_id": "3f88936e-d61f-3f5f-aa5c-322d320c2acd",
                                                "text": "I was going to go shopping, but I went dancing instead."
                                            },
                                            {
                                                "example_id": "c2da3052-367b-4170-a397-fb704eabc456",
                                                "sense_id": "3f88936e-d61f-3f5f-aa5c-322d320c2acd",
                                                "text": "‘It's rather like a beautiful Inverness cloak one has inherited. Much too good to hide away, so one wears it instead of an overcoat and pretends it's an amusing new fashion.’"
                                            },
                                            {
                                                "example_id": "95c6f3b4-6d2f-4d2c-800d-213f2ff66669",
                                                "sense_id": "3f88936e-d61f-3f5f-aa5c-322d320c2acd",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. […] But the scandals kept coming, […]. A broad section of the political class now recognises the need for change but remains unable to see the necessity of a fundamental overhaul. Instead it offers fixes and patches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26d01c35-6078-4fcd-847c-78893f738052",
                        "source_entry_id": "198bc827-911e-3956-aafc-3fd0ff7e41dc",
                        "source_sense_id": "3c2746aa-f50e-3e59-843c-0d7e302326d2",
                        "target_lang_word": "en échange",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "284a6639-edc7-4bfe-9589-ff3ddfe0d212",
                        "source_entry_id": "198bc827-911e-3956-aafc-3fd0ff7e41dc",
                        "source_sense_id": "3c2746aa-f50e-3e59-843c-0d7e302326d2",
                        "target_lang_word": "en retour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en retour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66913336-8cad-3047-ac94-49fedd73572c",
                                        "entry_id": "b6b2120a-41d6-3af0-bc76-f367a54670b7",
                                        "glosses": [
                                            "En échange ; par réciprocité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ad0e394-836b-4edd-a4cc-77d6498bc373",
                                                "sense_id": "66913336-8cad-3047-ac94-49fedd73572c",
                                                "text": "Pourtant, comme tous les engouements semblables, la francophilie est un phénomène à sens unique. Un groupe national manifestant un tel penchant affectif, intellectuel ou politique n'obtient pas, en retour, de la grande puissance honorée une meilleure connaissance de ses réalités."
                                            },
                                            {
                                                "example_id": "8c3a7771-a142-4978-8588-815a0e69cd83",
                                                "sense_id": "66913336-8cad-3047-ac94-49fedd73572c",
                                                "text": "Lors d'une halte, en remontant dans le truck, Paul montre à Stacy les cookies qu'il a dérobés. En retour, elle lui montre les deux yaourts à boire qu'elle a subtilisés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "4377f74f-a1d4-38e9-8c0f-53a95f41bd9a",
                "word": "взамен",
                "pos": "prep",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a81e2363-d46e-3a21-ada0-f7c9049d10e7",
                        "entry_id": "4377f74f-a1d4-38e9-8c0f-53a95f41bd9a",
                        "glosses": [
                            "соответствует по значению словам: заменяя, замещая кого-либо или что-либо, вместо кого-либо или чего-либо"
                        ],
                        "tags": [
                            "с род. п."
                        ],
                        "examples": [
                            {
                                "example_id": "6e7763b6-9dbc-4faf-b9c6-70dffdf3ce38",
                                "sense_id": "a81e2363-d46e-3a21-ada0-f7c9049d10e7",
                                "text": "С остальными ссыльными я встречалась от случая к случаю, раз в десять дней, когда мы приходили отмечать свой документ, выданный взамен паспорта."
                            },
                            {
                                "example_id": "d80df67f-ddec-47b5-befc-3a7a1ec03e4a",
                                "sense_id": "a81e2363-d46e-3a21-ada0-f7c9049d10e7",
                                "text": "Не скажу, чтобы Катя так уж любила ящериц или змей, но ей позволено было (за компанию с Машей) то, что не позволялось прежде, и она с удовольствием переключилась на зверей и насекомых ― взамен музыкальных уроков и чтения детских книжек."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6c64f98-f4c6-4a7a-8eda-afeb1cb991e7",
                        "source_entry_id": "4377f74f-a1d4-38e9-8c0f-53a95f41bd9a",
                        "source_sense_id": "a81e2363-d46e-3a21-ada0-f7c9049d10e7",
                        "target_lang_word": "in stead of",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in stead of",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb22798c-79d2-3ee4-9699-a355d1ed3ceb",
                                        "entry_id": "1a59eff2-7573-3e47-8522-b42e128cca1c",
                                        "glosses": [
                                            "Archaic form of instead of."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a1f388e-0c8b-4b4a-ad0a-9a1fc9d8783d",
                                                "sense_id": "bb22798c-79d2-3ee4-9699-a355d1ed3ceb",
                                                "text": "Slaue I haue ſet my life vpon a caſt, / And I will ſtand the hazard of the die, / I thinke there be ſixe Richmonds in the field, / Fiue haue I ſlaine to daie in ſtead of him, / A horſe, a horſe, my kingdome for a horſe."
                                            },
                                            {
                                                "example_id": "6dd1c43e-4bc0-4aae-8b8e-586f6703d0cf",
                                                "sense_id": "bb22798c-79d2-3ee4-9699-a355d1ed3ceb",
                                                "text": "I my ſelfe vvill haue / The beards of Barbels, ſeru'd, in ſtead of ſallades; / Oyld Muſhromes; and the ſvvelling vnctuous papps / Of a fat pregnant Sovv, nevvly cut off, / Dreſt vvith an exquiſite, and poynant ſauce; […]"
                                            },
                                            {
                                                "example_id": "26a5a643-feae-49fa-a8a9-62c4eb01e9f2",
                                                "sense_id": "bb22798c-79d2-3ee4-9699-a355d1ed3ceb",
                                                "text": "The Reformation you haue made of the many and maine corruptions of the Romiſh Ch[urch] vve do ingenuouſly acknovvledge, and doe vvithall imbrace vvith you all the truths vvhich to our knovvledge you haue receiued in ſtead of them. But Rome vvas not built all in a day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "137c10eb-9805-4476-8209-7b87da9b6ff0",
                        "source_entry_id": "4377f74f-a1d4-38e9-8c0f-53a95f41bd9a",
                        "source_sense_id": "a81e2363-d46e-3a21-ada0-f7c9049d10e7",
                        "target_lang_word": "instead of",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instead of",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "682c640e-1fbe-3688-b558-f173415d3ca5",
                                        "entry_id": "dd6dbd90-27d2-353e-a458-1773da5bb8f2",
                                        "glosses": [
                                            "In lieu of; in place of; rather than."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f4db74-cc9c-4589-ae6a-44cc2f6defe3",
                                                "sense_id": "682c640e-1fbe-3688-b558-f173415d3ca5",
                                                "text": "He walked to school instead of taking the car."
                                            },
                                            {
                                                "example_id": "b032b412-2c6f-4b28-95c3-2f2d519d0315",
                                                "sense_id": "682c640e-1fbe-3688-b558-f173415d3ca5",
                                                "text": "And he shall be thy spokesman unto the people: and he shall be, even he shall be to thee instead of a mouth, and thou shalt be to him instead of God."
                                            },
                                            {
                                                "example_id": "b315688f-cc63-43ff-b15c-c06b56d6c61b",
                                                "sense_id": "682c640e-1fbe-3688-b558-f173415d3ca5",
                                                "text": "Then we relapsed into a discomfited silence, and wished we were anywhere else. But Miss Thorn relieved the situation by laughing aloud, and with such a hearty enjoyment that instead of getting angry and more mortified we began to laugh ourselves, and instantly felt better."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "854e9585-f2a9-4931-9955-700fd0dab19d",
                        "source_entry_id": "4377f74f-a1d4-38e9-8c0f-53a95f41bd9a",
                        "source_sense_id": "a81e2363-d46e-3a21-ada0-f7c9049d10e7",
