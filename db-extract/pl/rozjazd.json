                                    },
                                    {
                                        "sense_id": "48b764d8-4d7c-31af-8bdd-29a2743035fe",
                                        "entry_id": "207df262-5c9c-3a54-82bd-a7d73265f88e",
                                        "glosses": [
                                            "A place where two things meet, especially where two roads meet."
