                                        "glosses": [
                                            "A country in Southern Africa. Official name: Republic of South Africa. Capitals: Pretoria, Cape Town, and Bloemfontein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d8f9830-945d-4654-bef8-19ee109d7b01",
                                                "sense_id": "640b1321-715f-3ba9-971b-e0c88e191f76",
                                                "text": "The facts show that the genocide President Donald Trump suggests might be happening is not happening – and that crime against White farmers in South Africa represents a tiny fraction of the country’s overall crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72280a9a-a868-3621-b098-912ea00de81e",
                                        "entry_id": "af99e608-f3b1-3b46-8acd-3c29e7b354a0",
                                        "glosses": [
                                            "Southern Africa (a region of Africa)."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "641944e8-a169-4446-9e1f-18917dd82296",
                                                "sense_id": "72280a9a-a868-3621-b098-912ea00de81e",
                                                "text": "With the exception of the Portuguese Colonies, the Journal is franked to all parts of South Africa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06ec9e31-8329-40cc-955d-d8e4b1d07b27",
                        "source_entry_id": "2a4b2787-fe1f-3223-81de-eb7a0d19e685",
                        "source_sense_id": "72640f40-8b62-3009-95a5-5bd7c7b77a6b",
