                                "target_senses": [
                                    {
                                        "sense_id": "9db29973-0437-3cc3-a177-37187a2f9522",
                                        "entry_id": "c25e1c6d-109f-3338-81ff-e7a083b9e972",
                                        "glosses": [
                                            "das Zurücklegen eines Weges durch einen Raum oder ein Gebiet (fahrend, fliegend oder gehend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d41e354-a627-42f2-99f8-bbd7b6b52197",
                                                "sense_id": "9db29973-0437-3cc3-a177-37187a2f9522",
                                                "text": "„Die erste Durchquerung Sibiriens durch die Kosaken erfolgte seinerzeit relativ weit im Norden.“"
                                            }
                                        ],
