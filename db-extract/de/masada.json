                "senses": [
                    {
                        "sense_id": "2a111630-ea5b-3a8a-b7f7-474332117a8a",
                        "entry_id": "85e5838a-0ad0-3cc1-a0c6-c3cf448f92d9",
                        "glosses": [
                            "archäologische Stätte im Süden Israels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "299ba94f-6b6f-43a0-a108-0fc875eff57b",
                                "sense_id": "2a111630-ea5b-3a8a-b7f7-474332117a8a",
                                "text": "„Masada war der Ort, an dem jüdische Kämpfer angeblich beschlossen, mit ihren Familien Selbstmord zu begehen, statt vor den überlegenen römischen Truppen zu kapitulieren.“"
                            },
                            {
                                "example_id": "40ef00e9-d3bf-4a6a-8450-ba0a3b0cc79c",
                                "sense_id": "2a111630-ea5b-3a8a-b7f7-474332117a8a",
                                "text": "„Dafür war es der zionistischen Bewegung jedoch gelungen, ein Bergplateau am Ufer des Toten Meeres zu erwerben, wo eine kleine Gruppe jüdischer Rebellen den Römern bis zum Tod erbitterten Widerstand geleistet hatte: Masada.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
