                    {
                        "sense_id": "9fd98f9e-a20b-3572-a30a-72d198c39512",
                        "entry_id": "6fd7bc78-0466-3e38-8334-0bb6e8b44df1",
                        "glosses": [
                            "de mate waarin iets makkelijk vervormbaar is of buigbaar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c8cd740-6494-4607-9076-1850868119e2",
                                "sense_id": "9fd98f9e-a20b-3572-a30a-72d198c39512",
                                "text": "Nee, gravin, zei hij ten slotte, dit is een Europees talent, ze hoeft niets meer te leren, wat een soepelheid, een tederheid en een kracht..."
                            },
                            {
                                "example_id": "c64a1412-9d19-4619-b48c-ca317774ce8d",
                                "sense_id": "9fd98f9e-a20b-3572-a30a-72d198c39512",
                                "text": "Huidtransplantaties bij patiënten met grote en diepe brandwonden leiden heel vaak tot littekens die zeer vervelend zijn voor patiënten. Ze jeuken en beperken de soepelheid van de huid. Soms kunnen mensen daardoor ledematen slecht bewegen. En dan zijn nieuwe operaties nodig."
                            }
                        ]
                    },
                    {
