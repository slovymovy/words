                "senses": [
                    {
                        "sense_id": "307ebc93-4090-39ab-95f4-d8dd0a357a88",
                        "entry_id": "5a5799ba-a686-331d-a090-e3a964d93054",
                        "glosses": [
                            "Truppe, die in einer Kolonie im Dienst einer Kolonialmacht steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da928efb-5327-4792-b47a-6ffa8ddef5b7",
                                "sense_id": "307ebc93-4090-39ab-95f4-d8dd0a357a88",
                                "text": "„Gemeinsam mit anderen Exiloffizieren und 200 miserabel ausgerüsteten Soldaten attakierte er die spanische Festung an der Mündung des Río Magdalena und besiegte die eigentlich überlegenen Kolonialtruppen.“"
                            },
                            {
                                "example_id": "d6263b6f-913f-4d42-9dfa-f906fc9e79b8",
                                "sense_id": "307ebc93-4090-39ab-95f4-d8dd0a357a88",
                                "text": "„Wenig später wurde er ebenso wie die meisten seiner Anhänger von den britischen Kolonialtruppen ermordet.“"
                            }
                        ],
