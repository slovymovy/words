                        "entry_id": "9425efee-a279-3484-bb53-c80cc85eaca0",
                        "glosses": [
                            "Possessed of whiskers; covered in bristles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94f2f345-cb3a-47b8-9b29-f8afdc4108d9",
                                "sense_id": "2fc793b5-a037-3572-842b-718314b8c884",
                                "text": "Michael's heavily whiskered face hadn't seen a razor in some days."
                            },
                            {
                                "example_id": "4a4a9321-937b-460c-a2ba-76924a367569",
                                "sense_id": "2fc793b5-a037-3572-842b-718314b8c884",
                                "text": "Their attention was, however, too much taken up with their fellow-passengers: a whiskered, cloaked, and cigared youth, with every thing military about him but the air:..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72c8f348-73ee-474a-bfa7-39aa0852eadd",
                        "source_entry_id": "9425efee-a279-3484-bb53-c80cc85eaca0",
                        "source_sense_id": "2fc793b5-a037-3572-842b-718314b8c884",
