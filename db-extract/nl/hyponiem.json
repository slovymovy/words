                                        "glosses": [
                                            "Submissive or inferior to, or controlled by authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15aa8db1-671c-451a-9ae4-aa26ff0aa4d3",
                                                "sense_id": "fc2a8910-3b99-3e4f-8980-a64de6736836",
                                                "text": "November 9, 1662, Robert South, Of the Creation of Man in the Image of God\nIt was subordinate, not enslaved, to the understanding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb7f8b7-4c77-3591-9512-a97c0f7f4767",
                                        "entry_id": "cdd618c7-a99a-34bd-9202-aa0d8d10de63",
                                        "glosses": [
                                            "dependent on and either modifying or complementing the main clause"
                                        ],
                                        "tags": [
