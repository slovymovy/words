                            "future"
                        ],
                        "form": "буду/будешь… ки́снуть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6173fae-0709-34fe-9f00-eeed461e4d42",
                        "entry_id": "2e85e17e-3be1-3803-9d40-6579c7938194",
                        "glosses": [
                            "становиться кислым, портиться от брожения"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2f0cdb06-1651-3645-89b5-7e11f2724b52",
                        "entry_id": "2e85e17e-3be1-3803-9d40-6579c7938194",
                        "glosses": [
                            "перен. разг. пребывать в подавленном, угнетённом настроении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bade831c-85d4-4da9-a66e-ae921cfad08c",
                                "sense_id": "2f0cdb06-1651-3645-89b5-7e11f2724b52",
                                "text": "Домашнее хозяйство ведет экономка, территорию вокруг дома обслуживает садовник ― одним словом, делать Нине решительно нечего, и она стала киснуть от скуки, периодически устраивая мужу скандалы."
                            }
                        ]
                    },
                    {
                        "sense_id": "77413087-43bb-3b5e-953d-2a69c287edf4",
                        "entry_id": "2e85e17e-3be1-3803-9d40-6579c7938194",
                        "glosses": [
                            "перен. разг. вести однообразную, бездеятельную жизнь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d43f19d6-46f7-4379-8d03-2de2c7a2cebc",
                                "sense_id": "77413087-43bb-3b5e-953d-2a69c287edf4",
                                "text": "Счастливая, я слышала, ты с вышек прыгаешь, рекорды берёшь, ― не то что я, несчастная, должна киснуть на этой даче."
                            },
                            {
                                "example_id": "4f0742a8-0380-4f38-bfc8-ba11bd9546d5",
                                "sense_id": "77413087-43bb-3b5e-953d-2a69c287edf4",
                                "text": "Неужели я уж так неинтересна как человек и некрасива как женщина, чтобы мне всю жизнь киснуть в этой трущобе, в этом гадком местечке, которого нет ни на одной географической карте!"
                            },
                            {
                                "example_id": "33894a6c-8056-4502-9d92-b8c32a2de74a",
                                "sense_id": "77413087-43bb-3b5e-953d-2a69c287edf4",
                                "text": "А я люблю сильные впечатления и предпочитаю подвергнуться на японских шхунах риску, чем сидеть неподвижно в вашем Охотске, киснуть и ждать у моря погоды!"
                            }
                        ]
                    }
                ],
                "translations": [],
