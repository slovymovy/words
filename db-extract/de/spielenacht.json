                "senses": [
                    {
                        "sense_id": "0b11c589-7726-3036-b082-5f58e1870f6b",
                        "entry_id": "aae96d18-1fbd-373d-86c7-c54f634415a5",
                        "glosses": [
                            "Veranstaltung, die nachts stattfindet und bei der hauptsächlich Spiele (zum Beispiel Brettspiele, Videospiele) gespielt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d1a49eb-e8c5-4042-a7a1-4bf0dd74e006",
                                "sense_id": "0b11c589-7726-3036-b082-5f58e1870f6b",
                                "text": "Es ist längst kein Spieleabend mehr – nach 22 Uhr nennt man es eine Spielenacht."
                            },
                            {
                                "example_id": "ea936a24-8865-4b47-9b16-6f1446a64ff0",
                                "sense_id": "0b11c589-7726-3036-b082-5f58e1870f6b",
                                "text": "Während der langen Spielenacht spielten wir bis zum Morgengrauen."
                            },
                            {
                                "example_id": "9b00b882-378d-449f-8f15-877c5c19ef07",
                                "sense_id": "0b11c589-7726-3036-b082-5f58e1870f6b",
                                "text": "„Und dennoch geht’s vor allem nicht um Online-, sondern Brett- und andere Games. Das Programm für die digitale Spielenacht ist ziemlich abwechslungsreich.“"
                            },
                            {
                                "example_id": "49ae45f2-551f-4d58-9588-d82d89a64923",
                                "sense_id": "0b11c589-7726-3036-b082-5f58e1870f6b",
                                "text": "„Am Samstag, 12. Dezember, wird das Jugendzentrum (JUZ) von Altomünster so eine Spielenacht für Jugendliche von 16 bis 25 Jahren ausrichten, zu der natürlich auch Mädchen zugelassen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
