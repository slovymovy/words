                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62bd0232-2222-464f-91eb-1091548fbdef",
                                "sense_id": "32c88eac-fcc3-3fb4-a858-2959f53d857d",
                                "text": "Płynie ciurkiem anyżówka i marcowe szumi piwo."
                            },
                            {
                                "example_id": "6b431858-656c-462d-bd57-9aad4002a4c5",
                                "sense_id": "32c88eac-fcc3-3fb4-a858-2959f53d857d",
                                "text": "Idzie Grześ • Przez wieś, • Worek piasku niesie, • A przez dziurkę • Piasek ciurkiem • Sypie się za Grzesiem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3cc94792-868f-357a-b70f-4b345d906fe8",
                        "entry_id": "34b100b0-e650-3444-b63a-e10cac45a829",
                        "glosses": [
                            "jeden za drugim, bez dokonywania wyboru"
                        ],
                        "tags": [],
                        "examples": [
