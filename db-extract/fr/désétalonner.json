                "senses": [
                    {
                        "sense_id": "e626f61c-8194-3d24-bb9d-4cfe7c21aa75",
                        "entry_id": "9d046444-8bff-3c8d-8504-477a52e1b543",
                        "glosses": [
                            "Faire perdre à quelque chose sa conformité à un étalon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96609151-ef7c-48d0-90ef-df77e4db31f7",
                                "sense_id": "e626f61c-8194-3d24-bb9d-4cfe7c21aa75",
                                "text": "Est-il possible que le coup de foudre ait pu le désétalonner et qu'il ait développé une hyper sensibilité ?"
                            },
                            {
                                "example_id": "eba6e646-e3b7-4738-8fdd-7ebb36572fcf",
                                "sense_id": "e626f61c-8194-3d24-bb9d-4cfe7c21aa75",
                                "text": "Décalage de température d'air extérieur. Cette option permet d'étalonner (ou de désétalonner volontairement) la température extérieure."
                            },
                            {
                                "example_id": "6d2fb6d7-8ebc-43b2-a3ff-841a2c69f7b6",
                                "sense_id": "e626f61c-8194-3d24-bb9d-4cfe7c21aa75",
                                "text": "On lui reproche surtout de se \"désétalonner\" avec le temps."
                            }
                        ]
                    }
