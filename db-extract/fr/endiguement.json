        "fr-extract.jsonl": [
            {
                "entry_id": "7443ee30-7262-3250-906a-c2e146393eb4",
                "word": "endiguement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3098af07-55c0-442d-8cf8-357c831ef4b5",
                        "entry_id": "7443ee30-7262-3250-906a-c2e146393eb4",
                        "tags": [
                            "plural"
