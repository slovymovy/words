                                    {
                                        "sense_id": "db49b0cb-3e95-35fe-9fb1-8e9148c23d19",
                                        "entry_id": "1877ea37-086d-317d-b3c2-0f58be1857f8",
                                        "glosses": [
                                            "Synonym of starting point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94cac7cd-ec64-4e2d-b562-f9315a1b5773",
                                                "sense_id": "db49b0cb-3e95-35fe-9fb1-8e9148c23d19",
                                                "text": "[…] the point of departure is Hong Kong International Airport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38bdb741-6ec8-39c4-87e8-2e03c7ef993b",
                                        "entry_id": "1877ea37-086d-317d-b3c2-0f58be1857f8",
                                        "glosses": [
                                            "of abstract processes that can be compared to a voyage: initial circumstances. Frequent collocations include, but are not limited to"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "334a79d0-319d-4c87-8c04-706fc249643a",
                                                "sense_id": "38bdb741-6ec8-39c4-87e8-2e03c7ef993b",
                                                "text": "[…] so “going back to the way things were” is not a useful point of departure."
                                            },
                                            {
                                                "example_id": "4016349e-3768-4d5a-ad4b-8557887843a0",
                                                "sense_id": "38bdb741-6ec8-39c4-87e8-2e03c7ef993b",
                                                "text": "Its point of departure is the view that conceptions of agency are […]"
                                            },
                                            {
                                                "example_id": "a894cede-6e67-43fd-9f10-05f1dc6a4ab5",
                                                "sense_id": "38bdb741-6ec8-39c4-87e8-2e03c7ef993b",
                                                "text": "[…] choosing to be childfree was a huge point of departure from my community […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf61030e-93f4-32ee-ad89-af58d8d72880",
                                        "entry_id": "1877ea37-086d-317d-b3c2-0f58be1857f8",
                                        "glosses": [
                                            "a dosage level at which additional administration of an agent significantly loses its efficacy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02765568-4caf-49d8-88bd-b6d3b47ca7d4",
                                                "sense_id": "cf61030e-93f4-32ee-ad89-af58d8d72880",
                                                "text": "In toxicology, point of departure (POD) is defined as the point on a toxicological dose-response curve […] generally corresponding to an estimated low effect level or no effect level."
                                            }
                                        ]
