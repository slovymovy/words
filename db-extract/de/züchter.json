                                "target_senses": [
                                    {
                                        "sense_id": "ba114180-ba0e-36cf-a089-34ddc73e29f0",
                                        "entry_id": "fd116c16-a2ed-317b-8d7a-d3bb83262460",
                                        "glosses": [
                                            "Celui qui élève des animaux."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3710404-cc9b-4350-9349-1c88179082b3",
                                                "sense_id": "ba114180-ba0e-36cf-a089-34ddc73e29f0",
                                                "text": "Suivez donc la marche que vous avez adoptée, éleveurs de l’Artois, de la Picardie, du Perche, des Ardennes et de la Franche-Comté, votre intelligence est au-dessus de celle de l’administration des haras."
                                            },
                                            {
                                                "example_id": "ab10e2e1-14f6-4384-a267-163ed1d45f86",
                                                "sense_id": "ba114180-ba0e-36cf-a089-34ddc73e29f0",
                                                "text": "L’éleveur ne peut vendre aucun des chevaux d’élevage de son taboune avant qu'il ait atteint l'âge de trois ans et demi et qu'il ait été présenté à la commission."
                                            },
                                            {
                                                "example_id": "146013c1-3ea9-4b54-8426-5743ae487a5b",
                                                "sense_id": "ba114180-ba0e-36cf-a089-34ddc73e29f0",
                                                "text": "De même le chasseur, quand il intervint pour guider les migrations naturelles des troupeaux, qu'il se contentait au début de suivre, devint un pasteur ; puis éleveur, quand il fit venir artificiellement, « agriculturalement », une partie du fourrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94c90cc9-a730-3a31-a10e-38fa66fe5ae1",
                                        "entry_id": "fd116c16-a2ed-317b-8d7a-d3bb83262460",
                                        "glosses": [
                                            "Celui qui surveille le vieillissement des vins, après la récolte."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c5e6470-5145-4ab9-894e-19a54c12ef71",
                        "source_entry_id": "45ca58e2-2aeb-3d88-829c-e9abd06caa6b",
