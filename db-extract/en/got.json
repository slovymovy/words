                                "example_id": "edc7eb75-17be-4547-96ca-a24fdcca648e",
                                "sense_id": "24742ce9-5aeb-3115-9ad8-bb061bd2eeb1",
                                "text": "I got to go study.",
                                "translation": "我得去學習。"
                            },
                            {
                                "example_id": "7cc49314-0642-4dd2-ac99-b580703ca426",
                                "sense_id": "24742ce9-5aeb-3115-9ad8-bb061bd2eeb1",
                                "text": "We got to ride to clean up the streets / For our wives and our daughters!"
                            }
                        ]
                    },
                    {
                        "sense_id": "949ebe4f-fdc5-36fc-a7e5-753e25e96227",
                        "entry_id": "24f5fbdd-a3cf-3bfb-9d90-0420701d262e",
                        "glosses": [
