        "ru-extract.jsonl": [
            {
                "entry_id": "ea2266ad-6dce-34a0-aaaf-2a07c3f19072",
                "word": "израилев",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "37d2e78d-4ab9-3682-9ddf-02da410c96d7",
                        "entry_id": "ea2266ad-6dce-34a0-aaaf-2a07c3f19072",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным Израиль"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a1ff186-c41e-49dc-aa28-b18400c7f70f",
                                "sense_id": "37d2e78d-4ab9-3682-9ddf-02da410c96d7",
                                "text": "Штопал израилев сын рваный суконный мундир с зеленой выпушкой."
                            },
                            {
                                "example_id": "a9a086bb-821e-4233-9eca-963500314365",
                                "sense_id": "37d2e78d-4ab9-3682-9ddf-02da410c96d7",
                                "text": "И главное ― без всякого за это упрека, укора, наказания, запрещения от Бога: на каковые упреки Бог израилев был в Ветхом Завете весьма быстр и скор."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
