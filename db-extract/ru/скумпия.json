                "senses": [
                    {
                        "sense_id": "5d37fb33-8f0e-354e-8366-23c1036036d0",
                        "entry_id": "552527f9-ba4c-3d7f-bfa9-91f27523cb34",
                        "glosses": [
                            "представитель одноимённого рода листопадных растений, кустарников или деревьев, семейства Сумаховые"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7290c54-c3b6-4160-870a-dfd4f5fa6ccb",
                                "sense_id": "5d37fb33-8f0e-354e-8366-23c1036036d0",
                                "text": "У скумпии в состав ядровых веществ входит также и физетин, придающий ядру этого кустарника характерный золотисто-жёлтый цвет. Клетки, содержащие физетин в молодых побегах скумпии, встречаются в сердцевине, образуя около ксилемы почти непрерывную обкладку."
                            }
                        ]
                    }
