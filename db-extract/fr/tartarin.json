                "senses": [
                    {
                        "sense_id": "eae7db74-6a87-30b2-8e86-7a4e8a333b5c",
                        "entry_id": "b7d5f116-15aa-3212-88f8-29d5548ae12d",
                        "glosses": [
                            "Fanfaron, hâbleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28066cb8-7dbe-40c3-ba11-f2fac35853d5",
                                "sense_id": "eae7db74-6a87-30b2-8e86-7a4e8a333b5c",
                                "text": "Y avait que son grand-père qui comptait. Un Tartarin !… Un feignant qui n’avait même pas fait la guerre… Réformé pour ses pieds plats…"
                            },
                            {
                                "example_id": "694a5736-939c-4a62-8f81-f7aeb55112d5",
                                "sense_id": "eae7db74-6a87-30b2-8e86-7a4e8a333b5c",
                                "text": "L’homme a beau se propulser dans la beauté, il retombe toujours dans ses penchants. Le décor n’y fait rien !\nEn outre, une rafale ramène à la réalité le Tartarin qui prend la montagne pour le piédestal de sa majesté : il n’a rien à faire là et doit remettre son cache-nez."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
