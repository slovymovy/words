        "fr-extract.jsonl": [
            {
                "entry_id": "3c5866d4-10e9-3b04-bba1-c3ae6f5dd1f7",
                "word": "infirmerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cd4c73c3-0fdd-4a0d-843a-b07735d9abc4",
                        "entry_id": "3c5866d4-10e9-3b04-bba1-c3ae6f5dd1f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "infirmeries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b9498f8-ae40-340c-8801-9a671b49c0cc",
                        "entry_id": "3c5866d4-10e9-3b04-bba1-c3ae6f5dd1f7",
                        "glosses": [
                            "Lieu destiné, en général, à recevoir des malades peu gravement atteints dans les communautés et maisons religieuses, dans les casernes, dans les collèges, dans tout établissement d’instruction comportant un internat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4121567-b67d-4316-86fe-415b7140e1b6",
                                "sense_id": "4b9498f8-ae40-340c-8801-9a671b49c0cc",
                                "text": "J’ai parlé tout à l’heure de l’insuffisance du personnel à l’infirmerie de Chelsa. Que dire à ce point de vue de l’infirmerie de Gray’s Inn? Pour ces 500 malades, il n’y a qu’un médecin."
                            },
                            {
                                "example_id": "1f96b34a-9c82-4ae6-9516-b9526a6c9faa",
                                "sense_id": "4b9498f8-ae40-340c-8801-9a671b49c0cc",
                                "text": "L'assistance médicale était organisée ; les infirmeries indigènes, créées dans chacun de nos postes, voyaient affluer, chaque jour, des centaines de consultants dont certains venaient se faire panser les blessures reçues en nous combattant ; […]."
                            },
                            {
                                "example_id": "1519e6b5-0bd2-42b8-a40b-2e431caf0301",
                                "sense_id": "4b9498f8-ae40-340c-8801-9a671b49c0cc",
                                "text": "Chaque hôpital possédait une tisanerie ; celle—ci dépendait de l’infirmerie du fort ; on y descendait par un petit escalier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "037e9d3f-9e40-4bdb-93c1-3f875658c1c5",
                        "source_entry_id": "3c5866d4-10e9-3b04-bba1-c3ae6f5dd1f7",
                        "source_sense_id": "4b9498f8-ae40-340c-8801-9a671b49c0cc",
                        "target_lang_word": "Revier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Revier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73147a0a-154f-3c81-8e7d-4d4ccc980513",
                                        "entry_id": "873964bd-9df1-3c28-9160-9c9ec2ad0191",
                                        "glosses": [
                                            "engster Aktionsraum eines Tieres, der gegen artgleiche Konkurrenten verteidigt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a4fdd59-90ba-4b9d-abdc-52815c1d024f",
                                                "sense_id": "73147a0a-154f-3c81-8e7d-4d4ccc980513",
                                                "text": "Singvögel kennzeichnen ihr Revier durch ihren Gesang."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd32cd49-41e2-36c4-84c8-33025f33fcc7",
                                        "entry_id": "873964bd-9df1-3c28-9160-9c9ec2ad0191",
                                        "glosses": [
                                            "Gebietseinheit unter anderem im Bergbau-, Feuerwehr-, Forst-, Jagd- und Polizeiwesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f2533ff-d263-43c1-98fe-4c191980d12c",
                                                "sense_id": "bd32cd49-41e2-36c4-84c8-33025f33fcc7",
                                                "text": "Der Jäger kennt sich in seinem Revier aus wie in seiner eigenen Westentasche."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2517573b-c738-38fa-9b0a-60861006a931",
                                        "entry_id": "873964bd-9df1-3c28-9160-9c9ec2ad0191",
                                        "glosses": [
                                            "Polizeirevier, Dienststelle der Schutzpolizei"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50e9ddd5-7439-4b3b-98d3-964aa9c6850f",
                                                "sense_id": "2517573b-c738-38fa-9b0a-60861006a931",
                                                "text": "Wenn sie den Alkoholtest verweigern, müssen wir sie zur Blutabnahme mit aufs Revier nehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e6a56d74-5b90-3e1c-bf4c-7d2b959952ed",
                                        "entry_id": "873964bd-9df1-3c28-9160-9c9ec2ad0191",
                                        "glosses": [
                                            "(das) Ruhrgebiet"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5fc8115-13d0-4aab-9615-0f5013f79e79",
                                                "sense_id": "e6a56d74-5b90-3e1c-bf4c-7d2b959952ed",
                                                "text": "„Die Randbezirke Nordrhein-Westfalens blieben allerdings weit hinter dem Ruhrgebiet zurück. Das Revier erlebte in den folgenden Jahrzehnten einen einzigartigen Aufstieg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb2a24cd-35bd-4499-b450-9218506c1618",
                        "source_entry_id": "3c5866d4-10e9-3b04-bba1-c3ae6f5dd1f7",
                        "source_sense_id": "4b9498f8-ae40-340c-8801-9a671b49c0cc",
                        "target_lang_word": "Krankenstation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krankenstation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ab26a9-f430-341f-b0b9-f654866b16a5",
                                        "entry_id": "cc1c956b-5251-3804-91ce-ddea3b8844f3",
                                        "glosses": [
                                            "abgetrennter Bereich für Kranke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4fb413c-7868-4804-895c-15b05161c4f8",
                                                "sense_id": "c9ab26a9-f430-341f-b0b9-f654866b16a5",
                                                "text": "„Mama ist lieber schon aus der Krankenstation zurückgekommen.“"
                                            },
                                            {
                                                "example_id": "56f1f79a-fb3a-4851-a869-63a78c1b10bb",
                                                "sense_id": "c9ab26a9-f430-341f-b0b9-f654866b16a5",
                                                "text": "„Die Krankenstation leitet ein deutscher Arzt, doch der kann kaum helfen.“"
                                            },
                                            {
                                                "example_id": "4a98025b-d64b-4356-9ddb-ee23d5bc2ad7",
                                                "sense_id": "c9ab26a9-f430-341f-b0b9-f654866b16a5",
                                                "text": "„Vor der Krankenstation der Mission wartet Schwester Gaudencia, die zweite Franziskanerin im Bunde.“"
                                            },
                                            {
                                                "example_id": "019f8aa4-b9eb-4325-b9d9-3feb0545118a",
                                                "sense_id": "c9ab26a9-f430-341f-b0b9-f654866b16a5",
                                                "text": "„Denn für Kranke gab es so gut wie keine Schonung, wenn sich die Krankheit nicht von alleine oder nach kurzem Aufenthalt auf der Krankenstation besserte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3736766-0d80-426a-a60e-0c96436fae1f",
                        "source_entry_id": "3c5866d4-10e9-3b04-bba1-c3ae6f5dd1f7",
