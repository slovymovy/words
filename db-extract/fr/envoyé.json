                    },
                    {
                        "form_id": "9ce66fce-b85a-4224-9160-260ecbf5caab",
                        "entry_id": "a7789815-4352-356b-a422-f80f4397b687",
                        "tags": [
                            "feminine"
                        ],
                        "form": "envoyée"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d36a1859-fda6-3814-b573-37bcfa77e5de",
                        "entry_id": "a7789815-4352-356b-a422-f80f4397b687",
                        "glosses": [
                            "Personne qui est envoyée quelque part par quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "090b8b6a-f29d-4417-ac15-f715d0e7e829",
                                "sense_id": "d36a1859-fda6-3814-b573-37bcfa77e5de",
                                "text": "En peu de mots, il expliqua sa mission, dit comment il était l’envoyé de Monsieur, et salua, selon leur rang et les avances qu’ils lui firent, l’amiral et les différents seigneurs anglais."
                            },
                            {
                                "example_id": "09efbd9b-8579-43af-a8d9-25d59b41637b",
                                "sense_id": "d36a1859-fda6-3814-b573-37bcfa77e5de",
                                "text": "L’empressement des envoyés des puissances pour venir adresser leurs félicitations à la cour des Tuileries avait été extrême."
                            },
                            {
                                "example_id": "6b441736-e52c-4ac3-afc7-9d9879cfb652",
                                "sense_id": "d36a1859-fda6-3814-b573-37bcfa77e5de",
                                "text": "Des conciliabules inutiles se tiennent entre les envoyés des nations."
                            },
                            {
                                "example_id": "d618dac2-190f-4908-a105-5e2bfc5f39e0",
                                "sense_id": "d36a1859-fda6-3814-b573-37bcfa77e5de",
                                "text": "Six hommes, des civils, se tenaient là, derrière une longue table. L'un d'eux, un petit homme au visage chafouin et au sourire figé, s'avança d'un petit pas sautillant vers les envoyés de Pékin. C'était le professeur Tcheng."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1fbcfb7-6bc7-4787-a2b6-4041b9546646",
                        "source_entry_id": "a7789815-4352-356b-a422-f80f4397b687",
                        "source_sense_id": "d36a1859-fda6-3814-b573-37bcfa77e5de",
                        "target_lang_word": "Gesandter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesandter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bcf9fee-f78c-37eb-a82c-644c8203e832",
                                        "entry_id": "7552d679-5c00-3303-bee7-dafc65d5f4d3",
                                        "glosses": [
                                            "diplomatischer, staatlicher Vertreter, der im Rang unterhalb eines Botschafters steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81d5b077-fdc3-42e2-b762-c65b6773e803",
                                                "sense_id": "4bcf9fee-f78c-37eb-a82c-644c8203e832",
                                                "text": "„Die drei Gesandten griffen gehorsam zu, aber eher diplomatischer Pflicht gehorchend als ihrem eigenen Appetit.“"
                                            },
                                            {
                                                "example_id": "7f11fe6e-5967-4ec4-9529-62ade02da59d",
                                                "sense_id": "4bcf9fee-f78c-37eb-a82c-644c8203e832",
                                                "text": "„Anwesend waren der französische Gesandte, der Prinz, der seit kurzer Zeit ein häufiger Gast im Hause der Gräfin war, und viele glänzende Damen und Herren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
