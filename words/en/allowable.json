{
    "word_family": [
        "allow",
        "allowance",
        "disallow",
        "disallowable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "57c6bbbf-9d3e-3ce8-a78a-bb23afcd01f0",
                    "sense_definition": "Permitted by rules, laws, or regulations; acceptable or legitimate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "permissible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee explained that the physical contact during the play was within <w>allowable</w> limits.",
                            "target_lang_translations": {
                                "pl": "Sędzia wyjaśnił, że kontakt fizyczny podczas gry mieścił się w <w>dopuszczalnych</w> granicach."
                            }
                        },
                        {
                            "text": "New regulations include strict rules about the maximum <w>allowable</w> level of chemicals in drinking water.",
                            "target_lang_translations": {
                                "pl": "Nowe regulacje zawierają surowe zasady dotyczące maksymalnego <w>dopuszczalnego</w> poziomu chemikaliów w wodzie pitnej."
                            }
                        }
                    ],
                    "synonyms": [
                        "leveful"
                    ],
                    "antonyms": [
                        "unallowable",
                        "forbidden",
                        "prohibited"
                    ],
                    "common_phrases": [
                        "allowable limit",
                        "maximum allowable level"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dozwolony przez zasady, prawo lub regulacje; akceptowalny lub legalny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dozwolony",
                                "target_lang_sense_clarification": "zgodny z przepisami lub zasadami"
                            },
                            {
                                "target_lang_word": "dopuszczalny",
                                "target_lang_sense_clarification": "mieszczący się w granicach normy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef87b201-e469-3821-bd66-d62c861c2c81",
                    "sense_definition": "Appropriate, satisfactory, or socially acceptable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "acceptable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In formal debates, a certain amount of emotional appeal is considered <w>allowable</w> to engage the audience.",
                            "target_lang_translations": {
                                "pl": "W formalnych debatach pewna ilość emocjonalnego przekazu jest uważana za <w>dopuszczalną</w>, aby zaangażować publiczność."
                            }
                        },
                        {
                            "text": "While his behavior was not ideal, it was deemed <w>allowable</w> under the stressful circumstances.",
                            "target_lang_translations": {
                                "pl": "Choć jego zachowanie nie było idealne, uznano je za <w>usprawiedliwione</w> w tych stresujących okolicznościach."
                            }
                        }
                    ],
                    "antonyms": [
                        "unacceptable"
                    ],
                    "target_lang_definitions": {
                        "pl": "Właściwy, satysfakcjonujący lub akceptowalny społecznie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dopuszczalny",
                                "target_lang_sense_clarification": "akceptowalny w danej sytuacji"
                            },
                            {
                                "target_lang_word": "przyjęty",
                                "target_lang_sense_clarification": "uznawany za stosowny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a8be435-07e3-37c3-9684-ddb111473c07",
                    "sense_definition": "Able to be legally or officially added, deducted, or permitted in financial or tax calculations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to keep all your receipts to prove these are <w>allowable</w> business expenses.",
                            "target_lang_translations": {
                                "pl": "Musisz zachować wszystkie paragony, aby udowodnić, że są to koszty uzyskania przychodu podlegające <w>odliczeniu</w>."
                            }
                        },
                        {
                            "text": "The accountant calculated the <w>allowable</w> tax deductions for the fiscal year.",
                            "target_lang_translations": {
                                "pl": "Księgowy obliczył <w>dopuszczalne</w> odliczenia podatkowe na ten rok obrotowy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "allowable expenses",
                        "allowable deductions"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mogący być prawnie lub oficjalnie dodanym, odliczonym lub uwzględnionym w obliczeniach finansowych lub podatkowych."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "podlegający odliczeniu",
                                "target_lang_sense_clarification": "w kontekście podatkowym"
                            },
                            {
                                "target_lang_word": "uznawany",
                                "target_lang_sense_clarification": "koszt, który można rozliczyć"
                            },
                            {
                                "target_lang_word": "dopuszczalny",
                                "target_lang_sense_clarification": "dozwolony do odliczenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "835bcad9-eb34-353c-a490-d2545a220f38",
                    "sense_definition": "Intellectually admissible, valid, or plausible.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "validity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor argued that the alternative interpretation of the text was an <w>allowable</w> hypothesis.",
                            "target_lang_translations": {
                                "pl": "Profesor argumentował, że alternatywna interpretacja tekstu była <w>dopuszczalną</w> hipotezą."
                            }
                        },
                        {
                            "text": "Without further evidence, both theories remain <w>allowable</w> explanations for the phenomenon.",
                            "target_lang_translations": {
                                "pl": "Bez dalszych dowodów obie teorie pozostają <w>prawdopodobnymi</w> wyjaśnieniami tego zjawiska."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Dopuszczalny pod względem intelektualnym, ważny lub prawdopodobny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dopuszczalny",
                                "target_lang_sense_clarification": "hipoteza lub interpretacja"
                            },
                            {
                                "target_lang_word": "uzasadniony",
                                "target_lang_sense_clarification": "mający podstawy naukowe lub logiczne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ac7e62e-d264-3698-b270-6f5dac42c016",
                    "sense_definition": "Praiseworthy or commendable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His dedication to helping the community was an <w>allowable</w> endeavor that inspired many.",
                            "target_lang_translations": {
                                "pl": "Jego oddanie pomocy społeczności było <w>chwalebnym</w> przedsięwzięciem, które zainspirowało wielu."
                            }
                        },
                        {
                            "text": "The young scholar's efforts, though incomplete, were highly <w>allowable</w>.",
                            "target_lang_translations": {
                                "pl": "Wysiłki młodego uczonego, choć niepełne, były wysoce <w>godne pochwały</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is archaic and rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Godny pochwały lub uznania (przestarzałe)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "chwalebny",
                                "target_lang_sense_clarification": "godny uznania"
                            },
                            {
                                "target_lang_word": "godny pochwały",
                                "target_lang_sense_clarification": "zasługujący na aprobatę"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95af4305-6b24-33b2-a111-16d41d71331b",
                    "sense_definition": "An amount, limit, or activity that is officially permitted.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "permitted_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The environmental agency set the daily <w>allowables</w> for industrial waste discharge.",
                            "target_lang_translations": {
                                "pl": "Agencja ochrony środowiska ustaliła dzienne <w>limity dopuszczalne</w> dla zrzutu odpadów przemysłowych."
                            }
                        },
                        {
                            "text": "Oil production was capped to keep output within the state-mandated <w>allowables</w>.",
                            "target_lang_translations": {
                                "pl": "Wydobycie ropy naftowej zostało ograniczone, aby utrzymać produkcję w granicach <w>limitów</w> nakazanych przez państwo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Oficjalnie dozwolona ilość, limit lub limit aktywności."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "limit dopuszczalny",
                                "target_lang_sense_clarification": "oficjalnie dozwolona ilość"
                            },
                            {
                                "target_lang_word": "norma",
                                "target_lang_sense_clarification": "dozwolona wielkość emisji lub wydobycia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}