                        "examples": [
                            {
                                "example_id": "8c02d146-18e4-40c2-9c6c-a4f77eb3e71b",
                                "sense_id": "05acd933-5647-30ab-aa64-451d8c7651b9",
                                "text": "De zeeslag bij Trafalgar was een keerpunt in de geschiedenis.",
                                "translation": "The naval battle of Trafalgar was a turning point in history.",
                                "english": "The naval battle of Trafalgar was a turning point in history."
                            },
                            {
                                "example_id": "19fb8223-05dd-4981-afe4-184d03cfb3e8",
                                "sense_id": "05acd933-5647-30ab-aa64-451d8c7651b9",
                                "text": "Beide vloten leden zware verliezen in de zeeslag.",
                                "translation": "Both fleets suffered heavy losses in the sea battle.",
                                "english": "Both fleets suffered heavy losses in the sea battle."
                            },
                            {
                                "example_id": "f2e6d6c9-e344-4291-9393-5d6b64aaa387",
                                "sense_id": "05acd933-5647-30ab-aa64-451d8c7651b9",
                                "text": "Het zeeslagje was meer een schermutseling dan een volledig gevecht.",
                                "translation": "The small sea battle was more of a skirmish than a full-fledged fight.",
                                "english": "The small sea battle was more of a skirmish than a full-fledged fight."
                            }
                        ]
