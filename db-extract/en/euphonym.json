                "senses": [
                    {
                        "sense_id": "27082a20-c90a-3b1f-926f-ad808cb3e340",
                        "entry_id": "203bc89a-8226-3b0d-8243-33e03a6f218d",
                        "glosses": [
                            "A pleasant-sounding name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb443def-1f6b-41c7-b3bb-dde928618b37",
                                "sense_id": "27082a20-c90a-3b1f-926f-ad808cb3e340",
                                "text": "But we thought these names were pretty and that they reflected good literary taste. The pets were called by their euphonyms only when visitors were to be properly impressed; consequently, they paid no attention to the meaningless titles."
                            },
                            {
                                "example_id": "8d8491b0-75d5-4f05-b5b2-93149fc0cac5",
                                "sense_id": "27082a20-c90a-3b1f-926f-ad808cb3e340",
                                "text": "Many female forenames are regarded as euphonyms. What is and is not euphonious is necessarily subjective, but it could be suggested that names containing labials (b, m), sibilants (s, sh) and liquids (l, r) are more likely to be euphonyms than those that do not."
                            },
                            {
                                "example_id": "1160371f-ef8c-405b-8f9c-c1e2cc690af1",
                                "sense_id": "27082a20-c90a-3b1f-926f-ad808cb3e340",
                                "text": "Euphonyms are names that sound good. “Edna Saint Vincent Millay” is an example."
                            }
                        ]
                    }
                ],
