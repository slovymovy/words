                                "target_senses": [
                                    {
                                        "sense_id": "42cd43b4-6a1b-3a86-b8a7-862b28997bce",
                                        "entry_id": "7f0f4e31-1a6c-311f-bf99-f9bbe1639e6f",
                                        "glosses": [
                                            "Action de banaliser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f8caa6a-ef3d-4bb2-9722-801472b9494c",
                                                "sense_id": "42cd43b4-6a1b-3a86-b8a7-862b28997bce",
                                                "text": "Cent fois, retrouvant au bout de quelques mois ou de quelques années une jeune femme que j’avais connue jeune fille, j’étais frappé par la banalisation de son caractère, par l’insignifiance de sa vie."
                                            },
                                            {
                                                "example_id": "c8daf86c-abd7-471f-9525-9845b8f2f2b3",
                                                "sense_id": "42cd43b4-6a1b-3a86-b8a7-862b28997bce",
                                                "text": "Pionnier de la banalisation médiatique du Front national, BFMTV vient de franchir un nouveau cap, en plein entre-deux-tours."
                                            },
                                            {
                                                "example_id": "8f8f9fa5-89c9-447b-aa8b-5c12f7295a98",
                                                "sense_id": "42cd43b4-6a1b-3a86-b8a7-862b28997bce",
                                                "text": "Pour comprendre les comportements inhumains, il est pertinent de mobiliser le concept de la « banalisation du mal », que la célèbre philosophe Hannah Arendt a théorisé après avoir assisté au procès du criminel nazi Adolf Eichmann."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63103a67-af16-317f-8428-9dc21c2ac20e",
                                        "entry_id": "7f0f4e31-1a6c-311f-bf99-f9bbe1639e6f",
                                        "glosses": [
                                            "Démarche commerciale qui consiste à faire du prix d’un produit le seul critère distinctif pour l’acheteur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fc25977-b20b-40cf-9e2d-288b3cd92b33",
                        "source_entry_id": "e25fb9b8-3855-3da6-a778-8175c8abe10c",
                        "source_sense_id": "0b8e9bd2-777e-306a-97c9-e7bd8a216c9f",
                        "source_sense_description": "act of trivializing",
                        "target_lang_word": "Untertreibung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Untertreibung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52929842-4edc-39a7-a7fd-beb83e1b0cfe",
                                        "entry_id": "ede17a98-9130-3502-a394-1a4917bce5c3",
                                        "glosses": [
                                            "eine Darstellung, durch die etwas kleiner oder unwichtiger erscheint als es in Wirklichkeit ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47a89896-b663-4a89-af3d-d91d3ec29e70",
                                                "sense_id": "52929842-4edc-39a7-a7fd-beb83e1b0cfe",
                                                "text": "Das ist doch eine Untertreibung – das kannst du doch sehr gut!"
                                            },
                                            {
                                                "example_id": "7884f87b-d91a-4074-8d88-e08e46f7765b",
                                                "sense_id": "52929842-4edc-39a7-a7fd-beb83e1b0cfe",
                                                "text": "Dieser Zeitungsartikel ist eine maßlose Untertreibung."
                                            },
                                            {
                                                "example_id": "4fd90b8d-d0dd-42d7-a7e2-8ddbacb55f54",
                                                "sense_id": "52929842-4edc-39a7-a7fd-beb83e1b0cfe",
                                                "text": "„Das war keine Prahlerei, sondern eher Untertreibung.“."
                                            },
                                            {
                                                "example_id": "3f049d6e-6117-43c2-97a5-88721c00acae",
                                                "sense_id": "52929842-4edc-39a7-a7fd-beb83e1b0cfe",
                                                "text": "„Schon die Alltagssprache bietet genug Beobachtungsmaterial für Untertreibungen.“"
                                            },
                                            {
                                                "example_id": "78fedf49-d27a-4a4e-8995-eb93ee0812a8",
                                                "sense_id": "52929842-4edc-39a7-a7fd-beb83e1b0cfe",
                                                "text": "„Kurz, wir neigen heute eher zu sachlicher Untertreibung, die sich wiederum vornehm-englisch »Understatement« nennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
