                "senses": [
                    {
                        "sense_id": "722fceaf-3885-3908-a4ad-6d0b97cdea3c",
                        "entry_id": "ddc5c29f-8a3f-3336-981d-6369dd88b997",
                        "glosses": [
                            "Personne qui dispense des soins aux malades."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0038b3b8-ab7f-4c9e-9850-6dcbf0880bed",
                                "sense_id": "722fceaf-3885-3908-a4ad-6d0b97cdea3c",
                                "text": "Encouragés à la performance et la rapidité — dans un contexte de réduction du personnel et des budgets —, les soignants finissent par tomber malades ou quitter ce milieu « devenu toxique »."
                            },
                            {
                                "example_id": "6196c96c-e5f9-430d-982e-a33dd69a22bd",
                                "sense_id": "722fceaf-3885-3908-a4ad-6d0b97cdea3c",
                                "text": "«Cette étude toujours en cours impliquant une large cohorte de soignants a montré qu'une infection par la Covid-19 offre une protection contre une réinfection pour la plupart des gens pendant au moins six mois», a déclaré dans un communiqué l'un des auteurs, le professeur David Eyre, de l'Université d'Oxford."
                            }
                        ]
                    }
                ],
