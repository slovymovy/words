                ],
                "senses": [
                    {
                        "sense_id": "f618cbf8-5100-3d7a-bce1-6f71c1e4f317",
                        "entry_id": "57a8592a-78aa-3c91-a717-a1a6cff651f7",
                        "glosses": [
                            "Person, die mit einem Preis ausgezeichnet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ca57b46-aa55-47c7-84f9-6377cf4910e3",
                                "sense_id": "f618cbf8-5100-3d7a-bce1-6f71c1e4f317",
                                "text": "Der mehrfache Preisträger signierte Autogrammkarten."
                            },
                            {
                                "example_id": "4b222200-2af8-4390-8c0e-4fe6720ccdb6",
                                "sense_id": "f618cbf8-5100-3d7a-bce1-6f71c1e4f317",
                                "text": "„Es gibt also für den Preisträger eine ganze Menge Möglichkeiten, etwas auf die Beine zu stellen.“"
                            },
                            {
                                "example_id": "8d3d04fe-ad91-45f3-a8ce-8e6b17179518",
                                "sense_id": "f618cbf8-5100-3d7a-bce1-6f71c1e4f317",
                                "text": "„Ich war an dem Tag, als man die Preise an die jungen Studenten der Malerei und Graphik verteilte, aufs Kapitol gegangen und erblickte dort den Maler Mengs, der zusammen mit Pompeo Bartoni und zwei oder drei anderen die Preisträger bestimmen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df764d18-383d-4552-875d-bd6b923dca03",
                        "source_entry_id": "57a8592a-78aa-3c91-a717-a1a6cff651f7",
                        "source_sense_id": "f618cbf8-5100-3d7a-bce1-6f71c1e4f317",
                        "source_sense_description": "Person, die mit einem Preis ausgezeichnet wurde",
                        "target_lang_word": "awardee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "awardee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28bb0e12-aba9-3c3f-9275-0e369fb95522",
                                        "entry_id": "0bcf6bb4-da1d-340e-9a29-98e1b98bf0bb",
                                        "glosses": [
                                            "The recipient of an award or special honor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1b6c594-9ae8-461e-9065-61bdb90b35dd",
                                                "sense_id": "28bb0e12-aba9-3c3f-9275-0e369fb95522",
                                                "text": "The other awardee that evening was Tom Frei, being honored for his advancement of the cure for leukemia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ad9bd5f-1c35-4362-b8a2-3e8d8453c40e",
                        "source_entry_id": "57a8592a-78aa-3c91-a717-a1a6cff651f7",
                        "source_sense_id": "f618cbf8-5100-3d7a-bce1-6f71c1e4f317",
                        "source_sense_description": "Person, die mit einem Preis ausgezeichnet wurde",
                        "target_lang_word": "honoree",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honoree",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d26a7b28-42c2-3ce0-b733-1b01d20bef81",
                                        "entry_id": "49225de6-0b8d-3dcd-a77f-685682627505",
                                        "glosses": [
                                            "One who receives an honor or award."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f816672-8e75-42b0-ad74-2bcc47dc337e",
                                                "sense_id": "d26a7b28-42c2-3ce0-b733-1b01d20bef81",
                                                "text": "It was perhaps the most public example of the “manterruption” – that is, a man interrupting a woman while she’s trying to speak (in this case, on stage, by herself, as an award honoree) and taking over the floor."
                                            },
                                            {
                                                "example_id": "6510db4f-a40d-497b-befd-c82300769e27",
                                                "sense_id": "d26a7b28-42c2-3ce0-b733-1b01d20bef81",
                                                "text": "The 18 honorees included some of the Democratic Party’s best-known leaders and boosters: Hillary Clinton, the philanthropist and major Democratic donor George Soros, and Robert F. Kennedy, who was given the recognition posthumously."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7babee03-c520-4be0-8e9d-fb3e20ce58f7",
                        "source_entry_id": "57a8592a-78aa-3c91-a717-a1a6cff651f7",
                        "source_sense_id": "f618cbf8-5100-3d7a-bce1-6f71c1e4f317",
                        "source_sense_description": "Person, die mit einem Preis ausgezeichnet wurde",
                        "target_lang_word": "lauréat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lauréat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f3403fc-e0f7-3e9f-bebe-1a5d20dcf5e2",
                                        "entry_id": "6681e28e-95e9-3998-b4a9-88fe81c5ca36",
                                        "glosses": [
                                            "Quelqu’un des poètes qui ont ont reçu solennellement une couronne de laurier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdae55df-7e13-4e5a-8cd3-d5c763ee41dc",
                                                "sense_id": "1f3403fc-e0f7-3e9f-bebe-1a5d20dcf5e2",
                                                "text": "Pétrarque est un poète lauréat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lauréat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "038103c4-d2fc-323b-9bd1-3537b630b150",
                                        "entry_id": "5b5bf5c8-511b-3892-aabb-83aace2eb5fd",
                                        "glosses": [
                                            "Celui ou celle qui a remporté le prix dans un concours scolaire ou académique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebaf918b-b15b-4c16-811d-b1f4215d76cc",
                                                "sense_id": "038103c4-d2fc-323b-9bd1-3537b630b150",
                                                "text": "Issu de la bourgeoisie intellectuelle parisienne, Jurgensen est un élève brillant : double lauréat du concours général en latin et en grec, admis à Henri-IV, il entre rue d'Ulm dès sa première tentative en 1937."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77f0728b-5a7f-3567-bb6c-8dcebfd5d9c6",
                                        "entry_id": "5b5bf5c8-511b-3892-aabb-83aace2eb5fd",
                                        "glosses": [
                                            "Celui qui s'est distingué lors de son cursus universitaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f16db803-8b77-42a7-9593-9113c9f47894",
                                                "sense_id": "77f0728b-5a7f-3567-bb6c-8dcebfd5d9c6",
                                                "text": "[…] ; les deux premiers élèves peuvent recevoir une mission à l'étranger à l'instar des principaux lauréats des Écoles des Beaux-Arts, des Mines, des Ponts-et-Chaussées, etc... Ce sont les grands prix de l'Institut agronomique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8595346e-8188-36ae-a267-55ee713f5e32",
                                        "entry_id": "5b5bf5c8-511b-3892-aabb-83aace2eb5fd",
                                        "glosses": [
                                            "Celui à qui on a attribué un prix, une mention ou un accessit dans un concours quelconque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "527ef299-90bd-49fb-b6ce-07f3af07acb7",
                                                "sense_id": "8595346e-8188-36ae-a267-55ee713f5e32",
                                                "text": "Marius André […] devait être couronné cette même année lauréat des Jeux Floraux septennaires du Félibrige et publier deux ans après son œuvre principale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
