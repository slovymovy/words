                                        "sense_id": "c5d517ce-dba8-39f4-8197-ed6c80f7de5d",
                                        "entry_id": "1e63ec09-1936-3c66-8fac-509a7fc3e94a",
                                        "glosses": [
                                            "Demande faite par celui qui remplit dans un tribunal les fonctions du ministère public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7c227c1-6651-4f6e-b1de-ba39ed5c8c64",
                                                "sense_id": "c5d517ce-dba8-39f4-8197-ed6c80f7de5d",
                                                "text": "Réquisitoire de mise en liberté, de non-lieu."
                                            },
                                            {
                                                "example_id": "f72b4b39-9655-404e-8f03-50e6c1ae7072",
                                                "sense_id": "c5d517ce-dba8-39f4-8197-ed6c80f7de5d",
                                                "text": "Réquisitoire écrit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74e4d5fa-f185-3c3e-ae2a-dadd42f05752",
                                        "entry_id": "1e63ec09-1936-3c66-8fac-509a7fc3e94a",
                                        "glosses": [
                                            "Discours par lequel le ministère public, dans un tribunal, énumère les charges de l'accusation et énumère les peines prévues par la loi."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e01709eb-03e0-3a22-bbc3-0befca2e5933",
                                        "entry_id": "1e63ec09-1936-3c66-8fac-509a7fc3e94a",
                                        "glosses": [
                                            "Discours par lequel le ministère public, dans un tribunal, énumère les charges de l'accusation et énumère les peines prévues par la loi.",
                                            "Contre un accusé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69c64671-e444-47bd-80fb-239140d4d640",
                                                "sense_id": "e01709eb-03e0-3a22-bbc3-0befca2e5933",
                                                "text": "Libéré des bracelets infamants, j'écoute peu le réquisitoire du ministère public, dont le Zorro commis d'office m'avait annoncé la sévérité. Le robin, qui n’a aucune considération pour l’assassin, m’achève au cours de son délire. Non content de déblatérer sur la couille molle que je suis […], il m'accuse de plus de l'intrusion d'une crapule dans mon foyer, ainsi que de son attrait pour une queutarde patentée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c9c64af-76dc-3aca-9bec-ce4888d70dd5",
                                        "entry_id": "1e63ec09-1936-3c66-8fac-509a7fc3e94a",
                                        "glosses": [
                                            "Discours par lequel le ministère public, dans un tribunal, énumère les charges de l'accusation et énumère les peines prévues par la loi.",
                                            "L'objet de l'accusation est une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "417ecc2b-529b-44b4-86cd-b9066faf3869",
                                                "sense_id": "8c9c64af-76dc-3aca-9bec-ce4888d70dd5",
                                                "text": "Le réquisitoire d'Ernest Pinard contre Madame Bovary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dc76016-1fcf-395e-b346-815e75488a1c",
                                        "entry_id": "1e63ec09-1936-3c66-8fac-509a7fc3e94a",
                                        "glosses": [
                                            "Discours, écrit qui contient une sorte d’acte d’accusation contre une personne, contre un parti, contre une doctrine."
                                        ],
