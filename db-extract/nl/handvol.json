                                "target_senses": [
                                    {
                                        "sense_id": "c7ef21c7-29b8-3963-90d3-f2c511bf59a4",
                                        "entry_id": "a9834278-1831-3e85-a046-aa9375678643",
                                        "glosses": [
                                            "The amount that can be held in a closed fist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32e67091-191d-3096-a541-ed2508580919",
                                        "entry_id": "a9834278-1831-3e85-a046-aa9375678643",
                                        "glosses": [
                                            "A small number of something."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "982dde0b-e01b-468d-befe-a5d1e86da8fc",
                                                "sense_id": "32e67091-191d-3096-a541-ed2508580919",
                                                "text": "At Pearl Harbor when the Japanese attacked, he survived to pilot Navy reconnaissance planes again and pick up a fistful of medals, from the Purple Heart to the Distinguished Flying Cross."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59079ab1-f1d1-3eed-ae58-ff7efdc1490c",
                                        "entry_id": "a9834278-1831-3e85-a046-aa9375678643",
                                        "glosses": [
                                            "A blow with the fist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
