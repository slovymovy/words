                                "target_senses": [
                                    {
                                        "sense_id": "20897dd8-adfb-3d70-b057-72b8396cb8e7",
                                        "entry_id": "ca0926ef-3834-390a-9290-81f82a935eb2",
                                        "glosses": [
                                            "Temps passé. Ne se dit plus guère aujourd’hui en français que du passé simple."
                                        ],
                                        "tags": [
                                            "conjugation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db3a9222-360c-444b-860f-d2f268b9a16b",
                                                "sense_id": "20897dd8-adfb-3d70-b057-72b8396cb8e7",
                                                "text": "Le prétérit désigne, dans les langues qui n’établissent pas dans leur flexion verbale de distinction (de nature aspectuelle) entre différentes expressions du passé, comme celle du grec ancien entre imparfait, aoriste et parfait, ou celle des langues romanes entre imparfait et passé simple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80f6d91f-bc78-455f-8ecf-c922304ca5a2",
                        "source_entry_id": "a2026e05-d63f-3c10-a770-159f2e95e756",
                        "source_sense_id": "3e383443-9902-3d39-a5a5-4914b7575421",
                        "source_sense_description": "preterite tense; simple past",
                        "target_lang_word": "Präteritum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Präteritum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50c264e1-5311-341b-bdd6-38f13816a61a",
                                        "entry_id": "33d577de-a0c9-34ef-9b0a-a8555d1667a9",
                                        "glosses": [
                                            "Zeitform eines Verbs, die ausdrückt, dass ein Geschehen vom Standpunkt des Sprechers aus gesehen vergangen, abgeschlossen und von der Gegenwart losgelöst ist und in diesem Sinn der Vergangenheit angehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272769fc-54bd-44b1-bb43-9af44a4e1db2",
                                                "sense_id": "50c264e1-5311-341b-bdd6-38f13816a61a",
                                                "text": "\"Ich spielte\" steht im Präteritum."
                                            },
                                            {
                                                "example_id": "4b38af0b-8281-4503-b0b8-fe6fda2e1a42",
                                                "sense_id": "50c264e1-5311-341b-bdd6-38f13816a61a",
                                                "text": "„Die Fragen nach Bestand und Veränderungen im Feld der Vergangenheitstempora konzentrieren sich mehr und mehr auf die Verwendungsweisen von Präteritum und Perfekt, nicht so sehr wegen der geringen Gebrauchsfrequenzen des Plusquamperfekts, sondern wegen der häufigen Konkurrenz zwischen Formen des Präteritums und des Perfekts.“"
                                            },
                                            {
                                                "example_id": "bfb5ee47-3bbf-4611-822b-349d9040c923",
                                                "sense_id": "50c264e1-5311-341b-bdd6-38f13816a61a",
                                                "text": "„Regelmäßige Verben ändern im Präteritum und im Partizip II ihren Stammvokal nicht, unregelmäßige Verben ändern ihn in gesetzmäßiger Weise in den drei Stammformen (Infinitiv - Präteritum - Partizip II) (Ablaut):…“"
                                            },
                                            {
                                                "example_id": "ff83d60e-30b8-43ca-8f40-c534e2d93f12",
                                                "sense_id": "50c264e1-5311-341b-bdd6-38f13816a61a",
                                                "text": "„In meinem Tagebuch war ich, wenn mir meine Geschichte zu intim wurde, in Präteritum und Konjunktiv geflüchtet, hatte direkte und indirekte Rede gekehrt, Gegenwart in Vergangenheit entrückt, hatte Distanz geschaffen, das Geschehen entschärft.“"
                                            },
                                            {
                                                "example_id": "2bf86ed4-9b26-4c4b-8b72-8dba91e5c178",
                                                "sense_id": "50c264e1-5311-341b-bdd6-38f13816a61a",
                                                "text": "„Im Laufe der Zeit hat das Präteritum sogar an Bedeutung verloren.“"
                                            },
                                            {
                                                "example_id": "13d2f448-1646-4f03-9b02-cb1d2fed6245",
                                                "sense_id": "50c264e1-5311-341b-bdd6-38f13816a61a",
                                                "text": "„In mündlichen Texten hat man oft einen Wechsel zwischen Präteritum und Perfekt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c63aa40e-18ef-3e43-b965-6b07926df7f4",
                                        "entry_id": "33d577de-a0c9-34ef-9b0a-a8555d1667a9",
                                        "glosses": [
                                            "Verbform im Präteritum [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f741ee27-7fec-46c2-b2cf-60f3e88cef8d",
                                                "sense_id": "c63aa40e-18ef-3e43-b965-6b07926df7f4",
                                                "text": "In der Wendung \"ich spielte\" ist \"spielte\" ein Präteritum."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
