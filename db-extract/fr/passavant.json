                                "target_senses": [
                                    {
                                        "sense_id": "45164ffa-cdf3-33b3-8a67-d3511d8e3b4f",
                                        "entry_id": "b796e666-2fcb-3a0a-aca3-3679e819a130",
                                        "glosses": [
                                            "A passageway through which to enter or leave.",
                                            "An aisle between rows of seating (especially in a train, aircraft or auditorium)."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30f0bb56-c5e5-4807-b48f-45665515ffb5",
                                                "sense_id": "45164ffa-cdf3-33b3-8a67-d3511d8e3b4f",
                                                "text": "The new fleet of trains comes with widened gangways and improved seating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfa9c585-0cb7-3d52-a39e-9b4779a07cd0",
                                        "entry_id": "b796e666-2fcb-3a0a-aca3-3679e819a130",
                                        "glosses": [
                                            "A passageway through which to enter or leave.",
                                            "The dividing aisle between the rows of seats on either side of the House of Commons. Used chiefly with reference to terms such as below the gangway."
                                        ],
                                        "tags": [
                                            "UK",
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86fe9ea0-af9f-3cf0-95e9-adb9b7c20223",
                                        "entry_id": "b796e666-2fcb-3a0a-aca3-3679e819a130",
                                        "glosses": [
                                            "A passageway through which to enter or leave.",
                                            "The narrow space between two buildings or houses, used to access the backyard/alleyway from the front."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64ba026b-c211-4615-af17-3dd7583e15f2",
                                                "sense_id": "86fe9ea0-af9f-3cf0-95e9-adb9b7c20223",
                                                "text": "Morris then allegedly tried to flee into a gangway between the bar and another building, closing a gate on an officer as he did"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be91aa28-2eb9-3005-9a6a-da8515431669",
                                        "entry_id": "b796e666-2fcb-3a0a-aca3-3679e819a130",
                                        "glosses": [
                                            "An articulating bridge or ramp, such as from land to a dock or a ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec117ee4-e936-4478-b969-f95d6ca61829",
                                                "sense_id": "be91aa28-2eb9-3005-9a6a-da8515431669",
                                                "text": "We came over on the usual mid-morning service from Victoria and this time, as we came down the gangway of the Invicta, the Shedmaster at Calais, M. Leclerc, and Henri Dutertre were waiting for us."
                                            },
                                            {
                                                "example_id": "0779c663-d8fc-442c-aa8a-6f79911dbc52",
                                                "sense_id": "be91aa28-2eb9-3005-9a6a-da8515431669",
                                                "text": "Like a lot of my fellow passengers — indie-rock fans who had signed up for a three-day voyage full of bands and beverages — I’d never been on a cruise before. So I don’t know whether most of them begin with a staff member high-fiving each and every person who comes off the gangway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "584642f1-6942-3660-ad48-4c13200031b1",
                                        "entry_id": "b796e666-2fcb-3a0a-aca3-3679e819a130",
                                        "glosses": [
                                            "A passage along either side of a ship's upper deck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7efcdbf-0a57-358b-95a4-792698b843c6",
                                        "entry_id": "b796e666-2fcb-3a0a-aca3-3679e819a130",
                                        "glosses": [
                                            "A passage through the side of a ship or an opening in the railing through which the ship may be boarded; (also in later use) a jet bridge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55919cb9-4e22-3025-9b65-62a013f51ba7",
                                        "entry_id": "b796e666-2fcb-3a0a-aca3-3679e819a130",
                                        "glosses": [
                                            "A temporary passageway, such as one made of planks."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4392e90c-8af0-3d0b-bba0-bf283a488f2d",
                                        "entry_id": "b796e666-2fcb-3a0a-aca3-3679e819a130",
                                        "glosses": [
                                            "A clear path through a crowd or a passageway with people."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6335254-36ef-3450-b7bb-37373e97dad1",
                                        "entry_id": "b796e666-2fcb-3a0a-aca3-3679e819a130",
                                        "glosses": [
                                            "An earthen and plank ramp leading from the stable yard into the upper storey or mow of a dairy barn."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gangway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8935bcb-5fa7-3602-9331-fbe032c43e6c",
                                        "entry_id": "965a202a-cf8d-3db2-866e-d1ace3a9f712",
                                        "glosses": [
                                            "To serve as, furnish with, or conduct oneself as though proceeding on a gangway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd14eca-6836-486f-b06a-13d23cbb4dec",
                                                "sense_id": "a8935bcb-5fa7-3602-9331-fbe032c43e6c",
                                                "text": "He gangwayed his way through the crowd, and just as the clock struck midnight, he was standing in front of NBC's camera on national TV as the governor-elect of Minnesota and the first Reform Party candidate ever to be elected to high office."
                                            },
                                            {
                                                "example_id": "124b2517-7e37-4307-8df6-e7aa3cec5264",
                                                "sense_id": "a8935bcb-5fa7-3602-9331-fbe032c43e6c",
                                                "text": "They're conducting phone conversations without speaking into the wrong end of their mobiles, or gangwaying to the Gents without tripping over, or turning the pages of a newspaper without blacking adjacent eyes."
                                            },
                                            {
                                                "example_id": "3befb184-cbd8-492a-9285-a8c229921192",
                                                "sense_id": "a8935bcb-5fa7-3602-9331-fbe032c43e6c",
                                                "text": "Here also of exceptional value were the half-dozen dueling codes published after 1880, gangwaying a detailed analysis in chapter II of the manner in which duels unfolded, and dozens of French sources which formed the core of a chapter on the French duel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gangway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57ff3888-21aa-3001-9d4b-721b473c1ca5",
                                        "entry_id": "a2d4004c-545f-3387-9b14-3c47329e7d56",
                                        "glosses": [
                                            "Make way! Clear a path!"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7b42437-9a9d-4ffb-a938-96a7bbbf3f99",
                                                "sense_id": "57ff3888-21aa-3001-9d4b-721b473c1ca5",
                                                "text": "And he pushed his way through the crowd crying, \"Gangway, gangway!\" and dragging Jane and Michael after him."
                                            },
                                            {
                                                "example_id": "492bfaaa-d80b-4e92-b17c-ad9913b951e2",
                                                "sense_id": "57ff3888-21aa-3001-9d4b-721b473c1ca5",
                                                "text": "Lemme at 'im! Lemme at 'im! I'll get 'im, Babbitt! Gangway, I'll moidalize him!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
