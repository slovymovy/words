                ],
                "senses": [
                    {
                        "sense_id": "a4342ba1-16e6-3f06-bc8a-993e422e8c65",
                        "entry_id": "16ba4db1-92ae-3ee2-a45f-124fb99e0561",
                        "glosses": [
                            "принадлежащий Иванову"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14acbfdb-a074-4f3d-bc5e-cf5b153e06bc",
                                "sense_id": "a4342ba1-16e6-3f06-bc8a-993e422e8c65",
                                "text": "А вот он, — сутуленький, маленький, — в том же свисающем с плеча пледике (ему холодно), выбравши жертвой великолепноглавого Вячеслава Иванова, vтаскается за ивановской фалдой."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8ce5fef-2f92-31df-9689-cac007cc7cca",
                        "entry_id": "16ba4db1-92ae-3ee2-a45f-124fb99e0561",
                        "glosses": [
                            "происходящий, производящийся в городе Иваново"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b1fd95d-4614-4ef8-bfbb-f895389e2016",
                                "sense_id": "c8ce5fef-2f92-31df-9689-cac007cc7cca",
                                "text": "Искал в Гостином дворе ивановского полотна для рубах и не нашёл."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4c0ea0a-831d-365f-ab3c-2d8caacf76d0",
                        "entry_id": "16ba4db1-92ae-3ee2-a45f-124fb99e0561",
                        "glosses": [
                            "свойственный жителям Иваново"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d867ed1-3366-4aff-9b31-1216f079a975",
                                "sense_id": "e4c0ea0a-831d-365f-ab3c-2d8caacf76d0",
                                "text": "Как тут устоять против его ивановского радушного оканья!"
                            }
                        ]
                    }
                ],
