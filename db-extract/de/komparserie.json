                        "examples": [
                            {
                                "example_id": "a7a453c2-a19d-4c6e-b070-53e6ef10c486",
                                "sense_id": "9378fb77-6c29-3f47-9c80-e3840396f377",
                                "text": "„So kam es, dass Paul Verhoeven und sein Freund Willi Werkmeister bei der Komparserie des Schauspielhauses in München, den heutigen Kammerspielen, \"sagen wir, ,gehobene Aufgaben bekamen\".“"
                            },
                            {
                                "example_id": "5a78da4f-526e-425f-b7d3-c1eaea09863e",
                                "sense_id": "9378fb77-6c29-3f47-9c80-e3840396f377",
                                "text": "„Robert, der sich mittlerweile seine Jacke wieder übergestreift hatte, erkannte bald in der Komparserie eine geschlossene Reisegesellschaft, die soeben hier eingetroffen war und vor der Registrierung und dem Weitermarsch in die Quartiere einen kurzen Aufenthalt genoß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
