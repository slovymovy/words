                        "examples": [
                            {
                                "example_id": "b70bc3e6-73e7-43ba-a105-cb89b33bf24c",
                                "sense_id": "79a25a93-788b-3231-b5e6-0b307df43f70",
                                "text": "… auf der anderen Seite müssen wir uns besonders auch jene Fälle überlegen, in denen der Betriebsprüfer sozusagen bereits auf der Dacke steht mit dem Vorsatz, eine Selbstanzeige herauszuholen, ob wir das auch wirklich wollen."
                            },
                            {
                                "example_id": "f00c1ebd-35cc-475b-8bc2-2b44c1884737",
                                "sense_id": "79a25a93-788b-3231-b5e6-0b307df43f70",
                                "text": "Nach zwei Stunden ist die Dacke fertig."
                            }
                        ],
