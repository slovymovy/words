            "senses": [
                {
                    "sense_id": "e3ce2d17-4b8c-330d-9f43-5f6c324b2732",
                    "sense_definition": "Residences or buildings where people live, considered collectively as a group.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government promised to build more affordable <w>housing</w> for young families.",
                            "target_lang_translations": {
                                "ru": "Правительство пообещало построить больше доступного <w>жилья</w> для молодых семей.",
                                "tr": "Hükümet, genç aileler için daha uygun fiyatlı <w>konut</w> inşa etme sözü verdi."
                            }
                        },
                        {
                            "text": "She lives in low-income <w>housing</w> near the city center.",
                            "target_lang_translations": {
                                "ru": "Она живет в социальном <w>жилье</w> недалеко от центра города.",
                                "tr": "Şehir merkezine yakın düşük gelir grubuna yönelik <w>sosyal konutlarda</w> yaşıyor."
                            }
