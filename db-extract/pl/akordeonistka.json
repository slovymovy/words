                    {
                        "translation_id": "9efd7b5c-7fa3-4936-8749-4bd8f20a914c",
                        "source_entry_id": "f433ccae-fec5-3c35-8e41-f57f0079f589",
                        "source_sense_id": "3f5b0d4e-eaba-3f5b-b13a-5174e7f11bca",
                        "target_lang_word": "Akkordeonistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akkordeonistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39d36bec-cd34-3e84-8b34-84566bf0aea5",
                                        "entry_id": "c78f18d0-daf1-34a9-855d-1c74a32c2ee3",
                                        "glosses": [
                                            "weibliche Person, die (professionell) Akkordeon spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a6b4246-2248-416b-9a1f-730ec8d05be8",
                                                "sense_id": "39d36bec-cd34-3e84-8b34-84566bf0aea5",
                                                "text": "„Unter dem Motto Marie, Marie, Marie steht der Eröffnungsabend am Freitag ganz im Zeichen der umtriebigen Akkordeonistin Marie-Theres Stickler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fce8b0e1-5b2a-436d-99d5-6e832d04bd7a",
                        "source_entry_id": "f433ccae-fec5-3c35-8e41-f57f0079f589",
                        "source_sense_id": "3f5b0d4e-eaba-3f5b-b13a-5174e7f11bca",
                        "target_lang_word": "аккордеонистка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аккордеонистка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "579ad126-1835-39a4-9523-8df0fa7f9635",
                                        "entry_id": "a8b793a3-c8d2-3c00-9245-5adf61525439",
                                        "glosses": [
                                            "женск. к аккордеонист; женщина-аккордеонист"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ade3180-1449-4f8c-bbbe-82f54abd30d0",
                                                "sense_id": "579ad126-1835-39a4-9523-8df0fa7f9635",
                                                "text": "Решилась и дала ей спеть соловьево-седовских «Соловьев», и теперь, как только эта Аня запевает, я улыбаюсь, но слезы сами катятся, не знаю уж, как это будет в спектакле, ― зал будет рыдать; самое трудное с аккордеонисткой, она совсем плоха, но другого, из мужского лагеря, говорят, очень хорошего, начальник не может дать, а елку и пеньки приказал вохровцам самим притащить из леса и принести новые или трогательно выстиранные ими же гимнастерки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
