        "fr-extract.jsonl": [
            {
                "entry_id": "4ee08a2b-682e-3db4-a200-d8469fdc9c61",
                "word": "zweieinhalb",
                "pos": "adj",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e37b9467-98c8-3dfe-92aa-2deddc06722e",
                        "entry_id": "4ee08a2b-682e-3db4-a200-d8469fdc9c61",
                        "glosses": [
                            "Deux et demi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc140407-34b5-439f-bc1a-8cf8ebbb7570",
                                "sense_id": "e37b9467-98c8-3dfe-92aa-2deddc06722e",
                                "text": "Der Unterricht dauert zweieinhalb Stunden.",
                                "translation": "Le cours dure deux heures et demie."
                            },
                            {
                                "example_id": "a422a53c-d560-44d5-9d4f-eebfe457d33b",
                                "sense_id": "e37b9467-98c8-3dfe-92aa-2deddc06722e",
                                "text": "Nach ein paar Tagen Probearbeit hat mir diese Mischung so gut gefallen, dass ich direkt mit der Ausbildung angefangen habe. Die dauert in der Regel drei Jahre. Mit Abitur konnte ich allerdings auf zweieinhalb Jahre verkürzen.",
                                "translation": "Après quelques jours d'essai, ce mélange m'a tellement plu que j'ai directement commencé la formation. Celle-ci dure en général trois ans. Avec le baccalauréat, j'ai toutefois pu réduire la durée à deux ans et demi."
                            },
                            {
                                "example_id": "a71c1475-d5ae-4182-9dbf-314fd7030d63",
                                "sense_id": "e37b9467-98c8-3dfe-92aa-2deddc06722e",
                                "text": "Woma Pythons (Aspidites ramsayi) kommen in Australien vor. Die Fleischfresser können bis zu zweieinhalb Meter lang werden. Sie ernähren sich von Mäusen, Ratten und anderen Nagetieren.",
                                "translation": "Les python de Ramsay (Aspidites ramsayi) vivent en Australie. Ces carnivores peuvent mesurer jusqu'à deux mètres et demi de long. Ils se nourrissent de souris, de rats et d'autres rongeurs."
                            }
                        ]
                    }
                ],
