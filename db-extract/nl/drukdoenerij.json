                        "glosses": [
                            "opgewonden handelingen die passen bij iemand die zichzelf heel erg belangrijk vindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b7f7a03-b847-49c7-a589-6fb4f6520f17",
                                "sense_id": "cc0e0bd8-4a0c-3053-9813-711f68431792",
                                "text": "De voornaamste voldoening en behoefte van deze mensen is om als ze ergens vrolijkheid aantreffen, die tegemoet te treden met hun naargeestige drukdoenerij."
                            },
                            {
                                "example_id": "fb48194c-4efe-4851-9394-537b720d7095",
                                "sense_id": "cc0e0bd8-4a0c-3053-9813-711f68431792",
                                "text": "Mondiale temperatuurmetingen uit de afgelopen twintig jaar en harde feiten uit het geologische archief geven een totaal ander beeld: niet de mens, maar alles in ons zonnestelsel regelt het klimaat op aarde, al zolang de aarde bestaat. De mens met zijn drukdoenerij heeft daar weinig invloed op."
                            }
                        ]
                    }
