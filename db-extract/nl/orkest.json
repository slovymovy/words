                "senses": [
                    {
                        "sense_id": "08e5b8ba-85af-3911-9857-b653625dc7aa",
                        "entry_id": "f09c57ca-87db-37cb-9945-26350de38209",
                        "glosses": [
                            "een groep musici"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a4c5290-b99f-4150-8d4d-74eefe851159",
                                "sense_id": "08e5b8ba-85af-3911-9857-b653625dc7aa",
                                "text": "Het orkest was in staat heel zacht te spelen, maar ook heel erg sterk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22b0cb6d-7aae-4774-b919-df87d3037999",
                        "source_entry_id": "f09c57ca-87db-37cb-9945-26350de38209",
                        "source_sense_id": "08e5b8ba-85af-3911-9857-b653625dc7aa",
                        "source_sense_description": "een groep musici",
                        "target_lang_word": "Orchester",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orchester",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3eb571da-3379-3013-9125-c685240db5c4",
                                        "entry_id": "92b20408-5050-3918-9906-e00bcc38addb",
                                        "glosses": [
                                            "größeres Ensemble aus Instrumentalisten, das unter der Leitung eines Dirigenten spielt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ff0aa2e-ea52-402e-84d3-619432cb5f13",
                                                "sense_id": "3eb571da-3379-3013-9125-c685240db5c4",
                                                "text": "Pablo ist der Dirigent eines Orchesters."
                                            },
                                            {
                                                "example_id": "a6b9f654-d1be-4375-945d-e4f75dbbcd1d",
                                                "sense_id": "3eb571da-3379-3013-9125-c685240db5c4",
                                                "text": "Jedes Orchester ist ein Zauberkasten der Klangfarben."
                                            },
                                            {
                                                "example_id": "9c622ea6-685b-422b-90c4-f1ab1e91c572",
                                                "sense_id": "3eb571da-3379-3013-9125-c685240db5c4",
                                                "text": "„Mit einem Tusch und folgenden Walzerklängen gab das Orchester die Tanzfläche frei.“"
                                            },
                                            {
                                                "example_id": "e3390edd-25c0-45ef-80f9-f849eddf30fb",
                                                "sense_id": "3eb571da-3379-3013-9125-c685240db5c4",
                                                "text": "„Sie gab mir vierundzwanzig Zechinen und ließ von ihrer Dienerschaft im Saal und in meinen Zimmern Kronleuchter aufhängen, so daß ich nur für das Orchester und das Souper zu sorgen hatte.“"
                                            },
                                            {
                                                "example_id": "99bd24e9-715c-49e2-ad6d-133bb4febeda",
                                                "sense_id": "3eb571da-3379-3013-9125-c685240db5c4",
                                                "text": "„In einem Pavillon spielte ein kleines Orchester ein Menuett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b9464e5-b4d0-3088-93da-9e5726685bd1",
                                        "entry_id": "92b20408-5050-3918-9906-e00bcc38addb",
                                        "glosses": [
                                            "Orchestergraben"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed639b46-00c9-4f58-a124-72fc96f14197",
                        "source_entry_id": "f09c57ca-87db-37cb-9945-26350de38209",
                        "source_sense_id": "08e5b8ba-85af-3911-9857-b653625dc7aa",
                        "source_sense_description": "een groep musici",
                        "target_lang_word": "orchestra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orchestra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1a63443-7e73-34b9-ada0-1f87825d7459",
                                        "entry_id": "68b17749-6122-3139-a32b-9695df96aca3",
                                        "glosses": [
                                            "A large group of musicians who play together on various instruments, usually including some from strings, woodwind, brass and/or percussion; the instruments played by such a group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca1032d0-9bff-430f-b952-8d114ab019d8",
                                                "sense_id": "d1a63443-7e73-34b9-ada0-1f87825d7459",
                                                "text": "The orchestra plays music for the dancers to dance to in the 19th century-styled dance hall."
                                            },
                                            {
                                                "example_id": "f4c7ca65-beb0-4760-a32a-510092abd0c8",
                                                "sense_id": "d1a63443-7e73-34b9-ada0-1f87825d7459",
                                                "text": "It requires quite an orchestra to get a train to start; the guard blows his horn, the stationmaster rings a large bell, and the engine whistles."
                                            },
                                            {
                                                "example_id": "4051374e-2a0f-4f12-95e9-c8582908eb70",
                                                "sense_id": "d1a63443-7e73-34b9-ada0-1f87825d7459",
                                                "text": "Musicians play their instruments. I play the orchestra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cea793eb-df4b-3de2-b395-69392c3fa594",
                                        "entry_id": "68b17749-6122-3139-a32b-9695df96aca3",
                                        "glosses": [
                                            "A semicircular space in front of the stage used by the chorus in Ancient Greek and Hellenistic theatres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa6e6ee2-786c-3605-8103-12bc9aff463a",
                                        "entry_id": "68b17749-6122-3139-a32b-9695df96aca3",
                                        "glosses": [
                                            "The area in a theatre or concert hall where the musicians sit, immediately in front of and below the stage, sometimes (also) used by other performers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "847e1455-1f0d-4be4-b2d9-ac42b36513ae",
                        "source_entry_id": "f09c57ca-87db-37cb-9945-26350de38209",
                        "source_sense_id": "08e5b8ba-85af-3911-9857-b653625dc7aa",
                        "source_sense_description": "een groep musici",
                        "target_lang_word": "orchestre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orchestre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0473703-3e31-3971-9d52-0f3aa5acddc8",
                                        "entry_id": "2e55271c-0e67-3178-bbaa-e2c95e1609e1",
                                        "glosses": [
                                            "Partie d’une salle de spectacle contenant les places les plus basses et située au plus près de la scène, entre la fosse d’orchestre et le parterre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b91732b7-708b-4260-8bc7-eea6a0a8a1af",
                                                "sense_id": "e0473703-3e31-3971-9d52-0f3aa5acddc8",
                                                "text": "Et, dans la salle, si l’élément populaire domine au parterre et aux troisièmes galeries, l’élégance y est presque toujours représentée aux premières loges et aux fauteuils d’orchestre, surtout quand le spectacle en vaut la peine."
                                            },
                                            {
                                                "example_id": "1becb9c3-113d-4765-998e-58c99d1042a8",
                                                "sense_id": "e0473703-3e31-3971-9d52-0f3aa5acddc8",
                                                "text": "Il regrettait de n’avoir pu avoir de loge. Elles étaient toutes prises. D’ailleurs il les avait souvent expérimentées, on était mieux à l'orchestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f5105c7-d206-3df4-b145-0cc8075a998e",
                                        "entry_id": "2e55271c-0e67-3178-bbaa-e2c95e1609e1",
                                        "glosses": [
                                            "Ensemble des musiciens qui participent à une œuvre musicale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1a4534c-2b3e-46d1-947f-7a344a738d94",
                                                "sense_id": "4f5105c7-d206-3df4-b145-0cc8075a998e",
                                                "text": "Le fracas de l’orchestre leur arrivait, assourdissant. Par instants, les violons dominaient le vacarme qu’ils semblaient apaiser, caresser, contenir, mais le saxo, le piston, la clarinette et surtout la trompette […] se mettaient ensemble à mugir et à pétarader de telle sorte que personne ne parlait plus."
                                            },
                                            {
                                                "example_id": "7e15e36b-c624-4189-9a81-3a63c97e285d",
                                                "sense_id": "4f5105c7-d206-3df4-b145-0cc8075a998e",
                                                "text": "Aux abords de Bab Segma, toute la population du mellah nous accueillit avec des transports d’allégresse, et plusieurs orchestres israélites nous gratifièrent de l’air de « la Mère Michel », qui passait alors pour notre hymne national."
                                            },
                                            {
                                                "example_id": "fa37ee41-249a-4c0d-97ce-f7cc67eef30b",
                                                "sense_id": "4f5105c7-d206-3df4-b145-0cc8075a998e",
                                                "text": "Il habitait un terrier dans les bois communaux de La Motte, commune de La Hardoye, jouait de la flûte et sonnait du cor. On disait aussi qu’au sabbat il dirigeait l’orchestre infernal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f4d2763-eb7b-3d4d-8385-c2061d7efbff",
                                        "entry_id": "2e55271c-0e67-3178-bbaa-e2c95e1609e1",
                                        "glosses": [
                                            "Technique particulière à chaque compositeur, lorsqu’il écrit pour l’orchestre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ede9090b-a3fc-4f85-8065-16953c538b3e",
                                                "sense_id": "1f4d2763-eb7b-3d4d-8385-c2061d7efbff",
                                                "text": "L’orchestre de tel compositeur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "orchestre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0468b601-e8d0-37d7-9067-5b64d40e6069",
