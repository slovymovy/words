                "senses": [
                    {
                        "sense_id": "03649646-6f2d-3988-85de-a71cf5b5008f",
                        "entry_id": "cb9c1c61-d9ce-3a15-970d-5fbb75043e38",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f98b3522-4804-431f-a315-b3e2725d910c",
                                "sense_id": "03649646-6f2d-3988-85de-a71cf5b5008f",
                                "text": "Frau Wesserle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5f0a245c-edd8-44e0-81e7-6732f082e3ba",
                                "sense_id": "03649646-6f2d-3988-85de-a71cf5b5008f",
                                "text": "Herr Wesserle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4238acb6-e3f1-4c39-904c-66c29c9376c5",
                                "sense_id": "03649646-6f2d-3988-85de-a71cf5b5008f",
                                "text": "Die Wesserles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "9ede8b3b-291b-47b5-8d8c-7e3c52bb2353",
                                "sense_id": "03649646-6f2d-3988-85de-a71cf5b5008f",
                                "text": "Der Wesserle trägt nie die Pullover, die die Wesserle ihm strickt."
                            },
                            {
                                "example_id": "9043d640-300f-490e-a6ea-53f1aca8fb7e",
                                "sense_id": "03649646-6f2d-3988-85de-a71cf5b5008f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wesserle kommt, geht der Herr Wesserle.“"
                            },
                            {
                                "example_id": "e4bd26d6-06a7-463a-aa10-e8286a6f5f7b",
                                "sense_id": "03649646-6f2d-3988-85de-a71cf5b5008f",
                                "text": "Wesserle kommt und geht."
                            },
                            {
                                "example_id": "5ff6c91b-e6ba-4cb1-b268-7a5e2ee1ae93",
                                "sense_id": "03649646-6f2d-3988-85de-a71cf5b5008f",
                                "text": "Wesserles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
