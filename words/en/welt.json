{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "119a4f9f-1b03-344f-86c5-104c60f42c86",
                    "sense_definition": "A raised ridge or swollen lump on the skin, typically caused by a lash, blow, or allergic reaction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "skin_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The whip left a long red <w>welt</w> across the soldier's back.",
                            "target_lang_translations": {
                                "ru": "Кнут оставил длинный красный <w>рубец</w> на спине солдата."
                            }
                        },
                        {
                            "text": "A nasty <w>welt</w> formed on her arm after she was stung by the wasp.",
                            "target_lang_translations": {
                                "ru": "После укуса осы у неё на руке вздулся неприятный <w>волдырь</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wheal",
                        "weal"
                    ],
                    "common_phrases": [
                        "red welt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Припухлость, вздутая полоса или рубец на коже, обычно от удара, хлыста или аллергии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рубец",
                                "target_lang_sense_clarification": "след от удара или хлыста"
                            },
                            {
                                "target_lang_word": "волдырь",
                                "target_lang_sense_clarification": "припухлость от укуса, ожога или аллергии"
                            },
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "след от плети или удара"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44b64c54-b037-3a8c-acdb-b4d25e81e34f",
                    "sense_definition": "A narrow strip of leather or other material stitched around the edge of a shoe between the upper and the sole.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "strip_reinforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cobbler carefully stitched the thick leather <w>welt</w> to the sole of the boot.",
                            "target_lang_translations": {
                                "ru": "Сапожник аккуратно пришил толстый кожаный <w>рант</w> к подошве ботинка."
                            }
                        },
                        {
                            "text": "High quality shoes often feature a durable Goodyear <w>welt</w>.",
                            "target_lang_translations": {
                                "ru": "Высококачественная обувь часто изготавливается с прочным <w>рантом</w> Гудьира."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Goodyear welt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкая полоска кожи или другого материала, вшиваемая по краю обуви между верхом и подошвой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рант",
                                "target_lang_sense_clarification": "в обувном производстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9c62ba1-6ca6-3b26-82f1-19f27deb04d5",
                    "sense_definition": "A strip of fabric or covered cord inserted into a seam to strengthen or decorate a garment edge.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "strip_reinforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She added a decorative satin <w>welt</w> around the collar of the coat.",
                            "target_lang_translations": {
                                "ru": "Она добавила декоративный атласный <w>кант</w> по воротнику пальто."
                            }
                        },
                        {
                            "text": "The cushion seams were finished neatly with a matching fabric <w>welt</w>.",
                            "target_lang_translations": {
                                "ru": "Швы подушки были аккуратно отделаны подходящим по цвету тканевым <w>кантом</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "welt pocket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полоска ткани или обтянутый шнур, вшиваемый в шов для укрепления или отделки края изделия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кант",
                                "target_lang_sense_clarification": "декоративный или укрепляющий шнур/полоска в шве"
                            },
                            {
                                "target_lang_word": "бейка",
                                "target_lang_sense_clarification": "полоска ткани для отделки края"
                            },
                            {
                                "target_lang_word": "листочка",
                                "target_lang_sense_clarification": "в карманах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8ba2822-d873-31c9-824f-319bb41af659",
                    "sense_definition": "A strip or border placed along the edge of an object for reinforcement or decoration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strip_reinforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms displayed a narrow <w>welt</w> along its outer boundary.",
                            "target_lang_translations": {
                                "ru": "На гербе была изображена узкая <w>кайма</w> по внешнему краю."
                            }
                        },
                        {
                            "text": "An old stone <w>welt</w> marked the boundary edge of the terrace.",
                            "target_lang_translations": {
                                "ru": "Старый каменный <w>бордюр</w> обозначал границу террасы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полоса или кайма по краю предмета для его укрепления или декоративного оформления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кайма",
                                "target_lang_sense_clarification": "полоса по краю"
                            },
                            {
                                "target_lang_word": "окаймление",
                                "target_lang_sense_clarification": "декоративный или укрепляющий край"
                            },
                            {
                                "target_lang_word": "бордюр",
                                "target_lang_sense_clarification": "краевая полоса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "571eb2e3-73ef-3287-ae8d-0db9ef9c903f",
                    "sense_definition": "A strip of wood or other material fastened over a flush seam or joint to strengthen it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strip_reinforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter nailed a wooden <w>welt</w> over the joint to keep it rigid.",
                            "target_lang_translations": {
                                "ru": "Плотник прибил деревянную <w>планку</w> поверх стыка, чтобы зафиксировать его."
                            }
                        },
                        {
                            "text": "A protective <w>welt</w> was fastened along the seam where the two boards met.",
                            "target_lang_translations": {
                                "ru": "Защитный <w>нащельник</w> был закреплен вдоль стыка в месте соединения двух досок."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревянная планка или нащельник, прикрепляемый поверх стыка для усиления конструкции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нащельник",
                                "target_lang_sense_clarification": "планка, закрывающая стык"
                            },
                            {
                                "target_lang_word": "накладка",
                                "target_lang_sense_clarification": "укрепляющая планка"
                            },
                            {
                                "target_lang_word": "планка",
                                "target_lang_sense_clarification": "деревянная полоса поверх шва"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7709c364-e3a0-3ddf-b3f4-2f865032be34",
                    "sense_definition": "A metal strip riveted over the edges of sheet-iron or boiler plates forming a butt joint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strip_reinforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer secured each iron joint with a heavy steel <w>welt</w>.",
                            "target_lang_translations": {
                                "ru": "Инженер укрепил каждый железный стык тяжелой стальной <w>накладкой</w>."
                            }
                        },
                        {
                            "text": "Steam escaped because the riveted <w>welt</w> on the boiler plate had cracked.",
                            "target_lang_translations": {
                                "ru": "Пар выходил наружу, потому что приклёпанная <w>стыковая планка</w> на котельной пластине треснула."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлическая полоса (накладка), приклепанная поверх стыка листов железа или котельных плит."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накладка",
                                "target_lang_sense_clarification": "металлическая полоса на стыковом шве"
                            },
                            {
                                "target_lang_word": "стыковая планка",
                                "target_lang_sense_clarification": "в клепаных соединениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1ddc47f-bcbe-3c12-874b-5b0444611245",
                    "sense_definition": "A strip or flap in machine knitting used to form or reinforce the heel of a stocking.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strip_reinforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knitting machine was adjusted to produce an elastic <w>welt</w> on the heel.",
                            "target_lang_translations": {
                                "ru": "Вязальную машину настроили так, чтобы на пятке получался эластичный <w>подгиб</w>."
                            }
                        },
                        {
                            "text": "A reinforced <w>welt</w> keeps the top of the stocking from curling downward.",
                            "target_lang_translations": {
                                "ru": "Усиленный <w>борт</w> не дает верху чулка заворачиваться вниз."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Укрепляющая полоса или подгиб в машинном вязании чулочно-носочных изделий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подгиб",
                                "target_lang_sense_clarification": "в вязании чулок"
                            },
                            {
                                "target_lang_word": "борт",
                                "target_lang_sense_clarification": "укрепленный край трикотажного изделия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b78285ac-be7e-35a6-94c6-a830ddf940cf",
                    "sense_definition": "A shoe made with a welt stitched between the upper and outsole.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strip_reinforcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traditional shoemakers produced sturdy leather <w>welts</w> for working men.",
                            "target_lang_translations": {
                                "ru": "Традиционные сапожники изготавливали для рабочих прочную кожаную <w>рантовую обувь</w>."
                            }
                        },
                        {
                            "text": "The shop sold handmade <w>welts</w> that could easily be repaired and resoled.",
                            "target_lang_translations": {
                                "ru": "В магазине продавалась сделанная вручную <w>рантовая обувь</w>, которую можно было легко починить и сменить на ней подошву."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обувь рантового метода крепления (с пришитым рантом)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рантовая обувь",
                                "target_lang_sense_clarification": "обувь с пришитым рантом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16bbfa7f-ab86-3e85-a7a1-97192c8ff6d5",
                    "sense_definition": "To strike heavily, producing marks or raised ridges on the skin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hit_beat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He angrily threatened to <w>welt</w> the intruder with a heavy walking stick.",
                            "target_lang_translations": {
                                "ru": "Он в ярости пригрозил <w>отходить</w> нарушителя тяжелой тростью."
                            }
                        },
                        {
                            "text": "The cruel master would <w>welt</w> his horses whenever they refused to pull the load.",
                            "target_lang_translations": {
                                "ru": "Жестокий хозяин <w>хлестал</w> своих лошадей каждый раз, когда они отказывались везти груз."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно бить, хлестать, оставляя следы или рубцы на коже."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлестать",
                                "target_lang_sense_clarification": "сильно стегать до рубцов"
                            },
                            {
                                "target_lang_word": "пороть",
                                "target_lang_sense_clarification": "наносить удары прутом или кнутом"
                            },
                            {
                                "target_lang_word": "лупить",
                                "target_lang_sense_clarification": "разг., сильно бить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "745a32b0-c36a-3964-a891-881919fa5a98",
                    "sense_definition": "To equip or border with a welt or reinforcing strip.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "border_fitting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craftsman took time to carefully <w>welt</w> the edge of each sole.",
                            "target_lang_translations": {
                                "ru": "Мастер не торопясь и тщательно <w>пришивал рант</w> к краю каждой подошвы."
                            }
                        },
                        {
                            "text": "Upholsterers often <w>welt</w> fine cushions to give them a tailored appearance.",
                            "target_lang_translations": {
                                "ru": "Обивщики часто <w>окантовывают</w> изящные подушки, чтобы придать им аккуратный законченный вид."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснащать рантом, кантом или укрепляющей полосой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пришивать рант",
                                "target_lang_sense_clarification": "к обуви"
                            },
                            {
                                "target_lang_word": "окантовывать",
                                "target_lang_sense_clarification": "обрабатывать край кантом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96b0a7da-8d8a-3f25-b164-e0f58d7173b2",
                    "sense_definition": "To roll or revolve.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship began to <w>welt</w> violently in the towering ocean waves.",
                            "target_lang_translations": {
                                "ru": "Корабль начал яростно <w>раскачиваться</w> на огромных океанских волнах."
                            }
                        },
                        {
                            "text": "Fallen boulders <w>welt</w> down the hillside during the violent earthquake.",
                            "target_lang_translations": {
                                "ru": "Обрушившиеся валуны <w>катились</w> вниз по склону во время мощного землетрясения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to mean roll or tumble"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Катиться, перекатываться или вращаться (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катиться",
                                "target_lang_sense_clarification": "устар., перекатываться"
                            },
                            {
                                "target_lang_word": "раскачиваться",
                                "target_lang_sense_clarification": "устар., крениться о судне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cff99e7-11ba-39d8-8b61-7ef7d8e63c98",
                    "sense_definition": "To decay, wither, or rot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unharvested vegetables began to <w>welt</w> in the damp soil.",
                            "target_lang_translations": {
                                "ru": "Несобранные овощи начали <w>гнить</w> в сырой земле."
                            }
                        },
                        {
                            "text": "Old timber will quickly <w>welt</w> if left uncovered in continuous rain.",
                            "target_lang_translations": {
                                "ru": "Старая древесина быстро <w>сгниет</w>, если оставить её открытой под непрекращающимся дождем."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional variant or dialect meaning decay"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гнить, увядать или портиться (диалектное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнить",
                                "target_lang_sense_clarification": "диал., разлагаться"
                            },
                            {
                                "target_lang_word": "увядать",
                                "target_lang_sense_clarification": "диал., вянуть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6b8279c-560b-35a8-917d-3a300c1d7092",
                    "sense_definition": "To become ropy or stringy, as liquids undergoing spoilage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The milk began to <w>welt</w> after sitting in the warm kitchen for days.",
                            "target_lang_translations": {
                                "ru": "Молоко начало <w>тянуться тягучими нитями</w> после того, как несколько дней простояло в теплой кухне."
                            }
                        },
                        {
                            "text": "The broth will <w>welt</w> if bacteria contaminate the fermentation vessel.",
                            "target_lang_translations": {
                                "ru": "Бульон <w>ослизнится</w>, если в емкость для ферментации попадут бактерии."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional meaning referring to fluids turning stringy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться тягучим или ослизняться (о жидкостях при порче, диалектное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тягустеть",
                                "target_lang_sense_clarification": "диал., становиться вязким при скисании"
                            },
                            {
                                "target_lang_word": "ослизняться",
                                "target_lang_sense_clarification": "диал., портиться и становиться нитевидным"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "922795ad-2760-3734-b786-7f523e6157f5",
                    "sense_definition": "A surname of German origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Welt</w> published a fascinating monograph on medieval trade routes.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Вельт</w> опубликовал увлекательную монографию о средневековых торговых путях."
                            }
                        },
                        {
                            "text": "Several families named <w>Welt</w> settled in Pennsylvania during the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Несколько семей по фамилии <w>Вельт</w> поселились в Пенсильвании в девятнадцатом веке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "German family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Немецкая фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вельт",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}