                "senses": [
                    {
                        "sense_id": "cc35de2f-ce0b-3cda-abe6-8335b18cd532",
                        "entry_id": "4e93d6c3-f630-3296-b917-61074448397e",
                        "glosses": [
                            "een geneesmiddel dat slaap veroorzaakt, in de zin van makkelijker in slaap vallen en/of langer doorslapen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4cadc69-8361-42c2-836f-8b661ae5cfe5",
                                "sense_id": "cc35de2f-ce0b-3cda-abe6-8335b18cd532",
                                "text": "Mogelijk schrikken grootgebruikers terug voor „het stigma verslaving”, oppert Paling. Zeker is dat veel gebruikers geen idee hebben hoe gevaarlijk de slaapmiddelen kunnen zijn, zegt Paling, die bij Radboudumc in Nijmegen onderzoek doet aan benzodiazepinen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d86c0eec-3bb1-4340-975c-ce0f0b687872",
                        "source_entry_id": "4e93d6c3-f630-3296-b917-61074448397e",
                        "source_sense_id": "cc35de2f-ce0b-3cda-abe6-8335b18cd532",
                        "source_sense_description": "een geneesmiddel dat slaap veroorzaakt",
                        "target_lang_word": "Schlafmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlafmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30915847-88ca-3191-aa17-9e5dc4606933",
                                        "entry_id": "a9d434c0-16d0-3436-9163-87b7b51eb1e8",
                                        "glosses": [
                                            "Mittel, das den Schlaf ermöglicht oder verbessert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd478ffd-64df-44e7-aea2-283e2a159d4e",
                                                "sense_id": "30915847-88ca-3191-aa17-9e5dc4606933",
                                                "text": "„Doll war erst mitten in der Schlafmittelentwöhnung und noch nicht ganz taktfest in der Stimmung, und der Verdacht würde bei den Ärzten bestehen, dass er sich beim freien Ausgang in die Stadt zusätzliche Schlafmittel oder gar Narkotika besorgen würde.“"
                                            },
                                            {
                                                "example_id": "0123a75b-d2f9-4dd2-be60-76afd11193e8",
                                                "sense_id": "30915847-88ca-3191-aa17-9e5dc4606933",
                                                "text": "„Auch er nimmt ein Schlafmittel.“"
                                            },
                                            {
                                                "example_id": "ee057ab9-3d25-4e82-a22a-77dc9736cead",
                                                "sense_id": "30915847-88ca-3191-aa17-9e5dc4606933",
                                                "text": "„Dann waren die Männer schon bei der Arbeit, und die Wirkung des Schlafmittels nahm langsam ab.“"
                                            },
                                            {
                                                "example_id": "b9c1c74c-4aa0-4986-b21c-e6624344a5a6",
                                                "sense_id": "30915847-88ca-3191-aa17-9e5dc4606933",
                                                "text": "„Morphin wurde bald als Schlafmittel verwendet, von den 1870er Jahren an auch als Sedativum bei erregten Kranken in psychiatrischen Anstalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
