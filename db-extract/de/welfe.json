                                        "sense_id": "0d94bdfb-9b4f-3ecf-a284-486b398f6a9e",
                                        "entry_id": "b7ca564a-2a1a-3761-ae1d-c0bfde8c545f",
                                        "glosses": [
                                            "In the politics of medieval Italian city states, any member of a faction that supported the Pope in a long struggle against the Ghibellines and the Holy Roman Emperor."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44c9997f-3bd5-4f5f-9166-b45aad1ae324",
                                                "sense_id": "0d94bdfb-9b4f-3ecf-a284-486b398f6a9e",
                                                "text": "1893, Oscar Browning, Guelphs and Ghibellines: A Short History of Mediaeval Italy from 1250-1409, Methuen & Co., page 13,\nThe parties of Guelph and Ghibelline raged as fiercely as if the lances of the German hosts were ever glimmering on the crest of the Alps, or as if the Lombard leagues were in constant watchfulness against an impending foe. […] Speaking generally, the Ghibellines were the party of the emperor, and the Guelphs the party of the Pope; the Ghibellines were on the side of authority, or sometimes of oppression, the Guelphs were on the side of liberty and self-government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dd78555-969c-3b85-bf49-3800cb3a5ab0",
                                        "entry_id": "b7ca564a-2a1a-3761-ae1d-c0bfde8c545f",
                                        "glosses": [
                                            "Any member of the German-Hanoverian Party (1867–1933), a conservative federalist political party in the German Empire and the Weimar Republic founded in protest of the annexation of the Kingdom of Hanover by the Kingdom of Prussia."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7716e493-cd5f-4180-881b-eb6d038d6546",
                                                "sense_id": "4dd78555-969c-3b85-bf49-3800cb3a5ab0",
                                                "text": "Bismarck was aware of the opportunity which the Reichstag afforded the Guelphs."
                                            }
                                        ]
                                    }
                                ]
