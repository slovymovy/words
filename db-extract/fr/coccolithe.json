                    }
                ],
                "senses": [
                    {
                        "sense_id": "32035519-846d-3f35-846c-0915ba39294e",
                        "entry_id": "21fb134b-db6a-385e-8a12-0d748621d829",
                        "glosses": [
                            "Plaquette de calcite microscopique sécrétée par des coccolithophores, algues unicellulaires marines, et recouvrant leur cellule pour former une coccosphère."
                        ],
                        "tags": [
                            "Biologie marine",
                            "Biominéralogie"
                        ],
                        "examples": [
                            {
                                "example_id": "06b2daf3-066f-41b4-8088-04b352c30425",
                                "sense_id": "32035519-846d-3f35-846c-0915ba39294e",
                                "text": "Les divers coccolithes de la coccosphère se recouvrent largement les uns les autres, assurant une indéniable rigidité à l’ensemble."
                            },
                            {
                                "example_id": "92c14698-66a1-463a-8a50-de7fd1feb4e8",
                                "sense_id": "32035519-846d-3f35-846c-0915ba39294e",
                                "text": "Les très faibles valeurs obtenues pour la craie blanche, sont dues au fait qu'elle est constituée essentiellement de fragments de coccolithes qui ne sont pas liés par un ciment (Pl. V, fig. 25 et 26). L'ensemble a donc une faible cohésion interparticulaire."
                            },
                            {
                                "example_id": "0aaec492-e238-4cb9-a147-985b72a1523c",
                                "sense_id": "32035519-846d-3f35-846c-0915ba39294e",
                                "text": "Les coccolithes sont des plaques microscopiques de calcite CaCO₃ qui servent d’exosquelette d’algues marines unicellulaires : les coccolithophores."
                            }
                        ]
                    }
                ],
