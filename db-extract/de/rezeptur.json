                    {
                        "form_id": "e109d459-419c-4d8c-bd78-888598fe7731",
                        "entry_id": "64bf9a49-3f67-3eee-aa86-81364235d978",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Rezeptur"
                    },
                    {
                        "form_id": "6e4aab87-0573-4a2b-9b7e-f0b3d7cb178c",
                        "entry_id": "64bf9a49-3f67-3eee-aa86-81364235d978",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rezepturen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e1c2f905-8555-306e-895d-fe59e31170a8",
                        "entry_id": "64bf9a49-3f67-3eee-aa86-81364235d978",
                        "glosses": [
                            "Anweisungen zur Herstellung eines Medikaments, Zusammensetzung eines Medikaments"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "a65f6b68-ab9b-4d03-91c1-4b9978e6ff7d",
                                "sense_id": "e1c2f905-8555-306e-895d-fe59e31170a8",
                                "text": "„In Rezepturen wird Folium häufig als Fol. abgekürzt.“"
                            },
                            {
                                "example_id": "f79eea8b-5167-41f4-84b1-c7faeb522f31",
                                "sense_id": "e1c2f905-8555-306e-895d-fe59e31170a8",
                                "text": "„Doch nun sucht die Pharmaforschung neue medizinische Substanzen und Rezepturen gegen Schmerzen, Krebs, Aids oder Malaria.“"
                            },
                            {
                                "example_id": "9b33d10a-eddf-49af-b09b-e187b5270c2c",
                                "sense_id": "e1c2f905-8555-306e-895d-fe59e31170a8",
                                "text": "„Die Forschergruppe Klostermedizin an der Uni Würzburg beschäftigt sich mit Rezepturen, die einst von Mönchen niedergeschrieben wurden und neu entdeckt werden.“"
                            },
                            {
                                "example_id": "51171cbd-029d-483d-bbfa-4ef579d28436",
                                "sense_id": "e1c2f905-8555-306e-895d-fe59e31170a8",
                                "text": "„Bei der Eigenherstellung von Arzneimitteln in Apotheken werden Arzneimittel von Apothekern nach Verschreibung durch einen Arzt oder auf Verlangen eines Patienten nach einer Rezeptur individuell zubereitet.“"
                            },
                            {
                                "example_id": "3ee58f5f-6e90-490c-bd6a-6129275e454f",
                                "sense_id": "e1c2f905-8555-306e-895d-fe59e31170a8",
                                "text": "[Verwendung von Schlangengift im Mittelalter:] „Aus heutiger Sicht muten viele dieser Rezepturen befremdlich an, weil die behaupteten Heilwirkungen in symbolischen, allegorischen und magischen Vorstellungen wurzeln.“"
                            },
                            {
                                "example_id": "b12cdbb5-e40c-4f8e-b270-103788322eb8",
                                "sense_id": "e1c2f905-8555-306e-895d-fe59e31170a8",
                                "text": "[Salbe:] „Es gibt eine Reihe von konkurrierenden Produkten, die eine ähnliche Rezeptur und Wirkung haben, jedoch meist nur einen regionalen Bekanntheitsgrad erreichen.“"
                            },
                            {
                                "example_id": "7e0ab562-84ba-4eb5-9ca6-84f8e94926f4",
                                "sense_id": "e1c2f905-8555-306e-895d-fe59e31170a8",
                                "text": "„Nachdem die Rezeptur des Schilddrüsen-Medikaments Levothyrox in Frankreich verändert wurde, klagen jetzt viele Patienten über Nebenwirkungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5d4e4826-87e6-3e90-90c1-1b134a82de94",
                        "entry_id": "64bf9a49-3f67-3eee-aa86-81364235d978",
                        "glosses": [
                            "Raum (beispielsweise in einer Apotheke), in dem Medikamente hergestellt werden"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9f558cc6-d705-3071-b40c-dc3dea135352",
                        "entry_id": "64bf9a49-3f67-3eee-aa86-81364235d978",
                        "glosses": [
                            "Anweisungen zur Zubereitung eines Gerichts, Liste der Zutaten eines Gerichts"
                        ],
                        "tags": [
                            "Küche",
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "2cb8b89c-2ebe-48c4-bfc7-595d815710b4",
                                "sense_id": "9f558cc6-d705-3071-b40c-dc3dea135352",
                                "text": "„Viele Gebäcke gelingen nur mit speziell für Urgetreide entwickelten Rezepturen und Verarbeitungsmethoden […].“"
                            },
                            {
                                "example_id": "586d83c8-760a-4234-af56-dfbece1b2e2b",
                                "sense_id": "9f558cc6-d705-3071-b40c-dc3dea135352",
                                "text": "[Kaugummi:] „Zwei Jahre lang haben sie [Anmerkung: die Schülerinnen] ihre Rezeptur verfeinert. Julia erklärt, dass ihre \"Kaubasis\" nicht Kunststoffpolymere sind, sondern \"Chicle\" - ein aus Südamerika stammendes Baumharz, auf dem schon die Azteken und die Maya kauten.“"
                            },
                            {
                                "example_id": "417e8461-8297-4044-b3cd-ffae9d58d071",
                                "sense_id": "9f558cc6-d705-3071-b40c-dc3dea135352",
                                "text": "„Hier räuchert er nach einer geheimen Rezeptur den Fisch von Hand.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "9fee361d-7769-340f-90f0-b3cfc189d566",
                        "entry_id": "64bf9a49-3f67-3eee-aa86-81364235d978",
                        "glosses": [
                            "Anweisungen zur Zusammensetzung von Stoffgemischen (beispielsweise Farben, Lacke, Kosmetika, Baustoffe, Futtermittel)"
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "8b6c2db9-5a02-467b-8493-a32bd4e0ef02",
                                "sense_id": "9fee361d-7769-340f-90f0-b3cfc189d566",
                                "text": "„Überall auf der Welt wurden Patente auf immer neue Rezepturen für die Butteralternative [Anmerkung: Margarine] vergeben.“"
                            },
                            {
                                "example_id": "f012dc3e-ad54-4e91-ad26-9ff0403ab963",
                                "sense_id": "9fee361d-7769-340f-90f0-b3cfc189d566",
                                "text": "[Lübecker Marzipan:] „Laut Unternehmenssprecherin Kathrin Gaebel kennen nur sechs Menschen in der Firma die genaue Rezeptur.“"
                            },
                            {
                                "example_id": "2a1d3771-235b-44fa-8694-5ba84de62342",
                                "sense_id": "9fee361d-7769-340f-90f0-b3cfc189d566",
                                "text": "„Die Rezeptur von Nutella wurde von dem damaligen Firmenchef Michele Ferrero und dem Lebensmittelchemiker Francesco Rivella (1927–2025) entwickelt.“"
                            },
                            {
                                "example_id": "94eaee03-284c-4844-b451-ccf70a731420",
                                "sense_id": "9fee361d-7769-340f-90f0-b3cfc189d566",
                                "text": "„In Europa wird Nutella nach mindestens zwei verschiedenen Rezepturen hergestellt.“"
                            },
                            {
                                "example_id": "73a118ad-2bd9-4af8-b6c3-c29ca0e223f7",
                                "sense_id": "9fee361d-7769-340f-90f0-b3cfc189d566",
                                "text": "„Denn ein sehr großer Teil der CO₂-Einsparung in Rohrdorf geht schon jetzt auf eine geänderte Rezeptur mit einen höheren Anteil etwa von Hochofenschlacke aus Stahlwerken zurück.“"
                            },
                            {
                                "example_id": "a439f2bf-8dc4-4acf-90b5-0ba89a965a9e",
                                "sense_id": "9fee361d-7769-340f-90f0-b3cfc189d566",
                                "text": "[Seife:] „Was die Sumerer entdeckten, haben die Ägypter weiterentwickelt: Sie fügten der Rezeptur Soda hinzu, ein Mineral, das in der Bodenkruste gefunden werden kann oder durch Verbrennung salzhaltiger Pflanzen entsteht. Das Resultat: Die Waschleistung steigerte sich deutlich.“"
                            },
                            {
                                "example_id": "1dfe5106-f4a6-465e-9020-35bc57be5a1c",
                                "sense_id": "9fee361d-7769-340f-90f0-b3cfc189d566",
                                "text": "[Seife:] „»Eine weitere Umweltsünde ist, dass in zwei Produkten in der Rezeptur auch flüssige Kunststoffverbindungen enthalten sind, und zwar ‚synthetische Polymere‘«, so Schuster.“"
                            },
                            {
                                "example_id": "23a783bc-5594-47c8-ab62-27fe334ceabf",
                                "sense_id": "9fee361d-7769-340f-90f0-b3cfc189d566",
                                "text": "„Lacklaboranten sind die Köche der Chemie. Sie entwickeln Rezepturen für Farben und Lacke, prüfen deren Eigenschaften, nehmen Proben und dokumentieren ihre Arbeit.“"
                            },
                            {
                                "example_id": "1c7cf4af-cc95-4a3d-bfc2-33a909ea400e",
                                "sense_id": "9fee361d-7769-340f-90f0-b3cfc189d566",
                                "text": "„An der Rezeptur der Tinte haben Carolina Reyes und ihre Kollegen mehrere Jahre lang gearbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "d12afa96-c294-359a-83a4-e526093681e8",
                        "entry_id": "64bf9a49-3f67-3eee-aa86-81364235d978",
                        "glosses": [
                            "Anleitung für das Gelingen von etwas"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "5081fc5c-b010-4eca-af3e-ddf0cd5fb167",
                                "sense_id": "d12afa96-c294-359a-83a4-e526093681e8",
                                "text": "„Es ist daher fraglich, ob die keynesianische Rezeptur einer Konjunkturpolitik jetzt ein kluger Einsatz begrenzter öffentlicher Mittel ist.“"
                            },
                            {
                                "example_id": "1b4fd3e1-b773-48a8-b676-209ef40e0e7e",
                                "sense_id": "d12afa96-c294-359a-83a4-e526093681e8",
                                "text": "[Massenproteste:] „Es wäre jedoch naiv, eine allgemein gültige Rezeptur für gelingende Massenmobilisierung vorlegen zu wollen – eine Rezeptur, die sich ungeachtet der jeweiligen thematischen Besonderheiten, der sozialen, politischen und kulturellen Rahmenbedingungen sowie möglicherweise hinzutretender zufälliger Konstellationen und Ereignisse anwenden ließe.“"
                            },
                            {
                                "example_id": "98a5560f-a645-46f4-a0a2-a0bb592a12b2",
                                "sense_id": "d12afa96-c294-359a-83a4-e526093681e8",
                                "text": "„Auch eine Rezeptur wider das politische Nervengift Vertrauen hielt Kissinger parat. Wenn man wartet, »bis die sowjetische Drohung völlig eindeutig und die Gefahr offensichtlich geworden ist, […] kann es sehr wohl zu spät sein. […]«“"
                            },
                            {
                                "example_id": "983484e8-f0ad-4f94-bbfe-678f8d7e09dd",
                                "sense_id": "d12afa96-c294-359a-83a4-e526093681e8",
                                "text": "„Der Trend zur \"People-Story\" ist ungebrochen, meint der Journalist Hans Leyendecker und verrät die Rezeptur an Hand eines erfolgreichen Beispiels: »Das Sterben der Hannelore Kohl hat nicht nur deshalb so viel Aufmerksamkeit gefunden, weil sie die Gattin Helmut Kohls war, sondern auch, weil Leid und Gerüchte eine Melange ergaben, die den Klatsch förderte.«“"
                            },
                            {
                                "example_id": "64ff71a5-e3f4-4131-b774-e3f2a38737d4",
                                "sense_id": "d12afa96-c294-359a-83a4-e526093681e8",
                                "text": "[Ostdeutschland:] „Unterscheidungsvermögen, nicht Schablonendenken, scheint die notwendige wissenschaftliche und politische Rezeptur zu sein, um auf Schrumpfungsfragen als soziale Fragen zu reagieren.“"
                            },
                            {
                                "example_id": "f8f06252-ff03-4e55-bbd4-5e124c2d30e6",
                                "sense_id": "d12afa96-c294-359a-83a4-e526093681e8",
                                "text": "„Würde man eine Rezeptur für gutes politisches Reden entwerfen, spielte der Zeitpunkt eine wichtige Rolle, neben der Relevanz des Gesagten, der Verständlichkeit, der Emotionalität und dem Sprechort. John F. Kennedys Satz \"Ich bin ein Berliner\", gesprochen in der Frontstadt Berlin während des Kalten Krieges, darf als Benchmark in dieser Disziplin gelten.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
