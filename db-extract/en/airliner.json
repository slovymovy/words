                                                "sense_id": "34500710-d139-38e0-8a16-63bcd22c2fbc",
                                                "text": "Maar ooit was ik de enige passagier in een groot lijnvliegtuig in Mali."
                                            },
                                            {
                                                "example_id": "3fe2cc30-6b44-4ef4-909c-d1a0157b17b3",
                                                "sense_id": "34500710-d139-38e0-8a16-63bcd22c2fbc",
