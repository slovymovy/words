                    },
                    {
                        "translation_id": "7bda89d7-ddd9-45df-8f18-bce950c8457e",
                        "source_entry_id": "d3b43a89-7307-3f06-a920-85eb5ad32d28",
                        "source_sense_description": "misspelled word",
                        "target_lang_word": "Rechtschreibfehler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechtschreibfehler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "898e627d-6709-3106-9deb-3cdc681ef8d3",
                                        "entry_id": "6f17cb3f-4bac-3e5c-925a-7c2056d03308",
                                        "glosses": [
                                            "Fehler in der Rechtschreibung, falsch geschriebenes Wort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcf96378-9856-46ac-8441-2c717ce50bd3",
                                                "sense_id": "898e627d-6709-3106-9deb-3cdc681ef8d3",
                                                "text": "Heinz schrieb „Libe“ anstatt „Liebe“ und handelte sich damit einen Rechtschreibfehler ein. Dieser Text strotzt nur so vor Rechtschreibfehlern."
                                            },
                                            {
                                                "example_id": "bc8a33d0-d991-42dd-98fd-84eefae1bc7d",
                                                "sense_id": "898e627d-6709-3106-9deb-3cdc681ef8d3",
                                                "text": "„Wer es versucht, macht Rechtschreibfehler und bekommt schlechte Zensuren.“"
                                            },
                                            {
                                                "example_id": "abff1d46-6929-48f2-b4a6-ccee100e27fc",
                                                "sense_id": "898e627d-6709-3106-9deb-3cdc681ef8d3",
                                                "text": "„Deshalb macht es Henning Scheich fassungslos, dass bei den meisten der auf Reichen beruhenden Methoden Rechtschreibfehler mindestens ein Jahr lang, oft auch noch deutlich länger, nicht oder nur unregelmäßig angestrichen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "294e226e-e2c6-49a8-a59b-34bef82a929e",
                        "source_entry_id": "d3b43a89-7307-3f06-a920-85eb5ad32d28",
                        "source_sense_description": "misspelled word",
                        "target_lang_word": "Schreibfehler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreibfehler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fd98451-82b1-3c31-88d4-fbb5cdc2c266",
                                        "entry_id": "78d68c2d-c0b8-3bee-a69a-262b4de3c67c",
                                        "glosses": [
                                            "Fehler in einem geschriebenen Text im Hinblick auf Interpunktion oder Orthografie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "821015d3-f3ed-4a07-b8ea-2ab316f0a90c",
                                                "sense_id": "0fd98451-82b1-3c31-88d4-fbb5cdc2c266",
                                                "text": "„Die Briefe, die ich schrieb, strotzten, wie ich erfuhr, von Schreibfehlern.“"
                                            },
                                            {
                                                "example_id": "3c8e84fe-4523-47ca-92dd-bfc09fa09fa5",
                                                "sense_id": "0fd98451-82b1-3c31-88d4-fbb5cdc2c266",
                                                "text": "„Die Postbeamtin wollte ihre Papiere wegen dieses Schreibfehlers nicht annehmen.“"
                                            },
                                            {
                                                "example_id": "2d795c39-2b47-4cb8-95bf-86720fdc3fd3",
                                                "sense_id": "0fd98451-82b1-3c31-88d4-fbb5cdc2c266",
                                                "text": "„Während ich es noch einmal abschrieb, um einige Schreibfehler auszumerzen, ging er zu seinem Vater und fragte ihn, wer ich sei; darüber mußte dieser lachen, bis wir zu Tisch gingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d499908-a7d0-457b-8ed7-84d6155dc2d8",
                        "source_entry_id": "d3b43a89-7307-3f06-a920-85eb5ad32d28",
