                        ]
                    },
                    {
                        "translation_id": "800af9ca-8a01-47fd-bd86-f39d812d6a69",
                        "source_entry_id": "3358be1a-1689-35c0-a719-3ff7507f9c3f",
                        "source_sense_id": "619d5000-4bbf-326c-93a3-43c3b10cca62",
                        "source_sense_description": "a community",
                        "target_lang_word": "kibboutz",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kibboutz",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba13645a-b95b-3032-b5e0-bb1887ded4a9",
                                        "entry_id": "d654a644-3e7e-3514-a684-2851218aeeb0",
                                        "glosses": [
                                            "Collectivité juive créée, en Israël, par le mouvement sioniste sous l'influence des idées du socialisme associatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "914b5934-b74a-4c26-8b91-b06e0af49fcc",
                                                "sense_id": "ba13645a-b95b-3032-b5e0-bb1887ded4a9",
                                                "text": "Aujourd’hui, on trouve des traces de l’utopie fouriériste dans le mouvement des SCOP (sociétés coopératives et participatives) comme dans le modèle du kibboutz en Israël ou les expériences locales qui surgissent ici ou là."
                                            },
                                            {
                                                "example_id": "7f095dcd-94b6-4d3f-b104-fc8cd393d717",
                                                "sense_id": "ba13645a-b95b-3032-b5e0-bb1887ded4a9",
                                                "text": "Sachant que j’étais juif, il avait ajouté : « Après l’indépendance, nous devrons envoyer des missions en Israël », et, comme je m’étonnais : « Oui, nous avons énormément à apprendre d’eux. — En quel domaine ? demandai-je. — Oh, les kibboutzim, l’irrigation, l’afforestation, l’amélioration des sols. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "118e03c2-50a7-4e9f-8c15-ce90ebeacf70",
                        "source_entry_id": "3358be1a-1689-35c0-a719-3ff7507f9c3f",
                        "source_sense_id": "619d5000-4bbf-326c-93a3-43c3b10cca62",
                        "source_sense_description": "a community",
                        "target_lang_word": "Kibbuz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kibbuz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6f80065-3451-393e-aba4-7f24239d0f67",
                                        "entry_id": "db8c2299-3c2d-3838-a352-8b2dc16e67b9",
                                        "glosses": [
                                            "ländliche Siedlung im heutigen Israel, deren Einwohner eine kollektive Lebensweise pflegen, die sich auf basisdemokratische Strukturen stützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87d8e2b7-bc32-4dbe-89dd-dbc4b814a944",
                                                "sense_id": "b6f80065-3451-393e-aba4-7f24239d0f67",
                                                "text": "„Im Jahr 1967 waren mehr als 80 Prozent der Arbeiter in einem großen Gewerkschaftsverband organisiert, der mit seinen genossenschaftlichen Betrieben ein Drittel der gesamten Volkswirtschaft kontrollierte; und die Kibbuzim genossen noch ein großes gesellschaftliches Prestige.“"
                                            },
                                            {
                                                "example_id": "897b5b16-a2f0-489f-8046-db82abccde33",
                                                "sense_id": "b6f80065-3451-393e-aba4-7f24239d0f67",
                                                "text": "„Wir hätten eigentlich in einen Kibbuz gewollt, in dem Leute aus Deutschland waren, die wir schon kannten, aber das ging angeblich nicht.“"
                                            },
                                            {
                                                "example_id": "7ef572ef-d19b-4957-a254-7c9ccf1bebd1",
                                                "sense_id": "b6f80065-3451-393e-aba4-7f24239d0f67",
                                                "text": "„Wenn ich Ihnen ausführlich schildern müßte, was ein Kibbuz ist und wie man in einem Kibbuz lebt, dann könnte ich ja ebensogut zur Feder greifen und ein Sachbuch über Palästina schreiben oder über den Kibbuz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
