                ],
                "senses": [
                    {
                        "sense_id": "117babdb-bfa3-39f7-8d71-663b2204605e",
                        "entry_id": "eecf3cf2-ea40-3b14-8a33-ded955994c3f",
                        "glosses": [
                            "helemaal niet boeiend; niet belangwekkend; niet de moeite waard om over na te denken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "696ece98-f4e1-4418-9c09-49d443fa31af",
                                "sense_id": "117babdb-bfa3-39f7-8d71-663b2204605e",
                                "text": "Hoe meer tijd er verstreek, hoe naargeestiger zijn gedachten werden. Het pijnlijkste was de gedachte dat Catharina hem volstrekt oninteressant vond. Mocht ze al dromen hebben, hij zou in geen ervan acteren."
                            },
                            {
                                "example_id": "da06cf5c-f06e-441a-a467-54deeefb9b3f",
                                "sense_id": "117babdb-bfa3-39f7-8d71-663b2204605e",
                                "text": "\"Steeds meer kunstenaars maken politiek of geëngageerd werk. Ze willen zich uitspreken over de wereld. Daarbij moet wel worden opgepast dat het niet een soort politieke propaganda wordt. Dat maakt het als kunst oninteressant.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cff78ef-3779-4a0e-87b6-73789759bc16",
                        "source_entry_id": "eecf3cf2-ea40-3b14-8a33-ded955994c3f",
                        "source_sense_id": "117babdb-bfa3-39f7-8d71-663b2204605e",
                        "source_sense_description": "helemaal niet boeiend; niet belangwekkend; niet de moeite waard om over na te denken",
                        "target_lang_word": "uninteresting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uninteresting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f9fe518-dedb-377a-93c7-c6cc94b6cdde",
                                        "entry_id": "370f8e13-1024-3f9e-9854-f223790126d8",
                                        "glosses": [
                                            "Arousing little or no interest; boring or uneventful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24c4055c-5940-4fc3-ac98-4301cdf6904d",
                                                "sense_id": "6f9fe518-dedb-377a-93c7-c6cc94b6cdde",
                                                "text": "To many, a railway ticket is but an uninteresting bit of pasteboard, which must be purchased before a journey is undertaken, and once obtained, may be stowed away in a convenient pocket and forgotten, until a watchful railway official requests its production."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
