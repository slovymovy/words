                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "automnal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81f16d3d-f6b2-32a4-b9cc-ffa9ef70e518",
                                        "entry_id": "0fabcb4f-4f9a-3820-a4af-a32c04822933",
                                        "glosses": [
                                            "Qui appartient à l’automne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc6dec7-9a65-4130-afeb-640beda8c627",
                                                "sense_id": "81f16d3d-f6b2-32a4-b9cc-ffa9ef70e518",
                                                "text": "On peut se perdre dans le silence automnal des allées du parc de Steglitz."
                                            },
                                            {
                                                "example_id": "a6458ce9-70e0-4585-9747-2b2377602bec",
                                                "sense_id": "81f16d3d-f6b2-32a4-b9cc-ffa9ef70e518",
                                                "text": "Comme l’espérance était la dominante du printemps, une terreur secrète s’empare de l’âme automnale, la fait glisser jusqu’à l’horreur d’elle-même et jusqu’au désespoir."
                                            },
                                            {
                                                "example_id": "453b0527-7c74-4666-810e-b62e7b66f7c7",
                                                "sense_id": "81f16d3d-f6b2-32a4-b9cc-ffa9ef70e518",
                                                "text": "Le soir, résonnaient les sons joyeux des flûtes par-delà les montagnes automnales."
                                            },
                                            {
                                                "example_id": "0e90b702-da6f-4624-9479-1b4092af27ae",
                                                "sense_id": "81f16d3d-f6b2-32a4-b9cc-ffa9ef70e518",
                                                "text": "Il apparaît assez tardivement , comme la plupart des hygrophores, préférant la fraîcheur des pluies automnales aux chaleurs de la fin de l'été."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a38e20f2-e8d5-34ea-9b00-664aee0474b0",
                                        "entry_id": "0fabcb4f-4f9a-3820-a4af-a32c04822933",
                                        "glosses": [
                                            "Qui se rapporte à la période de la vieillesse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd25f6d1-c17c-4456-9dce-1b56ddac0872",
                                                "sense_id": "a38e20f2-e8d5-34ea-9b00-664aee0474b0",
                                                "text": "C’est là qu’il va vivre désormais, entouré de quelques proches, une sœur cadette, un beau-frère attentionné, des neveux, une nièce surtout, qui aura le meilleur de sa tendresse automnale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46ae3917-7a50-33fe-8c2a-7ebad4956982",
                                        "entry_id": "0fabcb4f-4f9a-3820-a4af-a32c04822933",
                                        "glosses": [
                                            "Qualifie la partie du bréviaire qui contient l’office des trois mois de l’automne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
