{
    "word_family": [
        "revise",
        "reviser",
        "revisionary",
        "revisionism",
        "revisionist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3fda3c6-6a19-3629-b43d-59153372cea7",
                    "sense_definition": "The action of reviewing notes or materials previously learned, especially in preparation for a test or examination.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the entire weekend doing <w>revision</w> for her final chemistry exam.",
                            "target_lang_translations": {
                                "ru": "Она провела все выходные за <w>повторением</w> материала к выпускному экзамену по химии.",
                                "zh": "她整个周末都在为化学期末考试做<w>复习</w>。"
                            }
                        },
                        {
                            "text": "My <w>revision</w> notes are messy, but they help me remember the key facts.",
                            "target_lang_translations": {
                                "ru": "Мои конспекты для <w>повторения</w> небрежные, но они помогают мне запомнить ключевые факты.",
                                "zh": "我的<w>复习</w>笔记虽然乱，但能帮我记住关键事实。"
                            }
                        }
                    ],
                    "synonyms": [
                        "review",
                        "studying"
                    ],
                    "common_phrases": [
                        "do revision",
                        "exam revision",
                        "revision notes",
                        "last-minute revision"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British, Australian, and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по повторению изученного материала, особенно при подготовке к экзамену.",
                        "zh": "指为了准备考试或测验，对之前学过的知识进行回顾和复习的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повторение",
                                "target_lang_sense_clarification": "изученного материала"
                            },
                            {
                                "target_lang_word": "подготовка",
                                "target_lang_sense_clarification": "к экзамену"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复习",
                                "target_lang_sense_clarification": "针对学习内容的回顾"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9733c03d-ff80-340c-bd53-e9e956be486d",
                    "sense_definition": "The process of reviewing, editing, and amending a text or piece of work to improve it.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_edit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The article requires careful <w>revision</w> before it can be published in the journal.",
                            "target_lang_translations": {
                                "ru": "Статья требует тщательной <w>переработки</w> перед публикацией в журнале.",
                                "zh": "这篇文章在发表于期刊前需要仔细<w>修改</w>。"
                            }
                        },
                        {
                            "text": "After several rounds of <w>revision</w>, the proposal was finally accepted by the board.",
                            "target_lang_translations": {
                                "ru": "После нескольких этапов <w>пересмотра</w>, предложение было наконец принято советом.",
                                "zh": "经过几轮<w>修订</w>，该提案最终被董事会采纳了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make revisions",
                        "process of revision",
                        "subject to revision",
                        "major revision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс проверки, редактирования и исправления текста или работы с целью их улучшения.",
                        "zh": "对文本或工作成果进行检查、编辑和修改，以使其更加完善的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переработка",
                                "target_lang_sense_clarification": "текста или материала"
                            },
                            {
                                "target_lang_word": "правка",
                                "target_lang_sense_clarification": "внесение изменений"
                            },
                            {
                                "target_lang_word": "пересмотр",
                                "target_lang_sense_clarification": "изменение подхода или содержания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "修改",
                                "target_lang_sense_clarification": "对内容进行更正或完善"
                            },
                            {
                                "target_lang_word": "修订",
                                "target_lang_sense_clarification": "对文稿或计划进行系统性调整"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04686e91-f108-3070-87d4-3bb0b45b63d7",
                    "sense_definition": "A specific new version or edition of something that has been changed or updated.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_edit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please ensure you are using the latest <w>revision</w> of the software manual.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что вы используете последнюю <w>версию</w> руководства к программному обеспечению.",
                                "zh": "请确保您使用的是该软件手册的最新<w>版本</w>。"
                            }
                        },
                        {
                            "text": "This <w>revision</w> corrects the spelling errors found in the previous printed edition.",
                            "target_lang_translations": {
                                "ru": "Эта <w>редакция</w> исправляет орфографические ошибки, найденные в предыдущем печатном издании.",
                                "zh": "这一<w>修订版</w>纠正了上一印刷版中的拼写错误。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "latest revision",
                        "minor revision",
                        "software revision",
                        "new revision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная новая версия или издание чего-либо, содержащее изменения.",
                        "zh": "指经过修改或更新后形成的特定新版本或新版次。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "версия",
                                "target_lang_sense_clarification": "программного обеспечения или документа"
                            },
                            {
                                "target_lang_word": "редакция",
                                "target_lang_sense_clarification": "вариант издания"
                            },
                            {
                                "target_lang_word": "исправленное издание",
                                "target_lang_sense_clarification": "книги или публикации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "版本",
                                "target_lang_sense_clarification": "软件或文档的更新形态"
                            },
                            {
                                "target_lang_word": "修订版",
                                "target_lang_sense_clarification": "书籍或出版物的更新版本"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4cdc57cb-5148-3609-a773-d2eedce6e8a5",
                    "sense_definition": "To provide something with a new vision or perspective.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director attempted to <w>revision</w> the classic play for a modern audience.",
                            "target_lang_translations": {
                                "ru": "Режиссер попытался <w>переосмыслить</w> классическую пьесу для современной аудитории.",
                                "zh": "导演试图为现代观众<w>重新审视</w>这部经典剧作。"
                            }
                        },
                        {
                            "text": "We need to <w>revision</w> our strategy to address the changing market conditions.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>пересмотреть</w> нашу стратегию, чтобы учесть меняющиеся рыночные условия.",
                                "zh": "我们需要<w>重构</w>我们的策略以应对不断变化的市场环境。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "rare or technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дать чему-либо новое видение или перспективу; переосмыслить.",
                        "zh": "以全新的视角或观点重新审视某事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переосмыслить",
                                "target_lang_sense_clarification": "взглянуть по-новому"
                            },
                            {
                                "target_lang_word": "пересмотреть",
                                "target_lang_sense_clarification": "стратегию или концепцию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重新审视",
                                "target_lang_sense_clarification": "以新视角看待事物"
                            },
                            {
                                "target_lang_word": "重构",
                                "target_lang_sense_clarification": "改变原有的概念或策略"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}