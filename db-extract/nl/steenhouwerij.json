                        "examples": [
                            {
                                "example_id": "ee9f3c3e-b029-4d25-be49-be9a453bdfe2",
                                "sense_id": "d03c6507-6080-3282-b750-865aa9e4d0bc",
                                "text": "Ik had er een brokje lapis lazuli, Tonio's favoriet, in willen laten verwerken, maar dat stelde de steenhouwerij voor problemen, dus lieten we het maar zo."
                            },
                            {
                                "example_id": "283e72b1-dc51-4d43-98d5-f91e9ed92a62",
                                "sense_id": "d03c6507-6080-3282-b750-865aa9e4d0bc",
                                "text": "Voor de gemeente Amersfoort was al deze nieuwe informatie aanleiding om het monument aan te passen. Onder druk van de tijd (het is bijna 4 mei) is nu gekozen voor een tijdelijke oplossing. Bij een steenhouwerij in Utrecht is een plaat zandsteen besteld waarop een nieuwe tekst is aangebracht. In plaats van 'Zij offerden zich voor de vrijheid', staat er nu 'Wij herdenken hen die vielen voor de vrijheid'."
                            }
