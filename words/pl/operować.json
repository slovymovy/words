    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "506236f3-985f-358d-b79f-a952bec53e8c",
                    "sense_definition": "przeprowadzać zabieg chirurgiczny na ciele pacjenta",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medycyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz musiał natychmiast <w>operować</w> rannego pacjenta, aby uratować mu życie.",
                            "target_lang_translations": {
                                "ru": "Врач должен был немедленно <w>прооперировать</w> раненого пациента, чтобы спасти ему жизнь."
                            }
                        },
                        {
                            "text": "Wczoraj w nocy doświadczony chirurg z powodzeniem <w>operował</w> złamaną nogę.",
                            "target_lang_translations": {
                                "ru": "Вчера ночью опытный хирург успешно <w>прооперировал</w> сломанную ногу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "operować pacjenta"
                    ],
                    "target_lang_definitions": {
                        "ru": "проводить хирургическую операцию на теле пациента"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оперировать",
                                "target_lang_sense_clarification": "проводить хирургическую операцию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9f988e2-ed0b-311e-a5c3-96f74db09759",
                    "sense_definition": "posługiwać się czymś, używać czegoś w określonym celu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "posługiwanie się",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W trakcie dyskusji prelegent sprawnie <w>operował</w> pojęciami naukowymi.",
                            "target_lang_translations": {
                                "ru": "В ходе дискуссии докладчик умело <w>оперировал</w> научными понятиями."
                            }
                        },
                        {
                            "text": "Ten artysta niezwykle lekko <w>operuje</w> pędzlem podczas malowania portretów.",
                            "target_lang_translations": {
                                "ru": "Этот художник невероятно легко <w>владеет</w> кистью во время написания портретов."
                            }
                        }
                    ],
                    "synonyms": [
                        "posługiwać się"
                    ],
                    "common_phrases": [
                        "operować faktami",
                        "operować pojęciami",
                        "sprawnie operować"
                    ],
                    "target_lang_definitions": {
                        "ru": "пользоваться чем-либо, применять что-либо с определенной целью (словами, понятиями, инструментами)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оперировать",
                                "target_lang_sense_clarification": "фактами, терминами, понятиями"
                            },
                            {
                                "target_lang_word": "пользоваться",
                                "target_lang_sense_clarification": "умело применять что-либо"
                            },
                            {
                                "target_lang_word": "владеть",
                                "target_lang_sense_clarification": "об инструменте, кисти, оружии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "827c3f7e-1010-3cc3-a430-daa0a98779ee",
                    "sense_definition": "prowadzić działalność, funkcjonować lub przebywać na określonym obszarze",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "działanie w terenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policja ostrzega mieszkańców, że ta grupa złodziei <w>operuje</w> głównie w centrum miasta.",
                            "target_lang_translations": {
                                "ru": "Полиция предупреждает жителей, что эта группа воров <w>орудует</w> преимущественно в центре города."
                            }
                        },
                        {
                            "text": "Nowa firma kurierska zaczyna <w>operować</w> na terenie całego kraju.",
                            "target_lang_translations": {
                                "ru": "Новая курьерская компания начинает <w>работать</w> по всей стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "działać"
                    ],
                    "common_phrases": [
                        "operować na rynku",
                        "operować na terenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "вести деятельность, функционировать на определенной территории"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действовать",
                                "target_lang_sense_clarification": "активно функционировать на территории"
                            },
                            {
                                "target_lang_word": "работать",
                                "target_lang_sense_clarification": "вести деятельность, предоставлять услуги"
                            },
                            {
                                "target_lang_word": "орудовать",
                                "target_lang_sense_clarification": "о преступниках или бандах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbea21cb-8209-321e-92de-e2337866ede0",
                    "sense_definition": "obracać środkami pieniężnymi lub dokonywać operacji finansowych",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "finanse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fundusz inwestycyjny codziennie <w>operuje</w> milionami złotych na giełdzie papierów wartościowych.",
                            "target_lang_translations": {
                                "ru": "Инвестиционный фонд ежедневно <w>оперирует</w> миллионами злотых на фондовой бирже."
                            }
                        },
                        {
                            "text": "Maklerzy giełdowi <w>operują</w> kapitałem powierzonym im przez zagranicznych inwestorów.",
                            "target_lang_translations": {
                                "ru": "Биржевые маклеры <w>распоряжаются</w> капиталом, доверенным им иностранными инвесторами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "operować kapitałem",
                        "operować gotówką"
                    ],
                    "target_lang_definitions": {
                        "ru": "совершать финансовые операции, распоряжаться денежными средствами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оперировать",
                                "target_lang_sense_clarification": "денежными суммами, капиталом"
                            },
                            {
                                "target_lang_word": "распоряжаться",
                                "target_lang_sense_clarification": "управлять финансовыми средствами"
                            },
                            {
                                "target_lang_word": "обращать",
                                "target_lang_sense_clarification": "в контексте оборота капитала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "932a5e74-6ff6-3a99-9b01-e9d9f3d222ee",
                    "sense_definition": "prowadzić działania zbrojne lub manewry wojskowe",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wojskowość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dywizja pancerna <w>operowała</w> w trudnym, górzystym terenie przez kilka tygodni.",
                            "target_lang_translations": {
                                "ru": "Танковая дивизия <w>действовала</w> в труднопроходимой гористой местности на протяжении нескольких недель."
                            }
                        },
                        {
                            "text": "Okręty marynarki wojennej regularnie <w>operują</w> na wodach międzynarodowych.",
                            "target_lang_translations": {
                                "ru": "Корабли военно-морского флота регулярно <w>действуют</w> в международных водах."
                            }
                        }
                    ],
                    "synonyms": [
                        "działać"
                    ],
                    "common_phrases": [
                        "operować na tyłach wroga"
                    ],
                    "target_lang_definitions": {
                        "ru": "вести боевые действия или военные маневры"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действовать",
                                "target_lang_sense_clarification": "о войсках или флоте"
                            },
                            {
                                "target_lang_word": "вести операции",
                                "target_lang_sense_clarification": "проводить военные маневры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5e51cf6-b907-33f8-bfbd-a2d746ad59c4",
                    "sense_definition": "o słońcu lub promieniach słonecznych: mocno świecić i nagrzewać dane miejsce",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zjawiska atmosferyczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W południe słońce mocno <w>operowało</w> na bezdrzewnym stoku góry, utrudniając wspinaczkę.",
                            "target_lang_translations": {
                                "ru": "В полдень солнце сильно <w>пекло</w> на безлесьем склоне горы, затрудняя подъем."
                            }
                        },
                        {
                            "text": "Na otwartej plaży promienie słoneczne <w>operują</w> tak silnie, że łatwo o oparzenia.",
                            "target_lang_translations": {
                                "ru": "На открытом пляже солнечные лучи <w>палят</w> так сильно, что легко получить ожоги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "słońce mocno operuje"
                    ],
                    "target_lang_definitions": {
                        "ru": "о солнце или солнечных лучах: сильно припекать, нагревать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "припекать",
                                "target_lang_sense_clarification": "о солнце, сильно греть"
                            },
                            {
                                "target_lang_word": "печь",
                                "target_lang_sense_clarification": "о солнце, сильно светить и греть"
                            },
                            {
                                "target_lang_word": "палить",
                                "target_lang_sense_clarification": "об обжигающем солнце"
                            }
                        ]
                    }
                }
            ]
        }
    ]
