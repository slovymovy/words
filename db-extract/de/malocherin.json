                        "entry_id": "f4d3af40-641d-34ad-a324-31dbdb6014d8",
                        "glosses": [
                            "Arbeitnehmerin, die überwiegend körperlich hart, schwer arbeitet"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "b1d15a1b-eadc-42c2-b921-79e1db388e93",
                                "sense_id": "28b33c09-faaa-3d9e-b158-0ff8422c5cb7",
                                "text": "„Sie schaut auf die Uhr. Es ist spät geworden. Nein, keinen Wein mehr, danke. Sie muss früh raus. Das ist sie sich schuldig, als Malocherin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
