                ],
                "senses": [
                    {
                        "sense_id": "febf7efd-70be-3aa4-ae39-674fdeb0a247",
                        "entry_id": "af3f71ef-e55e-3bdb-aaed-31aa2da3664c",
                        "glosses": [
                            "Qui peut être bu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "276382c6-572f-4d03-bfe5-32c43187484d",
                                "sense_id": "febf7efd-70be-3aa4-ae39-674fdeb0a247",
                                "text": "Ce vin n’est pas bon, mais il est buvable."
                            },
                            {
                                "example_id": "803d5dd8-e357-4c87-8b1e-cb96eda067e7",
                                "sense_id": "febf7efd-70be-3aa4-ae39-674fdeb0a247",
                                "text": "La forme gel buvable est utilisée pour le traitement symptomatique des gastralgies."
                            },
                            {
                                "example_id": "df6e9190-bc8e-46e3-b0c6-d25d005c3280",
                                "sense_id": "febf7efd-70be-3aa4-ae39-674fdeb0a247",
                                "text": "L'eau de Vichy est aussi potable que l'eau du robinet ; mais quant à savoir si elle est buvable, les opinions diffèrent : certains la trouvent imbuvable mais pour d'autres c'est la plus buvable de toutes en raison de son goût."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cac88c9-ff67-456c-a85d-bb03ae8fb3ed",
                        "source_entry_id": "af3f71ef-e55e-3bdb-aaed-31aa2da3664c",
                        "source_sense_id": "febf7efd-70be-3aa4-ae39-674fdeb0a247",
                        "target_lang_word": "trinkbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trinkbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85e01bd2-bcdc-38fd-93f5-0fc16f1403c8",
                                        "entry_id": "b6e6a66e-c2ba-3573-8e78-7591eb6bae01",
                                        "glosses": [
                                            "so beschaffen, dass man es ohne gesundheitliche Bedenken trinken kann"
                                        ],
                                        "tags": [
                                            "von Flüssigkeiten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33f14f6b-b02d-4172-9a11-02b9fe759380",
                                                "sense_id": "85e01bd2-bcdc-38fd-93f5-0fc16f1403c8",
                                                "text": "„Heute habe ich versucht, mir etwas trinkbares Wasser zu verschaffen, indem ich Meerwasser verdunstete.“"
                                            },
                                            {
                                                "example_id": "f57ce500-16f6-47cd-9258-7beb6e250607",
                                                "sense_id": "85e01bd2-bcdc-38fd-93f5-0fc16f1403c8",
                                                "text": "[Jakarta/Indonesien:] „Trotzdem ist trinkbares Wasser ein Luxusgut. Überhaupt ist Wasser für die 18 Millionen Menschen im Ballungsgebiet ein Grund zur täglichen Sorge. Ursache ist der unverantwortliche Umgang mit Abwässern jeder Art.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e85e2698-5706-3c9f-abe1-531ddde9f6f9",
                                        "entry_id": "b6e6a66e-c2ba-3573-8e78-7591eb6bae01",
                                        "glosses": [
                                            "einigermaßen gut schmeckend"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f562cccd-45e8-4574-b1b7-9fa82f3072e8",
                                                "sense_id": "e85e2698-5706-3c9f-abe1-531ddde9f6f9",
                                                "text": "„Schweizer fragen gelegentlich besorgt, wie man es in einem Land aushalte, in dem es weder anständigen Kaffee noch trinkbaren Wein, dafür eine alles beherrschende Bürokratie gebe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "760d2189-7ecd-4165-9795-9901b8de05f1",
                        "source_entry_id": "af3f71ef-e55e-3bdb-aaed-31aa2da3664c",
