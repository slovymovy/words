                "senses": [
                    {
                        "sense_id": "a1d7270f-9746-3cc2-8b75-f29a77f6984f",
                        "entry_id": "a539aeb8-362c-3af9-8bbc-b56aab965635",
                        "glosses": [
                            "Sauce faite avec du poivre, du sel et du vinaigre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd384782-a46a-42c9-b034-763607a7f840",
                                "sense_id": "a1d7270f-9746-3cc2-8b75-f29a77f6984f",
                                "text": "Manger des artichauts à la poivrade, Les manger tout crus, avec une sauce composée d’huile, de vinaigre, de sel et de poivre."
                            },
                            {
                                "example_id": "37c96f50-91b2-4bb6-a8c0-eb32429cb391",
                                "sense_id": "a1d7270f-9746-3cc2-8b75-f29a77f6984f",
                                "text": "À la terrine de hure succède le brochet mayonnaise orné d’un beau persil vert que tout le monde croque sans hésitation. Puis la gruillotte, qui est civet où se marient les abats, foie, reins, poumons, collets et pieds de sangliers. Enfin, le quartier rôti servi avec une opulante^([sic]) sauce poivrade à base de marinade."
                            },
                            {
                                "example_id": "8e9e33d2-09f1-487f-a500-1fceec71c39e",
                                "sense_id": "a1d7270f-9746-3cc2-8b75-f29a77f6984f",
                                "text": "Un lièvre à la sauce poivrade."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4e51baf-810a-3122-b6f5-f2ac944a2c82",
                        "entry_id": "a539aeb8-362c-3af9-8bbc-b56aab965635",
