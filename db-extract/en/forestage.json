                "senses": [
                    {
                        "sense_id": "02883e3a-f821-3234-9534-e0316cdddbf2",
                        "entry_id": "6470ce8f-0d80-3709-a52b-1155b1253213",
                        "glosses": [
                            "The part of a theatre stage in front of the closed curtain."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "92438ac5-0e75-372c-baaa-c8d1fd385d6e",
                        "entry_id": "6470ce8f-0d80-3709-a52b-1155b1253213",
                        "glosses": [
                            "A preliminary or developmental stage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bf520de-9d81-438e-ad7a-05f397309f70",
                                "sense_id": "92438ac5-0e75-372c-baaa-c8d1fd385d6e",
                                "text": "The formation of exogenous uric acid is largely within our power; the amount can be diminished by limiting the forestages of uric acid-nucleins and purin derivatives—in the food."
                            },
                            {
                                "example_id": "d01bcee2-0cfb-4485-807a-28d3022aec98",
                                "sense_id": "92438ac5-0e75-372c-baaa-c8d1fd385d6e",
                                "text": "The various foot abnormalities have been found to belong to a series of specific types (I to V), all of which have their forestages in embryonic blebs, the final location of which has proved to be decisive for the type of abnormality."
                            },
                            {
                                "example_id": "731198a3-8d83-4b71-9e03-ccb54ec23d68",
                                "sense_id": "92438ac5-0e75-372c-baaa-c8d1fd385d6e",
                                "text": "The antecedents of exhange are the subjective forms of appropriation of alien possessions, robbery and gift-giving - just as presents given to the chief and penalties imposed by the chief represent forestages of taxation."
                            },
                            {
                                "example_id": "2aae4024-04c9-43fc-aaff-e544eb05f25d",
                                "sense_id": "92438ac5-0e75-372c-baaa-c8d1fd385d6e",
                                "text": "The explanation of Gnostic ideas “in terms of themselves,” i.e., in terms of their historical foundations, is futile, for in that way they are reduced only to their less developed forestages but not understood in their actual significance."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a589a89-7702-3a8d-8b6a-883e23b7bd57",
                        "entry_id": "6470ce8f-0d80-3709-a52b-1155b1253213",
                        "glosses": [
                            "Forecastle."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "139ae868-16d8-47a6-93ab-5c5d6cead020",
                                "sense_id": "5a589a89-7702-3a8d-8b6a-883e23b7bd57",
                                "text": "Ships of Forecastle were ships with Forestages, and carried about 150 men each ; they were the largest ships then in use."
                            },
                            {
                                "example_id": "97f082be-537b-4ba5-a7a6-a92613397aa7",
                                "sense_id": "5a589a89-7702-3a8d-8b6a-883e23b7bd57",
                                "text": "This account differs from that in the Cottonian Roll, as well as from that given by Hackluyt, which are both 14,956. In neither of these, however, is any mention of the ships of forstage, the barges, ballengers, or victuallers."
                            },
                            {
                                "example_id": "6286ab13-4db5-4162-a9bc-b0a24773272f",
                                "sense_id": "5a589a89-7702-3a8d-8b6a-883e23b7bd57",
                                "text": "Another letter of 1462 also mentions 'great forestages out of Spain'."
                            },
                            {
                                "example_id": "bc8a5a6b-7950-4ea5-9147-95dde050c88f",
                                "sense_id": "5a589a89-7702-3a8d-8b6a-883e23b7bd57",
                                "text": "The oldest have single-decked and open forestages and the hulls are clinker-built for the characteristic nail pattern is shown; the planks are short."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fafcae99-4c58-44d2-b607-0180db563b1b",
                        "source_entry_id": "6470ce8f-0d80-3709-a52b-1155b1253213",
                        "source_sense_description": "the part of a theatre stage in front of the closed curtain",
                        "target_lang_word": "avant-scène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avant-scène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ebb2d6f-e789-3371-9947-467e91bedae7",
                                        "entry_id": "617a2300-e2c8-315b-b15a-2ecb032a5ffe",
                                        "glosses": [
                                            "Partie du théâtre antique où jouaient les acteurs."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7a61e43-0f4e-3747-8c18-23b7775414ce",
                                        "entry_id": "617a2300-e2c8-315b-b15a-2ecb032a5ffe",
                                        "glosses": [
                                            "Partie du théâtre qui est en avant des décors et qui s’étend jusqu’à l’orchestre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be09941c-6a93-4b3f-a2a3-326ac73ff624",
                                                "sense_id": "c7a61e43-0f4e-3747-8c18-23b7775414ce",
                                                "text": "À droite et à gauche, entre de hautes colonnes, les avant-scènes restaient vides, drapées de lambrequins à longues franges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae67edf2-0bbb-3dc8-82b8-dbfedd0aac7f",
                                        "entry_id": "617a2300-e2c8-315b-b15a-2ecb032a5ffe",
                                        "glosses": [
                                            "Loges de spectateurs placées près de la scène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd43d3de-4f1a-4c5d-9ddf-d7fdcac2ea0f",
                                                "sense_id": "ae67edf2-0bbb-3dc8-82b8-dbfedd0aac7f",
                                                "text": "Cet hiver passa, puis l’été, et à l’automne suivant une fois encore, mais cette fois dans tout l’éclat d’une représentation à bénéfice, en plein Opéra, nous vîmes tout à coup, s’ouvrir, avec un certain fracas, une des grandes loges de l’avant-scène, et, sur le devant de cette loge, s’avancer, un bouquin à la main, cette même beauté que j’avais vue au boulevard."
                                            },
                                            {
                                                "example_id": "437be6b7-f19d-44cb-af13-41ecc81992b1",
                                                "sense_id": "ae67edf2-0bbb-3dc8-82b8-dbfedd0aac7f",
                                                "text": "Je sortais d’un théâtre où tous les soirs je paraissais aux avant-scènes en grande tenue de soupirant."
                                            },
                                            {
                                                "example_id": "a05202f6-7e25-4f94-bd64-53b8bb79b4f3",
                                                "sense_id": "ae67edf2-0bbb-3dc8-82b8-dbfedd0aac7f",
                                                "text": "On le citait partout et en toutes occasions, soit qu’il galopât son cob irlandais, le matin au Bois […] soit qu’il apparût, le soir, dans une avant-scène de théâtre, en compagnie d’une jolie fille […]"
                                            },
                                            {
                                                "example_id": "5675262e-b433-4933-ac27-b866d2013c4f",
                                                "sense_id": "ae67edf2-0bbb-3dc8-82b8-dbfedd0aac7f",
                                                "text": "Ils restaient là, bouche béante, devant lui, éblouis, fascinés, et ils l’enviaient comme lui-même, dans ses voyages à Paris, admirait et enviait Sainte-Austreberthe, lorsqu’il l’apercevait à Longchamps ou dans une avant-scène des Variétés."
                                            },
                                            {
                                                "example_id": "49f46139-58cd-442d-96d4-185507989fa4",
                                                "sense_id": "ae67edf2-0bbb-3dc8-82b8-dbfedd0aac7f",
                                                "text": "Fréquemment, ils disposaient d’une avant-scène à l’Opéra, que leur prêtait la principale cliente de mon père, femme riche dont il était chargé de gérer la fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8200931a-0813-336a-b744-09b16502940b",
                                        "entry_id": "617a2300-e2c8-315b-b15a-2ecb032a5ffe",
                                        "glosses": [
                                            "Partie avancée ou visible d’une manifestation quelconque."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
