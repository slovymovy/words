                        "sense_id": "dae5083c-b822-3c0e-93e6-2f87097f6696",
                        "entry_id": "443c27f9-37ee-35ff-9c47-75bbbf17099d",
                        "glosses": [
                            "Nom donné à des poètes allemands qui florissaient du XIIᵉ au XIVᵉ siècle, et qui imitaient particulièrement les trouvères français et les troubadours provençaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb3e00f0-6182-4f7e-a1ce-72696652b12d",
                                "sense_id": "dae5083c-b822-3c0e-93e6-2f87097f6696",
                                "text": "Comme Jaufre Rudel, le minnesinger Meinloh a recherché sa dame pour sa « vertu »."
                            },
                            {
                                "example_id": "cb9990c5-feec-4a49-8878-0fca6066c921",
                                "sense_id": "dae5083c-b822-3c0e-93e6-2f87097f6696",
                                "text": "On sait que les minnesingers furent les troubadours de l'Allemagne, dont la poésie chevaleresque, soit dans l'épopée, soit dans le genre lyrique, présente presque toujours un calque de la nôtre ; …."
                            }
                        ]
                    }
