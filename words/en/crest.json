                    "target_lang_definitions": {
                        "ru": "Подняться до пика или наивысшего уровня (о волнах или паводковых водах).",
                        "de": "Einen Höchststand erreichen, insbesondere bei Wellen oder Hochwasser."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достигать пика",
                                "target_lang_sense_clarification": "об уровне воды"
                            },
                            {
                                "target_lang_word": "вздыматься",
                                "target_lang_sense_clarification": "о волне"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "den Höchststand erreichen",
                                "target_lang_sense_clarification": "bei Pegelständen oder Fluten"
                            },
                            {
                                "target_lang_word": "sich auftürmen",
                                "target_lang_sense_clarification": "bei Wellen"
                            }
                        ]
                    }
