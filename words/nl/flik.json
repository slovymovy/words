                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Flik</w> dat niet nog een keer!",
                            "target_lang_translations": {
