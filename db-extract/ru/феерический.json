                        "sense_id": "6bf4fa36-1683-39e7-8d83-f0b00287a934",
                        "entry_id": "82d340a6-da80-3e7b-895d-2c3fb2200089",
                        "glosses": [
                            "féerie (related to or characteristic of a féerie)"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "bb4cdd92-bde3-36b3-bb13-37a897b51f20",
                        "entry_id": "82d340a6-da80-3e7b-895d-2c3fb2200089",
                        "glosses": [
                            "enchanting, magical, fairy-tale (making an extraordinary impression)"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d04dc68e-933d-427d-9405-d257c3657642",
                                "sense_id": "bb4cdd92-bde3-36b3-bb13-37a897b51f20",
                                "text": "Ла́мпочки габари́тов, кото́рые тепе́рь перелива́ются и мерца́ют феери́ческим синева́тым све́том, то́же с мультиотража́телем и то́же фи́рмы IPF.",
                                "translation": "Sidelights, which now shimmer and flicker with an enchanting bluish light, also with a multi-reflector and also from IPF.",
                                "english": "Sidelights, which now shimmer and flicker with an enchanting bluish light, also with a multi-reflector and also from IPF."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab80652c-664e-360e-a51e-eec88c9ff6f8",
                        "entry_id": "82d340a6-da80-3e7b-895d-2c3fb2200089",
                        "glosses": [
                            "extraordinary (showing a quality with great intensity)"
                        ],
                        "tags": [
                            "colloquial",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dd57472c-1fbf-4196-8f38-3225a3f89eeb",
                                "sense_id": "ab80652c-664e-360e-a51e-eec88c9ff6f8",
                                "text": "Тако́го феери́ческого вранья́ Пиф ника́к не ожида́ла.",
                                "translation": "Pif did not expect such an extraordinary lie.",
                                "english": "Pif did not expect such an extraordinary lie."
                            }
                        ]
                    }
                ],
