                "senses": [
                    {
                        "sense_id": "eb47a144-67cc-32e7-ad39-06fa42e2fa7d",
                        "entry_id": "9413b7c0-915a-3806-b9d7-03cce5071e5c",
                        "glosses": [
                            "house; edifice, palace"
                        ],
                        "tags": [
                            "inanimate",
