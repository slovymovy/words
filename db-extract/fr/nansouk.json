                ],
                "senses": [
                    {
                        "sense_id": "8add23d0-a394-3581-90f3-6067b17db514",
                        "entry_id": "6fadc9e5-e95a-3f4a-8e90-19553cd1a35b",
                        "glosses": [
                            "Sorte de belle mousseline de coton plus fine que le jaconas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8720e03-8487-4834-93b4-be17bd9528ef",
                                "sense_id": "8add23d0-a394-3581-90f3-6067b17db514",
                                "text": "Elle repasse une chemise de nansouk, une guimpe de batiste, deux jupons, coton et linon."
                            },
                            {
                                "example_id": "d463a425-9144-4b1e-9b1e-8ac554314d35",
                                "sense_id": "8add23d0-a394-3581-90f3-6067b17db514",
                                "text": "Tous nos autres produits, en calicots, en cretonnes, en percales, en jaconas, en nansouks, subissent tous différents apprêts… on donne plus généralement aux nansouks un apprêt, dit de l'Inde, qui, avec le blanc, coûte 9 centimes le mètre."
                            },
                            {
                                "example_id": "5c99e737-9112-44ce-93ad-379c989824d4",
                                "sense_id": "8add23d0-a394-3581-90f3-6067b17db514",
                                "text": "Jupons en nansouk, grand volant garni de plis."
                            },
                            {
                                "example_id": "6d75c627-c2b6-48a0-8529-3683134e6304",
                                "sense_id": "8add23d0-a394-3581-90f3-6067b17db514",
                                "text": "Des pensionnaires s’alanguissent à leur fenêtre en enlaçant leur amie de passage. L’un d’eux, pour mieux soutenir notre symphonie, tient dans ses mains les deux seins de sa partenaire à peine voilée par son peignoir de nansouk."
                            },
                            {
                                "example_id": "9677b977-e8cc-4bc4-84dd-4c67413bbe63",
                                "sense_id": "8add23d0-a394-3581-90f3-6067b17db514",
                                "text": "En jupon de nansouk blanc, plissé dans le bas, en corset-brassière à bretelles, de coutil blanc, Minne se regarde dans la glace."
                            }
                        ]
                    }
                ],
