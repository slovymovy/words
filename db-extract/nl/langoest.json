                                "target_senses": [
                                    {
                                        "sense_id": "202c5267-3bf7-328f-8c2a-f1b1e36b4fcc",
                                        "entry_id": "63b9558e-2da7-3684-93e6-371401f21eaa",
                                        "glosses": [
                                            "Crustacé décapode, qui vit dans la mer et qui, à la différence du homard, n’a pas de pinces et est pourvu de longues antennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ffa9cee-7f21-4912-9513-1fefc54756a5",
                                                "sense_id": "202c5267-3bf7-328f-8c2a-f1b1e36b4fcc",
                                                "text": "De grosses langoustes dormaient immobiles en abaissant leurs longues cornes sur le sable fin."
                                            },
                                            {
                                                "example_id": "731d284a-7435-4091-aa5f-a93f7e3aeca2",
                                                "sense_id": "202c5267-3bf7-328f-8c2a-f1b1e36b4fcc",
                                                "text": "Quant au petit loup, elle donnait plutôt l'illusion d'une femelle de kanguroo dont on aurait craint, tout le temps, que les gros yeux tombassent dans la mayonnaise de sa langouste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa86f7a-85f2-3293-9261-c6ab88c98431",
                                        "entry_id": "63b9558e-2da7-3684-93e6-371401f21eaa",
                                        "glosses": [
                                            "Ce crustacé cuisiné pour l'alimentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ae96f3a-da86-4ceb-95fb-ad1251ca650c",
                                                "sense_id": "3fa86f7a-85f2-3293-9261-c6ab88c98431",
                                                "text": "Il y eut, chez les plus fortunés de ses amis, le festin, le balthazar, la ripaille, la ribote, la bombance, la grande bouffe avec, en point d'orgue, une langouste sauce thermidor à se lécher tous les doigts de la main."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
