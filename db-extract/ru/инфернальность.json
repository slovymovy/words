                                        "glosses": [
                                            "The quality of being infernal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99dc4632-a7bf-480d-943d-9bdd558a99f3",
                                                "sense_id": "4ff46c3b-b209-34f0-9456-5eb369e04411",
                                                "text": "You associate the Green Mountain State with gourmet ice cream and cows, not swastikas and hate mail, but on second thought it’s possible to conclude that such small town infernality is very Jacksonian."
                                            }
