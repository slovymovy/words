                "senses": [
                    {
                        "sense_id": "fca70978-5061-397d-8571-ea1f52b40cc4",
                        "entry_id": "311908b0-e6b0-32b4-810a-893150bfd003",
                        "glosses": [
                            "small shack"
                        ],
                        "tags": [
                            "Northern-Germany",
                            "derogatory",
                            "feminine",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "9dfdd88d-5ecf-440b-b86c-54a833f45802",
                                "sense_id": "fca70978-5061-397d-8571-ea1f52b40cc4",
                                "text": "Er ist geliefert, weil die Welt der Freiheit und der Demokratie größer ist als seine finstere, verdrossene Butze.",
                                "translation": "He [Putin] is finished, because the world of freedom and democracy is bigger than his dark, pitiful shack.",
                                "english": "He [Putin] is finished, because the world of freedom and democracy is bigger than his dark, pitiful shack."
                            }
                        ]
                    },
                    {
                        "sense_id": "53165f5b-63c3-355c-96d6-a47b024ff704",
                        "entry_id": "311908b0-e6b0-32b4-810a-893150bfd003",
                        "glosses": [
                            "synonym of Alkoven"
                        ],
                        "tags": [
                            "Northern-Germany",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "0d79a317-200c-4f7e-bf1f-8407e25517b2",
                                "sense_id": "53165f5b-63c3-355c-96d6-a47b024ff704",
                                "text": "Als sie am Morgen das Mannszeug anzog, packte die Frau die Mädchenkleider zusammen, machte ein Bündel daraus und sagte: »So, das soll deins sein, meine Tochter! Und das^([sic]) du es nicht vergessen tust: auf Wodshorn ist immer eine Butze und ein Platz am Tische für dich da.«",
                                "translation": "As she put on the male clothes in the morning, the woman packed up the girl's clothes, made a bundle out off it and said: \"So, this should be yours, my daughter! And that you don't forget: at Wodshorn is always an alcove and a place at the table for you.\"",
                                "english": "As she put on the male clothes in the morning, the woman packed up the girl's clothes, made a bundle out off it and said: \"So, this should be yours, my daughter! And that you don't forget: at Wodshorn is always an alcove and a place at the table for you.\""
                            }
                        ]
                    }
