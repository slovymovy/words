                                        "glosses": [
                                            "A mammal of the order Primates, including apes (which include humans), monkeys, lemurs, tarsiers, lorisids, and galagos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38630e7a-4642-4bc6-b40d-c66dfb0113c4",
                                                "sense_id": "d77ab75f-5d52-336c-914c-5f5f93982fa9",
                                                "text": "Primates range from lemurs to gorillas."
                                            }
                                        ]
