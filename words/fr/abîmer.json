                        {
                            "text": "Fais attention avec ces ciseaux, tu risques d'<w>abîmer</w> la table en bois.",
                            "target_lang_translations": {
                                "en": "Be careful with these scissors, or you could <w>damage</w> the wooden table.",
                                "ru": "Осторожнее с этими ножницами, ты можешь <w>испортить</w> деревянный стол.",
                                "nl": "Pas op met die schaar, want je riskeert de houten tafel te <w>beschadigen</w>.",
                                "de": "Pass mit dieser Schere auf, du könntest den Holztisch <w>beschädigen</w>.",
                                "pl": "Uważaj z tymi nożyczkami, bo możesz <w>uszkodzić</w> drewniany stół.",
                                "it": "Fai attenzione con queste forbici, rischi di <w>rovinare</w> il tavolo di legno.",
                                "cs": "Dávej pozor na ty nůžky, jinak <w>poškodíš</w> dřevěný stůl.",
                                "tr": "Bu makasla dikkatli ol, yoksa ahşap masayı <w>bozabilirsin</w>.",
                                "es": "Ten cuidado con estas tijeras, que podrías <w>estropear</w> la mesa de madera.",
                                "zh": "用这把剪刀要小心，你可能会把木桌<w>弄坏</w>。"
                            }
                        },
                        {
                            "text": "La pluie battante a complètement <w>abîmé</w> les fleurs du jardin.",
                            "target_lang_translations": {
                                "en": "The lashing rain has completely <w>damaged</w> the flowers in the garden.",
                                "ru": "Проливной дождь полностью <w>испортил</w> цветы в саду.",
                                "nl": "De striemende regen heeft de bloemen in de tuin volledig <w>beschadigd</w>.",
                                "de": "Der peitschende Regen hat die Blumen im Garten völlig <w>verdorben</w>.",
                                "pl": "Ulewny deszcz całkowicie <w>zepsuł</w> kwiaty w ogrodzie.",
                                "it": "La pioggia battente ha completamente <w>rovinato</w> i fiori del giardino.",
                                "cs": "Prudký liják úplně <w>poškodil</w> květiny na zahradě.",
                                "tr": "Şiddetli yağmur bahçedeki çiçekleri tamamen <w>mahvetti</w>.",
                                "es": "La lluvia torrencial ha <w>estropeado</w> por completo las flores del jardín.",
                                "zh": "狂风暴雨把花园里的花全都<w>弄坏</w>了。"
                            }
                        }
                    ],
