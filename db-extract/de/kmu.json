                                        "entry_id": "c845f8a7-21c0-30da-932e-9ced43c1ba7b",
                                        "glosses": [
                                            "Entreprise petite ou moyenne (dont la taille est supérieure à 10 salariés et inférieure à 250 salariés et dont le chiffre d’affaires annuel n’excède pas 50 millions d’euros)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ccf1d4-9749-4bc8-a5d3-c413b5512b5d",
                                                "sense_id": "2b69861b-4853-3608-87c9-e95cb1064a1c",
                                                "text": "Le \"pacte PME\" [vise] à inciter les administrations et les grands groupes à compter davantage de PME parmi leurs fournisseurs (Le Monde, « Le CEA lance un appel aux PME », 25 avril 2006)."
                                            },
                                            {
                                                "example_id": "b19e2db6-42c3-4d86-b111-1834661bdd98",
                                                "sense_id": "2b69861b-4853-3608-87c9-e95cb1064a1c",
                                                "text": "Les règles de l’UE en matière d’aides d’État permettent aux États membres de prendre des mesures rapides et efficaces pour aider les citoyens et les entreprises (en particulier les PME) qui sont confrontés à des difficultés économiques en raison de l’épidémie de COVID‑19."
                                            }
                                        ]
                                    },
