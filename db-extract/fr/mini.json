            {
                "entry_id": "d7e27f06-e798-34af-9399-cae858de9336",
                "word": "Mini",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1f5d9e37-70be-32e6-b329-b29ea7e368ec",
                        "entry_id": "d7e27f06-e798-34af-9399-cae858de9336",
                        "glosses": [
                            "Nom donné à un modèle de très petite voiture citadine, vendu sous diverses marques : Morris, Austin, Rover, Innocenti, et pour finir sous sa propre marque Mini."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "f745ed11-4814-421c-99a5-b5e467f56adb",
                                "sense_id": "1f5d9e37-70be-32e6-b329-b29ea7e368ec",
                                "text": "Cooper s’intéresse de près à la Mini dont il devine le potentiel. Pour lui, c’est un kart."
                            },
                            {
                                "example_id": "e8edde0d-fcd4-4745-bfe9-e3548e27ee3d",
                                "sense_id": "1f5d9e37-70be-32e6-b329-b29ea7e368ec",
                                "text": "Si vous devez transporter votre chien sur les sièges arrière de la Mini, préférez un Yorkshire, un lévrier afghan serait vraiment à l’étroit."
                            },
                            {
                                "example_id": "a6f45857-6537-4422-99e1-f491e5041bb7",
                                "sense_id": "1f5d9e37-70be-32e6-b329-b29ea7e368ec",
                                "text": "La Mini fête ses 60 ans en août 2019. Née Morris Mini Minor et Austin Baby Seven en 1959, cette micro voiture imaginée du temps de la Crise de Suez devait servir la famille anglaise soumise au rationnement de l’essence."
                            }
                        ]
                    },
                    {
                        "sense_id": "ecb7f4c3-95d3-3487-bf33-9f58c2a48974",
                        "entry_id": "d7e27f06-e798-34af-9399-cae858de9336",
                        "glosses": [
                            "Marque issue du modèle ci-dessus, propriété du groupe BMW."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "139240e0-7bc5-49a8-a2d2-c5bfc1e95be4",
                                "sense_id": "ecb7f4c3-95d3-3487-bf33-9f58c2a48974",
                                "text": "Ucar Mobility va faire son entrée dans les réseaux français de BMW et Mini, en marque blanche, pour proposer des solutions de location courte durée de type Rent."
                            }
                        ]
                    }
                ],
