                                "target_senses": [
                                    {
                                        "sense_id": "26a14375-2514-33ce-bc79-bd28102aff71",
                                        "entry_id": "cd960fb6-8290-32de-9229-b75171441c82",
                                        "glosses": [
                                            "A large, semipermanent mound of windblown sand, held together by specialized plants, common along seashores and in deserts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b2937c-53e5-4907-92f3-b3c964e4604d",
                                                "sense_id": "26a14375-2514-33ce-bc79-bd28102aff71",
                                                "text": "So enfeebled was resolution in him that he could only palter at a fatuous picture of himself carrying Podson bodily over the lagoon and dumping him on the sand dunes."
                                            },
                                            {
                                                "example_id": "fd2fbb40-eac3-43c0-b67b-cf15101cb14f",
                                                "sense_id": "26a14375-2514-33ce-bc79-bd28102aff71",
                                                "text": "An anemometer constructed by the Soil Mechanics Laboratory of the Western Region, British Railways, has been installed at Dawlish Warren, near Exeter, to obtain a record of the velocity (speed and direction) of the wind. This information is used for the study of the effects of wind erosion on the sand dunes which protect the railway from the sea at that point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
