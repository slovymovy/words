                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b6a24e3-4ea8-40e5-ae0d-3ec84e3c3f94",
                                "sense_id": "89a920fa-a92a-333a-8225-4bd455319e08",
                                "text": "Nach dem Gottesdienst wird im Gemeindezentrum ein Vortrag angeboten."
                            },
                            {
                                "example_id": "b3b71b93-9895-407d-9a19-fd4498e547cb",
                                "sense_id": "89a920fa-a92a-333a-8225-4bd455319e08",
                                "text": "Im jüdischen Gemeindezentrum wird zum interreligiösen Dialog eingeladen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
