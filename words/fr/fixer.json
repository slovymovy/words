                        "fixer un rendez-vous",
                        "fixer un prix",
                        "fixer des objectifs"
                    ]
                },
                {
                    "sense_id": "96e9275b-2563-3962-a1cd-14832e3a96cc",
                    "sense_definition": "Regarder ou observer attentivement et longuement sans détourner les yeux.",
