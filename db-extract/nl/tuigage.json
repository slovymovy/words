                        "glosses": [
                            "het geheel van masten, bomen, zeilen en touwwerk van moderne zeilschepen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6063de62-40d5-44e1-af99-44a3cd2d7a63",
                                "sense_id": "a5121851-29e7-36e1-943e-53291113d445",
                                "text": "De masten en hun verstaging, de takelage, werden vroeger niet tot de tuigage gerekend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e9073bb-e7ec-4b1c-9e1a-2b4aab5c09f0",
                        "source_entry_id": "7cecf674-7cc4-3700-82ba-72aeacb400f0",
                        "source_sense_id": "a5121851-29e7-36e1-943e-53291113d445",
                        "source_sense_description": "het geheel van masten, bomen, zeilen en touwwerk van moderne zeilschepen",
                        "target_lang_word": "Takelage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Takelage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b97a2a4-6342-338c-8387-07bfa53e76cf",
                                        "entry_id": "75f57904-f352-3260-b10e-fbdeb5f37679",
                                        "glosses": [
                                            "die gesamte Segeleinrichtung eines Schiffes, bestehend aus Masten, Segeln und Tauwerk"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eced7f1-774b-4d3e-a8d4-a733ec176fb6",
                                                "sense_id": "0b97a2a4-6342-338c-8387-07bfa53e76cf",
                                                "text": "„Stenge nennt man den festen, aus Metallrohr oder früher auch aus Massivholz bestehenden, Teil der Takelage auf einem Segelschiff oder Segelboot, der die Verlängerung des Mastes oberhalb der ersten Saling bildet.“"
                                            },
                                            {
                                                "example_id": "29c5f8af-7a65-43b8-bef4-12b97ef7cbeb",
                                                "sense_id": "0b97a2a4-6342-338c-8387-07bfa53e76cf",
                                                "text": "„Er jagte die Mannschaft in die Takelage, befahl Segel zu setzen, in den Wind zu drehen und die auffrischende Brise auszunutzen.“"
                                            },
                                            {
                                                "example_id": "4fd2811c-d630-4655-96e8-792f2c54e239",
                                                "sense_id": "0b97a2a4-6342-338c-8387-07bfa53e76cf",
                                                "text": "„Bald begann ich die Takelage der Brigg aufzuentern und zu den Masttopps aufzusteigen.“"
                                            },
                                            {
                                                "example_id": "fd43661f-34f5-4f42-8f0d-b48e10daa850",
                                                "sense_id": "0b97a2a4-6342-338c-8387-07bfa53e76cf",
                                                "text": "„Bald war die Takelage komplett, lange vor dem Schiff selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df5cd98b-0763-49d9-9897-9d73d8137ca4",
                        "source_entry_id": "7cecf674-7cc4-3700-82ba-72aeacb400f0",
