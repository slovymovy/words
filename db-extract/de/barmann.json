                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                        "entry_id": "656e66f4-77df-35b5-8f79-4f674d04d7e9",
                        "glosses": [
                            "männliche Person, die an einer Bar arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a6265c6-285d-4f58-b570-cfcf64e899c9",
                                "sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                                "text": "Der Student arbeitet am Wochenende als Barmann und verdient sich so ein paar Euro dazu."
                            },
                            {
                                "example_id": "7f425545-831f-4ac1-bbd2-97a6e397ee41",
                                "sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                                "text": "„Der Barmann goss ihm einen Doppelten ein. Er schüttete ihn rein. Der Barmann füllte nach. Er schüttete ihn rein. Der Barmann füllte nach. Er schüttete ihn rein und ließ einen Zwanziger auf die Bar fallen.“"
                            },
                            {
                                "example_id": "4cb45cad-e5a9-4f83-8355-c61954ddf943",
                                "sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                                "text": "„Während wir reden, geht Deans Blick immer wieder an mir vorbei zur Kellnerin, die ab und zu ein paar knappe Bemerkungen mit dem Barmann wechselt und manchmal resigniert aufseufzt.“"
                            },
                            {
                                "example_id": "c0a42b5d-9727-4a65-823e-3f1f7f4b7415",
                                "sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                                "text": "„Ich trank aus, beorderte den Barmann zu mir und bestellte nochmal dasselbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b35635ed-182b-4628-b9d7-8c0a98935627",
                        "source_entry_id": "656e66f4-77df-35b5-8f79-4f674d04d7e9",
                        "source_sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                        "source_sense_description": "männliche Person, die an einer Bar arbeitet",
                        "target_lang_word": "barman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dfd7025-f859-37d2-98e5-9ca54b667cf7",
                                        "entry_id": "e5d5f035-0e6e-301e-ab03-4cae7774a8d4",
                                        "glosses": [
                                            "A man who works in a bar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c0261f5-9124-44f2-96a0-ed93eb4a996d",
                                                "sense_id": "1dfd7025-f859-37d2-98e5-9ca54b667cf7",
                                                "text": "NOT so long ago there was a beer commercial on British TV in which two pointy-headed aliens order a pint in a rural pub. “Up from London, are we?” the barman asks politely."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfb0d47d-c769-45a5-bad8-c17686f5a122",
                        "source_entry_id": "656e66f4-77df-35b5-8f79-4f674d04d7e9",
                        "source_sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                        "source_sense_description": "männliche Person, die an einer Bar arbeitet",
                        "target_lang_word": "bartender",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bartender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9ba9d89-17df-35e7-9dc9-e2a58527e42d",
                                        "entry_id": "837d51fb-8e81-3b96-b4e6-a090afd72d01",
                                        "glosses": [
                                            "One who tends a bar or pub; a person preparing and serving drinks at a bar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c483b9c0-63a4-4fad-ad35-2361cb4fad12",
                                                "sense_id": "f9ba9d89-17df-35e7-9dc9-e2a58527e42d",
                                                "text": "He observed as the sad bartender ritually played canasta with two bored and customerless dancers..."
                                            },
                                            {
                                                "example_id": "360b6a90-4746-43c5-bf43-c4cdcde13b49",
                                                "sense_id": "f9ba9d89-17df-35e7-9dc9-e2a58527e42d",
                                                "text": "They weren't all just sexpats and drifters and former disgraced officers or old bartenders, none of which he should have mentioned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56e7821e-ef2f-4376-a42c-4d1df1c681e1",
                        "source_entry_id": "656e66f4-77df-35b5-8f79-4f674d04d7e9",
                        "source_sense_id": "c9eacd24-e892-3060-a5db-17491b1d88b0",
                        "source_sense_description": "männliche Person, die an einer Bar arbeitet",
                        "target_lang_word": "barman",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barman",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6227b26c-fc31-39cb-a340-7b17745097c9",
                                        "entry_id": "559ff839-fc1b-3fcf-b040-b55b6815b1d2",
                                        "glosses": [
                                            "Serveur dans un bar, garçon de bar."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52b79372-20f3-4eb1-9bc0-66696cb8ae6d",
                                                "sense_id": "6227b26c-fc31-39cb-a340-7b17745097c9",
                                                "text": "Par le petit téléphone intérieur, M. de Cérésolles appela le barman, celui-ci prit la commande, reposa le récepteur, et commença de préparer le whiskey."
                                            },
                                            {
                                                "example_id": "b9d52b75-5ebc-4031-8c36-772fe4880685",
                                                "sense_id": "6227b26c-fc31-39cb-a340-7b17745097c9",
                                                "text": "Il grognait. Et quand il sonna à la porte de verre et de fer forgé des Dossin il retrouva toute sa hargne pour toiser le maître d’hôtel en veste blanche de barman qui voulait lui retirer son vêtement."
                                            },
                                            {
                                                "example_id": "adef4d31-816c-448d-bde4-3cf681055aeb",
                                                "sense_id": "6227b26c-fc31-39cb-a340-7b17745097c9",
                                                "text": "Le barman lui ayant annoncé qu’il ne servait rien avant que le Queen Mary levât l’ancre, il allait retourner dans sa cabine pour échapper au hourvari des coursives, quand un grand Américain dans la cinquantaine, le visage couperosé, les cheveux blancs, les sourcils très fournis d’un noir d’encre, en costume de tussor beige froissé, vint s’asseoir sur le tabouret voisin et commanda un dry Martini."
                                            },
                                            {
                                                "example_id": "11798907-88cd-4306-b6c1-fcfd25837232",
                                                "sense_id": "6227b26c-fc31-39cb-a340-7b17745097c9",
