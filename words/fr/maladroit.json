        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b58ec17-025a-3fef-a96c-9c9ecf3d0c0c",
                    "sense_definition": "Personne qui manque d'adresse ou de savoir-faire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand <w>maladroit</w> a laissé échapper l'assiette qui s'est brisée sur le carrelage.",
                            "target_lang_translations": {
                                "en": "That big <w>klutz</w> let the plate slip, and it smashed on the tiled floor.",
                                "ru": "Этот большой <w>недотёпа</w> выронил тарелку, и она разбилась о кафельный пол.",
                                "de": "Dieser große <w>Tollpatsch</w> hat den Teller fallen lassen, der dann auf den Fliesen zerbrach.",
                                "es": "Este grandullón <w>torpe</w> dejó caer el plato, que se hizo añicos sobre las baldosas.",
                                "zh": "这个高大的<w>笨手笨脚的人</w>没拿稳盘子，盘子摔在瓷砖地上碎了。"
                            }
                        },
                        {
                            "text": "Le pauvre <w>maladroit</w> a encore heurté le meuble du salon en marchant dans le noir.",
                            "target_lang_translations": {
                                "en": "The poor <w>klutz</w> bumped into the living room furniture again as he walked in the dark.",
                                "ru": "Бедный <w>недотёпа</w> снова налетел на мебель в гостиной, пробираясь в темноте.",
                                "de": "Der arme <w>Tollpatsch</w> ist im Dunkeln beim Gehen wieder gegen das Wohnzimmermöbel gestoßen.",
                                "es": "El pobre <w>torpe</w> volvió a chocar con el mueble del salón al caminar a oscuras.",
                                "zh": "这个可怜的<w>笨手笨脚的人</w>在黑暗里走路，又撞到了客厅的家具。"
                            }
                        }
                    ],
                    "synonyms": [
                        "empoté",
                        "gaffeur"
                    ],
                    "common_phrases": [
                        "grand maladroit"
                    ],
                    "target_lang_definitions": {
                        "en": "Person who lacks skill or know-how.",
                        "ru": "Человек, не обладающий сноровкой или умением в делах.",
                        "de": "Person, der es an Geschick oder praktischem Können fehlt.",
                        "es": "Persona que carece de destreza o de habilidad práctica.",
                        "zh": "指缺乏技能或本领的人。"
                    },
