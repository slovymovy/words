                                        "entry_id": "4a16de64-9d27-3d91-af62-f56cf78d1988",
                                        "glosses": [
                                            "A mechanism powered by a coiled spring and regulated by some form of escapement; the power is transmitted through toothed gearwheels and used to drive a mechanical clock, toy, or other device."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36f1c75d-3588-44a6-a853-d27a141b1ddc",
                                                "sense_id": "7e9a2dd4-8574-31ee-ba5e-bd3b6be34ff3",
                                                "text": "Many contrivances for making model horses move up and down as on roundabouts were patented in 1887, and toy horses pulling toy carts were made to imitate galloping by means of clockwork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52fae208-ec2a-32d8-875c-ef48ead82693",
                                        "entry_id": "4a16de64-9d27-3d91-af62-f56cf78d1988",
                                        "glosses": [
                                            "The action of behaving mechanically in the manner of a clock."
                                        ],
                                        "tags": [
