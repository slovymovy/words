                "translations": [
                    {
                        "translation_id": "bcfc45d8-cf1a-4d21-a11f-054eed4ae164",
                        "source_entry_id": "e6fb2176-f0e9-3ae8-aec5-de210f536a10",
                        "target_lang_word": "despotism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despotism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e00ae285-c115-32fd-a5ee-58da4f67efdd",
                                        "entry_id": "311c7ee9-321a-3f56-a3f8-65fd84b13b42",
                                        "glosses": [
                                            "Government by a despot or despots: rule by a singular authority, either a single person or a tight-knit group, which rules with absolute power, especially in a cruel and oppressive way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa476a69-731c-4347-9eb5-a8b3c467e073",
                                                "sense_id": "e00ae285-c115-32fd-a5ee-58da4f67efdd",
                                                "text": "The iron hand of despotism has quenched the last spark of liberty; hunted down like a wild beast, I am watching an opportunity to fly my degraded and enslaved country."
                                            },
                                            {
                                                "example_id": "645f6371-385e-47ad-94e4-23b358c91ca2",
                                                "sense_id": "e00ae285-c115-32fd-a5ee-58da4f67efdd",
                                                "text": "But now events have proved that I was right because Khrushchev's grandchildren do live in freedom and the great question of our time: can they continue to live in freedom, or will they revert to the old, or a new despotism?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
