                    {
                        "translation_id": "44edd55a-6768-48e7-b69b-2cf7f4297e40",
                        "source_entry_id": "dc214804-c156-3bd1-8db8-6fa0c9107143",
                        "target_lang_word": "amazingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
