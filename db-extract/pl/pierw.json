                "translations": [
                    {
                        "translation_id": "ae8c1b74-e4dd-409a-a9b6-3096cfc4159f",
                        "source_entry_id": "87fe6937-13ee-32dd-8d47-c0b64e419cb0",
                        "source_sense_id": "735611f3-38c0-32ea-96a5-f50c28b30370",
                        "target_lang_word": "first",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "first",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f402fa42-e51d-379e-be20-43fdfd7bc08d",
                                        "entry_id": "ce1c661a-117e-3e35-b516-24e6fb6018ff",
                                        "glosses": [
                                            "Preceding all others of a series or kind; the ordinal of one; earliest."
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a202a785-fc7f-4b3b-8d90-6d04add5cf6b",
                                                "sense_id": "f402fa42-e51d-379e-be20-43fdfd7bc08d",
                                                "text": "Hancock was first to arrive."
                                            },
                                            {
                                                "example_id": "7376a6bc-d53d-4d29-8b8b-679caaddbc47",
                                                "sense_id": "f402fa42-e51d-379e-be20-43fdfd7bc08d",
                                                "text": "The first day of September 2013 was a Sunday."
                                            },
                                            {
                                                "example_id": "ae7a7380-ae80-4773-8834-3a0eadfaa89d",
                                                "sense_id": "f402fa42-e51d-379e-be20-43fdfd7bc08d",
                                                "text": "I was the first runner to reach the finish line, and won the race."
                                            },
                                            {
                                                "example_id": "a4a901e6-4802-4ceb-95f0-b1d905357149",
                                                "sense_id": "f402fa42-e51d-379e-be20-43fdfd7bc08d",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke. He was dressed out in broad gaiters and bright tweeds, like an English tourist, and his face might have belonged to Dagon, idol of the Philistines."
                                            },
                                            {
                                                "example_id": "69ad19c9-8fae-4610-8d11-6bc16e4d3091",
                                                "sense_id": "f402fa42-e51d-379e-be20-43fdfd7bc08d",
                                                "text": "The dawn of the oil age was fairly recent. Although the stuff was used to waterproof boats in the Middle East 6,000 years ago, extracting it in earnest began only in 1859 after an oil strike in Pennsylvania. The first barrels of crude fetched $18 (around $450 at today’s prices)."
                                            },
                                            {
                                                "example_id": "b162c4d1-c819-46cc-a6a6-3439b88bcb5c",
                                                "sense_id": "f402fa42-e51d-379e-be20-43fdfd7bc08d",
                                                "text": "Consequently, in the initial position the white pieces and pawns are placed on the first and second ranks; the black pieces and pawns on the eighth and seventh ranks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3056504c-9767-3305-b149-c563d9e44b5f",
                                        "entry_id": "ce1c661a-117e-3e35-b516-24e6fb6018ff",
                                        "glosses": [
                                            "Most eminent or exalted; most excellent; chief; highest."
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8965d70f-3ec3-443f-8d9e-81dafdf34e64",
                                                "sense_id": "3056504c-9767-3305-b149-c563d9e44b5f",
                                                "text": "Demosthenes was the first orator of Greece."
                                            },
                                            {
                                                "example_id": "42ae2d6a-914e-4754-b128-a048ac9bd013",
                                                "sense_id": "3056504c-9767-3305-b149-c563d9e44b5f",
                                                "text": "the first violinist"
                                            },
                                            {
                                                "example_id": "28bbe6a3-0e17-4b25-a22f-e1dc29a17fb2",
                                                "sense_id": "3056504c-9767-3305-b149-c563d9e44b5f",
                                                "text": "1784: William Jones, The Description and Use of a New Portable Orrery, &c., PREFACE\nTHE favourable reception the Orrery has met with from Perſons of the firſt diſtinction, and from Gentlemen and Ladies in general, has induced me to add to it ſeveral new improvements in order to give it a degree of Perfection; and diſtinguiſh it from others; which by Piracy, or Imitation, may be introduced to the Public."
                                            },
                                            {
                                                "example_id": "7a61018b-3470-4823-a682-e5b2bbab0395",
                                                "sense_id": "3056504c-9767-3305-b149-c563d9e44b5f",
                                                "text": "It rose to be the first of pastoral regions, and continued until after the gold discovery to be the land of squatterdom."
                                            },
                                            {
                                                "example_id": "4169f705-c85f-4321-b4c9-3b4ac9ff95a8",
                                                "sense_id": "3056504c-9767-3305-b149-c563d9e44b5f",
                                                "text": "The French openings decided that satin gowns, suits, wraps and even hats were to be in first fashion this autumn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b22ab973-71be-3c98-8ae7-b3b25eb7a272",
                                        "entry_id": "ce1c661a-117e-3e35-b516-24e6fb6018ff",
                                        "glosses": [
                                            "Of or belonging to a first family."
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "255f27a3-3dcf-45fb-bd78-5a4a1106edb5",
                                                "sense_id": "b22ab973-71be-3c98-8ae7-b3b25eb7a272",
                                                "text": "First Cat; First Daughter; First Dog; First Son"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d00d6cd-96da-3f4f-92de-48367df6af4d",
                                        "entry_id": "ce1c661a-117e-3e35-b516-24e6fb6018ff",
                                        "glosses": [
                                            "Coming right after the zeroth in things that use zero-based numbering."
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "first",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0b6c71a-4280-3e5a-8552-2d9f7e3759ec",
                                        "entry_id": "2eb25427-e6ae-3622-9fa8-94103fb57ee6",
                                        "glosses": [
                                            "Before anything else; firstly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e5c8c56-eea7-4f44-b9c4-64595ebefcbe",
                                                "sense_id": "c0b6c71a-4280-3e5a-8552-2d9f7e3759ec",
                                                "text": "Clean the sink first, before you even think of starting to cook."
                                            },
                                            {
                                                "example_id": "add22939-cfca-441d-9c6d-170ef1a2804c",
                                                "sense_id": "c0b6c71a-4280-3e5a-8552-2d9f7e3759ec",
                                                "text": "I plunged nose first into the water."
                                            },
                                            {
                                                "example_id": "9e95758f-bf41-41ce-885f-3745afd7ba3c",
                                                "sense_id": "c0b6c71a-4280-3e5a-8552-2d9f7e3759ec",
                                                "text": "That concertina was a wonder in its way. The handles that was on it first was wore out long ago, and he'd made new ones of braided rope yarn. And the bellows was patched in more places than a cranberry picker's overalls."
                                            },
                                            {
                                                "example_id": "7260595b-0393-48d5-aa72-4f05c069162f",
                                                "sense_id": "c0b6c71a-4280-3e5a-8552-2d9f7e3759ec",
                                                "text": "Since the mid-1980s, when Indonesia first began to clear its bountiful forests on an industrial scale in favour of lucrative palm-oil plantations, “haze” has become an almost annual occurrence in South-East Asia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24abe2c7-0fb4-30f0-99f2-f60fb00fac5b",
                                        "entry_id": "2eb25427-e6ae-3622-9fa8-94103fb57ee6",
                                        "glosses": [
                                            "For the first time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "578ed87c-5292-4fdf-a9e6-6eed6916b8ad",
                                                "sense_id": "24abe2c7-0fb4-30f0-99f2-f60fb00fac5b",
                                                "text": "I first witnessed a death when I was nine years old."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa752f04-d7da-3826-9ba4-3cc988ae0d2a",
                                        "entry_id": "2eb25427-e6ae-3622-9fa8-94103fb57ee6",
                                        "glosses": [
                                            "Now."
                                        ],
                                        "tags": [
                                            "Hong-Kong",
                                            "nonstandard",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "first",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dca3b242-6a9f-3d92-9d3e-8e98c033d127",
                                        "entry_id": "147af709-8dab-3f61-84f3-81f0465a35a2",
                                        "glosses": [
                                            "The person or thing in the first position."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "695e8c20-4f2c-42d3-90a7-ea38bbecf1dc",
                                                "sense_id": "dca3b242-6a9f-3d92-9d3e-8e98c033d127",
                                                "text": "He was the first to complete the course."
                                            },
                                            {
                                                "example_id": "4a55f721-4f47-4cc9-9201-0843d1c8ca0c",
                                                "sense_id": "dca3b242-6a9f-3d92-9d3e-8e98c033d127",
                                                "text": "Study gives strength to the mind; conversation, grace: the first apt to give stiffness, the other suppleness: one gives substance and form to the statue, the other polishes it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efe4d08a-aeec-3660-a09c-fc89b2064560",
                                        "entry_id": "147af709-8dab-3f61-84f3-81f0465a35a2",
                                        "glosses": [
                                            "The first gear of an engine."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b107d76-5aec-3eac-945e-6d3f8485c0a6",
                                        "entry_id": "147af709-8dab-3f61-84f3-81f0465a35a2",
                                        "glosses": [
                                            "Something that has never happened before; a new occurrence."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cacc92c6-3111-4bcc-9916-f86683cfcd5c",
                                                "sense_id": "2b107d76-5aec-3eac-945e-6d3f8485c0a6",
                                                "text": "This is a first. For once he has nothing to say."
                                            },
                                            {
                                                "example_id": "36ad92d0-3a92-4b7a-b743-4cb9423148d3",
                                                "sense_id": "2b107d76-5aec-3eac-945e-6d3f8485c0a6",
                                                "text": "I remember other firsts: how I wussily asked her out the first time, and the first time I told her I loved her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "590f4b75-84b8-3c18-8ae0-a17fddd1dc39",
                                        "entry_id": "147af709-8dab-3f61-84f3-81f0465a35a2",
                                        "glosses": [
                                            "First base."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53d89595-1c80-4f68-a100-e888ad6fce8c",
                                                "sense_id": "590f4b75-84b8-3c18-8ae0-a17fddd1dc39",
                                                "text": "There was a close play at first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7bfbb0e-a23d-387e-82c1-9a41ac81eed0",
                                        "entry_id": "147af709-8dab-3f61-84f3-81f0465a35a2",
                                        "glosses": [
                                            "A first-class honours degree."
                                        ],
                                        "tags": [
                                            "British",
                                            "colloquial",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52d1d946-f934-4293-9383-85c23ba0ccf7",
                                                "sense_id": "c7bfbb0e-a23d-387e-82c1-9a41ac81eed0",
                                                "text": "[Stephen Hawking] […] would go to Cambridge, he said, if they gave him a first, and stay at Oxford if they gave him a second. He got a first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7a80916-5172-3286-a17f-208c2a29a5b8",
                                        "entry_id": "147af709-8dab-3f61-84f3-81f0465a35a2",
                                        "glosses": [
                                            "A first-edition copy of some publication."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "543a194e-4d9d-308d-aff4-4e2e46f24824",
                                        "entry_id": "147af709-8dab-3f61-84f3-81f0465a35a2",
                                        "glosses": [
