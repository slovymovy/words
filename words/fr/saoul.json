                    "frequency": "Middle",
                    "semantic_group_id": "ivresse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir bu plusieurs verres à la fête, il est rentré complètement <w>saoul</w> chez lui."
                        },
                        {
                            "text": "Il refuse de conduire ce soir parce qu'il a bu et qu'il est déjà <w>saoul</w>."
                        }
                    ],
                    "synonyms": [
                        "ivre",
                        "bourré",
                        "beurré"
                    ],
                    "antonyms": [
