                    {
                        "translation_id": "b761cb41-6c1b-41e6-b8df-f62b3f4020d6",
                        "source_entry_id": "44aacdb8-fe04-33dc-b32c-fcf0eb789dd2",
                        "source_sense_id": "32080a82-e042-3acc-b867-a8175cf08eaa",
                        "source_sense_description": "Vermittler von Immobilien zum Kauf oder zur Miete",
                        "target_lang_word": "real estate agent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "real estate agent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae222172-5de7-3325-b1ff-0e28b51f95eb",
                                        "entry_id": "0af73339-4f45-36fd-b340-de23f266415b",
                                        "glosses": [
                                            "An individual or company that acts in the sale, lease or maintenance of land, property, real estate, etc. for another."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
