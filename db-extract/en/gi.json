                        "examples": [
                            {
                                "example_id": "7aa608ee-51ba-49ac-9b47-b763e1f73613",
                                "sense_id": "ade853ff-eb57-3aeb-91a3-6e5e0bb44b04",
                                "text": "By the time they got up to the reception building, there was a welcoming committee standing in the lamp-lined drive, all in black gi, headed by a tall, fit, scholarly-looking woman named Sister Rochelle […]"
                            },
                            {
                                "example_id": "a48de5f0-bd14-4eb4-a402-5cc0a89e7643",
                                "sense_id": "ade853ff-eb57-3aeb-91a3-6e5e0bb44b04",
                                "text": "Attenders watched the Mad Max: Fury Road star, dressed in a blue gi, subdue his opponents and win all his matches. Hardy’s certificate of achievement was awarded to “Edward Hardy” – the actor’s real name."
                            }
                        ]
                    }
                ],
