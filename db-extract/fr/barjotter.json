                ],
                "senses": [
                    {
                        "sense_id": "ed05180b-e8f7-3826-97bd-cc5e003892e8",
                        "entry_id": "f52e3a74-4c36-36a1-8a75-946ef6b92998",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de barjoter (perdre la tête, avoir une idée fixe)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d31be26-de30-4b8d-9495-4644bfa61cd3",
                                "sense_id": "ed05180b-e8f7-3826-97bd-cc5e003892e8",
                                "text": "Ecoutez, je ne sais pas qui barjotte le plus — la police ou les journaux."
                            },
                            {
                                "example_id": "dbb34e2d-5ccd-4acb-a6dd-a30c49abaf81",
                                "sense_id": "ed05180b-e8f7-3826-97bd-cc5e003892e8",
                                "text": "Il barjotte, Raphaël. Il n’arrive pas à décoller du rôle de grand frère, et il interprète tout comme avec des œillères."
                            },
                            {
                                "example_id": "11e856ed-feb5-4023-810d-4c2c25a28cde",
                                "sense_id": "ed05180b-e8f7-3826-97bd-cc5e003892e8",
                                "text": "Moi je me traîne au long de la journée, comme un petit vieux, je dors dès que je peux pour écourter le temps, et parfois je pianote sur les mots ou je barjotte sur des projets, construire un avenir hors hiérarchie, un travail étique, pas forcément grandiose."
                            }
                        ]
                    }
                ],
