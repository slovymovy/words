                "senses": [
                    {
                        "sense_id": "585dad66-d8f7-3713-8383-9d04335f5e73",
                        "entry_id": "352b3ff9-4652-3f67-b6f5-bdd275463462",
                        "glosses": [
                            "brennbares Gas, das Wasserstoff und Kohlenmonoxid (H₂/CO) enthält und für chemische Synthesen (Synthesereaktion) verwendet werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbb565c6-d748-4883-8850-25bc81771c1f",
                                "sense_id": "585dad66-d8f7-3713-8383-9d04335f5e73",
                                "text": "„Der klassische Weg der Herstellung von Synthesegas (auch Syngas genannt) ist die Vergasung von Kohle unter Zugabe von Wasserdampf und Sauerstoff.“"
                            },
                            {
                                "example_id": "70b405e7-88f5-44e4-a841-44301dac892f",
                                "sense_id": "585dad66-d8f7-3713-8383-9d04335f5e73",
                                "text": "„Bis Anfang der 50er Jahre wurde Synthesegas fast ausschließlich durch Vergasung von Steinkohlenkoks oder Braunkohlenschwelkoks hergestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
