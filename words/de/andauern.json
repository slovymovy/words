                    "sense_definition": "über einen bestimmten Zeitraum hinweg kontinuierlich bestehen bleiben oder sich zeitlich weiter fortführen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zeitlicher Verlauf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niemand weiß genau, wie lange die aktuellen Bauarbeiten noch <w>andauern</w> werden.",
                            "target_lang_translations": {
                                "en": "Nobody knows exactly how long the current construction work will <w>continue</w>."
                            }
                        },
                        {
                            "text": "Der starke Regen <w>dauerte</w> fast die gesamte Nacht über <w>an</w>.",
                            "target_lang_translations": {
                                "en": "The heavy rain <w>lasted</w> almost the entire night."
                            }
                        }
                    ],
                    "synonyms": [
                        "anhalten",
                        "fortdauern",
                        "weitergehen"
                    ],
                    "antonyms": [
                        "aufhören",
                        "stoppen"
                    ],
                    "common_phrases": [
                        "noch lange andauern",
                        "weiter andauern"
                    ],
                    "target_lang_definitions": {
                        "en": "to persist or keep going continuously over a certain period of time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "continue",
                                "target_lang_sense_clarification": "to keep happening or ongoing"
                            },
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "to continue in time"
                            },
                            {
                                "target_lang_word": "persist",
                                "target_lang_sense_clarification": "to continue to exist, especially weather or difficulties"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d47a3a1-d713-324e-a7bb-a0460e3c7505",
                    "sense_definition": "das zeitliche Fortbestehen; Substantivierung des Verbs <w>andauern</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zeitlicher Verlauf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das lange <w>Andauern</w> der Krise bereitet den Verantwortlichen große Sorgen.",
                            "target_lang_translations": {
                                "en": "The long <w>continuation</w> of the crisis causes great concern for those in charge."
                            }
                        },
                        {
                            "text": "Trotz des weiteren <w>Andauerns</w> der Proteste blieb die Lage in der Stadt friedlich.",
                            "target_lang_translations": {
