                    },
                    {
                        "translation_id": "5f1248b6-3d8b-47e9-80fc-52c9f9218589",
                        "source_entry_id": "180ab509-96f3-331f-928f-c91a319d7dae",
                        "source_sense_id": "69054de7-c8a3-3229-804a-61f2f1a52dc8",
                        "target_lang_word": "eschar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eschar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e3a10ec-ed09-378f-8360-772f59117c5b",
                                        "entry_id": "e0f22f66-dd2e-36b5-81f8-884e4d462006",
                                        "glosses": [
                                            "A superficial structure of dead tissue, usually hardened, commonly, but not necessarily dark, adhering to underlying living or necrotic tissue, caused by gangrene or a burn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b27fd99e-1f9d-4858-8d0f-6c06baae1b75",
                                                "sense_id": "8e3a10ec-ed09-378f-8360-772f59117c5b",
                                                "text": "...stable intact eschar on the heels should not be removed. Blood flow in the tissue under the eschar is poor and the wound is susceptible to infection. The eschar acts as a natural barrier to infection by keeping the bacteria from entering the wound. If the eschar becomes unstable (wet, draining, loose, boggy, edematous, red) it should be debrided according to the clinic or facility protocol"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f3835bc-242c-388d-b5e5-b274376993c1",
                                        "entry_id": "e0f22f66-dd2e-36b5-81f8-884e4d462006",
                                        "glosses": [
                                            "Any hard, dark, commonly flattened or sunken lesion or crust, especially on a burn, abscess, infection, wound; commonly a coagulation of blood or exudations, not necessarily involving dead or necrotic tissue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8002e5bb-2bd1-490a-b543-752f5d2272e5",
                                                "sense_id": "1f3835bc-242c-388d-b5e5-b274376993c1",
                                                "text": "When the caustic is removed, the eschar should be punctured for the discharge of the matter, and then dressed with warm emollient poultices..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e9f6027-da88-306d-8571-0307cab2f467",
                                        "entry_id": "e0f22f66-dd2e-36b5-81f8-884e4d462006",
                                        "glosses": [
                                            "The emotional imprint of a trauma such as grief, loss, or degradation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "literary",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4702b46e-7bec-46c5-9d17-49955bae9bf9",
                                                "sense_id": "0e9f6027-da88-306d-8571-0307cab2f467",
                                                "text": "In another minute there was no letter; but, as with every other relationship in my life, an eschar of ashes. The word is rare, but exact."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e80cf43f-8e57-4fd4-a36d-cae4c75f4186",
                        "source_entry_id": "180ab509-96f3-331f-928f-c91a319d7dae",
                        "source_sense_id": "69054de7-c8a3-3229-804a-61f2f1a52dc8",
                        "target_lang_word": "os",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "os",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc5e37bd-f7a5-3514-852a-170289629c14",
                                        "entry_id": "1ee2b7fd-b9cf-3de2-8368-64cb840248b8",
                                        "glosses": [
                                            "Synonym of bone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8261bcfd-523b-4f62-85a3-71c1f9233ba6",
                                                "sense_id": "bc5e37bd-f7a5-3514-852a-170289629c14",
                                                "text": "I was once, I remember, called to a Patient, who had received a violent Contuſion in his Tibia, by which the exterior Cutis was lacerated, ſo that there was a profuſe ſanguinary Diſcharge; and the interior Membranes were ſo divellicated, that the Os or Bone very plainly appeared through the Aperture of the Vulnus or Wound."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "os",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c9c1aea-7aea-3ca9-9dc3-efa78c69ab59",
                                        "entry_id": "c830fda0-ac37-33f5-969a-3906340b3b3e",
                                        "glosses": [
                                            "An opening or entrance to a passage, particularly one at either end of the cervix, internal (to the uterus) or external (to the vagina)."
                                        ],
                                        "tags": [
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "427cb965-a64e-46e2-b5b6-8037af99cb45",
                                                "sense_id": "8c9c1aea-7aea-3ca9-9dc3-efa78c69ab59",
                                                "text": "The instrument closed, as seen in Fig. 1, is then passed along the finger to the os, in and through the cervix up to the fundus of the uterus, which may be determined both by the distance and the resistance to the broad rounded head of the Capiat."
                                            },
                                            {
                                                "example_id": "a0dec3ac-56b1-413c-84bb-cf439d4c412b",
                                                "sense_id": "8c9c1aea-7aea-3ca9-9dc3-efa78c69ab59",
                                                "text": "[…] monocolpate (“unisulcate”) pollen grains still have a continuous aperture membrane devoid of special openings (ora) in the exine for the emergence of the pollen tube."
                                            }
                                        ]
                                    }
                                ]
