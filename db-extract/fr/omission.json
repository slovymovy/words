        "fr-extract.jsonl": [
            {
                "entry_id": "39465463-abd8-3916-b366-172eeeb926c7",
                "word": "omission",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7029724b-9655-48fa-b52a-f8b9b7bea46f",
                        "entry_id": "39465463-abd8-3916-b366-172eeeb926c7",
                        "tags": [
                            "plural"
                        ],
                        "form": "omissions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "88aab57d-ef15-3a52-b456-121d1ea2417e",
                        "entry_id": "39465463-abd8-3916-b366-172eeeb926c7",
                        "glosses": [
                            "Action d’omettre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acde6011-5a96-4ec4-a752-f8fc85090cf0",
                                "sense_id": "88aab57d-ef15-3a52-b456-121d1ea2417e",
                                "text": "Faire une omission, une omission volontaire et coupable."
                            },
                            {
                                "example_id": "06df47d7-23c6-42a1-a928-f4a1ec1f03c6",
                                "sense_id": "88aab57d-ef15-3a52-b456-121d1ea2417e",
                                "text": "C’est une omission grave."
                            },
                            {
                                "example_id": "4bd0fb12-56a9-46cd-b91b-0ca1d5a68068",
                                "sense_id": "88aab57d-ef15-3a52-b456-121d1ea2417e",
                                "text": "Sauf erreur ou omission."
                            },
                            {
                                "example_id": "0021d2d0-2b08-40bc-a126-6cabb4d5d5ab",
                                "sense_id": "88aab57d-ef15-3a52-b456-121d1ea2417e",
                                "text": "Mentir par omission."
                            },
                            {
                                "example_id": "3bea156b-5155-466d-ad6d-2b17f86e2f6d",
                                "sense_id": "88aab57d-ef15-3a52-b456-121d1ea2417e",
                                "text": "S’ils refusent publiquement (et je vois d’ici, je palpe d’ici, je mesure d’ici le monceau ordonné de leurs belles raisons, de leurs nobles raisons de refuser la marche parmi nous), alors le moindre adolescent comprendra qu’ils ont en vérité choisi, qu’ils préfèrent réellement —et non par erreur, et non par omission, et non par aveuglement guérissable— leur confort spirituel, et les garanties temporelles de leur confort, aux questions bassement humaines."
                            }
                        ]
                    },
                    {
                        "sense_id": "75e2d30c-b6ad-3da5-be4c-28b8bc540643",
                        "entry_id": "39465463-abd8-3916-b366-172eeeb926c7",
                        "glosses": [
                            "La chose omise."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6b9190d7-dc76-467a-8135-660d9f3ebb0a",
                                "sense_id": "75e2d30c-b6ad-3da5-be4c-28b8bc540643",
                                "text": "[…] il narra, en une esquisse sommaire et avec les omissions et les inexactitudes naturelles à son genre de mentalité, la série de ses aventures."
                            },
                            {
                                "example_id": "7d5a383d-28bc-4e3e-b8a9-cdd0802e0fda",
                                "sense_id": "75e2d30c-b6ad-3da5-be4c-28b8bc540643",
                                "text": "Péché d’omission ou par omission : Péché qui consiste à ne pas faire ce qui est commandé."
                            },
                            {
                                "example_id": "89e4b5e9-6eb5-440a-882b-8710c2094018",
                                "sense_id": "75e2d30c-b6ad-3da5-be4c-28b8bc540643",
                                "text": "La réalité quotidienne, c’est la routine, l’hypocrisie, l’omission […], l’indifférence, le pacte dans l’ombre avec la mort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6de158de-a932-4f7a-bd27-6319fcdbd15b",
                        "source_entry_id": "39465463-abd8-3916-b366-172eeeb926c7",
                        "target_lang_word": "omission",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omission",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e19bcc2a-bf13-3893-9af1-568cdc1815c3",
                                        "entry_id": "cee55e22-4358-35bd-8e05-c9a8fdef7d12",
                                        "glosses": [
                                            "The act of omitting."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b822e91-19c0-47a2-b1e9-b61aaa2b6d16",
                                                "sense_id": "e19bcc2a-bf13-3893-9af1-568cdc1815c3",
                                                "text": "Scots was not ‘banned’ outright — impossible anyway with so many Scots-speaking teachers but, like Gaelic, marginalised by omission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89f6e9a5-c65a-3f8f-8ad1-52f1adeda8c4",
                                        "entry_id": "cee55e22-4358-35bd-8e05-c9a8fdef7d12",
                                        "glosses": [
                                            "The act of neglecting to perform an action one has an obligation to do."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ad6f88-339b-4503-a507-3675c124d0c0",
                                                "sense_id": "89f6e9a5-c65a-3f8f-8ad1-52f1adeda8c4",
                                                "text": "E&O insurance (for errors and omissions) covers both errors of commission and errors of omission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57c43e96-88f1-351a-93b5-d282b7a13a19",
                                        "entry_id": "cee55e22-4358-35bd-8e05-c9a8fdef7d12",
                                        "glosses": [
                                            "An instance of those acts, or the thing left out thereby; something deleted or left out."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5ce2345-5b2a-4ba3-a1bc-d9927eb91763",
                                                "sense_id": "57c43e96-88f1-351a-93b5-d282b7a13a19",
                                                "text": "The suspicious omissions in the new edition of the book attracted claims of censorship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24a6715c-ed23-3121-9f6b-373b769bfb0c",
                                        "entry_id": "cee55e22-4358-35bd-8e05-c9a8fdef7d12",
                                        "glosses": [
                                            "Something not done or neglected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abb96092-aa10-4469-a15f-e00f59755629",
                                                "sense_id": "24a6715c-ed23-3121-9f6b-373b769bfb0c",
                                                "text": "The lack of a sponge count was an omission by the surgical team."
