                "senses": [
                    {
                        "sense_id": "7ac245ea-2e98-3745-96cf-21dbadb2f4c8",
                        "entry_id": "265799db-7ea0-352f-a2fc-f508db2f6abe",
                        "glosses": [
                            "Faire perdre son caractère purement biologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "929bc1ce-ddc3-4d66-8378-54c1cf20b6e3",
                                "sense_id": "7ac245ea-2e98-3745-96cf-21dbadb2f4c8",
                                "text": "Vous essayez, avec beaucoup d’intelligence et d’esprit, de « débiologiser » l’homme."
                            },
                            {
                                "example_id": "31346191-9349-4a20-b494-4ebdecba61e6",
                                "sense_id": "7ac245ea-2e98-3745-96cf-21dbadb2f4c8",
                                "text": "Dans tous les cas, les questions de sexualité, couples et familles, continuent de se socialiser et de se « débiologiser », renforçant le débat entre libertés individuelles et normes sociales."
                            }
                        ]
                    }
