    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c7ffc3e4-c017-3ae5-9b25-a55b65473e20",
                    "sense_definition": "odczuwanie niskiej temperatury przez kogoś (używane bezosobowo)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "odczucie_temperatury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jest mi bardzo <w>zimno</w> w ręce, ponieważ zapomniałem wziąć z domu rękawiczek.",
                            "target_lang_translations": {
                                "ru": "Мне очень <w>холодно</w> в руки, потому что я забыл взять из дома перчатки.",
                                "en": "My hands are very <w>cold</w> because I forgot to bring my gloves from home."
                            }
                        },
                        {
                            "text": "Zamknij proszę to okno, bo robi się tutaj <w>zimno</w>.",
                            "target_lang_translations": {
                                "ru": "Закрой, пожалуйста, это окно, потому что здесь становится <w>холодно</w>.",
                                "en": "Please close that window, because it's getting <w>cold</w> in here."
                            }
                        }
                    ],
                    "antonyms": [
                        "ciepło",
                        "gorąco"
                    ],
                    "common_phrases": [
                        "jest mi zimno",
                        "zrobiło się zimno"
                    ],
                    "target_lang_definitions": {
                        "ru": "ощущение холода кем-либо (используется безлично)",
                        "en": "feeling cold (used impersonally to describe a person's sensation of low temperature)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодно",
                                "target_lang_sense_clarification": "об ощущении холода кем-либо"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "cold",
                                "target_lang_sense_clarification": "feeling cold"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "876cf12a-7a98-33bd-a963-7b5803c4bb22",
                    "sense_definition": "w sposób charakteryzujący się niską temperaturą otoczenia",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temperatura_otoczenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na dworze było tak <w>zimno</w>, że musiał nałożyć grubą kurtkę.",
                            "target_lang_translations": {
                                "ru": "На улице было так <w>холодно</w>, что ему пришлось надеть толстую куртку.",
                                "en": "It was so <w>cold</w> outside that he had to put on a thick jacket."
                            }
                        },
                        {
                            "text": "W tym starym zamku zawsze jest <w>zimno</w> i wilgotno.",
                            "target_lang_translations": {
                                "ru": "В этом старом замке всегда <w>холодно</w> и сыро.",
                                "en": "It is always <w>cold</w> and damp in this old castle."
                            }
                        }
                    ],
                    "synonyms": [
                        "chłodno"
                    ],
                    "antonyms": [
                        "ciepło",
                        "gorąco"
                    ],
                    "common_phrases": [
                        "zimno na dworze"
                    ],
                    "target_lang_definitions": {
                        "ru": "о низкой температуре окружающей среды",
                        "en": "in a cold manner, referring to low ambient temperature"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодно",
                                "target_lang_sense_clarification": "о температуре воздуха"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "cold",
                                "target_lang_sense_clarification": "of weather or environment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "818e39c9-b7b2-35db-a932-d780aba0f47c",
                    "sense_definition": "w sposób pozbawiony serdeczności, obojętny lub nieprzyjazny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zachowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel <w>zimno</w> się skrzywił i pokręcił głową, odrzucając moją prośbę.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>холодно</w> поморщился и покачал головой, отклонив мою просьбу.",
                                "en": "The teacher grimaced <w>coldly</w> and shook his head, rejecting my request."
                            }
                        },
                        {
                            "text": "Przywitała go bardzo <w>zimno</w>, co od razu popsuło atmosferę spotkania.",
                            "target_lang_translations": {
                                "ru": "Она встретила его очень <w>холодно</w>, что сразу испортило атмосферу встречи.",
                                "en": "She greeted him very <w>coldly</w>, which immediately ruined the atmosphere of the meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "chłodno"
                    ],
                    "antonyms": [
                        "ciepło",
                        "serdecznie",
                        "życzliwie"
                    ],
                    "common_phrases": [
                        "zimno przyjąć",
                        "patrzeć zimno"
                    ],
                    "target_lang_definitions": {
                        "ru": "бездушно, равнодушно или недружелюбно",
                        "en": "in an unfriendly, indifferent, or emotionally distant manner"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодно",
                                "target_lang_sense_clarification": "сдержанно, без эмоций"
                            },
                            {
                                "target_lang_word": "прохладно",
                                "target_lang_sense_clarification": "недружелюбно, равнодушно"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "coldly",
                                "target_lang_sense_clarification": "unfriendly or indifferently"
                            },
                            {
                                "target_lang_word": "cold",
                                "target_lang_sense_clarification": "emotionally distant"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ccf2d98-8e01-3d23-a244-4f4c2ce124ba",
                    "sense_definition": "niska temperatura powietrza lub otoczenia",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperatura_otoczenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na dworze panowało potworne <w>zimno</w>, dlatego musiał nałożyć grubą kurtkę.",
                            "target_lang_translations": {
                                "ru": "На улице стоял ужасный <w>холод</w>, поэтому ему пришлось надеть толстую куртку.",
                                "en": "There was a terrible <w>cold</w> outside, so he had to put on a thick jacket."
                            }
                        },
                        {
                            "text": "Mimo że dokuczało im wielkie <w>zimno</w>, postanowili kontynuować wycieczkę w góry.",
                            "target_lang_translations": {
                                "ru": "Несмотря на то, что их мучил сильный <w>холод</w>, они решили продолжить поход в горы.",
                                "en": "Even though they were bothered by the great <w>cold</w>, they decided to continue their trip into the mountains."
                            }
                        }
                    ],
                    "synonyms": [
                        "chłód",
                        "mróz",
                        "ziąb"
                    ],
                    "antonyms": [
                        "ciepło",
                        "upał"
                    ],
                    "common_phrases": [
                        "potworne zimno",
                        "chronić przed zimnem"
                    ],
                    "target_lang_definitions": {
                        "ru": "низкая температура воздуха или окружающей среды",
                        "en": "low temperature of the air or environment"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холод",
                                "target_lang_sense_clarification": "низкая температура воздуха"
                            },
                            {
                                "target_lang_word": "стужа",
                                "target_lang_sense_clarification": "сильный холод"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "cold",
                                "target_lang_sense_clarification": "low temperature"
                            },
                            {
                                "target_lang_word": "coldness",
                                "target_lang_sense_clarification": "lack of heat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18b5704e-eacf-32f9-96dd-6d2fd4afedd7",
                    "sense_definition": "bolesna zmiana skórna, pęcherzyk pojawiający się najczęściej na wardze wskutek zakażenia wirusowego",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "choroba",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rano obudziłem się i zauważyłem, że na mojej wardze wyskoczyło bolesne <w>zimno</w>.",
                            "target_lang_translations": {
                                "ru": "Утром я проснулся и заметил, что на губе выскочила болезненная <w>простуда</w>.",
                                "en": "In the morning I woke up and noticed that a painful <w>cold sore</w> had popped up on my lip."
                            }
                        },
                        {
                            "text": "Muszę kupić w aptece specjalną maść, żeby szybko wyleczyć to <w>zimno</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить в аптеке специальную мазь, чтобы быстро вылечить эту <w>простуду</w>.",
                                "en": "I need to buy a special ointment at the pharmacy to quickly cure this <w>cold sore</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "opryszczka",
                        "febra",
                        "skwarka"
                    ],
                    "common_phrases": [
                        "zimno na wardze",
                        "wyskoczyło zimno"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie opryszczki"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "болезненное высыпание, пузырек, появляющийся обычно на губах в результате вирусной инфекции",
                        "en": "a painful skin lesion, typically a blister appearing on the lip due to a viral infection"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простуда",
                                "target_lang_sense_clarification": "разговорное обозначение герпеса на губах"
                            },
                            {
                                "target_lang_word": "герпес",
                                "target_lang_sense_clarification": "медицинское название высыпания"
                            },
                            {
                                "target_lang_word": "лихорадка",
                                "target_lang_sense_clarification": "разговорное название герпеса на губах"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "cold sore",
                                "target_lang_sense_clarification": "herpes simplex blister on the lip"
                            }
                        ]
                    }
                }
            ]
        }
    ]
