                        "entry_id": "435b7444-eb90-3218-83c4-4eafed95cc2b",
                        "glosses": [
                            "A person, especially a man, who delivers a baby (in childbirth)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16ca00f5-b95b-4f48-a8a8-8ba4ef6f0c84",
                                "sense_id": "a42df2a8-17b9-343c-9bee-dfbca0974fa8",
                                "text": "And lastly, obstetrical chairs seemed most natural to the accoucheurs of the middle ages."
                            },
                            {
                                "example_id": "271fc191-d409-4c73-9ac7-b225e2cb04eb",
                                "sense_id": "a42df2a8-17b9-343c-9bee-dfbca0974fa8",
                                "text": "Family story: on the day of his birth the accoucheur approached his father, the baby wrapped in a cloth."
                            }
                        ]
                    }
