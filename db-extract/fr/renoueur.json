                                "example_id": "8d34354d-2fe4-4da0-956c-069d6bc043d8",
                                "sense_id": "1d7641b5-2717-3ec6-98ab-dde651aba44c",
                                "text": "Trois gaillards membrus, un renoueur féru d’exorcismes, deux gendarmes adeptes de la méthode réanimation Jules Moch, rien, ni personne, ne lui fit recouvrer l’esprit."
                            },
                            {
                                "example_id": "0eee0580-8564-4eab-9423-64b4fa6f8fed",
                                "sense_id": "1d7641b5-2717-3ec6-98ab-dde651aba44c",
                                "text": "Aussi simples que soient les paysans, ils ne tarderaient pas à se détourner dʼun renoueur maladroit qui les estropierait."
                            }
                        ]
                    }
