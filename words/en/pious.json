{
    "word_family": [
        "piety",
        "piously",
        "piousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eabc9db7-2c84-3997-a8e0-b50e3a8be39f",
                    "sense_definition": "Deeply religious and showing respect for God or religious practices.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_devotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pious</w> woman attended church every single morning before starting her daily work.",
                            "target_lang_translations": {
                                "zh": "那位<w>虔诚</w>的女士每天早晨在开始日常工作前都会去教堂。"
                            }
                        },
                        {
                            "text": "He lived a <w>pious</w> life, always following the teachings of his faith with great care.",
                            "target_lang_translations": {
                                "zh": "他过着<w>虔诚</w>的生活，始终严格遵循自己信仰的教义。"
                            }
                        }
                    ],
                    "synonyms": [
                        "religious",
                        "devout",
                        "godly",
                        "observant"
                    ],
                    "antonyms": [
                        "impious",
                        "profane"
                    ],
                    "common_phrases": [
                        "pious man",
                        "pious woman"
                    ],
                    "target_lang_definitions": {
                        "zh": "虔诚的；笃信宗教的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "虔诚",
                                "target_lang_sense_clarification": "指对宗教或信仰恭敬而真诚"
                            },
                            {
                                "target_lang_word": "笃信",
                                "target_lang_sense_clarification": "指信仰非常坚定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d5adde3-9b63-3754-a5cb-1630ae54d47a",
                    "sense_definition": "Pretending to be virtuous or morally superior to others in an annoying way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "negative_virtue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made a <w>pious</w> comment about how everyone else should behave better than they currently do.",
                            "target_lang_translations": {
                                "zh": "她发表了一番<w>道貌岸然</w>的评论，说其他人现在的表现应该更好一些。"
                            }
                        },
                        {
                            "text": "His <w>pious</w> attitude made it very difficult for his colleagues to work with him comfortably.",
                            "target_lang_translations": {
                                "zh": "他那副<w>伪善</w>的态度让同事们很难与他舒心地共事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pious attitude",
                        "pious comment"
                    ],
                    "target_lang_definitions": {
                        "zh": "伪善的；道貌岸然的；自命清高的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "道貌岸然",
                                "target_lang_sense_clarification": "指神态严肃，装作道德高尚的样子"
                            },
                            {
                                "target_lang_word": "伪善",
                                "target_lang_sense_clarification": "表面正经而实际虚假"
                            },
                            {
                                "target_lang_word": "自命不凡",
                                "target_lang_sense_clarification": "自以为品德或言行高人一等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1eeca9a4-7923-3cec-91fa-ef634e197d2c",
                    "sense_definition": "Connected to religious activities or charitable works.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_devotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization dedicated itself to a <w>pious</w> cause, helping the poor in the local community.",
                            "target_lang_translations": {
                                "zh": "该组织致力于一项<w>慈善</w>事业，帮助当地社区的穷人。"
                            }
                        },
                        {
                            "text": "They spent their weekend performing <w>pious</w> duties at the local monastery.",
                            "target_lang_translations": {
                                "zh": "他们在当地修道院履行<w>敬虔</w>的职责，度过了周末。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reverent",
                        "reverential"
                    ],
                    "common_phrases": [
                        "pious cause",
                        "pious duty"
                    ],
                    "target_lang_definitions": {
                        "zh": "（行为或事业）出于宗教善意的，慈善的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "慈善",
                                "target_lang_sense_clarification": "指扶贫济困等行善行为"
                            },
                            {
                                "target_lang_word": "善意",
                                "target_lang_sense_clarification": "出于良好的愿望或宗教道德的动机"
                            },
                            {
                                "target_lang_word": "敬虔",
                                "target_lang_sense_clarification": "出于宗教责任或情怀"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}