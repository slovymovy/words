                "senses": [
                    {
                        "sense_id": "94d43b81-b364-369e-b156-af393176f71c",
                        "entry_id": "85a92aa7-2a71-368a-8153-53ababe0b36b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a9874f0-08f4-4e28-8996-3ad0cb6bd166",
                                "sense_id": "94d43b81-b364-369e-b156-af393176f71c",
                                "text": "Frau Grünewälder ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e2e1dd0a-aedc-412a-9e8b-506b8783bf32",
                                "sense_id": "94d43b81-b364-369e-b156-af393176f71c",
                                "text": "Herr Grünewälder wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c85833c7-e4e4-499d-a0a0-b7d176de7d73",
                                "sense_id": "94d43b81-b364-369e-b156-af393176f71c",
                                "text": "Die Grünewälders fahren heute ins Bergische Land."
                            },
                            {
                                "example_id": "38ed470d-6b9d-4a5c-8ac1-4a37f63d1605",
                                "sense_id": "94d43b81-b364-369e-b156-af393176f71c",
                                "text": "Der Grünewälder trägt nie die Schals, die die Grünewälder ihm strickt."
                            },
                            {
                                "example_id": "b63e6820-f596-4997-a19a-5e8180c41c50",
                                "sense_id": "94d43b81-b364-369e-b156-af393176f71c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Grünewälder kommt, geht der Herr Grünewälder.“"
                            },
                            {
                                "example_id": "9c476d52-c25a-4569-854e-d68f93b39af1",
                                "sense_id": "94d43b81-b364-369e-b156-af393176f71c",
                                "text": "Grünewälder kommt und geht."
                            },
                            {
                                "example_id": "7a798ba0-c036-4e6b-91f9-fbb4fbf4e8bb",
                                "sense_id": "94d43b81-b364-369e-b156-af393176f71c",
                                "text": "Grünewälders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
