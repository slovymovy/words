                    "sense_id": "1a4ce879-c950-3bca-a1ab-76fe3a86c18e",
                    "sense_definition": "Qui ne dort pas ; qui est sorti du sommeil.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après un long voyage en train, il est resté <w>éveillé</w> presque toute la nuit.",
                            "target_lang_translations": {
                                "en": "After a long train journey, he stayed <w>awake</w> for almost the whole night.",
                                "ru": "После долгого путешествия на поезде он почти всю ночь <w>бодрствовал</w>.",
                                "de": "Nach der langen Zugfahrt blieb er fast die ganze Nacht <w>wach</w>.",
                                "es": "Tras un largo viaje en tren, se quedó <w>despierto</w> casi toda la noche.",
                                "zh": "经过一段漫长的火车旅程后，他几乎整夜都<w>醒着</w>。"
                            }
                        },
                        {
                            "text": "Le bébé est enfin <w>éveillé</w> et réclame déjà son biberon avec impatience.",
                            "target_lang_translations": {
                                "en": "The baby is finally <w>awake</w> and already demanding his bottle impatiently.",
                                "ru": "Малыш наконец <w>проснулся</w> и уже нетерпеливо требует свою бутылочку.",
                                "de": "Das Baby ist endlich <w>wach</w> und verlangt schon ungeduldig nach seinem Fläschchen.",
                                "es": "Por fin el bebé está <w>despierto</w> y ya reclama su biberón con impaciencia.",
                                "zh": "宝宝终于<w>醒</w>了，已经迫不及待地要喝奶了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "réveillé"
