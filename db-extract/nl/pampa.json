                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b59a7bd4-3ef4-4d46-af07-4fe43b4f0f6e",
                                                "sense_id": "897da9a0-6eb1-3b5a-97ef-3b57fe44e909",
                                                "text": "Argentinien besteht überwiegend aus der Pampa."
                                            },
                                            {
                                                "example_id": "377c80df-780f-4c0c-9e1e-232572ec2ba0",
                                                "sense_id": "897da9a0-6eb1-3b5a-97ef-3b57fe44e909",
                                                "text": "„Die durch die Pampas reisende Gesellschaft hatte ihre Zelte in weitem Halbkreise aufgeschlagen. In der Mitte desselben brannten die von Pferdemist genährten Feuer, über denen Fleischstücke schmorten.“"
                                            },
                                            {
                                                "example_id": "f636b70b-657f-4886-b11b-89e0e414ca08",
                                                "sense_id": "897da9a0-6eb1-3b5a-97ef-3b57fe44e909",
                                                "text": "„Das Gras der Pampas wurde höher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c63db80-5641-3456-af24-d0dc3ad8b554",
                                        "entry_id": "e57ab213-4dde-3cd0-bdac-199dcfe80779",
