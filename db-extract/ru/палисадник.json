                "senses": [
                    {
                        "sense_id": "cebf074b-60dd-30f5-a9ff-139599e0a1d7",
                        "entry_id": "e5f31a99-b5a5-394f-81f8-efe536f6c1d8",
                        "glosses": [
                            "садик перед домом, небольшая часть придомовой территории между наружной стеной и уличной оградой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf33529-3e02-48cb-a13d-3380855f5b92",
                                "sense_id": "cebf074b-60dd-30f5-a9ff-139599e0a1d7",
                                "text": "Дома стоят скученно, без промежуточных палисадников или садиков."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f5cb997-11d5-3a5d-a56e-a563036bf86f",
                        "entry_id": "e5f31a99-b5a5-394f-81f8-efe536f6c1d8",
                        "glosses": [
                            "забор, ограда, отделяющая придомовую территорию от уличной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da6e9828-c519-4a3b-8f7a-a8260141a5d1",
                                "sense_id": "5f5cb997-11d5-3a5d-a56e-a563036bf86f",
                                "text": "Проезжая мимо какого-то помещичьего имения, Рябович поглядел через палисадник в сад."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02827b4a-d105-44e1-a0de-f061d0a94b88",
                        "source_entry_id": "e5f31a99-b5a5-394f-81f8-efe536f6c1d8",
                        "source_sense_description": "садик перед домом",
                        "target_lang_word": "front garden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "front garden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cfb5271-ce75-32d0-abe3-e4498996e753",
                                        "entry_id": "477df358-46f8-378c-88a8-3418bc101c1f",
                                        "glosses": [
                                            "A garden at the front of a property."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37f6819e-fc73-4988-820e-461cd64246fb",
                        "source_entry_id": "e5f31a99-b5a5-394f-81f8-efe536f6c1d8",
                        "source_sense_description": "садик перед домом",
                        "target_lang_word": "Vorgarten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorgarten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9d35656-3dd4-3cf3-b246-569aa22c94be",
                                        "entry_id": "03d6e7b8-e019-390a-8676-fac5b9c457eb",
                                        "glosses": [
                                            "meist kleines, privates Stück Grünfläche zwischen Haus und Straße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a61e5917-8be0-41a9-bfe8-9e2f18c67cca",
                                                "sense_id": "c9d35656-3dd4-3cf3-b246-569aa22c94be",
                                                "text": "Die Vorgärten der Deutschen sind reichlich mit Gartenzwergen bestückt."
                                            },
                                            {
                                                "example_id": "7bc95c85-2e3c-405c-93b4-28f0fda03c2b",
                                                "sense_id": "c9d35656-3dd4-3cf3-b246-569aa22c94be",
                                                "text": "„Im Vorgarten strich mir Frau Apken über die Haare.“"
                                            },
                                            {
                                                "example_id": "6ee8f84a-c096-45e1-803c-d2d4b7bb6ea7",
                                                "sense_id": "c9d35656-3dd4-3cf3-b246-569aa22c94be",
                                                "text": "„In den kahlen Vorgärten lag nebelschwere Luft.“"
                                            },
                                            {
                                                "example_id": "5c5be495-5aab-4ce0-914f-731228a3e1ea",
                                                "sense_id": "c9d35656-3dd4-3cf3-b246-569aa22c94be",
                                                "text": "„Perfekt asphaltierte Straßen schlängeln sich an gepflegten Vorgärten vorbei, Kinder schaukeln, Rentner trinken Eistee.“"
                                            },
                                            {
                                                "example_id": "39236cdf-02b4-41d2-9f3d-ac4a9015e873",
                                                "sense_id": "c9d35656-3dd4-3cf3-b246-569aa22c94be",
                                                "text": "„Die Vorgärten waren adrett gepflegt, die Hecken gestutzt, die hölzernen Hundehütten sahen identisch aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c90d9ca-6eca-4c8d-99b3-8cd47af0797e",
                        "source_entry_id": "e5f31a99-b5a5-394f-81f8-efe536f6c1d8",
                        "source_sense_description": "ограда",
                        "target_lang_word": "paling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbf8e7b9-bef2-32d4-b041-1ecb2fca4854",
                                        "entry_id": "c73ddf78-d7e8-387a-ae13-7115eed4a4c6",
                                        "glosses": [
                                            "present participle and gerund of pale"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "paling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c6e569d-7b25-386d-9102-c363c1b623e6",
                                        "entry_id": "888a9f5e-1356-30fd-b93c-376e49d275cb",
                                        "glosses": [
                                            "A pointed stick used to make a fence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77630130-b8c4-45b1-9544-eebb65eed2bc",
                                                "sense_id": "7c6e569d-7b25-386d-9102-c363c1b623e6",
                                                "text": "The boys continued hitting the tennis ball with pailings snatched from a fence […]"
                                            },
                                            {
                                                "example_id": "a38ba397-6dae-4641-8553-794c9f38ab54",
                                                "sense_id": "7c6e569d-7b25-386d-9102-c363c1b623e6",
                                                "text": "The smell of the damp eucalypt palings that clad the walls exhaling their aromatic resin into the house, mingling with the fragrance of the myrtle burning in the fireplace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef134044-6e24-32cf-bc3d-aca940c4a5d9",
                                        "entry_id": "888a9f5e-1356-30fd-b93c-376e49d275cb",
                                        "glosses": [
                                            "A fence made of palings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79bd76fd-0501-43a2-8f55-4df601608106",
                                                "sense_id": "ef134044-6e24-32cf-bc3d-aca940c4a5d9",
                                                "text": "1789, Alderman Le Mesurier), addressing the House of Commons, in The Parliamentary Register,ᴴᵃⁿˢᵃʳᵈ London: John Debrett, Volume 26, p. 172,\nGentlemen must have observed that many of the nurserymen’s plantations were wide and extensive, some of them covering several acres; and that their palings and fences were for the most part low, and might be so weak and out of repair, as to afford a very insufficient security against the inroads of robbers and spoilers."
                                            },
                                            {
                                                "example_id": "9e87cf3d-9ede-4020-b7ff-64e15b0fb5a4",
                                                "sense_id": "ef134044-6e24-32cf-bc3d-aca940c4a5d9",
                                                "text": "The park paling was still the boundary on one side, and she soon passed one of the gates into the ground."
                                            },
                                            {
                                                "example_id": "2b5b1a2b-7198-4cc1-a0e1-46ec6cc010e3",
                                                "sense_id": "ef134044-6e24-32cf-bc3d-aca940c4a5d9",
                                                "text": "The wide doors and windows of the restaurant stood open, beneath large awnings, to a wide pavement, where there were other plants in tubs, and rows of spreading trees, and beyond which there was a large shady square, without any palings, and with marble-paved walks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bb36a55-092a-3c4a-b21a-a417fc0f7b33",
                                        "entry_id": "888a9f5e-1356-30fd-b93c-376e49d275cb",
                                        "glosses": [
                                            "A fence made of galvanized sheeting."
                                        ],
                                        "tags": [
                                            "Caribbean"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15cf0d3c-243e-4321-9cab-224314a4bf9d",
                                                "sense_id": "6bb36a55-092a-3c4a-b21a-a417fc0f7b33",
                                                "text": "He worked badly. He had to paint a large sign on a corrugated iron paling. Doing letters on a corrugated surface was bad enough; to paint a cow and a gate, as he had to, was maddening."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
