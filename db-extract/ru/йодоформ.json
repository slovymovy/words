                            {
                                "target_word": "iodoforme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a42d1f05-1361-394e-b4ef-d3f164791bed",
                                        "entry_id": "035ed699-d04c-3732-b93a-80316b1549a7",
                                        "glosses": [
                                            "Composé jaunâtre généralement obtenu par la réaction de l’iode sur l’alcool en présence du carbonate de potasse et qui s’emploie comme antiseptique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9676e345-0a79-41b7-990c-10d63ead98bf",
                                                "sense_id": "a42d1f05-1361-394e-b4ef-d3f164791bed",
                                                "text": "Quelques-unes, enfin, paraissaient couvertes de pansements, plaquées d’axonge noire mercurielle, d’onguents verts de belladone, piquées de grains de poussière, par les micas jaunes de la poudre d’iodoforme."
                                            },
                                            {
                                                "example_id": "f2dfdfdc-c048-4783-8786-b63e51858c74",
                                                "sense_id": "a42d1f05-1361-394e-b4ef-d3f164791bed",
                                                "text": "Le train qui glisse, la fumée à goût d’iodoforme, la portière, le plaid, le grand manteau, la moustache claire…"
                                            },
                                            {
                                                "example_id": "7df5e272-78b6-4b2f-b999-f4f24e05d8e2",
                                                "sense_id": "a42d1f05-1361-394e-b4ef-d3f164791bed",
                                                "text": "L’iodoforme est un antiseptique très employé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
