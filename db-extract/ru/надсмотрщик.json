                ],
                "senses": [
                    {
                        "sense_id": "964464d8-5939-3bd0-a233-5b314d3e7e70",
                        "entry_id": "7e2b0cd3-a913-3e98-bd11-239d4c9b0af3",
                        "glosses": [
                            "тот, кто надзирает за кем-либо или за чем-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91bf208e-66cb-4301-9977-0656d4c2650d",
                        "source_entry_id": "7e2b0cd3-a913-3e98-bd11-239d4c9b0af3",
                        "source_sense_id": "964464d8-5939-3bd0-a233-5b314d3e7e70",
                        "target_lang_word": "Aufseher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufseher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc136bba-0965-3caa-a9ee-c38df04fe18a",
                                        "entry_id": "e7394201-48f3-3f24-a047-c7e54e690f69",
                                        "glosses": [
                                            "jemand, der Dinge bewacht oder Vorgänge überwacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5805d0-c546-44bd-94cb-92ac7f8fa069",
                                                "sense_id": "bc136bba-0965-3caa-a9ee-c38df04fe18a",
                                                "text": "„Der Aufseher des Sammelpunkts empfing uns mit Freude, und wir heuerten sofort an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                        "entry_id": "e7394201-48f3-3f24-a047-c7e54e690f69",
                                        "glosses": [
                                            "jemand, der Personen (meist: unter Zwang gehaltene Personen) beaufsichtigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a3decd-04b1-49c4-98bc-7f3d20c23eea",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "„Der Aufseher des Sammelpunkts empfing uns mit Freude, und wir heuerten sofort an.“"
                                            },
                                            {
                                                "example_id": "6945fd09-d457-4a74-b6e8-b8288b428ed3",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "Im Gefängnis als Aufseher zu arbeiten, ist keine leichte Aufgabe."
                                            },
                                            {
                                                "example_id": "67cb0b89-3d67-4fa1-bf77-abbe83d51740",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "„Die Aufseher haben uns auch gesagt, wir sollen schreiben, dass wir zum Arbeiten noch weiter fahren würden.“"
                                            },
                                            {
                                                "example_id": "49a4d8d6-a14e-4599-9ab9-44b20b4f18b0",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "„Ich folgte dem Aufseher über zwei kahle Steintreppen und einen langen, weiß gekalkten Gang, vorbei an langen Reihen schwerer Türen mit kleinen, vergitterten Fenstern.“"
                                            },
                                            {
                                                "example_id": "a1d1f9de-8d17-4479-8941-bb3e33402bfe",
                                                "sense_id": "4c8adf08-a08d-39f1-b342-3028784c001c",
                                                "text": "„Sie strickte ihm auch einen weißwollenen Schwanzwärmer mit roter Spitze, aber er versteckte ihn vor den andern Burschen der Kolonne, weil er Angst hatte, die Aufseher könnten es entdecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64f207fb-3d59-4109-b319-7e5b6336bae8",
                        "source_entry_id": "7e2b0cd3-a913-3e98-bd11-239d4c9b0af3",
                        "source_sense_id": "964464d8-5939-3bd0-a233-5b314d3e7e70",
                        "target_lang_word": "Wärter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wärter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                        "entry_id": "66a245c1-1bc3-36cb-b369-9216834d9063",
                                        "glosses": [
                                            "Person, die etwas beaufsichtigt oder bewacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "066a6da1-dbd5-4ce0-b93d-e7173bbca943",
                                                "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                                "text": "Die Wärter waren alle eingeschlafen."
                                            },
                                            {
                                                "example_id": "cca730d7-1dbf-415e-ba7d-c17af511443a",
                                                "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                                "text": "„Andere wandten ein, es werde die Gemeinde zehn Pfund und zwölf Schilling für die Kutsche und die Dienste eines Wärters kosten, das Mädchen zur Einschiffung nach London zu schaffen.“"
                                            },
                                            {
                                                "example_id": "412e101d-d06b-49fc-8a4a-50a140e53b1b",
                                                "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                                "text": "„Der Wärter hatte seinen Kopf gewaltsam dem Maler zugedreht.“"
                                            },
                                            {
                                                "example_id": "89ced730-5b63-4206-9d0d-14eb8d8e170c",
                                                "sense_id": "886ea9ab-5fa9-3e7c-8569-e4aa9c25c87d",
                                                "text": "„Bewacht wird die Zufahrt von zwei Wärtern in Tarnuniform, von denen einer auf einem Holzturm achtgibt, dass der Wald nirgends brennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6917bc9d-79bf-4e69-bd60-9f32b4a4da83",
                        "source_entry_id": "7e2b0cd3-a913-3e98-bd11-239d4c9b0af3",
                        "source_sense_id": "964464d8-5939-3bd0-a233-5b314d3e7e70",
                        "target_lang_word": "Aufsicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufsicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "043924c8-9cdc-3bd1-89c7-a2cc6678be5d",
                                        "entry_id": "5c25f2c3-be5a-3a29-bbb8-938d05b9a24d",
                                        "glosses": [
                                            "die Beobachtung, Kontrolle, Überwachung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ba143e6-cedc-4a02-a015-adeddce5c25a",
                                                "sense_id": "043924c8-9cdc-3bd1-89c7-a2cc6678be5d",
                                                "text": "In den Pausen muss in Schulen immer Aufsicht geführt werden."
                                            },
                                            {
                                                "example_id": "09a82d0e-b733-4588-8161-da9f384565c1",
                                                "sense_id": "043924c8-9cdc-3bd1-89c7-a2cc6678be5d",
                                                "text": "Der die Aufsicht durchführende Beamte ist befugt, Verwarnungen auszusprechen."
                                            },
                                            {
                                                "example_id": "8d5b4f7d-1292-4565-94c8-1baccc77cded",
                                                "sense_id": "043924c8-9cdc-3bd1-89c7-a2cc6678be5d",
                                                "text": "„Die Aufsicht über den Religionsunterricht wurde den staatlichen Behörden überschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8625b130-4d23-3438-bd61-87fa82b0a876",
                                        "entry_id": "5c25f2c3-be5a-3a29-bbb8-938d05b9a24d",
                                        "glosses": [
                                            "Person, die [1] wahrnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a051f862-473f-4be7-8f77-e69174f3a2c8",
                                                "sense_id": "8625b130-4d23-3438-bd61-87fa82b0a876",
                                                "text": "Die Aufsicht hat sehr gut aufgepasst und Schlimmeres verhindert."
                                            },
                                            {
                                                "example_id": "a62ed01f-1532-45e8-8740-f775a04eed96",
                                                "sense_id": "8625b130-4d23-3438-bd61-87fa82b0a876",
                                                "text": "„Die Braut von dem Kellner ist Aufsicht in einem Warenhaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "12914c97-42e4-3cd7-809b-b6f078be7c81",
                                        "entry_id": "5c25f2c3-be5a-3a29-bbb8-938d05b9a24d",
                                        "glosses": [
                                            "Darstellung, bei der ein Gegenstand von oben wiedergegeben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1f09a0c-335d-42d4-8a4a-6f6c189e528d",
                                                "sense_id": "12914c97-42e4-3cd7-809b-b6f078be7c81",
                                                "text": "Die linke Skizze zeigt eine Aufsicht auf das Schiff, die rechte eine Ansicht der Backbordseite."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
