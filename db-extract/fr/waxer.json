                        "sense_id": "4cce9325-89df-37d9-9725-8065a163d261",
                        "entry_id": "f816becb-9c73-3fad-8ac5-d84bef7d2093",
                        "glosses": [
                            "Appliquer de la wax sur une planche de surf."
                        ],
                        "tags": [
                            "Surf"
                        ],
                        "examples": [
                            {
                                "example_id": "5aa4dc06-76df-4ee4-959d-a3443eeef01a",
                                "sense_id": "4cce9325-89df-37d9-9725-8065a163d261",
                                "text": "Pour waxer une planche de surf, il faut frotter le pain de wax délicatement sur la planche, on ne pousse pas trop fort."
                            },
                            {
                                "example_id": "aedfd608-5151-4a5e-98a8-3c3a5f6fa50f",
                                "sense_id": "4cce9325-89df-37d9-9725-8065a163d261",
                                "text": "Waxez sérieusement votre planche pour gagner en équilibre."
                            },
                            {
                                "example_id": "93a0e854-9c51-40a3-bf5d-7207772a1e86",
                                "sense_id": "4cce9325-89df-37d9-9725-8065a163d261",
                                "text": "Dans le cas où la planche a déjà été waxée précédemment, il faut la laisser sécher au soleil pendant quelques minutes."
                            }
                        ]
