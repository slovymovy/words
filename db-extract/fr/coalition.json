                                        "glosses": [
                                            "spojenectví různých subjektů k prosazení konkrétních cílů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa983a77-e913-412c-a3b0-1e60ebe2b65b",
                                                "sense_id": "fbd7711b-b57c-3a89-8510-e2a9b458203a",
                                                "text": "Dohadovací řízení je v koalici prvním stupněm vyjádření toho, že strany nejsou spokojeny s fungováním spolupráce a může vést až ke konci koalice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "koalice",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "8c066b0a-0c69-39d9-a701-69d6071e072f",
                                        "entry_id": "778c229a-a717-36f6-b2d0-ab8eec26056b",
                                        "glosses": [
                                            "samice koaly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4a4738c-e181-4c13-afaa-75dedb115f24",
                                                "sense_id": "8c066b0a-0c69-39d9-a701-69d6071e072f",
                                                "text": "Koalice dostanou implantáty na omezení porodnosti a podvyživená nebo nemocná zvířata budou zlikvidována."
                                            }
                                        ]
