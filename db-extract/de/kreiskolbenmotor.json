                "senses": [
                    {
                        "sense_id": "70db41ef-656c-3365-ab0b-4c2778decac5",
                        "entry_id": "d16d1de2-cea5-3c32-b7f2-899f85763cee",
                        "glosses": [
                            "Verbrennungsmotor, bei dem der Verbrennungsdruck durch einen rotierenden Kreiskolben in Bewegung umgesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b46d98c7-6590-44f2-b58d-835776bf8f8c",
                                "sense_id": "70db41ef-656c-3365-ab0b-4c2778decac5",
                                "text": "„Als nach dem Kreiskolbenmotor kein Hahn mehr krähte, landete der Mazda RX-7 seinen größten Hit.“"
                            },
                            {
                                "example_id": "72e09faf-e3d0-47b7-9329-5bd0afc4714e",
                                "sense_id": "70db41ef-656c-3365-ab0b-4c2778decac5",
                                "text": "„Ihre Wahl fiel auf den Kreiskolbenmotor des Typs KC-24, den Sachs in größeren Stückzahlen an einen amerikanischen Hersteller von Schneemobilen lieferte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
