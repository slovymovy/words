                        "entry_id": "dab627d6-7eb9-3bc6-bd6f-0e2ce40702eb",
                        "glosses": [
                            "название «красновато-коричневого с золотистым отливом» цвета, оттенок этого цвета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a26e0956-bb83-438c-817e-ab41d9dc72ff",
                                "sense_id": "9b11f290-383d-3e3f-90d2-84beca23c27a",
                                "text": "Le Luxembourg qu'il traversa resplendissait d'une mordorure ensoleillée, plein d'enfants jolis et de flambants rubans."
                            },
                            {
                                "example_id": "fef37faf-eb2b-443e-b647-cbf688a3a961",
                                "sense_id": "9b11f290-383d-3e3f-90d2-84beca23c27a",
                                "text": "Des draps de satin rouge gisaient là, mélangeant leur mordorure mouvante au molleton d’une lourde couette du même coloris."
                            },
                            {
                                "example_id": "420eee47-6da0-41c5-9c58-df0e33ff7e4d",
                                "sense_id": "9b11f290-383d-3e3f-90d2-84beca23c27a",
                                "text": "Il serait dans un état comme neuf, s'il n'avait un cheveu dans un angle supérieur essentiellement visible à son dos, étant noyé dans la mordorure au devant."
                            },
                            {
                                "example_id": "61ab1260-6858-41fe-9791-96f08d13eb60",
                                "sense_id": "9b11f290-383d-3e3f-90d2-84beca23c27a",
                                "text": "Vase balustre en grès émaillé capucin à mordorure argent et or."
                            }
                        ]
                    }
                ],
