                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забивать",
                                "target_lang_sense_clarification": "убивать скот для получения мяса"
                            },
                            {
                                "target_lang_word": "резать",
                                "target_lang_sense_clarification": "разговорный вариант забоя скота"
                            }
