                    {
                        "translation_id": "e9cc232f-8f9c-4b1c-b089-5cc84c6772f4",
                        "source_entry_id": "df3117fa-241b-3f57-9982-bb0d4f2c396f",
                        "source_sense_id": "71c9baf8-53c4-355a-8d40-a698c796c454",
