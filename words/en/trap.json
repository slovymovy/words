    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "214557d1-7465-347c-bb19-fe862fbc8dcd",
                    "sense_definition": "A machine or device designed to catch animals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_trap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer set a <w>trap</w> to catch the rats in the barn.",
                            "target_lang_translations": {
                                "ru": "Фермер поставил <w>ловушку</w>, чтобы поймать крыс в сарае.",
                                "zh": "农夫在谷仓里设下<w>陷阱</w>来捕捉老鼠。"
                            }
                        },
                        {
                            "text": "We need to buy a humane <w>trap</w> to catch the stray cat.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить гуманную <w>ловушку</w>, чтобы поймать бродячую кошку.",
                                "zh": "我们需要买一个人道的<w>捕兽笼</w>来抓住那只流浪猫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snare",
                        "net"
                    ],
                    "common_phrases": [
                        "mouse trap",
                        "set a trap",
                        "rat trap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство или механизм, предназначенный для поимки животных.",
                        "zh": "用于捕捉动物的装置或机械。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловушка",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "капкан",
                                "target_lang_sense_clarification": "механическое устройство с захватом"
                            },
                            {
                                "target_lang_word": "силок",
                                "target_lang_sense_clarification": "петля для ловли птиц или мелких зверей"
                            },
                            {
                                "target_lang_word": "западня",
                                "target_lang_sense_clarification": "устройство, преграждающее выход"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陷阱",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "捕兽夹",
                                "target_lang_sense_clarification": "机械式捕捉装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0880dc2-8cb5-3e1c-b8a0-4f4e10ad3ba2",
                    "sense_definition": "A trick or arrangement designed to catch, deceive, or detect someone.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_trap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't fall into the <w>trap</w> of thinking the exam will be easy.",
                            "target_lang_translations": {
                                "ru": "Не попадайся в <w>ловушку</w>, думая, что экзамен будет легким.",
                                "zh": "别掉进认为考试会很容易的<w>陷阱</w>里。"
                            }
                        },
                        {
                            "text": "The police set a <w>trap</w> to catch the criminals.",
                            "target_lang_translations": {
                                "ru": "Полиция устроила <w>ловушку</w>, чтобы поймать преступников.",
                                "zh": "警方设下<w>圈套</w>以抓捕罪犯。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snare"
                    ],
                    "common_phrases": [
                        "fall into a trap",
                        "death trap",
                        "booby trap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уловка или хитрость, предназначенная для того, чтобы поймать, обмануть или разоблачить кого-либо.",
                        "zh": "旨在诱骗、欺骗或捕捉某人的诡计或安排。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловушка",
                                "target_lang_sense_clarification": "хитрость, уловка"
                            },
                            {
                                "target_lang_word": "западня",
                                "target_lang_sense_clarification": "безвыходное положение"
                            },
                            {
                                "target_lang_word": "капкан",
                                "target_lang_sense_clarification": "переносное значение: безвыходная ситуация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陷阱",
                                "target_lang_sense_clarification": "比喻义"
                            },
                            {
                                "target_lang_word": "圈套",
                                "target_lang_sense_clarification": "精心设计的骗局"
                            }
                        ]
                    }
                },
                {
