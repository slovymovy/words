                "senses": [
                    {
                        "sense_id": "163d7c02-705b-312a-820b-fc490c03255a",
                        "entry_id": "f698e363-8e31-3f58-bd0e-0534914064f7",
                        "glosses": [
                            "overeenkomstig de regels en eisen van de juridische wetgeving"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "71303be0-7e46-318a-9de8-78df6cbe3d5e",
                        "entry_id": "f698e363-8e31-3f58-bd0e-0534914064f7",
                        "glosses": [
                            "overeenkomstig de wetten van de natuur, volgens een vast patroon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51482e9c-8277-4f1a-991f-ce82d18f0ba6",
                                "sense_id": "71303be0-7e46-318a-9de8-78df6cbe3d5e",
                                "text": "Volgens radicaal-islamistische beweging Hamas zal het voorlopig onrustig blijven in de regio. „Het wapen van verzet zal een wetmatigheid blijven voor de bevrijding van Palestina, Jeruzalem en de al-Aqsa-moskee”, zei Hamas-prominent Achmad Bahar in Gaza. Leider Ismail Hanija riep vrijdag op tot een nieuwe Palestijnse opstand (intifada)."
                            },
                            {
                                "example_id": "7ff5226f-2b7e-45a9-b0e5-2a0a888fe815",
                                "sense_id": "71303be0-7e46-318a-9de8-78df6cbe3d5e",
                                "text": "Oude economische wetmatige zekerheden waarbij omzet, winst, groei en groeiverwachting in onderlinge samenhang worden bezien, werden opzij geschoven De meesten dot.com-ondernemers hadden bovendien nauwelijks ondernemerscapaciteiten."
                            },
                            {
                                "example_id": "153d2495-3199-42b4-a8f6-27566267dd27",
                                "sense_id": "71303be0-7e46-318a-9de8-78df6cbe3d5e",
                                "text": "Ook vanuit Volksgezondheid kan veel meer worden gedaan om de vraag naar drugs terug te dringen. Neem de vraag weg, dan daalt het aanbod vanzelf. Deze economische wetmatigheid geldt evenzeer voor de internationale drugshandel."
                            },
                            {
                                "example_id": "19e0fa66-8ec7-4604-9e37-2e91f08ae2bc",
                                "sense_id": "71303be0-7e46-318a-9de8-78df6cbe3d5e",
                                "text": "In de psychologie – en diverse andere sociale wetenschappen – onderzoek je regelmatigheden in menselijk gedrag. De natuurwetenschappen onderzoeken ook regelmatigheden. Het verschil tussen beide is dat je in een aantal natuurwetenschappen kunt komen tot wetmatigheden. In de psychologie leiden regelmatigheden nooit tot wetmatigheden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c91f08b7-a2c4-4ea2-b279-e5a76430b764",
                        "source_entry_id": "f698e363-8e31-3f58-bd0e-0534914064f7",
                        "source_sense_id": "163d7c02-705b-312a-820b-fc490c03255a",
                        "target_lang_word": "legitimate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legitimate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a59abb0b-2e7b-3d2c-8f8b-fdaf68c8c737",
                                        "entry_id": "761bb422-d4cb-3453-ae85-f2cac7bc46d9",
                                        "glosses": [
                                            "In accordance with the law or established legal forms and requirements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c67c9f27-912a-40e2-8791-a2a0fc580022",
                                                "sense_id": "a59abb0b-2e7b-3d2c-8f8b-fdaf68c8c737",
                                                "text": "Rodwell was sent off by referee Martin Atkinson - who has shown 15 red cards since the start of last season - after 23 minutes for what appeared to be a legitimate challenge on Suarez."
                                            },
                                            {
                                                "example_id": "b48a0411-f904-4d1d-a021-67d9cecfede0",
                                                "sense_id": "a59abb0b-2e7b-3d2c-8f8b-fdaf68c8c737",
                                                "text": "According to the tweet, the encounter began with \"a traffic stop for unlawful speed.\" If so, then the initial stop was legitimate, but in and of itself that wouldn't be probable cause to search the car. It does give an officer the right to look inside, and if contraband is in plain view, that would be probable cause. Here we don't know whether the bag full of drugs marked \"BAG FULL OF DRUGS\" was laying out in plain view, but it seems entirely possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f178790c-1fe3-3163-8360-c14b93fa7ef9",
                                        "entry_id": "761bb422-d4cb-3453-ae85-f2cac7bc46d9",
                                        "glosses": [
                                            "Conforming to known principles, or established or accepted rules or standards; valid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a78c5454-ac5b-46fa-a72d-407be1393e68",
                                                "sense_id": "f178790c-1fe3-3163-8360-c14b93fa7ef9",
                                                "text": "legitimate reasoning; a legitimate standard or method"
                                            },
                                            {
                                                "example_id": "9adf3a53-d2f2-425e-aa6b-c4e558f4102f",
                                                "sense_id": "f178790c-1fe3-3163-8360-c14b93fa7ef9",
                                                "text": "Tillotson still keeps his place as a legitimate English classic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a3e60db-523d-37fb-8a9c-64719c50922a",
                                        "entry_id": "761bb422-d4cb-3453-ae85-f2cac7bc46d9",
                                        "glosses": [
                                            "Authentic, real, genuine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48e12d81-0bbb-4173-9054-be605c0de903",
                                                "sense_id": "6a3e60db-523d-37fb-8a9c-64719c50922a",
                                                "text": "legitimate poems of Chaucer; legitimate inscriptions"
                                            },
                                            {
                                                "example_id": "d3efef74-df08-4204-8842-a5a9b391a64d",
                                                "sense_id": "6a3e60db-523d-37fb-8a9c-64719c50922a",
                                                "text": "The truth is, when we fail to protect legitimate rights of others and continue to expand the net of lies and defamation, every one would become victims one day including ourselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08af66ce-9b94-3938-bad5-517042a23208",
                                        "entry_id": "761bb422-d4cb-3453-ae85-f2cac7bc46d9",
                                        "glosses": [
                                            "Marital.",
                                            "Lawfully begotten, i.e. born to a married couple or later legitimated."
                                        ],
                                        "tags": [
                                            "of a child"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3eb59d88-b4bd-36f9-be95-aa1471802fb1",
                                        "entry_id": "761bb422-d4cb-3453-ae85-f2cac7bc46d9",
                                        "glosses": [
                                            "Marital.",
                                            "Legally married."
                                        ],
                                        "tags": [
                                            "of a sexual partner"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b374dd6-ca1a-45d1-a409-2a69d18f1074",
                                                "sense_id": "3eb59d88-b4bd-36f9-be95-aa1471802fb1",
                                                "text": "Besides his four legitimate wives, the caliph had dozens of concubines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6608c7e-ed70-315d-af24-45c4d544ecaf",
                                        "entry_id": "761bb422-d4cb-3453-ae85-f2cac7bc46d9",
                                        "glosses": [
                                            "Relating to hereditary rights."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a89eb249-3a1b-349f-a134-14c84b3f9957",
                                        "entry_id": "761bb422-d4cb-3453-ae85-f2cac7bc46d9",
                                        "glosses": [
                                            "Belonging or relating to the legitimate theater."
                                        ],
                                        "tags": [],
                                        "examples": []
