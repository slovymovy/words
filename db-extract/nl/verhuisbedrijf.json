                        "tags": [],
                        "examples": [
                            {
                                "example_id": "760d5764-8cb2-47a0-a0df-f80d4a3db71d",
                                "sense_id": "14b18974-ab61-34e0-ae0a-67c953b5e490",
                                "text": "Ik bel mijn assistente Joelia en vraag haar om bij het verhuisbedrijf een kopie van dat registratieformulier te bemachtigen en die naar Hotel Moskou te faxen."
                            },
                            {
                                "example_id": "544f0dca-436d-4a6f-98c0-77d85c8906d4",
                                "sense_id": "14b18974-ab61-34e0-ae0a-67c953b5e490",
                                "text": "\"Een grote vleugel til je hier niet zomaar uit\", zegt Sicco Elzinga van het verhuisbedrijf. \"We hebben nog bekeken of we dit met een helikopter konden doen, maar vanwege vergunningen en dergelijke was dat niet haalbaar. Daarom hebben we deze speciale telescoopkraan besteld.\""
                            }
                        ]
