                        "glosses": [
                            "mieszkanka Rostowa albo Rostowa nad Donem; kobieta z jednego z tych miast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1636eff-b3f7-4526-92b1-00be565c9f7d",
                                "sense_id": "8048327d-cf75-3e5b-ae6f-f134b7f85054",
                                "text": "Grono uroczych rostowianek towarzyszyło warszawskim profesorom niemal do końca ich pobytu w mieście nad Donem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
