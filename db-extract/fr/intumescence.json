                        "sense_id": "e15ce7cb-3102-30bf-b422-2f32d4e24f9f",
                        "entry_id": "a1671197-e70b-309c-bf95-6c53988d4431",
                        "glosses": [
                            "Action par laquelle une chose s’enfle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "593cc210-c928-4917-9c00-09af525d5613",
                                "sense_id": "e15ce7cb-3102-30bf-b422-2f32d4e24f9f",
                                "text": "bientôt elle tombe à l’horizon, l’intersecte, ne montre plus que la moitié de son front qui s’assoupit, s’incline et disparaît dans la molle intumescence des vagues."
                            },
                            {
                                "example_id": "8969d108-4ce6-4ea0-9a1c-6f5f22d111b4",
                                "sense_id": "e15ce7cb-3102-30bf-b422-2f32d4e24f9f",
                                "text": "À deux verstes en avant, en suivant le cours de l’Obi, une petite ville, pittoresquement étagée, s’élevait sur une légère intumescence du sol."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfd662d8-fc4f-3f13-b251-3163ab02ac61",
                        "entry_id": "a1671197-e70b-309c-bf95-6c53988d4431",
                        "glosses": [
                            "Augmentation de volume du corps ou d'une de ses parties."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "13f8c2f6-cc8e-4ad4-a7dc-4ecdbee198ce",
                                "sense_id": "cfd662d8-fc4f-3f13-b251-3163ab02ac61",
                                "text": "L’intumescence des chairs."
                            },
                            {
                                "example_id": "9d7b68d2-d0eb-40e6-b714-2a3d0d94c56c",
                                "sense_id": "cfd662d8-fc4f-3f13-b251-3163ab02ac61",
                                "text": "Il s’agit de renflements, dont l’un est situé en région craniale (intumescence cervicale) et l’autre caudalement (intumescence lombosacrée)."
                            }
                        ]
                    }
