                                            "A stowaway on a seagoing vessel."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "submarine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e5b3463-2048-3139-8584-d9ca4e4fd28a",
                                        "entry_id": "b6f2a201-7614-35cb-81bb-a9f8407b5c12",
                                        "glosses": [
                                            "To operate or serve on a submarine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba3eb7a5-9356-37bb-8f76-f72791cf5c11",
                                        "entry_id": "b6f2a201-7614-35cb-81bb-a9f8407b5c12",
                                        "glosses": [
                                            "To torpedo; to destroy with a sudden sneak attack."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c07b73b9-7ca4-410a-81e1-946b81394760",
                                                "sense_id": "ba3eb7a5-9356-37bb-8f76-f72791cf5c11",
                                                "text": "“We’re really at the point of chicken, where the Fed is trying to ward off inflation without submarining the economy.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1560748-0e3f-377c-90ab-0158898816cf",
                                        "entry_id": "b6f2a201-7614-35cb-81bb-a9f8407b5c12",
                                        "glosses": [
                                            "To sink or submerge oneself."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54bfec7c-95b7-4f0e-8189-82acff0c7f1a",
                                                "sense_id": "f1560748-0e3f-377c-90ab-0158898816cf",
                                                "text": "The second their center snapped the ball, I submarined between the big guy's legs and tackled the halfback."
                                            },
                                            {
                                                "example_id": "c714a24f-24d3-4a71-a02f-00c05a266776",
                                                "sense_id": "f1560748-0e3f-377c-90ab-0158898816cf",
                                                "text": "Ten days later, the full force of what happened crushed me. I submarined into the depths of disillusionment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e459f758-82eb-3065-9102-50354a2f950e",
                                        "entry_id": "b6f2a201-7614-35cb-81bb-a9f8407b5c12",
                                        "glosses": [
                                            "To slide forwards underneath one's seat belt (during a crash or sudden stop)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5f56fec-1fa6-4619-be3c-9d6431613df3",
                                                "sense_id": "e459f758-82eb-3065-9102-50354a2f950e",
                                                "text": "The seatback should always be up while driving so that the occupant doesn't submarine and potentially suffer severe internal injury."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
