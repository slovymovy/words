                "senses": [
                    {
                        "sense_id": "e2b1f3fa-f259-397d-bfb3-3766134c1fdd",
                        "entry_id": "f12fe60d-ea27-3b9d-9914-853ff39e04bf",
                        "glosses": [
                            "Variante expressive du verbe piquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aeb2ce3-b623-4519-aef8-64613859ff19",
                                "sense_id": "e2b1f3fa-f259-397d-bfb3-3766134c1fdd",
                                "text": "Et, secundo, ce soir même, demain au plus tard, je vous fais vacciner, cul ou cuisse ou bras, je ne sais pas trop ou ça se met… et je me fais piquailler avec vous comme un brave couillon que je suis."
                            },
                            {
                                "example_id": "ad661003-7ba3-499c-a04f-dfcf4de9096e",
                                "sense_id": "e2b1f3fa-f259-397d-bfb3-3766134c1fdd",
                                "text": "Après, si personne ne me réponds, je n’en fais pas un plat, c’était ici un moyen comme un autre de piquailler l’orgueil des spécialistes pour lancer un débat."
                            }
                        ]
                    }
                ],
