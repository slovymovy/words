                        "sense_id": "9ad95cf5-f35a-3f7a-9689-08194cce4c0c",
                        "entry_id": "3e24590d-87a6-31f9-b8ec-980091a0de7e",
                        "glosses": [
                            "tekens die op het wegdek staan aangegeven en het verkeer door middel van de visuele informatie geleiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2746359b-66ec-4b76-a3ab-8435edd892e4",
                                "sense_id": "9ad95cf5-f35a-3f7a-9689-08194cce4c0c",
                                "text": "Er zijn meerdere omleidingsroutes. De werkzaamheden betreffen onder meer asfalteren en het aanbrengen van vangrails, verlichting en wegmarkeringen. Weggebruikers kunnen hun reis voorbereiden op www.vananaarbeter.nl."
                            },
                            {
                                "example_id": "5c6949f9-c36e-428d-85b1-5956551cbe84",
                                "sense_id": "9ad95cf5-f35a-3f7a-9689-08194cce4c0c",
                                "text": "Wegmarkeringen op 60 km/u-wegen en doorgetrokken lijnen bij toe- en afritten langs spitsstroken vragen van de wegbeheerder extra aandacht.”"
                            },
                            {
                                "example_id": "ff18b5be-65e2-4165-ab40-638090b0cf40",
                                "sense_id": "9ad95cf5-f35a-3f7a-9689-08194cce4c0c",
                                "text": "De politie heeft onderzoek gedaan naar de toedracht van het ongeval. De automobilist had gezien de wegmarkering voorrang."
                            }
                        ]
                    }
                ],
