                                            "initialism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3a77a7e-931a-3048-a69a-d1718841c553",
                                        "entry_id": "a1d87105-9208-3f09-990c-77eb27ce5c2f",
                                        "glosses": [
                                            "Initialism of International Cultural Exchange."
                                        ],
                                        "tags": [
                                            "abbreviation",
