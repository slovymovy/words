                "senses": [
                    {
                        "sense_id": "d1a669f2-9870-3a80-bdc6-e8f20e93dfc7",
                        "entry_id": "647ddcc8-1675-3f3f-abee-ebfd416ec0d3",
                        "glosses": [
                            "zur späteren Verwendung zurückgehaltene Menge (= Vorrat) an Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bfa9819-1900-40dd-a972-b8dea9db863a",
                                "sense_id": "d1a669f2-9870-3a80-bdc6-e8f20e93dfc7",
                                "text": "Mit ihrem Wasservorrat konnten sie ihre Pflanzen im Garten im Sommer bewässern."
                            },
                            {
                                "example_id": "488ebe3d-b684-4d27-bfe8-b91f1ec9d8be",
                                "sense_id": "d1a669f2-9870-3a80-bdc6-e8f20e93dfc7",
                                "text": "„Von den Wasservorräten der Welt sind etwa 97 Prozent salzhaltig.“"
                            },
                            {
                                "example_id": "4a4fe765-e129-4542-afbf-839216ae413e",
                                "sense_id": "d1a669f2-9870-3a80-bdc6-e8f20e93dfc7",
                                "text": "„Jacobsen zieht daraus den Schluss, dass der irdische Wasserkreislauf bis tief in den Mantel reicht und dass der Wasservorrat der Erde insgesamt deutlich größer ist als bisher gedacht.“"
                            },
                            {
                                "example_id": "76703819-b6eb-448f-951e-cada27018169",
                                "sense_id": "d1a669f2-9870-3a80-bdc6-e8f20e93dfc7",
                                "text": "„Im Anschluss nahmen einige Teilnehmer das Angebot an, den Hochbehälter auf dem Parsberg zu besichtigen, in dem der Wasservorrat für das Versorgungsgebiet aufbewahrt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
