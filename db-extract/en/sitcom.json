                        ]
                    },
                    {
                        "translation_id": "0edc44c2-67d9-4e10-b6ba-b4c8f206a943",
                        "source_entry_id": "2590dc19-ba1e-3fe3-b8fb-adb5304f2ac1",
                        "source_sense_id": "cda8dac7-5fd2-3cb5-9921-6ffc6305e905",
