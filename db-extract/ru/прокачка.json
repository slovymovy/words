                "senses": [
                    {
                        "sense_id": "b46e26c7-e18b-3258-9a0c-c61f2df66f36",
                        "entry_id": "c458a99a-8106-377c-b997-3379c0d86182",
                        "glosses": [
                            "действие по значению гл. прокачать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d01bf7f-6e49-424b-a5c8-a5e2ddaa6d10",
                                "sense_id": "b46e26c7-e18b-3258-9a0c-c61f2df66f36",
                                "text": "На этом семинаре можно прокачать переговорные навыки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3ab413d-e930-4257-ad28-94671e074c83",
                        "source_entry_id": "c458a99a-8106-377c-b997-3379c0d86182",
                        "source_sense_id": "b46e26c7-e18b-3258-9a0c-c61f2df66f36",
                        "target_lang_word": "pompage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pompage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2321eecf-61a8-340f-9b92-b66e47035273",
                                        "entry_id": "458b0367-5af0-3574-af13-05cc6c8c5632",
                                        "glosses": [
                                            "Activité qui consiste à utiliser une pompe pour déplacer de la matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67397d4e-0450-489c-908f-cbe073889841",
                                                "sense_id": "2321eecf-61a8-340f-9b92-b66e47035273",
                                                "text": "Pour nous, un béton facilement pompable est un béton qui ne forme pas de bouchons lors du pompage (et non pas celui qui se pompe à faible pression)."
                                            },
                                            {
                                                "example_id": "5b1bf56b-68c0-4e16-9da0-2463fa262948",
                                                "sense_id": "2321eecf-61a8-340f-9b92-b66e47035273",
                                                "text": "« Cet avis concernait précisément, l’émission de particules dans l’environnement provenant des travaux relatifs au projet de pompage de la rivière Lombrette pour le domaine skiable », explique dans un courriel la porte-parole pour Le Massif, Maude Barrette Desjardins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37ef8d85-4edb-332a-b485-89ef89329bc4",
                                        "entry_id": "458b0367-5af0-3574-af13-05cc6c8c5632",
                                        "glosses": [
                                            "Phénomène d’instabilité."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42d633e7-64f0-4cb9-9e5b-a1bb03d16727",
                        "source_entry_id": "c458a99a-8106-377c-b997-3379c0d86182",
                        "source_sense_id": "b46e26c7-e18b-3258-9a0c-c61f2df66f36",
                        "target_lang_word": "purge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae2a12b-9c04-3c03-8a08-b11c9cd8d9e6",
                                        "entry_id": "1f6845b6-cb8a-317f-9f40-438c8f9653b2",
                                        "glosses": [
                                            "Action de se purger ; purgatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1bcec72-7cd8-426f-a9d2-e75d360b961d",
                                                "sense_id": "3ae2a12b-9c04-3c03-8a08-b11c9cd8d9e6",
                                                "text": "Prendre une purge."
                                            },
                                            {
                                                "example_id": "f76a62f1-c6b5-4158-a8ab-dc143624e5db",
                                                "sense_id": "3ae2a12b-9c04-3c03-8a08-b11c9cd8d9e6",
                                                "text": "Prescrire une purge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99818d0b-34f8-3ec8-97d2-d3652009f25b",
                                        "entry_id": "1f6845b6-cb8a-317f-9f40-438c8f9653b2",
                                        "glosses": [
                                            "Élément indésirable, complexe, lourd."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "247b017d-fc81-405c-b567-cd90e53345d6",
                                                "sense_id": "99818d0b-34f8-3ec8-97d2-d3652009f25b",
                                                "text": "La dernière mise à jour ? Tu parles d’une purge : trois heures d’installation !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7258edae-c78e-3d36-9e0a-65658b89cddb",
                                        "entry_id": "1f6845b6-cb8a-317f-9f40-438c8f9653b2",
                                        "glosses": [
                                            "Action de purger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "142c763d-5dc0-45a9-9252-b37264933afb",
                                                "sense_id": "7258edae-c78e-3d36-9e0a-65658b89cddb",
                                                "text": "Purge d’hypothèques, Moyen accordé au tiers détenteur pour affranchir l’immeuble des hypothèques dont il est grevé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b2cf1f9-f230-347a-a605-2ca94de3315d",
                                        "entry_id": "1f6845b6-cb8a-317f-9f40-438c8f9653b2",
                                        "glosses": [
                                            "Épurge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "530a393b-c4df-31d5-aad6-47591b12220b",
                                        "entry_id": "1f6845b6-cb8a-317f-9f40-438c8f9653b2",
                                        "glosses": [
                                            "Campagne d’épuration d’une population sur critère d’opinion politique, d’appartenance à une classe, une religion ou un groupe ethnique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a84d0f24-b049-4eff-9e58-b2b789c15d3f",
                                                "sense_id": "530a393b-c4df-31d5-aad6-47591b12220b",
                                                "text": "Rome a eu l’équivalent des purges et procès à grand spectacle, et de la maladie du soupçon ; tout sénateur était soupçonnable, et il en fut ainsi jusqu'à la fin de l'Empire."
                                            },
                                            {
                                                "example_id": "fb42471f-043c-4cad-8988-edbd4a7678be",
                                                "sense_id": "530a393b-c4df-31d5-aad6-47591b12220b",
                                                "text": "Un mot nouveau fit son apparition, lourd de menaces : le « cosmopolitisme ». Dans les pays de l'Est européen, soumis à l'ordre soviétique, on pourchassait, au nom du cosmopolitisme, des catégories entières de citoyens, et les purges qui s'y amplifiaient réveillaient aussitôt le souvenir des années terribles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f902b059-0ff5-3718-83b5-5e0e8963c8ca",
                                        "entry_id": "1f6845b6-cb8a-317f-9f40-438c8f9653b2",
                                        "glosses": [
                                            "Élimination d’un fluide indésirable dans un système, comme les bulles d’air dans un système hydraulique ou l’eau dans un système à bain d’huile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da61d8cb-e8e1-4240-a5ff-610d7b44edc7",
                                                "sense_id": "f902b059-0ff5-3718-83b5-5e0e8963c8ca",
                                                "text": "Une défectuosité du système de purge est à l’origine de la contamination de l’échangeur thermique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a4c75e-6d52-3e78-b80c-8588c5cf7b77",
                                        "entry_id": "1f6845b6-cb8a-317f-9f40-438c8f9653b2",
                                        "glosses": [
                                            "Match, course ou épreuve ennuyeux, avec peu d’actions, sans intérêt à regarder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b84397c4-cb6b-4dde-906d-97eacf08062c",
                                                "sense_id": "b1a4c75e-6d52-3e78-b80c-8588c5cf7b77",
                                                "text": "Danemark - France restera une bonne purge, pénible souvent, inintéressant la plupart du temps."
                                            },
                                            {
                                                "example_id": "b60ac72e-257f-4869-94df-f580d3c68436",
                                                "sense_id": "b1a4c75e-6d52-3e78-b80c-8588c5cf7b77",
                                                "text": "Alors tant pis si la course est une purge."
                                            },
                                            {
                                                "example_id": "d0c85bc7-3b2c-4c77-bb62-1d147e283b96",
                                                "sense_id": "b1a4c75e-6d52-3e78-b80c-8588c5cf7b77",
                                                "text": "0-0 à la pause ! Et on n'est pas loin de la purge : 2 tirs espagnols, 1 français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd9c852-5dc7-3249-813d-7175e3820def",
                                        "entry_id": "1f6845b6-cb8a-317f-9f40-438c8f9653b2",
                                        "glosses": [
                                            "Élimination, avant vente, d’une section de grume présentant un défaut."
                                        ],
                                        "tags": [
                                            "Exploitation forestière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dca693b-82d7-4ef1-aa9f-a0d23d8aa098",
                                                "sense_id": "2fd9c852-5dc7-3249-813d-7175e3820def",
                                                "text": "Les broussins correspondent à un « foisonnement » anarchique local de bourgeons, gourmands et picots engendrant une prolifération des traces dans le bois. Ils nécessitent une purge localisée, l’arbre étant déclassé en charpente s’il est brogneux, c’est-à-dire couvert de nombreux broussins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "purge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75ded3cf-2577-3515-b5dd-1aef2d9dc190",
                                        "entry_id": "51722d08-ab58-3e73-97d1-17f96d374a27",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de purger."
