                                        "examples": [
                                            {
                                                "example_id": "39f07774-1170-4099-bd8e-ba178729630b",
                                                "sense_id": "faf71f70-196c-3004-a80e-481eafaae6b8",
                                                "text": "Certains Thuléens reviennent ensuite vers l’Alaska, rapportant avec eux des éléments culturels acquis dans l’Est, comme le remplacement de la poterie par des récipients en stéatite et l’utilisation de l’iglou de neige."
                                            },
                                            {
                                                "example_id": "2773c75e-9819-41fe-ac57-ad65d4bb2369",
                                                "sense_id": "faf71f70-196c-3004-a80e-481eafaae6b8",
                                                "text": "De nombreux sceaux en stéatite (silicate de magnésium fournissant le talc), durcis au feu, représentent des animaux et comportent une écriture mal déchiffrée d’environ 270 signes."
                                            }
                                        ]
                                    }
