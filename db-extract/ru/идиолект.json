                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a263d6df-9704-423a-b7f4-316da2cf9273",
                        "source_entry_id": "ed4b3f11-d02a-3d95-8c35-98595bb67549",
                        "source_sense_id": "e09c3903-8ada-3490-93fe-d8aea26107c9",
                        "target_lang_word": "Idiolekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Idiolekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83ffb8a1-26b9-36d5-8356-b8a7a738fb83",
                                        "entry_id": "929609d8-0416-3708-8cb2-b8b6916c4e0d",
                                        "glosses": [
                                            "besondere Sprachform, charakteristische Sprachverwendung einer einzelnen Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23471ebb-02a4-4fe9-a665-6377b1ef24c9",
                                                "sense_id": "83ffb8a1-26b9-36d5-8356-b8a7a738fb83",
                                                "text": "Jeder Mensch spricht auch einen eigenen Idiolekt. Jeder Idiolekt unterscheidet sich etwas von jedem anderen."
                                            },
                                            {
                                                "example_id": "059dbe6b-f0fe-4474-8147-2e6f5589eb42",
                                                "sense_id": "83ffb8a1-26b9-36d5-8356-b8a7a738fb83",
                                                "text": "Da sie in einer rätoromanisch sprachigen Familie in Zürich aufwuchs und heute in Basel lebt, hat sie einen speziellen Idiolekt."
                                            },
                                            {
                                                "example_id": "6e631e4b-4c9c-40e6-ab42-015cdf23e4bd",
                                                "sense_id": "83ffb8a1-26b9-36d5-8356-b8a7a738fb83",
                                                "text": "„In der Eigensprache (= Idiolekt) kommt der einzelne Mensch in seiner Gesamtheit und in seiner Einzigartigkeit zum Ausdruck.“"
                                            },
                                            {
                                                "example_id": "deb3e5fb-95dd-4337-b344-42661e4b1e9d",
                                                "sense_id": "83ffb8a1-26b9-36d5-8356-b8a7a738fb83",
                                                "text": "„Der Idiolekt gilt für die geschriebene Sprache ebenso wie für die gesprochene und ist abhängig von Sozialisierung, Bildung und Zugehörigkeit zu verschiedenen Sprechergruppen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3679c2ab-b4f8-4659-b9a6-66e766a6cb86",
                        "source_entry_id": "ed4b3f11-d02a-3d95-8c35-98595bb67549",
                        "source_sense_id": "e09c3903-8ada-3490-93fe-d8aea26107c9",
                        "target_lang_word": "idiolect",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiolect",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f7ca5736-65c6-32e5-9989-a98246585c60",
                                        "entry_id": "b6610789-f23e-36ee-a961-8940b9f7b4b3",
                                        "glosses": [
                                            "het taalgebruik van één individu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f91cd4bc-e723-42fb-a745-8af6ecd8d524",
                                                "sense_id": "f7ca5736-65c6-32e5-9989-a98246585c60",
                                                "text": "Sun Ra: Avant-garde jazzmusicus die claimde dat hij helemaal niet van Birmingham, Alabama kwam, maar van Saturnus. In diens onnavolgbare idiolect: 'Space is the place!'"
                                            },
                                            {
                                                "example_id": "140b5537-9ebb-4d4c-8925-a5711ed84f3a",
                                                "sense_id": "f7ca5736-65c6-32e5-9989-a98246585c60",
                                                "text": "Heel extreem kun je zeggen: „Ieder mens spreekt zijn eigen dialect.” Daar is een begrip voor: het idiolect.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
