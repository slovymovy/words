                            }
                        ]
                    },
                    {
                        "translation_id": "8bd6911a-2c12-4b24-a6e9-c9b830802f53",
                        "source_entry_id": "9ef31723-860f-3c86-b4f7-395c7596f450",
                        "target_lang_word": "nail salon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
