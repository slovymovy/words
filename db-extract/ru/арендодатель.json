                        ]
                    },
                    {
                        "translation_id": "494f3649-d22b-43db-a8a0-e4b89e5dd7cc",
                        "source_entry_id": "baef261c-6aea-3561-8444-f75a61af2fdb",
                        "source_sense_id": "5764a39f-c27c-3a17-99e7-819774284afe",
                        "target_lang_word": "bailleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bailleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13ced86c-d208-36d8-9894-cfdc59c621a4",
                                        "entry_id": "f3756655-19c9-3ae9-b4fe-044213925a54",
                                        "glosses": [
                                            "Qui baille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a65693f-ff6f-4a36-a846-26ea4a74bbf2",
                                                "sense_id": "13ced86c-d208-36d8-9894-cfdc59c621a4",
                                                "text": "Les organes de la société bailleresse continuent à fonctionner normalement et les droits et devoirs des différents membres de la société ne supportent aucune modification."
                                            },
                                            {
                                                "example_id": "f7930e4b-97ab-4622-8dab-1bafb92ab539",
                                                "sense_id": "13ced86c-d208-36d8-9894-cfdc59c621a4",
                                                "text": "On se réjouit que Téléfilm et la SODEC, les grosses institutions bailleuses de fonds, ne tiennent plus le baromètre du succès de salles à tout prix, d’autant moins depuis que les œuvres sont diffusées sur plusieurs plateformes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bailleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69a27f63-75d5-3833-9815-843dee6d5575",
                                        "entry_id": "c816f01e-7ef7-390b-8c07-fa830bf8b196",
                                        "glosses": [
                                            "Celui qui baille à ferme ou à loyer ; par opposition à celui qui prend une ferme, ou une maison à loyer, et qu’on appelle preneur."
                                        ],
                                        "tags": [
                                            "Droit de propriété"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "403264c9-4aee-47ba-a985-166bc7776a9a",
                                                "sense_id": "69a27f63-75d5-3833-9815-843dee6d5575",
                                                "text": "Lorsque le locataire se marie en cours de bail, le conjoint qui n'a pas signé le contrat peut quand même se prévaloir du bail. Il faudra donc que le renon donné par les locataires soit signé par les deux époux et si l'un ne le fait pas, le bailleur pourra considérer que le congé est nul."
                                            },
                                            {
                                                "example_id": "00b06700-9b31-4297-88fa-6cf509aadcfb",
                                                "sense_id": "69a27f63-75d5-3833-9815-843dee6d5575",
                                                "text": "« Nous faisons de plus en plus de médiation avec les bailleurs ou les fournisseurs d’énergie pour étaler les impayés », remarque Fathia, qui accompagne 80 familles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e14eff9-8ad0-3d05-960d-9cf5009a1353",
                                        "entry_id": "c816f01e-7ef7-390b-8c07-fa830bf8b196",
                                        "glosses": [
                                            "Celui qui baille, fournisseur, donneur, livreur."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4305c672-8637-4973-953f-56642c6aa549",
                                                "sense_id": "7e14eff9-8ad0-3d05-960d-9cf5009a1353",
                                                "text": "Bailleur de fonds"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
