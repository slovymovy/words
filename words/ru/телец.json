{
    "word_family": [
        "телёнок",
        "телиться",
        "тёлка",
        "телушка"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2719d0b5-bd63-3a2e-bb5c-df387f6336e2",
                    "sense_definition": "Человек, рождённый под знаком зодиака Телец (с 21 апреля по 20 мая).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zodiac",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой лучший друг — типичный <w>Телец</w>, поэтому он всегда очень спокоен и упрям.",
                            "target_lang_translations": {
                                "en": "My best friend is a typical <w>Taurus</w>, which is why he is always very calm and stubborn."
                            }
                        },
                        {
                            "text": "По гороскопу она родилась в начале мая и считает себя настоящим <w>Тельцом</w>.",
                            "target_lang_translations": {
                                "en": "According to her horoscope, she was born in early May and considers herself a true <w>Taurus</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "типичный Телец",
                        "Телец по гороскопу"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное обозначение человека по знаку зодиака"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person born under the Taurus astrological sign (April 21 to May 20)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Taurus",
                                "target_lang_sense_clarification": "person born under the sign of Taurus"
                            },
                            {
                                "target_lang_word": "Taurean",
                                "target_lang_sense_clarification": "person born under the sign of Taurus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a245d9a3-f04d-319e-89ea-f5d189a0f231",
                    "sense_definition": "Телёнок или молодой бычок.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старинных легендах и притчах часто упоминался жертвенный <w>телец</w>.",
                            "target_lang_translations": {
                                "en": "In ancient legends and parables, a sacrificial <w>calf</w> was often mentioned."
                            }
                        },
                        {
                            "text": "Многие люди поклоняются только деньгам, забывая всё ради золотого <w>тельца</w>.",
                            "target_lang_translations": {
                                "en": "Many people worship only money, forgetting everything for the sake of the golden <w>calf</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "телёнок",
                        "бычок"
                    ],
                    "common_phrases": [
                        "золотой телец"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее и книжное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A calf or young bull (archaic, literary, or biblical)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "calf",
                                "target_lang_sense_clarification": "young bovine, archaic or biblical"
                            },
                            {
                                "target_lang_word": "bullock",
                                "target_lang_sense_clarification": "young bull"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f9d1e200-71c0-3ed2-9348-8e5c9a97aa3d",
                    "sense_definition": "Второй знак зодиака в астрологии, соответствующий сектору эклиптики от 30° до 60°.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zodiac",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "В астрологии знак <w>Тельца</w> традиционно относится к земной стихии.",
                            "target_lang_translations": {
                                "en": "In astrology, the sign of <w>Taurus</w> traditionally belongs to the earth element."
                            }
                        },
                        {
                            "text": "Каждое утро она читала свежий гороскоп для знака <w>Телец</w>.",
                            "target_lang_translations": {
                                "en": "Every morning she read the latest horoscope for the sign of <w>Taurus</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "♉"
                    ],
                    "common_phrases": [
                        "знак Тельца"
                    ],
                    "target_lang_definitions": {
                        "en": "The second sign of the zodiac in astrology."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Taurus",
                                "target_lang_sense_clarification": "astrological sign"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a1f8f09-2ce6-34d5-9ede-9edeece5e948",
                    "sense_definition": "Зодиакальное созвездие Северного полушария, содержащее яркую звезду Альдебаран.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "astronomy",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "В ясную зимнюю ночь на небе хорошо видно созвездие <w>Тельца</w>.",
                            "target_lang_translations": {
                                "en": "On a clear winter night, the constellation of <w>Taurus</w> is clearly visible in the sky."
                            }
                        },
                        {
                            "text": "Яркая звезда Альдебаран издавна привлекала внимание астрономов в созвездии <w>Телец</w>.",
                            "target_lang_translations": {
                                "en": "The bright star Aldebaran has long attracted the attention of astronomers in the constellation <w>Taurus</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "созвездие Тельца"
                    ],
                    "target_lang_definitions": {
                        "en": "A zodiacal constellation in the northern sky containing the bright star Aldebaran."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Taurus",
                                "target_lang_sense_clarification": "constellation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}