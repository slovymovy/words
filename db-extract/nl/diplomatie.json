                "translations": [
                    {
                        "translation_id": "326b08a7-4ba7-4480-9f58-4689479bc41e",
                        "source_entry_id": "8c8d8f9f-f19f-3368-bbd9-10603ddd04cd",
                        "source_sense_id": "f8d02e6a-ab5c-3165-9826-7dddd76f9ea1",
                        "source_sense_description": "de kunst en de kunde van het voeren van overleg",
                        "target_lang_word": "Diplomatie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diplomatie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "373f879a-0edb-340e-9a51-c37fc979cd81",
                                        "entry_id": "fde91839-a509-3b9b-99e0-260d3b51b491",
                                        "glosses": [
                                            "Verständigung auf zwischenstaatlicher oder multinationaler Ebene mit friedlichen Mitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fbe5c92-5e20-495f-858a-c18799bf5c38",
                                                "sense_id": "373f879a-0edb-340e-9a51-c37fc979cd81",
                                                "text": "Die Vereinten Nationen bemühen sich in Kriegsgebieten um Diplomatie."
                                            },
                                            {
                                                "example_id": "bbdb67e7-517a-4733-ba92-c988fa69f5d0",
                                                "sense_id": "373f879a-0edb-340e-9a51-c37fc979cd81",
                                                "text": "„Wäre die Diplomatie nicht die Wissenschaft der Intrigen und der Hinterhältigkeit, hätten, wie es sein sollte, die Staatsgeschäfte Moral und Wahrhaftigkeit zur Basis, so wäre die Geheimniskrämerei eher lächerlich als notwendig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c7532da3-5411-3d28-9dfe-03a3edc35bd8",
                                        "entry_id": "fde91839-a509-3b9b-99e0-260d3b51b491",
                                        "glosses": [
                                            "diplomatisches Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2d1faa6-f712-4c7d-b80f-4c5789edbaed",
                                                "sense_id": "c7532da3-5411-3d28-9dfe-03a3edc35bd8",
                                                "text": "Das ist ein schwieriges Thema im Vorstand, das müssen Sie mit Diplomatie angehen."
                                            },
                                            {
                                                "example_id": "6647c0e8-8374-49e5-9fee-d9f45d54f0ab",
                                                "sense_id": "c7532da3-5411-3d28-9dfe-03a3edc35bd8",
                                                "text": "„Während es das Ziel traditioneller westlicher Diplomatie ist, dass nach einer Verhandlung alle Seiten ihr Gesicht wahren können, bringt Trump die Situation gern zum Eskalieren.“"
                                            },
                                            {
                                                "example_id": "009be94d-85e3-46a4-8f9f-e0ad7cc598ad",
                                                "sense_id": "c7532da3-5411-3d28-9dfe-03a3edc35bd8",
                                                "text": "„Indessen brachte er dem Sohn gegenüber jene Diplomatie in Anwendung, deren er sich in wichtigen Fällen zu bedienen pflegte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "33f36e08-2f91-31f5-a037-d21ffb7cc30f",
                                        "entry_id": "fde91839-a509-3b9b-99e0-260d3b51b491",
                                        "glosses": [
                                            "Gesamtheit der Diplomaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8dc1b8f-0880-4c14-a7b2-77e8c0bbdcec",
                                                "sense_id": "33f36e08-2f91-31f5-a037-d21ffb7cc30f",
                                                "text": "Es ist Aufgabe der Diplomatie, Konflikte nach Möglichkeit zu beheben."
                                            },
                                            {
                                                "example_id": "536ff87a-4f83-4ee2-8978-1d1ed2eb9c13",
                                                "sense_id": "33f36e08-2f91-31f5-a037-d21ffb7cc30f",
                                                "text": "„Lesen und Schreiben eroberten Bereiche jenseits der Theologie: den Handel, die Diplomatie und sogar die Liebeslyrik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02545f87-11c7-48f4-a01f-b6b078c5594e",
                        "source_entry_id": "8c8d8f9f-f19f-3368-bbd9-10603ddd04cd",
                        "source_sense_id": "f8d02e6a-ab5c-3165-9826-7dddd76f9ea1",
                        "source_sense_description": "de kunst en de kunde van het voeren van overleg",
                        "target_lang_word": "diplomacy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diplomacy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "594cdce3-2d51-3055-8f8f-ac76af49df3b",
                                        "entry_id": "33ca466d-8189-375b-afc8-d7acca17f8d2",
                                        "glosses": [
                                            "The art and practice of conducting international relations by negotiating alliances, treaties, agreements etc., bilaterally or multilaterally, between states and sometimes international organizations, or even between polities with varying status, such as those of monarchs and their princely vassals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3076fc42-de35-46f0-b7e9-8655b47fc1c9",
                                                "sense_id": "594cdce3-2d51-3055-8f8f-ac76af49df3b",
                                                "text": "National diplomacy typically deploys its dexterity to secure advantage for one's nation."
                                            },
                                            {
                                                "example_id": "13448457-3456-43c9-a685-60fd7687f76b",
                                                "sense_id": "594cdce3-2d51-3055-8f8f-ac76af49df3b",
                                                "text": "Admiral Hackett: Hell of a thing you just pulled off, Commander. Curing the genophage? I never thought I'd see the day.\nShepard: Wrex has agreed to help the turians, Admiral. We should get their full support.\nAdmiral Hackett: And the salarians? How did you manage to get them on board?\nShepard: Careful diplomacy.\nAdmiral Hackett: Uh-huh… I don’t think I want to know what that means. Doesn't matter. You're starting to put together a real alliance out there.\nAdmiral Hackett: Good work, Commander. Hackett, out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04c6c1de-09e5-3ea3-ad63-e30d5ea90b92",
                                        "entry_id": "33ca466d-8189-375b-afc8-d7acca17f8d2",
                                        "glosses": [
                                            "Tact and subtle skill in dealing with people so as to avoid or settle hostility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd13700c-2f55-4819-abfe-98a6b48eea9d",
                                                "sense_id": "04c6c1de-09e5-3ea3-ad63-e30d5ea90b92",
                                                "text": "As I was talking with many relatives I have in this town I got assaulted with intense probing of whom I was married to, then who is your girlfriend, then it was what do you do for a job? Most of these relatives don't know I'm gay and deflecting these questions put to the test the art of diplomacy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fa97abf-2a42-4fd6-84f3-282306a17d09",
                        "source_entry_id": "8c8d8f9f-f19f-3368-bbd9-10603ddd04cd",
                        "source_sense_id": "f8d02e6a-ab5c-3165-9826-7dddd76f9ea1",
                        "source_sense_description": "de kunst en de kunde van het voeren van overleg",
                        "target_lang_word": "diplomatie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diplomatie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "900303da-a4b6-30e9-80f3-59945d82c737",
                                        "entry_id": "00d99644-ffb5-341e-a490-eecab319c5ba",
                                        "glosses": [
                                            "Connaissance des traditions qui règlent les rapports mutuels des États, art de concilier leurs intérêts respectifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d90c7d56-fd88-4250-b83b-132082fb8d0f",
                                                "sense_id": "900303da-a4b6-30e9-80f3-59945d82c737",
                                                "text": "Demandez à la diplomatie si le plus beau de tous les succès n’est pas le triomphe de la ruse sur la force ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "692f569c-1163-3938-ad97-935207e0d45a",
                                        "entry_id": "00d99644-ffb5-341e-a490-eecab319c5ba",
                                        "glosses": [
                                            "Ces rapports mêmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a913f96-bfdb-4812-9561-580585cd385f",
                                                "sense_id": "692f569c-1163-3938-ad97-935207e0d45a",
                                                "text": "Non seulement il invita ses concitoyens à déposer leurs ressentiments et leurs griefs sur l'autel de la patrie, mais il demanda encore que le bienfait de cette pacification fût étendu aux autres peuples, et que la France, introduisant parmi les nations une nouvelle diplomatie, jetât les fondements d'une alliance universelle."
                                            },
                                            {
                                                "example_id": "0d8a5b53-db44-482f-8b55-cd45f5c019e7",
                                                "sense_id": "692f569c-1163-3938-ad97-935207e0d45a",
                                                "text": "Diplomatie secrète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cadf2ea0-6c2c-3385-b272-16d3541565c9",
                                        "entry_id": "00d99644-ffb5-341e-a490-eecab319c5ba",
                                        "glosses": [
                                            "Carrière diplomatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "365253f6-0295-47a4-bf24-f73b6da2bd5d",
                                                "sense_id": "cadf2ea0-6c2c-3385-b272-16d3541565c9",
                                                "text": "Je me jetai dans le travail, je m'occupai de science, de littérature et de politique ; j'entrai dans la diplomatie à l’avénement de Charles X qui supprima l'emploi que j'occupais sous le feu roi."
                                            },
                                            {
                                                "example_id": "8101fe7e-cbc3-4796-9bca-be54ebc40c69",
                                                "sense_id": "cadf2ea0-6c2c-3385-b272-16d3541565c9",
                                                "text": "Le Président a qualifié d’« hypothétique » la possibilité de démilitariser Quemoy et Matsu en échange d'un cessez-le-feu, néanmoins il a reconnu que c'était théoriquement envisagé par la diplomatie américaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9261fb88-bc21-3ba2-ab66-f3bdbd6d4912",
                                        "entry_id": "00d99644-ffb5-341e-a490-eecab319c5ba",
                                        "glosses": [
                                            "Tact, prudence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bba16a91-95a1-4f95-a990-a80fd6fd312b",
                                                "sense_id": "9261fb88-bc21-3ba2-ab66-f3bdbd6d4912",
                                                "text": "Parler avec diplomatie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0350582e-29d3-3ad5-b1ad-491b0b085e9c",
                                        "entry_id": "00d99644-ffb5-341e-a490-eecab319c5ba",
                                        "glosses": [
                                            "Adresse, ruse, habileté."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01ad0f15-dcf5-4d65-a6e3-4c7028604d96",
                                                "sense_id": "0350582e-29d3-3ad5-b1ad-491b0b085e9c",
                                                "text": "Faire de la diplomatie, user d’adresse, de ruse."
                                            },
                                            {
                                                "example_id": "81d687aa-c44b-4844-bba0-6f90d4174127",
                                                "sense_id": "0350582e-29d3-3ad5-b1ad-491b0b085e9c",
                                                "text": "Que de diplomatie !"
                                            },
                                            {
                                                "example_id": "7e1d4930-2feb-476f-bc5b-f0133e3c6869",
                                                "sense_id": "0350582e-29d3-3ad5-b1ad-491b0b085e9c",
                                                "text": "Voilà bien de la diplomatie dépensée en pure perte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d8d654f-b1fa-3f0f-bd5d-665715e76fe0",
                                        "entry_id": "00d99644-ffb5-341e-a490-eecab319c5ba",
                                        "glosses": [
                                            "Étude des chartes, diplômes et autres documents officiels. Elle s’intéresse à leur classification, leur valeur, leur âge et leur authenticité. Elle est souvent considérée, avec la paléographie ou l’archivistique, comme une discipline auxiliaire de l’histoire."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
