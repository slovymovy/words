                                "example_id": "82d1389b-421d-44c0-bdbf-29825fdcad66",
                                "sense_id": "f50bf0fe-00ae-3c3e-a0ec-4d7842e79ff5",
                                "text": "„Der Wochenfluss gilt immer noch als hochinfektiös. Dies ist nicht richtig, da die Mehrzahl der Keime apathogen sind.“"
                            },
                            {
                                "example_id": "e8358bc3-7df3-4082-ae51-87470bc492c7",
                                "sense_id": "f50bf0fe-00ae-3c3e-a0ec-4d7842e79ff5",
                                "text": "Verursacher der Nagerpest ist ein sehr kleines, auch für Menschen hochinfektiöses Bakterium."
                            },
                            {
                                "example_id": "c1353f7d-5680-43ff-909e-694f2f0f7ba8",
                                "sense_id": "f50bf0fe-00ae-3c3e-a0ec-4d7842e79ff5",
                                "text": "„Die Rhinotracheitis der Katze (RTK) ist eine besonders unter jungen Katzen weitverbreitete hochinfektiöse Krankheit, die zum ersten Mal von CRANDELL und MAURER (1958) beschrieben worden ist.“"
                            }
