{
    "word_family": [
        "ellende"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "39b1ebb1-06c3-3527-80dd-1d3246774e0d",
                    "sense_definition": "zich mentaal of fysiek zeer slecht, verdrietig of ziek voelen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gevoel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij voelde zich <w>ellendig</w> na haar dood en wilde met niemand praten.",
                            "target_lang_translations": {
                                "en": "He felt <w>miserable</w> after her death and didn't want to talk to anyone."
                            }
                        },
                        {
                            "text": "Ik voel me <w>ellendig</w> door de griep en blijf vandaag in bed.",
                            "target_lang_translations": {
                                "en": "I feel <w>terrible</w> because of the flu and am staying in bed today."
                            }
                        }
                    ],
                    "synonyms": [
                        "erbarmelijk",
                        "rampzalig"
                    ],
                    "antonyms": [
                        "gelukkig",
                        "vrolijk",
                        "gezond"
                    ],
                    "common_phrases": [
                        "zich ellendig voelen"
                    ],
                    "target_lang_definitions": {
                        "en": "feeling mentally or physically very bad, sad, or ill"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "miserable",
                                "target_lang_sense_clarification": "feeling very unhappy or unwell"
                            },
                            {
                                "target_lang_word": "wretched",
                                "target_lang_sense_clarification": "feeling deep affliction or distress"
                            },
                            {
                                "target_lang_word": "terrible",
                                "target_lang_sense_clarification": "feeling very unwell or bad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02e99201-d2ec-3d59-991f-09f45a31dbb6",
                    "sense_definition": "in een zeer slechte, beklagenwaardige of armoedige toestand verkerend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vluchtelingen leefden in <w>ellendige</w> omstandigheden in het tijdelijke kamp.",
                            "target_lang_translations": {
                                "en": "The refugees lived in <w>wretched</w> conditions in the temporary camp."
                            }
                        },
                        {
                            "text": "Hij bleef alleen en <w>ellendig</w> achter in het verlaten huis.",
                            "target_lang_translations": {
                                "en": "He was left behind alone and <w>miserable</w> in the abandoned house."
                            }
                        }
                    ],
                    "synonyms": [
                        "erbarmelijk",
                        "rampzalig"
                    ],
                    "antonyms": [
                        "uitstekend",
                        "comfortabel"
                    ],
                    "common_phrases": [
                        "ellendige omstandigheden"
                    ],
                    "target_lang_definitions": {
                        "en": "being in a very bad, pitiable, or impoverished state"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "miserable",
                                "target_lang_sense_clarification": "poverty-stricken or wretched conditions"
                            },
                            {
                                "target_lang_word": "wretched",
                                "target_lang_sense_clarification": "of an inferior or lowly social status"
                            },
                            {
                                "target_lang_word": "abject",
                                "target_lang_sense_clarification": "extremely unpleasant and humble"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3af547f1-bfa3-3510-931c-7701c605eb4d",
                    "sense_definition": "zeer irritant, vervelend of ergerlijk",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "irritatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>ellendige</w> herrie van de buren houdt me de hele nacht wakker.",
                            "target_lang_translations": {
                                "en": "That <w>wretched</w> noise from the neighbors keeps me awake all night."
                            }
                        },
                        {
                            "text": "Ik kan die <w>ellendige</w> sleutels nergens vinden terwijl ik haast heb.",
                            "target_lang_translations": {
                                "en": "I can't find those <w>awful</w> keys anywhere while I'm in a hurry."
                            }
                        }
                    ],
                    "antonyms": [
                        "fijn",
                        "prettig"
                    ],
                    "common_phrases": [
                        "die ellendige herrie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt als versterkend bijvoeglijk naamwoord bij ergernis"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "very irritating, annoying, or aggravating"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wretched",
                                "target_lang_sense_clarification": "used to express annoyance or dislike"
                            },
                            {
                                "target_lang_word": "miserable",
                                "target_lang_sense_clarification": "causing unhappiness or annoyance"
                            },
                            {
                                "target_lang_word": "awful",
                                "target_lang_sense_clarification": "very unpleasant or annoying"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9b6ffbd-9ac8-323d-9c12-adfe93e54abd",
                    "sense_definition": "van zeer slechte kwaliteit of erg onaangenaam",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kwaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was het <w>ellendigste</w> onderdeel van de opleiding waar iedereen tegenop zag.",
                            "target_lang_translations": {
                                "en": "It was the <w>most dismal</w> part of the course that everyone was dreading."
                            }
                        },
                        {
                            "text": "We kregen <w>ellendig</w> eten geserveerd dat koud en smakeloos was.",
                            "target_lang_translations": {
                                "en": "We were served <w>wretched</w> food that was cold and tasteless."
                            }
                        }
                    ],
                    "synonyms": [
                        "erbarmelijk",
                        "rampzalig"
                    ],
                    "antonyms": [
                        "voortreffelijk",
                        "goed"
                    ],
                    "common_phrases": [
                        "een ellendig resultaat"
                    ],
                    "target_lang_definitions": {
                        "en": "of very poor quality or very unpleasant"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismal",
                                "target_lang_sense_clarification": "disappointingly inadequate or poor"
                            },
                            {
                                "target_lang_word": "wretched",
                                "target_lang_sense_clarification": "of an insignificant or poor nature"
                            },
                            {
                                "target_lang_word": "meager",
                                "target_lang_sense_clarification": "deficient or inferior in quality"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
