                "senses": [
                    {
                        "sense_id": "f8489b7e-29e8-31a2-9d49-6ee22e19da86",
                        "entry_id": "04e2bb11-960b-34a4-8c55-e8d919919c86",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99db3a4d-f62d-4ae9-b819-fd61df18f85a",
                                "sense_id": "f8489b7e-29e8-31a2-9d49-6ee22e19da86",
                                "text": "Frau Puckler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dcf622bd-e0d5-4666-90fc-11609191d0f3",
                                "sense_id": "f8489b7e-29e8-31a2-9d49-6ee22e19da86",
                                "text": "Herr Puckler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0e115c48-6b2e-4b3e-90c7-ec2772c67bd8",
                                "sense_id": "f8489b7e-29e8-31a2-9d49-6ee22e19da86",
                                "text": "Die Pucklers kommen heute aus Ostfriesland."
                            },
                            {
                                "example_id": "2d2b4a37-c42d-46cf-b8b4-5423810db43f",
                                "sense_id": "f8489b7e-29e8-31a2-9d49-6ee22e19da86",
                                "text": "Der Puckler trägt nie die Schals, die die Puckler ihm strickt."
                            },
                            {
                                "example_id": "65f6740a-a4f6-42d8-b69e-7317ee9259b1",
                                "sense_id": "f8489b7e-29e8-31a2-9d49-6ee22e19da86",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Puckler kommt, geht der Herr Puckler.“"
                            },
                            {
                                "example_id": "d02b49a7-5040-4044-853d-d7de7f75c155",
                                "sense_id": "f8489b7e-29e8-31a2-9d49-6ee22e19da86",
                                "text": "Puckler kommt und geht."
                            },
                            {
                                "example_id": "531ff2bc-5944-4fdd-90e0-5272ee338e04",
                                "sense_id": "f8489b7e-29e8-31a2-9d49-6ee22e19da86",
                                "text": "Pucklers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
