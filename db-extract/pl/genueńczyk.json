                    {
                        "translation_id": "a4e2f97e-cec0-40af-bc5c-78718a5b4d3c",
                        "source_entry_id": "f668244b-6570-3abf-919a-0ab8e32f3427",
                        "source_sense_id": "f3e7a401-807b-3f3c-9bff-8601019ec6e7",
