                "senses": [
                    {
                        "sense_id": "b6f0c657-20d0-393f-9790-47a0bf7a2180",
                        "entry_id": "ccdc683b-0eb2-36b4-be14-211bf760f64f",
                        "glosses": [
                            "\\\"erhöhte Galerie oder Tribüne, die mit einer Langseite zu einem größeren Innenraum hin geöffnet ist\\"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9cd025e-61d9-4956-b2df-fc8fedbf61bb",
                                "sense_id": "b6f0c657-20d0-393f-9790-47a0bf7a2180",
                                "text": "\"Vor der Tür parkt der rote Transporter der Waldkircher Orgelbaufirma Jäger & Brommer. Somit ist klar, was zurzeit auf der Empore im Inneren geschieht. Die Orgelbauer geben der Stadtkirche ihr Instrument zurück - nach dessen umfassender Überarbeitung.\""
                            },
                            {
                                "example_id": "3ea6c94f-6d7d-4b65-bdd1-f948801958fe",
                                "sense_id": "b6f0c657-20d0-393f-9790-47a0bf7a2180",
                                "text": "„Unter der Empore aber schimmerte eine große Blutlache.“"
                            },
                            {
                                "example_id": "08128f4b-6dc7-4ea5-a3eb-bd2153f4245b",
                                "sense_id": "b6f0c657-20d0-393f-9790-47a0bf7a2180",
                                "text": "„Verstoßen werde weiters gegen die Bestimmung des Bebauungsplanes, wonach eine Empore nur bis 50 % der theoretisch möglichen Emporenebene zulässig sei.“"
                            },
                            {
                                "example_id": "70d3aa65-456a-4b65-ae26-41d4805824c1",
                                "sense_id": "b6f0c657-20d0-393f-9790-47a0bf7a2180",
                                "text": "„Sie saß inmitten ihrer wohlhabenden Freunde auf der Empore.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "303bcc7d-9382-476a-abff-6fdd6b89e9f5",
                        "source_entry_id": "ccdc683b-0eb2-36b4-be14-211bf760f64f",
