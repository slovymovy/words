                        "glosses": [
                            "Fait de trop regarder la télévision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a614456-586a-4d72-98bc-19849650e0d8",
                                "sense_id": "cc439436-6222-33ab-9c83-f739f07743e6",
                                "text": "La téléphagie infantile."
                            },
                            {
                                "example_id": "b81bdd4d-fc5b-47a7-b903-02f52e60af02",
                                "sense_id": "cc439436-6222-33ab-9c83-f739f07743e6",
                                "text": "La téléphagie vivrait t-elle ses dernières heures ? Selon une étude récente, le temps passé devant la télévision et sur Internet serait désormais presque à égalité."
                            },
                            {
                                "example_id": "471c552d-76c4-4b24-8712-6af240011afb",
                                "sense_id": "cc439436-6222-33ab-9c83-f739f07743e6",
                                "text": "Et cette liberté nouvelle, surveillée par personne, l’écartèle désormais entre mille envies provisoires ; nuit blanche boulimique, sieste matutinale, téléphagie déjeunatoire, rendormissement aux toilettes, bains moussants digestifs et même une pause cigarette de-ci de-là, pour finir les cartouches que la défunte avait stockées d’avance."
                            }
                        ]
                    }
