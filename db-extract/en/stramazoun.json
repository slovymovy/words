                        "glosses": [
                            "A direct descending blow with the sword edge."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "61b1ae4e-464d-4ede-a007-ba1c945c47b7",
                                "sense_id": "a9bb6f22-37b5-3d4c-8b45-a198fd1aa666",
                                "text": "But I (being loth to take the deadly advauntage that lay before mee of his left ſide) made a kind of stramazoun, ran him vp to the hilts, through the Doublet, through the Shirt, and yet miſt the skin."
                            },
                            {
                                "example_id": "f8fb5f75-2bf5-423c-9bad-00ed7abdcba9",
                                "sense_id": "a9bb6f22-37b5-3d4c-8b45-a198fd1aa666",
                                "text": "Thy fincture, carricade, and sly passata,\nThy stramazon, and resolute stoccata."
                            },
                            {
                                "example_id": "c139f574-e3e1-4748-ba04-6b89722c8277",
                                "sense_id": "a9bb6f22-37b5-3d4c-8b45-a198fd1aa666",
                                "text": "There were others that made it their glory to pass for Hectors, sons of Priam, brothers of the blade; and talked of nothing but attacks, combats, reverses, stramazons, stoccados;[…]"
                            }
                        ]
                    }
