                        "examples": [
                            {
                                "example_id": "786dc868-028b-42af-960b-6098487ef24c",
                                "sense_id": "81ce9ac8-19e5-3e5d-87b2-20f978ddfce3",
                                "text": "In het veranderend humeur van zijn onderdanen tekenen zich pas de echte risico's voor koning Willem IV af. Op termijn kunnen die overigens weer volop stof bieden voor nieuwe boeken en TV-series over de Oranjes. De monarchie als permanente bron van volksvermaak. Dat is voor menig mediaconsument pas écht een geruststellende gedachte."
                            },
                            {
                                "example_id": "b4208dce-71f5-40f4-b186-5488e01f7a55",
                                "sense_id": "81ce9ac8-19e5-3e5d-87b2-20f978ddfce3",
                                "text": "AT&T claimde dat het Time Warner wel moet inlijven om te kunnen concurreren met techreuzen als Amazon, Netflix en Google in de strijd om de streamende mediaconsument. Met de fusie is een bedrag van zo'n 85 miljard dollar gemoeid."
                            }
                        ]
