                                "target_senses": [
                                    {
                                        "sense_id": "2ec74efa-b20c-3627-a4a9-8f43e3181c02",
                                        "entry_id": "138a53d1-e753-3168-ad1b-005c2fc42a8a",
                                        "glosses": [
                                            "het niet op de voorgrond treden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f1cfca3-4206-45f7-92ed-51188d32e272",
                                                "sense_id": "2ec74efa-b20c-3627-a4a9-8f43e3181c02",
                                                "text": "Maar ze had een fenomenaal vermogen om juist die lijzige, een beetje langzame uitspraak en taal te gebruiken om een zelfironische humor en verteltalent te etaleren waaraan de geparodieerde teruggetrokkenheid iets extra's toevoegde."
                                            },
                                            {
                                                "example_id": "063b0858-9af7-448d-9aa9-5cbd77734202",
                                                "sense_id": "2ec74efa-b20c-3627-a4a9-8f43e3181c02",
                                                "text": "De psychiater zei in de rechtszaal dat zijn diagnose wordt ondersteund door Breiviks gedrag: zijn teruggetrokkenheid, depressies, grootheidswaanzin, onverschilligheid tegenover leed van anderen en de tics in zijn gezicht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
