                                    {
                                        "sense_id": "3f94cdbd-d345-369a-b426-aaa7f1e8e07b",
                                        "entry_id": "160f5d02-b5a7-3172-a32f-1c71876d6075",
                                        "glosses": [
                                            "Something which covers; a covering or coating."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd8d3b79-e823-4561-ba35-1621d3448348",
                                                "sense_id": "3f94cdbd-d345-369a-b426-aaa7f1e8e07b",
                                                "text": "1658: But in the Homericall Urne of Patroclus, whatever was the solid Tegument, we finde the immediate covering to be a purple peece of silk — Sir Thomas Browne, Urne-Burial (Penguin 2005, p. 21)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6fb2ac6-d09c-30d3-be55-c37089a265b4",
                                        "entry_id": "160f5d02-b5a7-3172-a32f-1c71876d6075",
                                        "glosses": [
                                            "A natural covering of the body or of a bodily organ; an integument."
                                        ],
