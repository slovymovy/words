                    {
                        "translation_id": "75ae7f7e-668b-42cc-b6a3-857bd6f60531",
                        "source_entry_id": "3a221c0a-25a0-3fef-a85f-e9702fe5f75f",
                        "source_sense_id": "3fa0413f-f559-3e69-9c01-e1398f6274ba",
                        "target_lang_word": "radiologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radiologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9612d8a-76d1-3464-bad3-a0ce89514e0d",
                                        "entry_id": "bc5b09e8-56db-31bf-88a1-941f6d6564d9",
                                        "glosses": [
                                            "Relatif à la radiologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c293edd-babe-41b3-aa93-fdde6dffe10c",
                                                "sense_id": "a9612d8a-76d1-3464-bad3-a0ce89514e0d",
                                                "text": "Les voitures radiologiques qui ont fourni un travail intensif pendant la guerre (certaines ont permis d'examiner 10 000 blessés et davantage) ne sont pas condamnées à disparaître dans la période de paix."
                                            },
                                            {
                                                "example_id": "60e775fb-b586-4e73-8959-f236923e6fef",
                                                "sense_id": "a9612d8a-76d1-3464-bad3-a0ce89514e0d",
                                                "text": "Des anomalies majeures radiologiques (atélectasie, épanchement pleural, pneumonie et/ou adénopathies) sont peu probables en l'absence de tout signe respiratoire (sensibilité de 80 %)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63ebba02-c38f-386a-8677-084449f6d296",
                                        "entry_id": "bc5b09e8-56db-31bf-88a1-941f6d6564d9",
                                        "glosses": [
                                            "Relatif à la radioactivité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "804db5b8-3b5d-479e-84eb-719ffaa53975",
                                                "sense_id": "63ebba02-c38f-386a-8677-084449f6d296",
                                                "text": "Divers phénomènes peuvent conduire à la perte du confinement ou de la protection radiologique ou à la perte de la sous-criticité : […]."
                                            },
                                            {
                                                "example_id": "986ace44-69f9-4e72-802a-4f165e6525a4",
                                                "sense_id": "63ebba02-c38f-386a-8677-084449f6d296",
                                                "text": "La conduite de l’intervention en cas d’accident radiologique est nécessairement planifiée, mais doit toujours s'adapter au type d'événement rencontré. Il ne suffit pas d'avoir une bonne connaissance théorique du risque, il faut savoir l'évaluer sur le terrain […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
