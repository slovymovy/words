{
    "word_family": [
        "winery",
        "winemaker",
        "winemaking",
        "winy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c9aee4c-4ace-3109-b4a8-41b9cf2914c3",
                    "sense_definition": "An alcoholic drink made from fermented grape juice.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered a bottle of red <w>wine</w> to go with our dinner.",
                            "target_lang_translations": {
                                "ru": "Мы заказали бутылку красного <w>вина</w> к ужину.",
                                "zh": "我们点了一瓶红<w>葡萄酒</w>来配晚餐。"
                            }
                        },
                        {
                            "text": "France is famous for producing excellent <w>wine</w>.",
                            "target_lang_translations": {
                                "ru": "Франция славится производством превосходного <w>вина</w>.",
                                "zh": "法国以出产优质<w>葡萄酒</w>而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vino"
                    ],
                    "common_phrases": [
                        "red wine",
                        "white wine",
                        "sparkling wine",
                        "dry wine",
                        "glass of wine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Алкогольный напиток, приготовленный из перебродившего виноградного сока.",
                        "zh": "用发酵的葡萄汁制成的酒精饮料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вино",
                                "target_lang_sense_clarification": "напиток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "葡萄酒",
                                "target_lang_sense_clarification": "由葡萄汁发酵制成的酒精饮料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1bf47b7-d5d5-30da-bc13-d19a05b3fcf1",
                    "sense_definition": "A specific serving or glass of wine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter brought two <w>wines</w> to our table immediately.",
                            "target_lang_translations": {
                                "ru": "Официант сразу принес два <w>вина</w> к нашему столику.",
                                "zh": "服务员立刻给我们这桌端来了两<w>杯葡萄酒</w>。"
                            }
                        },
                        {
                            "text": "I will just have a house <w>wine</w>, please.",
                            "target_lang_translations": {
                                "ru": "Я буду просто домашнее <w>вино</w>, пожалуйста.",
                                "zh": "请给我来一<w>杯葡萄酒</w>就行，要店里的招牌款。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Порция или бокал вина.",
                        "zh": "一份葡萄酒，通常指一杯葡萄酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вино",
                                "target_lang_sense_clarification": "порция"
                            },
                            {
                                "target_lang_word": "бокал вина",
                                "target_lang_sense_clarification": "мера объема"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一杯葡萄酒",
                                "target_lang_sense_clarification": "指一份或一杯葡萄酒"
                            },
                            {
                                "target_lang_word": "一杯酒",
                                "target_lang_sense_clarification": "点酒时指一杯酒的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5d24194-0da7-306c-9aac-cbcbe6222220",
                    "sense_definition": "An alcoholic beverage made by fermenting fruits or plants other than grapes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother used to make delicious dandelion <w>wine</w> in the summer.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка летом делала вкусное <w>вино</w> из одуванчиков.",
                                "zh": "我奶奶以前夏天常酿好喝的蒲公英<w>果酒</w>。"
                            }
                        },
                        {
                            "text": "Japanese sake is often referred to as rice <w>wine</w>.",
                            "target_lang_translations": {
                                "ru": "Японское саке часто называют рисовым <w>вином</w>.",
                                "zh": "日本清酒常被称为米<w>酒</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rice wine",
                        "plum wine",
                        "fruit wine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Алкогольный напиток, приготовленный путем брожения фруктов или растений, отличных от винограда.",
                        "zh": "由葡萄以外的水果或植物发酵制成的酒精饮料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вино",
                                "target_lang_sense_clarification": "плодово-ягодное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "果酒",
                                "target_lang_sense_clarification": "由葡萄以外的水果酿成的酒"
                            },
                            {
                                "target_lang_word": "酒",
                                "target_lang_sense_clarification": "泛指由其他植物原料发酵制成的酒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e5218dc-b1ee-33eb-ad5a-6a63c1ed214e",
                    "sense_definition": "A deep reddish-purple color resembling the color of red wine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a beautiful <w>wine</w> dress to the evening gala.",
                            "target_lang_translations": {
                                "ru": "Она надела красивое платье цвета <w>бордо</w> на вечерний гала-концерт.",
                                "zh": "她穿着一条漂亮的<w>酒红色</w>连衣裙去参加晚间盛会。"
                            }
                        },
                        {
                            "text": "The walls of the library were painted in a dark <w>wine</w> shade.",
                            "target_lang_translations": {
                                "ru": "Стены библиотеки были выкрашены в темный оттенок <w>бордо</w>.",
                                "zh": "图书馆的墙壁被刷成了深<w>酒红色</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wine red",
                        "wine colored"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокий красно-фиолетовый цвет, напоминающий цвет красного вина.",
                        "zh": "一种深红偏紫、类似红葡萄酒颜色的色调。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бордо",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "винный цвет",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酒红色",
                                "target_lang_sense_clarification": "像红酒一样的深红紫色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df771a6c-352b-35c8-bf37-ec602d6fe08f",
                    "sense_definition": "Wind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold <w>wine</w> blew across the desolate moor.",
                            "target_lang_translations": {
                                "ru": "Холодный <w>ветер</w> дул над пустынной пустошью.",
                                "zh": "寒<w>风</w>吹过荒凉的沼地。"
                            }
                        },
                        {
                            "text": "We could hear the <w>wine</w> howling through the trees all night.",
                            "target_lang_translations": {
                                "ru": "Мы слышали, как <w>ветер</w> выл среди деревьев всю ночь.",
                                "zh": "我们整夜都能听见<w>风</w>在树林间呼啸。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ветер (диалектное или устаревшее значение).",
                        "zh": "风。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ветер",
                                "target_lang_sense_clarification": "диалектное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "风",
                                "target_lang_sense_clarification": "方言或古旧用法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f169c7fd-5b54-3ebc-a896-ab09c32e69d4",
                    "sense_definition": "To entertain someone with food and drink, typically to impress them.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "entertain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>wined</w> and dined the potential investors at a luxury hotel.",
                            "target_lang_translations": {
                                "ru": "Компания <w>угощала</w> и развлекала потенциальных инвесторов в роскошном отеле.",
                                "zh": "公司在一家豪华酒店设宴<w>款待</w>潜在投资者。"
                            }
                        },
                        {
                            "text": "He loves to <w>wine</w> and dine his clients to close the deal.",
                            "target_lang_translations": {
                                "ru": "Он любит <w>угощать</w> и развлекать своих клиентов, чтобы заключить сделку.",
                                "zh": "为了谈成生意，他喜欢设宴<w>款待</w>客户。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wine and dine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угощать кого-либо едой и напитками, обычно чтобы произвести впечатление.",
                        "zh": "用酒食招待某人，通常是为了给对方留下深刻印象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угощать вином",
                                "target_lang_sense_clarification": "развлекать"
                            },
                            {
                                "target_lang_word": "потчевать",
                                "target_lang_sense_clarification": "устаревшее/книжное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "款待",
                                "target_lang_sense_clarification": "用酒食招待别人"
                            },
                            {
                                "target_lang_word": "设宴招待",
                                "target_lang_sense_clarification": "特指设宴招待以取悦或笼络对方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7a10f07-6eb2-3d8f-845a-fb2cf9db412e",
                    "sense_definition": "To perform a rhythmic dance involving the rotation of the hips and waist.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd began to <w>wine</w> to the beat of the dancehall music.",
                            "target_lang_translations": {
                                "ru": "Толпа начала <w>танцевать вайн</w> в такт дэнсхолл-музыке.",
                                "zh": "人群开始随着舞厅雷鬼音乐的节拍<w>扭动臀胯</w>。"
                            }
                        },
                        {
                            "text": "She taught her friends how to <w>wine</w> properly at the party.",
                            "target_lang_translations": {
                                "ru": "Она учила своих подруг, как правильно <w>двигать бедрами</w> на вечеринке.",
                                "zh": "她在派对上教朋友们怎样正确地<w>扭动臀胯</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Caribbean / Jamaican"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнять ритмичный танец, включающий вращение бедрами и талией.",
                        "zh": "跳一种有节奏地转动臀部和腰部的舞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "танцевать вайн",
                                "target_lang_sense_clarification": "карибский танец"
                            },
                            {
                                "target_lang_word": "вращать бедрами",
                                "target_lang_sense_clarification": "движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扭动臀胯",
                                "target_lang_sense_clarification": "加勒比英语中指随着节奏转动腰胯跳舞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b018b0d-9b38-343d-a7b9-a14d3a8367c2",
                    "sense_definition": "To drink wine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "consume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day, we <w>wined</w> and relaxed by the fire.",
                            "target_lang_translations": {
                                "ru": "После долгого дня мы <w>пили вино</w> и отдыхали у камина.",
                                "zh": "忙了一整天后，我们一边<w>喝葡萄酒</w>一边在火炉旁放松。"
                            }
                        },
                        {
                            "text": "They <w>wined</w> late into the night celebrating their victory.",
                            "target_lang_translations": {
                                "ru": "Они <w>пили вино</w> до глубокой ночи, празднуя победу.",
                                "zh": "他们庆祝胜利，一直<w>喝葡萄酒</w>到深夜。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пить вино.",
                        "zh": "喝葡萄酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пить вино",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喝葡萄酒",
                                "target_lang_sense_clarification": "指饮用葡萄酒"
                            },
                            {
                                "target_lang_word": "饮酒",
                                "target_lang_sense_clarification": "较概括的说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "50ee57a0-ac7c-31e9-9835-705be86fa948",
                    "sense_definition": "A free compatibility layer software that allows Windows applications to run on Unix-like operating systems.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "software",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "I installed <w>Wine</w> on my Linux computer to play my favorite games.",
                            "target_lang_translations": {
                                "ru": "Я установил <w>Wine</w> на свой компьютер с Linux, чтобы играть в любимые игры.",
                                "zh": "我在自己的 Linux 电脑上安装了<w>Wine</w>，这样就能玩我最喜欢的游戏。"
                            }
                        },
                        {
                            "text": "The developer used <w>Wine</w> to test the application on a different platform.",
                            "target_lang_translations": {
                                "ru": "Разработчик использовал <w>Wine</w> для тестирования приложения на другой платформе.",
                                "zh": "开发者使用<w>Wine</w>在另一种平台上测试这个应用程序。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Программное обеспечение, позволяющее запускать приложения Windows на Unix-подобных системах.",
                        "zh": "一种自由兼容层软件，可让 Windows 应用程序在类 Unix 操作系统上运行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Wine",
                                "target_lang_sense_clarification": "программа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "Wine",
                                "target_lang_sense_clarification": "软件名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fca9ced-9055-3774-910b-37c5c5c4d9ba",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Wine</w> will see you in his office now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Вайн</w> примет вас в своем кабинете сейчас.",
                                "zh": "<w>瓦因</w>先生现在会在他的办公室见你。"
                            }
                        },
                        {
                            "text": "We met a family named <w>Wine</w> during our vacation.",
                            "target_lang_translations": {
                                "ru": "Мы познакомились с семьей по фамилии <w>Вайн</w> во время отпуска.",
                                "zh": "我们度假时遇到了一户姓<w>瓦因</w>的人家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вайн",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瓦因",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}