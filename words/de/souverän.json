                {
                    "sense_id": "f04c6c00-32d7-3743-9746-c14d1db453ce",
                    "sense_definition": "im Auftreten sicher, ruhig und überlegen wirkend",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "haltung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Sprecherin reagierte auf die kritischen Fragen des Journalisten vollkommen <w>souverän</w>."
                        },
                        {
                            "text": "Mit einem <w>souveränen</w> Auftreten konnte sie die gesamte Prüfungskommission schnell überzeugen."
                        }
                    ],
                    "common_phrases": [
