                ],
                "senses": [
                    {
                        "sense_id": "9a8fa1b7-31a4-3a76-a4f4-aa3e65862290",
                        "entry_id": "506e5f62-2f76-3007-a212-568dd0dc4749",
                        "glosses": [
                            "Philosophie politique libérale, demandant au pouvoir de ne pas intervenir, notamment dans le domaine économique."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "b718780b-785a-4aca-84cb-5701fd45af35",
                                "sense_id": "9a8fa1b7-31a4-3a76-a4f4-aa3e65862290",
                                "text": "Le laissez-faire ne signifie pas de laisser agir des forces mécaniques sans âme. Il signifie de permettre à chaque individu de choisir comment il veut coopérer dans la division sociale du travail."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6219e545-1f10-4500-8946-a7c60959b5aa",
                        "source_entry_id": "506e5f62-2f76-3007-a212-568dd0dc4749",
                        "source_sense_id": "9a8fa1b7-31a4-3a76-a4f4-aa3e65862290",
                        "target_lang_word": "laissez-faire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laissez-faire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9b69741-2416-3243-a828-e020eb4d2970",
                                        "entry_id": "4071f08f-06fb-327c-a9ac-23fa384e6d6b",
                                        "glosses": [
                                            "Alternative form of laissez faire."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90fba2dc-5fbd-4cbc-aa95-e48d39aa743a",
                                                "sense_id": "b9b69741-2416-3243-a828-e020eb4d2970",
                                                "text": "As the economic derivative of libertarianism, laissez-faire capitalism is an economics of life, of rationality."
                                            },
                                            {
                                                "example_id": "6806debc-8176-45f7-9f90-33ad4d00feeb",
                                                "sense_id": "b9b69741-2416-3243-a828-e020eb4d2970",
                                                "text": "Francis is saying that the environmental crisis is really a crisis in laissez-faire capitalism."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laissez-faire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "198fd81c-af1f-364d-9263-778a501195bd",
                                        "entry_id": "46e4a61d-8b2a-3789-8114-2dff4b892ead",
                                        "glosses": [
                                            "Alternative form of laissez faire."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e6e3990-a3b6-45fa-8bca-9e566d6e5a99",
                                                "sense_id": "198fd81c-af1f-364d-9263-778a501195bd",
                                                "text": "‘How about we all try a policy of non-involvement for once? A little laissez-faire?’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
