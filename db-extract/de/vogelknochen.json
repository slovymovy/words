                        "examples": [
                            {
                                "example_id": "1b7dd7fc-d130-42cf-a3e3-5a043a426815",
                                "sense_id": "6bc9a862-7275-3d4b-bbc2-aef6a21bdcee",
                                "text": "„Andere waren aus Vogelknochen gefertigt und sollten die Klitorisschenkel reizen, welche die Vagina umgeben.“"
                            },
                            {
                                "example_id": "a6571116-2853-4207-a139-dfd3a86d35d6",
                                "sense_id": "6bc9a862-7275-3d4b-bbc2-aef6a21bdcee",
                                "text": "„Kröten- und Vogelknochen klapperten auf den Tisch, gelbe Zähne, zierliche Elfenbeinteile, exotisch und namenlos, ein schwarzes kleines Herz, vertrocknet und steinhart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
