                "senses": [
                    {
                        "sense_id": "ccc0a097-d259-342d-a433-8409c1a89ed2",
                        "entry_id": "eb1b6198-9fe3-3475-9f8b-a23007a54560",
                        "glosses": [
                            "Bodenschicht, in der sich salzfreies Wasser befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b0b5a5b-d916-471c-8c6e-e6ba50e32891",
                                "sense_id": "ccc0a097-d259-342d-a433-8409c1a89ed2",
                                "text": "„Dass die Süßwasseraquifere leer laufen und versalzen, erwähnen die Firmen in ihren Umweltberichten nicht.“"
                            },
                            {
                                "example_id": "77c33d1d-716b-4db8-9e1b-f8fddeac5bfc",
                                "sense_id": "ccc0a097-d259-342d-a433-8409c1a89ed2",
                                "text": "„Sollte CO2 in einen Süßwasseraquifer eindringen, wären die Auswirkungen lokal begrenzt.“"
                            },
                            {
                                "example_id": "3dbfba90-dac1-4d35-a297-357b947a411b",
                                "sense_id": "ccc0a097-d259-342d-a433-8409c1a89ed2",
                                "text": "„Die Gründe für die Intrusion von salinen Wässern in Süßwasseraquifere sind vielfältig, sowohl natürliche als auch anthropogene Einflüsse kommen bekanntlich in Betracht.“"
                            },
                            {
                                "example_id": "7ec1d86a-533a-4ec8-a2d9-fc8aea8f119a",
                                "sense_id": "ccc0a097-d259-342d-a433-8409c1a89ed2",
                                "text": "„Küstennahe Süßwasseraquifere sind durch das Vordringen von Salzwasser bedroht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
