                "senses": [
                    {
                        "sense_id": "0aab8f88-11fc-315d-be54-62b127cd2e79",
                        "entry_id": "73df07f5-6d6d-3a45-ac37-873556c9726d",
                        "glosses": [
                            "Kundgebung mit einer Vielzahl von Teilnehmern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29b848ca-fd8e-4ae9-851d-9c0a556ccee0",
                                "sense_id": "0aab8f88-11fc-315d-be54-62b127cd2e79",
                                "text": "„Auf Erdoğans Massenkundgebungen kann man ein weiteres Geheimnis seines Erfolgs entdecken, und zwar an den Gesichtern der Frauen. Wie so vieles erinnert auch diese libidinöse Dimension an Vladimir Putin.“"
                            },
                            {
                                "example_id": "74e8351f-d94b-4f7e-adaa-35d46165128b",
                                "sense_id": "0aab8f88-11fc-315d-be54-62b127cd2e79",
                                "text": "„Gleichzeitig organisierten sie in den Städten, in denen sie die Mehrheit hatten, gewaltige Massenkundgebungen, die oft genug zu blutigen Zusammenstößen mit tschechischen Demonstranten führten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
