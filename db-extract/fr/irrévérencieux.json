                        ],
                        "form": "irrévérencieuse"
                    },
                    {
                        "form_id": "55bc0693-fce0-46f6-adfa-7d3937d37552",
                        "entry_id": "c92bbdd9-4576-31ad-970f-7ab5a021e184",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "irrévérencieuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db245524-dd2e-324b-8ea5-688db498218e",
                        "entry_id": "c92bbdd9-4576-31ad-970f-7ab5a021e184",
                        "glosses": [
                            "Qui manque de révérence, de respect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bfe764a-7361-4959-b1f6-669154449354",
                                "sense_id": "db245524-dd2e-324b-8ea5-688db498218e",
                                "text": "Un propos irrévérencieux."
                            },
                            {
                                "example_id": "a0723688-7b1f-433f-9837-3ce6cd50930c",
                                "sense_id": "db245524-dd2e-324b-8ea5-688db498218e",
                                "text": "Je suis bien trop irrévérencieux pour me permettre une opinion sur des questions aussi graves."
                            },
                            {
                                "example_id": "2e1b1679-cc35-40cf-8d8e-497c031e78d2",
                                "sense_id": "db245524-dd2e-324b-8ea5-688db498218e",
                                "text": "Son geste irrévérencieux n’a pas eu l’heur de plaire au parquet, qui l’a poursuivi pour outrage envers les fonctionnaires chargés de visualiser les images au centre d’identification de Rennes, rapporte LCI (25/4)."
                            },
                            {
                                "example_id": "e1169205-49c6-4397-a98f-f573e23b1312",
                                "sense_id": "db245524-dd2e-324b-8ea5-688db498218e",
                                "text": "L'auto-ironie et l'humour irrévérencieux de Leblanc apparaissent dans les innombrables surnoms qu'il s'attribue et dont il fait suivre sa signature : on découvre « Peanuts », « la grande folle » ou « Pauline Julien in drag », « Gérard Lefou », la « putain paranoïaque », « l'énergumène », « l'Hostie crémeuse », « Gérald Piaf », parmi d'autres."
                            },
                            {
                                "example_id": "bd37e43a-467c-4cdc-80ad-021b4dc8fb4f",
                                "sense_id": "db245524-dd2e-324b-8ea5-688db498218e",
                                "text": "Ses irrévérencieuses notes de cumin, sa texture joyeusement croustillante, ainsi que sa sauce relevée et langoureuse sur le palais — inspirée de la typique Bull’s Eye du sud-ouest des États-Unis —, me plaisent plus que tout."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a99aecb-d2b1-4720-8611-d30f156f9709",
                        "source_entry_id": "c92bbdd9-4576-31ad-970f-7ab5a021e184",
                        "source_sense_id": "db245524-dd2e-324b-8ea5-688db498218e",
                        "target_lang_word": "respektlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "respektlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                        "entry_id": "22bcd000-0015-36fd-b5a8-4c4c1483684d",
                                        "glosses": [
                                            "ohne Respekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38dfdd90-de43-4cf1-b861-d0693cca764b",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "Sein respektloses Verhalten gegenüber dem Lehrer hatte Konsequenzen."
                                            },
                                            {
                                                "example_id": "86cdd514-9b04-4a1a-81cb-ba6c796cbc0f",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Ein Kunde einer Pizzeria dürfte einen gehörigen Schock erlebt haben, als sein Blick auf den Kassenzettel fiel: Ein Angestellter des Restaurants hatte darauf respektlose Worte hinterlassen.“"
                                            },
                                            {
                                                "example_id": "d0694205-8972-41a7-978c-71f6e73da939",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Double-Gewinner Niko Kovac vom FC Bayern München hat einen respektlosen Umgang mit den Fußball-Trainern in der Bundesliga beklagt.“"
                                            },
                                            {
                                                "example_id": "3d5dd527-f2f3-40ed-80e6-5802f61e0943",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Über Trumps respektlosen Umgang mit verheirateten Frauen hat auch Trumps ehemalige Geschäftspartnerin Jill Harth berichtet, die über einen längeren Zeitraum von ihm sexuell belästigt worden sein soll.“"
                                            },
                                            {
                                                "example_id": "0b5fdaf6-f058-429a-b0b9-cb023ee2c910",
                                                "sense_id": "0f8dad19-54e2-341f-b0f0-33030540559c",
                                                "text": "„Diskus-Olympiasieger Christoph Harting hat nach seinen respektlosen Äußerungen und herablassenden Sprüchen über Verband und Konkurrenten offenbar einen Denkzettel erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a015c16-0736-4e77-9533-05282fddebe8",
                        "source_entry_id": "c92bbdd9-4576-31ad-970f-7ab5a021e184",
