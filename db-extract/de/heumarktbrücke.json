                ],
                "senses": [
                    {
                        "sense_id": "6b92ae63-c0c0-3eff-b7e6-d71b1b5bbe98",
                        "entry_id": "17e0f80f-ccf4-3d10-8490-86b42780faeb",
                        "glosses": [
                            "Überführung eines Gewässers (Brücke), die ihren Eigennamen dadurch erhielt, dass sie zu einem Marktplatz führte – in Wien zum Beispiel zum Handelsplatz für aus Ungarn importiertes Heu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ea33bcd-b77b-4df9-81ad-a0e533237129",
                                "sense_id": "6b92ae63-c0c0-3eff-b7e6-d71b1b5bbe98",
                                "text": "„Bisher war die Heumarktbrücke die letzte Straßenbrücke nach Süden hin.“"
                            },
                            {
                                "example_id": "c60cc500-29aa-462a-b2e4-589ac5864dd8",
                                "sense_id": "6b92ae63-c0c0-3eff-b7e6-d71b1b5bbe98",
                                "text": "„Die Lage einer neuen Brücke südlich der Heumarktbrücke wurde geprüft und der Wiener Platz durchgearbeitet.“"
                            },
                            {
                                "example_id": "9825ab72-574e-4dd4-910c-cf4bde4aa038",
                                "sense_id": "6b92ae63-c0c0-3eff-b7e6-d71b1b5bbe98",
                                "text": "„Stereotype Blöcke sollten diese Magistralen säumen, an ihrer Kreuzung sollte ein Platz entstehen, und die Verlängerung der Ost-West-Achse sollte über die Heumarktbrücke ins rechtsrheinische Köln-Deutz führen, wo ein gigantisches Gauforum geplant war.“"
                            },
                            {
                                "example_id": "7a23bddd-b64c-4112-afc0-b72149b54e5b",
                                "sense_id": "6b92ae63-c0c0-3eff-b7e6-d71b1b5bbe98",
                                "text": "„Seine Konstruktion ist vom Statiker besonders geistreich erdacht als kontinuierliches dünnwandiges Tragwerk aus zwei tragenden Platten—dem Boden des Saals und der Decke der Halle — und Zungenwänden dazwischen, gewissermaßen nach dem Prinzip des I-Trägers aus Flanschen und Stegen zusammengesetzt, eine Kastenkonstruktion, vergleichbar der neuen Heumarktbrücke.“"
                            },
                            {
                                "example_id": "b8941258-a102-4064-be00-9beaf9339120",
                                "sense_id": "6b92ae63-c0c0-3eff-b7e6-d71b1b5bbe98",
                                "text": "„Der Weg führte uns — wir domizilierten damals in der Weihburggasse Nr. 918, im Baron Löwenthalschen Hause — durch das Karolinentor auf das Wasserglacis zur damals noch hölzernen Heumarktbrücke, wo ich den blinden, auch später noch lange dort sitzenden Leiermann, mit der Zipfelmütze auf dem Kopfe, samt seinen Walzer- und Marschweisen, noch frisch im Gedächtnis habe und der auch ein richtiger Typus gewesen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
