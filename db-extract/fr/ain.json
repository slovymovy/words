                                                "sense_id": "5fbc661b-e3af-38ef-83fa-0bbb29ff6b87",
                                                "text": "Der Ain mündet östlich von Lyon in die Rhône."
                                            },
                                            {
                                                "example_id": "db2d0503-d6f3-4666-bdd1-98612b54d305",
                                                "sense_id": "5fbc661b-e3af-38ef-83fa-0bbb29ff6b87",
                                                "text": "Die Quelle des Ain liegt circa zwanzig Kilometer westlich der Schweizer Grenze."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ain",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9d277f6-9535-3ff9-85a4-c89ab9aa5669",
                                        "entry_id": "8c118cc9-1d96-3117-9330-b14bf1b88568",
