                ],
                "senses": [
                    {
                        "sense_id": "8e9dc069-5970-378a-85da-fff3927adea8",
                        "entry_id": "b130b703-b03e-388d-aad5-15b3066b989e",
                        "glosses": [
                            "Schraube mit Oberteil in Form eines Hammers, welches in der Regel durch das Einpassen in eine Nut fixiert wird"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "7ce2547a-d378-4883-8d4d-1b9e991d7da6",
                                "sense_id": "8e9dc069-5970-378a-85da-fff3927adea8",
                                "text": "„Eine verschweißte Hammerkopfschraube an einer Halterung war gerissen, die das Fünf-Tonnen-Teil vor dem Kippen bewahren sollte.“"
                            },
                            {
                                "example_id": "d287fb73-54d4-43df-8fed-60093ce5fbae",
                                "sense_id": "8e9dc069-5970-378a-85da-fff3927adea8",
                                "text": "„Ergänzende Untersuchungen an Normalkupplungen haben gezeigt, daß die Vorspannkraft nach dem Anziehen der Hammerkopfschraube abnimmt […]“"
                            },
                            {
                                "example_id": "735140ef-8109-4e66-af67-1f12482398b8",
                                "sense_id": "8e9dc069-5970-378a-85da-fff3927adea8",
                                "text": "„[Für das Einsetzen der Schraube] beinhaltet das Verbindungsprofil eine Aufnahmevorrichtung in Form einer C-Schiene, in die die Hammerkopfschraube eingeführt wird.“"
                            },
                            {
                                "example_id": "c83db5f0-d06b-465e-bcc2-f7dc301240f7",
                                "sense_id": "8e9dc069-5970-378a-85da-fff3927adea8",
                                "text": "„Die selbstgebaute[sic] Version besteht lediglich aus einem einfachen Multiplexbrettchen, das mit zwei Hammerkopfschrauben in den Nuten der Auflagehilfe geführt und fixiert wird.“"
                            },
                            {
                                "example_id": "5f8fc085-c0a6-4ef2-9940-7434484fde3a",
                                "sense_id": "8e9dc069-5970-378a-85da-fff3927adea8",
                                "text": "„Die Hammerkopfschraube wird in die Profilnut eingeschwenkt und kann somit auch in bestehende Systeme nachträglich eingebracht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
