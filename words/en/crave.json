{
    "word_family": [
        "craving",
        "craver"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67df2fb1-44af-3d29-86f5-84f2f239f793",
                    "sense_definition": "To desire something very strongly, especially to satisfy a physical or emotional appetite.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day at work, I often <w>crave</w> something sweet like chocolate or ice cream.",
                            "target_lang_translations": {
                                "ru": "После долгого рабочего дня мне часто безумно <w>хочется</w> чего-нибудь сладкого, например, шоколада или мороженого."
                            }
                        },
                        {
                            "text": "Many people <w>crave</w> attention from others to feel validated and important in their social circles.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>жаждут</w> внимания окружающих, чтобы чувствовать себя признанными и значимыми в своем кругу общения."
                            }
                        }
                    ],
                    "synonyms": [
                        "long for",
                        "yearn for",
                        "hunger for",
                        "thirst for"
                    ],
                    "antonyms": [
                        "dislike",
                        "spurn",
                        "reject"
                    ],
                    "common_phrases": [
                        "crave attention",
                        "crave sweets",
                        "crave excitement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно желать чего-либо, особенно для удовлетворения физической или эмоциональной потребности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаждать",
                                "target_lang_sense_clarification": "страстно хотеть чего-то"
                            },
                            {
                                "target_lang_word": "очень хотеть",
                                "target_lang_sense_clarification": "сильное желание, часто еды"
                            },
                            {
                                "target_lang_word": "испытывать тягу",
                                "target_lang_sense_clarification": "сильное влечение к чему-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a3b0e2a-f7c8-3995-8d24-007ab702f905",
                    "sense_definition": "To ask for something earnestly or humbly, often from a person in a position of authority.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>crave</w> your indulgence for a few moments while I explain the reasoning behind this difficult decision.",
                            "target_lang_translations": {
                                "ru": "Я <w>прошу</w> вашего снисхождения на несколько минут, пока я объясняю причины этого трудного решения."
                            }
                        },
                        {
                            "text": "The prisoner decided to <w>crave</w> pardon from the king in hopes of receiving a lighter sentence.",
                            "target_lang_translations": {
                                "ru": "Заключенный решил <w>испросить</w> помилования у короля в надежде на смягчение приговора."
                            }
                        }
                    ],
                    "synonyms": [
                        "beg",
                        "beseech",
                        "entreat",
                        "implore"
                    ],
                    "common_phrases": [
                        "crave your indulgence",
                        "crave pardon"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in formal or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Усердно или смиренно просить о чем-либо, часто у лица, облеченного властью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молить",
                                "target_lang_sense_clarification": "смиренно просить"
                            },
                            {
                                "target_lang_word": "испрашивать",
                                "target_lang_sense_clarification": "официально или вежливо просить"
                            },
                            {
                                "target_lang_word": "умолять",
                                "target_lang_sense_clarification": "настойчиво просить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "715b7425-f692-392f-a8cb-21757c6ada9c",
                    "sense_definition": "To require or call for a specific action or condition as a necessity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "requirement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The delicate nature of these diplomatic negotiations <w>craves</w> wary walking to avoid any international misunderstandings.",
                            "target_lang_translations": {
                                "ru": "Деликатный характер этих дипломатических переговоров <w>требует</w> крайней осторожности, чтобы избежать любых международных недоразумений."
                            }
                        },
                        {
                            "text": "This complex legal situation <w>craves</w> immediate attention from the most experienced lawyers in the firm.",
                            "target_lang_translations": {
                                "ru": "Эта сложная юридическая ситуация <w>взывает</w> к немедленному вниманию со стороны самых опытных юристов фирмы."
                            }
                        }
                    ],
                    "synonyms": [
                        "require",
                        "demand",
                        "necessitate"
                    ],
                    "common_phrases": [
                        "craves wary walking"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "this usage is primarily found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Требовать определенных действий или условий в силу необходимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "требовать",
                                "target_lang_sense_clarification": "нуждаться в чем-либо"
                            },
                            {
                                "target_lang_word": "взывать",
                                "target_lang_sense_clarification": "о ситуации, требующей внимания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "05a253e7-c37d-32fa-8418-39ca71de4467",
                    "sense_definition": "A formal application made to a court to request a specific order or legal action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer submitted a formal <w>crave</w> to the court to ensure the documents remained confidential.",
                            "target_lang_translations": {
                                "ru": "Адвокат подал официальное <w>ходатайство</w> в суд, чтобы обеспечить конфиденциальность документов."
                            }
                        },
                        {
                            "text": "The judge reviewed the <w>crave</w> before deciding whether to grant the requested injunction.",
                            "target_lang_translations": {
                                "ru": "Судья рассмотрел <w>прошение</w>, прежде чем решить, удовлетворять ли запрос о судебном запрете."
                            }
                        }
                    ],
                    "synonyms": [
                        "petition",
                        "application",
                        "motion"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in Scots law"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заявление в суд с просьбой о вынесении определенного постановления или совершении процессуального действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходатайство",
                                "target_lang_sense_clarification": "официальная просьба в суде"
                            },
                            {
                                "target_lang_word": "прошение",
                                "target_lang_sense_clarification": "формальное обращение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}