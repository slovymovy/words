                "senses": [
                    {
                        "sense_id": "005c92ae-baf2-3496-838b-d3701e0d5817",
                        "entry_id": "02cc960c-5c8b-3c2d-8520-73da78daf6ef",
                        "glosses": [
                            "Transformer en bunker, protéger comme pour un bunker."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c5d59d6-5efa-4b33-814f-1382e19240b1",
                                "sense_id": "005c92ae-baf2-3496-838b-d3701e0d5817",
                                "text": "Un «noyau dur» pour les centrales : «bunkeriser» les fonctions vitales des réacteurs."
                            },
                            {
                                "example_id": "801b018a-2057-4f33-b14a-75430d77072f",
                                "sense_id": "005c92ae-baf2-3496-838b-d3701e0d5817",
                                "text": "Quelques mois avant sa chute, Mouammar Kadhafi, l’ancien bédouin devenu dictateur, s’est complètement bunkerisé, « pris au piège de son propre système », écrit Hélène Bravin."
                            }
                        ]
                    }
