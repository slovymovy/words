                "senses": [
                    {
                        "sense_id": "1134eb1a-b117-3ac2-b025-f421cce69f3f",
                        "entry_id": "153cb5bd-e086-38e5-9d63-46461644bf0a",
                        "glosses": [
                            "Textilie (meist Teppich), die ursprünglich in französischen Manufakturen, später in mehreren Orten Europa geknüpft wurde"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "5a0f7a01-8aab-4bc2-97db-2efbe57f4849",
                                "sense_id": "1134eb1a-b117-3ac2-b025-f421cce69f3f",
                                "text": "„In Paris waren die teuren Savonnerien ein Privileg der Krone, aber in Bonn konnte jeder, der es sich leisten konnte, eine Savonnerie erwerben.“"
                            },
                            {
                                "example_id": "552209ff-8ed0-409f-8aa4-1f253bd2f399",
                                "sense_id": "1134eb1a-b117-3ac2-b025-f421cce69f3f",
                                "text": "„Am prächtigsten mit Savonnerien ausgestattet war das Buen Retiro des Bonner Residenzschlosses.“"
                            },
                            {
                                "example_id": "0faafd97-5fba-41dc-a7f8-604bb2e709cd",
                                "sense_id": "1134eb1a-b117-3ac2-b025-f421cce69f3f",
                                "text": "„Im als zusätzliche Bergungsstelle zugewiesenen Tresorraum der Landwirtschaftlichen Krankenkasse für Wien und Niederdonau in der Seitzergasse2-4 deponierte das Kunstgewerbemuseum am 23. September 1942 einen Renaissancetisch und fünf Kisten mit Teppichen und Savonnerien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
