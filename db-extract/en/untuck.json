                "senses": [
                    {
                        "sense_id": "5918c4f0-4e98-3083-b88c-07213de4b878",
                        "entry_id": "a1c6c207-6efb-335b-812d-0a7f0a61f37d",
                        "glosses": [
                            "To remove something from a relatively hidden location or position where it is tucked."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "23511698-e38e-44f8-8f36-a0e2be4afe67",
                                "sense_id": "5918c4f0-4e98-3083-b88c-07213de4b878",
                                "text": "As soon as work is over, I'm going to untuck this shirt and take off my shoes."
                            },
                            {
                                "example_id": "c192cf0c-707c-46f1-8fd2-5a0b215d0f76",
                                "sense_id": "5918c4f0-4e98-3083-b88c-07213de4b878",
                                "text": "The cat will wake up in a tightly curled position, then untuck her head, and gradually her limbs, and then stretch."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8961b06-a7b9-368b-9f00-4bcc09bc0fb9",
                        "entry_id": "a1c6c207-6efb-335b-812d-0a7f0a61f37d",
                        "glosses": [
                            "To remove that which is concealing one’s penis and testicles such as gaff or adhesive tape."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37f83599-fef2-4adc-997a-c0157d04170a",
                        "source_entry_id": "a1c6c207-6efb-335b-812d-0a7f0a61f37d",
                        "source_sense_description": "remove from a hidden location",
                        "target_lang_word": "ressortir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ressortir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f68fb67-126c-30e0-abe0-c32d6195d111",
                                        "entry_id": "9d2d42c8-5185-37b4-bd2a-9130fd6bae94",
                                        "glosses": [
                                            "Sortir de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27255805-c1b7-48d7-a8ff-faf2d0120c2d",
                                                "sense_id": "7f68fb67-126c-30e0-abe0-c32d6195d111",
                                                "text": "Pour preuve, Netflix, avec une série animée, et Mattel, avec une nouvelle gamme de jouets, ont ressorti Musclor de la naphtaline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b7682a8-5014-3700-9ad8-d2fd6b70f139",
                                        "entry_id": "9d2d42c8-5185-37b4-bd2a-9130fd6bae94",
                                        "glosses": [
                                            "Sortir après être entré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd714404-93ee-4df4-ad55-9f0d6753a71b",
                                                "sense_id": "3b7682a8-5014-3700-9ad8-d2fd6b70f139",
                                                "text": "Une jeune fille a été frappée d’un coup de baïonnette à la mâchoire gauche et l’arme est ressortie par la pommette droite."
                                            },
                                            {
                                                "example_id": "901e5239-c242-44d9-8184-f41a11908abc",
                                                "sense_id": "3b7682a8-5014-3700-9ad8-d2fd6b70f139",
                                                "text": "[…], il entra dans le bois, d’où il ressortit un peu après, écorçant avec son couteau une trique de grosseur assez respectable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cd027f1-fa76-3143-9eba-3c1175394949",
                                        "entry_id": "9d2d42c8-5185-37b4-bd2a-9130fd6bae94",
                                        "glosses": [
                                            "Apparaître en opposition frappante, saillante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1baa018d-af75-425d-99d3-9b7aa9b87829",
                                                "sense_id": "7cd027f1-fa76-3143-9eba-3c1175394949",
                                                "text": "Les malléoles ressortaient nettement."
                                            },
                                            {
                                                "example_id": "d30a0866-214d-4c81-9f69-f269ffb4e961",
                                                "sense_id": "7cd027f1-fa76-3143-9eba-3c1175394949",
                                                "text": "Les ombres font ressortir les lumières. – De légers défauts semblent faire valoir davantage d’heureuses qualités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53c0fc45-8348-3dbe-803c-2d1397771918",
                                        "entry_id": "9d2d42c8-5185-37b4-bd2a-9130fd6bae94",
                                        "glosses": [
                                            "Résulter, se dégager, apparaître comme conséquence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "907d7938-dfd7-4c14-a300-286a78726158",
                                                "sense_id": "53c0fc45-8348-3dbe-803c-2d1397771918",
                                                "text": "À en juger par le calme des promeneurs, il ressortait que personne ne s’était aperçu de quoi que ce fût."
                                            },
                                            {
                                                "example_id": "ea2528f8-462f-428f-86f3-a81c86a5bbc0",
                                                "sense_id": "53c0fc45-8348-3dbe-803c-2d1397771918",
                                                "text": "Il en ressort que la présence de MCPA a pour effet de réduire la période d'emploi du mélange ternaire (3,6-DCP + mécoprop + MCPA) par rapport au binaire (3,6-DCP + mécoprop) de la mi-tallage au début montaison au lieu de début tallage au début montaison."
                                            },
                                            {
                                                "example_id": "25515cd1-9992-46b6-ba8b-894fdc249330",
                                                "sense_id": "53c0fc45-8348-3dbe-803c-2d1397771918",
                                                "text": "Il ressort des termes mêmes de l’article 38 de la Constitution que c’est à sa demande que le Gouvernement peut être autorisé par le Parlement à prendre par ordonnances des mesures qui sont normalement du domaine de la loi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ressortir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6c9994a-d7d0-372a-af55-e1a5a861669c",
                                        "entry_id": "57811dc6-73ef-3b43-a4b3-203fb4122df7",
                                        "glosses": [
                                            "Être du ressort de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e045466-9e62-44d7-8e58-0c884dab0d92",
                                                "sense_id": "b6c9994a-d7d0-372a-af55-e1a5a861669c",
                                                "text": "L’affaire ressortit à la cour d’assises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4ff47e3-0a49-30f7-8b4e-332efa24e3d6",
                                        "entry_id": "57811dc6-73ef-3b43-a4b3-203fb4122df7",
                                        "glosses": [
                                            "Concerner, se rapporter à."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6598c242-d8fc-4a0d-b2ae-27fe939d8f24",
                                                "sense_id": "b4ff47e3-0a49-30f7-8b4e-332efa24e3d6",
                                                "text": "Ces gosses, ils ont une hiérarchie compliquée, ressortissant à Ubu-Roi et à Flaubert…"
                                            },
                                            {
                                                "example_id": "29c71419-5f89-4390-8b23-287ed32d8635",
                                                "sense_id": "b4ff47e3-0a49-30f7-8b4e-332efa24e3d6",
                                                "text": "Un peu comme les étudiants, jadis, ressortissaient au doyen."
                                            },
                                            {
                                                "example_id": "1f7d2892-fcb0-422b-ac60-6a91f99b9370",
                                                "sense_id": "b4ff47e3-0a49-30f7-8b4e-332efa24e3d6",
                                                "text": "D'évidence, cette phraséologie électorale ressortissait à sa plus pauvre veine ; le « fier archer » s'efforçant aux plates promesses d'un aspirant à la Chambre endosserait-il la livrée du batteur d’estrade ?"
                                            },
                                            {
                                                "example_id": "28801f22-9cd9-49b6-9a67-ac08791b5ce0",
                                                "sense_id": "b4ff47e3-0a49-30f7-8b4e-332efa24e3d6",
                                                "text": "En dehors des ballerines, il n’y a rien dans l’apparence de cette adolescente qui ressortisse à « ce qui se fait » alors et qu’on voit dans les journaux de mode et les magasins des grandes villes."
                                            },
                                            {
                                                "example_id": "a4014420-326a-4f8c-9516-896db76f987c",
                                                "sense_id": "b4ff47e3-0a49-30f7-8b4e-332efa24e3d6",
                                                "text": "Le neurologue ne m’avait-il pas assuré que mon cas semblait ressortir à une forme fruste de la maladie, qu’on pouvait espérer qu’elle n’évoluerait pas trop, pas trop vite, que je n’aurais peut-être pas à subir les degrés gravissimes de la saloperie."
                                            },
                                            {
                                                "example_id": "141f6571-0140-4e40-abab-14319805483a",
                                                "sense_id": "b4ff47e3-0a49-30f7-8b4e-332efa24e3d6",
                                                "text": "Son aptitude ressortissait à la perception extrasensorielle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
