                        "examples": [
                            {
                                "example_id": "fc34e049-1895-4e6f-af5d-435023c96083",
                                "sense_id": "d84ab4b6-6072-33f6-b26b-d778c049d59d",
                                "text": "Kamphuis Sloopwerken uit Reutum maakt korte metten met het onderkomen van de voormalige protestants-christelijke basisschool. Ook deze dinsdag neemt een zogenoemde ‘vergruizer’ - een kraanmachine met ‘papegaaienbek’ - flinke happen uit de school, waar steeds minder van overblijft."
                            },
                            {
                                "example_id": "db4e80b3-f87c-4f70-9104-d4921879b556",
                                "sense_id": "d84ab4b6-6072-33f6-b26b-d778c049d59d",
                                "text": "Hoe dat komt, weet Verborg wel. „Er is geen aandacht voor. Op de lts en het mbo leren leerlingen niet meer wat een papegaaienbek, duivejager of kraalojief is. Hun leraren weten het ook niet."
                            }
                        ]
                    }
