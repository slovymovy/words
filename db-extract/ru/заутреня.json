                ],
                "senses": [
                    {
                        "sense_id": "b900160e-5427-36a0-bb07-fe6a2c8bb54b",
                        "entry_id": "f4311b07-0a8f-3562-ac9d-c69e2dca11ef",
                        "glosses": [
                            "церк., разг. русское народное название утрени || название утрени первого дня Пасхи"
                        ],
                        "tags": [
                            "в более узком смысле"
                        ],
                        "examples": [
                            {
                                "example_id": "ba1a6262-f8b1-42b3-9343-0469007b6f6d",
                                "sense_id": "b900160e-5427-36a0-bb07-fe6a2c8bb54b",
                                "text": "А на колокольне тоненько колокол бьёт ― заутреня."
                            },
                            {
                                "example_id": "d1d84649-fdd1-4ff8-abcd-f6e9dc2b2bd5",
                                "sense_id": "b900160e-5427-36a0-bb07-fe6a2c8bb54b",
                                "text": "Все ждали с нетерпением благовеста к заутрени; праздничные платья, тонкие передники, пелерины и рукава, тщательно причёсанные волосы придавали всем милый, нарядный вид."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de78996b-067e-4afd-9eb7-2aefec6a3992",
                        "source_entry_id": "f4311b07-0a8f-3562-ac9d-c69e2dca11ef",
                        "source_sense_id": "b900160e-5427-36a0-bb07-fe6a2c8bb54b",
                        "target_lang_word": "matins",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matins",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90d98d9f-2126-34c1-b630-4cd2ce2dbbb3",
                                        "entry_id": "1c772ab0-c5e8-38a2-82ae-a1878128279c",
                                        "glosses": [
                                            "Together with lauds, the earliest of the canonical hours; traditionally prayed at sunrise or earlier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4b4526-5c09-4449-a85d-79c10725bc82",
                                                "sense_id": "90d98d9f-2126-34c1-b630-4cd2ce2dbbb3",
                                                "text": "This chant was sung in many cathedrals both at First Vespers and at Matins for Christmas Day. In Notre Dame and many other churches, however, it was only performed at First Vespers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cffdd56-199a-3aad-8cfc-3bb62dab367f",
                                        "entry_id": "1c772ab0-c5e8-38a2-82ae-a1878128279c",
                                        "glosses": [
                                            "Morning prayers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4a2a1fb-ae66-44d3-847a-3c6f4e2bac35",
                                                "sense_id": "8cffdd56-199a-3aad-8cfc-3bb62dab367f",
                                                "text": "The monk must arise when the matins ring, / The abbot may sleep to their chime; / But the yeoman must start when the bugles sing / ’Tis time, my hearts, ’tis time."
                                            }
                                        ]
                                    }
                                ]
                            },
