                ],
                "translations": [
                    {
                        "translation_id": "4647de6c-c9f8-4abf-a6c6-e90680f8ed50",
                        "source_entry_id": "5285aee9-d689-3d18-8409-3cd72ba77cfe",
                        "target_lang_word": "Drehbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drehbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8a7661d-5ed3-3262-ae0f-deb76eead0ec",
                                        "entry_id": "c4028d63-ed9c-36d9-9f47-0755c89b755e",
                                        "glosses": [
                                            "Verzeichnis der gesprochenen Texte und der Regieanweisungen für einen Film"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74a21ac7-b0fe-4830-a6a2-d7e83e0d7287",
                                                "sense_id": "c8a7661d-5ed3-3262-ae0f-deb76eead0ec",
                                                "text": "Das Drehbuch konnte weder den Regisseur noch den vorgeschlagenen Hauptdarsteller begeistern."
                                            },
                                            {
                                                "example_id": "39233744-641f-4c4a-ae98-66ee47b33484",
                                                "sense_id": "c8a7661d-5ed3-3262-ae0f-deb76eead0ec",
                                                "text": "„Die Idee für das Drehbuch habe er in einem Taschenbuch gefunden, das jemand in der Eisenbahn liegengelassen hatte.“"
                                            },
                                            {
                                                "example_id": "70015ca1-2c3d-4252-afc2-0d59cad72c89",
                                                "sense_id": "c8a7661d-5ed3-3262-ae0f-deb76eead0ec",
                                                "text": "„Dafür wollte er das Drehbuch sehen.“"
                                            },
                                            {
                                                "example_id": "0b989084-d928-4d17-9fdd-7b9d5cdc685a",
                                                "sense_id": "c8a7661d-5ed3-3262-ae0f-deb76eead0ec",
                                                "text": "„Vor drei Jahren schrieb ich an einem Drehbuch und kam nicht weiter.“"
                                            },
                                            {
                                                "example_id": "b926daef-d5d5-441c-a112-acd739a1bd1d",
                                                "sense_id": "c8a7661d-5ed3-3262-ae0f-deb76eead0ec",
                                                "text": "„Er interessierte sich nicht mehr für die Hauptdarstellerinnen und weigerte sich, wenn man ihn darum bat, sich die Drehbücher anzusehen oder irgendwelche Ratschläge zu geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21847d27-8dd5-377f-8025-dd2dbeb6f447",
                                        "entry_id": "c4028d63-ed9c-36d9-9f47-0755c89b755e",
                                        "glosses": [
                                            "detailliert ausgearbeiteter Plan für ein Vorhaben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ab138d-2b11-4466-8bcc-42169ef18fa4",
                                                "sense_id": "21847d27-8dd5-377f-8025-dd2dbeb6f447",
                                                "text": "Dieses Verbrechen lief wie nach Drehbuch ab."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
