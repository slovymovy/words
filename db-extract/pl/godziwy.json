                ],
                "senses": [
                    {
                        "sense_id": "c582698e-94ed-30a2-88be-51b958fc3ca8",
                        "entry_id": "39c12b76-b49b-3bb1-8b78-8719516b7439",
                        "glosses": [
                            "decent, reasonable, creditable"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "11fec6e2-c560-4373-93a4-48082daaccf8",
                                "sense_id": "c582698e-94ed-30a2-88be-51b958fc3ca8",
                                "text": "Kiedy mówimy o zasadach, rozumiemy zasady prostéj moralności. To samo jest godziwe u nas, co jest godziwe za granicą, i na odwrót.",
                                "translation": "When we talk about rules, we mean the rules of simple morality. The same thing which is decent beyond the border is decent among us, and vice versa.",
                                "english": "When we talk about rules, we mean the rules of simple morality. The same thing which is decent beyond the border is decent among us, and vice versa."
                            },
                            {
                                "example_id": "f47e3d99-e8be-41df-b73b-0e132ec25dc0",
                                "sense_id": "c582698e-94ed-30a2-88be-51b958fc3ca8",
                                "text": "W szkole agronomicznej w Grignon, z której już wielu rodaków wyszło zdatnych i znalazło godziwe zatrudnienie, teraz uczęszcza czterech...",
                                "translation": "The agricultural school in Grignon, from which many of my countrymen have already come out qualified and found decent work, is now attended by four...",
                                "english": "The agricultural school in Grignon, from which many of my countrymen have already come out qualified and found decent work, is now attended by four..."
                            },
                            {
                                "example_id": "c60ea5bb-3292-4d7c-909d-4d70876e61d5",
                                "sense_id": "c582698e-94ed-30a2-88be-51b958fc3ca8",
                                "text": "Czym różni się wartość godziwa od ceny rynkowej",
                                "translation": "How a fair value is different from a market price",
                                "english": "How a fair value is different from a market price"
                            },
                            {
                                "example_id": "a2ac5b4c-1fdb-4b3c-8a52-96128bcc60c3",
                                "sense_id": "c582698e-94ed-30a2-88be-51b958fc3ca8",
                                "text": "Wtedy wolno mu [właścicielowi] podnieść czynsz i opłaty nie tylko do poziomu zapewniającego utrzymanie lokali, ale także do poziomu zapewniającego zwrot kapitału i godziwy zysk.",
                                "translation": "Then he [the property owner] is allowed to raise the rent and fees not only to a level allowing him to maintain the property, but also to a level that ensures the return of his capital and a decent profit.",
                                "english": "Then he [the property owner] is allowed to raise the rent and fees not only to a level allowing him to maintain the property, but also to a level that ensures the return of his capital and a decent profit."
                            },
                            {
                                "example_id": "fb850e0e-006c-4326-91c5-bf3d6dda81d4",
                                "sense_id": "c582698e-94ed-30a2-88be-51b958fc3ca8",
                                "text": "Art. 3 kodeksu pracy wyposażający pracownika w prawo do godziwego wynagrodzenia za pracę nie zdefiniował tego pojęcia. Nieco bliżej określa je art. 4 ust. 1 europejskiej karty społecznej z 18 października 1961 r. Przewiduje, że jest to wynagrodzenie zapewniające pracownikom i ich rodzinom godziwy (przyzwoity) poziom życia.",
                                "translation": "Article 3 of the work code, which gives the worker a right to reasonable remuneration for work, has not defined this concept. Article 4, statute 1 of the European social charter of October 18, 1961, indicates it somewhat more closely. It foresees that it is remuneration which ensures for workers and their families a reasonable (decent) standard of living.",
                                "english": "Article 3 of the work code, which gives the worker a right to reasonable remuneration for work, has not defined this concept. Article 4, statute 1 of the European social charter of October 18, 1961, indicates it somewhat more closely. It foresees that it is remuneration which ensures for workers and their families a reasonable (decent) standard of living."
                            }
                        ]
                    },
