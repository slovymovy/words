                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Maman prépare un délicieux ragoût de bœuf dans sa grande <w>cocotte</w> en fonte."
                        },
                        {
                            "text": "Il faut laisser cuire les légumes à feu très doux dans la <w>cocotte</w> fermée."
                        }
                    ],
                    "common_phrases": [
                        "cocotte en fonte",
                        "cocotte-minute"
                    ]
                },
