                                        "examples": [
                                            {
                                                "example_id": "1ff93ca3-e9e1-4910-91d9-4239cdd37cd1",
                                                "sense_id": "13c4a76e-4097-39b2-b8c8-16021ff76af1",
                                                "text": "Po tym, jak po raz drugi przyłapano go na łgarstwie, przylgnęła do niego opinia kłamcy."
                                            }
