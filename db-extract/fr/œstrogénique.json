                                    {
                                        "sense_id": "43ec5e62-d3dc-3930-b79e-aef7c37b3bc5",
                                        "entry_id": "ea8f9849-871a-372c-b1c9-62aee0530f26",
                                        "glosses": [
                                            "Of, relating to, or acting like estrogen."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dad054be-9c95-4723-b80f-011e86a1c5b9",
                                                "sense_id": "43ec5e62-d3dc-3930-b79e-aef7c37b3bc5",
                                                "text": "Assuming, for the moment, that one is of some definite genetic sex, at birth […] Suppose, in addition, I am born with a vagina and an estrogenic capability toward femininity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69f75530-1ea5-30ac-942e-d64a407f0fec",
