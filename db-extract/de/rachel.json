                        ]
                    },
                    {
                        "translation_id": "4b26bd7d-a441-4174-944d-5ae0abc1f3fe",
                        "source_entry_id": "1acb73de-c927-3d18-a6cd-f078ac245847",
                        "source_sense_id": "8f1dd266-6b48-3a24-9463-488803eea506",
                        "source_sense_description": "weiblicher Vorname",
