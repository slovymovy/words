                "senses": [
                    {
                        "sense_id": "cc61db16-355d-36eb-94d1-6e0d7967e36a",
                        "entry_id": "514d859f-5d0a-330a-82c1-e20c3bfe566a",
                        "glosses": [
                            "Streitkraft, die erst im Bedarfsfall aufgestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b8adf53-a860-4e76-aa26-c420f3e7cd81",
                                "sense_id": "cc61db16-355d-36eb-94d1-6e0d7967e36a",
                                "text": "„Durch das bäuerliche Volksheer ist die Idee neu erwacht, der Heeresdienst sei Untertanendienst, die Heerespflicht sei Bürgerpflicht.“"
                            },
                            {
                                "example_id": "16dd4a54-0436-46a5-b964-5e2f07ebde24",
                                "sense_id": "cc61db16-355d-36eb-94d1-6e0d7967e36a",
                                "text": "„Alle bejahten den quantitativen Aufwuchs und strukturellen Umbau der selektiven Reichswehr zu einem wirklichen Volksheer.“"
                            },
                            {
                                "example_id": "83470257-dbdb-40c8-8cd4-ffd6f684249e",
                                "sense_id": "cc61db16-355d-36eb-94d1-6e0d7967e36a",
                                "text": "„Die Kriege gegen das revolutionäre und dann imperiale Frankreich hatten gezeigt, dass die deutschen Staaten in ihren Staats-, Heeres- und Sozialverfassungen dem französischen Volksheer nicht standhielten.“"
                            },
                            {
                                "example_id": "6724ac9c-5227-4a27-b5dd-24d4c272fded",
                                "sense_id": "cc61db16-355d-36eb-94d1-6e0d7967e36a",
                                "text": "„Das neue französische Volksheer, von revolutionärem Schwung getragen, war daher den Söldnerheeren der europäischen Koalition moralisch überlegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
