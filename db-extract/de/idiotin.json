                                        "entry_id": "7f7a2c5d-859a-3985-9d8d-c133f886a7a4",
                                        "glosses": [
                                            "Féminin singulier de idiot."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
