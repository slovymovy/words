                        "target_lang_word": "confesseresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confesseresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2a6d7f5-2823-3406-ab1a-529bc0cac03e",
                                        "entry_id": "680ddcab-c3f5-3863-8952-3dfa5bd34d34",
                                        "glosses": [
                                            "Celle qui, dans l’Église primitive (ou aux débuts d’une Église protestante), avait confessé la foi de Jésus-Christ, jusqu’à souffrir des tourments, mais sans mourir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6395f5-0f44-43d4-8b84-8069c7dd99f3",
                                                "sense_id": "e2a6d7f5-2823-3406-ab1a-529bc0cac03e",
                                                "text": "Que Dieu vous aime, illustre confesseresse du nom de Christ, de vous avoir choisie entre touttes ses martyres pour souffrir des [plus] cruelles douleurs que les hommes méchants puissent inventer !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "558c28fc-184c-3d1e-bcb2-f481079331fc",
                                        "entry_id": "680ddcab-c3f5-3863-8952-3dfa5bd34d34",
                                        "glosses": [
                                            "Celle qui entend en confession."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7faa6c1e-34a8-4365-8846-958a61898799",
                                                "sense_id": "558c28fc-184c-3d1e-bcb2-f481079331fc",
                                                "text": "Je croyais bien, voyez-vous, de par ma condition de confesseresse, tout connaître en matière de vice…"
                                            },
                                            {
                                                "example_id": "eacffafe-9a5e-4109-9c8e-c6d2f306c75d",
                                                "sense_id": "558c28fc-184c-3d1e-bcb2-f481079331fc",
                                                "text": "Avant que d’aller passer six mois en taule pour avoir raconté des menteries fédérales, Marion Jones faisait hier une saucette chez Oprah, la grande confesseresse des États."
                                            }
                                        ]
                                    }
