                        "examples": [
                            {
                                "example_id": "7e8cf906-5180-4fde-bc0a-8047e1cd706c",
                                "sense_id": "8563d54c-9b42-3628-a073-ef830b707197",
                                "text": "Elle s’est acheté deux jilbeb, de longues robes amples couvrant les cheveux et les formes du corps : un noir et un de couleur aubergine."
                            },
                            {
                                "example_id": "dca85894-c866-470a-bbee-e16b1c6967f5",
                                "sense_id": "8563d54c-9b42-3628-a073-ef830b707197",
                                "text": "Sabrina est vêtue d’un jilbeb, robe noire tout en drapé tombant jusqu’au sol, manches longues et voile marron qui ne laisse voir que l’ovale du visage."
                            },
                            {
                                "example_id": "950b2355-7a70-450c-9f39-e79e7c2b717d",
                                "sense_id": "8563d54c-9b42-3628-a073-ef830b707197",
                                "text": "De son jilbeb, ce long voile anthracite qui l’enveloppe de la tête aux pieds, n’émerge que son visage souriant."
                            }
                        ]
                    }
