                    {
                        "sense_id": "378557b1-d408-3c24-8d07-d937052800d9",
                        "entry_id": "7aea0539-3236-3fde-9899-9b80756983a2",
                        "glosses": [
                            "Petit mur."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eb95648e-c38a-3bb6-a810-2bf75cd69b8b",
                        "entry_id": "7aea0539-3236-3fde-9899-9b80756983a2",
                        "glosses": [
                            "Mur bas, généralement construit en pierres sèches et servant de séparation."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "69406add-ebcf-4568-8fe8-dc8af6df5efd",
                                "sense_id": "eb95648e-c38a-3bb6-a810-2bf75cd69b8b",
                                "text": "L’usage des lozes est divers : couverture des maisons, construction et consolidation des muraillons ou murets, confection des calades, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecba7226-7550-4ad0-82e5-ad1fc088064e",
                        "source_entry_id": "7aea0539-3236-3fde-9899-9b80756983a2",
                        "source_sense_description": "Petit mur",
                        "target_lang_word": "Mäuerchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mäuerchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "429f9e05-19d2-3a0e-8df8-56f08a47334b",
                                        "entry_id": "1774db6a-b749-302a-866f-aa5ac9adb517",
                                        "glosses": [
                                            "kleine Mauer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a404e8ff-8f41-4527-bfb8-6d13acc0ea6c",
                                                "sense_id": "429f9e05-19d2-3a0e-8df8-56f08a47334b",
                                                "text": "„Im Laufe der Jahrhunderte haben die Inselbewohner die Steine aufgesammelt, halbkreisförmige Mäuerchen gebaut und auf deren Innenseite kleine Vertiefungen angelegt.“"
                                            },
                                            {
                                                "example_id": "abc4211f-6926-4abc-a9f8-11ef19d63ca1",
                                                "sense_id": "429f9e05-19d2-3a0e-8df8-56f08a47334b",
                                                "text": "„Ich ging in den Park hinaus, setzte mich auf ein Mäuerchen, schrieb ein paar Nachrichten.“"
                                            },
                                            {
                                                "example_id": "afbbbbf1-ce99-4bc8-bf3d-52a323930137",
                                                "sense_id": "429f9e05-19d2-3a0e-8df8-56f08a47334b",
                                                "text": "„Das 1927/28 ausgegrabene Mäuerchen, das den heiligen Raum umfriedet, misst rund 63 mal 46 Meter.“"
                                            },
                                            {
                                                "example_id": "32954237-07e1-401d-a83b-c7035fce3979",
                                                "sense_id": "429f9e05-19d2-3a0e-8df8-56f08a47334b",
                                                "text": "„Ich gelangte in den Hof hinaus, den ein weinumranktes Mäuerchen umgab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
