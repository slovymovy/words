                    "sense_id": "5ecd47fd-68f1-313b-a51d-8ecc3f41d123",
                    "sense_definition": "D'une manière conforme à la réalité ou aux faits, avec une grande précision.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle ne sait pas <w>exactement</w> à quelle heure le train doit arriver.",
                            "target_lang_translations": {
                                "en": "She doesn't know <w>exactly</w> what time the train is due to arrive.",
                                "ru": "Она не знает <w>точно</w>, во сколько поезд должен прибыть.",
                                "nl": "Ze weet niet <w>precies</w> hoe laat de trein moet aankomen.",
                                "de": "Sie weiß nicht <w>genau</w>, wann der Zug ankommen soll.",
                                "pl": "Nie wie <w>dokładnie</w>, o której godzinie pociąg ma przyjechać.",
                                "it": "Non sa <w>esattamente</w> a che ora il treno deve arrivare.",
                                "cs": "Neví <w>přesně</w>, v kolik hodin má vlak přijet.",
                                "tr": "Trenin saat kaçta varması gerektiğini <w>tam</w> olarak bilmiyor.",
                                "es": "No sabe <w>exactamente</w> a qué hora debe llegar el tren.",
                                "zh": "她并不<w>准确</w>地知道火车什么时候到。"
                            }
                        },
                        {
                            "text": "Le technicien a mesuré <w>exactement</w> la distance entre les deux murs.",
                            "target_lang_translations": {
                                "en": "The technician measured the distance between the two walls <w>exactly</w>.",
                                "ru": "Техник <w>точно</w> измерил расстояние между двумя стенами.",
                                "nl": "De technicus heeft de afstand tussen de twee muren <w>precies</w> gemeten.",
                                "de": "Der Techniker hat den Abstand zwischen den beiden Wänden <w>genau</w> gemessen.",
                                "pl": "Technik <w>dokładnie</w> zmierzył odległość między dwiema ścianami.",
                                "it": "Il tecnico ha misurato <w>esattamente</w> la distanza tra i due muri.",
                                "cs": "Technik <w>přesně</w> změřil vzdálenost mezi oběma zdmi.",
                                "tr": "Teknisyen iki duvar arasındaki mesafeyi <w>tam</w> olarak ölçtü.",
                                "es": "El técnico midió <w>exactamente</w> la distancia entre las dos paredes.",
                                "zh": "技术员<w>精确</w>地测量了两堵墙之间的距离。"
                            }
                        }
