{
    "word_family": [
        "chirp",
        "chirper",
        "chirpy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5120604d-2ce5-3d97-89ac-4e1b15443029",
                    "sense_definition": "To make a series of short, high-pitched sounds, such as those made by small birds or insects.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every morning, dozens of sparrows <w>chirrup</w> merrily in the garden bushes.",
                            "target_lang_translations": {
                                "zh": "每天早晨，几十只麻雀在花园的灌木丛中欢快地<w>唧唧喳喳叫着</w>。"
                            }
                        },
                        {
                            "text": "The cat made a friendly noise and began to <w>chirrup</w> at the birds outside.",
                            "target_lang_translations": {
                                "zh": "猫咪发出友善的声音，开始对着外面的鸟儿<w>啾啾叫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chirp",
                        "twitter",
                        "peep"
                    ],
                    "common_phrases": [
                        "chirrup happily"
                    ],
                    "target_lang_definitions": {
                        "zh": "（鸟或昆虫等）发出连续短促而清脆的叫声；唧唧喳喳地叫"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "唧唧喳喳地叫",
                                "target_lang_sense_clarification": "鸟虫等连续叫"
                            },
                            {
                                "target_lang_word": "鸣叫",
                                "target_lang_sense_clarification": "鸟或虫叫"
                            },
                            {
                                "target_lang_word": "啾啾叫",
                                "target_lang_sense_clarification": "鸟叫声清脆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5600f3f-82dd-381a-bb6b-09930a54cffc",
                    "sense_definition": "To say or express something in a quick, cheerful, and high-pitched voice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vocal_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Good morning to everyone!\" the receptionist <w>chirruped</w> as the guests entered the lobby.",
                            "target_lang_translations": {
                                "zh": "客人走进大堂时，接待员用欢快清脆的声音<w>说道</w>：“大家早上好！”"
                            }
                        },
                        {
                            "text": "She <w>chirruped</w> her thanks before hurrying out the door to catch her train.",
                            "target_lang_translations": {
                                "zh": "她欢快地<w>道了声</w>谢，便急忙出门赶火车去了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chirp"
                    ],
                    "target_lang_definitions": {
                        "zh": "用欢快、尖细的声音轻快地说"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "欢快地说",
                                "target_lang_sense_clarification": "声音尖细轻快"
                            },
                            {
                                "target_lang_word": "尖声轻快地说",
                                "target_lang_sense_clarification": "声音短促欢快"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c29918b7-160e-3af3-bf13-e1942134586a",
                    "sense_definition": "To encourage or urge an animal forward by making a clicking or clucking sound with the mouth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "urge_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider gently leaned forward to <w>chirrup</w> her horse into a trot.",
                            "target_lang_translations": {
                                "zh": "骑手微微前倾身体，通过<w>咂嘴催赶</w>让马小跑起来。"
                            }
                        },
                        {
                            "text": "He <w>chirruped</w> at the team of mules to keep them moving up the hill.",
                            "target_lang_translations": {
                                "zh": "他对着骡队<w>发啧啧声催赶</w>，让它们继续往山上走。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chirrup to a horse"
                    ],
                    "target_lang_definitions": {
                        "zh": "（用嘴发出啧啧声或咂嘴声）催促牲畜前行"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "咂嘴催促",
                                "target_lang_sense_clarification": "发声驱赶牲口"
                            },
                            {
                                "target_lang_word": "发啧啧声催赶",
                                "target_lang_sense_clarification": "发出声音催牲口走"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba925b1f-d0e1-3e5f-8c16-1c8e4f3f907e",
                    "sense_definition": "A series of short, high-pitched sounds made by a bird, insect, or other small animal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were woken up early by the cheerful <w>chirrup</w> of crickets outside the window.",
                            "target_lang_translations": {
                                "zh": "窗外蟋蟀欢快的<w>唧唧声</w>大清早就把我们吵醒了。"
                            }
                        },
                        {
                            "text": "The quiet night was suddenly interrupted by the loud <w>chirrup</w> of a small bird.",
                            "target_lang_translations": {
                                "zh": "宁静的夜晚突然被一只小鸟清脆的<w>啾啾声</w>打破了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chirp",
                        "twitter"
                    ],
                    "common_phrases": [
                        "cheerful chirrup"
                    ],
                    "target_lang_definitions": {
                        "zh": "（鸟、昆虫等发出的）唧唧声，啾啾声"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "唧唧声",
                                "target_lang_sense_clarification": "虫鸣或短促鸟鸣"
                            },
                            {
                                "target_lang_word": "啾啾声",
                                "target_lang_sense_clarification": "鸟叫声"
                            },
                            {
                                "target_lang_word": "鸣叫声",
                                "target_lang_sense_clarification": "动物叫声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a23cc41-7289-34f7-8dbf-db80e56ee212",
                    "sense_definition": "A brief, high-pitched remark or insignificant utterance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vocal_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nervous boy offered a faint <w>chirrup</w> of apology before stepping away.",
                            "target_lang_translations": {
                                "zh": "那个紧张的男孩退开之前，微弱地<w>挤出一句</w>道歉。"
                            }
                        },
                        {
                            "text": "Her sarcastic comment was met only with a confused <w>chirrup</w> from the audience.",
                            "target_lang_translations": {
                                "zh": "她那讽刺的言论只换来了观众席上一阵困惑的<w>低语声</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "短促尖细的话语；微弱的吱唔声"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轻声言语",
                                "target_lang_sense_clarification": "微弱尖细的短句"
                            },
                            {
                                "target_lang_word": "低声嘟囔",
                                "target_lang_sense_clarification": "微弱含混的声音"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}