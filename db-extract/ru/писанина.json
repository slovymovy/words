                    {
                        "translation_id": "673a6086-7644-42b2-86f5-86209ce8b0cc",
                        "source_entry_id": "211800c8-f043-3c4f-9fae-4acf86e9c47a",
                        "target_lang_word": "Geschreibsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschreibsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a75fc295-b25e-3cd7-a515-f88f0c2c7b7c",
                                        "entry_id": "d7bacfa7-4056-3704-9f6d-318bab7ad8ed",
                                        "glosses": [
                                            "schriftlich Verfasstes, das nicht besonders hoch geschätzt oder ernst genommen wird"
                                        ],
                                        "tags": [
                                            "leicht abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27221f94-fb86-408f-a6ee-8844f15b5ff8",
                                                "sense_id": "a75fc295-b25e-3cd7-a515-f88f0c2c7b7c",
                                                "text": "„Zwei junge Berichterstatter interviewten mich, aber sie wußten nicht zu fragen, und aus dem, was ich ihnen zur Anregung mitteilte, machten sie hinterher ein so albernes und entstellendes Geschreibsel, daß ich mir vornahm, in künftigen Fällen nur auf präzise Fragen zu antworten und auch nur unter der Bedingung, daß man die Fragen und meine Antworten dann wörtlich wiedergäbe.“"
                                            },
                                            {
                                                "example_id": "2edbf9da-32eb-4538-aabf-68735fad2d4e",
                                                "sense_id": "a75fc295-b25e-3cd7-a515-f88f0c2c7b7c",
                                                "text": "„Sie enthielt eine Menge Geschreibsel.“"
                                            },
                                            {
                                                "example_id": "777ff782-52ab-47dc-b11c-ffbd3b1d0e98",
                                                "sense_id": "a75fc295-b25e-3cd7-a515-f88f0c2c7b7c",
                                                "text": "„Sie ist eine moderne, aufgeklärte Frau, die schließlich für die Hälfte meines Geschreibsels verantwortlich ist, steht wie alle Intellektuellen Deutschlands eher links, hat viele Demos und soziale Bewegungen kommen und gehen sehen und versteht, was in Griechenland los ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12a49c59-d23f-48e0-bcdc-593fa996b3e7",
                        "source_entry_id": "211800c8-f043-3c4f-9fae-4acf86e9c47a",
                        "target_lang_word": "Schreiberei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreiberei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3807c6ab-bcaa-331b-8848-80980acbb24e",
                                        "entry_id": "51a95de3-b474-3fa3-8613-5ea94350dca8",
                                        "glosses": [
                                            "Anfertigen schriftlich verfasster Texte; das Schreiben"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aef642d1-aca4-443c-83c3-2c31cd0abfda",
                                                "sense_id": "3807c6ab-bcaa-331b-8848-80980acbb24e",
                                                "text": "„Und immer wieder musste ich den vielen Freunden und Verwandten eine neue Adresse melden und hatte doch schon an meinem Tagebuch genug Schreiberei.“"
                                            },
                                            {
                                                "example_id": "cf5e0c13-aa26-4952-8dfa-ac81069c7471",
                                                "sense_id": "3807c6ab-bcaa-331b-8848-80980acbb24e",
                                                "text": "„An diesem Sonntag wurde es mit der weiteren Schreiberei nichts, die begonnene Karte blieb unvollendet in dem Radiobastelbuch Ottochens liegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
