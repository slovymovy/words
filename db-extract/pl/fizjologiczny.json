                            {
                                "example_id": "5772fef2-b976-4eae-a671-fb26a957b7c0",
                                "sense_id": "086f0d6c-88e6-37d3-86f9-b42278f82249",
                                "text": "Cechy fizjologiczne tej grupy zwierząt pozwalają przetrwać tak niedogodne warunki jakie spotykamy w Arktyce."
