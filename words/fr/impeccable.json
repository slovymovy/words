    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "693ac293-1ef6-3f15-9e32-7d4d77482db2",
                    "sense_definition": "Qui ne présente aucun défaut, qui est absolument soigné ou conforme à la perfection.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle porte toujours une tenue <w>impeccable</w> pour aller au bureau."
                        },
                        {
                            "text": "Le travail a été rendu à l'heure avec une présentation <w>impeccable</w>."
                        }
                    ],
                    "synonyms": [
                        "impec",
                        "parfait"
                    ],
                    "antonyms": [
                        "imparfait"
                    ],
                    "common_phrases": [
                        "tenue impeccable",
                        "service impeccable"
                    ]
                },
                {
                    "sense_id": "1f212248-22be-3c5f-97c7-e6d25bcd7899",
                    "sense_definition": "Qui est incapable de commettre une erreur ou de faillir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "infaillibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Même les plus grands spécialistes ne sont pas <w>impeccables</w> et peuvent se tromper."
                        },
                        {
                            "text": "Personne ne peut prétendre être un juge totalement <w>impeccable</w>."
                        }
                    ],
                    "synonyms": [
                        "infaillible"
                    ],
                    "antonyms": [
                        "faillible"
                    ]
                },
                {
                    "sense_id": "68e16d0d-be38-3da1-b3b8-4a565b29a025",
                    "sense_definition": "Qui est incapable de pécher, exempt de tout péché.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon la doctrine chrétienne, seul Dieu est considéré comme <w>impeccable</w> par nature."
                        },
                        {
                            "text": "Les théologiens rappellent qu'aucun être humain sur terre n'est <w>impeccable</w>."
                        }
                    ],
                    "antonyms": [
                        "peccable"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "théologie"
                        }
                    ]
                }
            ]
        },
        {
