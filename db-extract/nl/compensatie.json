                        "target_lang_word": "Abfindung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abfindung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "338079a0-53ed-3c42-b964-4f42bb05d640",
                                        "entry_id": "1d1f63d1-704d-3499-84bb-73d5f38b5ffb",
                                        "glosses": [
                                            "Entschädigungszahlung für den Rücktritt vom Arbeitsplatz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b25394fd-630f-4fe3-9f9d-ac8133116128",
                                                "sense_id": "338079a0-53ed-3c42-b964-4f42bb05d640",
                                                "text": "Die Manageretage hat üppige Abfindungen erhalten."
                                            },
                                            {
                                                "example_id": "5f93ae50-2840-4b40-bde8-2c864797f42b",
                                                "sense_id": "338079a0-53ed-3c42-b964-4f42bb05d640",
                                                "text": "Ohne Abfindung geh ich sowieso nicht."
                                            },
                                            {
                                                "example_id": "6e123132-b55d-47cf-a6f3-4172151b868b",
                                                "sense_id": "338079a0-53ed-3c42-b964-4f42bb05d640",
                                                "text": "„Sie hatte den Auftrag erhalten, die Namen derer bekanntzugeben, die das dreißigste Lebensjahr überschritten hatten und geneigt waren, mit zweihundert Scudi das Haus zu verlassen.“"
                                            },
                                            {
                                                "example_id": "32398910-fa44-4ea5-a41a-aa9b99bd2d18",
                                                "sense_id": "338079a0-53ed-3c42-b964-4f42bb05d640",
                                                "text": "„Busch erhielt eine einmalige Abfindung von 1000 Gulden (etwa 1700 Goldmark).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce2dd6d5-3628-3aad-a93e-8aa8fc1da482",
                                        "entry_id": "1d1f63d1-704d-3499-84bb-73d5f38b5ffb",
                                        "glosses": [
                                            "finanzielle Aufwandsentschädigung"
                                        ],
                                        "tags": [
                                            "vor Gericht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "729521e3-143c-4da7-9b5f-751b903d1879",
                                                "sense_id": "ce2dd6d5-3628-3aad-a93e-8aa8fc1da482",
                                                "text": "Das Gericht verurteilte den Angeklagten zur Zahlung einer angemessenen Abfindung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86b526ee-354a-4db9-a8d5-b5c1abc0e303",
                        "source_entry_id": "936188a5-e633-3549-9b0b-d4fac389e11d",
