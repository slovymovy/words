                "senses": [
                    {
                        "sense_id": "421bd8c9-e867-3c5c-8743-1d0017469ee1",
                        "entry_id": "9c975aa8-e01d-3949-ae19-dbec1d5b87f3",
                        "glosses": [
                            "wat hevige afkeer opwekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acdd5ebc-4e27-4808-a448-4740c06cd713",
                                "sense_id": "421bd8c9-e867-3c5c-8743-1d0017469ee1",
                                "text": "Marteling is een afschuwelijke zaak."
                            },
                            {
                                "example_id": "175c3389-db50-4e7c-bb52-2666c81b9661",
                                "sense_id": "421bd8c9-e867-3c5c-8743-1d0017469ee1",
                                "text": "Het was niet afschuwelijk slecht."
                            },
                            {
                                "example_id": "dfa08c66-33ab-4e97-aaec-8e6675427536",
                                "sense_id": "421bd8c9-e867-3c5c-8743-1d0017469ee1",
                                "text": "De afschuwelijke waarheid van ons noodlot grijpt hen bij de keel."
                            },
                            {
                                "example_id": "7845f7f7-9642-40a9-9cd7-1f21e339065b",
                                "sense_id": "421bd8c9-e867-3c5c-8743-1d0017469ee1",
                                "text": "'Wat afschuwelijk, Vincenzo.' Wel knap dat je toch gids bent geworden."
                            }
                        ]
                    }
