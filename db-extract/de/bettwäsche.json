                        "cross_references": [
                            {
                                "target_word": "bedding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d71116e9-c99a-33fb-9939-2d8984960163",
                                        "entry_id": "932b90b5-73cf-3754-bf5d-c32cf5c8a17e",
                                        "glosses": [
                                            "The textiles associated with a bed, e.g., sheets, pillowcases, bedspreads, blankets, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7d5cf5-4627-47a4-a109-ac8f36e1c407",
                                                "sense_id": "d71116e9-c99a-33fb-9939-2d8984960163",
                                                "text": "Hire of bedding, and food in the restaurant cars is cheap, and passengers are officially encouraged not to tip company's servants—but they do."
                                            },
                                            {
                                                "example_id": "54101ab8-f891-4fc2-8095-e7e31e9b23ad",
                                                "sense_id": "d71116e9-c99a-33fb-9939-2d8984960163",
                                                "text": "Similarly, the biotech giant Cargill has begun manufacturing a polymer from vegetable oils that is used in polyurethane foams, which is found in beddings, furniture and car-seat headrests."
                                            }
                                        ]
                                    },
                                    {
