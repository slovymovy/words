                                "example_id": "a3d5332c-24c5-4f9f-938f-1a4fbd31d33b",
                                "sense_id": "b29ff421-0989-328c-9693-5e151bf3486a",
                                "text": "„Der Knabe rutschte vom Brunnenrand, kam näher und führte sie durch eine enge Gasse zu einem Seiteneingang.“"
                            },
                            {
                                "example_id": "bd2fab66-8666-41dd-b527-b19ffc7dc728",
                                "sense_id": "b29ff421-0989-328c-9693-5e151bf3486a",
                                "text": "„Rasch zog sie die Beine aus dem Wasser und glitt bloßfüßig vom Brunnenrand auf den Boden.“"
                            }
                        ],
