                "senses": [
                    {
                        "sense_id": "8d31d12f-ceca-3b37-8a13-065622167082",
                        "entry_id": "eae28724-87fa-351a-8e60-e8ce7c304411",
                        "glosses": [
                            "ein Schlag auf dem Grün mit dem Putter, bei dem der Golfball in Richtung Loch rollt und im Idealfall ins Loch fällt"
                        ],
                        "tags": [
                            "Golf"
                        ],
                        "examples": [
                            {
                                "example_id": "6e86acce-3af3-4075-b9f7-2bd9792f0485",
                                "sense_id": "8d31d12f-ceca-3b37-8a13-065622167082",
                                "text": "Vor jedem Putt markieren die Golfprofis ihren Ball, nehmen ihn auf und werfen ihn zu ihrem Caddie, der ihn sorgfältig putzt."
                            },
                            {
                                "example_id": "a6daede4-4fb7-4411-9506-a5699546c590",
                                "sense_id": "8d31d12f-ceca-3b37-8a13-065622167082",
                                "text": "Den Putt zum Birdie konnte er nicht verwandeln."
                            },
                            {
                                "example_id": "a561ccc6-416c-4497-8ed9-73cd914c8b12",
                                "sense_id": "8d31d12f-ceca-3b37-8a13-065622167082",
                                "text": "„Ich unterteilte die Strecke in drei Abschnitte, kannte inzwischen jeden Stamm genau, und wie ein Golfer vor dem entscheidenden Putt das Grün, studierte ich die Besonderheiten des Holzes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
