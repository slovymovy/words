{
    "word_family": [
        "pouffer",
        "poufiasse"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d2518131-6247-3aff-9e9b-a1900edb5b63",
                    "sense_definition": "Siège bas et rembourré, sans dossier ni bras, servant d'assise d'appoint ou de repose-pieds.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mobilier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est assis sur un gros <w>pouf</w> moelleux posé au milieu de la chambre."
                        },
                        {
                            "text": "Après une longue journée de marche, elle a posé ses pieds sur le <w>pouf</w> du salon."
                        }
                    ],
                    "common_phrases": [
                        "gros pouf"
                    ]
                },
                {
                    "sense_id": "5fc2af59-d980-34f6-9e58-7b77fb1cb187",
                    "sense_definition": "Terme injurieux désignant une femme jugée vulgaire, ridicule ou méprisable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a traité cette fille de <w>pouf</w> lors d'une violente dispute dans la rue."
                        },
                        {
                            "text": "Elle a ignoré les provocations de cette <w>pouf</w> sans daigner lui accorder un regard."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "péjoratif et vulgaire"
                        }
                    ]
                },
                {
                    "sense_id": "877cda5a-e800-3ac1-8de0-9ce84eb3bcf6",
                    "sense_definition": "Coussin rembourré que les femmes portaient autrefois sous leur jupe pour en faire bouffer le tissu.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au dix-neuvième siècle, les dames portaient un <w>pouf</w> pour donner du volume à leur robe."
                        },
                        {
                            "text": "La couturière a fixé un <w>pouf</w> sous la jupe de satin pour accentuer la cambrure."
                        }
                    ],
                    "synonyms": [
                        "faux-cul"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mode historique"
                        }
                    ]
                },
                {
                    "sense_id": "5e30df9b-f392-33f4-bb21-ca3af7b23179",
                    "sense_definition": "Bordel militaire de campagne mis à la disposition des troupes en opération ou en garnison.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats stationnés dans cette garnison lointaine fréquentaient régulièrement le <w>pouf</w> de la base."
                        },
                        {
                            "text": "Le roman historique évoque les femmes recrutées pour travailler dans un <w>pouf</w> militaire."
                        }
                    ],
                    "synonyms": [
                        "BMC"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot militaire"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "historique"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "4826d45b-231b-32ce-b46e-8e8494c9d1c4",
                    "sense_definition": "Onomatopée évoquant un bruit sourd, une chute ou une disparition soudaine et inattendue.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prestidigitateur a agité sa baguette, et <w>pouf</w>, le lapin a disparu de la boîte !"
                        },
                        {
                            "text": "Il a trébuché sur la première marche et, <w>pouf</w>, il s'est étalé de tout son long."
                        }
                    ],
                    "common_phrases": [
                        "et pouf"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7c70c2fb-e3ea-365c-92ea-08a2184d759c",
                    "sense_definition": "Se dit d'une pierre ou d'un marbre friable qui perd ses arêtes et s'effrite à la taille.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce bloc de calcaire est trop <w>pouf</w> pour permettre une sculpture aux détails très fins."
                        },
                        {
                            "text": "Le sculpteur a rejeté ce marbre <w>pouf</w> qui s'émiettait sous les coups répétés du burin."
                        }
                    ],
                    "common_phrases": [
                        "marbre pouf"
                    ]
                }
            ]
        }
    ]
}