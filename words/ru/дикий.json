                {
                    "sense_id": "8c51bd61-cece-33b5-8c05-4b1b626fd69e",
                    "sense_definition": "Странный, нелепый, неправдоподобный.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_absurd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Твоя идея кажется мне совершенно <дикой> и опасной.",
                            "target_lang_translations": {
                                "en": "Your idea seems completely <wild> and dangerous to me.",
                                "es": "Tu idea me parece completamente <descabellada> y peligrosa.",
                                "fr": "Ton idée me semble complètement <insensée> et dangereuse."
                            }
                        },
                        {
                            "text": "Он совершил какой-то <дикий> и непонятный поступок.",
                            "target_lang_translations": {
                                "en": "He committed some <bizarre> and incomprehensible act.",
                                "es": "Cometió una acción bastante <descabellada> e incomprensible.",
                                "fr": "Il a commis un acte assez <bizarre> et incompréhensible."
                            }
                        }
