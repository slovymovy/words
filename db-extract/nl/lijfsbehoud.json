                    {
                        "sense_id": "6774dfde-6d38-36ed-a1ce-70afe37969e5",
                        "entry_id": "0501ae96-b2b6-3aed-9681-d3143c28fa6c",
                        "glosses": [
                            "het in leven blijven"
