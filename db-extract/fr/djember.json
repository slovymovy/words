                "senses": [
                    {
                        "sense_id": "212b85b7-c4bb-336f-a7ef-1e923dc4ffa4",
                        "entry_id": "bf82ff93-f833-386c-96cb-0e358129f134",
                        "glosses": [
                            "Jouer du djembé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebf01900-df14-4d5c-a431-8c47cf2298e0",
                                "sense_id": "212b85b7-c4bb-336f-a7ef-1e923dc4ffa4",
                                "text": "La sortie du métro avait des airs de Centre Bell. Ça chante, ça djembe, ça fait du bruit..."
                            },
                            {
                                "example_id": "169b4868-b7d4-45a0-a067-a24fe79fa2d5",
                                "sense_id": "212b85b7-c4bb-336f-a7ef-1e923dc4ffa4",
                                "text": "Genolier: ça va «djember» à l’école!"
                            },
                            {
                                "example_id": "0ebdeb45-17d8-469f-91eb-0e7c6f5484a7",
                                "sense_id": "212b85b7-c4bb-336f-a7ef-1e923dc4ffa4",
                                "text": "L'après midi «si on dansait, folkait, djembait» a permis de découvrir deux nouvelles associations casseloises."
                            },
                            {
                                "example_id": "7353960e-d91b-4b00-acc2-c98f78b351d2",
                                "sense_id": "212b85b7-c4bb-336f-a7ef-1e923dc4ffa4",
                                "text": "Ils \"synthétisaient\", ils \"djembaient\", ils \"tambourinaient\" comme c'est pas possible."
                            }
                        ]
                    }
