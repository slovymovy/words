                "senses": [
                    {
                        "sense_id": "3deeff24-d427-3537-a01c-ecbf102ebb0e",
                        "entry_id": "fe1c3a9e-5613-3702-ac85-1a27ab0def4d",
                        "glosses": [
                            "związany z neoromantyzmem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcbce1d4-9175-4ab1-866f-d6f2d9585b3f",
                                "sense_id": "3deeff24-d427-3537-a01c-ecbf102ebb0e",
                                "text": "Sarkając na to, że się na nim poznać nie umiano, chwyta za pióro, kruszy kopie za powstałą w r. 1832 neoromantyczną szkołą, która muzykę miała pchnąć na nowe tory a za któréj przedstawiciela Berlioz siebie uważał, tak jak Wiktor Hugo za jéj reprezentanta w piśmiennictwie uchodził."
                            },
                            {
                                "example_id": "c31dddbe-d996-425f-8479-e82a1c5eef1b",
                                "sense_id": "3deeff24-d427-3537-a01c-ecbf102ebb0e",
                                "text": "Wiedeń nie chciał jednak zrażać Polaków, zwłaszcza młodzieży, która wychowywała się w neoromantycznej atmosferze \"Młodej Polski\"."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
