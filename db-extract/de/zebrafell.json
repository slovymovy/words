                "senses": [
                    {
                        "sense_id": "15e9db86-3d94-311a-9f68-9844248f326c",
                        "entry_id": "9acf9d9f-1d7c-3d2e-99ac-dfe9e244f34a",
                        "glosses": [
                            "(abgezogenes) Fell eines Zebras"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f5330c5-efc3-4937-854d-5da1da6d7c7b",
                                "sense_id": "15e9db86-3d94-311a-9f68-9844248f326c",
                                "text": "„Auf der Oberfläche des Gehirns bilden die Dominanzbänder ein Streifenmuster ähnlich einem Zebrafell.“"
                            },
                            {
                                "example_id": "9d394907-2e1c-4c18-bfb5-970d7cbf2a45",
                                "sense_id": "15e9db86-3d94-311a-9f68-9844248f326c",
                                "text": "„Ein etwas aufwärts gebogener Streifen schwarz-weißen Zebrafelles, der in einer dicken Haarquaste ausläuft und mit einem Lederriemen um den Hals befestigt wird, ist als Tanzschmuck sehr beliebt.“"
                            },
                            {
                                "example_id": "6784aaa5-7b1d-4a39-8a58-62cc503dd359",
                                "sense_id": "15e9db86-3d94-311a-9f68-9844248f326c",
                                "text": "„Die Zebrafelle, welche Muata Jamwo besitzt, kommen vom äussersten Süden seines Reiches.“"
                            },
                            {
                                "example_id": "535d9bea-b36b-402e-af67-f3fe280b1076",
                                "sense_id": "15e9db86-3d94-311a-9f68-9844248f326c",
                                "text": "„Die Einrichtung setzt ganz bewusst auf Design mit geometrisch-ethnischen Elementen (z. B. Sofas mit Zebrafellen); zum Club gehören zwei Bars, zwei Tanzflächen und DJs, die Hip-Hop, Latin und Electronic auflegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
