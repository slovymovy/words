                "senses": [
                    {
                        "sense_id": "8b8f0bc6-7132-3b95-8cd0-273d8c739105",
                        "entry_id": "d07133e7-adcf-3b87-9d77-e9b63b99d252",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord man"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "62500fea-fdb8-4f84-ab13-ffa0093db839",
                                "sense_id": "8b8f0bc6-7132-3b95-8cd0-273d8c739105",
                                "text": "Gijs lijkt overal verstand van te hebben en etaleert die kennis graag. Zeker in het bijzijn van andere mannen - Giorgos in dit geval - alsof hij met ze probeert te wedijveren."
                            },
                            {
                                "example_id": "964f2dbe-7885-44f9-9393-59cdc3f2064b",
                                "sense_id": "8b8f0bc6-7132-3b95-8cd0-273d8c739105",
                                "text": "Maar ook schreef ik mijn gedachten op over relaties, emoties, vrouwen, mannen, kinderen, verslaving, angst en haat."
                            }
                        ]
                    },
