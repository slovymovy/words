                },
                {
                    "sense_id": "2c2fdd7c-0c5e-3e95-8c86-54932c9940b6",
                    "sense_definition": "Einer der zehn hölzernen oder kunststoffbeschichteten Kegel beim Bowling",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit einem geschickten Wurf räumte sie alle zehn <w>Pins</w> auf einmal ab."
                        },
                        {
                            "text": "Ihm fehlten noch zwei <w>Pins</w> für einen neuen Bahnrekord."
