                                    {
                                        "sense_id": "fe67cbf6-4928-34b8-88cd-f8b679263a77",
                                        "entry_id": "f5ab6dc0-cc88-3412-8a81-7e05ded66df6",
                                        "glosses": [
                                            "Anything which allures; something or someone used to lure or entice someone or something into doing something"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2ba233c-c46e-45d0-9d92-23c46310b612",
                                                "sense_id": "fe67cbf6-4928-34b8-88cd-f8b679263a77",
                                                "text": "One of the “girls” used in this way, Pamella Bordes, later spoke of being “part of an enormous group … used as sexual bait.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4c62f95-2714-39c2-84f8-f7fb742b4b96",
                                        "entry_id": "f5ab6dc0-cc88-3412-8a81-7e05ded66df6",
                                        "glosses": [
                                            "Anything which allures; something or someone used to lure or entice someone or something into doing something",
                                            "Something that lures or entices a specified group"
                                        ],
                                        "tags": [
