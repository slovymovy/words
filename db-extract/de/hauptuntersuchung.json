                "senses": [
                    {
                        "sense_id": "771f04cf-c495-329e-ac44-0203f6eaf791",
                        "entry_id": "9724c138-53a0-3f3a-b4b2-927650595351",
                        "glosses": [
                            "periodische Überprüfung von technischen Einrichtungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a502c6c8-2719-41a1-93a6-c9311f268d0a",
                                "sense_id": "771f04cf-c495-329e-ac44-0203f6eaf791",
                                "text": "Die Hauptuntersuchung an Kraftfahrzeugen dient in erster Linie der Verkehrssicherheit."
                            },
                            {
                                "example_id": "49df30fb-4fa7-4527-951b-9c0f5ae2be43",
                                "sense_id": "771f04cf-c495-329e-ac44-0203f6eaf791",
                                "text": "„Bei Dampfkesseln von Lokomotiven, die dem öffentlichen Verkehr dienen, kann anläßlich der Hauptuntersuchungen eine teilweise Zerlegung des Kessels verlangt werden.“"
                            },
                            {
                                "example_id": "a6eadaf0-ec1b-4a3c-9f6c-eb4118f3f54d",
                                "sense_id": "771f04cf-c495-329e-ac44-0203f6eaf791",
                                "text": "„Die ordnungsgemäße Führung folgender Unterlagen ist zu kontrollieren: […] die Aufzeichnungen über die Instandhaltung der Seilbahn mit Ausnahme der Blitzschutzanlage (ua. die Niederschriften über die Hauptuntersuchungen, die Aufzeichnungen über das Versetzen von festen Klemmen) zumindest über das vorangegangene Betriebsjahr; …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "93794e3e-7b3d-375a-abb7-a79b664c8c70",
                        "entry_id": "9724c138-53a0-3f3a-b4b2-927650595351",
                        "glosses": [
                            "periodische Überprüfung von technischen Einrichtungen",
                            "in Deutschland insbesondere von Kraftfahrzeugen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1a\""
                    }
                ],
