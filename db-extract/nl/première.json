                                "target_senses": [
                                    {
                                        "sense_id": "6a8e8fbb-a22e-3269-8392-5b422988bfa7",
                                        "entry_id": "ab89ccff-c5ec-3149-8551-ed1fdd1732a2",
                                        "glosses": [
                                            "Nom que l’on donne à la toute première représentation publique d’un spectacle, d’un film, d’une pièce de théâtre, etc, d'une opération chirurgicale, d'une ascension par une nouvelle voie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb5dc190-ecdc-4b22-9c78-705212682f4e",
                                                "sense_id": "6a8e8fbb-a22e-3269-8392-5b422988bfa7",
                                                "text": "On ne savait pas encore la date exacte de la première."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "284461b9-f764-39a9-888f-5daca8fbc5e5",
                                        "entry_id": "ab89ccff-c5ec-3149-8551-ed1fdd1732a2",
                                        "glosses": [
                                            "Chose faite pour la première fois dans un secteur d'activité, un domaine ou une zone géographique donnés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4812b016-0903-41e0-8f38-ce0df684c9e4",
                                                "sense_id": "284461b9-f764-39a9-888f-5daca8fbc5e5",
                                                "text": "Après plusieurs expertises médicales, le Conseil d’État requiert de cesser l’alimentation et l’hydratation de Vincent Lambert. Une première en France."
                                            },
                                            {
                                                "example_id": "15a231d6-d056-4b82-82dd-42313b88b5ba",
                                                "sense_id": "284461b9-f764-39a9-888f-5daca8fbc5e5",
                                                "text": "Le Wifi gratuit dans les aéroports parisiens à partir de juillet. Une première en Europe, qui devrait bien faciliter la vie des voyageurs."
                                            },
                                            {
                                                "example_id": "f262af22-4c1e-412a-86bc-04bca367d643",
                                                "sense_id": "284461b9-f764-39a9-888f-5daca8fbc5e5",
                                                "text": "Gage de ce nouveau goût, le logo « Matines » est désormais estampillé sur la coquille de chaque œuf, une première dans ce secteur,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7666aa31-9515-3442-aade-d3a40eba6ad8",
                                        "entry_id": "ab89ccff-c5ec-3149-8551-ed1fdd1732a2",
                                        "glosses": [
                                            "Nom donné à tout événement qui ne s’était jusqu’alors jamais produit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f3d31c-0700-4b7a-a663-0fdb26990290",
                                                "sense_id": "7666aa31-9515-3442-aade-d3a40eba6ad8",
                                                "text": "Quand l’homme a marché sur la Lune, c’était une première !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feca83f1-9c41-3b12-a5d8-b6d4b618a4ae",
                                        "entry_id": "ab89ccff-c5ec-3149-8551-ed1fdd1732a2",
                                        "glosses": [
                                            "Avant-dernière classe du lycée, entre la seconde et la terminale, pour les adolescents de 16-17 ans."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e88e31d-d056-431e-b981-8b4eecebf875",
                                                "sense_id": "feca83f1-9c41-3b12-a5d8-b6d4b618a4ae",
                                                "text": "27 juin 1941 – Dans huit jours, je ne suis plus en seconde. Donc c’est comme si j’étais en première. Quelle félicité de me sentir en première… et dernière !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca46dfa-c0bb-3356-a094-7e7852598a3b",
                                        "entry_id": "ab89ccff-c5ec-3149-8551-ed1fdd1732a2",
                                        "glosses": [
                                            "masculin et féminin identiques Élève de cette classe."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7e52681-fcce-45c1-a50e-a65b3061e991",
                                                "sense_id": "2ca46dfa-c0bb-3356-a094-7e7852598a3b",
                                                "text": "Quels bouffons ! Les garçons de terminale que j’ai connus lors de soirées ne me parlent plus dans l’enceinte du lycée parce que je ne suis qu’une première…"
                                            },
                                            {
                                                "example_id": "36869c6a-d020-4e97-9778-84af3608d0fa",
                                                "sense_id": "2ca46dfa-c0bb-3356-a094-7e7852598a3b",
                                                "text": "Sans Roméo, monsieur Palanquin a peur que nous devions changer de pièce. Déjà qu’il a échoué à appliquer l’idée géniale de Raphaëlle : distribuer les Montaigu aux terminales, les Capulet aux premières…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0cd1077-fc45-3caf-9ede-911126a857f6",
                                        "entry_id": "ab89ccff-c5ec-3149-8551-ed1fdd1732a2",
                                        "glosses": [
                                            "Première classe d’un train, d’un tramway, d’un bateau, d'un avion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21de11d2-1220-40bb-b901-11f3c2201ba3",
                                                "sense_id": "d0cd1077-fc45-3caf-9ede-911126a857f6",
                                                "text": "Les deux hommes s’installèrent dans un wagon de première."
                                            },
                                            {
                                                "example_id": "3bf53565-96af-423c-917b-2520d553ac62",
                                                "sense_id": "d0cd1077-fc45-3caf-9ede-911126a857f6",
                                                "text": "Dans le train du retour, le dimanche, j'essayais d'amuser mon fils pour qu'il se tienne tranquille, les voyageurs de première n'aiment pas le bruit et les enfants qui bougent."
                                            },
                                            {
                                                "example_id": "19503418-e74a-491f-8860-a182bea321f8",
                                                "sense_id": "d0cd1077-fc45-3caf-9ede-911126a857f6",
                                                "text": "J'passe la moitié d'ma vie en l'air\nEntre New York et Singapour\nJe voyage toujours en première."
                                            },
                                            {
                                                "example_id": "cb1326ca-c448-456d-9425-a7dc1f6e398e",
                                                "sense_id": "d0cd1077-fc45-3caf-9ede-911126a857f6",
                                                "text": "Donnez-moi une première pour Lyon."
                                            },
                                            {
                                                "example_id": "2b2c542b-ef9c-4cf0-adc1-4ca708f318fc",
                                                "sense_id": "d0cd1077-fc45-3caf-9ede-911126a857f6",
                                                "text": "Les premières, Les places de première classe"
                                            },
                                            {
                                                "example_id": "01bcd9ca-ef99-4227-9566-7c822088bb6d",
                                                "sense_id": "d0cd1077-fc45-3caf-9ede-911126a857f6",
                                                "text": "Prendre des premières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79463c8f-140b-3bba-82ac-b6c963d9a403",
                                        "entry_id": "ab89ccff-c5ec-3149-8551-ed1fdd1732a2",
                                        "glosses": [
                                            "Première loge d'un théâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efb057b1-0e44-4212-9cc9-7e8b2d8ffcbf",
                                                "sense_id": "79463c8f-140b-3bba-82ac-b6c963d9a403",
                                                "text": "Après avoir rajusté sa cravate, son gilet et son habit que le fuyard, en l’étreignant, avait fortement fripés, il s'empressa de regagner le corridor des premières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b4a5832-cab6-3e32-bc7e-dcb0430321b0",
                                        "entry_id": "ab89ccff-c5ec-3149-8551-ed1fdd1732a2",
                                        "glosses": [
                                            "Premier palier de vitesse d’un véhicule doté d’une boîte de vitesses, première vitesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "990d1b57-5e6a-4598-a12f-320c9e1c3875",
                                                "sense_id": "0b4a5832-cab6-3e32-bc7e-dcb0430321b0",
                                                "text": "Ce dernier acte accompli, il démarra calmement sa bouzine, enclencha la première et s’éloigna en direction du Requin Chagrin, où attendaient ses complices sabre au clair et champagne au frais…"
                                            },
                                            {
                                                "example_id": "b09af35d-b3da-447a-9f6f-0fd95ab1c767",
                                                "sense_id": "0b4a5832-cab6-3e32-bc7e-dcb0430321b0",
                                                "text": "On entendait au bas de la côte, du côté de Munster, l’autocar qui se mettait en première et dont le klaxon était bien connu. On le sentait peiner. On comptait les virages."
                                            },
                                            {
                                                "example_id": "ed4888fd-d206-4d54-b4e1-527b136d9936",
                                                "sense_id": "0b4a5832-cab6-3e32-bc7e-dcb0430321b0",
                                                "text": "tandis que je passe la première en éprouvant la désagréable impression d'être devenu le chauffeur de Madame, celle-ci, commodément accoudée à l'arrière, distribue à travers la glace de petits signes d'amitié aux populations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2abdb83-826b-37fd-83b8-280800028068",
                                        "entry_id": "ab89ccff-c5ec-3149-8551-ed1fdd1732a2",
                                        "glosses": [
                                            "Ouvrière qualifiée tenant la fonction de contremaître dans un atelier de couture. Appelée aussi première main."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46fb7fb2-dd45-4c72-bbbf-186ea41271d9",
                                                "sense_id": "f2abdb83-826b-37fd-83b8-280800028068",
                                                "text": "Il arrive qu’au bonheur, les « premières » sont les dernières."
                                            },
                                            {
                                                "example_id": "57527346-b28e-4455-a785-8954e253624d",
                                                "sense_id": "f2abdb83-826b-37fd-83b8-280800028068",
                                                "text": "— une première chez Dermas, pensez donc ! une femme superbe. Elle ne me regarde même pas ; elle ne sait même pas que j’existe… Pensez donc !"
                                            },
                                            {
                                                "example_id": "f89c9894-c649-4f6c-bd75-7195547baf66",
                                                "sense_id": "f2abdb83-826b-37fd-83b8-280800028068",
                                                "text": "Je te donnerai aussi un mot pour une première de chez Béchoff-David, une ancienne camarade qui n’a pas réussi. Ta garde-robe va changer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0886d97-1c2b-39ce-8d2d-62c88a501b4c",
                                        "entry_id": "ab89ccff-c5ec-3149-8551-ed1fdd1732a2",
                                        "glosses": [
                                            "Nom donné à différentes couches composant la semelle d’une chaussure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4238f8e9-22aa-4f3a-ba1f-1749d417c241",
                                                "sense_id": "a0886d97-1c2b-39ce-8d2d-62c88a501b4c",
                                                "text": "Première de propreté, première de montage."
                                            }
                                        ]
                                    }
                                ]
                            },
