                    "frequency": "Middle",
                    "semantic_group_id": "chute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En se précipitant vers la sortie, il a <w>culbuté</w> une chaise de la cuisine."
                        },
                        {
                            "text": "Le grand chien a couru si vite qu'il a <w>culbuté</w> le petit garçon dans l'herbe."
                        }
                    ],
                    "synonyms": [
                        "renverser",
                        "jeter à terre"
                    ],
                    "antonyms": [
