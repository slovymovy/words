                        "examples": [
                            {
                                "example_id": "2ccac8ac-0a46-4f70-b156-6955050a3567",
                                "sense_id": "bbb6e057-e8c9-32f8-8b8e-bbc97050eeb0",
                                "text": "The prime minister is a determined centralist in thrall to a tactless and obsessive aide, Cummings, whose skill seems limited to writing slogans in triplicate."
