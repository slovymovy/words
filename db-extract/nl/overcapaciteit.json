                            {
                                "example_id": "40c9644d-dab5-4de8-80dc-3361d87873da",
                                "sense_id": "74144a21-acdb-3754-a6f3-0e4b05dbcedd",
                                "text": "Elektriciteitscentrales moeten een flinke overcapaciteit hebben om piekbelastingen aan te kunnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b63ff6d4-028a-3688-810e-3e0af2da41f4",
                        "entry_id": "cd89ee49-320f-38b1-8065-9a979a15cfeb",
