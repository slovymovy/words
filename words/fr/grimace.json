    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "415dc4b4-3d91-361d-8f82-c75fcebf0fcf",
                    "sense_definition": "Contorsion ou déformation expressive des traits du visage, volontaire ou involontaire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'amuse devant le miroir et fait une drôle de <w>grimace</w> pour faire rire son frère."
                        },
                        {
                            "text": "Il a bu une gorgée de ce café trop amer en faisant une <w>grimace</w> de dégoût."
                        }
                    ],
                    "synonyms": [
                        "moue",
                        "rictus"
                    ],
                    "antonyms": [
                        "sourire"
                    ],
                    "common_phrases": [
                        "faire la grimace",
                        "faire des grimaces"
                    ]
                },
                {
                    "sense_id": "a3929d38-55da-3a16-8c11-7e0fe4c1d2d1",
                    "sense_definition": "Comportement hypocrite ou affecté visant à dissimuler ses véritables sentiments ; faux-semblant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "faussete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cessez toutes ces <w>grimaces</w> et dites-moi franchement ce que vous pensez de cette proposition."
                        },
                        {
                            "text": "Derrière ses <w>grimaces</w> de bienveillance se cachait une profonde indifférence envers ses collègues."
                        }
                    ],
                    "synonyms": [
                        "simagrée"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "482da411-5fd0-39df-be2f-03c630233f37",
                    "sense_definition": "Première ou troisième personne du singulier du présent de l'indicatif ou du subjonctif du verbe <w>grimacer</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comédien <w>grimace</w> sur scène pour amuser le jeune public pendant tout le spectacle."
                        },
                        {
                            "text": "Dès qu'il avale ce sirop au goût désagréable, il <w>grimace</w> aussitôt sans pouvoir s'en empêcher."
                        }
                    ],
