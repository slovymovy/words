                    "semantic_group_id": "gesaess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim Schlittschuhlaufen ist er plötzlich ausgerutscht und direkt auf seinen <w>Arsch</w> gefallen.",
                            "target_lang_translations": {
                                "en": "While ice-skating, he suddenly slipped and fell right on his <w>ass</w>.",
                                "ru": "Катаясь на коньках, он внезапно поскользнулся и упал прямо на <w>жопу</w>.",
                                "nl": "Tijdens het schaatsen gleed hij plotseling uit en viel recht op zijn <w>kont</w>.",
                                "pl": "Podczas jazdy na łyżwach nagle się poślizgnął i upadł prosto na <w>dupę</w>.",
                                "fr": "En faisant du patin à glace, il a soudainement glissé et est tombé directement sur son <w>cul</w>.",
                                "it": "Mentre pattinava sul ghiaccio, è scivolato all'improvviso ed è caduto dritto sul <w>culo</w>.",
                                "cs": "Při bruslení najednou uklouzl a spadl přímo na <w>prdel</w>.",
                                "tr": "Buz pateni yaparken aniden ayağı kaydı ve doğrudan <w>kıçının</w> üstüne düştü.",
                                "es": "Al patinar sobre hielo, de repente se resbaló y se cayó directamente sobre el <w>culo</w>.",
                                "zh": "滑冰时他突然滑倒，直接摔在了<w>屁股</w>上。"
                            }
                        },
                        {
                            "text": "Nach der langen Radtour tat ihm vom harten Sattel der ganze <w>Arsch</w> weh.",
                            "target_lang_translations": {
                                "en": "After the long bike tour, his whole <w>ass</w> hurt from the hard saddle.",
                                "ru": "После долгой поездки на велосипеде от жёсткого седла у него болела вся <w>задница</w>.",
                                "nl": "Na de lange fietstocht deed zijn hele <w>kont</w> pijn van het harde zadel.",
                                "pl": "Po długiej wycieczce rowerowej od twardego siodełka bolała go cała <w>dupa</w>.",
                                "fr": "Après la longue sortie à vélo, tout son <w>cul</w> lui faisait mal à cause de la selle dure.",
                                "it": "Dopo la lunga gita in bicicletta, gli faceva male tutto il <w>culo</w> a causa del sellino duro.",
                                "cs": "Po dlouhé vyjížďce na kole ho z tvrdého sedla bolela celá <w>prdel</w>.",
                                "tr": "Uzun bisiklet turundan sonra sert sele yüzünden bütün <w>kıçı</w> ağrıyordu.",
                                "es": "Después de la larga excursión en bicicleta, le dolía todo el <w>culo</w> por culpa del sillín duro.",
                                "zh": "长途骑行后，因为车座太硬，他的整个<w>屁股</w>都疼。"
                            }
                        }
