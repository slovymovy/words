                "senses": [
                    {
                        "sense_id": "17bca959-8c11-3eb4-8b86-ad9c7a738639",
                        "entry_id": "db9a2ffb-87b9-3350-be4e-1ec477f3af51",
                        "glosses": [
                            "het gebied dat dicht bij de kust ligt bestaande uit kustwateren, strand, duin en de polders vlak achter het duin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "816b172f-8fba-4f49-bffd-00acd988c8f3",
                                "sense_id": "17bca959-8c11-3eb4-8b86-ad9c7a738639",
                                "text": "De Waddenzee en de kustzone boven de Waddeneilanden kenden van oudsher een gezonde haaienstand, zegt visserijexpert en bioloog Wouter van der Heij van de Waddenvereniging."
                            },
                            {
                                "example_id": "61f7ad11-bbcc-4356-bd4c-1865a19dc519",
                                "sense_id": "17bca959-8c11-3eb4-8b86-ad9c7a738639",
                                "text": "De vissers zijn ten einde raad. Vanaf 2016 is de hele traditionele visserij in de kustzone van de Noordzee verboden, en in de belangrijkste delen zelfs al met ingang van volgend jaar."
                            },
                            {
                                "example_id": "279be1a9-1742-49db-9a18-de6d146d6182",
                                "sense_id": "17bca959-8c11-3eb4-8b86-ad9c7a738639",
                                "text": "Schultz van Haegen schrijft in een persbericht blij te zijn dat ze samen met bestuurders tot afspraken is gekomen. “Niemand wil de kust volbouwen”. Het is de bedoeling dat er door het kustpact een “goede balans tussen bescherming en behoud van de kust en de ontwikkeling van de kustzone wordt gevonden”, meldt het ministerie."
                            }
                        ]
                    }
