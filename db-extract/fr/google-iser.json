                "senses": [
                    {
                        "sense_id": "ba832127-fecf-3e98-8268-75a42b4506cc",
                        "entry_id": "d3a9efcf-afc2-3cf0-bf01-ff37bf1442a1",
                        "glosses": [
                            "Saisir un mot ou une phrase sur le moteur de recherche Google dans le but de trouver des réponses."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "86a8d71b-2e2f-46c4-ae95-f5e9db0b636f",
                                "sense_id": "ba832127-fecf-3e98-8268-75a42b4506cc",
                                "text": "Chérie, on s'est fait google-iser !!"
                            },
                            {
                                "example_id": "04225a0b-9bb2-4cd5-9cf1-8ec285755661",
                                "sense_id": "ba832127-fecf-3e98-8268-75a42b4506cc",
                                "text": "Fermez le bocal et entreposez-le dans un endroit frais mais à la lumière (c'est de la chimie, ça, allez google-iser si ça vous dit) pendant 1 mois au MINIMUM."
                            },
                            {
                                "example_id": "261b2fcf-c366-4a4f-a3fa-5f03849907e6",
                                "sense_id": "ba832127-fecf-3e98-8268-75a42b4506cc",
                                "text": "Que celui qui n'a jamais essayé de « googler » (on dit aussi « google-iser ») son nom jette la première pierre !"
                            }
                        ]
                    }
