                "senses": [
                    {
                        "sense_id": "04f50d41-42ca-3260-9cf1-fbc6408ec5d5",
                        "entry_id": "c87d5d9c-0916-3a12-8918-d2dcf17a3750",
                        "glosses": [
                            "miasto powiatowe w południowej Polsce, w województwie śląskim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bb7f0ff-1b4f-4cec-bfd2-e1d545f4e5ec",
                                "sense_id": "04f50d41-42ca-3260-9cf1-fbc6408ec5d5",
                                "text": "Drugi dzień Dni Zawiercia upłynął w koncertowej, imprezowej atmosferze."
                            },
                            {
                                "example_id": "1dbe32f0-a238-451d-b07b-59142c6a78ce",
                                "sense_id": "04f50d41-42ca-3260-9cf1-fbc6408ec5d5",
                                "text": "W Zawierciu w okolicach ulicy Junackiej i Kasprowicza jeden z mieszkańców zauważył polującego drapieżnika."
                            },
                            {
                                "example_id": "8dcd50b1-1c6e-4658-a4d8-7940e3a4108d",
                                "sense_id": "04f50d41-42ca-3260-9cf1-fbc6408ec5d5",
                                "text": "W okresie międzywojennym w publicystyce pojawia się nazwa „Zawiercie – miasto wymarłe” lub „miasto bezrobotnych”."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
