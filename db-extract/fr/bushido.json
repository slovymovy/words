                        "examples": [
                            {
                                "example_id": "f03b8c4c-3102-414a-a190-5ee7d0979463",
                                "sense_id": "15f189da-3bdb-3e1c-8c02-35f5d25e09cb",
                                "text": "Sept grandes vertus confucéennes sont associées au bushido : la droiture, le courage, la bienveillance, la politesse, la sincérité, l’honneur, la loyauté."
                            },
                            {
                                "example_id": "5f27b9d8-35c4-42c7-96c2-6e171b8622b7",
                                "sense_id": "15f189da-3bdb-3e1c-8c02-35f5d25e09cb",
                                "text": "L’auteur précise que le « bushido » s’inspire du bouddhisme, du confucianisme, du shintoïsme et du zen."
                            }
                        ]
