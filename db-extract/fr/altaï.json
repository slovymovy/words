                        "target_lang_word": "Altai",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altai",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "198167f4-4e96-3504-9613-9c230c507a9e",
                                        "entry_id": "a428d6fc-292a-3a1f-bb51-3e1ace9263d3",
                                        "glosses": [
                                            "A mountain range in central Asia, where Russia, China, Mongolia and Kazakhstan converge."
                                        ],
                                        "tags": [
                                            "with the"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92273199-520b-443c-92a6-976b13eff1f0",
                                                "sense_id": "198167f4-4e96-3504-9613-9c230c507a9e",
                                                "text": "Deep in the Altai Mountains, where Russia, China, Kazakhstan and Mongolia meet, Kazakh people have for centuries developed and nurtured a special bond with golden eagles, training the birds to hunt foxes and other small animals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74fd1a5b-a51f-3757-91bf-2711d63b72fb",
                                        "entry_id": "a428d6fc-292a-3a1f-bb51-3e1ace9263d3",
                                        "glosses": [
                                            "Alternative form of Altay."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41a8db02-a042-30a3-b142-5c14a79445ea",
                                        "entry_id": "a428d6fc-292a-3a1f-bb51-3e1ace9263d3",
                                        "glosses": [
                                            "A city in Govi-Altai, Mongolia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d8fbbb8-d3a2-4f2e-a53d-4918987a3c6d",
                                                "sense_id": "41a8db02-a042-30a3-b142-5c14a79445ea",
                                                "text": "Set dramatically on a dry plain, with high snow-capped peaks in the distance, is the provincial capital Altai, located 1,005 kilometres west of Ulaanbaatar. Before 1960, it was known as Yösön Bulag (the ‘nine springs’). This town of 15,000 people sits at 2,160 metres above sea level, making it the highest city in the country."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Altai",
