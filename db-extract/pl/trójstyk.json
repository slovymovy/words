                                "target_word": "Dreiländereck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05b5cff1-5c4a-3980-b259-f6fe11f72178",
                                        "entry_id": "e0a2e55e-888c-3159-9d36-18c0e98c62c2",
                                        "glosses": [
                                            "Grenzpunkt, an dem drei Länder aufeinandertreffen"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd41a6f8-4e66-46a4-afd2-f56dfbfec5da",
                                                "sense_id": "05b5cff1-5c4a-3980-b259-f6fe11f72178",
                                                "text": "Wie viele Dreiländerecke gibt es in Europa?"
                                            },
                                            {
                                                "example_id": "868e9c7e-2e55-4917-938c-34a9dbce1628",
                                                "sense_id": "05b5cff1-5c4a-3980-b259-f6fe11f72178",
                                                "text": "„Nach der Rückkehr von meiner Wanderung zum Dreiländereck fuhr ich zur norwegischen Grenze, zur Zollstation in Kilpisjärvi, direkt am Grenzübergang.“"
                                            },
                                            {
                                                "example_id": "cdbbd1eb-8596-48bf-9954-82019c065491",
                                                "sense_id": "05b5cff1-5c4a-3980-b259-f6fe11f72178",
                                                "text": "„Hunkeler badet im Rhein, ermittelt im Dreiländereck, fährt immer wieder ins Elsass, wo er mit Hedwig ein kleines Haus zur Wochenenderholung und als Rückzugsort nutzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
