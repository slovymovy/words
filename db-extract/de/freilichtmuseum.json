                    {
                        "translation_id": "79989489-f1f3-4c40-b144-66e255610b51",
                        "source_entry_id": "e5898090-2041-3000-8064-44957de18734",
                        "source_sense_id": "6eacdb86-4142-336f-95e1-fc0d7b10aeec",
