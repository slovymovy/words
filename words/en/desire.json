{
    "word_family": [
        "desirable",
        "desirability",
        "desirous",
        "undesirable",
        "undesired"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0dac1ad9-d58e-3bf9-bbcc-35e4cfa4c8b6",
                    "sense_definition": "To want or wish for something earnestly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wanting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>desire</w> to speak with you about the upcoming project.",
                            "target_lang_translations": {
                                "ru": "Я <w>желаю</w> поговорить с вами о предстоящем проекте."
                            }
                        },
                        {
                            "text": "Many people <w>desire</w> success but few are willing to work for it.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>желают</w> успеха, но немногие готовы ради него работать."
                            }
                        }
                    ],
                    "synonyms": [
                        "want",
                        "wish",
                        "hope"
                    ],
                    "common_phrases": [
                        "desire to speak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искренне хотеть или желать чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желать",
                                "target_lang_sense_clarification": "хотеть чего-либо"
                            },
                            {
                                "target_lang_word": "хотеть",
                                "target_lang_sense_clarification": "иметь потребность или желание"
                            },
                            {
                                "target_lang_word": "стремиться",
                                "target_lang_sense_clarification": "сильно желать достичь чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84afede6-68d8-34aa-a1b8-dbe5ac20695b",
                    "sense_definition": "To feel a strong emotional or sexual attraction toward someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has <w>desired</w> him since the first moment they met at the gala.",
                            "target_lang_translations": {
                                "ru": "Она <w>желала</w> его с того самого момента, как они встретились на торжестве."
                            }
                        },
                        {
                            "text": "It was clear from his gaze that he <w>desired</w> her deeply.",
                            "target_lang_translations": {
                                "ru": "По его взгляду было ясно, что он глубоко её <w>вожделеет</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lust"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать сильное эмоциональное или сексуальное влечение к кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желать",
                                "target_lang_sense_clarification": "испытывать влечение"
                            },
                            {
                                "target_lang_word": "вожделеть",
                                "target_lang_sense_clarification": "страстно желать, книжное"
                            },
                            {
                                "target_lang_word": "хотеть",
                                "target_lang_sense_clarification": "испытывать физическое влечение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d6510c4-b9e0-3cfa-8940-1f2feebeed82",
                    "sense_definition": "To express a wish for something or to request someone to do something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "requesting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>desire</w> him to go in and wait for the manager.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>попросите</w> его войти и подождать менеджера."
                            }
                        },
                        {
                            "text": "The queen <w>desired</w> that her subjects remain peaceful during the transition.",
                            "target_lang_translations": {
                                "ru": "Королева <w>пожелала</w>, чтобы её подданные сохраняли спокойствие во время перехода власти."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal request"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать пожелание или просить кого-либо сделать что-либо (официально)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просить",
                                "target_lang_sense_clarification": "обращаться с просьбой"
                            },
                            {
                                "target_lang_word": "желать",
                                "target_lang_sense_clarification": "выражать волю или просьбу"
                            },
                            {
                                "target_lang_word": "повелевать",
                                "target_lang_sense_clarification": "официально требовать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e48c10e1-ad3c-323d-8814-ef0e4f54772d",
                    "sense_definition": "A strong feeling of wanting to have something or wishing for something to happen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wanting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>desire</w> for success motivated him to work late every night.",
                            "target_lang_translations": {
                                "ru": "Его <w>желание</w> добиться успеха заставляло его работать допоздна каждую ночь."
                            }
                        },
                        {
                            "text": "Too much <w>desire</w> can seriously affect one’s judgement in difficult situations.",
                            "target_lang_translations": {
                                "ru": "Слишком сильное <w>желание</w> может серьезно повлиять на рассудительность в трудных ситуациях."
                            }
                        }
                    ],
                    "synonyms": [
                        "longing",
                        "yearning",
                        "craving",
                        "wish",
                        "want"
                    ],
                    "antonyms": [
                        "apathy",
                        "disinterest"
                    ],
                    "common_phrases": [
                        "strong desire",
                        "burning desire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное чувство потребности в чем-либо или желание, чтобы что-то произошло."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желание",
                                "target_lang_sense_clarification": "стремление к чему-либо"
                            },
                            {
                                "target_lang_word": "стремление",
                                "target_lang_sense_clarification": "настойчивое желание"
                            },
                            {
                                "target_lang_word": "охота",
                                "target_lang_sense_clarification": "разговорное желание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98cf6d34-c2ce-358b-982a-843bfee74e3a",
                    "sense_definition": "A person or thing that is wanted or wished for.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wanting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of searching, he finally found his heart's <w>desire</w>.",
                            "target_lang_translations": {
                                "ru": "После долгих лет поисков он наконец нашел то, чего так <w>желало</w> его сердце."
                            }
                        },
                        {
                            "text": "The new car was his primary <w>desire</w> for the year.",
                            "target_lang_translations": {
                                "ru": "Новая машина была его главным <w>желанием</w> в этом году."
                            }
                        }
                    ],
                    "synonyms": [
                        "dream"
                    ],
                    "common_phrases": [
                        "hearts desire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, которые являются объектом желания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желание",
                                "target_lang_sense_clarification": "объект стремлений"
                            },
                            {
                                "target_lang_word": "мечта",
                                "target_lang_sense_clarification": "заветное желание"
                            },
                            {
                                "target_lang_word": "предмет желаний",
                                "target_lang_sense_clarification": "то, чего хотят"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9809943-d987-309c-b0bc-34efccbf7fa7",
                    "sense_definition": "A strong feeling of sexual attraction or romantic love.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>desire</w> for her kept him awake at night thinking of her.",
                            "target_lang_translations": {
                                "ru": "Его <w>влечение</w> к ней не давало ему спать по ночам, заставляя думать о ней."
                            }
                        },
                        {
                            "text": "The movie explores the themes of love and physical <w>desire</w>.",
                            "target_lang_translations": {
                                "ru": "Фильм исследует темы любви и физического <w>желания</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lust",
                        "concupiscence"
                    ],
                    "antonyms": [
                        "distaste",
                        "hatred"
                    ],
                    "common_phrases": [
                        "sexual desire",
                        "physical desire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное чувство сексуального влечения или романтической любви."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желание",
                                "target_lang_sense_clarification": "любовное влечение"
                            },
                            {
                                "target_lang_word": "вожделение",
                                "target_lang_sense_clarification": "сильное чувственное влечение"
                            },
                            {
                                "target_lang_word": "влечение",
                                "target_lang_sense_clarification": "склонность, тяга к кому-либо"
                            },
                            {
                                "target_lang_word": "страсть",
                                "target_lang_sense_clarification": "сильное чувство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}