        "fr-extract.jsonl": [
            {
                "entry_id": "aafaf45e-ddfc-347f-a766-a21f9e238845",
                "word": "analphabétisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a678aa16-7d52-4db3-8840-466e20e231e0",
                        "entry_id": "aafaf45e-ddfc-347f-a766-a21f9e238845",
                        "tags": [
                            "plural"
                        ],
                        "form": "analphabétismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "053b33ac-3021-3444-ab0a-4368a3d1f13a",
                        "entry_id": "aafaf45e-ddfc-347f-a766-a21f9e238845",
                        "glosses": [
                            "Incapacité complète à lire et à écrire, le plus souvent par manque d’apprentissage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "926e60f9-683c-4dca-81b0-e4ad1241a742",
                                "sense_id": "053b33ac-3021-3444-ab0a-4368a3d1f13a",
                                "text": "Si la fameuse liquidation de l’analphabétisme, tant admirée, tarde tant à s’accomplir, c’est aussi que les malheureux instituteurs, travailleurs isolés, n’arrivent souvent pas à toucher leur maigre traitement […]. De sorte que l’on se demande comment les instituteurs vivent encore et si, avant la liquidation de l’analphabétisme, on n’assiste pas à celle du professorat."
                            },
                            {
                                "example_id": "cba9bef5-867f-488e-ab6d-1114de94346b",
                                "sense_id": "053b33ac-3021-3444-ab0a-4368a3d1f13a",
                                "text": "L’analphabétisme est en constante régression dans le monde, même si, aujourd’hui encore, trop d’enfants n’ont pas accès à l'école."
                            },
                            {
                                "example_id": "33454b52-3185-400d-9c4a-b142ce37c20b",
                                "sense_id": "053b33ac-3021-3444-ab0a-4368a3d1f13a",
                                "text": "Parfois, est réputé alphabète celui qui sait lire et écrire son nom. Ces critères assez simplistes se reflètent encore parfois, de nos jours, soit dans les programmes d’alphabétisation, soit dans la détermination des dimensions du problème de l’analphabétisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64196852-caab-4767-be6e-aad0b1ab5865",
                        "source_entry_id": "aafaf45e-ddfc-347f-a766-a21f9e238845",
                        "source_sense_id": "053b33ac-3021-3444-ab0a-4368a3d1f13a",
                        "target_lang_word": "Analphabetismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Analphabetismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb1fa71a-98c2-3034-9dda-8f3290fffc62",
                                        "entry_id": "2272c07a-4e2b-36b4-92e0-6afcf56f4faf",
                                        "glosses": [
                                            "Zustand, in dem Jemand nicht Lesen und Schreiben kann, Zustand eines Analphabeten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fb871ef-369d-4836-8258-551854cc257a",
                                                "sense_id": "cb1fa71a-98c2-3034-9dda-8f3290fffc62",
                                                "text": "Das Bildungsministerium startet eine Kampagne gegen Analphabetismus."
                                            },
                                            {
                                                "example_id": "0608bf82-1a0b-45ab-aa0b-e53700b9b8d4",
                                                "sense_id": "cb1fa71a-98c2-3034-9dda-8f3290fffc62",
                                                "text": "Die Statistik verschweigt die Häufigkeit funktionaler Analphabetismen."
                                            },
                                            {
                                                "example_id": "5a440a42-d36d-4a09-aace-61d3e5fab61b",
                                                "sense_id": "cb1fa71a-98c2-3034-9dda-8f3290fffc62",
                                                "text": "„Bei mehr als der Hälfte aller Staaten der Erde liegt der Analphabetismus, oder besser gesagt, die Illiteralität, bei über 50% der Bevölkerung.“"
                                            },
                                            {
                                                "example_id": "9b5adc1e-533d-4c5c-9284-3f411a1443bd",
                                                "sense_id": "cb1fa71a-98c2-3034-9dda-8f3290fffc62",
                                                "text": "„Der Analphabetismus lag bei über achtzig Prozent, die Arbeitslosigkeit war fast ebenso hoch.“"
                                            },
                                            {
                                                "example_id": "646bb7af-03b2-4fd5-86b5-09db499b4153",
                                                "sense_id": "cb1fa71a-98c2-3034-9dda-8f3290fffc62",
                                                "text": "„Beide Städte kämpfen mit Analphabetismus, Armut und Arbeitslosigkeit.“"
                                            },
                                            {
                                                "example_id": "127ac841-2754-461b-8dff-229b382ec9bd",
                                                "sense_id": "cb1fa71a-98c2-3034-9dda-8f3290fffc62",
                                                "text": "„Alles in allem: eher harmlose und daher verzeihliche Mißgriffe, die sicherlich auch keinen gutgläubigen Leser an den Rand des Analphabetismus bringen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "871e4e1b-acbe-46a1-8ceb-3d0047529dc9",
                        "source_entry_id": "aafaf45e-ddfc-347f-a766-a21f9e238845",
                        "source_sense_id": "053b33ac-3021-3444-ab0a-4368a3d1f13a",
                        "target_lang_word": "illiteracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illiteracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf9f575-e2f9-3d2a-b90c-9c07eabbacc9",
                                        "entry_id": "729d31a7-f2c1-3797-aef5-c83c05c1c8ec",
                                        "glosses": [
                                            "The inability to read and write."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c805e3db-6ee4-46ae-8dca-5129e8800d78",
                                                "sense_id": "2bf9f575-e2f9-3d2a-b90c-9c07eabbacc9",
                                                "text": "Illiteracy is widespread in certain areas of the country."
                                            },
                                            {
                                                "example_id": "15cabb75-71d2-49c5-8775-081b2a857cc1",
                                                "sense_id": "2bf9f575-e2f9-3d2a-b90c-9c07eabbacc9",
                                                "text": "The heroines of these plays speak out against intraracial biases, stereotyping, lynchmobs, illiteracy, poverty, promiscuity, self-righteousness, verbally abusive men, rape, and miscegenation. […] Without warning the doctor, she chokes the life out of her child in order to keep him safe from white lynchmobs."
                                            },
                                            {
                                                "example_id": "f8dd2712-c7cb-4193-a1b6-50685e43e572",
                                                "sense_id": "2bf9f575-e2f9-3d2a-b90c-9c07eabbacc9",
                                                "text": "While some local governments ignore the illiteracy problem, others are actively campaigning to teach people to read and write. In the villages of Xiping County in Henan Province in central China, students stop visitors and ask them to read a few characters on a blackboard. Any visitor who cannot read the characters is not allowed to enter the village. This means that illiterates are effectively grounded, and in frustration many have joined the special reading classes offered in each village. Now in Xiping County, according to local officials, only 1.7 percent of those between the ages of 20 and 40 are illiterate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3567f479-7870-3b5b-8c05-9425e70e9ce4",
                                        "entry_id": "729d31a7-f2c1-3797-aef5-c83c05c1c8ec",
                                        "glosses": [
                                            "The portion of a population unable to read and write, generally given as a percentage."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4311603d-a80f-3155-8fb8-50f7c6195683",
                                        "entry_id": "729d31a7-f2c1-3797-aef5-c83c05c1c8ec",
                                        "glosses": [
                                            "A word, phrase, or grammatical turn thought to be characteristic of an illiterate person."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23a2233b-0e24-3c1d-8db7-839789979e73",
                                        "entry_id": "729d31a7-f2c1-3797-aef5-c83c05c1c8ec",
                                        "glosses": [
                                            "Unlearnedness; the state of being ignorant or unlettered."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
