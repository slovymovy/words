                ],
                "senses": [
                    {
                        "sense_id": "c9f64838-206a-30e7-9e97-c3c398cd2f28",
                        "entry_id": "cff4071d-8599-32b6-9522-fa3389d8f073",
                        "glosses": [
                            "Mettre une majuscule à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d97d0185-9537-409c-9754-02385836e94c",
                                "sense_id": "c9f64838-206a-30e7-9e97-c3c398cd2f28",
                                "text": "— Que s'il majusculait la première lettre des substantifs, il ne fallait voir là qu'une habitude d'Allemand."
                            },
                            {
                                "example_id": "b7e2fa6a-d671-4e7c-8190-8cf54bfa4df4",
                                "sense_id": "c9f64838-206a-30e7-9e97-c3c398cd2f28",
                                "text": "Par la Fin, qu'il convient ainsi de majusculer."
                            },
                            {
                                "example_id": "ca740571-c297-4f45-9fa5-e2a84ae13757",
                                "sense_id": "c9f64838-206a-30e7-9e97-c3c398cd2f28",
                                "text": "Mais ne s'agit-il pas d'échapper au pouvoir des mots qui ont une certaine tendance à se majusculer d'eux-mêmes ?"
                            },
                            {
                                "example_id": "db034142-ea33-4895-b9a5-992be7aa2f78",
                                "sense_id": "c9f64838-206a-30e7-9e97-c3c398cd2f28",
                                "text": "Ce document signé de la main d'un général au paraphe autoritaire prouvait, avec le charme que procurent ces belles calligraphies, qui majusculent jusqu'au nom des imbéciles, que dès l'âge de trente-neuf ans, le Caporal Lendemain, promu adjudant, passait de l'active à la réserve […]."
                            }
                        ]
                    }
                ],
