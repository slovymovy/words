                        "glosses": [
                            "Escadron de cavalerie de trente cavaliers et trois officiers dans l’armée romaine."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "ed3020bd-9cb0-4a18-b0ce-4b1adec8b13b",
                                "sense_id": "16cd2afa-de40-301c-904a-03e138b2d17c",
                                "text": "Cette cavalerie se divisait en turmes. Une turme, ou décurie, comptait trente-deux cavaliers commandés par un décurion (decurio)"
                            },
                            {
                                "example_id": "b205ddc5-d348-471b-847c-81bc5be1bacb",
                                "sense_id": "16cd2afa-de40-301c-904a-03e138b2d17c",
                                "text": "Il suffit que les Indiennes l’entraînassent avec elles pour qu’apparut aux soldats ce que l’habitude ne leur avait pas permis de remarquer. Le Balte et sa turme virent avec un mélange en part égale d’admiration et d’épouvante paraître aux yeux de tous, sa pauvre veste ôtée sans résistance, les deux seins tendus de Colombe."
                            }
                        ]
                    }
