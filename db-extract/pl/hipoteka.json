                "translations": [
                    {
                        "translation_id": "36c4ae4f-bb36-4421-ab31-a551d4bd1ecb",
                        "source_entry_id": "61e3aaa7-a116-3a1a-8c85-cfd15f326310",
                        "source_sense_id": "63cd5edb-98a4-3e45-865f-bf49f9dcbc79",
                        "target_lang_word": "mortgage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mortgage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95a08e9f-4414-3ffc-996f-c8ec30765bc3",
                                        "entry_id": "02ad905d-6ad5-3600-ad2d-5196a932c8a6",
                                        "glosses": [
                                            "A special form of secured loan where the purpose of the loan must be specified to the lender, to purchase assets that must be fixed (not movable) property, such as a house or piece of farm land. The assets are registered as the legal property of the borrower but the lender can seize them and dispose of them if they are not satisfied with the manner in which the repayment of the loan is conducted by the borrower. Once the loan is fully repaid, the lender loses this right of seizure and the assets are then deemed to be unencumbered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a671e0d-d01e-45d5-b20f-ac26a237f511",
                                                "sense_id": "95a08e9f-4414-3ffc-996f-c8ec30765bc3",
                                                "text": "We're renting a property in the city centre because we can't afford to get a mortgage yet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed8e689f-c9ab-3bb8-bf43-747a5d593977",
                                        "entry_id": "02ad905d-6ad5-3600-ad2d-5196a932c8a6",
                                        "glosses": [
                                            "State of being pledged."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c587310-c2a2-4f09-9a17-fb68b8354f5e",
                                                "sense_id": "ed8e689f-c9ab-3bb8-bf43-747a5d593977",
                                                "text": "lands given in mortgage"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mortgage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b71782ca-6151-320f-969a-aeb70f9e080d",
                                        "entry_id": "16f3ad02-1ea2-36c8-b748-bda419dfe4e7",
                                        "glosses": [
                                            "To borrow against a property, to obtain a loan for another purpose by giving away the right of seizure to the lender over a fixed property such as a house or piece of land; to pledge a property in order to get a loan."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d428e921-46f5-44cf-9772-587e726616b6",
                                                "sense_id": "b71782ca-6151-320f-969a-aeb70f9e080d",
                                                "text": "to mortgage a property, an estate, or a shop"
                                            },
                                            {
                                                "example_id": "259af901-85c5-4125-9cd9-f21b7746686d",
                                                "sense_id": "b71782ca-6151-320f-969a-aeb70f9e080d",
                                                "text": "We mortgaged our house in order to start a company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "861a149a-a578-31bf-bdbf-e76e75f19740",
                                        "entry_id": "16f3ad02-1ea2-36c8-b748-bda419dfe4e7",
                                        "glosses": [
                                            "To pledge and make liable; to make subject to obligation; to achieve an immediate result by paying for it in the long term."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a1ccc97-82ff-41a3-8d69-adae0bcf00ab",
                                                "sense_id": "861a149a-a578-31bf-bdbf-e76e75f19740",
                                                "text": "She mortgaged her future for the pleasures of the relationship with the sculptor, a relationship she knew would be short."
                                            },
                                            {
                                                "example_id": "6ab0503b-026e-428f-a8dc-30ab65e71833",
                                                "sense_id": "861a149a-a578-31bf-bdbf-e76e75f19740",
                                                "text": "Like a latter-day Faustus who has mortgaged his soul to the pursuit of his art, Harrison now desperately craves the paternal love from which his learning has estranged him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bd9c213-c22c-48c1-ad3e-cfe43ccda444",
                        "source_entry_id": "61e3aaa7-a116-3a1a-8c85-cfd15f326310",
                        "source_sense_id": "63cd5edb-98a4-3e45-865f-bf49f9dcbc79",
                        "target_lang_word": "hypothèque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypothèque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2dda12d9-c5d2-3973-aaa7-171cae4861f3",
                                        "entry_id": "70336c4a-ee33-37cc-b2b3-17edfbb4a95d",
                                        "glosses": [
                                            "Accord entre celui qui emprunte de l’argent (le propriétaire) et celui qui fournit l’argent (le créancier). Si le montant d’argent (qui est égal à la valeur de la propriété) n’est pas remboursé, le créancier peut faire réaliser le bien, généralement par vente aux enchères, afin d'obtenir la somme qui lui est due. (En jargon juridique : droit réel qui grève les immeubles affectés à la sûreté, à l’acquittement d’une obligation, d’une dette, et qui les suit en quelques mains qu’ils passent.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f94439f-f258-4a0c-89cc-07b72e7639eb",
                                                "sense_id": "2dda12d9-c5d2-3973-aaa7-171cae4861f3",
                                                "text": "Sans prétendre à relever ma fortune, puisque Guillaume a de la répugnance pour une carrière quelconque qui enchaînerait son indépendance, je dois achever de libérer quelques terres de certaines hypothèques que mon mari a été forcé de laisser prendre."
                                            },
                                            {
                                                "example_id": "260da064-3d18-4d3c-a8cc-cf11465d81a8",
                                                "sense_id": "2dda12d9-c5d2-3973-aaa7-171cae4861f3",
                                                "text": "Les paysans du Lot, il y a vingt ans, étaient misérables, accablés par les hypothèques dont une prospérité relative, survenue à la suite de la guerre, les libéra."
                                            },
                                            {
                                                "example_id": "eab8fb86-8f97-47ff-b890-9c76a0e8caa5",
                                                "sense_id": "2dda12d9-c5d2-3973-aaa7-171cae4861f3",
                                                "text": "L’hôtel aussi, au moins métaphoriquement, croula : l’hypothèque n’était qu’une seconde hypothèque, et, disait-on, irrécupérable."
                                            },
                                            {
                                                "example_id": "2f71dda0-20ee-4550-9b23-d6605795f69c",
                                                "sense_id": "2dda12d9-c5d2-3973-aaa7-171cae4861f3",
                                                "text": "Déclaration d’hypothèque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f361f08c-edfb-3152-be68-046068836467",
                                        "entry_id": "70336c4a-ee33-37cc-b2b3-17edfbb4a95d",
                                        "glosses": [
                                            "Charge figurée qui reste après des actions précédentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19bd3fd6-6d7c-4315-9a41-1ccb1fb15c43",
                                                "sense_id": "f361f08c-edfb-3152-be68-046068836467",
                                                "text": "Le procès en destitution s’en vient et la guerre civile entre républicains durera tant que le parti ne se sera pas débarrassé de l’hypothèque trumpiste."
                                            }
                                        ]
                                    }
                                ]
                            },
