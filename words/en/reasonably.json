                    "sense_id": "f27e4d2b-0dc0-3309-8c95-3971e9d4f682",
                    "sense_definition": "To a moderate or acceptable degree; fairly or satisfactorily.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree_moderation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The food at the restaurant was delicious and <w>reasonably</w> priced.",
                            "target_lang_translations": {
                                "ru": "Еда в ресторане была вкусной и стоила <w>приемлемо</w>.",
                                "nl": "Het eten in het restaurant was heerlijk en <w>redelijk</w> geprijsd.",
                                "pl": "Jedzenie w restauracji było pyszne i <w>przystępnie</w> wycenione.",
                                "de": "Das Essen im Restaurant war köstlich und <w>preiswert</w>.",
                                "fr": "La nourriture au restaurant était délicieuse et à un prix <w>raisonnable</w>.",
                                "it": "Il cibo al ristorante era delizioso e a un prezzo <w>ragionevole</w>.",
                                "cs": "Jídlo v restauraci bylo vynikající a <w>přiměřeně</w> drahé.",
                                "tr": "Restorandaki yemek lezzetliydi ve <w>makul</w> fiyatlıydı.",
                                "es": "La comida en el restaurante estaba deliciosa y tenía un precio <w>razonablemente</w> asequible.",
                                "zh": "这家餐厅的食物很美味，而且价格<w>相当</w>合理。"
                            }
                        },
                        {
                            "text": "I am <w>reasonably</w> sure that I left my keys on the table.",
                            "target_lang_translations": {
                                "ru": "Я <w>довольно</w> уверен, что оставил ключи на столе.",
                                "nl": "Ik ben er <w>redelijk</w> zeker van dat ik mijn sleutels op tafel heb laten liggen.",
                                "pl": "Jestem <w>dość</w> pewien, że zostawiłem klucze na stole.",
                                "de": "Ich bin mir <w>einigermaßen</w> sicher, dass ich meine Schlüssel auf dem Tisch gelassen habe.",
                                "fr": "Je suis <w>raisonnablement</w> sûr d'avoir laissé mes clés sur la table.",
                                "it": "Sono <w>ragionevolmente</w> sicuro di aver lasciato le chiavi sul tavolo.",
                                "cs": "Jsem si <w>docela</w> jistý, že jsem nechal klíče na stole.",
                                "tr": "Anahtarlarımı masanın üzerinde bıraktığımdan <w>oldukça</w> eminim.",
                                "es": "Estoy <w>razonablemente</w> seguro de que dejé mis llaves en la mesa.",
                                "zh": "我<w>相当</w>确定我把钥匙落在桌子上了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fairly",
                        "quite",
                        "moderately",
                        "adequately",
                        "relatively",
                        "pretty"
