                        "tags": [],
                        "form": "zigue"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4659dc39-0516-3c88-836a-9eb29e4cf662",
                        "entry_id": "8cb799b0-6329-3dfd-83bb-5af287c9b340",
                        "glosses": [
                            "Type ; individu ; quidam."
                        ],
                        "tags": [
                            "colloquial",
                            "familiar",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b30b8e06-81a5-4382-96b6-ed70bbfbcd36",
                                "sense_id": "4659dc39-0516-3c88-836a-9eb29e4cf662",
                                "text": "Vous ne pouvez pas savoir à quel point un zig en train de mourir est hostile à toute forme de conversation."
                            },
                            {
                                "example_id": "6d706a24-351b-4172-81f5-9c511200de95",
                                "sense_id": "4659dc39-0516-3c88-836a-9eb29e4cf662",
                                "text": "À propos de gapettes et de bitos, on avait récemment lu un article dans lequel il était dit que les Texans avaient la manie de flinguer les zigs aux cheveux longs. Bien que nos cheveux ne pendouillassent pas jusqu’au milieu du dos, tout de même, vu la situation, il valait mieux qu'on se fît légèrement dégager la nuque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bc23516-321b-4b7e-84b6-39a27410b3c8",
                        "source_entry_id": "8cb799b0-6329-3dfd-83bb-5af287c9b340",
                        "source_sense_id": "4659dc39-0516-3c88-836a-9eb29e4cf662",
                        "target_lang_word": "vent",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vent",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                                        "entry_id": "55e7ce03-8c29-31a1-9007-fc842ecfd73a",
                                        "glosses": [
                                            "kerel, man (wordt zowel positieve als in negatieve zin gebruikt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b986a4c-83cc-45fc-a2d6-00cf4b77c13b",
                                                "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                                                "text": "Een toffe gozer, een jofele vent."
                                            },
                                            {
                                                "example_id": "ffb7ae01-9e82-486e-a617-11b79227a808",
                                                "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                                                "text": "Nee, die man van mij, dat is een eitje, een vent van niks!"
                                            },
                                            {
                                                "example_id": "ff6ec868-e1fb-4747-816a-f4bdcaa63723",
                                                "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                                                "text": "Ik dacht bij mezelf dat je naar die vent was teruggegaan."
                                            },
                                            {
                                                "example_id": "21e41708-8e2e-479a-8275-653c0174f37e",
                                                "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                                                "text": "'Vertel me eens over die vent met wie je op de bruiloft stond te praten?' vervolgde ze met een sluwe blik in haar ogen."
                                            },
                                            {
                                                "example_id": "cf43c7cd-2f77-420f-8333-0606e0e1f72c",
                                                "sense_id": "c60a5c41-51b1-33f9-93d4-0ed67111e236",
                                                "text": "Het was een lange slanke vent van in de veertig, en in tegenstelling tot alle andere hikers was hij glad geschoren met een verzorgde, gezonde uitstraling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b657c214-8dfd-34c8-a0fc-3dfcb2816a72",
                                        "entry_id": "55e7ce03-8c29-31a1-9007-fc842ecfd73a",
                                        "glosses": [
                                            "gecastreerde ezel"
                                        ],
                                        "tags": [
                                            "regionaal in Vlaanderen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03a3f239-6cbb-4081-aa92-086cc361b4ca",
                                                "sense_id": "b657c214-8dfd-34c8-a0fc-3dfcb2816a72",
                                                "text": "Maar ze vergeten ondertussen wel dat “vent” oorspronkelijk “gecastreerde ezel” betekent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vent",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "baa3e8d3-5602-37c6-946e-fcff6988559f",
                                        "entry_id": "a9d53993-dff4-3583-a81a-05acefb58105",
                                        "glosses": [
                                            "opening waardoor lucht een afgesloten ruimte in of uit kan stromen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e9ebc7a-2b2f-4ab8-8da1-1f6d9723540f",
                                                "sense_id": "baa3e8d3-5602-37c6-946e-fcff6988559f",
                                                "text": "In de periode van 23 tot en met 27 augustus 2007 waren er verhoogde acrylonitril (AN)-metingen rond de trein (fabriek) 4 en 5 bij het SNP tankenpark bij Dow in Terneuzen142. Dit bleek te wijten aan een lekkende ERV-pakking van voedingstank 2TV-417 en een defecte N₂ PCV van de 4VE430-tank van trein 4 die continue N₂ aan het suppleren was met als gevolg dat niet alle vents naar de fornuizen gingen, maar dat een deel ook naar buiten ontluchtte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vent",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ed488560-3083-3bbc-8ddf-80efdf12bb1d",
                                        "entry_id": "9f285a0e-16cd-39c7-addd-aa686a486a78",
                                        "glosses": [
                                            "enkelvoud tegenwoordige tijd van venten"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea103e9d-845f-39b9-8b7a-33550cf8846b",
                                        "entry_id": "9f285a0e-16cd-39c7-addd-aa686a486a78",
                                        "glosses": [
                                            "gebiedende wijs van venten"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d268d986-7b08-4518-b12b-5ff2d33d75e4",
                                                "sense_id": "ea103e9d-845f-39b9-8b7a-33550cf8846b",
                                                "text": "Nee, ik vent niet meer, ik sta nu op de markt, minder gesjouw weet je ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78d20078-bc74-4ddc-b95b-84098aa87d44",
                        "source_entry_id": "8cb799b0-6329-3dfd-83bb-5af287c9b340",
                        "source_sense_id": "4659dc39-0516-3c88-836a-9eb29e4cf662",
                        "target_lang_word": "kerel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kerel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cfff3179-1b09-3086-8da6-6683b97202c7",
                                        "entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                                        "glosses": [
                                            "vrije man van lage geboorte"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7cf6261-d8db-3a46-aed9-5c4c47319930",
                                        "entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                                        "glosses": [
                                            "forse, stevige man (een echte vent)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ad8cb33-fdc2-47e3-bc5b-4db9c3fd9b78",
                                                "sense_id": "d7cf6261-d8db-3a46-aed9-5c4c47319930",
                                                "text": "Een brede kerel kwam het pad oplopen met twee grote emmers water in zijn handen."
                                            },
                                            {
                                                "example_id": "655e8ac3-9a3b-460a-a909-1e9e703d7e9e",
                                                "sense_id": "d7cf6261-d8db-3a46-aed9-5c4c47319930",
                                                "text": "Ze waren de onbetwiste heerseressen van de barakken en hielden zonder problemen een twintigtal kerels onder de duim, hoe naar liefde snakkend die zich ook konden gedragen na meerdere maanden in de bergen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08ef95a8-cf66-34d3-b640-8abeb6c201d5",
                                        "entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                                        "glosses": [
                                            "man, echtgenoot"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e997fdc0-6b10-3f70-b70b-a23ea9da5d90",
                                        "entry_id": "954f1f90-23e8-306c-b05c-a21222b70f5c",
                                        "glosses": [
                                            "mannelijk persoon"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "191e2312-d3b0-4977-bbca-5c297e279ef2",
                                                "sense_id": "e997fdc0-6b10-3f70-b70b-a23ea9da5d90",
                                                "text": "Hier was duidelijk het verschil in leeftijd te zien: jonge kerels willen alles uitproberen, hoe gevaarlijker hoe beter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
