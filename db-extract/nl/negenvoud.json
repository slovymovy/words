                        "glosses": [
                            "in negenvoud: negen exemplaren van hetzelfde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7eb74f1-7b62-4daa-bfe6-2b820d49e9e2",
                                "sense_id": "53bdde58-3777-38ec-8bda-ed81acad9cac",
                                "text": "Zo’n honderd gemeenten en organisaties in Duitsland, Oostenrijk en Zwitserland hebben op de expositie ingetekend. Deze komt in negenvoud beschikbaar."
                            }
                        ]
                    },
