                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a5c8a57-a638-4cde-a4aa-c8de2a084632",
                                "sense_id": "0a9d62d5-1b0b-3aad-ae2a-5678eba39e64",
                                "text": "„Friedrich I. Barbarossa übertrug im Jahre 1181 seinem Stellvertreter in Esslingen politische und rechtliche Aufgaben, die das Umland betrafen und machte Esslingen spätestens damit zur Reichslandstadt.“"
                            },
                            {
                                "example_id": "e9221731-3a62-4b9f-8fe8-95a8648748cb",
                                "sense_id": "0a9d62d5-1b0b-3aad-ae2a-5678eba39e64",
                                "text": "„Eine »systemische Schwäche der neuen Gesetzeslage« beklagt Jürgen Bernhardt, Geschäftsführer von BioTeSys in Esslingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
