                ],
                "senses": [
                    {
                        "sense_id": "248aaa9e-36e7-3ea7-9c90-d714bd0c01e3",
                        "entry_id": "37176fb1-755e-3791-8148-f3cbe0b3587e",
                        "glosses": [
                            "книжн. полный серьёзных, значительных и сложных по содержанию мыслей; содержащий глубокую, значительную мысль (мысли)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bbff55d-04c2-44db-be11-0289d25f20a6",
                                "sense_id": "248aaa9e-36e7-3ea7-9c90-d714bd0c01e3",
                                "text": "Глубокомысленное сочинение."
                            },
                            {
                                "example_id": "659bb97d-1b04-4e64-aecb-21db762824e0",
                                "sense_id": "248aaa9e-36e7-3ea7-9c90-d714bd0c01e3",
                                "text": "Необычайно глубокомысленный человек."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bbf1cec-e520-353b-8151-08937b2d96fd",
                        "entry_id": "37176fb1-755e-3791-8148-f3cbe0b3587e",
                        "glosses": [
                            "обладающий способностью проникать в сущность явлений; отличающийся глубиной мыслей, суждений и т.п.; серьёзный, сосредоточенный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed828a2f-93d8-4bfb-93df-90c3e97ff757",
                                "sense_id": "1bbf1cec-e520-353b-8151-08937b2d96fd",
                                "text": "Он шутит с самым глубокомысленным видом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a8ac848-15e8-4a3e-a9c2-eea2b9c53072",
                        "source_entry_id": "37176fb1-755e-3791-8148-f3cbe0b3587e",
                        "target_lang_word": "tiefsinnig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tiefsinnig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e069abc-f7ca-3fbc-bfff-40549c40b717",
                                        "entry_id": "0b5daaf6-a90a-3854-99c4-48446d89ece3",
                                        "glosses": [
                                            "den Dingen auf den Grund gehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dcd1a2e-9a51-4f64-b2b4-ad276cdec8d3",
                                                "sense_id": "9e069abc-f7ca-3fbc-bfff-40549c40b717",
                                                "text": "„George, mit dem ich in den letzten zwei Jahren schon viele tiefsinnige Gespräche über Leben und Tod, Gott und die Welt, Geld, Familie, Freundschaft und Gerechtigkeit geführt hatte, war ein eingefleischter Pessimist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3b7c2f0-4d45-454b-9aa9-5e86e035fc76",
                        "source_entry_id": "37176fb1-755e-3791-8148-f3cbe0b3587e",
                        "target_lang_word": "głęboki",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "głęboki",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "b57d7dab-8dc0-3447-ad56-bda6648e0737",
                                        "entry_id": "0c5223c6-62ab-3fd7-9621-818f7e6c3a12",
                                        "glosses": [
                                            "charakteryzujący się dużym wymiarem w głąb czegoś, daleko od brzegu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99f3cc33-f8c3-40cd-a9f2-e0660dd29a25",
                                                "sense_id": "b57d7dab-8dc0-3447-ad56-bda6648e0737",
                                                "text": "Tutaj rzeka jest bardzo głęboka i nie możemy przejść jej w bród."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "c76685fd-4b1c-3f14-8752-689df434d202",
                                        "entry_id": "0c5223c6-62ab-3fd7-9621-818f7e6c3a12",
                                        "glosses": [
                                            "taki, który nie ma banalnego, powierzchownego znaczenia; jest dociekliwy, zawierający istotę omawianego problemu"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31255690-c09b-43f8-a901-7e7b8a7aa1ef",
                                                "sense_id": "c76685fd-4b1c-3f14-8752-689df434d202",
                                                "text": "Twoja głęboka myśl pogrążyła mnie w głębokiej zadumie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "8287b1dc-d62f-326a-a66a-bd2a5f68f916",
                                        "entry_id": "0c5223c6-62ab-3fd7-9621-818f7e6c3a12",
                                        "glosses": [
                                            "mający duży stopień zaawansowania, nasilenia, nasycenia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d7edbc0-481e-4330-b257-b2e8f11ab22a",
                                                "sense_id": "8287b1dc-d62f-326a-a66a-bd2a5f68f916",
                                                "text": "Adam powoli wychodzi z głębokiej depresji."
                                            },
                                            {
                                                "example_id": "0840c0fa-0982-4f07-bf06-aaac9083266f",
                                                "sense_id": "8287b1dc-d62f-326a-a66a-bd2a5f68f916",
                                                "text": "Wtedy to Pan sprawił, że mężczyzna pogrążył się w głębokim śnie, i gdy spał wyjął jedno z jego żeber, a miejsce to zapełnił ciałem"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d32c064e-4813-4a9d-b9a3-fdc7ca0bd57c",
                        "source_entry_id": "37176fb1-755e-3791-8148-f3cbe0b3587e",
                        "target_lang_word": "gruntowny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gruntowny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "f52b39d0-fd34-3742-944c-62dabb21fa51",
                                        "entry_id": "cfa93374-aa0c-3422-b4fd-3cf82b98c5ef",
                                        "glosses": [
                                            "sięgający do gruntu, dogłębnie wnikający we wszystkie szczegóły"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ac7e38e-ac7e-4b7d-9605-f0a02923370b",
                                                "sense_id": "f52b39d0-fd34-3742-944c-62dabb21fa51",
                                                "text": "Paserskim okiem ocenił psie meble, z których jeden mahoniowy kredens byłby coś wart, ale dopiero po gruntownej renowacji, marny dywan, pachnący kiszoną kapustą po przedświątecznym czyszczeniu, i obitą ceratą kanapę"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
