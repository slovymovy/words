                        "examples": [
                            {
                                "example_id": "8297b96f-56c3-48ba-baf9-e44fa00cc2e2",
                                "sense_id": "4adc279e-29aa-39eb-81ff-ef999564edc6",
                                "text": "Ожидают наступления жестоких морозов, а вместе с ними бесснежье сулит далеко не радостные перспективы земледельцу, грозит вымерзание озимей, неурожай."
                            },
