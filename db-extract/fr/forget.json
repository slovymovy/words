                                "example_id": "22f48607-603a-447d-a39e-8d828dc055a0",
                                "sense_id": "7ab8288d-7521-3805-be94-f2159c62e665",
                                "text": "Après les sociétés du CAC40, la parole a été donnée au milieu sportif avec l'audition des ex-tennismen Yannick Noah et Guy Forget."
                            }
                        ]
                    }
