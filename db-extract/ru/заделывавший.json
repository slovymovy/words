                        "examples": [
                            {
                                "example_id": "f06dc940-fb00-4019-9f8a-ab7d317f78e7",
                                "sense_id": "c3193b56-4646-3843-a3cc-489a18273971",
                                "text": "Богатство твое и товары твои, все склады твои, корабельщики твои и кормчие твои, заделывавшие пробоины твои и распоряжавшиеся торговлею твоею, и все ратники твои, какие у тебя были, и все множество народа в тебе, в день падения твоего упадет в сердце морей."
                            }
                        ]
                    }
