                        "glosses": [
                            "A preparation made from the leaves and flowers of the cannabis plant, traditionally consumed in food or drink, especially during Hindu festivals such as Holi."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
