                "senses": [
                    {
                        "sense_id": "79302fdd-3d61-3fab-b63f-54ff2721faf9",
                        "entry_id": "b4f25653-82cc-3a4f-a591-d1a74c0f4229",
                        "glosses": [
                            "то же, что забросить, бросить куда-нибудь далеко, потерять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cd824f9-15fd-4fb4-be99-e21129262389",
                                "sense_id": "79302fdd-3d61-3fab-b63f-54ff2721faf9",
                                "text": "Дети закинули мяч за забор."
                            },
                            {
                                "example_id": "6a797d5a-6162-4889-adc6-48af9085d6f9",
                                "sense_id": "79302fdd-3d61-3fab-b63f-54ff2721faf9",
                                "text": "Закинуть книгу под стол."
                            },
                            {
                                "example_id": "70b8fa69-3ff9-480c-8717-de600873efec",
                                "sense_id": "79302fdd-3d61-3fab-b63f-54ff2721faf9",
                                "text": "Закинуть сети, невод."
                            },
                            {
                                "example_id": "5ff9393b-c529-4abe-aa98-bc110a3d4991",
                                "sense_id": "79302fdd-3d61-3fab-b63f-54ff2721faf9",
                                "text": "Закинул куда-то ключ, второй день ищу."
                            },
                            {
                                "example_id": "4294856f-21d4-4353-a387-04fad75682cd",
                                "sense_id": "79302fdd-3d61-3fab-b63f-54ff2721faf9",
                                "text": "Судьба закинула его на крайний север."
                            },
                            {
                                "example_id": "41fd6c55-2894-4f43-ac77-c893f1120dd0",
                                "sense_id": "79302fdd-3d61-3fab-b63f-54ff2721faf9",
                                "text": "Бурей закинуло корабль к неизвестным берегам."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6ce7283-5658-3729-a9d0-f2e6543e25b8",
