                "senses": [
                    {
                        "sense_id": "1c28ca26-2f2c-3a08-a057-a11bbd924b30",
                        "entry_id": "be5f3c2f-8666-3301-9c42-8219cd96da02",
                        "glosses": [
                            "het proces waarin waarneming en geheugen aan elkaar gekoppeld worden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11ff00ba-743a-449a-bca5-90d399a161b3",
                                "sense_id": "1c28ca26-2f2c-3a08-a057-a11bbd924b30",
                                "text": "Het duurde even maar toen de herkenning er eenmaal was groetten de oude vrienden elkaar heel hartelijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68f4b35b-cb65-4114-85e6-8feacd6e0fc3",
                        "source_entry_id": "be5f3c2f-8666-3301-9c42-8219cd96da02",
                        "source_sense_id": "1c28ca26-2f2c-3a08-a057-a11bbd924b30",
                        "target_lang_word": "Erkennung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erkennung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c683190c-84a2-3327-8a8b-2450ee77001b",
                                        "entry_id": "6ba78fa6-5833-39d2-83b4-2215baba742b",
                                        "glosses": [
                                            "das Erkennen einer Sache, eines Sachverhaltes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae78174a-47cf-4e8b-9bd9-7f3c5e68ff20",
                                                "sense_id": "c683190c-84a2-3327-8a8b-2450ee77001b",
                                                "text": "„Die frühzeitige Erkennung von Tumoren oder von Erkrankungen wie Alzheimer oder Parkinson hat für die Therapie eine sehr große Bedeutung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35f82bdd-7907-4e12-9cc2-339e2a537a33",
                        "source_entry_id": "be5f3c2f-8666-3301-9c42-8219cd96da02",
                        "source_sense_id": "1c28ca26-2f2c-3a08-a057-a11bbd924b30",
                        "target_lang_word": "recognition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recognition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a546865e-ea96-318c-ae90-fb9a65521afb",
                                        "entry_id": "0c7a3453-0647-3adb-a8ec-7864ca5a42ab",
                                        "glosses": [
                                            "The act of recognizing or the condition of being recognized (matching a current observation with a memory of a prior observation of the same entity)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "799d8e72-8873-4678-858c-3dd2077de378",
                                                "sense_id": "a546865e-ea96-318c-ae90-fb9a65521afb",
                                                "text": "He looked at her for ten full minutes before recognition dawned."
                                            },
                                            {
                                                "example_id": "781bcd52-d5aa-422b-95f1-510ee59c0e95",
                                                "sense_id": "a546865e-ea96-318c-ae90-fb9a65521afb",
                                                "text": "Warwick observed, as they passed through the respectable quarter, that few people who met the girl greeted her, and that some others whom she passed at gates or doorways gave her no sign of recognition; from which he inferred that she was possibly a visitor in the town and not well acquainted."
                                            },
                                            {
                                                "example_id": "ff6d133f-1f42-425b-9df1-1ff02e1271b3",
                                                "sense_id": "a546865e-ea96-318c-ae90-fb9a65521afb",
                                                "text": "December 20, 2021, ETSC, New rules on major EU roads should improve infrastructure safety\nOne omission is any language on getting roads ready for automated systems in transport. ETSC had called for provisions on ensuring that road markings, signs and infrastructure take into account the specific needs of e.g. traffic sign recognition and automated lane keeping systems."
                                            },
                                            {
                                                "example_id": "c80995c4-2f2e-4565-8391-04378ed9a1df",
                                                "sense_id": "a546865e-ea96-318c-ae90-fb9a65521afb",
                                                "text": "The freight market has changed beyond all recognition from when RAIL was first published. Coal, the then-dominant traffic, has all but disappeared. Instead, maritime intermodal flows have shown steady growth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b691e73c-ad43-306b-bdc6-4d66bcf185be",
                                        "entry_id": "0c7a3453-0647-3adb-a8ec-7864ca5a42ab",
                                        "glosses": [
                                            "Acceptance as valid or true."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85f1f8a0-feba-4ae6-8d72-1cb4b5cd7fa3",
                                                "sense_id": "b691e73c-ad43-306b-bdc6-4d66bcf185be",
                                                "text": "The law was a recognition of their civil rights."
                                            },
                                            {
                                                "example_id": "bac347e9-4c0f-48da-9a50-07d3144520be",
                                                "sense_id": "b691e73c-ad43-306b-bdc6-4d66bcf185be",
                                                "text": "With fresh material, taxonomic conclusions are leavened by recognition that the material examined reflects the site it occupied; a herbarium packet gives one only a small fraction of the data desirable for sound conclusions. Herbarium material does not, indeed, allow one to extrapolate safely: what you see is what you get[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd7ab0ad-53e3-3e08-b1f6-42aa3b2476c8",
                                        "entry_id": "0c7a3453-0647-3adb-a8ec-7864ca5a42ab",
                                        "glosses": [
                                            "Official acceptance of the status of a new government by that of another country."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e02a0196-51a0-3d77-abe3-b6aa4e61ddc9",
                                        "entry_id": "0c7a3453-0647-3adb-a8ec-7864ca5a42ab",
                                        "glosses": [
                                            "Honour, favourable note, or attention."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93ecadb1-b9e3-482a-9ccf-37c076193fc7",
                                                "sense_id": "e02a0196-51a0-3d77-abe3-b6aa4e61ddc9",
                                                "text": "The charity gained plenty of recognition for its efforts, but little money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "583da5c0-77b3-3ec1-a3c7-00969fe955c0",
                                        "entry_id": "0c7a3453-0647-3adb-a8ec-7864ca5a42ab",
                                        "glosses": [
                                            "The propriety consisting for antibodies to bind to some specific antigens and not to others."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61b42722-1cb8-337e-a50f-dbbf8267399a",
                                        "entry_id": "0c7a3453-0647-3adb-a8ec-7864ca5a42ab",
                                        "glosses": [
                                            "A return of the feu to the superior."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a278ec9-8ae2-4e5a-bf1b-2f11ca3bed6f",
                        "source_entry_id": "be5f3c2f-8666-3301-9c42-8219cd96da02",
                        "source_sense_id": "1c28ca26-2f2c-3a08-a057-a11bbd924b30",
                        "target_lang_word": "reconnaissance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reconnaissance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59655e7e-7937-3cc7-a803-c3e313b75116",
                                        "entry_id": "91f2048d-6d7c-3901-83b1-3128769f8cd2",
                                        "glosses": [
                                            "Action par laquelle on retrouve dans sa mémoire l’idée, l’image d’une chose ou d’une personne quand on vient à la revoir, de sorte à l'identifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7be184ba-9fee-4ed3-83f1-a896a0fbb823",
                                                "sense_id": "59655e7e-7937-3cc7-a803-c3e313b75116",
                                                "text": "Une lettre fut cause de leur mutuelle reconnaissance. - Il reconnut les meubles qu’on lui avait volés ; et, après que la reconnaissance qu’il en fit eut été vérifiée devant le juge, ils lui furent délivrés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83491d46-5d1a-3f5d-ab9b-a8fefacdc636",
                                        "entry_id": "91f2048d-6d7c-3901-83b1-3128769f8cd2",
                                        "glosses": [
                                            "Action d’examiner en détail et avec soin certains objets pour en constater l’espèce, le nombre, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "337aa170-ee8b-400a-9e75-445615a9e7c7",
                                                "sense_id": "83491d46-5d1a-3f5d-ab9b-a8fefacdc636",
                                                "text": "Dans les premières grammaires du français, se pose le problème de la reconnaissance de l’article comme catégorie, ou plutôt celui de la forme que doit prendre son traitement."
                                            },
                                            {
                                                "example_id": "63bdc9c9-8bb8-40a2-9ee1-4459cc976d5b",
                                                "sense_id": "83491d46-5d1a-3f5d-ab9b-a8fefacdc636",
                                                "text": "Faire la reconnaissance des lieux, des meubles, des papiers. - La reconnaissance sera longue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58233323-bbba-3651-abd8-4dc9ead6eee2",
                                        "entry_id": "91f2048d-6d7c-3901-83b1-3128769f8cd2",
                                        "glosses": [
                                            "Acte par lequel on reconnaît qu’on a reçu quelque chose, soit par emprunt, soit en dépôt, ou pour reconnaître qu’on est obligé à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3175327c-b399-4fdd-b049-1b0668e4cc80",
                                                "sense_id": "58233323-bbba-3651-abd8-4dc9ead6eee2",
                                                "text": "Vous me donnerez des reconnaissances en bonne forme de l’argent que je dépenserai pour vous ; et, quand vous serez riche, vous me rendrez le tout."
                                            },
                                            {
                                                "example_id": "a4f9d532-728a-45f8-8ecf-fa9a76abf7c4",
                                                "sense_id": "58233323-bbba-3651-abd8-4dc9ead6eee2",
                                                "text": "Pourtant, tous les actes unilatéraux ne sont pas réceptices alors même qu'ils produisent des effets sur des tiers. Ainsi, la reconnaissance d’enfant naturel, le testament et l'acceptation de succession sont de nature à produire des conséquences sur des tiers. Pourtant ils ne s'adressent à personne."
                                            },
                                            {
                                                "example_id": "b122259f-c593-4789-abe2-1ae9ed561738",
                                                "sense_id": "58233323-bbba-3651-abd8-4dc9ead6eee2",
                                                "text": "Il me donna ses pierreries en garde, je lui en donnai ma reconnaissance. Il m’a passé une reconnaissance de la rente, de la pension qu’il me doit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bac7172-0d20-31be-8c0f-37fbdc5a4f1f",
                                        "entry_id": "91f2048d-6d7c-3901-83b1-3128769f8cd2",
                                        "glosses": [
                                            "Aveu ou confession d’une faute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22570545-9698-4919-abcc-ed485277e679",
                                                "sense_id": "0bac7172-0d20-31be-8c0f-37fbdc5a4f1f",
                                                "text": "Cette prompte reconnaissance de sa faute lui en a mérité le pardon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac91faa5-383a-32da-9e21-0fa599575384",
                                        "entry_id": "91f2048d-6d7c-3901-83b1-3128769f8cd2",
                                        "glosses": [
                                            "Action de reconnaître, d’admettre comme légal un gouvernement étranger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4032beb0-2eb7-4cbf-af16-92a962c516ba",
                                                "sense_id": "ac91faa5-383a-32da-9e21-0fa599575384",
                                                "text": "La reconnaissance de ce gouvernement par l’Angleterre ne se fit point attendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd1f6574-09e5-3fb7-b57f-2f9bd046bd6d",
                                        "entry_id": "91f2048d-6d7c-3901-83b1-3128769f8cd2",
                                        "glosses": [
                                            "Gratitude ; souvenir des bienfaits reçus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61dab3c9-dcf2-4290-8579-945f1931c404",
                                                "sense_id": "dd1f6574-09e5-3fb7-b57f-2f9bd046bd6d",
                                                "text": "Eh ! Mon cher grand génie, vous êtes un homme supérieur, vous savez bien que la reconnaissance est un mot d’imbécile, on le met dans le dictionnaire, mais il n’est pas dans le cœur humain."
                                            },
                                            {
                                                "example_id": "f11b9081-5548-4191-ad6a-44f38c2c305e",
                                                "sense_id": "dd1f6574-09e5-3fb7-b57f-2f9bd046bd6d",
                                                "text": "On peut donc continuer à boire de l'eau de Seltz sans crainte, en se souvenant avec reconnaissance des services qu'elle a rendus, lors de la première apparition du choléra en 1852."
                                            },
                                            {
                                                "example_id": "68002675-e304-4616-a111-e967b89095fe",
                                                "sense_id": "dd1f6574-09e5-3fb7-b57f-2f9bd046bd6d",
                                                "text": "Et ce pauvre hère, ragaillardi lui aussi par le thé et la bonne chère, traduit alors la reconnaissance de son estomac repu par un concert qui porte la satisfaction générale à son comble."
                                            },
                                            {
                                                "example_id": "3a4a6d1b-dc76-4c8b-97c2-c747e9ad274e",
                                                "sense_id": "dd1f6574-09e5-3fb7-b57f-2f9bd046bd6d",
                                                "text": "Sa santé laissant de plus en plus à désirer il avait refusé le renouvellement de son mandat de T∴ P∴ S∴ G∴ C∴, mais le Sup∴ Cons∴, désireux de lui témoigner sa reconnaissance et de conserver sa précieuse collaboration, lui décerna à l’unanimité le titre de T∴ P∴ S∴ G∴ C∴ d'Honneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cda4699-467d-33e9-a393-0be02fb3f56b",
                                        "entry_id": "91f2048d-6d7c-3901-83b1-3128769f8cd2",
                                        "glosses": [
                                            "Considération."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bba3ed26-43a1-4d1a-83e6-e61ea9b2bde8",
                                                "sense_id": "5cda4699-467d-33e9-a393-0be02fb3f56b",
                                                "text": "Chez Aviapartner, les syndicats demandent « une juste reconnaissance de leur travail » soit « au moins 200 euros brut »."
                                            },
                                            {
                                                "example_id": "544613c1-1fd7-463f-99d9-0d1060b3c8ad",
                                                "sense_id": "5cda4699-467d-33e9-a393-0be02fb3f56b",
                                                "text": "Un troisième ami de la maison, le principal du collège d’Arbois, M. Romanet, exerça une influence décisive sur la carrière de Louis Pasteur. Ce maître, qui se proposait chaque jour d’élever davantage l’esprit et le cœur de ses collégiens, inspirait à Pasteur quelque chose de plus que le respect et la reconnaissance; c’était de l’admiration."
                                            },
                                            {
                                                "example_id": "0b442dbc-695e-465c-9901-96018e71341c",
                                                "sense_id": "5cda4699-467d-33e9-a393-0be02fb3f56b",
                                                "text": "Raschi, en se cantonnant dans son rôle de commentateur, s'est attiré, lui, la reconnaissance de tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1225fbf-788e-3dc3-b2b3-9aaddab61240",
                                        "entry_id": "91f2048d-6d7c-3901-83b1-3128769f8cd2",
                                        "glosses": [
                                            "Action d’examiner la position, la nature d’un terrain et les dispositions de l’ennemi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "800e14a2-464c-4fc6-8bec-84d29c8e4ef1",
                                                "sense_id": "c1225fbf-788e-3dc3-b2b3-9aaddab61240",
                                                "text": "[…], et, pour se procurer des renseignements précis en faisant quelques prisonniers, il résolut de lancer une vigoureuse reconnaissance de l'autre coté de Buzancy. Mais cette reconnaissance ne tarda pas à prendre les proportions d'un véritable combat, […]."
                                            },
                                            {
                                                "example_id": "cb47fbbb-8852-4a5a-b1d3-33e68d5f12a7",
                                                "sense_id": "c1225fbf-788e-3dc3-b2b3-9aaddab61240",
                                                "text": "Le 22 Août, la marche vers le Nord devait être continuée. Mais un épais brouillard couvrait le sol empêchant les reconnaissances."
                                            },
                                            {
                                                "example_id": "024e762e-f48e-4073-b915-6466b70f1c28",
                                                "sense_id": "c1225fbf-788e-3dc3-b2b3-9aaddab61240",
                                                "text": "En résumé, la reconnaissance a pour but de communiquer de l’information au commandant pour qu’il prenne des décisions éclairées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0675b251-2241-3c3d-80b4-628206348b77",
                                        "entry_id": "91f2048d-6d7c-3901-83b1-3128769f8cd2",
                                        "glosses": [
                                            "Action d’apercevoir, de découvrir, d’explorer des côtes, des rades, etc., en naviguant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2aee930-101f-4eed-9a31-62871ac57970",
                                                "sense_id": "0675b251-2241-3c3d-80b4-628206348b77",
                                                "text": "Il fit la reconnaissance d’une baie qui avait échappé à tous les autres navigateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0612374-2b73-3bdf-9923-2843a058f5c4",
                                        "entry_id": "91f2048d-6d7c-3901-83b1-3128769f8cd2",
                                        "glosses": [
                                            "Droit payable en nature."
                                        ],
                                        "tags": [
                                            "Droit féodal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a4db53e-dca0-433c-a644-8422d7061d5a",
                                                "sense_id": "b0612374-2b73-3bdf-9923-2843a058f5c4",
