            {
                "entry_id": "5fd7cd36-4818-3862-963f-9ec248df2207",
                "word": "pelletée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a74a2dbc-8ea4-4f99-92ff-79e634484a2b",
                        "entry_id": "5fd7cd36-4818-3862-963f-9ec248df2207",
                        "tags": [
                            "plural"
                        ],
                        "form": "pelletées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3421d863-9a6a-3bb4-9988-e51e9826621e",
                        "entry_id": "5fd7cd36-4818-3862-963f-9ec248df2207",
                        "glosses": [
                            "Ce qu’on prend d’un coup de pelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abbd0a1e-b87a-48fb-96c3-0a7c9669efbb",
                                "sense_id": "3421d863-9a6a-3bb4-9988-e51e9826621e",
                                "text": "Comme il ouvrait la portière, une énorme pelletée de boue tomba sur sa figure, et de là sur sa cravate. Comme il parlait à M. Coffe dans ce moment, la boue entra même dans sa bouche."
                            },
                            {
                                "example_id": "7abf2183-1b94-4f32-86d3-2ee6f3141948",
                                "sense_id": "3421d863-9a6a-3bb4-9988-e51e9826621e",
                                "text": "Ma mère et moi nous étions au salon, et je regardais par la fenêtre les ouvriers de la voirie qui jetaient des pelletées de sable sur le verglas, lorsque ma tante parut."
                            },
                            {
                                "example_id": "7712f537-745d-4858-9d1c-8053d3f61c2e",
                                "sense_id": "3421d863-9a6a-3bb4-9988-e51e9826621e",
                                "text": "Deux ouvriers recouvrent les poissons d’une pelletée de sel avant de les précipiter dans une fosse de conservation."
                            },
                            {
                                "example_id": "d4545f61-feb1-482e-98bf-efdc1083115c",
                                "sense_id": "3421d863-9a6a-3bb4-9988-e51e9826621e",
                                "text": "— Le président du Conseil jeta, très sagement à mon sens, une pelletée de terre sur cet embryon de conspiration. Après tout, les conjurés n’étaient pas passés aux actes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43f7f87e-8fce-4d11-b46b-04847fffee9a",
                        "source_entry_id": "5fd7cd36-4818-3862-963f-9ec248df2207",
                        "source_sense_id": "3421d863-9a6a-3bb4-9988-e51e9826621e",
                        "target_lang_word": "shovelful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shovelful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d636d4bc-c885-37a0-86ec-5da9434e0fd5",
                                        "entry_id": "63b69274-05fe-3b3c-b669-a0728f34b78e",
                                        "glosses": [
                                            "The amount that can be moved at once with a shovel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1894977d-492e-4ee8-b206-69cac25e0bd7",
                                                "sense_id": "d636d4bc-c885-37a0-86ec-5da9434e0fd5",
                                                "text": "One shovelful of dirt makes a molehill; a million shovelfuls make a mountain."
                                            },
                                            {
                                                "example_id": "f1dd8ed7-9a17-4d9b-88fd-476b5a56de98",
                                                "sense_id": "d636d4bc-c885-37a0-86ec-5da9434e0fd5",
                                                "text": "Two workers each had a shovelful of snow. There were two shovelsful of snow."
                                            },
                                            {
                                                "example_id": "b4c22bdf-fbfd-4b37-bec7-ca0f98106029",
                                                "sense_id": "d636d4bc-c885-37a0-86ec-5da9434e0fd5",
                                                "text": "As to the fireman, the sight of him at work, swinging round with his shovelful of coal and at the same moment lightly depressing his right heel and so working the pedal which causes the steam-operated firedoors to open like magic in front of the shovel, was always a pleasure."
                                            },
                                            {
                                                "example_id": "05a93cca-89a1-4527-b9a1-1e3aefd1edbd",
                                                "sense_id": "d636d4bc-c885-37a0-86ec-5da9434e0fd5",
                                                "text": "The doors are at the right level for firing, which normally is down one side of the firebox at a time, unlike our own practice, which is to fire each side of the firebox with alternate shovelfuls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1b22412-a4a6-4906-8851-5aebb69e8512",
                        "source_entry_id": "5fd7cd36-4818-3862-963f-9ec248df2207",
