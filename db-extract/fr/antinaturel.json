                "senses": [
                    {
                        "sense_id": "9d9a6935-f394-3e31-95d8-a7d724ddd1ba",
                        "entry_id": "01a25f92-2477-31ac-9a68-ada976d17795",
                        "glosses": [
                            "Opposé à la nature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad8c2613-5adc-40c2-b428-4bf8a85c25f9",
                                "sense_id": "9d9a6935-f394-3e31-95d8-a7d724ddd1ba",
                                "text": "— En tout cas, on ne peut nier le caractère inhumain, monstrueux, antinaturel de ses sentiments à notre égard…"
                            },
                            {
                                "example_id": "7fce9a77-28be-44b5-aecf-7f33e58b7534",
                                "sense_id": "9d9a6935-f394-3e31-95d8-a7d724ddd1ba",
                                "text": "En effet, l'opposition masculin/féminin perd en dehors de la désignation direct du sexe, tout rapport avec une différenciation naturelle : sexuisemblance, même dans la classe des substantifs animés on parle de genre antinaturel et de genre indifférencié dans le cas où les limites des genres grammaticaux ne coïncident plus avec les limites des genres naturels."
                            }
                        ]
                    }
                ],
