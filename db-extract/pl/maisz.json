                        "cross_references": [
                            {
                                "target_word": "tercel gentle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c888825d-ee48-3e1d-a4a1-8d084a444d09",
                                        "entry_id": "34baf237-77d9-362d-824e-d54666b34ad8",
                                        "glosses": [
                                            "A male falcon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb9ca6ef-976a-4a39-a7b4-40fe5565478a",
                                                "sense_id": "c888825d-ee48-3e1d-a4a1-8d084a444d09",
                                                "text": "Like as a fearefull Dove, which through the raine / Of the wide ayre her way does cut amaine, / Having farre off espyde a Tassell gent, / Which after her his nimble winges doth straine, / Doubleth her hast for feare to bee for-hent [...]."
                                            },
                                            {
                                                "example_id": "a7a6b3d0-cf60-4221-973d-b60c3fee8056",
                                                "sense_id": "c888825d-ee48-3e1d-a4a1-8d084a444d09",
                                                "text": "O for a Falkners voice, / To lure this Tassell gentle backe againe [...]."
                                            },
                                            {
                                                "example_id": "dc1c2eab-c9e4-4408-98af-aa00e9aa61fc",
                                                "sense_id": "c888825d-ee48-3e1d-a4a1-8d084a444d09",
                                                "text": "Marry, out upon thee, foul kite, that would fain be a tercel gentle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58f6d21b-0bb5-4c78-9727-786c29055a9d",
                        "source_entry_id": "36880c83-632a-343c-983d-ad69f04eb1c8",
                        "source_sense_id": "a7126950-7a23-35bf-a6e9-9caecb9656c6",
