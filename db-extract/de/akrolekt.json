                ],
                "senses": [
                    {
                        "sense_id": "e1baf971-cad7-3ce1-a2f9-ff8904bf3f79",
                        "entry_id": "7cb43da2-a8aa-3bb5-91c8-f83b6b268339",
                        "glosses": [
                            "Sprachvarietät, die einer voll ausgebauten Sprache am nächsten kommt und das höchste Prestige hat"
                        ],
                        "tags": [
                            "Soziolinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "8c381fb9-9f68-4b6c-9903-417a4c86aa79",
                                "sense_id": "e1baf971-cad7-3ce1-a2f9-ff8904bf3f79",
                                "text": "„Dies ist zuerst im Rahmen der Kreolistik gesagt worden, wo zahlreiche Übergangsformen und keine eigentlichen Einschnitte zwischen den verschiedenen Sprachniveaus (Basilekt - Mesolekt(e) - Akrolekt) feststellbar sind.“"
                            },
                            {
                                "example_id": "f0fc42ec-25c4-4c04-92cf-af73d34a66b4",
                                "sense_id": "e1baf971-cad7-3ce1-a2f9-ff8904bf3f79",
                                "text": "„Das Kreol wird als ‚Basilekt‘, die Prestigevarietät als Akrolekt bezeichnet, die Zwischenstufen sind in der Bezeichnung ‚Mesolekt‘ zusammengefasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d784df55-d034-4ca0-bb0c-852a23d97211",
                        "source_entry_id": "7cb43da2-a8aa-3bb5-91c8-f83b6b268339",
                        "source_sense_id": "e1baf971-cad7-3ce1-a2f9-ff8904bf3f79",
                        "source_sense_description": "Sprachvarietät, die einer voll ausgebauten Sprache am nächsten kommt",
                        "target_lang_word": "acrolect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acrolect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32d7c255-891b-368a-8c7a-845c814cfa76",
                                        "entry_id": "19e11846-81d4-3d72-b63f-31b4e9938deb",
                                        "glosses": [
                                            "The variety of speech that is considered most suitable for formal occasions (typically using only standard forms)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25738e09-71c7-4024-a9d2-d777e87ca066",
                                                "sense_id": "32d7c255-891b-368a-8c7a-845c814cfa76",
                                                "text": "In one dimension change is directed toward the acrolect, the “typical” change in the creole continuum."
                                            },
                                            {
                                                "example_id": "79fdeda9-1b6e-4ded-bbbe-2e6cb9a55c8e",
                                                "sense_id": "32d7c255-891b-368a-8c7a-845c814cfa76",
                                                "text": "At the other end of the continuum is the most standard speech, the acrolect. In between is a gradient of forms with many successive levels, the mesolects."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a3116b4-a872-4dbd-bef9-b8d1156e20b2",
                        "source_entry_id": "7cb43da2-a8aa-3bb5-91c8-f83b6b268339",
                        "source_sense_id": "e1baf971-cad7-3ce1-a2f9-ff8904bf3f79",
                        "source_sense_description": "Sprachvarietät, die einer voll ausgebauten Sprache am nächsten kommt",
                        "target_lang_word": "acrolecte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acrolecte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44dc9002-d4df-3214-9a0d-4e9d72e08a8c",
                                        "entry_id": "5885c387-ea29-3720-9fab-d61c77d5fc05",
                                        "glosses": [
                                            "Variété la plus prestigieuse d’une langue donnée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9081efe-1b8a-4caf-be31-d45176f722e2",
                                                "sense_id": "44dc9002-d4df-3214-9a0d-4e9d72e08a8c",
                                                "text": "Évidemment, l’accès à l’écriture solennelle de ces deux oralités les promeut au rang d’acrolecte de plein droit."
                                            },
                                            {
                                                "example_id": "6b819e3d-6d27-4b03-94ec-8db8bd83d24e",
                                                "sense_id": "44dc9002-d4df-3214-9a0d-4e9d72e08a8c",
                                                "text": "Il est possible, selon l’analyse de l’auteur, de retrouver l’interlecte dans l’acrolecte ou dans le basilecte."
                                            },
                                            {
                                                "example_id": "22100b92-db0b-4116-af48-6311124c35b0",
                                                "sense_id": "44dc9002-d4df-3214-9a0d-4e9d72e08a8c",
                                                "text": "Les exogènistes québécois considèrent généralement le français standardisé de l’Hexagone comme l’acrolecte de la langue française."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
