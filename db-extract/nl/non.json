                "senses": [
                    {
                        "sense_id": "f6e6cb5a-e1c4-303e-93c7-f46140ba8682",
                        "entry_id": "2cd91233-9d5c-3fbc-8114-4648c10f665c",
                        "glosses": [
                            "inwoonster van een vrouwenklooster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "423ebb2e-4a73-43b7-b549-88df449ac763",
                                "sense_id": "f6e6cb5a-e1c4-303e-93c7-f46140ba8682",
                                "text": "Wanneer ik de deur open en de ontvangstruimte binnenstap, roept iemand mijn ' Madame Bonnet?' Een lange en statige non nadert me, steekt haar hand naar me uit en stelt zich voor als zuster Geneviève."
                            },
                            {
                                "example_id": "50d3e86d-0513-4f86-b8b1-e7c3413dc8c3",
                                "sense_id": "f6e6cb5a-e1c4-303e-93c7-f46140ba8682",
                                "text": "De oude non schudt haar hoofd."
                            },
                            {
                                "example_id": "9873cce9-dcf5-42df-97e0-ce3a08bc451d",
                                "sense_id": "f6e6cb5a-e1c4-303e-93c7-f46140ba8682",
                                "text": "Nonnen kan men makkelijk herkennen aan hun typische zwart-witte kledij."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a093bb2-79fb-3792-8a99-7f5ae6e3dc1d",
                        "entry_id": "2cd91233-9d5c-3fbc-8114-4648c10f665c",
                        "glosses": [
                            "soort vogel en soort vlinder die qua uiterlijk lijken op bovenstaand vrouwspersoon"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4698be4f-3a1d-44d9-8662-d9914c03ed27",
                        "source_entry_id": "2cd91233-9d5c-3fbc-8114-4648c10f665c",
                        "source_sense_description": "inwoonster van een vrouwenklooster",
                        "target_lang_word": "Nonne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nonne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aedd65d6-30c5-3a9d-9a3d-c38c9a141d07",
                                        "entry_id": "88079f33-2eb6-37c5-be89-9eb8e00bd609",
                                        "glosses": [
                                            "Mitglied eines Frauenordens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d21b500-ad42-49b7-aa05-7968ea68cf47",
                                                "sense_id": "aedd65d6-30c5-3a9d-9a3d-c38c9a141d07",
                                                "text": "Von den hiesigen Nonnen sind jetzt wirklich vier schwanger, und gegen sechs sind auf ewig eingemauert 6, weil sie die Kunst nicht verstanden haben, nicht schwanger zu werden."
                                            },
                                            {
                                                "example_id": "0b6c8f74-1585-4d82-9e2c-e464accfdec9",
                                                "sense_id": "aedd65d6-30c5-3a9d-9a3d-c38c9a141d07",
                                                "text": "„Eine Nonne in einem Habit aus braunem Leinen mit weiten Ärmeln und mit einem schwarzen Schleier vor dem Gesicht führte die beiden Besucherinnen an der Küche, dem Speisesaal und dem Versammlungsraum vorbei zum Westflügel des Klostergebäudes, dem so genannten »Pensionat«.“"
                                            },
                                            {
                                                "example_id": "0d0bf985-605e-455f-95e5-9063eacf8173",
                                                "sense_id": "aedd65d6-30c5-3a9d-9a3d-c38c9a141d07",
                                                "text": "„Manchmal, so berichtet ein unbekannter Chronist um das Jahr 900, bieten die Sklavenhändler auch Nonnen feil.“"
                                            },
                                            {
                                                "example_id": "c56b370d-a458-43c3-a5cf-cffe69820150",
                                                "sense_id": "aedd65d6-30c5-3a9d-9a3d-c38c9a141d07",
                                                "text": "„Miss Carey war fest eingeschlafen und lächelte im Schlaf wie die fromme Nonne, die sie zweifellos geworden, wenn da nicht diese schizophysiologische Mißbildung in ihrem Nukleus caudatus gewesen wäre.“"
                                            },
                                            {
                                                "example_id": "7a6d3590-1dc5-45e8-933a-484ca0f1d1cb",
                                                "sense_id": "aedd65d6-30c5-3a9d-9a3d-c38c9a141d07",
                                                "text": "„Jedenfalls saßen die beiden Nonnen neben mir, und wir kamen irgendwie ins Gespräch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9911a5c7-8bc5-37ec-97e6-2a736150bd0e",
                                        "entry_id": "88079f33-2eb6-37c5-be89-9eb8e00bd609",
                                        "glosses": [
                                            "Nachtfalter (Lymantria monacha)"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e177acb6-8c79-4dff-aee0-cbc8e7877784",
                                                "sense_id": "9911a5c7-8bc5-37ec-97e6-2a736150bd0e",
                                                "text": "Die Nonnen haben hübsche Raupen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b36e81bb-f6d5-3cbe-af2c-fb9525101157",
                                        "entry_id": "88079f33-2eb6-37c5-be89-9eb8e00bd609",
                                        "glosses": [
                                            "Prachtfinken (aus der Gattung Lonchura)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4f785c5f-8ff0-35b5-baf6-f1dd5ce08265",
                                        "entry_id": "88079f33-2eb6-37c5-be89-9eb8e00bd609",
                                        "glosses": [
                                            "rinnenförmig nach unten gewölbter Dachziegel [„Mönch und Nonne“]"
                                        ],
                                        "tags": [],
