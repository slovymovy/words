                                                "sense_id": "471abb09-7d5e-36c9-b4d2-62d29f2bd6cc",
                                                "text": "Die Parolen der Neonazis drohen die Jugend zu radikalisieren."
                                            },
                                            {
                                                "example_id": "a31d05b9-3510-4ac2-b3d2-7ce07b0142f9",
                                                "sense_id": "471abb09-7d5e-36c9-b4d2-62d29f2bd6cc",
                                                "text": "Die Menschen radikalisieren sich vor allem wegen den fehlenden Zukunftsperspektiven."
                                            },
                                            {
                                                "example_id": "8bae5cd2-46ec-4ab5-abdd-76204736a69e",
                                                "sense_id": "471abb09-7d5e-36c9-b4d2-62d29f2bd6cc",
                                                "text": "„Gegenüber den Anfangsjahren hat sich die AfD deutlich radikalisiert und ist weit im rechten Spektrum gelandet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
