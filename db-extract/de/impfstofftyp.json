                "senses": [
                    {
                        "sense_id": "46daa3d6-cb5c-3594-9ab0-f173e84b66ed",
                        "entry_id": "70e9a0b9-0928-340e-8125-3d7ee0208846",
                        "glosses": [
                            "Klasse der Seren (Impfstoffe), die zum Vakzinieren (Impfen) verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac27683-b34e-4fb8-89c4-b46b033858d9",
                                "sense_id": "46daa3d6-cb5c-3594-9ab0-f173e84b66ed",
                                "text": "„Zu guter Letzt trat nur ein einziger Typ des Pockenvirus in Erscheinung (zumindest so weit das Abwehrsystem davon betroffen war), daß also ein einziger Impfstofftyp ausreichte, der sich zudem als sehr stabil und wirksam erwies.“"
                            },
                            {
                                "example_id": "22703651-cab2-4241-b89e-099f4291c837",
                                "sense_id": "46daa3d6-cb5c-3594-9ab0-f173e84b66ed",
                                "text": "„Dieser Impfstofftyp wird dann eingesetzt, wenn die Erkrankung nicht durch den Erreger selbst, sondern durch dessen Gift ausgelöst wird (z. B. Wundstarrkrampf).“"
                            },
                            {
                                "example_id": "98aadc3c-ba79-4572-983e-b3df9c4851db",
                                "sense_id": "46daa3d6-cb5c-3594-9ab0-f173e84b66ed",
                                "text": "„Dieser Impfstofftyp gibt eine gute Immunität, verursacht aber in einigen Fällen Nebenwirkungen. Dafür sind in erster Linie die Lipide der Virushülle verantwortlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
