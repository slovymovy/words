                        ],
                        "examples": [
                            {
                                "example_id": "61ba149c-1b6e-4594-b2b7-559def97dcda",
                                "sense_id": "ad534ac9-54d5-34a7-80d0-0431046264da",
                                "text": "The Egyptians were indeed indefatigable architects, sculptors, painters, hieroglyphists, and inscriptionists[…]"
                            },
                            {
                                "example_id": "fc9092db-0b5b-47fd-9c9d-5ae0000a179a",
                                "sense_id": "ad534ac9-54d5-34a7-80d0-0431046264da",
                                "text": "Rothko more than any artist I have known succumbed to the lure of light, light that, as the Byzantine inscriptionist said, can be contained but never captured really[…]"
                            },
                            {
                                "example_id": "18bafa84-09bf-42ed-b1b6-43890bff44b9",
                                "sense_id": "ad534ac9-54d5-34a7-80d0-0431046264da",
                                "text": "But it also reminds us from the beginning that words are the physical materials of this poet's work, as they are the materials for the inscriptionist."
                            },
                            {
                                "example_id": "da1bd877-1da7-423d-8855-9c0137c3f053",
                                "sense_id": "ad534ac9-54d5-34a7-80d0-0431046264da",
                                "text": "For quotations using this term, see Citations:inscriptionist."
                            }
                        ]
                    }
