                        "examples": [
                            {
                                "example_id": "f19603c6-ebad-43bf-b9b4-de5b7b49c51e",
                                "sense_id": "908be67c-22ae-3461-8601-8a44b579a25d",
                                "text": "C’est pourquoi le CHU de Dijon conseillait en 2022 à ceux qui pensent être victimes d’une piqûre de « ne surtout pas uriner avant prise en charge » et de « rejoindre un service d’urgences le plus rapidement possible »."
                            }
                        ]
                    }
                ],
