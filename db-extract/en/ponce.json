                "translations": [
                    {
                        "translation_id": "922d97c5-5766-46ee-b643-f05b2ac7b28b",
                        "source_entry_id": "d863c7c0-b1b6-3bfb-ba54-63ec5620277e",
                        "source_sense_description": "man living off a woman's earnings",
                        "target_lang_word": "Zuhälter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuhälter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be33ab03-4e6a-36c6-8bd2-cd8dd3afef66",
                                        "entry_id": "605bed47-26fd-32d2-89e5-66823cdedff4",
                                        "glosses": [
                                            "eine Person, die von der Prostitution einer oder mehrerer Frauen (oder Männer) lebt und die Betroffenen dabei ausbeutet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "371e1110-2788-4c22-9e3d-f261baa7dc30",
                                                "sense_id": "be33ab03-4e6a-36c6-8bd2-cd8dd3afef66",
                                                "text": "Ihr Zuhälter hat sie verprügelt."
                                            },
                                            {
                                                "example_id": "de67e368-c41e-4c58-b059-78837f5e838a",
                                                "sense_id": "be33ab03-4e6a-36c6-8bd2-cd8dd3afef66",
                                                "text": "„Sie machte das als Hobby, hatte keinen Zuhälter und kannte keine anderen Nutten.“"
                                            },
                                            {
                                                "example_id": "a70e4065-d759-41bc-bc2f-f763f983712b",
                                                "sense_id": "be33ab03-4e6a-36c6-8bd2-cd8dd3afef66",
                                                "text": "„Ein Zuhälter war auf sie aufmerksam geworden und hatte sie mit Geschenken überhäuft, bis sie nachgab und die Vormittage in einem Stundenhotel verbrachte.“"
                                            },
                                            {
                                                "example_id": "8416721f-be67-4a37-8fd0-4c3674693d04",
                                                "sense_id": "be33ab03-4e6a-36c6-8bd2-cd8dd3afef66",
                                                "text": "„Wenn ihn zuzeiten sein Wettglück verließ, scheint sich Durrieux auch als Carolines Zuhälter betätigt zu haben.“"
                                            },
                                            {
                                                "example_id": "34a99a2c-7f5a-4f17-ac3f-c17d6624a88d",
                                                "sense_id": "be33ab03-4e6a-36c6-8bd2-cd8dd3afef66",
                                                "text": "„Max sah auch Zuhälter herumlaufen und Huren, die auffallender gekleidet waren und leuchtendere Farben trugen als die anderen Frauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28d87e95-bce5-44d6-a671-d97a6d4d50bc",
                        "source_entry_id": "d863c7c0-b1b6-3bfb-ba54-63ec5620277e",
                        "source_sense_description": "man living off a woman's earnings",
                        "target_lang_word": "Gigolo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gigolo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dcc33494-88e6-33ed-820c-f967aeecd456",
                                        "entry_id": "bee589fc-46b1-35b9-ab12-bdd675675be8",
                                        "glosses": [
                                            "Angestellter eines Tanzlokals, einer Tanzschule, der sich als Tanzpartner den weiblichen Gästen anbietet"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a7892c7-9823-46e1-841c-d4850e4eadd2",
                                                "sense_id": "dcc33494-88e6-33ed-820c-f967aeecd456",
                                                "text": "„Vielleicht sind die mißtrauischen Blicke, mit denen oft die Ehegatten den modisch besmokingten Gigolo an ihren Tisch herantänzeln sehen, nicht ganz so unberechtigt, denn die verpflichteten Tänzer, deren Qualitäten meistens in ein paar exklusiven Schritten, einem tadellosen »evening dress« im Verein mit guten Manieren bestehen, sind von allzuvielen Frauen geradezu darauf dressiert worden, ihre Aufgaben auf weitere Gebiete zu übertragen.“"
                                            },
                                            {
                                                "example_id": "aba0a0d5-7f2b-4607-902b-19846e90f012",
                                                "sense_id": "dcc33494-88e6-33ed-820c-f967aeecd456",
                                                "text": "„Neulich hörte ich in einem Dancing in Nizza einen armen kleinen Gigolo sagen: Une femme! Une femme! Ça fait pipi avec rien. Ich wollte es nicht gehört haben.“"
                                            },
                                            {
                                                "example_id": "ca4a98bd-3380-431e-89b8-8667723d5eb6",
                                                "sense_id": "dcc33494-88e6-33ed-820c-f967aeecd456",
                                                "text": "„Ob sich nun der Naturalismusfürst tatsächlich je auf der Tanzfläche seines bevorzugten Beherbergungsbetriebes aufhielt, ist unbekannt. Vielleicht Gattin Grete, erfreute sich doch der 5-o’-clock-Tea bei den schnieken Ladies größter Beliebtheit, nicht zuletzt wegen der Gigolos. Diese professionellen Eintänzer wuchten jeglich weiblich’ Wesen, ohne Ansehen von Alter oder Gewicht übers Parkett, mit Todesverachtung & steifem Kragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "43f20434-ec5f-3883-9c1e-2ae754265ba2",
                                        "entry_id": "bee589fc-46b1-35b9-ab12-bdd675675be8",
                                        "glosses": [
                                            "(jüngerer, eleganter, in der Halbwelt verkehrender) Mann, der eine intime, zumeist sexuell geprägte, längerfristige Beziehung mit einer zumeist älteren (gut betuchten) Dame hat und sich von dieser aushalten lässt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24cd5875-10ad-4db2-92ea-bf2b159803e1",
                                                "sense_id": "43f20434-ec5f-3883-9c1e-2ae754265ba2",
                                                "text": "„Der zweite ist Casanova persönlich, ein rüder ‚alter Habicht‘, der nicht mehr so kann, wie er möchte, weshalb Camille, seine auch schon etwas zerfallene ‚letzte Geliebte‘, sich einen 20jährigen Gigolo angelt, der aber nur gegen Bezahlung arbeitet.“"
                                            },
                                            {
                                                "example_id": "cf5640c2-56e3-4c92-b014-c9a2b59f2f57",
                                                "sense_id": "43f20434-ec5f-3883-9c1e-2ae754265ba2",
                                                "text": "„Nach Überzeugung des Richters drang der Angeklagte, der nach eigenen Angaben als Gigolo von Zuwendungen älterer Frauen lebt, über ein Kellerfenster in die Villa der Wormser Seniorin ein.“"
                                            },
                                            {
                                                "example_id": "7f32a308-927f-425e-9240-3bd7fd471ba5",
                                                "sense_id": "43f20434-ec5f-3883-9c1e-2ae754265ba2",
                                                "text": "„In Europa, wo ihn Thomas Mann mit seinem Felix Krull am besten beschrieben hat, gilt er als hübscher, junger Gigolo, der an der italienischen und französischen Riviera alten, reichen Damen das Geld aus der Tasche zieht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1d264b20-29b9-3bb1-9616-db3c6b8bcf59",
                                        "entry_id": "bee589fc-46b1-35b9-ab12-bdd675675be8",
                                        "glosses": [
                                            "(jüngerer oder älterer) charmanter, gutaussehender, lebemännischer Mann, der bei Frauen besonders gut ankommt und daher viele Liebschaften hat"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b1a40dc-2dae-42d5-9057-ebb319c262c2",
                                                "sense_id": "1d264b20-29b9-3bb1-9616-db3c6b8bcf59",
                                                "text": "„Was aber, wenn diese Frau die steuertechnischen Geheimnisse ihres Ex-Mannes preisgibt und ihn als polospielenden Gigolo und Steuerbetrüger hinstellt?“"
                                            },
                                            {
                                                "example_id": "df07fffe-1e3b-4238-834a-4b850494c35c",
                                                "sense_id": "1d264b20-29b9-3bb1-9616-db3c6b8bcf59",
                                                "text": "„Der Gigolo ging faul hinter ihr her, nachdem er das Taxi bezahlt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "feafaca9-1315-4037-8095-d453a80bb9a4",
                        "source_entry_id": "d863c7c0-b1b6-3bfb-ba54-63ec5620277e",
                        "source_sense_description": "man living off a woman's earnings",
                        "target_lang_word": "Schnorrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnorrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                        "entry_id": "ebe4404a-166a-3814-a1a1-a366f2aa913a",
                                        "glosses": [
                                            "(männliche) Person, die wiederholt um Gefälligkeiten (zum Beispiel Zigaretten oder Snacks) bittet, ohne die Absicht zu haben, eine Gegenleistung zu erbringen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aca51b18-7651-4d51-ad64-c93ec5a29cfd",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "„Er war empört gewesen, daß der Bankier Roest ihn als Schnorrer und Nebbich empfangen hatte, aber er sah bald, daß er in dieser Stadt, die in einem Millionentaumel lebte, wirklich ein Nebbich war.“"
                                            },
                                            {
                                                "example_id": "78bfe3c7-aecd-4d6d-8796-22966b38b6de",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "Er hatte nicht viel für Schnorrer übrig, aber ihm gefiel es, wenn jemand sein Talent in der Öffentlichkeit präsentierte, und er fand, dass eine kleine Gage gerechtfertigt war."
                                            },
                                            {
                                                "example_id": "3aca782b-aff2-4cd2-b092-554be12d119c",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "„Die Schnorrer, das heißt die Bettler, die auf Kosten reicher Gönner lebten, waren fester Bestandteil des durch die jüdische Religion geprägten Selbstverständnisses.“"
                                            },
                                            {
                                                "example_id": "37f8bb00-ef8d-41e0-b935-14dfa059fae4",
                                                "sense_id": "482df6de-448b-3c1d-822f-1e964860bc28",
                                                "text": "„Denn einerseits entpuppt sich der Sabbatgast, der seinen Schwiegersohn ungebeten an den Tisch setzt, zwar als ein Schnorrer; andererseits aber folgen alle Beteiligten hier nur dem Gebot: Der Hausherr erfüllt seine Gastgeberpflicht, der Sabbatgast erfüllt seinen Vertrag mit den Eltern des Schwiegersohns, und indem er den Vater seiner Frau begleitet, hält sich auch der Schwiegersohn nur an die Regeln der Tradition.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
