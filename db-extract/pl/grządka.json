                                                "sense_id": "0700fe99-49df-384a-83a5-b20f66c33b99",
                                                "text": "Herr Wirt! Noch eine Stange!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a7decde5-2173-3633-b3f0-97de94440b34",
                                        "entry_id": "a9bb0b2f-6492-3024-b30d-c2e4c7595cc1",
