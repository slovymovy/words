                "senses": [
                    {
                        "sense_id": "9a5e1884-8ffe-3ae6-8a2c-dedba65b3762",
                        "entry_id": "8ad0226a-906b-3870-9a1c-cfbe04a083eb",
                        "glosses": [
                            "eine von zwei Kammern eines Parlaments"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "e40a2851-1e8a-4820-b77c-b74605d18653",
                                "sense_id": "9a5e1884-8ffe-3ae6-8a2c-dedba65b3762",
                                "text": "„Gegründet wurde das Unterhaus im Jahr 1867, als mit dem Verfassungsgesetz von 1867 der moderne kanadische Bundesstaat entstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2270ab1e-0779-3129-bace-670a8153c6b8",
                        "entry_id": "8ad0226a-906b-3870-9a1c-cfbe04a083eb",
                        "glosses": [
                            "die zweite Kammer britischen Parlaments"
                        ],
                        "tags": [
                            "no-plural",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "5f488e86-cf58-4fda-ab48-efce8dfea509",
                                "sense_id": "2270ab1e-0779-3129-bace-670a8153c6b8",
                                "text": "„Die ersten beiden Stuart-Monarchen, Jakob I. und Karl I. gerieten mit dem Unterhaus über Besteuerung, Religion und königliche Befugnisse in Konflikt.“"
                            },
                            {
                                "example_id": "092176d0-9ff6-4c67-a9a0-ba6db7ad63bb",
                                "sense_id": "2270ab1e-0779-3129-bace-670a8153c6b8",
                                "text": "„Er wollte unbedingt eine Debatte im Unterhaus mitansehen dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
