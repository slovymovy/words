{
    "word_family": [
        "abattement",
        "abatteur",
        "abattoir",
        "abattre"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7d19ee24-e2f4-30bf-bc9f-3c1ddc8bf0fb",
                    "sense_definition": "Affaibli moralement, découragé ou accablé par le chagrin ou les épreuves.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "état_moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il a perdu son travail, il semble profondément <w>abattu</w>.",
                            "target_lang_translations": {
                                "en": "Since he lost his job, he seems deeply <w>dejected</w>.",
                                "ru": "С тех пор как он потерял работу, он, кажется, глубоко <w>подавлен</w>.",
                                "de": "Seit er seine Arbeit verloren hat, wirkt er zutiefst <w>niedergeschlagen</w>.",
                                "es": "Desde que perdió su trabajo, parece profundamente <w>abatido</w>.",
                                "zh": "自从他失去工作后，他看上去非常<w>沮丧</w>。"
                            }
                        },
                        {
                            "text": "Elle avait l'air <w>abattu</w> après avoir appris la mauvaise nouvelle.",
                            "target_lang_translations": {
                                "en": "She looked <w>dejected</w> after hearing the bad news.",
                                "ru": "Она выглядела <w>подавленной</w> после того, как услышала плохую новость.",
                                "de": "Nachdem sie die schlechte Nachricht erfahren hatte, sah sie <w>niedergeschlagen</w> aus.",
                                "es": "Tenía un aire <w>abatido</w> tras enterarse de la mala noticia.",
                                "zh": "听到这个坏消息后，她看起来十分<w>沮丧</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "accablé",
                        "découragé",
                        "démoralisé"
                    ],
                    "antonyms": [
                        "jovial",
                        "rayonnant"
                    ],
                    "common_phrases": [
                        "avoir l'air abattu",
                        "se sentir abattu"
                    ],
                    "target_lang_definitions": {
                        "en": "Weakened in spirit, discouraged, or overwhelmed by sadness or hardship.",
                        "ru": "Морально ослабленный, павший духом от горя или трудностей.",
                        "de": "Innerlich niedergedrückt, mutlos oder von Kummer und Schwierigkeiten überwältigt.",
                        "es": "Debilitado anímicamente, desanimado o agobiado por la tristeza o las adversidades.",
                        "zh": "精神上受挫，灰心失望，或因悲伤与困境而情绪低落。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dejected",
                                "target_lang_sense_clarification": "often after bad news or setbacks"
                            },
                            {
                                "target_lang_word": "despondent",
                                "target_lang_sense_clarification": "formal, losing all hope"
                            },
                            {
                                "target_lang_word": "downcast",
                                "target_lang_sense_clarification": "looking sad or discouraged"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "подавленный",
                                "target_lang_sense_clarification": "состояние после плохих новостей"
                            },
                            {
                                "target_lang_word": "удручённый",
                                "target_lang_sense_clarification": "книжн., сильно огорчённый"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "niedergeschlagen",
                                "target_lang_sense_clarification": "nach schlechten Nachrichten oder Rückschlägen"
                            },
                            {
                                "target_lang_word": "entmutigt",
                                "target_lang_sense_clarification": "nach Misserfolgen die Zuversicht verloren"
                            },
                            {
                                "target_lang_word": "verzagt",
                                "target_lang_sense_clarification": "gehobener Stil, ohne Zuversicht"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "abatido",
                                "target_lang_sense_clarification": "tras malas noticias o reveses"
                            },
                            {
                                "target_lang_word": "desanimado",
                                "target_lang_sense_clarification": "sin ánimo tras un fracaso"
                            },
                            {
                                "target_lang_word": "decaído",
                                "target_lang_sense_clarification": "ánimo bajo, tristeza prolongada"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沮丧",
                                "target_lang_sense_clarification": "常指遭遇坏消息或挫折后"
                            },
                            {
                                "target_lang_word": "颓丧",
                                "target_lang_sense_clarification": "情绪低落，失去斗志"
                            },
                            {
                                "target_lang_word": "消沉",
                                "target_lang_sense_clarification": "精神萎靡，缺乏干劲"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a66166a-8f05-331d-a749-b1b7d3808651",
                    "sense_definition": "Affaibli physiquement par la maladie, la fatigue ou la douleur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "état_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patient est encore très <w>abattu</w> après plusieurs jours de forte fièvre.",
                            "target_lang_translations": {
                                "en": "The patient is still badly <w>weakened</w> after several days of high fever.",
                                "ru": "После нескольких дней высокой температуры пациент всё ещё очень <w>ослаблен</w>.",
                                "de": "Der Patient ist nach mehreren Tagen mit hohem Fieber noch sehr <w>geschwächt</w>.",
                                "es": "Tras varios días con fiebre alta, el paciente sigue muy <w>debilitado</w>.",
                                "zh": "经过几天的高烧，病人仍然非常<w>虚弱</w>。"
                            }
                        },
                        {
                            "text": "Cette longue marche sous le soleil brûlant a laissé les randonneurs complètement <w>abattus</w>.",
                            "target_lang_translations": {
                                "en": "The long walk in the scorching sun left the hikers completely <w>exhausted</w>.",
                                "ru": "Этот долгий переход под палящим солнцем оставил туристов совершенно <w>изнурёнными</w>.",
                                "de": "Der lange Marsch in der sengenden Sonne hat die Wanderer völlig <w>erschöpft</w>.",
                                "es": "Esa larga caminata bajo el sol abrasador dejó a los excursionistas completamente <w>agotados</w>.",
                                "zh": "在烈日下的长途跋涉让徒步者们<w>疲惫</w>不堪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "épuisé",
                        "faible",
                        "fatigué"
                    ],
                    "antonyms": [
                        "gaillard",
                        "vif",
                        "vigoureux"
                    ],
                    "target_lang_definitions": {
                        "en": "Physically weakened by illness, tiredness, or pain.",
                        "ru": "Физически ослабленный из-за болезни, усталости или боли.",
                        "de": "Durch Krankheit, Müdigkeit oder Schmerzen körperlich geschwächt.",
                        "es": "Físicamente debilitado por una enfermedad, el cansancio o el dolor.",
                        "zh": "身体因疾病、疲劳或疼痛而虚弱无力。"
                    },
