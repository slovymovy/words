                        "examples": [
                            {
                                "example_id": "7b522e67-d73c-48ea-9ddd-b5c11b5703c7",
                                "sense_id": "c4cd7452-28a1-3e37-8eca-e58dcfb822dd",
                                "text": "Il a voulu monter plus haut que l’échelle, disait-on à ceux qui plaignaient l’ex-garde-chasse, le chanoine rubicond à qui sa femme faisait son café au lait le matin, comme on l’a vu dans le récit des événements antérieurs."
                            },
                            {
                                "example_id": "66cc22b3-289d-499a-aaee-c141787d5665",
                                "sense_id": "c4cd7452-28a1-3e37-8eca-e58dcfb822dd",
                                "text": "L’ex-garde-chasse fit entendre un grondement de bête acculée."
                            },
                            {
                                "example_id": "55c8c1f9-466d-4997-8c1f-d3c518cc7925",
                                "sense_id": "c4cd7452-28a1-3e37-8eca-e58dcfb822dd",
                                "text": "Un vieux maire, ex-garde-chasse, se mit à notre disposition, mais ses renseignements ne nous apportèrent aucune précision nouvelle."
                            }
                        ]
                    }
