                "senses": [
                    {
                        "sense_id": "733261ba-ea0e-3126-a79a-0a0294352ca0",
                        "entry_id": "97d8c034-66d3-3793-8b92-fbbb4c1ea0ca",
                        "glosses": [
                            "ägyptische Stadt am rechten Ufer des Nils unterhalb des ersten Katarakts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44231d30-dc6a-494d-b3c4-7cb993a8c32e",
                                "sense_id": "733261ba-ea0e-3126-a79a-0a0294352ca0",
                                "text": "„[…] Das größte Stauwerk der Welt wird südlich von Assuan eingeweiht.“"
                            },
                            {
                                "example_id": "720e453c-0961-4fb6-8438-00078df4e8ce",
                                "sense_id": "733261ba-ea0e-3126-a79a-0a0294352ca0",
                                "text": "„Der ägyptische Staatspräsident Gamal Abd an Nasser eröffnet nahe der Stadt Assuan die Bauarbeiten für den Staudamm am Nil.“"
                            },
                            {
                                "example_id": "7b0bf406-356d-4bf1-96e9-c96872692044",
                                "sense_id": "733261ba-ea0e-3126-a79a-0a0294352ca0",
                                "text": "„Der bundesdeutschen Firma Hochtief AG in Essen wird die Leitung der Rettung der beiden durch den Staudammbau bei Assuan in Ägypten bedrohten Felsentempel von Abu Simbel am westlichen Nilufer übertragen.“"
                            },
                            {
                                "example_id": "902c7c0f-d733-4d9a-b1f2-c06a528c44f2",
                                "sense_id": "733261ba-ea0e-3126-a79a-0a0294352ca0",
                                "text": "„Bundeskanzler Helmut Schmidt (SPD) trifft in Assuan (Ägypten) mit dem somalischen Präsidenten Siad Barre zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
