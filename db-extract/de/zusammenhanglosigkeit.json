                        "target_lang_word": "raideur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raideur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14a5c750-5c64-3e61-98bb-b2eb37bdb51a",
                                        "entry_id": "7401c6c7-b1a9-3982-9227-b4b7a788fec4",
                                        "glosses": [
                                            "Caractère de ce qui est raide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23d7dd94-a9fb-4aaf-b146-f1e074f42a76",
                                                "sense_id": "14a5c750-5c64-3e61-98bb-b2eb37bdb51a",
                                                "text": "La raideur d’une corde tendue."
                                            },
                                            {
                                                "example_id": "6f1c8ac4-8b9a-4ab3-8c24-b550ea134c97",
                                                "sense_id": "14a5c750-5c64-3e61-98bb-b2eb37bdb51a",
                                                "text": "La raideur d’une barre de fer."
                                            },
                                            {
                                                "example_id": "492ecb8f-1009-4c5d-ab18-15983fc81169",
                                                "sense_id": "14a5c750-5c64-3e61-98bb-b2eb37bdb51a",
                                                "text": "Il lui est resté de la raideur dans le bras."
                                            },
                                            {
                                                "example_id": "15ab85c8-6079-494c-8cdc-7b607c13b305",
                                                "sense_id": "14a5c750-5c64-3e61-98bb-b2eb37bdb51a",
                                                "text": "Soyez à cheval sans raideur."
                                            },
                                            {
                                                "example_id": "666911ff-1a05-471c-a032-602fcf5e2e16",
                                                "sense_id": "14a5c750-5c64-3e61-98bb-b2eb37bdb51a",
                                                "text": "La raideur des mouvements."
                                            },
                                            {
                                                "example_id": "3eea7ac1-5ce0-4c96-9f77-12a83be47690",
                                                "sense_id": "14a5c750-5c64-3e61-98bb-b2eb37bdb51a",
                                                "text": "La raideur des contours, d’une draperie."
                                            },
                                            {
                                                "example_id": "acf6b821-f20c-4533-862d-3f80bc89d613",
                                                "sense_id": "14a5c750-5c64-3e61-98bb-b2eb37bdb51a",
                                                "text": "Son style est clair et correct, mais il a de la raideur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a9d04fd-fcfd-3495-8656-9b7bffa1962f",
                                        "entry_id": "7401c6c7-b1a9-3982-9227-b4b7a788fec4",
                                        "glosses": [
                                            "Caractère d'une côte, d’un escalier, d'un raidillon, dont la pente est difficile à monter et à descendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af29c5cd-6d6f-443c-a522-419b7f0406e4",
                                                "sense_id": "7a9d04fd-fcfd-3495-8656-9b7bffa1962f",
                                                "text": "Il faut bien serrer le frein à cause de la raideur de la descente."
                                            },
                                            {
                                                "example_id": "be63cd53-f4c4-4bc3-a749-7c3ac3a1297f",
                                                "sense_id": "7a9d04fd-fcfd-3495-8656-9b7bffa1962f",
                                                "text": "La raideur de la montée."
                                            },
                                            {
                                                "example_id": "247048d0-3141-4da3-bee4-7b4fbfd0d8cd",
                                                "sense_id": "7a9d04fd-fcfd-3495-8656-9b7bffa1962f",
                                                "text": "La raideur d’un escalier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c669a52-2b15-38d1-88fb-c63480da2850",
                                        "entry_id": "7401c6c7-b1a9-3982-9227-b4b7a788fec4",
                                        "glosses": [
                                            "Rigidité, fermeté excessive, extrême sévérité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61019a6a-6597-47ac-b30e-159643cbe893",
                                                "sense_id": "4c669a52-2b15-38d1-88fb-c63480da2850",
                                                "text": "Une raideur inflexible."
                                            },
                                            {
                                                "example_id": "d1f8a0ab-c1ec-4ee6-8c2e-073f05cb589d",
                                                "sense_id": "4c669a52-2b15-38d1-88fb-c63480da2850",
                                                "text": "Il a de la raideur dans l’esprit, dans l’humeur, dans le caractère."
                                            },
                                            {
                                                "example_id": "a968562c-d4ee-4690-a6eb-2985df75fada",
                                                "sense_id": "4c669a52-2b15-38d1-88fb-c63480da2850",
                                                "text": "Une raideur de principes."
                                            },
                                            {
                                                "example_id": "3c032bf5-1cdf-4d57-8d76-baff7caf7835",
                                                "sense_id": "4c669a52-2b15-38d1-88fb-c63480da2850",
                                                "text": "Il apporte, il met beaucoup de raideur en affaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c48136b8-177d-3e74-9454-412eca496d32",
                                        "entry_id": "7401c6c7-b1a9-3982-9227-b4b7a788fec4",
                                        "glosses": [
                                            "Défaut de la mobilité du squelette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e7b5bfa-d4e9-4a8d-990b-dffe7aecde72",
                                                "sense_id": "c48136b8-177d-3e74-9454-412eca496d32",
                                                "text": "La notion de raideur sur prothèse du genou est relative. Un genou normal fléchit jusqu'à 150° mais la flexion d'un genou prothétique dépasse rarement 120°."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raideur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bc65156-a887-3c90-835e-5e4f394698b0",
                                        "entry_id": "6d3a9eca-af1b-31c0-9b0b-d81e936a3433",
                                        "glosses": [
                                            "Personne prenant part à des raids."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bb943a9-461c-34d1-b16d-80a3a96ef9c2",
                                        "entry_id": "6d3a9eca-af1b-31c0-9b0b-d81e936a3433",
                                        "glosses": [
                                            "Personne lançant isolément des OPA."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "756d1d2b-8e28-4c0c-a865-a8dc11ea995e",
                                                "sense_id": "9bb943a9-461c-34d1-b16d-80a3a96ef9c2",
                                                "text": "Certains raideurs — personnes qui lancent seules une OPA hostile — recherchent parfois ce que l'on appelle un « greenmail », c'est-à-dire que la mise en place d'une défense anti-OPA par la cible se traduira par un appauvrissement tel que celle-ci ferait mieux de payer en cash le raideur pour qu'il arrête son attaque. Un raideur célèbre pour ce genre d'opération est le financier Carl Icahn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f95f167-56d4-4591-84a6-33205a3380ad",
