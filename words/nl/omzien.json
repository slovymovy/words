{
    "word_family": [
        "omzien",
        "omkijken",
        "ommezien"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc7127c4-fd46-31f8-b859-e982ea142444",
                    "sense_definition": "Zorgen voor of aandacht besteden aan iemand of iets (meestal met 'naar').",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zorg_dragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is gelukkig altijd wel iemand die naar de eenzame buren wil <w>omzien</w>.",
                            "target_lang_translations": {
                                "it": "Fortunatamente c'è sempre qualcuno che vuole <w>prendersi cura</w> dei vicini solitari."
                            }
                        },
                        {
                            "text": "In deze moeilijke tijden moeten we meer naar elkaar <w>omzien</w>.",
                            "target_lang_translations": {
                                "it": "In questi tempi difficili dobbiamo <w>prenderci cura</w> maggiormente l'uno dell'altro."
                            }
                        }
                    ],
                    "synonyms": [
                        "omkijken"
                    ],
                    "common_phrases": [
                        "omzien naar elkaar",
                        "omzien naar de armen"
                    ],
                    "target_lang_definitions": {
                        "it": "Prendersi cura di qualcuno o qualcosa, prestare attenzione o assistere (di solito con 'naar')."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "prendersi cura di",
                                "target_lang_sense_clarification": "assistere o occuparsi di qualcuno"
                            },
                            {
                                "target_lang_word": "badare a",
                                "target_lang_sense_clarification": "prestare attenzione a qualcuno bisognoso"
                            },
                            {
                                "target_lang_word": "occuparsi di",
                                "target_lang_sense_clarification": "dedicare attenzione e cura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59b84e12-dadf-3593-b646-edb139152c56",
                    "sense_definition": "Achterom kijken of terugblikken in de tijd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "blikken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zonder <w>om</w> te <w>zien</w> liep hij snel weg van het oude huis.",
                            "target_lang_translations": {
                                "it": "Senza <w>guardarsi indietro</w>, si allontanò rapidamente dalla vecchia casa."
                            }
                        },
                        {
                            "text": "Als we <w>omzien</w> naar het verleden, zien we hoeveel er veranderd is.",
                            "target_lang_translations": {
                                "it": "Se <w>ripensiamo</w> al passato, vediamo quanto le cose siano cambiate."
                            }
                        }
                    ],
                    "synonyms": [
                        "omkijken"
                    ],
                    "common_phrases": [
                        "omzien in weemoed"
                    ],
                    "target_lang_definitions": {
                        "it": "Guardarsi indietro, sia fisicamente che nel tempo (riflettere sul passato)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "guardarsi indietro",
                                "target_lang_sense_clarification": "sia fisicamente che metaforicamente nel tempo"
                            },
                            {
                                "target_lang_word": "volgersi indietro",
                                "target_lang_sense_clarification": "girarsi a guardare"
                            },
                            {
                                "target_lang_word": "ripensare a",
                                "target_lang_sense_clarification": "riflettere sul passato"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f0fe978-12e5-3287-8c06-d80af455f112",
                    "sense_definition": "Om je heen kijken om iets of iemand te zoeken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "blikken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bleef even op de hoek van de straat staan om rustig <w>om</w> te <w>zien</w>.",
                            "target_lang_translations": {
                                "it": "Si fermò un attimo all'angolo della strada per <w>guardarsi intorno</w> con calma."
                            }
                        },
                        {
                            "text": "Je moet goed <w>omzien</w> in deze drukke winkelstraat om hen niet kwijt te raken.",
                            "target_lang_translations": {
                                "it": "Devi <w>guardarti bene intorno</w> in questa affollata via dello shopping per non perderli di vista."
                            }
                        }
                    ],
                    "synonyms": [
                        "omkijken"
                    ],
                    "target_lang_definitions": {
                        "it": "Guardarsi intorno per cercare qualcosa o qualcuno."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "guardarsi intorno",
                                "target_lang_sense_clarification": "osservare l'ambiente circostante"
                            },
                            {
                                "target_lang_word": "cercare con lo sguardo",
                                "target_lang_sense_clarification": "tentare di individuare qualcuno o qualcosa"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c47c2a20-889b-3465-abdc-eec5163d32ac",
                    "sense_definition": "Een zeer korte periode, een ogenblik.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In een <w>omzien</w> stonden de tafel en stoelen weer op hun plek.",
                            "target_lang_translations": {
                                "it": "In un <w>batter d'occhio</w> il tavolo e le sedie erano di nuovo al loro posto."
                            }
                        },
                        {
                            "text": "De vakantie was in een <w>omzien</w> alweer voorbij.",
                            "target_lang_translations": {
                                "it": "La vacanza era già finita in un <w>soffio</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ommezien"
                    ],
                    "common_phrases": [
                        "in een omzien"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in de vaste uitdrukking 'in een omzien'"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Un periodo di tempo brevissimo, un batter d'occhio."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "batter d'occhio",
                                "target_lang_sense_clarification": "un istante, un momento brevissimo"
                            },
                            {
                                "target_lang_word": "attimo",
                                "target_lang_sense_clarification": "un momento fugace"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}