                    {
                        "sense_id": "7a751bfe-7a43-360f-90bc-e6440b7a07ca",
                        "entry_id": "78420105-78c9-3696-8115-4306203531ec",
                        "glosses": [
                            "een schrijfpen met holle houder waarin zich een inktreservoir bevindt"
                        ],
                        "tags": [
                            "teken- en schrijfmateriaal"
                        ],
                        "examples": [
                            {
                                "example_id": "869faceb-098f-4da3-a0d3-e63e8495f03e",
                                "sense_id": "7a751bfe-7a43-360f-90bc-e6440b7a07ca",
                                "text": "Als een vulpen langere tijd open (zonder dop) heeft gelegen, kan de inkt in de penpunt indrogen."
                            },
                            {
                                "example_id": "e2b6dc06-f906-4de1-8811-b0e778d3f7c1",
                                "sense_id": "7a751bfe-7a43-360f-90bc-e6440b7a07ca",
                                "text": "Ik legde de lege cahiers die ik had meegenomen links op een stapel, met mijn ernaast."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
