                "forms": [],
                "senses": [
                    {
                        "sense_id": "78a99d7d-dbba-3fee-8866-09fe1d215ab2",
                        "entry_id": "9bb730eb-8ea7-3643-bad7-4a83f9f1368d",
                        "glosses": [
                            "samen met iets of iemand anders ergens naartoe gestuurd worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bf1c0d0-3c2d-4155-9a40-682806143e73",
                                "sense_id": "78a99d7d-dbba-3fee-8866-09fe1d215ab2",
                                "text": "Atheïsten en humanisten in het Amerikaanse leger willen eigen geestelijk verzorgers met de strijdkrachten kunnen meezenden. Dat meldde de Amerikaanse krant The New York Times eerder deze week."
                            },
                            {
                                "example_id": "0e3bf895-b2ae-400e-93c6-bfdb94f5facb",
                                "sense_id": "78a99d7d-dbba-3fee-8866-09fe1d215ab2",
                                "text": "Ons land is bereid vier tot zes F-16’s beschikbaar te stellen voor bombardementen op ISIS-stellingen. Ook een KDC-10 tankvliegtuig is onomstreden. Inzet van de straaljagers en de tanker betekent het meezenden van zo’n 250 militairen."
                            },
                            {
                                "example_id": "40a7d47e-5373-4d09-8eb8-5fd555439387",
                                "sense_id": "78a99d7d-dbba-3fee-8866-09fe1d215ab2",
                                "text": "Technisch expert Jan Zandstra denkt dat de geluidskwaliteit van de radiozender sterk achteruit kan gaan door het meezenden van een antimuggenpiep. De theorie bestaat dat muggen door een frequentie van hoger dan 15 kilohertz kunnen worden verjaagd. „Maar alle frequenties boven de 15 kilohertz worden door de radiozender weggefilterd. Stuurt Noordzee FM een iets lagere frequentie mee, dan zijn er mensen die de piep kunnen horen. Dus het zal alleen maar tot irritatie leiden.”"
                            }
                        ]
                    }
