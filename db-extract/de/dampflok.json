                    {
                        "translation_id": "78e7bbeb-c395-4573-b6dc-f3be3ad26c0b",
                        "source_entry_id": "fe1c6eb7-983d-396e-8b5c-3082240b589c",
                        "source_sense_id": "e3eb59d6-3f42-3951-a144-fc449bc7a8b7",
                        "source_sense_description": "Abkürzung von Dampflokomotive",
                        "target_lang_word": "паровоз",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "паровоз",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bfcf9f73-d0bc-3d93-86f4-e2e6df0e72cb",
                                        "entry_id": "e47c25af-9d8f-3e18-b217-415a429774af",
                                        "glosses": [
                                            "ж.-д. локомотив, использующий в качестве двигателя паровую машину"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d78c1bfd-9626-439a-90ee-ae74f640dcd3",
                                                "sense_id": "bfcf9f73-d0bc-3d93-86f4-e2e6df0e72cb",
                                                "text": "Паровоз засвистел, начал тормозить."
                                            },
                                            {
                                                "example_id": "551c5d9f-ee51-4004-9120-d2222382d26f",
                                                "sense_id": "bfcf9f73-d0bc-3d93-86f4-e2e6df0e72cb",
                                                "text": "Паровозы пыхтели, испуская клубы пара и осыпая искрами рельсовый путь."
                                            },
                                            {
                                                "example_id": "718b82ea-8833-401e-b890-35217492d10b",
                                                "sense_id": "bfcf9f73-d0bc-3d93-86f4-e2e6df0e72cb",
                                                "text": "Паровоз пускает под себя мощную струю отработанного пара — и по пару, по пару…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "714c2bbd-aaa2-3186-a283-f2e89bcdcec8",
                                        "entry_id": "e47c25af-9d8f-3e18-b217-415a429774af",
                                        "glosses": [
                                            "карт. в преферансе: приём, позволяющий отдать заказавшему неудачный мизер (обязательство не взять ни одной взятки) как можно больше взяток"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443334f6-3a8b-4bdf-ab33-600252c7047d",
                                                "sense_id": "714c2bbd-aaa2-3186-a283-f2e89bcdcec8",
                                                "text": "В Сочи на пляже играли в преферанс и засадили одному паровоз на мизере."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "104c93a2-6bee-31ee-9b0b-00e700b38ffe",
                                        "entry_id": "e47c25af-9d8f-3e18-b217-415a429774af",
                                        "glosses": [
                                            "сленг способ курения наркотиков, когда один курильщик выдувает дым в рот другому"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "447d84c1-8f0b-43f0-84c8-d141d4fd83f6",
                                                "sense_id": "104c93a2-6bee-31ee-9b0b-00e700b38ffe",
                                                "text": "Кондукторы, матросы забивают папиросы // И по кругу раздают друг другу паровозы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cb41593-467d-35e8-9f9d-acfeb761ab23",
                                        "entry_id": "e47c25af-9d8f-3e18-b217-415a429774af",
                                        "glosses": [
                                            "жарг. смесь вин, подаваемая в ресторане по заказу в конце застолья"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff57f60a-e8d8-45d9-b1a0-cd7bad2bec3c",
                                                "sense_id": "9cb41593-467d-35e8-9f9d-acfeb761ab23",
                                                "text": "Говорю: „Выпьем паровоз“. Это так называется последний бокал, где давали какую-то смесь из вин. Щербов говорил: „Не пей паровоза“, — а выпили."
                                            }
                                        ]
                                    }
                                ]
                            },
