        "fr-extract.jsonl": [
            {
                "entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                "word": "sororité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "53a25f40-ab29-4f46-921c-d98077c1cb68",
                        "entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                        "tags": [
                            "plural"
                        ],
                        "form": "sororités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62004fae-c00f-3827-bb24-be644d24d6b0",
                        "entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                        "glosses": [
                            "Organisme, association, à caractère religieux, entre femmes voulant vivre de façon sororale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f99882b-2d9f-422a-89c0-bd29b993ab8a",
                                "sense_id": "62004fae-c00f-3827-bb24-be644d24d6b0",
                                "text": "Dune a mis en scène la plus puissante et la plus agaçante sororité de l’histoire de la littérature : l’ordre du Bene Gesserit."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4b00a85-ce16-3c21-8deb-8138e0bc6fe5",
                        "entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                        "glosses": [
                            "Organisation semi-secrète d’étudiantes américaines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2366926c-e3e1-4505-b678-b7a3bdc5dfc3",
                                "sense_id": "f4b00a85-ce16-3c21-8deb-8138e0bc6fe5",
                                "text": "Pour rien au monde je n’aurais raté le septième match de la série de championnat de la Ligue américaine 2003 entre les Yankees et les Red Sox, mais il y avait en même temps une réception à la sororité de ma copine et je devais obligatoirement y assister."
                            },
                            {
                                "example_id": "b6702670-2fc5-4b24-bade-4d937436cb80",
                                "sense_id": "f4b00a85-ce16-3c21-8deb-8138e0bc6fe5",
                                "text": "— Et je raconterai à mes camarades de sororité que j'ai couché avec un college boy blanc, et elles ne me croiront pas"
                            }
                        ]
                    },
                    {
                        "sense_id": "41d3658e-6aa4-326e-b28a-136179f8b500",
                        "entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                        "glosses": [
                            "Solidarité entre femmes, fondée sur la conscience de partager une condition commune et visant à lutter contre les systèmes d’oppression comme le patriarcat."
                        ],
                        "tags": [
                            "Études féministes",
                            "Luttes sociales"
                        ],
                        "examples": [
                            {
                                "example_id": "fbc941d3-0ba4-47c4-8ed7-a082eb3eade8",
                                "sense_id": "41d3658e-6aa4-326e-b28a-136179f8b500",
                                "text": "Elle s’est construite et élevée dans un milieu pauvre et un pays raciste. Elle prêche la force des femmes et leur sororité."
                            },
                            {
                                "example_id": "d362f53c-0dcd-4a7b-a9f5-f908004c8668",
                                "sense_id": "41d3658e-6aa4-326e-b28a-136179f8b500",
                                "text": "Ce que la minisérie du studio Louise Média réussit le mieux, c’est à éclipser un Dom Juan, finalement juste pathétique dans son déni et sa jalousie mal placée, pour mettre en lumière la sororité qui naît entre ses victimes."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcee45c4-c7ae-37ed-86d3-83deeba22f3e",
                        "entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                        "glosses": [
                            "Lien affectif ou amical entre femmes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6dc8e85b-57d5-464d-ab87-5955af1e73f5",
                                "sense_id": "bcee45c4-c7ae-37ed-86d3-83deeba22f3e",
                                "text": "Entre l’amitié féminine, la sororité ou encore le féminisme, Léa Volène nous propose différents aspects des femmes, mais aussi leurs forces et leurs fragilités."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6154f18b-91e8-4811-b23d-7feb2783425a",
                        "source_entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                        "source_sense_id": "62004fae-c00f-3827-bb24-be644d24d6b0",
                        "source_sense_description": "Organisation d’étudiantes américaines",
                        "target_lang_word": "Schwesternschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a20756e1-0754-4ea3-9531-7c6b7c1c27a0",
                        "source_entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                        "source_sense_id": "62004fae-c00f-3827-bb24-be644d24d6b0",
                        "source_sense_description": "Organisation d’étudiantes américaines",
                        "target_lang_word": "sorority",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorority",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03d901fa-e244-3eb5-9455-48dd50c1f99c",
                                        "entry_id": "b9ddddef-d5df-36e5-8917-ff71e6bc537e",
                                        "glosses": [
                                            "A group of girls or women associated for a common purpose; a sisterhood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd36b902-a513-3c84-919b-b2af6475aeb1",
                                        "entry_id": "b9ddddef-d5df-36e5-8917-ff71e6bc537e",
                                        "glosses": [
                                            "A social organization of female students at a college or university; usually identified by Greek letters."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aae7af97-ea41-4fa3-98b4-ba5b2f23e1af",
                                                "sense_id": "bd36b902-a513-3c84-919b-b2af6475aeb1",
                                                "text": "Every day is a party at this sorority!"
                                            },
                                            {
                                                "example_id": "fbd4cbc8-e354-4727-8681-6c428c7f28f7",
                                                "sense_id": "bd36b902-a513-3c84-919b-b2af6475aeb1",
                                                "text": "And Florida State University suspended all frats and sororities for two months after the November 2017 death of Pi Kappa Phi pledge Andrew Coffey, which has since been determined to have been due to hazing, according to police. […] When Jo Hannah Burch pledged a sorority at Young Harris College, a private liberal arts college in North Georgia, she too was looking to meet new people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "614a8cf9-991d-4bc5-a2e6-6672a232771a",
                        "source_entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
                        "source_sense_id": "62004fae-c00f-3827-bb24-be644d24d6b0",
                        "source_sense_description": "Organisation d’étudiantes américaines",
                        "target_lang_word": "sisterhood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sisterhood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f2e7188-d312-320b-8058-f7a806abc6e0",
                                        "entry_id": "2e84ec50-7789-32b6-b92e-902f3269b0d8",
                                        "glosses": [
                                            "The state, or kinship of being sisters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e4ebb60-da62-3f9d-851e-65b5d9799505",
                                        "entry_id": "2e84ec50-7789-32b6-b92e-902f3269b0d8",
                                        "glosses": [
                                            "The quality of being sisterly; sisterly companionship; especially, the sense that women have of being in solidarity with one another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f065aff-0deb-3022-ba46-da3ac15033e6",
                                        "entry_id": "2e84ec50-7789-32b6-b92e-902f3269b0d8",
                                        "glosses": [
                                            "A religious society of women."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30961389-4ead-4cc5-a64c-9f72c8cdf700",
                                                "sense_id": "3f065aff-0deb-3022-ba46-da3ac15033e6",
                                                "text": "In contrast, she said, women join sisterhoods and do volunteer work for Jewish fundraising organizations that are run and dominated by men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "797fde9f-c86f-3bee-b09a-e8eaa37174cb",
                                        "entry_id": "2e84ec50-7789-32b6-b92e-902f3269b0d8",
                                        "glosses": [
                                            "The idea of universal experience amongst women, regardless of other traits or factors. (Considered obsolete in third-wave feminism.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2932092-55e0-4af2-8ec5-ebc626cb4e88",
                                                "sense_id": "797fde9f-c86f-3bee-b09a-e8eaa37174cb",
                                                "text": "What does the rallying cry of sisterhood and the concept of feminism mean when last year, the majority of white, female voters chose whiteness as a political identity over womanhood?"
                                            },
                                            {
                                                "example_id": "efff4d75-aaa8-4b89-aa05-883a728adf08",
                                                "sense_id": "797fde9f-c86f-3bee-b09a-e8eaa37174cb",
                                                "text": "In a terrible way, I’ve never felt more part of a sisterhood or more certain that pain is shared within that family."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "716c4891-5977-4138-ac6e-fccb50fe0c0a",
                        "source_entry_id": "4d934870-9e3b-3ff7-af2c-6d6d194e8f6a",
