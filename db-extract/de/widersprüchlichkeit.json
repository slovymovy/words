                "senses": [
                    {
                        "sense_id": "0fe7cc3b-66f6-352e-bf1f-68d6000c950a",
                        "entry_id": "b4f44fbd-07f5-32e9-bcfc-abf8843d7431",
                        "glosses": [
                            "Zustand des Nichtübereinstimmens, der gleichzeitig sich widersprechende Aspekte enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcc4a5b2-717b-4c17-b167-edf32c191225",
                                "sense_id": "0fe7cc3b-66f6-352e-bf1f-68d6000c950a",
                                "text": "Aufgrund derer gegensätzlichen Bemühungen bleibt Berlin eine Stadt voller Widersprüchlichkeit."
                            },
                            {
                                "example_id": "fff289a2-8a95-4b0c-9226-1f9474a3daf4",
                                "sense_id": "0fe7cc3b-66f6-352e-bf1f-68d6000c950a",
                                "text": "Der Fall Neumeier steckt voller Widersprüchlichkeiten."
                            },
                            {
                                "example_id": "cd0553d6-266a-4bfa-9973-f7af78e4ba8f",
                                "sense_id": "0fe7cc3b-66f6-352e-bf1f-68d6000c950a",
                                "text": "Die Widersprüchlichkeit in seinen Aussagen lässt sich im Nachhinein nur teilweise erklären."
                            },
                            {
                                "example_id": "9ac1d13a-b19f-41d3-ac68-6906cd5c836b",
                                "sense_id": "0fe7cc3b-66f6-352e-bf1f-68d6000c950a",
                                "text": "„Denn es liegt im Wesen des Humors, dass man die Widersprüchlichkeit nicht nur der Welt, sondern seiner eigenen Existenz akzeptiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
