    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e35070ed-aee5-35e3-970a-c875f40bba53",
                    "sense_definition": "Qui se trouve au début, qui marque le commencement d'une action, d'un processus ou d'un état.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "commencement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le projet <w>initial</w> a dû être modifié pour tenir compte du budget limité."
                        },
                        {
                            "text": "Après une hésitation <w>initiale</w>, elle a accepté notre proposition avec enthousiasme."
                        }
                    ],
                    "synonyms": [
                        "premier"
                    ],
                    "antonyms": [
                        "final"
                    ],
                    "common_phrases": [
                        "projet initial",
                        "idée initiale",
                        "phase initiale"
                    ]
                },
                {
                    "sense_id": "397c6091-78de-30b1-ae3a-d22e0d23e1b5",
                    "sense_definition": "Se dit d'une lettre ou d'une syllabe qui commence un mot.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La lettre <w>initiale</w> d'un nom propre s'écrit toujours avec une majuscule."
                        },
                        {
                            "text": "Les enfants apprennent à reconnaître le son de la consonne <w>initiale</w> de chaque mot."
                        }
                    ],
                    "antonyms": [
                        "final"
                    ],
                    "common_phrases": [
                        "lettre initiale",
                        "syllabe initiale"
                    ]
                },
                {
                    "sense_id": "6223cd7d-4071-3b80-98e5-341be17db860",
                    "sense_definition": "En physique, qualifie l'état ou la valeur d'une grandeur mesurée au commencement d'un mouvement ou d'une observation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vitesse <w>initiale</w> du projectile détermine la trajectoire qu'il suivra dans l'air."
                        },
                        {
                            "text": "Les scientifiques comparent la température <w>initiale</w> du liquide avec celle mesurée après la réaction."
                        }
                    ],
                    "antonyms": [
                        "final"
                    ],
                    "common_phrases": [
                        "vitesse initiale",
                        "position initiale"
                    ]
                },
                {
                    "sense_id": "f7093db1-a7a8-3b3c-a7dc-13bc31fcac6e",
                    "sense_definition": "En typographie, qualifie la première lettre d'un livre ou d'un chapitre, souvent ornée ou plus grande que les autres.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "typographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le copiste a tracé une lettre <w>initiale</w> richement enluminée au début du chapitre."
                        },
                        {
                            "text": "Cette édition de luxe présente une grande majuscule <w>initiale</w> pour ouvrir chaque poème."
                        }
                    ]
                }
            ]
        }
    ]
