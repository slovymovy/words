                "senses": [
                    {
                        "sense_id": "47bc0507-5f16-3c98-8195-c2ff79c3eaf1",
                        "entry_id": "dfc4051e-78fd-3e34-98ef-19054b9345b1",
                        "glosses": [
                            "Siegespreis für den ersten Platz bei einem Wettkampf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28073bb0-b132-4ee3-8598-68402b87387f",
                                "sense_id": "47bc0507-5f16-3c98-8195-c2ff79c3eaf1",
                                "text": "Durch sein Talent für die Leichtathletik hatte er mehrere Goldmedaillen bekommen."
                            },
                            {
                                "example_id": "64e9df90-9a76-4450-b84c-a7c1ce43b529",
                                "sense_id": "47bc0507-5f16-3c98-8195-c2ff79c3eaf1",
                                "text": "„Auf der verwaisten Aschenbahn werde ich die 400 Meter in knapp zehn Minuten laufen und die Goldmedaille gewinnen.“"
                            },
                            {
                                "example_id": "dfbc24df-d9db-4fc7-99d7-926c5556c0c3",
                                "sense_id": "47bc0507-5f16-3c98-8195-c2ff79c3eaf1",
                                "text": "„Deutschland gewinnt dreiunddreißig Goldmedaillen, neun mehr als die USA.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe65a54d-bbba-40ff-b658-7a24b8636c2e",
                        "source_entry_id": "dfc4051e-78fd-3e34-98ef-19054b9345b1",
                        "source_sense_id": "47bc0507-5f16-3c98-8195-c2ff79c3eaf1",
                        "source_sense_description": "Siegespreis für den ersten Platz bei einem Wettkampf",
                        "target_lang_word": "金牌",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "金牌",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "27e454f1-7f73-3d4c-bba5-370af8059eea",
                                        "entry_id": "864058e9-2e1f-328c-ac83-e980a3b13910",
                                        "glosses": [
                                            "金質的獎牌，通常是表面鍍金的銀塊"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5974162-997a-4490-9fa4-aa0fb52c28d5",
                                                "sense_id": "27e454f1-7f73-3d4c-bba5-370af8059eea",
                                                "text": "奧運會的時候，我們關注金牌的運動員。"
                                            },
                                            {
                                                "example_id": "f84fe1c6-f365-4fda-9c01-74595c3409e8",
                                                "sense_id": "27e454f1-7f73-3d4c-bba5-370af8059eea",
                                                "text": "奥运会的时候，我们关注金牌的运动员。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "632c8e83-1890-3769-87fd-6d7953b6305e",
                                        "entry_id": "864058e9-2e1f-328c-ac83-e980a3b13910",
                                        "glosses": [
                                            "金字牌的簡稱。"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6cd3415-301a-48d4-80af-906e34112a13",
                                                "sense_id": "632c8e83-1890-3769-87fd-6d7953b6305e",
                                                "text": "岳爺揮淚對着眾百姓道：「爾等不可如此！聖上連發十二道金牌召我，我怎敢抗違君命！」"
                                            },
                                            {
                                                "example_id": "25579026-ca76-4909-b0f0-716807ca3e7c",
                                                "sense_id": "632c8e83-1890-3769-87fd-6d7953b6305e",
                                                "text": "岳爷挥泪对着众百姓道：「尔等不可如此！圣上连发十二道金牌召我，我怎敢抗违君命！」"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
