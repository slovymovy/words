                ],
                "senses": [
                    {
                        "sense_id": "9d3c877d-da5b-35c0-90d7-4194ae28de9f",
                        "entry_id": "7e302f4e-3923-3fd9-9c5e-e00d13332e80",
                        "glosses": [
                            "разг., пренебр. писатель (обычно плохой, но плодовитый)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95de6417-e9ea-40ec-a6b9-e9b059b5ef83",
                                "sense_id": "9d3c877d-da5b-35c0-90d7-4194ae28de9f",
                                "text": "Теперь всякий посредственный писака с гордостию говорит о себе, что он литератор или поэт."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d8fbf82-4f2e-3323-bd1f-75dfed9cef5f",
                        "entry_id": "7e302f4e-3923-3fd9-9c5e-e00d13332e80",
                        "glosses": [
                            "разг. тот, кто пишет, кто умеет писать (в 1 знач.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e94a6fa-61c8-427b-8bc8-ca5cfcf8ec00",
                                "sense_id": "5d8fbf82-4f2e-3323-bd1f-75dfed9cef5f",
                                "text": "[Матвеевна:] Какая, батюшка, писака: так кой-какие каракульки ставлю."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c21475f-53e0-3a71-94e1-1a53a634687e",
                        "entry_id": "7e302f4e-3923-3fd9-9c5e-e00d13332e80",
                        "glosses": [
                            "тот, кто много, охотно пишет"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c69aec27-d1fe-3882-bac9-2e145f7fd3c7",
                        "entry_id": "7e302f4e-3923-3fd9-9c5e-e00d13332e80",
                        "glosses": [
                            "тот, кто профессионально занимается написанием, составлением текстов (бумаг, прошений и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16db0dc3-78ac-4c10-892e-0356d8937ab1",
                                "sense_id": "c69aec27-d1fe-3882-bac9-2e145f7fd3c7",
                                "text": "Для осуществления подобных хитроумных замыслов во всех странах существуют канцелярские писаки, ум которых, за отсутствием творческих мыслей, целиком направлен на составление или казенных отписок, или бумаг, слагающих с их начальства возможно большую долю ответственности."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "986de448-5f30-40c2-bd02-7d463653323e",
                        "source_entry_id": "7e302f4e-3923-3fd9-9c5e-e00d13332e80",
                        "target_lang_word": "scribbler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scribbler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1868a7a3-507f-3135-8f21-cc76e036c53b",
                                        "entry_id": "3cd8f5ac-5e75-3447-846e-1cdc638a24ae",
                                        "glosses": [
                                            "One who scribbles; a hasty or untalented writer or artist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072ea513-6dc6-488d-88df-f4b4495efdf5",
                                                "sense_id": "1868a7a3-507f-3135-8f21-cc76e036c53b",
                                                "text": "The scribbler, pinch'd with hunger, writes to dine."
                                            },
                                            {
                                                "example_id": "b6778315-cd0a-497b-b837-3ad4f4300b0a",
                                                "sense_id": "1868a7a3-507f-3135-8f21-cc76e036c53b",
                                                "text": "\"That's what I have been talking to you, sir - scientific gibberish! Did you think you could match cunning with me - you with your walnut of a brain? You think you are omnipotent, you infernal scribblers, don't you? That your praise can make a man and your blame can break him?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d83ef87-3608-3818-8d03-190a307f0d9f",
                                        "entry_id": "3cd8f5ac-5e75-3447-846e-1cdc638a24ae",
                                        "glosses": [
                                            "A machine for coarse carding or teasing of wool."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11d2c69d-a8c7-3433-91d0-e7288148829c",
                                        "entry_id": "3cd8f5ac-5e75-3447-846e-1cdc638a24ae",
                                        "glosses": [
                                            "A ruled notebook or exercise book, especially in grade school."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
