                "word": "gyropode",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "07e9735b-b673-4c71-b61c-5a567480a897",
                        "entry_id": "9ca34197-46b2-397a-9ca6-e66b5c83c141",
                        "tags": [
                            "plural"
