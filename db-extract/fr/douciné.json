                        "glosses": [
                            "Se dit d'un vin trop sucré, pommadé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "702fab19-e07b-4a07-85dc-5b6204e10ea9",
                                "sense_id": "0529f3de-39a4-3747-8750-2eb44d160155",
                                "text": "On passe de souple, coulant, fondu, tendre, velouté, assoupli, fondant, gouleyant, crémeux, gras, sucré, suave, mûr, miellé, onctueux à douciné, douceâtre, pommadé, sirupeux, mou, flasque ou lourd."
                            }
                        ]
                    },
                    {
