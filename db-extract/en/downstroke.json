                        "sense_id": "5c53f8d9-beea-31e4-897a-8c1f9a339e5e",
                        "entry_id": "93e5e4c3-e583-3bf2-86b9-57f9ffb74535",
                        "glosses": [
                            "A downward stroke, especially one that is part of a sequence of alternating upward and downward strokes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e36bdcef-bc9c-4c0d-87ea-9afda2176396",
                                "sense_id": "5c53f8d9-beea-31e4-897a-8c1f9a339e5e",
                                "text": "It was written, not printed; written in a clear, even hand, with thick downstrokes and thin upstrokes, very large, easier than print, and so beautiful that Lucy stared at it for a whole minute and forgot about reading it."
                            },
                            {
                                "example_id": "19606f4d-580f-4b3a-a982-7724b7b10bb5",
                                "sense_id": "5c53f8d9-beea-31e4-897a-8c1f9a339e5e",
                                "text": "1997, Ted Hughes, Tales from Ovid, London: Faber & Faber, \"Erisychthon,\" lines 41-6, p. 86,\nHe snatches an axe—and hauls / The weight of the broad head up and back. / But in that moment, as the blade hangs / Poised for the first downstroke, shudderings / Swarm through the whole tree, to its outermost twigs / And a groan bursts out of the deep grain."
                            },
                            {
                                "example_id": "8336fc23-b419-488f-9654-ab6ff4e0eaa6",
                                "sense_id": "5c53f8d9-beea-31e4-897a-8c1f9a339e5e",
                                "text": "If you keep typing on the downstroke of the spacebar it lets you, for example, squeeze a four-letter word into the space normally occupied by a three-letter word."
                            }
                        ]
                    }
