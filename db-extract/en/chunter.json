                    },
                    {
                        "translation_id": "98599925-f1d1-4a46-a4d1-afb3936b465c",
                        "source_entry_id": "78f04433-a015-3a8d-8767-f69e6af9adc5",
                        "source_sense_description": "grumble, complain",
                        "target_lang_word": "se plaindre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se plaindre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05b15f61-20ce-31cd-8034-f555ae3de6f4",
                                        "entry_id": "07e82e44-bbbf-30dd-8939-79297d353ed6",
                                        "glosses": [
                                            "Se lamenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8ebc2c6-6a1a-4468-a202-a2d548d34842",
                                                "sense_id": "05b15f61-20ce-31cd-8034-f555ae3de6f4",
                                                "text": "Je me plains à mes vers, si j’ay quelque regret."
                                            },
                                            {
                                                "example_id": "77e92b63-314f-4f9a-8ef4-3a347afdc500",
                                                "sense_id": "05b15f61-20ce-31cd-8034-f555ae3de6f4",
                                                "text": "Nous nous levons à demi habillés, des inconnus autour de nous surgissant du foin, à la vitesse et avec les ennuis d’une résurrection, se plaignant du bras, d’une fluxion, de la jambe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ed100f8-a045-36d4-a690-e2bd6f82b3e1",
                                        "entry_id": "07e82e44-bbbf-30dd-8939-79297d353ed6",
                                        "glosses": [
                                            "Témoigner son mécontentement de quelque chose, du mécontentement contre quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0723cb05-7bbe-4e36-b05e-83a84c3d955e",
                                                "sense_id": "7ed100f8-a045-36d4-a690-e2bd6f82b3e1",
                                                "text": "Les fumeurs du pays et les matelots du port se plaignaient fréquemment de la mauvaise qualité du tabac de régie."
                                            },
                                            {
                                                "example_id": "a24c3fa7-bb0e-4663-b6f9-39ad0e1568e6",
                                                "sense_id": "7ed100f8-a045-36d4-a690-e2bd6f82b3e1",
                                                "text": "En 1582, la ville de Metz envoya une députation au roi pour se plaindre des calvinistes et des juifs."
                                            },
                                            {
                                                "example_id": "d9be7745-1f22-4efa-a582-7e794a179047",
                                                "sense_id": "7ed100f8-a045-36d4-a690-e2bd6f82b3e1",
                                                "text": "Victime de l’hostilité d’Arago en France et de Humboldt en Allemagne, Paravey a la mentalité d’un persécuté. Il se plaint dès 1835 « de sourdes et odieuses manœuvres qui tendent sans cesse à se renouveler. »"
                                            },
                                            {
                                                "example_id": "0b3ef190-cff9-4dc5-8893-c0c109be75bb",
                                                "sense_id": "7ed100f8-a045-36d4-a690-e2bd6f82b3e1",
                                                "text": "[…] ou bien Bleu, ouvrier qualifié, spécialisé dans les lunettes de la marine de guerre qui se plaignait que les ouvriers communistes cherchassent noise aux socialistes à l’atelier, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82ad58d4-3fc6-3559-ae44-917c0b9b8451",
                                        "entry_id": "07e82e44-bbbf-30dd-8939-79297d353ed6",
                                        "glosses": [
                                            "Porter plainte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35071c30-88b1-4276-a8d5-8ad6fc51b0dc",
                                                "sense_id": "82ad58d4-3fc6-3559-ae44-917c0b9b8451",
                                                "text": "Il est allé se plaindre au commissaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30a81f75-9667-3f02-96ce-c139b95b25bd",
                                        "entry_id": "07e82e44-bbbf-30dd-8939-79297d353ed6",
                                        "glosses": [
                                            "Faire entendre un bruit doux et continu, comme une plainte, un gémissement, en parlant d’une chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bac6ef6-8524-4744-9a8d-afabbaa1304f",
                                                "sense_id": "30a81f75-9667-3f02-96ce-c139b95b25bd",
                                                "text": "Pendant que les lames attaquaient mon vaillant navire et que leurs coups sourds faisaient résonner la coque qui vibrait et se plaignait sous les chocs, je restai allongé sur ma couchette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
