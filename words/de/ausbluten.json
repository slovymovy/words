    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f5d3f04-bccf-373a-a1ac-e393ea1de2c3",
                    "sense_definition": "so viel Blut verlieren, dass kein Blut mehr im Körper verbleibt, oder einem Tier nach der Schlachtung das gesamte Blut entziehen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "koerperlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ohne sofortige Hilfe des Notarztes wäre der schwer verletzte Mann auf der Straße fast <w>ausgeblutet</w>."
                        },
                        {
                            "text": "Der Metzger hängte das Tier auf, um es vor der weiteren Verarbeitung vollständig <w>ausbluten</w> zu lassen."
                        }
                    ],
                    "synonyms": [
                        "verbluten"
                    ],
                    "common_phrases": [
                        "jemanden ausbluten lassen",
                        "ein Tier ausbluten lassen"
                    ]
                },
                {
                    "sense_id": "317018db-e05b-3fe5-9054-11a7a4ca3734",
                    "sense_definition": "durch ständige Verluste oder hohe Abgaben seine finanziellen oder materiellen Reserven vollständig verlieren",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wirtschaftlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch die lang anhaltende Krise <w>blutete</w> das kleine Familienunternehmen finanziell allmählich <w>aus</w>."
                        },
                        {
                            "text": "Die hohen Steuern und sinkenden Einnahmen lassen viele Betriebe in der Region wirtschaftlich <w>ausbluten</w>."
                        }
                    ],
                    "synonyms": [
                        "zugrunde gehen"
                    ],
                    "antonyms": [
                        "florieren"
                    ],
                    "common_phrases": [
                        "finanziell ausbluten"
                    ]
                },
                {
                    "sense_id": "cfb79e56-4445-3c48-8440-be3da5037810",
                    "sense_definition": "zu bluten aufhören",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "koerperlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nachdem die tiefe Wunde endlich <w>ausgeblutet</w> hatte, legte die Ärztin einen festen Verband an."
                        },
                        {
                            "text": "Man muss warten, bis der Schnitt am Finger vollständig <w>ausgeblutet</w> ist, bevor man das Pflaster aufklebt."
                        }
                    ],
                    "synonyms": [
                        "versiegen"
                    ]
                }
            ]
        }
    ]
