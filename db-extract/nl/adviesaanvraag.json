                        "examples": [
                            {
                                "example_id": "29923c72-860c-4123-97bb-d5e18dfe566f",
                                "sense_id": "a26fa63c-e521-37cb-ba44-a7acf125bb04",
                                "text": "Er ligt een adviesaanvraag bij de Gezondheidsraad over het combineren van vaccins. Op 2 maart vroeg demissionair minister De Jonge dat advies aan en gisteren schreef hij in zijn kamerbrief dat hij het eind mei verwacht."
                            },
                            {
                                "example_id": "36801137-32e4-48ea-9d1f-b25f8c8d4041",
                                "sense_id": "a26fa63c-e521-37cb-ba44-a7acf125bb04",
                                "text": "Als voorschotje is er wel al een adviesaanvraag bij het OMT gedaan om te kijken wat er gebeurt als het trainen weer opengesteld gaat worden. \"Sport levert natuurlijk veel op: plezier, vitaliteit, samenhang in alle sportverenigingen. Dus we kijken ernaar. Maar de eerlijkheid gebiedt te zeggen dat dat wel in de toekomst ligt. En ik hoop natuurlijk in de nabije toekomst.\""
                            }
                        ]
                    }
