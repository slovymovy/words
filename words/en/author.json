{
    "word_family": [
        "authorship",
        "authorial",
        "authoritative",
        "authority",
        "authorize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c368eaa9-cebf-32aa-9a1c-9dcb93324edc",
                    "sense_definition": "A person who writes books, stories, or articles as a profession.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "writer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous <w>author</w> signed copies of her new novel at the local bookstore.",
                            "target_lang_translations": {
                                "ru": "Знаменитый <w>автор</w> подписывала экземпляры своего нового романа в местном книжном магазине.",
                                "zh": "那位著名的<w>作家</w>在当地书店为她的新小说签名。"
                            }
                        },
                        {
                            "text": "She is a successful <w>author</w> who has written several best-selling mystery books.",
                            "target_lang_translations": {
                                "ru": "Она успешная <w>писательница</w>, написавшая несколько детективных бестселлеров.",
                                "zh": "她是一位成功的<w>作家</w>，写过几本畅销的悬疑小说。"
                            }
                        }
                    ],
                    "synonyms": [
                        "writer"
                    ],
                    "common_phrases": [
                        "famous author",
                        "published author"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который профессионально пишет книги, рассказы или статьи.",
                        "zh": "以写书、故事或文章为职业的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автор",
                                "target_lang_sense_clarification": "литературного произведения"
                            },
                            {
                                "target_lang_word": "писатель",
                                "target_lang_sense_clarification": "профессиональный литератор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作家",
                                "target_lang_sense_clarification": "文学作品的创作者"
                            },
                            {
                                "target_lang_word": "作者",
                                "target_lang_sense_clarification": "泛指文章或书籍的撰写者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc847e51-015c-3c6b-a0df-37aecf2ccb98",
                    "sense_definition": "The originator or creator of any work, such as a piece of music, a software program, or a collaborative project.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "creator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>author</w> of this software code left detailed notes for future developers.",
                            "target_lang_translations": {
                                "ru": "<w>Автор</w> этого программного кода оставил подробные примечания для будущих разработчиков.",
                                "zh": "这段软件代码的<w>作者</w>为未来的开发者留下了详细的注释。"
                            }
                        },
                        {
                            "text": "The copyright of any original writing belongs initially and properly to its <w>author</w>.",
                            "target_lang_translations": {
                                "ru": "Авторское право на любое оригинальное произведение изначально и по праву принадлежит его <w>автору</w>.",
                                "zh": "任何原创作品的版权最初都理应归其<w>作者</w>所有。"
                            }
                        }
                    ],
                    "synonyms": [
                        "creator",
                        "artist"
                    ],
                    "common_phrases": [
                        "original author",
                        "lead author"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создатель любого произведения, например, музыкального сочинения, компьютерной программы или совместного проекта.",
                        "zh": "任何作品的创始者或创造者，例如音乐作品、软件程序或合作项目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автор",
                                "target_lang_sense_clarification": "создатель проекта или кода"
                            },
                            {
                                "target_lang_word": "создатель",
                                "target_lang_sense_clarification": "разработчик или творец"
                            },
                            {
                                "target_lang_word": "разработчик",
                                "target_lang_sense_clarification": "в контексте ПО"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作者",
                                "target_lang_sense_clarification": "项目或代码的创建者"
                            },
                            {
                                "target_lang_word": "开发者",
                                "target_lang_sense_clarification": "软件或系统的设计者"
                            },
                            {
                                "target_lang_word": "创始人",
                                "target_lang_sense_clarification": "项目的发起人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57ee7057-1f85-3e43-9fe8-968584e8c7ab",
                    "sense_definition": "The person or thing that causes something to happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was considered the <w>author</w> of his own misfortune due to his poor decisions.",
                            "target_lang_translations": {
                                "ru": "Его считали <w>виновником</w> собственных несчастий из-за его неверных решений.",
                                "zh": "由于他糟糕的决定，他被认为是自己不幸的<w>始作俑者</w>。"
                            }
                        },
                        {
                            "text": "The detective was determined to find the <w>author</w> of the chaos that erupted in the city.",
                            "target_lang_translations": {
                                "ru": "Детектив был полон решимости найти <w>виновника</w> хаоса, вспыхнувшего в городе.",
                                "zh": "侦探决心找出城中骚乱的<w>始作俑者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "creator"
                    ],
                    "common_phrases": [
                        "author of misfortune",
                        "author of change"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или обстоятельство, являющееся причиной чего-либо.",
                        "zh": "导致某事发生的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виновник",
                                "target_lang_sense_clarification": "причина несчастья или события"
                            },
                            {
                                "target_lang_word": "творец",
                                "target_lang_sense_clarification": "созидатель обстоятельств"
                            },
                            {
                                "target_lang_word": "автор",
                                "target_lang_sense_clarification": "инициатор перемен"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "始作俑者",
                                "target_lang_sense_clarification": "坏事或某种局面的开创者"
                            },
                            {
                                "target_lang_word": "根源",
                                "target_lang_sense_clarification": "导致事件发生的根本原因"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53257577-9e9e-34c9-8138-00fbd72bf27d",
                    "sense_definition": "The legal owner of the copyright to a work, especially in a corporate or work-for-hire context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many corporate contracts, the company is legally considered the <w>author</w> of the work.",
                            "target_lang_translations": {
                                "ru": "Во многих корпоративных контрактах компания по закону считается <w>автором</w> работы.",
                                "zh": "在许多公司合同中，公司在法律上被视为作品的<w>著作权人</w>。"
                            }
                        },
                        {
                            "text": "The <w>author</w> named on the copyright registration for the Android robot is Google Inc.",
                            "target_lang_translations": {
                                "ru": "<w>Автором</w>, указанным в регистрации авторских прав на робота Android, является Google Inc.",
                                "zh": "Android机器人版权注册上注明的<w>著作权人</w>是谷歌公司。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "corporate author"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Законный владелец авторских прав на произведение, особенно в корпоративном контексте.",
                        "zh": "作品版权的合法拥有者，特别是在公司或受雇创作的背景下。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автор",
                                "target_lang_sense_clarification": "субъект авторского права"
                            },
                            {
                                "target_lang_word": "правообладатель",
                                "target_lang_sense_clarification": "владелец прав"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "著作权人",
                                "target_lang_sense_clarification": "法律意义上的版权所有者"
                            },
                            {
                                "target_lang_word": "版权所有者",
                                "target_lang_sense_clarification": "拥有作品法律权利的实体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57c789a6-dfc1-3790-bd3f-c6e444492389",
                    "sense_definition": "The primary participant or mastermind behind a crime or offense.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are still searching for the <w>author</w> of the robbery.",
                            "target_lang_translations": {
                                "ru": "Полиция все еще ищет <w>виновника</w> ограбления.",
                                "zh": "警方仍在搜捕这起抢劫案的<w>主犯</w>。"
                            }
                        },
                        {
                            "text": "Accomplices of a crime shall incur the same punishment as the <w>authors</w> of such an offense.",
                            "target_lang_translations": {
                                "ru": "Соучастники преступления несут такое же наказание, как и <w>исполнители</w> такого правонарушения.",
                                "zh": "犯罪的从犯应与该罪行的<w>主犯</w>受到同等惩罚。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "author of a crime"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal or formal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основной участник или организатор преступления или правонарушения.",
                        "zh": "犯罪或违法行为的主要参与者或策划者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виновник",
                                "target_lang_sense_clarification": "совершивший преступление"
                            },
                            {
                                "target_lang_word": "исполнитель",
                                "target_lang_sense_clarification": "в юридическом смысле"
                            },
                            {
                                "target_lang_word": "автор",
                                "target_lang_sense_clarification": "организатор преступления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主犯",
                                "target_lang_sense_clarification": "犯罪的主要策划或实施者"
                            },
                            {
                                "target_lang_word": "肇事者",
                                "target_lang_sense_clarification": "引起事故或违法行为的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71edf3bb-07e4-3f6a-bef0-f4f8f8c21d07",
                    "sense_definition": "A person who provides information; an informant or source.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>author</w> for this rumor is a reliable person within the administration.",
                            "target_lang_translations": {
                                "ru": "Мой <w>источник</w> этого слуха — надежный человек в администрации.",
                                "zh": "我关于这个传言的<w>消息来源</w>是行政部门内的一位可靠人士。"
                            }
                        },
                        {
                            "text": "As my <w>authors</w> tell me, the ancient customs were quite different from today.",
                            "target_lang_translations": {
                                "ru": "Как сообщают мои <w>источники</w>, древние обычаи сильно отличались от сегодняшних.",
                                "zh": "正如我的<w>消息来源</w>所言，古代的风俗与今天大不相同。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, предоставляющий информацию; информатор или источник.",
                        "zh": "提供信息的人；情报员或消息来源。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "источник",
                                "target_lang_sense_clarification": "лицо, сообщившее сведения"
                            },
                            {
                                "target_lang_word": "информатор",
                                "target_lang_sense_clarification": "сообщающий новости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消息来源",
                                "target_lang_sense_clarification": "提供信息的人或渠道"
                            },
                            {
                                "target_lang_word": "线人",
                                "target_lang_sense_clarification": "提供内部情报的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4bb5219c-3d8d-36ba-b4b0-486e08acb5c0",
                    "sense_definition": "To write or create a work as its originator.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has <w>authored</w> several influential papers on the subject of climate change.",
                            "target_lang_translations": {
                                "ru": "Она <w>написала</w> несколько влиятельных работ на тему изменения климата.",
                                "zh": "她<w>撰写</w>了几篇关于气候变化的有影响力的论文。"
                            }
                        },
                        {
                            "text": "The professor <w>authored</w> a book that is now used in universities worldwide.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>составил</w> книгу, которая сейчас используется в университетах по всему миру.",
                                "zh": "这位教授<w>撰写</w>了一本书，目前在世界各地的大学中使用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "writer"
                    ],
                    "common_phrases": [
                        "authored a book",
                        "authored a report"
                    ],
                    "target_lang_definitions": {
                        "ru": "Писать или создавать произведение в качестве его автора.",
                        "zh": "作为创始者撰写或创作作品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "написать",
                                "target_lang_sense_clarification": "создать текст"
                            },
                            {
                                "target_lang_word": "составить",
                                "target_lang_sense_clarification": "подготовить отчет или документ"
                            },
                            {
                                "target_lang_word": "быть автором",
                                "target_lang_sense_clarification": "являться создателем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撰写",
                                "target_lang_sense_clarification": "正式地书写文章或书籍"
                            },
                            {
                                "target_lang_word": "创作",
                                "target_lang_sense_clarification": "进行文学或艺术创作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}