                                "example_id": "f41a8d69-4921-450a-83a9-b20d42b2624b",
                                "sense_id": "74e21f7b-1b7e-31ab-8036-0322e4e327ff",
                                "text": "Zdegradowanemu oficerowi zerwano epolety."
                            }
                        ],
