                "senses": [
                    {
                        "sense_id": "0f845e48-a61e-3eb0-8e87-6a23f9c56df8",
                        "entry_id": "42daf044-f91c-30f4-aec2-4e9399248a95",
                        "glosses": [
                            "Exprimer l’antonyme de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b60cdf24-fb43-474e-b603-eadcb3f6e0e8",
                                "sense_id": "0f845e48-a61e-3eb0-8e87-6a23f9c56df8",
                                "text": "Et puisqu'on dit \"ils ont réussi à conclure\", on souhaiterait pouvoir antonymiser immédiatement \"ils ont échoué à conclure\"."
                            },
                            {
                                "example_id": "e6cde315-9f3f-48fb-b052-fbdb925c0482",
                                "sense_id": "0f845e48-a61e-3eb0-8e87-6a23f9c56df8",
                                "text": "Terrible Aède, j'avoue que j'aurais pas pu l'antonymiser ma citation..."
                            },
                            {
                                "example_id": "d484ccbd-beca-4df2-b054-da0ca135009e",
                                "sense_id": "0f845e48-a61e-3eb0-8e87-6a23f9c56df8",
                                "text": "安静 ānjìng, calme et silencieux. A rapprocher ou antonymiser de 热闹 rènao, la chaleur d'un endroit animé."
                            }
                        ]
                    }
