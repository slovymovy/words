                "senses": [
                    {
                        "sense_id": "57e7b6ac-cf7c-3fb1-b032-536a397ce216",
                        "entry_id": "6ab8f8aa-deb1-3706-b8aa-cd2dc04b5d11",
                        "glosses": [
                            "Any of certain flowering plants of the genera Lythrum and Lysimachia, which are in different taxonomic families."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "584db5d9-6c09-42ab-a8ef-89688deddc4d",
                                "sense_id": "57e7b6ac-cf7c-3fb1-b032-536a397ce216",
                                "text": "1919, Ronald Firbank, Valmouth, Duckworth, hardback edition, page 91,\nHe had a suit of summer mufti, and a broad-brimmed blue beaver hat looped with leaves broken from the hedgerows in the lanes, and a Leander scarf tucked full of flowers: loosestrife, meadowrue, orchis, ragged-robin."
                            },
                            {
                                "example_id": "8b8fa662-ffad-4e18-8abb-308ac6685362",
                                "sense_id": "57e7b6ac-cf7c-3fb1-b032-536a397ce216",
                                "text": "Most loosestrifes thrive in the northern part of the United States and Canada but only a few make good garden plants for the South."
                            },
                            {
                                "example_id": "5eb0cec4-d82f-427c-9031-c1e2098cea72",
                                "sense_id": "57e7b6ac-cf7c-3fb1-b032-536a397ce216",
                                "text": "2013, Théodore de Saussure, Jane F. Hill (translator), Chemical Research on Plant Growth, [Recherches chimiques sur la Végétation], page 22,\nI grew some peas, loosestrifes, and fleabanes [“inules”] in profound darkness, beneath two identical receptacles filled with atmospheric air."
                            }
                        ]
                    }
