                                        "sense_id": "16972a35-b3df-304c-9ccd-0b6fd2110acd",
                                        "entry_id": "cb25612c-cfbf-3904-8075-aef863c0365e",
                                        "glosses": [
                                            "A call or summons, especially a judicial call, demand, or order."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eeb1580-d619-4d88-9d2b-57bcc037e5cf",
                                                "sense_id": "16972a35-b3df-304c-9ccd-0b6fd2110acd",
                                                "text": "the invocation of papers or evidence into court"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4c0ab82-3e31-371b-a55c-381a5e86ea53",
                                        "entry_id": "cb25612c-cfbf-3904-8075-aef863c0365e",
                                        "glosses": [
                                            "An act of invoking or claiming a legal right."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "729b5845-0d6d-459b-94bd-544c56849573",
                                                "sense_id": "b4c0ab82-3e31-371b-a55c-381a5e86ea53",
                                                "text": "McNeil (D) contended that his courtroom appearance with an attorney for the West Allis crime constituted an invocation of his Miranda right to counsel and that his subsequent waiver during police-initiated questioning regarding the Caledonia crime was invalid."
                                            },
                                            {
                                                "example_id": "3a6405f4-2af6-4d6f-a62e-11e501558c5e",
                                                "sense_id": "b4c0ab82-3e31-371b-a55c-381a5e86ea53",
                                                "text": "As a matter of legal principle, the State should report whether all the necessary conditions for the invocation of the right of self-defense were existent."
                                            },
                                            {
                                                "example_id": "440bf005-b977-435c-bc11-48284fcd7e50",
                                                "sense_id": "b4c0ab82-3e31-371b-a55c-381a5e86ea53",
                                                "text": "This chapter might have been titled “The First 'First Civil Right'”: before Richard Nixon's 1968 invocation of the right to protection from (black) crime, Truman Democrats advocated protection from (white) lawlessness as the first essential right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1b9c1c4-d5e1-3b48-946b-d587f7bdf4ea",
                                        "entry_id": "cb25612c-cfbf-3904-8075-aef863c0365e",
                                        "glosses": [
                                            "The act of invoking, such as a function call."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
