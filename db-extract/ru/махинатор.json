                "senses": [
                    {
                        "sense_id": "040a4ec1-cece-3cc0-9def-c9b90e0a898a",
                        "entry_id": "07a5c4bc-d806-3f35-a7fa-c4661846713b",
                        "glosses": [
                            "разг. тот, кто занимается махинациями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3345f03e-3a5e-4460-a7b5-97eaf432e5f6",
                                "sense_id": "040a4ec1-cece-3cc0-9def-c9b90e0a898a",
                                "text": "Это в НАТО высокопоставленных махинаторов сажают."
                            },
                            {
                                "example_id": "f6dcee20-b756-4b77-ad8d-4b0eddedc0c9",
                                "sense_id": "040a4ec1-cece-3cc0-9def-c9b90e0a898a",
                                "text": "Но если прокурор усмотрел наличие махинации с 10 млн долларов, то не может быть никакого сомнения в том, что махинатор должен быть изолирован, так как, находясь на свободе, он предпримет все меры, чтобы помешать следствию, обелить себя…"
                            }
                        ]
                    }
                ],
