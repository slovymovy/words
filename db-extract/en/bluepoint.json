                                        "entry_id": "1ea1c17f-e44b-3cb9-a891-5dffcb574107",
                                        "glosses": [
                                            "Espèce d’huître américaine, présente sur toute la côte est de l’Amérique du Nord, du Golfe du Mexique jusqu’au Golfe du Saint-Laurent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e8fc07-eb9d-4019-a4f7-e56dcc981622",
                                                "sense_id": "781981f8-5a33-3a28-ab16-4d4461b86f23",
                                                "text": "L’huître commerciale la plus courante sur la côte atlantique de l’Amérique du Nord est la Crassostrea virginica, l’huître de Virginie, connue également sous le nom d’huître américaine."
                                            },
                                            {
                                                "example_id": "ca405cc4-091b-49ec-b642-e9bdcda1b6de",
                                                "sense_id": "781981f8-5a33-3a28-ab16-4d4461b86f23",
                                                "text": "L’huître américaine, également connue sous le nom d’huître de Virginie (Crassostrea virginica), a une aire de répartition naturelle qui s’étend du Canada atlantique au sud du Golfe du Mexique."
                                            },
                                            {
                                                "example_id": "2e5223a5-dacf-47ea-b04c-c6a80f2600e9",
                                                "sense_id": "781981f8-5a33-3a28-ab16-4d4461b86f23",
                                                "text": "L’huître de Virginie, connue scientifiquement sous le nom de Crassostrea virginica, est un réel trésor des zones côtières qu’elle habite."
                                            }
                                        ]
