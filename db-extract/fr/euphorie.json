        "fr-extract.jsonl": [
            {
                "entry_id": "83db3ee5-3462-3d61-a480-1b48ba8d2caf",
                "word": "euphorie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c8417e28-3e3b-4dc6-b821-f2115764244c",
                        "entry_id": "83db3ee5-3462-3d61-a480-1b48ba8d2caf",
                        "tags": [
                            "plural"
                        ],
                        "form": "euphories"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a3ad4bf-5fdf-39dc-b03d-a6638d976e07",
                        "entry_id": "83db3ee5-3462-3d61-a480-1b48ba8d2caf",
                        "glosses": [
                            "Sensation de bien-être, état de confiance de celui qui croit se bien porter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58090e40-50f5-48c7-bbd1-326dd8bce731",
                                "sense_id": "8a3ad4bf-5fdf-39dc-b03d-a6638d976e07",
                                "text": "5 février 1941 – Mais je ne suis pas dupe de cette euphorie du matin. Quand le soleil s’éteint, les projecteurs intérieurs se mettent en route et on ne voit plus que soi. Triste spectacle."
                            },
                            {
                                "example_id": "8893e5e8-fda4-4242-ac67-bc0b0ea8ac78",
                                "sense_id": "8a3ad4bf-5fdf-39dc-b03d-a6638d976e07",
                                "text": "La vérité est que ce soir-là, au bord du fleuve, dans l'euphorie énamourée qui nous collait l'un contre l'autre et nous faisait rejeter la misère, j'avais découvert ce qu'il y a de profondément égoïste dans le bonheur."
                            },
                            {
                                "example_id": "5316c18a-06c4-4bfe-8526-b8d28c85c24b",
                                "sense_id": "8a3ad4bf-5fdf-39dc-b03d-a6638d976e07",
                                "text": "Un délicieux témoignage a été laissé par Théophile Gautier dans sa nouvelle le Club des Haschichins. Le Dʳ Moreau chargeait tellement en shit son dawamesk que le pauvre Gautier, au-delà de l’euphorie, eut parfois des hallucinations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4e62f70-b8ba-440a-80e2-e0e02fd80831",
                        "source_entry_id": "83db3ee5-3462-3d61-a480-1b48ba8d2caf",
                        "source_sense_id": "8a3ad4bf-5fdf-39dc-b03d-a6638d976e07",
                        "target_lang_word": "Euphorie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Euphorie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                        "entry_id": "796f7160-6c59-3e0e-a215-917740857742",
                                        "glosses": [
                                            "ein begeisterter Gemütszustand der Lebensfreude, ein vorübergehendes gesteigertes gutes Lebensgefühl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7815a60-4eb7-4776-b184-a0f7a2e8a5c9",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "Jetzt in Optimismus oder gar Euphorie auszubrechen, wäre falsch, doch vorsichtige Hoffnungen darf man erstmals hegen."
                                            },
                                            {
                                                "example_id": "f6741dc0-2dca-45aa-9260-92b3596ff67c",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "„Ich hätte nicht geglaubt, dass seine Euphorie so lange vorhalten würde.“"
                                            },
                                            {
                                                "example_id": "0638160e-b4f2-4313-b2b7-674cb706c36a",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "„Die europäische Presse versammelte ihre Korrespondenten in London, deren Berichte sich vor wissenschaftlicher Euphorie überschlugen.“"
                                            },
                                            {
                                                "example_id": "dc6653d6-6176-4b8d-8430-b1756ee8a067",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "„Wie war es möglich, daß die gesamte Bevölkerung übergangslos vom Zustand der Katatonie in den der Euphorie kippte?“"
                                            },
                                            {
                                                "example_id": "f5a26361-d6f3-4313-8ab5-cc18c86b16e5",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "„Eine Euphorie stellte sich ein, man kennt sie nach Fastenkuren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebdaed40-1850-31e0-ba4c-2dcb4c5165a2",
                                        "entry_id": "796f7160-6c59-3e0e-a215-917740857742",
                                        "glosses": [
                                            "subjektives Wohlbefinden Schwerkranker"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
