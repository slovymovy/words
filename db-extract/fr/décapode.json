                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "décapodes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d89aaa0e-4fd6-35ac-b65a-c8a33b4582ba",
                        "entry_id": "ee1e29a1-0e86-3987-b55b-1750e8e76995",
                        "glosses": [
                            "Qui a dix pieds ou cinq paires de pattes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a840d10-ec50-4b51-8d0f-7bd4b08e978c",
                                "sense_id": "d89aaa0e-4fd6-35ac-b65a-c8a33b4582ba",
                                "text": "Crustacés décapodes."
                            },
                            {
                                "example_id": "f4a2f84e-2681-434f-bb29-9b6d1cdccbf3",
                                "sense_id": "d89aaa0e-4fd6-35ac-b65a-c8a33b4582ba",
                                "text": "Mollusques décapodes."
                            },
                            {
                                "example_id": "d75f264e-2189-4d18-b77c-7643f490de0b",
                                "sense_id": "d89aaa0e-4fd6-35ac-b65a-c8a33b4582ba",
                                "text": "Le homard, le crabe sont décapodes."
                            },
                            {
                                "example_id": "2cd715b5-4e26-4fc9-804d-06dd30081585",
                                "sense_id": "d89aaa0e-4fd6-35ac-b65a-c8a33b4582ba",
                                "text": "Le Conseil fédéral suisse a tranché : le homard, qui dispose d’un système nerveux complexe, est sensible à la douleur et, du coup, doit être « étourdi avant la mise à mort », ainsi que tous les « décapodes marcheurs » du même acabit : langoustes, langoustines, araignées de mer, tourteaux, bernard-l’ermite…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a1b9426-fdc0-4c0b-8683-51f94ef616a4",
                        "source_entry_id": "ee1e29a1-0e86-3987-b55b-1750e8e76995",
                        "source_sense_id": "d89aaa0e-4fd6-35ac-b65a-c8a33b4582ba",
