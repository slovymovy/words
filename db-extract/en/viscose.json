    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "115a1d7c-e8f4-3e59-82bd-074c4f63778b",
                "word": "viscose",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b001b9d4-9add-464d-9b14-829287ca71dc",
                        "entry_id": "115a1d7c-e8f4-3e59-82bd-074c4f63778b",
                        "tags": [
                            "plural"
                        ],
                        "form": "viscoses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "364b40b4-9022-3f56-8bb6-1f035959a204",
                        "entry_id": "115a1d7c-e8f4-3e59-82bd-074c4f63778b",
                        "glosses": [
                            "A viscous orange-brown liquid obtained by chemical treatment of cellulose and used as the basis of manufacturing rayon and cellulose film."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4612608a-38f7-46f1-8970-00e9598411fc",
                                "sense_id": "364b40b4-9022-3f56-8bb6-1f035959a204",
                                "text": "Near-synonym: rayon (synecdochally synonymous)"
                            }
                        ]
                    },
                    {
                        "sense_id": "90c2350b-46ce-3141-82e7-f29257dfbe61",
                        "entry_id": "115a1d7c-e8f4-3e59-82bd-074c4f63778b",
                        "glosses": [
                            "A fabric made from this material."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "170e2855-0f89-43f9-b1fb-0680789b3b08",
                                "sense_id": "90c2350b-46ce-3141-82e7-f29257dfbe61",
                                "text": "Her mission statement is that clothes made from sustainable viscose and cruelty-free alternatives to leather should not be targeted at a niche market, but shown to hold their own on the Paris fashion week catwalk."
                            },
                            {
                                "example_id": "d164f01c-8c6e-4f25-93aa-3af3a993804f",
                                "sense_id": "90c2350b-46ce-3141-82e7-f29257dfbe61",
                                "text": "Here you are […] in your favourite viscose shirt and palazzo pants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c76f0add-0851-40c8-bb17-1d7f3de07810",
                        "source_entry_id": "115a1d7c-e8f4-3e59-82bd-074c4f63778b",
                        "source_sense_description": "liquid",
                        "target_lang_word": "viskóza",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d8ed9add-348b-4d98-956d-739d899878ea",
                        "source_entry_id": "115a1d7c-e8f4-3e59-82bd-074c4f63778b",
                        "source_sense_description": "liquid",
                        "target_lang_word": "viscose",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viscose",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d086b397-2e92-36b7-99c7-5905a0a9a03b",
                                        "entry_id": "2b03af8c-97a5-3a63-a1d2-09e71776b2c7",
                                        "glosses": [
                                            "een stroperige organische vloeistof die wordt gebruikt bij de productie van rayongarens en cellofaan, natriumzout van cellulosexanthaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14a0d03-969a-4c62-b87d-86ba0eb08407",
                                                "sense_id": "d086b397-2e92-36b7-99c7-5905a0a9a03b",
                                                "text": "Viscose is een stroperige vloeistof die uit bomen wordt gewonnen en gebruikt wordt bij de productie van garens. Jaarlijks zouden zo'n 70 miljoen bomen worden omgehakt voor de productie van viscose."
                                            },
                                            {
                                                "example_id": "5db33196-06ce-45af-b7fd-402282bfcc1d",
                                                "sense_id": "d086b397-2e92-36b7-99c7-5905a0a9a03b",
                                                "text": "Je zal ook zien dat kleuren in verschillende materialen anders overkomen. Een kleur in een platte katoen zal minder mooi overkomen als dezelfde kleur in een wol, zijde, viscose of suède."
                                            },
                                            {
                                                "example_id": "9332f31c-b676-46df-a897-1e98fbea560e",
                                                "sense_id": "d086b397-2e92-36b7-99c7-5905a0a9a03b",
                                                "text": "De keten investeert daarvoor bijvoorbeeld in nieuwe recyclingtechnieken, zoals re:newcell. Katoen, viscose en andere cellulose vezels worden tot een soort - duurzaam - pulp gemalen en hergebruikt als een nieuwe vezel in textielproducties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
