                                "target_senses": [
                                    {
                                        "sense_id": "72b504d2-3df2-3a59-a2b4-e28c14a391db",
                                        "entry_id": "74c02463-cafb-30c3-bc24-55247fc151aa",
                                        "glosses": [
                                            "Geld, mit dem jemand bestochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3908c622-f7d4-4ab0-83c8-26b2caaf3907",
                                                "sense_id": "72b504d2-3df2-3a59-a2b4-e28c14a391db",
                                                "text": "Er musste wegen der Annahme von Schmiergeld von seinem Posten zurücktreten."
                                            },
                                            {
                                                "example_id": "49e5ab24-872f-4651-b7cb-04566d19214c",
                                                "sense_id": "72b504d2-3df2-3a59-a2b4-e28c14a391db",
                                                "text": "„Insgesamt mindestens 150 Millionen Dollar zahlt der CIA über verschwiegene Kanäle als Schmiergeld an Mobutu und seine Entourage.“"
                                            },
                                            {
                                                "example_id": "04fb9c7d-1110-4d68-8538-d24c6443def6",
                                                "sense_id": "72b504d2-3df2-3a59-a2b4-e28c14a391db",
                                                "text": "„Beim Kauf der Eurofighter durch Österreich sollen Schmiergelder geflossen sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6be9253f-18d8-4bb6-adc4-bc41c6b99a0b",
                        "source_entry_id": "dbc1d8bc-e6d6-3286-90d6-4338d37a9077",
                        "source_sense_description": "bribe, secret payment",
                        "target_lang_word": "Bestechungsgeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bestechungsgeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "349e7851-ae46-360d-98a1-4e9ddd1d4e05",
                                        "entry_id": "779a7656-7cdc-396d-bca7-97d5bd1cadbc",
                                        "glosses": [
                                            "finanzielle Zuwendung mit der Absicht, deren Empfänger zu rechtswidrigem Handeln zu bewegen, um daraus einen unlauteren Vorteil zu erlangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f50d605c-f933-4077-b381-b05b3817c9e5",
                                                "sense_id": "349e7851-ae46-360d-98a1-4e9ddd1d4e05",
                                                "text": "„Brasiliens Präsident Temer wird vorgeworfen, rund 130.000 Euro Bestechungsgeld angenommen haben.“"
                                            },
                                            {
                                                "example_id": "23b0950e-1443-48ce-989a-2f3ce979eff0",
                                                "sense_id": "349e7851-ae46-360d-98a1-4e9ddd1d4e05",
                                                "text": "„Die Wahl hatte den neunzehnjährigen Karl Bestechungsgelder in der sagenhaften Höhe von 852000 Goldgulden gekostet.“"
                                            },
                                            {
                                                "example_id": "144e22b8-92f1-4e57-8611-f6d584633127",
                                                "sense_id": "349e7851-ae46-360d-98a1-4e9ddd1d4e05",
                                                "text": "„Gerüchte kursieren über Bestechungsgelder an SS-Angehörige, die angeblich eine »Arisierung« erreichen oder illegale Grenzübertritte organisieren können, hilfsbereite Freunde melden sich mit »glänzenden Verbindungen«, die sich immer wieder als Schimäre erweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b44d71f-d93a-4022-9e93-89740c125849",
                        "source_entry_id": "dbc1d8bc-e6d6-3286-90d6-4338d37a9077",
                        "source_sense_description": "bribe, secret payment",
                        "target_lang_word": "Bakschisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bakschisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46b906c3-8b76-3878-b487-c897da83366d",
                                        "entry_id": "f547fef0-3f9a-354b-907d-b49e17fb4f18",
                                        "glosses": [
                                            "(geringe) Geldsumme, die jemandem gegeben wird, zum Beispiel als Almosen beziehungsweise Trinkgeld, oder auch für eine erwiesene Gefälligkeit"
                                        ],
                                        "tags": [
                                            "zumeist auf den orientalischen Kulturkreis bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03af8af5-b589-4842-9834-6a612f3a0fb4",
                                                "sense_id": "46b906c3-8b76-3878-b487-c897da83366d",
                                                "text": "„Das Wort Bakschisch stammt aus dem Persischen und bedeutet Geschenk. Was jedoch im persischen Mogulreich eine Geste der Dankbarkeit oder eine Gabe an Bettler war, ist im modernen Ägypten eine lästige Pflicht. Ob in einem Restaurant, beim Besuch der Pyramiden, am Flughafen oder auf dem Parkplatz - überall werden Touristen und Einheimische für jeden kleinen Dienst zur Kasse gebeten. Die hilfsbereiten Geister erwarten ständig Trinkgeld, also Bakschisch.“"
                                            },
                                            {
                                                "example_id": "154af34e-2255-477b-9a00-20956a1d7a1f",
                                                "sense_id": "46b906c3-8b76-3878-b487-c897da83366d",
                                                "text": "„Stimmenkauf ist an der Tagesordnung. Nach einer Untersuchung, die Politologen 1999 in einem Elendsviertel von Dhaka durchführten, gaben 17 Prozent der Wähler ihre Stimmer der Partei, die Zigaretten ausgeteilt hatte; 10 Prozent hatten Limonade erhalten, 9 Prozent Bakschisch und 12 Prozent Drohungen.“"
                                            },
                                            {
                                                "example_id": "adc4aba0-b75d-47a0-8a1b-a9f04cf7c273",
                                                "sense_id": "46b906c3-8b76-3878-b487-c897da83366d",
                                                "text": "„Für die schlecht bezahlten Polizisten oder Ärzte heißt das, dass sie vielleicht wieder auf die Unsitte des ‚Bakschisch‘ zurückgreifen werden - die man im Hinblick auf die EU-Bewerbung gerade zu bekämpfen beginnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
