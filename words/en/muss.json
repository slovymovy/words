{
    "word_family": [
        "mussy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06870a52-969a-396d-9b75-956d3e7f7556",
                    "sense_definition": "A state of disorder or confusion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was in a complete <w>muss</w> after the children finished playing.",
                            "target_lang_translations": {
                                "cs": "Pokoj byl po hraní dětí v naprostém <w>nepořádku</w>."
                            }
                        },
                        {
                            "text": "Please clean up this <w>muss</w> before the guests arrive for dinner.",
                            "target_lang_translations": {
                                "cs": "Prosím, ukliď ten <w>nepořádek</w>, než hosté dorazí na večeři."
                            }
                        }
                    ],
                    "synonyms": [
                        "mess",
                        "disorder",
                        "clutter"
                    ],
                    "antonyms": [
                        "order"
                    ],
                    "common_phrases": [
                        "in a muss"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal American English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Stav nepořádku nebo zmatku."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nepořádek",
                                "target_lang_sense_clarification": "obecný stav věcí, které nejsou na svém místě"
                            },
                            {
                                "target_lang_word": "zmatek",
                                "target_lang_sense_clarification": "stav chaosu nebo dezorganizace"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "091f47b4-e930-303c-97e1-585b34294234",
                    "sense_definition": "A chaotic struggle or scramble to grab objects.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd created a <w>muss</w> when the shopkeeper threw coins into the street.",
                            "target_lang_translations": {
                                "cs": "Dav vyvolal <w>strkanici</w>, když obchodník hodil mince do ulice."
                            }
                        },
                        {
                            "text": "They engaged in a wild <w>muss</w> to secure the limited supplies.",
                            "target_lang_translations": {
                                "cs": "Pustili se do divoké <w>rvačky</w>, aby získali omezené zásoby."
                            }
                        }
                    ],
                    "synonyms": [
                        "scramble",
                        "struggle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Chaotická rvačka nebo přetahování o předměty."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strkanice",
                                "target_lang_sense_clarification": "fyzické přetahování nebo tlačení v davu"
                            },
                            {
                                "target_lang_word": "rvačka",
                                "target_lang_sense_clarification": "násilný boj o něco"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15434a37-8223-3529-836c-c6434599a8cf",
                    "sense_definition": "A term of endearment used to address someone affectionately.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She called her little one a sweet <w>muss</w> while tucking him into bed.",
                            "target_lang_translations": {
                                "cs": "Když ho ukládala do postele, něžně ho oslovila."
                            }
                        },
                        {
                            "text": "He whispered a soft <w>muss</w> to his partner before leaving for work.",
                            "target_lang_translations": {
                                "cs": "Před odchodem do práce zašeptal své partnerce něžné oslovení."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or dated usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Oslovení vyjadřující náklonnost k někomu."
                    },
                    "translations": {
                        "cs": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37bf6d11-203b-36de-b5fd-1f34b09568d6",
                    "sense_definition": "To make something untidy or rumpled.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind began to <w>muss</w> her hair as she walked along the beach.",
                            "target_lang_translations": {
                                "cs": "Vítr jí začal <w>rozcuchávat</w> vlasy, když kráčela po pláži."
                            }
                        },
                        {
                            "text": "Do not <w>muss</w> the papers on my desk while you are looking for a pen.",
                            "target_lang_translations": {
                                "cs": "Nezmačkej mi ty papíry na stole, když hledáš propisku."
                            }
                        }
                    ],
                    "synonyms": [
                        "tousle",
                        "rumple",
                        "dishevel"
                    ],
                    "antonyms": [
                        "smooth"
                    ],
                    "common_phrases": [
                        "muss up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in American English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Udělat něco neupraveným nebo zmačkaným."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozcuchat",
                                "target_lang_sense_clarification": "zejména o vlasech"
                            },
                            {
                                "target_lang_word": "rozčepýřit",
                                "target_lang_sense_clarification": "učinit neupraveným, rozcuchaným"
                            },
                            {
                                "target_lang_word": "zmačkat",
                                "target_lang_sense_clarification": "o papírech nebo oblečení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}