                {
                    "sense_id": "9139d615-9ee7-36ed-8b7d-5822477e4436",
                    "sense_definition": "Een onbetrouwbaar, gemeen of verraderlijk persoon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vertrouw hem niet, want hij is een vuile <w>rat</w> die alleen aan zichzelf denkt.",
                            "target_lang_translations": {
                                "en": "Don't trust him, because he is a dirty <w>rat</w> who only thinks of himself.",
                                "ru": "Не доверяй ему, потому что он грязная <w>крыса</w>, которая думает только о себе.",
                                "pl": "Nie ufaj mu, bo to brudny <w>szczur</w>, który myśli tylko o sobie.",
                                "de": "Vertrau ihm nicht, denn er ist eine dreckige <w>Ratte</w>, die nur an sich selbst denkt.",
                                "fr": "Ne lui fais pas confiance, car c'est un sale <w>rat</w> qui ne pense qu'à lui.",
                                "it": "Non fidarti di lui, perché è un <w>infame</w> che pensa solo a se stesso.",
                                "cs": "Nevěř mu, protože je to špinavá <w>krysa</w>, která myslí jen na sebe.",
                                "tr": "Ona güvenme, çünkü o sadece kendini düşünen pis bir <w>hain</w>.",
                                "es": "No confíes en él, porque es una <w>rata</w> sucia que solo piensa en sí mismo.",
                                "zh": "别相信他，他是个只顾自己的卑鄙<w>小人</w>。"
                            }
                        },
                        {
                            "text": "Die <w>rat</w> heeft al onze geheimen aan de concurrentie doorverteld.",
                            "target_lang_translations": {
                                "en": "That <w>rat</w> told all our secrets to the competition.",
                                "ru": "Эта <w>крыса</w> разболтала все наши секреты конкурентам.",
                                "pl": "Ten <w>szczur</w> wygadał wszystkie nasze sekrety konkurencji.",
                                "de": "Diese <w>Ratte</w> hat all unsere Geheimnisse an die Konkurrenz verraten.",
                                "fr": "Ce <w>rat</w> a raconté tous nos secrets à la concurrence.",
                                "it": "Quell'<w>infame</w> ha rivelato tutti i nostri segreti alla concorrenza.",
                                "cs": "Ta <w>krysa</w> vyzradila všechna naše tajemství konkurenci.",
                                "tr": "O <w>alçak</w> tüm sırlarımızı rakiplere anlattı.",
                                "es": "Esa <w>rata</w> le contó todos nuestros secretos a la competencia.",
                                "zh": "那个<w>叛徒</w>把我们所有的秘密都告诉了竞争对手。"
                            }
