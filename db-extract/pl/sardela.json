                        "sense_id": "e0f34a4c-214b-3cb2-af96-785fdcdf9a2b",
                        "entry_id": "c862951b-d721-32ca-b980-d3650359242b",
                        "glosses": [
                            "Engraulis, mała ryba morska żyjąca w ławicach poławiana w celach spożywczych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d074d03-c5b0-4f71-ab83-41f54d25f08c",
                                "sense_id": "e0f34a4c-214b-3cb2-af96-785fdcdf9a2b",
                                "text": "Mnie coś niosło. Na Zlarinie to była sardelada, czyli uroczystość pieczenia sardeli i koniec wojny na Bałkanach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3176dc32-82ff-4eaf-ae0c-cc4ae2cad504",
