                "senses": [
                    {
                        "sense_id": "c189a7c2-6404-3db7-afcb-72725d699bdd",
                        "entry_id": "a28a4d67-912a-3a39-9a36-1c6cd3913173",
                        "glosses": [
                            "wiederverwendbarer Behälter für Milch, meist aus Metall mit Henkel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "947d685b-ec66-4453-946f-21839f6e949b",
                                "sense_id": "c189a7c2-6404-3db7-afcb-72725d699bdd",
                                "text": "Ich habe vom Bauern eine 'Milchkanne' mit frischer Milch bekommen."
                            },
                            {
                                "example_id": "4235ba11-7e8a-42cc-b33c-81b95a149791",
                                "sense_id": "c189a7c2-6404-3db7-afcb-72725d699bdd",
                                "text": "„Ich saß oben auf dem Milchwagen, mitten im Lärm der Milchkannen, und trieb den alten Blesi voran, die Walküre ritt schweigend neben dem Wagen her.“"
                            },
                            {
                                "example_id": "ede1b5a0-ca1f-4903-836f-effc5b918c30",
                                "sense_id": "c189a7c2-6404-3db7-afcb-72725d699bdd",
                                "text": "„Auf der Bank in der Futterküche steht meine Milchkanne mit der Magermilch.“"
                            },
                            {
                                "example_id": "562ad73a-b4cd-4e83-8eac-b78454933d34",
                                "sense_id": "c189a7c2-6404-3db7-afcb-72725d699bdd",
                                "text": "„Darum mache ich mich auf die Suche und finde auch bald den Bauern, der zum Tausch bereit ist – mit dem Versprechen als Dreingabe, eine kleine Milchkanne allabendlich zu füllen.“"
                            },
                            {
                                "example_id": "ed92ce54-61d7-4bb2-8a91-22701f21b783",
                                "sense_id": "c189a7c2-6404-3db7-afcb-72725d699bdd",
                                "text": "übertragen: „‚5G ist nicht an jeder Milchkanne notwendig‘, sagte [Forschungsministerin Anja Karliczek].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
