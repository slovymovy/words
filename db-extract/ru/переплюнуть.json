        "pl-extract.jsonl": [
            {
                "entry_id": "9c10c176-5248-3e33-adae-088ff4238297",
                "word": "переплюнуть",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [
                    {
                        "form_id": "68c2ed71-4834-4a3e-8f2e-4aa6c2d452bf",
                        "entry_id": "9c10c176-5248-3e33-adae-088ff4238297",
                        "tags": [
                            "transliteration"
                        ],
                        "form": "pereplûnutʹ"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad86abb1-2640-32ab-9857-ba2a8d115cbd",
                        "entry_id": "9c10c176-5248-3e33-adae-088ff4238297",
                        "glosses": [
                            "plunąć, splunąć (przez coś, na drugą stronę czegoś)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a680e3d2-67de-4704-aeb5-66f2c1ad92a3",
                                "sense_id": "ad86abb1-2640-32ab-9857-ba2a8d115cbd",
                                "text": "Си́дя на берегу́, он переплю́нул пря́мо на друго́й бе́рег кана́вы.",
                                "translation": "Siedząc na brzegu, splunął prosto na drugi brzeg rowu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1b0d4945-cff5-37a7-ba1e-6881ac360589",
                        "entry_id": "9c10c176-5248-3e33-adae-088ff4238297",
                        "glosses": [
                            "splunąć dalej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6da17987-d299-461f-b4aa-8e696c5ca5fb",
                                "sense_id": "1b0d4945-cff5-37a7-ba1e-6881ac360589",
                                "text": "По́сле шко́лы мальчи́шки устра́ивали соревнова́ние, кто да́льше всех переплю́нет.",
                                "translation": "Po szkole chłopcy urządzali zawody, kto splunie najdalej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6e1a8d5f-acd8-36ff-a618-b631d08ef706",
                        "entry_id": "9c10c176-5248-3e33-adae-088ff4238297",
                        "glosses": [
                            "przebić, prześcignąć"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbab7e0c-62f2-44cd-9e2f-94466fc10be7",
                                "sense_id": "6e1a8d5f-acd8-36ff-a618-b631d08ef706",
                                "text": "Подру́га хоте́ла меня́ удиви́ть пода́рком, но я её переплю́нула.",
                                "translation": "Przyjaciółka chciała mnie zaskoczyć prezentem, ale ja ją przebiłam."
                            },
                            {
                                "example_id": "f445f945-9e73-4bb1-9f27-70ae6bf5e64c",
                                "sense_id": "6e1a8d5f-acd8-36ff-a618-b631d08ef706",
                                "text": "Я сто́лько всего́ повида́л в э́той жизни, что тебе́ меня́ не переплю́нуть ни в о́пыте, ни в упря́мстве.",
                                "translation": "W życiu tyle już widziałem, że nie prześcigniesz mnie ani w doświadczeniu, ani w upartości."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [],
