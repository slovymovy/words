                        "examples": [
                            {
                                "example_id": "0bb798a8-29c5-4c70-b955-cf321e2dc1fc",
                                "sense_id": "f4819b55-0120-3489-8be4-90889db48882",
                                "text": "„Trotz Vorschriften und Repräsentationspflicht muss die Individualität nicht völlig vorbei sein.“"
                            },
                            {
                                "example_id": "fad0a477-3d56-4b47-a5bc-f9cb3253dcf8",
                                "sense_id": "f4819b55-0120-3489-8be4-90889db48882",
                                "text": "„Und ob eine Goldloge mit 5 Plätzen gerade bei diesem umstrittenen Ball wirklich zur Repräsentationspflicht des 3. Natioanlaratspräsidenten gehört, ist zumindest eine Diskussion wert.“"
                            },
                            {
                                "example_id": "aafc15d8-8d26-49ab-a704-ee26c36e68b5",
                                "sense_id": "f4819b55-0120-3489-8be4-90889db48882",
                                "text": "„Im Anschluss daran übernahm die Emden wieder ihre Repräsentationspflichten im ostasiatischen Raum.“"
                            }
                        ],
