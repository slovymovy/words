                ],
                "senses": [
                    {
                        "sense_id": "1c2e8f1e-4980-3929-8f74-64d221f5e121",
                        "entry_id": "7a382b1f-48fe-3a39-b60e-e9b1e46a4f35",
                        "glosses": [
                            "Prozess in einem Hüttenwerk zur Gewinnung von Metall und anderen Rohmaterialien"
                        ],
                        "tags": [
                            "Hüttenwesen",
                            "Metallurgie"
                        ],
                        "examples": [
                            {
                                "example_id": "ed7c30f1-12af-4d9e-bc4b-861f0b86045f",
                                "sense_id": "1c2e8f1e-4980-3929-8f74-64d221f5e121",
                                "text": "Die US-Umweltorganisation »Pure Earth« (vormals Blacksmith Institute) befindet: Bergbau und Verhüttung gehören zu jenen Industrien mit dem größten Verseuchungspotenzial überhaupt."
                            },
                            {
                                "example_id": "689dc6df-8416-4107-88da-7a0afe32ee0b",
                                "sense_id": "1c2e8f1e-4980-3929-8f74-64d221f5e121",
                                "text": "Die Verhüttung des Erzes wurde in einfachen zylindrisch bis konischen schornsteinartigen Schachtöfen aus Lehm vorgenommen, die je nach Bauart auch über einer eingetieften Herd- bzw. Schlackeabflussgrube errichtet wurden."
                            },
                            {
                                "example_id": "f3021a74-922b-4aac-a29e-f5360d447528",
                                "sense_id": "1c2e8f1e-4980-3929-8f74-64d221f5e121",
                                "text": "Voraussetzung für die Herstellung von Bronze waren leistungsfähige Öfen für die Verhüttung und das Schmelzen der Metalle."
                            },
                            {
                                "example_id": "fb3e88b0-151d-4b18-ba9b-53bb5435cf91",
                                "sense_id": "1c2e8f1e-4980-3929-8f74-64d221f5e121",
                                "text": "Bereits in der Antike führte die Verhüttung von Erzen zu lokalen Problemen und Klagen, wie aus vielen Texten überliefert ist."
                            },
                            {
                                "example_id": "476289d1-171a-477d-9eb9-9a0b6a17fa6c",
                                "sense_id": "1c2e8f1e-4980-3929-8f74-64d221f5e121",
                                "text": "Eisen fiel zunächst als Nebenprodukt bei der Verhüttung von Kupfer an, wurde dann aber ab dem 1. Jahrtausend v. Chr. immer bedeutungsvoller."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cb484bd-6f55-4a9d-9fbe-f59a14cd6e7f",
