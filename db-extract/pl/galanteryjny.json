                                        "glosses": [
                                            "einer Dame gegenüber entgegenkommend, liebenswürdig, rücksichtsvoll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18fe2017-d459-496c-8a8f-63eaa4b160a0",
                                                "sense_id": "c0d70699-f42d-3f64-a598-5c81a38c5543",
                                                "text": "Er erwies sich immer als ausgesprochen galant."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1f8d9605-2560-3d64-bc53-9185dc535ee1",
