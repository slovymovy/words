                                        "entry_id": "025b3060-9c1e-3ca9-9b9b-f6697139b6ab",
                                        "glosses": [
                                            "Of, or pertaining to apatheism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0f1d236-d82f-4dfb-9d82-901c44d460ec",
                        "source_entry_id": "8dbd7de8-74f5-3535-a6b3-28412528f495",
                        "source_sense_id": "5fccccde-01bc-3344-9eca-9931abab9b32",
                        "source_sense_description": "umgangssprachlich, scherzhaft: Phlegmatiker; schwer erregbarer, träger Mensch",
                        "target_lang_word": "flegmatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flegmatique",
