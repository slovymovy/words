                "senses": [
                    {
                        "sense_id": "1fc299bd-504d-329b-a50c-310f3c5f26c3",
                        "entry_id": "642ad13b-8780-3af4-99b9-b170a5747192",
                        "glosses": [
                            "Flug über den Atlantischen Ozean"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "811dbd02-d475-4b21-a99c-d431ffbd885d",
                                "sense_id": "1fc299bd-504d-329b-a50c-310f3c5f26c3",
                                "text": "Nach einem Transatlantikflug muss man seine Uhr neu stellen."
                            },
                            {
                                "example_id": "e37635ca-7484-4ca6-8d76-9bfb069e956f",
                                "sense_id": "1fc299bd-504d-329b-a50c-310f3c5f26c3",
                                "text": "„So meinte der damalige British-Airways-Chef Rod Eddington 2003, dass es vielen Firmenchefs nicht mehr möglich sei, 8700 Euro für einen Transatlantikflug zu bezahlen, wenn sie gleichzeitig Jobs streichen müssten.“"
                            },
                            {
                                "example_id": "8a7807ba-65d5-42bc-8baa-a62c7b26b1a1",
                                "sense_id": "1fc299bd-504d-329b-a50c-310f3c5f26c3",
                                "text": "„Es war nicht der einzige Transatlantikflug in die USA, gegen den am Montag anonyme Drohungen ausgesprochen wurden.“"
                            },
                            {
                                "example_id": "0978da6a-e1c5-49d7-882f-87eaa382bf1b",
                                "sense_id": "1fc299bd-504d-329b-a50c-310f3c5f26c3",
                                "text": "„Der Preis eines Tickets für den Transatlantikflug in der Economy-Klasse überstieg zu dieser Zeit den Betrag eines durchschnittlichen Monatsgehalts in der Schweiz bei weitem.“"
                            },
                            {
                                "example_id": "15309bdd-e905-48fc-9125-c3609e6ce40d",
                                "sense_id": "1fc299bd-504d-329b-a50c-310f3c5f26c3",
                                "text": "„Ich buchte einen Transatlantikflug nach Frankfurt am Main.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
