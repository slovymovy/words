                            },
                            {
                                "target_lang_word": "сим",
                                "target_lang_sense_clarification": "устаревший или крайне формальный стиль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b864ed1-63ed-36ff-836c-74bd36667f83",
                    "sense_definition": "Near this place or close by",
