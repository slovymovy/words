                "senses": [
                    {
                        "sense_id": "613a9f85-daae-37f4-a13e-ae4d799f8dea",
                        "entry_id": "16389093-2d8e-355e-9f5b-34875208b529",
                        "glosses": [
                            "spezielle Hochblätter, die einen Blütenstand umgeben, wissenschaftlich Folium involucrale"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2f9c4da-c38a-471d-ae61-3d2c2a9cf4cc",
                                "sense_id": "613a9f85-daae-37f4-a13e-ae4d799f8dea",
                                "text": "Beim Aronstab wird der Kolben von einem tütenförmigen Hüllblatt umschlossen."
                            },
                            {
                                "example_id": "865f9054-3820-415c-bd98-e7f352a172d2",
                                "sense_id": "613a9f85-daae-37f4-a13e-ae4d799f8dea",
                                "text": "Die Neutriebe sind nicht kräftig genug, um aus dem Hüllblatt herauszuwachsen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eaed69b2-c8e4-46bf-b846-fd018fc2a0a3",
                        "source_entry_id": "16389093-2d8e-355e-9f5b-34875208b529",
                        "source_sense_id": "613a9f85-daae-37f4-a13e-ae4d799f8dea",
                        "source_sense_description": "Botanik: spezielle Hochblätter, die einen Blütenstand umgeben, wissenschaftlich Folium involucrale",
                        "target_lang_word": "involucral bract",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9259cf53-9fc0-4265-a7c8-82cf926dd6e1",
                        "source_entry_id": "16389093-2d8e-355e-9f5b-34875208b529",
                        "source_sense_id": "613a9f85-daae-37f4-a13e-ae4d799f8dea",
                        "source_sense_description": "Botanik: spezielle Hochblätter, die einen Blütenstand umgeben, wissenschaftlich Folium involucrale",
                        "target_lang_word": "bractée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bractée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a860d262-f791-3d71-b810-5a40c3d2b54f",
                                        "entry_id": "61122d7e-8e1a-3fe2-b9b8-7849a1d43f6b",
                                        "glosses": [
                                            "Feuille fréquemment colorée qui accompagne une fleur ou une inflorescence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6169c8a-4069-4ece-a2b3-e4056cc5e63b",
                                                "sense_id": "a860d262-f791-3d71-b810-5a40c3d2b54f",
                                                "text": "La nappe est étalée sur un charmant tapis de plantes alpines, parmi lesquelles brille la Paronyque à feuilles de serpolet, dont les larges et minces bractées ressemblent à des écailles d’argent."
                                            },
                                            {
                                                "example_id": "41e7223f-efc1-499c-96e4-5fdd7a4894a0",
                                                "sense_id": "a860d262-f791-3d71-b810-5a40c3d2b54f",
                                                "text": "L’involucre, cette collerette de bractées finement découpées qui entourent l’inflorescence chez certaines espèces, chez les ombellifères en particulier, ne constitue jamais, comme chez la nigelle de Damas, l’attrait principal de la plante."
                                            },
                                            {
                                                "example_id": "939a57e5-4d52-4b9f-b863-7e39d21c12bb",
                                                "sense_id": "a860d262-f791-3d71-b810-5a40c3d2b54f",
                                                "text": "L’Œillet des Chartreux (Dianthus Carthusianorum L.), à racine presque ligneuse; le calicule, formé de nombreuses écailles brunâtres ou rougeâtres, est entouré d’un involucre constitué par deux bractées longuement aristées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80d7953c-b49a-4a0d-a6d2-5c6b81961861",
                        "source_entry_id": "16389093-2d8e-355e-9f5b-34875208b529",
                        "source_sense_id": "613a9f85-daae-37f4-a13e-ae4d799f8dea",
                        "source_sense_description": "Botanik: spezielle Hochblätter, die einen Blütenstand umgeben, wissenschaftlich Folium involucrale",
                        "target_lang_word": "involucre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "involucre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0bde780b-6483-3753-a5c6-f087441aa3c1",
                                        "entry_id": "674736f2-dcbb-390e-893c-d21124956bea",
                                        "glosses": [
                                            "Ensemble de bractées formant une collerette à la base d’une ombelle ou d’un capitule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8da1b88a-a481-42d9-aab5-6b77193e6cdd",
                                                "sense_id": "0bde780b-6483-3753-a5c6-f087441aa3c1",
                                                "text": "Prendre soin d’enlever l’involucre qui risque de moisir, puis stocker les noisettes au frais dans un local aéré à l’abri des rongeurs qui en sont friands."
                                            },
                                            {
                                                "example_id": "290f2fcd-352a-4648-8c56-f15b830dad19",
                                                "sense_id": "0bde780b-6483-3753-a5c6-f087441aa3c1",
                                                "text": "L’involucre, cette collerette de bractées finement découpées qui entourent l’inflorescence chez certaines espèces, chez les ombellifères en particulier, ne constitue jamais, comme chez la nigelle de Damas, l’attrait principal de la plante."
                                            },
                                            {
                                                "example_id": "b39396fe-5052-4816-80ce-95333fd177be",
                                                "sense_id": "0bde780b-6483-3753-a5c6-f087441aa3c1",
                                                "text": "Tous les vendredis de fin d’été, l’entrepreneur, assisté par ses proches, fait sa cueillette à la main et part à l’aube, direction les marchés de la périphérie parisienne, pour vendre ses noisettes fraîches, encore lovées dans leur involucre (la gangue verte qui les protège durant leur développement)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7f93ed7-5517-3f1e-89b8-9987913b8e92",
                                        "entry_id": "674736f2-dcbb-390e-893c-d21124956bea",
                                        "glosses": [
                                            "Ensemble de bractées formant une collerette à la base de certaines fleurs isolées comme les anémones et simulant un calice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9084bafe-0496-4001-adc7-9f4ee743c8ab",
                                                "sense_id": "f7f93ed7-5517-3f1e-89b8-9987913b8e92",
                                                "text": "L’Œillet des Chartreux (Dianthus Carthusianorum L.), à racine presque ligneuse; le calicule, formé de nombreuses écailles brunâtres ou rougeâtres, est entouré d’un involucre constitué par deux bractées longuement aristées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4cc8b51-5e9f-3af1-8a41-3618a8dedce3",
                                        "entry_id": "674736f2-dcbb-390e-893c-d21124956bea",
