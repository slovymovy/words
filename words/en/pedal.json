{
    "word_family": [
        "pedalist",
        "pedaler",
        "pedalling",
        "pedal-board",
        "pedal-steel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16019dea-56bf-3e7c-b291-4fb71137393c",
                    "sense_definition": "A lever operated by the foot to control or power a machine, such as a bicycle, car, or piano.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mechanical_controls",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must push the brake <w>pedal</w> firmly to stop the car quickly.",
                            "target_lang_translations": {
                                "ru": "Вы должны сильно нажать на <w>педаль</w> тормоза, чтобы быстро остановить машину.",
                                "zh": "你必须用力踩下刹车<w>踏板</w>，才能让车迅速停下来。"
                            }
                        },
                        {
                            "text": "The pianist used the sustain <w>pedal</w> to make the notes ring out longer.",
                            "target_lang_translations": {
                                "ru": "Пианист использовал правую <w>педаль</w>, чтобы ноты звучали дольше.",
                                "zh": "钢琴家使用了延音<w>踏板</w>，让音符持续更久。"
                            }
                        }
                    ],
                    "synonyms": [
                        "treadle"
                    ],
                    "common_phrases": [
                        "brake pedal",
                        "gas pedal",
                        "clutch pedal",
                        "piano pedal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рычаг, управляемый ногой для контроля или приведения в действие механизма, например, велосипеда, автомобиля или пианино.",
                        "zh": "用脚操作、用来控制或驱动机器的杠杆或部件，如自行车、汽车或钢琴上的踏板。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "педаль",
                                "target_lang_sense_clarification": "рычаг, нажимаемый ступнёй"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踏板",
                                "target_lang_sense_clarification": "由脚踩压来控制机器的部件，如汽车、自行车、钢琴上的部件"
                            },
                            {
                                "target_lang_word": "脚踏板",
                                "target_lang_sense_clarification": "机械或车辆上用脚操作的杆件，较正式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d30571d7-c52c-3f80-a26a-f21176877009",
                    "sense_definition": "An electronic effects unit used by musicians, typically placed on the floor and activated by the foot.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guitarist bought a new distortion <w>pedal</w> to change his instrument's sound.",
                            "target_lang_translations": {
                                "ru": "Гитарист купил новую <w>педаль</w> дисторшн, чтобы изменить звучание своего инструмента.",
                                "zh": "那位吉他手买了一个新的失真<w>效果器</w>，来改变乐器的音色。"
                            }
                        },
                        {
                            "text": "He has a large guitar <w>pedal</w> board with many different effects.",
                            "target_lang_translations": {
                                "ru": "У него большой <w>педалборд</w> с множеством различных эффектов.",
                                "zh": "他有一块很大的吉他<w>效果器</w>板，上面有许多不同的效果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stompbox",
                        "effects unit"
                    ],
                    "common_phrases": [
                        "guitar pedal",
                        "distortion pedal",
                        "effects pedal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронное устройство эффектов, используемое музыкантами, обычно располагающееся на полу и активируемое ногой.",
                        "zh": "音乐人使用的一种电子效果设备，通常放在地上并用脚启动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "педаль",
                                "target_lang_sense_clarification": "гитарный эффект"
                            },
                            {
                                "target_lang_word": "примочка",
                                "target_lang_sense_clarification": "разговорное название гитарного эффекта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "效果器",
                                "target_lang_sense_clarification": "音乐人脚踩启用的单块效果设备，常见于吉他设备"
                            },
                            {
                                "target_lang_word": "单块效果器",
                                "target_lang_sense_clarification": "尤指放在地上脚踩控制的吉他效果器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ed66ba8-dab6-366e-9446-0c1b5c27da80",
                    "sense_definition": "The set of pipes or the keyboard played with the feet on a pipe organ.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organist played the deep bass notes using the <w>pedal</w> keyboard.",
                            "target_lang_translations": {
                                "ru": "Органист играл глубокие басовые ноты, используя ножную <w>клавиатуру</w>.",
                                "zh": "风琴师用<w>脚键盘</w>弹奏出低沉的低音音符。"
                            }
                        },
                        {
                            "text": "A small organ commonly has only one or two ranks on the <w>pedal</w>.",
                            "target_lang_translations": {
                                "ru": "У маленького органа обычно всего один или два ряда труб в <w>педали</w>.",
                                "zh": "小型管风琴的<w>脚键盘音栓组</w>通常只有一两组音管。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pedalboard"
                    ],
                    "common_phrases": [
                        "organ pedal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор труб или клавиатура органа, на которой играют ногами.",
                        "zh": "管风琴上由脚来演奏的键盘部分，或与之对应的一组音管。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "педаль",
                                "target_lang_sense_clarification": "ножная клавиатура органа"
                            },
                            {
                                "target_lang_word": "педальная клавиатура",
                                "target_lang_sense_clarification": "полное техническое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脚键盘",
                                "target_lang_sense_clarification": "管风琴上用脚演奏的键盘部分"
                            },
                            {
                                "target_lang_word": "管风琴脚键盘",
                                "target_lang_sense_clarification": "较完整的技术说法，指管风琴的脚部键盘系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d88d5d13-2509-30c4-a11a-8bcdaabfab2f",
                    "sense_definition": "A biological structure that is shaped like or functions as a foot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist examined the <w>pedal</w> disc of the sea anemone under the microscope.",
                            "target_lang_translations": {
                                "ru": "Ученый исследовал <w>педальный</w> диск морской анемоны под микроскопом.",
                                "zh": "科学家在显微镜下观察了海葵的<w>足盘</w>。"
                            }
                        },
                        {
                            "text": "Certain mollusks use a <w>pedal</w> muscle to move slowly across the ocean floor.",
                            "target_lang_translations": {
                                "ru": "Некоторые моллюски используют <w>ножную</w> мышцу, чтобы медленно передвигаться по океанскому дну.",
                                "zh": "某些软体动物利用<w>足肌</w>在海底缓慢移动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foot"
                    ],
                    "common_phrases": [
                        "pedal disc"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical/biological context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Биологическая структура, имеющая форму ноги или выполняющая её функции.",
                        "zh": "生物学中形状像脚，或功能相当于脚的结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "педальный",
                                "target_lang_sense_clarification": "относящийся к ноге (в биологии)"
                            },
                            {
                                "target_lang_word": "ножной",
                                "target_lang_sense_clarification": "связанный с конечностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "足部结构",
                                "target_lang_sense_clarification": "生物学中像足或起足部作用的结构，如海葵的足盘"
                            },
                            {
                                "target_lang_word": "足",
                                "target_lang_sense_clarification": "用于具体术语时，如足盘、足肌"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "510b0d2b-f1d6-326f-9202-2634e948f947",
                    "sense_definition": "To ride a bicycle by moving the feet in a circular motion on the pedals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to <w>pedal</w> uphill when the wind is blowing against you.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>крутить педали</w> в гору, когда дует встречный ветер.",
                                "zh": "顶风上坡时很难<w>踩踏板</w>。"
                            }
                        },
                        {
                            "text": "The children like to <w>pedal</w> fast around the park on their bikes.",
                            "target_lang_translations": {
                                "ru": "Детям нравится быстро <w>гонять</w> по парку на своих велосипедах.",
                                "zh": "孩子们喜欢骑着自行车在公园里快速<w>蹬车</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cycle",
                        "bike",
                        "ride"
                    ],
                    "common_phrases": [
                        "pedal fast",
                        "pedal hard",
                        "pedal away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ехать на велосипеде, совершая круговые движения ногами на педалях.",
                        "zh": "骑自行车时用双脚在踏板上做圆周运动前进。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крутить педали",
                                "target_lang_sense_clarification": "наиболее частое выражение"
                            },
                            {
                                "target_lang_word": "педалировать",
                                "target_lang_sense_clarification": "интенсивно нажимать на педали"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踩踏板",
                                "target_lang_sense_clarification": "骑自行车时用脚转动踏板前进"
                            },
                            {
                                "target_lang_word": "蹬车",
                                "target_lang_sense_clarification": "口语中指骑车时用力蹬踏板前进"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04ad4b94-9994-3388-ad90-82a8cd0c1a99",
                    "sense_definition": "To operate any machine or mechanism by using foot levers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "operation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weaver had to <w>pedal</w> the loom for hours to finish the fabric.",
                            "target_lang_translations": {
                                "ru": "Ткачу приходилось часами <w>нажимать на педали</w> станка, чтобы закончить ткань.",
                                "zh": "织工不得不连续几个小时<w>踩动踏板</w>织机，才能完成这块布。"
                            }
                        },
                        {
                            "text": "She learned how to <w>pedal</w> the old sewing machine to control the needle speed.",
                            "target_lang_translations": {
                                "ru": "Она научилась <w>приводить в движение</w> старую швейную машину педалью, чтобы контролировать скорость иглы.",
                                "zh": "她学会了如何<w>踩动踏板</w>那台老式缝纫机，以控制针的速度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "operate",
                        "work"
                    ],
                    "common_phrases": [
                        "pedal a loom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Управлять любой машиной или механизмом с помощью ножных рычагов.",
                        "zh": "通过脚踏杠杆或踏板来操作某种机器或机械装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нажимать на педали",
                                "target_lang_sense_clarification": "приводить в действие механизм"
                            },
                            {
                                "target_lang_word": "работать педалями",
                                "target_lang_sense_clarification": "управлять устройством"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "踩动踏板",
                                "target_lang_sense_clarification": "通过脚踏板来操作机器或装置"
                            },
                            {
                                "target_lang_word": "脚踏操作",
                                "target_lang_sense_clarification": "较一般地指用脚踏装置使机器运转"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7d420752-2a48-3b03-bc0f-cec97ec97a98",
                    "sense_definition": "Relating to or concerning the foot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor checked the <w>pedal</w> pulse to ensure there was good blood flow to the feet.",
                            "target_lang_translations": {
                                "ru": "Врач проверил <w>пульс на стопе</w>, чтобы убедиться в хорошем кровоснабжении ног.",
                                "zh": "医生检查了<w>足部</w>脉搏，以确认脚部血流良好。"
                            }
                        },
                        {
                            "text": "He suffered a <w>pedal</w> injury during the marathon that required medical attention.",
                            "target_lang_translations": {
                                "ru": "Во время марафона он получил <w>травму стопы</w>, потребовавшую медицинской помощи.",
                                "zh": "他在马拉松比赛中受了<w>足部</w>损伤，需要接受治疗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foot"
                    ],
                    "common_phrases": [
                        "pedal pulse",
                        "pedal extremity"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical or formal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к стопе или касающийся её.",
                        "zh": "与足部有关的，或涉及足部的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ножной",
                                "target_lang_sense_clarification": "относящийся к ноге"
                            },
                            {
                                "target_lang_word": "педальный",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "足部的",
                                "target_lang_sense_clarification": "医学或正式语境中，表示与足部有关"
                            },
                            {
                                "target_lang_word": "足的",
                                "target_lang_sense_clarification": "较文雅或书面的说法，表示与脚有关"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}