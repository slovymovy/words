{
    "word_family": [
        "affection",
        "affectionate",
        "affectation",
        "affective",
        "unaffected",
        "disaffected"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ceec99aa-7338-3eb8-9f27-356781d01671",
                    "sense_definition": "To produce a change or influence something or someone.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "influence_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bad weather will likely <w>affect</w> our travel plans for the weekend.",
                            "target_lang_translations": {
                                "ru": "Плохая погода, вероятно, <w>повлияет</w> на наши планы на выходные.",
                                "zh": "恶劣的天气很可能会<w>影响</w>我们周末的旅行计划。"
                            }
                        },
                        {
                            "text": "Smoking can negatively <w>affect</w> your health in the long run.",
                            "target_lang_translations": {
                                "ru": "Курение может негативно <w>сказаться</w> на вашем здоровье в долгосрочной перспективе.",
                                "zh": "从长远来看，吸烟会对你的健康产生负面<w>影响</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "influence",
                        "alter",
                        "change",
                        "have an effect on"
                    ],
                    "common_phrases": [
                        "affect the outcome",
                        "directly affect",
                        "seriously affect",
                        "adversely affect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить изменение или оказывать влияние на что-то или кого-то.",
                        "zh": "对某人或某事产生影响或改变。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "влиять",
                                "target_lang_sense_clarification": "оказывать воздействие, изменять ход чего-либо"
                            },
                            {
                                "target_lang_word": "воздействовать",
                                "target_lang_sense_clarification": "активно влиять, добиваясь результата"
                            },
                            {
                                "target_lang_word": "сказываться",
                                "target_lang_sense_clarification": "иметь последствия, отражаться на чем-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "影响",
                                "target_lang_sense_clarification": "对人或事物产生作用"
                            },
                            {
                                "target_lang_word": "波及",
                                "target_lang_sense_clarification": "影响到其他范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afbde2b3-8ee1-36ce-9913-e706ae3f5623",
                    "sense_definition": "To cause someone to feel strong emotions, such as sadness or sympathy.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was deeply <w>affected</w> by the tragic news she received yesterday.",
                            "target_lang_translations": {
                                "ru": "Она была глубоко <w>тронута</w> трагическими новостями, которые получила вчера.",
                                "zh": "她被昨天收到的悲剧消息深深地<w>触动</w>了。"
                            }
                        },
                        {
                            "text": "The movie's ending seemed to <w>affect</w> everyone in the audience.",
                            "target_lang_translations": {
                                "ru": "Концовка фильма, казалось, <w>задела</w> за живое всех в зале.",
                                "zh": "电影的结局似乎<w>打动</w>了在场的每一位观众。"
                            }
                        }
                    ],
                    "synonyms": [
                        "move",
                        "touch"
                    ],
                    "common_phrases": [
                        "deeply affect",
                        "be affected by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-то испытывать сильные эмоции, такие как грусть или сочувствие.",
                        "zh": "使人产生强烈的感情，如悲伤或同情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трогать",
                                "target_lang_sense_clarification": "вызывать сочувствие или умиление"
                            },
                            {
                                "target_lang_word": "волновать",
                                "target_lang_sense_clarification": "приводить в состояние душевного беспокойства"
                            },
                            {
                                "target_lang_word": "задевать",
                                "target_lang_sense_clarification": "касаться чувств, обижать или волновать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "触动",
                                "target_lang_sense_clarification": "引起内心的情感波动"
                            },
                            {
                                "target_lang_word": "打动",
                                "target_lang_sense_clarification": "使人感动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caf49259-60d1-37eb-bcbe-4b9c0287dfae",
                    "sense_definition": "To attack or cause illness in a part of the body or an organism.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "health_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The virus tends to <w>affect</w> the respiratory system more than other organs.",
                            "target_lang_translations": {
                                "ru": "Вирус, как правило, <w>поражает</w> дыхательную систему больше, чем другие органы.",
                                "zh": "这种病毒比起其他器官，更容易<w>侵袭</w>呼吸系统。"
                            }
                        },
                        {
                            "text": "This specific disease does not usually <w>affect</w> children.",
                            "target_lang_translations": {
                                "ru": "Это конкретное заболевание обычно не <w>поражает</w> детей.",
                                "zh": "这种特定的疾病通常不会<w>感染</w>儿童。"
                            }
                        }
                    ],
                    "synonyms": [
                        "infect",
                        "harm",
                        "attack"
                    ],
                    "common_phrases": [
                        "affect the liver",
                        "affect the brain",
                        "severely affect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Атаковать или вызывать болезнь в части тела или организме.",
                        "zh": "攻击或导致身体某部位或生物体患病。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поражать",
                                "target_lang_sense_clarification": "о болезни: наносить вред органам или системам"
                            },
                            {
                                "target_lang_word": "затрагивать",
                                "target_lang_sense_clarification": "распространяться на определенные области"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "侵袭",
                                "target_lang_sense_clarification": "指疾病或病毒攻击身体"
                            },
                            {
                                "target_lang_word": "感染",
                                "target_lang_sense_clarification": "受病原体影响"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f1feecc-0471-3f2d-828c-dbe37033da1c",
                    "sense_definition": "To pretend to have or feel something; to put on a false appearance to impress others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "feign_pretend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>affect</w> a British accent to sound more sophisticated.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>изображать</w> британский акцент, чтобы звучать более утонченно.",
                                "zh": "他试图<w>装作</w>有英国口音，好让自己听起来更老练。"
                            }
                        },
                        {
                            "text": "She managed to <w>affect</w> indifference even though she was very angry.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>напустить на себя</w> безразличие, хотя она была очень зла.",
                                "zh": "尽管她非常生气，还是设法<w>装作</w>漠不关心的样子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "feign",
                        "fake",
                        "simulate"
                    ],
                    "common_phrases": [
                        "affect an accent",
                        "affect indifference",
                        "affect a pose"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Притворяться, что имеешь или чувствуешь что-то; напускать на себя ложный вид.",
                        "zh": "假装拥有或感受某事；为了给他人留下印象而伪装。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притворяться",
                                "target_lang_sense_clarification": "разыгрывать из себя кого-то, симулировать"
                            },
                            {
                                "target_lang_word": "делать вид",
                                "target_lang_sense_clarification": "создавать ложное впечатление"
                            },
                            {
                                "target_lang_word": "напускать на себя",
                                "target_lang_sense_clarification": "демонстративно принимать какой-либо вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装作",
                                "target_lang_sense_clarification": "假装某种样子"
                            },
                            {
                                "target_lang_word": "伪装",
                                "target_lang_sense_clarification": "掩盖真实情况"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f5f88f8-ad70-34a4-830e-e1206a8e9f02",
                    "sense_definition": "An expressed or observed emotional response or mood.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "psychology_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient displayed a flat <w>affect</w> and showed no reaction to the good news.",
                            "target_lang_translations": {
                                "ru": "Пациент демонстрировал уплощенный <w>аффект</w> и не выказывал никакой реакции на хорошие новости.",
                                "zh": "病人表现出平淡的<w>情感表现</w>，对好消息没有任何反应。"
                            }
                        },
                        {
                            "text": "Psychologists study how positive <w>affect</w> can improve creative problem solving.",
                            "target_lang_translations": {
                                "ru": "Психологи изучают, как положительный <w>аффект</w> может улучшить творческое решение проблем.",
                                "zh": "心理学家研究积极的<w>情感表现</w>如何能改善创造性问题的解决。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flat affect",
                        "positive affect",
                        "negative affect"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical (psychology)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выраженная или наблюдаемая эмоциональная реакция или настроение (психологический термин).",
                        "zh": "一种表现出来或被观察到的情绪反应或心境（心理学术语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аффект",
                                "target_lang_sense_clarification": "внешнее проявление эмоций и чувств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "情感表现",
                                "target_lang_sense_clarification": "心理学中指外在的情绪流露"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}