                {
                    "sense_id": "bc8fcc0f-32ac-3d62-904c-a0d53b34dfe2",
                    "sense_definition": "den Fahrtrichtungsanzeiger an einem Fahrzeug betätigen, um eine Richtungsänderung oder ein Überholmanöver anzukündigen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Du musst rechtzeitig <w>blinken</w>, bevor du an der nächsten Kreuzung abbiegst."
                        },
                        {
                            "text": "Weil der Fahrer vor mir nicht <w>blinkte</w>, konnte ich seine Richtungsänderung nicht vorhersehen."
                        }
                    ],
                    "common_phrases": [
                        "nach links blinken",
                        "vor dem Abbiegen blinken",
                        "rechtzeitig blinken"
                    ]
                },
                {
                    "sense_id": "a94c1bd4-7be9-3014-945d-72630f222555",
                    "sense_definition": "in regelmäßigen, kurzen Abständen aufleuchten oder Lichtsignale aussenden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn die kleine rote Lampe am Gerät dauerhaft <w>blinkt</w>, ist die Batterie fast leer."
                        },
                        {
                            "text": "In der klaren Nacht <w>blinkten</w> unzählige helle Sterne über den Bergen."
                        }
                    ],
                    "synonyms": [
                        "aufleuchten",
                        "funkeln"
                    ],
                    "common_phrases": [
