                        ],
                        "examples": [
                            {
                                "example_id": "6f98ff09-b610-42c9-97ff-22ee615469ea",
                                "sense_id": "5eaf893a-4503-3753-8c4f-162d511bbc0c",
                                "text": "nautical charts"
                            },
                            {
                                "example_id": "66bc4bd5-da0c-4e3e-9cb2-650fc6afea98",
                                "sense_id": "5eaf893a-4503-3753-8c4f-162d511bbc0c",
                                "text": "I was mostly unfamiliar with the nautical terms used in the sailing documentary."
                            },
                            {
                                "example_id": "87768e18-0bcd-4411-ad00-db620ad29a67",
                                "sense_id": "5eaf893a-4503-3753-8c4f-162d511bbc0c",
                                "text": "The mainsail was \"scandalised\" - a nautical mode of describing a sail reefed at both ends[.]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d8f1a1d-93a4-4c7d-89bf-50ea89583ae8",
                        "source_entry_id": "611dc860-efb1-325b-b0e5-6ca5d644d12a",
                        "source_sense_id": "5eaf893a-4503-3753-8c4f-162d511bbc0c",
