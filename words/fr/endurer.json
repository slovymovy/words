            "senses": [
                {
                    "sense_id": "9398e78c-ad15-3e97-b701-10eb196200cb",
                    "sense_definition": "Supporter ou subir avec patience ou résignation une épreuve pénible, une souffrance ou un désagrément.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resister",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blessé a dû <w>endurer</w> une vive souffrance avant l'arrivée des secours d'urgence.temps"
                        },
                        {
                            "text": "Elle refuse d'<w>endurer</w> plus longtemps les remarques désobligeantes de son voisin."
                        }
                    ],
                    "synonyms": [
                        "supporter",
                        "subir",
                        "tolérer"
                    ],
                    "common_phrases": [
