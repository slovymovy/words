                                        "entry_id": "6866750c-e8cb-3660-9f32-d661d58c487c",
                                        "glosses": [
                                            "Bien qu’on fait à quelqu’un, en reconnaissance d’un service ou en faveur d’une bonne action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc5c027a-3418-47af-ad8c-3b0d57f9d268",
                                                "sense_id": "8ea45e1c-8582-3e74-9579-c16d6abf3260",
                                                "text": "Lorsque dans une armée le besoin de récompenses se fait très vivement sentir, on peut affirmer que sa valeur est en baisse."
                                            },
                                            {
                                                "example_id": "14f2bd20-7476-43ee-a72c-0548b60c1933",
                                                "sense_id": "8ea45e1c-8582-3e74-9579-c16d6abf3260",
                                                "text": "Si tu réussis à faire venir Nazira dans mon magasin, seule, sans sa mère, je te donnerai une guinée de récompense."
                                            },
                                            {
                                                "example_id": "6f462c87-2bbf-4804-b42c-31ab20484b6a",
                                                "sense_id": "8ea45e1c-8582-3e74-9579-c16d6abf3260",
                                                "text": "— C’était un méchant homme, il a eu la récompense qu’il méritait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7089396e-5002-369a-ba9b-6aefe245120b",
                                        "entry_id": "6866750c-e8cb-3660-9f32-d661d58c487c",
                                        "glosses": [
                                            "Compensation ou dédommagement."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "092b8484-3c92-426a-8262-cffd92913216",
                                                "sense_id": "7089396e-5002-369a-ba9b-6aefe245120b",
                                                "text": "On lui donna tant pour récompense des pertes qu’il avait faites."
                                            },
                                            {
                                                "example_id": "5117f226-d208-40be-ab1f-9de3d7fa27ae",
                                                "sense_id": "7089396e-5002-369a-ba9b-6aefe245120b",
                                                "text": "Il faut lui accorder quelque récompense pour le dommage qu’il a souffert."
                                            },
                                            {
                                                "example_id": "9a404457-2321-476f-9dbf-f0b69e899483",
                                                "sense_id": "7089396e-5002-369a-ba9b-6aefe245120b",
                                                "text": "Pour récompense, on lui donna une pension."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99f08c0f-cc34-3166-9db2-8e58f606025f",
                                        "entry_id": "6866750c-e8cb-3660-9f32-d661d58c487c",
                                        "glosses": [
                                            "Indemnité ou remploi dû lorsqu’on fait des liquidations de communautés conjugales ou de successions."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd9e8f70-ff3a-4e70-b9ba-67cf6598909a",
                                                "sense_id": "99f08c0f-cc34-3166-9db2-8e58f606025f",
                                                "text": "Récompense due à la communauté par les époux, aux époux par la communauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "854eba0b-9969-3696-b61a-1d635dff4a67",
                                        "entry_id": "6866750c-e8cb-3660-9f32-d661d58c487c",
                                        "glosses": [
                                            "Titre accordé à quelqu’un pour lui rendre hommage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d5572bd-6411-4c8a-88b0-c506ef77404e",
                                                "sense_id": "854eba0b-9969-3696-b61a-1d635dff4a67",
                                                "text": "Tournées internationales, récompenses, starisation… la jeune fille vit un rêve"
                                            }
                                        ]
                                    }
                                ]
