                            },
                            {
                                "example_id": "a20385fd-1b23-45d0-8510-42d5868340fd",
                                "sense_id": "fb166269-f52d-391a-928a-3fd43ac861e3",
                                "text": "Najdłuższy zachowany kołtun znajduje się w muzeum w Krakowie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1c66ddb9-4569-30e8-8dcd-dcce1bf09a63",
                        "entry_id": "a35938df-9be5-31a8-a39f-c433ca15557c",
                        "glosses": [
                            "potargane i brudne włosy"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0afc1fbb-5518-4c41-82c7-e0f319e5b692",
                                "sense_id": "1c66ddb9-4569-30e8-8dcd-dcce1bf09a63",
                                "text": "Jak ty wyglądasz?! Umaluj się chociaż i zrób coś z tym kołtunem na głowie!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8837da50-8980-46a4-af5b-540efdbf6ab8",
                        "source_entry_id": "a35938df-9be5-31a8-a39f-c433ca15557c",
                        "source_sense_id": "fb166269-f52d-391a-928a-3fd43ac861e3",
                        "target_lang_word": "elflock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elflock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c62fa38-45df-3391-b368-463ee559d833",
                                        "entry_id": "a7a75bcf-977c-3b00-b59e-af66dd1ca9f5",
                                        "glosses": [
                                            "A lock of hair that is tangled."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e586862-4621-41a4-ac37-bc1dc31996af",
                                                "sense_id": "3c62fa38-45df-3391-b368-463ee559d833",
                                                "text": "[T]heir wide Farthingales extreamly fill the Coach, an one would take their thick and knotty Elflocks for Hempen ſtuffing, broke out of an old pack-ſaddle."
                                            },
                                            {
                                                "example_id": "a1d6fdc1-4fb3-4782-8939-1563df997ea6",
                                                "sense_id": "3c62fa38-45df-3391-b368-463ee559d833",
                                                "text": "Never was even washerwoman more untidy. A cap all rags, from which the hair came straggling in elf-locks over a face which generally looked red-hot […]"
                                            },
                                            {
                                                "example_id": "1c8120e6-fcb4-4630-bf39-3242b0661bfa",
                                                "sense_id": "3c62fa38-45df-3391-b368-463ee559d833",
                                                "text": "All went unshaven, and many had long, filthy elf-locks hanging about their faces, and ragged beards reaching to their girdles."
                                            },
                                            {
                                                "example_id": "80551814-0e1a-46d4-a127-7031bd959035",
                                                "sense_id": "3c62fa38-45df-3391-b368-463ee559d833",
                                                "text": "The face which emerged was not reassuring.[…]. He was not a mongol but there was a deficiency of a sort there, and it was not made more pretty by a latter-day hair cut which involved eccentrically long elf-locks and oiled black curls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e04a173-9b8f-4f4f-9a89-cc8b7e38a962",
                        "source_entry_id": "a35938df-9be5-31a8-a39f-c433ca15557c",
                        "source_sense_id": "fb166269-f52d-391a-928a-3fd43ac861e3",
                        "target_lang_word": "Weichselzopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weichselzopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4985078-aef0-3cf3-8302-999a8924f1dc",
                                        "entry_id": "ed38e472-44f1-381d-9bb1-76c9775a47be",
                                        "glosses": [
                                            "Verfilzung der Haare aufgrund von Hautkrankheiten und mangelnder Hygiene im Mittelalter und noch bis ins 16. Jahrhundert in Deutschland, im 19. Jahrhundert noch in den Donauländern und in Polen (daher engl. „Polish plait“ und lat. „Plica polonica“)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92557d3f-e14e-4b02-b0b1-a7f9214ce620",
                                                "sense_id": "b4985078-aef0-3cf3-8302-999a8924f1dc",
                                                "text": "„Der Bauer ist von gutem Körperbau, starkstämmig, soldatischen Ansehens, und hat gewöhnlich blondes Haar; die meisten lassen dasselbe lang herunterwallen. Dadurch haben so viele Bauern die Plica polonica (Weichselzopf), eine sehr anmutige Krankheit, womit auch wir hoffentlich einst gesegnet werden, wenn das Lange-Haartum in den deutschen Gauen allgemeiner wird.“"
                                            },
                                            {
                                                "example_id": "a4022c32-e8e1-4ef9-b777-c7baef481a9a",
                                                "sense_id": "b4985078-aef0-3cf3-8302-999a8924f1dc",
                                                "text": "„Darein schenkte er von dem Rosoglio und klagte, zwölf solche grüne Römer habe er hierher mitgebracht, abgesehen von eigenen Likörgläschen, überhaupt schönes Tafelgeschirr und Besteck aller Art, Tischzeug und Gerät, wie es sich gehört, aber seine Schwester, die Hex, habe alles mit Fleiß zerbrochen und vertan und sein ganzes Gut drunter und drüber gebracht, daß es hoffnungslos verdorben und ineinandergewachsen sei, wie ein Weichselzopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "e6565785-5c0e-494f-830e-1c69e9cc76bb",
