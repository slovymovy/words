                "senses": [
                    {
                        "sense_id": "8cd9d2ac-31df-3675-9c72-3652cfa7bfd1",
                        "entry_id": "cad16b80-489b-32c8-9124-84df9de3dd49",
                        "glosses": [
                            "schnarrender, kehliger Tierlaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30958425-352b-44cd-b8ab-8b2e977b8a2b",
                                "sense_id": "8cd9d2ac-31df-3675-9c72-3652cfa7bfd1",
                                "text": "Schweine geben oft Grunzlaute von sich."
                            },
                            {
                                "example_id": "f4b9ec9d-89ad-421d-9587-b99f2eb54aa6",
                                "sense_id": "8cd9d2ac-31df-3675-9c72-3652cfa7bfd1",
                                "text": "„Andere Männchen und Weibchen demonstrieren diesem Alphamännchen ihre Unterwürfigkeit, indem sie sich vor ihm ducken und dabei Grunzlaute ausstoßen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e27a31bd-d53d-384b-9f8d-3daa8e2e37fe",
                        "entry_id": "cad16b80-489b-32c8-9124-84df9de3dd49",
                        "glosses": [
                            "menschlicher Rachenlaut, der als unartikuliert empfunden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb3f6b6a-6aba-4acc-9dbe-e1523a0a4ee5",
                                "sense_id": "e27a31bd-d53d-384b-9f8d-3daa8e2e37fe",
                                "text": "„Das Vokabular der Feuerländer war so klein und ihre in Grunzlauten versunkene Grammatik so simpel und einfältig, dass dieses menschliche Unterscheidungsmerkmal aus Darwins Blickwinkel kaum noch als solches gelten konnte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
