                "senses": [
                    {
                        "sense_id": "077dee10-5064-3532-b4ab-8b28d3a737a2",
                        "entry_id": "aef309f4-7c58-33e6-a905-0ee6e5beff80",
                        "glosses": [
                            "o zapachu (najczęściej perfum): składający się z połączenia zapachów cytrusowych, kwiatowych oraz animalistycznych i paczuli czy mchu dębowego kolejno jako nuty głowy, serca i bazy"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "ab192680-f1d6-4bbc-8634-8bfe0f437e50",
                                "sense_id": "077dee10-5064-3532-b4ab-8b28d3a737a2",
                                "text": "Gdybym nie poznała szyprów, byłby to dla mnie pewnie signature scent, ale szyprowa zadziorność zrobiła swoje"
                            },
                            {
                                "example_id": "ef987b14-066b-401e-b145-a2a33b3bacce",
                                "sense_id": "077dee10-5064-3532-b4ab-8b28d3a737a2",
                                "text": "A jednak nuta szyprowa w Izia La Nuit to nie tylko cierń przeszywający miękkie ciało, to nie tylko ciemność ostro kontrastująca z jaśniejącym światłem - nie, ten zapach przypomina mi właśnie tę bardzo ciemną, drzewną, mszystą, zimną i gorzką nutę, która była tak charakterystyczna dla kobiecych perfum szyprowych z przeszłości"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
