                        "glosses": [
                            "то же, что царствование; правление какого-либо царя, какой-либо царицы"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "408cd651-1073-3bf0-911b-0f6cdb79f3a4",
