                                "sense_id": "af07fcad-84c9-3910-a0dc-1643dc6c3ca9",
                                "text": "In putje winter wordt zonnen op het strand afgeraden.",
                                "translation": "Tanning on the beach is discouraged in the midst of winter.",
                                "english": "Tanning on the beach is discouraged in the midst of winter."
                            },
                            {
                                "example_id": "7d185179-72bf-4ca5-834b-010b05661359",
                                "sense_id": "af07fcad-84c9-3910-a0dc-1643dc6c3ca9",
                                "text": "Putje zomer staat er dikwijls een ijsverkoper op het plein.",
                                "translation": "There is often an ice-cream seller at the square in the heart of summer.",
                                "english": "There is often an ice-cream seller at the square in the heart of summer."
                            },
                            {
                                "example_id": "ab917bf3-caf4-47ff-a3c9-b67184483c01",
                                "sense_id": "af07fcad-84c9-3910-a0dc-1643dc6c3ca9",
                                "text": "Newaar, we weten wat ervan is honger en koude te moeten afbijten; gaan we nu de anderen, als 't in putje van den winter is, ook op straat smijten met een leêgen buik?"
                            }
                        ]
