{
    "word_family": [
        "array"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88cdd0b6-252d-397a-8ca8-13a87b45355b",
                    "sense_definition": "A state of confusion or lack of organization.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden resignation of the manager left the entire department in complete <w>disarray</w>.",
                            "target_lang_translations": {
                                "nl": "Het plotselinge aftreden van de manager liet de hele afdeling in complete <w>wanorde</w> achter."
                            }
                        },
                        {
                            "text": "After the storm, the living room was in total <w>disarray</w> with furniture scattered everywhere.",
                            "target_lang_translations": {
                                "nl": "Na de storm was de woonkamer een totale <w>chaos</w>, met meubels overal verspreid."
                            }
                        }
                    ],
                    "synonyms": [
                        "chaos",
                        "disorder",
                        "confusion"
                    ],
                    "common_phrases": [
                        "in complete disarray",
                        "in total disarray"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een toestand van verwarring of gebrek aan orde en organisatie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wanorde",
                                "target_lang_sense_clarification": "toestand van totale chaos of gebrek aan regelmaat"
                            },
                            {
                                "target_lang_word": "verwarring",
                                "target_lang_sense_clarification": "gebrek aan overzicht of duidelijkheid"
                            },
                            {
                                "target_lang_word": "ontreddering",
                                "target_lang_sense_clarification": "toestand van stuurloosheid of wanorde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffc98569-906e-372a-8145-452243465531",
                    "sense_definition": "A state of being untidily or improperly dressed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She appeared at the door in a state of <w>disarray</w>, her hair uncombed and her clothes wrinkled.",
                            "target_lang_translations": {
                                "nl": "Ze verscheen aan de deur in een staat van <w>verwaarlozing</w>, met ongekamd haar en gekreukte kleren."
                            }
                        },
                        {
                            "text": "The actor was caught in a state of <w>disarray</w> while rushing to get ready for the stage.",
                            "target_lang_translations": {
                                "nl": "De acteur werd in <w>ontredderde toestand</w> aangetroffen terwijl hij zich haastte om klaar te zijn voor het toneel."
                            }
                        }
                    ],
                    "synonyms": [
                        "dishabille"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een toestand waarin kleding slordig, ongepast of overhoop zit."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verwaarloosde toestand",
                                "target_lang_sense_clarification": "slordige uiterlijke staat"
                            },
                            {
                                "target_lang_word": "ontredderde staat",
                                "target_lang_sense_clarification": "verwarde of ongeordende kleding en uiterlijk"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b348f5cc-f931-36e8-8644-b9f8bedba034",
                    "sense_definition": "To cause something to become disorganized or confused.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected news served to <w>disarray</w> the team's carefully planned strategy.",
                            "target_lang_translations": {
                                "nl": "Het onverwachte nieuws diende om de zorgvuldig geplande strategie van het team te <w>verstoren</w>."
                            }
                        },
                        {
                            "text": "Heavy rain began to <w>disarray</w> the orderly lines of the marching band.",
                            "target_lang_translations": {
                                "nl": "Hevige regen begon de ordelijke rijen van de fanfare te <w>ontregelen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disorganize",
                        "disrupt"
                    ],
                    "target_lang_definitions": {
                        "nl": "Ervoor zorgen dat iets ongeorganiseerd of verward raakt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verstoren",
                                "target_lang_sense_clarification": "de orde of rust verbreken"
                            },
                            {
                                "target_lang_word": "verwarren",
                                "target_lang_sense_clarification": "in de war brengen of ontregelen"
                            },
                            {
                                "target_lang_word": "ontregelen",
                                "target_lang_sense_clarification": "de regelmaat of structuur verbreken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4be9e109-eada-30bc-897e-53f98494bde2",
                    "sense_definition": "To remove someone's clothing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old text described how the character would <w>disarray</w> herself before retiring for the night.",
                            "target_lang_translations": {
                                "nl": "De oude tekst beschreef hoe het personage zich zou <w>ontkleden</w> voordat ze ging slapen."
                            }
                        },
                        {
                            "text": "It is archaic to use the verb to <w>disarray</w> when referring to taking off clothes.",
                            "target_lang_translations": {
                                "nl": "Het is archaïsch om het werkwoord 'to disarray' te gebruiken als men doelt op <w>uitkleden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "undress"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is no longer common in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemands kleding uittrekken (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitkleden",
                                "target_lang_sense_clarification": "van kleding ontdoen"
                            },
                            {
                                "target_lang_word": "ontkleden",
                                "target_lang_sense_clarification": "formeel of literair voor uitkleden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}