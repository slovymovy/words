                "senses": [
                    {
                        "sense_id": "4a5032c5-ab91-37d2-acd7-86a9fdb43627",
                        "entry_id": "b6af7354-6304-35ca-9996-79e9571b32ab",
                        "glosses": [
                            "Person, die nicht Anhänger des Islams ist"
                        ],
                        "tags": [
                            "Islam"
                        ],
                        "examples": [
                            {
                                "example_id": "4efc7fae-0e3d-4707-9b23-afdb11f3e296",
                                "sense_id": "4a5032c5-ab91-37d2-acd7-86a9fdb43627",
                                "text": "Die Scharia kennt keine Sonderstellung für Nichtmuslime, außer es sind Abrahamiten."
                            },
                            {
                                "example_id": "656f96c0-7c61-4869-9cfb-b2ffe1a9f592",
                                "sense_id": "4a5032c5-ab91-37d2-acd7-86a9fdb43627",
                                "text": "Zu den Nichtmuslimen gehören Atheisten, Buddhisten, Juden, Christen und Hindus."
                            },
                            {
                                "example_id": "72dc9104-28e3-4092-8145-4195e4eceffd",
                                "sense_id": "4a5032c5-ab91-37d2-acd7-86a9fdb43627",
                                "text": "„Kaum ein Nichtmuslim kann sich vorstellen, wie Bankgeschäfte unter diesen Einschränkungen funktionieren sollen.“"
                            },
                            {
                                "example_id": "243cfaff-6da8-45f0-9df5-ef2faf0c8d6b",
                                "sense_id": "4a5032c5-ab91-37d2-acd7-86a9fdb43627",
                                "text": "„Fatwa Nr. 6 schreibt den Frauen das Kopftuch vor, Fatwa Nr. 17 verbietet strikt die Heirat einer Muslimin mit einem Nichtmuslim, Fatwa Nr. 38 verbietet den Mädchen das Velofahren, falls das Risiko dabei gross ist, dass das Jungfernhäutchen reisst.“"
                            },
                            {
                                "example_id": "1355f5b0-4532-4b8c-9ba5-70155610bed2",
                                "sense_id": "4a5032c5-ab91-37d2-acd7-86a9fdb43627",
                                "text": "„Da alle anderen islamischen Glaubensrichtungen allein Muhammad als Propheten anerkennen, erklärte der pakistanische Staat die Ahmadis zu abtrünnigen Muslimen und schließlich 1974 per Gesetz zu Nichtmuslimen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
