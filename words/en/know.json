{
    "word_family": [
        "knowledge",
        "knowable",
        "knowing",
        "knowingly",
        "unknown",
        "well-known",
        "foreknow"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f8b1068-9fa5-3251-9dc3-a3b12411a77d",
                    "sense_definition": "To perceive the truth or factuality of something; to be certain that a statement or fact is correct.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>know</w> that I am right and you are wrong about this matter.",
                            "target_lang_translations": {
                                "ru": "Я <w>знаю</w>, что я прав, а ты ошибаешься в этом вопросе."
                            }
                        },
                        {
                            "text": "He <w>knew</w> something terrible was going to happen before it actually did.",
                            "target_lang_translations": {
                                "ru": "Он <w>знал</w>, что случится что-то ужасное, еще до того, как это произошло."
                            }
                        }
                    ],
                    "synonyms": [
                        "sleep with",
                        "go to bed with"
                    ],
                    "antonyms": [
                        "doubt"
                    ],
                    "common_phrases": [
                        "know for sure",
                        "know the truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осознавать истинность или фактичность чего-либо; быть уверенным в правильности утверждения или факта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знать",
                                "target_lang_sense_clarification": "быть уверенным в чем-либо"
                            },
                            {
                                "target_lang_word": "ведать",
                                "target_lang_sense_clarification": "книжн., иметь сведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cad5c32-d956-3a65-90ca-9cf47439e0a8",
                    "sense_definition": "To be aware of a specific piece of information or a situation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "awareness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>knows</w> where I live because she visited my house last week.",
                            "target_lang_translations": {
                                "ru": "Она <w>знает</w>, где я живу, потому что заходила ко мне на прошлой неделе."
                            }
                        },
                        {
                            "text": "No one <w>knows</w> if water is flowing on the surface of that distant planet.",
                            "target_lang_translations": {
                                "ru": "Никто не <w>знает</w>, течет ли вода по поверхности той далекой планеты."
                            }
                        }
                    ],
                    "antonyms": [
                        "ignore"
                    ],
                    "common_phrases": [
                        "know the way",
                        "know the answer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладать информацией о конкретном факте или ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знать",
                                "target_lang_sense_clarification": "обладать информацией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c41468aa-df28-3373-ad60-216e497bc354",
                    "sense_definition": "To be acquainted or familiar with a person, place, or thing through previous encounter.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "acquaintance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>know</w> your mother well, but I have never met your father.",
                            "target_lang_translations": {
                                "ru": "Я хорошо <w>знаю</w> твою маму, но никогда не встречал твоего отца."
                            }
                        },
                        {
                            "text": "Do you <w>know</w> Marsha from the office? She is very nice.",
                            "target_lang_translations": {
                                "ru": "Ты <w>знаешь</w> Маршу из офиса? Она очень милая."
                            }
                        }
                    ],
                    "synonyms": [
                        "copulate with"
                    ],
                    "common_phrases": [
                        "know someone well",
                        "know by name"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть знакомым с человеком, местом или вещью благодаря предыдущим встречам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знать",
                                "target_lang_sense_clarification": "быть знакомым с кем-либо"
                            },
                            {
                                "target_lang_word": "быть знакомым",
                                "target_lang_sense_clarification": "иметь личное знакомство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "752e2e79-74b4-3485-a309-a53886eade53",
                    "sense_definition": "To understand or have a grasp of a skill, language, or subject through experience or study.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>knows</w> how to swim very well and practices every morning.",
                            "target_lang_translations": {
                                "ru": "Она <w>умеет</w> очень хорошо плавать и тренируется каждое утро."
                            }
                        },
                        {
                            "text": "His mother tongue is Italian, but he also <w>knows</w> French and English.",
                            "target_lang_translations": {
                                "ru": "Его родной язык — итальянский, но он также <w>знает</w> французский и английский."
                            }
                        }
                    ],
                    "synonyms": [
                        "coitize"
                    ],
                    "common_phrases": [
                        "know how to",
                        "know a language"
                    ],
                    "target_lang_definitions": {
                        "ru": "Понимать или владеть навыком, языком или предметом в результате обучения или практики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знать",
                                "target_lang_sense_clarification": "владеть предметом или языком"
                            },
                            {
                                "target_lang_word": "уметь",
                                "target_lang_sense_clarification": "обладать навыком"
                            },
                            {
                                "target_lang_word": "владеть",
                                "target_lang_sense_clarification": "свободно использовать навык"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "134d3ece-32cc-385c-ae1d-43e9f1d5f27c",
                    "sense_definition": "To have information or be informed about a particular topic or event.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "awareness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>knew</w> of our plan to throw a surprise party for him.",
                            "target_lang_translations": {
                                "ru": "Она <w>знала</w> о нашем плане устроить для него вечеринку-сюрприз."
                            }
                        },
                        {
                            "text": "He <w>knows</w> about nineteenth century politics better than most historians.",
                            "target_lang_translations": {
                                "ru": "Он <w>знает</w> политику девятнадцатого века лучше большинства историков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "know about",
                        "know of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь сведения или быть информированным об определенной теме или событии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знать",
                                "target_lang_sense_clarification": "быть осведомленным"
                            },
                            {
                                "target_lang_word": "слышать",
                                "target_lang_sense_clarification": "иметь общее представление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab6c1c37-c35b-3ef0-a068-e41512876533",
                    "sense_definition": "To be able to distinguish or recognize the nature of something, often by contrast.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important for children to <w>know</w> right from wrong at an early age.",
                            "target_lang_translations": {
                                "ru": "Детям важно в раннем возрасте <w>отличать</w> хорошее от плохого."
                            }
                        },
                        {
                            "text": "The soldiers did not <w>know</w> friend from foe in the dark of the night.",
                            "target_lang_translations": {
                                "ru": "Солдаты не могли <w>отличить</w> своих от врагов в ночной темноте."
                            }
                        }
                    ],
                    "synonyms": [
                        "sleep with"
                    ],
                    "antonyms": [
                        "confuse"
                    ],
                    "common_phrases": [
                        "know right from wrong",
                        "know the difference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть способным отличить или распознать природу чего-либо, часто на контрасте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отличать",
                                "target_lang_sense_clarification": "видеть разницу"
                            },
                            {
                                "target_lang_word": "различать",
                                "target_lang_sense_clarification": "распознавать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2408e289-ad0e-370b-8714-674cd92cf8eb",
                    "sense_definition": "To be able to play or perform a specific piece of music or a song.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you <w>know</w> any songs by the Beatles that we can sing together?",
                            "target_lang_translations": {
                                "ru": "Ты <w>знаешь</w> какие-нибудь песни Битлз, которые мы могли бы спеть вместе?"
                            }
                        },
                        {
                            "text": "The pianist <w>knew</w> the entire concerto by heart and did not need sheet music.",
                            "target_lang_translations": {
                                "ru": "Пианист <w>знал</w> весь концерт наизусть, и ему не нужны были ноты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "know a song",
                        "know by heart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть способным исполнить определенное музыкальное произведение или песню."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знать",
                                "target_lang_sense_clarification": "помнить мелодию или текст"
                            },
                            {
                                "target_lang_word": "помнить",
                                "target_lang_sense_clarification": "воспроизводить по памяти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "014d3aba-79ee-377c-96b7-f22f5a07223f",
                    "sense_definition": "To recognize someone or something as being the same as previously encountered after a period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acquaintance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has changed so much that you would hardly <w>know</w> him now.",
                            "target_lang_translations": {
                                "ru": "Он так сильно изменился, что ты бы его сейчас едва <w>узнал</w>."
                            }
                        },
                        {
                            "text": "I <w>knew</w> the old house immediately despite the new coat of paint.",
                            "target_lang_translations": {
                                "ru": "Я сразу <w>узнал</w> старый дом, несмотря на новый слой краски."
                            }
                        }
                    ],
                    "synonyms": [
                        "coitize"
                    ],
                    "common_phrases": [
                        "hardly know someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узнать кого-либо или что-либо при повторной встрече спустя время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узнавать",
                                "target_lang_sense_clarification": "идентифицировать знакомое"
                            },
                            {
                                "target_lang_word": "признавать",
                                "target_lang_sense_clarification": "опознавать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e897d9b6-e32d-312a-a137-427859a59f0e",
                    "sense_definition": "To experience or go through certain conditions or events.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their long relationship <w>knew</w> many ups and downs over the decades.",
                            "target_lang_translations": {
                                "ru": "Их долгие отношения <w>знали</w> много взлетов и падений на протяжении десятилетий."
                            }
                        },
                        {
                            "text": "The family <w>knew</w> both good times and bad during the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Семья <w>познала</w> как хорошие, так и плохие времена во время экономического кризиса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "know ups and downs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать или проходить через определенные условия или события."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знать",
                                "target_lang_sense_clarification": "испытывать на своем веку"
                            },
                            {
                                "target_lang_word": "познать",
                                "target_lang_sense_clarification": "пережить, испытать"
                            },
                            {
                                "target_lang_word": "видеть",
                                "target_lang_sense_clarification": "сталкиваться в жизни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f050831-f087-37b9-b00c-2feae9209441",
                    "sense_definition": "To have sexual relations with someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text says that the man <w>knew</w> his wife and she conceived a son.",
                            "target_lang_translations": {
                                "ru": "В древнем тексте говорится, что муж <w>познал</w> жену свою, и она зачала сына."
                            }
                        },
                        {
                            "text": "In the biblical sense, to <w>know</w> someone implies a very intimate physical relationship.",
                            "target_lang_translations": {
                                "ru": "В библейском смысле <w>познать</w> кого-то подразумевает очень близкие физические отношения."
                            }
                        }
                    ],
                    "synonyms": [
                        "coitize",
                        "go to bed with",
                        "sleep with",
                        "copulate with"
                    ],
                    "common_phrases": [
                        "know biblically"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in a biblical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в интимную связь с кем-либо (библейское значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "познать",
                                "target_lang_sense_clarification": "устар., вступить в связь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a2de8eb-e015-38d3-9ff7-8c370633d75d",
                    "sense_definition": "To hold a justified true belief according to philosophical definitions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philosophers debate what it truly means to <w>know</w> a proposition as truth.",
                            "target_lang_translations": {
                                "ru": "Философы спорят о том, что на самом деле означает <w>знать</w> суждение как истину."
                            }
                        },
                        {
                            "text": "To <w>know</w> something in this sense requires more than just having an opinion.",
                            "target_lang_translations": {
                                "ru": "Чтобы <w>знать</w> что-то в этом смысле, требуется нечто большее, чем просто наличие мнения."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладать обоснованным истинным убеждением согласно философским определениям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "познавать",
                                "target_lang_sense_clarification": "постигать истину"
                            },
                            {
                                "target_lang_word": "знать",
                                "target_lang_sense_clarification": "обладать знанием"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c9cd1ee-f531-3f91-88bc-505bd995f510",
                    "sense_definition": "Knowledge or the state of being informed about something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "awareness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only a few people were in the <w>know</w> about the secret merger.",
                            "target_lang_translations": {
                                "ru": "Лишь немногие были в <w>курсе</w> секретного слияния."
                            }
                        },
                        {
                            "text": "If you want to be in the <w>know</w>, you should follow his blog.",
                            "target_lang_translations": {
                                "ru": "Если хочешь быть в <w>курсе</w> событий, тебе стоит подписаться на его блог."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the know"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mostly used in the phrase 'in the know'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние осведомленности о чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "курс",
                                "target_lang_sense_clarification": "быть в курсе дела"
                            },
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "разг., быть в теме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}