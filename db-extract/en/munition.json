                    }
                ],
                "senses": [
                    {
                        "sense_id": "5df87730-3295-36e5-b451-d5509729d5e7",
                        "entry_id": "b4a090ab-3b5c-3942-a905-0cd35d91d95e",
                        "glosses": [
                            "Materials of war: armaments, weapons and ammunition."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "fcc23557-be0e-449d-8973-030213cf3469",
                                "sense_id": "5df87730-3295-36e5-b451-d5509729d5e7",
                                "text": "Just as we can say that an English girl who leaves the narrow circle of her old life, and goes into a munition factory and joins a union and takes part in its debates, will never after be a docile home-slave; so we can say that the clergyman who helps in Y. M. C. A. work in France, or in Red Cross organization in America, will be less the bigot and formalist forever after."
                            }
                        ]
                    },
                    {
                        "sense_id": "921422d9-5f3c-3ee1-bd76-4461d2836845",
                        "entry_id": "b4a090ab-3b5c-3942-a905-0cd35d91d95e",
                        "glosses": [
                            "Bombs, rockets, missiles (complete explosive devices, in contrast to e.g. guns)."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0fe7c247-5a57-35d6-acc4-d568f880daf9",
                        "entry_id": "b4a090ab-3b5c-3942-a905-0cd35d91d95e",
                        "glosses": [
                            "A tower or fortification."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dfef7442-13e1-431c-8981-1694493c90b3",
                                "sense_id": "0fe7c247-5a57-35d6-acc4-d568f880daf9",
                                "text": "I wil stand vpon my watch, and fixe my steppe vpon the munition: and I wil behold, to see what may be sayd to me, and what I may answer to him that rebuketh me."
                            }
                        ]
                    }
                ],
                "translations": [
