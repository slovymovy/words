                "senses": [
                    {
                        "sense_id": "1b789ef7-2dd2-33a7-8314-3d5b36b24cff",
                        "entry_id": "fa32002e-a645-3a17-8400-4795d2e523e5",
                        "glosses": [
                            "Streitigkeiten in und um Gaza, zwischen Israel und der Hamas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "713cb9fe-5629-4b67-8535-f06da5e4f312",
                                "sense_id": "1b789ef7-2dd2-33a7-8314-3d5b36b24cff",
                                "text": "„Auch fast drei Wochen nach Beginn des blutigen Gaza-Konflikts zwischen Israel und der radikal-islamischen Hamas ist kein Ende abzusehen.“"
                            },
                            {
                                "example_id": "765ef0d5-4c43-4611-901a-b155bbe061ed",
                                "sense_id": "1b789ef7-2dd2-33a7-8314-3d5b36b24cff",
                                "text": "„Die UN-Menschenrechtskommissarin Navi Pillay hat Israel im Gaza-Konflikt scharf kritisiert: Es sei sehr wahrscheinlich, dass das Land Völkerrecht verletzt und Kriegsverbrechen begangen hat.“"
                            },
                            {
                                "example_id": "47d0e190-9707-432e-b157-62d134786013",
                                "sense_id": "1b789ef7-2dd2-33a7-8314-3d5b36b24cff",
                                "text": "„Der israelische Premier Benjamin Netanjahu ist gegen eine neue Waffenruhe im Gaza-Konflikt.“"
                            },
                            {
                                "example_id": "12e2f54a-444d-42af-beb7-f413fde8801b",
                                "sense_id": "1b789ef7-2dd2-33a7-8314-3d5b36b24cff",
                                "text": "„Die USA reagierten verstimmt auf israelische Kritik an den Bemühungen von US-Außenminister John Kerry, eine Waffenruhe im Gaza-Konflikt zu vermitteln.“"
                            },
                            {
                                "example_id": "d4ef4609-4085-4f46-996f-1eca47f39f0e",
                                "sense_id": "1b789ef7-2dd2-33a7-8314-3d5b36b24cff",
                                "text": "„Die Außenminister der USA, Deutschlands sowie mehrerer weiterer Länder beraten in Paris über den Gaza-Konflikt und eine längerfristige Waffenruhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
