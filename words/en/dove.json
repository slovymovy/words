{
    "word_family": [
        "dovecote",
        "dovetail"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f5054c9-ead1-3b6a-aa39-4d3c6ca63d4e",
                    "sense_definition": "A pigeon, especially one smaller in size and white-colored; a bird of the family Columbidae.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician released a white <w>dove</w> into the air during the show.",
                            "target_lang_translations": {
                                "ru": "Во время шоу фокусник выпустил в воздух белого <w>голубя</w>.",
                                "de": "Der Zauberer ließ während der Show eine weiße <w>Taube</w> in die Luft fliegen.",
                                "zh": "表演期间，魔术师向空中放飞了一只白<w>鸽子</w>。"
                            }
                        },
                        {
                            "text": "We heard the soft cooing of a mourning <w>dove</w> in the garden.",
                            "target_lang_translations": {
                                "ru": "Мы слышали тихое воркование плачущей <w>горлицы</w> в саду.",
                                "de": "Wir hörten das sanfte Gurren einer Trauertaube im Garten.",
                                "zh": "我们在花园里听到了哀鸽柔和的叫声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pigeon"
                    ],
                    "common_phrases": [
                        "white dove",
                        "turtle dove",
                        "mourning dove"
                    ],
                    "target_lang_definitions": {
                        "ru": "Голубь, особенно небольшого размера и белого цвета; птица семейства голубиных.",
                        "de": "Eine Taube, insbesondere eine kleinere, weiß gefärbte; ein Vogel aus der Familie der Taubenvögel.",
                        "zh": "一种鸟，通常指鸽子，特别是体型较小且羽毛呈白色的品种。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голубь",
                                "target_lang_sense_clarification": "птица"
                            },
                            {
                                "target_lang_word": "горлица",
                                "target_lang_sense_clarification": "разновидность голубя"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Taube",
                                "target_lang_sense_clarification": "Vogel aus der Familie der Taubenvögel"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鸽子",
                                "target_lang_sense_clarification": "鸟类名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a31c9ec0-9a8e-3ac0-9239-e89241009766",
                    "sense_definition": "A person favouring conciliation and negotiation rather than conflict.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senator is a known <w>dove</w> who consistently votes against military intervention.",
                            "target_lang_translations": {
                                "ru": "Сенатор — известный <w>голубь</w>, который последовательно голосует против военного вмешательства.",
                                "de": "Der Senator ist eine bekannte <w>Taube</w>, die konsequent gegen militärische Interventionen stimmt.",
                                "zh": "这位参议员是著名的<w>鸽派</w>人物，一贯投票反对军事干预。"
                            }
                        },
                        {
                            "text": "In the cabinet meeting, the <w>dove</w> argued for a diplomatic solution instead of war.",
                            "target_lang_translations": {
                                "ru": "На заседании кабинета министров <w>голубь</w> выступал за дипломатическое решение вместо войны.",
                                "de": "In der Kabinettssitzung plädierte die <w>Taube</w> für eine diplomatische Lösung statt für Krieg.",
                                "zh": "在内阁会议上，这位<w>鸽派</w>成员主张通过外交途径而非战争来解决问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peace dove"
                    ],
                    "antonyms": [
                        "hawk"
                    ],
                    "common_phrases": [
                        "political dove",
                        "hawks and doves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, выступающий за примирение и переговоры, а не за конфликт.",
                        "de": "Eine Person, die eher zu Versöhnung und Verhandlungen als zu Konflikten neigt.",
                        "zh": "指在政治或外交上主张通过和平谈判而非武力冲突解决问题的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голубь",
                                "target_lang_sense_clarification": "политика"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Taube",
                                "target_lang_sense_clarification": "politisch gemäßigte Person"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鸽派",
                                "target_lang_sense_clarification": "政治立场"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bcea177-8e9e-349f-8683-d8b02ad25209",
                    "sense_definition": "Term of endearment for one regarded as pure and gentle.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "endearment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He whispered to his wife, calling her his precious <w>dove</w>.",
                            "target_lang_translations": {
                                "ru": "Он прошептал жене, называя её своей драгоценной <w>голубкой</w>.",
                                "de": "Er flüsterte seiner Frau zu und nannte sie sein kostbares <w>Täubchen</w>.",
                                "zh": "他对着妻子耳语，称她为自己珍贵的<w>小鸽子</w>。"
                            }
                        },
                        {
                            "text": "Come here, my little <w>dove</w>, and tell me what is wrong.",
                            "target_lang_translations": {
                                "ru": "Иди сюда, моя маленькая <w>голубка</w>, и расскажи мне, что случилось.",
                                "de": "Komm her, mein kleines <w>Täubchen</w>, und sag mir, was los ist.",
                                "zh": "过来，我的<w>小鸽子</w>，告诉我发生了什么事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "my little dove"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often literary or old-fashioned"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое обращение к тому, кого считают чистым и нежным.",
                        "de": "Ein Kosewort für jemanden, der als rein und sanft angesehen wird.",
                        "zh": "对纯洁、温柔之人的爱称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голубка",
                                "target_lang_sense_clarification": "обращение к женщине"
                            },
                            {
                                "target_lang_word": "голубчик",
                                "target_lang_sense_clarification": "ласковое обращение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Täubchen",
                                "target_lang_sense_clarification": "liebevolle Anrede"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小鸽子",
                                "target_lang_sense_clarification": "亲昵称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2e6f948-a919-3504-888c-5aaa8ce98f33",
                    "sense_definition": "A greyish, bluish, pinkish colour like that of the bird.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chose a soft <w>dove</w> grey for the living room walls.",
                            "target_lang_translations": {
                                "ru": "Она выбрала мягкий <w>голубино</w>-серый цвет для стен гостиной.",
                                "de": "Sie wählte ein sanftes <w>Taubengrau</w> für die Wände des Wohnzimmers.",
                                "zh": "她为客厅的墙壁选择了柔和的<w>鸽灰色</w>。"
                            }
                        },
                        {
                            "text": "The bridesmaids wore dresses in a beautiful shade of <w>dove</w>.",
                            "target_lang_translations": {
                                "ru": "Подружки невесты были в платьях красивого <w>сизого</w> оттенка.",
                                "de": "Die Brautjungfern trugen Kleider in einem wunderschönen <w>Taubengrau</w>.",
                                "zh": "伴娘们穿着颜色为美丽的<w>鸽灰色</w>的礼服。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dove grey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сероватый, голубоватый или розоватый цвет, напоминающий оперение голубя.",
                        "de": "Eine gräuliche, bläuliche oder rötliche Farbe, die an das Gefieder des Vogels erinnert.",
                        "zh": "一种类似于鸽子羽毛颜色的灰蓝色或灰粉色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сизый цвет",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "голубино-серый",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "taubengrau",
                                "target_lang_sense_clarification": "Farbton"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鸽灰色",
                                "target_lang_sense_clarification": "颜色名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab2967bc-eade-32e9-aa09-18612b931b99",
                    "sense_definition": "Simple past of <w>dive</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>dove</w> into the swimming pool to cool off on a hot day.",
                            "target_lang_translations": {
                                "ru": "Он <w>нырнул</w> в бассейн, чтобы охладиться в жаркий день.",
                                "de": "Er <w>tauchte</w> in den Swimmingpool, um sich an einem heißen Tag abzukühlen.",
                                "zh": "炎热的一天，他<w>跳入</w>游泳池里降温。"
                            }
                        },
                        {
                            "text": "The company's stock value <w>dove</w> sharply after the bad news.",
                            "target_lang_translations": {
                                "ru": "Стоимость акций компании резко <w>упала</w> после плохих новостей.",
                                "de": "Der Aktienwert des Unternehmens <w>stürzte</w> nach den schlechten Nachrichten stark ab.",
                                "zh": "坏消息传出后，该公司的股票价值急剧<w>暴跌</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dove into",
                        "dove down"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "chiefly US and Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола dive (нырять).",
                        "de": "Präteritum von 'dive' (tauchen/springen).",
                        "zh": "动词 dive（跳水、潜水）的过去式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нырнул",
                                "target_lang_sense_clarification": "прошедшее время"
                            },
                            {
                                "target_lang_word": "упал",
                                "target_lang_sense_clarification": "переносное значение (о ценах)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "tauchte",
                                "target_lang_sense_clarification": "Präteritum von tauchen"
                            },
                            {
                                "target_lang_word": "sprang",
                                "target_lang_sense_clarification": "im Kontext von 'ins Wasser springen'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳入",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "暴跌",
                                "target_lang_sense_clarification": "价格或数值下降"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8ce2c28-1726-3a2a-822b-021e55cc52e6",
                    "sense_definition": "Past participle of <w>dive</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They have <w>dove</w> deep into the archives to find the answer.",
                            "target_lang_translations": {
                                "ru": "Они глубоко <w>погрузились</w> в архивы, чтобы найти ответ.",
                                "de": "Sie sind tief in die Archive <w>eingetaucht</w>, um die Antwort zu finden.",
                                "zh": "他们深入<w>钻研</w>了档案以寻找答案。"
                            }
                        },
                        {
                            "text": "She had never <w>dove</w> from the high board before today.",
                            "target_lang_translations": {
                                "ru": "Она никогда раньше не <w>ныряла</w> с вышки.",
                                "de": "Sie war vor heute noch nie vom Sprungbrett <w>getaucht</w>.",
                                "zh": "在今天之前，她从未从跳水板上<w>跳入</w>水中。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "less common, chiefly US dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола dive (нырять).",
                        "de": "Partizip Perfekt von 'dive' (tauchen/springen).",
                        "zh": "动词 dive（跳水、潜水）的过去分词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нырял",
                                "target_lang_sense_clarification": "форма глагола"
                            },
                            {
                                "target_lang_word": "погружался",
                                "target_lang_sense_clarification": "форма глагола"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "getaucht",
                                "target_lang_sense_clarification": "Partizip von tauchen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "潜入",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                }
            ]
        },
