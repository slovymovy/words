    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ea97967-382e-34fe-bda0-e59a26190019",
                    "sense_definition": "Mettre dans un contenant autant qu'il peut en tenir ; rendre plein.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "remplir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il prit la cruche pour <w>emplir</w> les verres des invités avec du vin frais."
                        },
                        {
                            "text": "Le jardinier <w>emplit</w> un grand seau avec l'eau de pluie pour arroser ses fleurs."
                        }
                    ],
                    "synonyms": [
                        "remplir"
                    ],
                    "antonyms": [
                        "vider"
                    ],
                    "common_phrases": [
                        "emplir d'eau",
                        "emplir un seau"
                    ]
                },
                {
                    "sense_id": "d456bb94-051c-349e-a5b9-58bf3d6acde2",
                    "sense_definition": "Affecter profondément quelqu'un, en parlant d'un sentiment ou d'une émotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette excellente nouvelle <w>emplit</w> le cœur des parents d'une joie immense."
                        },
                        {
                            "text": "Le spectacle grandiose de la nature <w>emplissait</w> son âme d'un profond sentiment de paix."
                        }
                    ],
                    "synonyms": [
                        "combler",
                        "envahir"
                    ],
                    "common_phrases": [
                        "emplir de joie",
                        "emplir de fierté"
                    ]
                },
                {
                    "sense_id": "d4f64040-cacd-3d16-b2d5-dabaf0aa4141",
                    "sense_definition": "Se diffuser dans un espace au point de l'occuper entièrement, en parlant d'une odeur, d'un son ou d'une clarté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diffusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'odeur du pain chaud <w>emplit</w> toute la cuisine dès le lever du jour."
                        },
                        {
                            "text": "Une musique douce et apaisante <w>emplissait</w> le salon pendant que les invités discutaient tranquillement."
                        }
                    ],
                    "synonyms": [
                        "envahir",
                        "inonder"
                    ],
                    "common_phrases": [
                        "emplir l'air",
                        "emplir la pièce"
                    ]
                },
                {
                    "sense_id": "d060defe-b318-3c2b-ba62-ade9a614907d",
                    "sense_definition": "Devenir plein, se charger abondamment de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remplir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La petite place du village s'<w>emplit</w> de monde à l'arrivée des musiciens ambulants."
                        },
                        {
                            "text": "Ses yeux s'<w>emplirent</w> de larmes en lisant la lettre de son père."
                        }
                    ],
                    "synonyms": [
                        "se remplir"
                    ],
                    "antonyms": [
                        "se vider"
                    ],
                    "common_phrases": [
                        "s'emplir d'eau",
                        "s'emplir de monde"
                    ]
                },
                {
                    "sense_id": "79f04ef1-92c1-3bc6-b140-f069efbd6ea1",
                    "sense_definition": "Occuper tout l'espace disponible d'un vêtement ou d'un volume.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "volume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il a pris du poids, cet homme <w>emplit</w> un peu trop son pantalon."
                        },
                        {
                            "text": "Le jeune sportif a tellement grandi qu'il <w>emplit</w> désormais tous ses vieux pulls."
                        }
                    ],
                    "common_phrases": [
                        "emplir son pantalon"
                    ]
                },
                {
                    "sense_id": "1d96658c-d4e2-33d8-970c-48ebf10619a1",
                    "sense_definition": "Prendre l'eau, se remplir d'eau au risque de couler, en parlant d'une embarcation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Frappé de plein fouet par la houle, le canot de sauvetage <w>emplit</w> à toute vitesse."
                        },
                        {
                            "text": "Les matelots ont rapidement manœuvré car la barque commençait à <w>emplir</w> dangereusement au large."
                        }
                    ],
                    "common_phrases": [
                        "bateau qui emplit"
                    ]
                },
                {
                    "sense_id": "b4c2225e-8ce7-312e-9976-834835917b70",
                    "sense_definition": "Féconder une femelle pour la rendre pleine ou gravide, en parlant d'un animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "elevage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce fermier expérimenté a fait <w>emplir</w> sa meilleure jument par un étalon noir réputé."
                        },
                        {
                            "text": "Au printemps, l'éleveur amène le taureau afin d'<w>emplir</w> toutes les vaches du domaine."
                        }
                    ],
                    "synonyms": [
                        "féconder",
                        "saillir"
                    ],
                    "common_phrases": [
                        "faire emplir sa jument"
                    ]
                }
            ]
        }
    ]
