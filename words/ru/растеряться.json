{
    "word_family": [
        "растерять",
        "растерянность",
        "растерянный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b7a28f8d-3fa2-37c7-9f32-501d78010193",
                    "sense_definition": "Утратить способность ясно мыслить или действовать из-за волнения, смущения или неожиданности.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>растерялся</w> от неожиданного вопроса и не смог сразу ответить.",
                            "target_lang_translations": {
                                "de": "Er <w>war verwirrt</w> durch die unerwartete Frage und konnte nicht sofort antworten."
                            }
                        },
                        {
                            "text": "Не нужно <w>растеряться</w> в сложной ситуации, лучше сохранять спокойствие.",
                            "target_lang_translations": {
                                "de": "Man sollte in einer schwierigen Situation nicht <w>die Fassung verlieren</w>, es ist besser, ruhig zu bleiben."
                            }
                        }
                    ],
                    "synonyms": [
                        "прийти в растерянность"
                    ],
                    "common_phrases": [
                        "сильно растеряться"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Fähigkeit verlieren, aufgrund von Aufregung, Verlegenheit oder Überraschung klar zu denken oder zu handeln."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verwirrt sein",
                                "target_lang_sense_clarification": "allgemeiner Zustand der Verwirrung"
                            },
                            {
                                "target_lang_word": "die Fassung verlieren",
                                "target_lang_sense_clarification": "die Beherrschung oder Ruhe verlieren"
                            },
                            {
                                "target_lang_word": "ratlos sein",
                                "target_lang_sense_clarification": "nicht wissen, was man tun soll"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3455e26-f08f-36d5-b0d4-c83bbe838208",
                    "sense_definition": "О многих предметах: пропасть, потеряться один за другим.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все документы в беспорядке <w>растерялись</w> во время переезда.",
                            "target_lang_translations": {
                                "de": "Alle Dokumente sind während des Umzugs im Chaos <w>verloren gegangen</w>."
                            }
                        },
                        {
                            "text": "Мелкие детали конструктора быстро <w>растерялись</w> по всей комнате.",
                            "target_lang_translations": {
                                "de": "Die kleinen Bauteile sind schnell im ganzen Zimmer <w>verloren gegangen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "потеряться",
                        "затеряться"
                    ],
                    "common_phrases": [
                        "детали растерялись"
                    ],
                    "target_lang_definitions": {
                        "de": "Von vielen Gegenständen: nach und nach verloren gehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verloren gehen",
                                "target_lang_sense_clarification": "allgemeiner Verlust von Gegenständen"
                            },
                            {
                                "target_lang_word": "abhandenkommen",
                                "target_lang_sense_clarification": "verloren gehen oder nicht mehr auffindbar sein"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c42a2946-0bd4-374b-80df-855b2e96a66e",
                    "sense_definition": "Страдательный залог от глагола <w>растерять</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все ключи <w>растерялись</w> из-за дырки в кармане.",
                            "target_lang_translations": {
                                "de": "Alle Schlüssel sind wegen eines Lochs in der Tasche <w>verloren gegangen</w>."
                            }
                        },
                        {
                            "text": "По дороге все вещи <w>растерялись</w>.",
                            "target_lang_translations": {
                                "de": "Unterwegs sind alle Sachen <w>verloren gegangen</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Passivform von 'verlieren' (in Bezug auf mehrere Dinge, die verloren gegangen sind)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verloren gehen",
                                "target_lang_sense_clarification": "passiver Verlust von Objekten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}