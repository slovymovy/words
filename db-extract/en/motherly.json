                    {
                        "translation_id": "1bd2a2e5-8dfe-4449-b470-4b869a19f535",
                        "source_entry_id": "3268b804-7532-3bb7-98d0-e120aa443489",
                        "source_sense_id": "5ce52695-518b-3514-805d-953043704dc9",
                        "source_sense_description": "befitting a mother; warm, caring, nurturing, protective, loving",
                        "target_lang_word": "mütterlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mütterlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea84458e-16ab-34ac-8b26-91a4d1510d07",
                                        "entry_id": "85cde165-05db-34e3-9068-cc1a0b471b29",
                                        "glosses": [
                                            "von der Mutter stammend, zur Mutter gehörig"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76c3f8d1-57a7-48a8-90c4-771efcc25157",
                                                "sense_id": "ea84458e-16ab-34ac-8b26-91a4d1510d07",
                                                "text": "Bei den Aka etwa, einem zentralafrikanischen Pygmäenvolk, leben manche Familien mit den mütterlichen, andere mit den väterlichen Verwandten."
                                            },
                                            {
                                                "example_id": "e3224e9c-fee9-4ad5-aefa-13ec7b713106",
                                                "sense_id": "ea84458e-16ab-34ac-8b26-91a4d1510d07",
                                                "text": "Keine anheimelnde Umgebung erwartet ihn[den Embryo], sondern das mütterliche Immunsystem."
                                            },
                                            {
                                                "example_id": "6f35a222-d84b-4d38-b495-65bdfa41da58",
                                                "sense_id": "ea84458e-16ab-34ac-8b26-91a4d1510d07",
                                                "text": "Während die unvertraute Stimme lediglich Regionen im Gehirn aktiviert, die für die Stimmerkennung zuständig sind, lässt das mütterliche Organ auch das Sprachzentrum anspringen."
                                            },
                                            {
                                                "example_id": "824b1411-50ce-4133-b567-cdf5185ed360",
                                                "sense_id": "ea84458e-16ab-34ac-8b26-91a4d1510d07",
                                                "text": "„Wenn nach der Geburt die mütterliche Zuckerzufuhr fehlt, tritt eine Unterzuckerung ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "75d71b55-f6de-3e37-8963-328423034646",
                                        "entry_id": "85cde165-05db-34e3-9068-cc1a0b471b29",
                                        "glosses": [
                                            "fürsorglich, liebevoll wie eine Mutter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee34527-767d-4aa8-8917-79686b22c856",
                                                "sense_id": "75d71b55-f6de-3e37-8963-328423034646",
                                                "text": "Für einen Moment wirkt sie fast mütterlich."
                                            },
                                            {
                                                "example_id": "9e4fa5dc-1982-468c-82e2-0a698aba1f5c",
                                                "sense_id": "75d71b55-f6de-3e37-8963-328423034646",
                                                "text": "Mütterlich und sinnlich, von einem geradezu vesuvianischen Temperament, war sie für ihn seit je die Inkarnation des Weibes."
                                            },
                                            {
                                                "example_id": "3a012c60-522c-4e76-9eba-4b782baf70a5",
                                                "sense_id": "75d71b55-f6de-3e37-8963-328423034646",
                                                "text": "Die 21-jährige Amerikanerin ist bestes Identifikationsmaterial in dieser Rolle einer jungen Frau, die zugleich hart und weich sein kann, brutal und zärtlich, widerspenstig und mütterlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
