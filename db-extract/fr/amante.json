                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "30b67e5b-6bfa-3d61-a39d-e0d739005024",
                                        "entry_id": "7f87310c-eaf1-30a3-b581-d36555c8d981",
                                        "glosses": [
                                            "η γυναίκα που διατηρεί ερωτική σχέση, συνήθως με έγγαμμο"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59cdcdda-511c-4645-9d10-d2bab3703d3c",
                                                "sense_id": "30b67e5b-6bfa-3d61-a39d-e0d739005024",
                                                "text": "※ Μοναδική του σύμμαχος η χυμώδης τηλεοπτική περσόνα και ερωμένη του υφυπουργού Οικονομικών Έλλη Καμπάνη που αλλάζει στρατόπεδο εν μία νυκτί με ένα και μόνο στόχο: ν’ αποδείξει πως η εκδίκηση είναι ένα πιάτο που τρώγεται καυτό, σαν την ίδια. (Θάνος Δραγούμης, Εντιμότατα λαμόγια, εκδ. Μεταίχμιο, 2017)"
                                            },
                                            {
                                                "example_id": "acf283c5-5ca1-4f88-b6e3-61c1765c7012",
                                                "sense_id": "30b67e5b-6bfa-3d61-a39d-e0d739005024",
                                                "text": "(μυθολογία) οι ερωμένες του Δία"
                                            },
                                            {
                                                "example_id": "164426d7-9303-42e1-bb09-59cbc56ed0a7",
                                                "sense_id": "30b67e5b-6bfa-3d61-a39d-e0d739005024",
                                                "text": "≤ συνυπώνυμα: γκόμενα, μετρέσα, παλλακίδα, φιλενάδα"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "357bde96-7605-3148-aa7b-a634c484f835",
                                        "entry_id": "7f87310c-eaf1-30a3-b581-d36555c8d981",
                                        "glosses": [
                                            "αυτή που διατηρεί παράνομη ή μη νομιμοποιημένη ερωτική σχέση με παντρεμένο"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f1dca5b-45e0-403b-8eeb-50524963decb",
                                                "sense_id": "357bde96-7605-3148-aa7b-a634c484f835",
                                                "text": "→ χρειάζεται παράθεμα"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "477cebaa-fa0e-31e5-9c9e-c5541023b925",
                                        "entry_id": "7f87310c-eaf1-30a3-b581-d36555c8d981",
