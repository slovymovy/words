                ],
                "senses": [
                    {
                        "sense_id": "21ff9f0d-d736-3a60-8090-10ea4bc0537c",
                        "entry_id": "b6630a3e-2c67-3a2b-bde0-01fdf74255cf",
                        "glosses": [
                            "Prénom féminin français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bb6560e-b038-46af-bbd9-90417c0bc707",
                                "sense_id": "21ff9f0d-d736-3a60-8090-10ea4bc0537c",
                                "text": "L’après-midi, Félix laissa ses potes à la maison pour qu’ils pussent « buller tranquilou » et il partit avec Margot à Bourg-en-Bresse acheter les billets de TGV pour Paris."
                            },
                            {
                                "example_id": "e8333aa0-97a9-4185-83b3-403152e3e680",
                                "sense_id": "21ff9f0d-d736-3a60-8090-10ea4bc0537c",
                                "text": "Après avoir tourné, à 16 ans, une publicité pour la chaîne de restauration Hooters, connue pour ses serveuses sexy et peu vêtues, Margot Robbie aurait pu travailler pour cet établissement."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc686328-a84f-3194-a1d3-40d7409dd2fa",
                        "entry_id": "b6630a3e-2c67-3a2b-bde0-01fdf74255cf",
                        "glosses": [
                            "Diminutif du prénom Marguerite."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "feb6c3b4-b4ea-48d8-a5a2-fb2cda2bc415",
                                "sense_id": "fc686328-a84f-3194-a1d3-40d7409dd2fa",
                                "text": "[…] car, ventre-saint-gris ! cette Margot, comme l’appelle mon beau-frère Charles IX est une adorable créature."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84c977be-bdf8-4d55-b8bc-36b506f797ab",
                        "source_entry_id": "b6630a3e-2c67-3a2b-bde0-01fdf74255cf",
                        "target_lang_word": "玛歌",
                        "target_lang_code": "zh",
