{
    "word_family": [
        "cavern"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b8566307-262e-3a79-8d5f-b12a56446f0a",
                    "sense_definition": "Resembling a cavern in size, shape, or atmosphere.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "size_and_depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cavernous</w> hall echoed with every footstep we took across the cold stone floor.",
                            "target_lang_translations": {
                                "nl": "De <w>spelonkachtige</w> hal weergalmde bij elke voetstap die we op de koude stenen vloer zetten."
                            }
                        },
                        {
                            "text": "They walked through the <w>cavernous</w> warehouse looking for the missing shipment of supplies.",
                            "target_lang_translations": {
                                "nl": "Ze liepen door de <w>immense, holle</w> loods op zoek naar de ontbrekende voorraadzending."
                            }
                        }
                    ],
                    "synonyms": [
                        "cavelike"
                    ],
                    "common_phrases": [
                        "cavernous hall",
                        "cavernous space"
                    ],
                    "target_lang_definitions": {
                        "nl": "Als een spelonk of grot; zeer groot, leeg en vaak hol klinkend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "grotachtig",
                                "target_lang_sense_clarification": "als een grot van vorm of sfeer"
                            },
                            {
                                "target_lang_word": "spelonkachtig",
                                "target_lang_sense_clarification": "donker en hol als een spelonk"
                            },
                            {
                                "target_lang_word": "immens groot",
                                "target_lang_sense_clarification": "enorm en hol van formaat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b84e0796-86e4-3a39-824b-e09b33f0e6c3",
                    "sense_definition": "Giving the impression of vast, dark depths.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "size_and_depth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man stared at us with <w>cavernous</w> eyes that seemed to hold many secrets.",
                            "target_lang_translations": {
                                "nl": "De oude man staarde ons aan met <w>diepliggende</w> ogen die vele geheimen leken te bewaren."
                            }
                        },
                        {
                            "text": "The critic pointed out the <w>cavernous</w> gaps in the author's logic throughout the novel.",
                            "target_lang_translations": {
                                "nl": "De criticus wees op de <w>gapende</w> gaten in de logica van de auteur door de hele roman heen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cavernous eyes"
                    ],
                    "target_lang_definitions": {
                        "nl": "De indruk wekkend van enorme, donkere diepten; diepliggend of gapend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "diepliggend",
                                "target_lang_sense_clarification": "van ogen, ver in de kassen verzonken"
                            },
                            {
                                "target_lang_word": "gapend",
                                "target_lang_sense_clarification": "van diepten, kloven of leemtes"
                            },
                            {
                                "target_lang_word": "onpeilbaar diep",
                                "target_lang_sense_clarification": "figuurlijk, zeer diep en donker"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c6f1a11-38de-3e61-b8ad-5b574fde3beb",
                    "sense_definition": "Having many cavities or hollow spaces.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The porous rock had a <w>cavernous</w> structure that allowed water to flow through easily.",
                            "target_lang_translations": {
                                "nl": "Het poreuze gesteente had een <w>caverneuze</w> structuur waardoor het water er gemakkelijk doorheen kon stromen."
                            }
                        },
                        {
                            "text": "Scientists studied the <w>cavernous</w> interior of the ancient volcanic formation.",
                            "target_lang_translations": {
                                "nl": "Wetenschappers bestudeerden het <w>holterijke</w> binnenste van de oude vulkanische formatie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorzien van vele holten of holle ruimtes; caverneus."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "caverneus",
                                "target_lang_sense_clarification": "wetenschappelijk of formeel voor vol holten"
                            },
                            {
                                "target_lang_word": "holterijk",
                                "target_lang_sense_clarification": "rijk aan holtes of openingen"
                            },
                            {
                                "target_lang_word": "poreus",
                                "target_lang_sense_clarification": "met veel holle tussenruimtes"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}