                    {
                        "translation_id": "05feddb8-9d4b-4653-93b8-8ebcbb29b7cd",
                        "source_entry_id": "af2a09e2-ccd6-3653-992c-6ceb9bbe3055",
                        "source_sense_id": "69159129-6671-3eca-8d8b-68e1553477e6",
                        "target_lang_word": "automutilation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "automutilation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d6641b2-3467-32ab-8ec2-53dc27df6e85",
                                        "entry_id": "eca217fc-5fc6-3f97-8035-9c9afeec792e",
                                        "glosses": [
                                            "Mutilation de soi-même, fait de s'infliger des blessures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "309e2348-9fa8-4b5b-b281-c83fc01e9194",
                                                "sense_id": "7d6641b2-3467-32ab-8ec2-53dc27df6e85",
                                                "text": "Ils considèrent que ce n’est pas dangereux, que ce n’est pas de l’automutilation, estime Clément Legrand."
                                            },
                                            {
                                                "example_id": "0a6bdfcb-47a9-4eb4-9a3c-07101202ebd6",
                                                "sense_id": "7d6641b2-3467-32ab-8ec2-53dc27df6e85",
                                                "text": "Ils apprirent aussi au Dalaï-lama que certains allaient jusqu'à se blesser volontairement, et que l'automutilation était pratiquée par 10 à 15 % des adolescents européens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87cf10d4-f56b-367d-8e96-a64a90b36dc6",
                                        "entry_id": "eca217fc-5fc6-3f97-8035-9c9afeec792e",
                                        "glosses": [
                                            "Action de se priver soi-même d'une partie de soi."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b0bc3d9-aa3d-4fa1-8805-fcc177a62a58",
                                                "sense_id": "87cf10d4-f56b-367d-8e96-a64a90b36dc6",
                                                "text": "Il y a une espèce de joie sauvage à voir cramer un manuscrit. Deux mois de travail, les pensées d’un instant, des choses qu’on ne retrouvera jamais plus… C’est une automutilation, une espèce de suicide…, ça aussi."
                                            },
                                            {
                                                "example_id": "ab94a426-5daa-4a50-8349-e0251e87ce03",
                                                "sense_id": "87cf10d4-f56b-367d-8e96-a64a90b36dc6",
                                                "text": "Le pullulement de raisons sociales et autres affichages en anglais ressemble à une forme d'automutilation."
                                            },
                                            {
                                                "example_id": "92361e5d-0c7e-4312-9a7b-e3aa3c73652b",
                                                "sense_id": "87cf10d4-f56b-367d-8e96-a64a90b36dc6",
                                                "text": "J’ai peur de la confrontation, alors je me tais. C’est de l’automutilation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
