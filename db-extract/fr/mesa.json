                                    {
                                        "sense_id": "9c75b545-ac3f-3634-9c33-08d265f60b8d",
                                        "entry_id": "ef97264e-764c-3848-9a83-556743c5a7b2",
                                        "glosses": [
                                            "Berg mit flacher, tafelartiger Oberseite"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42bdc441-ad38-4d12-a704-42e8d0bea8d9",
                                                "sense_id": "9c75b545-ac3f-3634-9c33-08d265f60b8d",
                                                "text": "Im Monument Valley gibt es viele Tafelberge."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tafelberg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "082c0964-67ef-3b85-950f-949909db4f88",
                                        "entry_id": "33a41ef2-b312-3f94-8499-c8caba07d062",
                                        "glosses": [
                                            "der Tafelberg bei Kapstadt, Südafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9342bd3e-3469-4954-860b-2ed1e0981140",
                                                "sense_id": "082c0964-67ef-3b85-950f-949909db4f88",
                                                "text": "„Dem schmalen, stellenweise bis über 50 km breiten Küstenstreifen sind vereinzelte Bergstöcke, wie der 1082 m hohe Tafelberg, aufgesetzt.“"
                                            },
                                            {
                                                "example_id": "c38ac188-1765-4ad9-9eb8-90b8fbc78702",
                                                "sense_id": "082c0964-67ef-3b85-950f-949909db4f88",
                                                "text": "„Einer [der drei Berge am Kap] heißt der Teufelsberg, der andere der Tafelberg, weil er oben platt ist […].“ (1774)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5563f2b1-21df-46ba-b028-7da1490502c6",
                        "source_entry_id": "9b4a9982-ec0d-3641-8b89-4947870bb69a",
                        "source_sense_id": "e7c0517b-8ea1-3f2f-a51c-bc36954cf1d6",
