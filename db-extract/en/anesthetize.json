                "senses": [
                    {
                        "sense_id": "f95d1382-a478-3379-bc32-a8445dd498fa",
                        "entry_id": "54b21553-16fa-3a9e-98af-63a8058d6719",
                        "glosses": [
                            "To administer anesthesia to: to render unfeeling or unconscious through the use of narcotic substances, usually either alcohol or pharmaceutical drugs."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f28e6af6-eeff-41b7-9320-408d71d5399f",
                                "sense_id": "f95d1382-a478-3379-bc32-a8445dd498fa",
                                "text": "Just prior to surgery the doctor will anesthetize him and he will sleep for four hours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ab449fd-ac3c-484c-955f-f5ed87415b5e",
                        "source_entry_id": "54b21553-16fa-3a9e-98af-63a8058d6719",
                        "source_sense_id": "f95d1382-a478-3379-bc32-a8445dd498fa",
                        "source_sense_description": "administer anesthesia",
                        "target_lang_word": "verdoven",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdoven",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7f2ea18b-2157-3d7a-8a2c-37cab2f6bae1",
                                        "entry_id": "a2e63d0b-5b68-3fcc-948c-18c4aa100120",
                                        "glosses": [
                                            "de pijnprikkel onderdrukken, bijvoorbeeld door het toedienen van een medicijn"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5cb01cc-5a5e-4c9d-b093-4ebafd92a7a1",
                                                "sense_id": "7f2ea18b-2157-3d7a-8a2c-37cab2f6bae1",
                                                "text": "Hij verdoofde de huid plaatselijk voordat hij aan de kleine ingreep begon."
                                            },
                                            {
                                                "example_id": "39172ad8-c914-4068-9182-b4e803932cb5",
                                                "sense_id": "7f2ea18b-2157-3d7a-8a2c-37cab2f6bae1",
                                                "text": "Als toetje nam ik twee ibuprofen-pillen om de pijn in mijn voeten te verdoven en ik kroop met vermoeide benen in mijn slaapzak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e6342e9-6f08-41c6-8097-4658e573bb76",
                        "source_entry_id": "54b21553-16fa-3a9e-98af-63a8058d6719",
                        "source_sense_id": "f95d1382-a478-3379-bc32-a8445dd498fa",
                        "source_sense_description": "administer anesthesia",
                        "target_lang_word": "anesthésier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anesthésier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e2645cf-1b23-3cda-b153-2131198f4868",
                                        "entry_id": "f69e4caf-55f9-3507-864b-108812d890eb",
                                        "glosses": [
                                            "Rendre insensible à la douleur par l’anesthésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb93aaa2-839f-4efc-88f0-049d2a52774d",
                                                "sense_id": "9e2645cf-1b23-3cda-b153-2131198f4868",
                                                "text": "On employait autrefois, pour anesthésier les malades, un appareil relativement compliqué."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4120819-0a8a-3ba3-91e4-2807af3a1c69",
                                        "entry_id": "f69e4caf-55f9-3507-864b-108812d890eb",
                                        "glosses": [
                                            "Rendre inactif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "444481a7-0da8-4507-b73c-802485f99144",
                                                "sense_id": "f4120819-0a8a-3ba3-91e4-2807af3a1c69",
                                                "text": "Vous ne le sentez pas, vous, quand quelqu’un a la haine de soi ? Ça le conduit à devenir mort tout en étant vivant, à anesthésier les mauvais sentiments mais aussi les bons pour ne pas ressentir la nausée d’être soi."
                                            },
                                            {
                                                "example_id": "6eb88c57-3173-4ae0-aea9-ad6299002a35",
                                                "sense_id": "f4120819-0a8a-3ba3-91e4-2807af3a1c69",
                                                "text": "Veste courte en cuir et cette nouvelle sorte de pantalon, d'un blanc immaculé. Souliers à talons aiguilles recouverts de paillettes, genre fantaisie, qu'on peut voir aux pieds des filles dans les bars à champagne. Cette apparition m’anesthésia."
                                            },
                                            {
                                                "example_id": "16889f75-4786-4d59-9279-7854bc10c020",
                                                "sense_id": "f4120819-0a8a-3ba3-91e4-2807af3a1c69",
                                                "text": "Il y a un monde entre gommer, anesthésier, enfouir ses émotions ou les vivre seuls – et les vivre jusqu'au bout dans la présence de Dieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce0d08ab-fec4-4785-ba04-0b647613ddf9",
                        "source_entry_id": "54b21553-16fa-3a9e-98af-63a8058d6719",
                        "source_sense_id": "f95d1382-a478-3379-bc32-a8445dd498fa",
