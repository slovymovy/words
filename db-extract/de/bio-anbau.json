                            {
                                "example_id": "d09188cc-5cd3-42c4-8681-5ac35b732d8f",
                                "sense_id": "7db51f8c-0350-36ea-a6c0-e49552b9fc7f",
                                "text": "„Am besten nutzt man für den Saft frischen Sellerie aus Bio-Anbau her, er enthält besonders viele Nährstoffe.“"
                            },
                            {
                                "example_id": "3e923db5-14e9-4f84-b1c0-07b478c18106",
                                "sense_id": "7db51f8c-0350-36ea-a6c0-e49552b9fc7f",
                                "text": "„Gut drei Jahre dauert der Prozess, vom konventionellen auf Bio-Anbau umzustellen.“"
                            },
                            {
                                "example_id": "faa3c592-3739-4b60-9b95-fbab85afe6ea",
                                "sense_id": "7db51f8c-0350-36ea-a6c0-e49552b9fc7f",
                                "text": "„Im Bio-Anbau sind derartige Pestizide zwar verboten, der enorm hohe Wasserbedarf aber bleibt bestehen.“"
                            }
                        ],
