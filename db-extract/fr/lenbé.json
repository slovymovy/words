                        "examples": [
                            {
                                "example_id": "1543f682-f5df-4dd4-b3c5-a89d5911afec",
                                "sense_id": "05c2e47e-8555-3fd8-8046-767c2c6317fa",
                                "text": "Ni flirts, ni blagues, le lenbé nous travaillait l’âme."
                            },
                            {
                                "example_id": "58b4f7be-a730-488a-bdbb-e3b5b5d6938f",
                                "sense_id": "05c2e47e-8555-3fd8-8046-767c2c6317fa",
                                "text": "Jean-Paul ne comprenait rien à tout ça. Pour lui ce n’était que l’effet d’un blues, d’un lenbé, d’une désolation sans fond. Il ne comprenait pas pourquoi les autres compères ne riaient plus comme avant."
                            }
