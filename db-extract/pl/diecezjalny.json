                                        "sense_id": "561ba51f-5cf9-3e1a-ade9-375045040c7d",
                                        "entry_id": "c6520c63-96bd-371e-90e8-9c11e2289d0b",
                                        "glosses": [
                                            "Pertaining to a diocese."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a05fb37f-5893-4710-9cc2-1339a57f54d4",
                                                "sense_id": "561ba51f-5cf9-3e1a-ade9-375045040c7d",
                                                "text": "Diocesan bureaucracies were both symptom and cause of this."
                                            }
                                        ]
