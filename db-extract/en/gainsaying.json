                        "entry_id": "db939a81-e462-3e44-bf77-010f06b93950",
                        "glosses": [
                            "Opposition, especially in speech."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dc752dd-5226-42cd-b2ae-787808925267",
                                "sense_id": "90d02395-bea8-3c7c-a846-0bd4c2ef50b4",
                                "text": "This gainsaying may take numberless forms: [...]"
                            },
                            {
                                "example_id": "b44ce3ee-de3a-4d9f-bfe7-c836333d3dba",
                                "sense_id": "90d02395-bea8-3c7c-a846-0bd4c2ef50b4",
                                "text": "Wee'le part the time betweene's then: and in that Ile no gaine-saying. […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "61c7689d-450f-3660-85d2-6c0475fd4b16",
                        "entry_id": "db939a81-e462-3e44-bf77-010f06b93950",
                        "glosses": [
                            "Refusal to accept or believe something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89cf8f4c-4495-4f58-83af-b76583b3e287",
                                "sense_id": "61c7689d-450f-3660-85d2-6c0475fd4b16",
                                "text": "So that it is best to take this meaning here, and understand, that an oath puts an end to all gainsaying by confirming the matter one way, in which all parties consent [...]"
                            }
                        ]
                    },
                    {
                        "sense_id": "4ae1098f-75a9-3569-bef8-7cb6d4fe4ea0",
                        "entry_id": "db939a81-e462-3e44-bf77-010f06b93950",
                        "glosses": [
                            "Contradiction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "188dd1ec-ee39-4842-9378-59d4765223b2",
                                "sense_id": "4ae1098f-75a9-3569-bef8-7cb6d4fe4ea0",
                                "text": "There is no gainsaying this logic."
                            }
                        ]
                    },
                    {
                        "sense_id": "d08a7732-bd4d-35d4-8ff5-9164dc1c4079",
                        "entry_id": "db939a81-e462-3e44-bf77-010f06b93950",
                        "glosses": [
                            "Denial; denying."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a564a76f-edb7-44b4-afb8-d411b4a22349",
                                "sense_id": "d08a7732-bd4d-35d4-8ff5-9164dc1c4079",
                                "text": "But there was no gainsaying the wisdom of the advice which he had given me as to concealing the treasure."
                            }
                        ]
                    },
                    {
                        "sense_id": "e048992e-e06e-3492-befa-c9eb56360910",
                        "entry_id": "db939a81-e462-3e44-bf77-010f06b93950",
                        "glosses": [
                            "Rebellious opposition; rebellion."
                        ],
                        "tags": [
                            "archaic",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "069773f3-8039-4bde-881e-8c4dd689b8e4",
                                "sense_id": "e048992e-e06e-3492-befa-c9eb56360910",
                                "text": "Woe unto them! for they have gone in the way of Cain, and ran greedily after the error of Balaam for reward, and perished in the gainsaying of Core."
                            }
                        ]
                    }
