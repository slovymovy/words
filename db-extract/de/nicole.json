                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c47a274-d679-4881-aaa8-6a24f8371c3d",
                                                "sense_id": "1f886c4c-66c5-3d8c-acf4-1b89eb8ec6e4",
                                                "text": "Nicole. They were all named Ashley or Nicole or Ashley Nicole. A sultry temptress of thirteen was after poor innocent Bob who was still a child, although lately his voice had been getting deeper […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
