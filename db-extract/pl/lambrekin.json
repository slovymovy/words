                "senses": [
                    {
                        "sense_id": "398bc075-60d4-332d-a0d6-05623dd01ccb",
                        "entry_id": "1fdc7db6-9cd2-3653-bb2d-a6b3ae536007",
                        "glosses": [
                            "rodzaj krótkiej ozdobnej zasłony, firanki nad oknem, drzwiami zawieszonej na drążku lub ozdabiający baldachimy"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "501ef001-d477-33b6-920b-6269cd17ca7e",
                        "entry_id": "1fdc7db6-9cd2-3653-bb2d-a6b3ae536007",
                        "glosses": [
                            "ornament lub element (na przykład zadaszenia albo baldachimu ołtarza) w kształcie krótkiej zasłony"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fed095f9-bb0e-4377-ac94-0a8c04ad5fd2",
                        "source_entry_id": "1fdc7db6-9cd2-3653-bb2d-a6b3ae536007",
                        "source_sense_id": "398bc075-60d4-332d-a0d6-05623dd01ccb",
                        "target_lang_word": "lambrequin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lambrequin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c96a0b8-a3e8-3a60-8935-4bab3e27ba60",
                                        "entry_id": "f681dacd-7d1f-3af9-a2db-354b696b5ba8",
                                        "glosses": [
                                            "Ornement qui pend du casque et entoure l’écu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bddf361f-c09c-4952-bea6-546aa0dc50b3",
                                                "sense_id": "2c96a0b8-a3e8-3a60-8935-4bab3e27ba60",
                                                "text": "Les armes du nouveau gentilhomme étaient « d'azur à la fasce d'or et pour cimier: lion issant d'argent, tenant en ses pattes une boule du même et d'un torty d'or et d'azur, le tout porté d'un avinet mort avec les lambrequins et couleurs susdites »."
                                            },
                                            {
                                                "example_id": "368a3bf7-a71d-43ce-a6c6-fd6c82e564f1",
                                                "sense_id": "2c96a0b8-a3e8-3a60-8935-4bab3e27ba60",
                                                "text": "Quand il voulait prendre l’air, il ôtait son casque, et se couvrait du bonnet. Alors les lambrequins retombaient sur ses épaules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38db0538-8901-3dd1-b59f-eec22051b402",
                                        "entry_id": "f681dacd-7d1f-3af9-a2db-354b696b5ba8",
                                        "glosses": [
                                            "Découpure de bois ou de tôle, couronnant un pavillon, une tente, un store, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2e7a7cd-c365-482e-a13b-ec0883d0d269",
                                                "sense_id": "38db0538-8901-3dd1-b59f-eec22051b402",
                                                "text": "Ce perron, aux marches larges et basses, était abrité par une vaste marquise vitrée, bordée d’un lambrequin à franges et à glands d’or."
                                            },
                                            {
                                                "example_id": "a109087b-6e96-4651-a3e0-c7e4767754c7",
                                                "sense_id": "38db0538-8901-3dd1-b59f-eec22051b402",
                                                "text": "Portail en fer défoncé, croix et stèle déplacées, colonnes fissurées, lambrequins arrachés, il ne les a pas vus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4c08fae-3ec6-30d0-af11-1708a8258f22",
                                        "entry_id": "f681dacd-7d1f-3af9-a2db-354b696b5ba8",
                                        "glosses": [
                                            "Bandeau décoratif d’étoffe qui surmonte un décor de tapisserie ou des rideaux de fenêtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e117714c-ac9a-473e-a772-f02e28c8d082",
                                                "sense_id": "f4c08fae-3ec6-30d0-af11-1708a8258f22",
                                                "text": "Les lambrequins de l’atelier étaient baissés."
                                            },
                                            {
                                                "example_id": "dd6e497e-e32d-4835-9775-8da45324caf8",
                                                "sense_id": "f4c08fae-3ec6-30d0-af11-1708a8258f22",
                                                "text": "Trois lits en forme de corbillards et garnis de lambrequins jaunes fanés occupaient deux faces de la muraille."
                                            },
                                            {
                                                "example_id": "dd95a5b8-fb05-4315-aa00-72053755ee5c",
                                                "sense_id": "f4c08fae-3ec6-30d0-af11-1708a8258f22",
                                                "text": "Les avant-scènes restaient vides, drapées de lambrequins à longues franges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35c34b32-5ff8-4a1f-9038-a3debffbee0f",
                        "source_entry_id": "1fdc7db6-9cd2-3653-bb2d-a6b3ae536007",
                        "source_sense_id": "398bc075-60d4-332d-a0d6-05623dd01ccb",
                        "target_lang_word": "Lambrequin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3874b5ec-c44c-4912-9f7f-fb9cbb011f29",
                        "source_entry_id": "1fdc7db6-9cd2-3653-bb2d-a6b3ae536007",
                        "source_sense_id": "398bc075-60d4-332d-a0d6-05623dd01ccb",
                        "target_lang_word": "Schabracke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schabracke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0130fa9a-4b41-3ca7-8883-bbcb01424fad",
                                        "entry_id": "bd550fe4-dff0-3af2-a7d0-ef20adabfa6d",
                                        "glosses": [
                                            "eine besondere Form der Satteldecke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4a82106-ec4e-4a30-b8cb-484155acf7be",
                                                "sense_id": "0130fa9a-4b41-3ca7-8883-bbcb01424fad",
                                                "text": "Nun, der Herr Obrist hätte ebensogut einziehen können wie einer durch den Argen Trumph (Arc de triomphe), und ich hätte dem Schimmel die neue Schabracke aufgelegt - Zacker, der hätte die Ohren gespitzt!"
                                            },
                                            {
                                                "example_id": "7e763a08-ecd0-4936-a9ed-14448979dc7d",
                                                "sense_id": "0130fa9a-4b41-3ca7-8883-bbcb01424fad",
                                                "text": "Als die acht Tage herum waren, hatte sie eine wunderschöne Schabracke gestickt, mit der schickte sie ihn auf den Markt, er dürfe sie aber nicht anders geben als für fünfhundert Gulden."
                                            },
                                            {
                                                "example_id": "6c059435-9bbc-48ae-a898-9e84d9a09a28",
                                                "sense_id": "0130fa9a-4b41-3ca7-8883-bbcb01424fad",
                                                "text": "„Wer zu den Reitern will, muss ein Pferd mitbringen, auch einen Sattel mit Schabracke und einen Woilach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42af1cb1-a383-3d07-84a7-a2688dec082d",
                                        "entry_id": "bd550fe4-dff0-3af2-a7d0-ef20adabfa6d",
                                        "glosses": [
                                            "unattraktive, ungepflegte, auch streitsüchtige, zänkische oder ältere Frau, Ehefrau oder Schwiegermutter (Österreich, Deutschland: Niederrhein, Westfalen, Mitteldeutschland, Ostdeutschland)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eedc4bc5-5582-4116-a815-01fbf9e5a662",
                                                "sense_id": "42af1cb1-a383-3d07-84a7-a2688dec082d",
                                                "text": "Inzwischen ist aus der Diva eine Schabracke geworden. (Der Tagesspiegel online, Alte Diva ohne Partner, 19.12.2003)"
                                            },
                                            {
                                                "example_id": "4f762b0c-7c3a-48dd-a26e-d1c157e51f2d",
                                                "sense_id": "42af1cb1-a383-3d07-84a7-a2688dec082d",
                                                "text": "Mit aufgedonnerten Haaren, schwarz anlackiert und mit Strass-Schabracke als Kleidervorhang: Prädestiniert zur Tunten-Mutti der Nation, die sie in der Tat lange war."
                                            },
                                            {
                                                "example_id": "8288f755-1df5-4c5e-9e14-21518259895d",
                                                "sense_id": "42af1cb1-a383-3d07-84a7-a2688dec082d",
                                                "text": "„…sie hatte ihr Klavier zur Verfügung gestellt, die alte Schabracke, und ihren Salon, ihre Partituren…“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "faa180a2-e713-3feb-b790-e17125b205f0",
                                        "entry_id": "bd550fe4-dff0-3af2-a7d0-ef20adabfa6d",
                                        "glosses": [
                                            "Stoffleiste an der Gardinenleiste, Übergardine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9ce811-325f-44d0-88f1-436eddc6c656",
                                                "sense_id": "faa180a2-e713-3feb-b790-e17125b205f0",
                                                "text": "Verwendung findet alles – die silberne Halterung für die Troddeln, die im Wohnzimmer eine Schabracke zieren, waren einmal Joghurtbecher und der scheinbar uralte geraffte Vorhang eine Mülltüte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e0ddb209-9ad0-3a61-869d-67c6894ccaa2",
                                        "entry_id": "bd550fe4-dff0-3af2-a7d0-ef20adabfa6d",
                                        "glosses": [
                                            "Sattelfleck, ein Zeichnungsmuster bei mehreren Tierarten (abgeleitet von [1])"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
