                        "glosses": [
                            "Caractère angulaire, anguleux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "626f5a4f-21ef-4851-bb06-bb7b59f32983",
                                "sense_id": "fbbf23b5-81a6-3079-9f88-d632f7713f36",
                                "text": "L’angularité de l’écriture est un signe de rudesse, comme la prédominance des courbures est un signe de douceur."
                            },
                            {
                                "example_id": "b41d5e1c-6fcc-457f-9dc2-b7b35f21d4cf",
                                "sense_id": "fbbf23b5-81a6-3079-9f88-d632f7713f36",
                                "text": "C’est la raison pour laquelle l’angularité est peu recherchée pour les bétons. Pour ces usages, on préfère même souvent les granulats ronds."
                            },
                            {
                                "example_id": "b2161197-0978-4716-87ac-341cf2612764",
                                "sense_id": "fbbf23b5-81a6-3079-9f88-d632f7713f36",
                                "text": "L’angularité des granulats ne se mesure que sur des matériaux alluvionnaires ou marins."
                            }
                        ]
                    }
                ],
