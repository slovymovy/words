                                        "entry_id": "b088cd0f-c3af-35b2-916b-d0ca33d39687",
                                        "glosses": [
                                            "Lugar donde vive un conjunto de familias o una comunidad humana no muy numerosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7983fe1-714a-4961-9fe4-47e9d5836f3f",
                                                "sense_id": "758020b3-ae07-3faa-a624-09e18a50b8fd",
                                                "text": "«Y él hablará por ti al pueblo y será a ti por boca y tú serás a él por señor»."
                                            }
