                "entry_id": "d7f659ff-620c-3ed7-8e72-0a9df5311144",
                "word": "drupelet",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "03d9d1a7-6d20-4bae-b7e1-153d95575e6b",
                        "entry_id": "d7f659ff-620c-3ed7-8e72-0a9df5311144",
                        "tags": [
                            "plural"
                        ],
                        "form": "drupelets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e98b31cf-a9ed-3e39-b0a4-12cd4f756986",
                        "entry_id": "d7f659ff-620c-3ed7-8e72-0a9df5311144",
                        "glosses": [
                            "One of the small drupe-like subdivisions which compose the outer layer of certain fruit such as blackberries or raspberries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0e5a82e-5ef0-4b66-a3bb-25f3c27ac8e4",
                                "sense_id": "e98b31cf-a9ed-3e39-b0a4-12cd4f756986",
                                "text": "It is best to pick the berries while all drupelets are of a consistent, dark red coloration."
                            },
                            {
                                "example_id": "bd3f508a-3414-40bd-a807-678700c4cbf3",
                                "sense_id": "e98b31cf-a9ed-3e39-b0a4-12cd4f756986",
                                "text": "The passengers on the chock-full boat were packed across the deck like drupelets."
                            },
                            {
                                "example_id": "857ea7ab-b2b3-47a4-a957-275506402260",
                                "sense_id": "e98b31cf-a9ed-3e39-b0a4-12cd4f756986",
                                "text": "Aggregated Fruits are close clusters of simple fruits all of the same flower. The raspberry and blackberry are good examples. In these, each grain is a drupelet or stone-fruit, like a cherry or peach on a very small scale."
                            },
                            {
                                "example_id": "b2e688b1-162d-4912-ad36-3f815dcc19ce",
                                "sense_id": "e98b31cf-a9ed-3e39-b0a4-12cd4f756986",
                                "text": "The fruits of the genus Rubus (blackberry, raspberry) are aggregates of small drupes (drupelets) upon the receptacle of a single flower, each drupelet from a single pistil."
                            },
                            {
                                "example_id": "1ccc3aa5-5e24-4327-8162-d888a9ece876",
                                "sense_id": "e98b31cf-a9ed-3e39-b0a4-12cd4f756986",
                                "text": "Each fertilized pistil/ovule will develop into a fleshy drupelet containing one seed (a pyrene). Erect and semi-erect blackberry cultivars produce fruit with relatively large pyrenes compared to those of trailing blackberries."
                            }
                        ]
                    }
