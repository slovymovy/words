                                    {
                                        "sense_id": "225099c3-1704-303f-a09f-832ca8431d71",
                                        "entry_id": "835e6769-4d38-3e95-925e-12ad9357ec44",
                                        "glosses": [
                                            "mit der Hand schreibend/geschrieben"
