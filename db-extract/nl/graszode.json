                    },
                    {
                        "translation_id": "f73aeb97-56a7-43f5-9c9c-8a725d63e954",
                        "source_entry_id": "01689477-d093-3ee6-9483-39d87adf8c11",
                        "source_sense_id": "7a48ba97-92ed-3f9f-b021-a72c177f921b",
                        "target_lang_word": "sod of grass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "474f7e55-3c66-4d62-a767-1c4c0c4f7a35",
                        "source_entry_id": "01689477-d093-3ee6-9483-39d87adf8c11",
                        "source_sense_id": "7a48ba97-92ed-3f9f-b021-a72c177f921b",
                        "target_lang_word": "turf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77b621cb-88dc-324e-b400-9a05d296216b",
                                        "entry_id": "434c2c28-9aaa-376a-8da8-ae4ec75597df",
                                        "glosses": [
                                            "A layer of earth covered with grass; sod."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "742585f3-7cbf-471a-b055-be9b55708a9d",
                                                "sense_id": "77b621cb-88dc-324e-b400-9a05d296216b",
                                                "text": "Miss Thorn began digging up the turf with her lofter: it was a painful moment for me. ¶ “You might at least have tried me, Mrs. Cooke,” I said."
                                            },
                                            {
                                                "example_id": "54f2a69e-faa3-4700-a2dc-6ea22b48f238",
                                                "sense_id": "77b621cb-88dc-324e-b400-9a05d296216b",
                                                "text": "It was a sixth successive defeat for Klopp in a major final and at the final whistle, with Karius burying his face into the turf, there was not exactly a stampede of team-mates wanting to console him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df4831c5-26d3-3d4e-bdbd-9f1ebc2bcde7",
                                        "entry_id": "434c2c28-9aaa-376a-8da8-ae4ec75597df",
                                        "glosses": [
                                            "A piece of such a layer cut from the soil. May be used as sod to make a lawn, dried for peat, stacked to form earthen structures, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae2ad8f2-d360-4329-8ef7-350add08d065",
                                                "sense_id": "df4831c5-26d3-3d4e-bdbd-9f1ebc2bcde7",
                                                "text": "\"It's an old custom the people had when they bought and sold land. They used to cut out a clod and hand it over to the buyer, and you weren't lawfully seised of your land - it didn't really belong to you - till the other fellow had actually given you a piece of it - like this.\" He held out the turves."
                                            },
                                            {
                                                "example_id": "35e8adaa-e5ad-4a6c-a4c1-0d893adcc647",
                                                "sense_id": "df4831c5-26d3-3d4e-bdbd-9f1ebc2bcde7",
                                                "text": "Frodo and Sam went forward and saw that amidst the clamorous host were set three high-seats built of green turves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a19db3f-b4ea-3f15-953f-868ac92d27ae",
                                        "entry_id": "434c2c28-9aaa-376a-8da8-ae4ec75597df",
                                        "glosses": [
                                            "A block of peat used as fuel."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34de9a4d-8c41-437f-a42d-d7413ce6da81",
                                                "sense_id": "6a19db3f-b4ea-3f15-953f-868ac92d27ae",
                                                "text": "In ordinary peat-bogs, however, where turves are cut, there is always a large percentage of waste peat resulting from the digging, drying or transport of the turves, which can be utilized only by moulding it."
                                            },
                                            {
                                                "example_id": "42731a56-9acc-407f-9b0d-ec93a01a38eb",
                                                "sense_id": "6a19db3f-b4ea-3f15-953f-868ac92d27ae",
                                                "text": "[…] the fireman has to divide his time between getting up into the bunker to throw more turfs into the cab, and getting down on his hands and knees to get it into the firebox, and even then a reserve supply of turf must be carried on a truck behind the engine, and stops must be made on each steep ascent to raise more steam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af7f504c-e1c6-38f7-b875-d9c53ef05b57",
                                        "entry_id": "434c2c28-9aaa-376a-8da8-ae4ec75597df",
                                        "glosses": [
                                            "A thick, carpet-like bed of algae."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10391f7-704b-46aa-86ae-1df11cd56c1f",
                                                "sense_id": "af7f504c-e1c6-38f7-b875-d9c53ef05b57",
                                                "text": "The turf layer is made up of filamentous and thallose red algae."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418bcd24-5c1b-3c95-a9c8-1f059c7017c7",
                                        "entry_id": "434c2c28-9aaa-376a-8da8-ae4ec75597df",
                                        "glosses": [
                                            "A surface of synthetic fibers made to look like grass; artificial turf."
                                        ],
                                        "tags": [
                                            "specifically",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aef76b0c-155f-442a-b677-d81efb11c446",
                                                "sense_id": "418bcd24-5c1b-3c95-a9c8-1f059c7017c7",
                                                "text": "In climates where grass struggles to grow, turf is usually used instead on sports fields."
                                            },
                                            {
                                                "example_id": "16ab9d5c-344d-408c-984f-089f0e8f50f1",
                                                "sense_id": "418bcd24-5c1b-3c95-a9c8-1f059c7017c7",
                                                "text": "The Niners have nine games left on the schedule, and only one visit to a turf field. That turf in Seattle is not slit film; while the NFL admits slit film fields lead to more ankle sprains, the league insists that turf is otherwise no more dangerous than grass."
                                            },
                                            {
                                                "example_id": "009ccbd4-b81e-4f5e-8aed-a1c12c5ba4f6",
                                                "sense_id": "418bcd24-5c1b-3c95-a9c8-1f059c7017c7",
                                                "text": "And accommodating all those events has made it harder and harder for teams to maintain grass fields. It's easier, cheaper and less time-consuming just to throw turf down and call it a day, hence artificial surfaces popping up even in outdoor stadiums and Sun-Belt cities such as Charlotte, N.C., and Nashville, Tenn."
                                            },
                                            {
                                                "example_id": "25f9d08b-8eb0-4438-bb18-a6181fd5f180",
                                                "sense_id": "418bcd24-5c1b-3c95-a9c8-1f059c7017c7",
                                                "text": "Thunder Bay Coun. Mark Bentz has put forward a referral of a motion that would see the indoor turf facility capped at around $30 million. Councillors voted in favour of the decision, which will see further consultations with user groups about how to re-scope the project."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5bb807e-25f3-32db-ab1a-333dc935e7fe",
                                        "entry_id": "434c2c28-9aaa-376a-8da8-ae4ec75597df",
                                        "glosses": [
                                            "A territory claimed by a gang as their own."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
