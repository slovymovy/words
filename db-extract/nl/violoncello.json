                                                "sense_id": "b6b396f3-0c2f-35d5-9807-4143d10dc2a0",
                                                "text": "Chocolates arranged in a candy dish or basket, antique or purchased in accordance to^([sic]) the personal taste of the host/hostess, wrapped with cello wrap and tied with a lovely ribbon—decadent!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
