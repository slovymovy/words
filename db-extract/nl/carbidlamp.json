                "translations": [
                    {
                        "translation_id": "afa73fc0-19e2-46bb-bc26-124f15591d68",
                        "source_entry_id": "5d6d74b8-1614-3a3e-bebe-6da8d3b63f71",
                        "source_sense_id": "98e100f6-7299-36ff-88b8-1afc80809d64",
                        "source_sense_description": "carbidlamp",
                        "target_lang_word": "Karbidlampe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karbidlampe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21a9df01-7f7c-3a00-8f00-dc83d9de7bfa",
                                        "entry_id": "7a06ed91-77e8-331d-a19c-199be0167daf",
                                        "glosses": [
                                            "häufig beim Bergbau oder bei der Höhlenforschung eingesetzte Lampe, bei der Ethin-Gas, das Reaktionsprodukt von Calciumcarbid und Wasser, verbrannt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efbefc38-79a1-4ebe-8a27-6979cabe3ce8",
                                                "sense_id": "21a9df01-7f7c-3a00-8f00-dc83d9de7bfa",
                                                "text": "„Vor allem in der Höhlenforschung werden weiterhin auch Karbidlampen eingesetzt, da diese eine Rundumbeleuchtung ermöglichen.“"
                                            },
                                            {
                                                "example_id": "49087e62-4472-437a-880a-41a8c3242a7c",
                                                "sense_id": "21a9df01-7f7c-3a00-8f00-dc83d9de7bfa",
                                                "text": "„Das kreidige Licht einer Karbidlampe flackert über sein Gesicht.“"
                                            },
                                            {
                                                "example_id": "ba9cfca3-d63a-448f-9739-d202fffcf3dc",
                                                "sense_id": "21a9df01-7f7c-3a00-8f00-dc83d9de7bfa",
                                                "text": "„Rechts waren zwei Ärzte bei hellweißen Karbidlampen mit einem entblößten Oberschenkel beschäftigt.“"
                                            },
                                            {
                                                "example_id": "3315e4fb-baeb-43dd-9e9a-2223aa886d20",
                                                "sense_id": "21a9df01-7f7c-3a00-8f00-dc83d9de7bfa",
                                                "text": "„Aber oft habe ich das leichte Glitzern gesehen, das während der Stromsperre unaufhörlich schien und flackerte – es schien dauernd Stromsperre zu herrschen – und das einzige Licht in dem Dämmern und den Schatten des Zimmers kam von einem kleinen Kerzenstumpf oder von der niedrigen Flamme einer Karbidlampe, die Knoblauchgeruch verbreitete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
