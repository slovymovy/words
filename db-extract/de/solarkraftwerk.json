                "senses": [
                    {
                        "sense_id": "ce232468-d9b0-3585-835a-beeba8f2f10e",
                        "entry_id": "57e1b508-79a2-34b3-83fc-d1567e98f575",
                        "glosses": [
                            "technische Anlage, in der die Sonneneinstrahlung in elektrischen Strom umgewandelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5af39493-bebb-4859-8655-209fea9bde0b",
                                "sense_id": "ce232468-d9b0-3585-835a-beeba8f2f10e",
                                "text": "Allerdings scheinen die angekündigten Maßnahmen eher kosmetisch zu sein: Ein ohnehin geplantes Solarkraftwerk wird gebaut, die Forschung zur \"Säuberung\" der Kohle subventioniert."
                            },
                            {
                                "example_id": "a478ca33-32a3-4e77-8ff6-acf19688ccad",
                                "sense_id": "ce232468-d9b0-3585-835a-beeba8f2f10e",
                                "text": "„Mit dem industriellen Solarkraftwerk will Heliovis sukzessive auch auf andere Märkte expandieren.“"
                            },
                            {
                                "example_id": "f2e0f0bc-3316-4e40-9ab0-3d44bd4fe414",
                                "sense_id": "ce232468-d9b0-3585-835a-beeba8f2f10e",
                                "text": "„Bis 2013 gab es kein einziges funktionierendes Solarkraftwerk in den Emiraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
