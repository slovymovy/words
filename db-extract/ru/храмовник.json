                                "target_senses": [
                                    {
                                        "sense_id": "66507217-9fc3-3c04-9dca-a0fb42573eb2",
                                        "entry_id": "41a6732d-764e-3ee9-9dd7-0301b58420c9",
                                        "glosses": [
                                            "A knightly member of the crusader age military order of Templars"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5137e261-7100-4060-b859-a4a2f1a4927a",
                                                "sense_id": "66507217-9fc3-3c04-9dca-a0fb42573eb2",
                                                "text": "[T]he ſame Caſtels were delyuered into the handes of Roberte de Poyꝛon, Toſtes de Saint Omer, and Roberte Haſtings, thꝛee Knightes templers, […]"
                                            },
                                            {
                                                "example_id": "dc7fa247-d1a6-4253-b463-7f0b66fd15ed",
                                                "sense_id": "66507217-9fc3-3c04-9dca-a0fb42573eb2",
                                                "text": "Heraclius patriarcha Hierosolymitanus ecclesiam militibus Templariis consecravit, […]"
                                            },
                                            {
                                                "example_id": "27c2ba3e-6f91-440c-bdd0-fe11665bec85",
                                                "sense_id": "66507217-9fc3-3c04-9dca-a0fb42573eb2",
                                                "text": "The rest of Prince John’s retinue consisted of the favourite leaders of his mercenary troops, some marauding barons and profligate attendants upon the court, with several Knights Templars and Knights of St John."
                                            },
                                            {
                                                "example_id": "9399e6c4-54bf-4dfc-bd29-ffbbcdc2f79d",
                                                "sense_id": "66507217-9fc3-3c04-9dca-a0fb42573eb2",
                                                "text": "Following these conversions, the Knights Templars noted their exhaustion from the wearisome Crusade which began over two years earlier in Rome. The French knight mentioned how he longed to once again see Friar Peter the Meek; as he too was a member of the original crusading party selected by Pope Boniface VIII and King Horik. Both Knights Templars took pride in their close friendship with the Irish monk; […]"
                                            }
                                        ]
                                    },
