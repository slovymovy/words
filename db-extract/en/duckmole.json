                    {
                        "sense_id": "adc36ded-77ef-3c9c-859b-97a306a6c78f",
                        "entry_id": "a294b2b1-2608-3049-b1f6-ecae5ddf9090",
                        "glosses": [
                            "Synonym of platypus."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c8367691-8369-44f5-9fac-7ef33e11c4ef",
                                "sense_id": "adc36ded-77ef-3c9c-859b-97a306a6c78f",
                                "text": "We can form a fairly clear idea from the duckmole and the kangaroo how the whole class of mammals have arisen from reptiles, but when we turn to geology we find the case greatly strengthened."
                            },
                            {
                                "example_id": "76bc69bc-6dd5-44ec-96dc-3a2ed915df47",
                                "sense_id": "adc36ded-77ef-3c9c-859b-97a306a6c78f",
                                "text": "“Duckmoles? I never heard of them.” His fleshy bill was the same shape as a duck's, but with comblike ridges inside the bottom half. “May I pick you up?” He nodded. “Mind the spurs on my hind feet, though. I've poison in them.”"
                            },
                            {
                                "example_id": "0035db30-b42f-4e14-b4b3-655f38e220ad",
                                "sense_id": "adc36ded-77ef-3c9c-859b-97a306a6c78f",
                                "text": "“Tell me, sir,” she says, “does this duckmole, does it quack?”"
                            }
                        ]
                    }
