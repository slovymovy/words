                    {
                        "form_id": "0c5a99ba-50ef-42eb-91a5-2b110d14d2e1",
                        "entry_id": "20ee5470-e748-3a2e-8d16-966d12c5fb2f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Amigos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "60a712cd-555d-3ff9-aeb3-598c7ef2e62f",
                        "entry_id": "20ee5470-e748-3a2e-8d16-966d12c5fb2f",
                        "glosses": [
                            "Person, die als Gönner und Freund eines Politikers auftritt und diesem etwa in Form von Geschenken zu Gefallen ist, weil sie sich davon Vorteile (für das eigene Unternehmen) erhofft"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "d16936a0-9f4d-4e3d-ac18-9e5d8c3413df",
                                "sense_id": "60a712cd-555d-3ff9-aeb3-598c7ef2e62f",
                                "text": "„Das alte Bayern, das Franz-Josef-Strauß-Bayern, das Bayern der Amigos und der Spezlwirtschaft, in dem ein Fall wie der von Uli Hoeneß mit ziemlicher Wahrscheinlichkeit nicht in die Öffentlichkeit gelangt wäre - dieses Bayern feiert gerade ein Comeback.“"
                            },
                            {
                                "example_id": "2a1db40a-b1ba-46af-9483-e72ffeba37d7",
                                "sense_id": "60a712cd-555d-3ff9-aeb3-598c7ef2e62f",
                                "text": "„Immer neue Details zu der Affäre, die fast täglich bekannt werden, verstärken aber den Eindruck, dass Wulff noch immer nicht die volle Wahrheit gesagt hat über seinen mehr als fragwürdigen Umgang mit geldwerten Angeboten seiner Amigos aus der Geschäftswelt.“"
                            },
                            {
                                "example_id": "dffebf46-d465-4fb0-bd97-e3d5cac01416",
                                "sense_id": "60a712cd-555d-3ff9-aeb3-598c7ef2e62f",
                                "text": "„Die viel vermissten und zu Heroen stilisierten Spitzenvertreter vergangener Zeiten pflegten im Umgang mit Spenden, Unternehmern und anderen Amigos Usancen, die heute zur Dezimierung der politischen Klasse führen würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "70b583ab-5332-3f96-b9ba-1dccb7c1bf06",
                        "entry_id": "20ee5470-e748-3a2e-8d16-966d12c5fb2f",
                        "glosses": [
                            "mehr oder weniger korrupter (bayerischer) Politiker"
                        ],
                        "tags": [
                            "umgangssprachlich,",
                            "spöttisch",
                            "abfällig"
                        ],
                        "examples": [
                            {
                                "example_id": "326cb037-3d2e-46e2-954c-6c26705dfd09",
                                "sense_id": "70b583ab-5332-3f96-b9ba-1dccb7c1bf06",
                                "text": "„Schon nach dem Tod von Franz Josef Strauß 1987 und nach dem Rücktritt des Amigos Streibl 1993 wandten sich viele Wähler von der CSU ab.“"
                            },
                            {
                                "example_id": "4ad1d001-868c-4a9b-92e0-a7847d686f0e",
                                "sense_id": "70b583ab-5332-3f96-b9ba-1dccb7c1bf06",
                                "text": "„Der Staatssekretär Schellenbaum, CSU-Mann, Typ jovialer Amigo, fährt mit seinem dicken BMW einen glücklosen Drehbuchschreiber über den Haufen und versucht, die Schuld, weil es für ihn praktischer ist und gottlob nichts Schlimmes passiert ist, seinem Chauffeur in die Schuhe zu schieben […].“"
                            },
                            {
                                "example_id": "96f77e2e-04fd-4470-b5b9-335da3cfc52e",
                                "sense_id": "70b583ab-5332-3f96-b9ba-1dccb7c1bf06",
                                "text": "„Man kann den Amigos in München vieles vorwerfen – doch gewiss nicht solch schauderhafte Unprofessionalität, wie sie die rechten Fundis in Kärnten bei ihrem Putsch an den Tag gelegt haben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b2a8eece-1c1e-36e1-9a83-027f29ffe82d",
                        "entry_id": "20ee5470-e748-3a2e-8d16-966d12c5fb2f",
                        "glosses": [
