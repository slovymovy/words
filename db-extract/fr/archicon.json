                        "cross_references": [
                            {
                                "target_word": "stupid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fa72d1e-3a21-32ed-8217-728e774a2ab4",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "Without intelligence.",
                                            "Lacking in intelligence."
                                        ],
                                        "tags": [
                                            "of animates"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15a358ca-c863-459f-a39b-f0f49c59594a",
                                                "sense_id": "5fa72d1e-3a21-32ed-8217-728e774a2ab4",
                                                "text": "It got trapped in the fishing net because it's a big stupid jellyfish!"
                                            },
                                            {
                                                "example_id": "23aac160-0b8f-4e0d-ac68-fa32fd2114c7",
                                                "sense_id": "5fa72d1e-3a21-32ed-8217-728e774a2ab4",
                                                "text": "And it would be a fine proposition\nIf I was a stupid girl\nBut honey, I am no one's exception\nThis I have previously learned"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3af5529-4f6d-3927-a72b-72eb96ee1293",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "Without intelligence.",
                                            "Exhibiting the quality of having been done by someone lacking in intelligence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5395b0b1-9564-4e90-aa21-ad9e11832215",
                                                "sense_id": "e3af5529-4f6d-3927-a72b-72eb96ee1293",
                                                "text": "So I have to pay first, and then wait in line? That's a stupid rule!"
                                            },
                                            {
                                                "example_id": "12e965f3-fc82-4ebb-b0e0-2c21a85e719f",
                                                "sense_id": "e3af5529-4f6d-3927-a72b-72eb96ee1293",
                                                "text": "He made the stupid decision of standing in a half-hour queue for a hamburger, instead of calling ahead."
                                            },
                                            {
                                                "example_id": "92cc0b6d-fccb-4274-b7ee-87c13c4b83f5",
                                                "sense_id": "e3af5529-4f6d-3927-a72b-72eb96ee1293",
                                                "text": "I should have spoke to him there and then, seen he was in the mood to do something stupid."
                                            },
                                            {
                                                "example_id": "8cba2915-5545-4254-ad6c-fc74c10dd0f5",
                                                "sense_id": "e3af5529-4f6d-3927-a72b-72eb96ee1293",
                                                "text": "You can kiss a hundred boys in bars\nShoot another shot, try to stop the feeling\nYou can say it's just the way you are\nMake a new excuse, another stupid reason"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2edf86a-b86b-3552-873c-10c4cf22333f",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "Without intelligence.",
                                            "Unpleasant; annoying to the speaker. This sense can be used alongside obscene words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8549b3a3-dd7c-454e-9710-15b7f68704a7",
                                                "sense_id": "b2edf86a-b86b-3552-873c-10c4cf22333f",
                                                "text": "The stupid rusty wire cut my thumb when I grabbed it."
                                            },
                                            {
                                                "example_id": "62d9222a-fcb0-49aa-ac4a-a6082b065755",
                                                "sense_id": "b2edf86a-b86b-3552-873c-10c4cf22333f",
                                                "text": "Marcie Linguini, who had come down with a stupid ear infection the day of Thanksgiving vacation, curled deeper into her bed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d816310e-be3f-3246-a284-4b3db89f8825",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "Without intelligence.",
                                            "Usually replaces an obscene or profane word, and thus is audibly stressed as such."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b3f99b-145f-4cec-ab8b-f027d846e84e",
                                                "sense_id": "d816310e-be3f-3246-a284-4b3db89f8825",
                                                "text": "I fall for every stupid trick every stupid day in this whole stupid world!"
                                            },
                                            {
                                                "example_id": "5a038a85-6c47-470f-9e74-cb3f8b534cc8",
                                                "sense_id": "d816310e-be3f-3246-a284-4b3db89f8825",
                                                "text": "Mom: Oh you stupid car! What's wrong with you now?!?\nCalvin: That's it, Mom! Go ahead and swear! We don't mind!"
                                            },
                                            {
                                                "example_id": "b07262c5-b593-4ed5-b2a3-64da5c0f7e3f",
                                                "sense_id": "d816310e-be3f-3246-a284-4b3db89f8825",
                                                "text": "Calvin, be quiet and eat the stupid lima beans."
                                            },
                                            {
                                                "example_id": "e87e7ca7-19e7-46fa-ac64-4f4fcde37902",
                                                "sense_id": "d816310e-be3f-3246-a284-4b3db89f8825",
                                                "text": "Dewey: \"It's too narrow for all three of us. Oh, bummer!\"\nHuey: \"Or we could just go single file.\"\nDewey: \"Stupid smart Huey...\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9426cc5b-ac7a-3385-a69b-1aa12e6bd6fd",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "To the point of stupor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2966524b-5ff9-46cf-bfd6-e649b0cc804b",
                                                "sense_id": "9426cc5b-ac7a-3385-a69b-1aa12e6bd6fd",
                                                "text": "Neurobiology bores me stupid."
                                            },
                                            {
                                                "example_id": "d40bf941-f128-47da-b500-97114a99387c",
                                                "sense_id": "9426cc5b-ac7a-3385-a69b-1aa12e6bd6fd",
                                                "text": "I am not sure if he is stupid with tiredness or inebriety."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da3083ed-da25-3ad6-9c93-0c40a40e7ebd",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "To the point of stupor.",
                                            "Characterized by or in a state of stupor; paralysed."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "618ae368-f71f-41d9-b6ab-79d1a8a95d6d",
                                                "sense_id": "da3083ed-da25-3ad6-9c93-0c40a40e7ebd",
                                                "text": "No sigh to rise, no tear had pow'r to flow, Fix'd in a stupid lethargy of woe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d022961e-9f6b-3708-be42-2096e7fcbed7",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "To the point of stupor.",
                                            "Lacking sensation; inanimate; destitute of consciousness; insensate."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29fa1e0b-b76d-49d7-8a86-2f5786dec421",
                                                "sense_id": "d022961e-9f6b-3708-be42-2096e7fcbed7",
                                                "text": "Were it not for [fire], the whole wou'd be one great stupid inanimate mass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd87ee97-0944-368f-ad70-02dcc4833661",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "To the point of stupor.",
                                            "Dulled in feeling or sensation; torpid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498da3cf-fd5e-497d-848f-d80dbbf45fa3",
                                                "sense_id": "bd87ee97-0944-368f-ad70-02dcc4833661",
                                                "text": "She had never seen Frank Churchill so silent and stupid. He said nothing worth hearing—looked without seeing—admired without intelligence—listened without knowing what she said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ad44866-ecc9-31bd-9f04-6fbb8508277a",
                                        "entry_id": "2e2526d9-062c-3d49-bdac-70c0dd6c728c",
                                        "glosses": [
                                            "Amazing."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "044e9151-cfbd-4025-ba53-1c368bb104ed",
                                                "sense_id": "3ad44866-ecc9-31bd-9f04-6fbb8508277a",
                                                "text": "That dunk was stupid! His head was above the rim!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stupid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d998cbf-15e0-3b94-87d7-762504e2f79e",
                                        "entry_id": "a3b89ea8-6ebd-3492-b4e3-cec1629b6a92",
                                        "glosses": [
                                            "Extremely."
