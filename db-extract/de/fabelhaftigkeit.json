                "senses": [
                    {
                        "sense_id": "ea4bee91-a1ff-359e-a51e-6deb2e7dd848",
                        "entry_id": "8374a4f7-2ddb-34f7-b4ff-663df9b31c53",
                        "glosses": [
                            "Eigenschaft, besonders gut, sehr schön zu sein"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "046f1ef7-63ea-41fd-8ca9-feb7aa758c15",
                                "sense_id": "ea4bee91-a1ff-359e-a51e-6deb2e7dd848",
                                "text": "„Unter dem Titel ‚Wild/Schön‘ sind rund 120 Werke zu sehen, die die Fabelhaftigkeit, die Mystifizierung aber auch die Ausbeutung und die Unterdrückung von Tiere zeigen.“"
                            },
                            {
                                "example_id": "b420fe79-e88b-465f-ad5a-6dc334558bc4",
                                "sense_id": "ea4bee91-a1ff-359e-a51e-6deb2e7dd848",
                                "text": "„Delvey hatte alles, was in New York zählte: gutes Aussehen, die richtigen Freunde, die richtigen Kontakte, und genug Geld, um diese von ihrer Fabelhaftigkeit zu überzeugen.“"
                            },
                            {
                                "example_id": "062fde12-b165-4492-9a6d-fa697a513eb7",
                                "sense_id": "ea4bee91-a1ff-359e-a51e-6deb2e7dd848",
                                "text": "„Aber man muss wissen: All die breit ausgestellte Fabelhaftigkeit in Rawvanas Leben hat angeblich wesentlich damit zu tun, dass sie sich leidenschaftlich zu einem veganen Lebensstil bekennt und diesen mit aller Macht bewirbt – und das in seiner noch radikaleren Rohkost-Variante: kein Fleisch oder Fisch, keine Milchprodukte, keine Eier sowie überhaupt nur Lebensmittel, die nicht über 45 Grad erhitzt wurden.“"
                            }
                        ],
