                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45de5ebd-2a11-43a3-9346-fe90847a6e35",
                                                "sense_id": "15fd4c25-f8dd-3c38-9e42-c546dea24a84",
                                                "text": "Der Verkäufer wusste schon, warum er den Wagen loswerden wollte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9b00c14a-bc29-36fc-882f-09efc97aa146",
                                        "entry_id": "2cf11218-3b65-35da-80c5-e144c726272d",
                                        "glosses": [
                                            "jemand, der etwas gewerbsmäßig verkauft"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c47b2e25-5052-4e0f-899d-5e252d96e5e4",
                                                "sense_id": "9b00c14a-bc29-36fc-882f-09efc97aa146",
                                                "text": "Er ist Verkäufer im Kaufhaus Puvogel."
                                            },
                                            {
                                                "example_id": "3aaf5a16-33c5-4e21-8a00-05beb07ed490",
                                                "sense_id": "9b00c14a-bc29-36fc-882f-09efc97aa146",
                                                "text": "„Türen klappen auf, Verkäufer springen auf, sie bieten Bananen, Erdnüsse, Cola, Wasser an.“"
                                            },
                                            {
                                                "example_id": "de02263a-dc75-4434-ada8-ac9567102841",
                                                "sense_id": "9b00c14a-bc29-36fc-882f-09efc97aa146",
                                                "text": "„Der Verkäufer, höchstens sechzehn Jahre alt, zieht ein Handy aus der Hosentasche und tippt darauf herum.“"
                                            },
                                            {
                                                "example_id": "ddd1e839-9068-49b7-8d66-af881c055db1",
                                                "sense_id": "9b00c14a-bc29-36fc-882f-09efc97aa146",
                                                "text": "„Während dieser Unterhaltung war ein Verkäufer von Melonenkernen hinzugetreten.“"
                                            },
                                            {
                                                "example_id": "fbe34839-8eda-48ad-965a-bbfcfb177290",
                                                "sense_id": "9b00c14a-bc29-36fc-882f-09efc97aa146",
                                                "text": "„Der Verkäufer machte ein entzücktes Gesicht und tänzelte um mich herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
