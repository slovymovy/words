                "entry_id": "02c82cc1-13ad-35ca-9617-6f613fa08025",
                "word": "slumlord",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "957e2d0e-ecef-4edb-9f17-fc822ac59667",
                        "entry_id": "02c82cc1-13ad-35ca-9617-6f613fa08025",
                        "tags": [
                            "plural"
                        ],
                        "form": "slumlords"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f18b68c-1f7a-385a-ac03-d8ff9bd9409e",
                        "entry_id": "02c82cc1-13ad-35ca-9617-6f613fa08025",
                        "glosses": [
                            "A person who makes money by renting housing that is kept in poor condition."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "dd41d635-dd98-4d29-8114-bb3b625a06b9",
                                "sense_id": "9f18b68c-1f7a-385a-ac03-d8ff9bd9409e",
                                "text": "Coordinate term: slumlady"
                            },
                            {
                                "example_id": "bc1ca0dd-27b0-4e9f-a13a-1a0c4a333d11",
                                "sense_id": "9f18b68c-1f7a-385a-ac03-d8ff9bd9409e",
                                "text": "The slumlord was collecting over $100 a month for this horrible place."
                            },
                            {
                                "example_id": "b1da8352-3266-41d1-86c8-ebd874aa1302",
                                "sense_id": "9f18b68c-1f7a-385a-ac03-d8ff9bd9409e",
                                "text": "The first rule in the slumlord business is: “The poorer the tenant, the bigger the profit!” The explanation is simplicity itself. For example, a poor family needs a two-room apartment, but can't afford the $40.00 a month rent. So you divide the two rooms into four smaller apartments, and rent each one for $20.00 a month. The poor families are happy with the low rent, and the slumlord is happy with the increased profit."
                            },
                            {
                                "example_id": "6a93f759-ff43-4dca-a7b2-a198adbc6c7a",
                                "sense_id": "9f18b68c-1f7a-385a-ac03-d8ff9bd9409e",
                                "text": "The guy's a real bastard, a real slumlord. He never did anything to maintain the place. He wouldn't give us a written lease—we only had a verbal agreement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99e195a4-0506-41ed-b572-7a8d6f05f818",
                        "source_entry_id": "02c82cc1-13ad-35ca-9617-6f613fa08025",
