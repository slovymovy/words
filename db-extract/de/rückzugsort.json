                ],
                "senses": [
                    {
                        "sense_id": "aa7fc603-350c-3505-8e30-ee92b9131f50",
                        "entry_id": "5ca56f16-935f-35c5-9122-358f91ec9bcf",
                        "glosses": [
                            "lokalisierbarer, begrenzter Platz, an dem das Zurückweichen vor einem meist überlegenen Gegner möglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f9e063f-214b-495a-b79e-8ff3ff5a101c",
                                "sense_id": "aa7fc603-350c-3505-8e30-ee92b9131f50",
                                "text": "Mein Rückzugsort ist die Natur."
                            },
                            {
                                "example_id": "1ecf7c59-82b3-4041-91c4-22774b86c657",
                                "sense_id": "aa7fc603-350c-3505-8e30-ee92b9131f50",
                                "text": "„Paris wird Jünger, während der Krieg den Kontinent verheert, zu einem einigermaßen sicheren Rückzugsort, zu einer Gegenwelt des Geistes und der Kunst.“"
                            },
                            {
                                "example_id": "30337223-e604-4c36-95dc-f586869ce930",
                                "sense_id": "aa7fc603-350c-3505-8e30-ee92b9131f50",
                                "text": "„Immerhin hatte sie auch einen Rückzugsort, der sie nichts kostete: das Haus von Adriennes Eltern in Rocfoin, wo sie bis September bleiben wollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
