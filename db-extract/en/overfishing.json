                "word": "overfishing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d5bab46e-ad97-4b46-822b-b68831a446ff",
                        "entry_id": "d27334e8-4906-3b2f-9967-9c3fbfe164f3",
                        "tags": [
                            "plural"
                        ],
                        "form": "overfishings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b84a5fd-780f-3e21-aced-278ccb279f9e",
                        "entry_id": "d27334e8-4906-3b2f-9967-9c3fbfe164f3",
                        "glosses": [
                            "Fishing that reduces the stock of remaining fish in an area to below that which is acceptable."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "46ccfc79-dd22-4948-aa23-478272fcfe5d",
                                "sense_id": "4b84a5fd-780f-3e21-aced-278ccb279f9e",
                                "text": "Most of the overfishings in the international sense are a product of misuse."
                            },
                            {
                                "example_id": "324098df-8562-4052-b37f-ab57f3029fde",
                                "sense_id": "4b84a5fd-780f-3e21-aced-278ccb279f9e",
                                "text": "The dawn of the oil age was fairly recent. Although the stuff was used to waterproof boats in the Middle East 6,000 years ago, extracting it in earnest began only in 1859 after an oil strike in Pennsylvania.[…]It was used to make kerosene, the main fuel for artificial lighting after overfishing led to a shortage of whale blubber. Other liquids produced in the refining process, too unstable or smoky for lamplight, were burned or dumped."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3129655-de45-4c78-b807-d86dd12414a5",
                        "source_entry_id": "d27334e8-4906-3b2f-9967-9c3fbfe164f3",
                        "source_sense_id": "4b84a5fd-780f-3e21-aced-278ccb279f9e",
                        "source_sense_description": "excessive fishing",
                        "target_lang_word": "overbevissing",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overbevissing",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2e043faa-5c12-3a37-8f98-458a6e53450c",
                                        "entry_id": "6c59b399-7985-328f-8653-d6569cece8bf",
                                        "glosses": [
                                            "het verschijnsel dat te veel vis in een bepaald gebied gevangen wordt, wat leidt tot het verdwijnen van die vissoort in dat gebied"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a291764-c80a-4e74-bc4f-ad8c44df33b5",
                                                "sense_id": "2e043faa-5c12-3a37-8f98-458a6e53450c",
                                                "text": "Voor de vader zou de vishandel nooit meer worden wat hij geweest was. Vervuild water, overbevissing, corrupte visafslag - alles kapot."
                                            },
                                            {
                                                "example_id": "dd814c89-b612-4936-a2a6-061eb29b7824",
                                                "sense_id": "2e043faa-5c12-3a37-8f98-458a6e53450c",
                                                "text": "De vis is uitgestorven door toedoen van de mens, concluderen Chinese onderzoekers. De vissoort wist 200 miljoen jaar te overleven en was tot de jaren 70 een normale verschijning in de Jangtsekiang. Overbevissing en het aanleggen van dammen in de rivier hebben er vermoedelijk voor gezorgd dat er een einde aan de Chinese lepelsteur gekomen is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
