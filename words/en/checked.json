                },
                {
                    "sense_id": "144b4ea1-b7c6-3f0e-987b-011a7cfa4761",
                    "sense_definition": "Of a consonant, produced with a glottal constriction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The phonetician identified several <w>checked</w> consonants in the dialect.",
                            "target_lang_translations": {
                                "ru": "Фонетист выявил в диалекте несколько <w>глоттализованных</w> согласных."
                            }
