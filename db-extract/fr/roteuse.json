                        "examples": [
                            {
                                "example_id": "b934a6bd-e86e-4406-8052-05fb2a5245e1",
                                "sense_id": "b5f458db-896d-3dd5-86a4-f00562d941fc",
                                "text": "Tout de même, auparavant, ils vont chercher deux trois roteuses, les louchébems, pour qu’on se requinque…Veuve Clicquot brut et biscuits roses."
                            },
                            {
                                "example_id": "0ea2b37e-a7fc-401f-b4b0-da6bd351caaf",
                                "sense_id": "b5f458db-896d-3dd5-86a4-f00562d941fc",
                                "text": "Pour avoir passé trop de noyes dans les casinos, éclusé trop de roteuses, frotté trop de tangos, ronflé dans trop de palaces et gigoté dans une infinité de pageots, Nora aspirait plus qu’à la vie en veilleuse, au ralenti demi-teinte."
                            },
                            {
                                "example_id": "90b7a629-ceaa-482a-adc4-1a64adacd017",
                                "sense_id": "b5f458db-896d-3dd5-86a4-f00562d941fc",
                                "text": "Ça s’arrose... On va décalotter une roteuse..."
                            }
                        ]
                    }
