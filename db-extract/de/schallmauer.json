                    {
                        "sense_id": "68a53001-64e0-37cf-b5b8-fb95580f62d0",
                        "entry_id": "484638a1-51ac-3973-9e75-1485e888cea6",
                        "glosses": [
                            "Aeronautik, Akustik: bildhafter Begriff für einen aerodynamischen Widerstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bae67931-f3a3-484c-945b-7e016b1b8909",
                                "sense_id": "68a53001-64e0-37cf-b5b8-fb95580f62d0",
                                "text": "Chuck Yeager hat als erster Mensch nachweislich die Schallmauer durchbrochen."
                            },
                            {
                                "example_id": "92f0d1fa-dade-4045-910f-c0954fa0e15f",
                                "sense_id": "68a53001-64e0-37cf-b5b8-fb95580f62d0",
                                "text": "„Er durchbrach in aufreizender Unverschämtheit die über meinem Haus befindliche Schallmauer und verursachte dabei einen Knall, der als überwältigend bezeichnet werden muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f5c61ec-7de7-40d5-89fd-181e265e504b",
                        "source_entry_id": "484638a1-51ac-3973-9e75-1485e888cea6",
                        "source_sense_id": "68a53001-64e0-37cf-b5b8-fb95580f62d0",
                        "source_sense_description": "Aeronautik, Akustik: bildhafter Begriff für einen aerodynamischen Widerstand",
                        "target_lang_word": "sound barrier",
