                "senses": [
                    {
                        "sense_id": "93119b2a-5538-33f5-ab67-1f2c78bf95c7",
                        "entry_id": "83e039bc-9087-3c1c-8c8b-47a9f6895d12",
                        "glosses": [
                            "Teil des Beins eines Lamms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28ef0ef9-a575-4543-bd69-ecbeda30e357",
                                "sense_id": "93119b2a-5538-33f5-ab67-1f2c78bf95c7",
                                "text": "Wir kaufen beim Fleischer Lammkeulen."
                            },
                            {
                                "example_id": "ba888dfb-5ffd-46fa-8d50-c77e6d8985ed",
                                "sense_id": "93119b2a-5538-33f5-ab67-1f2c78bf95c7",
                                "text": "„Am Rand des Tisches im Vordergrund liegen zwei Stücke Fleisch, eine große Lammkeule und ein kleines Kotelett.“"
                            },
                            {
                                "example_id": "5dbe69f1-bd1c-4bf2-a004-f0c09f9d12ba",
                                "sense_id": "93119b2a-5538-33f5-ab67-1f2c78bf95c7",
                                "text": "„Hafrún backte Schokoladenkuchen, goss Kaffee auf, briet ein Hühnchen, eine Lammkeule, und beim Abendessen erstatteten sie ihr Bericht über das, was sie den Tag über gelesen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1cb25b0d-b274-3b6e-897e-9622335f1956",
                        "entry_id": "83e039bc-9087-3c1c-8c8b-47a9f6895d12",
                        "glosses": [
                            "Gericht aus [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1fbded3-5bd2-46ff-9d70-5465a6fb682e",
                                "sense_id": "1cb25b0d-b274-3b6e-897e-9622335f1956",
                                "text": "Wir essen gerne Lammkeule."
                            },
                            {
                                "example_id": "1bd2efa8-450d-400e-9147-b9d605f3a8f2",
                                "sense_id": "1cb25b0d-b274-3b6e-897e-9622335f1956",
                                "text": "„Eigil hatte eine Lammkeule gebraten.“"
                            },
                            {
                                "example_id": "58aa8edb-8643-48e5-bf84-061afeeacd3f",
                                "sense_id": "1cb25b0d-b274-3b6e-897e-9622335f1956",
                                "text": "„Aus dunklen Quellen stammten denn auch die schöne, junge Lammkeule, die Butter, die grünen Böhnchen und alle anderen Zutaten, mit welchen Thomas Lieven am Abend des 25. November 1940 in Chantal Tessiers Küche ein wohlschmeckendes Essen bereitete.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be6ba169-7127-4baa-b682-d0c4e99e0759",
