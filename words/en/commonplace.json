    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9df96309-3c79-3ed1-9d27-1963fb2b78d1",
                    "sense_definition": "Ordinary, unremarkable, or occurring frequently in everyday life.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ordinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Remote working has become completely <w>commonplace</w> across many modern companies.",
                            "target_lang_translations": {
                                "ru": "Удалённая работа стала совершенно <w>обычным делом</w> во многих современных компаниях."
                            }
                        },
                        {
                            "text": "Electric cars are an increasingly <w>commonplace</w> sight on the city roads.",
                            "target_lang_translations": {
                                "ru": "Электромобили становятся всё более <w>привычным</w> зрелищем на дорогах города."
                            }
                        }
                    ],
                    "synonyms": [
                        "banal",
                        "everyday",
                        "routine",
                        "unexceptional"
                    ],
                    "antonyms": [
                        "distinguished",
                        "inimitable",
                        "unique"
                    ],
                    "common_phrases": [
                        "become commonplace",
                        "commonplace occurrence",
                        "commonplace event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обычный, ничем не примечательный или часто встречающийся в повседневной жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обычный",
                                "target_lang_sense_clarification": "привычный, распространенный"
