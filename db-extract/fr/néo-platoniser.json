                ],
                "senses": [
                    {
                        "sense_id": "87a6dd21-4318-3b60-9744-b1f751de5e7d",
                        "entry_id": "ed2ae173-5e09-325b-8c3e-a4566b56053d",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de néoplatoniser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d56ee8de-ba56-4862-9dd8-85e7c242effc",
                                "sense_id": "87a6dd21-4318-3b60-9744-b1f751de5e7d",
                                "text": "Autant dire, ce qui serait tout aussi vrai que le point de vue incriminé ici, que Martin Heidegger est réactionnaire parce qu’il présocratise, que Karl Rahner n’est pas de son temps parce qu’il néo-platonise."
                            },
                            {
                                "example_id": "09da55f2-1cf8-4462-89e0-c04de0feead6",
                                "sense_id": "87a6dd21-4318-3b60-9744-b1f751de5e7d",
                                "text": "S’il nous arrive parfois de néo-platoniser (car platoniser, on n’en parle même plus) pour les besoins du recours aux sources, nous le faisons avec prudence et sans déposer le harnais scolastique ; et nous nous attarderions plus volontiers en Descartes qu’en Pascal."
                            }
                        ]
                    }
