                        "entry_id": "db96df44-fde4-340e-9806-00f1251d3db0",
                        "glosses": [
                            "indywidualna lub zespołowa, gładkolufowa broń palna, służąca do wystrzeliwania granatów na niewielką odległość"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b70fab1-062d-45e7-aff5-cd901809c9dd",
                                "sense_id": "311f62c4-69b2-35b9-9310-8f30561fbbbb",
                                "text": "Na trzeciorzędne odcinki posyła się trzeciorzędne oddziały, wyposażone w zdezelowane samochody, rakietnice jako substytut radiostacji i butelki z benzyną w zastępstwie granatników."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
