{
    "word_family": [
        "conflicted",
        "conflicting",
        "conflictual"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "05f40121-b302-3786-bd21-47fbb9a8784d",
                    "sense_definition": "A clash or disagreement, often violent, between two or more opposing groups or individuals.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>conflict</w> between the government and the rebels began three years ago.",
                            "target_lang_translations": {
                                "ru": "<w>Конфликт</w> между правительством и повстанцами начался три года назад."
                            }
                        },
                        {
                            "text": "Diplomats are working hard to resolve the <w>conflict</w> peacefully.",
                            "target_lang_translations": {
                                "ru": "Дипломаты усердно работают над тем, чтобы разрешить этот <w>конфликт</w> мирным путем."
                            }
                        }
                    ],
                    "synonyms": [
                        "clash",
                        "dispute",
                        "struggle",
                        "strife"
                    ],
                    "antonyms": [
                        "peace",
                        "agreement",
                        "harmony"
                    ],
                    "common_phrases": [
                        "armed conflict",
                        "resolve a conflict",
                        "violent conflict",
                        "internal conflict"
                    ],
                    "target_lang_definitions": {
                        "ru": "Столкновение или разногласие, часто насильственное, между двумя или более противоборствующими группами или отдельными лицами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфликт",
                                "target_lang_sense_clarification": "серьёзное разногласие или столкновение сторон"
                            },
                            {
                                "target_lang_word": "столкновение",
                                "target_lang_sense_clarification": "стычка или противостояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c528d018-9ed5-32fa-8915-4c7f623c4d78",
                    "sense_definition": "An incompatibility, as of two things that cannot be simultaneously fulfilled.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "incompatibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wanted to attend the meeting but there's a <w>conflict</w> in my schedule that day.",
                            "target_lang_translations": {
                                "ru": "Я хотел прийти на встречу, но в моем расписании на этот день есть <w>накладка</w>."
                            }
                        },
                        {
                            "text": "The lawyer had a <w>conflict</w> of interest and could not take the case.",
                            "target_lang_translations": {
                                "ru": "У адвоката возник <w>конфликт</w> интересов, и он не смог взяться за это дело."
                            }
                        }
                    ],
                    "synonyms": [
                        "incompatibility",
                        "clash",
                        "discrepancy"
                    ],
                    "antonyms": [
                        "compatibility",
                        "consistency"
                    ],
                    "common_phrases": [
                        "schedule conflict",
                        "conflict of interest",
                        "potential conflict"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несовместимость двух вещей, которые не могут быть реализованы одновременно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфликт",
                                "target_lang_sense_clarification": "противоречие или несовпадение (например, интересов)"
                            },
                            {
                                "target_lang_word": "противоречие",
                                "target_lang_sense_clarification": "положение, при котором одно исключает другое"
                            },
                            {
                                "target_lang_word": "несовместимость",
                                "target_lang_sense_clarification": "невозможность сочетания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2af6dccd-45ff-3668-8df7-be909b22479c",
                    "sense_definition": "To be at odds with or to be incompatible with something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incompatibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His personal beliefs often <w>conflict</w> with his professional duties.",
                            "target_lang_translations": {
                                "ru": "Его личные убеждения часто <w>конфликтуют</w> с профессиональными обязанностями."
                            }
                        },
                        {
                            "text": "The witness's testimony <w>conflicts</w> with the evidence found at the scene.",
                            "target_lang_translations": {
                                "ru": "Показания свидетеля <w>противоречат</w> уликам, найденным на месте происшествия."
                            }
                        }
                    ],
                    "synonyms": [
                        "clash",
                        "disagree",
                        "differ"
                    ],
                    "antonyms": [
                        "agree",
                        "match",
                        "correspond"
                    ],
                    "common_phrases": [
                        "conflict with reality",
                        "directly conflict"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться в противоречии или быть несовместимым с чем-либо другим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфликтовать",
                                "target_lang_sense_clarification": "вступать в противоречие"
                            },
                            {
                                "target_lang_word": "противоречить",
                                "target_lang_sense_clarification": "не соответствовать чему-либо"
                            },
                            {
                                "target_lang_word": "расходиться",
                                "target_lang_sense_clarification": "не совпадать (о мнениях или данных)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb745ba1-e193-34f2-a7f8-e8aa48046a48",
                    "sense_definition": "To overlap in a way that prevents both from happening, especially regarding a schedule.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incompatibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your conference call <w>conflicts</w> with my older one so please reschedule.",
                            "target_lang_translations": {
                                "ru": "Ваш созвон <w>накладывается</w> на мой предыдущий, поэтому, пожалуйста, перенесите его."
                            }
                        },
                        {
                            "text": "I cannot attend because the two events <w>conflict</w>.",
                            "target_lang_translations": {
                                "ru": "Я не могу присутствовать, так как эти два мероприятия <w>совпадают</w> по времени."
                            }
                        }
                    ],
                    "synonyms": [
                        "overlap",
                        "clash"
                    ],
                    "common_phrases": [
                        "schedules conflict"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наслаиваться друг на друга таким образом, что это мешает обоим событиям произойти, особенно в отношении расписания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накладываться",
                                "target_lang_sense_clarification": "о времени или планах"
                            },
                            {
                                "target_lang_word": "совпадать",
                                "target_lang_sense_clarification": "происходить в одно и то же время, создавая неудобство"
                            },
                            {
                                "target_lang_word": "конфликтовать",
                                "target_lang_sense_clarification": "о расписании"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}