            {
                "entry_id": "bf4065f2-e87b-30d4-9cbc-8ceaa77af3c0",
                "word": "perry",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cf5bc87d-17c3-4d56-b267-c63630ad5a2c",
                        "entry_id": "bf4065f2-e87b-30d4-9cbc-8ceaa77af3c0",
                        "tags": [
                            "plural"
                        ],
                        "form": "perries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8e6e5075-8b3c-36ec-aa97-02838f2c186e",
                        "entry_id": "bf4065f2-e87b-30d4-9cbc-8ceaa77af3c0",
                        "glosses": [
                            "A fermented alcoholic beverage made from pears; somewhat analogous to cider."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2a316286-2e85-4548-9d42-7d49fe1d300e",
                                "sense_id": "8e6e5075-8b3c-36ec-aa97-02838f2c186e",
                                "text": "Perry is less popular than cider, but some consider it superior."
                            },
                            {
                                "example_id": "6d27645d-b21d-4f67-b4b0-7e3cc9d763bd",
                                "sense_id": "8e6e5075-8b3c-36ec-aa97-02838f2c186e",
                                "text": "Sip the perry of the Black Worchester and you will belch clouds of soot."
                            },
                            {
                                "example_id": "17098eca-6284-44f5-88ba-b0e2532aeb40",
                                "sense_id": "8e6e5075-8b3c-36ec-aa97-02838f2c186e",
                                "text": "M. Vasse never observed a fatal termination unless in two instances ; in which the persons, adults, had drank perry in large quantity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdfef24f-5db1-4305-a00b-897fbff4c1d8",
                        "source_entry_id": "bf4065f2-e87b-30d4-9cbc-8ceaa77af3c0",
                        "source_sense_id": "8e6e5075-8b3c-36ec-aa97-02838f2c186e",
