                "senses": [
                    {
                        "sense_id": "3de4ed92-5d56-34f2-aa21-b8fa43ebe67d",
                        "entry_id": "de838181-8a37-390e-bce9-1924dd1b8624",
                        "glosses": [
                            "Donner un caractère technique excessif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f136801e-26e3-437a-8bc6-fd5934b71fbd",
                                "sense_id": "3de4ed92-5d56-34f2-aa21-b8fa43ebe67d",
                                "text": "Nous avons cherché à reproduire l'idée d'annotations techniques et ludiques (surtout il était important de ne pas surtechniciser dans ce contexte pour ne pas avoir un produit trop \"froid\") sur un produit tech."
                            },
                            {
                                "example_id": "684dc777-5b66-45a0-8b08-052e4476ee0d",
                                "sense_id": "3de4ed92-5d56-34f2-aa21-b8fa43ebe67d",
                                "text": "Sous prétexte de sécurité – alors que la logique est surtout financière –, on a surtechnicisé l’accouchement au détriment du soutien psychologique, de l’accompagnement."
                            },
                            {
                                "example_id": "988e718e-86e9-4afd-ac21-9e1dfcc7db34",
                                "sense_id": "3de4ed92-5d56-34f2-aa21-b8fa43ebe67d",
                                "text": "Ces propriétés pourtant primordiales ont été pour ainsi dire oubliées dans notre monde surtechnicisé, surdigitalisé, surraffiné etc."
                            }
                        ]
                    }
