                                        "entry_id": "9fd53de1-dccf-390b-8314-f801a3386445",
                                        "glosses": [
                                            "A war fought in the United States between 1861 and 1865, between the Northern states (Union) and Southern states (Confederacy)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9923f41c-dbd0-46ec-b971-6a9c5e40209d",
                        "source_entry_id": "801d48d6-869e-3975-9c58-f223f59c0240",
                        "source_sense_id": "0d4c7859-574f-3130-a567-1a63afa20366",
                        "target_lang_word": "guerre de Sécession",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guerre de Sécession",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e557d1d5-1f01-34a4-82f9-defdc8ff26d2",
                                        "entry_id": "c996daf4-fdc1-3fb7-882d-2c7adabbfbcc",
                                        "glosses": [
                                            "Guerre qui s'est déroulée de 1861 à 1865 en Amérique du Nord entre les États-Unis d’Amérique (désigné par le terme « l’Union » pendant la guerre) et les États confédérés d’Amérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6780354-9bec-4fa9-8ca5-e78ea56abf3d",
                                                "sense_id": "e557d1d5-1f01-34a4-82f9-defdc8ff26d2",
                                                "text": "Le Ku Klux Klan est né après la guerre de Sécession."
                                            },
                                            {
                                                "example_id": "32a074da-48cd-4583-9751-22d222b67716",
                                                "sense_id": "e557d1d5-1f01-34a4-82f9-defdc8ff26d2",
                                                "text": "Pourtant, la guerre de Sécession opposait les Etats du Nord, l’Union, ayant aboli l’esclavage, aux Etats du Sud, la Confédération, cherchant à le maintenir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
