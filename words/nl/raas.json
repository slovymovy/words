    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c0f61fa-b715-3076-b940-bec42fcaac4a",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>razen</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "razen_inflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>raas</w> van woede als ik zie hoe onrechtvaardig ze worden behandeld.",
                            "target_lang_translations": {
                                "en": "I <w>rage</w> with anger when I see how unfairly they are being treated."
                            }
                        },
                        {
                            "text": "Als ik zo hard door de bocht <w>raas</w>, voel ik de adrenaline.",
                            "target_lang_translations": {
                                "en": "When I <w>speed</w> through the bend so fast, I feel the adrenaline."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present indicative of 'razen' (to rage, storm, or speed)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rage",
                                "target_lang_sense_clarification": "to express violent anger"
                            },
                            {
                                "target_lang_word": "storm",
                                "target_lang_sense_clarification": "to move or act with great noise or fury"
                            },
                            {
                                "target_lang_word": "speed",
                                "target_lang_sense_clarification": "to move very quickly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dfd9242-79f1-3291-8fed-3e2f7e0b398d",
                    "sense_definition": "Gebiedende wijs van <w>razen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "razen_inflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Raas</w> maar lekker uit in de tuin tot je weer rustig bent.",
                            "target_lang_translations": {
                                "en": "Just <w>blow off some steam</w> in the garden until you are calm again."
                            }
                        },
                        {
                            "text": "<w>Raas</w> niet zo tegen me, ik kan er ook niets aan doen!",
                            "target_lang_translations": {
                                "en": "Don't <w>rage</w> at me like that, I can't help it either!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'razen' (to rage, storm, or speed)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rage",
                                "target_lang_sense_clarification": "command to vent anger or energy"
                            },
                            {
                                "target_lang_word": "storm",
                                "target_lang_sense_clarification": "command to rush or make noise"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "440385a7-8ed3-371b-8de3-3580b155de8a",
                    "sense_definition": "Onzin of wartaal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "onzin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een <w>raas</w> kraam jij nu toch allemaal uit?",
                            "target_lang_translations": {
                                "en": "What kind of <w>nonsense</w> are you talking about now?"
                            }
                        },
                        {
                            "text": "Laat je niet misleiden door al die <w>raas</w> op het internet.",
                            "target_lang_translations": {
                                "en": "Don't be misled by all that <w>rubbish</w> on the internet."
                            }
                        }
                    ],
                    "synonyms": [
                        "onzin",
                        "onzinpraat",
                        "kletskoek"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for nonsense"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Nonsense, gibberish, or foolish talk."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nonsense",
                                "target_lang_sense_clarification": "spoken or written words that have no meaning or make no sense"
                            },
                            {
                                "target_lang_word": "rubbish",
                                "target_lang_sense_clarification": "worthless talk or ideas"
                            },
                            {
                                "target_lang_word": "gibberish",
                                "target_lang_sense_clarification": "unintelligible or meaningless speech"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd114440-9203-37f3-b77b-9448cff357d3",
                    "sense_definition": "Een stommeling of een onuitstaanbaar persoon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scheldwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die gemene <w>raas</w> heeft me alweer opgelicht waar ik bij stond.",
                            "target_lang_translations": {
                                "en": "That mean <w>scoundrel</w> ripped me off again right in front of my eyes."
                            }
                        },
                        {
                            "text": "Zeg, luister eens, jij domme <w>raas</w>, dat is helemaal niet waar!",
                            "target_lang_translations": {
                                "en": "Hey, listen here, you stupid <w>fool</w>, that is not true at all!"
                            }
                        }
                    ],
                    "synonyms": [
                        "stommeling",
                        "schoft",
                        "huichelaar"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "dialectal or regional insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A fool, idiot, or an insufferable, unpleasant person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fool",
                                "target_lang_sense_clarification": "a person who acts unwisely or imprudently"
                            },
                            {
                                "target_lang_word": "idiot",
                                "target_lang_sense_clarification": "a stupid person"
                            },
                            {
                                "target_lang_word": "scoundrel",
                                "target_lang_sense_clarification": "a dishonest or unscrupulous person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
