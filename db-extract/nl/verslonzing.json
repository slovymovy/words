                        "examples": [
                            {
                                "example_id": "c3583e04-d301-4918-8690-3520006675ae",
                                "sense_id": "ee2b3212-62ae-350b-9ef3-ff5044e0e665",
                                "text": "Zoals gezegd, een korte periode van neergang en verslonzing, waarin de van zijn goede humeur beroofde drinker zich pas echt aan de fles vastklampt, in de waan zo zijn verloren bravoure terug te kunnen winnen."
                            },
                            {
                                "example_id": "77819975-824d-4fbc-8105-b31f07b21f48",
                                "sense_id": "ee2b3212-62ae-350b-9ef3-ff5044e0e665",
                                "text": "Herinneringsbos MH17 heeft geldtekort; verslonzing dreigt"
                            },
                            {
                                "example_id": "27ade33f-e5e1-4087-9e29-5a793a6a1b52",
                                "sense_id": "ee2b3212-62ae-350b-9ef3-ff5044e0e665",
                                "text": "Logistiek afstemmen, standaarden afspreken, dat is de bedoeling. En proberen de verslonzing van het leger te voorkomen door meer te gaan samenwerken, waardoor het uiteindelijk goedkoper is. Volgens minister Zijlstra van Buitenlandse Zaken is Nederland een goed voorbeeld. \"Een beetje zoals wij al met de Belgen samenwerken, dat is de bedoeling in heel Europa.\""
                            }
                        ]
                    }
