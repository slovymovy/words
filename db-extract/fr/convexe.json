                "senses": [
                    {
                        "sense_id": "99db95da-a0dc-37e0-88ab-6a847f02067e",
                        "entry_id": "6a8684b3-2eef-34c8-ae99-b9d2a44a7e8a",
                        "glosses": [
                            "Qui présente une surface bombée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19bf270e-2e60-43c9-8ae8-fcffcbe1ac40",
                                "sense_id": "99db95da-a0dc-37e0-88ab-6a847f02067e",
                                "text": "Un miroir, un verre convexe."
                            },
                            {
                                "example_id": "9dca7460-3141-4a68-abc6-6c98cc7ab991",
                                "sense_id": "99db95da-a0dc-37e0-88ab-6a847f02067e",
                                "text": "Pour le dessert, Jeanine avait prévu un vin de Cilaos avec le gâteau. Mémé Gâté, grande amatrice de ce breuvage moelleux, avait exigé qu’on en remplisse son verre à ras bord. C’est-à-dire jusqu’à ce que le précieux liquide forme un débord convexe au-dessus de son verre."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e3eb53d-8f61-3502-832e-a496b20b825f",
                        "entry_id": "6a8684b3-2eef-34c8-ae99-b9d2a44a7e8a",
                        "glosses": [
                            "Qui présente une courbe en bosse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ded4b560-1a43-4836-918d-f46cbb4d57de",
                                "sense_id": "4e3eb53d-8f61-3502-832e-a496b20b825f",
                                "text": "Le lit de la Lanterne dans la vallée moyenne, celui du Breuchin […] et de la Semouse dans leur section inférieure sont envahis sur la rive convexe par des bancs de cailloutis exondés aux basses eaux […]"
                            },
                            {
                                "example_id": "626f0146-1ce4-43b8-a8ee-8c524365d999",
                                "sense_id": "4e3eb53d-8f61-3502-832e-a496b20b825f",
                                "text": "Ligne courbe convexe. — Un cercle, une ellipse sont convexes."
                            }
                        ]
                    },
                    {
                        "sense_id": "01a74ab9-5adc-3bb1-a171-85dc045fd998",
                        "entry_id": "6a8684b3-2eef-34c8-ae99-b9d2a44a7e8a",
                        "glosses": [
                            "Qualifie une surface qui ne peut être rencontrée par une ligne droite en plus de deux points."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3024797d-9786-3236-a3d9-ab303b0994aa",
                        "entry_id": "6a8684b3-2eef-34c8-ae99-b9d2a44a7e8a",
                        "glosses": [
                            "Qualifie un polygone plan dont les sommets sont dans un même demi-plan par rapport à n’importe quel côté du polygone."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "811b2774-a807-3a6b-b448-dcab12937bd5",
                        "entry_id": "6a8684b3-2eef-34c8-ae99-b9d2a44a7e8a",
                        "glosses": [
                            "Qui contient tout segment reliant deux de ses points."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cc03063-7f5c-4d7e-a070-fba02bf2a725",
                                "sense_id": "811b2774-a807-3a6b-b448-dcab12937bd5",
                                "text": "Tout disque est convexe."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0261e30-2298-35f4-872b-ac3d5dfad441",
                        "entry_id": "6a8684b3-2eef-34c8-ae99-b9d2a44a7e8a",
                        "glosses": [
                            "Dont la courbe représentative délimite une partie supérieure convexe (c’est-à-dire que tout segment reliant deux points de la courbe représentative est « au-dessus » de la courbe)."
                        ],
                        "tags": [
                            "Analyse réelle"
                        ],
                        "examples": [
                            {
                                "example_id": "c5bff318-ba66-4665-9c72-4bc1be0ef016",
                                "sense_id": "c0261e30-2298-35f4-872b-ac3d5dfad441",
                                "text": "La fonction carré est convexe, de même que la fonction exponentielle."
                            }
                        ]
                    }
