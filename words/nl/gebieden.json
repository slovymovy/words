    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cdf5c363-eedf-3ac0-af1f-17784ab31464",
                    "sense_definition": "Meervoud van <w>gebied</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Mojave is een van de droogste <w>gebieden</w> van Amerika.",
                            "target_lang_translations": {
                                "en": "The Mojave is one of the driest <w>regions</w> in America.",
                                "ru": "Мохаве — один из самых засушливых <w>регионов</w> Америки.",
                                "fr": "Le Mojave est l'une des <w>régions</w> les plus arides d'Amérique."
                            }
                        },
                        {
                            "text": "In stedelijke <w>gebieden</w> wonen veel meer mensen dan op het platteland.",
                            "target_lang_translations": {
                                "en": "Many more people live in urban <w>areas</w> than in the countryside.",
                                "ru": "В городских <w>районах</w> живет гораздо больше людей, чем в сельской местности.",
                                "fr": "Beaucoup plus de gens vivent dans les <w>zones</w> urbaines qu'à la campagne."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of <w>area</w>.",
                        "ru": "Множественное число слова <w>gebied</w> (область, территория).",
                        "fr": "Pluriel de <w>gebied</w> (région, zone, territoire)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "areas",
                                "target_lang_sense_clarification": "distinct parts or sections of space"
                            },
                            {
                                "target_lang_word": "regions",
                                "target_lang_sense_clarification": "broad geographic areas"
                            },
                            {
                                "target_lang_word": "territories",
                                "target_lang_sense_clarification": "areas under a specific jurisdiction"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "области",
                                "target_lang_sense_clarification": "крупные географические или административные единицы"
                            },
                            {
                                "target_lang_word": "территории",
                                "target_lang_sense_clarification": "земельные пространства, находящиеся под чьим-либо управлением"
                            },
                            {
                                "target_lang_word": "районы",
                                "target_lang_sense_clarification": "части местности, города или страны"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "zones",
                                "target_lang_sense_clarification": "espaces géographiques ou délimités"
                            },
                            {
                                "target_lang_word": "régions",
                                "target_lang_sense_clarification": "grandes étendues territoriales"
                            },
                            {
                                "target_lang_word": "territoires",
                                "target_lang_sense_clarification": "espaces sous une autorité ou une délimitation particulière"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "db68eb39-67ad-3315-a70e-41de13d288d6",
                    "sense_definition": "Iemand dwingend opdragen iets te doen; een bevel geven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning <w>gebood</w> zijn ridders om het kasteel onmiddellijk te verdedigen.",
                            "target_lang_translations": {
                                "en": "The king <w>commanded</w> his knights to defend the castle immediately.",
                                "ru": "Король <w>повелел</w> своим рыцарям немедленно защищать замок.",
                                "fr": "Le roi <w>ordonna</w> à ses chevaliers de défendre immédiatement le château."
                            }
                        },
                        {
                            "text": "De eerlijkheid <w>gebiedt</w> te zeggen dat het resultaat tegenviel.",
                            "target_lang_translations": {
                                "en": "Honesty <w>dictates</w> saying that the result was disappointing.",
                                "ru": "Честность <w>требует</w> сказать, что результат разочаровал.",
                                "fr": "L'honnêteté <w>commande</w> de dire que le résultat a été décevant."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevelen",
                        "commanderen",
                        "gelasten"
                    ],
                    "antonyms": [
                        "verbieden"
                    ],
                    "common_phrases": [
                        "de eerlijkheid gebiedt",
                        "de noodzaak gebiedt"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "somewhat formal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To order someone to do something; to give a command.",
                        "ru": "Властно поручать кому-либо что-то сделать; отдавать приказ.",
                        "fr": "Donner un ordre impératif à quelqu'un ; ordonner, commander."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "command",
                                "target_lang_sense_clarification": "to give an authoritative order"
                            },
                            {
                                "target_lang_word": "order",
                                "target_lang_sense_clarification": "to tell someone to do something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "приказывать",
                                "target_lang_sense_clarification": "давать обязательное для исполнения распоряжение"
                            },
                            {
                                "target_lang_word": "повелевать",
                                "target_lang_sense_clarification": "торжественно или властно приказывать (устар./книжн.)"
                            },
                            {
                                "target_lang_word": "требовать",
                                "target_lang_sense_clarification": "диктовать необходимость (в переносном смысле, напр. о честности)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "ordonner",
                                "target_lang_sense_clarification": "donner un ordre formel"
                            },
                            {
                                "target_lang_word": "commander",
                                "target_lang_sense_clarification": "exercer l'autorité en exigeant une action"
                            },
                            {
                                "target_lang_word": "commander de",
                                "target_lang_sense_clarification": "exiger au sens figuré, dicter"
                            }
                        ]
                    }
                }
            ]
        }
    ]
