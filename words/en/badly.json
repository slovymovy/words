                {
                    "sense_id": "4c4b06da-12a9-38b9-bdc6-6465f1fdaaf4",
                    "sense_definition": "To a great or serious degree; very much.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>badly</w> need a vacation after working so hard this month.",
                            "target_lang_translations": {
                                "ru": "Мне <w>очень</w> нужен отпуск после такой тяжелой работы в этом месяце.",
                                "cs": "Po tak náročné práci tento měsíc <w>nutně</w> potřebuji dovolenou.",
                                "pl": "<w>Bardzo</w> potrzebuję urlopu po tak ciężkiej pracy w tym miesiącu.",
                                "zh": "这个月工作太辛苦了，我<w>非常</w>需要休个假。"
                            }
                        },
                        {
                            "text": "The car was <w>badly</w> damaged in the accident yesterday.",
                            "target_lang_translations": {
                                "ru": "Машина была <w>сильно</w> повреждена во вчерашней аварии.",
                                "cs": "Auto bylo při včerejší nehodě <w>silně</w> poškozeno.",
                                "pl": "Samochód został <w>poważnie</w> uszkodzony we wczorajszym wypadku.",
                                "zh": "那辆车在昨天的事故中<w>严重</w>受损。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "need badly",
                        "want badly",
                        "badly damaged",
                        "badly hurt"
                    ],
                    "target_lang_definitions": {
