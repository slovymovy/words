                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88964fc3-a886-30cc-af2b-08da5da8182f",
                                        "entry_id": "2544ebe8-f952-3647-83bf-e73d5c76a0d5",
                                        "glosses": [
                                            "Having no further stake to wager, but remaining active in a hand."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bac9380c-d787-4cd7-802b-b26b9f1ab77a",
                                                "sense_id": "88964fc3-a886-30cc-af2b-08da5da8182f",
                                                "text": "By betting his last $100, John was all in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acaa879a-9613-3ba7-9e78-5945b23e532e",
                                        "entry_id": "2544ebe8-f952-3647-83bf-e73d5c76a0d5",
                                        "glosses": [
                                            "Totally committed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb63901e-2fe6-4a93-b75f-27c4dff35b9f",
                                                "sense_id": "acaa879a-9613-3ba7-9e78-5945b23e532e",
                                                "text": "John is now all in on getting this product to market by year end, come hell or high water."
                                            }
                                        ]
                                    }
                                ]
