                                                "sense_id": "e79b552d-d399-3964-97a4-8250f806bb77",
                                                "text": "The word hour is written with a silent aitch."
                                            },
                                            {
                                                "example_id": "1e81ab48-c1ce-4ecc-9f59-f668c0d8a377",
                                                "sense_id": "e79b552d-d399-3964-97a4-8250f806bb77",
                                                "text": "Cockneys drop their aitches."
                                            },
                                            {
                                                "example_id": "c0fb90cb-f26a-4af5-8d4d-a6e16081996c",
                                                "sense_id": "e79b552d-d399-3964-97a4-8250f806bb77",
                                                "text": "The word length, which contains only four sounds l e ng th, is usually spell'd thus, el ee en gee tee aitch."
                                            },
                                            {
                                                "example_id": "02d1b758-1946-409b-8719-6e50014533f2",
                                                "sense_id": "e79b552d-d399-3964-97a4-8250f806bb77",
                                                "text": "\"If you've got any drawing-room manners, or a dislike to eating peas with a knife or dropping aitches, you'd better chuck 'em away. They ain't no further use.\""
                                            },
                                            {
                                                "example_id": "8904f12f-7df7-4df5-a6bb-b1f4aaeead27",
                                                "sense_id": "e79b552d-d399-3964-97a4-8250f806bb77",
                                                "text": "She frowned, hearing Lim Cheng Po's voice, so English, so refined, so very English upper-class. And often she had had to tell Joe about his aitches."
                                            }
                                        ]
