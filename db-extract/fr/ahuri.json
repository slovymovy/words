                        "entry_id": "49841e1a-57d4-3aba-a970-cf5b051be901",
                        "glosses": [
                            "Celui qui est interdit, stupéfait, ahuri."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "93a0b73b-66e3-48a1-9e63-042b5dd7afa9",
                                "sense_id": "b2cd922c-b1a3-31a6-a2f8-e315a7d82bb0",
                                "text": "C’est un ahuri."
                            },
                            {
                                "example_id": "5a6fdba8-dd67-46f5-99d5-c9b67ed24bff",
                                "sense_id": "b2cd922c-b1a3-31a6-a2f8-e315a7d82bb0",
                                "text": "Après une vingtaine de feuillets, la fièvre retombait immanquablement, la sauce se figeait et je restais devant la page blanche comme un ahuri complet, inapte à creuser mon sillon plus avant."
                            }
                        ]
                    }
