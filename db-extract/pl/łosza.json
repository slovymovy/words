                "senses": [
                    {
                        "sense_id": "d1726ac6-6dd5-3912-abc4-8545b0da917b",
                        "entry_id": "81caebdf-32b9-31dc-a0b7-ad41695b55d7",
                        "glosses": [
                            "samica łosia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3befb5b8-397e-430b-9e2a-3904d803d419",
                                "sense_id": "d1726ac6-6dd5-3912-abc4-8545b0da917b",
                                "text": "Łosza ocierała szyję o drzewo; małe, trochę za matką ukryte, skubało gałązki"
                            },
                            {
                                "example_id": "6818f731-c325-46e0-b493-91e18e23f7de",
                                "sense_id": "d1726ac6-6dd5-3912-abc4-8545b0da917b",
                                "text": "Przewodnik w rezerwacie wskazał na ślady łoszy niedaleko strumienia."
                            },
                            {
                                "example_id": "12026c94-9cf7-4943-aedd-34cf284d457e",
                                "sense_id": "d1726ac6-6dd5-3912-abc4-8545b0da917b",
                                "text": "Wczesnym rankiem na polanie stała samotna łosza."
                            },
                            {
                                "example_id": "083ab8db-1f26-4b09-a54f-124385c40da8",
                                "sense_id": "d1726ac6-6dd5-3912-abc4-8545b0da917b",
                                "text": "Na spacerze w lesie natknęliśmy się na odpoczywającą łoszę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
