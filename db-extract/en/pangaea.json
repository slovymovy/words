                                        "glosses": [
                                            "superkontynent, który powstał w permie i rozpadł się w jurze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df87ccdf-f40c-47c4-8ef9-15907b00cc0d",
                                                "sense_id": "581300a5-534c-3128-819e-1474211734ba",
                                                "text": "W okresie jurajskim Pangea rozpadła się na dwie części: północną, Laurazję, i południową, Gondwanę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
