            {
                "entry_id": "e8bf2698-df20-357a-a6cf-b6480ce6627f",
                "word": "semonce",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "33b59bd4-e688-472e-b71b-4322359774d2",
