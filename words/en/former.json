                        "zh": [
                            {
                                "target_lang_word": "学生",
                                "target_lang_sense_clarification": "指在校学习的人"
                            },
                            {
                                "target_lang_word": "年级生",
                                "target_lang_sense_clarification": "指特定年级的学生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9486f85-213b-364f-99b9-c319e594a8a2",
                    "sense_definition": "An object, such as a template or gauge, used to shape something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builder used a wooden <w>former</w> to construct the brick arch.",
                            "target_lang_translations": {
                                "ru": "Строитель использовал деревянный <w>шаблон</w> для возведения кирпичной арки.",
                                "tr": "Inşaatçı, tuğla kemeri yapmak için ahşap bir <w>kalıp</w> kullandı.",
                                "zh": "建筑工用木制<w>模板</w>来建造砖拱。"
                            }
                        },
                        {
                            "text": "You need to wrap the wire tightly around the <w>former</w>.",
                            "target_lang_translations": {
                                "ru": "Нужно плотно обмотать проволоку вокруг <w>каркаса</w>.",
                                "tr": "Teli <w>kalıbın</w> etrafına sıkıca sarmanız gerekiyor.",
                                "zh": "你需要把电线紧紧地绕在<w>模具</w>上。"
                            }
