                                        "entry_id": "666ba245-f386-3855-95f8-7fe61dca2798",
                                        "glosses": [
                                            "Initialism of lesbian, gay, bisexual, transgender/transsexual, queer/questioning, intersex, and allied/allies/asexual/aromantic/agender."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
