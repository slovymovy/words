                        "entry_id": "40fdfeb8-6e11-34d1-8742-58d5629c6506",
                        "tags": [
                            "positive",
                            "predicative",
                            "singular",
                            "neuter"
                        ],
                        "form": "es ist abspenstig"
                    },
                    {
                        "form_id": "3ad8dac6-2582-4c92-b926-08f8942d584a",
                        "entry_id": "40fdfeb8-6e11-34d1-8742-58d5629c6506",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind abspenstig"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "71463468-c9fc-37d3-bcd5-f79b196e1980",
                        "entry_id": "40fdfeb8-6e11-34d1-8742-58d5629c6506",
                        "glosses": [
                            "jemandem nicht treu, ergeben"
                        ],
                        "tags": [
                            "meist in der Wendung „abspenstig machen“"
                        ],
                        "examples": [
                            {
                                "example_id": "de531616-bb58-4902-9aad-8d5bcf834595",
                                "sense_id": "71463468-c9fc-37d3-bcd5-f79b196e1980",
                                "text": "„Du ahnst nicht, wie froh ich bin, dass ich sie der alten Hexe abspenstig machen konnte.“"
                            },
                            {
                                "example_id": "dbeab4b5-7244-4966-ae92-4ae575154660",
                                "sense_id": "71463468-c9fc-37d3-bcd5-f79b196e1980",
                                "text": "„Bestimmt kannten die Anwälte des Eigners tausend juristische Winkelzüge, um ihnen die Jacht abspenstig zu machen.“"
                            },
                            {
                                "example_id": "a4327dc1-c774-4422-9af6-a8fd6e37706a",
                                "sense_id": "71463468-c9fc-37d3-bcd5-f79b196e1980",
                                "text": "„Mein Boss mag es gar nicht, wenn man ihm sein Territorium abspenstig machen will.“"
                            },
                            {
                                "example_id": "af744f94-e2e5-473c-bb60-8e4255702f47",
                                "sense_id": "71463468-c9fc-37d3-bcd5-f79b196e1980",
                                "text": "„In Göttingen wird auf Initiative des Tuchfabrikanten Grätzel mit hoher Geldbuße belegt, wer ihm einen Arbeiter abspenstig macht.“"
                            },
                            {
                                "example_id": "d9b51ccc-fda9-4334-9849-705c2a095b75",
                                "sense_id": "71463468-c9fc-37d3-bcd5-f79b196e1980",
                                "text": "„Die Unabhängigkeit währte nicht lange; bereits um 1876 gelang es dem Herrscher von Bunyoro-Kitara, das abspenstige Königtum wieder einzugliedern.“"
                            },
                            {
                                "example_id": "3b218aad-3c14-4f5c-8fcc-786c96fc3a1c",
                                "sense_id": "71463468-c9fc-37d3-bcd5-f79b196e1980",
                                "text": "„Eben dieses vergessliche, verführte, abspenstige Du möchte Gott für sich gewinnen.“"
                            },
                            {
                                "example_id": "de0beb5e-056a-4977-ad83-982cb0a95b21",
                                "sense_id": "71463468-c9fc-37d3-bcd5-f79b196e1980",
                                "text": "„Seehofer will verlorenes Terrain neu besetzen, um abspenstige Wähler zurückzugewinnen: Wo eine CSU wieder im natürlichen Habitat rechts der Mitte waltet, so seine Logik, da wird der AfD schon irgendwann die Puste ausgehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
