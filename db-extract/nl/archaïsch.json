                                "target_senses": [
                                    {
                                        "sense_id": "08dc45c6-c127-3f3f-939e-c7643ed8c771",
                                        "entry_id": "93eca894-563d-32bb-89d3-d10913b6f75d",
                                        "glosses": [
                                            "Qui est ancien, qui présente de l’ancienneté ou en à des traits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95047cc8-4366-40cd-898c-d35997ed57c1",
                                                "sense_id": "08dc45c6-c127-3f3f-939e-c7643ed8c771",
                                                "text": "[…]; ils ne se rendent aucun compte du progrès de nos mœurs ; encore moins soupçonnent-ils que leur pruderie archaïque fait rire jusqu'à ces enfants dont ils prétendent protéger la candeur."
                                            },
                                            {
                                                "example_id": "a94c1fc0-8fa6-45cd-8267-22955bed0a73",
                                                "sense_id": "08dc45c6-c127-3f3f-939e-c7643ed8c771",
                                                "text": "Le Moyen Âge étant un retour aux mœurs des très vieux temps, il était naturel qu'il engendrât de nouveau des idées fort archaïques relatives à la justice, […]."
                                            },
                                            {
                                                "example_id": "ad327999-2daa-49b2-aa4b-f89162ab80d0",
                                                "sense_id": "08dc45c6-c127-3f3f-939e-c7643ed8c771",
                                                "text": "Un lecteur m'écrit « La prof de français nous a dit qu'il est inutile d'apprendre à conjuguer le passé simple, car c'est un temps archaïque, aujourd'hui complètement inusité »."
                                            },
                                            {
                                                "example_id": "b3b4c4e0-9ead-47f6-a123-ac22509319c1",
                                                "sense_id": "08dc45c6-c127-3f3f-939e-c7643ed8c771",
                                                "text": "De même qualifier d’archaïque la fidélité aux valeurs fondamentales du socialisme et la reconnaissance de l’histoire de la gauche et de ses luttes c’est l’idéologie dominante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf6e031-f0e1-3651-b15a-5c1f8158e0b7",
                                        "entry_id": "93eca894-563d-32bb-89d3-d10913b6f75d",
                                        "glosses": [
                                            "Qui n’est plus utilisé, désuet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44e631a8-49c4-3ea0-9eb1-b3774e5b151a",
                                        "entry_id": "93eca894-563d-32bb-89d3-d10913b6f75d",
                                        "glosses": [
