                ],
                "senses": [
                    {
                        "sense_id": "b8134134-83b3-3a0f-882c-5d91af485cc6",
                        "entry_id": "ddf76c3c-7802-3256-babd-7051f4ad9f53",
                        "glosses": [
                            "Concierge, portier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aed566bd-d2b0-406d-89e0-4949e32536ee",
                                "sense_id": "b8134134-83b3-3a0f-882c-5d91af485cc6",
                                "text": "Ils venaient sûrement faire un mauvais coup, m’a expliqué le pipelet, mais, dame! ici, c’est une maison bien surveillée; la preuve!"
                            },
                            {
                                "example_id": "ece56da9-988f-4012-a7a0-51c2aab01838",
                                "sense_id": "b8134134-83b3-3a0f-882c-5d91af485cc6",
                                "text": "Il venait au bureau le dimanche ; et comme le concierge, ce jour-là, mettait à profit ses loisirs pour aller prendre le vermouth avec des cochers du quartier, il lui arrivait de l’attendre des heures, sous le porche glacial de l’immeuble, payé de sa peine si, à son retour, le pipelet le saluait d’un flatteur : Ah ! ah !… quel bûcheur, ce Monsieur Sainthomme !"
                            },
                            {
                                "example_id": "fb056209-4cf7-4478-8b0c-7ce23ac845e0",
                                "sense_id": "b8134134-83b3-3a0f-882c-5d91af485cc6",
                                "text": "Il n’y a rien pour nous ? dit-elle au portier. Ah ! tenez, vous n’auriez pas vingt francs, mon Pipelet, ça m’éviterait de remonter."
                            }
                        ]
                    },
                    {
                        "sense_id": "13714cf9-533a-3ca0-b152-9621d273d819",
                        "entry_id": "ddf76c3c-7802-3256-babd-7051f4ad9f53",
                        "glosses": [
                            "Personne bavarde voire indiscrète."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e7097c8d-3f06-45eb-9c6f-99c2f5405c2f",
                                "sense_id": "13714cf9-533a-3ca0-b152-9621d273d819",
                                "text": "M. Richard Fauvet, intellectuel incorruptible, traite publiquement Noël Chérouvier de pipelet humanitaire, de pédagogue au cœur sensible, de bavard intempérant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee489922-24ab-4ce9-9046-739316e7bd55",
