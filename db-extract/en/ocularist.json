                                    {
                                        "sense_id": "de00e8ae-b200-30c3-bd32-18c507f1af56",
                                        "entry_id": "52f34b0e-88d1-3df0-8fda-c035580d17dd",
                                        "glosses": [
                                            "Technicien qui fabrique des prothèses oculaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37ae337a-fd13-4ad4-8f65-074a59c801cc",
                                                "sense_id": "de00e8ae-b200-30c3-bd32-18c507f1af56",
                                                "text": "Quel n'est pas son émerveillement lorsque l'oculariste lui sort un tiroir de prothèses d'yeux de toutes les couleurs et de toutes les grandeurs"
                                            },
                                            {
                                                "example_id": "0c9c14ae-6c9f-4d49-9375-28a33787c04b",
                                                "sense_id": "de00e8ae-b200-30c3-bd32-18c507f1af56",
                                                "text": "Beaucoup moins connu, l'oculariste procède au moulage et à la fabrication des prothèses lorsqu'une ablation du globe oculaire est nécessaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b8846f8-655c-34c7-ab51-4bd51bb7e6bb",
                                        "entry_id": "52f34b0e-88d1-3df0-8fda-c035580d17dd",
                                        "glosses": [
                                            "Oculiste."
                                        ],
