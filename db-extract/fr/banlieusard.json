                        "sense_id": "2e85fb9f-2400-3f63-a44f-a0220ee08b1a",
                        "entry_id": "cea2885c-a336-32d7-9f82-e5c7e11d5b71",
                        "glosses": [
                            "Relatif à la banlieue ou à ses habitants."
                        ],
