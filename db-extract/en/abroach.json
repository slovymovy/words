                                            {
                                                "example_id": "3d7b2f85-4207-45d8-a81e-14e829a9fabd",
                                                "sense_id": "c7167955-d65f-306c-8876-1e7776aa863a",
                                                "text": "De aangestoken kinderen kregen nu ook de mazelen."
