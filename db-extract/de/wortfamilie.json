                        ],
                        "form": "die Wortfamilie"
                    },
                    {
                        "form_id": "7553b267-97f3-4021-830a-61878273bca3",
                        "entry_id": "46d592cb-f2fc-3f17-b126-b98b8193899d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wortfamilien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ddda2f02-2a73-3fe6-94e2-a9a854ff0717",
                        "entry_id": "46d592cb-f2fc-3f17-b126-b98b8193899d",
                        "glosses": [
                            "Gruppe von Wörtern, die auf das gleiche Ursprungswort, Etymon zurückgeht."
                        ],
                        "tags": [
                            "Historiolinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "08b292fe-0b1f-4339-af08-372701382036",
                                "sense_id": "ddda2f02-2a73-3fe6-94e2-a9a854ff0717",
                                "text": "Zur Wortfamilie der indogermanischen Wurzel *kap- gehören u.a. die deutschen Wörter \"haben\", \"Habicht\" und \"heben\"."
                            },
                            {
                                "example_id": "682a44a8-09cf-4688-9cd3-aa49b6bfb83b",
                                "sense_id": "ddda2f02-2a73-3fe6-94e2-a9a854ff0717",
                                "text": "„Wir nennen solche Gruppen von Wörtern, die etymologisch verwandt sind und deren Kernwort in der Gegenwartssprache noch existiert, Wortfamilie.“"
                            },
                            {
                                "example_id": "4e570e4b-a53f-4331-aac8-754d896165f0",
                                "sense_id": "ddda2f02-2a73-3fe6-94e2-a9a854ff0717",
                                "text": "„Die Gesamtheit aller Bildungen aus einem Grundwort oder einer Wurzel nennen wir Wortfamilie.“"
                            },
                            {
                                "example_id": "6772bdff-39f9-4943-94e0-313f4ac27137",
                                "sense_id": "ddda2f02-2a73-3fe6-94e2-a9a854ff0717",
                                "text": "„Es bettet dabei die Geschichte der Einzelwörter in größere Zusammenhänge ein, arbeitet die Wortfamilien heraus und zeigt Verwandtschaften mit Wörtern anderer Sprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d2fa1f11-5ad1-35af-9445-bc340cb8452c",
                        "entry_id": "46d592cb-f2fc-3f17-b126-b98b8193899d",
                        "glosses": [
                            "Gruppe von Wörtern, die in einem Grundwort/ Grundmorphem übereinstimmen."
                        ],
                        "tags": [
                            "Allgemeine Linguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "c8a27b87-b37a-411e-bafd-b2a1a580878c",
                                "sense_id": "d2fa1f11-5ad1-35af-9445-bc340cb8452c",
                                "text": "Zur heutigen Wortfamilie von haben gehören u.a. \"haben\", \"Habe\" und \"Gehabe\"."
                            },
                            {
                                "example_id": "9321b27e-1e3e-41a1-8c2b-4d0d1de6d4d6",
                                "sense_id": "d2fa1f11-5ad1-35af-9445-bc340cb8452c",
                                "text": "„Die Zusammenhänge der Wortfamilien wurden durch eine Anordnungsweise gewahrt, die nur die Grundwörter alphabetisch ordnet, die Bestimmungswörter aber innerhalb des Grundwortartikels alphabetisch anführt.“"
                            },
                            {
                                "example_id": "c88cfe28-9199-42bb-8f6a-d65274732fef",
                                "sense_id": "d2fa1f11-5ad1-35af-9445-bc340cb8452c",
                                "text": "„Damit wurde nun aber eine Wortfamilie zerstört.“"
                            },
                            {
                                "example_id": "44ff0c20-8a44-4aa2-97e6-39d4ce046675",
                                "sense_id": "d2fa1f11-5ad1-35af-9445-bc340cb8452c",
                                "text": "„Da ist zum einen die Häufigkeit der Meldungen und zum anderen der Umfang der entsprechenden Wortfamilie mit einem ausgefächerten Bedeutungsspektrum.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
