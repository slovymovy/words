                    {
                        "sense_id": "73b5f216-1955-3d4b-adcd-91891997a522",
                        "entry_id": "8e7c6855-abb7-30cd-893e-40f6ccf549ea",
                        "glosses": [
                            "Personne en charge de tester les plats cuisinés pour en apprécier le goût ou pour déterminer s’ils ne sont pas empoisonnés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae4438c3-955c-4161-b1d7-f863f6c591a6",
                                "sense_id": "73b5f216-1955-3d4b-adcd-91891997a522",
                                "text": "Empoisonner l’empereur sans que les autres convives soient indisposés, sans que le goûteur soit malade, voilà quel était l’objectif qu'Agrippine avait fixé à Locuste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4e50d02-2122-4e9a-8793-cb1d481da6a6",
