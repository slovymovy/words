                        "glosses": [
                            "Celui qui disserte, souvent avec un sens, peu favorable, de pédantisme ou de bavardage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e1ed5cd-aae2-474c-bb1a-a701077794f4",
                                "sense_id": "6b9372e2-5feb-3db1-aa85-22fd66443f96",
                                "text": "Et nombre de dissertateurs qui raisonnent à l’infini manquent du sentiment."
                            },
                            {
