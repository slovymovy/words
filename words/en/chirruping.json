            "senses": [
                {
                    "sense_id": "6ccf3560-207e-3625-b745-1587d9bb0584",
                    "sense_definition": "present participle and gerund of <w>chirrup</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chirrup_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small birds were <w>chirruping</w> happily in the garden bushes.",
                            "target_lang_translations": {
                                "zh": "小鸟在花园灌木丛中欢快地<w>啁啾</w>。"
                            }
                        },
                        {
                            "text": "A tiny cricket kept <w>chirruping</w> from behind the kitchen cupboard all night.",
                            "target_lang_translations": {
                                "zh": "一只小蟋蟀整夜都在厨房橱柜后面不停地<w>唧唧叫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
