                            "positive"
                        ],
                        "form": "eigenzinnigs"
                    },
                    {
                        "form_id": "e541f738-3859-4b65-ac2e-c1400cc48bd8",
                        "entry_id": "8ed09e96-0aa4-31ca-a495-565461d06588",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "eigenzinnigers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad90af36-a7ed-3e22-8e9a-8f133e3d3e60",
                        "entry_id": "8ed09e96-0aa4-31ca-a495-565461d06588",
                        "glosses": [
                            "van een persoon dat die persoon dingen op zijn eigen manier doet ook als die afwijken van de andere mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c9b4875-7ab9-42ba-a4db-4fe3f3b0f5c5",
                                "sense_id": "ad90af36-a7ed-3e22-8e9a-8f133e3d3e60",
                                "text": "De eigenzinnige man ging niet meer op vakantie en vond auto's een verouderde techniek."
                            },
                            {
                                "example_id": "30b82597-6e76-4161-984d-81a0638334b3",
                                "sense_id": "ad90af36-a7ed-3e22-8e9a-8f133e3d3e60",
                                "text": "De laatste drie jaar deelde Ex het directeurschap met Ina Klaassen. Ze noemt hem een visionair met lef. \"Zijn eigenzinnige blik en bevlogen aanpak hebben de groei die het museum heeft doorgemaakt aangewakkerd en voortgestuwd.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da0c0fb1-1a97-4a00-aab3-160f2fd5ee86",
                        "source_entry_id": "8ed09e96-0aa4-31ca-a495-565461d06588",
                        "source_sense_id": "ad90af36-a7ed-3e22-8e9a-8f133e3d3e60",
                        "target_lang_word": "idiosyncratic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiosyncratic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ca61588-d0aa-3961-9fbf-5ed16409bd40",
                                        "entry_id": "d38353d7-f531-37cf-af82-a368127938de",
                                        "glosses": [
                                            "Peculiar to a specific individual; eccentric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea0c44a8-e878-47c1-bfce-356730054494",
                                                "sense_id": "5ca61588-d0aa-3961-9fbf-5ed16409bd40",
                                                "text": "At the time, I set it down to some idiosyncratic, personal distaste . . . but I have since had reason to believe the cause to lie much deeper in the nature of man."
                                            },
                                            {
                                                "example_id": "f5410208-850f-4599-af7d-7331a3b462c0",
                                                "sense_id": "5ca61588-d0aa-3961-9fbf-5ed16409bd40",
                                                "text": "It was no merely idiosyncratic experience, for the youth had the same: it was love!"
                                            },
                                            {
                                                "example_id": "00286afd-3e74-4ed5-8a9c-e82910a9605a",
                                                "sense_id": "5ca61588-d0aa-3961-9fbf-5ed16409bd40",
                                                "text": "British Director Ronald Eyre kept the action crisp; he was correctly content to execute the composer's wishes, rather than impose a fashionably idiosyncratic view of his own."
                                            },
                                            {
                                                "example_id": "5193f165-b621-4fb7-a774-409bfcea9574",
                                                "sense_id": "5ca61588-d0aa-3961-9fbf-5ed16409bd40",
                                                "text": "I’m not saying that Kaufman’s film will be enshrined as a classic, as those Kubrick films are. It’s too idiosyncratic and demanding for that: many viewers will be thinking of ending it halfway through"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67aa9b62-4fee-48f1-90c5-6536c33e0d59",
                        "source_entry_id": "8ed09e96-0aa4-31ca-a495-565461d06588",
                        "source_sense_id": "ad90af36-a7ed-3e22-8e9a-8f133e3d3e60",
                        "target_lang_word": "wayward",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wayward",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "427f6b90-0389-378a-bb86-a7ab5dbd71a3",
                                        "entry_id": "d39cc7e4-b1a6-322b-8c1f-1693137f84d9",
                                        "glosses": [
                                            "Given to wilful, perverse deviation from the expected norm; tending to stray."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "771c0f2f-ae04-4636-9372-2d927af9d247",
                                                "sense_id": "427f6b90-0389-378a-bb86-a7ab5dbd71a3",
                                                "text": "He is a brilliant fellow when he chooses to work—one of the brightest intellects of the University, but he is wayward, dissipated, and unprincipled."
                                            },
                                            {
                                                "example_id": "d1e9d59c-e778-4a71-93bf-feeaddc3efe2",
                                                "sense_id": "427f6b90-0389-378a-bb86-a7ab5dbd71a3",
                                                "text": "Fancies are like shadows . . . you can’t cage them, they’re such wayward, dancing things."
                                            },
                                            {
                                                "example_id": "3302595a-6244-4bd4-bcd7-dac6e9e23cd1",
                                                "sense_id": "427f6b90-0389-378a-bb86-a7ab5dbd71a3",
                                                "text": "The Ig Nobel awards are arguably the highlight of the scientific calendar. The prizes, which are the wayward son of the more righteous Nobels, are supposed to reward research that makes people laugh, then think."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c51c9663-ebf6-348a-90b9-06b3a43ed441",
                                        "entry_id": "d39cc7e4-b1a6-322b-8c1f-1693137f84d9",
                                        "glosses": [
                                            "Obstinate, contrary and unpredictable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3048ebba-34e8-3c36-a57e-d041bc13c101",
                                        "entry_id": "d39cc7e4-b1a6-322b-8c1f-1693137f84d9",
                                        "glosses": [
                                            "Not on target."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc2c4831-2550-4f65-b45a-42ece80c2084",
                                                "sense_id": "3048ebba-34e8-3c36-a57e-d041bc13c101",
                                                "text": "Bulgaria's only attacking weapon was the wayward shooting of Martin Petrov, whereas England's attacking options were awash with movement in the shape of Rooney, Young and Walcott."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "440187fe-bcb5-45e3-9147-d26d501ff4be",
                        "source_entry_id": "8ed09e96-0aa4-31ca-a495-565461d06588",
                        "source_sense_id": "ad90af36-a7ed-3e22-8e9a-8f133e3d3e60",
                        "target_lang_word": "recalcitrant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recalcitrant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a102c90b-a246-369f-a332-a93b7b7cdc1f",
                                        "entry_id": "ae082175-93cd-3c5f-8839-b15edd04e588",
                                        "glosses": [
                                            "Marked by a stubborn unwillingness to obey authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84116be2-14bd-41d5-a27c-823c192d4dec",
                                                "sense_id": "a102c90b-a246-369f-a332-a93b7b7cdc1f",
                                                "text": "His nimble fancy was recalcitrant to mental discipline."
                                            },
                                            {
                                                "example_id": "1398e722-ca34-44f6-b317-9209e9e66f33",
                                                "sense_id": "a102c90b-a246-369f-a332-a93b7b7cdc1f",
                                                "text": "There was something in her manner so reminiscent of the school teacher reprimanding a recalcitrant pupil that Mr. Snyder's sense of humor came to his rescue."
                                            },
                                            {
                                                "example_id": "ac7f8831-6021-46bb-8aab-a2d20c7881e6",
                                                "sense_id": "a102c90b-a246-369f-a332-a93b7b7cdc1f",
                                                "text": "Kenya's official \"Cowan Plan,\" named after a colonial prison administrator, decreed that recalcitrant prisoners \"be manhandled to the site and forced to carry out the task.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15db8756-80b9-33c9-b367-47d854dcede7",
                                        "entry_id": "ae082175-93cd-3c5f-8839-b15edd04e588",
                                        "glosses": [
                                            "Unwilling to cooperate socially."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81459491-a483-317d-9518-9ec0b659a873",
                                        "entry_id": "ae082175-93cd-3c5f-8839-b15edd04e588",
                                        "glosses": [
                                            "Difficult to deal with or to operate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18be77a7-2bb2-4c97-9f4f-3a9c999be3db",
                                                "sense_id": "81459491-a483-317d-9518-9ec0b659a873",
                                                "text": "The more labile organic constituents of complex dissolved and particulate organic matter are commonly hydrolyzed and metabolized more rapidly than more recalcitrant organic compounds that are less accessible enzymatically."
                                            },
                                            {
                                                "example_id": "d665ee28-65f3-4bbf-9869-99b2fc1a8743",
                                                "sense_id": "81459491-a483-317d-9518-9ec0b659a873",
                                                "text": "The Hansa had no legal status, independent finances or a common institutional framework, while the major weapon against recalcitrant members (or opponents) was the threat of embargo."
                                            },
                                            {
                                                "example_id": "3b22f9d0-4670-44b7-8ecb-f7499fa898f9",
                                                "sense_id": "81459491-a483-317d-9518-9ec0b659a873",
                                                "text": "Particularly recalcitrant examples which made it impossible to remove actual words while maintaining the balance of the set were resolved by altering a consonant in the base word to create a new base form."
                                            },
                                            {
                                                "example_id": "98775f62-ef82-4dd6-ae22-b33958a34e43",
                                                "sense_id": "81459491-a483-317d-9518-9ec0b659a873",
                                                "text": "However, when a clinician is faced with a more recalcitrant case, it is important to remember to ask the patient whether psychological, social, or occupational stress might be contributing to the activity of the skin disorder."
                                            },
                                            {
                                                "example_id": "79df0ccc-b768-45f1-bfb3-05a2d10502e6",
                                                "sense_id": "81459491-a483-317d-9518-9ec0b659a873",
                                                "text": "The temptation is to regard him [John Ogdon] as an idiot savant, a big talent bottled inside a recalcitrant body and accompanied by a personality that seems not just unremarkable, but almost entirely blank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34e93874-cd80-3d61-9444-025901b86bc0",
                                        "entry_id": "ae082175-93cd-3c5f-8839-b15edd04e588",
                                        "glosses": [
                                            "Not viable for an extended period; damaged by drying or freezing."
                                        ],
                                        "tags": [
                                            "of seed"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "recalcitrant",
                                "target_lang_code": "en",
                                "target_senses": [
