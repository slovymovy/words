                                "target_senses": [
                                    {
                                        "sense_id": "20463032-4ae7-3a8d-abee-a2011d0535d4",
                                        "entry_id": "511e5e70-5d41-375f-b475-f2bb532fd44b",
                                        "glosses": [
                                            "Mât portant une hune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97a00cb6-81ca-497c-8e58-f8a44e11b104",
                                                "sense_id": "20463032-4ae7-3a8d-abee-a2011d0535d4",
                                                "text": "Quarante-quatre pièces de canon tonnent à la fois, enfilant de biais la corvette française, trouant sa voilure, fouillant son équipage, brisant son petit hunier, tandis qu’en même temps les couleurs françaises disparaissent du fort et du trois-mâts et font place au drapeau anglais."
                                            },
                                            {
                                                "example_id": "47acf529-93f5-460a-9671-87fc261b7318",
                                                "sense_id": "20463032-4ae7-3a8d-abee-a2011d0535d4",
                                                "text": "Je crois fort, disait le vieux pêcheur, je crois fort que c’est eux ! Un liston rouge, un hunier à rouleau, ça leur ressemble joliment toujours ; qu’en dis-tu, Gaud, ma fille ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ff1803e-96f3-316d-8573-18266b522440",
                                        "entry_id": "511e5e70-5d41-375f-b475-f2bb532fd44b",
                                        "glosses": [
                                            "Voile carrée du mât de hune."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a23523f-4305-4851-a014-b0f6124b5707",
                                                "sense_id": "3ff1803e-96f3-316d-8573-18266b522440",
                                                "text": "Il était au vent de l'îlot, et, tribord amure, sous ses basses voiles, ses huniers et ses perroquets, il s'élevait vers le nord."
                                            },
                                            {
                                                "example_id": "66077c59-fe62-4abe-8b8b-477413b239da",
                                                "sense_id": "3ff1803e-96f3-316d-8573-18266b522440",
                                                "text": "Et Jean-Marie, malgré la rafale, malgré les soubresauts du brick, grimpait au mât de misaine pour amarrer le hunier qui flottait au vent comme un drapeau."
                                            },
                                            {
                                                "example_id": "a7a240dd-954f-4d24-acf2-fba785ca0a01",
                                                "sense_id": "3ff1803e-96f3-316d-8573-18266b522440",
                                                "text": "Les eaux du Mississippi son basses : on attend encore la crue de printemps. C'est pourquoi je n'ai fait border que les huniers et les perroquets. Nous ne pouvons marcher trop vite, si la vigie nous signale un bas-fond, nous devrons prendre des ris et virer. Et un brick ne se manœuvre pas comme une chaloupe !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
