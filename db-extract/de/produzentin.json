                "senses": [
                    {
                        "sense_id": "68337aab-911c-3c28-82de-015fc4bb4094",
                        "entry_id": "844bc878-4a22-31c3-b9c4-d11e77d35638",
                        "glosses": [
                            "weibliche Person, die etwas produziert, herstellt oder erzeugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b8f3d72-aadd-43b9-a82b-09c55916db7d",
                                "sense_id": "68337aab-911c-3c28-82de-015fc4bb4094",
                                "text": "Demi Moore ist eine US-amerikanische Produzentin von Filmen."
                            },
                            {
                                "example_id": "a03faa23-1fbd-491b-be95-f906293f35b2",
                                "sense_id": "68337aab-911c-3c28-82de-015fc4bb4094",
                                "text": "„1920 bis 1930 erlebte die Manufaktur ihre glanzvolle Zeit als Produzentin von besserer Keramik, von Geschirr für die feine Tafel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "329b11c0-405f-4b6b-9474-8d97e05bb419",
                        "source_entry_id": "844bc878-4a22-31c3-b9c4-d11e77d35638",
                        "source_sense_id": "68337aab-911c-3c28-82de-015fc4bb4094",
                        "source_sense_description": "weibliche Person, die etwas produziert, herstellt oder erzeugt",
                        "target_lang_word": "productrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "productrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20a996f1-efc3-38c3-8016-d4264840aad9",
                                        "entry_id": "5d802c28-5bdf-3276-9ed4-31dbc98374b4",
                                        "glosses": [
                                            "Celle qui crée, par son travail, les produits agricoles ou industriels, par opposition à ceux qui s’en servent, qui les consomment."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77e3ead9-698a-435c-bbfc-fcd79606def4",
                                                "sense_id": "20a996f1-efc3-38c3-8016-d4264840aad9",
                                                "text": "Rencontre avec Madeleine Hayeur, productrice de porcs de race Duroc : son parcours, son travail et ses efforts auprès du public pour mieux faire connaître son métier et la production porcine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df44d7dc-4496-3a8e-b5ac-36b0a62c2a5f",
                                        "entry_id": "5d802c28-5bdf-3276-9ed4-31dbc98374b4",
                                        "glosses": [
                                            "Celle qui coordonne, contrôle et assure le financement de tous les aspects de la production d’un film, d’un téléfilm, d’une émission de télévision, d’un album de musique, d’un spectacle vivant ou d’un jeu vidéo."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c131df8c-5fc1-4fa0-87ce-62de503be2d4",
                                                "sense_id": "df44d7dc-4496-3a8e-b5ac-36b0a62c2a5f",
                                                "text": "En 1996, la productrice française Sophie Goupil choisit de coproduire La Cinquième Saison, première coproduction franco-iranienne de long métrage, avec une institution publique, la fondation Fârâbi."
                                            },
                                            {
                                                "example_id": "d67a77b5-c621-478a-890d-26b30bd19bcd",
                                                "sense_id": "df44d7dc-4496-3a8e-b5ac-36b0a62c2a5f",
                                                "text": "Commentant le titre de son film dans le dossier de presse, elle en profite pour affirmer une autre dualité : « C’est bien moi L’une chante l’autre pas. L’une réalisatrice, l’autre productrice."
                                            },
                                            {
                                                "example_id": "484c510c-047c-408b-b97b-5ccda4b1b170",
                                                "sense_id": "df44d7dc-4496-3a8e-b5ac-36b0a62c2a5f",
                                                "text": "« C’est une grosse pression pour ces artistes », avance la productrice, Anne Marcassus, qui a fait son casting en majorité dans la troupe des Enfoirés, dont elle est la directrice artistique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2237cf9a-41e6-31dd-80c5-cf28b1cd2b9a",
                                        "entry_id": "5d802c28-5bdf-3276-9ed4-31dbc98374b4",
                                        "glosses": [
                                            "Celle qui coordonne et contrôle tous les aspects de la production d’une émission de radio."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bd62fe0-1209-481b-9a84-be35f783c711",
                                                "sense_id": "2237cf9a-41e6-31dd-80c5-cf28b1cd2b9a",
                                                "text": "Aujourd'hui, Charline Vanhoenacker et Juliette Arnaud reçoivent la productrice de radio Laure Adler !"
                                            }
                                        ]
                                    }
                                ]
                            },
