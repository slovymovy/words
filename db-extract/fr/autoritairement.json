        "fr-extract.jsonl": [
            {
                "entry_id": "e3fa4574-d4a9-3c0c-bf9e-b0dc7d2e86d1",
                "word": "autoritairement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4caa2e56-3bbe-3923-8f4c-c30fc3692713",
                        "entry_id": "e3fa4574-d4a9-3c0c-bf9e-b0dc7d2e86d1",
                        "glosses": [
                            "D’une manière autoritaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c095eac-34e5-4f3c-9081-b707495858e2",
                                "sense_id": "4caa2e56-3bbe-3923-8f4c-c30fc3692713",
                                "text": "L'insuffisance des troupes régulières me contraignait à temporiser et à agir plus politiquement qu’autoritairement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f747539-2707-4db0-9e00-e623bd60bbb4",
                        "source_entry_id": "e3fa4574-d4a9-3c0c-bf9e-b0dc7d2e86d1",
                        "source_sense_id": "4caa2e56-3bbe-3923-8f4c-c30fc3692713",
                        "target_lang_word": "authoritatively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "authoritatively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fd41570-5232-36f8-954a-201d2d103ec9",
                                        "entry_id": "f7f84e20-4808-373f-a71d-42cae4e31c29",
                                        "glosses": [
                                            "In an authoritative manner; with authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc0de0a4-bfe2-4905-b9b2-ef9395cbde1a",
                                                "sense_id": "0fd41570-5232-36f8-954a-201d2d103ec9",
                                                "text": "He has, of course, the right to speak authoritatively, and he laughs at my theory that there was a crack in Pansay's head and a little bit of the Dark World came through and pressed him to death."
                                            },
                                            {
                                                "example_id": "6dcd0dad-48ac-48d9-b2a6-6329133c80ab",
                                                "sense_id": "0fd41570-5232-36f8-954a-201d2d103ec9",
                                                "text": "The inability of Trump's own spokespeople to speak authoritatively on the president's thinking and actions -- a challenge even Trump himself has acknowledged -- has left the White House with an enormous credibility gap, and has tarnished the reputations of many of its most visible spokespeople."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26aa2232-ec26-4728-9c7e-a256acab7e90",
                        "source_entry_id": "e3fa4574-d4a9-3c0c-bf9e-b0dc7d2e86d1",
                        "source_sense_id": "4caa2e56-3bbe-3923-8f4c-c30fc3692713",
                        "target_lang_word": "commandingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commandingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a307b209-2d8c-3c33-87fb-1b14ab5717ac",
                                        "entry_id": "184a7722-cd23-3f5c-b476-ee52162198fe",
                                        "glosses": [
                                            "In a commanding fashion."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "368a4ca4-1921-4d4b-ac75-7905b4287dc8",
                                                "sense_id": "a307b209-2d8c-3c33-87fb-1b14ab5717ac",
                                                "text": "And yet, somehow, did Ahab—in his own proper self, as daily, hourly, and every instant, commandingly revealed to his subordinates,—Ahab seemed an independent lord […]"
                                            },
                                            {
                                                "example_id": "aaf5316a-6e43-4622-994a-dedfc3e8dd3f",
                                                "sense_id": "a307b209-2d8c-3c33-87fb-1b14ab5717ac",
                                                "text": "She could see it all so clearly, so commandingly, when she looked: it was when she took her brush in hand that the whole thing changed."
                                            },
                                            {
                                                "example_id": "1ab41c94-d27a-4ac4-b093-af6a2eb1fbdf",
                                                "sense_id": "a307b209-2d8c-3c33-87fb-1b14ab5717ac",
                                                "text": "“Delightful idea,” said Lady Partridge. […] / “It is, I believe, an irresistible one,” said Lipscomb, laying his left hand commandingly on the table."
                                            },
                                            {
                                                "example_id": "8916e1e7-32e3-4f62-b0b1-401df7135aa5",
                                                "sense_id": "a307b209-2d8c-3c33-87fb-1b14ab5717ac",
                                                "text": "“I ordered for the table,” she says, commandingly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f262f1ee-bec2-489e-8711-ce53881c7dd2",
                        "source_entry_id": "e3fa4574-d4a9-3c0c-bf9e-b0dc7d2e86d1",
