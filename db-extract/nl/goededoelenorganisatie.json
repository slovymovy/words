                        "examples": [
                            {
                                "example_id": "f029f246-6dfd-4158-932e-f1565e7a1a59",
                                "sense_id": "d1083f1b-f062-3eac-8340-8f52e5400a88",
                                "text": "Vorig jaar maakte goededoelenorganisatie VSBfonds bekend dat in 2018 de laatste prijs zou worden uitgereikt. De organisatie wilde zich richten op andere cultuurprojecten."
                            },
                            {
                                "example_id": "606d334d-a31c-478d-9bdd-18958f088eb1",
                                "sense_id": "d1083f1b-f062-3eac-8340-8f52e5400a88",
                                "text": "Organisator van het concert was Chime For Change, een goededoelenorganisatie opgezet door het Italiaanse modehuis Gucci. De organisatie zamelt geld in voor emancipatieprojecten in meer dan zeventig landen."
                            },
                            {
                                "example_id": "83916463-dd8d-4874-b710-ba0fb0ba695c",
                                "sense_id": "d1083f1b-f062-3eac-8340-8f52e5400a88",
                                "text": "Een rederij met ex-bootvluchtelingen aan het roer en moeders die andere vrouwen helpen met het oplossen van problemen. Het zijn twee van de dertien initiatieven die vandaag, op de Internationale Dag van de Vrede, een zogeheten vredesduif ontvingen van goededoelenorganisatie Pax. De duiven werden voor het eerst uitgereikt."
                            }
                        ]
