                "senses": [
                    {
                        "sense_id": "9f89e36d-0e47-369b-b9ed-7bd13701af42",
                        "entry_id": "59618e1b-5251-374c-b186-266e3f4b1b60",
                        "glosses": [
                            "Einrichtung, in der Filme vorgeführt werden"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e777ef3e-6112-40df-8bca-7f563c55dbcc",
                                "sense_id": "9f89e36d-0e47-369b-b9ed-7bd13701af42",
                                "text": "„Zu Kriegsbeginn gab es allein im Deutschen Kaiserreich mehr als 2500 Lichtspieltheater, die täglich von rund 1,4 Millionen Menschen besucht wurden.“"
                            },
                            {
                                "example_id": "13356565-3774-4cc9-8219-dcfcf346ae1c",
                                "sense_id": "9f89e36d-0e47-369b-b9ed-7bd13701af42",
                                "text": "„Eine große Entdeckung waren für Spicer, der viel Sinn fürs Drama hatte, die neuen Lichtspieltheater.“"
                            },
                            {
                                "example_id": "5313a0b4-20bc-475c-99c6-3bf7bedcf071",
                                "sense_id": "9f89e36d-0e47-369b-b9ed-7bd13701af42",
                                "text": "„Wie immer musste er rechtzeitig zur Abendvorstellung im Lichtspieltheater am Wedding sein.“"
                            },
                            {
                                "example_id": "d78d5525-c879-4518-bebe-e3b0d6486f7e",
                                "sense_id": "9f89e36d-0e47-369b-b9ed-7bd13701af42",
                                "text": "„Damals schuftete er vom Morgengrauen bis spät abends am Markt, meistens beim Fischhändler, und sicherte sich somit wenigstens eine Mahlzeit am Tag. Deswegen hatte er noch nicht einen Fuß in ein Lichtspieltheater setzen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
