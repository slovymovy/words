        "fr-extract.jsonl": [
            {
                "entry_id": "b8426c31-50ff-3799-8382-a5d3529f0769",
                "word": "sparadrap",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "79469059-804b-4cda-9fd4-e08dd07f3d95",
                        "entry_id": "b8426c31-50ff-3799-8382-a5d3529f0769",
                        "tags": [
                            "plural"
                        ],
                        "form": "sparadraps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31ec6e53-6c33-3e16-95ac-1c0dd28bf43b",
                        "entry_id": "b8426c31-50ff-3799-8382-a5d3529f0769",
                        "glosses": [
                            "Tissu recouvert d’une sorte d’emplâtre agglutinatif."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "76ce6afb-59c9-41c8-8c6c-3ab9f3a5bbd4",
                                "sense_id": "31ec6e53-6c33-3e16-95ac-1c0dd28bf43b",
                                "text": "Le taffetas d’Angleterre est un sparadrap."
                            },
                            {
                                "example_id": "2596869f-66b2-430b-8a72-354c6966a773",
                                "sense_id": "31ec6e53-6c33-3e16-95ac-1c0dd28bf43b",
                                "text": "Le sparadrap, collé sur sa joue, en tirait obliquement la peau tendue."
                            }
                        ]
                    },
                    {
                        "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                        "entry_id": "b8426c31-50ff-3799-8382-a5d3529f0769",
                        "glosses": [
                            "Bandage plus ou moins poreux, élastique, adhésif, qui s'applique sur la peau par simple pression et sert à maintenir un pansement ou sert de pansement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b794597-63fd-4090-83f8-60d1a779d6ba",
                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                "text": "Les pansements étaient compliqués et difficiles, la fixation des appareils et des linges par le sparadrap n’ayant pas encore été imaginée à cette époque."
                            },
                            {
                                "example_id": "4a1e8ff9-9018-4474-b4c2-6c7589cccb83",
                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                "text": "[Corte] est en train de téléphoner. Il n'a plus de bandages, mais seulement un pansement de sparadrap."
                            },
                            {
                                "example_id": "9b1b5768-3531-4958-9af2-5e7ea3f7b6f0",
                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                "text": "Papa n'avait plus son bandeau sur la tête, mais, pour ne pas exhiber son sparadrap et son crâne passé à la tondeuse, il avait mis sa grande viscope d'ouvrier sellier."
                            },
                            {
                                "example_id": "9895847a-e13a-407c-8735-cf1469a25c8b",
                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                "text": "Henri enleva son pansement, le remplaça par un carré de sparadrap."
                            },
                            {
                                "example_id": "93494abf-d847-47be-ab37-99a2eb49cdfa",
                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                "text": "Un sparadrap maintenait ouverte la paupière de son œil droit et lui donnait un air de boxeur égaré."
                            }
                        ]
                    },
                    {
                        "sense_id": "9363f25b-1503-3e28-9f04-c160bcb091db",
                        "entry_id": "b8426c31-50ff-3799-8382-a5d3529f0769",
                        "glosses": [
                            "Moyen de réparer quelque-chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f01ab15b-41c4-4cd6-b9bb-4350235d3c5a",
                                "sense_id": "9363f25b-1503-3e28-9f04-c160bcb091db",
                                "text": "Une politique sparadrap."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8722b586-033f-4a21-95e1-553bacedfa11",
                        "source_entry_id": "b8426c31-50ff-3799-8382-a5d3529f0769",
                        "source_sense_description": "Tissu recouvert d’une sorte d’emplâtre agglutinatif.",
                        "target_lang_word": "Pflaster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pflaster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8866553-8577-32be-8a51-d88be84764cf",
                                        "entry_id": "3c1165c8-668e-3c00-96ae-cbd6343eb1bc",
                                        "glosses": [
                                            "Klebeband als Heftpflaster, zur Fixierung von beispielsweise Wundauflagen, Schläuchen, Venenverweilkanülen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "7cf4c9f9-dbb8-324d-bf52-8f0fed872905",
                                        "entry_id": "3c1165c8-668e-3c00-96ae-cbd6343eb1bc",
                                        "glosses": [
                                            "Klebeband als selbstklebende Folie in Kombination mit einer Wundauflage (bei äußerlicher Verletzung am Körper)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "2b70188d-5168-33e1-b11f-0ed310348417",
                                        "entry_id": "3c1165c8-668e-3c00-96ae-cbd6343eb1bc",
                                        "glosses": [
                                            "Klebeband als Medium zur transdermalen Applikation von Wirkstoffen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "af1cb34a-6412-3c12-8907-e614be2745a3",
                                        "entry_id": "3c1165c8-668e-3c00-96ae-cbd6343eb1bc",
                                        "glosses": [
                                            "aus vielen einzelnen Steinen bestehender Straßenbelag; Gegend, Gebiet"
                                        ],
                                        "tags": [
                                            "auch im übertragenen Sinne für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d82041ba-a050-4e12-a59e-b72bec23f3d5",
                                                "sense_id": "af1cb34a-6412-3c12-8907-e614be2745a3",
                                                "text": "Eine Weile schwiegen beide Damen; im Augenblick aber, wo sie von dem holprigen Pflaster in den stillen Asphaltweg einbogen, sagte die Baronin: »Ich begreife Stechlin nicht, daß er nicht ein Coupé apart genommen.«."
                                            },
                                            {
                                                "example_id": "7b1869e8-0040-405c-b676-a31e174472ec",
                                                "sense_id": "af1cb34a-6412-3c12-8907-e614be2745a3",
                                                "text": "Tokio ist ein teures Pflaster, dort kann sich ein Single kaum eine Wohnung leisten."
                                            },
                                            {
                                                "example_id": "95a36943-a7d0-4681-aef9-2ccec87c40f4",
                                                "sense_id": "af1cb34a-6412-3c12-8907-e614be2745a3",
                                                "text": "Rio bei Nacht ist ein heißes Pflaster, man darf keinesfalls Wertsachen dabeihaben."
                                            },
                                            {
                                                "example_id": "a1ee4119-83ec-4ed3-aa24-ca82c3de72a7",
                                                "sense_id": "af1cb34a-6412-3c12-8907-e614be2745a3",
                                                "text": "Wenn Sie an unserer Universität Karriere machen wollen, haben Sie sich ein schwieriges Pflaster ausgesucht."
                                            },
                                            {
                                                "example_id": "8b914783-f5fe-433a-a59a-882f927aceaf",
                                                "sense_id": "af1cb34a-6412-3c12-8907-e614be2745a3",
                                                "text": "„Das Pflaster unter ihnen besteht aus roten Ziegeln.“"
                                            },
                                            {
                                                "example_id": "cf881cc2-6f2e-4e82-9051-977be4515f7e",
                                                "sense_id": "af1cb34a-6412-3c12-8907-e614be2745a3",
                                                "text": "„Denn wirklich Heinz, nachdem man ihn auf das Pflaster gestellt hatte mit seinen zwei Krücken, kam langsam den Boulevard de la Madelaine herauf, er erkannte mich auch, doch war er zu atemlos, um zu rufen.“"
                                            },
                                            {
                                                "example_id": "99c67ae5-a58e-4beb-908c-cea850d29a5e",
                                                "sense_id": "af1cb34a-6412-3c12-8907-e614be2745a3",
                                                "text": "„Eine Gaslaterne erleuchtete den Gehweg ein paar Schritte neben Shakespeare and Company und warf einen warmen Lichtschein auf das graue Pflaster und die cremeweiße Steinfassade des Gebäudes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a75fcce5-cf5d-3be3-84de-e26e2023f95f",
                                        "entry_id": "3c1165c8-668e-3c00-96ae-cbd6343eb1bc",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20de2e50-da47-49c1-be33-c45f3a917c88",
                                                "sense_id": "a75fcce5-cf5d-3be3-84de-e26e2023f95f",
                                                "text": "Die Verletzung am Arm von Peter wird durch die Krankenschwester mit einem Pflaster versorgt."
                                            },
                                            {
                                                "example_id": "10015783-8186-467d-ae9c-d7c8b7fee66b",
                                                "sense_id": "a75fcce5-cf5d-3be3-84de-e26e2023f95f",
                                                "text": "Ich will mit dem Rauchen aufhören und dachte, ich versuche es einmal mit Pflastern."
                                            },
                                            {
                                                "example_id": "8672130f-974b-4ed0-8637-0b6828132b60",
                                                "sense_id": "a75fcce5-cf5d-3be3-84de-e26e2023f95f",
                                                "text": "„Mama klebte mir ein Pflaster drüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
