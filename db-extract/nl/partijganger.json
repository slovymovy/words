                        "examples": [
                            {
                                "example_id": "64983aed-fd0b-4281-aba0-2ac835f588fa",
                                "sense_id": "c2527b11-9b94-3ea3-9260-bf394fbbb9c5",
                                "text": "Maar Harald? Ontvoerde landgenoten, geboeid bij een graf, neerschieten? Of hoe die rechtse partijgangers het in de praktijk ook aanpakten."
                            },
                            {
                                "example_id": "73111aef-d2e4-4f00-9146-8bfd5424c609",
                                "sense_id": "c2527b11-9b94-3ea3-9260-bf394fbbb9c5",
                                "text": "Op de verkiezingsavond van 15 maart staan vader Loek Hermans en zijn twee dochters Sophie en Caroliene na de eerste exitpoll even samen te praten. In het Haagse World Trade Centre, waar de VVD bijeen is, ziet een partijganger het trio en zegt: ,,Ha! De dynastie-Hermans! Heb je nog andere kinderen, Loek?’’"
                            }
                        ]
