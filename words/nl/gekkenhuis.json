            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7101450-4fd0-3576-a995-ec13351ae9e1",
                    "sense_definition": "Een zeer chaotische, drukke of verwarrende toestand of plek.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chaos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de uitverkoop was het een compleet <w>gekkenhuis</w> in de winkelstraat.",
                            "target_lang_translations": {
                                "en": "During the sale, the shopping street was a complete <w>madhouse</w>."
                            }
                        },
                        {
                            "text": "Op kantoor werd het een <w>gekkenhuis</w> toen de computers plotseling uitvielen.",
                            "target_lang_translations": {
                                "en": "The office became a <w>madhouse</w> when the computers suddenly crashed."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een compleet gekkenhuis"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figuurlijk gebruikt voor een chaotische situatie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A very chaotic, busy, or confusing place or state of affairs."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "madhouse",
                                "target_lang_sense_clarification": "chaotic place"
                            },
                            {
                                "target_lang_word": "bedlam",
                                "target_lang_sense_clarification": "scene of uproar and confusion"
                            },
                            {
                                "target_lang_word": "zoo",
                                "target_lang_sense_clarification": "wild or disorderly place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4798bb1a-0a7e-37dd-8a65-f61f866ed8b4",
                    "sense_definition": "Een psychiatrische inrichting of gesticht voor mensen met een psychische aandoening.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "inrichting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In historische romans werd zo'n instelling vaak aangeduid als een <w>gekkenhuis</w>.",
                            "target_lang_translations": {
                                "en": "In historical novels, such an institution was often referred to as an <w>insane asylum</w>."
                            }
                        },
                        {
                            "text": "Men besloot de verwarde man tijdelijk in een <w>gekkenhuis</w> op te nemen.",
                            "target_lang_translations": {
                                "en": "They decided to temporarily admit the confused man to an <w>insane asylum</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gesticht",
                        "krankzinnigengesticht",
                        "dolhuis",
                        "zothuis"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "verouderde en pejoratieve benaming voor een psychiatrische inrichting"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A psychiatric institution or asylum for people with mental illnesses (dated/pejorative)."
                    },
                    "translations": {
