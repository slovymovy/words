                        "ne pas avoir son pareil"
                    ]
                },
                {
                    "sense_id": "5a8d5d32-91a7-3854-bcb8-10999e87d54b",
                    "sense_definition": "Personnes de même condition, de même naissance ou de même caractère que la personne dont on parle ; ses pairs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il préfère la compagnie de ses <w>pareils</w> à celle des étrangers."
