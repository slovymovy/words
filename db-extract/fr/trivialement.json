        "fr-extract.jsonl": [
            {
                "entry_id": "02b8904a-89a5-3630-a891-2ba7f3ff6a73",
                "word": "trivialement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d17a33d5-4b4e-3cd9-97a4-8639dc5d7e75",
                        "entry_id": "02b8904a-89a5-3630-a891-2ba7f3ff6a73",
                        "glosses": [
                            "D’une manière triviale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5181cb74-24a1-4dfb-bd6a-b2eafef9d9ba",
                                "sense_id": "d17a33d5-4b4e-3cd9-97a4-8639dc5d7e75",
                                "text": "Pour ses contemporains, c'était un zozo. Un drôle d'oiseau ! Un original, comme on dit trivialement de quelqu'un, quand ses faits et gestes nous dépassent. Délicieux détail, Malcolm de Chazal avait un cheveu sur la langue, donc zozotait..."
                            },
                            {
                                "example_id": "0ca1449d-e331-449f-8047-461587de8f44",
                                "sense_id": "d17a33d5-4b4e-3cd9-97a4-8639dc5d7e75",
                                "text": "D’aucuns trouvent indécent que je puisse ainsi subordonner le travail au sexe, les mêmes donneurs de leçon n’ayant aucun mal à accepter que les artistes et autres intellectuels normalement constitués aient recours, trivialement, aux prostituées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a85a6d4-87c0-4630-9222-8f1f3c91f2f0",
                        "source_entry_id": "02b8904a-89a5-3630-a891-2ba7f3ff6a73",
                        "source_sense_id": "d17a33d5-4b4e-3cd9-97a4-8639dc5d7e75",
                        "target_lang_word": "coarsely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coarsely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f20b0daf-cdd8-330f-8500-b8528532e2a7",
                                        "entry_id": "02cc8cbf-653a-3586-a9a4-fa20baff3ad7",
                                        "glosses": [
                                            "in a coarse manner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "501ad2fb-c585-4233-9782-0d817556cf21",
                                                "sense_id": "f20b0daf-cdd8-330f-8500-b8528532e2a7",
                                                "text": "He stood transfixed before the unaccustomed view of London at night time, a vast panorama which reminded him […] of some wood engravings far off and magical, in a printshop in his childhood. They dated from the previous century and were coarsely printed on tinted paper, with tinsel outlining the design."
                                            },
                                            {
                                                "example_id": "0c33be7b-409a-4c22-9920-9a06885d5239",
                                                "sense_id": "f20b0daf-cdd8-330f-8500-b8528532e2a7",
                                                "text": "Wild nuts, peas, vetch, a legume which had edible seed pods, and grasses were often combined with pulses like beans or lentils, the most commonly identified ingredient, and at times, wild mustard. To make the plants more palatable, pulses, which have a naturally bitter taste, were soaked, coarsely ground or pounded with stones to remove their husk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dd701b9-f018-4153-a49c-584fb11a7f43",
                        "source_entry_id": "02b8904a-89a5-3630-a891-2ba7f3ff6a73",
                        "source_sense_id": "d17a33d5-4b4e-3cd9-97a4-8639dc5d7e75",
                        "target_lang_word": "crudely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crudely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d239ab2-33fb-3061-8838-6db169250fe1",
                                        "entry_id": "1d2684db-d9a1-30a6-a980-4529d81979f5",
                                        "glosses": [
                                            "In a crude manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb2062a4-69d1-4e8e-aabc-dddddacac35b",
                                                "sense_id": "6d239ab2-33fb-3061-8838-6db169250fe1",
                                                "text": "Her features had been crudely handsome, too, like Millie's, but booze had splodged their outlines."
                                            },
                                            {
                                                "example_id": "efba2f87-99d7-48ff-8ef1-31070e9f46af",
                                                "sense_id": "6d239ab2-33fb-3061-8838-6db169250fe1",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            },
                                            {
                                                "example_id": "3279c225-b7d4-4d7a-90e8-ff2107cb315a",
                                                "sense_id": "6d239ab2-33fb-3061-8838-6db169250fe1",
                                                "text": "Mr Netanyahu also called Mr Shapiro’s observations “unacceptable”. The ambassador too was accused of demonstrating a “double standard” and was crudely dismissed by a former Mr Netanyahu aide as a “little Jew boy” courting favour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
