                "senses": [
                    {
                        "sense_id": "f9e82a7d-7acb-37ec-876e-7c92119e84b7",
                        "entry_id": "268c3c63-63c6-366d-b728-1ecd1dc1db87",
                        "glosses": [
                            "Acronym of Bay Area Rapid Transit."
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "ae964cce-3384-4ff5-b792-8aa2ea40eca6",
                                "sense_id": "f9e82a7d-7acb-37ec-876e-7c92119e84b7",
                                "text": "I walk down to the BART station and catch the train back to the city and it’s night by the time it rises up from the tunnels under Oakland."
                            },
                            {
                                "example_id": "e2526877-eca0-43f9-889b-cfc06b16cdd8",
                                "sense_id": "f9e82a7d-7acb-37ec-876e-7c92119e84b7",
                                "text": "“Oakland Airport Connector service is running limited service due to a power outage. Shuttles will depart every 18 minutes,” BART said in a 2:38 p.m. PST update."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
