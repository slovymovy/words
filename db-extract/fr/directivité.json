                "senses": [
                    {
                        "sense_id": "922a1cb0-839b-3447-9afd-a8160a1de275",
                        "entry_id": "b2a618ac-a841-3eb5-9672-2ce465d829e2",
                        "glosses": [
                            "Propriété de capter ou d'émettre de manière préférentielle un rayonnement sonore ou électrique dans une direction déterminée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d42a6c1-8bd8-494b-8193-dbabf170fe3c",
                                "sense_id": "922a1cb0-839b-3447-9afd-a8160a1de275",
                                "text": "Une antenne directive possède un ou deux lobes nettement plus importants que les autres qu'on nomme « lobes principaux ». Elle sera d'autant plus directive que le lobe le plus important sera étroit. La directivité correspond à la largeur du lobe principal, entre les angles d'atténuation à 3 dB."
                            },
                            {
                                "example_id": "aa36ce67-1d76-412c-b883-f1a662e368ae",
                                "sense_id": "922a1cb0-839b-3447-9afd-a8160a1de275",
                                "text": "La directivité d’un radiotélescope est d’autant meilleure que le diamètre du miroir est plus grand et plus petite la longueur d’onde du rayonnement capté."
                            }
                        ]
                    }
                ],
