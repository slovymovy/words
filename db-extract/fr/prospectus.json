        "fr-extract.jsonl": [
            {
                "entry_id": "a85c463c-095c-3162-bce4-927a6fc279fd",
                "word": "prospectus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "edb5eb26-64df-3fbc-83a9-576a8cc03217",
                        "entry_id": "a85c463c-095c-3162-bce4-927a6fc279fd",
                        "glosses": [
                            "Programme qui se publie avant qu’un ouvrage paraisse, dans lequel on donne une idée de cet ouvrage, son format, son caractère, le nombre des volumes et des conditions de la souscription."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4bc53dde-71c6-4c08-abe3-d123fbb13566",
                                "sense_id": "edb5eb26-64df-3fbc-83a9-576a8cc03217",
                                "text": "Le moment venu on redistribua prospectus sur prospectus, cartes-annonces sur cartes-annonces; Paris s'emplit à nouveau de la nouvelle de l'apparition du roman à sensation et lorsque la publication en commença on tira à cent mille exemplaires un numéro gratuit que l'on sema dans la France entière."
                            },
                            {
                                "example_id": "793005ef-4f28-4eed-9210-064db9c67ccb",
                                "sense_id": "edb5eb26-64df-3fbc-83a9-576a8cc03217",
                                "text": "Le prospectus sur « la première livraison de l'Encyclopédie par ordre de matières » paru en 1782 annonce que la souscription « ouverte jusqu'à la fin Avril 1783 » s'élève maintenant à « 751 livres » ([…])."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2c4736d-379c-3800-a7d6-bc164ffd5a6d",
                        "entry_id": "a85c463c-095c-3162-bce4-927a6fc279fd",
                        "glosses": [
                            "Publicité, imprimé ou brochure, destiné à une promotion grand public."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f758f197-3be9-4fee-8a21-21699abb8d9a",
                                "sense_id": "f2c4736d-379c-3800-a7d6-bc164ffd5a6d",
                                "text": "Vauvinet était mis, comme les jeunes gens qui se livrent aux affaires, avec une recherche excessive qui, pour beaucoup d’entre eux est une espèce de prospectus."
                            },
                            {
                                "example_id": "06165fe3-e475-4dc2-a616-a4b9ca564672",
                                "sense_id": "f2c4736d-379c-3800-a7d6-bc164ffd5a6d",
                                "text": "Andoche connaît le Prospectus, il entre dans les idées du marchand, il n’est pas fier, il limousinera notre prospectus gratis."
                            },
                            {
                                "example_id": "a2d6c8b4-498d-47aa-b682-1be10e03883e",
                                "sense_id": "f2c4736d-379c-3800-a7d6-bc164ffd5a6d",
                                "text": "Milee est l'un des deux distributeurs français de prospectus avec La Poste. Sa mise en liquidation judiciaire et les 10.000 emplois concernés traduisent la fin d'une époque. C'était l'époque où Carrefour et Leclerc pouvaient, pour leurs grandes opérations promotionnelles, Noël, Pâques, la fête des mères, éditer et distribuer jusqu'à 25 millions de prospectus. Il y en avait un dans toutes les boîtes aux lettres de France."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bb6d9bc-e486-3f1a-8c11-b1d92142270a",
                        "entry_id": "a85c463c-095c-3162-bce4-927a6fc279fd",
                        "glosses": [
                            "Annonce de publicité quelconque, tract, dépliant."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "04a0602b-2aaa-47b1-aa6d-e549cbb43f00",
                                "sense_id": "3bb6d9bc-e486-3f1a-8c11-b1d92142270a",
                                "text": "Petit \"prospectus\" élevé au rang d'œuvre d'art, le flyer est un des moyens de diffusion de l'information parmi les plus efficaces et les plus branchés."
                            }
                        ]
                    },
                    {
                        "sense_id": "a28a79b5-9b30-3805-99b7-90d2ee50e814",
                        "entry_id": "a85c463c-095c-3162-bce4-927a6fc279fd",
                        "glosses": [
                            "Document préparé par une entreprise en lien avec l'offre ou l'émission de titres financiers, contenant des informations au sujet des titres et de leur émetteur, et destiné à des investisseurs potentiels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3527fd6-9b2b-4e35-bb7a-b41d256592a1",
                                "sense_id": "a28a79b5-9b30-3805-99b7-90d2ee50e814",
                                "text": "Le club reconnaît lui-même dans un prospectus boursier mardi 7 août être \"dépendant de la popularité et de la performance de son équipe\" et de sa \"capacité à retenir des employés clés, y compris les joueurs\", un facteur de risque important pour les actionnaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e69d0d3e-b080-4a62-830d-d9fd8a891207",
                        "source_entry_id": "a85c463c-095c-3162-bce4-927a6fc279fd",
                        "target_lang_word": "Flugblatt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flugblatt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07670029-04ce-3f2a-b21d-e9b43d78bb20",
                                        "entry_id": "8d81cc42-3c63-3f95-8288-f64641e374f8",
                                        "glosses": [
                                            "ein kleines Schriftstück (ein Zettel, Faltblatt oder Ähnliches) mit Informationen oder Werbung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a4e0b24-3e21-48ff-974e-06b608f1b1eb",
                                                "sense_id": "07670029-04ce-3f2a-b21d-e9b43d78bb20",
                                                "text": "Verteile diese Flugblätter, damit mehr Kundschaft kommt."
                                            },
                                            {
                                                "example_id": "da458aca-8637-47e0-891b-ee5e6b1b32b8",
                                                "sense_id": "07670029-04ce-3f2a-b21d-e9b43d78bb20",
                                                "text": "„Vor dem Rathaus werden Stöße von Flugblättern abgeladen und verteilt.“"
                                            },
                                            {
                                                "example_id": "73326622-1752-4012-baea-c2687dc0c439",
                                                "sense_id": "07670029-04ce-3f2a-b21d-e9b43d78bb20",
                                                "text": "„Beim Verteilen von Flugblättern, erinnert sich der Veteran, halfen auch weiße Portugiesen, Gegner der Diktatur.“"
                                            },
                                            {
                                                "example_id": "33752c63-5aa3-4d8b-8e85-340ef488bae5",
                                                "sense_id": "07670029-04ce-3f2a-b21d-e9b43d78bb20",
                                                "text": "„Wir redeten, diskutierten, verfassten Flugblätter, Zeitschriften, Streitschriften.“"
                                            },
                                            {
                                                "example_id": "69a0db43-8d47-4ed8-9ef9-83628c25d85b",
                                                "sense_id": "07670029-04ce-3f2a-b21d-e9b43d78bb20",
                                                "text": "„Allerhand Flugblätter wurden verteilt, an Allerheiligen war der Besuch der nationalen Gedenkstätten größer als in früheren Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36aff350-aa21-46e4-8299-f321122c88b7",
                        "source_entry_id": "a85c463c-095c-3162-bce4-927a6fc279fd",
