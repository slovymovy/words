                                "target_senses": [
                                    {
                                        "sense_id": "85cae1e4-1e74-3683-a6b8-84a4fa135ecb",
                                        "entry_id": "a9e9118c-aef5-3988-97df-fc757f3313ab",
                                        "glosses": [
                                            "übereinstimmend mit objektiven Rechtsnormen oder subjektivem Rechtsempfinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f10869d-1dce-452a-a1e6-122080d15618",
                                                "sense_id": "85cae1e4-1e74-3683-a6b8-84a4fa135ecb",
                                                "text": "Durch das Urteil erhielt der Verbrecher doch noch seine gerechte Strafe."
                                            },
                                            {
                                                "example_id": "4d5b7a65-8185-4d80-91e1-95e0afb3509c",
                                                "sense_id": "85cae1e4-1e74-3683-a6b8-84a4fa135ecb",
                                                "text": "Die Kita-Beiträge sind schon lange in der Diskussion. Kita für alle und das umsonst - wäre das gerecht?"
                                            },
                                            {
                                                "example_id": "342e325e-427d-488b-8460-2fe62f6a25d4",
                                                "sense_id": "85cae1e4-1e74-3683-a6b8-84a4fa135ecb",
                                                "text": "„Gott verbietet euch nicht, zu denen, die euch nicht der Religion wegen bekämpft und nicht aus euren Häusern vertrieben haben, freundlich zu sein und sie gerecht zu behandeln. Siehe, Gott liebt die, die gerecht handeln.“"
                                            },
                                            {
                                                "example_id": "8feee4ad-1268-4e05-a013-498700ee821f",
                                                "sense_id": "85cae1e4-1e74-3683-a6b8-84a4fa135ecb",
                                                "text": "[Da redete Jesus zu dem Volk und zu seinen Jüngern und sprach: …] So auch ihr: Von außen scheint ihr vor den Menschen gerecht, aber innen seid ihr voller Heuchelei und missachtet das Gesetz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c2edc209-8192-3f0d-b18c-412df35ced49",
                                        "entry_id": "a9e9118c-aef5-3988-97df-fc757f3313ab",
                                        "glosses": [
                                            "allgemeinen, sachlichen Normen entsprechend"
                                        ],
