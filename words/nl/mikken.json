{
    "word_family": [
        "gemik",
        "mikpunt",
        "mik",
        "gemikt"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "070b0044-ca35-3823-aaf1-0c1b94bcd16e",
                    "sense_definition": "een wapen, voorwerp of blik op een bepaald doel richten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "doel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ervaren boogschutter moest zorgvuldig <w>mikken</w> om de roos precies in het midden te raken.",
                            "target_lang_translations": {
                                "en": "The experienced archer had to <w>aim</w> carefully to hit the bullseye dead center."
                            }
                        },
                        {
                            "text": "Hij <w>mikte</w> langzaam op het doel voordat hij de bal met kracht wegschopte.",
                            "target_lang_translations": {
                                "en": "He slowly <w>took aim</w> at the goal before kicking the ball with force."
                            }
                        }
                    ],
                    "synonyms": [
                        "richten"
                    ],
                    "common_phrases": [
                        "goed mikken",
                        "mikken op"
                    ],
                    "target_lang_definitions": {
                        "en": "to direct a weapon, object, or gaze toward a specific target"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to aim",
                                "target_lang_sense_clarification": "point a weapon or object at a target"
                            },
                            {
                                "target_lang_word": "to take aim",
                                "target_lang_sense_clarification": "prepare to shoot or hit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8e9e499-d8eb-35a9-8617-34ce311b5de7",
                    "sense_definition": "iets nonchalant of krachtig ergens heen gooien",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "werpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Mik</w> dat oude klokhuis maar direct in de prullenbak naast de deur.",
                            "target_lang_translations": {
                                "en": "Just <w>chuck</w> that old apple core directly into the trash can beside the door."
                            }
                        },
                        {
                            "text": "Na de lange werkdag <w>mikte</w> zij haar zware tas moeiteloos in de hoek.",
                            "target_lang_translations": {
                                "en": "After the long workday, she effortlessly <w>tossed</w> her heavy bag into the corner."
                            }
                        }
                    ],
                    "synonyms": [
                        "gooien",
                        "werpen",
                        "mieteren",
                        "flikkeren",
                        "smijten"
                    ],
                    "common_phrases": [
                        "in de prullenbak mikken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruikt voor gooien"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to casually or forcefully toss or chuck something somewhere"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to chuck",
                                "target_lang_sense_clarification": "informally throw"
                            },
                            {
                                "target_lang_word": "to toss",
                                "target_lang_sense_clarification": "casually throw"
                            },
                            {
                                "target_lang_word": "to fling",
                                "target_lang_sense_clarification": "throw with force or carelessness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d120da6-8d44-3853-bf2a-69ec210510a7",
                    "sense_definition": "zich een bepaald doel stellen of ergens naar streven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het nieuwe marketingproject <w>mikt</w> vooral op een veel jongere doelgroep van studenten.",
                            "target_lang_translations": {
                                "en": "The new marketing project mainly <w>targets</w> a much younger demographic of students."
                            }
                        },
                        {
                            "text": "De startende ondernemer <w>mikte</w> erop om binnen een jaar winstgevend te zijn.",
                            "target_lang_translations": {
                                "en": "The beginning entrepreneur <w>aimed</w> to be profitable within a year."
                            }
                        }
                    ],
                    "synonyms": [
                        "munten"
                    ],
                    "common_phrases": [
                        "mikken op succes"
                    ],
                    "target_lang_definitions": {
                        "en": "to set a goal, target a specific group, or strive toward an outcome"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to aim",
                                "target_lang_sense_clarification": "strive for or direct effort toward"
                            },
                            {
                                "target_lang_word": "to target",
                                "target_lang_sense_clarification": "focus on a particular audience or goal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "013271e9-3589-3b4f-a449-f99e28c5b147",
                    "sense_definition": "een aanzet tot een beweging maken of zich verroeren",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zodra de strenge bewaker binnenstapte, durfde geen enkele gevangene nog te <w>mikken</w>.",
                            "target_lang_translations": {
                                "en": "As soon as the strict guard stepped in, not a single prisoner dared to <w>budge</w>."
                            }
                        },
                        {
                            "text": "Het bange kind bleef roerloos staan en <w>mikte</w> niet tijdens het strenge verhoor.",
                            "target_lang_translations": {
                                "en": "The frightened child stood motionless and did not <w>stir</w> during the strict questioning."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to make a slight movement or stir"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to budge",
                                "target_lang_sense_clarification": "make the slightest movement"
                            },
                            {
                                "target_lang_word": "to stir",
                                "target_lang_sense_clarification": "move slightly"
                            }
                        ]
                    }
                }
            ]
        },
        {
