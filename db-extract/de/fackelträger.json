                "senses": [
                    {
                        "sense_id": "2f34db11-ad3b-30b2-877f-d8597199e55d",
                        "entry_id": "539112aa-0637-30d0-80c3-ab7b8ccc8f2d",
                        "glosses": [
                            "Person, die eine brennende Fackel trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e215abd8-233d-469e-bbef-95fe765c88f8",
                                "sense_id": "2f34db11-ad3b-30b2-877f-d8597199e55d",
                                "text": "„Auf einem entsetzlichen Platz bildete sich eine Art Prozession - zehn der Krötenwesen und 24 fast menschliche Fackelträger, elf auf jeder Seite und jeweils einer vorn und einer am Ende der Aufstellung.“"
                            },
                            {
                                "example_id": "63545545-68e5-4d5f-a12e-961a53ca1320",
                                "sense_id": "2f34db11-ad3b-30b2-877f-d8597199e55d",
                                "text": "„Jimenez blickte ihn an und nickte, das Zeichen wurde an die Fackelträger weitergegeben und das Feuer entfacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a0d1984-5633-4e39-ba18-0a08b7e04476",
