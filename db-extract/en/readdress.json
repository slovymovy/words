                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b982de61-f53a-45e2-bf52-d7a0892d019c",
                                "sense_id": "83ffd9c1-9189-30e6-b585-d7b17fd06aec",
                                "text": "John doesn't live there any more. You'd better readdress that parcel."
                            },
                            {
                                "example_id": "f6a5e9e7-4324-47a4-93cb-9366a82e5cdb",
                                "sense_id": "83ffd9c1-9189-30e6-b585-d7b17fd06aec",
                                "text": "We can use this relocator code ourselves to readdress the DOS to the memory level that we want."
                            }
                        ]
