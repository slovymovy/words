                    {
                        "translation_id": "89e2f284-5a5f-4990-869b-df0dd1db932d",
                        "source_entry_id": "987b900b-1618-3b9d-a14d-5c04f5bd3134",
                        "source_sense_description": "The official residence of the President of France",
                        "target_lang_word": "Élysée",
