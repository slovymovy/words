                        "target_lang_word": "patinajcı",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "72be6daf-7abb-491f-8e22-d7de2ab64105",
                        "source_entry_id": "07dd5056-9e34-3cf1-80ab-ac505acfa986",
                        "source_sense_id": "3aa7b979-26dd-378c-9231-bb740af10a44",
                        "target_lang_word": "patineur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patineur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03957d02-4db9-34ae-9650-a0ec1a933649",
                                        "entry_id": "f7d3c076-d7e5-3d33-8976-64e566f0dc00",
                                        "glosses": [
                                            "Personne qui se déplace en glissant sur la glace à l’aide de patins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "647c725f-f65a-4f11-b838-0755d4a441b4",
                                                "sense_id": "03957d02-4db9-34ae-9650-a0ec1a933649",
                                                "text": "Il y avait beaucoup de patineurs sur la rivière, sur le canal."
                                            },
                                            {
                                                "example_id": "178223bb-44bc-4c6a-9878-5a84fb64715f",
                                                "sense_id": "03957d02-4db9-34ae-9650-a0ec1a933649",
                                                "text": "Le patineur le plus fort est aussi le patineur le plus intelligent sur la piste, celui qui accepte de laisser ses adversaires le dépasser en sachant qu’il pourra reprendre la tête au bon moment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02f0c2f6-5e12-4204-8670-0c19632537ca",
                        "source_entry_id": "07dd5056-9e34-3cf1-80ab-ac505acfa986",
                        "source_sense_id": "3aa7b979-26dd-378c-9231-bb740af10a44",
                        "target_lang_word": "coureur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coureur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf18acbd-5d9b-37cc-99ab-df7b24beff41",
                                        "entry_id": "d919b2ad-59f6-3906-9732-e4d7ef5af3c9",
                                        "glosses": [
                                            "Celui qui se livre à l’exercice de la course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e891d478-391f-4f5e-8b76-b4f32485fb3b",
                                                "sense_id": "bf18acbd-5d9b-37cc-99ab-df7b24beff41",
                                                "text": "C’est le meilleur coureur qu’on ait jamais vu."
                                            },
                                            {
                                                "example_id": "a8880d94-44e1-4696-8dba-0abeb3b38b4c",
                                                "sense_id": "bf18acbd-5d9b-37cc-99ab-df7b24beff41",
                                                "text": "Pourquoi s'était-elle mis en tête que la nouvelle lui arriverait en route, c'est-à-dire qu'elle rencontrerait le coureur chargé de lui apporter le télégramme ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c3156a4-59f8-3f42-b7fb-a4d9cd798905",
                                        "entry_id": "d919b2ad-59f6-3906-9732-e4d7ef5af3c9",
                                        "glosses": [
                                            "Celui qui dispute le prix dans une course à pied, à bicyclette ou à cheval."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbdfa3bb-18fb-4998-9ad7-8746aaa3cc19",
                                                "sense_id": "8c3156a4-59f8-3f42-b7fb-a4d9cd798905",
                                                "text": "A peine en a-t-il prévenu Barth que, gadouilleux et crotté, il cingle vers le Normandy avec la détermination d'un coureur olympique en espoir de médaille d'or."
                                            },
                                            {
                                                "example_id": "837c1479-7c86-48f8-af33-4f1c32fa9473",
                                                "sense_id": "8c3156a4-59f8-3f42-b7fb-a4d9cd798905",
                                                "text": "Au général, le Danois Joshua Gudnitz (Coloquick) est toujours leader avant la 3ᵉ étape qui mènera, ce dimanche, les coureurs de Priziac à Carhaix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c16e0bb3-726d-3b0a-892f-dd69c46bd3d4",
                                        "entry_id": "d919b2ad-59f6-3906-9732-e4d7ef5af3c9",
                                        "glosses": [
                                            "Cheval de selle, que sa taille et sa légèreté rendent propre à la course."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5a78f5c-84b3-421b-b6e8-7fe7d5becd28",
                                                "sense_id": "c16e0bb3-726d-3b0a-892f-dd69c46bd3d4",
                                                "text": "Il avait d’excellents coureurs dans son écurie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e2ad87d-0275-3e6f-b953-153cd161f42f",
                                        "entry_id": "d919b2ad-59f6-3906-9732-e4d7ef5af3c9",
                                        "glosses": [
                                            "Celui qui va et vient, qui est souvent par la ville ou en voyage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd96434-fd63-4c34-9d40-ec48ab68f593",
                                                "sense_id": "2e2ad87d-0275-3e6f-b953-153cd161f42f",
                                                "text": "C’est un grand coureur, un coureur perpétuel, on ne le trouve jamais à la maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dd7872d-58e1-32bb-b436-dc31110802ac",
                                        "entry_id": "d919b2ad-59f6-3906-9732-e4d7ef5af3c9",
                                        "glosses": [
                                            "Celui qui court le guilledou."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f7fb5a1-1724-40bb-917e-522346021101",
                                                "sense_id": "6dd7872d-58e1-32bb-b436-dc31110802ac",
                                                "text": "Il laissait un fils Pierre Lenoir, qui ne valait pas cher. Un amoral, un de ces coureurs et de ces faibles qui sont capables de toutes les folies pour la première femme qui passe et qu'ils ont momentanément dans la peau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df09382b-8907-39e7-b934-db65c213f47f",
                                        "entry_id": "d919b2ad-59f6-3906-9732-e4d7ef5af3c9",
                                        "glosses": [
                                            "Éclaireur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de43ad2-0465-4701-9ae3-52bc92849432",
                                                "sense_id": "df09382b-8907-39e7-b934-db65c213f47f",
                                                "text": "Vers midi, les grand’gardes signalent des coureurs allemands dans la direction de Givron et d'Adon ; des cavaliers isolés s'approchent de Chaumont-Porcien, et, reçus à coups de fusil, se replient vivement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "403c57cb-d2f5-3824-b94b-8ab2f7d5b7d4",
                                        "entry_id": "d919b2ad-59f6-3906-9732-e4d7ef5af3c9",
                                        "glosses": [
                                            "Rampant ; qui émet des tiges rampant à la surface du sol."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7356f59b-7fe3-463a-bc20-278d284d8736",
                                                "sense_id": "403c57cb-d2f5-3824-b94b-8ab2f7d5b7d4",
                                                "text": "Repiquer à exposition ensoleillée à la mi-mai à 1 m en tous sens pour les variétés non coureuses et de 1,20 m sur le rangs et de 2 m entre les rangs pour les variétés coureuses. Arrosages. Apport de compost conseillé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
