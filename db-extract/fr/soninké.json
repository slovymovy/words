                        "glosses": [
                            "Langue de la famille nigéro-congolaise et du sous-groupe mandé, parlée par environ un million de personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df1d1578-832c-498b-a9a8-5ef80207d7f1",
                                "sense_id": "bb0f725e-2f8b-3763-89d5-303f082bdd98",
                                "text": "Il existe par ailleurs des langues mandées non mandingues, dont le soninké parlé dans le nord-ouest du Mali et le soussou de Guinée maritime."
                            }
                        ]
                    }
                ],
