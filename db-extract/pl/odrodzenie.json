                "senses": [
                    {
                        "sense_id": "e33872eb-e249-3d24-b197-d30572b3aeec",
                        "entry_id": "b26e637c-e3d5-3110-8552-ab0c93a747bc",
                        "glosses": [
                            "rzecz. odczas. od odrodzić"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0165e51a-4a64-4685-a335-8d845282b461",
                                "sense_id": "e33872eb-e249-3d24-b197-d30572b3aeec",
                                "text": "Makówki ofiarowywano Demeter na misteriach eleuzyńskich jako symbol ziemi, snu i zapomnienia (po śmierci i przed odrodzeniem)."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "955e7cc6-f0e1-3d49-819b-3b20d0b4ea29",
                        "entry_id": "b26e637c-e3d5-3110-8552-ab0c93a747bc",
                        "glosses": [
                            "epoka w historii kultury europejskiej wieku XV i XVI"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c3d58b7-e035-40a6-bf9d-740ab524b372",
                                "sense_id": "955e7cc6-f0e1-3d49-819b-3b20d0b4ea29",
                                "text": "Rzeźba nagrobna, zgodnie z prądami odrodzenia, realistycznie oddawała rysy i postać zmarłego, przedstawiając go w charakterystycznej, na wpół podpartej pozie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8d30993-7a0e-4f76-b95c-8fb76d824cb7",
                        "source_entry_id": "b26e637c-e3d5-3110-8552-ab0c93a747bc",
                        "source_sense_id": "e33872eb-e249-3d24-b197-d30572b3aeec",
