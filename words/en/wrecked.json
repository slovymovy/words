                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "破坏",
                                "target_lang_sense_clarification": "使严重受损或毁坏"
                            },
                            {
                                "target_lang_word": "毁坏",
                                "target_lang_sense_clarification": "使损坏到无法使用"
                            },
                            {
                                "target_lang_word": "撞毁",
                                "target_lang_sense_clarification": "因撞击而毁坏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0ee4cdfa-cd1e-3d78-8738-e9cf79a3271e",
                    "sense_definition": "Destroyed, usually in an accident; severely damaged to the point of being unusable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanics inspected the <w>wrecked</w> car to see if any parts could be salvaged.",
                            "target_lang_translations": {
                                "zh": "技工们检查了那辆<w>报废的</w>汽车，看是否还有零件可以使用。"
                            }
                        },
                        {
                            "text": "They found a <w>wrecked</w> ship partially submerged near the rocky shore.",
                            "target_lang_translations": {
                                "zh": "他们在岩石嶙峋的海岸附近发现了一艘部分被淹没的<w>遇难</w>船只。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ruined"
                    ],
                    "common_phrases": [
                        "wrecked car",
                        "wrecked ship"
                    ],
                    "target_lang_definitions": {
                        "zh": "被损毁的；在事故中遭到严重破坏至无法使用的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "损坏的",
                                "target_lang_sense_clarification": "遭到严重破坏的"
                            },
                            {
                                "target_lang_word": "报废的",
                                "target_lang_sense_clarification": "受损严重无法再使用的"
                            },
                            {
                                "target_lang_word": "遇难的",
                                "target_lang_sense_clarification": "常指失事遭毁的船只等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9671451-b252-347a-8416-655f67e84d45",
                    "sense_definition": "Extremely intoxicated from alcohol or drugs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After having so many drinks at the party, he was completely <w>wrecked</w>.",
                            "target_lang_translations": {
                                "zh": "在派对上喝了那么多酒之后，他彻底<w>烂醉</w>了。"
                            }
                        },
                        {
                            "text": "They walked home slowly because their friends were too <w>wrecked</w> to drive.",
                            "target_lang_translations": {
                                "zh": "他们慢慢走回家，因为他们的朋友都<w>酩酊大醉</w>，无法开车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk",
                        "stoned"
                    ],
                    "common_phrases": [
                        "get wrecked"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（俚语）极度醉酒的；因酒精或药物而神志不清的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "烂醉的",
                                "target_lang_sense_clarification": "饮酒过量神志不清的"
                            },
                            {
                                "target_lang_word": "酩酊大醉的",
                                "target_lang_sense_clarification": "喝得极醉的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab94a922-6f51-3435-8ace-16992b7506a6",
                    "sense_definition": "Utterly defeated, humiliated, or publicly exposed in a competition, game, or argument.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His opponent got totally <w>wrecked</w> during the final round of the debate.",
                            "target_lang_translations": {
                                "zh": "他的对手在辩论的最后一轮中被彻底<w>击溃</w>了。"
                            }
                        },
                        {
                            "text": "The rookie player was completely <w>wrecked</w> by the champion in just two moves.",
                            "target_lang_translations": {
                                "zh": "那名新手玩家仅仅两招就被冠军彻底<w>完虐</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rekt"
                    ],
                    "common_phrases": [
                        "get wrecked"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（俚语）惨败的；在竞争、游戏或辩论中被彻底击垮或碾压的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "被碾压",
                                "target_lang_sense_clarification": "在比赛或竞争中毫无还手之力地惨败"
                            },
                            {
                                "target_lang_word": "被完虐",
                                "target_lang_sense_clarification": "网络俚语，指彻底输掉比赛"
                            },
                            {
                                "target_lang_word": "惨败",
                                "target_lang_sense_clarification": "彻底失败"
                            }
                        ]
                    }
                }
            ]
        }
    ]
