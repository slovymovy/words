                                "target_senses": [
                                    {
                                        "sense_id": "2b5ef8c0-2243-3df5-8497-3383fe454253",
                                        "entry_id": "2c4c31aa-c236-38fc-aad3-078e30999d47",
                                        "glosses": [
                                            "per Telefonleitung übermitteltes Dokument, Schriftstück, Foto oder Zeichnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "725bf875-eca3-4060-9b1a-97dc7cb1b935",
                                                "sense_id": "2b5ef8c0-2243-3df5-8497-3383fe454253",
                                                "text": "Ich sende Klaus ein Fax."
                                            },
                                            {
                                                "example_id": "2ff17158-400a-4e36-a23c-2b31ec15e4dd",
                                                "sense_id": "2b5ef8c0-2243-3df5-8497-3383fe454253",
                                                "text": "„Oliver faxt noch am selben Abend sein Kündigungsschreiben an den Verlag, das haben wir uns gut überlegt wegen des Datumsstempels auf dem Fax.“"
                                            },
                                            {
                                                "example_id": "113176c3-535e-4e00-b994-4f079e3cfab4",
                                                "sense_id": "2b5ef8c0-2243-3df5-8497-3383fe454253",
                                                "text": "„Dies sei nicht der Fall, weil der Fax kein Geheimnis dargestellt habe und es auch an einer Gefährdung der Aufgabe der Armee mangle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80468df7-4fc3-38c9-bc65-2ef2b2260623",
                                        "entry_id": "2c4c31aa-c236-38fc-aad3-078e30999d47",
                                        "glosses": [
                                            "Faxgerät"
                                        ],
                                        "tags": [
                                            "Kurzwort für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a321f918-45ab-4674-8ec3-ef50f19bc165",
                                                "sense_id": "80468df7-4fc3-38c9-bc65-2ef2b2260623",
                                                "text": "Unser Fax war ausgeschaltet."
                                            },
                                            {
                                                "example_id": "f7b772d2-c467-4753-b173-443168febd2c",
                                                "sense_id": "80468df7-4fc3-38c9-bc65-2ef2b2260623",
                                                "text": "„Sein Ziel ist es, als Erster im Büro zu sein, um sein Kündigungsschreiben aus dem Fax zu nehmen, bevor es jemand sieht.“"
                                            },
                                            {
                                                "example_id": "e6182d3a-6656-4223-90aa-ffee1c44b24f",
                                                "sense_id": "80468df7-4fc3-38c9-bc65-2ef2b2260623",
                                                "text": "„Okay, ich werde dir die Adresse per Fax senden, und dann hast du sie, wenn du vom Essen zurück bist, okay?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
