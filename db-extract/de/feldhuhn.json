                        "entry_id": "ad05d112-bd08-3652-b214-41a1bcf362db",
                        "glosses": [
                            "ein Vertreter aus der Unterfamilie der Feldhühner (Perdicinae) aus der Familie der Fasanenartigen mit 132 Arten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff17d80d-670c-4811-8539-8c2348cf9628",
                                "sense_id": "67ac85b9-fe01-3115-935c-dcff29537783",
                                "text": "„Heute ist es üblich, die Raufußhühner, Feldhühner, Truthühner, Fasanen und Pfauen als Fasanenartige zusammenzufassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
