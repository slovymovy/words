                                            {
                                                "example_id": "3255ff8a-cbb2-4de4-b41d-8585e3dc536f",
                                                "sense_id": "fd82c16c-2be7-36ab-9a5b-8de1f38eb5c8",
                                                "text": "La culture de l’échalotte (Allium ascalonicum, lin), présente des résultats assez incertains pour étonner un grand nombre de cultivateurs."
                                            },
                                            {
                                                "example_id": "e6840c91-69eb-4e51-8ddd-c910165b08e9",
                                                "sense_id": "fd82c16c-2be7-36ab-9a5b-8de1f38eb5c8",
                                                "text": "Comme à son haleine mademoiselle aurait pu s’apercevoir qu’elle buvait, elle mangea de l’ail et de l’échalotte, et cacha avec leur empuantissement l’odeur de ses ivresses."
                                            }
                                        ]
                                    }
