                        "examples": [
                            {
                                "example_id": "335cf92d-6347-4330-b0a8-085a49d25155",
                                "sense_id": "8cae7985-812f-313f-a10a-53780444e3ad",
                                "text": "Lubię sosik z grzybkami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0465d02a-35b8-3dfa-9846-3aee4031af1f",
                        "entry_id": "fa94db1d-df0c-3d0f-b01e-7e0476c9f720",
                        "glosses": [
                            "mały grzyb"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "338f54a2-7be4-3bc8-ae8f-82b78b5d3181",
                        "entry_id": "fa94db1d-df0c-3d0f-b01e-7e0476c9f720",
                        "glosses": [
                            "przedmiot, obiekt przypominający swoim kształtem owocnik grzyba"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d92c1fc7-5e91-40fe-a19c-25ec9cb6517a",
                                "sense_id": "338f54a2-7be4-3bc8-ae8f-82b78b5d3181",
                                "text": "Rano widać z okien hotelu poruszające się szybko grzybki parasoli i nieruchome, zastygłe w dziwacznej pozie, odwrócone krzesełka ulicznej kawiarni"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "42bc07b2-27cb-36e7-bea2-e149de4546ce",
                        "entry_id": "fa94db1d-df0c-3d0f-b01e-7e0476c9f720",
                        "glosses": [
                            "część składowa zaworu zamykająca i otwierająca przepływ"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d6ecfc-6743-4ca1-8d63-279f154a373d",
                                "sense_id": "42bc07b2-27cb-36e7-bea2-e149de4546ce",
                                "text": "…za duży luz zwiększa hałaśliwość pracy rozrządu i obciążenia dynamiczne części rozrządu, co prowadzi do przyspieszonego wybijania gniazda zaworu i spowodować może nawet urwanie grzybka"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "79c355f5-fd4f-3c0c-89d4-0ed736049205",
                        "entry_id": "fa94db1d-df0c-3d0f-b01e-7e0476c9f720",
                        "glosses": [
                            "przyrząd do cerowania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec10ac9f-8a1f-43a2-90d8-7f5324d11d6b",
                                "sense_id": "79c355f5-fd4f-3c0c-89d4-0ed736049205",
                                "text": "Dziura w cerowanej pończosze wydała jej się beznadziejnie wielka, a grzybek kręcił się jak opętany, nie mogąc we wnętrzu tej pięty odpowiedniego miejsca znaleźć"
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "3159732b-ea92-3375-a771-518c290cab4c",
                        "entry_id": "fa94db1d-df0c-3d0f-b01e-7e0476c9f720",
                        "glosses": [
                            "krótka fryzura damska i (rzadziej) męska"
                        ],
                        "tags": [
                            "fryz."
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.6\""
                    },
                    {
                        "sense_id": "b0321bcb-d1fb-3714-bc0f-cd00584c2ce6",
                        "entry_id": "fa94db1d-df0c-3d0f-b01e-7e0476c9f720",
                        "glosses": [
                            "wywrotka jachtu kilem lub mieczem do góry"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "73cfcafc-800c-43cb-aa88-ac1a9b5180ea",
                                "sense_id": "b0321bcb-d1fb-3714-bc0f-cd00584c2ce6",
                                "text": "Wykonałem zbyt gwałtowny zwrot i w efekcie jacht zrobił grzybka."
                            }
                        ],
                        "sense_index_json": "\"1.7\""
                    },
                    {
                        "sense_id": "109c89a9-bcd2-3c40-9cb9-0136c7c0f933",
                        "entry_id": "fa94db1d-df0c-3d0f-b01e-7e0476c9f720",
                        "glosses": [
                            "rodzaj omletu z dodatkiem mąki"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.8\""
                    }
                ],
                "translations": [
