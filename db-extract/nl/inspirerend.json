                            {
                                "example_id": "646fb265-e188-421a-8184-5845c361c432",
                                "sense_id": "e32b1615-61a7-3b1c-afb4-af6f7c2a1cea",
                                "text": "De coach gaf een zeer inspirerende speech."
                            },
                            {
                                "example_id": "d29691ff-3168-45d9-8dce-69b15d86fbb2",
                                "sense_id": "e32b1615-61a7-3b1c-afb4-af6f7c2a1cea",
                                "text": "Hij had nieuw en inspirerend werk."
                            },
                            {
                                "example_id": "2230f124-6214-478e-ba85-4f8aa69222f3",
                                "sense_id": "e32b1615-61a7-3b1c-afb4-af6f7c2a1cea",
                                "text": "Hoewel de feesten de hoofdrol spelen, hebben ook enkele andere inspirerende en schilderachtige figuren een plaats gekregen. Zoals Franciscus, Hieronymus en Christofoor, die de hele wereld (het Christuskind) op zijn schouder draagt."
                            }
                        ]
                    }
