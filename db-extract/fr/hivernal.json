                                "target_senses": [
                                    {
                                        "sense_id": "e91d435e-e05d-36c0-a14b-163303b06c91",
                                        "entry_id": "0e1ed8d0-2d30-32c6-b9d7-8e2e3b9197d4",
                                        "glosses": [
                                            "Suggestive or characteristic of winter; cold, stormy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8713ee1e-8ae3-4570-92d8-88148702a3ae",
                                                "sense_id": "e91d435e-e05d-36c0-a14b-163303b06c91",
                                                "text": "wintry weather"
                                            },
                                            {
                                                "example_id": "9fcc351c-e0e5-4023-b2b2-99a69783f74b",
                                                "sense_id": "e91d435e-e05d-36c0-a14b-163303b06c91",
                                                "text": "A faded, and an ancient dragon he was; and many a wintry storm of rain, snow, sleet, and hail, had changed his colour from a gaudy blue to a faint lack-lustre shade of gray."
                                            },
                                            {
                                                "example_id": "e53e677b-a6fb-4134-bfe3-4256e33b4cb3",
                                                "sense_id": "e91d435e-e05d-36c0-a14b-163303b06c91",
                                                "text": "In one village in Bachu County, more than 1,000 buildings and houses collapsed, according to the state-run New China News Agency. Tens of thousands of people were left homeless and were preparing to spend the night outside in the wintry chill, witnesses said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "676b2d8f-3c64-3128-9177-f7358eb57525",
                                        "entry_id": "0e1ed8d0-2d30-32c6-b9d7-8e2e3b9197d4",
                                        "glosses": [
                                            "Containing sleet or snow."
                                        ],
                                        "tags": [
                                            "of precipitation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d2d37f8-aff8-4fda-8122-daa599712bf0",
                                                "sense_id": "676b2d8f-3c64-3128-9177-f7358eb57525",
                                                "text": "It will be cloudy overnight, with outbreaks of heavy rain at times. The rain may turn wintry over higher ground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64a70924-0082-3b1a-b373-ff756d2f6e90",
                                        "entry_id": "0e1ed8d0-2d30-32c6-b9d7-8e2e3b9197d4",
                                        "glosses": [
                                            "Aged, white-haired."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a59c82c0-102f-3a48-a14c-fec86b0ee0b1",
                                        "entry_id": "0e1ed8d0-2d30-32c6-b9d7-8e2e3b9197d4",
                                        "glosses": [
                                            "Chilling, cheerless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32486787-5bd0-4eac-997c-bb0752d55472",
                                                "sense_id": "a59c82c0-102f-3a48-a14c-fec86b0ee0b1",
                                                "text": "a wintry remark"
                                            },
                                            {
                                                "example_id": "73bb3045-347f-492b-a75e-9f9f06928630",
                                                "sense_id": "a59c82c0-102f-3a48-a14c-fec86b0ee0b1",
                                                "text": "He reached the old ruins at last, dim masses of moss-grown masonry in the glimmer of the wintry starlight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
