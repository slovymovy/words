                "senses": [
                    {
                        "sense_id": "83d34603-e4cc-3b20-8c15-7736beb8c2be",
                        "entry_id": "57c16933-4d0e-3e3c-a48d-de56ee56ad8a",
                        "glosses": [
                            "To convert an image into a vector graphics format."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4c6c6a74-edc9-4faa-9e08-c8d9c0af1bbc",
                                "sense_id": "83d34603-e4cc-3b20-8c15-7736beb8c2be",
                                "text": "The raster and vectorized images are displayed on a graphic monitor where the vector data is an active layer and the raster image is a background layer."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ad4ef6a-c14e-3ff3-b0b4-09fe19f5b616",
                        "entry_id": "57c16933-4d0e-3e3c-a48d-de56ee56ad8a",
                        "glosses": [
                            "To convert a program that operates on scalar values into the equivalent program operating on vectors, usually as an optimization step inside the compiler (automatic vectorization)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4842171b-7e08-40fc-a2fe-5ab4306ea916",
                                "sense_id": "9ad4ef6a-c14e-3ff3-b0b4-09fe19f5b616",
                                "text": "The principles on which the Cyber 200 FORTRAN compiler tries to detect which parts of a program can be vectorized are similar to those used in the Cray CFT compiler."
                            }
                        ]
                    },
                    {
                        "sense_id": "77f13d4c-a6c5-3ecf-9612-a2be96683b8f",
                        "entry_id": "57c16933-4d0e-3e3c-a48d-de56ee56ad8a",
                        "glosses": [
                            "To lead selectively a drug to a target."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b60be75c-2c1d-4b0f-97b0-8c7df9e18561",
                                "sense_id": "77f13d4c-a6c5-3ecf-9612-a2be96683b8f",
                                "text": "[…] peculiarities of the CNT structure can be used to vectorize drugs and other chemicals."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c45f63b-6871-42b4-a1ea-3a9e7ff8b52d",
                        "source_entry_id": "57c16933-4d0e-3e3c-a48d-de56ee56ad8a",
                        "source_sense_description": "to convert an image into a vector graphics format",
                        "target_lang_word": "vectoriser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vectoriser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a05dff2a-fda5-3be0-8244-6342d8e636ab",
                                        "entry_id": "e03df84c-c081-3469-89a4-83c6a2252d6c",
                                        "glosses": [
                                            "Mettre sous forme de vecteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "056077c4-9ef7-48e4-8588-112532c3b816",
                                                "sense_id": "a05dff2a-fda5-3be0-8244-6342d8e636ab",
                                                "text": "Au fur et à mesure que Bartlebooth se familiarisait avec les petits morceaux de bois, il se mettait à les percevoir selon un axe privilégié, comme si ces pièces se polarisaient, se vectorisaient, se figeaient dans un mode de perception qui les assimilait, avec une irrésistible séduction, à des images, des formes, des silhouettes familières : un chapeau, un poisson, un oiseau étonnamment précis, à longue queue, au long bec courbe avec une protubérance à la base, comme il se souvenait en avoir vu en Australie, ou bien, justement, la découpe de l’Australie, ou l’Afrique, l’Angleterre, la péninsule Ibérique, la botte italienne, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4d08f15-9d94-3383-a275-311f36078ba1",
                                        "entry_id": "e03df84c-c081-3469-89a4-83c6a2252d6c",
                                        "glosses": [
                                            "Transformer, automatiquement ou non, une image matricielle (définie selon une grille de pixels) en image vectorielle (définie par des instructions de tracé géométrique)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f172c901-f820-47f7-be02-d5778b487070",
                                                "sense_id": "e4d08f15-9d94-3383-a275-311f36078ba1",
                                                "text": "Néanmoins la vectorisation entraîne des imprécisions et des pertes d'informations qui peuvent être parfois gênantes pour des traitements ultérieurs. Pour vectoriser une image il faut au préalable extraire le squelette des objets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64db9439-3ab4-354a-a8fb-20e1416b5e85",
                                        "entry_id": "e03df84c-c081-3469-89a4-83c6a2252d6c",
                                        "glosses": [
                                            "Optimiser, automatiquement ou non, un code source de logiciel en faisant faire effectuer un même calcul sur de nombreux jeux de données à la fois (représentées sous forme d’un tableau appelé « vecteur ») par un matériel adapté, plutôt que d’effectuer ce calcul de façon répétée pour chaque jeu de données (scalaire)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "342b7144-1c2a-384e-8008-857ba9840173",
                                        "entry_id": "e03df84c-c081-3469-89a4-83c6a2252d6c",
                                        "glosses": [
                                            "Placer sur un vecteur, en parlant d'une arme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95ef04e1-c588-403e-804f-30593d9bbc7b",
                                                "sense_id": "342b7144-1c2a-384e-8008-857ba9840173",
                                                "text": "Les principaux problèmes auxquels il faudra faire face dans vingt ans sont clairement posés : la Corée du Nord et l’Iran auront-ils à cette date une arme nucléaire qui puisse être vectorisée ?"
                                            },
                                            {
                                                "example_id": "3d4d5228-7c19-475a-8b33-9602ed325d2e",
                                                "sense_id": "342b7144-1c2a-384e-8008-857ba9840173",
                                                "text": "Une fois l'arme constituée, pour être efficace dans une logique militaire, il faut la vectoriser, c'est-à-dire l'adapter sur un système qui permettra de la projeter à une grande distance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
