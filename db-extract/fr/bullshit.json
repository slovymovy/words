                                "target_senses": [
                                    {
                                        "sense_id": "a310f71c-bcd1-3667-8e12-b25da54fe9c9",
                                        "entry_id": "cea98ff6-6342-3485-84b1-f36671ec8c00",
                                        "glosses": [
                                            "To tell lies, exaggerate; to mislead; to deceive."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "721ac6c9-1a46-44eb-a553-5e14d5808cc3",
                                                "sense_id": "a310f71c-bcd1-3667-8e12-b25da54fe9c9",
                                                "text": "You’re bullshitting me. I called your office and you never even came in."
                                            },
                                            {
                                                "example_id": "dde93a16-db67-4911-8642-76dc16e51aef",
                                                "sense_id": "a310f71c-bcd1-3667-8e12-b25da54fe9c9",
                                                "text": "I think you’re bullshitting. Let’s just call your office and see if you even came in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f463780f-c122-3d6b-800a-70c6cb620170",
                                        "entry_id": "cea98ff6-6342-3485-84b1-f36671ec8c00",
                                        "glosses": [
                                            "To have casual conversation with no real point; to shoot the breeze."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84ba77d3-fead-4b83-83e2-0c6930d7b476",
                                                "sense_id": "f463780f-c122-3d6b-800a-70c6cb620170",
                                                "text": "I will probably just go and bullshit with Joe for a while."
                                            }
                                        ]
