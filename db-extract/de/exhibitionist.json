                            {
                                "example_id": "dd127a70-72b5-493c-8096-8fdd187880af",
                                "sense_id": "8b2e0507-9f0e-3bd0-9ab5-5b7853b318b3",
                                "text": "Im Stadtpark treibt ein Exhibitionist sein Unwesen."
                            },
                            {
                                "example_id": "375dc081-dc3b-43f3-b56a-3f3f8cd45455",
                                "sense_id": "8b2e0507-9f0e-3bd0-9ab5-5b7853b318b3",
                                "text": "„Anscheinend habe ich einen Exhibitionisten zur Welt gebracht.“"
                            },
                            {
                                "example_id": "92709343-005d-4338-9338-0e6ce185fdb1",
                                "sense_id": "8b2e0507-9f0e-3bd0-9ab5-5b7853b318b3",
                                "text": "„Erst jetzt, während ich dies schreibe, wird mir klar, was für ein Exhibitionist ich sein muß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
