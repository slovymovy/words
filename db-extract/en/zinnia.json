                                            {
                                                "example_id": "8d11a9fb-728f-4fd3-b08a-0d291636c3ea",
                                                "sense_id": "c8c9e24a-d983-3248-8ad0-2c966639181f",
                                                "text": "Je zinnia's staan er mooi bij dit jaar."
                                            }
