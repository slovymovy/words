                "senses": [
                    {
                        "sense_id": "48a8acad-1d75-3fef-ad8d-4569b1df94c9",
                        "entry_id": "fdea8b7a-3a00-3bf0-861c-50ac634d6f3e",
                        "glosses": [
                            "устар. равный по весу одному золотнику¹"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5b3ef5-a867-4180-9cf8-414710bdc871",
                                "sense_id": "48a8acad-1d75-3fef-ad8d-4569b1df94c9",
                                "text": "В качестве разменного эквивалента использовались слитки серебра-гривны, делившиеся на части для осуществления торговых операций. Вес слитка первоначально составлял 96 золотников. В дальнейшем, во времена татарского ига, половина 96-золотниковой гривны стала одним из стандартов при сборе дани (\"полугривна с сохи\"), что в конечном итоге привело к распространению слитков весом в 48 золотников в качестве главного элемента денежной системы."
                            }
                        ]
                    },
                    {
                        "sense_id": "86cbb4e1-6dad-33d3-aa19-8158869a544d",
                        "entry_id": "fdea8b7a-3a00-3bf0-861c-50ac634d6f3e",
                        "glosses": [
                            "соотносящийся по значению с существительным золотник², связанный с ним"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa033610-e259-4fc0-ba06-2e2fe6a5bdea",
                                "sense_id": "86cbb4e1-6dad-33d3-aa19-8158869a544d",
                                "text": "Золотниковый воздухораспределитель."
                            },
                            {
                                "example_id": "f2ed7500-81a9-4ddc-ab8e-43222666a79a",
                                "sense_id": "86cbb4e1-6dad-33d3-aa19-8158869a544d",
                                "text": "Золотниковый смеситель."
                            },
                            {
                                "example_id": "bc23a90e-e51b-4b4a-9582-7d8a310ae146",
                                "sense_id": "86cbb4e1-6dad-33d3-aa19-8158869a544d",
                                "text": "Золотниковый вакуумный насос."
                            }
                        ]
