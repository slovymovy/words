                                        "sense_id": "c798abd5-4a62-3460-a1d3-f41ffe8ed19b",
                                        "entry_id": "7b80a5b2-e959-39b2-b728-bf017af04f3f",
                                        "glosses": [
                                            "in irgend einem Maße nicht zu übertreffen; am weitesten von der Mitte oder dem Durchschnitt entfernt"
                                        ],
                                        "tags": [
                                            "im engeren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9465fe8d-340a-46ea-9890-2de1524c3842",
                                                "sense_id": "c798abd5-4a62-3460-a1d3-f41ffe8ed19b",
                                                "text": "Die zwei extremen Werte der Messung lassen wir wegfallen, es sind anscheinend Ausreißer."
                                            },
                                            {
                                                "example_id": "42fb0a68-1111-440e-9793-d45c5a06aeb7",
                                                "sense_id": "c798abd5-4a62-3460-a1d3-f41ffe8ed19b",
                                                "text": "„In manchen Teilen der Biosphäre wimmelt es von Leben, weil dort die Lebensbedingungen beinahe ideal sind. Andere Teile sind nur spärlich besiedelt, weil extreme Kälte oder Hitze das Überleben schwierig macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb086c8a-b6e8-3e8b-9ea9-9fef09bbdad8",
                                        "entry_id": "7b80a5b2-e959-39b2-b728-bf017af04f3f",
                                        "glosses": [
                                            "außerordentlich, besonders; übermäßig"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2e6dfdf-bd42-4b93-ad78-4b33ae6168ac",
                                                "sense_id": "fb086c8a-b6e8-3e8b-9ea9-9fef09bbdad8",
                                                "text": "„In manchen Teilen der Biosphäre wimmelt es von Leben, weil dort die Lebensbedingungen beinahe ideal sind. Andere Teile sind nur spärlich besiedelt, weil extreme Kälte oder Hitze das Überleben schwierig macht.“"
                                            },
                                            {
                                                "example_id": "50703e5e-5275-4555-911e-faa19f1fbf15",
                                                "sense_id": "fb086c8a-b6e8-3e8b-9ea9-9fef09bbdad8",
                                                "text": "Das ist ein extrem starker Kaffee."
                                            },
                                            {
                                                "example_id": "39be9c8f-e736-4dc5-b80a-5c3d03525d1c",
                                                "sense_id": "fb086c8a-b6e8-3e8b-9ea9-9fef09bbdad8",
                                                "text": "umgangssprachlich: „Er hörte gern eine freie Meinung, je drastischer und extremer, desto besser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
