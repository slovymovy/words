                                    },
                                    {
                                        "sense_id": "fa2226cc-3ff4-3570-9628-f204463f230f",
                                        "entry_id": "521de7f0-e586-3d72-aca7-d13a7dbecc78",
                                        "glosses": [
                                            "A person, usually male, especially one who behaves in an objectionable or pitiable manner."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49077665-76f2-3b57-80fd-ae3ebb80127a",
                                        "entry_id": "521de7f0-e586-3d72-aca7-d13a7dbecc78",
                                        "glosses": [
                                            "A man or child, especially an annoying one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f78a693-904e-40cd-987f-92716e8630ba",
                                                "sense_id": "49077665-76f2-3b57-80fd-ae3ebb80127a",
                                                "text": "I tackled the blighter squarely."
                                            },
                                            {
                                                "example_id": "a1700abb-c76a-4e1a-9e7d-2b8b237123d1",
                                                "sense_id": "49077665-76f2-3b57-80fd-ae3ebb80127a",
                                                "text": "Translation: there's still some hope for you, poor stammering blighter."
                                            },
                                            {
                                                "example_id": "eab89dfe-22cf-4e70-89e5-afb8db8b35ed",
                                                "sense_id": "49077665-76f2-3b57-80fd-ae3ebb80127a",
                                                "text": "\"[I]f I had known that Pine was such a blighter as to leave me nothing, I'm hanged if I'd have allowed him to be buried in such decent company.\""
                                            },
                                            {
                                                "example_id": "83543c20-1d21-495b-8bd7-26064d65603f",
                                                "sense_id": "49077665-76f2-3b57-80fd-ae3ebb80127a",
                                                "text": "He knew that the old blighter had to be humored in certain small ways."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d95533d-326f-417a-9f5f-1352d0d73994",
                        "source_entry_id": "2c350ac2-26c3-36e8-94d6-f2ad7d52a2be",
                        "source_sense_id": "14ceba6b-c3f4-3a98-9d2c-5254f382f41d",
                        "target_lang_word": "rascal",
