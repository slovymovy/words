                        "sense_id": "dcb60fdd-985b-399d-b7c8-12a38ed13d22",
                        "entry_id": "2fec1ed8-d7f2-3baa-8755-9b96cbdd3dbb",
                        "glosses": [
                            "Funktion, die gewisse Eigenschaften von Daten zusammenfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9e4ea51-456c-4293-a5ee-f734c88d8233",
                                "sense_id": "dcb60fdd-985b-399d-b7c8-12a38ed13d22",
                                "text": "„Zur Überprüfung der Ableitbarkeit der Aggregationsfunktionen werden diese klassifiziert in additive, semi-additive und additiv-berechenbare Aggregationsfunktionen.“"
                            },
                            {
                                "example_id": "7085006a-5b57-4b45-8717-9d379009ae26",
                                "sense_id": "dcb60fdd-985b-399d-b7c8-12a38ed13d22",
                                "text": "„Summe, Minimum und Maximum sind Beispiele additiver Aggregationsfunktionen.“"
                            },
                            {
                                "example_id": "aa79130a-b94f-49dc-8eb7-308f73642edc",
                                "sense_id": "dcb60fdd-985b-399d-b7c8-12a38ed13d22",
                                "text": "Die Abfragesprache SQL bietet unter anderem Aggregationsfunktionen wie Summe (SUM), Anzahl (COUNT), Maximum (MAX), Minimum (MIN) in ihrem Befehlssatz an."
                            }
                        ],
