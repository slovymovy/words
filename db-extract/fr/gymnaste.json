                        ],
                        "examples": [
                            {
                                "example_id": "79f5bc90-f5ee-47d8-bf8f-41b54fb6e84d",
                                "sense_id": "05b04e58-0f77-3f12-8cdd-6bb6fee13228",
                                "text": "Elle s’y prit exactement comme un gymnaste qui répète un exercice avec sa partenaire, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d12a977-e48c-4e5e-b73f-c516011ecc1d",
                        "source_entry_id": "380b3ed8-f47f-34bf-ae70-f958de21dd21",
                        "target_lang_word": "Turner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Turner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "449d603f-55e2-3c97-8b18-f56ca22f0b2a",
                                        "entry_id": "fad41f4d-6f24-3d7a-bcff-eab103b11601",
                                        "glosses": [
                                            "Sportler, dessen Sportart das Turnen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46912bc2-8eb7-4c37-ad48-762e4fa4ef02",
                                                "sense_id": "449d603f-55e2-3c97-8b18-f56ca22f0b2a",
                                                "text": "Damals waren die deutschen Turner noch Weltspitze."
                                            },
                                            {
                                                "example_id": "57d390bc-39d4-485a-8e53-5d0918debd9d",
                                                "sense_id": "449d603f-55e2-3c97-8b18-f56ca22f0b2a",
                                                "text": "„Turner und Turnerinnen wurden von Motorrettungsbooten in geregeltem Pendelverkehr befördert.“"
                                            },
                                            {
                                                "example_id": "b96fb691-9ea7-42f1-93bd-5f02e78cb581",
                                                "sense_id": "449d603f-55e2-3c97-8b18-f56ca22f0b2a",
                                                "text": "„Eine Viertelstunde später erschienen die Pferde; man nahm Abschied und wandte sich auf die Holzbrücke zu, die die Turner vor ihnen passiert hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53649002-7148-4580-a338-c6cfafb3aee6",
                        "source_entry_id": "380b3ed8-f47f-34bf-ae70-f958de21dd21",
