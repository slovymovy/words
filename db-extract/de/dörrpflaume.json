                "senses": [
                    {
                        "sense_id": "b5d22338-4e16-38ac-8d69-992e399f0222",
                        "entry_id": "34aa697f-9a87-3f83-b2f3-a597689f3e98",
                        "glosses": [
                            "getrocknete/gedörrte Pflaume"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a695331-5d1c-45ab-92ce-490701f12a3c",
                                "sense_id": "b5d22338-4e16-38ac-8d69-992e399f0222",
                                "text": "„Das baut das angespannte Eiweiß des Muskelfleisches ab, macht das starre, zähe Bindegewebe mürbe und verleiht noch dem rosigsten Filet das Aussehen einer hundertjährigen Dörrpflaume.“"
                            },
                            {
                                "example_id": "0d65f83f-2655-4497-9f54-5ffe4db1c2e6",
                                "sense_id": "b5d22338-4e16-38ac-8d69-992e399f0222",
                                "text": "„Ein anderes Mal empfahl er zu Rauchaal, Quellerstängeln und Shiitake einen Mix aus Wasserkefir, Dörrpflaume, Limette und Grüntee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
