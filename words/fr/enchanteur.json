                    "frequency": "Middle",
                    "semantic_group_id": "charme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons passé nos vacances d'été dans un cadre <w>enchanteur</w> au bord du lac."
                        },
                        {
                            "text": "La cantatrice a séduit toute la salle grâce à sa voix <w>enchanteresse</w>."
                        }
                    ],
                    "synonyms": [
                        "charmant",
                        "ravissant",
                        "féerique",
                        "magique",
                        "captivant"
                    ],
                    "common_phrases": [
                        "cadre enchanteur",
                        "décor enchanteur",
                        "aspect enchanteur",
                        "voix enchanteresse"
