                        "entry_id": "688f5abd-58a8-3203-8d29-e9710c6cc10d",
                        "glosses": [
                            "An area allocated for someone to work in, especially in an office."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae40746-752b-46f5-ab7b-0b957b8051a4",
                                "sense_id": "a1fdbee2-5b90-3900-99d0-15c88f12f8f7",
                                "text": "Holonyms: workplace, workstead"
                            },
                            {
                                "example_id": "fc8301f5-65c4-4ef4-89d7-8027b1de13fd",
                                "sense_id": "a1fdbee2-5b90-3900-99d0-15c88f12f8f7",
                                "text": "Near-synonym: workstation"
                            }
                        ]
                    },
                    {
                        "sense_id": "75a2531f-bae3-3482-9c45-b449836b4278",
                        "entry_id": "688f5abd-58a8-3203-8d29-e9710c6cc10d",
                        "glosses": [
                            "A file (or system of files) in which related software and data can be manipulated or developed in isolation from others."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "92c7a522-57d5-3d72-aa1b-2199321d4b56",
                        "entry_id": "688f5abd-58a8-3203-8d29-e9710c6cc10d",
                        "glosses": [
                            "An empty portion of the screen or window that serves as a container for other windows or objects."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88371f14-4e35-4cf4-952e-7ae0d40a6628",
                                "sense_id": "92c7a522-57d5-3d72-aa1b-2199321d4b56",
                                "text": "Unlike other Microsoft Office applications, Access doesn't automatically display an empty workspace when you start the program."
                            }
                        ]
                    },
                    {
                        "sense_id": "63aa70b5-2c4d-3d47-a7c4-7a31b9977338",
                        "entry_id": "688f5abd-58a8-3203-8d29-e9710c6cc10d",
                        "glosses": [
