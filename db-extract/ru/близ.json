                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4646f50a-c2e9-40dc-ace4-0f5c0b42436f",
                                                "sense_id": "e3c98981-55ba-30c2-b437-781d674d1ab8",
                                                "text": "The end is near."
                                            },
                                            {
                                                "example_id": "5fd8a6e5-8e7b-4207-a024-3955d79413c5",
                                                "sense_id": "e3c98981-55ba-30c2-b437-781d674d1ab8",
                                                "text": "We're getting near to Xmas."
