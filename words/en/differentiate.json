{
    "word_family": [
        "different",
        "difference",
        "differentiation",
        "differentiator",
        "differentiable",
        "differential"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "081f2c08-6ec6-3298-aca3-08afe71efd1c",
                    "sense_definition": "To be the specific quality or feature that makes one thing different from another.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What features <w>differentiate</w> an alligator from a crocodile?",
                            "target_lang_translations": {
                                "ru": "Какие признаки <w>отличают</w> аллигатора от крокодила?"
                            }
                        },
                        {
                            "text": "The unique color pattern is what <w>differentiates</w> the two species.",
                            "target_lang_translations": {
                                "ru": "Уникальный цветовой узор — это то, что <w>дифференцирует</w> эти два вида."
                            }
                        }
                    ],
                    "synonyms": [
                        "distinguish"
                    ],
                    "antonyms": [
                        "equate"
                    ],
                    "common_phrases": [
                        "differentiate between things",
                        "differentiate from others"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть тем самым качеством или особенностью, которая отличает один предмет от другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отличать",
                                "target_lang_sense_clarification": "служить отличительным признаком"
                            },
                            {
                                "target_lang_word": "дифференцировать",
                                "target_lang_sense_clarification": "книжн., выделять различия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9caad56-0a3f-3f5a-b843-6c1916513c18",
                    "sense_definition": "To recognize, identify, or perceive the difference between two or more things.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is often difficult to <w>differentiate</w> a fake smile from a genuine one.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>отличить</w> фальшивую улыбку от искренней."
                            }
                        },
                        {
                            "text": "Young children may find it hard to <w>differentiate</w> between fact and fiction.",
                            "target_lang_translations": {
                                "ru": "Маленьким детям может быть трудно <w>различать</w> факты и вымысел."
                            }
                        }
                    ],
                    "synonyms": [
                        "tell apart",
                        "distinguish"
                    ],
                    "antonyms": [
                        "mix up",
                        "muddle up",
                        "conflate"
                    ],
                    "common_phrases": [
                        "differentiate between them",
                        "differentiate fact from fiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распознавать, определять или воспринимать разницу между двумя или более вещами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "различать",
                                "target_lang_sense_clarification": "видеть разницу"
                            },
                            {
                                "target_lang_word": "отличать",
                                "target_lang_sense_clarification": "одно от другого"
                            },
                            {
                                "target_lang_word": "дифференцировать",
                                "target_lang_sense_clarification": "книжн., проводить различие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8185b4c0-fa97-32c5-9adc-bba45b28cdaa",
                    "sense_definition": "To modify or change something so that it becomes distinct or develops a specialized character.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company needs to <w>differentiate</w> its products to attract more customers.",
                            "target_lang_translations": {
                                "ru": "Компании необходимо <w>дифференцировать</w> свои продукты, чтобы привлечь больше клиентов."
                            }
                        },
                        {
                            "text": "Over time, the two dialects <w>differentiated</w> into separate languages.",
                            "target_lang_translations": {
                                "ru": "Со временем два диалекта <w>дифференцировались</w> в отдельные языки."
                            }
                        }
                    ],
                    "synonyms": [
                        "alter",
                        "transform",
                        "individualize"
                    ],
                    "antonyms": [
                        "preserve",
                        "leave alone"
                    ],
                    "common_phrases": [
                        "differentiate a product",
                        "differentiate the brand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Модифицировать или изменять что-либо так, чтобы оно стало отличным от других или приобрело специализированный характер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дифференцировать",
                                "target_lang_sense_clarification": "делать различным, разделять"
                            },
                            {
                                "target_lang_word": "индивидуализировать",
                                "target_lang_sense_clarification": "придавать уникальные черты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2828a006-38af-36d8-bdd8-74b928fbea4d",
                    "sense_definition": "To undergo a process of development where cells or tissues become specialized in form or function.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stem cells have the unique ability to <w>differentiate</w> into various types of specialized cells.",
                            "target_lang_translations": {
                                "ru": "Стволовые клетки обладают уникальной способностью <w>дифференцироваться</w> в различные типы специализированных клеток."
                            }
                        },
                        {
                            "text": "During the early stages of development, cells begin to <w>differentiate</w> into specific organs.",
                            "target_lang_translations": {
                                "ru": "На ранних стадиях развития клетки начинают <w>дифференцироваться</w> в специфические органы."
                            }
                        }
                    ],
                    "synonyms": [
                        "specialize"
                    ],
                    "common_phrases": [
                        "differentiate into cells"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проходить процесс развития, при котором клетки или ткани становятся специализированными по форме или функции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дифференцироваться",
                                "target_lang_sense_clarification": "биол., приобретать специализацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff35487d-78ab-311b-8dc4-2f1a4284e447",
                    "sense_definition": "To adapt teaching methods or materials to meet the diverse needs and levels of different students.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Teachers often use technology to <w>differentiate</w> instruction for students with different learning styles.",
                            "target_lang_translations": {
                                "ru": "Учителя часто используют технологии, чтобы <w>дифференцировать</w> обучение для учеников с разными стилями восприятия."
                            }
                        },
                        {
                            "text": "The educator <w>differentiated</w> the lesson to ensure both advanced and struggling students could succeed.",
                            "target_lang_translations": {
                                "ru": "Педагог <w>дифференцировал</w> урок, чтобы обеспечить успех как сильным, так и отстающим ученикам."
                            }
                        }
                    ],
                    "synonyms": [
                        "particularize"
                    ],
                    "common_phrases": [
                        "differentiate instruction",
                        "differentiate the curriculum"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "educational jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Адаптировать методы обучения или материалы для удовлетворения разнообразных потребностей и уровней подготовки различных учащихся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дифференцировать",
                                "target_lang_sense_clarification": "пед., адаптировать под уровень ученика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "155fa57a-7f15-310e-bdaa-60831b2cedf8",
                    "sense_definition": "To calculate the derivative or differential of a mathematical function.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In calculus class, we learned how to <w>differentiate</w> complex algebraic functions.",
                            "target_lang_translations": {
                                "ru": "На занятиях по математическому анализу мы учились <w>дифференцировать</w> сложные алгебраические функции."
                            }
                        },
                        {
                            "text": "If you <w>differentiate</w> the position function with respect to time, you get the velocity.",
                            "target_lang_translations": {
                                "ru": "Если <w>продифференцировать</w> функцию положения по времени, получится скорость."
                            }
                        }
                    ],
                    "common_phrases": [
                        "differentiate a function",
                        "differentiate with respect to"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вычислять производную или дифференциал математической функции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дифференцировать",
                                "target_lang_sense_clarification": "матем., находить производную"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bed768c5-0a5c-3fcf-a368-ddc0ded28220",
                    "sense_definition": "A product or substance that has been formed through a process of differentiation or stratification.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stratification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geologist examined the various <w>differentiates</w> found within the igneous rock formation.",
                            "target_lang_translations": {
                                "ru": "Геолог изучил различные <w>дифференциаты</w>, обнаруженные в толще изверженных пород."
                            }
                        },
                        {
                            "text": "Magma typically exhibits both agpaitic and miascitic <w>differentiates</w> depending on the cooling process.",
                            "target_lang_translations": {
                                "ru": "Магма обычно проявляет как агпаитовые, так и миаскитовые <w>дифференциаты</w> в зависимости от процесса охлаждения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "magmatic differentiates"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical/scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продукт или вещество, образовавшееся в процессе дифференциации или расслоения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дифференциат",
                                "target_lang_sense_clarification": "геол., продукт расслоения магмы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}