                    {
                        "translation_id": "2c4882b2-38dd-4e43-9ea8-6904816cafd4",
                        "source_entry_id": "bc621d9f-7c84-3e03-b9a7-eaff6910a32c",
                        "source_sense_id": "69b49035-dec4-39ac-bfdc-b56090edd42f",
                        "source_sense_description": "een land in West-Afrika, officieel de Republiek Guinee",
                        "target_lang_word": "Guinée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
