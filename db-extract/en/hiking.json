                "senses": [
                    {
                        "sense_id": "5daa97fb-1d9d-3a7a-a8fc-e1e90ad360bd",
                        "entry_id": "8fab9efb-e782-3273-a24a-86c5ab5225ea",
                        "glosses": [
                            "Walking in the countryside for pleasure or sport."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8bd8ff38-43ad-4930-8e0b-561b9d172eb2",
                                "sense_id": "5daa97fb-1d9d-3a7a-a8fc-e1e90ad360bd",
                                "text": "To protect the glacier, officials have limited the number of visitors to 10,000 a day and have banned hiking on the ice."
                            },
                            {
                                "example_id": "f5257c8b-f8c7-4d22-8652-869b83782c45",
                                "sense_id": "5daa97fb-1d9d-3a7a-a8fc-e1e90ad360bd",
                                "text": "Consulting the data provided by ARPS to the county, the county discovers that ARPS has erroneously stated that the parking area too was on solid ground when in fact the earth was ill suited to anything other than hikings."
                            }
                        ]
                    },
                    {
                        "sense_id": "faa8dc1f-af4a-389d-a589-620a6a2ed9e7",
                        "entry_id": "8fab9efb-e782-3273-a24a-86c5ab5225ea",
                        "glosses": [
                            "The act by which something is hiked, or raised sharply."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e1188c38-cf9b-46dd-b2a9-a41fd8181c60",
                                "sense_id": "faa8dc1f-af4a-389d-a589-620a6a2ed9e7",
                                "text": "Like in previous years, Government policies with regard to restraining price hikings have been dealing with curtailing credit supplies and bank liquidities […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efe80dc0-4c79-4326-b2b7-61418f8fd3d7",
                        "source_entry_id": "8fab9efb-e782-3273-a24a-86c5ab5225ea",
                        "source_sense_description": "walking",
                        "target_lang_word": "wandelen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wandelen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8002b6dd-c6a5-3cf0-9254-3181d5eca52a",
                                        "entry_id": "7ce65957-3d7a-3ed5-a52c-b22bc54b8da7",
                                        "glosses": [
                                            "gericht een wandeling maken"
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "745a7ec1-cd85-4ad1-801b-06a8a707bb3b",
                                                "sense_id": "8002b6dd-c6a5-3cf0-9254-3181d5eca52a",
                                                "text": "Ik ben gisteren naar de Griete gewandeld."
                                            },
                                            {
                                                "example_id": "9241bd13-b688-4a02-9846-886dc92e2fa2",
                                                "sense_id": "8002b6dd-c6a5-3cf0-9254-3181d5eca52a",
                                                "text": "De moeder van 11 kinderen had pas op latere leeftijd het wandelen ontdekt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4295f43-f309-39df-aaf2-5ba80dbe6113",
                                        "entry_id": "7ce65957-3d7a-3ed5-a52c-b22bc54b8da7",
                                        "glosses": [
                                            "ongericht een wandeling maken"
                                        ],
                                        "tags": [
                                            "unergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fde97d05-4cc0-42f2-9031-658f1864495f",
                                                "sense_id": "d4295f43-f309-39df-aaf2-5ba80dbe6113",
                                                "text": "Mijn vader heeft altijd veel gewandeld."
                                            },
                                            {
                                                "example_id": "edfb7f7e-8de4-43da-b0fc-ca19b6a0b8d1",
                                                "sense_id": "d4295f43-f309-39df-aaf2-5ba80dbe6113",
                                                "text": "Je ziet natuurlijk wel het verschil tussen een amateur en prof, dat is logisch, maar toch. Ik moet morgen en overmorgen gebruiken om tijdens het wandelen alles in te laten dalen, en mijn geest en lichaam langzaam te transformeren tot Irene."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
