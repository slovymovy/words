                        "sense_id": "e9a22bdf-23f4-39e8-9b1a-ccfe36c89ee1",
                        "entry_id": "3d3d7340-1fbd-3c84-8c14-b43a06337606",
                        "glosses": [
                            "To say or declare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8c4da0c-faf8-46a3-a45c-65828b58136b",
                                "sense_id": "e9a22bdf-23f4-39e8-9b1a-ccfe36c89ee1",
