                "senses": [
                    {
                        "sense_id": "05de5c3b-69fc-38f0-93f2-c3406dd16da5",
                        "entry_id": "3994ae75-39a3-37bf-8053-7ace8c581be0",
                        "glosses": [
                            "Anzahl Krankenhauseinweisungen (Hospitalisierungen) aufgrund einer bestimmten Erkrankung, die auf eine Gesamtmenge, zum Beispiel 100.000 Einwohner, und einen gewissen Zeitraum, zum Beispiel 7 Tage, bezogen wird"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "cb4247dd-be9f-4630-aaa1-2445ea856675",
                                "sense_id": "05de5c3b-69fc-38f0-93f2-c3406dd16da5",
                                "text": "„In einem Gesetzesentwurf, der Bild vorliegt, ist die Hospitalisierungsrate wie folgt definiert: „Anzahl der stationär zur Behandlung aufgenommenen Patienten, die an der Coronavirus-Krankheit-2019 (COVID-19) erkrankt sind, je 100.000 Einwohner innerhalb von sieben Tagen.““"
                            },
                            {
                                "example_id": "32b405d9-4776-4305-a02a-585dfaccf4d9",
                                "sense_id": "05de5c3b-69fc-38f0-93f2-c3406dd16da5",
                                "text": "„Das Bundeskabinett hat am Dienstag beschlossen, dass die so genannte Hospitalisierungsrate künftig das entscheidende Kriterium für Maßnahmen in der Corona-Pandemie sein soll.“"
                            },
                            {
                                "example_id": "314f437f-bb56-452a-8d90-90165624e8f5",
                                "sense_id": "05de5c3b-69fc-38f0-93f2-c3406dd16da5",
                                "text": "„Wie die Deutsche Presse-Agentur berichtet, wurde die Hospitalisierungsrate Mitte Februar bei einer ähnlichen Sieben-Tage-Fallinzidenz wie derzeit mit rund sechs angegeben. Damals nahmen die Covid-19-Impfungen in Deutschland erst langsam zu. In der dritten Welle im April 2021 lag der Wert bei knapp zehn.“"
                            },
                            {
                                "example_id": "935544f3-53fa-4b61-87eb-fb30b9c3bf98",
                                "sense_id": "05de5c3b-69fc-38f0-93f2-c3406dd16da5",
                                "text": "auf eine andere Gesamtmenge bezogen und in % ausgedrückt: „Die Hospitalisierungsrate lag insgesamt bei 19 %, zeigte jedoch einen geschlechterspezifischen Unterschied (männlich: 26 %, weiblich: 20 %), der sich ebenso in Bezug auf den Fall-Verstorbenen-Anteil (männlich: 26 %, weiblich: 16 %) beobachten ließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
