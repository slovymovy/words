                        "source_sense_id": "4c133506-05cb-3931-bf2f-22292ecea8d4",
                        "source_sense_description": "de studie naar de oorsprong van de voor- en familienamen van mensen.",
                        "target_lang_word": "Namenforschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namenforschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                        "entry_id": "6f293d46-4ef5-3723-94f2-2676798d595a",
                                        "glosses": [
                                            "linguistische Disziplin, die sich der Erforschung von Eigennamen widmet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a5c5397-e358-4c0c-8c5b-b089f7616bb7",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "Die Namenforschung erforscht die Entwicklung, Etymologie und Verbreitung von Eigennamen."
                                            },
                                            {
                                                "example_id": "bcd55a6d-a4b2-462a-8444-960fc52a5f1e",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "„Die Namenforschung der Staaten der Erde ist zweifellos noch nicht abgeschlossen.“"
                                            },
                                            {
                                                "example_id": "5c6edc99-0cff-4373-9650-ca380366d891",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "„Als traditionelle Orte der Namenforschung im deutschsprachigen Raum sind Lüneburg, Heidelberg, Mainz und Wiesbaden sowie mit Statistiken auch Zentren in Österreich und der Schweiz zu nennen.“"
                                            },
                                            {
                                                "example_id": "15a8366f-d98f-43ab-aafe-3830edc59d61",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "„Ein Kosename, in der Namenforschung auch als Hypokoristikum bezeichnet, wird oft formal mit einem Kurznamen beziehungsweise einer Kurzform gleichgesetzt.“"
                                            },
                                            {
                                                "example_id": "c5843056-ef60-4b17-9a2a-61a87a749a49",
                                                "sense_id": "c32aa37c-e30f-3a87-bbcf-65cc8a7263da",
                                                "text": "„Bandnamen haben in der Namenforschung bisher keine Beachtung gefunden, obwohl sie sowohl von der kultursemantischen als auch der formal-strukturellen Seite her interessant sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
