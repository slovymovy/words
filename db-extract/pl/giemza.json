                                "sense_id": "43c53f8c-e3cc-376f-9d2f-1e9ea8ab62ae",
                                "text": "Do produkcji tych mokasynów użyto giemzę przywiezioną z Włoch."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "e55d912a-0af1-3cde-9dd1-b041ee175bb3",
                        "entry_id": "11f10e23-5fcb-387b-9ead-42e4b7d1eb4c",
                        "glosses": [
                            "klapa, kres"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "e0835f16-dcce-45e4-abbf-344e454f587f",
                                "sense_id": "e55d912a-0af1-3cde-9dd1-b041ee175bb3",
                                "text": "Nie udało ci się skombinować biletów, no to giemza."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "9141f2be-a956-3446-8576-88d113abe55c",
                        "entry_id": "11f10e23-5fcb-387b-9ead-42e4b7d1eb4c",
                        "glosses": [
