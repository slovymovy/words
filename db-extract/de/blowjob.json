                            {
                                "example_id": "9967d7a6-e030-4126-9868-4f957aa54044",
                                "sense_id": "d044aa88-f1d1-33cc-9169-f3072f4207cc",
                                "text": "„Plötzlich fing sie an, mich zu küssen, öffnete mir dann die Hose und gab mir gekonnt einen Blowjob.“"
                            },
                            {
                                "example_id": "8a647283-b804-41ff-9661-690c55bc4d59",
                                "sense_id": "d044aa88-f1d1-33cc-9169-f3072f4207cc",
                                "text": "„Der Salon d'argent erfreut sich doppelter Berühmtheit: Hier unterzeichnete Napoléon Bonaparte seine Abdankung nach der Niederlage von Waterloo, und Jahre später erlag Präsident Félix Faure in diesem Raum einem Herzstillstand, nachdem seine Mätresse Marguerite Steinheil ihm einen energischen Blowjob verpasst hatte.“"
                            },
                            {
                                "example_id": "b200d0ad-d92f-4f1d-8587-4b791fb3cdc5",
                                "sense_id": "d044aa88-f1d1-33cc-9169-f3072f4207cc",
                                "text": "„Er hatte tatsächlich so einige dieser Etablissements in Saigon besucht, wo man Sex für einen Zehner und einen Blowjob für einen Dollar bekam.“"
                            },
                            {
                                "example_id": "eceafe19-8e6d-4ad8-a2ac-e528462e3a9d",
                                "sense_id": "d044aa88-f1d1-33cc-9169-f3072f4207cc",
                                "text": "„Das Leben von Zuckermans Bruder Henry, einem scheinbar ausgeglichenen Zahnarzt und Familienvater, ist ein so trostloser Trott, dass er sich lieber einer lebensgefährlichen Bypass-Operation unterzieht, als die durch Betablocker hervorgerufene Impotenz in Kauf zu nehmen und auf die Blowjobs seiner Assistentin Wendy zu verzichten.“"
                            }
                        ],
