        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5344481c-abd1-3167-95d7-21136f0c3e41",
                    "sense_definition": "To walk in a slow, relaxed, or casual way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "walking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>saunter</w> through the park after finishing their lunch.",
                            "target_lang_translations": {
                                "pl": "Po obiedzie postanowili <w>pospacerować</w> po parku."
                            }
                        },
                        {
                            "text": "He would often <w>saunter</w> down the street to greet his neighbors.",
                            "target_lang_translations": {
                                "pl": "Często <w>przechadzał się</w> ulicą, by przywitać się z sąsiadami."
                            }
                        }
                    ],
                    "synonyms": [
                        "amble",
                        "stroll",
                        "ramble",
                        "wander"
                    ],
                    "common_phrases": [
                        "saunter along",
                        "saunter through"
                    ],
                    "target_lang_definitions": {
                        "pl": "Poruszać się powolnym, swobodnym lub nieformalnym krokiem."
                    },
                    "translations": {
                        "pl": [
                            {
