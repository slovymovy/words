                    {
                        "sense_id": "6e8891bc-f1d1-35e6-b378-41f95cd4b177",
                        "entry_id": "25d7be6f-068c-35a5-9401-e7ce20100dcc",
                        "glosses": [
                            "heel erg mooi waardoor je nergens anders meer aandacht voor hebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cff9a885-8500-4953-86a3-aa33e26160e0",
                                "sense_id": "6e8891bc-f1d1-35e6-b378-41f95cd4b177",
                                "text": "Toen de jongen de betoverende schoonheid zag, liep hij per ongeluk tegen de lantaarnpaal aan."
                            },
                            {
                                "example_id": "0e570fec-ea12-4855-8e27-5e9a4dcca67f",
                                "sense_id": "6e8891bc-f1d1-35e6-b378-41f95cd4b177",
                                "text": "Eenmaal aangekomen op de pas vermaakte ik me, net als de poedelnaakte Goldie, door foto’s te nemen terwijl we een handstand maakten met de betoverende Kings Canyon bergen op de achtergrond."
                            }
                        ]
                    }
                ],
