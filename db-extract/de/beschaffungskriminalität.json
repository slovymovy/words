                "senses": [
                    {
                        "sense_id": "95de3d0e-a67e-369f-8312-2d6fc2c0a7b2",
                        "entry_id": "b0dbb329-60c8-33c2-945c-50f9ecebf2cb",
                        "glosses": [
                            "Kriminalität mit der Zielsetzung, sich die finanziellen Mittel zum Drogenkauf zu verschaffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "405a4cca-59dc-4b08-a14b-3d6b9553280d",
                                "sense_id": "95de3d0e-a67e-369f-8312-2d6fc2c0a7b2",
                                "text": "Die Beschaffungskriminalität im Innenstadtbereich hat stark zugenommen."
                            },
                            {
                                "example_id": "1be0d337-abd5-4670-9bbf-3071f48941d3",
                                "sense_id": "95de3d0e-a67e-369f-8312-2d6fc2c0a7b2",
                                "text": "„Für Therapie statt Strafe entscheiden sich Richter vor allem dann, wenn es um Drogenbesitz beziehungsweise kleine, selbst abhängige Dealer geht. Kommt aber Beschaffungskriminalität wie Einbruch, Diebstahl oder Raub dazu, geben Richter strafrechtlichen Konsequenzen den Vorzug.“"
                            },
                            {
                                "example_id": "a6be9d60-873a-402e-8a10-715472bec0a0",
                                "sense_id": "95de3d0e-a67e-369f-8312-2d6fc2c0a7b2",
                                "text": "„Bei der Beschaffungskriminalität allerdings gebe es noch keinen starken Rückgang, sagte Bereswill.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
