                "forms": [
                    {
                        "form_id": "e355d55b-bc54-4469-95b7-cd017abc3751",
                        "entry_id": "d99e5c58-41d8-3b63-9330-e894c412d211",
                        "tags": [
                            "plural"
                        ],
                        "form": "rhéologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c6de08d-726d-3f71-91ac-b62be40fe9ca",
                        "entry_id": "d99e5c58-41d8-3b63-9330-e894c412d211",
                        "glosses": [
                            "Étude de la déformation et de l’écoulement de la matière sous l’effet d’une contrainte."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "99627b05-75a0-4cd8-ac53-6f2fdd85cda4",
                                "sense_id": "7c6de08d-726d-3f71-91ac-b62be40fe9ca",
                                "text": "La rhéologie est une extension des disciplines telles que l’élasticité et la mécanique des fluides newtoniens, aux matériaux dont le comportement mécanique ne peut être décrit par ces théories classiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d3ecf06-23d8-3445-8fb2-63cc2ad6fa53",
                        "entry_id": "d99e5c58-41d8-3b63-9330-e894c412d211",
                        "glosses": [
                            "Comportement rhéologique d’un matériau."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "37206c06-a7c0-48d3-b9c1-02448b86880b",
                                "sense_id": "6d3ecf06-23d8-3445-8fb2-63cc2ad6fa53",
                                "text": "En 1975, G.SUSS de la Technische Hochschule de Darmstadt, a repris l’étude de l’influence de la taille des particules de filler sur la rhéologie des mélanges filler-liant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6efc1535-0dfb-4ad2-969a-55de3e65a35a",
                        "source_entry_id": "d99e5c58-41d8-3b63-9330-e894c412d211",
                        "source_sense_description": "étude de l'écoulement sous contrainte d'un matériau",
                        "target_lang_word": "Rheologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rheologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc11e4f3-8df8-3f11-a8ca-b4c37022fd43",
                                        "entry_id": "468eaff9-3f92-3817-891e-2d5647d1a24d",
                                        "glosses": [
                                            "Physik, : Teilgebiet der Physik, das die Verformungs- und Fließeigenschaften von Materie untersucht"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f43f5f31-6cb5-4eaf-8a00-6d3bd1e0c873",
                                                "sense_id": "bc11e4f3-8df8-3f11-a8ca-b4c37022fd43",
                                                "text": "Rheologie ist die Wissenschaft, die uns hilft, Erkenntnisse über Elastizität und Viskosität eines Materials zu erhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "666e11ad-81b6-3c71-83d1-447000687078",
                                        "entry_id": "468eaff9-3f92-3817-891e-2d5647d1a24d",
                                        "glosses": [
                                            "Verhalten von Flüssigkeiten und Gasen unter äußeren Beanspruchungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a579c460-a752-40b0-a29c-de7d5404b4dc",
                                                "sense_id": "666e11ad-81b6-3c71-83d1-447000687078",
                                                "text": "„Es existiert umfangreiche Literatur, die die Vorteile der Verwendung von Produkten mit optimalen Rheologien aufgrund von Verzweigungen der Polymerketten oder von speziellen bimodalen Strukturen zeigt. “"
                                            },
                                            {
                                                "example_id": "a1168f27-abc7-4c46-81ff-1de5724f71d7",
                                                "sense_id": "666e11ad-81b6-3c71-83d1-447000687078",
                                                "text": "„Obwohl sensu latu die Sedimentationsbedingungen und strukturellen Merkmale dieser Gebiete ähnlich sind, treten sensu strictu erhebliche Unterschiede auf, welche im Wesentlichen auf die unterschiedlichen Rheologien von Schlamm und Salz zurückzuführen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
