                "senses": [
                    {
                        "sense_id": "ee01aea8-66e1-33e4-a16e-c5661145dcbf",
                        "entry_id": "be842aed-8ab1-3aeb-9021-d9b6619baa69",
                        "glosses": [
                            "an der Realität (und nicht an Vorstellungen, Träumen oder gar Utopien) orientierte weibliche Person; nüchtern-sachlich denkende und handelnde Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3434e6f-2b32-44f1-a38e-22deb5a26441",
                                "sense_id": "ee01aea8-66e1-33e4-a16e-c5661145dcbf",
                                "text": "Als Realistin war ihr klar, dass dieser Traum sich nicht würde so einfach verwirklichen lassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "69c4fca8-661b-35c4-8427-5ef486037283",
                        "entry_id": "be842aed-8ab1-3aeb-9021-d9b6619baa69",
                        "glosses": [
                            "Anhängerin der (künstlerischen/literarischen/philosophischen) Strömung des Realismus (ab 18. Jahrhundert)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "008f8b5a-2cb8-4c56-bbd7-8fd402614feb",
                                "sense_id": "69c4fca8-661b-35c4-8427-5ef486037283",
                                "text": "Wie soll man sie als Künstlerin beschreiben? Keine Impressionistin oder Expressionistin, dann doch eher eine Realistin, eine mit Hang zur Perfektion."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
