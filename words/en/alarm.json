                {
                    "sense_id": "05114ed1-88f4-3f40-84d0-076984521c44",
                    "sense_definition": "A sudden feeling of fear or worry that something bad is happening or might happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion_fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no cause for <w>alarm</w> as the situation is under control.",
                            "target_lang_translations": {
                                "ru": "Нет причин для <w>беспокойства</w>, так как ситуация под контролем.",
                                "nl": "Er is geen reden tot <w>ongerustheid</w> aangezien de situatie onder controle is.",
                                "pl": "Nie ma powodów do <w>niepokoju</w>, ponieważ sytuacja jest pod kontrolą.",
                                "de": "Es gibt keinen Grund zur <w>Beunruhigung</w>, da die Situation unter Kontrolle ist.",
                                "fr": "Il n'y a pas lieu de s'<w>alarmer</w> car la situation est sous contrôle.",
                                "it": "Non c'è motivo di <w>allarme</w> poiché la situazione è sotto controllo.",
                                "cs": "Není důvod k <w>obavám</w>, protože situace je pod kontrolou.",
                                "tr": "Durum kontrol altında olduğu için <w>endişelenecek</w> bir durum yok.",
                                "es": "No hay motivo de <w>alarma</w> ya que la situación está bajo control."
                            }
                        },
                        {
                            "text": "She looked at the dark clouds with growing <w>alarm</w>.",
                            "target_lang_translations": {
                                "ru": "Она смотрела на темные тучи с растущей <w>тревогой</w>.",
                                "nl": "Ze keek naar de donkere wolken met groeiende <w>verontrusting</w>.",
                                "pl": "Patrzyła na ciemne chmury z rosnącym <w>niepokojem</w>.",
                                "de": "Sie blickte mit wachsender <w>Besorgnis</w> auf die dunklen Wolken.",
                                "fr": "Elle regarda les nuages sombres avec une <w>inquiétude</w> grandissante.",
                                "it": "Guardò le nuvole scure con crescente <w>preoccupazione</w>.",
                                "cs": "Sledovala tmavé mraky s rostoucím <w>znepokojením</w>.",
                                "tr": "Karanlık bulutlara artan bir <w>endişeyle</w> baktı.",
                                "es": "Ella miró las nubes oscuras con creciente <w>alarma</w>."
                            }
                        }
                    ],
