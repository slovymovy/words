                "senses": [
                    {
                        "sense_id": "1ce87891-3c1a-3fdd-838f-d2e894e65359",
                        "entry_id": "b01062e4-7d51-3c94-9f95-0cdcfdc00d4c",
                        "glosses": [
                            "Mettre en mauvais état, ou dérégler."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "2bd6bd40-0549-4bcb-9ed3-1fdb13808664",
                                "sense_id": "1ce87891-3c1a-3fdd-838f-d2e894e65359",
                                "text": "Tu as débretté la grue."
                            },
                            {
                                "example_id": "070da5cf-e96e-423b-ba17-28df54157763",
                                "sense_id": "1ce87891-3c1a-3fdd-838f-d2e894e65359",
                                "text": "Il n'est ni fêlé ni débretté."
                            },
                            {
                                "example_id": "e8654e2f-a0b1-4a3f-9ade-1424863adc24",
                                "sense_id": "1ce87891-3c1a-3fdd-838f-d2e894e65359",
                                "text": "Puis le véhicule était adapté, puis là Michel est bien plus mal pris que d'autre chose, parce qu'il y a toute une installation pour que, moi, je conduise, mais je ne conduis pas. Ça fait que, lui, il est obligé de tout «débretter» pour rendre le... Donc, 2007, ça a été une année difficile, et c'est là que je me suis demandé: Comment est-ce que je vais passer à travers ça?"
                            },
                            {
                                "example_id": "cee451f7-caf2-464b-b0e2-e6832eb6c74f",
                                "sense_id": "1ce87891-3c1a-3fdd-838f-d2e894e65359",
                                "text": "Le crépi se débrette pis ça l'air de la marde avec le temps."
                            },
                            {
                                "example_id": "20ea418a-4e4e-4d13-95f5-dcd5de9ab61d",
                                "sense_id": "1ce87891-3c1a-3fdd-838f-d2e894e65359",
                                "text": "Décembre 2004: le «compteur de hits» se débrette et repart à zéro..."
                            },
                            {
                                "example_id": "e71920e7-2953-4b64-bb83-ce789ee86609",
                                "sense_id": "1ce87891-3c1a-3fdd-838f-d2e894e65359",
                                "text": "Bô-Erk aurait fait une tournée des étages avant son départ et comme par hasard, elle a « débretté » complètement."
                            }
                        ]
                    }
                ],
