                                            },
                                            {
                                                "example_id": "e61f7585-1acd-451f-9d98-26f41f11b1d0",
                                                "sense_id": "7ed050f3-cbf6-39da-97c8-7a62e55fd6c1",
                                                "text": "Самым замечательным здесь было то, что этот заводик, на котором работает всего лишь пятьсот человек, делает фары, задние фонарики и потолочные плафоны для всех заводов Форда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "473cafbd-c4d3-39b3-93e4-ff51aef52f40",
                                        "entry_id": "3f69ae24-0bda-3741-81bc-e875f234cbf2",
                                        "glosses": [
                                            "устар. маяк"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ec19b19-9c62-4ab5-a89a-e2fa82aa03bd",
                                                "sense_id": "473cafbd-c4d3-39b3-93e4-ff51aef52f40",
                                                "text": "Корабли Игоревы стояли на якорях близ фара, или маяка, готовые к сражению."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5e538f7-5514-3bd9-ae24-534a05bd3ac0",
                                        "entry_id": "3f69ae24-0bda-3741-81bc-e875f234cbf2",
                                        "glosses": [
                                            "перен., жарг. или мол., шутл. большие глаза"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f79b1e6-8ab8-4e9a-9d46-1d7d2b031f42",
                                                "sense_id": "d5e538f7-5514-3bd9-ae24-534a05bd3ac0",
                                                "text": "Девушка испуганно заморгала и прикрыла лицо рукой, и лейтенант с фатовскими усиками закричал: — Гаси свет! Чего фары вылупил?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6887fb49-d270-3b3c-9701-3915d604fb90",
                                        "entry_id": "3f69ae24-0bda-3741-81bc-e875f234cbf2",
                                        "glosses": [
                                            "перен., жарг. кровоподтёк под глазом; синяк"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "908cd4e8-f3f0-4872-a8fd-46de9133b6af",
                                                "sense_id": "6887fb49-d270-3b3c-9701-3915d604fb90",
                                                "text": "Под глазом у Тита лиловела огромная «фара» — столкнулся с кем-то возле щита."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f658e0a4-9026-32e9-8f58-dceaa6484282",
                                        "entry_id": "3f69ae24-0bda-3741-81bc-e875f234cbf2",
                                        "glosses": [
                                            "крим., жарг. сигнал опасности"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63d688d8-4459-4626-a016-2cbfbffcd3e2",
                        "source_entry_id": "3f779dee-6fe1-3de5-8198-ee23007c6ccc",
                        "source_sense_id": "f13c6f5f-aa93-375b-9df2-bd3ad954d68f",
                        "target_lang_word": "reflecting telescope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reflecting telescope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98650695-9389-38d8-a317-3891de344180",
                                        "entry_id": "0cf342dd-d4b5-36a6-a76c-0e2bb3ccd86f",
                                        "glosses": [
                                            "A telescope which produces a magnified image by reflecting light through a series of mirrors housed in a tube, using a large curved mirror to gather the light and one or more additional mirrors to transmit the light to an eyepiece."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc31c658-99d1-45b7-8893-95acc5ea5d44",
                        "source_entry_id": "3f779dee-6fe1-3de5-8198-ee23007c6ccc",
                        "source_sense_id": "f13c6f5f-aa93-375b-9df2-bd3ad954d68f",
                        "target_lang_word": "reflector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reflector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84cdcad4-4acb-39ae-aeb9-a95df036a0f3",
                                        "entry_id": "be74eb40-7657-35d5-8e6d-d006c92ace4c",
                                        "glosses": [
                                            "Something which reflects heat, light or sound, especially something having a reflecting surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a60a255a-4682-4126-9212-dacd92c7366d",
                                                "sense_id": "84cdcad4-4acb-39ae-aeb9-a95df036a0f3",
                                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady. She stood for a moment holding her skirt above the grimy steps,[…], and the light of the reflector fell full upon her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d059663-802d-3db3-961e-0218a7a83684",
                                        "entry_id": "be74eb40-7657-35d5-8e6d-d006c92ace4c",
                                        "glosses": [
                                            "A reflecting telescope."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4d248dc-ffc4-366b-83cf-a2663663e8ad",
                                        "entry_id": "be74eb40-7657-35d5-8e6d-d006c92ace4c",
                                        "glosses": [
                                            "A small, often red, reflecting disk on the rear of a vehicle or bicycle that reflects the headlights of other vehicles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8fd7c88c-e0a8-346f-826a-21bdb93cfd3b",
                                        "entry_id": "be74eb40-7657-35d5-8e6d-d006c92ace4c",
                                        "glosses": [
                                            "A safety reflector."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63c5e57c-0174-3f7e-934c-e7b0735f8a63",
                                        "entry_id": "be74eb40-7657-35d5-8e6d-d006c92ace4c",
                                        "glosses": [
                                            "One who reflects on something; one who thinks or considers at length."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f7ae968-81d6-408a-9910-13b8aee1dde4",
                                                "sense_id": "63c5e57c-0174-3f7e-934c-e7b0735f8a63",
                                                "text": "Most reflectors on leadership are comfortable thinking of \"ethical\" and \"unethical\" as modifiers of leadership."
                                            },
                                            {
                                                "example_id": "1bf4d0e7-cb6c-4c7b-94fd-b1d2af93fff5",
                                                "sense_id": "63c5e57c-0174-3f7e-934c-e7b0735f8a63",
                                                "text": "Nonreflectors simply thought through that which they already knew, reflectors evaluated experiences by interpreting these experiences, and critical reflectors re-evaluated their presuppositions to correct distortions in reasoning and attitudes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c57a4b17-9af8-309c-97b7-e9b5c893712f",
                                        "entry_id": "be74eb40-7657-35d5-8e6d-d006c92ace4c",
                                        "glosses": [
                                            "Something that is reflective (indicative) of something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77fa1416-799b-46dc-9651-944f34009420",
                                                "sense_id": "c57a4b17-9af8-309c-97b7-e9b5c893712f",
                                                "text": "The biography is an enormously powerful reflector of mainstream values: it is a statement that this person is someone, or did something, worth writing about. Similarly, because the biographer has access to myriads of details about her or his subject, what gets full exposure and what gets swept under the carpet can be more indicative of the biographer's values (and the society that instilled them) than of the actual subject's life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc487996-43c0-374c-90dd-999afce34934",
                                        "entry_id": "be74eb40-7657-35d5-8e6d-d006c92ace4c",
                                        "glosses": [
                                            "A pattern which can change the direction and/or offset of an oncoming spaceship without being destroyed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
