                        "target_lang_word": "Klaue",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klaue",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1db0e660-a691-348e-b218-b376c8731671",
                                        "entry_id": "0df16d4a-82f5-31ec-89c0-ccbb0326e89e",
                                        "glosses": [
                                            "Hornteil des Tierfußes, besonders Huf von Wiederkäuern, Kralle von Raubvögeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe302b48-f89b-4a0f-80f0-bbdc9a9c1591",
                                                "sense_id": "1db0e660-a691-348e-b218-b376c8731671",
                                                "text": "Mit seinen Klauen grub sich das Schwein in den Morast."
                                            },
                                            {
                                                "example_id": "da728b52-21f4-4d5c-b1d3-5c53958a423d",
                                                "sense_id": "1db0e660-a691-348e-b218-b376c8731671",
                                                "text": "„Für das Silber mußte er einen Krug Güldenprachter Wein sowie einen Schweinekopf nebst vier Klauen einkaufen und alles in die Küche schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21ba603d-acd3-30c3-bc0c-b1cdb3ffaca6",
                                        "entry_id": "0df16d4a-82f5-31ec-89c0-ccbb0326e89e",
                                        "glosses": [
                                            "Hand"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "426dee06-0155-4c81-b5c5-545e19a9189e",
                                                "sense_id": "21ba603d-acd3-30c3-bc0c-b1cdb3ffaca6",
                                                "text": "Er starrte auf die schmutzigen Klauen dieses Menschen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "202a7ba2-887d-3c1b-9f64-9624e2295148",
                                        "entry_id": "0df16d4a-82f5-31ec-89c0-ccbb0326e89e",
                                        "glosses": [
                                            "unleserliche, schlechte Handschrift"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa50e762-024d-4554-9777-1b5b70acdd9e",
                                                "sense_id": "202a7ba2-887d-3c1b-9f64-9624e2295148",
                                                "text": "Deine Klaue kann ja niemand lesen, schreib doch etwas schöner."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e1619a2c-9e40-34bb-9f1c-8dd31ae5205a",
                                        "entry_id": "0df16d4a-82f5-31ec-89c0-ccbb0326e89e",
                                        "glosses": [
                                            "scheren-, zangenähnlicher Fuß-Fortsatz"
                                        ],
                                        "tags": [
                                            "häufig bei Insekten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "514cc66e-a447-4ee9-9b23-8d7b1433a68a",
                                                "sense_id": "e1619a2c-9e40-34bb-9f1c-8dd31ae5205a",
                                                "text": "Bei diesem Käfer sind die Klauen der Hinterfüße ungleich lang."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "36c8792c-65f0-3fbc-9273-660ee54f2c26",
                                        "entry_id": "0df16d4a-82f5-31ec-89c0-ccbb0326e89e",
                                        "glosses": [
                                            "eine hakenartige Form bei Werkzeugen, Geräten und Vorrichtungen, um Gegenstände besser Greifen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d3e65be-668a-4718-9b3f-a957ec9c2c8e",
                                                "sense_id": "36c8792c-65f0-3fbc-9273-660ee54f2c26",
                                                "text": "Dank der funktionalen Klaue konnte das Gerät den Gegenstand gut greifen."
                                            },
                                            {
                                                "example_id": "c0324eac-e1a4-45c1-93a7-260fd9ef6cce",
                                                "sense_id": "36c8792c-65f0-3fbc-9273-660ee54f2c26",
                                                "text": "„Er setzte den Hammer mit der Klaue zwischen Drahtschlinge und Türstock an und hebelte ein paarmal am Scharnier, wobei er einen ziemlichen Lärm verursachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4261a00e-9fa8-450a-b7a1-281bcb1c452b",
                        "source_entry_id": "80bf401a-e6cd-3cd4-964e-cf58ee7c62be",
