        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bf808a83-1dd4-38ce-b639-a046008e0d8d",
                    "sense_definition": "In alle opzichten; helemaal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "complete_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben het <w>volkomen</w> met je eens over dit onderwerp.",
                            "target_lang_translations": {
                                "ru": "Я <w>полностью</w> согласен с тобой по этому вопросу.",
                                "en": "I <w>completely</w> agree with you on this subject.",
                                "fr": "Je suis <w>tout à fait</w> d'accord avec toi sur ce sujet."
                            }
                        },
                        {
                            "text": "Dat was <w>volkomen</w> onaanvaardbaar gedrag tijdens de vergadering.",
                            "target_lang_translations": {
                                "ru": "Это было <w>совершенно</w> неприемлемое поведение во время собрания.",
                                "en": "That was <w>totally</w> unacceptable behavior during the meeting.",
                                "fr": "C'était un comportement <w>absolument</w> inacceptable pendant la réunion."
                            }
                        }
                    ],
                    "synonyms": [
                        "helemaal",
                        "volledig",
                        "compleet",
                        "totaal"
