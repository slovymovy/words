                        "faire grâce de",
                        "coup de grâce"
                    ]
                },
                {
                    "sense_id": "b6056af9-f897-3443-b817-00695cf82770",
                    "sense_definition": "Acte de clémence par lequel le chef de l'État dispense un condamné d'exécuter sa peine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pardon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président de la République a exercé son droit de <w>grâce</w> en faveur du prisonnier."
                        },
                        {
                            "text": "L'avocat a immédiatement déposé un recours en <w>grâce</w> pour son client."
