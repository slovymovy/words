                        "entry_id": "e654193b-7fe8-3791-b6ff-52ba088de050",
                        "glosses": [
                            "Personne qui s’occupe d’ostréiculture (élevage des huîtres)."
                        ],
                        "tags": [
                            "Élevage",
                            "Ostréiculture"
                        ],
                        "examples": [
                            {
                                "example_id": "d244bdaa-73fb-46a4-85bc-42d18554ddd7",
                                "sense_id": "53b1f20a-ab22-3b86-a816-8db51befaac4",
                                "text": "De plus, en raison de la quotidienneté de leur activité, les ostréiculteurs, contrairement aux marins de pêche ou de commerce, sont généralement embarqués 365 jours par an."
                            },
                            {
                                "example_id": "89a0a1e2-4119-46a1-a4d9-d4162272651d",
                                "sense_id": "53b1f20a-ab22-3b86-a816-8db51befaac4",
                                "text": "L’Éguille célèbre ses ostréiculteurs samedi 13 et dimanche 14 août."
                            },
                            {
                                "example_id": "1b51b55e-e033-4a29-b36f-5ff07539175e",
                                "sense_id": "53b1f20a-ab22-3b86-a816-8db51befaac4",
                                "text": "Roland Tétaud, ostréiculteur à Bourcefranc, est décédé le 3 août."
                            }
                        ]
