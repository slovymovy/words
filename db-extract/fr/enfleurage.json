                "senses": [
                    {
                        "sense_id": "650c7aa3-3fef-371b-b850-fd914605f4fc",
                        "entry_id": "bb640ae6-a578-3c7f-86a7-0483eea33d43",
                        "glosses": [
                            "Action d’enfleurer."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d56842e4-ccd5-4e70-9378-9391a350657f",
                                "sense_id": "650c7aa3-3fef-371b-b850-fd914605f4fc",
                                "text": "Les extraits sont obtenus soit en mélangeant des huiles essentielles odorantes, soit en traitant par l'alcool les graisses qui se sont imprégnées d'essences pendant l'opération de l'enfleurage."
                            },
                            {
                                "example_id": "7171dccc-301d-4e97-b077-24a771e8bed1",
                                "sense_id": "650c7aa3-3fef-371b-b850-fd914605f4fc",
                                "text": "L'essence naturelle de tubéreuse était jadis obtenue par enfleurage à froid : les fleurs étaient déposées sur des plaques enduites de graisse inodore, qui s'imprégnait de leur parfum. Un solvant tel que l'éthanol permettait d'obtenir par la suite une essence dite « absolue »."
                            }
                        ]
                    }
                ],
