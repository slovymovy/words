{
    "word_family": [
        "veil",
        "unveiling",
        "revealer",
        "revelation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3466d74e-335a-36e4-adec-3545225728f9",
                    "sense_definition": "To show or announce something to the public for the first time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "reveal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tech giant is expected to <w>unveil</w> its latest smartphone at the conference tomorrow.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что завтра на конференции технологический гигант <w>представит</w> свой новейший смартфон."
                            }
                        },
                        {
                            "text": "The company will <w>unveil</w> a new plan to reduce carbon emissions by the end of the year.",
                            "target_lang_translations": {
                                "ru": "Компания <w>обнародует</w> новый план по сокращению выбросов углекислого газа к концу года."
                            }
                        }
                    ],
                    "synonyms": [
                        "reveal",
                        "show",
                        "display",
                        "unfold"
                    ],
                    "antonyms": [
                        "conceal",
                        "hide"
                    ],
                    "common_phrases": [
                        "unveil a new plan",
                        "unveil a statue",
                        "unveil the prototype"
                    ],
                    "target_lang_definitions": {
                        "ru": "Впервые показать или объявить что-либо общественности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представить",
                                "target_lang_sense_clarification": "публике новый продукт или план"
                            },
                            {
                                "target_lang_word": "презентовать",
                                "target_lang_sense_clarification": "официально показать новинку"
                            },
                            {
                                "target_lang_word": "обнародовать",
                                "target_lang_sense_clarification": "сделать информацию публичной"
                            },
                            {
                                "target_lang_word": "раскрыть",
                                "target_lang_sense_clarification": "сделать известным скрытый ранее план"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a304bb39-6bcb-306f-ab9c-254e3ea274d3",
                    "sense_definition": "To remove a cover or veil from something so that it can be seen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "reveal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist decided to <w>unveil</w> the painting after months of working in secret.",
                            "target_lang_translations": {
                                "ru": "Художник решил <w>показать</w> картину после нескольких месяцев секретной работы."
                            }
                        },
                        {
                            "text": "They will <w>unveil</w> the monument during the official ceremony on Saturday.",
                            "target_lang_translations": {
                                "ru": "Они торжественно <w>откроют</w> памятник во время официальной церемонии в субботу."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncover",
                        "bare",
                        "uncloak"
                    ],
                    "antonyms": [
                        "cover",
                        "veil"
                    ],
                    "common_phrases": [
                        "unveil the face",
                        "unveil the monument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снять покров или завесу с чего-либо, чтобы это стало видимым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торжественно открыть",
                                "target_lang_sense_clarification": "памятник или монумент"
                            },
                            {
                                "target_lang_word": "обнажить",
                                "target_lang_sense_clarification": "снять физическое покрытие"
                            },
                            {
                                "target_lang_word": "раскрыть",
                                "target_lang_sense_clarification": "убрать то, что закрывало обзор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75f6032b-bab2-39e4-9c6f-2e23a89f2eb5",
                    "sense_definition": "To remove one's own veil or to reveal one's true identity or character.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reveal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the final act of the play, the mysterious stranger finally <w>unveils</w> himself to the audience.",
                            "target_lang_translations": {
                                "ru": "В финальном акте пьесы таинственный незнакомец наконец <w>раскрывает</w> себя зрителям."
                            }
                        },
                        {
                            "text": "She chose to <w>unveil</w> her true intentions only after the contract was signed.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>раскрыть</w> свои истинные намерения только после подписания контракта."
                            }
                        }
                    ],
                    "synonyms": [
                        "reveal",
                        "expose"
                    ],
                    "antonyms": [
                        "disguise",
                        "mask"
                    ],
                    "common_phrases": [
                        "unveil oneself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снять с себя вуаль или раскрыть свою истинную личность или характер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскрыться",
                                "target_lang_sense_clarification": "показать свою истинную сущность"
                            },
                            {
                                "target_lang_word": "разоблачить себя",
                                "target_lang_sense_clarification": "выявить свои скрытые намерения"
                            },
                            {
                                "target_lang_word": "открыться",
                                "target_lang_sense_clarification": "перестать скрывать лицо или тайну"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}