                        "glosses": [
                            "mansuetude, amiability, geniality, good nature"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2930690-2417-4962-ac9b-2c0f9b21b356",
                                "sense_id": "cd36e363-e230-378f-b178-b2e4118b208b",
                                "text": "В пя́том часу́ она́ обе́дала до́ма с му́жем. Его́ простота́, здра́вый смысл и доброду́шие приводи́ли её в умиле́ние и восто́рг.",
                                "translation": "She dined at home with her husband at five o'clock. She was in ecstasies over his simplicity, common sense, and good humour.",
                                "english": "She dined at home with her husband at five o'clock. She was in ecstasies over his simplicity, common sense, and good humour."
                            }
                        ]
                    }
                ],
