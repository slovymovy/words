                                        "examples": [
                                            {
                                                "example_id": "a80f8c78-6977-42c2-9869-4e9c9e17495c",
                                                "sense_id": "1f0e8798-b8cf-33d7-abd1-e99b5ac0fc92",
                                                "text": "Avec le Solutréen (race de Cro-Magnon), l’industrie lithique atteint son apogée : les solutréens furent d’admirables ciseleurs de pierre (pointes à feuille de laurier, pointes à cran, véritables bijoux)."
                                            },
                                            {
                                                "example_id": "0380b2ba-b714-403f-a69d-1d9e4f1d4d08",
                                                "sense_id": "1f0e8798-b8cf-33d7-abd1-e99b5ac0fc92",
                                                "text": "En archéologie préhistorique, une sorte de dogme attribuait en effet aux Solutréens l’invention du traitement thermique […]"
                                            }
                                        ]
                                    }
