                                        "entry_id": "b9082697-dad4-3e97-8d4e-fc86630336f5",
                                        "glosses": [
                                            "A natural gift or talent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97e4f50e-392f-3c3e-a7de-8e23411e2084",
                                        "entry_id": "b9082697-dad4-3e97-8d4e-fc86630336f5",
                                        "glosses": [
                                            "A large amount."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc0faf00-57bc-4693-b133-78245531240b",
                                                "sense_id": "97e4f50e-392f-3c3e-a7de-8e23411e2084",
                                                "text": "But no palace had so fair a ceiling; for from the wooden beams were suspended a whole dowry of copper vessels—pails, cauldrons, water pots, of every colour from lustrous black to the palest pink."
                                            }
                                        ]
                                    }
