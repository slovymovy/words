                        "form": "die Isländerinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d61e517e-f6b5-391e-94aa-e7847330ed8b",
                        "entry_id": "4764281d-7045-3e3f-953d-48bf11186123",
                        "glosses": [
                            "Staatsbürgerin von Island"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d30eaacc-6d26-44c1-9cf2-7bfb41b00b3a",
                                "sense_id": "d61e517e-f6b5-391e-94aa-e7847330ed8b",
                                "text": "„Ich erzähle ihm, dass ich auf dem Hinflug eine Begegnung mit einer jungen Isländerin hatte.“"
                            },
                            {
                                "example_id": "e22ccf24-745b-4ee9-baf3-701b61f9876c",
                                "sense_id": "d61e517e-f6b5-391e-94aa-e7847330ed8b",
                                "text": "„Auf der anderen Seite jedoch saß eine etwas ältere Frau und sang aus voller Kehle, obwohl die Isländerin war.“"
                            },
                            {
                                "example_id": "b60a9f49-bd16-44ce-af4b-0824a262fdc3",
                                "sense_id": "d61e517e-f6b5-391e-94aa-e7847330ed8b",
                                "text": "„Ich bin mit Isländerinnen ins Bett gegangen, nur um rauszukriegen, wo sich die wirklich geheimen Quellen befinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ec8bff3-5993-44dd-b519-8c815798fea3",
                        "source_entry_id": "4764281d-7045-3e3f-953d-48bf11186123",
                        "source_sense_id": "d61e517e-f6b5-391e-94aa-e7847330ed8b",
