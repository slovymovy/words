                                "target_senses": [
                                    {
                                        "sense_id": "2e8a99b9-8fef-32e8-b24a-3f6de03d9aa3",
                                        "entry_id": "3dc759db-ef6b-3750-89dc-ee8b4ab3e881",
                                        "glosses": [
                                            "An early-medieval geographic region corresponding to the homeland of the Merovingian Franks in modern western Germany, northeastern France, Belgium and parts of the Netherlands. Capital: Metz."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a01a5f3-5ccc-4594-ac26-8972539b4229",
                        "source_entry_id": "05d09aab-2c2c-3a04-a8b7-f79f1285b056",
                        "source_sense_id": "576d0408-f8c6-3fa8-9d91-bb0e693e347c",
                        "source_sense_description": "(nord-)östlich gelegenes Teilreich des (merowingischen) Frankenreichs (6.–8. Jahrhundert)",
                        "target_lang_word": "Austrasie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Austrasie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4215bdb6-3a88-360e-abc8-ebcd92c549e0",
                                        "entry_id": "d418864d-262f-3427-83a5-6acec014dcad",
                                        "glosses": [
                                            "Royaume franc qui s'étendait du nord-est de la France actuelle, les bassins de la Meuse et de la Moselle, jusqu’aux bassins moyen et inférieur du Rhin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd08ef02-cc4b-416f-bead-ee7f22d6a9c7",
                                                "sense_id": "4215bdb6-3a88-360e-abc8-ebcd92c549e0",
                                                "text": "Cette frontière qu'il fallait défendre contre les Goths et contre les Basques appartenait alors toute entière au roi d’Austrasie, au nom duquel le ban de guerre fut publié sur les deux rives de l’Adour."
                                            },
                                            {
                                                "example_id": "f70ee8c0-e9cf-4d87-861a-21139e6d867c",
                                                "sense_id": "4215bdb6-3a88-360e-abc8-ebcd92c549e0",
                                                "text": "Le royaume franc était divisé en trois sous-royaumes, Neustrie, Austrasie et Burgondie, qui avaient leur propre aristocratie, leur cour, avec souvent un roi spécifique et leur maire du palais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
