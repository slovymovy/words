                        "examples": [
                            {
                                "example_id": "691f9b18-b746-4ba5-b29f-96726c933c89",
                                "sense_id": "82227a2b-5ade-3819-b2db-c859b138b04e",
                                "text": "Frankrijk heeft zich geplaatst voor de finaleronde van de Nations League. De wereldkampioen was in Lissabon te sterk voor regerend Europees kampioen Portugal: 0-1."
                            },
                            {
                                "example_id": "2bee89c0-7d3d-4804-bb89-f1c6fc63faab",
                                "sense_id": "82227a2b-5ade-3819-b2db-c859b138b04e",
                                "text": "De Azzurri spelen geen vlekkeloze wedstrijd, de thuisploeg krijgt enkele grote kansen, maar uiteindelijk winnen ze wel: 0-2. En door die zege verzekert Italië zich ten koste van Nederland voor de finaleronde van de Nations League."
                            }
