                                            {
                                                "example_id": "0482eb65-2264-410b-b30b-47f7adc5f0db",
                                                "sense_id": "f7b653c1-fd96-3af2-b25c-1512852d86e6",
                                                "text": "Mit Zungenreden ist ein Phänomen gemeint, über das in der Bibel mehrfach berichtet wird . (Zitate in Wikipedia)"
                                            },
                                            {
                                                "example_id": "6cfa14cb-5d07-4974-852c-d74de37bb7ac",
                                                "sense_id": "f7b653c1-fd96-3af2-b25c-1512852d86e6",
                                                "text": "„Unter Zungenreden (Glossolalie) wird ein Sprechen oder Beten im oder mit dem Heiligen Geist verstanden, und zwar in einer Sprache, die dem Sprecher unbekannt ist (siehe 1. Korinther 14).“"
                                            },
                                            {
                                                "example_id": "14ec542e-2c10-45c5-b150-7d6273cd00bb",
                                                "sense_id": "f7b653c1-fd96-3af2-b25c-1512852d86e6",
                                                "text": "„Verbreiteter als das »snake handling« ist das weitaus weniger gefährliche und dennoch emotional erfüllende Zungenreden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
