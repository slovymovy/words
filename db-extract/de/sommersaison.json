                "senses": [
                    {
                        "sense_id": "02d0d6c5-0b05-3c61-a515-0fc9a69488ba",
                        "entry_id": "09d0ba98-b56b-3008-b363-1d137bc4fc37",
                        "glosses": [
                            "Hauptgeschäftszeit, Hauptreisezeit der warmen Monate (Mai/Juni-August/September)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49bb684e-dfb3-4725-8900-712b93fb7663",
                                "sense_id": "02d0d6c5-0b05-3c61-a515-0fc9a69488ba",
                                "text": "„[…] Die Dampfeisenbahn fährt in der Sommersaison (Ostern bis September) von Douglas zum Port Erin und hält an verschiedenen Orten.“"
                            },
                            {
                                "example_id": "0eb1a8bd-bcfb-4b83-b6db-86629aa44b8e",
                                "sense_id": "02d0d6c5-0b05-3c61-a515-0fc9a69488ba",
                                "text": "„In der Sommersaison arbeiten im Camp etwa 150 Goldgräber, 25 bis 30 davon sind Frauen.“"
                            },
                            {
                                "example_id": "dbc76c27-e940-4930-9aea-c62e5919d1eb",
                                "sense_id": "02d0d6c5-0b05-3c61-a515-0fc9a69488ba",
                                "text": "„Die britische Presse berichtete kürzlich von einem Industriellen, der für diese Sommersaison eine Überraschung besonderer Art bereithält: das Sporthemd aus Papier.“"
                            },
                            {
                                "example_id": "5bf7b195-efb1-41bf-9538-6cc42a689280",
                                "sense_id": "02d0d6c5-0b05-3c61-a515-0fc9a69488ba",
                                "text": "„Michalis nutzt die Sommersaison, um in der Gastronomie Geld zu verdienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
