                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De deuren <w>openstaand</w> achterlatend rende hij snel naar buiten.",
                            "target_lang_translations": {
                                "fr": "En laissant les portes <w>ouvertes</w>, il a vite couru dehors."
