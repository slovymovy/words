{
    "word_family": [
        "novel",
        "novelist",
        "novelization",
        "novelize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9545da33-2eac-322f-b56b-8681a0f698d3",
                    "sense_definition": "The quality or state of being new, original, or unusual",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "newness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>novelty</w> of the new job wore off after a few months of routine.",
                            "target_lang_translations": {
                                "ru": "Эффект <w>новизны</w> от новой работы прошел через несколько месяцев рутины."
                            }
                        },
                        {
                            "text": "Electric cars were once a sheer <w>novelty</w> but are now common on our roads.",
                            "target_lang_translations": {
                                "ru": "Электромобили когда-то были абсолютной <w>диковинкой</w>, но теперь они обычное явление на наших дорогах."
                            }
                        }
                    ],
                    "synonyms": [
                        "newness",
                        "freshness",
                        "originality"
                    ],
                    "antonyms": [
                        "familiarity",
                        "sameness"
                    ],
                    "common_phrases": [
                        "sheer novelty",
                        "sense of novelty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние новизны, оригинальности или необычности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новизна",
                                "target_lang_sense_clarification": "свойство чего-либо нового"
                            },
                            {
                                "target_lang_word": "необычность",
                                "target_lang_sense_clarification": "качество чего-то непривычного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b63b5454-bcc7-34c2-814a-dabfa8802f6b",
                    "sense_definition": "A small, inexpensive toy or trinket, often sold as a souvenir or gift",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gift shop was filled with plastic <w>novelties</w> and postcards for tourists.",
                            "target_lang_translations": {
                                "ru": "Сувенирный магазин был забит пластиковыми <w>безделушками</w> и открытками для туристов."
                            }
                        },
                        {
                            "text": "He bought a <w>novelty</w> item that looked like a giant foam finger.",
                            "target_lang_translations": {
                                "ru": "Он купил <w>шуточный</w> предмет, который выглядел как гигантский палец из пенопласта."
                            }
                        }
                    ],
                    "synonyms": [
                        "trinket",
                        "knick-knack",
                        "bauble"
                    ],
                    "common_phrases": [
                        "novelty item",
                        "novelty shop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькая недорогая игрушка или безделушка, часто продаваемая в качестве сувенира или подарка"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безделушка",
                                "target_lang_sense_clarification": "мелкое украшение или игрушка"
                            },
                            {
                                "target_lang_word": "сувенир",
                                "target_lang_sense_clarification": "памятный подарок"
                            },
                            {
                                "target_lang_word": "прикольная вещица",
                                "target_lang_sense_clarification": "забавный предмет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e43e7e7-8d7e-3e95-a31a-8b8742ae1fbf",
                    "sense_definition": "A new product, invention, or innovation",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "innovation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is always looking for a technical <w>novelty</w> to stay ahead of competitors.",
                            "target_lang_translations": {
                                "ru": "Компания всегда ищет техническую <w>новинку</w>, чтобы опережать конкурентов."
                            }
                        },
                        {
                            "text": "The patent office reviewed the <w>novelty</w> of the design before granting approval.",
                            "target_lang_translations": {
                                "ru": "Патентное ведомство проверило <w>новизну</w> дизайна перед выдачей одобрения."
                            }
                        }
                    ],
                    "synonyms": [
                        "innovation",
                        "invention"
                    ],
                    "common_phrases": [
                        "technical novelty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новый продукт, изобретение или инновация"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новинка",
                                "target_lang_sense_clarification": "недавно появившийся товар или изделие"
                            },
                            {
                                "target_lang_word": "нововведение",
                                "target_lang_sense_clarification": "инновация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc07456b-fce3-371e-9b2b-beb9d4fcab81",
                    "sense_definition": "In chess, a move in the opening that has never been played before in recorded games",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmaster prepared a theoretical <w>novelty</w> on move fifteen to surprise his opponent.",
                            "target_lang_translations": {
                                "ru": "Гроссмейстер подготовил теоретическую <w>новинку</w> на пятнадцатом ходу, чтобы удивить противника."
                            }
                        },
                        {
                            "text": "The game was drawn after Black found a strong <w>novelty</w> in the Sicilian Defense.",
                            "target_lang_translations": {
                                "ru": "Партия закончилась вничью после того, как черные нашли сильную <w>новинку</w> в сицилианской защите."
                            }
                        }
                    ],
                    "common_phrases": [
                        "theoretical novelty",
                        "unveil a novelty"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in chess"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В шахматах: ход в дебюте, который ранее не встречался в записанных партиях"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новинка",
                                "target_lang_sense_clarification": "новый ход в шахматной теории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2de17473-3a7c-3edb-8101-5bed1864ed0d",
                    "sense_definition": "In novelty theory, the density of complexification and dynamic change over time",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher discussed the increasing <w>novelty</w> of the universe as it evolves.",
                            "target_lang_translations": {
                                "ru": "Философ обсуждал возрастающую <w>новизну</w> Вселенной по мере её эволюции."
                            }
                        },
                        {
                            "text": "According to this model, <w>novelty</w> reaches a peak during periods of rapid social change.",
                            "target_lang_translations": {
                                "ru": "Согласно этой модели, <w>новизна</w> достигает пика в периоды быстрых социальных изменений."
                            }
                        }
                    ],
                    "antonyms": [
                        "habituation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "philosophical or scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В теории новизны: плотность усложнения и динамических изменений с течением времени"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новизна",
                                "target_lang_sense_clarification": "философский термин, обозначающий степень сложности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "176834df-f123-3561-8f6b-32246a3c45b1",
                    "sense_definition": "Describing an item designed for humor or display rather than serious functional use",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>novelty</w> tie that played music whenever someone pressed the button.",
                            "target_lang_translations": {
                                "ru": "На ней был <w>необычный</w> галстук, который играл музыку каждый раз, когда кто-то нажимал на кнопку."
                            }
                        },
                        {
                            "text": "The office was decorated with <w>novelty</w> mugs shaped like various animals.",
                            "target_lang_translations": {
                                "ru": "Офис был украшен <w>сувенирными</w> кружками в форме различных животных."
                            }
                        }
                    ],
                    "synonyms": [
                        "gimmicky",
                        "decorative"
                    ],
                    "antonyms": [
                        "functional",
                        "practical"
                    ],
                    "common_phrases": [
                        "novelty mugs",
                        "novelty socks",
                        "novelty hat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает предмет, предназначенный для шутки или демонстрации, а не для серьезного использования"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сувенирный",
                                "target_lang_sense_clarification": "предназначенный для подарка"
                            },
                            {
                                "target_lang_word": "шуточный",
                                "target_lang_sense_clarification": "сделанный ради забавы"
                            },
                            {
                                "target_lang_word": "необычный",
                                "target_lang_sense_clarification": "оригинальный по форме"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a37ac607-f742-30e3-81fe-649bc5f38cea",
                    "sense_definition": "A small village located in the state of Missouri, United States",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The historic post office in <w>Novelty</w> has been a landmark for many years.",
                            "target_lang_translations": {
                                "ru": "Историческое почтовое отделение в <w>Новелти</w> на протяжении многих лет является местной достопримечательностью."
                            }
                        },
                        {
                            "text": "They drove through <w>Novelty</w> while exploring the rural roads of Missouri.",
                            "target_lang_translations": {
                                "ru": "Они проезжали через <w>Новелти</w>, исследуя сельские дороги Миссури."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Missouri, USA"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая деревня, расположенная в штате Миссури, США"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Новелти",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
