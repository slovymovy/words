                "senses": [
                    {
                        "sense_id": "06f818a2-c09d-3125-a844-e4ff0050d094",
                        "entry_id": "a1d72e4d-c04d-37fc-999d-4549cd541d8f",
                        "glosses": [
                            "Manteau imperméable."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "cf339587-761e-4c4f-9571-65a9c5197135",
                                "sense_id": "06f818a2-c09d-3125-a844-e4ff0050d094",
                                "text": "Il [le brouillard] s’accroche aux vêtements de bureau, étriqués et minces, aux waterproofs des fillettes de magasin, aux petits voiles flasques, aux grands cartons de toile cirée."
                            },
                            {
                                "example_id": "9a99c2b5-45dd-47bb-9b9b-452674f88306",
                                "sense_id": "06f818a2-c09d-3125-a844-e4ff0050d094",
                                "text": "… et une pluie incessante qui ne nous empêcha pas de repartir le lendemain, ayant rabattu le bord de nos chapeaux et endossé nos waterproof."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6856c2e1-70b6-462a-bb4d-63da90fd4e32",
                        "source_entry_id": "a1d72e4d-c04d-37fc-999d-4549cd541d8f",
                        "source_sense_id": "06f818a2-c09d-3125-a844-e4ff0050d094",
