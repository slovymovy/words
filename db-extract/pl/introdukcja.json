                        ]
                    },
                    {
                        "translation_id": "a1993611-5e15-4639-ba09-baca4a7bcce3",
                        "source_entry_id": "5057a64f-c299-388f-8272-f5c095a767bd",
                        "source_sense_id": "c02668a5-d082-398b-af1f-e39e33a14a52",
                        "target_lang_word": "introduction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "introduction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9f871e9-bdf2-3f51-abea-19f32aaca525",
                                        "entry_id": "94701d77-47ac-3a50-9a0b-64ba54ee1cde",
                                        "glosses": [
                                            "Action d’introduire, de faire entrer une chose dans une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aa5a23d-3dd1-47a2-89fd-b92a5805fc5c",
                                                "sense_id": "c9f871e9-bdf2-3f51-abea-19f32aaca525",
                                                "text": "C'est en 1875 que Copeman a proposé la dilatation du col par l’introduction du doigt contre l’hyperemesis gravidarum ; l'auteur publie deux faits favorables à la méthode."
                                            },
                                            {
                                                "example_id": "e6927348-2af7-4fa2-9373-44f3ce7e3460",
                                                "sense_id": "c9f871e9-bdf2-3f51-abea-19f32aaca525",
                                                "text": "Une étude récente a démontré que les chances de valider son billet de train dès la première introduction dans le composteur sont de 1 sur 200 000 et qu'en moyenne, […]."
                                            },
                                            {
                                                "example_id": "17ff247c-9f9c-4593-bc61-f613e9dfb95c",
                                                "sense_id": "c9f871e9-bdf2-3f51-abea-19f32aaca525",
                                                "text": "— L’introduction d’une coutume nouvelle, d’un usage étranger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c61a5e7d-13d0-37d0-86d0-2613e5b6c55e",
                                        "entry_id": "94701d77-47ac-3a50-9a0b-64ba54ee1cde",
                                        "glosses": [
                                            "L’introduction d’une instance, Le commencement d’une procédure à quelque tribunal."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ff63792-39e2-3291-adbc-03eb44ad3c58",
                                        "entry_id": "94701d77-47ac-3a50-9a0b-64ba54ee1cde",
                                        "glosses": [
                                            "Mise en place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a16c3597-8c36-47cf-8e17-f7ff8f45127d",
                                                "sense_id": "0ff63792-39e2-3291-adbc-03eb44ad3c58",
                                                "text": "Tout échange monétaire est délicat : il serait bon de faire coïncider l’introduction du saarmark, et plus encore l’introduction du franc, avec une amélioration des conditions matérielles et politiques de la vie sarroise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "add1dcdc-b9cb-3538-be12-0977296e062f",
                                        "entry_id": "94701d77-47ac-3a50-9a0b-64ba54ee1cde",
                                        "glosses": [
                                            "Action d’introduire quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "154c8497-39b6-41b9-89a9-53710215eca7",
                                                "sense_id": "add1dcdc-b9cb-3538-be12-0977296e062f",
                                                "text": "L’introduction d’un ambassadeur auprès du chef de l’état."
                                            },
                                            {
                                                "example_id": "98532353-95d2-4b27-8888-b96d131d4f17",
                                                "sense_id": "add1dcdc-b9cb-3538-be12-0977296e062f",
                                                "text": "Son introduction dans leur société ne doit pas vous surprendre."
                                            },
                                            {
                                                "example_id": "da8dcbfd-7ed4-4525-bdd3-dcf9e0338149",
                                                "sense_id": "add1dcdc-b9cb-3538-be12-0977296e062f",
                                                "text": "Donner à quelqu’un une lettre d’introduction auprès d’un grand personnage."
                                            },
                                            {
                                                "example_id": "310958b2-c3ad-4473-90b5-25780068fe30",
                                                "sense_id": "add1dcdc-b9cb-3538-be12-0977296e062f",
                                                "text": "Jérôme d’abord avait essayé de trouver du travail ; il s’était plusieurs fois rendu à Tunis et grâce à quelques lettres d’introduction qu’il s’était fait donner en France, et à l’appui de ses amis tunisiens, avait rencontré quelques fonctionnaires à l’Information, à la Radio, au Tourisme, à l’Éducation nationale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca492804-fcfb-391a-ade6-dd721653f661",
                                        "entry_id": "94701d77-47ac-3a50-9a0b-64ba54ee1cde",
                                        "glosses": [
                                            "Ce qui sert comme d’entrée, d’acheminement ou de préparation à une science, à une étude, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9133b05c-5cd2-4011-b9f4-bca0e4f01e58",
                                                "sense_id": "ca492804-fcfb-391a-ade6-dd721653f661",
                                                "text": "Introduction à la physique, à la géographie."
                                            },
                                            {
                                                "example_id": "0b9e665c-bfa4-4166-95a5-6160c1f0ee4e",
                                                "sense_id": "ca492804-fcfb-391a-ade6-dd721653f661",
                                                "text": "Introduction à la vie dévote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbcbe408-12d9-3502-914d-4a21edf96e07",
                                        "entry_id": "94701d77-47ac-3a50-9a0b-64ba54ee1cde",
                                        "glosses": [
                                            "Sorte d’avertissement explicatif qu’on met en tête d’un ouvrage."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28225ce6-76d5-4b24-aa4d-d791a3d6042f",
                                                "sense_id": "bbcbe408-12d9-3502-914d-4a21edf96e07",
                                                "text": "Armé d'un coupe-papier, tu sabres la liasse sous blister, survoles fébrilement l’introduction où Jean-Paul expose les mérites comparés des bétons bitumineux, des bétons autoplaçants, des bétons fibrés, des bétons précontraints, des bétons cyclopéens, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d365390f-a491-39e2-bc4b-dc110455cba0",
                                        "entry_id": "94701d77-47ac-3a50-9a0b-64ba54ee1cde",
                                        "glosses": [
                                            "Quelques accords, du prélude plus ou moins développé qui préparent, dans une œuvre symphonique, l’entrée du thème ; dans une œuvre lyrique, le lever du rideau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da441dcb-062d-4884-b30d-cb96bd4e0a14",
                                                "sense_id": "d365390f-a491-39e2-bc4b-dc110455cba0",
                                                "text": "L’introduction est une sorte de prélude qui se contente d’une seule idée mélodique."
                                            },
                                            {
                                                "example_id": "332920a3-0e88-4933-a8b1-8c359b9e19af",
                                                "sense_id": "d365390f-a491-39e2-bc4b-dc110455cba0",
                                                "text": "L’introduction de la Sonate pathétique."
                                            },
                                            {
                                                "example_id": "1e71a57d-937f-4138-b6c4-d7809a676f92",
                                                "sense_id": "d365390f-a491-39e2-bc4b-dc110455cba0",
                                                "text": "L’introduction de Roméo et Juliette."
                                            },
                                            {
                                                "example_id": "37c0bea0-2d25-4f7d-90d4-ec8c7f740b70",
                                                "sense_id": "d365390f-a491-39e2-bc4b-dc110455cba0",
                                                "text": "L’introduction de l’ouverture de Don Juan,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cb318fa-fdc6-3e7e-8fd3-249be056ff82",
                                        "entry_id": "94701d77-47ac-3a50-9a0b-64ba54ee1cde",
                                        "glosses": [
                                            "Premier paragraphe d’une rédaction ou dissertation."
                                        ],
