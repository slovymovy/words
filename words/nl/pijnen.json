{
    "word_family": [
        "pijn",
        "pijnlijk",
        "pijnigen",
        "pijnbank"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd49c6ad-892e-31fb-a16a-c4b98b446218",
                    "sense_definition": "leed toebrengen als straf",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "straffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tiran besloot de gevangenen te <w>pijnen</w> voor hun verzet tegen het regime.",
                            "target_lang_translations": {
                                "en": "The tyrant decided to <w>torture</w> the prisoners for their resistance against the regime.",
                                "zh": "暴君决定因囚犯对政权的抵抗而对他们进行<w>惩罚</w>。"
                            }
                        },
                        {
                            "text": "In vroeger tijden werden misdadigers vaak publiekelijk <w>gepijnd</w> als afschrikwekkend voorbeeld.",
                            "target_lang_translations": {
                                "en": "In earlier times, criminals were often publicly <w>tortured</w> as a deterrent.",
                                "zh": "过去，罪犯常被公开<w>施刑</w>以儆效尤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "straffen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Wordt tegenwoordig zelden in deze betekenis gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To inflict suffering as a form of punishment.",
                        "zh": "作为惩罚施加痛苦"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to punish",
                                "target_lang_sense_clarification": "general term for inflicting a penalty"
                            },
                            {
                                "target_lang_word": "to torment",
                                "target_lang_sense_clarification": "to cause severe physical or mental suffering"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惩罚",
                                "target_lang_sense_clarification": "指对过错进行处罚"
                            },
                            {
                                "target_lang_word": "施刑",
                                "target_lang_sense_clarification": "指执行刑罚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8663564a-e8d5-3fbc-83a4-f0302636909d",
                    "sense_definition": "lichamelijk kwellen om informatie of een bekentenis af te dwingen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "martelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vijand probeerde de spion te <w>pijnen</w> om de geheime codes te achterhalen.",
                            "target_lang_translations": {
                                "en": "The enemy tried to <w>torture</w> the spy to uncover the secret codes.",
                                "zh": "敌人试图<w>拷打</w>那名间谍以获取秘密代码。"
                            }
                        },
                        {
                            "text": "Het is internationaal verboden om krijgsgevangenen te <w>pijnen</w> tijdens een verhoor.",
                            "target_lang_translations": {
                                "en": "It is internationally prohibited to <w>torture</w> prisoners of war during an interrogation.",
                                "zh": "国际法禁止在审讯期间<w>折磨</w>战俘。"
                            }
                        }
                    ],
                    "synonyms": [
                        "folteren",
                        "martelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Verouderde term voor martelen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To physically torment someone to force a confession or information.",
                        "zh": "通过肉体折磨以获取信息或供词"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to torture",
                                "target_lang_sense_clarification": "the act of inflicting severe pain for information"
                            },
                            {
                                "target_lang_word": "to rack",
                                "target_lang_sense_clarification": "archaic term specifically referring to the use of a torture device"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拷打",
                                "target_lang_sense_clarification": "指通过拷问和殴打获取口供"
                            },
                            {
                                "target_lang_word": "折磨",
                                "target_lang_sense_clarification": "指使人在肉体上受苦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07002da5-cc93-3d0a-a284-71cda71d8fbe",
                    "sense_definition": "ernstig kwellen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "martelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De onzekerheid over zijn toekomst bleef hem innerlijk <w>pijnen</w>.",
                            "target_lang_translations": {
                                "en": "The uncertainty about his future continued to <w>torment</w> him internally.",
                                "zh": "对未来的不确定性持续在内心<w>折磨</w>着他。"
                            }
                        },
                        {
                            "text": "Zijn geweten bleef hem <w>pijnen</w> na de gemaakte fouten in het verleden.",
                            "target_lang_translations": {
                                "en": "His conscience continued to <w>torment</w> him after the mistakes made in the past.",
                                "zh": "过去犯下的错误让他内心持续受到良心的<w>煎熬</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literaire of verouderde vorm."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To cause severe mental or emotional distress.",
                        "zh": "使人感到极度痛苦或煎熬"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to torment",
                                "target_lang_sense_clarification": "to cause great mental suffering"
                            },
                            {
                                "target_lang_word": "to agonize",
                                "target_lang_sense_clarification": "to cause intense mental struggle or pain"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "折磨",
                                "target_lang_sense_clarification": "指精神上的痛苦煎熬"
                            },
                            {
                                "target_lang_word": "煎熬",
                                "target_lang_sense_clarification": "指内心受到长期的痛苦折磨"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}