                "senses": [
                    {
                        "sense_id": "b46bf561-8602-3382-a928-b2cc7cbbfc8b",
                        "entry_id": "1a8b4e0e-8e8e-3c65-ad38-79f82a2a56ce",
                        "glosses": [
                            "niet bekend; zonder dat men er zich bewust van is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "323b22f7-2d44-4224-88f7-174e72ef2e1b",
                                "sense_id": "b46bf561-8602-3382-a928-b2cc7cbbfc8b",
                                "text": "Het resulteerde na maanden hard werk in een document met onverwachte en ongeweten weetjes, bijzondere anekdotes en memorabele momenten van gelovigen aan hun kerk."
                            },
                            {
                                "example_id": "6a1680b8-7983-48ac-ad47-1b407371d882",
                                "sense_id": "b46bf561-8602-3382-a928-b2cc7cbbfc8b",
                                "text": "Het feitelijk gegeven ligt er dat veel embryo’s kort na de conceptie tenietgaan. Soms geweten, veelal ongeweten. Deze embryo’s -dan nog onbezield geacht- spelen in de belevings- en herinneringswereld van de man en vrouw veelal nauwelijks of helemaal geen rol. Ze zijn tenietgegaan. Hebben deze kort na de conceptie beëindigde -ik moet toch zeggen gestorven- embryo’s, wel een ziel? Zijn ze dus in feite mens geweest? Of worden ze pas later mens?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "906ed9e6-083c-4740-b96e-531d77addfd5",
                        "source_entry_id": "1a8b4e0e-8e8e-3c65-ad38-79f82a2a56ce",
                        "source_sense_id": "b46bf561-8602-3382-a928-b2cc7cbbfc8b",
                        "target_lang_word": "unknown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unknown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a5701e2-0dfe-309b-baba-5cfd3fcb5b72",
                                        "entry_id": "8015cf8c-752a-3678-9871-fc438f2a721e",
                                        "glosses": [
                                            "Not known; unidentified; not well known."
                                        ],
                                        "tags": [
                                            "postpositional",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f425a7a7-6680-44fe-9538-962b5e0cbd44",
                                                "sense_id": "1a5701e2-0dfe-309b-baba-5cfd3fcb5b72",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track. The three returned wondering and charmed with Mrs. Cooke; they were sure she had had no hand in the furnishing of that atrocious house."
                                            },
                                            {
                                                "example_id": "ef044ffc-84ff-4369-bd1f-59879256d649",
                                                "sense_id": "1a5701e2-0dfe-309b-baba-5cfd3fcb5b72",
                                                "text": "I suspect that this large and complex military railway system, shrouded in official secrecy for most of its operational life, remains unknown to many people."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unknown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da657c97-582b-3347-a0a7-61cb34fdd025",
                                        "entry_id": "cefa04e7-1144-3d81-88cd-2b1f6b010a7d",
                                        "glosses": [
                                            "A variable (usually x, y or z) whose value is to be found."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2665e531-b64e-3a2d-a963-18199ddc61ca",
                                        "entry_id": "cefa04e7-1144-3d81-88cd-2b1f6b010a7d",
                                        "glosses": [
                                            "Any thing, place, or situation about which nothing is known; an unknown fact or piece of information."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db1e7bef-c002-4731-8f1c-76cdd73b12b6",
                                                "sense_id": "2665e531-b64e-3a2d-a963-18199ddc61ca",
                                                "text": "Had God walked close beside her into the unknown?"
                                            },
                                            {
                                                "example_id": "502c1991-a3be-4c2b-81fb-f057e8817536",
                                                "sense_id": "2665e531-b64e-3a2d-a963-18199ddc61ca",
                                                "text": "I think I learned more from my family than they did from me in the brief idyllic time we spent together. None of them much more than a mile from home, they carried the aura of a close-knit community as a shield against against the unknown."
                                            },
                                            {
                                                "example_id": "7245f1f7-36d2-488d-8aad-31a7dea6634d",
                                                "sense_id": "2665e531-b64e-3a2d-a963-18199ddc61ca",
                                                "text": "As we know, There are known knowns. There are things we know we know. We also know There are known unknowns. That is to say We know there are some things We do not know."
                                            },
                                            {
                                                "example_id": "78becae2-c44c-4ea7-915d-84b9b871c9ba",
                                                "sense_id": "2665e531-b64e-3a2d-a963-18199ddc61ca",
                                                "text": "The other priority is getting people to respond well to interventions, especially changes to routine. This is one of the biggest unknowns in these scenarios, and yet compliance can be the most crucial factor in determining whether an intervention works."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68e5a63f-6b1d-352e-b178-3c261f2d0e48",
                                        "entry_id": "cefa04e7-1144-3d81-88cd-2b1f6b010a7d",
                                        "glosses": [
                                            "A person of no identity; a nonentity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd610cd1-2648-460d-b3d1-a4a0352c3bf7",
                                                "sense_id": "68e5a63f-6b1d-352e-b178-3c261f2d0e48",
                                                "text": "How does it feel, / how does it feel? / To be on your own, / with no direction home / A complete unknown, / like a rolling stone"
                                            },
                                            {
                                                "example_id": "0e343043-35b5-4366-9e2d-7a4f3118b926",
                                                "sense_id": "68e5a63f-6b1d-352e-b178-3c261f2d0e48",
                                                "text": "Khaleque, the landowner, who had contributed most of the money needed to transform the neglected burial-place of an unknown into a mazar, masked his pride and pleasure with difficulty. He solemnly declared: ‘Perhaps now we shall be forgiven for neglecting the saint all these years.’"
                                            }
                                        ]
                                    }
                                ]
