{
    "word_family": [
        "spiritual",
        "spiritually",
        "spiritualism",
        "spiritualist",
        "spiritualize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4b150e4-f7e3-377b-97fc-242551cf6154",
                    "sense_definition": "Concern for that which is unseen and intangible, as opposed to physical or mundane matters.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "inner_life",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people find that <w>spirituality</w> helps them cope with the stresses of modern life.",
                            "target_lang_translations": {
                                "ru": "Многие люди находят, что <w>духовность</w> помогает им справляться со стрессами современной жизни."
                            }
                        },
                        {
                            "text": "Her deep <w>spirituality</w> is reflected in the way she treats every living being with kindness.",
                            "target_lang_translations": {
                                "ru": "Ее глубокая <w>духовность</w> отражается в том, как по-доброму она относится ко всему живому."
                            }
                        }
                    ],
                    "synonyms": [
                        "immateriality"
                    ],
                    "antonyms": [
                        "materialism"
                    ],
                    "common_phrases": [
                        "deep spirituality",
                        "personal spirituality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Интерес к невидимому и нематериальному в противовес физическим или обыденным вещам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "духовность",
                                "target_lang_sense_clarification": "внутренний мир и ценности"
                            },
                            {
                                "target_lang_word": "нематериальность",
                                "target_lang_sense_clarification": "отсутствие физической формы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81dda6ef-fb40-3934-8fe4-abdf2468c2d2",
                    "sense_definition": "The quality of having an appreciation for religious values or a connection to the divine.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "inner_life",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monastery is a place where one can focus entirely on prayer and <w>spirituality</w>.",
                            "target_lang_translations": {
                                "ru": "Монастырь — это место, где можно полностью сосредоточиться на молитве и <w>духовности</w>."
                            }
                        },
                        {
                            "text": "The author explores the intersection of <w>spirituality</w> and organized religion in his latest book.",
                            "target_lang_translations": {
                                "ru": "В своей последней книге автор исследует пересечение <w>духовности</w> и организованной религии."
                            }
                        }
                    ],
                    "synonyms": [
                        "religiousness",
                        "piety"
                    ],
                    "common_phrases": [
                        "religious spirituality",
                        "growth in spirituality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, выражающееся в признании религиозных ценностей или связи с божественным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "духовность",
                                "target_lang_sense_clarification": "религиозный аспект"
                            },
                            {
                                "target_lang_word": "религиозность",
                                "target_lang_sense_clarification": "вера и благочестие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f74d972f-cfd6-3719-97d2-28dc9ea2c851",
                    "sense_definition": "The quality or state of being <w>spiritual</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inner_life",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that the <w>spirituality</w> of the soul is what distinguishes humans from animals.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что именно <w>духовность</w> души отличает людей от животных."
                            }
                        },
                        {
                            "text": "The music possessed a haunting <w>spirituality</w> that moved the entire audience to tears.",
                            "target_lang_translations": {
                                "ru": "Музыка обладала пронзительной <w>одухотворенностью</w>, которая растрогала до слез всех слушателей."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "inherent spirituality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние бытия духовным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "духовность",
                                "target_lang_sense_clarification": "свойство души или явления"
                            },
                            {
                                "target_lang_word": "одухотворенность",
                                "target_lang_sense_clarification": "возвышенность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db63e15d-49fe-3d4e-b4af-f92ae6ae2a49",
                    "sense_definition": "An ecclesiastical body or the whole body of the clergy, as distinct from secular society.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ecclesiastical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historically, the <w>spirituality</w> held significant political power alongside the nobility.",
                            "target_lang_translations": {
                                "ru": "Исторически <w>духовенство</w> обладало значительной политической властью наряду с дворянством."
                            }
                        },
                        {
                            "text": "The king sought a subsidy from the <w>spirituality</w> to fund his upcoming campaign.",
                            "target_lang_translations": {
                                "ru": "Король просил субсидию у <w>духовенства</w> для финансирования своей предстоящей кампании."
                            }
                        }
                    ],
                    "synonyms": [
                        "clergy"
                    ],
                    "common_phrases": [
                        "the spirituality"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or formal ecclesiastical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Церковная организация или духовенство в целом, в отличие от светского общества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "духовенство",
                                "target_lang_sense_clarification": "сословие служителей церкви"
                            },
                            {
                                "target_lang_word": "клир",
                                "target_lang_sense_clarification": "совокупность священнослужителей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3766b159-1b6f-3362-a1bb-62f4a855204f",
                    "sense_definition": "Property or rights belonging to the church or an ecclesiastic, as distinct from temporal possessions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ecclesiastical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archbishop acted as the guardian of the <w>spiritualities</w> during the vacancy of the see.",
                            "target_lang_translations": {
                                "ru": "Архиепископ исполнял обязанности хранителя <w>церковного имущества</w> в период, когда кафедра оставалась вакантной."
                            }
                        },
                        {
                            "text": "The legal dispute concerned the distribution of the <w>spiritualities</w> within the diocese.",
                            "target_lang_translations": {
                                "ru": "Судебный спор касался распределения <w>церковных прав и доходов</w> внутри епархии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "guardian of the spiritualities"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "specifically refers to historical church law or property"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имущество или права, принадлежащие церкви или духовному лицу, в отличие от светских владений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "церковное имущество",
                                "target_lang_sense_clarification": "права и владения церкви"
                            },
                            {
                                "target_lang_word": "духовные дела",
                                "target_lang_sense_clarification": "сфера церковного управления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}