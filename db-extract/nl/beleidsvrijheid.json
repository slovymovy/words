                        "glosses": [
                            "vrijheid van een bestuursorgaan om — na afweging van belangen — af te zien van het gebruik van een bepaalde bevoegdheid, bijvoorbeeld door te besluiten geen vergunning te verlenen; situatie waarin de wet niet voorschrijft wanneer een bevoegdheid tot een bepaalde rechtshandeling van een bestuursorgaan moet leiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
