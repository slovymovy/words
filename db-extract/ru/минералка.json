                                        "sense_id": "33d34992-228b-3636-a35d-4d9c845ee259",
                                        "entry_id": "7fc8be63-8da2-3ee9-9ee5-e00f36eb2eb7",
                                        "glosses": [
                                            "Carbonated water (water impregnated with pressurised carbon dioxide, originally made with sodium bicarbonate)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "034048f2-92bc-4748-80e8-e1263fcf5791",
                                                "sense_id": "33d34992-228b-3636-a35d-4d9c845ee259",
                                                "text": "A waiter brought his aperitif, which was a small scotch and soda, and as he sipped it gratefully he sighed.\n ‘Civilized,’ he said to Mr. Campion. ‘Humanizing.’ […] ‘Cigars and summer days and women in big hats with swansdown face-powder, that's what it reminds me of.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d46710e-92fd-3900-9499-ea2a2984ab49",
                                        "entry_id": "7fc8be63-8da2-3ee9-9ee5-e00f36eb2eb7",
                                        "glosses": [
                                            "Any carbonated (usually sweet) soft drink."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d005267-682d-4b21-88dd-443be1e48677",
                                                "sense_id": "4d46710e-92fd-3900-9499-ea2a2984ab49",
                                                "text": "Should Americans on food assistance be able to use that money on soda? Starting in 2026, the answer in six states will be no. At least six others have proposed similar restrictions, and some states are also disallowing candy purchases."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838bab0d-1421-37f8-bff8-43df1c63902a",
                                        "entry_id": "7fc8be63-8da2-3ee9-9ee5-e00f36eb2eb7",
                                        "glosses": [
                                            "A glass, bottle or can of this drink."
