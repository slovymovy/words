{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2aa01359-4e7a-3dfb-812f-69afda627046",
                    "sense_definition": "A donkey or ass.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old farmer led his tired <w>neddy</w> down the dirt path to the barn.",
                            "target_lang_translations": {
                                "ru": "Старый фермер вёл своего уставшего <w>ослика</w> по грунтовой тропинке к амбару."
                            }
                        },
                        {
                            "text": "They bought a stubborn <w>neddy</w> to help carry supplies up the mountain.",
                            "target_lang_translations": {
                                "ru": "Они купили упрямого <w>осла</w>, чтобы тот помогал таскать припасы в гору."
                            }
                        }
                    ],
                    "synonyms": [
                        "donkey",
                        "ass"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally for a donkey"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Осёл или ослик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ослик",
                                "target_lang_sense_clarification": "разговорное название осла"
                            },
                            {
                                "target_lang_word": "осёл",
                                "target_lang_sense_clarification": "животное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01eed3bb-8253-3a00-bc09-c53b2cf01547",
                    "sense_definition": "A horse, especially a racehorse.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long ride through the bush, he tied his <w>neddy</w> to a tree.",
                            "target_lang_translations": {
                                "ru": "После долгой поездки по бушу он привязал своего <w>коня</w> к дереву."
                            }
                        },
                        {
                            "text": "He placed a small bet on a fast <w>neddy</w> during the weekend races.",
                            "target_lang_translations": {
                                "ru": "Он сделал небольшую ставку на быструю <w>лошадку</w> во время выходных скачек."
                            }
                        }
                    ],
                    "synonyms": [
                        "horse",
                        "racehorse"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "principally Australian informal usage"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for a horse"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лошадь, особенно скаковая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лошадка",
                                "target_lang_sense_clarification": "разговорное название лошади"
                            },
                            {
                                "target_lang_word": "конь",
                                "target_lang_sense_clarification": "скаковая или ездовая лошадь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5785a6e-b2e6-3495-b4d0-139058b71462",
                    "sense_definition": "Horse racing or the horse races.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They love to bet on the <w>neddies</w> every Saturday afternoon at the local pub.",
                            "target_lang_translations": {
                                "ru": "Каждую субботу днем в местном пабе они любят ставить на <w>скачки</w>."
                            }
                        },
                        {
                            "text": "We spent the whole weekend drinking beer and talking about the <w>neddies</w>.",
                            "target_lang_translations": {
                                "ru": "Мы провели все выходные, пили пиво и разговаривали о <w>бегах</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bet on the neddies"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "principally Australian slang"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "slang for horse racing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скачки или лошадиные бега."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скачки",
                                "target_lang_sense_clarification": "соревнования и бега"
                            },
                            {
                                "target_lang_word": "бега",
                                "target_lang_sense_clarification": "конные соревнования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d0a5363-e53b-3be9-8ca6-8a7fc6f7b0ba",
                    "sense_definition": "A foolish, stupid, or incompetent person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some <w>neddy</w> in the government department rejected our application without reading it.",
                            "target_lang_translations": {
                                "ru": "Какой-то <w>болван</w> из министерства отклонил нашу заявку, даже не прочитав её."
                            }
                        },
                        {
                            "text": "He got angry and called the committee members a bunch of stupid <w>neddies</w>.",
                            "target_lang_translations": {
                                "ru": "Он разозлился и назвал членов комитета кучкой глупых <w>дурачков</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "idiot",
                        "fool"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый, дурной или некомпетентный человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурачок",
                                "target_lang_sense_clarification": "глупый человек"
                            },
                            {
                                "target_lang_word": "болван",
                                "target_lang_sense_clarification": "олух, бестолковый человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2ccfc68-e586-3e3b-a21a-23f20befe3be",
                    "sense_definition": "Horsepower, especially in relation to vehicle engine performance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You will need a lot more <w>neddies</w> under the hood to win this race.",
                            "target_lang_translations": {
                                "ru": "Тебе понадобится куда больше <w>лошадок</w> под капотом, чтобы выиграть эту гонку."
                            }
                        },
                        {
                            "text": "The car struggled uphill because it just lacked the necessary <w>neddies</w>.",
                            "target_lang_translations": {
                                "ru": "Машина с трудом ехала в гору, потому что ей просто не хватало нужных <w>лошадиных сил</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "horsepower"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "automotive slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лошадиные силы, мощность двигателя автомобиля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лошадиные силы",
                                "target_lang_sense_clarification": "мощность мотора"
                            },
                            {
                                "target_lang_word": "лошадки",
                                "target_lang_sense_clarification": "разговорно о мощности двигателя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "071acf46-be49-3a76-a211-8b53ac322ff4",
                    "sense_definition": "Alternative form of <w>netty</w>: an outdoor toilet, outhouse, or lavatory.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old cottage had no indoor plumbing, only a small <w>neddy</w> in the backyard.",
                            "target_lang_translations": {
                                "ru": "В старом коттедже не было водопровода, только маленький <w>нужник</w> на заднем дворе."
                            }
                        },
                        {
                            "text": "He walked out into the cold night air to use the wooden <w>neddy</w>.",
                            "target_lang_translations": {
                                "ru": "Он вышел на холодный ночной воздух, чтобы сходить в деревянный <w>сортир</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "outhouse",
                        "lavatory",
                        "toilet"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional English dialect form of netty"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уличный туалет, уборная или нужник (диалектизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нужник",
                                "target_lang_sense_clarification": "дворовый туалет"
                            },
                            {
                                "target_lang_word": "сортир",
                                "target_lang_sense_clarification": "просторечное наименование туалета"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cd4c06eb-1bb3-347c-8ebb-bc64823be3f3",
                    "sense_definition": "A male given name, used as a familiar diminutive of Edward.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Little <w>Neddy</w> ran outside to play as soon as his father arrived home.",
                            "target_lang_translations": {
                                "ru": "Маленький <w>Недди</w> выбежал поиграть на улицу, как только его отец вернулся домой."
                            }
                        },
                        {
                            "text": "Everyone called him <w>Neddy</w> when he was a young boy in school.",
                            "target_lang_translations": {
                                "ru": "Все звали его <w>Недди</w>, когда он был маленьким мальчиком в школе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "diminutive name form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя, уменьшительно-ласкательная форма от Эдвард."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Недди",
                                "target_lang_sense_clarification": "уменьшительное от Эдвард"
                            }
                        ]
                    }
                }
            ]
        }
    ]
