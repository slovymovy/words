                        "entry_id": "1388d1fd-91e5-38eb-bbda-7d15c3266772",
                        "glosses": [
                            "Region in Nordfrankreich, die für die Herstellung des Champagners bekannt ist"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "2a6c44da-dae3-4a43-894e-29f1675c7b94",
                                "sense_id": "2fc13923-9e80-3cdd-8c73-ae26dcf3e99c",
                                "text": "„Nahezu 1.500 Millionen Flaschen lagern in den eindrucksvollen Kelleranlagen der Champagne.“"
                            },
                            {
                                "example_id": "e670c815-4874-4c9b-a494-189a7c2e24cf",
                                "sense_id": "2fc13923-9e80-3cdd-8c73-ae26dcf3e99c",
                                "text": "„Eigentlich ist die Champagne ja berühmt für Champagner, aber Jean stellte aus seinen eigenen, für die Region typischen Pinot-Noir-Trauben aus Trotz lieber Rotwein her.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
