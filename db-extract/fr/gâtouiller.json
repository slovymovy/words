                ],
                "senses": [
                    {
                        "sense_id": "1a683bfc-d6b6-38f0-9dfd-50b27153e8fb",
                        "entry_id": "bb30e138-16af-3139-b3c4-f6cee1bd77b2",
                        "glosses": [
                            "Gagatiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2e3c1d4-c561-4f8d-883e-5c5b4df7efc6",
                                "sense_id": "1a683bfc-d6b6-38f0-9dfd-50b27153e8fb",
                                "text": "Avec leurs grands yeux expressifs, leur pelage tout doux, leur grâce naturelle, les minets font gâtouiller mais pas seulement."
                            },
                            {
                                "example_id": "490e655d-4d31-42e3-b3a3-9e66321c6d90",
                                "sense_id": "1a683bfc-d6b6-38f0-9dfd-50b27153e8fb",
                                "text": "C’est quand même terrible de gâtouiller au point de faire des comparaisons historiques pareilles."
                            },
                            {
                                "example_id": "cf431219-d869-4c86-ba9e-ae5923a60101",
                                "sense_id": "1a683bfc-d6b6-38f0-9dfd-50b27153e8fb",
                                "text": "Franchement, il faut arrêter de gâtouiller sur les moutons, ces boules de laine soi-disant toutes mimi…"
                            },
                            {
                                "example_id": "4a4b4af0-dda3-4d26-8720-1eab3147f443",
                                "sense_id": "1a683bfc-d6b6-38f0-9dfd-50b27153e8fb",
                                "text": "Houlà, il gâtouille à fond le vieux… ça promet pour l’avenir."
                            },
                            {
                                "example_id": "589388e5-0abe-464b-9a43-1b36f993bcad",
                                "sense_id": "1a683bfc-d6b6-38f0-9dfd-50b27153e8fb",
                                "text": "Je répète mon âge… 1894 !… je rabâche ?… je gâtouille ?… j'ai le droit ! tous les gens qui sont de l’autre siècle ont le droit de rabâcher !"
                            }
                        ]
                    }
                ],
