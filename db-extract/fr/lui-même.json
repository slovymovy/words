                                            {
                                                "example_id": "5830220c-fbf0-442e-83c8-28f233cf8a5c",
                                                "sense_id": "4894999e-8ef8-30b9-90bf-f2b04363dbae",
                                                "text": "自分をもっと出していい。"
                                            },
                                            {
                                                "example_id": "48df8d43-df4a-478d-9239-13af866c65b4",
                                                "sense_id": "4894999e-8ef8-30b9-90bf-f2b04363dbae",
                                                "text": "自分の小ささを自覚する。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4ae1fed-45b0-32fd-8152-09d379cdabd0",
                                        "entry_id": "3098ef7c-f295-399e-b6f0-b67859e012dc",
                                        "glosses": [
                                            "（反射指示代名詞）その人自身、自己。他者でない人。",
                                            "自意識。自己の判断やかんがえ。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d578c437-f269-44e4-af53-09ac13367e37",
                                                "sense_id": "d4ae1fed-45b0-32fd-8152-09d379cdabd0",
                                                "text": "自分の中の悪魔がささやく。"
                                            },
                                            {
                                                "example_id": "82eecdc2-d211-4600-9796-766244e84abb",
                                                "sense_id": "d4ae1fed-45b0-32fd-8152-09d379cdabd0",
                                                "text": "その人は自分の中でとても大きい存在だ。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f61b2bbe-0ba5-3939-b3a5-a12d60b10d02",
                                        "entry_id": "3098ef7c-f295-399e-b6f0-b67859e012dc",
                                        "glosses": [
                                            "（反射指示代名詞）その人自身、自己。他者でない人。",
                                            "自己の実力。能力。本来の力。"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc873d5-bc6a-4d42-b29b-95d7013c6345",
                                                "sense_id": "f61b2bbe-0ba5-3939-b3a5-a12d60b10d02",
                                                "text": "いまの自分では勝てない相手だ。"
                                            },
                                            {
                                                "example_id": "6daf7d2f-2bf2-41e3-8bb4-711df9806998",
                                                "sense_id": "f61b2bbe-0ba5-3939-b3a5-a12d60b10d02",
                                                "text": "自分に足りないものを補う。"
                                            },
                                            {
                                                "example_id": "4d951504-168b-4bef-9940-0e2394ce6e22",
                                                "sense_id": "f61b2bbe-0ba5-3939-b3a5-a12d60b10d02",
                                                "text": "自分のスイングができれば打てるはずだ。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "472d53dc-f83a-3b9e-9f77-dcaa63a25ea6",
                                        "entry_id": "3098ef7c-f295-399e-b6f0-b67859e012dc",
                                        "glosses": [
                                            "（軍隊用語、学生用語。第一人称）私。"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abb6499d-c841-39c1-af52-6d6265fb6722",
                                        "entry_id": "3098ef7c-f295-399e-b6f0-b67859e012dc",
                                        "glosses": [
                                            "（関西地方などの方言。第二人称、同格または目下に対して）おまえ、あんた。"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73da9e1e-7d02-4744-ae30-92ef0df7a64b",
                        "source_entry_id": "647eb4c0-5f5d-3c21-8574-3daca3fac627",
                        "target_lang_word": "hemzelf",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hemzelf",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8e5f6539-8bdf-3432-b1cc-c6f11af4b9e1",
                                        "entry_id": "cd6fdeae-f55a-3271-aaac-1c7f2a9f2fb5",
                                        "glosses": [
                                            "derde persoon enkelvoud, versterkte vorm van hem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b58d0e2-9fd2-4dfa-bf56-49e655fe8b31",
                                                "sense_id": "8e5f6539-8bdf-3432-b1cc-c6f11af4b9e1",
                                                "text": "Ik raad jullie af, om hemzelf te gaan zoeken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d288d245-3fd7-499a-afba-1e08d2126924",
                        "source_entry_id": "647eb4c0-5f5d-3c21-8574-3daca3fac627",
                        "target_lang_word": "ele mesmo",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3e5a3981-9fb4-4883-bce9-87a49bf3c257",
                        "source_entry_id": "647eb4c0-5f5d-3c21-8574-3daca3fac627",
                        "target_lang_word": "сам",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сам",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "543cbfa0-4edc-3b82-978e-8423d7d2d765",
                                        "entry_id": "dd4d5139-d351-3f28-aead-b1ac16b0a997",
                                        "glosses": [
                                            ": воплощающий какие-либо качества, свойства"
                                        ],
                                        "tags": [
                                            "в знач. прилагательного"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8fb5582-41f1-40a8-9112-a11c53933df6",
                                                "sense_id": "543cbfa0-4edc-3b82-978e-8423d7d2d765",
                                                "text": "И когда приехали на пикник в лес, я была сама кротость, само лукавство и обаяние."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf8d0ee-b44a-3f0e-8552-ff84b5d88acf",
                                        "entry_id": "dd4d5139-d351-3f28-aead-b1ac16b0a997",
                                        "glosses": [
                                            "лично, без посторонней помощи; собственными силами и средствами"
                                        ],
                                        "tags": [
                                            "в знач. наречия"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ac4cdd0-9d4c-4c90-b06b-2eb98c36b217",
                                                "sense_id": "adf8d0ee-b44a-3f0e-8552-ff84b5d88acf",
                                                "text": "Сам же к нам навязался в товарищи, неведомо кто, неведомо откуда, — да ещё и спесивится."
                                            },
                                            {
                                                "example_id": "a00fbc96-8379-400b-bc05-dbb226e10294",
                                                "sense_id": "adf8d0ee-b44a-3f0e-8552-ff84b5d88acf",
                                                "text": "Наследники отыщутся сами."
                                            },
                                            {
                                                "example_id": "53544466-f8d4-49b2-aa7d-d1588ad65375",
                                                "sense_id": "adf8d0ee-b44a-3f0e-8552-ff84b5d88acf",
                                                "text": "Все прививки я делаю сам, обрезку — сам, посадки — сам, всё — сам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8668fd4-02b0-3bcb-8de4-a3ee56624e8f",
                                        "entry_id": "dd4d5139-d351-3f28-aead-b1ac16b0a997",
                                        "glosses": [
                                            ": по личной инициативе, без требования со стороны"
                                        ],
                                        "tags": [
                                            "в знач. наречия"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f6ba1ca-8181-4eb3-ad82-78a43260213e",
                                                "sense_id": "c8668fd4-02b0-3bcb-8de4-a3ee56624e8f",
                                                "text": "Человек свободен… он за всё платит сам: за веру, за неверие, за любовь, за ум."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "667fb29c-0f63-3c6b-8356-0ab1f4c11113",
                                        "entry_id": "dd4d5139-d351-3f28-aead-b1ac16b0a997",
                                        "glosses": [
                                            "непроизвольно, невольно"
                                        ],
                                        "tags": [
                                            "в знач. наречия"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9baad09a-5a89-43ac-bd8c-4c888a73ffaf",
                                                "sense_id": "667fb29c-0f63-3c6b-8356-0ab1f4c11113",
                                                "text": "Рука сама тянется за гармошкой — и сама отдёргивается."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c05630a8-6207-3010-aba9-cf5c46cc7ef7",
                                        "entry_id": "dd4d5139-d351-3f28-aead-b1ac16b0a997",
                                        "glosses": [
                                            "разг., субстантивир. руководитель, хозяин, главный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b1c4df9-7583-43dc-9643-daf02e1f3547",
                                                "sense_id": "c05630a8-6207-3010-aba9-cf5c46cc7ef7",
                                                "text": "После обеда подойдёт сам и завизирует вашу заявку."
                                            },
                                            {
                                                "example_id": "9ae40329-47d2-4545-aa0e-0f56f327463b",
                                                "sense_id": "c05630a8-6207-3010-aba9-cf5c46cc7ef7",
                                                "text": "Затем появился «сам» — начальник тюрьмы, пожилой, полный, в большой серой бороде, расчёсанной на две стороны."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
