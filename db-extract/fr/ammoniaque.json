                                                "sense_id": "c4e8e56a-b35f-3782-b7b2-c1a1c9029f77",
                                                "text": "Never use ammonia to clean metal writing pens."
                                            },
                                            {
                                                "example_id": "b0ecc54b-6b3e-4e84-9310-2c0c0462039c",
                                                "sense_id": "c4e8e56a-b35f-3782-b7b2-c1a1c9029f77",
                                                "text": "Slowly we rode down to the camp - a very sorrowful party. We took \"Nep\" straight to the surgery, where the doctor instantly applied injections of ammonia, then the new remedy for snake bite."
                                            },
                                            {
                                                "example_id": "6625e744-e2e9-46f2-8827-6df9e713911f",
                                                "sense_id": "c4e8e56a-b35f-3782-b7b2-c1a1c9029f77",
                                                "text": "When the woman pressed charges against the man who beat her up and threatened her, the man's girlfriend approached her after work and threw a bottle of ammonia at her."
                                            }
