        "fr-extract.jsonl": [
            {
                "entry_id": "3f1e6f76-806e-3ae2-8ace-c7cb80c8f2fd",
                "word": "déclive",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6f2fa1d-34e5-4300-a935-59f31a88e798",
                        "entry_id": "3f1e6f76-806e-3ae2-8ace-c7cb80c8f2fd",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "déclives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54f5abea-c9e1-3feb-a963-1bce20d91a6e",
                        "entry_id": "3f1e6f76-806e-3ae2-8ace-c7cb80c8f2fd",
                        "glosses": [
                            "Qui va en pente ; qui est incliné."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c9240fb8-869b-440a-ae2d-f4505c85ff8a",
                                "sense_id": "54f5abea-c9e1-3feb-a963-1bce20d91a6e",
                                "text": "On parvenait chez l’accusateur public au moyen d’un passage obscur et déclive."
                            },
                            {
                                "example_id": "fe37fd86-0f59-4747-9ff7-56c0ef975d65",
                                "sense_id": "54f5abea-c9e1-3feb-a963-1bce20d91a6e",
                                "text": "Aussi, lorsque, après avoir franchi une porte vitrée immense, donnant sur un vestibule un peu moins vaste que le Square du temple, nous nous engageâmes dans un large escalier aux marches déclives, usées et traîtresses, mais qu’une rampe remarquablement ciselée aidait à gravir sans péril, je me contentai, toujours prudent, d’admirer l’élégante rampe en silence."
                            },
                            {
                                "example_id": "867a4be4-68ef-410d-b0fc-ca34dc40b300",
                                "sense_id": "54f5abea-c9e1-3feb-a963-1bce20d91a6e",
                                "text": "La place fatale formait une sorte de triangle entre plusieurs blocs erratiques, posés comme pour une embuscade dans cette clairière déclive."
                            },
                            {
                                "example_id": "8b82c477-4d4f-4ac7-8d1c-95af6abaa4cc",
                                "sense_id": "54f5abea-c9e1-3feb-a963-1bce20d91a6e",
                                "text": "Comme la pièce était longue et déclive, tous les degrés de la pénombre s’y succédaient jusqu’aux angles du fond, où quelque reste de la nuit passée semblait attendre la nuit prochaine."
                            },
                            {
                                "example_id": "4618e1b5-bf13-4228-9df3-9367b1c11711",
                                "sense_id": "54f5abea-c9e1-3feb-a963-1bce20d91a6e",
                                "text": "Devant eux, couchée sur un chariot posé lui-même sur des rails, une fusée emplissait presque toute la salle déclive, sa pointe dirigée vers une porte de béton et d’acier."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea2f2487-411d-3098-80a4-b75b166776b9",
                        "entry_id": "3f1e6f76-806e-3ae2-8ace-c7cb80c8f2fd",
                        "glosses": [
                            "Se dit du point le plus bas du corps, d'une partie du corps, d'un organe mais aussi de la partie la plus basse d'une plaie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3780515e-b8b1-4aa4-8e52-9ed2b10f3a4c",
                                "sense_id": "ea2f2487-411d-3098-80a4-b75b166776b9",
                                "text": "Si l'agonie n'a pas été longue, la portion des poumons qui était la plus déclive au moment du refroidissement du cadavre, sera engorgée ; …. — (François Jean Matthyssens, Précis élémentaire de médecine légale , Éd. Vve Heirstraeten, Anvers 1837)"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "94991483-c1eb-31af-b833-406789ba50d4",
                "word": "déclive",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fa6333be-6eb7-4781-89d9-555df82f38d4",
                        "entry_id": "94991483-c1eb-31af-b833-406789ba50d4",
                        "tags": [
