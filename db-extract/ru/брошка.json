                                    {
                                        "sense_id": "f0cf1027-85de-3bc1-90d7-2d6d1c845934",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Partie tournante (portant un mandrin, une pointe de tour, une fraise, etc.) d’une machine-outil, servant à usiner un trou dans une pièce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b6537fb-e888-3b5e-8602-ecdcc0bfa744",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Aiguille à tricoter."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "108cd09e-6fbd-4c8c-bf9a-0d0179a5daaf",
                                                "sense_id": "6b6537fb-e888-3b5e-8602-ecdcc0bfa744",
                                                "text": "Broches à tricoter."
                                            },
                                            {
                                                "example_id": "34293f5a-09d0-432f-857a-8df078c568e0",
                                                "sense_id": "6b6537fb-e888-3b5e-8602-ecdcc0bfa744",
                                                "text": "Elle les voulait aussi heureux que s’ils avaient eu leur mère. Sa tendresse la rendait adroite et inventive. Elle, qui ne savait tricoter qu’aux broches, avait appris un point de crochet et leur avait fait à chacun, pour l’hiver, un joli manteau de laine bleue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c9533f0-bc78-3976-b118-14397184cce9",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Éperon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b4ce5c4-78d4-3e34-a966-d41fa40ca369",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Bijou muni d’une longue épingle et d’un fermoir, servant à attacher un châle, un col, ou à garnir un corsage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91463243-7104-4d36-bcb0-924b3c7d0175",
                                                "sense_id": "1b4ce5c4-78d4-3e34-a966-d41fa40ca369",
                                                "text": "Une broche de diamants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89986370-1eb0-36ec-86ba-0a7782c8745b",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Fil de fer, parfois d'autres métaux."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d9fc198-38b5-443a-b03e-43edcb7ddcf1",
                                                "sense_id": "89986370-1eb0-36ec-86ba-0a7782c8745b",
                                                "text": "L’État fédéral, c’est la broche qui tient les morceaux du Canada ensemble."
                                            },
                                            {
                                                "example_id": "63351978-fae2-49ae-b145-4a489384f84b",
                                                "sense_id": "89986370-1eb0-36ec-86ba-0a7782c8745b",
                                                "text": "Fixer avec de la broche."
                                            },
                                            {
                                                "example_id": "4111bc8f-1a6a-4b08-a175-9b3b9094d9b6",
                                                "sense_id": "89986370-1eb0-36ec-86ba-0a7782c8745b",
                                                "text": "D'la broche de brass, ça fait pareil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "336d85aa-39ff-38fc-8567-cd4f90bc2998",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Fil de fer, parfois d'autres métaux.",
                                            "Agrafe."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bd076dc-4255-4adc-81ec-fb74f10a5bac",
                                                "sense_id": "336d85aa-39ff-38fc-8567-cd4f90bc2998",
                                                "text": "Le lieutenant passa l'extrémité de sa lame sous une agrafe plantée sous un des souliers du défunt […]. La broche, comme on dit au Québec, retenait encore une minuscule étiquette que Larouche ramena dans la paume de sa main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043fd1fb-a170-3a2a-ba6d-1940f1801127",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Au pluriel : défenses du sanglier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcfbc3e7-0f29-4d46-a61c-3492dca1a519",
                                                "sense_id": "043fd1fb-a170-3a2a-ba6d-1940f1801127",
                                                "text": "Les broches du sanglier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61ed0a8d-55df-3be5-84e9-fc3ff430a470",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Au pluriel : premiers bois du chevreuil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a5a54a7-5c69-405e-b787-46310c179b65",
                                                "sense_id": "61ed0a8d-55df-3be5-84e9-fc3ff430a470",
                                                "text": "C’est bien plutôt des chevreuils que vient le danger, car la fougue d’un jeune brocard ne recule pas devant la masse d’un grand cerf, et ses broches peuvent lui infliger des blessures irréparables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f26362c6-f1aa-35ad-9448-2984ea160873",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
