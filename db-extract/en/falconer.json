                    {
                        "translation_id": "404938df-ea38-4400-a2e4-6c64b816267d",
                        "source_entry_id": "a114f1d1-acce-3df3-858c-72696cdd5034",
                        "source_sense_description": "a person who breeds or trains hawks",
                        "target_lang_word": "fauconnier",
                        "target_lang_code": "fr",
