                                        "examples": [
                                            {
                                                "example_id": "ec60b759-1acb-483b-94b8-98a7fec1497c",
                                                "sense_id": "90113b14-c5d5-3c06-ad53-f051c9320640",
                                                "text": "Ο αέρας του βουνού σε ανανεώνει"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5f4ea17-dfae-3152-82ae-8ea9af9582d1",
                                        "entry_id": "fed44a5c-4a84-3274-9f49-657b2dc0ce24",
                                        "glosses": [
                                            "η επιβεβαίωση μιας υπόσχεσης εκ νέου, σε συμπεφωνημένα τακτά χρονικά διαστήματα, η παράταση"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ed6cd6f-5004-44a8-b427-6807611c8314",
                                                "sense_id": "f5f4ea17-dfae-3152-82ae-8ea9af9582d1",
                                                "text": "Δεν κάναμε ακόμα ανανέωση στο συμβόλαιο του σπιτιού"
                                            },
                                            {
                                                "example_id": "086fc046-1cc5-487d-a050-92a489d3403d",
                                                "sense_id": "f5f4ea17-dfae-3152-82ae-8ea9af9582d1",
                                                "text": "Το διαβατήριο/η άδεια οδηγησης/το συμβόλαιο της ασφαλιστικής χρειάζεται ανανέωση"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "523dc852-e26f-38e8-b2e4-9e80d15acd06",
                                        "entry_id": "fed44a5c-4a84-3274-9f49-657b2dc0ce24",
                                        "glosses": [
                                            "αντικατάσταση του παλιού με ένα νέο, φρέσκο, καινούργιο, μοντέρνο"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1b2cd62-e972-427b-81d7-cff63061eec8",
                                                "sense_id": "523dc852-e26f-38e8-b2e4-9e80d15acd06",
                                                "text": "Ανοιξε τα παράθυρα γιατί ο αέρας εδώ μέσα χρειάζεται και λίγη ανανέωση με τόσα τσιγάρα που καπνίζουμε"
                                            },
                                            {
                                                "example_id": "19d79094-58f1-4b81-b2e3-ac778d71a6da",
                                                "sense_id": "523dc852-e26f-38e8-b2e4-9e80d15acd06",
                                                "text": "Το σαλόνι χρειάζεται ανανέωση. Μόλις βρούμε λεφτά να βάλουμε ένα πιο μοντέρνο καναπέ, να πάρουμε άλλο χαλί και να πετάξουμε επιτέλους τον πίνακα που νόμιζες στα νιάτα μας ότι ήταν ευκαιρία στο Μοναστηράκι"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
