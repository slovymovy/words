                    {
                        "sense_id": "a1b20683-ba98-368d-a596-52a4f4f5c60d",
                        "entry_id": "78c64eca-29e7-384a-a106-91f1986cec54",
                        "glosses": [
                            "A session of sunbathing."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "c0b1f599-e085-430d-9bff-b60f9c6b9472",
                                "sense_id": "a1b20683-ba98-368d-a596-52a4f4f5c60d",
                                "text": "It was a simple affair. We were camping down the south coast and one of my friends leapt out of the surf and slammed down onto the beach to have a sunbake – marvellous. We made the image and it's been around, I suppose as a sort of icon of the Australian way of life."
                            }
                        ]
                    }
                ],
