                "senses": [
                    {
                        "sense_id": "731f7954-aa86-3235-849f-6925b7b675f8",
                        "entry_id": "80b1c870-33c5-3a3f-af10-182ea220dcd9",
                        "glosses": [
                            "de versterkte plaats waar een brug met de oever verbonden is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bea8f37-68a0-407c-a404-39f64f84c39e",
                                "sense_id": "731f7954-aa86-3235-849f-6925b7b675f8",
                                "text": "Na de spoedige terugkomste te Rome, is de reize uit Italië naar Holland, van den eersten van louwmaand tot den laatsten van sprokkelmaand des jaars 1806, voortgezet door Ancona, Bologne, Ferrara, Venetiën, Padua, Vincenze, Verona, Roveredo, Botzen, Collman, Sterzing, Steinnach, Inspruck, Augsburg, Stuttgard, Manheim, Darmstadt, Frankfort, Cassel, het bruggehoofd van Mentz, van hier langs den Rhijn afzakkende tot Deutz, en vervolgens te land, over Dusseldorp, Duisburg, Wezel, naar ons Vaderland."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e9af81d-748b-37d5-a063-ddf480621564",
                        "entry_id": "80b1c870-33c5-3a3f-af10-182ea220dcd9",
                        "glosses": [
                            "het eerst veroverde stuk land bij een invasie ook in figuurlijke zin"
                        ],
                        "tags": [
                            "metonymisch"
                        ],
                        "examples": [
                            {
                                "example_id": "a926f321-8613-44d7-823e-c88f564920af",
                                "sense_id": "8e9af81d-748b-37d5-a063-ddf480621564",
                                "text": "We hebben er de mond van vol, maar de markt loopt er niet van over: biologische en biologisch-dynamische wijn. Net 2 procent van het wereldwijde druiven-areaal is officieel biologisch gecertificeerd. Binnen die niche is nog een splinterpartijtje actief: dat van de natuurwijnproducenten. En ofschoon piepklein, hun stem klinkt door. Nu gaat het mij te ver om te beweren dat in Parijs op iedere straathoek wel een wijnbar of -winkel zit die louter oog heeft voor het natuurschoon, maar de trend is daar. Zo ook in Berlijn, New York en Londen. In de Britse hoofdstad bezocht ik vorige week nog Compagnie des Vins Surnaturels, een adres met vierhonderd voornamelijk Franse wijnen van onbesproken komaf. Een aanrader voor de sommelier van restaurant Choux in Amsterdam dat hier als bruggenhoofd van de natuurwijnbeweging dient."
                            },
                            {
                                "example_id": "dbd29c1f-5ff7-4eb0-a8a6-5bcd76eb83c3",
                                "sense_id": "8e9af81d-748b-37d5-a063-ddf480621564",
                                "text": "„Wat een gezichtsverlies.” En: „We wisten dat Venezuela een bodemloze put is.” Miljardenleningen en grote Chinese projecten ten spijt is de Venezolaanse economie ingestort en dreigt ook het ‘Chinese bruggenhoofd’ in Latijns-Amerika te verbrokkelen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b74fd24a-6fe0-48fa-b990-1cf631f61df6",
                        "source_entry_id": "80b1c870-33c5-3a3f-af10-182ea220dcd9",
                        "target_lang_word": "Brückenkopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brückenkopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3075b8fd-2e17-37f7-9ac7-6da3445f4c9a",
                                        "entry_id": "38a39fb5-7d0b-352c-80e1-f2bde00dd1b6",
                                        "glosses": [
                                            "militärisch gesicherte Stellung auf der Seite eines Gewässers, die ansonsten noch vom Feind gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2c08d8f-7e3a-4e66-8431-1c81a0c969d8",
                                                "sense_id": "3075b8fd-2e17-37f7-9ac7-6da3445f4c9a",
                                                "text": "„Auch mit dem Kriegsende besserte sich die Lage nicht, im Gegenteil, am 12. Dezember 1918 zogen amerikanische Truppen in das Stadtgebiet ein und besetzten den sogenannten Brückenkopf.“"
                                            },
                                            {
                                                "example_id": "e8c265dc-5709-42f1-a648-8da59048ec5e",
                                                "sense_id": "3075b8fd-2e17-37f7-9ac7-6da3445f4c9a",
                                                "text": "„Von seinem Brückenkopf bei Küstrin waren es nur noch achtzig Kilometer nach Berlin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1c9d258-820e-4411-afc4-b13a982d7b83",
