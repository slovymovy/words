                                                "sense_id": "77778686-450c-3f9c-ac07-94d7f2789eee",
                                                "text": "Diese Lampe benötigt ein Leuchtmittel von 220 Volt."
                                            },
                                            {
                                                "example_id": "1370d158-0311-4b00-a640-a5c53d6535d4",
                                                "sense_id": "77778686-450c-3f9c-ac07-94d7f2789eee",
                                                "text": "„Die Einrichtung besteht außerdem aus einem Transformator, der den Wechselstrom des städtischen Elektrizitätswerks von 6.600 Volt in Gleichstrom von 2 mal 230 Volt umwandeln kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "922e285d-d37f-41e5-b46c-26d3e9911bb6",
                        "source_entry_id": "b31fafcf-83c0-39e0-a404-24470e453d9a",
