                        "examples": [
                            {
                                "example_id": "d12f62a8-6faa-4dbb-9c59-d23748fb4cf6",
                                "sense_id": "80cd30a1-11c7-33b3-a8eb-6a2e1bf72b59",
                                "text": "Het Nederlands heeft enkele keelklanken die in andere talen niet voorkomen.",
                                "translation": "Dutch has some guttural sounds that do not occur in other languages.",
                                "english": "Dutch has some guttural sounds that do not occur in other languages."
                            },
                            {
                                "example_id": "af761ac0-0bb2-4279-9615-8c472d55bf96",
                                "sense_id": "80cd30a1-11c7-33b3-a8eb-6a2e1bf72b59",
                                "text": "Bij het uitspreken van de letter \"g\" voel je een trilling in je keel, het is een keelklank",
                                "translation": "When pronouncing the letter \"g,\" you feel a vibration in your throat, it is a guttural sound.",
                                "english": "When pronouncing the letter \"g,\" you feel a vibration in your throat, it is a guttural sound."
                            },
                            {
                                "example_id": "a730f22e-0a6f-4c2c-9f35-efbe23b0c17d",
                                "sense_id": "80cd30a1-11c7-33b3-a8eb-6a2e1bf72b59",
                                "text": "Sommige talen hebben veel meer keelklanken dan andere, wat het voor sprekers van die talen moeilijker kan maken om andere klanken uit te spreken.",
                                "translation": "Some languages have many more guttural sounds than others, which can make it more difficult for speakers of those languages to pronounce other sounds.",
                                "english": "Some languages have many more guttural sounds than others, which can make it more difficult for speakers of those languages to pronounce other sounds."
                            }
                        ]
