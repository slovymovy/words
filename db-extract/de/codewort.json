                "senses": [
                    {
                        "sense_id": "5bf96a04-7fd0-31a1-b468-8ce8bcce0d7c",
                        "entry_id": "b1d0b56d-956b-38da-a7ed-85e17d6150c3",
                        "glosses": [
                            "vereinbartes Wort, das als nicht allgemein bekanntes Signal für etwas Bestimmtes dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cab936c1-42d0-48f2-86b7-d8f20603a748",
                                "sense_id": "5bf96a04-7fd0-31a1-b468-8ce8bcce0d7c",
                                "text": "„Heute kennt man Bückwaren allenfalls noch in so genannten Head Shops, wo auf ein Codewort hin, etwa das Verlangen eines „Duftkissens“, getrocknete Pflanzen oder Pilze verkauft werden, die meist gegen das Betäubungsmittelgesetz verstoßen.“"
                            },
                            {
                                "example_id": "f065a7c7-0d91-45d9-866b-070f95a2947a",
                                "sense_id": "5bf96a04-7fd0-31a1-b468-8ce8bcce0d7c",
                                "text": "„Codewörter wurden ausgetauscht, Termine und Treffpunkte vereinbart, und noch mancher Koffer wanderte am Flughafen Frankfurt von einer Hand in die andere.“"
                            },
                            {
                                "example_id": "f707fb00-1a90-4b11-8fb5-508328ee2b95",
                                "sense_id": "5bf96a04-7fd0-31a1-b468-8ce8bcce0d7c",
                                "text": "\"Bevölkerung\" ist ein beliebtes Codewort bei rechtspopulistischen Parteien, um eigene Ansichten hinter den Interessen der Allgemeinheit zu verstecken."
                            },
                            {
                                "example_id": "540e6c50-92e4-4d7d-a8a4-a4ff67ec3ee8",
                                "sense_id": "5bf96a04-7fd0-31a1-b468-8ce8bcce0d7c",
                                "text": "„Dort wechselte man für jedes Treffen die Wohnung, musste einzeln in zehn- bis fünfzehnminütigem Abstand eintrudeln und das ständig geänderte, gültige Codewort parat haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
