                                        "sense_id": "793acbb5-05f7-3fe3-9e90-0500fb8ccae6",
                                        "entry_id": "6b78ba70-4dba-3a30-886a-5e84b09a613f",
                                        "glosses": [
                                            "Vin provenant de l’île de Chypre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc37eccd-da91-4722-91cb-9512b1de5e5d",
                                                "sense_id": "793acbb5-05f7-3fe3-9e90-0500fb8ccae6",
                                                "text": "Mais à la fin du repas, on apporta à Bébé un verre particulier, dans lequel elle but, seule et sans en offrir aux convives, un doigt de chypre parfumé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a196868-5eea-3c1f-8ca6-3ff6fedd56aa",
                                        "entry_id": "6b78ba70-4dba-3a30-886a-5e84b09a613f",
                                        "glosses": [
                                            "Parfum composé."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e370f580-bd00-40b1-88b6-2dbc12cdc9a3",
                                                "sense_id": "3a196868-5eea-3c1f-8ca6-3ff6fedd56aa",
                                                "text": "Son odeur caractéristique la désigne d'une façon particulière pour être employée dans les parfums tels que l'ambre et le chypre …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06f65e46-027d-33d0-b1ca-d0cce91c887d",
                                        "entry_id": "6b78ba70-4dba-3a30-886a-5e84b09a613f",
                                        "glosses": [
                                            "Base de parfum dont l'une des composantes traditionnelles était extraite d'un lichen qui pousse sur le chêne."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1f58669-7bd7-4ee2-ad65-f46d88307854",
                                                "sense_id": "06f65e46-027d-33d0-b1ca-d0cce91c887d",
                                                "text": "Il s’avança vers Spade à petits pas sautillants : une odeur pénétrante de chypre l’escortait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
