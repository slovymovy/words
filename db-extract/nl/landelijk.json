                "senses": [
                    {
                        "sense_id": "5fbbead6-7ebc-3f6a-aab7-8abb7afcd768",
                        "entry_id": "e64781c1-8cd6-3d35-80dc-bc083b670303",
                        "glosses": [
                            "met betrekking tot of geldend voor het hele land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5a40a3a-3fce-4e55-bf69-3e8bb7bcf707",
                                "sense_id": "5fbbead6-7ebc-3f6a-aab7-8abb7afcd768",
                                "text": "De gemeentelijke verkiezingen worden overschaduwd door de landelijke politiek."
                            },
                            {
                                "example_id": "9c50e952-cbf4-453d-978c-6179acef93c0",
                                "sense_id": "5fbbead6-7ebc-3f6a-aab7-8abb7afcd768",
                                "text": "De landelijke museumdag trok veel bezoekers."
                            },
                            {
                                "example_id": "9e10a735-4bef-4c64-bb59-895a8368d226",
                                "sense_id": "5fbbead6-7ebc-3f6a-aab7-8abb7afcd768",
                                "text": "'Duurzame mijlpaal': De rechter oordeelt dat de gemeente bevoegd is om zo'n verbod op te leggen en vindt de argumenten van Den Haag voldoende onderbouwd. Dat de bijdrage van het verbod op landelijk en wereldwijd niveau \"gering is\", doet daar niet aan af, aldus de rechter."
                            },
                            {
                                "example_id": "1ff37b8e-1c57-4d2c-ac3b-07f37561572a",
                                "sense_id": "5fbbead6-7ebc-3f6a-aab7-8abb7afcd768",
                                "text": "Vanaf 1971 was hij elf jaar landelijk politicus, waarvan negen jaar als leider van D66. Als het vleesgeworden redelijk alternatief gaf hij de partij na het vertrek van de flamboyante oprichter Hans van Mierlo een nieuw gezicht."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2c3da91-ecfb-31db-b49f-8d9b0c2e97ff",
                        "entry_id": "e64781c1-8cd6-3d35-80dc-bc083b670303",
                        "glosses": [
                            "met betrekking tot minder bevolkte, niet-stedelijke gebieden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0603b527-dc2e-49db-8b22-2d8081837acf",
                                "sense_id": "c2c3da91-ecfb-31db-b49f-8d9b0c2e97ff",
                                "text": "Het aantal inwoners in een landelijke omgeving neemt gestaag af."
                            }
                        ]
                    }
                ],
