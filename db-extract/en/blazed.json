                        "entry_id": "71703d45-99f5-324f-b573-8126c4f16f69",
                        "glosses": [
                            "Under the influence of marijuana, usually at a relatively high dose."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1b724621-1072-4018-af6b-fbb6113e636f",
                                "sense_id": "f821e514-d458-39ba-8be7-8b1885777798",
                                "text": "I could tell by his bloodshot eyes that he was pretty blazed."
                            },
                            {
                                "example_id": "e98fa60f-9c93-485b-b964-97a297390309",
                                "sense_id": "f821e514-d458-39ba-8be7-8b1885777798",
                                "text": "That's when they asked the fatal question. Can I use the car for a minute? I was reluctant, but so blazed that I let them."
                            },
                            {
                                "example_id": "cf41496c-055b-4c1f-a54f-8187972844e6",
                                "sense_id": "f821e514-d458-39ba-8be7-8b1885777798",
                                "text": "\"Just kidding. I wanna get blazed out of my mind, eat every muffin in this place, and yell about how much I love everyone.\""
                            }
                        ]
                    }
