                ],
                "senses": [
                    {
                        "sense_id": "f1837148-4864-34e9-aaf0-684fed4da1a2",
                        "entry_id": "4b1cd04c-377d-326c-be77-410512fe59b8",
                        "glosses": [
                            "действие по значению гл. подбирать, подобрать, подбираться, подобраться"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4bf8cada-4e66-304b-951b-d1f9fdf9c49b",
                        "entry_id": "4b1cd04c-377d-326c-be77-410512fe59b8",
                        "glosses": [
                            "отбор для спаривания, скрещивания определенных особей в целях улучшения потомства"
                        ],
                        "tags": [
                            "в животноводстве и растениеводстве"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "51b3a484-3a23-337a-8fd3-3392ed600f92",
                        "entry_id": "4b1cd04c-377d-326c-be77-410512fe59b8",
                        "glosses": [
                            "то, что подобрано; коллекция, собрание, ассортимент, набор"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6958ac3c-fc58-34f6-8765-ff402dc4bec9",
                        "entry_id": "4b1cd04c-377d-326c-be77-410512fe59b8",
                        "glosses": [
                            "сочетание (красок, расцветок и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b76ea772-a5a0-4ddc-9a12-e2b9ee81f00a",
                                "sense_id": "6958ac3c-fc58-34f6-8765-ff402dc4bec9",
                                "text": "Всё сделано ею «от» и «до»: цвет стен, обоев, шторы, подбор ткани."
                            },
                            {
                                "example_id": "f4af1e4d-428f-4b1a-b257-8ebf8d49d54a",
                                "sense_id": "6958ac3c-fc58-34f6-8765-ff402dc4bec9",
                                "text": "Был упразднён и Никитский монастырь, но ещё в 20-е годы на его колокольне иногда звонил известный в Москве звонарь-виртуоз К. К. Сараджев, которому нравился тембровый подбор колоколов монастыря."
                            }
                        ]
                    },
                    {
                        "sense_id": "187f5d82-9dd9-3a3a-8ef1-66dbde6514ca",
                        "entry_id": "4b1cd04c-377d-326c-be77-410512fe59b8",
                        "glosses": [
                            "каблук, сделанный из кусков кожи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1bf7086-a37d-4bd0-b50e-5e7d5910508a",
                                "sense_id": "187f5d82-9dd9-3a3a-8ef1-66dbde6514ca",
                                "text": "Ипполит Матвеевич сунул сухощавые ноги в довоенные штучные брюки, завязал их у щиколотки тесёмками и погрузился в короткие мягкие сапоги с узкими квадратными носами и низкими подборами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ed1e000-0de7-43fa-aa45-4f8450bbfa15",
                        "source_entry_id": "4b1cd04c-377d-326c-be77-410512fe59b8",
                        "target_lang_word": "Zusammenstellung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammenstellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62d2426a-1984-345b-9b20-76b448752ebe",
                                        "entry_id": "5cee8cc0-ee20-3fd4-8132-f893aa8caed4",
                                        "glosses": [
                                            "die Anordnung von Ausgewähltem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "516168fb-f52b-4d64-81b5-86355391c621",
                                                "sense_id": "62d2426a-1984-345b-9b20-76b448752ebe",
                                                "text": "Die Zusammenstellung der Bilder kann als gelungen betrachtet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be20deb2-dbf1-3359-8384-9214b619ecb1",
                                        "entry_id": "5cee8cc0-ee20-3fd4-8132-f893aa8caed4",
                                        "glosses": [
                                            "das Anordnen von Ausgewähltem, der Vorgang von ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53dc72f6-fdf1-41d8-9cfd-9bbb4a721b4f",
                                                "sense_id": "be20deb2-dbf1-3359-8384-9214b619ecb1",
                                                "text": "Die Zusammenstellung der Bilder übernahm der Künstler selbst."
                                            },
                                            {
                                                "example_id": "170c678c-858f-453b-886e-6c8ad01b7488",
                                                "sense_id": "be20deb2-dbf1-3359-8384-9214b619ecb1",
                                                "text": "„Nicht von ungefähr sind es, zumindest in Deutschland, vor allem unterbeschäftigte Postbeamte, die durch die Zusammenstellung und private Publikation von Eisenbahnkursbüchern ihr schmales Salär aufbessern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "339e94b1-2416-4da1-b1a2-05ccf912d0ad",
                        "source_entry_id": "4b1cd04c-377d-326c-be77-410512fe59b8",
                        "target_lang_word": "choix",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "choix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d2264e3-9af7-3fbd-8c4b-03b7d192d4b0",
                                        "entry_id": "dbf914a2-e7fd-317b-81c7-c03881241e06",
                                        "glosses": [
                                            "Action de choisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e05a1b2-7209-4721-8a7a-329351572db2",
                                                "sense_id": "5d2264e3-9af7-3fbd-8c4b-03b7d192d4b0",
                                                "text": "Faire un bon choix, un mauvais choix. — Un choix éclairé."
                                            },
                                            {
                                                "example_id": "d8964b40-9db2-43ac-9697-0ddfe0d5eaba",
                                                "sense_id": "5d2264e3-9af7-3fbd-8c4b-03b7d192d4b0",
                                                "text": "D’un saut elle traversa le chemin, et à la hâte fit choix de quatre boîtes qu’elle emporta en courant pour aller les cacher au pied d’une haie, sous un tas de feuilles sèches."
                                            },
                                            {
                                                "example_id": "e6cdfa6b-6ed0-43d2-b9f2-fb0fd886c067",
                                                "sense_id": "5d2264e3-9af7-3fbd-8c4b-03b7d192d4b0",
                                                "text": "La violence est un acte qui résulte d’une décision prise par la personne qui le commet. Le libre arbitre est l’un des attributs essentiels de la dignité humaine. Si la violence est un choix, il est possible de ne pas être violent. Il suffit de renoncer à la volonté de puissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34c4dbe6-9ad8-36e9-bd65-e4ec9cad2424",
                                        "entry_id": "dbf914a2-e7fd-317b-81c7-c03881241e06",
                                        "glosses": [
                                            "Pouvoir ou faculté de choisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56bcac31-3c3e-4776-8387-941d2dd2408c",
                                                "sense_id": "34c4dbe6-9ad8-36e9-bd65-e4ec9cad2424",
                                                "text": "On lui a donné, laissé le choix."
                                            },
                                            {
                                                "example_id": "dd9eb85a-29b8-436d-a940-b0e6e9eaba1f",
                                                "sense_id": "34c4dbe6-9ad8-36e9-bd65-e4ec9cad2424",
                                                "text": "Butler avançait que le consentement des femmes ne peut se concevoir comme un choix véritablement libre, car il se construit lui-même au sein de rapports de pouvoir préexistants et asymétriques. (Tel le « choix » de porter le voile, le « choix » de porter des talons aiguilles, le « choix » de se plâtrer la figure et de s’épiler intégralement)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d4fa694-a456-36fc-b11d-8fc5a7f335af",
                                        "entry_id": "dbf914a2-e7fd-317b-81c7-c03881241e06",
                                        "glosses": [
                                            "Préférence accordée à une personne ou à une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bab0d01-6b2c-4169-bcfe-23e3f1da7582",
                                                "sense_id": "4d4fa694-a456-36fc-b11d-8fc5a7f335af",
                                                "text": "Parmi tant d’amis, il faut faire un choix prudent."
                                            },
                                            {
                                                "example_id": "9bc42651-e859-4e2a-8d46-25e0c32cb8c4",
                                                "sense_id": "4d4fa694-a456-36fc-b11d-8fc5a7f335af",
                                                "text": "— Je connais des enfants qui, si le choix leur était donné, préféreraient la fessée à la privation de dessert."
                                            },
                                            {
                                                "example_id": "58ec118e-c20b-42a7-889f-9efc433e3b15",
                                                "sense_id": "4d4fa694-a456-36fc-b11d-8fc5a7f335af",
                                                "text": "— Il ne restait donc que deux choix possibles : soit il la laissait tranquille – et il avait déjà prouvé qu'il en était incapable –, soit il prenait le taureau par les cornes et acceptait de chambouler sa vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba3e156a-da45-3194-bd8a-95bd0e34a4cf",
                                        "entry_id": "dbf914a2-e7fd-317b-81c7-c03881241e06",
                                        "glosses": [
                                            "Variété, grande quantité d’objets entre lesquels on peut choisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05184984-8f97-4ae2-b221-1256afe3aa1c",
                                                "sense_id": "ba3e156a-da45-3194-bd8a-95bd0e34a4cf",
                                                "text": "Si la buvette est ouverte, il me paraît que les consommateurs n’y peuvent trouver qu’un choix restreint de consommations."
                                            },
                                            {
                                                "example_id": "752c0c56-3a47-4201-b6aa-71a29f9fbdce",
                                                "sense_id": "ba3e156a-da45-3194-bd8a-95bd0e34a4cf",
                                                "text": "Tous ceux qui n'avaient pas de bidons, de troisième cartouchière, de vis de culasse, en découvrent soudain un choix près d'eux […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fd6c764-4f7a-3a45-9c11-90a4f7c2cb15",
                                        "entry_id": "dbf914a2-e7fd-317b-81c7-c03881241e06",
                                        "glosses": [
                                            "Discernement ; distinction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4550cd6-9c24-4cd5-8618-1ae42e144d09",
                                                "sense_id": "6fd6c764-4f7a-3a45-9c11-90a4f7c2cb15",
                                                "text": "Une érudition entassée sans choix."
                                            },
                                            {
                                                "example_id": "0c753f49-91ad-4ad0-87ce-acb612121a75",
