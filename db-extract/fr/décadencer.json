                ],
                "senses": [
                    {
                        "sense_id": "1c8b934d-eac6-3800-8c85-af87cce61340",
                        "entry_id": "3c119ee0-cb78-3265-9d35-27a757fd2d81",
                        "glosses": [
                            "Faire perdre sa cadence à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee842a5d-f5c5-48c7-af11-dd01cdea8235",
                                "sense_id": "1c8b934d-eac6-3800-8c85-af87cce61340",
                                "text": "Ça donne des dessins pas pareils que j'associe pour casser le confort visuel et décadencer les rythmes des histoires que je raconte."
                            },
                            {
                                "example_id": "775c3907-f31b-4169-9a75-0f99d69818a9",
                                "sense_id": "1c8b934d-eac6-3800-8c85-af87cce61340",
                                "text": "L'aller-retour en pointe vers Strasbourg la matin, vers Metz le soir est décadencé d'une dizaine de minutes côté Metz pour assurer en plus la desserte de Lutzelbourg, Dettwiller et Hochfelden."
                            },
                            {
                                "example_id": "e65aeed6-59e3-48fe-90bd-f0758dd47c52",
                                "sense_id": "1c8b934d-eac6-3800-8c85-af87cce61340",
                                "text": "Là encore, la desserte a été décadencée et il faut probablement aller chercher les motifs de ce méfait à une nouvelle poussée de robustesse mal placée."
                            }
                        ]
                    }
                ],
