                        "cross_references": [
                            {
                                "target_word": "point de fusion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ebd4407-159c-33d8-93f5-34874c1cb9e7",
                                        "entry_id": "e52c9ac4-62e0-3863-9d36-9f80208a459b",
                                        "glosses": [
                                            "Température à laquelle coexistent l’état solide et l’état liquide d’un corps, sous une pression donnée."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05d51833-2992-4fb2-a835-508b1ee62402",
                                                "sense_id": "1ebd4407-159c-33d8-93f5-34874c1cb9e7",
                                                "text": "M. Violle a trouvé pour point de fusion de l’argent et de l’or 954° et 1035°. MM. Holborn et Wienn ont donné pour les mêmes corps 968° et 1070°."
                                            },
                                            {
                                                "example_id": "4745fd6d-b11b-4592-a3b2-1fd2635ac8f4",
                                                "sense_id": "1ebd4407-159c-33d8-93f5-34874c1cb9e7",
                                                "text": "Le meilleur criterium de la pureté des différents acides gras est leur point de fusion, qui est d'autant plus élevé qu'ils contiennent plus de carbone."
                                            },
                                            {
                                                "example_id": "3e9f349c-cb2d-42a9-8749-21c95c096233",
                                                "sense_id": "1ebd4407-159c-33d8-93f5-34874c1cb9e7",
                                                "text": "Les triglycérides du beurre se comptent par millions, puisque l’on a identifié 400 résidus d’acides gras différant par leur longueur ou par leurs insaturations (des doubles liaisons entre des atomes de carbone voisins), et chaque triglycéride a un point de fusion différent : c’est la raison pour laquelle ce mélange qu’est le beurre commence à fondre à – 10 °C, et que sa fusion s’achève à environ 55 °C."
                                            },
                                            {
                                                "example_id": "1b14f041-00be-4ca7-b15f-6f7b653f3d3e",
                                                "sense_id": "1ebd4407-159c-33d8-93f5-34874c1cb9e7",
                                                "text": "Toutefois, les liquides ont tendance à rester en surfusion, ce qui signifie qu’ils se solidifient à des températures bien inférieures à leur point de fusion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
