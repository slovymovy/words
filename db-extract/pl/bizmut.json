                    {
                        "translation_id": "f892b126-93d6-4783-922a-d415774043b9",
                        "source_entry_id": "2dc05c60-dfe6-3f31-a5e6-00e3332ab9eb",
                        "source_sense_id": "e6ff4da1-5b41-30af-81ed-7e5f6a78bf2c",
                        "target_lang_word": "bismuth",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bismuth",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7cd04f08-01c1-3651-9dc2-947880e6c67d",
                                        "entry_id": "fbfb89f5-1733-3db6-8e1b-12193353c0d6",
                                        "glosses": [
                                            "Métal fragile, d’un blanc gris à teinte rouge et qui cristallise facilement, de symbole Bi et de numéro atomique 83 ; il appartient à la série chimique des métaux pauvres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea2f2cf1-63f5-4240-87ec-9b6316fb4ea9",
                                                "sense_id": "7cd04f08-01c1-3651-9dc2-947880e6c67d",
                                                "text": "L'étain, le plomb, le bismuth, l’antimoine, qui sont séparés pendant la dissolution ou la sursaturation par l'hydroxyde d’ammonium, sont sans influence sur le résultat."
                                            },
                                            {
                                                "example_id": "f5e166a9-6956-4537-830c-4b93d808f314",
                                                "sense_id": "7cd04f08-01c1-3651-9dc2-947880e6c67d",
                                                "text": "On est alors fort étonné de retrouver les morceaux de bismuth intacts, leur aspect extérieur ne diffère en rien de ce qu’il était avant la chauffe […] Il semble, d’après cela que le bismuth n’a pas fondu."
                                            }
                                        ]
                                    },
