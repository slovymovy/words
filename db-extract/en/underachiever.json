                ],
                "senses": [
                    {
                        "sense_id": "c4d2006b-1b13-3274-bdba-6e71af37f371",
                        "entry_id": "99e221e7-39ee-37bd-aba1-65c43670daf5",
                        "glosses": [
                            "One who underachieves, i.e. performs less well than expected."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ece40b-5dc4-4b7e-8882-4d5c3540e764",
                                "sense_id": "c4d2006b-1b13-3274-bdba-6e71af37f371",
                                "text": "Woody Allen has provided what is probably the best theological answer to the problem of evil: God is not evil; He is just an underachiever."
                            },
                            {
                                "example_id": "bf5452ef-e44e-4062-a56f-d65fcc66ed96",
                                "sense_id": "c4d2006b-1b13-3274-bdba-6e71af37f371",
                                "text": "Bart: (reading his permanent record) \"Underachiever and proud of it.\" How old is this thing?"
                            },
                            {
                                "example_id": "4c649146-57f2-4c4c-a5f3-ff9c8d5495b6",
                                "sense_id": "c4d2006b-1b13-3274-bdba-6e71af37f371",
                                "text": "For the TLC undertaking, he employs only underachievers, cronies who have been hired for their ability to make the work site madcap and, therefore, filmable."
                            },
                            {
                                "example_id": "d8a3c739-fa73-471f-91fb-39d7c09e8aeb",
                                "sense_id": "c4d2006b-1b13-3274-bdba-6e71af37f371",
                                "text": "This unsung, underrated, under-appreciated / The one them underachievers had underestimated / Finally graduated, I'm one of the most hated"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82cef4b3-3db0-45fa-bdeb-fedcaf9d923d",
                        "source_entry_id": "99e221e7-39ee-37bd-aba1-65c43670daf5",
                        "source_sense_id": "c4d2006b-1b13-3274-bdba-6e71af37f371",
                        "source_sense_description": "one who underachieves",
                        "target_lang_word": "Minderleister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Minderleister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "559ec4b5-281b-3e6f-9c95-8d0144cf9aed",
                                        "entry_id": "8f8d0a34-9bf8-3d8e-9955-3887bf975341",
                                        "glosses": [
                                            "Person, die in ihren Leistungen unter ihren Möglichkeiten bleibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "670246af-1c9f-4959-b318-e9decdff0458",
                                                "sense_id": "559ec4b5-281b-3e6f-9c95-8d0144cf9aed",
                                                "text": "„Am einfachsten wäre es für Arbeitgeber, wenn sie Minderleister bereits im Einstellungsprozess erkennen könnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa8f53c2-91e4-4243-ab35-5affbb7caed7",
                        "source_entry_id": "99e221e7-39ee-37bd-aba1-65c43670daf5",
                        "source_sense_id": "c4d2006b-1b13-3274-bdba-6e71af37f371",
                        "source_sense_description": "one who underachieves",
                        "target_lang_word": "Minderleisterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Minderleisterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71181845-08db-3839-abc5-9d355c19d602",
                                        "entry_id": "7620c101-d1f9-31b1-b7eb-0cb01288e923",
                                        "glosses": [
                                            "weibliches Lebewesen, das in seinen Leistungen unter seinen Möglichkeiten bleibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53b6bc65-1cae-4ca9-92b1-f019a95dd969",
                                                "sense_id": "71181845-08db-3839-abc5-9d355c19d602",
                                                "text": "„Und jetzt opferst du mich für so eine Minderleisterin, nur damit sie hier weiterhin Probleme machen kann?“"
                                            },
                                            {
                                                "example_id": "982ae419-9cb5-4eb6-935b-b3cf156b27a2",
                                                "sense_id": "71181845-08db-3839-abc5-9d355c19d602",
                                                "text": "„Warum es keine Moral gab, die verhinderte, dass eine Krebskranke als Minderleisterin gesehen wird, die den Laden aufhält.“"
                                            },
                                            {
                                                "example_id": "ad844de9-289e-4274-874d-c0d8949b9487",
                                                "sense_id": "71181845-08db-3839-abc5-9d355c19d602",
                                                "text": "„In extremen Fällen kann eine Schülerin zur Minderleisterin werden, wenn sie nicht als Streberin bezeichnet werden möchte.“"
                                            },
                                            {
                                                "example_id": "695d574f-0e99-4017-b078-7dbcae2d4f0e",
                                                "sense_id": "71181845-08db-3839-abc5-9d355c19d602",
                                                "text": "„Währenddessen stieg, durch Zucht, durch Kraftfutter, durch bessere Melkmaschinen und durch radikales Aussortieren jeder Minderleisterin, ununterbrochen die Milchproduktion jeder einzelnen Kuh.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
