                "senses": [
                    {
                        "sense_id": "cffb1ced-262a-3a4b-b150-e65a926c8e89",
                        "entry_id": "2add902c-0b15-32ff-a556-0196d60fa732",
                        "glosses": [
                            "Aufforderung von offizieller Seite, zum Beispiel vor einem Gericht oder bei der Polizei zu erscheinen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2bfc00f9-70fc-4597-a3c1-f4d079c92227",
                                "sense_id": "cffb1ced-262a-3a4b-b150-e65a926c8e89",
                                "text": "Die Vorladung wurde rechtzeitig zugestellt."
                            },
                            {
                                "example_id": "04b8d5a2-d5b2-4c32-9597-8fc6852fe91e",
                                "sense_id": "cffb1ced-262a-3a4b-b150-e65a926c8e89",
                                "text": "„Ich war gerade aufgestanden, als ich eine Vorladung erhielt, vor dem amtierenden Bürgermeister im Rathaus zu erscheinen.“"
                            },
                            {
                                "example_id": "2c2c46dc-61d5-40bf-b9fa-34694d4d061d",
                                "sense_id": "cffb1ced-262a-3a4b-b150-e65a926c8e89",
                                "text": "„Inzwischen näherte sich der Tag meiner endgültigen Vorladung auf das Konsulat der Vereinigten Staaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
