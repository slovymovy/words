                        "glosses": [
                            "knooppunt voor gasopslag en gasdoorvoer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5034a0f8-e423-4140-ae56-7b3df0d9e7fb",
                                "sense_id": "0755016d-84ed-37c0-bdf8-43539cfce776",
                                "text": "Nederlandse gasrotonde draait op handel met Russen"
                            },
                            {
                                "example_id": "35745eba-b4c1-4313-b06a-87c9428cce25",
                                "sense_id": "0755016d-84ed-37c0-bdf8-43539cfce776",
                                "text": "Gasunie heeft het gasnet de laatste jaren flink uitgebreid. De zogenoemde gasrotonde is al versterkt in het noorden, zuiden en oosten van Nederland, maar het westen was achtergebleven."
                            },
                            {
                                "example_id": "49cedc6c-6bcb-4377-a882-ac21f233af9a",
                                "sense_id": "0755016d-84ed-37c0-bdf8-43539cfce776",
                                "text": "De investering in het aardgasnetwerk sluit volgens het fonds aan bij deze gedachte. Nederland bouwt aan een sterke positie als gasrotonde in Europa. Daarbij kan GDF Suez het kapitaal weer gebruiken om te investeren in ontwikkelingen in de Noordzee, zegt PGGM."
                            }
                        ]
                    }
