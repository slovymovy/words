                                        "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                        "entry_id": "62438177-1906-3f66-afac-1b672c2016f4",
                                        "glosses": [
                                            "eine Frau, die für Geld sexuelle Handlungen vornimmt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "221c9379-4dc6-4e13-a74c-0b8909bb9780",
                                                "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                                "text": "Die Bezeichnung Nutte wird von den betreffenden Personen zugunsten des Ausdrucks Hure abgelehnt."
                                            },
                                            {
                                                "example_id": "13a8f45d-b242-444f-9806-c18807e6594b",
                                                "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                                "text": "„Nadine war keine professionelle Nutte. Sie machte das als Hobby, hatte keinen Zuhälter und kannte keine anderen Nutten.“"
                                            },
                                            {
                                                "example_id": "171a24be-00ba-4aa4-9b94-19d7671806c1",
                                                "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                                "text": "„Er würde zum Wirt gehen und ihm sagen, dass solche Nutte unmöglich weiter in einem anständigen Hause wohnen könne.“"
                                            },
                                            {
                                                "example_id": "9345cbf6-6509-4871-b216-5d286e74ea56",
                                                "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                                "text": "„Am Nebentisch hockten ein paar Nutten.“"
                                            },
                                            {
                                                "example_id": "1d22b5bd-ca3a-4d18-9df6-513ba927aeee",
                                                "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                                "text": "„Auf anständige Weise verdient hier keiner sein Geld: Entweder man ist Nutte, Dealer oder Banker.“"
                                            },
                                            {
                                                "example_id": "db05fd60-d399-459b-81d5-a3bf88f8b642",
                                                "sense_id": "d2fb1905-e26e-38ad-9bec-e51beb01eaad",
                                                "text": "„Schicken Sie mir ein paar Nutten und eine Flasche Whiskey mit Eis aufs Zimmer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
