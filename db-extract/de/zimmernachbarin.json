                        "glosses": [
                            "weibliche Person, die mit einer anderen Person im gleichen Zimmer ist, zum Beispiel in einem Büro oder Altersheim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5051f81-ad3c-47ba-84de-0619b1360503",
                                "sense_id": "80d4c37f-5b06-376e-80cc-65b7e5f7c3b7",
                                "text": "„Die Zimmernachbarin regt sich in ihrem Bett.“"
                            },
                            {
                                "example_id": "acfbfda6-9e42-4472-b112-f4db614488af",
                                "sense_id": "80d4c37f-5b06-376e-80cc-65b7e5f7c3b7",
                                "text": "„Sie schwatzte, ich hätte Glück gehabt, die Polizei sei wiedergekommen, sie hätten die Zimmernachbarin mitgenommen.“"
                            }
                        ],
