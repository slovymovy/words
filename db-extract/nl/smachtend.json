                "senses": [
                    {
                        "sense_id": "53c07f68-e20b-3650-a689-59f7214dd59a",
                        "entry_id": "7eed0317-85ad-3025-b84c-ed14f43763bf",
                        "glosses": [
                            "heel sterk verlangend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4908aad-4a10-43ce-8733-dec95ba196ed",
                                "sense_id": "53c07f68-e20b-3650-a689-59f7214dd59a",
                                "text": "Het is de Nederlandstalige uitvoering. 'You’re the one that I want' is dan: 'Want voor jou wil ik gaan!' Maar; het smachtende Oooh Sandy, blijft natuurlijk onveranderd smachtend Ooh Sandy."
                            },
                            {
                                "example_id": "5a348222-caa4-4f8a-bb57-e1bf4833e277",
                                "sense_id": "53c07f68-e20b-3650-a689-59f7214dd59a",
                                "text": "Terug naar de seks op het filmdoek. De naar filmbloot smachtende collega kwam de laatste dagen flink aan zijn trekken. Vooral de Franse regisseurs maakten hun reputatie meer dan waar."
                            },
                            {
                                "example_id": "e91015ef-261a-40f6-9584-050ac0be07ed",
                                "sense_id": "53c07f68-e20b-3650-a689-59f7214dd59a",
                                "text": "Het is verre van zeker dat de fans van het immens populaire Boer Zoekt Vrouw volgend jaar een nieuw seizoen kunnen bekijken van de datingshow voor naar liefde smachtende boeren."
                            },
                            {
                                "example_id": "95bcf4ea-7552-4a3b-9962-16d3e262142d",
                                "sense_id": "53c07f68-e20b-3650-a689-59f7214dd59a",
                                "text": "De naar een geïnteresseerde man smachtende Patrick had echter niets in de gaten. ,,Gordon ziet er best sexy uit op een paard, aldus Patrick. En Gordon: ,,We zijn misschien een leuk 'echtpaard'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6277d4d-fd4a-44ea-a184-b11c7d37388a",
                        "source_entry_id": "7eed0317-85ad-3025-b84c-ed14f43763bf",
                        "source_sense_id": "53c07f68-e20b-3650-a689-59f7214dd59a",
                        "source_sense_description": "heel sterk verlangend",
                        "target_lang_word": "eager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                        "entry_id": "9c964a3c-8fb8-30d5-b89f-02136844abc6",
                                        "glosses": [
                                            "Desirous; keen to do or obtain something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2fd0a64-b285-4dcb-8caa-62f39164f7a0",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "You stayed up all night to get to the front of the queue. You must be very eager to get tickets."
                                            },
                                            {
                                                "example_id": "666b5e2b-ed8e-4487-b994-a54313b524f0",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "Stacey is very eager to go cycling this weekend."
                                            },
                                            {
                                                "example_id": "325756f1-cff1-42ef-b526-df5544f8fd4f",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "The hounds were eager in the chase."
                                            },
                                            {
                                                "example_id": "57dc19dd-8598-4641-a9c0-c2f2b8c6455a",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "I was eager to show my teacher how much I'd learned over the holidays."
                                            },
                                            {
                                                "example_id": "7902f82a-e6f2-4c13-826f-785514e0a3fd",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "When to her eager lips is brought / Her infant's thrilling kiss."
                                            },
                                            {
                                                "example_id": "93d0cdee-10c1-43f2-b419-f2d4f8e9cab8",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "a crowd of eager and curious schoolboys"
                                            },
                                            {
                                                "example_id": "5ea125c5-7c69-4078-87a0-81688f6f6c8d",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him.[…]. The captive made no resistance and came not only quietly but in a series of eager little rushes like a timid dog on a choke chain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8908f6a4-7314-33cb-9be3-396f43c1fffa",
                                        "entry_id": "9c964a3c-8fb8-30d5-b89f-02136844abc6",
                                        "glosses": [
                                            "Not employing lazy evaluation; calculating results immediately, rather than deferring calculation until they are required."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60bb466c-94c9-402f-b4af-f87f45a587d9",
                                                "sense_id": "8908f6a4-7314-33cb-9be3-396f43c1fffa",
                                                "text": "an eager algorithm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0afd2f8e-6e35-32b8-8bdb-8427c04fee91",
                                        "entry_id": "9c964a3c-8fb8-30d5-b89f-02136844abc6",
                                        "glosses": [
                                            "Brittle; inflexible; not ductile."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "822c0d29-209f-4eb2-b569-3e99a2a06c49",
                                                "sense_id": "0afd2f8e-6e35-32b8-8bdb-8427c04fee91",
                                                "text": "gold itself will be sometimes so eager, (as artists call it), that it will as little endure the hammer as glass itself"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fac0f05a-4349-3bcc-af99-da238fad0dc7",
                                        "entry_id": "9c964a3c-8fb8-30d5-b89f-02136844abc6",
                                        "glosses": [
                                            "Sharp; sour; acid."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "878232f0-f336-4474-b698-630e9a231fce",
                                                "sense_id": "fac0f05a-4349-3bcc-af99-da238fad0dc7",
                                                "text": "like eager droppings into milk"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f378c05-6599-3891-8dd5-6c305f5ae319",
                                        "entry_id": "9c964a3c-8fb8-30d5-b89f-02136844abc6",
                                        "glosses": [
                                            "Sharp; keen; bitter; severe."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84f3ec27-2621-4250-aeaa-2cc256773628",
                                                "sense_id": "6f378c05-6599-3891-8dd5-6c305f5ae319",
                                                "text": "If so thou thinkest, vex him with eager words."
                                            },
                                            {
                                                "example_id": "985c7559-f033-47f0-8c5f-51784402be39",
                                                "sense_id": "6f378c05-6599-3891-8dd5-6c305f5ae319",
                                                "text": "It is a nipping and an eager air."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d389ba2a-bf68-391c-ac8a-cca5bc73068a",
                                        "entry_id": "53e680a9-66be-3aa6-9c1f-23549e5ab031",
                                        "glosses": [
                                            "To be or become eager."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be38eb2a-a0f7-4ea2-b4dc-7b5f77b64da6",
                                                "sense_id": "d389ba2a-bf68-391c-ac8a-cca5bc73068a",
                                                "text": "Now everybody considered it a high privilege (valued it at a high consideration) to see him and to hear him speak, and to obey his command (him commanding), whereas he, though being such a person, eagered to be unknown, and to escape notice in solitude."
                                            },
                                            {
                                                "example_id": "55fb64e1-2fe3-4e95-9680-340d641c13cc",
                                                "sense_id": "d389ba2a-bf68-391c-ac8a-cca5bc73068a",
                                                "text": "Our spirits fret and chafe like sea waves on the rocks eagering to climb the shore."
                                            },
                                            {
                                                "example_id": "bc8a47bb-540e-4d2d-9dcf-fce536fab895",
                                                "sense_id": "d389ba2a-bf68-391c-ac8a-cca5bc73068a",
                                                "text": "The buggy jolted on, the stout, wellkept team eagering, homing, barning."
                                            },
                                            {
                                                "example_id": "ffe66551-307e-4e9d-b566-e6fff0eb422c",
                                                "sense_id": "d389ba2a-bf68-391c-ac8a-cca5bc73068a",
                                                "text": "After entering college, I eagered to have a parttime job."
                                            },
                                            {
                                                "example_id": "7dbde8a2-cb64-49e8-badb-33c9d9fa48f0",
                                                "sense_id": "d389ba2a-bf68-391c-ac8a-cca5bc73068a",
                                                "text": "After the go-ahead from the joint committee, the Mugglesby CO warmed up and eagered up tremendously, and we went back to plotting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39ef8d17-9a32-3503-9b6e-0ce7b0eb233b",
                                        "entry_id": "53e680a9-66be-3aa6-9c1f-23549e5ab031",
                                        "glosses": [
                                            "To express eagerness."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e18b5f6-ff99-48de-b29f-68465f61a1f5",
                                                "sense_id": "39ef8d17-9a32-3503-9b6e-0ce7b0eb233b",
                                                "text": "His hair crinkled towards her fondly. \"Yes,\" he eagered."
                                            },
                                            {
                                                "example_id": "736f8d14-3bc4-432a-9adb-3fadd109c2bd",
                                                "sense_id": "39ef8d17-9a32-3503-9b6e-0ce7b0eb233b",
                                                "text": "Peg! eager voices eagered voicely."
                                            },
                                            {
                                                "example_id": "169a2ce4-3175-4cab-9554-ea1dc31a4738",
                                                "sense_id": "39ef8d17-9a32-3503-9b6e-0ce7b0eb233b",
                                                "text": "[…] Sister Clare saying Oh look a greenfinch and the name was a gift to me as much as the three and a half more minutes the green vision danced and fretted and eagered and preened in front of me […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c68d19a-4a70-3d50-83ae-f77fba3ae4ab",
                                        "entry_id": "53e680a9-66be-3aa6-9c1f-23549e5ab031",
                                        "glosses": [
                                            "To make or encourage to be eager"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d42ccb7-c279-42d0-afb8-a35106c2f464",
                                                "sense_id": "4c68d19a-4a70-3d50-83ae-f77fba3ae4ab",
                                                "text": "Physicians also admit to eagering patients to turn to specialised web sites in order to read further."
                                            },
                                            {
                                                "example_id": "316f3b6b-0409-4bf6-b37e-e70c940b3c76",
                                                "sense_id": "4c68d19a-4a70-3d50-83ae-f77fba3ae4ab",
                                                "text": "But they only eagered him to be off ."
                                            },
                                            {
                                                "example_id": "16a142f6-5201-4572-9772-3c4247636c63",
                                                "sense_id": "4c68d19a-4a70-3d50-83ae-f77fba3ae4ab",
                                                "text": "Its presence gave him no thought of condemnation, but only eagered his longing for the redemption body."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eager",
                                "target_lang_code": "en",
                                "target_senses": [
