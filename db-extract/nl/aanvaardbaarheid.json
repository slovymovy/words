                        "examples": [
                            {
                                "example_id": "af185791-39dc-45f7-832a-a99acb39e322",
                                "sense_id": "fe5ad65e-a4da-30d3-93eb-29427b7b5632",
                                "text": "Dat imponerende onderwerp van zeespiegelstijging wordt zo gereduceerd tot één centimeter extra nattigheid in het jaar 2021 - and that’s it. Dat valt reuze mee. Dat is niet alleen zonde vanwege alle mondiaal beschikbare klimaatwetenschappelijke inzichten die zo ongebruikt in een la bij het KNMI blijven liggen, het geeft ook een sterk vertekend beeld van het eigenlijke 21ste-eeuwse verdrinkingsrisico en dus de aanvaardbaarheid van bodemdaling door delfstoffenwinning."
                            },
                            {
                                "example_id": "05aafc7e-ed4d-474c-b2e4-6d880318bc6a",
                                "sense_id": "fe5ad65e-a4da-30d3-93eb-29427b7b5632",
                                "text": "En terwijl Wilders ooit binnen centrum-rechts begon en van daaruit tot isolement radicaliseerde, maakt Le Pen juist een beweging van de flanken richting centrum en aanvaardbaarheid."
                            },
                            {
                                "example_id": "048b4d60-46a1-4fa8-852d-8461ef81a1ee",
                                "sense_id": "fe5ad65e-a4da-30d3-93eb-29427b7b5632",
                                "text": "Terwijl in de museumwereld het debat woedt over de ethische aanvaardbaarheid van het exposeren van menselijke resten uit het koloniaal verleden, is er een categorie mensen die lichaamsdelen na hun dood juist graag tentoongesteld zouden zien, maar door wettelijke voorschriften worden gedwarsboomd."
                            }
                        ]
