                    {
                        "sense_id": "4f635ed5-ea20-3899-a1f1-800b1a2b605e",
                        "entry_id": "9e4bb7f4-d233-3d9f-9edd-da542377c711",
                        "glosses": [
                            "The propagation of warez by distributing it to various sites."
                        ],
                        "tags": [
                            "Internet",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "392738db-6175-4810-a4cf-ee2e35e94364",
                                "sense_id": "4f635ed5-ea20-3899-a1f1-800b1a2b605e",
                                "text": "If anyone can help me with obtaining a source with an updated ftp list, either distro sites or non ratio sites, please contact me on ICQ […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "03c23145-1bcb-366a-9a7e-c2ce65b249c8",
                        "entry_id": "9e4bb7f4-d233-3d9f-9edd-da542377c711",
                        "glosses": [
                            "The act of distributing printed material such as magazines or newspapers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dd5f11bb-085e-4a5d-aa2a-ca604148212a",
                                "sense_id": "03c23145-1bcb-366a-9a7e-c2ce65b249c8",
                                "text": "I started writing my own zine, Thought Bombs, and organized a distro of other good, anarchist, anti-racist/abolitionist and feminist zines."
                            }
                        ]
                    }
                ],
