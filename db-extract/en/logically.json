                                                "sense_id": "9af5c93f-bfd0-328b-94d5-bc603418414e",
                                                "text": "„Aufgrund dessen muß die Argumentation der Industrieländer als ökonomisch sachlogisch, aber sozialethisch nicht menschengerecht bewertet werden.“"
                                            },
                                            {
                                                "example_id": "7fd05e01-a216-48dc-b0b5-5b049e206198",
                                                "sense_id": "9af5c93f-bfd0-328b-94d5-bc603418414e",
                                                "text": "„Dieses System wird als sachlogisch strukturiertes Kennzahlensystem bezeichnet. Der Unterschied zum Rechensystem liegt im Fehlen der Rechenoperationen zwischen den einzelnen Elementen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
