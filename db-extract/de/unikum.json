                                "target_senses": [
                                    {
                                        "sense_id": "1bc520c6-a78e-3c76-bc8d-27817db6a6d8",
                                        "entry_id": "9ab120ec-4468-3ef5-9b00-d3fcc3c8e0bc",
                                        "glosses": [
                                            "heel bijzondere gebeurtenis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76814850-f7e1-447b-a06e-b62560ca2b21",
                                                "sense_id": "1bc520c6-a78e-3c76-bc8d-27817db6a6d8",
                                                "text": "De fiscale regularisatiegolf van 2013 die België destijds overspoelde en die de begroting veel geld in het laatje bracht, blijft voorlopig een unicum. Terwijl in 2013 nog meer dan 2,2 miljard euro werd opgehaald voor de schatkist, staat de teller in 2017 nog maar op 90 miljoen euro van de - voorzichtig - begrote 200 miljoen euro."
                                            },
                                            {
                                                "example_id": "a4ac0ac8-e9e1-4c15-accf-4febcca18a4a",
                                                "sense_id": "1bc520c6-a78e-3c76-bc8d-27817db6a6d8",
                                                "text": "Eigenaar Fausto Albers heeft in zijn culinaire leven veel kreeften gezien, maar een exemplaar van 8,2 kilo was ook voor hem een unicum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "268057fd-ec26-3fee-a9ae-15a7de354085",
                                        "entry_id": "9ab120ec-4468-3ef5-9b00-d3fcc3c8e0bc",
                                        "glosses": [
                                            "enige exemplaar / enige keer dat iets gebeurt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7a9812-5694-41c8-a444-2e7cacf0a7d1",
                                                "sense_id": "268057fd-ec26-3fee-a9ae-15a7de354085",
                                                "text": "Een bejaarde als volwaardig mens; een rond en geloofwaardig personage - dat was in de populaire cultuur nog een unicum."
                                            },
                                            {
                                                "example_id": "32e3f44d-d7a7-4fa6-b877-43c5712b9fce",
                                                "sense_id": "268057fd-ec26-3fee-a9ae-15a7de354085",
                                                "text": "125 jaar zonder prijs. Geen enkele club heeft langer gewacht dan Vitesse, klonk het hier en daar rond de finale van de KNVB-beker. ‘Ook internationaal een unicum onder profclubs: 125 jaar meedoen, maar geen enkele prijs’, schreef columnist en Vitesse-supporter Marcel van Roosmalen in NRC."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ff8fffc-acc0-4bd4-8ed7-e0d269e68357",
                        "source_entry_id": "c16fdd81-1cef-33cb-802b-058b6b25575b",
