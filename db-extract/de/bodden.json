                            },
                            {
                                "target_word": "bay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e9bc6b7-fa1a-39b2-87de-3870ec2c3ff2",
                                        "entry_id": "5e232306-68fa-31b6-89c2-897e01f6cd72",
                                        "glosses": [
                                            "The excited howling of dogs when hunting or being attacked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dad4e53-4557-4bd0-9b80-5b2d6850bd07",
                                                "sense_id": "8e9bc6b7-fa1a-39b2-87de-3870ec2c3ff2",
                                                "text": "The hunt is up, the morn is bright and grey, / The fields are fragrant, and the woods are green. / Uncouple here, and let us make a bay / And wake the Emperor and his lovely bride, / And rouse the Prince, and ring a hunter's peal, / That all the court may echo with the noise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd260995-345c-3d07-9d41-b865b35a9a94",
                                        "entry_id": "5e232306-68fa-31b6-89c2-897e01f6cd72",
                                        "glosses": [
                                            "The climactic confrontation between hunting-dogs and their prey."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "786785c5-56ee-3740-a156-fc2d34e30c27",
                                        "entry_id": "5e232306-68fa-31b6-89c2-897e01f6cd72",
                                        "glosses": [
                                            "A state of being obliged to face an antagonist or a difficulty, when escape has become impossible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "198cb45b-2bfe-4414-8fe9-d71dad39a9de",
                                                "sense_id": "786785c5-56ee-3740-a156-fc2d34e30c27",
                                                "text": "Embolden'd by despair, he stood at bay."
                                            },
                                            {
                                                "example_id": "07cf05a0-47ac-47cf-8ecb-f1891b07494d",
                                                "sense_id": "786785c5-56ee-3740-a156-fc2d34e30c27",
                                                "text": "The most terrible evils are just kept at bay by incessant efforts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "645b9596-d362-332c-8960-54e6f49872ce",
                                        "entry_id": "0b865ca4-35ff-3b88-acf4-5a3285a9dadb",
                                        "glosses": [
                                            "To howl."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e572699c-0e55-48bf-b040-2d865fe05ad4",
                                                "sense_id": "645b9596-d362-332c-8960-54e6f49872ce",
                                                "text": "The hounds at nearer distance hoarsely bay'd."
                                            },
                                            {
                                                "example_id": "ad188b65-30d7-447f-9654-5393cdbd2723",
                                                "sense_id": "645b9596-d362-332c-8960-54e6f49872ce",
                                                "text": "For at the last shall the thunder, fleeing to escape from the doom of the gods, roar horribly among the Worlds; and Time, the hound of the gods, shall bay hungrily at his masters because he is lean with age."
                                            },
                                            {
                                                "example_id": "1884a0f0-9f4b-4530-a157-15cdb18ade5a",
                                                "sense_id": "645b9596-d362-332c-8960-54e6f49872ce",
                                                "text": "The scene was rocking, all were digging the sounds\nIgor on chains, backed by his baying hounds\nThe coffin-bangers were about to arrive\nWith their vocal group, The Crypt-Kicker Five."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28f02aaf-0d55-3dd3-952e-f7a821dae20b",
