                ],
                "senses": [
                    {
                        "sense_id": "9ff2781a-9305-3807-88d8-bee4ccf1cd5c",
                        "entry_id": "756f584b-8059-32a2-82e1-86a0cedc934b",
                        "glosses": [
                            "Vivre en commun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98256ad0-edd9-41b1-baef-8a98d4eadcc0",
                                "sense_id": "9ff2781a-9305-3807-88d8-bee4ccf1cd5c",
                                "text": "L'Inde reste toute à dire et à covivre, comme tout à l'heure l'Afrique."
                            },
                            {
                                "example_id": "511eaba0-3185-4107-a52c-8e5c928d7530",
                                "sense_id": "9ff2781a-9305-3807-88d8-bee4ccf1cd5c",
                                "text": "Et si tout est surdimensionné, il suffit d'introduire des compagnons pour partager et covivre."
                            },
                            {
                                "example_id": "cfa3aece-f3d2-492e-9ab9-0861d15aef8a",
                                "sense_id": "9ff2781a-9305-3807-88d8-bee4ccf1cd5c",
                                "text": "Même si ce comportement est conservateur sachant que je suis moderniste et progressiste on peut covivre avec lui"
                            }
                        ]
                    }
