                                    {
                                        "sense_id": "abe9b65c-f270-3b31-a201-37d888649a30",
                                        "entry_id": "e5e9c9e0-48ef-3014-a6d5-5318a1c7e1b4",
                                        "glosses": [
                                            "landwirtschaftliches Gerät, das automatisch dreschen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77f991f4-5f4f-497a-95af-76ff80fcb807",
                                                "sense_id": "abe9b65c-f270-3b31-a201-37d888649a30",
                                                "text": "„Da übernahm Rose sich bei der Dreschmaschine, bekam einen Ohnmachtsanfall, hatte drei Tage lang eine krause Stirn, trank sich, als er in Howe zu tun hatte, bis oben hin voll und verschlief zwei Nächte.“"
                                            },
                                            {
                                                "example_id": "ad8771ca-bdbf-4179-9e31-80edb263bf0f",
                                                "sense_id": "abe9b65c-f270-3b31-a201-37d888649a30",
                                                "text": "„Er schafft einen Göpel und eine Dreschmaschine an und setzt auf seinem Ausbauernhof das Flegeldreschen außer Kraft.“"
                                            },
                                            {
                                                "example_id": "e5c23d99-348b-4c09-aaad-9a59b03055f1",
                                                "sense_id": "abe9b65c-f270-3b31-a201-37d888649a30",
                                                "text": "„Die Pflüge und Eggen, die Drill- und die Dreschmaschinen, die Selbstbinder zur Ernte und die Traktoren verschwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
