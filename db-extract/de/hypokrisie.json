                                "target_senses": [
                                    {
                                        "sense_id": "8547429c-1779-3228-9453-bb10cae0732c",
                                        "entry_id": "e1de1451-125e-37c2-bc23-56a9bb147691",
                                        "glosses": [
                                            "Vice consistant à s'attribuer une vertu, une croyance ou une opinion, une piété ou un sentiment noble que l'on n'a pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c208782-28a5-42dd-97e1-75db5227c6ba",
                                                "sense_id": "8547429c-1779-3228-9453-bb10cae0732c",
                                                "text": "L’hypocrisie est un hommage que le vice rend à la vertu."
                                            },
                                            {
                                                "example_id": "a6a973c8-2e31-400e-a438-b4f6b91199da",
                                                "sense_id": "8547429c-1779-3228-9453-bb10cae0732c",
                                                "text": "Une pareille entreprise est une insanité ; aussi aboutit-elle à des équivoques, quand elle n'oblige pas les députés à des attitudes d'une déplorable hypocrisie."
                                            },
                                            {
                                                "example_id": "b111cee5-7269-498c-ac99-3597c4500bd9",
                                                "sense_id": "8547429c-1779-3228-9453-bb10cae0732c",
                                                "text": "Arsène André perçait enfin la brume de ce préambule. Ah ! ah ! l'hypocrisie hargneuse le circonvenait comme un filet de chasse ; […]."
                                            },
                                            {
                                                "example_id": "890bbe5e-00ed-4ec4-8e60-b5bd649ed715",
                                                "sense_id": "8547429c-1779-3228-9453-bb10cae0732c",
                                                "text": "Il fait l’homme de bien, mais toute sa conduite n’est qu’hypocrisie."
                                            },
                                            {
                                                "example_id": "99dff370-965e-419a-91e3-268350cd8a17",
                                                "sense_id": "8547429c-1779-3228-9453-bb10cae0732c",
                                                "text": "En politique l’hypocrisie est un art."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee0d564d-fcea-366f-b9e5-29b520eb8c00",
                                        "entry_id": "e1de1451-125e-37c2-bc23-56a9bb147691",
                                        "glosses": [
                                            "Vice consistant à s'attribuer une vertu, une croyance ou une opinion, une piété ou un sentiment noble que l'on n'a pas.",
                                            "(sens large) Fait de s'attribuer faussement des valeurs ou pratiques morales."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7caaff77-cb44-30cd-a557-43139356d111",
                                        "entry_id": "e1de1451-125e-37c2-bc23-56a9bb147691",
                                        "glosses": [
                                            "Vice consistant à s'attribuer une vertu, une croyance ou une opinion, une piété ou un sentiment noble que l'on n'a pas.",
                                            "Critique d'autrui fondée sur une valeur que l'on contredit soi-même."
