                                "target_senses": [
                                    {
                                        "sense_id": "d805035a-a031-3580-a419-60de15f5925d",
                                        "entry_id": "5ee941ae-d6ac-3956-8eb2-8ee915e3dbde",
                                        "glosses": [
                                            "Person, die sich in politischen Gremien für die Interessen einer Gruppe, meist eines wirtschaftlichen Unternehmens, einsetzt/stark macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8658a6-94c9-40f8-896e-cce1949caf06",
                                                "sense_id": "d805035a-a031-3580-a419-60de15f5925d",
                                                "text": "„Aus dem Fußballspieler ist ein Geschäftsmann und Lobbyist mit großen Plänen und vielen Millionen Investmentkapital geworden.“"
                                            }
