                "senses": [
                    {
                        "sense_id": "c85d343d-f849-3b8d-94dc-268d06657358",
                        "entry_id": "9fbbb84c-512b-3d12-b885-f45f6a6c791c",
                        "glosses": [
                            "Ausdruck einer Aktion oder eines Zustandes, der nicht tatsächlich, sondern hypothetisch und in einer alternativen Wirklichkeit möglich ist. Insbesondere in romanischen Sprachen hat der Subjunktiv eine vom Konjunktiv abweichende Bedeutung und Funktion (siehe etwa für Französisch, Spanisch)."
                        ],
                        "tags": [
                            "Modus"
                        ],
                        "examples": [
                            {
                                "example_id": "d0ded430-ed19-4e8f-a447-d0233b24730b",
                                "sense_id": "c85d343d-f849-3b8d-94dc-268d06657358",
                                "text": "Im Deutschen hat der Subjunktiv keine vom Konjunktiv verschiedene Bedeutung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
