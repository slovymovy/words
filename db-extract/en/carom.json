                        "form": "caroms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3992032-6d46-31e6-9cd8-8a6391411010",
                        "entry_id": "1b7a3bc7-b032-3083-a1eb-a7ffb9d055e0",
                        "glosses": [
                            "A shot in which the ball struck with the cue comes in contact with two or more balls on the table; a hitting of two or more balls with the player's ball."
                        ],
                        "tags": [
                            "countable",
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e40e60f3-5ee3-38a5-a71a-a73fa28d3f07",
                        "entry_id": "1b7a3bc7-b032-3083-a1eb-a7ffb9d055e0",
                        "glosses": [
                            "A billiard-like Indian game in which players take turns flicking checker-like pieces into one of four goals on the corners of a board measuring one meter by one meter."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f95c72a9-08d6-4ab6-97ea-ce6cc96401fe",
                                "sense_id": "e40e60f3-5ee3-38a5-a71a-a73fa28d3f07",
                                "text": "He loved playing carrom in his free time."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b54ce9c3-23dc-4475-8b71-ad431ecf21ac",
                        "source_entry_id": "1b7a3bc7-b032-3083-a1eb-a7ffb9d055e0",
                        "source_sense_description": "shot in which the cue ball strikes two balls",
                        "target_lang_word": "карамбо́ль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "карамбо́ль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3ea8bb41-d680-3891-9f42-0018aaa76a54",
                                        "entry_id": "70c4fd8f-6eb0-3564-8e0a-1fe2de8c5f48",
                                        "glosses": [
                                            "игр. разновидность игры на бильярде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc639dbd-6539-48dc-b0ec-d2c30e20bd47",
                                                "sense_id": "3ea8bb41-d680-3891-9f42-0018aaa76a54",
                                                "text": "Оказывается, на сегодняшний день существует порядка тридцати различных видов игры на бильярде. Можно разделить их на пять больших групп: русский бильярд, спортивный пул, развлекательный пул, снукер и карамболь."
                                            },
                                            {
                                                "example_id": "a6bac1e7-4cea-46db-90b4-a474e4d4232e",
                                                "sense_id": "3ea8bb41-d680-3891-9f42-0018aaa76a54",
                                                "text": "Минут десять он смотрел, как двое людей с лицами наркоманов играли в карамболь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64befbb1-cd2b-39a0-a962-3a2a16568f24",
                                        "entry_id": "70c4fd8f-6eb0-3564-8e0a-1fe2de8c5f48",
                                        "glosses": [
                                            "игр. удар, при котором биток (шар, по которому нанесён удар) совершает последовательное соударение с двумя прицельными шарами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1af17ca3-4c0d-4531-93a6-2b43e1e78572",
                                                "sense_id": "64befbb1-cd2b-39a0-a962-3a2a16568f24",
                                                "text": "Положив заказанный шар в лузу, игрок имеет возможность добавить на свой счёт очки за карамболь — столкновение битка с другим шаром."
                                            },
                                            {
                                                "example_id": "9074d02a-1589-4677-8cf3-d6d653cdc53d",
                                                "sense_id": "64befbb1-cd2b-39a0-a962-3a2a16568f24",
                                                "text": "Он сделал три карамболя, отведя шар противника в противоположный угол, и уступил место Энниоку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eed3aa7f-7e32-3bc0-99f6-74bb6e463683",
                                        "entry_id": "70c4fd8f-6eb0-3564-8e0a-1fe2de8c5f48",
                                        "glosses": [
                                            "устар. столкновение, скандал, происшествие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c585fb9-7326-421d-8ae7-7a05ed5258e7",
                                                "sense_id": "eed3aa7f-7e32-3bc0-99f6-74bb6e463683",
                                                "text": "Я со смехом заметил, что карамболь совершенно случайных происшествий, толкнувших меня в самый центр загадки, представляется теперь удивительнее её самой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
