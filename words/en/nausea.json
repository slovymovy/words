{
    "word_family": [
        "nauseate",
        "nauseous",
        "nauseating"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94a9426d-31b1-3685-92b1-ab98e9d3320e",
                    "sense_definition": "A feeling of illness or discomfort in the stomach, often with an urge to vomit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong smell of the chemicals caused immediate <w>nausea</w>.",
                            "target_lang_translations": {
                                "ru": "Резкий запах химикатов вызвал мгновенную <w>тошноту</w>."
                            }
                        },
                        {
                            "text": "She felt a wave of <w>nausea</w> after eating the spoiled food.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала приступ <w>тошноты</w> после того, как съела испорченную еду."
                            }
                        }
                    ],
                    "synonyms": [
                        "queasiness",
                        "sickness"
                    ],
                    "common_phrases": [
                        "severe nausea",
                        "feeling of nausea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тягостное ощущение в подложечной области и глотке, часто предшествующее рвоте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тошнота́",
                                "target_lang_sense_clarification": "физическое ощущение недомогания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac388313-ac57-3bc1-adb1-98b49ecda0d4",
                    "sense_definition": "A feeling of illness caused by the movement of a vehicle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winding roads on the mountain trip caused terrible <w>nausea</w>.",
                            "target_lang_translations": {
                                "ru": "Извилистые горные дороги вызвали ужасную <w>тошноту</w>."
                            }
                        },
                        {
                            "text": "He took medicine to prevent <w>nausea</w> during the long boat ride.",
                            "target_lang_translations": {
                                "ru": "Он принял лекарство, чтобы предотвратить <w>тошноту</w> во время долгой поездки на лодке."
                            }
                        }
                    ],
                    "synonyms": [
                        "motion sickness"
                    ],
                    "common_phrases": [
                        "travel nausea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Болезненное состояние, вызванное укачиванием в транспорте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тошнота́",
                                "target_lang_sense_clarification": "при укачивании"
                            },
                            {
                                "target_lang_word": "морская болезнь",
                                "target_lang_sense_clarification": "специфическое состояние при качке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c749975e-9185-36d7-bf22-157f94222cdb",
                    "sense_definition": "A feeling of intense dislike or disgust.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a sense of <w>nausea</w> when he heard about the cruel treatment of the animals.",
                            "target_lang_translations": {
                                "ru": "Он испытал чувство <w>отвращения</w>, когда услышал о жестоком обращении с животными."
                            }
                        },
                        {
                            "text": "The corruption in the government filled the citizens with <w>nausea</w>.",
                            "target_lang_translations": {
                                "ru": "Коррупция в правительстве вызывала у граждан <w>отвращение</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disgust",
                        "revulsion",
                        "loathing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство сильной неприязни, отвращения или омерзения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвраще́ние",
                                "target_lang_sense_clarification": "крайняя неприязнь"
                            },
                            {
                                "target_lang_word": "омерзе́ние",
                                "target_lang_sense_clarification": "сильное чувство гадливости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}