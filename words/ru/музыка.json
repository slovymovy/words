{
    "word_family": [
        "музыкант",
        "музыкальный",
        "музицировать",
        "музыковед",
        "музыкальность"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23de46ae-5b93-35ac-aaa7-6faf6d914d8b",
                    "sense_definition": "Вид искусства, в котором художественные образы создаются с помощью ритмически организованных звуков.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "music_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В детстве я ходил в специальную школу, где изучал <музыку> и живопись.",
                            "target_lang_translations": {
                                "en": "In childhood, I went to a special school where I studied <music> and painting.",
                                "zh": "我小时候上过一所专门学校，在那里学习<w>音乐</w>和绘画。"
                            }
                        },
                        {
                            "text": "Мой брат очень любит классическую <музыку> и часто посещает концерты.",
                            "target_lang_translations": {
                                "en": "My brother loves classical <music> very much and often attends concerts.",
                                "zh": "我哥哥非常喜欢古典<w>音乐</w>，经常去听音乐会。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "классическая музыка",
                        "учитель музыки",
                        "история музыки",
                        "любить музыку"
                    ],
                    "target_lang_definitions": {
                        "en": "An art form in which artistic images are created using rhythmically organized sounds.",
                        "zh": "一种通过有节奏的组织声音来创造艺术形象的艺术形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "music",
                                "target_lang_sense_clarification": "art form"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "音乐",
                                "target_lang_sense_clarification": "艺术形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba2f7817-b050-3099-9093-686741bc5239",
                    "sense_definition": "Звучание инструментов или голоса; исполняемое музыкальное произведение или композиция.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "music_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из открытого окна соседей доносилась громкая и весёлая <музыка>.",
                            "target_lang_translations": {
                                "en": "Loud and cheerful <music> drifted from the neighbors' open window.",
                                "zh": "邻居敞开的窗户里传出了响亮而欢快的<w>音乐</w>。"
                            }
                        },
                        {
                            "text": "Мы весь вечер танцевали под быструю <музыку> на дне рождения друга.",
                            "target_lang_translations": {
                                "en": "We danced to fast <music> all evening at my friend's birthday party.",
                                "zh": "在朋友的生日派对上，我们整晚都在快节奏的<w>音乐</w>中跳舞。"
                            }
                        }
                    ],
                    "synonyms": [
                        "мелодия",
                        "композиция"
                    ],
                    "antonyms": [
                        "сумбур"
                    ],
                    "common_phrases": [
                        "слушать музыку",
                        "громкая музыка",
                        "танцевать под музыку",
                        "писать музыку"
                    ],
                    "target_lang_definitions": {
                        "en": "The sound of instruments or voices; a musical work or composition being performed.",
                        "zh": "乐器或人声发出的声音；正在演奏的乐曲或作品。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "music",
                                "target_lang_sense_clarification": "sound or composition"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "音乐",
                                "target_lang_sense_clarification": "声音或作品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1604972a-7bb9-3849-a4c2-34a1bc14522d",
                    "sense_definition": "Группа музыкантов, оркестр (обычно духовой).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В городском парке по выходным всегда играла духовая <музыка>.",
                            "target_lang_translations": {
                                "en": "A brass <band> always played in the city park on weekends.",
                                "zh": "周末的城市公园里总有<w>乐队</w>在演奏。"
                            }
                        },
                        {
                            "text": "Когда полковая <музыка> заиграла марш, солдаты выстроились на плацу.",
                            "target_lang_translations": {
                                "en": "When the regimental <band> struck up a march, the soldiers lined up on the parade ground.",
                                "zh": "当军乐团奏响进行曲时，士兵们在操场上排好了队。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "полковая музыка",
                        "играет музыка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A group of musicians, an orchestra (usually brass).",
                        "zh": "一组音乐家，通常指管乐队。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "band",
                                "target_lang_sense_clarification": "group of musicians"
                            },
                            {
                                "target_lang_word": "orchestra",
                                "target_lang_sense_clarification": "group of musicians"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乐队",
                                "target_lang_sense_clarification": "音乐家团体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cb489a3-30c3-3312-9d99-eabac1e3063d",
                    "sense_definition": "Гармоничное, приятное для слуха звучание (в переносном смысле).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В её тихом и спокойном голосе слышалась настоящая <музыка>.",
                            "target_lang_translations": {
                                "en": "Real <music> could be heard in her quiet and calm voice.",
                                "zh": "她那安静平和的声音听起来简直是<w>天籁</w>。"
                            }
                        },
                        {
                            "text": "Для меня шум дождя за окном — это лучшая <музыка> для сна.",
                            "target_lang_translations": {
                                "en": "For me, the sound of rain outside the window is the best <music> for sleeping.",
                                "zh": "对我来说，窗外的雨声是最好的助眠<w>音乐</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "музыка речи",
                        "музыка голоса"
                    ],
                    "target_lang_definitions": {
                        "en": "Harmonious sound pleasing to the ear (figuratively).",
                        "zh": "比喻和谐、悦耳的声音。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "music",
                                "target_lang_sense_clarification": "figurative: pleasant sound"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天籁",
                                "target_lang_sense_clarification": "比喻美妙的声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c5ce9f3-a39f-31c5-ad34-6046e05f2935",
                    "sense_definition": "Какое-либо дело, история или неприятная ситуация.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Если ты сейчас уйдёшь, то испортишь нам всю <музыку>.",
                            "target_lang_translations": {
                                "en": "If you leave now, you'll spoil the whole <thing> for us.",
                                "zh": "如果你现在走，就会把我们这整件<w>事</w>都搞砸。"
                            }
                        },
                        {
                            "text": "Эта долгая <музыка> с оформлением документов длится уже целый месяц.",
                            "target_lang_translations": {
                                "en": "This long <business> with the paperwork has been dragging on for a whole month.",
                                "zh": "办理文件的这档子<w>麻烦事</w>已经拖了一个月了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "испортить музыку",
                        "долгая музыка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Some business, story, or unpleasant situation.",
                        "zh": "指某项事务、过程或令人不快的局面。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "business",
                                "target_lang_sense_clarification": "colloquial: situation or affair"
                            },
                            {
                                "target_lang_word": "affair",
                                "target_lang_sense_clarification": "colloquial: situation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "麻烦",
                                "target_lang_sense_clarification": "口语：令人不快的局面"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "be7d623e-4f17-331e-b7f1-b545d024571b",
                    "sense_definition": "Украинская фамилия.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Гражданин <Музыка> был приглашён в кабинет директора для подписания договора.",
                            "target_lang_translations": {
                                "en": "Citizen <Muzyka> was invited to the director's office to sign the contract.",
                                "zh": "<w>穆济卡</w>先生被请到经理办公室签署合同。"
                            }
                        },
                        {
                            "text": "В списке новых сотрудников значился инженер по фамилии <Музыка>.",
                            "target_lang_translations": {
                                "en": "The list of new employees included an engineer with the surname <Muzyka>.",
                                "zh": "新员工名单里有一位姓<w>穆济卡</w>的工程师。"
                            }
                        }
                    ],
