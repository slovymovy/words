                        "examples": [
                            {
                                "example_id": "d61167f1-e882-458d-8b90-b82fbc27635e",
                                "sense_id": "ce0a0377-d63a-3815-8869-79c2fda4da1b",
                                "text": "Étirable, tordable, suçable, le caramel mou dure le temps qu’il faut pour poisser les doigts et coller aux quenottes les plus saines."
                            },
                            {
                                "example_id": "60d5b2b3-f1c4-4ed4-9e7d-85e0eaff2ad8",
                                "sense_id": "ce0a0377-d63a-3815-8869-79c2fda4da1b",
                                "text": "Son indiscrétion^([au maringouin]) dépasse toute mesure et le corps humain est pour lui piquable, mordable, suçable en toutes ses parties. Rien ne l'arrête, ni le sommeil de l'innocence, ni le repos troublé du crime. Il mord , pique et suce toujours."
                            },
                            {
                                "example_id": "233dc064-2f74-4b7c-9969-a4108233a922",
                                "sense_id": "ce0a0377-d63a-3815-8869-79c2fda4da1b",
                                "text": "Il a un corps sublime. Il a une bite sublime difficilement suçable pour ne pas lui faire de mal."
                            }
                        ]
                    }
