                        "entry_id": "7b342280-33ff-3694-9af5-2a9a6a3337a7",
                        "glosses": [
                            "Levant, relatif à l’orient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e768f635-2257-4ccd-a28a-3b79682a92dc",
                                "sense_id": "52e93558-b521-3dc7-8873-76b68ca19548",
                                "text": "Amplitude ortive, arc de l’horizon qui est entre le point où se lève un astre et l’orient vrai où se fait l’intersection de l’horizon et de l’équateur."
                            },
                            {
                                "example_id": "f21d596a-fce8-438b-bb7a-498b42f00697",
                                "sense_id": "52e93558-b521-3dc7-8873-76b68ca19548",
                                "text": "Le plus grand azimuth est de 90°, lorsque le soleil passe au zénith : il diminue, à mesure que la hauteur méridienne diminue : enfin , il est égal à l'azimuth ortif ou occase, lorsque la latitude est zéro."
                            }
                        ]
                    }
