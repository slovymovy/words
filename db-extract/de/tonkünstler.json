                        "form": "den Tonkünstlern"
                    },
                    {
                        "form_id": "d9b97212-b175-40b6-bd8b-4a1235b9bc11",
                        "entry_id": "3929a032-88f4-3767-890a-d2b308eec7f3",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Tonkünstler"
                    },
                    {
                        "form_id": "bc16678d-ca4f-42d9-b7af-c8b587d57580",
                        "entry_id": "3929a032-88f4-3767-890a-d2b308eec7f3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Tonkünstler"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5301100-ef60-3f15-9a33-72a728f8b013",
                        "entry_id": "3929a032-88f4-3767-890a-d2b308eec7f3",
                        "glosses": [
                            "Künstler, der musikalische Werke schafft"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "f584ffe0-6ae5-4c4e-9d37-9d56fc8b71bd",
                                "sense_id": "a5301100-ef60-3f15-9a33-72a728f8b013",
                                "text": "„Der Tonkünstler orientierte sich in seinem Schaffen an Johannes Brahms, Felix Mendelssohn-Bartholdy, Robert Schumann und Wolfgang Amadeus Mozart.“"
                            },
                            {
                                "example_id": "bc3497ab-cd08-44ad-9620-c6c6ba857652",
                                "sense_id": "a5301100-ef60-3f15-9a33-72a728f8b013",
                                "text": "„Dafür wird er dann aber auch mit größtmöglicher künstlerischer Ernsthaftigkeit seitens der Tonkünstler und ihres Kapellmeisters belohnt.“"
                            },
                            {
                                "example_id": "975cb632-c411-4486-8139-43571c47e09c",
                                "sense_id": "a5301100-ef60-3f15-9a33-72a728f8b013",
                                "text": "„Während sich der Tonkünstler über Fragen der Besetzung ausließ, vor allem über die vier Gesangssolisten, warf der Archivar Leonhard einen fragenden Blick zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6efb6441-e88d-363e-8e91-f9fa952754be",
                        "entry_id": "3929a032-88f4-3767-890a-d2b308eec7f3",
                        "glosses": [
                            "besonders begabter Musiker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c220031-acc0-49db-b764-f0d7645c54e3",
                                "sense_id": "6efb6441-e88d-363e-8e91-f9fa952754be",
                                "text": "„Während sich der Tonkünstler über Fragen der Besetzung ausließ, vor allem über die vier Gesangssolisten, warf der Archivar Leonhard einen fragenden Blick zu.“"
                            },
                            {
                                "example_id": "54485ff0-0587-4f76-b8fd-e2a5bf86ad11",
                                "sense_id": "6efb6441-e88d-363e-8e91-f9fa952754be",
                                "text": "„Des kühlen Wetters wegen war das Auftakt-Konzert in den Richard-Strauss-Saal verlegt worden, doch etwa 150 Gäste waren begeistert und belohnten die Arbeit der Tonkünstler mit minutenlang rauschendem Beifall.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
