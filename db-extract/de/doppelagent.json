                "senses": [
                    {
                        "sense_id": "60f3146b-e3c0-3d0c-9412-88d62f56de26",
                        "entry_id": "432def4f-6e10-30d0-9ea5-e298b06060c8",
                        "glosses": [
                            "für zwei gegeneinander arbeitende Nachrichtendienste tätige Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cc1daaf-6ee6-46eb-ad5f-0e991d0aba18",
                                "sense_id": "60f3146b-e3c0-3d0c-9412-88d62f56de26",
                                "text": "„Die Psychologie des Agenten, zumal des Doppelagenten, wäre das wichtigste Kapitel der heutigen politischen Psychologie.“"
                            },
                            {
                                "example_id": "b513655d-e0fe-4d32-ae3e-4d176e3a6f73",
                                "sense_id": "60f3146b-e3c0-3d0c-9412-88d62f56de26",
                                "text": "„Die doppelte Null bekam ich wegen eines toten Japaners, der in New York als Code-Fachmann arbeitete, und wegen eines norwegischen Doppelagenten in Stockholm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
