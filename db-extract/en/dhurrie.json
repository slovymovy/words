                        "examples": [
                            {
                                "example_id": "ec365bfd-2753-468a-9a68-0389c688c0bc",
                                "sense_id": "99c648e2-ec4b-3b4b-a3e2-4b4a83f93266",
                                "text": "The eye-flies had colonized the top of an almeira; the red stains on the durry were thicker, for Mohammed Latif had slept here during his imprisonment and spat a good deal […]."
                            },
                            {
                                "example_id": "02c0118d-ae86-4749-85cb-7452f155f6dd",
                                "sense_id": "99c648e2-ec4b-3b4b-a3e2-4b4a83f93266",
                                "text": "They were hospitable and loved company We sat on a dhurrie under the open sky."
                            },
