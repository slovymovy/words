                        "glosses": [
                            "An immature ovum in mammals."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a8f9bbc-7f03-4fd5-a763-a538a47cca3c",
                        "source_entry_id": "5bf5ab06-2f43-39d3-a455-100af9b6e8df",
                        "source_sense_description": "botany: structure that develops into a seed",
                        "target_lang_word": "zaadknop",
