                                "example_id": "f8ba5644-5753-484c-8ff7-ac16f10505f9",
                                "sense_id": "c9907d22-74a2-3a05-aa05-232ac453c528",
                                "text": "„Unmengen von Schiffen begegnen uns; nicht selten kann man sie im Blick stromauf und stromab gleich im Dutzend zählen.“"
                            },
                            {
                                "example_id": "08963eb6-7dcb-4ef5-99b3-3dd847cfce2f",
                                "sense_id": "c9907d22-74a2-3a05-aa05-232ac453c528",
                                "text": "Spittal liegt an der Drau stromauf von Villach, also näher an der Quelle."
                            },
                            {
                                "example_id": "0159a802-fd6a-41df-bdd6-caaa76353b14",
                                "sense_id": "c9907d22-74a2-3a05-aa05-232ac453c528",
                                "text": "Vor der Entwicklung von Motorantrieben musste man Schiffe stromauf meist treideln."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
