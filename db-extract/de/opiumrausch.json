                "senses": [
                    {
                        "sense_id": "e759a036-677f-3b64-adb2-31541b04e8c1",
                        "entry_id": "e15d109c-d013-3045-a83a-cfeca210225a",
                        "glosses": [
                            "Rausch, der auf Opiumkonsum zurückzuführen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd6dc205-2b66-4929-aea0-9ef2cbe4fcd3",
                                "sense_id": "e759a036-677f-3b64-adb2-31541b04e8c1",
                                "text": "„Eine solche Szenerie hatte ich nie zuvor gesehen, und auch kein Lebender kann sie je gesehen haben, außer im Fieberdelirium oder in der Hölle des Opiumrausches.“"
                            },
                            {
                                "example_id": "c33d13d9-d91b-4315-9390-a8ed60d322df",
                                "sense_id": "e759a036-677f-3b64-adb2-31541b04e8c1",
                                "text": "„Den Weg zurück nach Hause habe ich nur undeutlich, verschwommen in Erinnerung, wie jemand, der im Opiumrausch umherstreift; hinter mir sang die Melodie von den Herrlichkeiten, die mir entgangen waren, von dem kurzen Augenblick flammenden Vergehens, den zu erfahren besser sei, als äonenlang als Sterblicher zu leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
