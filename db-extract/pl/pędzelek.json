                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c7dca494-af26-31bf-b2a4-db5779efe5ac",
                        "entry_id": "f5b01782-2b75-3fd9-89c9-fd9c673efec1",
                        "glosses": [
                            "mały pędzel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aade1e28-1f5b-4b7f-9000-0d725b75b8ee",
                                "sense_id": "c7dca494-af26-31bf-b2a4-db5779efe5ac",
                                "text": "A gdy służąca uciekła, jej pani rzuciła się gorączkowo do swej tualety i otworzywszy parę słoików za pomocą pędzelka umalowała sobie twarz na różowy kolor."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "7a453323-0f8f-3307-a9ed-9c6066ebf6ee",
                        "entry_id": "f5b01782-2b75-3fd9-89c9-fd9c673efec1",
                        "glosses": [
                            "zakończenie uszu niektórych zwierząt w formie kępki włosów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4ad0339-5393-4325-b6d3-290fabf31b75",
                        "source_entry_id": "f5b01782-2b75-3fd9-89c9-fd9c673efec1",
                        "source_sense_id": "7a453323-0f8f-3307-a9ed-9c6066ebf6ee",
                        "target_lang_word": "tuft of hair",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "74bb3133-d62b-47bb-b251-05967ac3266a",
                        "source_entry_id": "f5b01782-2b75-3fd9-89c9-fd9c673efec1",
                        "source_sense_id": "7a453323-0f8f-3307-a9ed-9c6066ebf6ee",
                        "target_lang_word": "Haarbüschel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haarbüschel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c974c723-3a2a-3a02-8411-2558421a0317",
                                        "entry_id": "4e1db8e6-b14d-37c5-ba53-92049db5c6d7",
                                        "glosses": [
                                            "gebündelte oder miteinander verwachsene, relativ kleine Menge von Haaren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2ab4f67-5ea2-46bc-b348-8db402dfea8c",
                                                "sense_id": "c974c723-3a2a-3a02-8411-2558421a0317",
                                                "text": "„Die Kugel stutzte ihm ein Haarbüschel, und das war mehr als ausreichend, um den Bader, den Arzt und alle übrigen Anwesenden zu vertreiben.“"
                                            },
                                            {
                                                "example_id": "69217514-ee10-4e5e-8152-baae11349261",
                                                "sense_id": "c974c723-3a2a-3a02-8411-2558421a0317",
                                                "text": "„Schon bei seiner ersten Begegnung war Robert das weiße Haarbüschel aufgefallen, das wie eine gedrehte Locke über der emporsteigenden Stirn stand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50f5175a-5c91-47f9-be7c-a78b2e68ade2",
                        "source_entry_id": "f5b01782-2b75-3fd9-89c9-fd9c673efec1",
                        "source_sense_id": "c7dca494-af26-31bf-b2a4-db5779efe5ac",
                        "target_lang_word": "кисточка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кисточка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ef6cd3d9-a1d6-3fe0-8cc6-0ee818f03ac1",
                                        "entry_id": "c974a2ac-df16-3734-8fae-25f41560ebd0",
                                        "glosses": [
                                            "уменьш.-ласк. к кисть, маленькая кисть"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adece953-aff0-4450-a8bb-d596cf3a1d73",
                                                "sense_id": "ef6cd3d9-a1d6-3fe0-8cc6-0ee818f03ac1",
                                                "text": "На верхушке завязи найдём маленькую кисточку, состоящую из тончайших волосков, поднятых кверху."
                                            },
                                            {
                                                "example_id": "f8cc8990-08a2-4982-ad45-7926c95ab87b",
                                                "sense_id": "ef6cd3d9-a1d6-3fe0-8cc6-0ee818f03ac1",
                                                "text": "Детей так много, что у Динки пестрит в глазах от их платьиц, рубашонок и вязанных, как чулок, с яркими полосками и с кисточками на концах, цветных фесок."
                                            },
                                            {
                                                "example_id": "3c47e23d-9192-4767-a572-0cb4c0cc231a",
                                                "sense_id": "ef6cd3d9-a1d6-3fe0-8cc6-0ee818f03ac1",
                                                "text": "Лариса клеила стульчики, рисовала тонкой кисточкой узоры на стенах, шила маленькие подушечки и раскладывала их на картонном диване."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6736ef9e-7f7e-3882-a70b-d3d9488e2367",
                                        "entry_id": "c974a2ac-df16-3734-8fae-25f41560ebd0",
                                        "glosses": [
                                            "пучок шерсти на конце хвоста"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0cfdfe8-85bd-4b05-818e-0246a5afea30",
                                                "sense_id": "6736ef9e-7f7e-3882-a70b-d3d9488e2367",
                                                "text": "С одного взгляда тушканчик обрисовался весь — от головы до кисточки на хвосте."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
