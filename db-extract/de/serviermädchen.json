                "senses": [
                    {
                        "sense_id": "1981d7b5-84d7-3ac1-98db-07481cbf1475",
                        "entry_id": "d2170f08-c046-3ea2-93da-d10ddeff8613",
                        "glosses": [
                            "weibliche Person, die mit dem Auftragen von Speisen und Getränken beschäftigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d3bffaf-1340-4b26-bca2-187f88ec43e3",
                                "sense_id": "1981d7b5-84d7-3ac1-98db-07481cbf1475",
                                "text": "„Zwei weitere Serviermädchen erschienen, balancierten Platten mit Braten, so klein, dass Astrids Vater davon sieben auf einen Streich hätte verputzen können.“"
                            },
                            {
                                "example_id": "0d2b12c5-dd83-4608-a902-1725696aaea8",
                                "sense_id": "1981d7b5-84d7-3ac1-98db-07481cbf1475",
                                "text": "„Sie warf ihre Handtasche auf den Stuhl, auf dem noch ein Schuhkarton von der Frau mit dem hellblauen Mantel lag – und die Frau mit dem hellblauen Mantel nahm kopfschüttelnd ihren Karton und ging hinter ihrem Mann her, der zwischen den Tischen stand und dem Serviermädchen die Zeche bezahlte.“"
                            },
                            {
                                "example_id": "67c17b92-cd38-4d7d-93b6-10e852bf351a",
                                "sense_id": "1981d7b5-84d7-3ac1-98db-07481cbf1475",
                                "text": "„Um Mitternacht konnten die Serviermädchen in der Küche erzählen, daß die Männer jetzt angefangen hätten, sie zu begrapschen, wenn sie ihnen die Gläser nachfüllten.“"
                            },
                            {
                                "example_id": "12c292fa-29a9-476b-80fd-7485c7e938b8",
                                "sense_id": "1981d7b5-84d7-3ac1-98db-07481cbf1475",
                                "text": "„Thomas ging in die Küche, um nach Bastian, dem Serviermädchen und dem Rehrücken zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
