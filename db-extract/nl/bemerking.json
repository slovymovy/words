                                ]
                            },
                            {
                                "target_word": "comment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f9e2fca-5385-34e9-9316-3491b6322d28",
                                        "entry_id": "1308ba6e-d562-3325-8797-e7edefc280de",
                                        "glosses": [
                                            "To remark."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8cc5ca5-fc08-47c1-b06a-43d9c69bac40",
                                                "sense_id": "6f9e2fca-5385-34e9-9316-3491b6322d28",
                                                "text": "“My Continental prominence is improving,” I commented dryly. ¶ Von Lindowe cut at a furze bush with his silver-mounted rattan. ¶ “Quite so,” he said as dryly, his hand at his mustache. “I may say if your intentions were known your life would not be worth a curse.”"
                                            },
                                            {
                                                "example_id": "5a2f8b89-e6fc-4877-ad80-d2b492a235d0",
                                                "sense_id": "6f9e2fca-5385-34e9-9316-3491b6322d28",
                                                "text": "\"A fine man, that Dunwody, yonder,\" commented the young captain, as they parted, and as he turned to his prisoner. \"We'll see him on in Washington some day. He is strengthening his forces now against Mr. Benton out there.[…].\""
                                            },
                                            {
                                                "example_id": "51f44e82-9dd7-4d4c-ada9-bcfc18976e70",
                                                "sense_id": "6f9e2fca-5385-34e9-9316-3491b6322d28",
                                                "text": "I think Mamet always comments that commerce really comes down to just a confidence game"
                                            },
                                            {
                                                "example_id": "c5c8a24b-c94a-46ce-82f9-8621d6a74395",
                                                "sense_id": "6f9e2fca-5385-34e9-9316-3491b6322d28",
                                                "text": "As Cambridge historian Mervyn James commented, \"silly quarrels escalated into battles in the streets.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "435e466e-5aad-3502-a763-76bec96591d6",
                                        "entry_id": "1308ba6e-d562-3325-8797-e7edefc280de",
                                        "glosses": [
                                            "To make remarks or notes; to express a view regarding."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "322b0785-efff-4af8-ab3b-ce395acbe01a",
                                                "sense_id": "435e466e-5aad-3502-a763-76bec96591d6",
                                                "text": "He commented about your proposal."
                                            },
                                            {
                                                "example_id": "61b2d55e-53ab-46e8-baf4-f0da26eb8355",
                                                "sense_id": "435e466e-5aad-3502-a763-76bec96591d6",
                                                "text": "The movie comments on race relations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ac76d48-0054-3baf-b207-425e13425856",
                                        "entry_id": "1308ba6e-d562-3325-8797-e7edefc280de",
                                        "glosses": [
                                            "To comment or remark on."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c769c1c-a357-492a-bf5c-cb20c76064ab",
                                                "sense_id": "2ac76d48-0054-3baf-b207-425e13425856",
                                                "text": "[…]who have expounded Scripture out of its Senses, and have so Commented the Laws thereof"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3047cef5-3627-33a9-b855-56f1c8dddd8a",
                                        "entry_id": "1308ba6e-d562-3325-8797-e7edefc280de",
                                        "glosses": [
                                            "To insert comments into (source code)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e6c4d19-896f-46a0-a7aa-48d4809c03e7",
                                                "sense_id": "3047cef5-3627-33a9-b855-56f1c8dddd8a",
                                                "text": "I wish I'd commented this complicated algorithm back when I remembered how it worked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1741ea1-c90b-3765-9439-650248b64cd8",
                                        "entry_id": "1308ba6e-d562-3325-8797-e7edefc280de",
                                        "glosses": [
                                            "To comment out (code); to disable by converting into a comment."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
