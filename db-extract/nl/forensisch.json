                    },
                    {
                        "translation_id": "9817ec6a-06cb-47a1-882c-d68747941280",
                        "source_entry_id": "270e905c-9d89-39d6-b4fd-15523d38109d",
                        "source_sense_id": "9921cfc4-3495-384d-b816-0c7ec3f73f94",
                        "source_sense_description": "(juridisch) betrekking hebbend op justitie",
                        "target_lang_word": "forensic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forensic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7749fe12-0d20-3996-82c7-76c323f93dac",
                                        "entry_id": "8aca23ea-f59c-37d2-ae17-ebd1603729f4",
                                        "glosses": [
                                            "Relating to the use of science and technology in the investigation and establishment of facts or evidence in a court of law."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9fd25bd-f2f4-48bb-8b4e-3eac58505044",
                                                "sense_id": "7749fe12-0d20-3996-82c7-76c323f93dac",
                                                "text": "In this account of events, the cards were stacked against Clemons from the beginning. His appeal lawyers have argued that he was physically beaten into making a confession, the jury was wrongfully selected and misdirected, and his conviction largely achieved on individual testimony with no supporting forensic evidence presented."
                                            },
                                            {
                                                "example_id": "bb8e4640-89e1-4938-b039-f1a7858d6dea",
                                                "sense_id": "7749fe12-0d20-3996-82c7-76c323f93dac",
                                                "text": "Fire investigators […] and forensic chemists are combing through fire sites [the 16th Street Baptist Church bombing], interviewing witnesses, and following leads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "361c371a-99c9-3346-aacf-209905f24a3f",
                                        "entry_id": "8aca23ea-f59c-37d2-ae17-ebd1603729f4",
                                        "glosses": [
                                            "Relating to, or appropriate for, courts of law; suitable or adapted to legal argumentation."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d838db32-aead-44fc-a20a-aa908b2c7cf2",
                                                "sense_id": "361c371a-99c9-3346-aacf-209905f24a3f",
                                                "text": "Varus trusted implicitly […] to the interest which they affected to take in the forensic eloquence of their conquerors."
                                            },
                                            {
                                                "example_id": "6ee06338-3d50-4684-b2f5-4d20669e0383",
                                                "sense_id": "361c371a-99c9-3346-aacf-209905f24a3f",
                                                "text": "Mr. Philips’ incredulous sniff was a triumph of forensic skill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c37d0c-d78c-3820-a425-be673d940378",
                                        "entry_id": "8aca23ea-f59c-37d2-ae17-ebd1603729f4",
                                        "glosses": [
                                            "Precise, thorough, or highly meticulous, by analogy with a scientific legal investigation."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa68d2f5-141e-429d-b481-080d4bc78b83",
                                                "sense_id": "32c37d0c-d78c-3820-a425-be673d940378",
                                                "text": "A forensic account of history"
                                            },
                                            {
                                                "example_id": "686060a6-e793-4bc6-ae26-1be943111484",
                                                "sense_id": "32c37d0c-d78c-3820-a425-be673d940378",
                                                "text": "With forensic precision"
                                            },
                                            {
                                                "example_id": "371eb8c4-dd62-4d98-9210-9f8f735cb37b",
                                                "sense_id": "32c37d0c-d78c-3820-a425-be673d940378",
                                                "text": "It [the judiciary] had been the forum before which the highest forensic discussions had been held, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "246ad1c8-96fc-3f4a-aa1a-5f6883db80d2",
                                        "entry_id": "8aca23ea-f59c-37d2-ae17-ebd1603729f4",
                                        "glosses": [
                                            "Relating to, or used in, debate or argument."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abb663b4-7c06-4dd9-89b3-2f4bd5fd5ecf",
                        "source_entry_id": "270e905c-9d89-39d6-b4fd-15523d38109d",
                        "source_sense_id": "9921cfc4-3495-384d-b816-0c7ec3f73f94",
                        "source_sense_description": "(juridisch) betrekking hebbend op justitie",
                        "target_lang_word": "légal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5397db7f-f489-3a39-9a43-15554ff1f5b6",
                                        "entry_id": "78ae92a9-dac7-38e6-b7a5-e59a6a90df15",
                                        "glosses": [
                                            "Permis par la loi, conforme à la loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676a0a65-5eeb-4c54-99df-ba5fefd7211f",
                                                "sense_id": "5397db7f-f489-3a39-9a43-15554ff1f5b6",
                                                "text": "L'arrêté municipal qui interdit aux habitants d'une ville d'y tenir certains animaux, tels que bœuf, vaches, moutons, porcs, volailles, pigeons, etc., est légal et obligatoire, comme pris dans l'intérêt de la salubrité publique"
                                            },
                                            {
                                                "example_id": "5e5cd360-d9ae-4975-a1ed-bd20f4579c40",
                                                "sense_id": "5397db7f-f489-3a39-9a43-15554ff1f5b6",
                                                "text": "Depuis le 17 janvier 1975, la loi Veil a légalisé l’IVG : « La femme enceinte que son état place dans une situation de détresse peut demander à un médecin l’interruption de grossesse. » C’est légal ; mais la frontière entre le « légal » et le « moral » est parfois difficile à cerner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "635bf98a-fac9-3a0a-9fd3-cede9f5499db",
                                        "entry_id": "78ae92a9-dac7-38e6-b7a5-e59a6a90df15",
                                        "glosses": [
                                            "Établi par la loi écrite, qui est selon la loi, qui résulte de la loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2872ba47-9c51-443b-b9b7-41c40f6417c8",
                                                "sense_id": "635bf98a-fac9-3a0a-9fd3-cede9f5499db",
                                                "text": "Ainsi pourvue d'un statut légal et de moyens financiers, la vulgarisation se développe rapidement, surtout dans la mouvance du syndicalisme, […]."
                                            },
                                            {
                                                "example_id": "9a29c1db-65d6-4c2f-9186-fee0c98d23bf",
                                                "sense_id": "635bf98a-fac9-3a0a-9fd3-cede9f5499db",
                                                "text": "On passe chez le Pakos pour acheter de la bière et du vin bon marché. Personne n'a l’âge légal pour ça, mais Terry et Gent ont l'air d'avoir vingt-cinq ans, alors aucun problème pour se faire servir."
                                            },
                                            {
                                                "example_id": "d10a7c5f-82f0-436a-bcc8-91d95f436664",
                                                "sense_id": "635bf98a-fac9-3a0a-9fd3-cede9f5499db",
                                                "text": "Il faut donc déduire de ces dispositions que le bitcoin n’est pas une monnaie légale, son acceptation en paiement n’est donc pas garantie par la loi."
                                            },
                                            {
                                                "example_id": "4f944871-2334-47f9-93b4-bca3774765c7",
                                                "sense_id": "635bf98a-fac9-3a0a-9fd3-cede9f5499db",
                                                "text": "« C’est parce qu’en France, contrairement à […] d’autres systèmes jurisprudentiels d’autres pays, on n’a pas la culture du précédent… Nous, on a un système légal, la jurisprudence étant une source, une des sources, mais on ne doit pas rendre ce qu’on appelle d’arrêts de règlement »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb004ec8-acee-3c4a-af9c-43b9e97e6197",
                                        "entry_id": "78ae92a9-dac7-38e6-b7a5-e59a6a90df15",
                                        "glosses": [
                                            "Relatif à la loi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea928f6-047e-4ef2-8d2a-9cf0b2164c4e",
                                                "sense_id": "fb004ec8-acee-3c4a-af9c-43b9e97e6197",
                                                "text": "Interprétation légale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beca4e70-2e2e-3eaa-aba7-b7a57338a7dc",
                                        "entry_id": "78ae92a9-dac7-38e6-b7a5-e59a6a90df15",
                                        "glosses": [
                                            "Ce qui concerne la loi de Dieu donnée par Moïse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34055634-3c02-421c-b46b-15920c5bddfd",
                                                "sense_id": "beca4e70-2e2e-3eaa-aba7-b7a57338a7dc",
                                                "text": "Les cérémonies légales."
                                            },
                                            {
                                                "example_id": "f0915f67-c166-4d59-94a6-854b482d9a80",
                                                "sense_id": "beca4e70-2e2e-3eaa-aba7-b7a57338a7dc",
                                                "text": "Les viandes légales."
                                            },
                                            {
                                                "example_id": "aaf18cf3-b411-4e64-8807-53e0330111d2",
                                                "sense_id": "beca4e70-2e2e-3eaa-aba7-b7a57338a7dc",
                                                "text": "Observations légales."
                                            },
                                            {
                                                "example_id": "893a3b13-fcd7-48e8-acba-1a5488f40fc4",
                                                "sense_id": "beca4e70-2e2e-3eaa-aba7-b7a57338a7dc",
                                                "text": "Impureté légale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
