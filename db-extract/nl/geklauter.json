                                ]
                            },
                            {
                                "target_word": "clambering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e35c1e5e-bd04-3802-80ac-3ae5616a8f48",
                                        "entry_id": "42313b97-d985-3cae-8eaf-f1b0b72f53e8",
                                        "glosses": [
                                            "Climbing"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e2f3b5-9b8b-412e-b475-5d4bcda63f1b",
                                                "sense_id": "e35c1e5e-bd04-3802-80ac-3ae5616a8f48",
                                                "text": "Its hills of smiling green swelled gently one above another, crowned with lofty trees of luxuriant growth; some pointing their tapering foliage towards the clouds, which were gloriously transparent; and others loaded with a verdant burthen of clambering vines, bowing their branches to the earth, that was covered with flowers."
                                            },
                                            {
                                                "example_id": "2d28c107-5f2f-4c83-b521-821502094141",
                                                "sense_id": "e35c1e5e-bd04-3802-80ac-3ae5616a8f48",
                                                "text": "The panes are ruddy through the clambering vines\nAnd blushing leaves, that Summer intertwines\nIn warmer tints than e'er luxuriant Spring,\nO'er flower-embosom'd roof led wandering."
                                            }
                                        ]
                                    }
                                ]
                            }
