                        "form": "den Polarbären"
                    },
                    {
                        "form_id": "9aeb96b9-f7c9-401e-9384-22add09345a4",
                        "entry_id": "0cdc7621-27fc-30cc-bad3-fd672e705f85",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Polarbären"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "60edce76-cdea-3ca0-8105-3ee1b4df04b4",
                        "entry_id": "0cdc7621-27fc-30cc-bad3-fd672e705f85",
                        "glosses": [
                            "Eisbär"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9e273b8-021e-4e7b-b349-64cacd3795db",
                                "sense_id": "60edce76-cdea-3ca0-8105-3ee1b4df04b4",
                                "text": "Experten behaupten, dass wegen der globalen Erwärmung Polarbären vom Aussterben bedroht sind."
                            },
                            {
                                "example_id": "c63db7ca-05ad-4174-b317-5b7c33547467",
                                "sense_id": "60edce76-cdea-3ca0-8105-3ee1b4df04b4",
                                "text": "„Plötzlich träumte er. Ein großer Polarbär lief einen Bergpfad herunter, grunzend wie ein Schwein. Er, Elsheimer, hatte eine zweizinkige Forke, um ihn aufzuhalten.“"
                            },
                            {
                                "example_id": "d37b0c67-26d9-4265-a0a9-a61de496021b",
                                "sense_id": "60edce76-cdea-3ca0-8105-3ee1b4df04b4",
                                "text": "„Inuit jagen nicht traditionell Eisbären Denn bis heute verdient nur eine Handvoll Menschen Geld mit Polarbären. Für die Inuit in Kanada hat der Eisbär eher rituelle Bedeutung und wurde traditionell nur als Mutprobe oder in der Not bei einer ungeplanten Begegnung eines Menschen mit dem Raubtier getötet.“"
                            },
                            {
                                "example_id": "093dffa5-9207-4569-b582-8e0a6e28ee5e",
                                "sense_id": "60edce76-cdea-3ca0-8105-3ee1b4df04b4",
                                "text": "„Mit seinem dichten Fell, dem stämmigen Körperbau und einer bis zu zehn Zentimeter dicken Speckschicht ist der Polarbär gegen die extreme Kälte in der Arktis gut geschützt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "204dd143-72a3-4526-9acd-d971420e2216",
                        "source_entry_id": "0cdc7621-27fc-30cc-bad3-fd672e705f85",
                        "source_sense_id": "60edce76-cdea-3ca0-8105-3ee1b4df04b4",
