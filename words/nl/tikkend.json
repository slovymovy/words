                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tapping",
                                "target_lang_sense_clarification": "the act of striking lightly"
                            },
                            {
                                "target_lang_word": "ticking",
                                "target_lang_sense_clarification": "the act of making a rhythmic clicking sound"
                            }
                        ]
                    }
                }
            ]
        }
