                                    {
                                        "sense_id": "071fac1e-fef1-3d77-9c53-5809dae28b64",
                                        "entry_id": "6bd82f75-c23c-3f96-ab77-7ac06e11d52b",
                                        "glosses": [
                                            "Approbation par une autorité quelconque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5ddc876-4ef2-4473-868e-ac1cc2421556",
                                                "sense_id": "071fac1e-fef1-3d77-9c53-5809dae28b64",
                                                "text": "Il est tout de même difficile de croire que le ministre de l’Intérieur agit sans l’aval du président de la République."
                                            },
