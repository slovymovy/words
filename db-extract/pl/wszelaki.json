                                "sense_id": "865dafee-fa02-3a4f-a453-b6d59cc9cab7",
                                "text": "Co pociągało za sobą wszelakie raporty, zapotrzebowania i różnorodne kartelusze"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
