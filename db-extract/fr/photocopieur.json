        "fr-extract.jsonl": [
            {
                "entry_id": "8730c3bb-7ab0-3b7d-a651-6a3162f1ed2c",
                "word": "photocopieur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c51df6b2-f44b-4a0d-98db-a52a2c16a5ff",
                        "entry_id": "8730c3bb-7ab0-3b7d-a651-6a3162f1ed2c",
                        "tags": [
                            "plural"
                        ],
                        "form": "photocopieurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e147ae83-4d49-39a5-b1de-d2cc9d955479",
                        "entry_id": "8730c3bb-7ab0-3b7d-a651-6a3162f1ed2c",
                        "glosses": [
                            "Appareil utilisant un procédé xérographique qui est une technique d'électrophotographie et permettant de reproduire un document rapidement et à bon marché lorsque le nombre d'exemplaires à reproduire est relativement peu élevé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba8ee5f5-ae46-4ea5-b712-7c753e926d6f",
                                "sense_id": "e147ae83-4d49-39a5-b1de-d2cc9d955479",
                                "text": "Le photocopieur est constitué d’un cylindre métallique nommé tambour ou photoconducteur recouvert d’une couche de matériau semi-conducteur."
                            },
                            {
                                "example_id": "8fe1c5c9-2858-4969-ac4a-a9cb59bcee93",
                                "sense_id": "e147ae83-4d49-39a5-b1de-d2cc9d955479",
                                "text": "On lui a demandé de faire des photocopies. Elle dit: a) Le photocopieur, c’est où? b) Pourriez-vous me dire où se trouve le photocopieur? c) Je dois faire des photocopies. Qu’est-ce que je fais?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1906e50-0dd5-47a6-a2f9-a2c2d03462ea",
                        "source_entry_id": "8730c3bb-7ab0-3b7d-a651-6a3162f1ed2c",
                        "source_sense_id": "e147ae83-4d49-39a5-b1de-d2cc9d955479",
                        "target_lang_word": "Kopierer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kopierer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20561a3c-d359-39f3-9fb2-f1fcf18c566d",
                                        "entry_id": "5df8a463-7698-3b6f-979f-73d62df44951",
                                        "glosses": [
                                            "ein Gerät zur Vervielfältigung mittels Elektrofotografie, beispielsweise von Dokumenten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7cc9517-41d9-4d31-a960-394f300205ca",
                                                "sense_id": "20561a3c-d359-39f3-9fb2-f1fcf18c566d",
                                                "text": "Ein Kopierer ist heute in fast jedem Büro zu finden."
                                            },
                                            {
                                                "example_id": "95f34439-9514-4173-b2f6-57a73057434f",
                                                "sense_id": "20561a3c-d359-39f3-9fb2-f1fcf18c566d",
                                                "text": "„Der Museumsmann sagte, er habe leider keinen Kopierer in seinem kleinen Büro, stattdessen reichte er mir einige leere Blätter und einen Kugelschreiber, damit ich die nötigen Informationen notieren könnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d9f551f-1e5b-4f4d-aebb-2b69e841f3af",
