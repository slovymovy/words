                    {
                        "translation_id": "c2bb553a-e081-4246-8cff-bc3ba078d1d2",
                        "source_entry_id": "dfbf65e6-3670-37f5-b810-22ac28c1718d",
                        "source_sense_id": "658fd72f-c7ff-3f36-84dd-7af53daf3778",
                        "source_sense_description": "Figur des Weihnachtsbrauchtums nach dem Vorbild des heiligen Nikolaus",
