                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d39bf4d-9136-429b-812b-45294814d72a",
                                "sense_id": "8a8f0a87-ec7a-3086-8788-edd1885041b5",
                                "text": "„Der zweite Halbfinalist nach Roger Federer bei den mit 8 Mio. Dollar dotierten ATP Finals in London heißt Grigor Dimitrow.“"
                            },
                            {
                                "example_id": "a566ed55-183c-4080-8b5a-d565d8f6387d",
                                "sense_id": "8a8f0a87-ec7a-3086-8788-edd1885041b5",
                                "text": "„Der Franzose Gaël Monfils, im Vorjahr in New York immerhin Halbfinalist, mühte sich gegen den Amerikaner Donald Young über fünf Sätze.“"
                            }
                        ],
