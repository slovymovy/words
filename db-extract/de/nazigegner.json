                "senses": [
                    {
                        "sense_id": "fb5e5b86-ebe8-3ca9-92cf-c48d2bf20d73",
                        "entry_id": "1d0a148e-db35-3157-bf5d-65d94f4a656c",
                        "glosses": [
                            "Person, die gegen den Nationalsozialismus eingestellt war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ac8c5e4-ace5-4cd0-9bbc-59a3333d36c1",
                                "sense_id": "fb5e5b86-ebe8-3ca9-92cf-c48d2bf20d73",
                                "text": "„In den ersten Nachkriegsjahren hat Piontek sich, angeblich von Haus aus Nazigegner, seiner Desertation gerühmt und schnell das CDU-schwarze Politgewand übergezogen.“"
                            },
                            {
                                "example_id": "6e94ce93-3fcf-4227-aa1e-2a9b3b4a8d8d",
                                "sense_id": "fb5e5b86-ebe8-3ca9-92cf-c48d2bf20d73",
                                "text": "„Ihr Mann war ein Nazigegner, und es war ihm gelungen, während des Krieges nicht Soldat werden zu müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
