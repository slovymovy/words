                ],
                "senses": [
                    {
                        "sense_id": "aa1d97e3-b826-359e-96fd-80c988d3d2bf",
                        "entry_id": "ea4545df-306f-3fb8-ad75-1813f7144d69",
                        "glosses": [
                            "Mappe, in der amtliche (teilweise auch kirchliche) Dokumente zu den wesentliche Ereignissen einer Familie gesammelt werden"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "e30b03cc-0f8a-497e-baa3-22d19eb3334f",
                                "sense_id": "aa1d97e3-b826-359e-96fd-80c988d3d2bf",
                                "text": "„In einem Stammbuch können Sie die Urkunden und Abschriften aus Personenstandsregistern aufbewahren.“"
                            },
                            {
                                "example_id": "6c86d639-df29-43f8-99f0-c3207d2a19db",
                                "sense_id": "aa1d97e3-b826-359e-96fd-80c988d3d2bf",
                                "text": "„Viele Erwachsene kennen ihren eigenen Taufspruch nicht mehr. Wie wäre es, wenn Sie den mal wieder ‚ausgraben‘? Zu finden ist er in der Regel im Stammbuch, in das die Taufe eingetragen worden ist.“"
                            },
                            {
                                "example_id": "fc7f14b6-4fab-4871-9bf5-cd48c64f659e",
                                "sense_id": "aa1d97e3-b826-359e-96fd-80c988d3d2bf",
                                "text": "„Wer sich für eine Kurz- oder Koseform entscheidet, sollte dennoch die volle Namensform im Stammbuch eintragen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2f6f8594-41bf-39b2-b862-58c48275614c",
                        "entry_id": "ea4545df-306f-3fb8-ad75-1813f7144d69",
                        "glosses": [
                            "Büchlein (vor allem eines Kindes, einer Jugendlichen), in dem sich auf ihre Bitte hin Bekannte, Freunde und Verwandte mit – oft literarischen – Texten und Bildern verewigen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "d78a147f-f13f-4a52-83bf-f3fd36d0d737",
                                "sense_id": "2f6f8594-41bf-39b2-b862-58c48275614c",
                                "text": "„Am ehesten, den zwei, drei Opponenten sei das ins Stammbuch geschrieben, gelingt es einer mutigen Walküre vom Format Eva Johanssons, dem Orchestersturm Paroli zu bieten.“"
                            },
                            {
                                "example_id": "4e4245c3-ef96-4788-886e-fa59503a8091",
                                "sense_id": "2f6f8594-41bf-39b2-b862-58c48275614c",
                                "text": "„Claus, du hast mir einst einen Vers ins Stammbuch geschrieben.“"
                            },
                            {
                                "example_id": "caa44a1c-da1e-4fe6-8b53-d41896833503",
                                "sense_id": "2f6f8594-41bf-39b2-b862-58c48275614c",
                                "text": "„Bei dem ersten Besuch überreichte Lisaweta Nicolajewna mir ihr Stammbuch, mit der Bitte, ihr zum Andenken Verse hinein zu schreiben.“"
                            },
                            {
                                "example_id": "067cbec1-29fa-42f9-843e-3726568d00f2",
                                "sense_id": "2f6f8594-41bf-39b2-b862-58c48275614c",
                                "text": "„Nur einige junge Leute, zu denen auch Boris zählte, versenkten sich tiefer in Julies melancholische Stimmung, und mit diesen jungen Leuten führte sie dann ausgedehnte Gespräche unter vier Augen über die Nichtigkeit alles Irdischen und zeigte ihnen ihre Stammbücher, die Denksprüche und Verse melancholischen Inhalts und dazu passende Zeichnungen enthielten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
