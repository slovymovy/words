    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "195f20d8-84e4-345b-acb3-65864b0a1e55",
                    "sense_definition": "Navire ou embarcation qui a sombré en mer ou qui s'est échoué.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "naufrage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les plongeurs ont exploré l'<w>épave</w> du navire marchand au fond de l'océan."
                        },
                        {
                            "text": "Après la violente tempête, une vieille <w>épave</w> a été découverte près du récif."
                        }
                    ],
                    "common_phrases": [
