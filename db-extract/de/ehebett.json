                    }
                ],
                "senses": [
                    {
                        "sense_id": "b634d286-ffb2-3155-aaea-eff97b1713ea",
                        "entry_id": "8eb66d27-ccbf-3503-a558-3537f91b1e13",
                        "glosses": [
                            "breites Bett, in dem zwei Leute Platz haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79354600-7d15-4804-af4e-31e8d934fe0c",
                                "sense_id": "b634d286-ffb2-3155-aaea-eff97b1713ea",
                                "text": "Dieses Hotel hat Doppelzimmer mit zwei einzeln stehenden Betten und mit Ehebetten."
                            },
                            {
                                "example_id": "deb6c321-9fd2-4863-a638-eb7467d3c0a6",
                                "sense_id": "b634d286-ffb2-3155-aaea-eff97b1713ea",
                                "text": "„Nachts schnarchte auf der anderen Seite des Ehebetts Wolfgang Hegebauer, genannt Wolfi, vierundvierzig Jahre alt, Buchhalter, gezeugt von irgendjemandem und einer Sudetendeutschen.“"
                            },
                            {
                                "example_id": "f6ac0d10-43c5-468e-8a09-21ae35091f2c",
                                "sense_id": "b634d286-ffb2-3155-aaea-eff97b1713ea",
                                "text": "„Die beiden verbringen die Nacht im verwaisten Ehebett des Pastors.“"
                            },
                            {
                                "example_id": "6b447b73-828b-41a3-bb03-c3d6c6723563",
                                "sense_id": "b634d286-ffb2-3155-aaea-eff97b1713ea",
                                "text": "„Abends durchtränkte Goldlotos die Ehebetten mit Duftrauch.“"
                            },
                            {
                                "example_id": "878e490b-5183-4c54-a31d-d3662c578ea3",
                                "sense_id": "b634d286-ffb2-3155-aaea-eff97b1713ea",
                                "text": "„Steinunn steht noch mit der Karte in der Hand, Gísli sitzt auf ihrem Ehebett und guckt, als würde er an Schafe oder Heumahd denken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60045b74-d89e-4dab-8701-dab41b7af17f",
                        "source_entry_id": "8eb66d27-ccbf-3503-a558-3537f91b1e13",
