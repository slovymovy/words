                    {
                        "translation_id": "5cad6ec9-6c62-426e-a1a3-b71558c6bba4",
                        "source_entry_id": "3c5d52e4-884f-36ad-a949-4a14cd5c84e3",
                        "source_sense_id": "de966afc-8a29-3576-9b51-e59d14274a1c",
                        "source_sense_description": "Person, die Porträts anfertigt",
                        "target_lang_word": "portrettist",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portrettist",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c4dc50c7-e8f8-304d-9696-d7d9d7b49035",
                                        "entry_id": "093d6a88-2bc7-3022-83d4-ff4655118c0d",
                                        "glosses": [
                                            "schilder of fotograaf van portretten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f529d761-487b-4cc9-984a-d9f90b370251",
                                                "sense_id": "c4dc50c7-e8f8-304d-9696-d7d9d7b49035",
                                                "text": "De race was het begin van een tweedaags festival rond de Zweedse schilder Alexander Roslin, portrettist van de aristocratie in de achttiende eeuw. De tentoonstelling met de door hem gemaakte portretten van de Franse, Zweedse en Russische adel aan de vooravond van de Franse Revolutie wordt morgen officieel door de Zweedse ambassadeur geopend."
                                            },
                                            {
                                                "example_id": "69283371-586a-47c0-a310-fd18f847c24e",
                                                "sense_id": "c4dc50c7-e8f8-304d-9696-d7d9d7b49035",
                                                "text": "Thomas Gainsborough was een populaire portrettist van de Britse adel. Maar zelf werd hij stapelgek van het schilderen van deze ‘idioten’ en maakte hij liever landschappen, zo blijkt in Rijksmuseum Twenthe."
                                            },
                                            {
                                                "example_id": "01059e4f-a743-4b11-baee-21e427d76089",
                                                "sense_id": "c4dc50c7-e8f8-304d-9696-d7d9d7b49035",
                                                "text": "In Haagse Post zei hij destijds: Het komische is dat je bij mensen in de huiskamer zit... Waarom is roem leuk? Omdat het een gevolg is van het werk. Met abstracte kunst had Citroen weinig. Schilderen vond hij al abstract genoeg. En aan het modernisme had hij niets toe te voegen, concludeerde hij al jong in Berlijn waar hij werkte met fotomontage en Bauhauskunstenaars. Ik ben portrettist, ik moet het van de mensen hebben, schreef hij in Notities van een schilder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
