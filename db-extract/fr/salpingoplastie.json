                ],
                "senses": [
                    {
                        "sense_id": "f22cc6ad-c7a1-3874-bc9a-aedb6efcbe30",
                        "entry_id": "e6b6fc4c-ed4f-3c30-99cc-32b7d355f0f8",
                        "glosses": [
                            "Intervention chirurgicale sur les trompes de Fallope destinée à rétablir leur perméabilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8319a01-1017-4213-969f-5fca8ed97a7d",
                                "sense_id": "f22cc6ad-c7a1-3874-bc9a-aedb6efcbe30",
                                "text": "Vidal, qui a imaginé cette opération, lui a donné le nom de salpingoplastie, parce qu’elle est très analogue à la pyloroplastie. Elle a pour but de traiter les rétrécissements de la trompe."
                            },
                            {
                                "example_id": "bcef2f11-8e34-4c02-a44f-a5f54a827a3c",
                                "sense_id": "f22cc6ad-c7a1-3874-bc9a-aedb6efcbe30",
                                "text": "Dans les stérilités tubaires par obstruction distale nous pratiquons la salpingoplastie termino-latérale de Pollosson."
                            },
                            {
                                "example_id": "b384309a-5297-4d0e-8eca-b963a39b9578",
                                "sense_id": "f22cc6ad-c7a1-3874-bc9a-aedb6efcbe30",
                                "text": "C’est ainsi que l’une de nos patientes a subi une cure de synéchie par voie basse dont le résultat anatomique est excellent et doit subir prochainement une salpingoplastie bilatérale."
                            }
                        ]
                    }
                ],
