                "senses": [
                    {
                        "sense_id": "daa7f8c6-e212-3bed-a5ac-4d5fb8d6def2",
                        "entry_id": "46203b8e-efbd-37f0-be82-9a79a1e5e791",
                        "glosses": [
                            "eine Zelle in einem Gefängnis, in der Häftlinge auf die Vollstreckung ihrer Todesstrafe (auf ihre Hinrichtung) warten müssen"
                        ],
                        "tags": [
                            "Justiz"
                        ],
                        "examples": [
                            {
                                "example_id": "afd10f8a-4dd0-404f-920a-f2ce8255da0e",
                                "sense_id": "daa7f8c6-e212-3bed-a5ac-4d5fb8d6def2",
                                "text": "„Mit dunkler, schleppender Stimme beschreibt er die Todeszelle, in der er auf sein Urteil wartete, während sein Zellennachbar ohne Prozess erschossen wurde.“"
                            },
                            {
                                "example_id": "5cd2c08a-4f48-41c0-be2a-c5063c03b6e7",
                                "sense_id": "daa7f8c6-e212-3bed-a5ac-4d5fb8d6def2",
                                "text": "„Diejenigen, die wirklich in die Todeszelle gehören, kommen sowieso nie dorthin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
