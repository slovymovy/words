                    },
                    {
                        "sense_id": "792f16a8-cce9-3208-87f5-dcfe2d30b33d",
                        "entry_id": "ba4ada48-021d-3a62-bf59-5437134d9449",
                        "glosses": [
                            "soort die ooit talrijk was of een groot verspreidingsgebied had, maar later gekenmerkt wordt door isolatie of een versnipperd of beperkt leefgebied"
                        ],
                        "tags": [],
