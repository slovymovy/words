                "senses": [
                    {
                        "sense_id": "fbcf3b37-c584-3518-8808-5057a1025b45",
                        "entry_id": "3417966f-ac46-3ea7-a266-fa464a1e849f",
                        "glosses": [
                            "französischer Auslandsgeheimdienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "255614c1-c1ee-4a4d-821b-8ff3c50ffc4e",
                                "sense_id": "fbcf3b37-c584-3518-8808-5057a1025b45",
                                "text": "„Als seine Verletzungen versorgt waren, erklärte er dem Mann vom DGSE, warum er in Damaskus war.“"
                            },
                            {
                                "example_id": "fc159f2e-797b-4f21-8f42-ff7885e83673",
                                "sense_id": "fbcf3b37-c584-3518-8808-5057a1025b45",
                                "text": "„Er leitete die Sondereinheit des DGSE, dieser arabische Giftzwerg drohte ihm in seinem eigenen Land, und jetzt wollte Vega es auch noch herunterspielen, als sei es keine große Sache.“"
                            },
                            {
                                "example_id": "732243dd-1748-4626-b234-2baf7db775d4",
                                "sense_id": "fbcf3b37-c584-3518-8808-5057a1025b45",
                                "text": "„›Wenn du gestern in Stockholm deinen Job ordentlich erledigt hättest, dann wäre Court Gentry, nach dem die CIA, das FBI, Interpol, die französische DGSE, die mexikanische Bundespolizei, der russische FSB und weiß Gott wer noch fahnden, jetzt nicht mehr im Spiel, und Mike hätte heute Morgen nicht ganz allein irgendwo in den dunklen Eingeweiden des Bahnhofs gestanden mit einer Drahtschlinge um den Hals.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
