                "senses": [
                    {
                        "sense_id": "0d1ec2a6-711a-387a-bc25-0c3957b1fa0a",
                        "entry_id": "0de6196c-095a-307b-b92b-58544d390798",
                        "glosses": [
                            "Spécialiste de la cryptologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f21322e-b74f-4ce0-ab27-6519fc069785",
                                "sense_id": "0d1ec2a6-711a-387a-bc25-0c3957b1fa0a",
                                "text": "Le cryptologue est un personnage bizarre qui, comme Humpty-Dumpty dans Alice au pays des merveilles, est assis en un équilibre instable en haut d’un mur."
                            },
                            {
                                "example_id": "af147425-93cc-4d59-b0ea-d9a6a417bf19",
                                "sense_id": "0d1ec2a6-711a-387a-bc25-0c3957b1fa0a",
                                "text": "Ses services de renseignements avaient accès aux plus grands secrets de la Wehrmacht et, pour ceux que ne pénétraient pas ses réseaux d'espionnage à Berlin, Genève et Paris, il en était informé grâce aux cryptologues de Bletchley Park qui lisaient les messages chiffrés des Allemands et lui permettaient de se faire une idée du degré de préparation de leur offensive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13649eb6-9395-43b1-9c34-b8382d22344d",
                        "source_entry_id": "0de6196c-095a-307b-b92b-58544d390798",
                        "source_sense_id": "0d1ec2a6-711a-387a-bc25-0c3957b1fa0a",
                        "target_lang_word": "Kryptologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kryptologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d039898a-8c31-3554-92b2-0ba191a875f5",
                                        "entry_id": "b7fb33c0-a0df-3696-b94d-48f6213ec457",
                                        "glosses": [
                                            "Person, die sich mit der Ver- und Entschlüsselung von Texten befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31989c5d-e419-4d77-a3e8-0dc6d90c0c17",
                                                "sense_id": "d039898a-8c31-3554-92b2-0ba191a875f5",
                                                "text": "„Für gewöhnlich zählen Kryptologen bei der Entschlüsselung eines Textes zunächst die Buchstaben, um ein Muster zu erkennen.“"
                                            },
                                            {
                                                "example_id": "86f28f9b-3a79-48ab-bbda-c93b0fa2e210",
                                                "sense_id": "d039898a-8c31-3554-92b2-0ba191a875f5",
                                                "text": "„Im allgemeinen ist es aber verständlich, wenn hoheitliche Geheimdienste selbst die Namen führender Kryptologen nicht der Öffentlichkeit preisgeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
