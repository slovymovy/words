                ],
                "senses": [
                    {
                        "sense_id": "42614e00-43ab-3e8d-bc62-67750d15e004",
                        "entry_id": "719c3c84-72b8-372b-9125-0f0d42ccfcd9",
                        "glosses": [
                            "Subir une fermentation préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cec9b421-4dc4-4b13-91eb-782e39b1438e",
                                "sense_id": "42614e00-43ab-3e8d-bc62-67750d15e004",
                                "text": "Le gluconate de sodium par exemple est produit à partir d'amidon de céréales dans des réacteurs que l'on ensemence avec une bactérie spécifique mise à préfermenter avant introduction."
                            },
                            {
                                "example_id": "94924ccd-2720-4387-9326-d38e5588af7e",
                                "sense_id": "42614e00-43ab-3e8d-bc62-67750d15e004",
                                "text": "Tu veux sans doute parler de la méthode dite:\"poolish\" qui consiste à faire préfermenter une bonne partie de la pâte."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6319ed3-dfa1-3bb8-b746-517532d2d407",
                        "entry_id": "719c3c84-72b8-372b-9125-0f0d42ccfcd9",
                        "glosses": [
                            "Faire subir une fermentation préalable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5582f7f-443d-44e3-b77a-87b30a8684e9",
                                "sense_id": "a6319ed3-dfa1-3bb8-b746-517532d2d407",
                                "text": "Les vins sont vinifiés selon une méthode traditionnelle qui consiste à d'abord préfermenter à froid pour extraire la couleur, puis fermenter à température maîtrisé pour préserver les arômes, et macérer à chaud pour extraire les tanins."
                            }
                        ]
                    }
