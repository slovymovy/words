                    {
                        "translation_id": "9bdb74a1-a31c-4ea7-a540-b5e399c064d9",
                        "source_entry_id": "c90927f4-599e-345a-bd48-f492ed11f438",
                        "source_sense_id": "27bba3c4-0aee-3042-9bf5-44d57207a40b",
                        "target_lang_word": "Leuchtstoffröhre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leuchtstoffröhre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81170181-34fd-3502-ab54-cbf0dd189e7b",
                                        "entry_id": "d96ee5a3-1868-35cd-83f9-e8bf6a572792",
                                        "glosses": [
                                            "Leuchtmittel bestehend aus einer geschlossenen Glasröhre mit je einer Elektrode an beiden Enden, in der Quecksilber-Dampf durch Anlegen einer elektrischen Spannung zur Emission von Licht mit hohem Anteil an UV-Strahlung angeregt wird, welche durch einen an der Innenwandung aufgebrachten Leuchtstoff in sichtbares Licht umgewandelt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bda8af82-29ba-47eb-938f-b6fbcec257a1",
                                                "sense_id": "81170181-34fd-3502-ab54-cbf0dd189e7b",
                                                "text": "Diese Leuchtstoffröhre gibt helles, weißes Licht ab."
                                            },
                                            {
                                                "example_id": "c8bd2bb5-4a47-4f1a-a6c8-bb1d140c1949",
                                                "sense_id": "81170181-34fd-3502-ab54-cbf0dd189e7b",
                                                "text": "„2016 hatten französische Forscher des staatlichen Forschungsinstituts Inserm die Wirkungen verschiedener Lichtarten an Ratten getestet. Bei extrem hoher Intensität von 6.000 Lux schadeten Glühbirne, Leuchtstoffröhre und LED-Lampe den Augen der Nager gleichermaßen.“"
                                            },
                                            {
                                                "example_id": "b2354e8b-4220-457d-869c-48fb4f3d2daf",
                                                "sense_id": "81170181-34fd-3502-ab54-cbf0dd189e7b",
                                                "text": "„Mit ein Grund ist, dass langsam auch bessere Ersatztechnologien wie etwa die Halogen- oder nun LED-Lampen auf den Markt kommen, die Konsumentenwünsche weit besser befriedigen als die schwierig entsorgbare Kompaktleuchtstofflampe, die auf der Technik der Leuchtstoffröhre beruht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
