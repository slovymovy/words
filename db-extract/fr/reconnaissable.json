                                        "sense_id": "b21e0bb9-62e4-33be-8a6c-a12b0df7104f",
                                        "entry_id": "3502a926-dcab-35f5-9263-f2a94af6018d",
                                        "glosses": [
                                            "so deutlich, dass man weiß, was man vor seinen Augen hat"
                                        ],
