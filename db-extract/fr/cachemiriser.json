                "senses": [
                    {
                        "sense_id": "a9869108-8226-30b8-8967-1c0a2d19433d",
                        "entry_id": "72122546-076a-379e-a714-0513b12b5b80",
                        "glosses": [
                            "Donner un caractère cachemiri."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a23d0c43-774d-485c-a2ee-1a9105d1a3f9",
                                "sense_id": "a9869108-8226-30b8-8967-1c0a2d19433d",
                                "text": "Enfin, s'il ne s'agit pas d'un système, fasse la Shakti qu'il ne s'agisse pas non plus jamais d'un \"mode\", - chacun se mettant à \"cachemiriser\" dans son coin en picorant à droite et à gauche des miettes de savoir de seconde main."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7a2cb24-6f1a-3592-abcf-5380e9fd7343",
                        "entry_id": "72122546-076a-379e-a714-0513b12b5b80",
                        "glosses": [
                            "Vêtir de cachemire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbacb7f7-d365-4d5d-aac2-8ae76342ae97",
                                "sense_id": "a7a2cb24-6f1a-3592-abcf-5380e9fd7343",
                                "text": "Oui je la cachemirise verbalement."
                            },
                            {
                                "example_id": "9dda74a4-2449-4383-a7da-265eaa9d6893",
                                "sense_id": "a7a2cb24-6f1a-3592-abcf-5380e9fd7343",
                                "text": "Chaque saison Flouze, cachemirise un nouvel objet: noeud pap, serre-tête, bandeau, cache-oreille.."
                            },
                            {
                                "example_id": "cf699ec0-4291-47db-8ab2-0eb8c4bb2c8b",
                                "sense_id": "a7a2cb24-6f1a-3592-abcf-5380e9fd7343",
                                "text": "Bref de quoi vous cachemiriser des pieds à la tête, on adoore!"
                            }
                        ]
                    }
