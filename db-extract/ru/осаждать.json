                                        "examples": [
                                            {
                                                "example_id": "6273a94a-170e-4698-ae4d-b1a798ad7eae",
                                                "sense_id": "fec04ea5-25f0-3e4b-8a99-a48a64b213e5",
                                                "text": "Vegetatively it is the nearest to H. translucens with its oblong-lanceolate leaves, with the margins and keel beset with pellucid teeth, but it differs and is characterised by the greyish-black quadrantly positioned globose flowers; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3c1f47b-7f26-3504-b892-e0b2185b58a1",
                                        "entry_id": "473f341e-e14a-3ac4-810d-7e00a3663fe2",
                                        "glosses": [
                                            "To attack or assail, especially from all sides."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cae5610-df45-4b13-a17b-115ad8298ebc",
                                                "sense_id": "c3c1f47b-7f26-3504-b892-e0b2185b58a1",
                                                "text": "“Nay, for matter o’ that, he never doth any mischief,” said the woman; “but to be sure it is necessary he should keep some arms for his own safety; for his house hath been beset more than once; and it is not many nights ago that we thought we heard thieves about it […]"
                                            },
                                            {
                                                "example_id": "e6c66cb2-022a-46cc-a09c-b6e0f261b7c5",
                                                "sense_id": "c3c1f47b-7f26-3504-b892-e0b2185b58a1",
                                                "text": "Track and platforms have been upgraded, but refurbished trains from Vivarail have been beset by software problems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aec07c33-346d-3429-bbb1-8e25d3249977",
                                        "entry_id": "473f341e-e14a-3ac4-810d-7e00a3663fe2",
                                        "glosses": [
                                            "To decorate something with jewels etc."
