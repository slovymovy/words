                    {
                        "sense_id": "9983bd6e-509d-3dbd-9805-c80cbffa1cc4",
                        "entry_id": "e75eff3d-1b18-391d-b55a-ba2262df9047",
                        "glosses": [
                            "A foot-operated pedal or lever that generates motion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50638a99-22f2-49c6-b7dd-4f1ea6dc1a1f",
                                "sense_id": "9983bd6e-509d-3dbd-9805-c80cbffa1cc4",
                                "text": "There is an inconspicuous treadle let into the floor and when you step on it an air-operated door-opening mechanism is automatically activated; [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd4b3748-3df5-367d-bee7-5e1827db5d5c",
                        "entry_id": "e75eff3d-1b18-391d-b55a-ba2262df9047",
                        "glosses": [
                            "A device actuated by wheels passing over it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1593d51-3ce4-480f-9802-4e26f7cf33d1",
                                "sense_id": "cd4b3748-3df5-367d-bee7-5e1827db5d5c",
                                "text": "As a car enters the parking area the front wheels pass over a treadle, causing a timber barrier to lift and allow the motorist to drive in and park. No money is required at this stage. As the car passes over a second treadle, just beyond the entrance, the barrier falls again."
                            }
                        ]
                    },
