                ],
                "senses": [
                    {
                        "sense_id": "b1747d7b-b36b-336d-b0f2-850e4c33e5f2",
                        "entry_id": "589231d9-ad5e-32b7-a127-b11e67f40665",
                        "glosses": [
                            "Qui a perdu des morceaux de peau en parlant de personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b1c0c5d-2ed4-452c-80db-8d9c6fd5aa32",
                                "sense_id": "b1747d7b-b36b-336d-b0f2-850e4c33e5f2",
                                "text": "Débraillés, avinés, écorchés, les mousquetaires du roi, ou plutôt ceux de M. de Tréville, s’épandaient dans les cabarets, dans les promenades, dans les jeux publics."
                            },
                            {
                                "example_id": "5945850e-fddd-4bfb-ade3-5901eaaa2480",
                                "sense_id": "b1747d7b-b36b-336d-b0f2-850e4c33e5f2",
                                "text": "Un genou écorché."
                            }
                        ]
                    },
                    {
                        "sense_id": "546e879d-d582-32ad-b15d-da17c4c029e1",
                        "entry_id": "589231d9-ad5e-32b7-a127-b11e67f40665",
                        "glosses": [
                            "Qui a perdu son revêtement en parlant d’un objet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fcac676-429f-4e6f-baa5-731203c42069",
                                "sense_id": "546e879d-d582-32ad-b15d-da17c4c029e1",
                                "text": "A table, je bois dans un verre dépoli, je mange avec des couverts en métal écorché."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b9eb536c-b879-3618-b123-8e32f3c4151d",
                "word": "écorché",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8aefdab8-9db0-4262-8999-c8cf992c2ebc",
                        "entry_id": "b9eb536c-b879-3618-b123-8e32f3c4151d",
                        "tags": [
                            "plural"
                        ],
                        "form": "écorchés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa07560a-61db-37dd-9ed6-df0671bc0704",
                        "entry_id": "b9eb536c-b879-3618-b123-8e32f3c4151d",
                        "glosses": [
                            "Supplicié à qui on a arraché la peau."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "97b89004-f8eb-3f8d-b941-5d75f4370f7e",
                        "entry_id": "b9eb536c-b879-3618-b123-8e32f3c4151d",
                        "glosses": [
                            "Sculpture ou dessin d’une figure sans peau, dont on voit les muscles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f6676c6-64b5-493c-b8d5-9d05c27dabf5",
                                "sense_id": "97b89004-f8eb-3f8d-b941-5d75f4370f7e",
                                "text": "La mule qu’on m’avait assignée pour monture était rasée à mi-corps, ce qui permettait d’étudier sa musculature aussi commodément que sur un écorché."
                            },
                            {
                                "example_id": "abf3716e-cfa4-4126-876c-89586cfc7e79",
                                "sense_id": "97b89004-f8eb-3f8d-b941-5d75f4370f7e",
                                "text": "Ces blocs énormes aux larges fissures transversales, veines de marbre de la montagne, sorte d’écorché terrestre où l’on peut étudier à nu l’anatomie du globe, ont des proportions qui réduisent à l’état microscopique les plus vastes granits égyptiens."
                            },
                            {
                                "example_id": "e1bd8385-9785-4d7a-805f-dda3fa0d9343",
                                "sense_id": "97b89004-f8eb-3f8d-b941-5d75f4370f7e",
                                "text": "Dans Vice, il s'agit d'une auscultation des différents aspects pris par la mort dans le vivant, de visualiser les différentes peaux de ce grand théâtre immobile : corps taxidermiques, squelettes adultes et enfants, mannequins de cire, écorchés, […]."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
