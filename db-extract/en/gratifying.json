                        "target_lang_word": "befriedigend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "befriedigend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4166f7be-badb-3bc3-bd4d-e15d83e7fc87",
                                        "entry_id": "b8658d7c-42d9-31c8-a46c-8dca702f1a40",
                                        "glosses": [
                                            "so, dass es die Beteiligten zufrieden macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfe8c50a-b75c-46cc-9fce-c33542718a54",
                                                "sense_id": "4166f7be-badb-3bc3-bd4d-e15d83e7fc87",
                                                "text": "Ob Sie nun Reichtum, Macht, einen befriedigenderen Beruf, ein harmonisches Familienleben anstreben – was es auch sei: mit Hilfe unserer Formel werden Sie es erreichen!"
                                            },
                                            {
                                                "example_id": "c9e30fb4-665b-4eb7-b3e7-fd3df335f3b9",
                                                "sense_id": "4166f7be-badb-3bc3-bd4d-e15d83e7fc87",
                                                "text": "Ihre Rede war ein befriedigender Abschluss der Tagung und dafür danken wir."
                                            },
                                            {
                                                "example_id": "484d94ad-6af9-4bde-a4fd-3904284718b8",
                                                "sense_id": "4166f7be-badb-3bc3-bd4d-e15d83e7fc87",
                                                "text": "Es ist ein befriedigendes Gefühl, zu wissen, dass die Kleine jetzt zu Hause ist."
                                            },
                                            {
                                                "example_id": "e56d0105-d559-4938-9a02-3540648b5c7e",
                                                "sense_id": "4166f7be-badb-3bc3-bd4d-e15d83e7fc87",
                                                "text": "Wenn Sie mich fragen, ist die befriedigendste Aussicht die, dass es hier keine Toten mehr geben wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51160891-ce3e-3bc1-90d9-385e1044a853",
                                        "entry_id": "b8658d7c-42d9-31c8-a46c-8dca702f1a40",
                                        "glosses": [
                                            "die Notenstufe 3, offiziell großgeschrieben: Befriedigend"
                                        ],
                                        "tags": [
                                            "in Österreich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bb53d5a-46c0-4ef2-9a40-b966782f16a3",
                                                "sense_id": "51160891-ce3e-3bc1-90d9-385e1044a853",
                                                "text": "„Mit »Befriedigend« sind Leistungen zu beurteilen, mit denen der Schüler die nach Maßgabe des Lehrplanes gestellten Anforderungen in der Erfassung und in der Anwendung des Lehrstoffes sowie in der Durchführung der Aufgaben in den wesentlichen Bereichen zur Gänze erfüllt; dabei werden Mängel in der Durchführung durch merkliche Ansätze zur Eigenständigkeit ausgeglichen.“"
                                            },
                                            {
                                                "example_id": "091852fc-aaa5-4805-a13e-2d91dfb51260",
                                                "sense_id": "51160891-ce3e-3bc1-90d9-385e1044a853",
                                                "text": "„Die Note ‚befriedigend‘ soll erteilt werden, wenn die Leistung im allgemeinen den Anforderungen entspricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0bb19a2f-76f7-35a3-a318-159520730e67",
                                        "entry_id": "b8658d7c-42d9-31c8-a46c-8dca702f1a40",
                                        "glosses": [
                                            "die Schulnote 3"
                                        ],
                                        "tags": [
                                            "in Deutschland (ohne Steigerung)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06a310d2-4c15-471c-9599-a656976ba43b",
                                                "sense_id": "0bb19a2f-76f7-35a3-a318-159520730e67",
                                                "text": "Dein Lehrer befand deine Leistung nur befriedigend."
                                            },
                                            {
                                                "example_id": "2b0ea763-8b16-4eb4-a588-8913104c9344",
                                                "sense_id": "0bb19a2f-76f7-35a3-a318-159520730e67",
                                                "text": "Im Abschlusszeugnis stand leider nur ein befriedigend bei Englisch."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
