                "senses": [
                    {
                        "sense_id": "6ba210ac-34bf-38ea-adac-f1622ab1effb",
                        "entry_id": "fcb9da06-3ac5-394a-99c8-8854c69a3dca",
                        "glosses": [
                            "Augean stable"
                        ],
                        "tags": [
                            "Greek",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "1fff225f-464a-421e-bfcb-f9296927d778",
                                "sense_id": "6ba210ac-34bf-38ea-adac-f1622ab1effb",
                                "text": "Weil, wie die Analyse zeigt, an dem Zustandekommen dieses Traumes die angenehmsten und befriedigendsten Gedanken mitgewirkt hatten. Mir fällt in der Analyse sofort der Augiasstall ein, den Herkules reinigt. Dieser Herkules bin ich.",
                                "translation": "The Interpretation of Dreams",
                                "english": "The Interpretation of Dreams"
                            }
                        ]
                    },
                    {
                        "sense_id": "2b538dae-6c5a-320d-a046-14f0bb4b35c6",
                        "entry_id": "fcb9da06-3ac5-394a-99c8-8854c69a3dca",
                        "glosses": [
                            "pigsty, Augean stables"
                        ],
                        "tags": [
                            "figuratively",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "9f25b41f-0367-4eb5-b10e-50a45e64c7c0",
                                "sense_id": "2b538dae-6c5a-320d-a046-14f0bb4b35c6",
                                "text": "Aber war denn das anders möglich, wenn man einen solchen Augiasstall auszumisten hatte, wie es das kaiserliche Paris war?"
                            }
                        ]
                    }
