                        "entry_id": "7fb8cb62-68e4-3826-b474-c17698015ca8",
                        "glosses": [
                            "Châssis fixe et immobile auquel tient et dans lequel vient s’emboîter une porte ou le châssis mobile d’une fenêtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fda3cef-27e1-4031-baa9-eb0b5d4b8277",
                                "sense_id": "58053e66-1112-300b-90b5-b7dfe74f0182",
                                "text": "Un dormant de croisée."
                            },
                            {
                                "example_id": "9ade8ba1-4797-48ae-b377-e6389bfeee55",
                                "sense_id": "58053e66-1112-300b-90b5-b7dfe74f0182",
                                "text": "Poser, sceller un dormant."
                            },
                            {
                                "example_id": "e41e3ddf-3d51-4a6d-b6e0-1cca8aede6e0",
                                "sense_id": "58053e66-1112-300b-90b5-b7dfe74f0182",
                                "text": "[…] le dormant de la porte est plus étroit qu’il ne faudrait, pour qu’on ne s’y heurte pas aux entournures […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "78297a55-bb8b-3222-ae38-08565e0d7fa4",
