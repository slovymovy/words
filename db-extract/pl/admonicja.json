                "translations": [
                    {
                        "translation_id": "2ce90614-33a8-47db-b2bf-1315929bb2ef",
                        "source_entry_id": "4234ebf3-8a03-3570-8c01-46bedbf9ca84",
                        "source_sense_id": "66e5f7ad-bf5a-32ac-b5a3-9c69e051fcd1",
