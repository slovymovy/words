                ],
                "senses": [
                    {
                        "sense_id": "69aec0b6-9f35-3f05-bfdf-d4b60a9e1a6e",
                        "entry_id": "84b1726e-1669-3e75-8ce5-4e2409e5e318",
                        "glosses": [
                            "ein Geschäftshaus, Laden, das Güter vieler verschiedener Branchen zum Verkauf anbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2730326b-0c5f-4d89-9e43-93863d271338",
                                "sense_id": "69aec0b6-9f35-3f05-bfdf-d4b60a9e1a6e",
                                "text": "Das Warenhaus in der Stadt ist riesig, bietet viele Waren an und ist günstig."
                            },
                            {
                                "example_id": "fc80b78e-7ac9-4cf2-8f2a-2f3bfa212123",
                                "sense_id": "69aec0b6-9f35-3f05-bfdf-d4b60a9e1a6e",
                                "text": "„Sie trugen Papierkleider, die es in einem Warenhaus zu kaufen gab.“"
                            },
                            {
                                "example_id": "2149e360-a42f-4f87-a905-91fd26915ee3",
                                "sense_id": "69aec0b6-9f35-3f05-bfdf-d4b60a9e1a6e",
                                "text": "„Die Braut von dem Kellner ist Aufsicht in einem Warenhaus.“"
                            },
                            {
                                "example_id": "67071c32-d4b0-41b5-83ff-097ac1012853",
                                "sense_id": "69aec0b6-9f35-3f05-bfdf-d4b60a9e1a6e",
                                "text": "„In einem Frankfurter Warenhaus wird neben einem Stand mit Damenunterwäsche ein Flugzeug angeboten.“"
                            },
                            {
                                "example_id": "3a2e7ca0-57e5-44a6-80c9-a98e436d5dc5",
                                "sense_id": "69aec0b6-9f35-3f05-bfdf-d4b60a9e1a6e",
                                "text": "„Die Christusfigur ist eine Kleiderpuppe, die er in der Seitengasse hinter Levys Warenhaus in Savannah in einer Müllkiste fand, mit Klebemasse ausbesserte und in ein faltenreiches Gewand kleidete, welches Della mit der Hand genäht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
