            "senses": [
                {
                    "sense_id": "e03ca09e-3d57-3421-bf45-e58d91ed69a7",
                    "sense_definition": "darzyć kogoś lub coś uznaniem, uważać za wartościowe lub ważne",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "szacunek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W naszej pracy bardzo <w>cenimy</w> punktualność oraz profesjonalne podejście do klienta.",
                            "target_lang_translations": {
                                "ru": "В нашей работе мы очень <w>ценим</w> пунктуальность и профессиональный подход к клиенту."
                            }
                        },
                        {
                            "text": "Mieszkańcy małego miasteczka głęboko <w>cenią</w> spokój oraz bliskość natury.",
                            "target_lang_translations": {
                                "ru": "Жители маленького городка глубоко <w>ценят</w> спокойствие и близость к природе."
                            }
                        }
                    ],
                    "synonyms": [
                        "szanować",
                        "poważać"
                    ],
                    "antonyms": [
                        "gardzić"
                    ],
                    "common_phrases": [
                        "wysoko cenić",
                        "cenić spokój",
                        "cenić zdanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "относиться к кому-либо или чему-либо с признанием, считать ценным, важным; дорожить кем-либо или чем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ценить",
                                "target_lang_sense_clarification": "признавать достоинства, важность кого-то или чего-то"
                            },
                            {
                                "target_lang_word": "дорожить",
                                "target_lang_sense_clarification": "беречь, высоко ценить (отношения, покой, время)"
                            },
                            {
                                "target_lang_word": "уважать",
                                "target_lang_sense_clarification": "относиться с почтением (к чужому мнению, личности)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60446a62-652e-31ad-b63c-82682123d67a",
                    "sense_definition": "określać wartość materialną czegoś, żądać określonej zapłaty za towar lub usługę",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wycena",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ekspert od antyków dokładnie <w>cenił</w> stary zegar przed wystawieniem go na aukcję.",
                            "target_lang_translations": {
                                "ru": "Эксперт по антиквариату тщательно <w>оценивал</w> старинные часы перед выставлением их на аукцион."
                            }
                        },
                        {
                            "text": "Malarz wysoko się <w>ceni</w>, dlatego jego obrazy kosztują fortunę.",
                            "target_lang_translations": {
                                "ru": "Художник <w>высоко себя ценит</w>, поэтому его картины стоят целое состояние."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyceniać",
                        "taksować",
                        "liczyć"
                    ],
                    "common_phrases": [
                        "wysoko się cenić",
                        "drogo cenić"
                    ],
                    "target_lang_definitions": {
                        "ru": "определять материальную стоимость чего-либо, назначать цену за товар или услугу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценивать",
                                "target_lang_sense_clarification": "устанавливать денежную стоимость"
                            },
                            {
                                "target_lang_word": "запрашивать",
                                "target_lang_sense_clarification": "просить определённую плату"
                            },
                            {
                                "target_lang_word": "ценить",
                                "target_lang_sense_clarification": "назначать цену (разг.)"
                            }
                        ]
                    }
                }
            ]
        }
