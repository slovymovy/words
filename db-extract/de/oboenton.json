                "senses": [
                    {
                        "sense_id": "690cfbb9-12c0-3ac8-8ee7-3a68f838cf9d",
                        "entry_id": "3c334544-6fa1-3b0c-9f00-d28593ac25a8",
                        "glosses": [
                            "mit einer Oboe erzeugter Ton"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "2abb12e1-0345-440e-9aea-a70a27347483",
                                "sense_id": "690cfbb9-12c0-3ac8-8ee7-3a68f838cf9d",
                                "text": "„Weil der Oboenton sehr ausgeprägte Obertöne hat (speziell den 3., 4. und 5.), ist sein Klang besonders deutlich hörbar.“"
                            },
                            {
                                "example_id": "2afa9868-10d1-490e-8f7a-9dc2e9c91b7f",
                                "sense_id": "690cfbb9-12c0-3ac8-8ee7-3a68f838cf9d",
                                "text": "„Der schöne Oboenton war im Wettbewerb ausschlaggebend für die sehr gute Platzierung.“"
                            },
                            {
                                "example_id": "d3386928-44a4-4aa2-80ab-3a54c3f45a69",
                                "sense_id": "690cfbb9-12c0-3ac8-8ee7-3a68f838cf9d",
                                "text": "„Und dann erklang plötzlich hoch darüber ein einzelner Oboenton.“"
                            },
                            {
                                "example_id": "b6b524b3-8b17-4724-8d2e-7e97ca88e244",
                                "sense_id": "690cfbb9-12c0-3ac8-8ee7-3a68f838cf9d",
                                "text": "„Ein Flötenton klingt anders als ein Oboenton gleicher Höhe und gleicher Lautstärke. Das ist ein Unterschied der Klangfarbe.“"
                            },
                            {
                                "example_id": "77e17188-419b-4080-9f0c-0b4ccdb9c179",
                                "sense_id": "690cfbb9-12c0-3ac8-8ee7-3a68f838cf9d",
                                "text": "„Céline Moinets Oboenton ist ganz auf französische Leichtigkeit fokussiert.“"
                            },
                            {
                                "example_id": "1bed2bf1-d0d6-4a98-836d-35492b8d1069",
                                "sense_id": "690cfbb9-12c0-3ac8-8ee7-3a68f838cf9d",
                                "text": "„In der folgenden Arie entzückt zunächst Saskia Fikentschers weicher, warmer, atmender Oboenton;“ […]."
                            },
                            {
                                "example_id": "3f11768f-6c31-4e84-a469-fae0223ac205",
                                "sense_id": "690cfbb9-12c0-3ac8-8ee7-3a68f838cf9d",
                                "text": "„Die Akustik trägt bestens, jedes Pizzicato der Celli, jeder Oboenton ist von der Ouvertüre an deutlich zu hören.“"
                            },
                            {
                                "example_id": "7900e1c8-e480-4155-95de-6a7f982d88ef",
                                "sense_id": "690cfbb9-12c0-3ac8-8ee7-3a68f838cf9d",
                                "text": "„Die Koreanerin Yeon Su Nam, Jahrgang 1998, schmeichelt den Publikumsohren mit einem so ausgewogenen, erhabenen Oboenton, dass man ihr ohne weiteres eine große Zukunft wünschen möchte.“"
                            },
                            {
                                "example_id": "fbcf258e-5a9b-4687-8a62-759134e24edc",
                                "sense_id": "690cfbb9-12c0-3ac8-8ee7-3a68f838cf9d",
                                "text": "„Klar artikuliert setzte Silvia Zabarella die Oboentöne über die dunklen Flötenmelodien,“ […]."
                            },
                            {
                                "example_id": "db701dae-b514-41d6-acf4-fe5182b393ec",
                                "sense_id": "690cfbb9-12c0-3ac8-8ee7-3a68f838cf9d",
                                "text": "„Ausdrücke wie der ›deutsche Oboenton‹, der ›französische Klarinettenton‹, der ›Geigenton der Wiener Philharmoniker‹ spezifizieren und differenzieren im Verhältnis zu anderen Oboen, Klarinetten oder sonstigen Instrumententönen,“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
