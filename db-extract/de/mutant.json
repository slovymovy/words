                ],
                "senses": [
                    {
                        "sense_id": "fb587c9a-fd4a-35ec-b0b0-5eba988b8d4c",
                        "entry_id": "91870126-cedc-3248-97d6-05c57386a83b",
                        "glosses": [
                            "Individuum mit durch Mutation verändertem Erbgut"
                        ],
                        "tags": [
                            "speziell Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "b94b75d7-a481-42d7-b24b-8b73c80e1a50",
                                "sense_id": "fb587c9a-fd4a-35ec-b0b0-5eba988b8d4c",
                                "text": "„Immerhin kämpft Professor X für das friedliche Zusammenleben von Menschen und Mutanten, also Menschen mit besonderem Gencode und daraus resultierenden besonderen Fähigkeiten, die von den ‚Normalen‘ oft gefürchtet oder gar gehasst werden.“"
                            },
                            {
                                "example_id": "9ecbb33a-21d3-4e55-966b-734daaf91d8e",
                                "sense_id": "fb587c9a-fd4a-35ec-b0b0-5eba988b8d4c",
                                "text": "„Allerdings mindert die Bestrahlung auch Fitness und Überlebensfähigkeit der Mutanten, sodass oft doch wilde Männchen zum Zuge kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "23b6d7d4-fabe-354d-97cb-a07d8e7ac4cd",
                        "entry_id": "91870126-cedc-3248-97d6-05c57386a83b",
                        "glosses": [
                            "(Chor-)Knabe im Stimmwechsel"
                        ],
                        "tags": [
                            "regional (Österreich)"
                        ],
                        "examples": [
                            {
                                "example_id": "b7e7ad73-3122-4899-8a75-e6a426817ec7",
                                "sense_id": "23b6d7d4-fabe-354d-97cb-a07d8e7ac4cd",
                                "text": "„Nach der endgültigen Entscheidung des Obersthofmeisteramtes zugunsten einer Konviktserziehung für die kk Hofsängerknaben und die Mutanten aus ihren Reihen, welche ein 1.-Klasse-Zeugnis mit Vorzug erworben hatten, entwickelte sich eine Balance zwischen liturgischer und profaner Funktion.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d682688-5497-4f29-a6b9-c7faef30f23d",
                        "source_entry_id": "91870126-cedc-3248-97d6-05c57386a83b",
                        "source_sense_id": "fb587c9a-fd4a-35ec-b0b0-5eba988b8d4c",
                        "source_sense_description": "Biologie, speziell Genetik: Individuum mit durch Mutation verändertem Erbgut",
                        "target_lang_word": "mutant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8caf4f9c-223e-310c-aaba-5c6d3e684329",
                                        "entry_id": "3080d64b-5562-322b-89ba-8e88cf831a2f",
                                        "glosses": [
                                            "That which has mutated, with one or more new characteristics from a mutation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bfdb07b-85fa-4477-81ac-ed2c7d2fb37f",
                                                "sense_id": "8caf4f9c-223e-310c-aaba-5c6d3e684329",
                                                "text": "Furthermore, it is possible that there occasionally arises what may be called a mutant of very desirable character from a eugenic point of view."
                                            },
                                            {
                                                "example_id": "05ca96bd-e635-4628-a9c5-ec7154208040",
                                                "sense_id": "8caf4f9c-223e-310c-aaba-5c6d3e684329",
                                                "text": "There does seem to have been some mutation among plants[…]but in animal life where are the mutants? When or where has a new species originated in this way?"
                                            },
                                            {
                                                "example_id": "8e35ad2a-190d-40c3-8cdb-069ad3319327",
                                                "sense_id": "8caf4f9c-223e-310c-aaba-5c6d3e684329",
                                                "text": "\"How did I ever get such ability?\" he wondered. \"No one else in our family has it. Am I some sort of a mutant? But if so, how or why? I never heard Dad or Mother mention it.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5eabc6c-4162-31ca-9416-85e18e45f8b6",
                                        "entry_id": "3080d64b-5562-322b-89ba-8e88cf831a2f",
                                        "glosses": [
                                            "Someone or something that seems strange, abnormal, or bizarre."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bba6bc0d-627c-4696-aa97-368a5f5ddfc3",
                                                "sense_id": "c5eabc6c-4162-31ca-9416-85e18e45f8b6",
                                                "text": "Your neighbor seems to be a mutant; he’s so cringy!"
                                            },
                                            {
                                                "example_id": "a35108a0-3689-4e94-8456-ea9afdc4f534",
                                                "sense_id": "c5eabc6c-4162-31ca-9416-85e18e45f8b6",
                                                "text": "She could really get to like this relationship with Raven, if it weren't for the fact that he's a homicidal mutant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b391e81b-1c60-3452-857b-d1856a3cb24f",
                                        "entry_id": "3080d64b-5562-322b-89ba-8e88cf831a2f",
                                        "glosses": [
                                            "Synonym of mutex."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mutant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1406259a-a404-3db5-921a-26ecccb2033e",
                                        "entry_id": "d82c646f-17bf-3f4f-93cc-bbadd5749107",
                                        "glosses": [
                                            "Of, relating to, undergoing (i.e. mutating), or resulting from change or mutation; that has undergone mutation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6db81d00-7cc0-464a-8a76-0e6706b82bbc",
                                                "sense_id": "1406259a-a404-3db5-921a-26ecccb2033e",
                                                "text": "mutant DNA"
                                            },
                                            {
                                                "example_id": "7f21da85-ed70-4cb5-83de-c376cc3a7398",
                                                "sense_id": "1406259a-a404-3db5-921a-26ecccb2033e",
                                                "text": "Scientists have created a mutant enzyme that breaks down plastic drinks bottles—by accident."
                                            },
                                            {
                                                "example_id": "b7704fe0-1866-44f9-b863-101b815a3220",
                                                "sense_id": "1406259a-a404-3db5-921a-26ecccb2033e",
                                                "text": "Researchers at the SSI found that antibodies from people who recovered from coronavirus were less effective at neutralising the mutant strain, but have not made details of their experiments public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45127bc5-71bd-3871-aae5-fdae5d8bd96c",
                                        "entry_id": "d82c646f-17bf-3f4f-93cc-bbadd5749107",
                                        "glosses": [
                                            "Strange, abnormal, or bizarre."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fedf2e5e-9d93-4e02-a362-b3e2a7ff3666",
                                                "sense_id": "45127bc5-71bd-3871-aae5-fdae5d8bd96c",
                                                "text": "Your mutant brother just growled at me again!"
                                            },
                                            {
                                                "example_id": "53809590-6cba-47f1-9fff-cb8c1a6ae0ac",
                                                "sense_id": "45127bc5-71bd-3871-aae5-fdae5d8bd96c",
                                                "text": "Boris Johnson got an angry response after telling school pupils that the exam results crisis was caused by a “mutant algorithm” and he was glad it had been “sorted out”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
