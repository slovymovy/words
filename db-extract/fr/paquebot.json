        "fr-extract.jsonl": [
            {
                "entry_id": "77ca889d-4c7d-3fb6-84e7-553d94bdb240",
                "word": "paquebot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1203fdb4-bdeb-467b-89c0-175c5db92504",
                        "entry_id": "77ca889d-4c7d-3fb6-84e7-553d94bdb240",
                        "tags": [
                            "plural"
                        ],
                        "form": "paquebots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5799f170-78f6-39fa-acf1-b8cdcfa7cd56",
                        "entry_id": "77ca889d-4c7d-3fb6-84e7-553d94bdb240",
                        "glosses": [
                            "Navire spécialisé dans le transport de personnes en haute mer."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "b520990a-0ecb-424e-84ab-d627ce13230c",
                                "sense_id": "5799f170-78f6-39fa-acf1-b8cdcfa7cd56",
                                "text": "Le paquebot ne ſe méfiant plus de rien, & craignant de donner ſur les bancs pendant la nuit, avait fait baiſſer les voiles pour entrer hier matin de bonne heure dans le port d’Hellevœt."
                            },
                            {
                                "example_id": "b654e6df-4ee2-42c2-ba4b-8c95e3870758",
                                "sense_id": "5799f170-78f6-39fa-acf1-b8cdcfa7cd56",
                                "text": "MSC est un armateur italo-suisse dont tous les paquebots de croisière ont été construits à Saint-Nazaire."
                            },
                            {
                                "example_id": "be335c64-3e10-428c-90a7-5a4c6c7b867e",
                                "sense_id": "5799f170-78f6-39fa-acf1-b8cdcfa7cd56",
                                "text": "Je suis habitué à ces fantaisies d’officiers. A la caserne, on est fréquemment convoqué par un capitaine inconnu qui veut connaître sans délai l’horaire de paquebots pour la Chine […]."
                            },
                            {
                                "example_id": "8d4157a1-194a-45e5-ae77-2020b3b1930e",
                                "sense_id": "5799f170-78f6-39fa-acf1-b8cdcfa7cd56",
                                "text": "Un magnifique paquebot danois, le « Oscar II », couvert de monde, nous rattrapa et changea de route pour passer à proximité de Rockall."
                            },
                            {
                                "example_id": "b3b0b3ea-f93a-4472-a158-388f2b352763",
                                "sense_id": "5799f170-78f6-39fa-acf1-b8cdcfa7cd56",
                                "text": "Chaque semaine, des paquebots arrivaient de New-York et débarquaient des touristes américains qui venaient se reposer de leurs affaires, à l’abri des lois de la prohibition."
                            },
                            {
                                "example_id": "61a07778-4d01-4433-8657-ec897e31d643",
                                "sense_id": "5799f170-78f6-39fa-acf1-b8cdcfa7cd56",
                                "text": "Bellonte faisait des calculs pour situer la position des paquebots aux heures où ne passerions certaines longitudes."
                            }
                        ]
                    },
                    {
                        "sense_id": "9dd8a5be-058c-3b63-b26d-ea263700b1a5",
                        "entry_id": "77ca889d-4c7d-3fb6-84e7-553d94bdb240",
                        "glosses": [
                            "Grosse voiture."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "84199d7d-d9d7-414d-a5cc-7d4efa328673",
                                "sense_id": "9dd8a5be-058c-3b63-b26d-ea263700b1a5",
                                "text": "Alors, tu l’avances ton paquebot ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b185f62-38a7-4057-b0f0-c8601d5f596e",
                        "source_entry_id": "77ca889d-4c7d-3fb6-84e7-553d94bdb240",
                        "source_sense_description": "navire",
                        "target_lang_word": "Passagierdampfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Passagierdampfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e74613e1-6716-3f73-a269-83f3173160ea",
                                        "entry_id": "46f14202-22ab-3710-be95-a398348ff477",
                                        "glosses": [
                                            "Personenschiff, speziell Dampfschiff, das für die Beförderung von Personen eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15db4e3e-22f1-4569-b57d-481ee658f6b1",
                                                "sense_id": "e74613e1-6716-3f73-a269-83f3173160ea",
                                                "text": "„Zufällig gleichzeitig traf die Nachricht über die Versenkung des britischen Passagierdampfers Lusitania durch ein U-Boot in der Irischen See ein.“"
                                            },
                                            {
                                                "example_id": "d51c9f11-dbab-49c4-9f19-03e91671f4c2",
                                                "sense_id": "e74613e1-6716-3f73-a269-83f3173160ea",
                                                "text": "„Die »Bremen« galt als modernster Passagierdampfer der deutschen Handelsfotte und stellte schon bei ihrer Jungfernfahrt vor 90 Jahren einen Geschwindigkeitsrekord auf.“"
                                            },
                                            {
                                                "example_id": "644f08be-0fed-4840-a960-f204119d5fcc",
                                                "sense_id": "e74613e1-6716-3f73-a269-83f3173160ea",
                                                "text": "„Auf dem großen Passagierdampfer, der um Mitternacht von New York nach Buenos Aires abgehen sollte, herrschte die übliche Geschäftigkeit und Bewegung der letzten Stunde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b66c9c58-0ad5-4aad-aa91-fdc6f4b4dcca",
                        "source_entry_id": "77ca889d-4c7d-3fb6-84e7-553d94bdb240",
                        "source_sense_description": "navire",
                        "target_lang_word": "packet boat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "packet boat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f82c539-994a-3b8f-b323-b3deebfacf4d",
                                        "entry_id": "771dabaa-5448-38f8-9a37-8253cf7ab76a",
                                        "glosses": [
                                            "An ocean-going ship chartered by the government to carry the mail and official communications."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23bf877e-8176-401e-95c4-939776f4f958",
                                                "sense_id": "9f82c539-994a-3b8f-b323-b3deebfacf4d",
                                                "text": "For every trunk, portmanteau, chest, box, bag, bundle, packet, or parcel, conveyed from any inn to the Custom-house, and from thence to or on board any boat, passage vessel, or packet boat, or landed from any boat, passage vessel or packet boat, and conveyed to the Custom-house, and from thence to any inn, or to the Custom-house only, or direct to any inn, or to any part of the town, not exceeding 28lbs in weight, whether carried by barrow, knot, or hand"
                                            },
                                            {
                                                "example_id": "5c191166-787a-4753-8c8c-0573d822f974",
                                                "sense_id": "9f82c539-994a-3b8f-b323-b3deebfacf4d",
                                                "text": "But the case of Rex v. Jones establishes the principle, that a packet boat employed by his Majesty to carry mails is rateable."
                                            },
                                            {
                                                "example_id": "56c71390-c78a-4883-9481-2cf63cc47c96",
                                                "sense_id": "9f82c539-994a-3b8f-b323-b3deebfacf4d",
                                                "text": "The packet boat on which Harvey should have travelled hoisted sail in the evening, leaving behind a smouldering Kentishman on the shore, where he was forced to spend the night."
                                            },
                                            {
                                                "example_id": "7b93af12-033d-4945-935b-c3faaa869adf",
                                                "sense_id": "9f82c539-994a-3b8f-b323-b3deebfacf4d",
                                                "text": "We were rather annoyed upon our arrival by the master of the packet boat wishing us to engage our places at once; we told him we had not yet made up our minds when we should go, which was a fact as we were divided in opinion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3b6dffa-81ec-35d6-9f7e-e50d2c379c58",
                                        "entry_id": "771dabaa-5448-38f8-9a37-8253cf7ab76a",
                                        "glosses": [
                                            "A boat that carried mail, cargo, and, in later years, some passengers along a regularly scheduled route up and down a river or canal."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a0aa840-36b5-494b-bc58-167ed3d388ad",
                                                "sense_id": "d3b6dffa-81ec-35d6-9f7e-e50d2c379c58",
                                                "text": "On the night in question the plaintiff's boat had arrived at the harbour of Moyvalley, shortly before the arrival of the packet boat; and after touching at the Moyvalley side, so as to give facility to one of the persons on board to hand out oats for the purpose of feeding the horses engaged in drawing the boat, the persons on board pushed the boat with poles across towards the opposite side of the canal, within a few yards of another boat, which was moored close to the opposite bank, in which position the plaintiff's boat was, when the packet boat entered the harbour or station."
                                            },
                                            {
                                                "example_id": "0bf393b0-f848-4986-8d82-5e9f7a8c8093",
                                                "sense_id": "d3b6dffa-81ec-35d6-9f7e-e50d2c379c58",
                                                "text": "Whenever any boats or floats moving in opposite directions, approach a place in the Canal which is less than thirty feet wide on its surface, or which will not safely permit their passing, it shall be the duty of the master of the boat or float ascending the Canal, to stop at such distance from such narrow place as may be convenient for the descending boat or float to pass through such narrow place, and there wait until such passage is effected: Provided, however that a descending boat or float, that is not a licensed packet boat which is about thus to meet an ascending licensed packet boat, shall stop and give place for the said licensed packet boat, first to pass through the said narrow place;- and, provided, also, that descending rafts shall, in all such cases, stop and give place for boats and every other description of ascending floats first to pass through the same."
                                            },
                                            {
                                                "example_id": "5e39f19f-a7ff-4b6c-90b2-91c4def23fac",
                                                "sense_id": "d3b6dffa-81ec-35d6-9f7e-e50d2c379c58",
                                                "text": "For her, none of the advantages of canalling could make up for the horrors she found in spending a night on board a packet boat: 'I would never advise ladies to travel by canal, unless the boats are quite new and clean; or at least, far better kept than any that I saw or heard of on this canal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba894efb-1956-3239-9b25-70ad7e0214b5",
                                        "entry_id": "771dabaa-5448-38f8-9a37-8253cf7ab76a",
                                        "glosses": [
                                            "A boat specifically designed to provide transportation to passengers on a regular schedule up and down a river or canal."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfc2350c-afd8-4cd2-b2d5-47ab4be80332",
                                                "sense_id": "ba894efb-1956-3239-9b25-70ad7e0214b5",
                                                "text": "On the canal is a packet boat with a few passengers visible on top."
                                            },
                                            {
                                                "example_id": "3592155c-ed33-4e2a-9ea8-4d62f8833cd9",
                                                "sense_id": "ba894efb-1956-3239-9b25-70ad7e0214b5",
                                                "text": "In the 1980s, the Apple Grove Resaurant brought back history when it offered packet boat rides on the canal."
                                            },
                                            {
                                                "example_id": "a7219a3f-fe3b-4071-9944-37fe506430a3",
                                                "sense_id": "ba894efb-1956-3239-9b25-70ad7e0214b5",
                                                "text": "Here, she's a force for reconciliation, although it's tempting to imagine Gardner meeting Keel on the packet boat and seducing him rather than sending him back to Grayson."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
