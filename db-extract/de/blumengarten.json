                                "target_senses": [
                                    {
                                        "sense_id": "f17e1aa4-b11a-3ccd-a84d-ff7cea9aa40f",
                                        "entry_id": "57695445-4705-384b-b8a5-7b4b61337c36",
                                        "glosses": [
                                            "A garden where flowers are grown for decorative purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c031dd39-05eb-47a1-b309-540595246867",
                                                "sense_id": "f17e1aa4-b11a-3ccd-a84d-ff7cea9aa40f",
                                                "text": "A mile or so further on is the intermediate station of Ryhall, smothered with primroses in the season, and at all times a veritable flower garden."
                                            }
                                        ]
                                    }
                                ]
