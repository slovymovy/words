                ],
                "senses": [
                    {
                        "sense_id": "31eb5769-d781-30c9-a2da-d3d2b8e36c8f",
                        "entry_id": "6ea7662f-4317-3d78-8958-e22276ec2e8a",
                        "glosses": [
                            "dem Atlantik der östlichen Erdhalbkugel zugehörig; den östlichen Atlantik betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b00f4203-79a0-4acc-8ba7-c9c1091667e7",
                                "sense_id": "31eb5769-d781-30c9-a2da-d3d2b8e36c8f",
                                "text": "„Fischbestände der Nordsee und die Vogelwelt auf ihrer ostatlantischen Zugroute zu erhalten.“"
                            },
                            {
                                "example_id": "16a3293b-a988-4dce-9174-45408f47a6fe",
                                "sense_id": "31eb5769-d781-30c9-a2da-d3d2b8e36c8f",
                                "text": "„Estland nimmt wie Finnland eine zentrale Lage im ostatlantischen Flugweg der Zugvögel auf ihrem Weg von den Brutrevieren im hohen Norden zu den Überwinterungsgebieten in Europa und Afrika ein.“"
                            },
                            {
                                "example_id": "18fa6c5c-29cb-45c4-aae2-641c972ca0b4",
                                "sense_id": "31eb5769-d781-30c9-a2da-d3d2b8e36c8f",
                                "text": "„Der Stöcker kommt an der gesamten ostatlantischen Küste bis nach Südafrika im Süden vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
