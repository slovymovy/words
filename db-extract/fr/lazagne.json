                        "examples": [
                            {
                                "example_id": "dbf560c4-d6b1-40dd-a3b0-86ee2c5cd47f",
                                "sense_id": "facf12b0-7acc-3ad0-a05d-d28a8865ab6d",
                                "text": "C’est sûr ce délicieux plat italien que l’on peut déguster avec un petit verre de chianti, mais le lazagne désigne aussi, au masculin, le portefeuille ou une bourse."
                            }
                        ]
