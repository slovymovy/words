                ],
                "translations": [
                    {
                        "translation_id": "9510ee13-729b-4ac2-8b3c-fc85d3e99add",
                        "source_entry_id": "dfb63247-c3d2-3238-90fe-ae7dee3afe27",
                        "target_lang_word": "annihilating",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "annihilating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2fab088-d63f-3f4b-88c5-4ecc14360cd9",
                                        "entry_id": "5680c342-a344-3603-9737-f87e02ed1ea1",
                                        "glosses": [
                                            "Causing annihilation; devastating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66b8fb31-9bd7-47cf-90a1-5493c6ecff23",
                                                "sense_id": "d2fab088-d63f-3f4b-88c5-4ecc14360cd9",
                                                "text": "The Doctor received a very unfriendly, and the godson, who stood as if turned to stone, a very annihilating glance."
                                            },
                                            {
                                                "example_id": "16b560f2-22f7-47aa-96e0-f93767a7904d",
                                                "sense_id": "d2fab088-d63f-3f4b-88c5-4ecc14360cd9",
                                                "text": "The thought of time, to me at least, is a very overpowering and often a very annihilating one for energy: Time rushing on, unbroken, irresistible, hurrying the worlds and the ages into being, and out of it, and making our 'noisy years seem moments in the being of the eternal Silence.'"
                                            },
                                            {
                                                "example_id": "8ccdbe11-accd-49a0-b6b0-1be9348a427a",
                                                "sense_id": "d2fab088-d63f-3f4b-88c5-4ecc14360cd9",
                                                "text": "Cold revenge is the union of intellect and hate — the most annihilating of all alliances."
                                            },
                                            {
                                                "example_id": "80d91b53-8c88-46d2-9ca9-04724dc42099",
                                                "sense_id": "d2fab088-d63f-3f4b-88c5-4ecc14360cd9",
                                                "text": "Nietzsche adds: \"I found that God is the most annihilating and hostile to life of all thoughts; and it is only through the enormous obscurity of the dear pious ones and the metaphysicians of all time that knowledge of this 'truth' had so long to be awaited.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "annihilating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cd054e7-8bef-38b6-b26f-f5e56cd8ff46",
                                        "entry_id": "0a29ba4e-7fcf-3fa6-8921-2fd6ca84a5b2",
