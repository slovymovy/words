                    {
                        "sense_id": "b03edb7e-c9f1-33ea-a7f0-3080e8171514",
                        "entry_id": "34f66bf2-94fb-37f8-85ec-72147c7c6ff8",
                        "glosses": [
                            "gepaard gaand met extreme beweeglijkheid (hyperkinesie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4814cef5-fe71-41d6-a10d-08c02515f26f",
                                "sense_id": "b03edb7e-c9f1-33ea-a7f0-3080e8171514",
                                "text": "Over ‘carpe diem’ en het verhevigde leven moest je gonzojournalist en briljant schrijver Hunter S. Thompson niets leren. Terry Gilliam ondernam een verdienstelijke poging om Thompsons onmogelijke mengeling van LSD-trip en vettig aangedikt proza naar het scherm te vertalen, met Benicio Del Toro als Dr. Gonzo, maar vooral Johnny Depp die zich in al zijn hyperkinetisch maniërisme kan uitleven als Thompsons alter ego Raoul Duke."
                            },
                            {
                                "example_id": "edd3e4ee-cc95-4950-8e20-7493f75cb84c",
                                "sense_id": "b03edb7e-c9f1-33ea-a7f0-3080e8171514",
                                "text": "Op het podium werd Garbus, zelf op percussie en effecten, bijgestaan door bassist-toetsenist Nate Brenner, een percussioniste en twee hyperkinetische zangeressen."
                            },
                            {
                                "example_id": "41595a07-ee3e-44e0-8c21-fa12eb1045e9",
                                "sense_id": "b03edb7e-c9f1-33ea-a7f0-3080e8171514",
                                "text": "Tokyo Giants speelt zich af in de hyperkinetische straten van Tokio en is het derde luik van de Plot Point-trilogie."
                            }
                        ]
                    }
