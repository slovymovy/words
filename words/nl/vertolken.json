{
    "word_family": [
        "tolk",
        "vertolking",
        "vertolker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79cf6f80-3161-3111-92c1-2666c978f866",
                    "sense_definition": "Gedachten, gevoelens of meningen onder woorden brengen of tot uitdrukking brengen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expressie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Haar vurige toespraak <w>vertolkt</w> de bezorgdheid van veel bezorgde burgers.",
                            "target_lang_translations": {
                                "de": "Ihre feurige Rede <w>bringt</w> die Besorgnis vieler besorgter Bürger <w>zum Ausdruck</w>."
                            }
                        },
                        {
                            "text": "De woordvoerder wist de standpunten van de partij uitstekend te <w>vertolken</w>.",
                            "target_lang_translations": {
                                "de": "Der Sprecher verstand es hervorragend, die Standpunkte der Partei <w>wiederzugeben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitdrukken"
                    ],
                    "common_phrases": [
                        "de gevoelens vertolken",
                        "de stem vertolken"
                    ],
                    "target_lang_definitions": {
                        "de": "Gedanken, Gefühle oder Meinungen in Worte fassen oder zum Ausdruck bringen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zum Ausdruck bringen",
                                "target_lang_sense_clarification": "Meinungen, Gefühle formulieren"
                            },
                            {
                                "target_lang_word": "ausdrücken",
                                "target_lang_sense_clarification": "Gedanken, Empfindungen mitteilen"
                            },
                            {
                                "target_lang_word": "wiedergeben",
                                "target_lang_sense_clarification": "Standpunkte oder Stimmungen darstellen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0e200c5-2a9d-382f-8f40-ff89ee05484b",
                    "sense_definition": "Een artistieke rol, muziekstuk of personage op het podium of scherm tot uitvoering brengen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kunst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge actrice zal de rol van de koningin met verve <w>vertolken</w>.",
                            "target_lang_translations": {
                                "de": "Die junge Schauspielerin wird die Rolle der Königin mit Schwung <w>verkörpern</w>."
                            }
                        },
                        {
                            "text": "Het orkest <w>vertolkte</w> de symfonie op een buitengewoon gevoelige wijze.",
                            "target_lang_translations": {
                                "de": "Das Orchester <w>interpretierte</w> die Sinfonie auf außerordentlich einfühlsame Weise."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een rol vertolken",
                        "een personage vertolken"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine künstlerische Rolle, ein Musikstück oder eine Figur auf der Bühne oder der Leinwand darstellen bzw. aufführen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "darstellen",
                                "target_lang_sense_clarification": "eine Rolle spielen"
                            },
                            {
                                "target_lang_word": "verkörpern",
                                "target_lang_sense_clarification": "eine Figur schauspielerisch ausfüllen"
                            },
                            {
                                "target_lang_word": "interpretieren",
                                "target_lang_sense_clarification": "ein Musikstück oder eine Rolle vortragen"
                            },
                            {
                                "target_lang_word": "spielen",
                                "target_lang_sense_clarification": "eine Rolle oder Figur spielen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "feb5d894-c26f-344d-ab42-50c0b6415082",
                    "sense_definition": "Een eigen interpretatie geven aan een tekst, werk of culturele uiting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interpretatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>vertolkt</w> de volksmuziek van zijn thuisland op geheel eigentijdse wijze in zijn composities.",
                            "target_lang_translations": {
                                "de": "Er <w>interpretiert</w> die Volksmusik seiner Heimat in seinen Kompositionen auf völlig zeitgenössische Weise."
                            }
                        },
                        {
                            "text": "De regisseur koos ervoor om de klassieke tragedie volstrekt modern te <w>vertolken</w>.",
                            "target_lang_translations": {
                                "de": "Der Regisseur entschied sich dafür, die klassische Tragödie vollkommen modern zu <w>interpretieren</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einem Text, Werk oder kulturellen Ausdruck eine eigene Interpretation oder Deutung verleihen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "interpretieren",
                                "target_lang_sense_clarification": "ein Kunstwerk oder Werk deuten und wiedergeben"
                            },
                            {
                                "target_lang_word": "auslegen",
                                "target_lang_sense_clarification": "deuten, einen Sinn beilegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3e1bab3-0ffa-3555-8d98-c93bf2848e09",
                    "sense_definition": "Mondeling overzetten van de ene taal naar de andere.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "taal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>vertolkte</w> de toespraak van de diplomaat rechtstreeks voor het aanwezige publiek.",
                            "target_lang_translations": {
                                "de": "Sie <w>dolmetschte</w> die Rede des Diplomaten direkt für das anwesende Publikum."
                            }
                        },
                        {
                            "text": "Het is niet gemakkelijk om een technisch betoog vlekkeloos te <w>vertolken</w> tijdens een conferentie.",
                            "target_lang_translations": {
                                "de": "Es ist nicht leicht, während einer Konferenz einen Fachvortrag fehlerfrei zu <w>dolmetschen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vertalen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Tegenwoordig gebruikt men vrijwel altijd 'tolken' of 'vertalen'."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Mündlich aus einer Sprache in eine andere übertragen (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "dolmetschen",
                                "target_lang_sense_clarification": "mündlich übersetzen"
                            },
                            {
                                "target_lang_word": "übersetzen",
                                "target_lang_sense_clarification": "sprachlich übertragen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}