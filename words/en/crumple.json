{
    "word_family": [
        "crumply"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b5e7565f-7268-3025-8877-300e455a36a0",
                    "sense_definition": "To press or crush something into irregular folds or wrinkles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "crush",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>crumpled</w> the paper note and threw it into the trash can.",
                            "target_lang_translations": {
                                "ru": "Он <w>скомкал</w> бумажную записку и бросил её в мусорное ведро."
                            }
                        },
                        {
                            "text": "She <w>crumpled</w> the letter in her hand after reading the bad news.",
                            "target_lang_translations": {
                                "ru": "Она <w>смяла</w> письмо в руке после того, как прочитала плохие новости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "crumple paper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сжимать или давить на что-либо, создавая неровности, складки или превращая в комок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скомкать",
                                "target_lang_sense_clarification": "сжать что-либо (обычно бумагу) в комок"
                            },
                            {
                                "target_lang_word": "сминать",
                                "target_lang_sense_clarification": "надавливать или сжимать, изменяя форму предмета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d03f59b0-8976-30c0-b9c8-7e5bdb6608ec",
                    "sense_definition": "To become wrinkled or crushed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "crush",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thin metal sheet <w>crumpled</w> easily under the heavy weight.",
                            "target_lang_translations": {
                                "ru": "Тонкий металлический лист легко <w>смялся</w> под тяжелым весом."
                            }
                        },
                        {
                            "text": "The car's bumper <w>crumpled</w> when it hit the post.",
                            "target_lang_translations": {
                                "ru": "Бампер машины <w>смялся</w> при ударе о столб."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться мятым, покрываться складками или деформироваться под воздействием силы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мяться",
                                "target_lang_sense_clarification": "становиться негладким, покрываться складками"
                            },
                            {
                                "target_lang_word": "деформироваться",
                                "target_lang_sense_clarification": "изменять форму под внешним давлением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5f7f605-3157-3c7b-bee8-9bb83f8e13c6",
                    "sense_definition": "To cause an object to collapse or bend inward due to force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accident <w>crumpled</w> the car's body panels.",
                            "target_lang_translations": {
                                "ru": "В результате аварии кузовные панели автомобиля <w>смялись</w>."
                            }
                        },
                        {
                            "text": "The impact <w>crumpled</w> the metal frame of the bicycle.",
                            "target_lang_translations": {
                                "ru": "От удара металлическая рама велосипеда <w>смялась</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить объект к разрушению или прогибу внутрь под воздействием сильного давления или удара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смять",
                                "target_lang_sense_clarification": "сильно деформировать или разрушить форму предмета"
                            },
                            {
                                "target_lang_word": "покоробить",
                                "target_lang_sense_clarification": "искривить или деформировать поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5620123-ad13-32c8-b665-00b48e88b2a2",
                    "sense_definition": "To give way, fail, or surrender under pressure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "collapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team's defense <w>crumpled</w> under the intense pressure of the final minutes.",
                            "target_lang_translations": {
                                "ru": "Оборона команды <w>сломилась</w> под сильным давлением в последние минуты."
                            }
                        },
                        {
                            "text": "The exhausted soldiers finally <w>crumpled</w> after days of fighting.",
                            "target_lang_translations": {
                                "ru": "Изможденные солдаты наконец <w>сломились</w> после нескольких дней боев."
                            }
                        }
                    ],
                    "synonyms": [
                        "buckle#English:_give way, give up, surrender",
                        "cave#Verb",
                        "cave in#Verb",
                        "fold#English:_give way or give up"
                    ],
                    "common_phrases": [
                        "crumple under pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не выдержать давления, сломаться или сдаться в трудной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сломиться",
                                "target_lang_sense_clarification": "не выдержать морального или физического давления"
                            },
                            {
                                "target_lang_word": "сдаться",
                                "target_lang_sense_clarification": "прекратить сопротивление"
                            },
                            {
                                "target_lang_word": "не выдержать",
                                "target_lang_sense_clarification": "потерпеть неудачу под сильным давлением"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8620a3fc-abfa-3f17-a921-73b1f872b288",
                    "sense_definition": "A crease, wrinkle, or irregular fold in a material.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a deep <w>crumple</w> in the fabric of the dress.",
                            "target_lang_translations": {
                                "ru": "На ткани платья была глубокая <w>складка</w>."
                            }
                        },
                        {
                            "text": "She tried to smooth out every <w>crumple</w> in the old map.",
                            "target_lang_translations": {
                                "ru": "Она пыталась разгладить каждый <w>залом</w> на старой карте."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Складка, морщина или неровность на поверхности материала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "складка",
                                "target_lang_sense_clarification": "неровность на ткани или бумаге"
                            },
                            {
                                "target_lang_word": "залом",
                                "target_lang_sense_clarification": "резкая складка или сгиб на материале"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}