                        "examples": [
                            {
                                "example_id": "7f8ad67f-83d1-4423-a4c7-cffc277e04f8",
                                "sense_id": "7fa6c8af-d470-3561-94fe-dcb8ab5aa50e",
                                "text": "Il avait un beau tuyau neuf, une bougrine en velours marron […]"
                            },
                            {
                                "example_id": "eb3b65fb-ced1-47a9-baa8-064768145d84",
                                "sense_id": "7fa6c8af-d470-3561-94fe-dcb8ab5aa50e",
                                "text": "[…] qu’il avait cachée avec une bouteille sous sa bougrine."
                            },
                            {
                                "example_id": "3da131c3-281b-45c1-ac3c-5ff05f66e1e3",
                                "sense_id": "7fa6c8af-d470-3561-94fe-dcb8ab5aa50e",
                                "text": "Charles mit sa bougrine et sortit."
                            },
                            {
                                "example_id": "7a109007-fb89-415a-a9b0-683d06dc21f6",
                                "sense_id": "7fa6c8af-d470-3561-94fe-dcb8ab5aa50e",
                                "text": "Je vous dis que j'ai d'l'air fine avec ma vieille bougrine, pis mon p'tit jupon barré que ma grand-mère m'avait donné."
                            }
                        ]
                    }
