                        "sense_id": "02d263f7-77e9-3278-9f27-d5cde08d1bce",
                        "entry_id": "f05cc289-0db7-326e-bdef-9f0bd612b1a0",
                        "glosses": [
                            "female equivalent of затво́рник (zatvórnik): female hermit, recluse"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "02e85376-8d7e-418b-bd32-0e5bea9052d2",
                                "sense_id": "02d263f7-77e9-3278-9f27-d5cde08d1bce",
                                "text": "Молоды́е затво́рницы в поло́женные часы́ сходи́ли в сад и прогу́ливались под надзо́ром двух стару́х.",
                                "translation": "At appointed hours the young recluses were let out to the garden and strolled under the supervision of two old women.",
                                "english": "At appointed hours the young recluses were let out to the garden and strolled under the supervision of two old women."
                            }
                        ]
                    }
