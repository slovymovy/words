{
    "word_family": [
        "drowse",
        "drowsiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8664948e-13cb-3edd-8bb8-669e02ed040f",
                    "sense_definition": "Feeling tired and ready to fall asleep",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sleepiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was feeling <w>drowsy</w> and decided to make a cup of coffee to wake myself up.",
                            "target_lang_translations": {
                                "cs": "Cítil jsem se <w>ospalý</w>, a tak jsem se rozhodl udělat si šálek kávy, abych se probral.",
                                "pl": "Czułem się <w>senny</w> i postanowiłem zrobić sobie kawę, żeby się rozbudzić."
                            }
                        },
                        {
                            "text": "The warm sun made everyone feel very <w>drowsy</w> after lunch.",
                            "target_lang_translations": {
                                "cs": "Kvůli teplému slunci se po obědě všichni cítili velmi <w>ospalí</w>.",
                                "pl": "Ciepłe słońce sprawiło, że po obiedzie wszyscy poczuli się bardzo <w>ospali</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sleepy",
                        "tired",
                        "lethargic"
                    ],
                    "common_phrases": [
                        "feeling drowsy"
                    ],
                    "target_lang_definitions": {
                        "cs": "Cítící únavu a potřebu spát, mátožný",
                        "pl": "odczuwający zmęczenie i senność, mający ochotę na sen"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ospalý",
                                "target_lang_sense_clarification": "mající chuť spát"
                            },
                            {
                                "target_lang_word": "omámený",
                                "target_lang_sense_clarification": "otupělý, ztěžklý únavou nebo léky"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "senny",
                                "target_lang_sense_clarification": "taki, któremu chce się spać"
                            },
                            {
                                "target_lang_word": "ospały",
                                "target_lang_sense_clarification": "ociężały, odczuwający potrzebę snu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b70f612-3e61-333c-b386-bc8eb9e61aa0",
                    "sense_definition": "Making someone feel sleepy or relaxed",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sleepiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a warm and <w>drowsy</w> summer afternoon that made us want to nap.",
                            "target_lang_translations": {
                                "cs": "Bylo teplé a <w>ospalé</w> letní odpoledne, které nás přímo lákalo si zdřímnout.",
                                "pl": "To było ciepłe i <w>senne</w> letnie popołudnie, które zachęcało do drzemki."
                            }
                        },
                        {
                            "text": "The <w>drowsy</w> hum of the bees in the garden nearly put him to sleep.",
                            "target_lang_translations": {
                                "cs": "<w>Uspávající</w> bzukot včel v zahradě ho málem uspal.",
                                "pl": "<w>Usypiające</w> brzęczenie pszczół w ogrodzie prawie go uśpiło."
                            }
                        }
                    ],
                    "synonyms": [
                        "soporific",
                        "somnolent"
                    ],
                    "common_phrases": [
                        "drowsy afternoon"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyvolávající pocit ospalosti, klidu nebo únavy",
                        "pl": "wywołujący senność lub sprzyjający relaksowi i wyciszeniu"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "uspávající",
                                "target_lang_sense_clarification": "vyvolávající spánek či dřímotu"
                            },
                            {
                                "target_lang_word": "ospalý",
                                "target_lang_sense_clarification": "přen. líný, poklidný, unaveně působící"
                            },
                            {
                                "target_lang_word": "mátožný",
                                "target_lang_sense_clarification": "pomalý, líný"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "senny",
                                "target_lang_sense_clarification": "wyciszony, leniwy, skłaniający do drzemki"
                            },
                            {
                                "target_lang_word": "usypiający",
                                "target_lang_sense_clarification": "kołyszący do snu, monotonny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}