                                        "entry_id": "886d4121-0f16-3cd1-9033-e7cf02548307",
                                        "glosses": [
                                            "afrikanische Antilope, die in großen Herden lebt und zur Gruppe der Kuhantilopen gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a228bd-37f1-4883-b68e-c22f823b8317",
                                                "sense_id": "e58eee55-d2e7-39bb-8e37-4c9d49549fba",
                                                "text": "Man unterscheidet zwei Arten von Gnus: das Streifengnu in Ost- und Südafrika (Connochaetes taurinus), und das Weißschwanzgnu (Connochaetes gnou), beheimatet im zentralen und östlichen Südafrika."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
