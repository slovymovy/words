                                        "glosses": [
                                            "ein kleines, mundgerechtes Stück eines Nahrungsmittels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "537ba9b3-d31e-4500-9698-4ed911be2fae",
                                                "sense_id": "a2eb399b-f5ea-3c62-bfb3-d53115f7380a",
                                                "text": "Das Fleisch hat er in kleine Happen geschnitten, damit jeder etwas davon abbekommt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d3799cc-a149-3a9a-9956-cac53ed127d9",
                                        "entry_id": "cfead3ff-618b-3d1c-812f-57de3948c691",
                                        "glosses": [
                                            "eine kleinere Mahlzeit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "199e5378-7d1d-4540-a526-ddbf20c7886b",
                                                "sense_id": "3d3799cc-a149-3a9a-9956-cac53ed127d9",
                                                "text": "„In einem kleinen Restaurant aßen wir einen Happen und gingen dann gemeinsam zur Bank.“"
                                            },
                                            {
                                                "example_id": "67d0dfbc-4ef2-455c-86c2-f0d52d158f42",
                                                "sense_id": "3d3799cc-a149-3a9a-9956-cac53ed127d9",
                                                "text": "Ich könnte jetzt einen Happen vertragen, der Magen hängt mir schon zwischen den Knien."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
