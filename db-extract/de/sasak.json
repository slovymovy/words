                "senses": [
                    {
                        "sense_id": "2789d85e-8f3c-30fb-a87c-19f15ef50241",
                        "entry_id": "d767416a-626d-3732-b396-d75e0ed97acc",
                        "glosses": [
                            "Sprache des gleichnamigen Volks auf der indonesischen Insel Lombok; sie ist mit dem Balinesischen verwandt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11cc9c2a-553b-4824-8bcc-6dfb94c65863",
                                "sense_id": "2789d85e-8f3c-30fb-a87c-19f15ef50241",
                                "text": "„Nach einer üblichen Klassifizierung werden fünf regionale Dialekte des Sasak unterschieden: menó-mené, ngenó-ngené, meriyak-meriku, kutó-kuté und ngettó-ngetté.“"
                            },
                            {
                                "example_id": "342d52cb-b63f-4c68-b135-d8b01217744f",
                                "sense_id": "2789d85e-8f3c-30fb-a87c-19f15ef50241",
                                "text": "„Aus jener Zeit stammen einige Sasak-Dörfer bei Amlapura und die Musiktradition des Cekepung, einer Art gesungenes Gamelan, bei dem die Sänger abwechselnd Verse auf Sasak und auf Balinesisch vortragen.“"
                            },
                            {
                                "example_id": "afe05209-648a-43e2-ad84-e1a306afde2d",
                                "sense_id": "2789d85e-8f3c-30fb-a87c-19f15ef50241",
                                "text": "„So heißt beispielsweise ein bestimmter Baum im Sasak ›sana‹, im Malai ›kaju sěna‹, im Minangkabau ›lansano‹ und im Bali ›ansana‹.“"
                            },
                            {
                                "example_id": "84da4cb4-8aa9-4cb9-bb8d-7d4be17ff4e7",
                                "sense_id": "2789d85e-8f3c-30fb-a87c-19f15ef50241",
                                "text": "„Im Sasak und Lombok (Südsee) ist es allgemeine Regel, daß der weiche Absatz das einfache Verb, der harte das […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
