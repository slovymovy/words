                ],
                "senses": [
                    {
                        "sense_id": "d988e979-b451-3e30-97b2-9b3f1dbe4903",
                        "entry_id": "40ed94b7-37d9-3f84-aa72-73270124fbfd",
                        "glosses": [
                            "Tanzdiele, in der viel Glas verarbeitet wurde (meist insbesondere die Tanzfläche)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c680a60-5011-4702-803f-82e1fa180492",
                                "sense_id": "d988e979-b451-3e30-97b2-9b3f1dbe4903",
                                "text": "„Während drinnen auf der Glastanzdiele der Schwof beginnt, geht man an der Theke zur Tagesordnung über.“"
                            },
                            {
                                "example_id": "93cd783e-1b39-4ccf-b5d4-fc9f8beab491",
                                "sense_id": "d988e979-b451-3e30-97b2-9b3f1dbe4903",
                                "text": "„Er fuhr über die Dörfer und besuchte Glastanzdielen.“"
                            },
                            {
                                "example_id": "75bda4a4-bd90-4b09-8b57-a32ae2e27025",
                                "sense_id": "d988e979-b451-3e30-97b2-9b3f1dbe4903",
                                "text": "„Ende der fünfziger Jahre kamen die Tanzlokale auf und auch in Eifa wurde eine Glastanzdiele eröffnet, die dann Treffpunkt der Jugendlichen wurde.“"
                            },
                            {
                                "example_id": "4003e327-660f-4b0c-9f4d-d70000ad9ae9",
                                "sense_id": "d988e979-b451-3e30-97b2-9b3f1dbe4903",
                                "text": "„Die Studierenden ließen sich vom Kaliort Sondershausen und der dortigen Glastanzdiele, von der Hainleite und dem Einbringen der Hopfenernte verzaubern.“"
                            },
                            {
                                "example_id": "2a994640-dbbe-4bd0-9dab-a833ace18f97",
                                "sense_id": "d988e979-b451-3e30-97b2-9b3f1dbe4903",
                                "text": "„Für die Zeit ein höchst futuristisches Bauwerk mit Schießstand und Kegelbahn, mit Glastanzdiele und einem Palmengarten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
