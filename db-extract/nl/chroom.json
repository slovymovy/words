                                                "sense_id": "46554934-ad09-3a90-9345-96f32a40135e",
                                                "text": "Chrom ist ein essentielles Spurenelement."
                                            },
                                            {
                                                "example_id": "6fb51751-7f00-4869-88de-f532e569cec0",
                                                "sense_id": "46554934-ad09-3a90-9345-96f32a40135e",
