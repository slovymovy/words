                "senses": [
                    {
                        "sense_id": "29f54811-de4f-39e2-ab77-43a36c95eb2c",
                        "entry_id": "100a5f1e-ef22-382d-a1d3-4cc49e98d4fd",
                        "glosses": [
                            "Traiter par corticothérapie (c’est-à-dire en faisant appel aux corticoïdes)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22fb127a-9247-43f6-919a-250464ee71de",
                                "sense_id": "29f54811-de4f-39e2-ab77-43a36c95eb2c",
                                "text": "Faut-il corticothéraper les patients avant une extubation programmée pour prévenir la survenue d’un œdème laryngé ?"
                            },
                            {
                                "example_id": "a76f885d-58fb-4e48-92be-d80263bb807f",
                                "sense_id": "29f54811-de4f-39e2-ab77-43a36c95eb2c",
                                "text": "Se méfier quand-même qu'elle ne soit pas le premier signe d'un zona avant de corticothéraper !"
                            },
                            {
                                "example_id": "780bf020-e4ce-4943-a429-bdd9faeef127",
                                "sense_id": "29f54811-de4f-39e2-ab77-43a36c95eb2c",
                                "text": "Donc tu penses qu'il vaut mieux ne pas corticothéraper et faire du surfactant en postnat immédiat..."
                            }
                        ]
                    }
