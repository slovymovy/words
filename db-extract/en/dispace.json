                                    {
                                        "sense_id": "5c9f46cc-8ffe-34a1-b129-028e5594958c",
                                        "entry_id": "82552c32-6538-3b23-a357-ce97d50a27a1",
                                        "glosses": [
                                            "ohne konkretes Ziel, mehr oder weniger zufällig durch ein Gebiet gehen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff4659b2-c101-4c80-96fb-ecbb59c86d2e",
                                                "sense_id": "5c9f46cc-8ffe-34a1-b129-028e5594958c",
                                                "text": "„Die Stadt bietet eine Menge. In einer halben Stunde können Sie die gut erhaltene Altstadt durchstreifen oder zur Wülzburg hinauffahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "593243bd-7533-3ef6-a031-e87912b0f111",
                                        "entry_id": "82552c32-6538-3b23-a357-ce97d50a27a1",
                                        "glosses": [
                                            "systematisch, zielgerichtet, aufmerksam durch ein Gebiet gehen, um etwas Bestimmtes zu finden, auf etwas Bestimmtes zu achten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f20d03e-030c-4722-997f-2938bae1da45",
                                                "sense_id": "593243bd-7533-3ef6-a031-e87912b0f111",
                                                "text": "„Es würde jetzt bald dunkel sein, und was hatte er nicht schon für schaurige Geschichten über Messerstecher gehört, die in den großen Städten bei Nacht und Nebel die Straßen nach wehrlosen Opfern durchstreiften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40a5afd3-fd68-443f-80f5-f70e31c9c656",
                        "source_entry_id": "6db0831f-b8cd-3643-8ed1-d4349d89accc",
