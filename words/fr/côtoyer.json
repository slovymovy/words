{
    "word_family": [
        "côte",
        "côtier",
        "côtoiement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72a1aaa5-a324-37ee-a79a-b2f473449cdf",
                    "sense_definition": "Fréquenter régulièrement une personne ou un groupe de personnes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans son nouveau travail, elle a la chance de <w>côtoyer</w> des artistes passionnés."
                        },
                        {
                            "text": "Il est parfois difficile de <w>côtoyer</w> quotidiennement des personnalités aussi fortes."
                        }
                    ],
                    "synonyms": [
                        "coudoyer",
                        "fréquenter"
                    ]
                },
                {
                    "sense_id": "fc372ecf-0d38-3b88-9e28-6513b91647fa",
                    "sense_definition": "Suivre ou longer une chose étendue en allant tout le long.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sentier de randonnée <w>côtoie</w> la falaise sur plus de trois kilomètres."
                        },
                        {
                            "text": "Nous avons marché pendant des heures en <w>côtoyant</w> la rive du fleuve."
                        }
                    ],
                    "common_phrases": [
                        "côtoyer la rive",
                        "côtoyer le fleuve"
                    ],
                    "synonyms": [
                        "longer"
                    ]
                },
                {
                    "sense_id": "6f9807f7-36d0-3b6e-a2cb-713c11675dd2",
                    "sense_definition": "Être tout proche de quelque chose, avoisiner ou frôler un état abstrait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proximite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par son métier dangereux de pompier, il <w>côtoie</w> souvent la mort."
                        },
                        {
                            "text": "Dans cette grande ville, les immeubles ultramodernes <w>côtoient</w> d'anciennes bâtisses en ruine."
                        }
                    ],
                    "common_phrases": [
                        "côtoyer le danger",
                        "côtoyer la mort"
                    ]
                },
                {
                    "sense_id": "8da2e710-e6c4-37e4-9d79-3ae211b4115a",
                    "sense_definition": "Naviguer en suivant de près la terre ferme ou le rivage marin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour éviter la houle du large, l'équipage a préféré <w>côtoyer</w> prudemment les terres."
                        },
                        {
                            "text": "Les marins n'osaient pas s'éloigner et se contentaient de <w>côtoyer</w> le rivage pendant leur voyage."
                        }
                    ],
                    "synonyms": [
                        "caboter"
                    ],
                    "common_phrases": [
                        "côtoyer le rivage"
                    ]
                }
            ]
        }
    ]
}