                "senses": [
                    {
                        "sense_id": "1162f998-520a-3e45-8baf-7cc03c0da259",
                        "entry_id": "70f6eb37-cc94-3869-84d1-b5ad19638722",
                        "glosses": [
                            "Schiff, auf dem Kohle transportiert wird beziehungsweise ein solches, das für diese Arbeit vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae300ae-e3e1-4c56-a2db-587a8cddccfc",
                                "sense_id": "1162f998-520a-3e45-8baf-7cc03c0da259",
                                "text": "„Als gegen Ende des letzten Jahrhunderts Ratten von einem gestrandeten Kohlenschiff auf die felsige Insel Ailsa Craig im Firth of Clyde kamen, räuberten sie unter der Brut der 250 000 Papageientaucher.“"
                            },
                            {
                                "example_id": "03f4ac0f-4d4e-488d-ab07-fdc35161a935",
                                "sense_id": "1162f998-520a-3e45-8baf-7cc03c0da259",
                                "text": "„Damals konnte ein Schiff nicht ohne Mühe vom Vorland nach London hinauffahren, und wir beneideten die Kohlenschiffe sehr um ihre großen Blöcke und das leichte Tauwerk, die den Männern die Arbeit derart vereinfachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
