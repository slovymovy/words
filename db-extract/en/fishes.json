                                "sense_id": "b9dc8e61-ac03-3a7e-b874-b8d92ea35932",
                                "text": "Coral bleaching threatens to disrupt the population equilibria of the reef’s fishes."
                            },
                            {
                                "example_id": "f04bdf8d-b4bb-4f99-add4-fc5fe8641c47",
                                "sense_id": "b9dc8e61-ac03-3a7e-b874-b8d92ea35932",
                                "text": "I get eaten by the worms / And weird fishes / Picked over by the worms / And weird fishes / Weird fishes"
                            }
