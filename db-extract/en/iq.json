                    {
                        "sense_id": "4d43d290-b2ac-3c20-89c7-d21c3b258c58",
                        "entry_id": "c4f54f3e-525a-3bbf-8f24-a73602fb1e33",
                        "glosses": [
                            "Initialism of intelligence quotient."
