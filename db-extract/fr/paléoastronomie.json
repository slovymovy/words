                        "entry_id": "4adbaf30-6e4a-3c57-9391-04464fc155b1",
                        "glosses": [
                            "Combinaison d’études astronomiques et archéologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dc9660f-94cb-493e-bbd9-010259758c44",
                                "sense_id": "8055e5a8-a04e-3aa6-aea1-6f70f30adbd3",
                                "text": "L’ethnoastronomie (appelée archéoastronomie ou paléoastronomie selon le sujet et l’époque de la création de l’œuvre étudiée), analyse les peintures, les gravures, les conceptions architecturales, funéraires, les mythes, les rites, etc., d’une culture, d’un groupe social ou d’une civilisation."
                            },
                            {
                                "example_id": "c368d9b5-219a-4b3e-99cd-fff37ba175ea",
                                "sense_id": "8055e5a8-a04e-3aa6-aea1-6f70f30adbd3",
                                "text": "Nouveauté apparue au tournant des années 2000, la paléoastronomie semble faire remonter l’astronomie à l’aube de l’humanité."
                            }
                        ]
                    }
