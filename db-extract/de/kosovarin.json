                        "examples": [
                            {
                                "example_id": "49720cb5-475c-4dee-8397-34433497cfd4",
                                "sense_id": "767da5f4-d812-321a-83ab-dac4d2e1a0c3",
                                "text": "„In Wirklichkeit hat die Kosovarin nie von einer Landesgrenze gesprochen, sondern von der Grenze ihrer Belastbarkeit.“"
                            },
                            {
                                "example_id": "42ed49e5-d5ee-4b61-83bc-9ca6a82dd4f0",
                                "sense_id": "767da5f4-d812-321a-83ab-dac4d2e1a0c3",
                                "text": "„Der Kampf der 15-jährigen Kosovarin Arigona Zogaj spaltet die österreichische Regierungskoalition aus sozialdemokratischer SPÖ und konservativer ÖVP.“"
                            }
                        ],
