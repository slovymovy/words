                                "target_lang_sense_clarification": "относящийся к делу орган"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e3dad82-30f7-3549-ad68-fba7eb70a7c6",
                    "sense_definition": "Functioning adequately or being in proper working order, especially in a biological context.",
