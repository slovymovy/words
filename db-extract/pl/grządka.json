                                                "sense_id": "a7decde5-2173-3633-b3f0-97de94440b34",
                                                "text": "Bern: Wo das Bier in Stangen kommt und die Schokolade Gipfel hat."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "b808fff6-ac38-3256-9d45-443e5a44110d",
                                        "entry_id": "a9bb0b2f-6492-3024-b30d-c2e4c7595cc1",
                                        "glosses": [
