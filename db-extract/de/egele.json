                "senses": [
                    {
                        "sense_id": "f81f8152-25de-3c51-9eec-ba74f5ebf27b",
                        "entry_id": "b4872c90-606c-32c8-8367-f3459de4d167",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56de3daf-9caf-49e6-a946-eb741cb30813",
                                "sense_id": "f81f8152-25de-3c51-9eec-ba74f5ebf27b",
                                "text": "„Der Hanomag R 40 mit 40 PS, Baujahr 1946, von Alfred Egele aus Kürnbach zählte zu den ältesten Traktoren, die die Blicke auf sich zogen.“"
                            },
                            {
                                "example_id": "87dc6567-d9c1-4da2-bb99-60ad95b08e07",
                                "sense_id": "f81f8152-25de-3c51-9eec-ba74f5ebf27b",
                                "text": "„Der in Dornbirn geborene Informatiker Manuel Egele (37), Assistenzprofessor für Computer Engineering an der Boston University, erhielt den \"Junior Principal Investigator\" für eine Arbeit über Computer-Sicherheit.“"
                            },
                            {
                                "example_id": "389561fd-07a2-4305-8e51-a711e1bb404a",
                                "sense_id": "f81f8152-25de-3c51-9eec-ba74f5ebf27b",
                                "text": "„Madeleine Egele gewann nach der Olympia-Generalprobe in Yanqing sowie in Altenberg und dem Sprint in Innsbruck nun auch in Sigulda und liegt damit in der Gesamtwertung an der zweiten Stelle.“"
                            },
                            {
                                "example_id": "52a8abaa-0ca3-4df7-80c2-c53e4cfb757f",
                                "sense_id": "f81f8152-25de-3c51-9eec-ba74f5ebf27b",
                                "text": "„Bereits am Morgen des 18. September haben Michaela Faschauner und Philipp Egele den Weg zum Standesamt eingeschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
