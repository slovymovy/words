                                        "glosses": [
                                            "Rare; not readily found; unusual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06296bf2-920e-42b5-b4b3-738b1426bd09",
                                                "sense_id": "db7aff76-5e5a-3e29-b5e6-a3aa55d57f71",
                                                "text": "Bald eagles are an uncommon sighting in this state."
                                            },
                                            {
                                                "example_id": "ca42e2af-f0d3-44b9-86af-6bb50c69d89e",
                                                "sense_id": "db7aff76-5e5a-3e29-b5e6-a3aa55d57f71",
                                                "text": "This is not an uncommon practice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a484a81-fa26-3d68-bccf-705e6c9e1942",
                                        "entry_id": "0ed962e1-4986-3088-a3c9-2d450b09d711",
                                        "glosses": [
                                            "Remarkable; exceptional."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d354fc3-1e1a-4dde-8b95-24be63e7f138",
                                                "sense_id": "1a484a81-fa26-3d68-bccf-705e6c9e1942",
                                                "text": "The diamond was of uncommon size"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "uncommon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b44fbb0-cffe-3f0d-a4a8-dedf52a5d424",
                                        "entry_id": "3d7446d7-ea27-31a2-a062-17a997e48384",
                                        "glosses": [
                                            "Exceedingly, exceptionally."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "dialectal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7895baaa-667d-46c8-8f48-3aa59d420e57",
                                                "sense_id": "9b44fbb0-cffe-3f0d-a4a8-dedf52a5d424",
                                                "text": "‘Is Suffolk your county, sir?’ asked William.\n‘Yes,’ I said, with some importance. ‘Suffolk’s my county.’\n‘I’m told the dumplings is uncommon fine down there,’ said William."
                                            },
                                            {
                                                "example_id": "91718bb5-4b7b-4b9f-ad3a-e8fee98aac6e",
                                                "sense_id": "9b44fbb0-cffe-3f0d-a4a8-dedf52a5d424",
                                                "text": "'The Squire's pretty springe, considering his weight,' said Mr Macey, 'and he stamps uncommon well.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be1a0854-7c5b-4b1e-80f6-63bd23b07018",
                        "source_entry_id": "585a81f8-b1af-3cc3-8312-64f749731248",
                        "source_sense_id": "50c2517a-bbb6-333f-80bd-7a689441bb79",
                        "target_lang_word": "ungewöhnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungewöhnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                        "entry_id": "d558a056-9765-32fb-abcf-008daa80df73",
                                        "glosses": [
                                            "nicht gewöhnlich, nicht der Gewohnheit entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ddf01c-63b6-4531-acc4-ab87866ab722",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Ungewöhnliche Zeiten erfordern ungewöhnliches Handeln."
                                            },
                                            {
                                                "example_id": "8ee19457-0104-4db1-ba7b-f1bf4d5cf5ad",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "„Ausgerechnet Neuseeland, dessen Einwohner sich nach einem flugunfähigen Vogel stolz Kiwis nennen, hat sich diesem ungewöhnlichen Flugsport verschrieben.“"
                                            },
                                            {
                                                "example_id": "94b0dd82-a208-4b55-91a6-beb7480c5d26",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Am ungewöhnlichsten jedoch war ihre Art zu laufen."
                                            },
                                            {
                                                "example_id": "6b05cb6a-5499-45eb-9df7-7e1b876bc456",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "„Wie reagiert die Psyche des Straßenbahnkondukteurs auf ein Douceur von ungewöhnlichem Ausmaße, das zum Beispiel mehr als dreimal so groß ist als der Fahrpreis und siebenmal so groß als das Normaltrinkgeld!“"
                                            },
                                            {
                                                "example_id": "74dbb13f-c556-49ce-a05a-1667ff695ef4",
                                                "sense_id": "a0829c8c-8e78-3718-9b39-4a0880a84d57",
                                                "text": "Auf einer Pressekonferenz erklärte der US-Präsident [Donald Trump], dass er ein Treffen mit dem kanadischen Premierminister Justin Trudeau […] ausgeschlagen habe. Ungewöhnlich ist, dass ein amtierender Präsident dies öffentlich sagt. Besonders ungewöhnlich ist, dass Kanada gar nicht um das Treffen gebeten hatte. Dies teilte Trudeaus Sprecherin im Anschluss mit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b67284d-4db0-4fa9-a3e5-5418053ae84e",
                        "source_entry_id": "585a81f8-b1af-3cc3-8312-64f749731248",
                        "source_sense_id": "50c2517a-bbb6-333f-80bd-7a689441bb79",
                        "target_lang_word": "peu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85860d31-b642-3743-845b-40a50c35f95e",
                                        "entry_id": "3eab1ec8-2480-38f9-a09f-7674ea9b67f2",
                                        "glosses": [
                                            "Presque pas ; pas beaucoup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d52cc5-5898-4534-b755-487a04f17b55",
                                                "sense_id": "85860d31-b642-3743-845b-40a50c35f95e",
                                                "text": "J’aime peu les proverbes."
                                            },
                                            {
                                                "example_id": "bdef8bf9-022b-4ef5-813c-2728d9edefa8",
                                                "sense_id": "85860d31-b642-3743-845b-40a50c35f95e",
                                                "text": "J’ai peu mangé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "997a4752-b158-3dcf-a994-dc33e050aa2c",
                                        "entry_id": "3eab1ec8-2480-38f9-a09f-7674ea9b67f2",
                                        "glosses": [
                                            "Presque pas ; pas très."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ad5988-1838-4fd5-bf9f-f6c36ec23a22",
                                                "sense_id": "997a4752-b158-3dcf-a994-dc33e050aa2c",
                                                "text": "Il y a des cépages peu hâtifs qui prudemment n'ont pas « débourré » — et, chose remarquable, ce ne sont pas ceux dits « du pays » qu'on s'obstine, aveuglément, à recommander."
                                            },
                                            {
                                                "example_id": "adfbd904-8760-4c6d-894c-fab0f4788bb9",
                                                "sense_id": "997a4752-b158-3dcf-a994-dc33e050aa2c",
                                                "text": "Ce film est peu intéressant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fd4aae9-9310-329f-ab8f-229094307644",
                                        "entry_id": "3eab1ec8-2480-38f9-a09f-7674ea9b67f2",
                                        "glosses": [
                                            "Presque aucun. Pas beaucoup."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475e9061-cd6f-4bdc-9304-588ae9035fbe",
                                                "sense_id": "4fd4aae9-9310-329f-ab8f-229094307644",
                                                "text": "Peu de gens le savent."
                                            },
                                            {
                                                "example_id": "d4a944a1-fb0d-4c77-ad0f-8b426e6853d6",
                                                "sense_id": "4fd4aae9-9310-329f-ab8f-229094307644",
                                                "text": "Il arrivera dans peu de jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e023a5d8-b743-3632-8376-dfa5031ec376",
                                        "entry_id": "3eab1ec8-2480-38f9-a09f-7674ea9b67f2",
                                        "glosses": [
                                            "Peu de choses."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b3e5301-afd2-48a5-bfa0-30b600def3a3",
                                                "sense_id": "e023a5d8-b743-3632-8376-dfa5031ec376",
                                                "text": "… je l'ai suppliée de vous envoyer quelque secours. … Elle m'a donc répondu que peu ne vous servirait à rien, et que, dans la vie simple que vous menez, beaucoup vous embarrasserait."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efa1e37a-a8a5-31db-be0b-e67e78f1e187",
                                        "entry_id": "5488cc39-04aa-310b-a5fd-ef9fc9a87ac2",
                                        "glosses": [
                                            "Peu de gens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58bc49b8-4833-43a0-9a2d-79c2053fb3af",
                                                "sense_id": "efa1e37a-a8a5-31db-be0b-e67e78f1e187",
                                                "text": "Beaucoup sont appelés mais peu sont élus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "311c7f77-db90-3f61-80e1-b49f521cde25",
                                        "entry_id": "5488cc39-04aa-310b-a5fd-ef9fc9a87ac2",
                                        "glosses": [
                                            "Peu de chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1205c901-5ffb-4dd1-8a75-1dfbb89627c8",
                                                "sense_id": "311c7f77-db90-3f61-80e1-b49f521cde25",
                                                "text": "Se contenter de peu."
                                            },
                                            {
                                                "example_id": "f59f33a6-48e6-4252-b390-8175dcfac217",
                                                "sense_id": "311c7f77-db90-3f61-80e1-b49f521cde25",
                                                "text": "Vivre de peu."
                                            },
                                            {
                                                "example_id": "ad766bcf-3fb2-4746-be23-8e882aa3e55c",
                                                "sense_id": "311c7f77-db90-3f61-80e1-b49f521cde25",
                                                "text": "Peu lui suffit."
                                            },
                                            {
                                                "example_id": "854e12b7-2d30-4f70-a31d-688d8a4fa72d",
                                                "sense_id": "311c7f77-db90-3f61-80e1-b49f521cde25",
                                                "text": "Peu avant dîner, l’oncle Rocheflamme entra en traînant les pieds, comme quelqu’un qui a fini sa vie, mais on ne se dérangea pas pour si peu."
                                            },
                                            {
                                                "example_id": "c78d39ac-77c8-4742-bf60-68f3931debf7",
                                                "sense_id": "311c7f77-db90-3f61-80e1-b49f521cde25",
                                                "text": "— Eh bien, non, je ne veux pas qu’on me dérange pour si peu !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1058ee26-91c2-38c3-9c84-d6af546a861f",
                                        "entry_id": "96c5dafc-74c5-30ae-b8d9-a358f3d617af",
                                        "glosses": [
                                            "Petite quantité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85064cb0-be09-4263-a36a-fcf6df3e20d2",
                                                "sense_id": "1058ee26-91c2-38c3-9c84-d6af546a861f",
                                                "text": "Le peu que j’ai fait pour vous ne mérite pas tant de remerciements, Le peu qui me reste à vivre."
                                            },
                                            {
                                                "example_id": "f091d690-6979-44a7-a55f-5662b71a0fa9",
                                                "sense_id": "1058ee26-91c2-38c3-9c84-d6af546a861f",
                                                "text": "Le peu de cas qu’on en fait. Son peu de mérite. Il vit du peu qu’il a."
                                            },
                                            {
                                                "example_id": "9a3c9051-2e7c-4525-adf7-280624afd1ff",
                                                "sense_id": "1058ee26-91c2-38c3-9c84-d6af546a861f",
                                                "text": "Excusez mon peu de mémoire. J’attribue cela au peu de soin que vous avez eu."
                                            },
                                            {
                                                "example_id": "b1b11c7d-9802-4098-97a4-86efba805e42",
                                                "sense_id": "1058ee26-91c2-38c3-9c84-d6af546a861f",
                                                "text": "Cette nuit-là, il y avait dehors une petite pluie de peu : donc, de l’encre, et les feuilles faisaient du bruit comme une robe de faille."
                                            },
                                            {
                                                "example_id": "f5724d84-b851-4bba-9a25-c5c55e2145f8",
                                                "sense_id": "1058ee26-91c2-38c3-9c84-d6af546a861f",
                                                "text": "On venait de supprimer les confitures du petit déjeuner, tout commençait à prendre un goût de peu et de sucre de raisin…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
