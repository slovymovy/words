                ],
                "senses": [
                    {
                        "sense_id": "60215f61-2a56-3809-90cb-0923b86a709a",
                        "entry_id": "3e96e41a-fa19-3454-8438-e03041351e16",
                        "glosses": [
                            "Neutronenstern, der in regelmäßiger Abfolge Impulse elektromagnetischer Wellen abstrahlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da5ac7a7-22ef-4fe3-a7e6-2d9817dfd074",
                                "sense_id": "60215f61-2a56-3809-90cb-0923b86a709a",
                                "text": "Pulsare geben ein nahezu gleichmäßiges Signal von sich."
                            },
                            {
                                "example_id": "7d40beef-8461-4b63-8ae5-81c8633a62b9",
                                "sense_id": "60215f61-2a56-3809-90cb-0923b86a709a",
                                "text": "„Im Zentrum des Krebsnebels befinden sich die Reste eines einst massereichen Sterns, ein rotierender Neutronenstern, der mehr oder weniger rasch pulsierende, hoch- und niedrigenergetische Strahlung aussendet und deshalb \"Pulsar\" genannt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab027653-420c-473c-8d9f-1ddffe8621e0",
                        "source_entry_id": "3e96e41a-fa19-3454-8438-e03041351e16",
                        "source_sense_id": "60215f61-2a56-3809-90cb-0923b86a709a",
                        "source_sense_description": "Astronomie: Neutronenstern, der in regelmäßiger Abfolge Impulse elektromagnetischer Wellen abstrahlt",
                        "target_lang_word": "pulsar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pulsar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65d6cbf3-df87-3843-b5ac-5c7de9754dd5",
                                        "entry_id": "c1e16040-a3e2-30ed-9d67-52b3ef4428c3",
                                        "glosses": [
                                            "A rotating neutron star that emits radio pulses periodically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac084c55-e1ed-43a6-9760-e0ba6a19693a",
                                                "sense_id": "65d6cbf3-df87-3843-b5ac-5c7de9754dd5",
                                                "text": "Rapidly rotating dead stars, pulsars are so named because as they spin, they release beams of electromagnetic radiation across space that appear to pulse like celestial lighthouses.\nBut a pulsar called PSR J1023+0038, located about 4,500 light-years away from Earth in the Sextans constellation, is even more unusual in that some of the pulses are brighter than others, almost like it’s switching between different modes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82c09d05-34e2-4c72-ab6e-638d75e5528e",
                        "source_entry_id": "3e96e41a-fa19-3454-8438-e03041351e16",
                        "source_sense_id": "60215f61-2a56-3809-90cb-0923b86a709a",
                        "source_sense_description": "Astronomie: Neutronenstern, der in regelmäßiger Abfolge Impulse elektromagnetischer Wellen abstrahlt",
                        "target_lang_word": "pulsar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pulsar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "431defa8-dc8b-3916-9a7d-b57af4b897cb",
                                        "entry_id": "0c5db7a2-28e7-37f7-b3f6-3b03bc56b08a",
                                        "glosses": [
                                            "Étoile à neutrons en rotation rapide sur elle-même et émettant des ondes radio à intervalles réguliers. C’est ce qui reste d’une étoile supermassive après son explosion en hypernova, en supernova ou en nova."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65782e73-127b-4df5-85a6-8b1532b50c31",
                                                "sense_id": "431defa8-dc8b-3916-9a7d-b57af4b897cb",
                                                "text": "En 1967, âgée de 24 ans, la Nord-Irlandaise met en évidence le premier pulsar, étoile à neutrons émettant un fort rayonnement électromagnétique."
                                            },
                                            {
                                                "example_id": "2cacff9b-60da-4929-bc82-f12479cfb2d4",
                                                "sense_id": "431defa8-dc8b-3916-9a7d-b57af4b897cb",
                                                "text": "D’autres pulsars « ultrarapides » ont été découverts depuis."
                                            },
                                            {
                                                "example_id": "5cd91403-ff10-4b5d-9c61-b9e33e7a4b1d",
                                                "sense_id": "431defa8-dc8b-3916-9a7d-b57af4b897cb",
                                                "text": "Les pulsars millisecondes sont accélérés en rotation, ce sont des pulsars vieux qui ont été réactivés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ece8af3-1a35-403f-898f-9a8f56cffa2d",
                        "source_entry_id": "3e96e41a-fa19-3454-8438-e03041351e16",
                        "source_sense_id": "60215f61-2a56-3809-90cb-0923b86a709a",
                        "source_sense_description": "Astronomie: Neutronenstern, der in regelmäßiger Abfolge Impulse elektromagnetischer Wellen abstrahlt",
                        "target_lang_word": "пульсар",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пульсар",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e084c2cf-b771-3c36-8182-e39355b796f2",
                                        "entry_id": "afa51338-2f8f-367a-ad70-b75382d9b516",
                                        "glosses": [
                                            "астрон. космический источник излучения, достигающего Земли в виде периодически возникающих импульсов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e78bb50-cf11-4fc0-bb79-7a3376b68acc",
                                                "sense_id": "e084c2cf-b771-3c36-8182-e39355b796f2",
                                                "text": "Голдом была предложена модель, согласно которой пульсар — это вращающаяся нейтронная звезда."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
