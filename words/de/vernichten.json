                    "frequency": "High",
                    "semantic_group_id": "zerstörung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein schwerer Hagelschlag <w>vernichtete</w> innerhalb weniger Minuten die gesamte Ernte der Bauern."
                        },
                        {
                            "text": "Er wollte alle Beweise <w>vernichten</w>, damit die Polizei ihm die Tat nicht nachweisen konnte."
                        }
                    ],
                    "synonyms": [
