                                "target_senses": [
                                    {
                                        "sense_id": "4ef0e137-d9a0-31bc-af49-9f49f7a0268c",
                                        "entry_id": "897c124b-0fd1-366e-bbd7-bd35c2622050",
                                        "glosses": [
                                            "Espèce de requins à 5 paires de fentes branchiales, dont la tête a la forme d’un T, rappelant une masse, un marteau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33444fbb-2abf-4240-862b-0de24388fc83",
                                                "sense_id": "4ef0e137-d9a0-31bc-af49-9f49f7a0268c",
                                                "text": "La forme de la tête d’un requin-marteau lui donne une meilleure vision et permet un odorat plus développé."
                                            },
                                            {
                                                "example_id": "1a647200-6079-47a7-978f-021cbd1dd928",
                                                "sense_id": "4ef0e137-d9a0-31bc-af49-9f49f7a0268c",
                                                "text": "La surveillance par satellite a permis à nos chercheurs de mettre en évidence cette découverte excitante : les requins-marteaux plongent à de très grandes profondeurs. Le requin-marteau est une espèce solitaire, rarement vue avec d’autres requins, qui évitent d’ailleurs sa présence car ce prédateur attaque volontiers ses congénères pour les manger."
                                            }
                                        ]
                                    }
                                ]
                            }
