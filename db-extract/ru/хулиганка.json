                    {
                        "translation_id": "f37f4899-921d-4389-b5c3-4062f042b4d2",
                        "source_entry_id": "50b8e3a7-ba66-3ca2-be4c-4ef7b0127e0f",
                        "source_sense_id": "356d37fd-9946-372e-bef5-3f8eb05f8ccb",
                        "target_lang_word": "hoodlum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoodlum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "509e3195-35bd-3d5e-a011-7562223ae678",
                                        "entry_id": "1d9967df-7cd0-350f-b660-d4846b88e890",
                                        "glosses": [
                                            "A gangster; a hired thug."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6aaa9ac-def6-410e-b6c6-38f215b93dbd",
                                                "sense_id": "509e3195-35bd-3d5e-a011-7562223ae678",
                                                "text": "There is no question the MS-13 gang must be stopped. It is a vile organization of hoodlums with no regard for life."
                                            },
                                            {
                                                "example_id": "e2a34fe6-4e43-4f03-9b84-a53f3aacb178",
                                                "sense_id": "509e3195-35bd-3d5e-a011-7562223ae678",
                                                "text": "In Sam Mendes's excellent gangster movie Road to Perdition (2002), he tested the boundaries further playing a hitman – but while we know he's a killer, we never really see him go full-pelt hoodlum."
                                            },
                                            {
                                                "example_id": "da196fb1-8f7d-407f-8c0a-14a21ddf424f",
                                                "sense_id": "509e3195-35bd-3d5e-a011-7562223ae678",
                                                "text": "Caesar Enrico “Rico” Bandello is a hoodlum who rises swiftly in Chicago’s mob world, in the 1931 film “Little Caesar.” Played by Edward G. Robinson, Rico is tracked down by police and shot."
                                            },
                                            {
                                                "example_id": "39afee49-f75e-4cbe-ae83-88a1a929d49e",
                                                "sense_id": "509e3195-35bd-3d5e-a011-7562223ae678",
                                                "text": "The state’s police spokesman Wasiu Abiodun told CNN in a statement that operatives arrested 11 armed “hoodlums” who set fire to a government building after looting it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "528e9f62-cc2f-3e04-b0aa-aeb2b907e6ea",
                                        "entry_id": "1d9967df-7cd0-350f-b660-d4846b88e890",
                                        "glosses": [
                                            "A rough or violent youth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
