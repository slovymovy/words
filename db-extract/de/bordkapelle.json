                "senses": [
                    {
                        "sense_id": "5aa83a67-00ef-34c3-a67b-9cbfc2068e9d",
                        "entry_id": "d23a16c3-58f9-3e33-a6bb-122c8204eb88",
                        "glosses": [
                            "kleines Musiker-Ensemble, das insbesondere Tanz- und Unterhaltungsmusik auf einem Schiff spielt; aber auch an Land"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "39076844-7c67-4c90-89e7-aba0cb5ca9cf",
                                "sense_id": "5aa83a67-00ef-34c3-a67b-9cbfc2068e9d",
                                "text": "„Die Bordkapelle der Titanic kam zu trauriger Berühmtheit: Während der Luxusdampfer 1912 im Atlantik versank, spielten die acht Musiker unbeirrt weiter, um die Passagiere zu beruhigen.“"
                            },
                            {
                                "example_id": "6687b772-4f2c-45d2-8f0a-70696acda877",
                                "sense_id": "5aa83a67-00ef-34c3-a67b-9cbfc2068e9d",
                                "text": "„Paul Bartsch trug Stücke aus der neuen CD “Tanzende Hunde – Die Lieder der Bordkapelle”, die im Herbst erscheinen wird, vor.“"
                            },
                            {
                                "example_id": "ed96b8fd-dadf-4bec-b645-9248950ce55d",
                                "sense_id": "5aa83a67-00ef-34c3-a67b-9cbfc2068e9d",
                                "text": "„Die Bordkapelle stimmt Sie zunächst mit angenehmer Dinner-Musik auf den Abend ein.“"
                            },
                            {
                                "example_id": "adcf52df-d304-4954-a303-c6a135dd4d32",
                                "sense_id": "5aa83a67-00ef-34c3-a67b-9cbfc2068e9d",
                                "text": "„Zum Abschluss einer gelungenen Kreuzfahrt stärkten sich die Gäste beim Apéro, welches die Bordkapelle im Anschluss an das Konzert offerierte.“"
                            },
                            {
                                "example_id": "0f5f3fb4-3c4a-43b6-9b27-d833af23be9d",
                                "sense_id": "5aa83a67-00ef-34c3-a67b-9cbfc2068e9d",
                                "text": "„Jeden Tag, Punkt 16 Uhr, spielt eine dreiköpfige Bordkapelle - unbeirrbar wie das Salonorchester der «Titanic».“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
