                            }
                        ]
                    },
                    {
                        "sense_id": "1752020c-58e0-3cbb-a1e1-d17aae24cff0",
                        "entry_id": "02f3f924-5362-3328-b567-d908f7c4fac9",
                        "glosses": [
                            "To act as a mediator in a dispute; to arbitrate or mediate."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "00a1686f-8c0d-418f-80a5-50b9c7ae5ed5",
                                "sense_id": "1752020c-58e0-3cbb-a1e1-d17aae24cff0",
                                "text": "I to the Lords will intercede, not doubting / Thir favourable ear,"
                            }
                        ]
                    },
                    {
                        "sense_id": "6e9d0ea0-b53c-39d0-bde1-6f2d9a41a8ba",
                        "entry_id": "02f3f924-5362-3328-b567-d908f7c4fac9",
                        "glosses": [
                            "To pass between; to intervene."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53ed9d6e-1be4-4e89-9f10-95cd5215e739",
                                "sense_id": "6e9d0ea0-b53c-39d0-bde1-6f2d9a41a8ba",
                                "text": "He supposed that a vast period interceded between that origination and the age wherein he lived."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdda81d3-fdf1-4e32-9d5a-640d107fe65a",
                        "source_entry_id": "02f3f924-5362-3328-b567-d908f7c4fac9",
                        "source_sense_description": "to plea on someone else's behalf",
                        "target_lang_word": "přimluvit",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b3d72f4d-4448-40ed-8abd-68615707b4f8",
                        "source_entry_id": "02f3f924-5362-3328-b567-d908f7c4fac9",
                        "source_sense_description": "to plea on someone else's behalf",
                        "target_lang_word": "bitten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bitten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f74a8fd0-ea70-3a2f-a368-fb6ad3e5602b",
                                        "entry_id": "e422ddf7-48b6-37ad-b927-8aaac888dcf8",
                                        "glosses": [
                                            "jemanden in höflicher Form nach etwas fragen, sich in höflicher Form an jemanden wenden, jemanden um etwas ersuchen, einen Wunsch ausdrücken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1040c02f-7286-4f8c-8cb2-12b9575ca90f",
                                                "sense_id": "f74a8fd0-ea70-3a2f-a368-fb6ad3e5602b",
                                                "text": "„Eines Tages klopften zwei Pilger an die Tür und baten um ein Glas Wasser und ein Stück Brot.“"
                                            },
                                            {
                                                "example_id": "3aae420a-fe97-42d9-88da-1ef40adacd05",
                                                "sense_id": "f74a8fd0-ea70-3a2f-a368-fb6ad3e5602b",
                                                "text": "„Aber ich bitte dich um einen Gefallen, nämlich daß er mich einmal im Monat besuchen darf – oder vielleicht auch nur jeden zweiten.“"
                                            },
                                            {
                                                "example_id": "24d47044-8b55-478f-b520-8f58bfdd99a7",
                                                "sense_id": "f74a8fd0-ea70-3a2f-a368-fb6ad3e5602b",
                                                "text": "„Denn ach, ich war noch ziemlich nüchtern; nur in Köthen hatt’ ich, nach alter Gewohnheit, um Kaffee und Kuchen gebeten, mehr aus Neugier als aus Magendrang.“"
                                            },
                                            {
                                                "example_id": "2bf9ee6f-c73f-442b-97ae-71eed7330cd8",
                                                "sense_id": "f74a8fd0-ea70-3a2f-a368-fb6ad3e5602b",
                                                "text": "Bittet, so wird Euch gegeben; suchet, so werdet Ihr finden; klopfet an, so wird Euch aufgetan."
                                            },
                                            {
                                                "example_id": "aac1d223-67bd-4c4b-bd51-7b0ae1eac620",
                                                "sense_id": "f74a8fd0-ea70-3a2f-a368-fb6ad3e5602b",
                                                "text": "„Papst Franziskus hat bei einem Bußakt für die Sünden und Verfehlungen von Vertretern der katholischen Kirche um Vergebung gebeten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "25ec9ee7-91dd-331e-bc3d-3bfe2edbc91a",
                                        "entry_id": "e422ddf7-48b6-37ad-b927-8aaac888dcf8",
                                        "glosses": [
                                            "jemanden in höflicher Form zu etwas einladen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbde5e53-4216-4c98-ba48-f114bb1c9fa8",
                                                "sense_id": "25ec9ee7-91dd-331e-bc3d-3bfe2edbc91a",
                                                "text": "„Als wir uns auf Vorrat satt gegessen hatten, hieß es: Nun bitten wir zu Tisch! Es war eine eindrucksvolle Belehrung über russische Gastfreundschaft.“"
                                            },
                                            {
                                                "example_id": "e4bf7632-4a9d-4349-86db-6e647524331d",
                                                "sense_id": "25ec9ee7-91dd-331e-bc3d-3bfe2edbc91a",
                                                "text": "„Mama ging hinaus den Kaffee zu besorgen, nachdem sie Herrn Laaß auch zu einer Tasse Kaffee gebeten hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "393fe07c-6650-4a60-843a-260accf3047a",
                        "source_entry_id": "02f3f924-5362-3328-b567-d908f7c4fac9",
