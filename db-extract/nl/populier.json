                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a05d17e-116b-4f95-b495-092961c00cee",
                        "source_entry_id": "7cc0aae4-7e1b-3515-a502-4eaac45238f2",
                        "source_sense_id": "c71da125-6603-39ca-8731-0e52b26cffab",
                        "target_lang_word": "peuplier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peuplier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c74b1c35-5faa-321d-96aa-88d4d70a0b7d",
                                        "entry_id": "b6ecee3a-f174-31da-bb19-e5a373293312",
                                        "glosses": [
                                            "Genre de grands arbres des lieux humides, dioïques, aux fleurs mâles ou femelles réunies en chatons pendants et apparaissant avant les feuilles qui sont caduques, simples et alternes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b97687e-7094-46b0-92e1-9f822f114e14",
                                                "sense_id": "c74b1c35-5faa-321d-96aa-88d4d70a0b7d",
                                                "text": "Immobile auprès d’elle, Geneviève tenait à la main un rameau que Stéphanie était sans doute allée détacher de la plus haute cime d’un peuplier, et l’idiote agitait doucement ce feuillage au-dessus de sa compagne endormie, pour chasser les mouches et fraîchir l’atmosphère."
                                            },
                                            {
                                                "example_id": "0373b439-cf21-46f7-a267-a2a23950f856",
                                                "sense_id": "c74b1c35-5faa-321d-96aa-88d4d70a0b7d",
                                                "text": "Il tombait de l’or des pommiers féconds où riaient les pommes rouges au temps heureux ; il tombait de l’or des peupliers jaillissants dont les feuilles sont des disques qui tremblent, mais un or terni sans le secours lumineux du soleil."
                                            },
                                            {
                                                "example_id": "0609d994-5e0c-4803-b093-c361ef735f75",
                                                "sense_id": "c74b1c35-5faa-321d-96aa-88d4d70a0b7d",
                                                "text": "Ce jardin était silencieux, avec ses allées tombales, ses peupliers étêtés, ses gazons piétinés, à moitié morts."
                                            },
                                            {
                                                "example_id": "ab9afba7-723d-42a8-8026-84be85ee8dcb",
                                                "sense_id": "c74b1c35-5faa-321d-96aa-88d4d70a0b7d",
                                                "text": "Arbre d’alignement dressé dans la campagne, le peuplier sert de repère aux voyageurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
