                        "glosses": [
                            "Qui peut être déjoué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a304df96-8c2d-4b8d-b45e-e2a03ca6f121",
                                "sense_id": "1fa10601-61ad-357a-acd1-9bfec62d7da9",
                                "text": "Après la disparition du prince Rwagasoré, elles en seront réduites, pour éviter d’être de plus en plus marginalisées, à tramer des complots, aisément déjouables, ou à compter, de façon tout aussi irréaliste, sur des soulèvements populaires spontanés, à la façon « muléliste »."
                            },
                            {
                                "example_id": "2fa247ed-97de-4a5c-a45d-deba407d284a",
                                "sense_id": "1fa10601-61ad-357a-acd1-9bfec62d7da9",
                                "text": "Cet itinéraire était plus long, mais lui permettait de passer à travers les contrôles plus facilement déjouables dans les va-et-vient de la région côtière, au nord de Krasnovodsk."
                            },
                            {
                                "example_id": "ac150b2c-09e3-4cad-99fc-8eedbebd6628",
                                "sense_id": "1fa10601-61ad-357a-acd1-9bfec62d7da9",
                                "text": "Autre explication: les attentats impliquant des armes plus difficiles à trouver sont plus facilement déjouables par les forces de police."
                            }
                        ]
                    }
