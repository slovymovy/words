                        "entry_id": "71f7c30f-baa9-3bdf-b377-f4de2f85a3e0",
                        "glosses": [
                            "houten plank waarop je groeten en vlees klein kunt hakken"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "cfb32d42-8d71-4693-b3cd-cd5921274d81",
                                "sense_id": "341b2360-ffe3-3776-8b47-11897a7ac337",
                                "text": "PAUL WELLER. Zong als een houten kop, sloeg op zijn gitaar als op een hakbord, maar meende elke noot zozeer dat je hem moeiteloos volgt. Paul Weller had vier gitaren en verder niemand mee, en dat toont waar hij nu staat."
                            },
                            {
                                "example_id": "6b753b2e-36da-43c9-b9c8-165940d83419",
                                "sense_id": "341b2360-ffe3-3776-8b47-11897a7ac337",
                                "text": "Met de pers praten, heeft hij ooit gezegd, is als je ballen op een hakbord leggen. Zijn interviews lijken altijd te ontaarden in een stroom van zelfkritiek en twijfels, die journalisten als een teken van een diepere malaise verklaren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7742d4e0-2967-4b1e-b36b-5d32e3a6a096",
                        "source_entry_id": "71f7c30f-baa9-3bdf-b377-f4de2f85a3e0",
                        "source_sense_id": "341b2360-ffe3-3776-8b47-11897a7ac337",
                        "source_sense_description": "houten plank waarop je groeten en vlees klein kunt hakken",
                        "target_lang_word": "chopping-board",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chopping-board",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91c451d6-4f30-3167-ac95-67223f3bd972",
                                        "entry_id": "43f911fe-8777-31c3-9595-1453a0284b79",
                                        "glosses": [
                                            "Alternative form of chopping board."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24c7fb6c-f364-4254-af62-f74229a61217",
                                                "sense_id": "91c451d6-4f30-3167-ac95-67223f3bd972",
                                                "text": "[T]he woman held it under the tap, and then wiped it with the same cloth she cleaned out the copper with, the verdigris from which adhered to the chopping-board, and from that to the suet with which the pudding was made."
                                            },
                                            {
                                                "example_id": "940ec954-b44a-467e-8077-86e3d7813b4f",
                                                "sense_id": "91c451d6-4f30-3167-ac95-67223f3bd972",
                                                "text": "“When I was captured by the American forces, I was like a fish on a chopping-board,” [Nguyen Quang] Hung said last week. “They could have either killed or spared me.”"
                                            },
                                            {
                                                "example_id": "dad97d79-dc35-46e0-9e6b-5f9512057d62",
                                                "sense_id": "91c451d6-4f30-3167-ac95-67223f3bd972",
                                                "text": "Indeed, I became so addicted to this delightful nectar that I mastered the art of racking my childlike body with bogus spasms of croup in the hope of persuading her to set to with the onion and the chopping-board."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
