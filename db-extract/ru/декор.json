                    {
                        "translation_id": "7faccda8-5329-47a4-a82b-d1ebff137b5d",
                        "source_entry_id": "91c8ff31-4ab9-36f0-b838-a403ac61f9d7",
                        "source_sense_id": "4c430a7d-3ab8-3621-a0b3-51695107951f",
                        "target_lang_word": "Dekor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dekor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6dbd1bf9-e74a-3627-899c-39c2ca975a2f",
                                        "entry_id": "93c9943d-4ace-3f33-92d0-4c5e2b533485",
                                        "glosses": [
                                            "Verzierung auf einem Gebäude oder Gebrauchsgegenstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "045d4f3f-683d-4493-a3e3-f8607d54e52f",
                                                "sense_id": "6dbd1bf9-e74a-3627-899c-39c2ca975a2f",
                                                "text": "„Die Wohnhausanlage besteht aus zwei großen dreigeschossigen Baukörpern mit secessionistisch-geometrisierendem Dekor.“"
                                            },
                                            {
                                                "example_id": "02f33cea-aa55-4d36-b2b8-0de96b7314d1",
                                                "sense_id": "6dbd1bf9-e74a-3627-899c-39c2ca975a2f",
                                                "text": "„Berühmtes Beispiel ist die vom Finnen Timo Sarpaneva 1976 entworfene Suomi-Kaffeekanne, deren Dekor verschiedene Künstler gestalteten, neben Salvador Dali auch Otto Piene oder Hap Grieshaber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0d84067-f85c-35bc-ae1f-bb689e34c092",
                                        "entry_id": "93c9943d-4ace-3f33-92d0-4c5e2b533485",
                                        "glosses": [
                                            "Ausstattung^([3])"
                                        ],
                                        "tags": [
                                            "Darstellende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a74faf7e-6728-495a-a719-8985acae1de3",
                                                "sense_id": "b0d84067-f85c-35bc-ae1f-bb689e34c092",
                                                "text": "„Der Filmemacher, der oft für seine poppigen Dekors und Kostüme, seine schrillen Figuren und fantastisch-romantischen Geschichten verehrt wird, war immer auch ein großer Realist, der die Veränderungen der spanischen Gesellschaft begleitet hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
