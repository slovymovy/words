                        "form": "die Mullahs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08ecf96a-3aa2-3714-9279-79db0ebf4520",
                        "entry_id": "33aad120-5f49-34bf-8c8b-0a61e0a68a89",
                        "glosses": [
                            "Titel für islamische Gelehrte"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ed0534c3-ec5c-4c1e-a8ed-59911517db35",
                                "sense_id": "08ecf96a-3aa2-3714-9279-79db0ebf4520",
                                "text": "„Seine Gegner zweifeln an seiner Ausbildung zum Mullah und werfen ihm Analphabetismus und mangelnde Kenntnis des Islam vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "551efc49-738d-3887-a4e5-eac2f875f96e",
                        "entry_id": "33aad120-5f49-34bf-8c8b-0a61e0a68a89",
                        "glosses": [
                            "Träger des Titels [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb05e3e6-d6fb-4f08-a17a-473ffbf1b3a4",
                                "sense_id": "551efc49-738d-3887-a4e5-eac2f875f96e",
                                "text": "„Und als Mönche und Mullahs für diese Woche zu einem gemeinsamen Friedensgebet in Mandelay aufriefen, für die Versöhnung zwischen den Religionen beten und vor der Gefahr einer Ausweitung des Konflikts über die Rakhine-Grenzen hinaus warnen wollten, verboten es ihnen die burmesischen Behörden kurzerhand.“"
                            },
                            {
                                "example_id": "d053f4f8-1823-42be-9b5d-481330e8d112",
                                "sense_id": "551efc49-738d-3887-a4e5-eac2f875f96e",
                                "text": "„Ayub befürwortete einen muslimischen Staat in Indien, obwohl er aufgrund seines säkularen Weltbildes für Mullahs und einen politischen Islam nicht viel übrig hatte.“"
                            },
                            {
                                "example_id": "8d709579-20c7-409b-b74a-cf30f39704db",
                                "sense_id": "551efc49-738d-3887-a4e5-eac2f875f96e",
                                "text": "„Er hat gerade Unterricht bei unserem Mullah.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "102d3f8b-dfe9-4644-bc51-ececee88c4b1",
                        "source_entry_id": "33aad120-5f49-34bf-8c8b-0a61e0a68a89",
                        "source_sense_id": "08ecf96a-3aa2-3714-9279-79db0ebf4520",
                        "source_sense_description": "kein Plural: Titel für islamische Gelehrte",
                        "target_lang_word": "mullah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mullah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2267fb6-dde4-3800-ad6c-24bf4b7b2c70",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "An honorific title for a scholar of theology and sharia law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8a843e-2e76-4d19-bccd-cb595d46936c",
                                                "sense_id": "f2267fb6-dde4-3800-ad6c-24bf4b7b2c70",
                                                "text": "Leading Republicans do not sympathize with the mullahs, do not repeat their talking points, and do not seek to appease them when they make outrageous claims about other countries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc774c8-755d-3e39-96cd-5e7957279eae",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "An honorific title for a mosque leader."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e692f7f2-1b63-31df-8d12-c7f9534e50b8",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "A scholar and teacher of theology and sharia law, and an issuer of fatwas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f88aec18-e5a2-43c3-945a-240f053db479",
                                                "sense_id": "e692f7f2-1b63-31df-8d12-c7f9534e50b8",
                                                "text": "In the first week of March 2018, the Shia mullah issues a fatwa prohibiting vengeance killing and requiring reconciliation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "629ac748-3655-352e-a37a-191b094489e3",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "A conservative Muslim leader or cleric, especially one who is hostile against other religions."
                                        ],
                                        "tags": [
                                            "India",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1750a548-64e7-3ae5-bad1-f34e714ea902",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "A Muslim."
                                        ],
                                        "tags": [
                                            "India",
                                            "broadly",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a328a4f-89c7-3f13-a11c-48d467d73913",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "A low-level cleric who specializes in telling stories of Ashura, rather than teaching or issuing fatwas."
