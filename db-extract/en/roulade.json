    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bec53098-d57d-31ed-9a7a-bbf3b00639c4",
                "word": "roulade",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "87fc59ca-8969-4e75-bedb-44f253208e46",
                        "entry_id": "bec53098-d57d-31ed-9a7a-bbf3b00639c4",
                        "tags": [
                            "plural"
                        ],
                        "form": "roulades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d175e4e0-c7b3-3084-bc4a-119a1847fb16",
                        "entry_id": "bec53098-d57d-31ed-9a7a-bbf3b00639c4",
                        "glosses": [
                            "An elaborate embellishment of several notes sung to one syllable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62a65013-e25e-4568-af23-c5e59eb1bc74",
                                "sense_id": "d175e4e0-c7b3-3084-bc4a-119a1847fb16",
                                "text": "He leaned back in his chair, and little more than the whites of his upturned eyes were visible; and beating time upon the table with one hand, claw-wise, and with two or three queer, little thrills and roulades, which re-appeared with great precision in each verse, he delivered himself thus, in what I suspect was an old psalm tune: […]"
                            },
                            {
                                "example_id": "e606c1d7-a16a-4f28-a15e-461e9bc52cab",
                                "sense_id": "d175e4e0-c7b3-3084-bc4a-119a1847fb16",
                                "text": "He heard only here and there the ecstatic burst of a mocking-bird's wonderful roulades."
                            }
                        ]
                    },
                    {
                        "sense_id": "a73e1279-0bcc-3e58-9428-2ea48de35c2c",
                        "entry_id": "bec53098-d57d-31ed-9a7a-bbf3b00639c4",
                        "glosses": [
                            "A slice of meat that is rolled up, stuffed, and cooked."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f46dadf-c0cb-40b2-9297-7d6bb15554fa",
                        "source_entry_id": "bec53098-d57d-31ed-9a7a-bbf3b00639c4",
                        "source_sense_description": "An elaborate embellishment of several notes sung to one syllable",
                        "target_lang_word": "рула́да",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рула́да",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "74479269-c447-3d0d-b1df-1a07d1a576f0",
                                        "entry_id": "d2cd2a6b-73c5-3924-bde3-d92bd67bff78",
                                        "glosses": [
                                            "муз. украшение, преимущественно в пении, быстрый виртуозный пассаж"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31832954-e9c1-4aa4-877d-f7b621a6469d",
                                                "sense_id": "74479269-c447-3d0d-b1df-1a07d1a576f0",
                                                "text": "Нестройная, иногда замирающая, иногда усиливающаяся рулада, как смычком, водила по моим нервам, и меня охватила невыразимая жуть."
                                            },
                                            {
                                                "example_id": "fbc28f97-6a6e-4c6d-9222-113bba07a915",
                                                "sense_id": "74479269-c447-3d0d-b1df-1a07d1a576f0",
                                                "text": "Отец Татарского, видимо, легко мог представить себе верного ленинца, благодарно постигающего над вольной аксеновской страницей, что марксизм изначально стоял за свободную любовь, или помешанного на джазе эстета, которого особо протяжная рулада саксофона заставит вдруг понять, что коммунизм победит."
                                            },
                                            {
                                                "example_id": "8b14d8ed-cf47-46b5-88d9-22794c9a2386",
                                                "sense_id": "74479269-c447-3d0d-b1df-1a07d1a576f0",
                                                "text": "И жемчужная рулада — мамин смех."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
