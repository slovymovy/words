            "senses": [
                {
                    "sense_id": "5d877f7d-fb0d-39c8-976b-d4751fb8f68b",
                    "sense_definition": "Lasting only for a short time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>brief</w> conversation before the meeting started.",
