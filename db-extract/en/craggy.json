                    {
                        "translation_id": "44c2fbb0-cec2-4763-9867-418fd8530408",
                        "source_entry_id": "417e1998-1899-3f4d-8b6d-b9a061f4c05f",
                        "source_sense_id": "24f1ea68-7b0d-30f7-b620-e1356cc49ee7",
                        "source_sense_description": "characterized by rugged etc. features",
                        "target_lang_word": "escarpé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escarpé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "695685a7-53f0-32a3-aadf-31dce3ffdc10",
                                        "entry_id": "1b892546-b443-35f3-84d9-1e36b79f3813",
                                        "glosses": [
                                            "Qui est en pente raide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2403f168-31d1-4bcd-9d6f-a984e3f0adcc",
                                                "sense_id": "695685a7-53f0-32a3-aadf-31dce3ffdc10",
                                                "text": "Les oiseaux innombrables nichent dans les falaises escarpées, et effarés par la sirène des navires, s'envolent en nuages bruyants."
                                            },
                                            {
                                                "example_id": "394dd7ed-582e-40a4-aa35-c60ded71ef9c",
                                                "sense_id": "695685a7-53f0-32a3-aadf-31dce3ffdc10",
                                                "text": "Le sentier montait toujours, puis, après avoir grimpé trois raidillons particulièrement escarpés, le décor changea brusquement."
                                            },
                                            {
                                                "example_id": "2c6c98c0-d4d6-4218-af48-92e6ea6008d5",
                                                "sense_id": "695685a7-53f0-32a3-aadf-31dce3ffdc10",
                                                "text": "La documentation archéologique y est malheureusement très rare pour le Haut Moyen Age, le site de Larina à Hières-sur-Amby (Isère) constituant une heureuse exception. Situé au confluent du Rhône et de l'Ain, ce promontoire escarpé a été occupé de la Préhistoire au IXᵉ siècle de notre ère."
                                            },
                                            {
                                                "example_id": "a91f2940-261a-436d-8cea-fe669a36068b",
                                                "sense_id": "695685a7-53f0-32a3-aadf-31dce3ffdc10",
                                                "text": "En bas d'un escalier en pierre étroit et escarpé du fort de la ville portuaire de Limassol, à l'intérieur d'une salle voûtée et bordée de pierres tombales de chevaliers médiévaux, se trouve la chapelle où le roi d'Angleterre Richard Ier, dit Cœur de Lion, se serait marié, en route pour les croisades en 1192."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8862ef98-1b8b-30b2-ac62-5af0bf8cc5f0",
                                        "entry_id": "1b892546-b443-35f3-84d9-1e36b79f3813",
                                        "glosses": [
                                            "(En parlant d'une personne) Dont l'abord n'est pas facile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0edbb405-f8de-46be-aa70-43c7bb2a4924",
                                                "sense_id": "8862ef98-1b8b-30b2-ac62-5af0bf8cc5f0",
                                                "text": "Dès lors il s’aperçut que cette femme était plus forte, plus escarpée qu’elle n’en avait l’air, et qu’il ne fallait pas heurter de front cette piété candide. Il lui défila de nouveau son jargon romantique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "escarpé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed4b2acd-f9e4-3a4b-8f50-85a77855080b",
                                        "entry_id": "4b052f56-de26-3350-850c-992e706ef995",
                                        "glosses": [
                                            "Participe passé masculin singulier de escarper."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
