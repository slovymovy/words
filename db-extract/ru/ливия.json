                        "source_entry_id": "ce93b658-fb5f-3351-951d-8ee20b71a666",
                        "source_sense_id": "91375e4c-79bc-34b0-9fda-c737598ab2b5",
                        "target_lang_word": "Libye",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Libye",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85fe0c78-b04f-3ce5-b405-bd59b1003187",
                                        "entry_id": "7f65db9f-2e6e-312e-b852-084b579ff6ed",
                                        "glosses": [
                                            "Pays d’Afrique du Nord, situé dans l’Est du Maghreb, entre la Tunisie et l'Algérie à l’ouest, l’Égypte à l’est, le Soudan au sud-est, le Tchad et le Niger au sud, et la Méditerranée (golfe de Syrte) au nord. Sa capitale est Tripoli."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56856097-dd87-39fb-a374-08d98cc9bcf9",
                                        "entry_id": "7f65db9f-2e6e-312e-b852-084b579ff6ed",
                                        "glosses": [
                                            "Relatif à la Libye antique, territoire historique des Libyens anciens (Berbères) s'étendant de la rive gauche du Nil aux îles Canaries."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15455fa8-ff4e-4942-9c02-93b9068676ec",
                        "source_entry_id": "ce93b658-fb5f-3351-951d-8ee20b71a666",
                        "source_sense_id": "91375e4c-79bc-34b0-9fda-c737598ab2b5",
                        "target_lang_word": "Lybie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lybie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf0c40c1-da2a-3b04-8c63-b8dac5fdc92f",
                                        "entry_id": "026cd9d3-da10-32e9-9e7b-5b949dbefbf6",
                                        "glosses": [
                                            "Variante ancienne de Libye."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e7d6557-28ab-4dbc-9eba-acb4514cf005",
                                                "sense_id": "bf0c40c1-da2a-3b04-8c63-b8dac5fdc92f",
                                                "text": "Pline dit avec un peu d’exactitude, que les truffes de Lybie étoient plus charnues que les autres."
                                            },
                                            {
                                                "example_id": "043333f8-379d-4e6c-87d1-a30556724d63",
                                                "sense_id": "bf0c40c1-da2a-3b04-8c63-b8dac5fdc92f",
                                                "text": "Volez, oiseaux de Lybie, dont le cou flexible se courbe avec grâce; volez au sommet de l'Ithôme et dites que la fille d'Homère Va revoir les lauriers de la Messénie!"
                                            },
                                            {
                                                "example_id": "96bc9bc8-a859-4a8b-9126-13b0f608fa84",
                                                "sense_id": "bf0c40c1-da2a-3b04-8c63-b8dac5fdc92f",
                                                "text": "Ce fut la conquête musulmane qui redonna la vie à Barqah : le fameux général Amrou ebn el-As, vainqueur de l’Égypte, poussa une expédition dans la Lybie jusqu’à Tripoli, et réunit toute cette contrée à l’empire des khalyfes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
