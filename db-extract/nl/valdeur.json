                    {
                        "sense_id": "228d2f53-6d81-3aad-bc97-2ecf7bd242df",
                        "entry_id": "202420e0-b9bb-3980-afb2-b13b97611910",
                        "glosses": [
                            "deur van een kooi die naar beneden valt als een dier naar binnen gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6f42a35-987f-4436-8d22-52b5505eed84",
                                "sense_id": "228d2f53-6d81-3aad-bc97-2ecf7bd242df",
                                "text": "Volgens Van Mierlo zijn slingerapen slimme beesten die een valdeur van een kooi kunnen blokkeren met een stok om pas daarna het lokaas weg te nemen. En ook de aankomende winter kunnen ze makkelijk overleven. ,,Ze hebben zelfs een oplossing voor koude voeten. Bij vriesweer steken ze hun handen onder hun voeten'', zegt Van Mierlo."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcae0d5c-2876-3a75-a35f-647dce9339e3",
                        "entry_id": "202420e0-b9bb-3980-afb2-b13b97611910",
                        "glosses": [
                            "deur met een scharnier met een horizontale as aan de bovenzijde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ca817e4-f0ca-4760-928e-2e7bfdc86620",
                                "sense_id": "bcae0d5c-2876-3a75-a35f-647dce9339e3",
                                "text": "'Aan het einde van de lagere school was ik erg in de ban van Zorro. Met vriendjes uit de straat verzon ik nieuwe avonturen, liefst op een lege zolder waar we kampplaatsen en valdeuren uitprobeerden."
                            }
                        ]
                    }
