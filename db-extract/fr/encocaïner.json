                "senses": [
                    {
                        "sense_id": "2f019a21-f762-3d6e-820b-c94ef8661d7a",
                        "entry_id": "8bfe8e87-e4e5-3ec6-b2d3-50d5b7b04466",
                        "glosses": [
                            "Intoxiquer à la cocaïne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee2513b-16d9-4be7-9e33-06c40827db00",
                                "sense_id": "2f019a21-f762-3d6e-820b-c94ef8661d7a",
                                "text": "Tout est prétexte à des célébrations où la fête encocaïne les foules hagardes et dociles."
                            },
                            {
                                "example_id": "10c7e13a-8ad4-4877-8d86-6bc26f3f785f",
                                "sense_id": "2f019a21-f762-3d6e-820b-c94ef8661d7a",
                                "text": "Il n’y a rien d’agréable à s’encocaïner, ni de désagréable, seul l’appétit me quitte immédiatement."
                            }
                        ]
                    }
