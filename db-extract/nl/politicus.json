        "nl-extract.jsonl": [
            {
                "entry_id": "a6c57cb5-91af-3593-a39f-791fbf9f0199",
                "word": "politicus",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "404eb6e8-c64b-4f8a-b66a-10fd8662fa85",
                        "entry_id": "a6c57cb5-91af-3593-a39f-791fbf9f0199",
                        "tags": [
                            "plural"
                        ],
                        "form": "politici"
                    },
                    {
                        "form_id": "a7f2d43f-42c3-4e7a-8f9e-7b17dee6c4e9",
                        "entry_id": "a6c57cb5-91af-3593-a39f-791fbf9f0199",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "(politicusje)"
                    },
                    {
                        "form_id": "90261eb3-003c-42a8-9abb-5cfdd8c71835",
                        "entry_id": "a6c57cb5-91af-3593-a39f-791fbf9f0199",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "(politicusjes)"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "306bf912-c8ea-3819-8ca9-1016f5928956",
                        "entry_id": "a6c57cb5-91af-3593-a39f-791fbf9f0199",
                        "glosses": [
                            "iemand die zich beroepsmatig met politiek bezighoudt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "957d1776-cf00-411c-8c6e-89190685124f",
                                "sense_id": "306bf912-c8ea-3819-8ca9-1016f5928956",
                                "text": "Deze politicus hoeft zich geen al te grote zorgen te maken over de volgende verkiezingen."
                            },
                            {
                                "example_id": "09629daf-e78c-4866-bb26-e6dd5af9410b",
                                "sense_id": "306bf912-c8ea-3819-8ca9-1016f5928956",
                                "text": "Eerder werd al bekend dat verdachte Tetsuya Yamagami wrok tegen Abe koesterde, omdat de politicus volgens hem verbonden was aan een religieuze groep. Het is niet duidelijk waarom de 41-jarige man uiteindelijk Abe als slachtoffer koos."
                            },
                            {
                                "example_id": "41229043-9c06-43a3-9539-4569105cf8bf",
                                "sense_id": "306bf912-c8ea-3819-8ca9-1016f5928956",
                                "text": "Het deed hem bijna plezier, gaf hij tenminste voor zichzelf toe, hij zou het niet hardop zeggen, om te lezen hoe de Franse generaals en politici gedwongen waren hun capitulatie te ondertekenen in dezelfde spoorwagon waarin ze het begin van die vreselijke Vrede van Versailles hadden gedicteerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1c552cb-4d96-499e-8e5d-12ebba2be011",
                        "source_entry_id": "a6c57cb5-91af-3593-a39f-791fbf9f0199",
                        "source_sense_id": "306bf912-c8ea-3819-8ca9-1016f5928956",
                        "source_sense_description": "iemand die zich beroepsmatig met politiek bezighoudt",
                        "target_lang_word": "politician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "politician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f593fca0-2f93-3517-a1a9-4b8a269192df",
                                        "entry_id": "329e1f18-c3db-3fb8-973a-84d4f82240ae",
                                        "glosses": [
                                            "One engaged in politics, especially an elected or appointed government official."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f56dc7e-5af6-4a71-91c6-ccb0c3e99a53",
                                                "sense_id": "f593fca0-2f93-3517-a1a9-4b8a269192df",
                                                "text": "Politicians should serve the country's interest."
                                            },
                                            {
                                                "example_id": "77ed57c3-dc26-4b63-bf93-f7d14f9bd635",
                                                "sense_id": "f593fca0-2f93-3517-a1a9-4b8a269192df",
                                                "text": "WHEN the mental growth of a man in public life ceases, he ought, for the sake of the community, to retire. Most of our mediocre or unsuccessful Presidents were slipping downhill mentally before they took office. Lincoln, Cleveland, Roosevelt, Wilson, and Coolidge broadened and strengthened as the years went by.\nBy the same token, some men, unused to politics, become mere politicians when elevated to high office, while other men, brought up in the game of politics, rise superior to their environment."
                                            },
                                            {
                                                "example_id": "664677a6-513a-4cea-92c6-a057ac1c1237",
                                                "sense_id": "f593fca0-2f93-3517-a1a9-4b8a269192df",
                                                "text": "It is not just politicians who find aspects of the explosion in satire unwelcome. Thanks to the internet, professional purveyors of the stuff face a lot more competition. For once, the joke is at their expense. A niche craft practised by a talented few has turned into a globally popular hobby, and what was once considered audacious commentary is now mainstream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3480026f-4108-3c90-9cea-b1fa7aed6de4",
                                        "entry_id": "329e1f18-c3db-3fb8-973a-84d4f82240ae",
                                        "glosses": [
                                            "Specifically, one who regards elected political office as a career."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0cd5367-261b-4bad-b7a6-9a3ad1cc92b9",
                                                "sense_id": "3480026f-4108-3c90-9cea-b1fa7aed6de4",
                                                "text": "Unlike the other candidates, I'm not a politician."
                                            },
                                            {
                                                "example_id": "8697c0d6-2252-4e9e-be2c-0aaa8227aaa0",
                                                "sense_id": "3480026f-4108-3c90-9cea-b1fa7aed6de4",
                                                "text": "I never wanted to be one, and as far as I'm concerned, I'm not a politician now. Am I the best man for this job? Probably not. I am, however, the President of the United States, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdc4c037-0d1e-3be8-b95b-ff1e7f3c02c7",
                                        "entry_id": "329e1f18-c3db-3fb8-973a-84d4f82240ae",
                                        "glosses": [
                                            "A politically active or interested person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b88907a-8180-43a6-af5b-918490604b4f",
                                                "sense_id": "fdc4c037-0d1e-3be8-b95b-ff1e7f3c02c7",
                                                "text": "Only real politicians are interested in this issue."
                                            },
                                            {
                                                "example_id": "9169c126-219c-4c74-8759-b569ec7f61e6",
                                                "sense_id": "fdc4c037-0d1e-3be8-b95b-ff1e7f3c02c7",
                                                "text": "You used to be such a politician. Do you remember the debates we held in Fitzroy's rooms?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10146799-e39c-3eb2-a784-1acca5c11138",
                                        "entry_id": "329e1f18-c3db-3fb8-973a-84d4f82240ae",
                                        "glosses": [
                                            "A sly or ingratiating person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb013cc1-aff4-487d-8834-45755b999fa6",
                                                "sense_id": "10146799-e39c-3eb2-a784-1acca5c11138",
                                                "text": "There is a politician in every office."
                                            },
                                            {
                                                "example_id": "cd8a4feb-caac-472d-b654-34cc7f23f7df",
                                                "sense_id": "10146799-e39c-3eb2-a784-1acca5c11138",
                                                "text": "Mrs. Dimitriou blushed at the compliment. \"Antonios, you are such a politician,\" her husband chuckled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10075904-f6ea-4033-8b95-a9a65b31f28c",
                        "source_entry_id": "a6c57cb5-91af-3593-a39f-791fbf9f0199",
                        "source_sense_id": "306bf912-c8ea-3819-8ca9-1016f5928956",
                        "source_sense_description": "iemand die zich beroepsmatig met politiek bezighoudt",
                        "target_lang_word": "politicien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "politicien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7090f500-6c8a-3462-aed0-6355ed568067",
                                        "entry_id": "c02de8f0-c360-3816-ba15-862d7a657e7f",
                                        "glosses": [
                                            "Personnalité active dans son engagement politique, et spécialement quand elle représente un parti politique ou est une élue du peuple."
                                        ],
                                        "tags": [
                                            "Parfois péjoratif"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b98e6a3c-8354-46c5-a934-214de0675b2a",
                                                "sense_id": "7090f500-6c8a-3462-aed0-6355ed568067",
                                                "text": "Les syndicats peuvent être fort utilement employés à faire de la propagande électorale ; il faut, pour les utiliser avec fruit, une certaine adresse, mais les politi­ciens ne manquent pas de légèreté de main."
                                            },
                                            {
                                                "example_id": "050be8fc-d916-4393-908a-1edab98be672",
                                                "sense_id": "7090f500-6c8a-3462-aed0-6355ed568067",
                                                "text": "Ils se contentaient donc de ménager la chèvre républicaine et le chou réactionnaire avec une délicatesse, un doigté qu’eût pu leur envier tel politicien de plus grande envergure ; député, sénateur, voire sous-secrétaire d’État ou ministre."
                                            },
                                            {
                                                "example_id": "dd0a4440-4a46-401a-bc7a-d99a6df62af5",
                                                "sense_id": "7090f500-6c8a-3462-aed0-6355ed568067",
                                                "text": "Peu préparé à la politique, mais d’opinions légitimistes , il se révèle politicien sans horizon. Les de Broglie et Cie n’ont pas de peine à le circonvenir."
                                            },
                                            {
                                                "example_id": "31a91c7b-0e6e-4cfd-a6e7-f07f55a35d06",
                                                "sense_id": "7090f500-6c8a-3462-aed0-6355ed568067",
                                                "text": "J’ai vu le consulat de Casablanca sans titulaire pendant près de deux ans, puis occupé par un vague politicien qui n’y dura guère plus de trois mois."
                                            },
                                            {
                                                "example_id": "4979ae50-6292-410c-9118-3243887c07aa",
                                                "sense_id": "7090f500-6c8a-3462-aed0-6355ed568067",
                                                "text": "Ça a commencé il y a déjà une trentaine d'années. Les politiciens se sont mis à préférer la forme au fond: ça les rend plus proches, plus complices, plus jeunes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "politicien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4ce352a-a066-340e-992b-eeb7b3f86764",
                                        "entry_id": "9b4e2994-85dc-3d69-8329-4748013cfd19",
                                        "glosses": [
                                            "Relatif à la politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d6fb2f5-7f75-49fd-9406-ee0e98122768",
                                                "sense_id": "e4ce352a-a066-340e-992b-eeb7b3f86764",
                                                "text": "C’est dans ce cercle de personnages politiques réservés et non de personnalités politiciennes et paradeuses qu’il convient de rechercher le profil du remplaçant que Paul Biya prépare pour le Cameroun », précise le politologue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
