            {
                "entry_id": "43926fbb-cb98-3e68-a7ec-7799e6a511d0",
                "word": "extroversion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a6a91367-ddbd-4284-9032-7bde8e778d00",
                        "entry_id": "43926fbb-cb98-3e68-a7ec-7799e6a511d0",
                        "tags": [
                            "plural"
                        ],
                        "form": "extroversions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b984535-db7a-341d-96dc-81be531ce1c5",
                        "entry_id": "43926fbb-cb98-3e68-a7ec-7799e6a511d0",
                        "glosses": [
                            "Inversion, retournement d’un organe membraneux, de telle sorte que la surface interne est à l’extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "674bd590-5d68-42d9-a292-7c9bdaefdfd1",
                                "sense_id": "8b984535-db7a-341d-96dc-81be531ce1c5",
                                "text": "Le mamelon […] ne fait saillie au dehors […] qu’à l’époque de la lactation, où il peut déterminer l’extroversion de la poche mammaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd16e534-1811-347c-9201-0c263552f547",
                        "entry_id": "43926fbb-cb98-3e68-a7ec-7799e6a511d0",
                        "glosses": [
                            "Variante de extraversion."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f7be713b-9983-4e20-bcbb-a59c075967b4",
                                "sense_id": "cd16e534-1811-347c-9201-0c263552f547",
                                "text": "L’intuition […] qui à distance et par extroversion ressent ce que ressent l’autre lui-même."
                            },
                            {
                                "example_id": "6a9db5ac-daaa-46b1-9c95-56673787bd9f",
                                "sense_id": "cd16e534-1811-347c-9201-0c263552f547",
                                "text": "Jung a appelé extroversion cette attitude générale qui porte l’intérêt vers les objets et non vers le sujet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ae947cd-a068-4b01-bf75-2a3111e3356a",
                        "source_entry_id": "43926fbb-cb98-3e68-a7ec-7799e6a511d0",
                        "target_lang_word": "extroversion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extroversion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60a914b5-ddb6-302c-afd1-84567bea31b9",
                                        "entry_id": "c965ae4c-ae0e-3a0a-9d9e-923406db450d",
                                        "glosses": [
                                            "The state or quality of being extroverted or an extrovert",
                                            "Consideration of the material world as an aid to spiritual insight."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1892b6a-a2c5-4867-8387-7128dca8ea59",
                                                "sense_id": "60a914b5-ddb6-302c-afd1-84567bea31b9",
                                                "text": "in mystical Divinity... a scattering or distracting ones thoughts upon exterior objects."
                                            },
                                            {
                                                "example_id": "4d3e5435-e452-47b1-8061-cd559e0b1535",
                                                "sense_id": "60a914b5-ddb6-302c-afd1-84567bea31b9",
                                                "text": "The turning of the eye of the mind from [Christ] to outward things [mystics] call Extroversion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfc70800-c651-3c79-b885-065d3b8cb5e9",
                                        "entry_id": "c965ae4c-ae0e-3a0a-9d9e-923406db450d",
                                        "glosses": [
                                            "The state or quality of being extroverted or an extrovert",
                                            "The condition of being inside out, especially in relation to the bladder."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91da3e9b-9e1e-49c7-a2dd-2b5757ed49a2",
                                                "sense_id": "bfc70800-c651-3c79-b885-065d3b8cb5e9",
                                                "text": "In extroversion of the bladder the anterior part of this organ is more or less completely wanting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac6b2e0-6ceb-31d7-87ed-e99a7241b2be",
                                        "entry_id": "c965ae4c-ae0e-3a0a-9d9e-923406db450d",
                                        "glosses": [
                                            "The state or quality of being extroverted or an extrovert",
                                            "A personality orientation towards others and things outside oneself; behavior expressing such orientation."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4ae8b21-0a9b-4acc-aa8c-8e34f12aba9f",
                                                "sense_id": "aac6b2e0-6ceb-31d7-87ed-e99a7241b2be",
                                                "text": "Extroversion is the thrusting out of the mind on to life, the use of the mind in practical affairs, the pouring out of the libido on external objects."
                                            },
                                            {
                                                "example_id": "3aa005f2-0b14-4606-bc61-a77c6d0321be",
                                                "sense_id": "aac6b2e0-6ceb-31d7-87ed-e99a7241b2be",
                                                "text": "In a genre characterized by brassy extroversion, The Dead is a quiet revolutionary: a musical that dares to be diffident."
                                            },
                                            {
                                                "example_id": "cc1df8f7-d880-4af2-8844-0b5dc9071e77",
                                                "sense_id": "aac6b2e0-6ceb-31d7-87ed-e99a7241b2be",
                                                "text": "The roots of what are popularly taken to be introversion and extroversion show up in infancy: positive emotionality, or extroversion, and negative emotionality, or neuroticism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
