                "senses": [
                    {
                        "sense_id": "77737c38-b55e-349a-a18a-38a415b4442d",
                        "entry_id": "d984c656-8069-32e6-b1fc-6f5d8afa5b3e",
                        "glosses": [
                            "die Versorgung eines geschlossenen Parkplatzgebäudes für Kraftfahrzeuge mit ausreichend frischer Luft; Lüftung von Garagen"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "d853edc8-1f1f-4914-8359-db46af13827e",
                                "sense_id": "77737c38-b55e-349a-a18a-38a415b4442d",
                                "text": "„Die Auslegung der Garagenlüftung hat nach einschlägigen Richtlinien, wie z.B. der ÖNORM H 6003 \"Lüftungstechnische Anlagen für Garagen\" oder der \"Verkehrs- und Umwelttechnischen Richtlinien für Garagenprojekte\" des Magistrats Wien zu erfolgen.“"
                            },
                            {
                                "example_id": "72167b2e-05ec-49bd-9565-9eaefa3bfe50",
                                "sense_id": "77737c38-b55e-349a-a18a-38a415b4442d",
                                "text": "„Ziel des hier beantragten Vorhabens ist es, solche Schichtlüftungen für Garagen zu untersuchen, die damit entstehenden Schadstoffkonzentrationsfelder zu ermitteln, die notwendigen minimalen Zuluftströme zu beziffern und letztlich auf dieser Basis ein neues Konzept für die Garagenlüftung zu beschreiben.“"
                            },
                            {
                                "example_id": "829e9eea-5793-45ba-9896-3168eeccfaea",
                                "sense_id": "77737c38-b55e-349a-a18a-38a415b4442d",
                                "text": "„Sie misst den Kohlenmonoxidgehalt in der Luft, schaltet bei Überschreitung des Grenzwertes die Garagenlüftung ein und warnt frühzeitig bei einer gesundheitsgefährdenden CO-Konzentration.“"
                            },
                            {
                                "example_id": "9ea881fc-18eb-47dd-8962-8484f32984de",
                                "sense_id": "77737c38-b55e-349a-a18a-38a415b4442d",
                                "text": "„Tabelle 1 gibt die Bauvorgaben für eine natürliche Garagenlüftung wieder.“"
                            },
                            {
                                "example_id": "79a01d92-bc2f-4496-ab9e-c5ef5126d3e5",
                                "sense_id": "77737c38-b55e-349a-a18a-38a415b4442d",
                                "text": "„Die Abweichung hinsichtlich der Garagenlüftung betrifft folgende Eckpunkte: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
