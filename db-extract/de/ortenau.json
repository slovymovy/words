                        "sense_id": "34c99284-7c17-375a-9b33-b06b8d29b78e",
                        "entry_id": "534f6aa7-f844-3bdf-b86e-c987ce7524f8",
                        "glosses": [
                            "Landschaft am rechten Oberrhein in Baden-Württemberg zwischen Breisgau im Süden und Schwarzwald im Osten"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "53ad1f44-2414-42d4-889d-1ce4a32955f8",
                                "sense_id": "34c99284-7c17-375a-9b33-b06b8d29b78e",
                                "text": "„Mitmachen können alle Fotobegeisterten, egal ob Hobbyfotograf oder Profi, aus der Ortenau oder von auswärts.“"
                            },
                            {
                                "example_id": "a832f39a-ff3c-4a27-aa48-8ad2cdc646b5",
                                "sense_id": "34c99284-7c17-375a-9b33-b06b8d29b78e",
                                "text": "„Die Ortenau ist nicht nur ein schöner Landstrich – sie lebt durch die Menschen, die hier verwurzelt sind.“"
                            },
                            {
                                "example_id": "4de4b9a2-a280-4086-abde-cdf9f6ebc538",
                                "sense_id": "34c99284-7c17-375a-9b33-b06b8d29b78e",
                                "text": "„Bei einer bundesweiten Kontrolle zur Einhaltung des Mindestlohns entdeckte der Zoll sieben Verstöße bei uns in der Ortenau.“"
                            }
                        ],
