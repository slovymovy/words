                    },
                    {
                        "translation_id": "cdce8a1f-f54f-4f81-8d8f-a5ffdb9b0a6d",
                        "source_entry_id": "a6122825-ff00-3e5a-b6f7-ee5cef1db420",
                        "source_sense_id": "cdff56d5-f141-33de-929d-2dde2642b159",
                        "source_sense_description": "deserting",
                        "target_lang_word": "désertion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désertion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d4f0040-5f67-3762-8174-b47b4af3aa1c",
                                        "entry_id": "8c1aceb2-530d-3d19-b3d8-3ae616d73092",
                                        "glosses": [
                                            "Action de déserter ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "039988a4-bf49-44f6-9206-eae3be1e3526",
                                                "sense_id": "5d4f0040-5f67-3762-8174-b47b4af3aa1c",
                                                "text": "Son trésor est vide. Son armée, mal recrutée, mal équipée, mal disciplinée, absolument démoralisée par ses défaites récentes, est réduite à fort peu de chose par les licenciements forcés et les désertions."
                                            },
                                            {
                                                "example_id": "0f3a0ff8-a54f-4b37-b7ec-e8d2e0681916",
                                                "sense_id": "5d4f0040-5f67-3762-8174-b47b4af3aa1c",
                                                "text": "Il faut donc trouver un argument-massue, un argument capable de semer le doute dans l’âme des ouvriers, d’ébranler leur confiance, d’amener des défections de plus en plus nombreuses, puis des désertions massives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "876406fb-26dd-4c2d-8c8b-c0a41b5123ae",
                        "source_entry_id": "a6122825-ff00-3e5a-b6f7-ee5cef1db420",
                        "source_sense_id": "cdff56d5-f141-33de-929d-2dde2642b159",
                        "source_sense_description": "deserting",
                        "target_lang_word": "Fahnenflucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fahnenflucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c926507-796f-3574-aeff-318f35cd546c",
                                        "entry_id": "89cf0658-92b0-3f4d-9f12-f0844248e4f9",
                                        "glosses": [
                                            "das mehr als drei Tage dauernde schuldhafte unerlaubte Fernbleiben eines Soldaten von der Truppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a197612-fcd3-4cc1-8a54-ec75ccdcb5d3",
                                                "sense_id": "6c926507-796f-3574-aeff-318f35cd546c",
                                                "text": "„Eine Flucht wäre für ihn Fahnenflucht gewesen.“"
                                            },
                                            {
                                                "example_id": "e43d0c1f-37cd-4481-b8c6-350355f80951",
                                                "sense_id": "6c926507-796f-3574-aeff-318f35cd546c",
                                                "text": "Fahnenflucht hat je nach Zeitdauer und verursachten Schadens an der Truppe unterschiedlich starke Konsequenzen für den oder die Fahnenflüchtigen. Diese Konsequenzen reichen von einer empfindlichen Geldstrafe bis hin zu Dauerarrest im Wachlokal der Kaserne. Bei einer länger bestehenden Fahnenflucht werden von Seiten der Bundeswehr die Feldjäger (Truppenteil, der ähnlich zu verstehen ist wie die Polizei im Zivilen) eingesetzt, um den oder die Fahnenflüchtigen in Gewahrsam zu nehmen."
                                            },
                                            {
                                                "example_id": "39be34e1-770a-4ddd-adc7-3311f8e08f83",
                                                "sense_id": "6c926507-796f-3574-aeff-318f35cd546c",
                                                "text": "„Aber sein suchendes Gesicht und sein gequälter Blick ließen ihr dies wie Fahnenflucht erscheinen.“"
                                            },
                                            {
                                                "example_id": "b2f484d2-af6f-4d26-a6a3-61f7c022884e",
                                                "sense_id": "6c926507-796f-3574-aeff-318f35cd546c",
                                                "text": "„Die afghanische Armee erwies sich als ineffizient und schrumpfte infolge von Fahnenflucht binnen weniger Monate von 90 000 Mann auf 30 000 zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "766934e2-a2dd-44c6-83d1-7497fa3c3607",
                        "source_entry_id": "a6122825-ff00-3e5a-b6f7-ee5cef1db420",
                        "source_sense_id": "cdff56d5-f141-33de-929d-2dde2642b159",
