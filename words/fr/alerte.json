                    "frequency": "High",
                    "semantic_group_id": "danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le veilleur a immédiatement donné l'<w>alerte</w> dès qu'il a aperçu de la fumée au loin."
                        },
                        {
                            "text": "Les pompiers ont été mobilisés rapidement après une fausse <w>alerte</w> dans l'immeuble voisin."
                        }
                    ],
                    "common_phrases": [
