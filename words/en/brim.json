{
    "word_family": [
        "brimmer",
        "brimless",
        "brimful"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5b1eb94-7d4b-3de8-8c2e-5362231f2de4",
                    "sense_definition": "The topmost lip or rim of a container, or a natural feature shaped like a container.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter carefully filled the wine glass to the <w>brim</w> without spilling a single drop.",
                            "target_lang_translations": {
                                "ru": "Официант осторожно наполнил бокал вина до самых <w>краёв</w>, не пролив ни капли.",
                                "zh": "服务员小心地把酒杯斟到<w>杯口</w>，一滴也没洒出来。"
                            }
                        },
                        {
                            "text": "The toy box was filled to the <w>brim</w> with stuffed animals and wooden blocks.",
                            "target_lang_translations": {
                                "ru": "Ящик для игрушек был наполнен <w>доверху</w> мягкими игрушками и деревянными кубиками.",
                                "zh": "玩具箱里塞满了毛绒玩具和木积木，都快到<w>边沿</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "filled to the brim",
                        "full to the brim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхний край или ободок контейнера или природного объекта, имеющего форму чаши.",
                        "zh": "容器最上面的边口或边缘，也可指形状像容器的自然物体的边缘。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "край",
                                "target_lang_sense_clarification": "сосуда или емкости"
                            },
                            {
                                "target_lang_word": "кромка",
                                "target_lang_sense_clarification": "верхняя часть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杯口",
                                "target_lang_sense_clarification": "容器上方的边口，如杯子、箱子等"
                            },
                            {
                                "target_lang_word": "边沿",
                                "target_lang_sense_clarification": "容器或凹形物体的上边缘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca7c2bc3-5561-3774-b24c-af6e68192525",
                    "sense_definition": "The projecting edge of a hat that provides shade or style.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled the <w>brim</w> of his hat down to protect his eyes from the bright sun.",
                            "target_lang_translations": {
                                "ru": "Он натянул <w>поля</w> шляпы пониже, чтобы защитить глаза от яркого солнца.",
                                "zh": "他把帽子的<w>帽檐</w>往下拉，好挡住刺眼的阳光。"
                            }
                        },
                        {
                            "text": "The detective wore a classic fedora with a wide <w>brim</w> that cast a shadow over his face.",
                            "target_lang_translations": {
                                "ru": "Детектив носил классическую фетровую шляпу с широкими <w>полями</w>, которые отбрасывали тень на его лицо.",
                                "zh": "那名侦探戴着一顶经典的软呢帽，宽宽的<w>帽檐</w>在他脸上投下了一片阴影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bill",
                        "hatbrim",
                        "rim"
                    ],
                    "common_phrases": [
                        "wide brim",
                        "hat brim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступающая часть шляпы, служащая для защиты от солнца или для стиля.",
                        "zh": "帽子向外突出的边，可以遮阳，也有装饰作用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поля",
                                "target_lang_sense_clarification": "шляпы"
                            },
                            {
                                "target_lang_word": "козырек",
                                "target_lang_sense_clarification": "кепки или фуражки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帽檐",
                                "target_lang_sense_clarification": "帽子向外伸出的边，用来遮阳或作装饰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cda2b79-6dbd-31c9-85c4-580a34d84cf9",
                    "sense_definition": "The border or edge of a body of water, such as a sea or river.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat quietly by the river's <w>brim</w> watching the small fish swim in the clear water.",
                            "target_lang_translations": {
                                "ru": "Мы тихо сидели у самого <w>берега</w> реки, наблюдая, как в чистой воде плавают маленькие рыбки.",
                                "zh": "我们静静地坐在河<w>边</w>，看着小鱼在清澈的水里游来游去。"
                            }
                        },
                        {
                            "text": "Wildflowers grew in abundance along the <w>brim</w> of the lake during the spring.",
                            "target_lang_translations": {
                                "ru": "Весной вдоль <w>кромки</w> озера в изобилии росли полевые цветы.",
                                "zh": "春天时，湖<w>边</w>开满了野花。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "river's brim",
                        "lake's brim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Граница или берег водоема, такого как море или река.",
                        "zh": "河流、湖泊、海等水域的边界或边缘地带。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "берег",
                                "target_lang_sense_clarification": "край воды"
                            },
                            {
                                "target_lang_word": "кромка",
                                "target_lang_sense_clarification": "воды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "岸边",
                                "target_lang_sense_clarification": "河、湖、海等水域的边缘"
                            },
                            {
                                "target_lang_word": "水边",
                                "target_lang_sense_clarification": "靠近水体的边上"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fea4d7ae-7b7a-38be-9f36-ee96916397c9",
                    "sense_definition": "A synonym of <w>bream</w>, referring to various types of freshwater fish.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local fishermen often catch <w>brim</w> in these shallow ponds during the summer months.",
                            "target_lang_translations": {
                                "ru": "Местные рыбаки часто ловят <w>лещей</w> в этих мелководных прудах в летние месяцы.",
                                "zh": "当地渔民夏天常常在这些浅水池塘里捕到<w>鲂鱼</w>。"
                            }
                        },
                        {
                            "text": "Sometimes her daddy would take her fishing for catfish or <w>brim</w> out on the lake.",
                            "target_lang_translations": {
                                "ru": "Иногда папа брал её на озеро ловить сомов или <w>лещей</w>.",
                                "zh": "有时她爸爸会带她去湖上钓鲶鱼或<w>鲂鱼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bream"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность пресноводной рыбы (синоним леща).",
                        "zh": "bream 的另一种说法，指几种淡水鱼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лещ",
                                "target_lang_sense_clarification": "пресноводная рыба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鲂鱼",
                                "target_lang_sense_clarification": "一种淡水鱼，此处作 bream 的异称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8eaf577-7be2-3219-a71e-dcaeaad79283",
                    "sense_definition": "An insulting term for an easily angered or violent woman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old play described the character as a <w>brim</w> who constantly argued with her neighbors.",
                            "target_lang_translations": {
                                "ru": "В старой пьесе персонаж описывался как <w>мегера</w>, которая постоянно ссорилась с соседями.",
                                "zh": "那部老戏把这个人物写成一个总是和邻居吵架的<w>泼妇</w>。"
                            }
                        },
                        {
                            "text": "She's a vixen, a <w>brim</w>, and all that is bad according to the local gossip.",
                            "target_lang_translations": {
                                "ru": "Согласно местным сплетням, она лиса, <w>фурия</w> и воплощение всего дурного.",
                                "zh": "按当地人的闲话说，她是个狐狸精，也是个<w>悍妇</w>，总之坏名声一大堆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shrew",
                        "vixen",
                        "harridan",
                        "virago",
                        "scold"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорбительное обозначение вспыльчивой или агрессивной женщины.",
                        "zh": "侮辱性说法，指容易发怒或性情凶悍的女人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мегера",
                                "target_lang_sense_clarification": "злая женщина"
                            },
                            {
                                "target_lang_word": "фурия",
                                "target_lang_sense_clarification": "разгневанная женщина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泼妇",
                                "target_lang_sense_clarification": "带侮辱意味，指爱发火、爱吵架的女人"
                            },
                            {
                                "target_lang_word": "悍妇",
                                "target_lang_sense_clarification": "带侮辱意味，指凶悍暴躁的女人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b991e4df-0f2d-3179-968a-efb83a0be38f",
                    "sense_definition": "To be full to the point of almost overflowing, often used figuratively with emotions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "filling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete was <w>brimming</w> with confidence after winning the regional championship.",
                            "target_lang_translations": {
                                "ru": "Молодой атлет <w>светился</w> уверенностью после победы на региональном чемпионате.",
                                "zh": "赢得地区冠军后，这位年轻运动员浑身都<w>洋溢</w>着自信。"
                            }
                        },
                        {
                            "text": "Her eyes began to <w>brim</w> with tears as she listened to the sad story.",
                            "target_lang_translations": {
                                "ru": "Её глаза начали <w>наполняться</w> слезами, пока она слушала эту грустную историю.",
                                "zh": "她听着这个悲伤的故事，眼里开始<w>盈满</w>泪水。"
                            }
                        }
                    ],
                    "synonyms": [
                        "teem",
                        "bulge",
                        "overflow"
                    ],
                    "common_phrases": [
                        "brimming with confidence",
                        "brimming with energy",
                        "brimming with joy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть наполненным до такой степени, что содержимое почти переливается через край (часто о чувствах).",
                        "zh": "充满到几乎要溢出的程度，常可用于感情等抽象事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наполняться до краев",
                                "target_lang_sense_clarification": "быть полным"
                            },
                            {
                                "target_lang_word": "переполняться",
                                "target_lang_sense_clarification": "чувствами или жидкостью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "洋溢",
                                "target_lang_sense_clarification": "充满得几乎要溢出，常用于情感、活力等抽象事物"
                            },
                            {
                                "target_lang_word": "盈满",
                                "target_lang_sense_clarification": "液体或情绪充满到快要溢出的程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1e8ec10-eb3a-3583-95d0-03bf9e5b7ff9",
                    "sense_definition": "To fill a container to its very top edge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "filling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host would <w>brim</w> the glasses of his guests with the finest vintage wine.",
                            "target_lang_translations": {
                                "ru": "Хозяин <w>наполнял до краев</w> бокалы гостей лучшим винтажным вином.",
                                "zh": "主人会用上好的陈年葡萄酒把客人的酒杯<w>斟满</w>。"
                            }
                        },
                        {
                            "text": "Please <w>brim</w> the cup so that we have enough water for the entire group.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>наполни</w> чашку <w>доверху</w>, чтобы нам хватило воды на всю группу.",
                                "zh": "请把这个杯子<w>倒满</w>，这样我们这一组人才有足够的水。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполнить емкость до самого верха.",
                        "zh": "把容器装到最顶端，直到满满的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наполнять до краев",
                                "target_lang_sense_clarification": "наливать доверху"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斟满",
                                "target_lang_sense_clarification": "把杯子、碗等容器加到满满的"
                            },
                            {
                                "target_lang_word": "倒满",
                                "target_lang_sense_clarification": "把容器装到最上沿"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7a34f1b7-eadb-376e-a388-9bf349bf7f63",
                    "sense_definition": "A family name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Brim</w> has lived in this small town for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Брим</w> живет в этом маленьком городке уже более сорока лет.",
                                "zh": "<w>布里姆</w>先生在这个小镇已经住了四十多年。"
                            }
                        },
                        {
                            "text": "The local library was named after the <w>Brim</w> family who donated the land.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь семьи <w>Брим</w>, которая пожертвовала землю.",
                                "zh": "当地的图书馆是以捐赠土地的<w>布里姆</w>家族命名的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Брим",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布里姆",
                                "target_lang_sense_clarification": "英文姓氏音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c66b5fd5-828a-3826-83ff-1493820c3bf2",
                    "sense_definition": "A synonym of <w>breme</w>, describing the sea or wind as fierce, stormy, or tempestuous.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors feared the <w>brim</w> winds that battered their small vessel during the night.",
                            "target_lang_translations": {
                                "ru": "Моряки боялись <w>яростных</w> ветров, которые всю ночь терзали их маленькое судно.",
                                "zh": "水手们害怕夜里不断冲击小船的<w>狂暴</w>大风。"
                            }
                        },
                        {
                            "text": "The ocean grew more <w>brim</w> as the dark clouds gathered on the horizon.",
                            "target_lang_translations": {
                                "ru": "Океан становился всё более <w>бушующим</w>, пока на горизонте сгущались темные тучи.",
                                "zh": "随着乌云在地平线上聚集，海面变得更加<w>汹涌</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "breme"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичный термин для описания яростного, штормового моря или ветра.",
                        "zh": "古旧用法，形容海或风猛烈、凶险、像暴风雨一般。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бушующий",
                                "target_lang_sense_clarification": "о море или ветре"
                            },
                            {
                                "target_lang_word": "яростный",
                                "target_lang_sense_clarification": "о стихии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狂暴",
                                "target_lang_sense_clarification": "形容海或风猛烈而凶猛"
                            },
                            {
                                "target_lang_word": "汹涌",
                                "target_lang_sense_clarification": "形容海浪或风势很强、很猛烈"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}