                ],
                "senses": [
                    {
                        "sense_id": "2b0db591-02c1-32e3-976a-339176c3a5dc",
                        "entry_id": "06b76885-83f9-3248-84fa-781c558f7c3e",
                        "glosses": [
                            "Qui est propre à opérer, qui produit ou peut produire des effets."
                        ],
                        "tags": [
                            "Théologien mais passé dans le langage courant"
                        ],
                        "examples": [
                            {
                                "example_id": "d57f6ca2-105a-4f59-901b-7426ebc65007",
                                "sense_id": "2b0db591-02c1-32e3-976a-339176c3a5dc",
                                "text": "La grâce opérante."
                            },
                            {
                                "example_id": "f3de1aff-fff0-4a9e-b40b-15eb51fe11fa",
                                "sense_id": "2b0db591-02c1-32e3-976a-339176c3a5dc",
                                "text": "Une foi vive et opérante."
                            },
                            {
                                "example_id": "e9a6df14-81bb-466b-a4c2-0424ee9527eb",
                                "sense_id": "2b0db591-02c1-32e3-976a-339176c3a5dc",
                                "text": "Un traitement opérant."
                            },
                            {
                                "example_id": "239e19b5-4ccd-40fb-9e3b-343101abec10",
                                "sense_id": "2b0db591-02c1-32e3-976a-339176c3a5dc",
                                "text": "Cette convention n’est pas équitable, elle ne sera pas opérante."
                            },
                            {
                                "example_id": "6e499df3-ccae-40ec-8040-8bd636ae0d0a",
                                "sense_id": "2b0db591-02c1-32e3-976a-339176c3a5dc",
                                "text": "Vitry ressemble à ces villes comme Lorient, Brest, Royan, reconstruites après-guerre : des bâtiments solides, rudes, sans affectation, désacralisés de tout discours architectural, immédiatement opérants."
                            }
                        ]
                    }
                ],
