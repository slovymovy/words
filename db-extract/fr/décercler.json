                "senses": [
                    {
                        "sense_id": "2a8c5258-85ea-3729-bf97-e88337449191",
                        "entry_id": "b0a961c8-fdc5-3c3b-85ab-d464d6f3ca4c",
                        "glosses": [
                            "Enlever, oter les cercles de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a047506-865d-46d4-894e-242c36f38e9d",
                                "sense_id": "2a8c5258-85ea-3729-bf97-e88337449191",
                                "text": "Décercler un tonneau."
                            },
                            {
                                "example_id": "adbfb7d5-6e29-4a4f-b55f-a71cc8c0cc5a",
                                "sense_id": "2a8c5258-85ea-3729-bf97-e88337449191",
                                "text": "En effet, les verbes décercler et déclouer sont beaucoup plus proches que D. Corbin ne semble l’affirmer."
                            }
                        ]
                    },
                    {
                        "sense_id": "56165cf7-4614-3d20-8ee3-37a18db5afc8",
                        "entry_id": "b0a961c8-fdc5-3c3b-85ab-d464d6f3ca4c",
                        "glosses": [
                            "Épancher ses sentiments, parler à cœur ouvert. → voir se décercler le cœur."
                        ],
                        "tags": [
                            "figuratively",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a22bebfc-0218-4e07-9976-69deda078de5",
                                "sense_id": "56165cf7-4614-3d20-8ee3-37a18db5afc8",
                                "text": "Ce matin, jusqu’au déjeuner, causé d’intimité avec Léon. C’est notre meilleure heure pour nous décercler le cœur ensemble."
                            }
                        ]
                    }
