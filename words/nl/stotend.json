{
    "word_family": [
        "stoot",
        "stoter",
        "stootje"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "65643615-acbc-3472-82cb-f79039cbc663",
                    "sense_definition": "een korte duwende beweging makend",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De machine maakt een <w>stotende</w> beweging tijdens het verwerken van het materiaal.",
                            "target_lang_translations": {
                                "fr": "La machine effectue un mouvement <w>saccadé</w> pendant le traitement du matériau."
                            }
                        },
                        {
                            "text": "Hij voelde een <w>stotende</w> kracht tegen zijn schouder in de drukke menigte.",
                            "target_lang_translations": {
                                "fr": "Il a senti une poussée <w>saccadée</w> contre son épaule dans la foule dense."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stotende beweging"
                    ],
                    "target_lang_definitions": {
                        "fr": "qui effectue un mouvement bref et saccadé"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "saccadé",
                                "target_lang_sense_clarification": "se dit d'un mouvement irrégulier ou par à-coups"
                            },
                            {
                                "target_lang_word": "par à-coups",
                                "target_lang_sense_clarification": "indique un mouvement qui se fait par poussées successives"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f195bed-04dd-308b-bb7d-089b9d7322e9",
                    "sense_definition": "iets doend dat hinderlijk is",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>stotende</w> opmerkingen tijdens de vergadering werden door iedereen als zeer ongepast ervaren.",
                            "target_lang_translations": {
                                "fr": "Ses remarques <w>choquantes</w> pendant la réunion ont été perçues par tous comme très inappropriées."
                            }
                        },
                        {
                            "text": "Het was een <w>stotend</w> gedrag dat de sfeer in de groep volledig verpestte.",
                            "target_lang_translations": {
                                "fr": "C'était un comportement <w>offensant</w> qui a complètement gâché l'ambiance dans le groupe."
                            }
                        }
                    ],
                    "synonyms": [
                        "hinderlijk",
                        "aanstootgevend",
                        "stuitend",
                        "beledigend",
                        "kwetsend",
                        "storend"
                    ],
                    "target_lang_definitions": {
                        "fr": "qui est offensant, choquant ou déplaisant"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "choquant",
                                "target_lang_sense_clarification": "qui heurte la sensibilité ou les convenances"
                            },
                            {
                                "target_lang_word": "offensant",
                                "target_lang_sense_clarification": "qui blesse ou manque de respect"
                            },
                            {
                                "target_lang_word": "déplaisant",
                                "target_lang_sense_clarification": "qui cause un sentiment de gêne ou d'irritation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87c3415e-04a6-3630-a563-84071f1a7b99",
                    "sense_definition": "de geslachtsdaad bedrijvend, dan wel imiterend",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De danser maakte ritmische en <w>stotende</w> heupbewegingen op de maat van de muziek.",
                            "target_lang_translations": {
                                "fr": "Le danseur effectuait des mouvements de hanches rythmiques et <w>suggestifs</w> sur le rythme de la musique."
                            }
                        },
                        {
                            "text": "In de film was een expliciete scène met <w>stotende</w> bewegingen te zien.",
                            "target_lang_translations": {
                                "fr": "Dans le film, on pouvait voir une scène explicite avec des mouvements <w>suggestifs</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stotende heupbewegingen"
                    ],
                    "target_lang_definitions": {
                        "fr": "qui imite ou évoque l'acte sexuel par des mouvements de va-et-vient"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "suggestif",
                                "target_lang_sense_clarification": "qui évoque des idées sexuelles de manière explicite"
                            },
                            {
                                "target_lang_word": "érotique",
                                "target_lang_sense_clarification": "relatif à l'excitation sexuelle"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81987fdf-1f98-3b10-b25a-eb3ddbc394b3",
                    "sense_definition": "onvoltooid deelwoord van <w>stoten</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij liep door de gang, <w>stotend</w> tegen elke deur die hij tegenkwam.",
                            "target_lang_translations": {
                                "fr": "Il marchait dans le couloir, <w>en heurtant</w> chaque porte qu'il croisait."
                            }
                        },
                        {
                            "text": "De auto reed <w>stotend</w> over de hobbelige weg door de motorproblemen.",
                            "target_lang_translations": {
                                "fr": "La voiture avançait <w>par à-coups</w> sur la route cahoteuse à cause de problèmes de moteur."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "participe présent du verbe pousser ou heurter"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "en heurtant",
                                "target_lang_sense_clarification": "indique l'action de cogner contre quelque chose"
                            },
                            {
                                "target_lang_word": "par à-coups",
                                "target_lang_sense_clarification": "décrit un fonctionnement irrégulier d'un moteur ou d'un mécanisme"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}