                    {
                        "sense_id": "5817161d-8bec-3747-bf05-1e306484a0d6",
                        "entry_id": "61643504-cae5-36f6-8911-2d1aa35c5429",
                        "glosses": [
                            "stabiler Karton aus Wellpappe mit Deckel für den Transport von gelben, gebogenen, dickschaligen Südfrüchten (Bananen); in zweiter Verwendung häufig für Transport/Unterbringung schriftlicher Dokumente, auch für andere Gegenstände beim Umzug"
                        ],
                        "tags": [
                            "Transport"
                        ],
                        "examples": [
                            {
                                "example_id": "eed9bece-ba8c-4472-a250-6de9bdb16eff",
                                "sense_id": "5817161d-8bec-3747-bf05-1e306484a0d6",
                                "text": "„Bücher transportiere ich generell in Bananenkisten. Es gibt nichts Geeigneteres dafür.“"
                            },
                            {
                                "example_id": "ce9ab36b-d88b-45a7-9486-7fd0253d27c6",
                                "sense_id": "5817161d-8bec-3747-bf05-1e306484a0d6",
                                "text": "„In der Zeit, als Ola seinen Wehrdienst geleistet hatte, war Arvid eines Nachmittags im Hinterzimmer umgekippt, er lag dort zwischen Bananenkisten und Küchenpapierrollen, bis Sara ihn einige Stunden später fand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
