                                        "sense_id": "3a39a704-41c0-3b9f-9f0e-a808b22158ff",
                                        "entry_id": "83b9649c-9a50-3f73-90d1-33dca8fe8b2b",
                                        "glosses": [
                                            "The art of using language, especially public speaking, as a means to persuade."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "183e622e-13b3-4c97-a09c-1172c911a46c",
                                                "sense_id": "3a39a704-41c0-3b9f-9f0e-a808b22158ff",
                                                "text": "Transport Minister Marples, meanwhile, used arrogant rhetoric and showed his personal contempt for railways when confirming in Parliament that a third of the network was to be closed even before the survey results were known."
                                            },
                                            {
                                                "example_id": "b11d0f64-cc54-4baf-b4af-95e44e93b51b",
                                                "sense_id": "3a39a704-41c0-3b9f-9f0e-a808b22158ff",
                                                "text": "“As soon as I am inaugurated, I will direct the Justice Department to vigorously pursue the death penalty to protect American families and children from violent rapists, murderers, and monsters. We will be a Nation of Law and Order again!” Trump wrote on Truth Social, echoing his long-standing advocacy for use of the death penalty, which was part of his tough-on-crime rhetoric during the 2024 campaign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf98ab0-55c2-3348-b138-a0cfe042bb47",
                                        "entry_id": "83b9649c-9a50-3f73-90d1-33dca8fe8b2b",
                                        "glosses": [
                                            "Meaningless language with an exaggerated style intended to impress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d29f59b2-92ac-4338-9963-3b8cc3ad7fc4",
                                                "sense_id": "adf98ab0-55c2-3348-b138-a0cfe042bb47",
                                                "text": "It’s only so much rhetoric."
                                            }
                                        ]
                                    }
