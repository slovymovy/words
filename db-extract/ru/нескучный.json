                    },
                    {
                        "sense_id": "7c02b8cc-1bdd-3c28-94b0-3cec14146086",
                        "entry_id": "696cd109-5006-37b9-a97b-bd5c454e9633",
                        "glosses": [
                            "весёлый, бодрый (о человеке)"
                        ],
                        "tags": [],
