                    {
                        "sense_id": "0b9b7132-395e-3d20-b85d-f805e4324383",
                        "entry_id": "b3a03428-be1e-34a4-a7b3-0c0e0d0a3f96",
                        "glosses": [
                            "Ouvrier dont la fonction est de décharger les marchandises d’un camion ou d’un wagon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0974b58d-4161-470f-963b-8509fe861a78",
                                "sense_id": "0b9b7132-395e-3d20-b85d-f805e4324383",
                                "text": "Il était ripeur, une profession que j’exercerai bientôt et qui consiste, comme son intitulé le dit un peu, à accompagner les livreurs des grands magasins et aller quérir au fond du camion les colis avant de se les coltiner dans des escaliers trop étroits avec pour seule satisfaction de répondre aux clientes qui demandent au travers de leur porte palière : « Qui c’est ? », « C’est le Printemps ! », ou les jours sans : « C’est le Bazar ! », selon la raison sociale de l’employeur du jour."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f11256c-92fc-3aed-a50b-92486be95281",
                        "entry_id": "b3a03428-be1e-34a4-a7b3-0c0e0d0a3f96",
                        "glosses": [
                            "Éboueur travaillant à l’arrière d’une benne, par opposition au chauffeur."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "78ca8282-5c6e-4130-a398-cb3690c243e0",
                                "sense_id": "0f11256c-92fc-3aed-a50b-92486be95281",
                                "text": "Les ripeurs travaillent dans un bruit infernal."
                            }
                        ]
