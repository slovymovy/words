                "senses": [
                    {
                        "sense_id": "ec004724-a5dd-3203-baad-81616c8c0ba3",
                        "entry_id": "06623206-f203-3c59-83bf-8315571bd148",
                        "glosses": [
                            "EU-Verordnung, die regelt, welche Informationen über ein Lebensmittel dem Verbraucher zur Verfügung gestellt werden müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4c0d5f4-463b-4e40-84b9-0b316d3b7fd6",
                                "sense_id": "ec004724-a5dd-3203-baad-81616c8c0ba3",
                                "text": "„Gemäß der neuen Lebensmittelinformationsverordnung der EU (EU Nr. 1169/2011) ist eine Angabe von enthaltenen Allergenen und Auslösersubstanzen für Unverträglichkeiten sowohl für verpackte als auch unverpackte Lebensmittelverpflichtend.“"
                            },
                            {
                                "example_id": "9120fd67-4c2b-46af-9dad-f68fbf1514fc",
                                "sense_id": "ec004724-a5dd-3203-baad-81616c8c0ba3",
                                "text": "„Konkrete Kennzeichnungselemente, die sich auf einer Lebensmittelverpackung befinden müssen, sind in der europäischen Lebensmittelinformationsverordnung Nr. 1169/2011/EU genannt.“"
                            },
                            {
                                "example_id": "caf99a0c-5538-44f3-841b-4c2e7947c486",
                                "sense_id": "ec004724-a5dd-3203-baad-81616c8c0ba3",
                                "text": "„Mit der Einführung der Lebensmittelinformationsverordnung (LMIV, VO (EU) Nr. 1169/2011) sieht der Europäische Gesetzgeber eine einheitliche europaweite Kennzeichnung von Lebensmitteln vor.“"
                            },
                            {
                                "example_id": "29c58d9a-208b-4004-be4c-6355403dd537",
                                "sense_id": "ec004724-a5dd-3203-baad-81616c8c0ba3",
                                "text": "„Hier werden im Wesentlichen Inhalte zu freiwilligen Herkunftsangaben, verpflichtenden Angaben sowie der Herkunftskennzeichnung nach der Lebensmittelinformationsverordnung ausgeführt mit einem Fazit, dass „die Lebensmittelinformationsverordnung […]“"
                            },
                            {
                                "example_id": "f2a46553-b189-48c4-90bb-4b63cd334685",
                                "sense_id": "ec004724-a5dd-3203-baad-81616c8c0ba3",
                                "text": "„Die Lebensmittelinformationsverordnung (LMIV) gilt in allen Mitgliedsstaaten der EU. Sie legt fest, welche Informationen über ein Lebensmittel dem Verbraucher zur Verfügung gestellt werden müssen. Darunter fallen beispielsweise Angaben […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
