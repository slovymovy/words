{
    "word_family": [
        "geloei",
        "loei"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e23c3a3-7436-3cd0-9d78-e7903d6350bd",
                    "sense_definition": "het maken van een langgerekt, laag geluid door een koe",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koeien <w>loeien</w> in de weide omdat ze naar binnen willen.",
                            "target_lang_translations": {
                                "en": "The cows are <w>mooing</w> in the meadow because they want to come inside."
                            }
                        },
                        {
                            "text": "In de verte hoorden we een koe <w>loeien</w>.",
                            "target_lang_translations": {
                                "en": "In the distance, we heard a cow <w>lowing</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "balken"
                    ],
                    "common_phrases": [
                        "koeien loeien"
                    ],
                    "target_lang_definitions": {
                        "en": "the making of a long, low sound by a cow"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moo",
                                "target_lang_sense_clarification": "the characteristic sound of a cow"
                            },
                            {
                                "target_lang_word": "low",
                                "target_lang_sense_clarification": "a more formal or literary term for a cow's sound"
                            },
                            {
                                "target_lang_word": "bellow",
                                "target_lang_sense_clarification": "a loud, deep roar of a cow"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "870af8e7-9757-3c91-8f6b-246974d8ae41",
                    "sense_definition": "een hard, aanhoudend en huilend geluid maken, vaak door de wind of een sirene",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wind <w>loeide</w> de hele nacht om het oude huis.",
                            "target_lang_translations": {
                                "en": "The wind <w>howled</w> around the old house all night long."
                            }
                        },
                        {
                            "text": "Ik hoorde de sirenes van de brandweer hard <w>loeien</w>.",
                            "target_lang_translations": {
                                "en": "I heard the fire truck sirens <w>wailing</w> loudly."
                            }
                        }
                    ],
                    "synonyms": [
                        "gieren",
                        "huilen",
                        "razen"
                    ],
                    "common_phrases": [
                        "loeien van de wind",
                        "sirenes loeien"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a loud, persistent, and howling sound, often by the wind or a siren"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "howl",
                                "target_lang_sense_clarification": "used for wind or sirens making a long, loud sound"
                            },
                            {
                                "target_lang_word": "roar",
                                "target_lang_sense_clarification": "used for the powerful sound of wind or engines"
                            },
                            {
                                "target_lang_word": "wail",
                                "target_lang_sense_clarification": "specifically used for the rising and falling sound of sirens"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}