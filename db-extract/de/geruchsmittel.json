                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b223710-bebb-4ee8-b63b-804d0326d8e4",
                                "sense_id": "8a8c9947-e977-372f-be97-08612091d29e",
                                "text": "„Nach längerer Zeit der Suche wurde klar, dass die Ursache wahrscheinlich ein Kanister mit Geruchsmittel sein könnte.“"
                            },
                            {
                                "example_id": "59b0c317-63df-4baf-8f4a-b5325002319b",
                                "sense_id": "8a8c9947-e977-372f-be97-08612091d29e",
                                "text": "„Sie sollten zunächst versuchen, durch den Einsatz von Geruchsmitteln Hunde vom Betreten Ihres Rasens abzuhalten.“"
                            },
                            {
                                "example_id": "17d016cf-1737-4f0e-94cd-bca1f7ecdc90",
                                "sense_id": "8a8c9947-e977-372f-be97-08612091d29e",
                                "text": "„Die Bedienung ist einfach und ermöglicht die präzise Bestimmung des Geruchsmittels im Bereich von 4-23 mg/m³.“"
                            },
                            {
                                "example_id": "d83f6f73-37d7-4cab-88c8-102a0018ea12",
                                "sense_id": "8a8c9947-e977-372f-be97-08612091d29e",
                                "text": "„Des Weiteren enthält Autogas einen geringen Anteil Propylen (3-5%) - ein Nebenprodukt, das beim Raffinationsverfahren entsteht; sowie ein Geruchsmittel.“"
                            },
                            {
                                "example_id": "42874233-c82a-41de-a528-7d2539f89039",
                                "sense_id": "8a8c9947-e977-372f-be97-08612091d29e",
                                "text": "„Stattdessen wird dort das Geruchsmittel wie in den meisten Ländern lokal beigegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
