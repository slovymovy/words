                                                "sense_id": "abdf78ff-cf14-3c83-bb17-fbfdf8614524",
                                                "text": "Terčem útoků na Sinaji bývají zřídka civilisté, většinou jsou to vojáci a policisté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "661cb727-6975-347f-977d-0fc51c7f255b",
                                        "entry_id": "5cca2267-2f63-3a84-89e2-b650df2ccf6e",
                                        "glosses": [
                                            "vokativ množného čísla podstatného jména voják"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31558663-e918-4764-b9f0-a56d386080e8",
                                                "sense_id": "661cb727-6975-347f-977d-0fc51c7f255b",
                                                "text": "„Zpátky, vojáci! – Ohlédněte se! Jak jsem řekl, vystřelíte jen jednou, ale potom z Jiřic živi neodejdete!“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
