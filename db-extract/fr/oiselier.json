                ],
                "senses": [
                    {
                        "sense_id": "2743e40e-7420-33ee-8a06-d22b40773101",
                        "entry_id": "918aa1fe-b3c4-33d6-a951-c3ce5cb33db6",
                        "glosses": [
                            "Celui qui fait le commerce (et éventuellement l’élevage) des oiseaux d’agrément, dans une oisellerie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5a2b1110-315f-4e75-bfa3-0a69ce27a192",
                                "sense_id": "2743e40e-7420-33ee-8a06-d22b40773101",
                                "text": "L’oiselier m’ayant fait avertir qu’il avait un oiseau extraordinaire nouvellement arrivé des Indes, je l’ai été voir, et je l’ai trouvé rare tant par la figure que par son plumage."
                            },
                            {
                                "example_id": "bc54fbeb-e674-4319-97cc-67b0a12af1e3",
                                "sense_id": "2743e40e-7420-33ee-8a06-d22b40773101",
                                "text": "Rien de plus simple: c’est le vulgaire trébuchet que vendent tous les oiseliers, mais trois fois plus grand.:"
                            },
                            {
                                "example_id": "8e948cb9-7d92-4176-8238-f603fc7db42f",
                                "sense_id": "2743e40e-7420-33ee-8a06-d22b40773101",
                                "text": "Un Américain prend en photo le guerrab, ce vendeur d'eau […], circulant dans la foule des oiseliers, il secouait des petites sonnailles de cuivre."
                            }
                        ]
                    }
                ],
