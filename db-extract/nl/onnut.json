        "nl-extract.jsonl": [
            {
                "entry_id": "20335b71-5e61-3f02-a70c-63123f79d2ae",
                "word": "onnut",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5e00d1ee-aeef-3a2b-8bce-dc72619a5081",
                        "entry_id": "20335b71-5e61-3f02-a70c-63123f79d2ae",
                        "glosses": [
                            "zonder nut, onbruikbaar en vaak zelfs schadelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a45f67eb-9c08-44e4-bead-c93df39d9e54",
                                "sense_id": "5e00d1ee-aeef-3a2b-8bce-dc72619a5081",
                                "text": "Beziet die mengeling van afschuw en fascinatie op het gelaat van het jongetje met de blauwe winteroverall*** en besef: giraf Marius is niet ten onnutte aan zijn eind gekomen. De voorgenomen euthanasie van een overtallig giraffenjong in de zoo van Kopenhagen wekte in februari wereldwijd protest. Maar de Denen bogen niet voor goedkope sentimentaliteit en leerden de wereld dat een dierentuin geen Disney World is maar dat de wilde beesten er elke dag vlees blieven - of nu dat van een collega uit een belendend perk komt dan wel van een cleane slachterij. En dus werd Marius, het jong te veel in de giraffengroep, aan de leeuwen gevoerd. Maar niet voordat geïnteresseerde Deentjes hadden mogen aanschouwen hoe hij vakkundig werd uitgebeend. Zodat die nu weten: de wereld is hard, maar o zo spannend."
                            },
                            {
                                "example_id": "8015de8d-dbcb-4030-b6b4-edfaab23c1de",
                                "sense_id": "5e00d1ee-aeef-3a2b-8bce-dc72619a5081",
                                "text": "Eind zeventiende eeuw was hekserij eigenlijk geen thema meer.” Toch liet Aaltje zich wegen, maar echt gelukkig pakte het uiteindelijk toch niet voor haar uit: in Eibergen sloot de kerkenraad haar uit van deelname aan het heilig avondmaal, juist omdat ze zich door naar Oudewater te gaan, aan zulke ijdele en onnutte proeven had overgegeven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed226079-9ca0-47e7-9d6a-59eb39f2feb3",
                        "source_entry_id": "20335b71-5e61-3f02-a70c-63123f79d2ae",
                        "source_sense_id": "5e00d1ee-aeef-3a2b-8bce-dc72619a5081",
                        "source_sense_description": "zonder nut, onbruikbaar en vaak zelfs schadelijk",
                        "target_lang_word": "useless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "useless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Without use or possibility to be used."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d175fa6f-2a60-45fc-a2e8-111de79cbdaa",
                                                "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                                "text": "This fork's prongs are bent. It's useless now."
                                            },
                                            {
                                                "example_id": "a4286ea4-9aa2-4365-8c8a-bc30181c9c71",
                                                "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                                "text": "I'm all for opening new stations (Transport Scotland is planning another at East Linton, about halfway between Drem and Dunbar), but they are useless without a decent service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Unhelpful, not useful; pointless (of an action)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f20054cb-dfff-4314-a444-ed39adc34f8c",
                                                "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                                "text": "I think it's useless to keep this discussion going. It's like talking to a brick wall."
                                            },
                                            {
                                                "example_id": "4c91d144-b3f0-4d4b-9751-fd698afdb7c4",
                                                "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                                "text": "I tried my best to make him quit smoking, but my efforts were useless. He now smokes six packs a day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45a58518-0798-312f-9a82-5601ff931b9c",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Good-for-nothing; not dependable."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e7ffd5-78c9-4edf-8e3d-b659f4630d37",
                                                "sense_id": "45a58518-0798-312f-9a82-5601ff931b9c",
                                                "text": "Bill never mows the lawn, takes out the trash or anything. He's useless, but I love him anyways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Unable to do well at a particular task or thing. Useless is mildly insulting."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd42613c-721a-4d51-8927-6d02a9d9ff19",
                                                "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                                "text": "My brother is useless at most computer games, but he is an awesome PS2 player."
                                            },
                                            {
                                                "example_id": "4c07a921-0837-4a35-adbf-28318b15deba",
                                                "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                                "text": "Why do you keep trying? You're obviously useless at it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
