                                "zh": "为什么<w>偏偏</w>是你必须做这件事？"
                            }
                        },
                        {
                            "text": "Szukałem <w>akurat</w> tej książki w bibliotece.",
                            "target_lang_translations": {
                                "ru": "Я искал <w>как раз</w> эту книгу в библиотеке.",
                                "en": "I was looking for <w>exactly</w> this book in the library.",
                                "nl": "Ik zocht <w>precies</w> dat boek in de bibliotheek.",
                                "de": "Ich habe <w>gerade</w> dieses Buch in der Bibliothek gesucht.",
                                "fr": "Je cherchais <w>justement</w> ce livre à la bibliothèque.",
                                "it": "Cercavo <w>proprio</w> quel libro in biblioteca.",
                                "cs": "Hledal jsem v knihovně <w>zrovna</w> tuhle knihu.",
                                "tr": "Kütüphanede <w>tam da</w> bu kitabı arıyordum.",
                                "es": "Estaba buscando <w>precisamente</w> este libro en la biblioteca.",
                                "zh": "我<w>恰恰</w>是在图书馆找这本书。"
                            }
                        }
