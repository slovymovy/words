                "senses": [
                    {
                        "sense_id": "d0adfa28-53fb-35d8-9c5d-c7c1d33e969f",
                        "entry_id": "d04a2158-3838-3a0e-b21f-d5b252c2b50a",
                        "glosses": [
                            "Sonner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac808254-4694-43d2-a852-45bda427c975",
                                "sense_id": "d0adfa28-53fb-35d8-9c5d-c7c1d33e969f",
                                "text": "Et que je te sonne, que je te ressonne, à se faire péter l’engueuloir : mais c’est sa manière au Sans-Chagrin. Quand i’sonne, y a de quoi décharpenter une grange…"
                            },
                            {
                                "example_id": "799ab3d1-0a91-4688-b9dc-b4b3ad4653c6",
                                "sense_id": "d0adfa28-53fb-35d8-9c5d-c7c1d33e969f",
                                "text": "Seulement maintenant, comme la sonnerie est déréglée, ma femme, elle va ressonner tout le temps !"
                            }
                        ]
                    }
