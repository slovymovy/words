                    "frequency": "Middle",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le matin, le doux <w>chant</w> des oiseaux me réveille toujours agréablement."
                        },
                        {
                            "text": "Dès le <w>chant</w> du coq, les fermiers se mettent au travail dans les étables."
                        }
                    ],
                    "common_phrases": [
                        "chant des oiseaux",
                        "chant du coq",
                        "chant du cygne"
                    ]
                },
                {
