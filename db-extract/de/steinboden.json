                    {
                        "sense_id": "dfeba357-4a08-30ca-89fb-f4d0997ab396",
                        "entry_id": "02406e69-5958-3862-b3ca-6212d88cf817",
                        "glosses": [
                            "Boden, der aus Steinfliesen/-platten oder ähnlichem Material hergestellt ist"
                        ],
                        "tags": [
                            "Innenarchitektur"
                        ],
                        "examples": [
                            {
                                "example_id": "1381fa79-7acb-4ddd-8d6f-d0355b173f78",
                                "sense_id": "dfeba357-4a08-30ca-89fb-f4d0997ab396",
                                "text": "„Sporadisch trafen wir uns auf dem Steinboden neben den Duschen.“"
                            },
                            {
                                "example_id": "d3fcb551-b21b-43f1-94e2-911212b806c8",
                                "sense_id": "dfeba357-4a08-30ca-89fb-f4d0997ab396",
                                "text": "„Andere Bewohner hockten auf dem Steinboden, als wollten sie Stühle und Schemel schonen, um sich ihres Besitzes länger zu erfreuen.“"
                            },
                            {
                                "example_id": "dfccee53-1113-4bf7-b995-3baeb3f3d3e9",
                                "sense_id": "dfeba357-4a08-30ca-89fb-f4d0997ab396",
                                "text": "„Ich zog meine Stiefel aus und ging barfuß über den kalten Steinboden Richtung Büro, wo ich meine Schwester vermutete.“"
                            }
                        ],
