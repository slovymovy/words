                        "glosses": [
                            "Having lustful desires; characterized by lewdness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93c08d70-d31c-48f6-b4bf-f63cadc845d6",
                                "sense_id": "2468a695-a2ff-3c54-b899-94828d0d5a11",
                                "text": "It is observed, that the red haired of both sexes are more libidinous and mischievous than the rest, whom yet they much exceed in strength and activity."
                            },
                            {
                                "example_id": "dfc55286-34cf-4c3e-9f1d-15fcdec13d41",
                                "sense_id": "2468a695-a2ff-3c54-b899-94828d0d5a11",
                                "text": "Stramonium seed, mixed with wine, produces, according to a seventeenth century erotologist, libidinous activity."
                            }
                        ]
                    },
