                ],
                "senses": [
                    {
                        "sense_id": "9e238bf6-6a20-3d0a-8662-deb08f688767",
                        "entry_id": "df851a7f-69d5-3ea7-98b3-12b11ed01dcd",
                        "glosses": [
                            "Westteil von Jerusalem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23ffef11-1df4-4901-ba12-727c4b86be62",
                                "sense_id": "9e238bf6-6a20-3d0a-8662-deb08f688767",
                                "text": "„Die opulenten Festessen in seinem Haus gegenüber der äthiopischen Kirche in Westjerusalem, in unmittelbarer Nachbarschaft von Elieser Ben Jehuda, waren legendär.“"
                            },
                            {
                                "example_id": "a251e8b2-e52d-431d-970a-e8ea215b85cd",
                                "sense_id": "9e238bf6-6a20-3d0a-8662-deb08f688767",
                                "text": "„Es folgte ein Bombenanschlag auf das Samiramis Hotel in Qatamon, Westjerusalem, bei dem viele Menschen starben, darunter auch der spanische Konsul.“"
                            },
                            {
                                "example_id": "f1b5f726-c3c3-48fe-9167-18e540d80092",
                                "sense_id": "9e238bf6-6a20-3d0a-8662-deb08f688767",
                                "text": "„Naheel brachte man nach Westjerusalem in ein Untersuchungsgefängnis im Russischen Viertel, unter Palästinensern bekannt als Moscobiya.“"
                            },
                            {
                                "example_id": "a287c50b-65c7-496c-a23d-31002f93a472",
                                "sense_id": "9e238bf6-6a20-3d0a-8662-deb08f688767",
                                "text": "„Der Plan sah im April und in der ersten Maihälfte die Eroberung und Entvölkerung der beiden größten arabischen Städte Jaffa und Haifa, der arabischen Viertel Westjerusalems sowie zahlreicher arabischer Städte, Ortschaften und Dörfer vor, darunter Tiberias am 18. April, Haifa am 23. April, Safad am 10. Mai und Beisan am 11. Mai.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
