                        {
                            "text": "Nasza nowa kampania reklamowa ma za <w>cel</w> młodzież szkolną.",
                            "target_lang_translations": {
                                "ru": "Наша новая рекламная кампания нацелена на школьную молодёжь как на свою <w>целевую аудиторию</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stać się celem",
                        "cel ataków"
                    ],
                    "target_lang_definitions": {
