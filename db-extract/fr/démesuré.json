                    },
                    {
                        "form_id": "cad04ef3-c53e-4120-af47-fe3fb1bedabb",
                        "entry_id": "2b58d275-427c-3e27-8152-2dd9bb2b7056",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "démesurées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "10a5a95b-e4b9-3ab9-9712-a54a0014ea78",
                        "entry_id": "2b58d275-427c-3e27-8152-2dd9bb2b7056",
                        "glosses": [
                            "Qui excède la mesure ordinaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dcd1130-3de5-4816-8e0e-97b45ad77df1",
                                "sense_id": "10a5a95b-e4b9-3ab9-9712-a54a0014ea78",
                                "text": "Ce mot était aussi chaque été la source d'une peur démesurée : celle d'être aspiré par un Canadair alors que je nageais en Méditerranée et d'être jeté, à quelques kilomètre de là, dans les flammes d'une pinède dévastée."
                            },
                            {
                                "example_id": "519a934f-7099-429b-8d68-e6676d664fbb",
                                "sense_id": "10a5a95b-e4b9-3ab9-9712-a54a0014ea78",
                                "text": "Autant je trouve que Maripier Morin avait été punie de façon totalement démesurée en se faisant retirer tous ses contrats, autant je trouve que Caroline Néron est punie de façon démesurée pour avoir… pour avoir fait quoi, exactement ?"
                            },
                            {
                                "example_id": "77d9130c-ce2c-46f1-acaa-e4f9c6f224db",
                                "sense_id": "10a5a95b-e4b9-3ab9-9712-a54a0014ea78",
                                "text": "Si les pompiers semblent en passe de parvenir à dompter le monstre de feu qui s’est déclaré mardi soir dans le secteur Saint-Magne-Hostens, cet événement est à tout point de vue démesuré."
                            },
                            {
                                "example_id": "76a173f6-d4f4-47e7-8ccc-6c52ad914e3e",
                                "sense_id": "10a5a95b-e4b9-3ab9-9712-a54a0014ea78",
                                "text": "Stupéfié, Morange se rapprocha insensiblement. On aurait dit qu’une bête sauvage aux griffes démesurées lui avait lacéré la peau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb80d3c1-4694-4968-bd23-00f534aa6ca2",
                        "source_entry_id": "2b58d275-427c-3e27-8152-2dd9bb2b7056",
                        "source_sense_id": "10a5a95b-e4b9-3ab9-9712-a54a0014ea78",
                        "target_lang_word": "maßlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maßlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "135c424d-7240-3bd2-822f-64c8cb4cadec",
                                        "entry_id": "64cd869e-197f-3906-b083-1866b54fa16d",
                                        "glosses": [
                                            "über das gewöhnliche Maß hinausgehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "396d42d9-83e9-46fa-b811-cd406f845675",
                                                "sense_id": "135c424d-7240-3bd2-822f-64c8cb4cadec",
                                                "text": "Diese maßlose Gier, noch mehr Geld anhäufen zu wollen, trieb ihn soweit, daß er kriminell wurde."
                                            },
                                            {
                                                "example_id": "c936c568-f630-4c90-a9f4-7fafb59ed614",
                                                "sense_id": "135c424d-7240-3bd2-822f-64c8cb4cadec",
                                                "text": "Sie war von ihm maßlos enttäuscht."
                                            },
                                            {
                                                "example_id": "64a39d4b-0821-4ccd-be5e-08c936dbafa3",
                                                "sense_id": "135c424d-7240-3bd2-822f-64c8cb4cadec",
                                                "text": "„Trifft das noch zu im Zeitalter der Weltraumfahrt? Dieses Wort ist eine maßlose Übertreibung, ebenso wie sein Synonym Astronautik. Es gibt eine Reihe von Vergleichen, die das anschaulich machen. Einer mag genügen: Wenn jemand am Alpenrand, etwa bei Grainau unweit Garmisch, in 900 m Höhe über dem Meeresspiegel steht und zum Gipfel der Zugspitze (2000 m über ihm) hinaufblickt, und wenn er seinen Hals reckt, um dort oben etwas zu erkennen, und wenn ihm dann ein hilfsbereiter Freund ein Blatt von 0,2 mm Stärke unter die Schuhe schiebt, »damit du etwas näher dran bist und besser sehen kannst«, so hat sich dieser Jemand damit dem Zugspitzgipfel nur um ein Zehnmillionstel der gegebenen Distanz genähert (1 km = 1 Million mm). Ein »Astronaut«, der den Mond betritt, hat mit der Reise von der Erde bis dorthin von der Entfernung, die uns vom sonnennächsten Fixstern trennt, noch weniger, nämlich 1 Hundertmillionstel, zurückgelegt. Andere Fixsterne sind millionen- und milliardenmal weiter entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80b5dc6a-cb6f-4afe-931a-257ae4d1410a",
                        "source_entry_id": "2b58d275-427c-3e27-8152-2dd9bb2b7056",
                        "source_sense_id": "10a5a95b-e4b9-3ab9-9712-a54a0014ea78",
                        "target_lang_word": "immeasurable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immeasurable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10ff63a0-67b6-3822-a2ff-080bf31d4239",
                                        "entry_id": "a26bd13d-d08c-3f2b-801f-61ad971c32a3",
                                        "glosses": [
                                            "impossible to measure"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "122bd0ff-5832-4421-8f85-6171588451e6",
                                                "sense_id": "10ff63a0-67b6-3822-a2ff-080bf31d4239",
                                                "text": "Give me your hand, and in a few minutes we shall be in my own dwelling, amid those immeasurable deserts where only my story may be communicated."
                                            },
                                            {
                                                "example_id": "1b72fe62-7185-4af9-a6d1-b67313aa36e0",
                                                "sense_id": "10ff63a0-67b6-3822-a2ff-080bf31d4239",
                                                "text": "There is also the former Great Central main line which, though it climbs to an almost equal altitude at Dunford, has the immeasurable advantage of electric traction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9550b0b3-3106-3cdb-a63f-ebbfeecdc09f",
                                        "entry_id": "a26bd13d-d08c-3f2b-801f-61ad971c32a3",
                                        "glosses": [
                                            "vast"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a82ac8a-c00a-42fa-a3c2-f85fae0233d6",
                                                "sense_id": "9550b0b3-3106-3cdb-a63f-ebbfeecdc09f",
                                                "text": "\"His contribution has been immeasurable,\" Bush said in a statement. \"I value his judgment, and I treasure his friendship.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "immeasurable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7b5b8e7-fc9c-3124-93a7-9744d40fe120",
                                        "entry_id": "ebf9ec7f-f963-3a64-8565-31513158e0dd",
                                        "glosses": [
                                            "anything that cannot be measured"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92d21b82-ba49-43eb-98ab-2139f6249e55",
                                                "sense_id": "e7b5b8e7-fc9c-3124-93a7-9744d40fe120",
                                                "text": "And inspiring good relationships is all about immeasurables: it is about inspiring purpose, compassion and attentiveness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
