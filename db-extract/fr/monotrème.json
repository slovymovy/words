                    {
                        "sense_id": "e5ac0e12-3020-3683-9a12-f6ffe2575c4d",
                        "entry_id": "e380c43a-603f-30cb-8ca4-11e49abd43ea",
                        "glosses": [
                            "Membre de l'ordre des monotrèmes, mammifère qui pond des œufs et allaite ses petits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37253cfe-b7dc-4db1-be5e-9f2adf45739f",
                                "sense_id": "e5ac0e12-3020-3683-9a12-f6ffe2575c4d",
                                "text": "L'ornithorynque est un monotrème."
                            },
                            {
                                "example_id": "14907979-68b8-4b85-8a00-e9aee33a8b52",
                                "sense_id": "e5ac0e12-3020-3683-9a12-f6ffe2575c4d",
                                "text": "Il s’agit d’une drôle de bestiole, un monotrème, comme son cousin l’ornithorynque qui pond des œufs et allaite ses petits."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff63fa27-e113-48ca-8c89-b70192be1d9e",
                        "source_entry_id": "e380c43a-603f-30cb-8ca4-11e49abd43ea",
                        "source_sense_id": "e5ac0e12-3020-3683-9a12-f6ffe2575c4d",
                        "target_lang_word": "Kloakentier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kloakentier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7bd7d850-c29d-3469-b3ae-f1b28803f828",
                                        "entry_id": "6117b283-0cfb-3020-8ff7-a489b08afd3f",
                                        "glosses": [
                                            "Ordnung der Säugetiere, die sich dadurch auszeichnet, dass ihre Vertreter Eier legen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6956fe6c-d7c9-44ba-b6f7-01b6126343de",
                                                "sense_id": "7bd7d850-c29d-3469-b3ae-f1b28803f828",
                                                "text": "Die Ansicht, dass Kloakentiere besonders urtümliche Säugetiere seien, die sich aus säugetierähnlichen Reptilien entwickelt haben, ist heute eine Minderheitenmeinung. Ihre tatsächliche Herkunft ist umstritten."
                                            },
                                            {
                                                "example_id": "f37d6874-50f9-4dd0-8b97-355bbf625055",
                                                "sense_id": "7bd7d850-c29d-3469-b3ae-f1b28803f828",
                                                "text": "„Wie so viele urtümliche Geschöpfe, leben auch die eierlegenden Ameisenigel und Schnabeltiere nur noch in dem großen zoologischen Raritätenkabinett unserer Erde, nämlich in der australischen Region, … In ihnen lernen wir die zweifellos ältesten und primitivsten Säuger der Welt kennen, die in den Tierbüchern als Kloakentiere zusammengefaßt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
