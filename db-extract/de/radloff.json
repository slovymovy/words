                ],
                "senses": [
                    {
                        "sense_id": "e103bae7-9627-3411-ad70-a4a7e815083f",
                        "entry_id": "bcd5a837-23ba-316e-a41d-9331dbfafcca",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91aa19af-392d-49ba-9ec7-4a330f50fc02",
                                "sense_id": "e103bae7-9627-3411-ad70-a4a7e815083f",
                                "text": "Frau Radloff ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d53ef891-dca2-4bfe-aa0d-e7d500b73eda",
                                "sense_id": "e103bae7-9627-3411-ad70-a4a7e815083f",
                                "text": "Herr Radloff wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "74dec918-2878-462d-8d45-5cd280c045a9",
                                "sense_id": "e103bae7-9627-3411-ad70-a4a7e815083f",
                                "text": "Die Radloffs kommen heute aus Frankfurt am Main."
                            },
                            {
                                "example_id": "f5035982-2981-4315-944f-510ebfce58c6",
                                "sense_id": "e103bae7-9627-3411-ad70-a4a7e815083f",
                                "text": "Der Radloff trägt nie die Schals, die die Radloff ihm strickt."
                            },
                            {
                                "example_id": "293f2f13-4fba-42be-bc81-8d1c09f9806c",
                                "sense_id": "e103bae7-9627-3411-ad70-a4a7e815083f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Radloff kommt, geht der Herr Radloff.“"
                            },
                            {
                                "example_id": "bc83e197-4e5c-4550-88ef-7767d03a6cb1",
                                "sense_id": "e103bae7-9627-3411-ad70-a4a7e815083f",
                                "text": "Radloff kommt und geht."
                            },
                            {
                                "example_id": "c99dcc02-620c-4b4b-adbb-3ddd24f218f5",
                                "sense_id": "e103bae7-9627-3411-ad70-a4a7e815083f",
                                "text": "Radloffs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "f15fd3f3-ddba-441b-ba08-ccad7ce6a3d4",
                                "sense_id": "e103bae7-9627-3411-ad70-a4a7e815083f",
                                "text": "An verregneten Herbsttagen ist Familie Radloffs liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "e8f2aa47-d130-4ea2-bdb5-440e967b1f9b",
                                "sense_id": "e103bae7-9627-3411-ad70-a4a7e815083f",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Radloff das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
