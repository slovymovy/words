                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94b624f2-d646-3d17-a4a1-0775a5d08cc3",
                                        "entry_id": "524e5709-f243-3164-9f28-2302efe712db",
                                        "glosses": [
                                            "A weakness; a flaw or ambiguity."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63b054a5-daca-465d-96e8-a8290e5b2825",
                                                "sense_id": "94b624f2-d646-3d17-a4a1-0775a5d08cc3",
                                                "text": "I have found a hole in your argument."
                                            },
                                            {
                                                "example_id": "86a4b416-f7d6-4505-8c5e-b5f4801a59d8",
                                                "sense_id": "94b624f2-d646-3d17-a4a1-0775a5d08cc3",
