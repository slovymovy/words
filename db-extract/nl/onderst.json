                "senses": [
                    {
                        "sense_id": "a35d8dab-af27-3358-a3f4-a01f4d177f3f",
                        "entry_id": "e6d6f9b9-c188-3456-a51f-74ced54dc66a",
                        "glosses": [
                            "datgene dat geheel onderop ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ee71b6-ca71-424e-86b6-532f05efc712",
                                "sense_id": "a35d8dab-af27-3358-a3f4-a01f4d177f3f",
                                "text": "De onderste bladen zijn door de lekkage vochtig geworden."
                            },
                            {
                                "example_id": "f69472b1-8593-4e25-aadf-8b5ed93670ec",
                                "sense_id": "a35d8dab-af27-3358-a3f4-a01f4d177f3f",
                                "text": "In de supermarkt keek ik meteen naar de onderste schappen met de huismerken en ik kocht alles in de aanbieding."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d5bf575-12df-4895-8974-b53fc0b92609",
                        "source_entry_id": "e6d6f9b9-c188-3456-a51f-74ced54dc66a",
                        "source_sense_id": "a35d8dab-af27-3358-a3f4-a01f4d177f3f",
                        "target_lang_word": "нижний",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нижний",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5c7d61f6-5494-3cde-ac66-a78f9f2f92ea",
                                        "entry_id": "0b5d9bf6-b06d-369c-b7d2-7397a6907de0",
                                        "glosses": [
                                            "находящийся под другими, ниже других"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a325706-e878-475b-925a-b3b3b652f05b",
                                                "sense_id": "5c7d61f6-5494-3cde-ac66-a78f9f2f92ea",
                                                "text": "Около двух часов пополуночи я отворил окно и, связав две шали, спустился с верхнего балкона на нижний, придерживаясь за колонну."
                                            },
                                            {
                                                "example_id": "d40452f2-1a23-4523-83a3-77e23538200a",
                                                "sense_id": "5c7d61f6-5494-3cde-ac66-a78f9f2f92ea",
                                                "text": "А в ложах двух нижних ярусов и на сцене сидели представители буржуазии и дворянства."
                                            },
                                            {
                                                "example_id": "d02266ec-66bf-46a2-8f4e-3ed0d675a1d4",
                                                "sense_id": "5c7d61f6-5494-3cde-ac66-a78f9f2f92ea",
                                                "text": "Слезы текли у него прямо на нижнюю толстую губу, и он медленно глотал их."
                                            },
                                            {
                                                "example_id": "ccda4531-fa63-404f-af73-458802d22490",
                                                "sense_id": "5c7d61f6-5494-3cde-ac66-a78f9f2f92ea",
                                                "text": "Едва я не забыл сказать, что в окошко нижнего этажа мелькали два новые лиц."
                                            },
                                            {
                                                "example_id": "67ba4b52-2fa7-4a7f-b346-0f5283cec996",
                                                "sense_id": "5c7d61f6-5494-3cde-ac66-a78f9f2f92ea",
                                                "text": "Принято было за правило, чтобы в губернские батальоны поступали из армии нижние чины, определенные на службу из самих тех уездов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "130a7175-87af-3b47-a855-5f0b99404f25",
                                        "entry_id": "0b5d9bf6-b06d-369c-b7d2-7397a6907de0",
                                        "glosses": [
                                            "жарг. партнёр, который принимает на себя подчинённую роль"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
