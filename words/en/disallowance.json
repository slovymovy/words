{
    "word_family": [
        "disallow",
        "allowance",
        "allow"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6aa9e6f1-4f2e-308a-9cd9-5487005b0805",
                    "sense_definition": "The action of not allowing, rejecting, or withdrawing permission or allowance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>disallowance</w> of individual choice caused widespread protests among the citizens.",
                            "target_lang_translations": {
                                "pl": "Nagłe <w>odebranie</w> możliwości indywidualnego wyboru wywołało masowe protesty wśród obywateli."
                            }
                        },
                        {
                            "text": "The committee's decision resulted in the <w>disallowance</w> of claims that lacked proper documentation.",
                            "target_lang_translations": {
                                "pl": "Decyzja komisji skutkowała <w>odrzuceniem</w> roszczeń, które nie posiadały odpowiedniej dokumentacji."
                            }
                        }
                    ],
                    "synonyms": [
                        "rejection",
                        "refusal",
                        "prohibition",
                        "disapproval"
                    ],
                    "antonyms": [
                        "allowance",
                        "approval",
                        "permission"
                    ],
                    "common_phrases": [
                        "disallowance of claims",
                        "disallowance of individual choice"
                    ],
                    "target_lang_definitions": {
                        "pl": "Działanie polegające na niedopuszczeniu, odrzuceniu lub wycofaniu pozwolenia bądź zgody."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odrzucenie",
                                "target_lang_sense_clarification": "np. wniosku, roszczenia"
                            },
                            {
                                "target_lang_word": "odmowa",
                                "target_lang_sense_clarification": "np. zgody, prawa"
                            },
                            {
                                "target_lang_word": "niedopuszczenie",
                                "target_lang_sense_clarification": "np. do głosu, do wyboru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c95b7e5b-35c3-334b-96eb-154eafc7e406",
                    "sense_definition": "The constitutional or legal power of a higher authority to veto or invalidate legislation passed by a lower jurisdiction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_veto",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The federal government exercised its power of <w>disallowance</w> to strike down the provincial law.",
                            "target_lang_translations": {
                                "pl": "Rząd federalny skorzystał ze swojego <w>prawa weta</w>, aby obalić prawo prowincjonalne."
                            }
                        },
                        {
                            "text": "Historically, the British monarch held the power of <w>disallowance</w> over colonial legislation.",
                            "target_lang_translations": {
                                "pl": "Historycznie rzecz biorąc, brytyjski monarcha posiadał prawo do <w>unieważniania</w> ustawodawstwa kolonialnego."
                            }
                        }
                    ],
                    "synonyms": [
                        "veto",
                        "invalidation",
                        "nullification"
                    ],
                    "antonyms": [
                        "ratification",
                        "sanction"
                    ],
                    "common_phrases": [
                        "power of disallowance"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used in legal and constitutional contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Konstytucyjne lub prawne uprawnienie wyższego organu władzy do zawetowania lub unieważnienia ustawodawstwa uchwalonego przez niższą instancję."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "prawo weta",
                                "target_lang_sense_clarification": "w prawie konstytucyjnym"
                            },
                            {
                                "target_lang_word": "unieważnienie",
                                "target_lang_sense_clarification": "ustawy przez wyższy organ"
                            },
                            {
                                "target_lang_word": "uchylenie",
                                "target_lang_sense_clarification": "aktu prawnego"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}