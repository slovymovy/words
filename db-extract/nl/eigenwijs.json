                ],
                "senses": [
                    {
                        "sense_id": "6eb5e97b-e5cc-3d1d-9695-9a7efd2c5b71",
                        "entry_id": "87830714-e6ad-31f6-8355-8cd0ca848302",
                        "glosses": [
                            "overtuigd zijn van het eigen gelijk"
                        ],
                        "tags": [
                            "te"
                        ],
                        "examples": [
                            {
                                "example_id": "2d5fc24c-4739-4813-addb-4c4797743148",
                                "sense_id": "6eb5e97b-e5cc-3d1d-9695-9a7efd2c5b71",
                                "text": "De eigenwijze oude man wilde niet naar de adviezen van de welwillende verpleegster luisteren."
                            },
                            {
                                "example_id": "c5ec789b-81ee-4191-a863-e8c9fb9e7ac4",
                                "sense_id": "6eb5e97b-e5cc-3d1d-9695-9a7efd2c5b71",
                                "text": "\"Liesbeth is een bescheiden, dankbare vrouw\", vertelt Boeijen. \"Een heel erg prettig iemand om mee samen te werken. Lekker eigenwijs, dat hoort ook.\""
                            },
                            {
                                "example_id": "7a9e35b8-cf88-499e-9f62-f8342ab5d2ca",
                                "sense_id": "6eb5e97b-e5cc-3d1d-9695-9a7efd2c5b71",
                                "text": "Het eigenwijze kind deed lekker niet wat zijn overbezorgde moeder zei dat het moest doen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
