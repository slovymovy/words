                "senses": [
                    {
                        "sense_id": "0a2c38d1-dfa4-3f6c-925d-8cf66815b41f",
                        "entry_id": "3c82cf14-a972-3a62-9b0b-d701793b64bc",
                        "glosses": [
                            "door pompen zorgen dat een vloeistof ergens anders naartoe gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f9099d5-b951-44b3-88b0-f684bee4dffa",
                                "sense_id": "0a2c38d1-dfa4-3f6c-925d-8cf66815b41f",
                                "text": "Andere grote steden elders in de wereld kennen dezelfde problemen door het wegpompen van grondwater. Delen van Mexico-Stad dalen jaarlijks zelfs 28 centimeter en ook Bangkok en Jakarta zakken in hoog tempo."
                            },
                            {
                                "example_id": "4d64301f-4ba0-4b79-bab8-d112ba8fda7e",
                                "sense_id": "0a2c38d1-dfa4-3f6c-925d-8cf66815b41f",
                                "text": "Dinsdag gaf het hoogheemraadschap Delfland groen licht voor het dagelijks wegpompen van anderhalf miljoen liter water. Als dat niet zou gebeuren, dan zou de snelweg onder water komen te staan."
                            },
                            {
                                "example_id": "2e09cb7c-9d20-48c1-a9a9-3e465b54a224",
                                "sense_id": "0a2c38d1-dfa4-3f6c-925d-8cf66815b41f",
                                "text": "Het gemaal staat tussen de Loolee en het Kanaal Almelo-Nordhorn, aan het einde van Sluiskade Zuidzijde. Het wegpompen van water naar het kanaal moet ervoor zorgen dat Almelo droge voeten houdt."
                            }
                        ]
                    }
