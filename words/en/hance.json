{
    "word_family": [
        "enhancement",
        "enhance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a77830c-8375-38b6-9867-783745ceb6c5",
                    "sense_definition": "To raise or elevate something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "raise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect decided to <w>hance</w> the ceiling to create a more spacious feeling in the room.",
                            "target_lang_translations": {
                                "pl": "Architekt zdecydował się <w>podnieść</w> sufit, aby nadać pomieszczeniu bardziej przestronny charakter."
                            }
                        },
                        {
                            "text": "They sought to <w>hance</w> the platform to ensure it remained visible above the growing crowd.",
                            "target_lang_translations": {
                                "pl": "Starali się <w>podwyższyć</w> platformę, aby zapewnić jej widoczność ponad rosnącym tłumem."
                            }
                        }
                    ],
                    "synonyms": [
                        "raise",
                        "elevate",
                        "lift"
                    ],
                    "antonyms": [
                        "lower",
                        "depress"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Podnosić lub zwiększać wysokość czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "podnosić",
                                "target_lang_sense_clarification": "zwiększać wysokość lub poziom czegoś"
                            },
                            {
                                "target_lang_word": "wznosić",
                                "target_lang_sense_clarification": "umieszczać coś wyżej"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "743cb02b-8814-3920-8f2c-04516f443c7c",
                    "sense_definition": "A curve or arc, particularly in architectural structures or ship design.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "curve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship's hull featured a graceful <w>hance</w> that improved its movement through the water.",
                            "target_lang_translations": {
                                "pl": "Kadłub statku charakteryzował się pełną wdzięku <w>krzywizną</w>, która poprawiała jego ruch w wodzie."
                            }
                        },
                        {
                            "text": "The stone bridge was built with a distinct <w>hance</w> at the base of each arch.",
                            "target_lang_translations": {
                                "pl": "Kamienny most został zbudowany z wyraźnym <w>łukiem</w> u podstawy każdego przęsła."
                            }
                        }
                    ],
                    "synonyms": [
                        "arc",
                        "curve",
                        "bend"
                    ],
                    "target_lang_definitions": {
                        "pl": "Krzywizna lub łuk, szczególnie w architekturze lub konstrukcji statków."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "łuk",
                                "target_lang_sense_clarification": "zakrzywiony element konstrukcyjny"
                            },
                            {
                                "target_lang_word": "krzywizna",
                                "target_lang_sense_clarification": "wygięty kształt powierzchni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6eaf12b-3fb7-3351-a489-f0e4e77fdeb9",
                    "sense_definition": "The arc of a smaller radius found at the springing point of an elliptical or complex arch.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "curve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mason carefully carved the <w>hance</w> to ensure the arch would support the weight correctly.",
                            "target_lang_translations": {
                                "pl": "Kamieniarz starannie wyrzeźbił <w>krzywiznę</w>, aby upewnić się, że łuk będzie prawidłowo przenosił ciężar."
                            }
                        },
                        {
                            "text": "The structural integrity of the arch depended on the precise angle of the <w>hance</w>.",
                            "target_lang_translations": {
                                "pl": "Integralność strukturalna łuku zależała od precyzyjnego kąta <w>węgarka</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "arc"
                    ],
                    "target_lang_definitions": {
                        "pl": "Łuk o mniejszym promieniu znajdujący się w punkcie wyjścia łuku eliptycznego lub złożonego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "węgarek",
                                "target_lang_sense_clarification": "element konstrukcyjny łuku"
                            },
                            {
                                "target_lang_word": "krzywizna łuku",
                                "target_lang_sense_clarification": "techniczne określenie wygięcia w architekturze"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9d3a63cd-4c6b-3258-a5d5-e90511e8cb8d",
                    "sense_definition": "A surname originating as a patronymic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian researched the genealogy of the <w>Hance</w> family.",
                            "target_lang_translations": {
                                "pl": "Historyk badał genealogię rodziny <w>Hance</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Hance</w> attended the conference to discuss his recent findings.",
                            "target_lang_translations": {
                                "pl": "Pan <w>Hance</w> wziął udział w konferencji, aby omówić swoje ostatnie odkrycia."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nazwisko pochodzące od imienia ojca."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Hance",
                                "target_lang_sense_clarification": "nazwisko własne"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}