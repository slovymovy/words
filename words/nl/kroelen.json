{
    "word_family": [
        "gekroel",
        "kroelpartij"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12fe5097-132d-3d20-af83-cfe2f8de5f4b",
                    "sense_definition": "Liefdevol omhelzen, knuffelen of aanhalen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "affectie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen vinden het heerlijk om op de bank met hun moeder te <w>kroelen</w>.",
                            "target_lang_translations": {
                                "en": "The children love to <w>cuddle</w> with their mother on the couch."
                            }
                        },
                        {
                            "text": "Na een lange dag werken wil ik gewoon even lekker <w>kroelen</w> met de hond.",
                            "target_lang_translations": {
                                "en": "After a long day of work, I just want to have a nice <w>snuggle</w> with the dog."
                            }
                        }
                    ],
                    "synonyms": [
                        "knuffelen",
                        "koesteren",
                        "aanhalen",
                        "nestelen"
                    ],
                    "common_phrases": [
                        "lekker kroelen",
                        "samen kroelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vooral informeel gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To hug, cuddle, or caress lovingly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cuddle",
                                "target_lang_sense_clarification": "to hold close in an affectionate way"
                            },
                            {
                                "target_lang_word": "snuggle",
                                "target_lang_sense_clarification": "to settle or draw together closely for warmth or affection"
                            },
                            {
                                "target_lang_word": "hug",
                                "target_lang_sense_clarification": "to squeeze tightly in one's arms"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "364f449a-2b97-33ee-8a91-27f228c911c1",
                    "sense_definition": "Zachtjes krabben, strelen of kietelen, vaak op het hoofd of de rug.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aanraking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je even op mijn rug <w>kroelen</w> op de plek waar het jeukt?",
                            "target_lang_translations": {
                                "en": "Can you <w>scratch</w> my back for a moment where it itches?"
                            }
                        },
                        {
                            "text": "De kat spint luid wanneer je achter haar oren begint te <w>kroelen</w>.",
                            "target_lang_translations": {
                                "en": "The cat purrs loudly when you start to <w>stroke</w> behind her ears."
                            }
                        }
                    ],
                    "synonyms": [
                        "krabbelen",
                        "kietelen",
                        "strelen"
                    ],
                    "common_phrases": [
                        "op de rug kroelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informeel en vaak regionaal gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To gently scratch, stroke, or tickle, often on the head or back."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scratch",
                                "target_lang_sense_clarification": "gently, to relieve an itch or show affection"
                            },
                            {
                                "target_lang_word": "stroke",
                                "target_lang_sense_clarification": "to gently move one's hand over a surface"
                            },
                            {
                                "target_lang_word": "tickle",
                                "target_lang_sense_clarification": "lightly touching to tease or please"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}