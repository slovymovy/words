                                    {
                                        "sense_id": "0c05e4c6-0564-3bf3-bbbe-3cb66aae14b4",
                                        "entry_id": "63cb520e-212c-3726-958f-a064529375d1",
                                        "glosses": [
                                            "An extinct arthropod of the class Trilobita, whose body had three large lobes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc275eed-0c8e-4d2d-ab6d-44e3656a04d3",
                                                "sense_id": "0c05e4c6-0564-3bf3-bbbe-3cb66aae14b4",
                                                "text": "When you look at a Precambrian trilobite in the lobby of a New York bank, it is difficult to speculate about its primeval environment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6a69305-d75d-40ad-9c64-f600fba646ce",
                        "source_entry_id": "8ee1dd36-5620-3ab6-a0b4-519e400363c1",
                        "source_sense_id": "d5a8894a-3537-3439-8b01-0cfbddaa1c72",
