                                        "glosses": [
                                            "Unaffected by time; timeless; permanent or unchanging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9bd14ad-01be-44f9-b241-d2a4f34d41b3",
                                                "sense_id": "2fd378e8-8656-341b-9e7d-5d307a961128",
                                                "text": "The machinery, when activated, would create atemporal bubbles wherein nothing was affected by the flow of time."
                                            },
                                            {
                                                "example_id": "0927b570-d0ca-4440-9bed-635eefb51aff",
                                                "sense_id": "2fd378e8-8656-341b-9e7d-5d307a961128",
                                                "text": "The greatest music is atemporal."
                                            }
                                        ]
