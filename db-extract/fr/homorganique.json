                "senses": [
                    {
                        "sense_id": "61ff3a64-8dc7-3828-9933-cc30c56328fd",
                        "entry_id": "c40231c5-4f22-3887-98e5-5fb284f750d4",
                        "glosses": [
                            "Qui procède du même organe de la phonation : dents pour les dentales, lèvres pour les labiales, etc."
                        ],
                        "tags": [
                            "Phonétique"
                        ],
                        "examples": [
                            {
                                "example_id": "43c3c558-079f-462f-9a09-19de77d4b335",
                                "sense_id": "61ff3a64-8dc7-3828-9933-cc30c56328fd",
                                "text": "L'expression \"de toute façon\" devient souvent, à l'oral, \"d'toute façon\", puisque [d] et [t] appartiennent au même groupe de consonnes (les dentales)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dfbca03-d327-4f25-bd61-256bac42fcd7",
                        "source_entry_id": "c40231c5-4f22-3887-98e5-5fb284f750d4",
                        "source_sense_id": "61ff3a64-8dc7-3828-9933-cc30c56328fd",
