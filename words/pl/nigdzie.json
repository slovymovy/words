                    "frequency": "High",
                    "semantic_group_id": "kierunek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Nigdzie</w> dzisiaj nie pójdziesz, będziesz siedzieć w domu i się uczyć.",
                            "target_lang_translations": {
                                "ru": "Ты сегодня <w>никуда</w> не пойдёшь, будешь сидеть дома и учиться."
                            }
                        },
                        {
                            "text": "W ten weekend postanowiłem zostać w mieszkaniu i <w>nigdzie</w> nie wyjeżdżać.",
                            "target_lang_translations": {
                                "ru": "В эти выходные я решил остаться в квартире и <w>никуда</w> не уезжать."
                            }
                        }
                    ],
                    "synonyms": [
