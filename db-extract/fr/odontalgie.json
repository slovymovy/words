                ],
                "senses": [
                    {
                        "sense_id": "96647fd9-5237-3043-b9af-b766201d3c44",
                        "entry_id": "3c5fb11f-d08e-3bd3-a360-2ea972e82e0c",
                        "glosses": [
                            "Douleur des dents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4536db6b-4157-4bee-af28-aa2ab1c2727b",
                                "sense_id": "96647fd9-5237-3043-b9af-b766201d3c44",
                                "text": "— Puis-je demander à quel usage vous voulez employer ce laudanum ?\n— C’est pour des douleurs de dents.\n— Une odontalgie nerveuse alors, car madame a des dents magnifiques.\n— Oui, c’est cela.\n— En frictions sur la partie douloureuse sans doute ?\n— Oui.\n— Alors une petite quantité suffit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd5de54c-9474-4ca0-8378-a269169c5eea",
                        "source_entry_id": "3c5fb11f-d08e-3bd3-a360-2ea972e82e0c",
                        "source_sense_id": "96647fd9-5237-3043-b9af-b766201d3c44",
                        "target_lang_word": "Zahnschmerz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zahnschmerz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc764ddd-8c9c-3a75-b8d7-8770c21eaf9d",
                                        "entry_id": "9288af12-9fb5-3ed7-be08-c8fd2ae007be",
                                        "glosses": [
                                            "Schmerz, der von einem kranken Zahn verursacht wird"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "679ec378-c84f-4482-933e-b5408a6baf08",
                                                "sense_id": "cc764ddd-8c9c-3a75-b8d7-8770c21eaf9d",
                                                "text": "Wegen seiner Zahnschmerzen ging er zum Zahnarzt."
                                            },
                                            {
                                                "example_id": "fe4c7547-fe99-43bf-93fa-417b9d295f40",
                                                "sense_id": "cc764ddd-8c9c-3a75-b8d7-8770c21eaf9d",
                                                "text": "„Zahnschmerzen wandern nicht.“"
                                            },
                                            {
                                                "example_id": "c878237f-3b6f-451c-b86a-b7a8c5f576ed",
                                                "sense_id": "cc764ddd-8c9c-3a75-b8d7-8770c21eaf9d",
                                                "text": "„Ich klagte über heftige Zahnschmerzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b45774c-ea19-4ce0-8c0f-8cd8cc7480b3",
                        "source_entry_id": "3c5fb11f-d08e-3bd3-a360-2ea972e82e0c",
                        "source_sense_id": "96647fd9-5237-3043-b9af-b766201d3c44",
                        "target_lang_word": "Zahnweh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zahnweh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c73c41f-cc51-37d3-bdf4-cbf3dd5cdc90",
                                        "entry_id": "4ae66a5a-97dd-3024-aa59-dddac4933af7",
                                        "glosses": [
                                            "Schmerz, der von einem kranken Zahn verursacht wird"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e22e8ab7-275a-46af-9708-a05e23407c38",
                                                "sense_id": "9c73c41f-cc51-37d3-bdf4-cbf3dd5cdc90",
                                                "text": "Er konnte die ganze Nacht nicht schlafen, weil er so Zahnweh hatte."
                                            },
                                            {
                                                "example_id": "2f567d02-8b9d-4b12-b947-16842a576a2d",
                                                "sense_id": "9c73c41f-cc51-37d3-bdf4-cbf3dd5cdc90",
                                                "text": "„In Piperno, wo wir zu Mittag aßen, sagte sie mir, mein Zahnweh sei nur vorgetäuscht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
