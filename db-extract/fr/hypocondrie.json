                                        "entry_id": "0ec5414c-fbbc-3c93-acf6-12490e665fce",
                                        "glosses": [
                                            "estado psíquico que se caracteriza pela crença infundada de se padecer de uma doença grave"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cca98055-46eb-354e-9fe6-ef034e040bbe",
                                        "entry_id": "0ec5414c-fbbc-3c93-acf6-12490e665fce",
                                        "glosses": [
                                            "tristeza profunda, melancolia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f31ba722-7221-4a04-892d-3e41741be7b2",
                                                "sense_id": "cca98055-46eb-354e-9fe6-ef034e040bbe",
                                                "text": "E foi por diante o mágico, a agitar diante de mim um chocalho, como me faziam, em pequeno, para eu andar depressa, e a flor da hipocondria recolheu-se ao botão para deixar a outra flor menos amarela, e nada mórbida - o amor da nomeada, o emplasto Brás Cubas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2bd7802-91e9-44a5-807a-669b55d43172",
                        "source_entry_id": "c1394648-ffb1-3ec8-adc1-be1f97f58dd9",
                        "target_lang_word": "мнительность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
