                        "sense_id": "ec036eb3-220f-3c73-bdcd-96a38494e62a",
                        "entry_id": "c00b1424-91a1-37e4-9f68-51a574cda298",
                        "glosses": [
                            "перен. намеренно отказаться от рассмотрения, обсуждения чего-либо, не принять во внимание что-либо"
                        ],
                        "tags": [],
