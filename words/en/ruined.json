{
    "word_family": [
        "ruin",
        "ruinous",
        "ruination"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24e7e51e-479b-35b2-abf2-e716eeda03bc",
                    "sense_definition": "Damaged so severely that it is destroyed, decayed, or no longer usable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We explored an ancient <w>ruined</w> castle near the top of the hill. ",
                            "target_lang_translations": {
                                "ru": "Мы исследовали древний <w>разрушенный</w> замок на вершине холма."
                            }
                        },
                        {
                            "text": "Heavy storms left the old wooden shed completely <w>ruined</w>.",
                            "target_lang_translations": {
                                "ru": "Сильные штормы полностью <w>разрушили</w> старый деревянный сарай."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ruined castle",
                        "ruined building",
                        "completely ruined"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушенный или поврежденный до такой степени, что непригоден для использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрушенный",
                                "target_lang_sense_clarification": "о зданиях и строениях"
                            },
                            {
                                "target_lang_word": "разоренный",
                                "target_lang_sense_clarification": "о месте или хозяйстве"
                            },
                            {
                                "target_lang_word": "испорченный",
                                "target_lang_sense_clarification": "о вещах и предметах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7d27bb6-1a02-3b7e-8634-ed08ea615b32",
                    "sense_definition": "Having lost all money, resources, or financial stability; bankrupt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the market crashed, many successful investors found themselves financially <w>ruined</w>.",
                            "target_lang_translations": {
                                "ru": "После краха рынка многие успешные инвесторы оказались финансово <w>разорены</w>."
                            }
                        },
                        {
                            "text": "Bad investments left his business completely <w>ruined</w> within a year.",
                            "target_lang_translations": {
                                "ru": "Плохие инвестиции полностью <w>разорили</w> его бизнес в течение года."
                            }
                        }
                    ],
                    "synonyms": [
                        "undone"
                    ],
                    "common_phrases": [
                        "financially ruined"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потерявший все деньги, финансовую стабильность; разорившийся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разоренный",
                                "target_lang_sense_clarification": "о человеке или бизнесе"
                            },
                            {
                                "target_lang_word": "банкрот",
                                "target_lang_sense_clarification": "финансово несостоятельный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f1ecc07-f566-34de-b02e-48a01ddaf5a4",
                    "sense_definition": "Extremely intoxicated or incapacitated by alcohol or drugs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He drank way too much at the party and ended up completely <w>ruined</w>.",
                            "target_lang_translations": {
                                "ru": "Он выпил слишком много на вечеринке и в итоге был полностью <w>готовый</w>."
                            }
                        },
                        {
                            "text": "They were totally <w>ruined</w> after a night of heavy drinking.",
                            "target_lang_translations": {
                                "ru": "После ночи бурной выпивки они были просто <w>никакие</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal slang for extreme intoxication"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно пьяный или находящийся под действием веществ (слэнг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьяный в дрова",
                                "target_lang_sense_clarification": "вдребезги пьяный"
                            },
                            {
                                "target_lang_word": "готовый",
                                "target_lang_sense_clarification": "сильно опьяневший"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a62d907f-fa4f-3f18-b19e-c55c220608c9",
                    "sense_definition": "Simple past tense and past participle of <w>ruin</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden rain shower <w>ruined</w> our weekend picnic in the park.",
                            "target_lang_translations": {
                                "ru": "Внезапный проливной дождь <w>испортил</w> наш пикник в парке на выходных."
                            }
                        },
                        {
                            "text": "He accidentally dropped his phone in the water and <w>ruined</w> it.",
                            "target_lang_translations": {
                                "ru": "Он случайно уронил телефон в воду и <w>испортил</w> его."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ruined my day",
                        "ruined the surprise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола to ruin (испортить, разрушить)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испортил",
                                "target_lang_sense_clarification": "планы, вещь, настроение"
                            },
                            {
                                "target_lang_word": "разрушил",
                                "target_lang_sense_clarification": "что-либо материальное или жизнь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}