                "translations": [
                    {
                        "translation_id": "34f5e3ea-e18b-4f32-81f0-61ca465bf171",
                        "source_entry_id": "81bee35e-3e3a-3440-ab9c-458a0f7de850",
                        "source_sense_id": "9bdb2a99-56c9-3b41-ba60-f8dba575a1cd",
                        "target_lang_word": "matron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
