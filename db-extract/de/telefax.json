                                        "sense_id": "e8795744-3d7c-3150-8b64-f9055a70c069",
                                        "entry_id": "03d1aec6-97fb-320d-ad1b-cae3ed46b2a2",
                                        "glosses": [
                                            "The face."
                                        ],
                                        "tags": [
