                                                "example_id": "5fba73b4-1c5f-4e3b-981d-d6d616577da3",
                                                "sense_id": "38d00ff7-84b8-30ee-8f1a-7f4f314e85aa",
                                                "text": "Bei Velveton wird die Oberfläche geraut, geschmirgelt und anschließend kurz geschoren."
                                            },
                                            {
                                                "example_id": "a4336737-333e-44de-b0d0-aad086205486",
                                                "sense_id": "38d00ff7-84b8-30ee-8f1a-7f4f314e85aa",
                                                "text": "Die rechte Gewebeseite wird geraut, jedoch nicht verstrichen. Der Flauschloden erhält dadurch eine matte, sehr weiche Oberfläche."
                                            }
