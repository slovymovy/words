                                    {
                                        "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                        "entry_id": "be51b1f8-6741-38db-8844-6c188075bb07",
                                        "glosses": [
                                            "Person, die aufgrund ihrer Ausbildung dazu in der Lage ist Restaurierungsarbeiten fachgerecht durchzuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd2720da-f900-4ba7-85dc-0e519c4897ec",
                                                "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                                "text": "„In der Werkstätte von Restaurator Thomas Frankl geht es nun darum, die Holzsärge von Schimmel zu reinigen, die Substanz zu erhalten und die Bemalungen und Beschläge zu konservieren.“"
                                            },
                                            {
                                                "example_id": "bab2b25a-9ed3-4e74-8a4d-27d8c1f1b379",
                                                "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                                "text": "„Ihr Verkauf brachte dem Restaurator aus Niederbayern mehr als eine halbe Million Euro - bis ihm ein Kunsthistoriker auf die Spur kam.“"
                                            },
                                            {
                                                "example_id": "6fe2e874-9bab-4f4d-b1e5-f8565dbede4f",
                                                "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                                "text": "„Museumsrundgang, Obergeschoss, der Restaurator geleitet durch die hohen Hallen wie ein Fremdenführer.“"
                                            },
                                            {
                                                "example_id": "38ac797e-6670-4dbb-b5bc-3aeb001f8ae0",
                                                "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                                "text": "„Als Restaurator von Orgeln verdiente er sein täglich Brot.“"
                                            }
                                        ],
