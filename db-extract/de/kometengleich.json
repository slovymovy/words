                "senses": [
                    {
                        "sense_id": "5c87beaa-073b-35d5-8bf5-1b1f03b635f0",
                        "entry_id": "9fea3f51-8ff7-3c0a-9d3a-92ac8a2e0005",
                        "glosses": [
                            "sehr schnell, rasant steigend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "123392db-afa2-4aad-9f78-5ae3c5f72a30",
                                "sense_id": "5c87beaa-073b-35d5-8bf5-1b1f03b635f0",
                                "text": "„Dann wurde mit einem sonderbaren Pfeifen und Stürzen der Fall vollbracht, und Carter fühlte alle Schrecken des Albtraums, als die Erde verging und das große Schiff lautlos und kometengleich ins Weltall schoss.“"
                            },
                            {
                                "example_id": "3525097c-565c-4be8-bc8f-6a04b6f04ae1",
                                "sense_id": "5c87beaa-073b-35d5-8bf5-1b1f03b635f0",
                                "text": "„Dann begann er wieder mit kometengleicher Schnelligkeit in Richtung des erfrorenen Kontinents zu stürzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
