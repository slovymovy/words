                                "example_id": "3044984b-0971-46ea-829d-c4faeeae0570",
                                "sense_id": "3340441e-5884-3d46-94f2-7247d9dcbb0f",
                                "text": "The present studies demonstrate that iodine depletion increases the sensitivity of the thyroid to the goitrogenic effects of thyrotropin."
                            },
                            {
                                "example_id": "30e12f24-af81-4a0c-b2cf-1c99a4c04aa0",
                                "sense_id": "3340441e-5884-3d46-94f2-7247d9dcbb0f",
                                "text": "Seventy-eight compounds were screened for goitrogenic action. Of these, 12 were found to be effective, but only thiouracil, propylthiouracil, 2-amino-thiazole and Dithane were found to be markedly active."
                            }
                        ]
