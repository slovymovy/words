                "entry_id": "64018d8d-ba4f-3d3f-9d57-d955a84a0d2b",
                "word": "Chinatown",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "49baee94-9991-4086-8441-6ce208f89687",
                        "entry_id": "64018d8d-ba4f-3d3f-9d57-d955a84a0d2b",
                        "tags": [
                            "plural"
                        ],
                        "form": "Chinatowns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6bfc7ab0-d1a1-3969-9cf2-0b1ec8b0d762",
                        "entry_id": "64018d8d-ba4f-3d3f-9d57-d955a84a0d2b",
                        "glosses": [
                            "Quartier ayant accueilli des Asiatiques, en particulier dans les pays anglophones d’Amérique."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "0c712ffa-3238-447a-8915-aba7e6958cf6",
                                "sense_id": "6bfc7ab0-d1a1-3969-9cf2-0b1ec8b0d762",
                                "text": "Certaine conversation de mes aînés, au sujet des bouges infects de Chinatown, à San Francisco, avait laissé une profonde impression dans mon jeune esprit."
                            },
                            {
                                "example_id": "065edbfd-67ad-46ae-82a2-debaf835fd3a",
                                "sense_id": "6bfc7ab0-d1a1-3969-9cf2-0b1ec8b0d762",
                                "text": "C’est mon ami Hong-Tcheng-Tsi, que j’ai connu dans la Chinatown de San-Francisco."
                            },
                            {
                                "example_id": "49f2848d-11c6-4111-843d-97231c39e2c2",
                                "sense_id": "6bfc7ab0-d1a1-3969-9cf2-0b1ec8b0d762",
                                "text": "… elle s'allume une cigarette avec un faux briquet Cartier acheté dans le Chinatown de New York au printemps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c5de82a-2ee2-465c-86dd-30954628bd52",
                        "source_entry_id": "64018d8d-ba4f-3d3f-9d57-d955a84a0d2b",
