                            {
                                "example_id": "64082a57-303c-407d-942a-c0e6ce0c205d",
                                "sense_id": "c4d420b5-1fdb-34c2-9626-a0bd4b8d1689",
                                "text": "„Per Gesetz vom 26. Mai 1955 wird Hammer, Zirkel und Ährenkranz in Ostdeutschland als Staatswappen eingeführt, die Staatsflagge jedoch bleibt Schwarz-Rot-Gold.“"
