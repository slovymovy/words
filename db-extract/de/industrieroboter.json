                    {
                        "sense_id": "d591f4b4-5c2f-36cb-aea9-5fc32a9964b0",
                        "entry_id": "5ae0ebda-2c10-3ca7-b8fd-3adfa7c37e04",
                        "glosses": [
                            "programmierbare Maschine, zur Handhabung und Bearbeitung von Werkstücken"
