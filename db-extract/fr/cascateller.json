                "senses": [
                    {
                        "sense_id": "952a7c2f-dcd0-38ce-951a-62e5521c93bc",
                        "entry_id": "8158511e-4725-3c5a-9eed-30568ffba4f6",
                        "glosses": [
                            "Tomber en cascade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4859d4bd-6ee1-46fe-ab20-c0c57ebbabe4",
                                "sense_id": "952a7c2f-dcd0-38ce-951a-62e5521c93bc",
                                "text": "On entendait bien les sources cascateller dans les profondeurs, mais, même en se frayant passage avec la serpette, il était impossible d’y parvenir."
                            },
                            {
                                "example_id": "90b48c7d-c2c7-453d-bee5-5a64d3fca31d",
                                "sense_id": "952a7c2f-dcd0-38ce-951a-62e5521c93bc",
                                "text": "De cette mosquée encore interdite aux giaours, nous n’apercevons que les cours dallées de marbre où cascatellent les eaux des fontaines réservées aux ablutions des croyants."
                            }
                        ]
                    }
