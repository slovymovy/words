                "senses": [
                    {
                        "sense_id": "4a137d6b-0fd4-386f-851a-6042c7178a60",
                        "entry_id": "d751010d-bfa9-3512-9665-1e9f058bcca2",
                        "glosses": [
                            "Behälter für den Transport von Waren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3095ae4c-3d8b-411f-abb6-bdeed3802ea4",
                                "sense_id": "4a137d6b-0fd4-386f-851a-6042c7178a60",
                                "text": "Der Transportbehälter wurde auf der Laderampe bereitgestellt."
                            },
                            {
                                "example_id": "791a3610-7044-48a7-abb3-eaf94592e00e",
                                "sense_id": "4a137d6b-0fd4-386f-851a-6042c7178a60",
                                "text": "„In der Antike legte man üppig verzierte Amphoren als Beigabe ins Grab oder sie wurden, mit kostbarem Öl gefüllt, den Siegern sportlicher Wettkämpfe überreicht. Unbemalt und schmucklos dienten sie jedoch als wichtigster Transportbehälter in der antiken Welt – für Massengüter wie Getreide, Wein, Olivenöl, Früchte und Würzsoßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
