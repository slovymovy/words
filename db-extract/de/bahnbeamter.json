                "senses": [
                    {
                        "sense_id": "0d324798-0256-30cb-a53d-bfe895cdd201",
                        "entry_id": "5f73e2da-7b02-34a9-92db-94b05868c20e",
                        "glosses": [
                            "Beamter, der bei der Eisenbahn tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33c40b10-81b9-4c02-9e8c-4fa2ef42543c",
                                "sense_id": "0d324798-0256-30cb-a53d-bfe895cdd201",
                                "text": "Am Gleis stand ein Bahnbeamter."
                            },
                            {
                                "example_id": "4f6aefc0-75b1-4b3b-b5be-65d4f2ef4967",
                                "sense_id": "0d324798-0256-30cb-a53d-bfe895cdd201",
                                "text": "„Doch in diesem entscheidenden Punkt erweist sich als wahr, was der Bahnbeamte in Stolp versprochen hat: Wir bleiben gnädig verschont.“"
                            },
                            {
                                "example_id": "02580774-be65-4947-b629-2cfb89f1d83d",
                                "sense_id": "0d324798-0256-30cb-a53d-bfe895cdd201",
                                "text": "„Ihre Auskünfte schnurrte sie herunter mit der Leidenschaftlichkeit des Bahnbeamten am Fahrkartenschalter.“"
                            },
                            {
                                "example_id": "1cfcf085-cfd4-4c3b-a7ae-9a085f158108",
                                "sense_id": "0d324798-0256-30cb-a53d-bfe895cdd201",
                                "text": "„Kein Pförtner im Haus, den ich mit einem Bahnbeamten verwechseln könnte, und doch ist diese Wohnung, in der ich nur drei bis vier Wochen im Jahr verbringe, mir fremder als jedes Hotel.“"
                            },
                            {
                                "example_id": "460fb276-dfb5-4c1f-92ed-833b97779538",
                                "sense_id": "0d324798-0256-30cb-a53d-bfe895cdd201",
                                "text": "„Nur mit Glück und der Hilfe eines Bahnbeamten retteten sie sich aus dem Gebäude.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
