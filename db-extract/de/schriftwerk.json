                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a45181-567a-4107-bdde-587d46c5e07a",
                                "sense_id": "1c79d62a-7d9f-3771-82c4-ee89b6606b92",
                                "text": "„Er war in karminrotem, drachenbesticktem Mantel mit runden Ärmelverzierungen und mit einem Nephritgürtel dargestellt, wie er auf einem Stuhle, den ein Tigerfell bedeckte, vertieft in ein militärisches Schriftwerk, saß.“"
                            },
                            {
                                "example_id": "b4302d99-b299-4d6e-8b93-a6968c767d95",
                                "sense_id": "1c79d62a-7d9f-3771-82c4-ee89b6606b92",
                                "text": "„So wurden nun die alten Schriftwerke, in die er sich vergraben hatte, wieder verbannt und die Exzerpte einstweilen in den Schreibtisch abgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
