                    },
                    {
                        "translation_id": "d76457e6-bd5e-4b82-9a7a-471da40a1954",
                        "source_entry_id": "d8d97704-024a-3117-a73a-608c16a75928",
                        "source_sense_id": "259ff65e-ea0b-38e8-9098-1f49e113a43f",
                        "source_sense_description": "ill-tempered woman — see also shrew",
                        "target_lang_word": "Xanthippe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xanthippe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0bcb2088-aef5-3025-99a0-8f829963d4c5",
                                        "entry_id": "5820836c-eb99-3380-a80e-94a4f6c9ad2e",
                                        "glosses": [
                                            "Bezeichnung für eine zänkische Frau oder Ehefrau nach der Ehefrau von Sokrates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4340b305-c121-4eec-a786-38f20e3c5c1e",
                                                "sense_id": "0bcb2088-aef5-3025-99a0-8f829963d4c5",
                                                "text": "Du traust dich wohl nicht nach Hause zu deiner Xanthippe?"
                                            },
                                            {
                                                "example_id": "53107855-5dc6-4091-9799-85327ed24fd3",
                                                "sense_id": "0bcb2088-aef5-3025-99a0-8f829963d4c5",
                                                "text": "„Vors Fenster wird er ihn hängen, wie er die Möbel seiner ersten Frau, dieser Xanthippe, vors Fenster gehängt hat: den Nachtstuhl, den Schrank, die Kommode, alles hinaus vors Fenster, an langen Stricken.“"
                                            },
                                            {
                                                "example_id": "0be5026d-a77c-405c-89ff-0ddb772a6cf8",
                                                "sense_id": "0bcb2088-aef5-3025-99a0-8f829963d4c5",
                                                "text": "„Seine Frau ist ’ne Xanthippe und imstande, ihm das Leben zur Hölle zu machen.“"
                                            },
                                            {
                                                "example_id": "a8b650c6-3e97-4bea-bd93-716de61c081f",
                                                "sense_id": "0bcb2088-aef5-3025-99a0-8f829963d4c5",
                                                "text": "„Die Frau des Sokrates hieß Xanthippe und war gar keine.“"
                                            },
                                            {
                                                "example_id": "163e6f34-41ac-42fe-bbdd-3f3280ee5518",
                                                "sense_id": "0bcb2088-aef5-3025-99a0-8f829963d4c5",
                                                "text": "„Der komische Effekt der Szene entsteht aus dem Gegensatz zwischen den hehren Zielen, die Benjamin mit seiner Reise zu verfolgen vorgibt, und dem niedrigen Beweggrund des geschundenen Ehemannes, der den Klauen seiner Xanthippe entkommen soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Xanthippe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbad90c2-f306-3f6a-a187-d1d573e1e159",
                                        "entry_id": "8f50695c-0e4b-3b28-9f21-a5966cffe5fc",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8abe39ac-f064-4298-8b90-e3c9e387d00c",
                                                "sense_id": "fbad90c2-f306-3f6a-a187-d1d573e1e159",
                                                "text": "Xanthippe hat rote Haare."
                                            },
                                            {
                                                "example_id": "d95eec7a-0642-4ded-82d1-e51a99ae7968",
                                                "sense_id": "fbad90c2-f306-3f6a-a187-d1d573e1e159",
                                                "text": "Ich kenne niemanden, der Xanthippe heißt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
