                "senses": [
                    {
                        "sense_id": "ee0cb6dc-d059-30e1-a23f-a4d8ae40594d",
                        "entry_id": "962d37e9-ac3f-3cf9-99b3-1713a84d88f1",
                        "glosses": [
                            "A prescriptive or normative economic stance according to which the state should actively stimulate economic growth and improve stability in the private sector through interest rates, taxation and public projects."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aefcadfb-293c-4f28-b884-711c8f33ee37",
                        "source_entry_id": "962d37e9-ac3f-3cf9-99b3-1713a84d88f1",
                        "source_sense_id": "ee0cb6dc-d059-30e1-a23f-a4d8ae40594d",
                        "source_sense_description": "economic stance",
                        "target_lang_word": "keynésianisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "keynésianisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e93aa659-c42b-3f91-b05b-e97733335141",
                                        "entry_id": "6fc6e0ab-cbbf-35d9-987c-80f99a35845d",
                                        "glosses": [
                                            "École de pensée économique interventionniste préconisant notamment une politique de relance pour redynamiser l’économie."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5359794-a321-44a7-97a8-556e5322a839",
                                                "sense_id": "e93aa659-c42b-3f91-b05b-e97733335141",
                                                "text": "Pendant que dans l'économie communiste le Gosplan était substitué à la « main invisible » du marché, le keynésianisme tempéré, combinant le rôle de l'État et celui du marché, inspirait la pensée des démocrates américains et des sociaux-démocrates européens."
                                            },
                                            {
                                                "example_id": "41810475-a57a-408e-acdd-535c2ef4f005",
                                                "sense_id": "e93aa659-c42b-3f91-b05b-e97733335141",
                                                "text": "Le keynésianisme politique éloigné de la théorie de Keynes permet ainsi de retracer l'évolution des approches macroéconomiques depuis la publication de la Théorie générale. Les modèles néo-keynésiens ([…]) préconisent un keynésianisme politique, acceptation de politiques actives de soutien de l'activité économique, mais pas un keynésianisme théorique puisque leurs références restent les approches de marché."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e171486-a661-4d88-9ccb-1623854cacd4",
                        "source_entry_id": "962d37e9-ac3f-3cf9-99b3-1713a84d88f1",
                        "source_sense_id": "ee0cb6dc-d059-30e1-a23f-a4d8ae40594d",
                        "source_sense_description": "economic stance",
                        "target_lang_word": "κεϋνσιανισμός",
