                "senses": [
                    {
                        "sense_id": "35ec3afd-be14-3102-b956-df1cc3bb2b41",
                        "entry_id": "bce012b8-afd7-3b81-ba28-fc9422eda934",
                        "glosses": [
                            "устар. походная металлическая фляжка с завинчивающейся крышкой в виде стакана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc585891-00cf-47f8-a409-4429183ee0ba",
                                "sense_id": "35ec3afd-be14-3102-b956-df1cc3bb2b41",
                                "text": "Все черно от дыма ― манерка, рогатки, на которых она висит, наши лица, руки."
                            },
                            {
                                "example_id": "e647bf24-0fa6-45f5-814e-8236e3526554",
                                "sense_id": "35ec3afd-be14-3102-b956-df1cc3bb2b41",
                                "text": "Перед ним была миска с кашей, манерка борща, каравай хлеба."
                            },
                            {
                                "example_id": "bd280973-0c0e-40a4-9e66-5217f6eec68a",
                                "sense_id": "35ec3afd-be14-3102-b956-df1cc3bb2b41",
                                "text": "В манерке, с бою захваченной на кухне, варится суп."
                            }
                        ]
                    },
                    {
                        "sense_id": "709a2119-37ce-3378-ac3f-c188a16627b1",
                        "entry_id": "bce012b8-afd7-3b81-ba28-fc9422eda934",
                        "glosses": [
                            "количество жидкости, вмещающееся в такую фляжку"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
