                            {
                                "target_word": "supporting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04f31520-8dcd-34a8-afe4-7a78ca39c1cc",
                                        "entry_id": "6408ff46-16b1-3c67-bd21-ecd0c4f0f267",
                                        "glosses": [
                                            "That which supports something else; a support."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "451d6544-d5bb-49b4-ad9a-0c87ac4ace87",
                                                "sense_id": "04f31520-8dcd-34a8-afe4-7a78ca39c1cc",
                                                "text": "But supposing that heaven had a Lord, then all included in its overspreadings and supportings, throughout the myriad of states, and within the four seas, would invariably be under the government of Heaven's Lord […]"
                                            },
                                            {
                                                "example_id": "7759c9c0-5106-4bb9-8831-6e235f7e6c95",
                                                "sense_id": "04f31520-8dcd-34a8-afe4-7a78ca39c1cc",
                                                "text": "[…] the pumps could he installed at once on the completion of the pump-house supportings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55c10393-8840-4b28-8bff-8050cf523085",
                        "source_entry_id": "8250d007-7a90-3c17-81c7-e2dc6c42c59f",
