    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d4f75a7-e427-3620-8fce-597c8bd4b8b1",
                    "sense_definition": "Don fait à Dieu, aux saints ou à une divinité dans le cadre d'un rite religieux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "culte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pèlerins déposent chaque matin une <w>offrande</w> de fleurs et de fruits devant l'autel du temple."
                        },
                        {
                            "text": "Pour remercier les dieux de la bonne récolte, les villageois préparent une <w>offrande</w> rituelle."
                        }
                    ],
                    "synonyms": [
                        "oblation",
                        "sacrifice"
                    ],
                    "common_phrases": [
                        "faire une offrande",
                        "offrande votive"
                    ]
                },
                {
                    "sense_id": "2de7ebaf-9753-3af8-b7bf-015fb835f1c9",
                    "sense_definition": "Présent ou don matériel offert avec dévouement ou générosité à une personne ou à une œuvre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "don",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'association caritative a reçu une généreuse <w>offrande</w> pour financer la rénovation du centre d'accueil."
                        },
                        {
                            "text": "Veuillez accepter cette modeste <w>offrande</w> en signe de notre profonde reconnaissance pour votre aide précieuse."
                        }
                    ],
                    "synonyms": [
                        "don",
                        "présent",
                        "cadeau"
                    ],
                    "common_phrases": [
                        "modeste offrande"
                    ]
                },
                {
                    "sense_id": "95eb4b7e-8f8b-3909-ae05-ea5535cc4a88",
                    "sense_definition": "Partie de la messe durant laquelle les fidèles s'avancent pour apporter leur don.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "culte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant le service religieux, toute l'assemblée s'est levée pour aller à l'<w>offrande</w>."
                        },
                        {
                            "text": "L'organiste jouait une douce mélodie pendant l'<w>offrande</w> à la fin de la cérémonie funéraire."
                        }
                    ],
                    "synonyms": [
                        "offertoire",
                        "quête"
                    ],
                    "common_phrases": [
                        "aller à l'offrande"
                    ]
                }
            ]
        }
    ]
}