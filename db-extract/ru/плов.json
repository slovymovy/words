                                                "sense_id": "edf9a2b6-5bf1-36f1-bd45-b4b7f718d123",
                                                "text": "Moim zdaniem, w tym pilawie jest za mało mięsa."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81d008f2-792c-4ef8-91fc-2f3f84e7eaa5",
                        "source_entry_id": "11d64c66-5665-3b23-bb5f-f8a81a050a4c",
