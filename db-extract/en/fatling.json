                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c34702a-3d02-4c07-9a09-ffb1dc2c9784",
                                "sense_id": "ed5c3c0c-f732-30ed-adde-5b2807d48e3d",
                                "text": "Lo I have prepared my dynner, myne oxen and my fatlinges are kylled, and all thinges are redy, come unto the mariage."
                            },
                            {
                                "example_id": "19674d40-f87f-441c-94fe-80b019b7703a",
                                "sense_id": "ed5c3c0c-f732-30ed-adde-5b2807d48e3d",
                                "text": "The wolf also shall dwell with the lamb, and the leopard shall lie down with the kid; and the calf and the young lion and the fatling together; and a little child shall lead them."
                            }
                        ]
                    }
