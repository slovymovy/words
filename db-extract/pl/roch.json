                                        "sense_id": "6e736541-3da6-307e-bf72-420eb494b328",
                                        "entry_id": "808299f4-db4d-31f4-bd5b-85a46903219c",
                                        "glosses": [
                                            "A placename",
                                            "A town in Oklahoma, United States."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
