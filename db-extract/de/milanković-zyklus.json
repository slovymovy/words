                "senses": [
                    {
                        "sense_id": "785b8b73-a92f-3d95-b641-3428ff9aeb26",
                        "entry_id": "302eb3f9-3be6-356f-bf07-9d570ee3d0b3",
                        "glosses": [
                            "Verlauf von über die jährliche Schwankungsbreite hinausgehenden langperiodischen Veränderungen der globalen Verteilung der auf der Erde eintreffenden Sonnenstrahlung"
                        ],
                        "tags": [
                            "Klimatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7a89f080-ca64-4563-9744-a9ed13e03904",
                                "sense_id": "785b8b73-a92f-3d95-b641-3428ff9aeb26",
                                "text": "„In der paläoklimatologischen Forschung werden die Milanković-Zyklen vielfach für Klimarekonstruktionen des Känozoikums herangezogen, wobei sie zum Beispiel vor 33,9 Millionen Jahren einen nachhaltigen Einfluss auf die Entstehung des antarktischen Eisschilds und den damit verbundenen Beginn des känozoischen Eiszeitalters ausübten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54fb917c-9e77-475f-9b77-73e69d58a1bf",
