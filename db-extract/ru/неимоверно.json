                        "examples": [
                            {
                                "example_id": "596200c0-f4f7-470f-9fe6-a6a9f3556c82",
                                "sense_id": "f834d7bc-ec11-38e5-b0ac-9ba85d6d7548",
                                "text": "Он хотел что-то сказать, пересиливал себя, но слова с языка не шли; только сердце билось неимоверно, как перед бедой."
                            },
                            {
                                "example_id": "26423b92-3b62-4cb5-9593-8136fb1f9898",
                                "sense_id": "f834d7bc-ec11-38e5-b0ac-9ba85d6d7548",
                                "text": "Все как-то неимоверно высоко задрали носы и подняли головы."
                            },
                            {
                                "example_id": "82520b0c-f646-4a09-9dc9-592301cb3eba",
                                "sense_id": "f834d7bc-ec11-38e5-b0ac-9ba85d6d7548",
                                "text": "О, в этих случаях преступник становится иногда неимоверно легкомыслен и легковерен."
                            }
                        ]
                    }
