                "word": "leeboard",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ee3a17bd-1156-420f-9177-754d253ddf10",
                        "entry_id": "43a26c18-acdd-3cfe-9a2b-e213ec2ab0f3",
