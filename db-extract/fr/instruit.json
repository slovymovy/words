                                            {
                                                "example_id": "72f13ea4-b0b1-49cf-a597-4aff93b55e4d",
                                                "sense_id": "2266a3d9-6a03-307e-bced-788a80a29076",
                                                "text": "An informed young man delivered a lecture on the history of modern art."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c67c08a-ede4-3bba-b770-5bca9732e12e",
                                        "entry_id": "fb5a47f1-66f8-3ed9-b96a-a4d571da0055",
                                        "glosses": [
                                            "Based on knowledge; founded on due understanding of a situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0004fe30-627d-41d4-91f0-d41ff0801f3a",
                                                "sense_id": "8c67c08a-ede4-3bba-b770-5bca9732e12e",
                                                "text": "Another informed and sobering estimate is that by 1800 indigenous populations in the western hemisphere were a tenth of what they had been three centuries before."
                                            }
