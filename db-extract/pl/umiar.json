                        "cross_references": [
                            {
                                "target_word": "moderation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "The state or quality of being moderate; avoidance of extremes"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e84038c-44ec-47a2-9498-458216a68410",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "...It regulates and governs the Passions of the Mind, and brings them into due moderation and frame..."
                                            },
                                            {
                                                "example_id": "cf777ed3-3f6a-4215-8e1e-a80ac10c3a07",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "Mr. Chairman, at this moment I stand astonished at my own moderation!"
                                            },
                                            {
                                                "example_id": "40214534-ff55-4198-a690-1a7a9bf298bf",
                                                "sense_id": "94184a9d-e523-3e18-b399-8d1c3df43fd7",
                                                "text": "America is a model of force and freedom and moderation - with all the coarseness and rudeness of its people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11042b05-a7f9-30bf-aaa5-2b2a147eb1f5",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "An instance of moderating: bringing something away from extremes, especially in a beneficial way"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5efccf78-2695-490f-b209-5367c2697431",
                                                "sense_id": "11042b05-a7f9-30bf-aaa5-2b2a147eb1f5",
                                                "text": "With the quick moderation of the weather some buying has appeared that had been held up because of the extremely cold weather […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c5b6379-0011-365e-b209-54d98c81ca0e",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "The process of moderating a discussion"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f2d0ca-9554-4a71-b60c-ee7bc00de59e",
                                                "sense_id": "2c5b6379-0011-365e-b209-54d98c81ca0e",
                                                "text": "The moderation of a large online forum can be hard work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4ad9a2e-3e3f-3967-b4a0-c1549114c8af",
                                        "entry_id": "c1d8eced-ca24-3fb1-840d-f27f9021cdcf",
                                        "glosses": [
                                            "Usage of neutron moderator to slow down neutrons in a nuclear reactor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4499e0e-be8a-4250-88b8-951ef023fc94",
                        "source_entry_id": "741e2744-f87d-3cdb-aedf-4cdadd1f3cef",
                        "source_sense_id": "8a2e0b23-6df1-3742-940e-6d80423142a0",
                        "target_lang_word": "restraint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restraint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "145cae07-bfbf-3cd2-8569-998b06cbac41",
                                        "entry_id": "5cf0e98c-1734-34ae-b35d-afeae4bbc89f",
                                        "glosses": [
                                            "something that restrains, ties, fastens or secures"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cacd8c7-0fbf-4ede-a9df-cf920783171b",
                                                "sense_id": "145cae07-bfbf-3cd2-8569-998b06cbac41",
                                                "text": "Make sure all the restraints are tight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b60abea8-4fa4-3fdc-baf3-453c6aac33d3",
                                        "entry_id": "5cf0e98c-1734-34ae-b35d-afeae4bbc89f",
                                        "glosses": [
                                            "control or caution; reserve"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deb98420-953a-47ea-84d0-d8d676785af2",
                                                "sense_id": "b60abea8-4fa4-3fdc-baf3-453c6aac33d3",
                                                "text": "Try to exercise restraint when talking to your boss."
                                            },
                                            {
                                                "example_id": "4a059509-711e-4628-9d54-771abebf00cd",
                                                "sense_id": "b60abea8-4fa4-3fdc-baf3-453c6aac33d3",
                                                "text": "City will feel nonplussed when they review the tape and Pellegrini had to summon all his restraint in the post-match interviews."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f4f2b23-1bef-4631-b900-d3b3fa2f3661",
                        "source_entry_id": "741e2744-f87d-3cdb-aedf-4cdadd1f3cef",
                        "source_sense_id": "8a2e0b23-6df1-3742-940e-6d80423142a0",
                        "target_lang_word": "Mäßigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mäßigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18eef75c-3df0-375d-92d0-445e9080a7f5",
                                        "entry_id": "1586fcb3-f54e-392b-a14b-e65121721351",
                                        "glosses": [
                                            "tugendhafte Eigenschaft Maß zu halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e43de43-7c3f-4d1d-8988-920f5f274989",
                                                "sense_id": "18eef75c-3df0-375d-92d0-445e9080a7f5",
                                                "text": "Gerade bei Staatsdienern mit Vorbildfunktion sollte Mäßigung eine Grundtugend sein."
                                            },
                                            {
                                                "example_id": "63aba6d6-f9c4-44bc-8e8b-539b0aec9eed",
                                                "sense_id": "18eef75c-3df0-375d-92d0-445e9080a7f5",
                                                "text": "„Die Idee der Mäßigung ist uralt.“"
                                            },
                                            {
                                                "example_id": "1310ad2f-ee81-4b68-b61a-90f66b93732a",
                                                "sense_id": "18eef75c-3df0-375d-92d0-445e9080a7f5",
                                                "text": "„Es war bei aller scheinbaren Mäßigung und dem hohen Anstande des Sprechenden eine gewisse Heftigkeit und Bitterkeit des Gefühls zu bemerken, dem man es ansah, daß es Mühe kostete, den verbissenen Ingrimm zurückzuhalten.“"
                                            },
                                            {
                                                "example_id": "5d46f4be-7273-497f-9bb5-a93fcd358551",
                                                "sense_id": "18eef75c-3df0-375d-92d0-445e9080a7f5",
                                                "text": "„Mäßigung ist der Anker des Lebens, sie verleiht uns Gleichgewicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e899ec9a-0545-431e-a201-067e1488c20f",
                        "source_entry_id": "741e2744-f87d-3cdb-aedf-4cdadd1f3cef",
                        "source_sense_id": "8a2e0b23-6df1-3742-940e-6d80423142a0",
                        "target_lang_word": "Zurückhaltung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zurückhaltung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad6dedc-b925-3c43-8ada-91e4a8d514dd",
                                        "entry_id": "61d60d3f-4729-32d6-91a8-2dbc35af52f2",
                                        "glosses": [
                                            "zurückhaltendes, nicht aufdringliches Verhalten, zurückhaltende Art"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8603f1f1-43e7-4899-b85c-d10699c0fb2c",
                                                "sense_id": "8ad6dedc-b925-3c43-8ada-91e4a8d514dd",
                                                "text": "Er sollte etwas Zurückhaltung üben."
                                            },
                                            {
                                                "example_id": "4f977495-bf50-4bdb-a53b-0311699b367e",
                                                "sense_id": "8ad6dedc-b925-3c43-8ada-91e4a8d514dd",
                                                "text": "„Unserer grundsätzlich kollektiven Diskretion entsprach Wotans individuelle Zurückhaltung, persönliche Gefühle zu äußern.“"
                                            },
                                            {
                                                "example_id": "d919e0af-b751-4b20-88cd-249951ccd9ae",
                                                "sense_id": "8ad6dedc-b925-3c43-8ada-91e4a8d514dd",
                                                "text": "„Unmittelbar darauf gingen die Generäle auseinander, mit jener feierlichen und wortkargen Zurückhaltung, mit der man nach einer Beerdigung auseinandergeht.“"
                                            },
                                            {
                                                "example_id": "83dde033-d473-43d8-87a1-d3161ddb72ef",
                                                "sense_id": "8ad6dedc-b925-3c43-8ada-91e4a8d514dd",
                                                "text": "„Sie machte mir Geständnisse, die sie für unmißverständlich hielt und die doch voll hinreißender Zurückhaltung waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e760c7a-008d-37cf-9e5d-38f4c43f711b",
                                        "entry_id": "61d60d3f-4729-32d6-91a8-2dbc35af52f2",
                                        "glosses": [
                                            "abwartendes, zögerndes, vorsichtiges Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62dd7b70-550b-4ec6-8e7d-865b9e249380",
                                                "sense_id": "4e760c7a-008d-37cf-9e5d-38f4c43f711b",
                                                "text": "Mit äußerster Zurückhaltung begleitete er seine Arbeit."
                                            },
                                            {
                                                "example_id": "85ef375e-4ea4-4373-a83a-264590717ba7",
                                                "sense_id": "4e760c7a-008d-37cf-9e5d-38f4c43f711b",
                                                "text": "„Diplomatische Zurückhaltung ist also nicht mehr vonnöten.“"
                                            },
                                            {
                                                "example_id": "f4218df1-57e5-4a43-8c80-18600cc5f70d",
                                                "sense_id": "4e760c7a-008d-37cf-9e5d-38f4c43f711b",
                                                "text": "„Bitten um Zurückhaltung auf der Bühne könnten da leicht nach hinten losgehen.“"
                                            },
                                            {
                                                "example_id": "3de46d27-4163-442f-8423-defda43d4ba6",
                                                "sense_id": "4e760c7a-008d-37cf-9e5d-38f4c43f711b",
                                                "text": "„Meine Antwort schien ihm zu gefallen, denn er gab seine Zurückhaltung schnell auf.“"
                                            },
                                            {
                                                "example_id": "d20c688e-5b60-4518-8650-0c0e38538ead",
                                                "sense_id": "4e760c7a-008d-37cf-9e5d-38f4c43f711b",
                                                "text": "„Jüngers Widerstand gegen die hier als Sadisten gesehenen nationalsozialistischen Machthaber geschieht höchst verklausuliert, wobei sich der Eindruck aufdrängt, dass es weniger Sorge um die eigene Person ist, die Jüngers Zurückhaltung veranlasst, sondern tiefe Verachtung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
