                "senses": [
                    {
                        "sense_id": "c547aea1-2eff-3492-be74-1e01ffb62049",
                        "entry_id": "9d8deecb-6b00-3949-9190-ef264c2951f5",
                        "glosses": [
                            "Sorte de bière légère, en vogue en France, dans la deuxième moitié du XXᵉ siècle."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5bf300df-d984-4e21-b5f5-37c0eef00c93",
                                "sense_id": "c547aea1-2eff-3492-be74-1e01ffb62049",
                                "text": "Fort de sa taille nouvelle, Sylvain but de la bière, une Valstar ultralégère en bouteille d'un litre. Il la but en cachette de la première à la dernière goutte."
                            },
                            {
                                "example_id": "8b4d9162-7679-4fed-a8ca-f369b47b51dd",
                                "sense_id": "c547aea1-2eff-3492-be74-1e01ffb62049",
                                "text": "On fonçait vers Dieppe en buvant de la Valstar rouge. On arrivait à six heures sur le port, on entrait dans le premier troquet et on commandait du Picon-bière."
                            }
                        ]
                    },
                    {
                        "sense_id": "f99d9a4b-edd2-38c3-97df-2753455dbf14",
                        "entry_id": "9d8deecb-6b00-3949-9190-ef264c2951f5",
                        "glosses": [
                            "Bouteille de cette bière."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4a1a57d2-5eb4-4668-ae07-6ffc3d4c15f3",
                                "sense_id": "f99d9a4b-edd2-38c3-97df-2753455dbf14",
                                "text": "Avant d'éventrer le troisième paquet, à quatre pattes devant son frigo, il attrapa un pot de rillettes et une Valstar. Puis, décapsulant sa bière, il se radoucit : […]."
                            },
                            {
                                "example_id": "4a085ed0-345e-460c-bb27-00ac0960e781",
                                "sense_id": "f99d9a4b-edd2-38c3-97df-2753455dbf14",
                                "text": "N'oublie pas de remonter les légumes à Musil... Et surtout, prends une ou deux Valstar pour moi."
                            },
                            {
                                "example_id": "6a7923b8-2ecb-46b7-a9be-0ecd84f59d09",
                                "sense_id": "f99d9a4b-edd2-38c3-97df-2753455dbf14",
                                "text": "L'immeuble se trouvait juste derrière le supermarché où d'habitude nous achetions des Valstars, les bières des bons départs, du chocolat ou des gâteaux; […]."
                            }
                        ]
                    }
