{
    "word_family": [
        "fancy",
        "fancifulness",
        "fancifully"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b1ab1680-c759-3e78-b72d-035fc7c67d9f",
                    "sense_definition": "Existing only in the imagination; unrealistic, fantastic, or not based on practical reality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "imagination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>fanciful</w> to suppose that he could get hired without any prior experience.",
                            "target_lang_translations": {
                                "ru": "Было <w>наивно</w> полагать, что его наймут без какого-либо предыдущего опыта."
                            }
                        },
                        {
                            "text": "The author created a <w>fanciful</w> world full of talking animals and floating cities.",
                            "target_lang_translations": {
                                "ru": "Автор создал <w>причудливый</w> мир, полный говорящих животных и парящих городов."
                            }
                        }
                    ],
                    "synonyms": [
                        "imaginative",
                        "fantastic",
                        "whimsical",
                        "unrealistic"
                    ],
                    "antonyms": [
                        "realistic",
                        "practical"
                    ],
                    "common_phrases": [
                        "fanciful notions",
                        "fanciful ideas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий лишь в воображении; нереалистичный, фантастический или оторванный от реальности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причудливый",
                                "target_lang_sense_clarification": "необычный, фантастический или затейливый"
                            },
                            {
                                "target_lang_word": "нереалистичный",
                                "target_lang_sense_clarification": "непрактичный, оторванный от реальности"
                            },
                            {
                                "target_lang_word": "фантастический",
                                "target_lang_sense_clarification": "сказочный, рожденный воображением"
                            },
                            {
                                "target_lang_word": "прихотливый",
                                "target_lang_sense_clarification": "затейливый, причудливой формы или характера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03f958bc-2ed9-363a-9023-fd4e19f7729c",
                    "sense_definition": "Unreal, illusory, or existing solely in the mind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "imagination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dismissed the ghost stories as mere <w>fanciful</w> tales invented by the villagers.",
                            "target_lang_translations": {
                                "ru": "Он отмахнулся от историй о призраках, сочтя их просто <w>вымышленными</w> сказками, придуманными жителями деревни."
                            }
                        },
                        {
                            "text": "Her fears proved to be entirely <w>fanciful</w> once the facts were revealed.",
                            "target_lang_translations": {
                                "ru": "Её страхи оказались совершенно <w>надуманными</w>, как только открылись факты."
                            }
                        }
                    ],
                    "synonyms": [
                        "imagined",
                        "illusory",
                        "fictitious"
                    ],
                    "antonyms": [
                        "real",
                        "actual"
                    ],
                    "common_phrases": [
                        "fanciful stories",
                        "fanciful tales"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нереальный, иллюзорный или являющийся чистым вымыслом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымышленный",
                                "target_lang_sense_clarification": "сочиненный, не имеющий отношения к фактам"
                            },
                            {
                                "target_lang_word": "надуманный",
                                "target_lang_sense_clarification": "беспочвенный, созданный только в мыслях"
                            },
                            {
                                "target_lang_word": "иллюзорный",
                                "target_lang_sense_clarification": "обманчивый, кажущийся"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}