            "senses": [
                {
                    "sense_id": "64d206b7-ebe4-38c7-8a4a-47f7b099e0d5",
                    "sense_definition": "A stupid or foolish person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stupid_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dumbass</w> walked off with my car keys and left me hers.",
                            "target_lang_translations": {
                                "cs": "Ten <w>blbec</w> odešel s mými klíči od auta a nechal mi ty svoje."
                            }
                        },
                        {
                            "text": "Do not listen to that <w>dumbass</w> because he has no idea what he is talking about.",
                            "target_lang_translations": {
                                "cs": "Neposlouchej toho <w>blbce</w>, protože nemá ani tušení, o čem mluví."
                            }
                        }
                    ],
                    "synonyms": [
                        "idiot",
                        "fool",
                        "moron"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Highly informal and offensive."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hloupý nebo nerozumný člověk (velmi neformální a urážlivé)."
                    },
                    "translations": {
