    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3a198883-9e66-3164-b708-ed8bdb7560b5",
                "word": "rearguard",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fc63b6b9-40ff-4ead-911d-0ea9973ec437",
                        "entry_id": "3a198883-9e66-3164-b708-ed8bdb7560b5",
                        "tags": [
                            "plural"
                        ],
                        "form": "rearguards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c49b4a69-a147-34b3-93af-6b4efa7196cc",
                        "entry_id": "3a198883-9e66-3164-b708-ed8bdb7560b5",
                        "glosses": [
                            "The rearmost part of a force, especially a detachment of troops that protect the rear of a retreating force."
                        ],
                        "tags": [
                            "attributive",
                            "often"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fbaa7f66-4dda-35ae-885e-2f48283d596f",
                        "entry_id": "3a198883-9e66-3164-b708-ed8bdb7560b5",
                        "glosses": [
                            "The defence, collectively the defenders."
                        ],
                        "tags": [
                            "attributive",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "d2597757-b602-42f0-933d-a3e71a5cc29a",
                                "sense_id": "fbaa7f66-4dda-35ae-885e-2f48283d596f",
                                "text": "Mancini's side only showed enough ambition when it was too late and by then battle lines were drawn as James Collins and former City captain Richard Dunne fought a magnificent rearguard action at the heart of Villa's defence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8abcf069-4e04-41b7-84eb-0d9e19136eb0",
                        "source_entry_id": "3a198883-9e66-3164-b708-ed8bdb7560b5",
                        "source_sense_description": "the rearmost part of a force",
                        "target_lang_word": "achterhoede",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achterhoede",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b5c494b8-ab23-34e2-aff3-f2d122ac7074",
                                        "entry_id": "8ac58b3f-2113-38f8-abec-e3480ff13def",
                                        "glosses": [
                                            "de posities op het speelveld het dichtste bij het eigen doel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa60b701-6de1-4a8a-a7b4-cd11a63ba4b2",
                                                "sense_id": "b5c494b8-ab23-34e2-aff3-f2d122ac7074",
                                                "text": "Als kleine jongen speelde ik altijd in de achterhoede."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aad06c82-3c31-3ec1-93f7-a00f7e3a0845",
                                        "entry_id": "8ac58b3f-2113-38f8-abec-e3480ff13def",
                                        "glosses": [
                                            "de laatsten van een groep"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b92138-4cf8-4ac7-a7d5-315a17f5d14c",
                                                "sense_id": "aad06c82-3c31-3ec1-93f7-a00f7e3a0845",
                                                "text": "Vaak moesten we meer dan een uur wachten op So it Goes, die zich niet goed voelde en steeds langzamer ging lopen. Barbie bleef altijd trouw bij haar, terwijl de anderen vooruitliepen om de weg te verkennen. Bij elke splitsing wachtten we op de achterhoede."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f998265f-1023-4c00-ba5b-46b3349e777a",
                        "source_entry_id": "3a198883-9e66-3164-b708-ed8bdb7560b5",
                        "source_sense_description": "the rearmost part of a force",
                        "target_lang_word": "arrière-garde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrière-garde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b866e298-81e2-3fe4-9088-3847fc93f876",
                                        "entry_id": "766fdeba-0db1-39f2-bdee-73bc75be364f",
                                        "glosses": [
                                            "Partie d’une armée, d’un corps de troupes qui marche la dernière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26415df7-e917-4e7b-b156-e83dcb269a85",
                                                "sense_id": "b866e298-81e2-3fe4-9088-3847fc93f876",
                                                "text": "Les chasseurs marchaient donc tranquillement le fusil en travers de la selle, accompagnés de leurs rastreros, à la suite des Comanches qui étaient loin de supposer qu’ils avaient une telle arrière-garde."
                                            },
                                            {
                                                "example_id": "9b4b8883-7f90-4e90-93bb-414a7ac14b0a",
                                                "sense_id": "b866e298-81e2-3fe4-9088-3847fc93f876",
                                                "text": "Fin février est très beau et le 2 mars nous quittons le cantonnement de Marquigny. Nous marchons en arrière-garde du bataillon et, par Louvergny, La Cassine, nous arrivons à l'étape à midi à Chémery-sur-Bar."
                                            },
                                            {
                                                "example_id": "fe4c2919-38b7-4e5b-84fc-b1b224fe66af",
                                                "sense_id": "b866e298-81e2-3fe4-9088-3847fc93f876",
                                                "text": "Mais sa marche était lente et inégale ; poursuivie par l’ennemi, dont les bâtiments légers la harcelaient, elle vit son arrière-garde coupée le 21 juillet."
                                            },
                                            {
                                                "example_id": "f4d96419-a1ec-4862-85ba-3588e50016dc",
                                                "sense_id": "b866e298-81e2-3fe4-9088-3847fc93f876",
                                                "text": "Les canons qui avaient réussi à gravir la pente furent acheminés vers l’arrière-garde. De là, leur précision se révéla diabolique. Un énième tir de barrage frôla les képis des colonnes d’assaillants allongés sur le sol, des boulets allaient heurter les barricades avec violence et affleuraient le sommet des monticules, empêchant les embusqués de pouvoir se relever pour répliquer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24f47b2e-274c-32da-8773-423961dbd9c7",
                                        "entry_id": "766fdeba-0db1-39f2-bdee-73bc75be364f",
                                        "glosses": [
                                            "Personnes les plus attachées à une idée, généralement les pionniers, lorsque cette idée n’est plus considérée comme nouvelle. Dans un sens péjoratif, souligne leur côté trop conservateur, voire l’obsolescence de leurs convictions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0079d16-a81a-405a-8382-67b9dc978aba",
                                                "sense_id": "24f47b2e-274c-32da-8773-423961dbd9c7",
                                                "text": "L’arrière-garde d’un mouvement politique ou culturel."
                                            },
                                            {
                                                "example_id": "379dad46-46e8-4a09-8dd8-d1ecbb9f4552",
                                                "sense_id": "24f47b2e-274c-32da-8773-423961dbd9c7",
                                                "text": "Dans l'esprit des non-spécialistes (et parfois de quelques scientifiques d'arrière-garde), la primatologie était alors considérée comme une sorte de loisir de femmes farfelues et misanthropes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f41b627-f82a-36d4-b588-53c5eb211f00",
                                        "entry_id": "766fdeba-0db1-39f2-bdee-73bc75be364f",
                                        "glosses": [
                                            "Arrière-plan, réserve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b10e334-d76c-4522-af84-16cf4b1b3cb1",
                                                "sense_id": "9f41b627-f82a-36d4-b588-53c5eb211f00",
                                                "text": "Tout ce qu’elle avait perdu, elle n’aurait qu’à lever un doigt pour le retrouver. C’est cette pensée d’arrière-garde qui lui donnait du courage et lui faisait dire : « Je ne regrette rien. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac3fecdf-98a9-4e1b-bbd9-c00495e501e4",
                        "source_entry_id": "3a198883-9e66-3164-b708-ed8bdb7560b5",
                        "source_sense_description": "the rearmost part of a force",
                        "target_lang_word": "Nachhut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachhut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a50743e5-1baa-3997-a38b-35f6ca914d7a",
                                        "entry_id": "a5e4e615-525f-3493-b9c3-627166aa1e97",
                                        "glosses": [
                                            "Truppenteil, der am Ende einer Marschkolonne Deckung gibt oder zur Sicherung in der ursprünglichen Stellung zurückbleibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e998e1dd-8bf5-4297-8b78-15f5f4cd4ac0",
                                                "sense_id": "a50743e5-1baa-3997-a38b-35f6ca914d7a",
                                                "text": "Eine starke Nachhut sollte ausgeschieden werden um die Truppen gegen Osten zu decken."
                                            },
                                            {
                                                "example_id": "08cf032f-8d03-432f-8bd9-c4442365ffce",
                                                "sense_id": "a50743e5-1baa-3997-a38b-35f6ca914d7a",
                                                "text": "Je mehr militärische Dienste von Staatsdienern erledigt wurden, desto weniger Platz blieb für Söldner an der Front und in der Nachhut."
                                            },
                                            {
                                                "example_id": "beaaf75b-eeb0-4128-9887-680158a510a9",
                                                "sense_id": "a50743e5-1baa-3997-a38b-35f6ca914d7a",
                                                "text": "Vorsichtig hatte er auch diesmal eine Nachhut in seinem Rücken aufgestellt: aber diese ward nun sein Verderben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dc3e4404-f3ac-31f8-adcd-a4108137da3b",
                                        "entry_id": "a5e4e615-525f-3493-b9c3-627166aa1e97",
                                        "glosses": [
                                            "jemand, der sich hinter einer Gruppe in Bewegung befindet"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e7354b4-6250-46c0-b877-7c05818a5613",
                                                "sense_id": "dc3e4404-f3ac-31f8-adcd-a4108137da3b",
                                                "text": "Sie schlugen den Rat erfahrener Bergführer in den Wind, zwar zügig voranzuschreiten, die Nachhut aber nicht aus dem Auge zu verlieren."
                                            },
                                            {
                                                "example_id": "f369babc-a171-436f-9927-5ad473dc6bdf",
                                                "sense_id": "dc3e4404-f3ac-31f8-adcd-a4108137da3b",
                                                "text": "Bis dahin aber wirst du in unserem Zuge aber die Nachhut bilden, denn wenigstens während der nächsten acht Tage darfst du uns nicht sehr nahe kommen."
                                            },
                                            {
                                                "example_id": "b8b262c9-9f63-4715-82ee-0f2b2ef276a5",
                                                "sense_id": "dc3e4404-f3ac-31f8-adcd-a4108137da3b",
                                                "text": "Schalmeien schrillen, uniformierte Kinder machen ernste Gesichter, ein paar Jugendliche folgen ohne Instrumente, als Nachhut."
                                            },
                                            {
                                                "example_id": "050d535d-a6dd-4039-a8eb-6f08bd4844f8",
                                                "sense_id": "dc3e4404-f3ac-31f8-adcd-a4108137da3b",
                                                "text": "„Hamann bildet die Nachhut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c3b3a8a-f40a-36f6-8052-aeacd161a520",
                                        "entry_id": "a5e4e615-525f-3493-b9c3-627166aa1e97",
                                        "glosses": [
                                            "jemand, der einer Entwicklung hinterherläuft oder hinter ihr zurückbleibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d9bb5e2-d79f-4540-85f0-67cc1b913334",
                                                "sense_id": "9c3b3a8a-f40a-36f6-8052-aeacd161a520",
                                                "text": "Aber siehe da: Die einstige Avantgarde, durch die Mühlen der Zeit zur ästhetischen Nachhut verkommen, wirkt heute fast schon wieder originell."
                                            },
                                            {
                                                "example_id": "95de6c96-4828-42ae-b0c0-62f791c62b8c",
                                                "sense_id": "9c3b3a8a-f40a-36f6-8052-aeacd161a520",
                                                "text": "Sind Journalisten denn die obrigkeitliche Nachhut liberaler Gesellschaften?"
                                            },
                                            {
                                                "example_id": "c3fcb157-da7e-4b6b-b0a4-7f91dc46b9ce",
                                                "sense_id": "9c3b3a8a-f40a-36f6-8052-aeacd161a520",
                                                "text": "Dort, wo angeblich die geistige Avantgarde ihren Sitz hat, bewegen sich offensichtlich auch Vertreter der geistigen Nachhut."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
