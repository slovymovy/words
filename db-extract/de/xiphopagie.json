                ],
                "senses": [
                    {
                        "sense_id": "d1b8d1bd-cae9-3c23-b8ec-323a8ff77da3",
                        "entry_id": "4527ffde-8629-3b0f-a77a-d3d2417aec49",
                        "glosses": [
                            "Fehlbildung siamesischer Zwillinge, die am Schwertfortsatz des Brustbeines aneinandergewachsen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a937acda-96cd-4359-ba60-f551dd6d2648",
                                "sense_id": "d1b8d1bd-cae9-3c23-b8ec-323a8ff77da3",
                                "text": "„Die Grenze der Verwachsung nach aufwärts kann verschieden sein, so dass die Xiphopagie und Sternopagie in einander übergehen.“"
                            },
                            {
                                "example_id": "818cf5e7-aaf9-401d-8704-1a835d80a348",
                                "sense_id": "d1b8d1bd-cae9-3c23-b8ec-323a8ff77da3",
                                "text": "„Foerster rechnet zur Xiphopagie auch diejenigen Fälle, bei welchen die Verwachsung sich auch auf den unteren Theil (sic) des Sternum erstreckt.“"
                            },
                            {
                                "example_id": "41446720-cc6c-433f-9109-e9e30268263a",
                                "sense_id": "d1b8d1bd-cae9-3c23-b8ec-323a8ff77da3",
                                "text": "„In mehreren arabischen Handschriften der Gothaer Bibliothek findet sich die Erzählung eines alten Falles von Xiphopagie, welcher mit dem Falle der siamesischen Zwillinge eine überraschende Aehnlichkeit darbietet…“"
                            },
                            {
                                "example_id": "be3a5549-6ad6-4f59-a55c-1c4fc7ef1e83",
                                "sense_id": "d1b8d1bd-cae9-3c23-b8ec-323a8ff77da3",
                                "text": "„Diese Abbildung erläutert auf das Schönste gerade jene Art der Verwachsung, für welche Geoffroy Saint-Hilaire den Namen der Xiphopagie eingeführt hat.“"
                            },
                            {
                                "example_id": "28a462a1-3c01-4837-97f5-d82cb2e91d49",
                                "sense_id": "d1b8d1bd-cae9-3c23-b8ec-323a8ff77da3",
                                "text": "„Das seltene Vorkommen eines doppelten Nabels und einer im Anfangsteil doppelten Nabelschnur bei Xiphopagie (…) würde sich so erklären, daß (sic) die Abschnürung der beiden Därme vom Dottersack nicht wie gewöhnlich innerhalb, sondern außerhalb der Bauchhöhle stattgefunden hat.“"
                            },
                            {
                                "example_id": "5d0fee39-0dc8-402d-8c6e-bbf47100c395",
                                "sense_id": "d1b8d1bd-cae9-3c23-b8ec-323a8ff77da3",
                                "text": "„Dr. Böhm in Gunzenhausen berichtet über einen Fall von verwachsenen Zwillingsfrüchten (Xiphopagie), welche glücklich durch die Operation getrennt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
