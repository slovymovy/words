                "senses": [
                    {
                        "sense_id": "5a63a03e-53c1-3ce5-9174-b4c50494132f",
                        "entry_id": "f62694da-c353-3376-bd18-99ff57909f9f",
                        "glosses": [
                            "iemand die het beheer heeft over de kas en de kaswijzigingen bijhoudt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "b4c00ce8-e588-4325-8ae1-e5b4959e49b6",
                                "sense_id": "5a63a03e-53c1-3ce5-9174-b4c50494132f",
                                "text": "De kassier zette zonder pardon het bordje \"gesloten\" voor mijn neus en ging naar huis."
                            },
                            {
                                "example_id": "69f97c1b-b6e2-4c1a-bde2-8f6fb565bb87",
                                "sense_id": "5a63a03e-53c1-3ce5-9174-b4c50494132f",
                                "text": "Hij praatte niet veel, hij kon goed uit de voeten met cijfers. Vóór de oorlog was hij kassier in een filiaal van de Banque de l'Union parisienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0242ff8b-5950-4cea-a5e7-783c781628aa",
                        "source_entry_id": "f62694da-c353-3376-bd18-99ff57909f9f",
                        "source_sense_id": "5a63a03e-53c1-3ce5-9174-b4c50494132f",
                        "source_sense_description": "iemand die het beheer heeft over de kas en de mutaties ervan bijhoudt",
                        "target_lang_word": "Kassierer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kassierer",
