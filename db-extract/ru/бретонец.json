                    },
                    {
                        "translation_id": "e3a442c5-7cec-4636-a84a-122a5130c07e",
                        "source_entry_id": "0fa9eb75-2074-3d56-95a0-c51c98eaf470",
                        "source_sense_id": "98df95c0-2470-37be-adc5-a432347ab40f",
                        "target_lang_word": "Bretone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bretone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f5bb41a-8304-38e5-991a-4fc69082515c",
                                        "entry_id": "cb3ebf49-2538-3c48-9150-c97f606f0c10",
                                        "glosses": [
                                            "Bewohner der Bretagne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9397930c-2849-46a9-8581-cbfd6a52e338",
                                                "sense_id": "5f5bb41a-8304-38e5-991a-4fc69082515c",
                                                "text": "„Ein Bretone kehrt in seine Heimatstadt zurück, nachdem ihm so einiges im Leben schief geraten war.“"
                                            },
                                            {
                                                "example_id": "763a762d-8d3c-436d-b246-2f345f80f3c9",
                                                "sense_id": "5f5bb41a-8304-38e5-991a-4fc69082515c",
                                                "text": "„Ein alter Bretone mit dem breitkrempigen Hut, wie ihn nur noch sehr alte Leute tragen, geht staksig zwischen den Grbäbern hin, den Blick auf den Boden gerichtet, als suche er etwas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "305ed322-74e7-3177-89e6-a3d3b7cc2ab6",
                                        "entry_id": "cb3ebf49-2538-3c48-9150-c97f606f0c10",
                                        "glosses": [
                                            "Angehöriger einer keltischen Minderheit im Nordwesten Frankreichs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "929e2e6d-76cb-4fc1-9b34-2671fc2a598e",
                                                "sense_id": "305ed322-74e7-3177-89e6-a3d3b7cc2ab6",
                                                "text": "„Nur 257 000 Erwachsene (12 % der Bretonen) sprechen gelegentlich Bretonisch. Drei Viertel der Sprecher sind über 50.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "337b5256-1f59-32e0-9b25-c066029ea8b2",
                                        "entry_id": "cb3ebf49-2538-3c48-9150-c97f606f0c10",
                                        "glosses": [
                                            "Pferderasse, die aus der Bretagne stammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aefa1756-7bde-43cb-9567-c721e1992307",
                                                "sense_id": "337b5256-1f59-32e0-9b25-c066029ea8b2",
                                                "text": "„Der Bretone ist ein Kaltblut-Pferd mit Ursprung in Frankreich. Der Bretone stammt aus dem französischem Zuchtgebiet Bretagne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b1cbe93-9dd5-4d50-9638-aabd14ea4cd0",
                        "source_entry_id": "0fa9eb75-2074-3d56-95a0-c51c98eaf470",
                        "source_sense_id": "98df95c0-2470-37be-adc5-a432347ab40f",
                        "target_lang_word": "Breton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Breton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cff9acb-ed73-355a-abc9-6b7cdc0830e0",
                                        "entry_id": "72f098b7-1d79-3e77-b3a7-35f1b464ee9a",
                                        "glosses": [
                                            "Habitant celte de ce qui est aujourd'hui la Grande-Bretagne, avant les invasions angles et saxonnes."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97837aa3-d26d-4315-9ca8-a237a524ce22",
                                                "sense_id": "8cff9acb-ed73-355a-abc9-6b7cdc0830e0",
                                                "text": "Shrewsbury, capitale du comté, a deux beaux ponts sur la Severn. C'est une ville dont la construction est due aux Bretons qui la bâtirent sur l'emplacement d'une seconde cité d’Uriconium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72aba3a7-6133-3d6e-b84f-7d8c63f158a2",
                                        "entry_id": "72f098b7-1d79-3e77-b3a7-35f1b464ee9a",
                                        "glosses": [
                                            "Habitant ou originaire de la Bretagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ef70e45-fefa-4a77-a213-931773be525d",
                                                "sense_id": "72aba3a7-6133-3d6e-b84f-7d8c63f158a2",
                                                "text": "Ah ! c’était bien cette veste carrée à petites basques brusquement coupées et dont les poches ballottent à la chute des reins, la veste de drap bleu classique en Bretagne, le gilet de rouennerie grossière, la chemise de toile fermée par un cœur d’or, le grand col roulé, les boucles d’oreilles, les gros souliers, le pantalon de toile bleue écrue, inégalement déteinte par longueurs de fil, enfin toutes ces choses humbles et fortes qui constituent le costume d’un pauvre Breton."
                                            },
                                            {
                                                "example_id": "738f9038-8974-46d9-8078-93ab6cf47a1c",
                                                "sense_id": "72aba3a7-6133-3d6e-b84f-7d8c63f158a2",
                                                "text": "Mais depuis quelques instants, elle qui joignait à ses souffrances corporelles les souffrances de la nostalgie bretonne, maladie morale si connue que les colonels y ont égard pour les Bretons qui se trouvent dans leurs régiments, elle aimait Provins !"
                                            },
                                            {
                                                "example_id": "8f137c78-a789-4daa-afc1-83e016486a94",
                                                "sense_id": "72aba3a7-6133-3d6e-b84f-7d8c63f158a2",
                                                "text": "Un Gascon, sans que je le susse, jouait en moi des tours incroyables au Breton et lui faisait des mines de singe..."
                                            },
                                            {
                                                "example_id": "38d95d44-fb80-4566-9f29-b38bb0290c1b",
                                                "sense_id": "72aba3a7-6133-3d6e-b84f-7d8c63f158a2",
                                                "text": "Depuis longtemps ont disparu les convois de moissonneurs qui faux en main, remontaient les plaines de Russie du Sud au Nord, récoltant au passage les céréales d’Igor Karénine, ou ceux des Bretons moissonnant dans l’Île-de-France."
                                            },
                                            {
                                                "example_id": "69417c56-ba63-43b4-96ba-cc3fd7a88f11",
                                                "sense_id": "72aba3a7-6133-3d6e-b84f-7d8c63f158a2",
                                                "text": "Il aimait qu’Odette fût ainsi, de même que s’il avait été épris d’une Bretonne, il aurait été heureux de la voir en coiffe et de lui entendre dire qu’elle croyait aux revenants."
                                            },
                                            {
                                                "example_id": "eb700769-ff43-48b5-951f-b859c8398743",
                                                "sense_id": "72aba3a7-6133-3d6e-b84f-7d8c63f158a2",
                                                "text": "J’admire que, depuis saint Patrick, les survivances ne fussent pas mortes de telles vieilles fables druidiques. Ainsi, en France, les plus catholiques des Bretons évoquent encore, à la veillée, des superstitions de l’époque de Judicaël !…"
                                            },
                                            {
                                                "example_id": "bba30aaa-ba36-45bb-a8ba-40f608a7dd62",
                                                "sense_id": "72aba3a7-6133-3d6e-b84f-7d8c63f158a2",
                                                "text": "Les Bretons, ces émigrants celtiques venus de Grande-Bretagne au Vᵉ siècle de notre ère, avaient ramené en Armorique une langue très analogue à ce parler gaulois que d’ailleurs employait encore à cette époque, la population d’Auvergne."
                                            },
                                            {
                                                "example_id": "b5141fcf-0924-4697-8da9-4f4254d2939e",
                                                "sense_id": "72aba3a7-6133-3d6e-b84f-7d8c63f158a2",
                                                "text": "Il ne saurait être question en Bretagne d'un État impérialiste au point de galliciser les Bretonnants pas plus que celtiser linguistiquement les Bretons Gallots."
                                            },
                                            {
                                                "example_id": "d50fc455-127f-42f0-b171-f3b58f58a580",
                                                "sense_id": "72aba3a7-6133-3d6e-b84f-7d8c63f158a2",
                                                "text": "« Sylphide, taciturne sont des mots rares pour ton âge. Tu aurais pu dire des femmes à la taille fine, tout le monde aurait compris. Quant à taciturne comme un Breton, je crois que tu exagères un peu. Bien sûr, les Bretons ne sont pas exubérants comme les Marseillais, mais de là à dire qu’ils sont taciturnes, je ne le crois pas. Je suis breton et j’aime la gaieté. D’où tiens-tu cela ? »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71390927-ec8f-339a-8767-8e27219a4a4b",
