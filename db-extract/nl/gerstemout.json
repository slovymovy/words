                        "examples": [
                            {
                                "example_id": "6633eb03-a71c-41f2-a627-9b0e02fd82c9",
                                "sense_id": "41d10624-fc46-32a6-9f9e-29b4f3996183",
                                "text": "\"Gerstemout is niet heel duur per biertje. Maar als we het over alle biertjes bekijken, is het een forse kostenpost\", zegt graanhandelaar Robin Appel tegen NU.nl."
                            },
                            {
                                "example_id": "47abb7d5-7cfc-4b91-b4f6-db0a42825555",
                                "sense_id": "41d10624-fc46-32a6-9f9e-29b4f3996183",
                                "text": "De allergenen tarwe, gerstemout en melk staan niet op de verpakking vermeld. Bij mensen met een allergie voor deze ingrediënten kan het eten van dit product mogelijk leiden tot klachten. Mensen zonder allergie voor een van deze allergenen kunnen het product gewoon consumeren, zegt Dirk."
                            },
                            {
                                "example_id": "7b689386-6c7c-496f-bbdf-22e1e5db128a",
                                "sense_id": "41d10624-fc46-32a6-9f9e-29b4f3996183",
                                "text": "Naar schatting 1 op de 300 Belgen zou geen gluten verdragen, eiwitten die voorkomen in de meeste graansoorten. Mongozo (niet te verwarren met het Afrikaanse bier) is gebrouwen met gerstemout dat gluten bevat, maar de gluten worden tijdens het brouwproces afgebroken."
                            }
                        ]
