                    {
                        "sense_id": "7e9ca65c-f8fc-39c5-b293-a61017647b27",
                        "entry_id": "48d7b6ae-30fb-32d2-a209-cd61a55fbbe6",
                        "glosses": [
                            "The act by which something is tipped or inclined."
