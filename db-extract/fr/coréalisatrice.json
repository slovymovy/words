                "senses": [
                    {
                        "sense_id": "dce44e31-579b-37f1-9f22-34f1cd276271",
                        "entry_id": "39d20a25-6ab9-3ae5-9dd5-d44d473208e0",
                        "glosses": [
                            "Celle qui est chargée de la réalisation d’un film, en collaboration avec quelqu’un d’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d143686-0890-4c7c-ab0f-b37ad4f2744e",
                                "sense_id": "dce44e31-579b-37f1-9f22-34f1cd276271",
                                "text": "À 17 ans, j’ai rencontré une personne qui réalisait, au même âge, qu’elle était en situation d’intersexuation, racontait Yaël Langmann, la créatrice, scénariste et coréalisatrice de Chair tendre, lors d’un entretien à Séries Mania."
                            },
                            {
                                "example_id": "04135c3f-f2a0-484f-91a5-a797f56b9ded",
                                "sense_id": "dce44e31-579b-37f1-9f22-34f1cd276271",
                                "text": "On [avec le coréalisateur, Anthony Marciano] avait envie de montrer une famille, singulière, mais qui ressemble à toutes les autres familles aussi, hyperfédératrice, détaille Mehla Bedia, coréalisatrice et protagoniste du film Forte, sorti en 2020 sur Amazon Prime Video."
                            },
                            {
                                "example_id": "f0e9dc33-8399-468f-ac75-76c267230b89",
                                "sense_id": "dce44e31-579b-37f1-9f22-34f1cd276271",
                                "text": "« Elle dégage une lumière intense et possède un instinct très sûr tout en n’ayant pas peur du travail », insiste la coréalisatrice Lise Akoka."
                            }
                        ]
                    }
                ],
