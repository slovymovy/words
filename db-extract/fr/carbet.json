                "senses": [
                    {
                        "sense_id": "6805fc21-606e-3a00-a7ee-a85581477718",
                        "entry_id": "28cf381d-e097-3e8e-92ef-99dc5169d153",
                        "glosses": [
                            "Grande case faite de branches et de feuillage, typique de certaines régions d’Amérique du Sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d19bfe-ab6c-4764-8775-adb112794556",
                                "sense_id": "6805fc21-606e-3a00-a7ee-a85581477718",
                                "text": "Un carbet dans la forêt vierge. Une femme noire, qui paraît avoir un grand âge, broie du manioc."
                            },
                            {
                                "example_id": "78cba715-e1e1-48de-9896-c122e754d425",
                                "sense_id": "6805fc21-606e-3a00-a7ee-a85581477718",
                                "text": "Je ne dis rien de la baraque… J’en ai vu des centaines, du même genre, quand ton père était juge à La Guadeloupe. C’est un carbet, sans les margouillats."
                            },
                            {
                                "example_id": "c3964816-4d7f-4d09-acfd-4daf5bae60c4",
                                "sense_id": "6805fc21-606e-3a00-a7ee-a85581477718",
                                "text": "Il évoquait alors les heures passées dans la fange, dans les carbets de branchages et de palmes, sur des matelas roulés à même le sol, coupé de tout secours médical, livré aux fièvres et aux délires."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf75ca70-5abf-3fd7-9f54-e2282f044f25",
                        "entry_id": "28cf381d-e097-3e8e-92ef-99dc5169d153",
                        "glosses": [
                            "Toiture pour abriter des embarcations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f545af3a-72c7-412a-b837-6bf33e51ce10",
                                "sense_id": "bf75ca70-5abf-3fd7-9f54-e2282f044f25",
                                "text": "À l’aide de quelques branchages et des palmes, nous avions transformé notre chaloupe en carbet."
                            }
                        ]
                    }
                ],
