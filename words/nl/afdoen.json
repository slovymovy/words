{
    "word_family": [
        "doen",
        "afdoend",
        "afdoening"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b780e1ba-5d0d-3ea2-ac1b-3d318865f05d",
                    "sense_definition": "het verwijderen of uittrekken van kledingstukken of accessoires",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zodra ze binnenkwam, wilde ze haar natte mantel <w>afdoen</w>.",
                            "target_lang_translations": {
                                "en": "As soon as she came in, she wanted to <w>take off</w> her wet coat."
                            }
                        },
                        {
                            "text": "Vergeet niet je bril <w>af te doen</w> voordat je gaat slapen.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>remove</w> your glasses before you go to sleep."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitdoen",
                        "uittrekken"
                    ],
                    "antonyms": [
                        "aandoen",
                        "opzetten"
                    ],
                    "common_phrases": [
                        "je hoed afdoen",
                        "je bril afdoen",
                        "je horloge afdoen"
                    ],
                    "target_lang_definitions": {
                        "en": "to remove or take off items of clothing or accessories"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take off",
                                "target_lang_sense_clarification": "to remove clothing or accessories"
                            },
                            {
                                "target_lang_word": "remove",
                                "target_lang_sense_clarification": "to take away an item being worn"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75aeb819-0755-3da3-9560-5934f64d9de1",
                    "sense_definition": "iets volledig voltooien of afhandelen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voltooien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten deze administratieve taken eerst <w>afdoen</w>.",
                            "target_lang_translations": {
                                "en": "We must <w>finish</w> these administrative tasks first."
                            }
                        },
                        {
                            "text": "Hij wilde de zaak snel <w>afdoen</w> om naar huis te kunnen gaan.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>settle</w> the matter quickly so he could go home."
                            }
                        }
                    ],
                    "synonyms": [
                        "voltooien",
                        "afhandelen",
                        "afwikkelen"
                    ],
                    "common_phrases": [
                        "een zaak afdoen"
                    ],
                    "target_lang_definitions": {
                        "en": "to fully complete, handle, or settle a matter or task"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "settle",
                                "target_lang_sense_clarification": "to conclude or resolve a matter"
                            },
                            {
                                "target_lang_word": "finish",
                                "target_lang_sense_clarification": "to complete a task or process"
                            },
                            {
                                "target_lang_word": "deal with",
                                "target_lang_sense_clarification": "to handle or dispose of a matter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12276978-128a-338c-9571-ab5c7c4f39cf",
                    "sense_definition": "iets als onbelangrijk of onbetekenend terzijde schuiven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verwerpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>deed</w> mijn serieuze waarschuwing <w>af</w> als een flauwe grap.",
                            "target_lang_translations": {
                                "en": "He <w>dismissed</w> my serious warning as a silly joke."
                            }
                        },
                        {
                            "text": "De directeur <w>deed</w> het hele probleem <w>af</w> met een simpel handgebaar.",
                            "target_lang_translations": {
                                "en": "The director <w>brushed aside</w> the entire problem with a simple wave of the hand."
                            }
                        }
                    ],
                    "common_phrases": [
                        "afdoen als"
                    ],
                    "target_lang_definitions": {
                        "en": "to dismiss or set something aside as unimportant or insignificant"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismiss",
                                "target_lang_sense_clarification": "to treat as unworthy of serious consideration"
                            },
                            {
                                "target_lang_word": "brush aside",
                                "target_lang_sense_clarification": "to disregard or ignore something as unimportant"
                            },
                            {
                                "target_lang_word": "shrug off",
                                "target_lang_sense_clarification": "to minimize the importance of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "417fe153-ffda-3dd7-a317-8ce290aa0e5b",
                    "sense_definition": "niet langer geldig, werkzaam of gewenst zijn; afgedaan hebben bij iemand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beëindigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na die gemene opmerking heeft hij voorgoed bij mij <w>afgedaan</w>.",
                            "target_lang_translations": {
                                "en": "After that mean remark, I <w>am finished</w> with him for good."
                            }
                        },
                        {
                            "text": "Die oude methode heeft nu echt <w>afgedaan</w> in ons bedrijf.",
                            "target_lang_translations": {
                                "en": "That old method <w>is</w> now truly <w>obsolete</w> in our company."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bij iemand afgedaan hebben"
                    ],
                    "target_lang_definitions": {
                        "en": "to no longer be valid, effective, or desired; to be finished with someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be finished",
                                "target_lang_sense_clarification": "to no longer have a relationship or validity"
                            },
                            {
                                "target_lang_word": "be done with",
                                "target_lang_sense_clarification": "to have no further use for or interest in"
                            },
                            {
                                "target_lang_word": "be over",
                                "target_lang_sense_clarification": "to have reached an end of validity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9ec04bc-b312-32a0-9a3f-01ccb1d4f8ef",
                    "sense_definition": "de waarde of het belang van iets verminderen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verminderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat kleine foutje <w>doet</w> niets <w>af</w> aan de kwaliteit van je werk.",
                            "target_lang_translations": {
                                "en": "That small mistake does not <w>detract</w> from the quality of your work."
                            }
                        },
                        {
                            "text": "Zijn late komst <w>deed</w> helaas <w>af</w> aan de feestelijke sfeer.",
                            "target_lang_translations": {
                                "en": "His late arrival unfortunately <w>diminished</w> the festive atmosphere."
                            }
                        }
                    ],
                    "common_phrases": [
                        "afdoen aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to reduce the value, quality, or importance of something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "detract",
                                "target_lang_sense_clarification": "to take away from the value or quality"
                            },
                            {
                                "target_lang_word": "diminish",
                                "target_lang_sense_clarification": "to make something seem less impressive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1b21e24-519a-3e36-8eec-96b5b1832775",
                    "sense_definition": "een schuld of verplichting vereffenen of terugbetalen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "betalen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij beloofde zijn openstaande schulden volgende maand volledig <w>af te doen</w>.",
                            "target_lang_translations": {
                                "en": "He promised to <w>pay off</w> his outstanding debts in full next month."
                            }
                        },
                        {
                            "text": "Het is een morele plicht om deze schuld eindelijk <w>af te doen</w>.",
                            "target_lang_translations": {
                                "en": "It is a moral duty to finally <w>settle</w> this debt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een schuld afdoen"
                    ],
                    "target_lang_definitions": {
                        "en": "to settle, pay off, or clear a debt or obligation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "settle",
                                "target_lang_sense_clarification": "to pay a bill or account"
                            },
                            {
                                "target_lang_word": "pay off",
                                "target_lang_sense_clarification": "to fully discharge a debt"
                            },
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "to pay off an outstanding balance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}