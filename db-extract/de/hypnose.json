                                "target_senses": [
                                    {
                                        "sense_id": "aa9d0b97-aadc-3bbf-9e62-05484c189550",
                                        "entry_id": "578d5a94-fc52-3ce8-8f90-70c88c3e7121",
                                        "glosses": [
                                            "A trancelike state, artificially induced, in which a person has a heightened suggestibility, and in which suppressed memories may be experienced."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edbd5149-00c5-4abf-8a48-7f3b84f70782",
                                                "sense_id": "aa9d0b97-aadc-3bbf-9e62-05484c189550",
                                                "text": "clinical hypnosis"
                                            },
                                            {
                                                "example_id": "ce51f5f2-8a90-4c79-8e8f-c0bea5d70a4f",
                                                "sense_id": "aa9d0b97-aadc-3bbf-9e62-05484c189550",
                                                "text": "under hypnosis"
                                            },
                                            {
                                                "example_id": "8738ec85-0941-4cbf-a685-55d585fcc77c",
                                                "sense_id": "aa9d0b97-aadc-3bbf-9e62-05484c189550",
                                                "text": "self-hypnosis"
                                            },
                                            {
                                                "example_id": "75d1078d-c269-4149-a324-30261e29b2fe",
                                                "sense_id": "aa9d0b97-aadc-3bbf-9e62-05484c189550",
                                                "text": "She entered a state of deep hypnosis."
                                            },
                                            {
                                                "example_id": "18658640-5eba-47b2-ace3-07f8ef404b45",
                                                "sense_id": "aa9d0b97-aadc-3bbf-9e62-05484c189550",
                                                "text": "The therapy used hypnosis to treat anxiety."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e89d350f-dac2-3ff0-a588-a2fb9bba3591",
                                        "entry_id": "578d5a94-fc52-3ce8-8f90-70c88c3e7121",
                                        "glosses": [
                                            "Any of various sleep-like conditions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef384811-9a78-333e-94db-797186117ce4",
