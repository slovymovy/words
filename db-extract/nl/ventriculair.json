                                        "glosses": [
                                            "Of or relating to a ventricle or ventriculus."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6624f23-f08f-48c8-88fb-5e2511d54662",
                                                "sense_id": "d5c01385-3f7b-3a1f-b456-c5c585ac4160",
                                                "text": "Commonly indicated for treatment of sour crop (Fig. 11-11, A), an ingluviotomy is done to retrieve crop calculi, ingluvioliths, or foreign bodies (which are not accessible per os) or to retrieve proventricular or ventricular foreign bodies (using micromagnets [glued in place within plastic tubes], lavage, or endoscopy) and for the placement of an ingluviotomy or proventriculotomy tube or the collection of crop wall biopsies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1ae1b5d-423e-46a9-a492-2e7f22a2933d",
