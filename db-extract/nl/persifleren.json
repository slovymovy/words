                "forms": [],
                "senses": [
                    {
                        "sense_id": "414f5536-9558-3143-a81b-5cb8a1ca921f",
                        "entry_id": "c18cdc85-d5d4-3139-b398-605dae1f9abf",
                        "glosses": [
                            "spottend nabootsen met sterke overdrijving"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "383b3a9d-521b-4baf-bc80-c61d35e510d1",
                                "sense_id": "414f5536-9558-3143-a81b-5cb8a1ca921f",
                                "text": "In Nederland bestaat niet alleen vrijheid van godsdienst, maar ook vrijheid om het geloof te bestrijden, te bekritiseren of te persifleren."
                            },
                            {
                                "example_id": "9b211796-e018-4f4d-9587-9838d78c68f1",
                                "sense_id": "414f5536-9558-3143-a81b-5cb8a1ca921f",
                                "text": "De film zal zowel bekende als nieuwe typetjes bevatten. In de TV Kantine persifleren Carlo en Irene talloze beroemdheden. De twee wonnen vorig jaar de Gouden Televizierring met het programma. Morgen gaat een nieuw seizoen van start."
                            },
                            {
                                "example_id": "0bb4fa8d-d698-47c3-a1ac-eb9009399404",
                                "sense_id": "414f5536-9558-3143-a81b-5cb8a1ca921f",
                                "text": "Paul Groot en Owen Schumacher persifleren in een nieuw seizoen van Koefnoen weer diverse bekende Nederlanders. Ook politici moeten er vlak voor de verkiezingen aan geloven. Maar niet iedereen kan zijn persiflage even goed waarderen. Zo stuurde Ad Koppejan, CDA-Tweede Kamerlid het satirische duo een lange mail met zijn ongezouten mening."
                            }
                        ]
                    }
