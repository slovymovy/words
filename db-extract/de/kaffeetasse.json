                ],
                "senses": [
                    {
                        "sense_id": "af452399-ec6d-3a9a-ab62-bd1409aafed2",
                        "entry_id": "e5b87ec3-2585-3288-917b-9e00ed190ffb",
                        "glosses": [
                            "Tasse à café."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "283f5a11-e54c-4ffc-9a5a-12e37115bf92",
                                "sense_id": "af452399-ec6d-3a9a-ab62-bd1409aafed2",
                                "text": "Mir ist heute morgen meine Kaffeetasse hinuntergefallen.",
                                "translation": "Ce matin, ma tasse à café m’a glissé des mains."
                            },
                            {
                                "example_id": "6595a30b-e4cb-4681-9cf0-292b357480c9",
                                "sense_id": "af452399-ec6d-3a9a-ab62-bd1409aafed2",
                                "text": "Fährt denn jetzt nun mal der Winterdienst raus oder wärmt er sich wieder die Hände an der Kaffeetasse? — (Borkener Zeitung)",
                                "translation": "Le service hivernal sort-il maintenant ou se réchauffe-t-il de nouveau les mains autour de la tasse de café ?"
                            },
                            {
                                "example_id": "c5c2ed68-94ca-41cd-aabc-e66b93b935f2",
                                "sense_id": "af452399-ec6d-3a9a-ab62-bd1409aafed2",
                                "text": "Ich setze mich an den Platz am Tisch, den ich mir reserviert habe, indem ich dort meine Kaffeetasse abgestellt habe.",
                                "translation": "Je m’assieds à la place que je me suis réservée en y déposant ma tasse de café."
                            },
                            {
                                "example_id": "e84c6c94-115c-41d9-a4b7-d66882a4742f",
                                "sense_id": "af452399-ec6d-3a9a-ab62-bd1409aafed2",
                                "text": "Viele Kaffeetrinkende rauchten beispielsweise regelmäßig Zigaretten - eine Tatsache, die früher nicht in die Untersuchungen einbezogen wurde. Heute weiß man: Negative Effekte, die damals dem Kaffee zugeschrieben wurden, stammten eher von der Zigarette als aus der Kaffeetasse.",
                                "translation": "De nombreux consommateurs de café fumaient régulièrement des cigarettes, par exemple, un fait qui n'était pas pris en compte dans les études auparavant. Aujourd'hui, on sait que les effets négatifs attribués autrefois au café provenaient davantage de la cigarette que de la tasse de café."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
