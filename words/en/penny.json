{
    "word_family": [
        "penniless",
        "halfpenny",
        "twopenny",
        "pennyworth",
        "penny-pinching",
        "penny-pincher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19ecf7c4-f657-35b8-8872-e5276f7e3ad8",
                    "sense_definition": "A coin worth one cent, used in the United States and formerly in Canada; one hundredth of a dollar.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "coins",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found a lucky <w>penny</w> on the sidewalk this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром я нашёл на тротуаре счастливый <w>пенни</w>.",
                                "zh": "今天早上我在人行道上捡到了一枚幸运的<w>美分</w>。"
                            }
                        },
                        {
                            "text": "She saved every <w>penny</w> she earned to buy a new bicycle.",
                            "target_lang_translations": {
                                "ru": "Она откладывала каждую <w>копейку</w>, которую зарабатывала, чтобы купить новый велосипед.",
                                "zh": "她把赚来的每一<w>分钱</w>都存起来，为了买一辆新自行车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cent"
                    ],
                    "common_phrases": [
                        "penny for your thoughts",
                        "pretty penny",
                        "every penny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Монета достоинством в один цент, используемая в США и ранее в Канаде; одна сотая доллара.",
                        "zh": "一种面值为一美分的硬币，在美国和加拿大（过去）使用；是一美元的百分之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цент",
                                "target_lang_sense_clarification": "номинал монеты"
                            },
                            {
                                "target_lang_word": "пенни",
                                "target_lang_sense_clarification": "разговорное название монеты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美分",
                                "target_lang_sense_clarification": "货币单位"
                            },
                            {
                                "target_lang_word": "分币",
                                "target_lang_sense_clarification": "硬币名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1a70959-aba3-32fe-9215-d91e6d192796",
                    "sense_definition": "A coin worth one hundredth of a pound sterling, used in the United Kingdom.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "coins",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sweet shop sells candies for just a <w>penny</w> each.",
                            "target_lang_translations": {
                                "ru": "В кондитерской продаются конфеты всего за один <w>пенс</w>.",
                                "zh": "那家糖果店卖的糖果每颗只要一<w>便士</w>。"
                            }
                        },
                        {
                            "text": "Do you have a <w>penny</w> I could borrow for the machine?",
                            "target_lang_translations": {
                                "ru": "У тебя не найдётся <w>пенни</w>, чтобы заплатить за автомат?",
                                "zh": "你有没有一<w>便士</w>借我用一下机器？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spend a penny",
                        "the penny drops"
                    ],
                    "target_lang_definitions": {
                        "ru": "Монета достоинством в одну сотую фунта стерлингов, используемая в Великобритании.",
                        "zh": "一种面值为一英镑百分之一的硬币，在英国使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пенс",
                                "target_lang_sense_clarification": "денежная единица и монета"
                            },
                            {
                                "target_lang_word": "пенни",
                                "target_lang_sense_clarification": "монета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "便士",
                                "target_lang_sense_clarification": "英国货币单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b331cb0-94fc-33e4-a3cf-471a8f6ff481",
                    "sense_definition": "A very small sum of money, or money in general.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "money_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It did not cost a <w>penny</w> to enter the museum today.",
                            "target_lang_translations": {
                                "ru": "Вход в музей сегодня не стоил ни <w>копейки</w>.",
                                "zh": "今天进博物馆参观没花一<w>分钱</w>。"
                            }
                        },
                        {
                            "text": "He arrived in the city without a single <w>penny</w> to his name.",
                            "target_lang_translations": {
                                "ru": "Он приехал в город, не имея за душой ни <w>гроша</w>.",
                                "zh": "他来到这座城市时，身上连一<w>分钱</w>都没有。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "not a penny",
                        "turn an honest penny",
                        "pennies from heaven"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень маленькая сумма денег или деньги в целом.",
                        "zh": "极少量的钱，或泛指金钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копейка",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "грош",
                                "target_lang_sense_clarification": "разговорное, ничтожная сумма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分文",
                                "target_lang_sense_clarification": "指极少的钱"
                            },
                            {
                                "target_lang_word": "钱财",
                                "target_lang_sense_clarification": "泛指金钱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8badcdbb-308a-30e1-a641-d1896b99693b",
                    "sense_definition": "A former British coin used before decimalisation, worth 1/240 of a pound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coins",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old days, you could buy a loaf of bread for a <w>penny</w>.",
                            "target_lang_translations": {
                                "ru": "В былые времена буханку хлеба можно было купить за <w>пенни</w>.",
                                "zh": "在过去，花一<w>便士</w>就能买到一条面包。"
                            }
                        },
                        {
                            "text": "He found an old <w>penny</w> buried in the garden soil.",
                            "target_lang_translations": {
                                "ru": "Он нашел старый <w>пенни</w>, зарытый в садовой земле.",
                                "zh": "他在花园的土里发现了一枚旧<w>便士</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "old penny"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "pre-decimalisation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинная британская монета, использовавшаяся до перехода на десятичную систему, равная 1/240 фунта.",
                        "zh": "英国十进制改革前使用的一种旧硬币，面值为一英镑的二百四十分之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пенни",
                                "target_lang_sense_clarification": "историческая монета"
                            },
                            {
                                "target_lang_word": "пенс",
                                "target_lang_sense_clarification": "номинал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旧便士",
                                "target_lang_sense_clarification": "历史货币"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b2848018-3aaf-3976-a0be-9d2427619672",
                    "sense_definition": "A female given name, often a short form of <w>Penelope</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My aunt <w>Penny</w> is coming to visit us this weekend.",
                            "target_lang_translations": {
                                "ru": "Моя тетя <w>Пенни</w> приедет навестить нас в эти выходные.",
                                "zh": "我的<w>彭妮</w>阿姨这个周末要来看我们。"
                            }
                        },
                        {
                            "text": "She decided to go by <w>Penny</w> instead of her full name.",
                            "target_lang_translations": {
                                "ru": "Она решила называть себя <w>Пенни</w> вместо полного имени.",
                                "zh": "她决定用<w>彭妮</w>这个名字，而不是她的全名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя, часто сокращение от Пенелопа.",
                        "zh": "女性名字，常为佩内洛普（Penelope）的昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пенни",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "彭妮",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e55a35e-8bca-3721-9c77-17d109644b4b",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Penny</w> was known for his generous contributions to the library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Пенни</w> был известен своими щедрыми пожертвованиями библиотеке.",
                                "zh": "<w>彭妮</w>先生以慷慨捐助图书馆而闻名。"
                            }
                        },
                        {
                            "text": "The letter was addressed to a family named <w>Penny</w>.",
                            "target_lang_translations": {
                                "ru": "Письмо было адресовано семье по фамилии <w>Пенни</w>.",
                                "zh": "这封信是寄给一个姓<w>彭妮</w>的家庭的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пенни",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "彭妮",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60491edd-07d9-3211-a466-3b7635b81a68",
                    "sense_definition": "To jam a door shut by inserting coins between the doorframe and the door.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students played a prank and <w>pennied</w> their friend's door.",
                            "target_lang_translations": {
                                "ru": "Студенты устроили розыгрыш и <w>заклинили монетами</w> дверь своего друга.",
                                "zh": "学生们搞了个恶作剧，用硬币把朋友的门<w>卡住</w>了。"
                            }
                        },
                        {
                            "text": "We could not get out because someone had <w>pennied</w> us in.",
                            "target_lang_translations": {
                                "ru": "Мы не могли выйти, потому что кто-то <w>заклинил</w> нашу дверь <w>монетами</w>.",
                                "zh": "我们出不去，因为有人用硬币把门<w>卡住</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "student culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заклинить дверь, вставив монеты между дверной коробкой и дверью.",
                        "zh": "通过在门框和门之间塞入硬币来卡住门。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заклинить монетами",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塞硬币卡住",
                                "target_lang_sense_clarification": "动作描述"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}