                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3c89997-bb00-4408-b01f-3c988f573d7d",
                                                "sense_id": "b09671c8-0fca-3084-8f17-a1952bca64c6",
