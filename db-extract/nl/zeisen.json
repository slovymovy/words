                        "examples": [
                            {
                                "example_id": "8cf6a3c1-3350-4b8e-a0de-f9bc50a88be9",
                                "sense_id": "8047b456-88b6-3cb9-bc6a-93e6e51bab2f",
                                "text": "Op de windvaan zijn twee zeisen en een zandloper weergegeven."
                            },
                            {
                                "example_id": "da59eeba-3bc6-4b1a-b9ec-1e04b9901be6",
                                "sense_id": "8047b456-88b6-3cb9-bc6a-93e6e51bab2f",
                                "text": "Ik zal u verdere moeite sparen, door u een twee drie te vertellen, wat er verder in onze hut is. Acht geiten, eene manke koe, doch vet, een dik vet kalf, vier zeisen, vier houweelen, drie spietsen en een jagersmes."
                            }
                        ]
                    }
                ],
