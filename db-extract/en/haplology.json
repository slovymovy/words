                                        "entry_id": "8ad36d71-bfde-3447-931a-42fceec44c5c",
                                        "glosses": [
                                            "Amuïssement dans un mot d’un ou de plusieurs phonèmes identiques ou apparentés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5729a0f0-70ec-4c71-8722-601cf05ddf8d",
                                                "sense_id": "f40d0dbd-566a-3196-bf57-29ffcffd2866",
