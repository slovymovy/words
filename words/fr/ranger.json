                        "ranger par catégorie"
                    ]
                },
                {
                    "sense_id": "e4139679-b64a-31aa-bfa2-a1f1bb07d6ba",
                    "sense_definition": "Déplacer quelque chose ou soi-même sur le côté pour libérer le passage ou pour stationner.",
