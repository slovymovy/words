                        "entry_id": "920688ec-f3de-341d-b534-f5e09f5b6b1d",
                        "glosses": [
                            "Chauffeur de taxi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9d17ca0-9587-4944-bbf5-177485802743",
                                "sense_id": "81d6cfc0-9c6f-323c-b461-7b11974f78f3",
                                "text": "En parlant du souvenir des Français, le taxiteur acceptait même de descendre son prix à 700 Dinards, mais à condition de payer ce soir."
                            },
                            {
                                "example_id": "628cbbca-46a0-4c56-a8bb-337be8858a66",
                                "sense_id": "81d6cfc0-9c6f-323c-b461-7b11974f78f3",
                                "text": "Commerce d'articles de literie, de meubles et de tissus d'ameublement et taxiteur agréé, service d'ambulance, à l'enseigne : Au Bélier, à Bellegarde, 17, rue Joseph-Bertola."
                            },
                            {
                                "example_id": "1a216b4d-4033-43e4-a3a8-94d7f5cddf14",
                                "sense_id": "81d6cfc0-9c6f-323c-b461-7b11974f78f3",
                                "text": "… le taxiteur réclame le prix de la course... Gustav ! l'argent est dans mon sac, sur la commode de la chambre."
                            }
                        ]
                    }
