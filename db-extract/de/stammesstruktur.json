                        "examples": [
                            {
                                "example_id": "7807d0e7-cd2f-4f8a-9e9e-113910c994ac",
                                "sense_id": "2999b881-603f-3601-8989-85407880f58d",
                                "text": "„Gerade in den FATA spielt die tribale Selbstzuordnung für die soziale Organisation eine große Rolle, wenngleich islamistische Gruppen wie die Taliban diese Stammesstrukturen bekämpfen.“"
                            },
                            {
                                "example_id": "5b0ddd39-0ff2-4007-bfa4-2739d2a3af42",
                                "sense_id": "2999b881-603f-3601-8989-85407880f58d",
                                "text": "„Herzstück seiner Reformen war die Modernisierung des Militärs mit dem Ziel, Stammesstrukturen durch zentralistische Befehlsstrukturen zu ersetzen.“"
                            },
                            {
                                "example_id": "f6639fed-610a-4d72-99c9-e1fca9d9b0cb",
                                "sense_id": "2999b881-603f-3601-8989-85407880f58d",
                                "text": "„Die Islamisten verunglimpften Stammesstrukturen und verfolgten eine radikalpolitische Ideologie, um in Afghanistan eine Revolution anzuzetteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
