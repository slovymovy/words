                        "sense_id": "d27da61f-a20d-3a10-ad38-d59051dc2a88",
                        "entry_id": "83bae45e-9ebe-39af-9684-9c85157dfbf8",
                        "glosses": [
                            "einzelnes Heiligenbild an einem Baum das an ein persönliches Ereignis erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "430ce245-3052-422c-b541-389e11aca4d1",
                                "sense_id": "d27da61f-a20d-3a10-ad38-d59051dc2a88",
                                "text": "„Bildbäume sind wohl die am wenigsten beachteten Flurdenkmäler, die der Pflege am nötigsten bedürfen.“"
                            },
                            {
                                "example_id": "59818369-440b-4c19-a277-65abc4a56d98",
                                "sense_id": "d27da61f-a20d-3a10-ad38-d59051dc2a88",
                                "text": "„Zwischen Pehendorf und Pretrobruck steht ein Bildbaum direkt an der Straße.“"
                            },
                            {
                                "example_id": "cc282505-ea2a-488c-bd00-0575c63f33b2",
                                "sense_id": "d27da61f-a20d-3a10-ad38-d59051dc2a88",
                                "text": "„Der Bildbaum im St. Margarethener Urbarialwald, ein 200 Jahr altes Naturdenkmal, musste vor wenigen Tagen aufgrund einer behördlicher Anordnung gefällt werden.“"
                            }
                        ],
