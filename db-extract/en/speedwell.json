                                        "sense_id": "417b4419-8554-319a-9425-9aab0162e9ff",
                                        "entry_id": "571f0469-ca8c-3799-99a9-8c5d2af7bfc3",
                                        "glosses": [
                                            "Genre de scrofulariacée qui comprend un grand nombre d’espèces, la plupart à fleurs bleues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95fda43b-bb43-482b-a624-4a53584cc97c",
                                                "sense_id": "417b4419-8554-319a-9425-9aab0162e9ff",
                                                "text": "Les prés sont mauves des fleurs mélancoliques d’automne, et j’ai cueilli la véronique au bord d’un ruisseau tari."
                                            },
                                            {
                                                "example_id": "d9a58b69-3723-4c2e-9536-cd870c05547e",
                                                "sense_id": "417b4419-8554-319a-9425-9aab0162e9ff",
                                                "text": "La véronique mâle, appelée aussi thé d’Europe, est employée comme stomachique et cordial."
                                            },
                                            {
                                                "example_id": "0b02225b-f2b8-4112-96f9-c749f64de6ab",
                                                "sense_id": "417b4419-8554-319a-9425-9aab0162e9ff",
                                                "text": "Tremblant un peu à l’idée que Yann pouvait être revenu, elle traversa le jardinet où poussaient des chrysanthèmes et des véroniques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "véronique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68248a94-e112-3bf6-95f4-17957b63b0ad",
                                        "entry_id": "5c62a372-53e9-3030-a98b-62872a9ef028",
                                        "glosses": [
                                            "D’une couleur bleue qui est celle de la fleur appelée « véronique ». #0379A6"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dff856a-1687-4ed0-8ccd-3a6b1fff30dc",
                                                "sense_id": "68248a94-e112-3bf6-95f4-17957b63b0ad",
                                                "text": "Comme tous les gens du clan Pasquier, il montrait des yeux bleu véronique."
                                            }
