{
    "word_family": [
        "top",
        "topper",
        "topless",
        "topmost"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a075604-0392-38f0-baa1-6490986eaee7",
                    "sense_definition": "Any food item added on top of another, such as sprinkles on ice cream or pepperoni on pizza.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like to order a large pizza with extra cheese and mushroom <w>topping</w>.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы заказать большую пиццу с двойным сыром и грибной <w>начинкой</w>."
                            }
                        },
                        {
                            "text": "The children enjoyed choosing a favorite <w>topping</w> for their frozen yogurt at the shop.",
                            "target_lang_translations": {
                                "ru": "Детям понравилось выбирать любимый <w>топпинг</w> для своего замороженного йогурта в магазине."
                            }
                        }
                    ],
                    "synonyms": [
                        "garnish"
                    ],
                    "common_phrases": [
                        "favorite topping",
                        "pizza topping",
                        "ice cream topping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой продукт питания, добавляемый поверх другого, например, посыпка на мороженом или пепперони на пицце."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топпинг",
                                "target_lang_sense_clarification": "ингредиент поверх блюда"
                            },
                            {
                                "target_lang_word": "начинка",
                                "target_lang_sense_clarification": "для пиццы или пирогов"
                            },
                            {
                                "target_lang_word": "гарнир",
                                "target_lang_sense_clarification": "украшение блюда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08241699-60d1-3d4b-a9ae-914f1ea403a2",
                    "sense_definition": "The act of cutting off the top of something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener spent the morning <w>topping</w> the hedges to keep them at a uniform height.",
                            "target_lang_translations": {
                                "ru": "Садовник провел утро, <w>подрезая верхушки</w> живой изгороди, чтобы поддерживать их на одной высоте."
                            }
                        },
                        {
                            "text": "Proper <w>topping</w> of the trees is necessary to prevent them from interfering with the power lines.",
                            "target_lang_translations": {
                                "ru": "Правильная <w>обрезка верхушек</w> деревьев необходима, чтобы они не мешали линиям электропередач."
                            }
                        }
                    ],
                    "synonyms": [
                        "lopping",
                        "pruning"
                    ],
                    "common_phrases": [
                        "topping trees",
                        "topping hedges"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по срезанию верхушки чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подрезание верхушек",
                                "target_lang_sense_clarification": "садоводство"
                            },
                            {
                                "target_lang_word": "кронирование",
                                "target_lang_sense_clarification": "обрезка деревьев"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e51e1696-23b2-3f31-835d-ddba6d2a2b73",
                    "sense_definition": "Either of the cables that support the ends of a spar or boom.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor adjusted the <w>topping</w> lift to ensure the boom was held at the correct angle.",
                            "target_lang_translations": {
                                "ru": "Моряк отрегулировал <w>топенант</w>, чтобы гик удерживался под правильным углом."
                            }
                        },
                        {
                            "text": "Check the tension on the <w>topping</w> before we attempt to raise the heavy sail.",
                            "target_lang_translations": {
                                "ru": "Проверьте натяжение <w>топенанта</w>, прежде чем мы попытаемся поднять тяжелый парус."
                            }
                        }
                    ],
                    "common_phrases": [
                        "topping lift"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой из тросов, поддерживающих концы рангоутного дерева или гика."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топенант",
                                "target_lang_sense_clarification": "морской термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea2ff585-175e-3e92-8e80-cbfe35edd200",
                    "sense_definition": "The tail of an artificial fly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a bright feather for the <w>topping</w> of the lure to attract more fish.",
                            "target_lang_translations": {
                                "ru": "Он использовал яркое перо для <w>хвостика</w> приманки, чтобы привлечь больше рыбы."
                            }
                        },
                        {
                            "text": "The intricate <w>topping</w> on this artificial fly makes it look very realistic in the water.",
                            "target_lang_translations": {
                                "ru": "Сложный <w>хвостик</w> на этой искусственной мушке заставляет ее выглядеть очень реалистично в воде."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хвостик искусственной мушки для рыбной ловли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвостик",
                                "target_lang_sense_clarification": "рыболовная мушка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bad0c16b-8f69-3b79-ab3e-5f662bc9ccae",
                    "sense_definition": "The act of raising one extremity of a spar higher than the other.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew began the <w>topping</w> of the yardarm to prepare the vessel for the incoming storm.",
                            "target_lang_translations": {
                                "ru": "Экипаж начал <w>подъем нока рея</w>, чтобы подготовить судно к приближающемуся шторму."
                            }
                        },
                        {
                            "text": "Precise <w>topping</w> is required to balance the weight of the equipment on the mast.",
                            "target_lang_translations": {
                                "ru": "Требуется точный <w>наклон рея</w>, чтобы сбалансировать вес оборудования на мачте."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по поднятию одного конца рангоутного дерева выше другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъем на топенантах",
                                "target_lang_sense_clarification": "морской термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a88e7b0-1b27-3ab6-82b0-af9a96c0cb0a",
                    "sense_definition": "present participle and gerund of <w>top</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local athlete is currently <w>topping</w> the leaderboard after three rounds of competition.",
                            "target_lang_translations": {
                                "ru": "Местный атлет в данный момент <w>возглавляет</w> таблицу лидеров после трех раундов соревнований."
                            }
                        },
                        {
                            "text": "She is <w>topping</w> the cake with fresh strawberries and whipped cream right now.",
                            "target_lang_translations": {
                                "ru": "Она прямо сейчас <w>украшает</w> торт свежей клубникой и взбитыми сливками."
                            }
                        }
                    ],
                    "common_phrases": [
                        "topping the list",
                        "topping the charts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола top (возглавлять, покрывать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возглавляющий",
                                "target_lang_sense_clarification": "список или рейтинг"
                            },
                            {
                                "target_lang_word": "покрывающий",
                                "target_lang_sense_clarification": "сверху"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "70ccf8b4-0780-3d3e-a04e-e32f72502d7d",
                    "sense_definition": "Wonderful; excellent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "positive_evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>topping</w> time at the garden party despite the occasional rain shower.",
                            "target_lang_translations": {
                                "ru": "Мы <w>чудесно</w> провели время на вечеринке в саду, несмотря на редкий дождь."
                            }
                        },
                        {
                            "text": "It really is a <w>topping</w> day for a walk through the countryside.",
                            "target_lang_translations": {
                                "ru": "Сегодня действительно <w>прекрасный</w> день для прогулки по сельской местности."
                            }
                        }
                    ],
                    "synonyms": [
                        "splendid",
                        "spiffing",
                        "excellent",
                        "wonderful"
                    ],
                    "antonyms": [
                        "awful",
                        "terrible"
                    ],
                    "common_phrases": [
                        "topping day",
                        "topping time"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чудесный; превосходный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первоклассный",
                                "target_lang_sense_clarification": "разг. брит."
                            },
                            {
                                "target_lang_word": "чудесный",
                                "target_lang_sense_clarification": "превосходный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b93169e-f7bd-32c6-bc6c-dc70ed57c04b",
                    "sense_definition": "Assuming superiority; proud or haughty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>topping</w> attitude made it very difficult for his colleagues to work with him.",
                            "target_lang_translations": {
                                "ru": "Его <w>высокомерное</w> отношение очень мешало коллегам работать с ним."
                            }
                        },
                        {
                            "text": "The novel describes the fall of a <w>topping</w> nobleman who looked down on everyone.",
                            "target_lang_translations": {
                                "ru": "В романе описывается падение <w>надменного</w> дворянина, который смотрел на всех свысока."
                            }
                        }
                    ],
                    "synonyms": [
                        "haughty",
                        "proud",
                        "superior"
                    ],
                    "antonyms": [
                        "humble",
                        "modest"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрирующий превосходство; гордый или высокомерный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокомерный",
                                "target_lang_sense_clarification": "архаич."
                            },
                            {
                                "target_lang_word": "надменный",
                                "target_lang_sense_clarification": "считающий себя выше других"
                            }
                        ]
                    }
                }
            ]
        },
        {
