                    "semantic_group_id": "degeler_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette plaisanterie opportune a permis de <w>dégeler</w> les relations entre les deux négociateurs."
                        },
                        {
                            "text": "Un simple mot d'accueil chaleureux suffit souvent à <w>dégeler</w> un public intimidé."
