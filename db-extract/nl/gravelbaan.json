                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90734fd2-fb11-3bda-83bc-cd56331dbd73",
