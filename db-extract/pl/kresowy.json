                                                "sense_id": "c1e39f87-3e1a-3e6f-ae8f-6caeb611f7bc",
                                                "text": "The Fringe"
                                            },
                                            {
                                                "example_id": "967971bf-beb2-41fb-93fa-d44de43a0e78",
                                                "sense_id": "c1e39f87-3e1a-3e6f-ae8f-6caeb611f7bc",
                                                "text": "Edinburgh Fringe"
                                            },
                                            {
