            {
                "entry_id": "ba8851d5-5d10-3d8f-9e8e-ca0bd977c14a",
                "word": "zend",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "640fbeed-5631-34bd-aea1-073635d8ef4d",
                        "entry_id": "ba8851d5-5d10-3d8f-9e8e-ca0bd977c14a",
                        "glosses": [
                            "Avestique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7381c06f-0642-45ca-9277-16a051f6ec53",
                                "sense_id": "640fbeed-5631-34bd-aea1-073635d8ef4d",
                                "text": "Le zend est voisin du sanskrit."
                            },
                            {
                                "example_id": "860a14d4-10f2-4717-a56c-578478b254bd",
                                "sense_id": "640fbeed-5631-34bd-aea1-073635d8ef4d",
                                "text": "Dans la région de l’Inde au Caucase, le zend, avec ses mots longs et compliqués, son manque de prépositions et sa manière d’y suppléer au moyen de cas formés par flexion, le perse des inscriptions cunéiformes, si parfait de structure, sont remplacés par le persan moderne, presque aussi décrépit que l’anglais, arrivé au dernier terme de l’érosion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad9e0883-db16-4efd-bf91-a7d6ffd5183a",
                        "source_entry_id": "ba8851d5-5d10-3d8f-9e8e-ca0bd977c14a",
                        "source_sense_id": "640fbeed-5631-34bd-aea1-073635d8ef4d",
                        "target_lang_word": "Zend",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a78f921-ab40-3c36-8056-98d3429ac19f",
                                        "entry_id": "fe619ff3-15c6-39ab-a31d-9f5e7cc6e727",
                                        "glosses": [
                                            "Exegetical glosses, paraphrases, commentaries and translations of the Avesta's texts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ebe3e6a-62bb-48c2-bef1-b3121561bd71",
                                                "sense_id": "9a78f921-ab40-3c36-8056-98d3429ac19f",
                                                "text": "Zand or 'Interpretation' is a term for the exegesis of Avestan texts through glosses, commentaries and translations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "908666e8-130b-3a12-acfb-defed119c90b",
                                        "entry_id": "fe619ff3-15c6-39ab-a31d-9f5e7cc6e727",
                                        "glosses": [
                                            "The Avestan language."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e57f6ff-1a2a-40fd-941c-f00bce167db2",
                                                "sense_id": "908666e8-130b-3a12-acfb-defed119c90b",
                                                "text": "As to grammatical forms, the Gâtha dialect shows not a few deviations from the current Zend language."
                                            },
                                            {
                                                "example_id": "e5b7b4de-9e9d-4f49-985a-e05d902f5371",
                                                "sense_id": "908666e8-130b-3a12-acfb-defed119c90b",
                                                "text": "[The Avesta] is the only work known to be written in the Zend language."
                                            },
                                            {
                                                "example_id": "61d400a5-6a01-40f7-b32e-849fdd5229ed",
                                                "sense_id": "908666e8-130b-3a12-acfb-defed119c90b",
                                                "text": "The dialect in which these writings are composed goes usually by the name of the Zend ; it is also styled the Avestan, and sometimes the Old Bactrian, from the country Bactria, the north-easternmost region of the great Iranian territory, which is supposed to have been its specific locality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
