                "senses": [
                    {
                        "sense_id": "0d5aca17-badf-33a3-8770-ded07259183e",
                        "entry_id": "b5ee2bc2-e854-344d-8083-7259d70285f4",
                        "glosses": [
                            "Yes, indeed."
                        ],
                        "tags": [
                            "dated",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f81a8a80-b53e-4956-97a9-37ea871d658f",
                                "sense_id": "0d5aca17-badf-33a3-8770-ded07259183e",
                                "text": "1597–1598, Joseph Hall, Virgidemiarum\nYea, and the prophet of the heav'nly lyre, / Great Solomon sings in the English quire […]"
                            },
                            {
                                "example_id": "4ea01fb3-ecce-4780-bd04-991ee3cecd42",
                                "sense_id": "0d5aca17-badf-33a3-8770-ded07259183e",
                                "text": "Let no man say that the Devil is not a cruel tyrant. He may give his folk some scrapings of unhallowed pleasure, but he will exact tithes, yea, of anise and cummin, in return, and there is aye the reckoning to pay at the hinder end."
                            }
                        ]
                    },
                    {
                        "sense_id": "f36c02bd-cf72-36f1-b52f-d5a6119950cc",
                        "entry_id": "b5ee2bc2-e854-344d-8083-7259d70285f4",
                        "glosses": [
                            "Thus, so (now often accompanied by a hand gesture by way of measurement)."
                        ],
                        "tags": [
                            "dated",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8db63230-89c4-47e8-89e5-76d8c4f0f07f",
                                "sense_id": "f36c02bd-cf72-36f1-b52f-d5a6119950cc",
                                "text": "\"The pony was about yea high,\" he explained, holding out his hand, palm down, roughly level with his chin."
                            }
                        ]
                    }
                ],
