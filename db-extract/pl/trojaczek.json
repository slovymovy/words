                    {
                        "translation_id": "49dff943-eca7-4f5e-8640-c24561bafee8",
                        "source_entry_id": "6b9022f9-987f-34ea-b6a0-e70171618af8",
                        "source_sense_id": "e241f6f4-2ee3-3452-b54f-63af5197ecf8",
                        "target_lang_word": "Drilling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drilling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "131451c3-28c9-3b17-b622-114a2a8f7b30",
                                        "entry_id": "4bfd4d1f-3e10-3dc7-9b2e-659f83fe6edc",
                                        "glosses": [
                                            "eines von insgesamt drei Kindern, die bei Mehrlingsgeburt zur Welt gekommen sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc79261d-6c5b-4223-b382-a832dc650edc",
                                                "sense_id": "131451c3-28c9-3b17-b622-114a2a8f7b30",
                                                "text": "Meine Schwester hat letzte Woche Drillinge zur Welt gebracht."
                                            },
                                            {
                                                "example_id": "4cdfc885-c00f-453c-8a2a-25cdaf91427e",
                                                "sense_id": "131451c3-28c9-3b17-b622-114a2a8f7b30",
                                                "text": "„An der Ecke hatte eine Frau ihre Drillinge auf einer Plane ausgelegt wie Gemüse.“"
                                            },
                                            {
                                                "example_id": "e9b39df5-2151-4afa-ad0a-cf3c13fa96d1",
                                                "sense_id": "131451c3-28c9-3b17-b622-114a2a8f7b30",
                                                "text": "„Die Parameter, die Day (1932) und Davis (1937) bei Zwillingsuntersuchungen verwendeten, ließen in der Untersuchung von Howard (1946) bei einer Gruppe von Drillingen auf noch größere Verzögerung als bei Zwillingen schließen.“"
                                            },
                                            {
                                                "example_id": "270d25e0-0bd7-4228-a674-5152a44243a2",
                                                "sense_id": "131451c3-28c9-3b17-b622-114a2a8f7b30",
                                                "text": "„Da Zwillinge sowieso nicht immer in große Verhältnisse hineingeboren werden, erkundigte sich ein kleiner Beamter tiefbekümmert beim Frauenarzt, weshalb in seiner jungen Ehe zuerst ein einziges Töchterchen ankam, danach ein Zwillingspärchen, und jetzt, im dritten Jahr, schon reguläre Drillinge.“"
                                            },
                                            {
                                                "example_id": "e7a6bcb1-10e5-4545-8fa4-5ae329cf955f",
                                                "sense_id": "131451c3-28c9-3b17-b622-114a2a8f7b30",
                                                "text": "„Endlich kommt die Schwester mit Drillingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5bdeaace-1bcf-30fc-9891-6299a04595fe",
                                        "entry_id": "4bfd4d1f-3e10-3dc7-9b2e-659f83fe6edc",
                                        "glosses": [
                                            "eine Schusswaffe mit drei Läufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f44f8774-88b9-4ffc-becf-e24ed5d92c2c",
                                                "sense_id": "5bdeaace-1bcf-30fc-9891-6299a04595fe",
                                                "text": "Mein Vater hatte einen alten Suhler Drilling mit Schrotkaliber 16."
                                            },
                                            {
                                                "example_id": "65f0334b-eb32-4294-bd7c-4a04e2c18920",
                                                "sense_id": "5bdeaace-1bcf-30fc-9891-6299a04595fe",
                                                "text": "„Der Förster Kniebusch wanderte langsam, den Drilling auf dem Rücken, durch den nächtlichen Wald.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5422d2a9-7b97-342b-829b-d6941b4f7f10",
                                        "entry_id": "4bfd4d1f-3e10-3dc7-9b2e-659f83fe6edc",
                                        "glosses": [
                                            "eine Kartoffel, die die für die jeweilige Knollenform vorgeschriebene Mindestgröße von 35 mm bei langovalen bis langen Sorten und 40 mm bei runden Sorten unterschreitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5e8c70-b2a6-4725-99fb-ee78dfdaccc1",
                                                "sense_id": "5422d2a9-7b97-342b-829b-d6941b4f7f10",
                                                "text": "Aus Drillingen kann man einen optisch ansprechenden Kartoffelsalat machen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1b6cbb70-9fb3-3ddd-9065-5086e3ab89d0",
                                        "entry_id": "4bfd4d1f-3e10-3dc7-9b2e-659f83fe6edc",
                                        "glosses": [
                                            "ein Angelhaken mit drei Hakenspitzen die meist im Winkel vom 120° zueinander angeordnet sind"
                                        ],
                                        "tags": [
                                            "Angeln"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73041df1-4608-4213-94ac-abb399a97790",
                                                "sense_id": "1b6cbb70-9fb3-3ddd-9065-5086e3ab89d0",
                                                "text": "Der Hecht hing am oberen Drillinge des Wobblers."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4328c07e-d654-359b-9328-6da3f79924af",
                                        "entry_id": "4bfd4d1f-3e10-3dc7-9b2e-659f83fe6edc",
                                        "glosses": [
                                            "drei Spielkarten mit dem gleichen Wert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d6e6f78-17bf-4551-9b96-90d35229f937",
                                                "sense_id": "4328c07e-d654-359b-9328-6da3f79924af",
                                                "text": "Mein Drilling verlor gegen den Flush meines Gegners."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
