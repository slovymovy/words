                        "glosses": [
                            "Une des espèces de petites antilopes africaines vivant principalement en forêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91545f49-4885-466f-979b-9dad6f703227",
                                "sense_id": "526e65c4-251f-3ae5-9938-cf1ea2312ac8",
                                "text": "Le type de sous-bois semble être un facteur déterminant de la répartition des céphalophes."
                            },
                            {
                                "example_id": "db896b7d-20ae-46fd-b3b7-724a5fabe3ee",
                                "sense_id": "526e65c4-251f-3ae5-9938-cf1ea2312ac8",
                                "text": "Les doutes levés, le chasseur et la vingtaine d’hommes du village qui, comme lui, pistent la nuit venue céphalophes, potamochères, porcs-épics et autres espèces moins avouables car strictement protégées comme les pangolins ou les mandrills, ont accepté de se plier à la discipline des chercheurs."
                            }
                        ]
                    }
